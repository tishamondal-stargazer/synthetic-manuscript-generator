𑆪𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆧𑆬𑆮𑆢𑇀𑆪𑆱𑇀𑆪 𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆪𑆱𑇀𑆪 𑆖𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆂 𑆑𑆰𑇀𑆛𑆳 𑆩𑆫𑇀𑆩𑆓𑆾 𑆪𑆯𑇀𑆖 𑆲𑆤𑇀𑆠𑆴 𑆱𑆂𑇆𑇒𑇘𑇆
𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆽𑆂 𑆑𑆼𑆮𑆬𑆾 𑆮𑆳𑆪𑆶𑆂 𑆥𑆷𑆫𑆟𑆽𑆫𑇀𑆮𑆳 𑆱𑆩𑆳𑆮𑆸𑆠𑆂𑇅 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆾 𑆢𑆷𑆰𑆪𑆤𑇀 𑆢𑆷𑆰𑇀𑆪𑆳𑆤𑇀 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇆𑇒𑇙𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆨𑇀𑆫𑆩𑆢𑆮𑆡𑆶𑆥𑆴𑆥𑆳𑆱𑆳𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆯𑆷𑆬𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆑𑆩𑇀𑆥𑆘𑇀𑆮𑆫𑆠𑆩𑆑- 𑆑𑆳𑆱𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆨𑆼𑆢𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆟𑆮𑆼𑆥𑆤𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑆳𑆑𑆶𑆬𑆠𑇀𑆮𑆩𑆱𑇀𑆫𑆳𑆓𑆩𑆤𑆁 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆱𑆚𑇀𑆖𑆳𑆫 𑆅𑆮 𑆖𑆳𑆕𑇀𑆓𑆼𑆰𑆶, 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆳𑆮𑆑𑆳𑆯𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆾 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆾𑇁𑆮𑆑𑆳𑆯𑆂 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆳𑆨𑆳𑆱𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆳𑆤𑇀 𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆨𑆼𑆢𑆯𑆷𑆬𑆳𑆪𑆳𑆩𑆱𑆕𑇀𑆑𑆾𑆖𑆲𑆫𑇀𑆰𑆱𑇀𑆦𑆶𑆫𑆟𑆽𑆫𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆠𑆼, 𑆃𑆤𑆶𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆯𑇀𑆖𑆾𑆥𑆖𑆵𑆪𑆠𑆼 𑆯𑆵𑆔𑇀𑆫𑆨𑆼𑆢𑆽𑆂 𑆱𑇀𑆦𑆾𑆛𑆑𑆽𑆱𑇀𑆠𑆤𑆶𑆨𑆴𑆫𑆫𑆶𑆟𑆳𑆨𑆽𑆂 𑆯𑇀𑆪𑆳𑆮𑆽𑆫𑇀𑆮𑆳 𑆠𑆤𑆶𑆮𑆴𑆯𑆢𑆳𑆫𑆶𑆟𑆳𑆬𑇀𑆥𑆳𑆱𑇀𑆫𑆳𑆮𑆽𑆂, 𑆮𑆴𑆧𑆢𑇀𑆣𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆖𑆾𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆮𑆳𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆂𑇆𑇓𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆰𑇀𑆟𑆾𑆥𑆖𑆳𑆫𑆼𑆟 𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆩𑇀𑆬𑆳𑆯𑆤𑆽𑆯𑇀𑆖𑆴𑆠𑆩𑇀𑇅 𑆢𑆷𑆰𑇀𑆪𑆳𑆤𑇀 𑆱𑆤𑇀𑆢𑆷𑆰𑇀𑆪 𑆣𑆩𑆤𑆵𑆂 𑆥𑆷𑆫𑆪𑆤𑇀 𑆮𑆽 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴𑇆𑇓𑇑𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆩𑆾𑆲𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆫𑆾𑆖𑆑𑆾𑇁𑆕𑇀𑆓𑆨𑆼𑆢𑆂 𑆱𑇀𑆮𑆼𑆢𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆂 𑆯𑆴𑆫𑆾𑆫𑆶𑆑𑇀 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑆳𑆑𑆶𑆬𑆠𑇀𑆮𑆩𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆫𑆠𑆴𑆫𑇀𑆨𑇀𑆫𑆩𑆂 𑆯𑆵𑆠𑆮𑆳𑆠𑆮𑆳𑆫𑆴𑆠𑆫𑇀𑆰𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆁 𑆖, 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆳𑆮𑆑𑆳𑆯𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆾𑇁𑆤𑆶𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆾𑇁𑆮𑆑𑆳𑆯𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆤𑆵𑆬𑆑𑆸𑆰𑇀𑆟𑆫𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆥𑆶𑆰𑇀𑆪𑆠𑆴, 𑆱𑆾𑆠𑇀𑆱𑆼𑆣𑆽𑆯𑇀𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆢𑆳𑆲𑆱𑆩𑇀𑆨𑆼𑆢𑆤𑆥𑆫𑆵𑆠𑆽𑆂 𑆱𑇀𑆦𑆾𑆛𑆑𑆽𑆫𑆶𑆥𑆖𑆵𑆪𑆠𑆼 𑆠𑆶𑆬𑇀𑆪𑆮𑆫𑇀𑆟𑆳𑆱𑇀𑆫𑆳𑆮𑆽𑆯𑇀𑆖𑆴𑆫𑆥𑆳𑆑𑆽𑆯𑇀𑆖, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆖𑆾𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆂𑇆𑇓𑇒𑇆
𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆚𑇀𑆖𑆴𑆠𑆂𑇅 𑆑𑆦𑆂 𑆱𑆤𑇀𑆢𑆷𑆰𑆪𑆤𑇀 𑆢𑆷𑆰𑇀𑆪𑆳𑆤𑇀 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆩𑆕𑇀𑆓𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴𑇆𑇓𑇓𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆯𑆵𑆠𑆑𑆂 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆾 𑆓𑆿𑆫𑆮𑆁 𑆤𑆴𑆢𑇀𑆫𑆳 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑇁𑆫𑆾𑆖𑆑𑆾 𑆩𑆣𑆶𑆫𑆳𑆱𑇀𑆪𑆠𑇀𑆮𑆩𑆳𑆱𑇀𑆪𑆾𑆥𑆬𑆼𑆥𑆾 𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆴𑆑𑆳 𑆗𑆫𑇀𑆢𑆴𑆫𑆳𑆬𑆱𑇀𑆪𑆁 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆤𑆳𑆯𑆾 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆖, 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆳𑆮𑆑𑆳𑆯𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆾𑇁𑆤𑆶𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆾𑇁𑆮𑆑𑆳𑆯𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆳𑆤𑇀 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑇀𑆤𑆳𑆠𑆴𑆫𑆑𑇀𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑆶𑆥𑇀𑆠𑆴𑆱𑇀𑆠𑆩𑇀𑆨𑆓𑆿𑆫𑆮𑆽𑆫𑆤𑇀𑆮𑆴𑆠𑆾𑇁𑆬𑇀𑆥𑆮𑆼𑆢𑆤𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆥𑆳𑆑𑆽𑆯𑇀𑆖𑆴𑆫𑆑𑆳𑆫𑆴𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆬𑆠𑇀𑆮𑆓𑆶𑆥𑆬𑆼𑆥𑆽𑆂 𑆱𑇀𑆦𑆾𑆛𑆂 𑆯𑇀𑆮𑆼𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆨𑆴𑆫𑆤𑆶𑆧𑆣𑇀𑆪𑆠𑆼, 𑆥𑇀𑆫𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆠𑆶 𑆯𑇀𑆮𑆼𑆠𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆠𑆤𑇀𑆠𑆶𑆩𑆢𑇀𑆣𑆤𑆩𑆤𑆶𑆧𑆢𑇀𑆣𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆱𑇀𑆫𑆮𑆠𑆴, 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆓𑆶𑆫𑆶𑆨𑆴𑆂 𑆱𑇀𑆡𑆴𑆫𑆽𑆫𑇀𑆘𑆳𑆬𑆳𑆮𑆠𑆠𑆽𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑇀𑆧𑆲𑆶𑆬𑆠𑇀𑆮𑆓𑆶𑆥𑆬𑆼𑆥𑆽𑆫𑇀𑆮𑇀𑆫𑆟𑆽𑆫𑆤𑆶𑆧𑆣𑇀𑆪𑆠𑆼𑇁𑆤𑆶𑆰𑆕𑇀𑆓𑆵 𑆖 𑆨𑆮𑆠𑆴, 𑆯𑇀𑆮𑆼𑆠𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆖𑆾𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆱𑆫𑇀𑆥𑆂𑇆𑇓𑇔𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆱𑇀𑆮𑆲𑆼𑆠𑆶𑆨𑆴𑆂𑇅 𑆥𑆫𑆱𑇀𑆥𑆫𑆁 𑆬𑆧𑇀𑆣𑆧𑆬𑆁 𑆢𑆲𑆢𑇀𑆓𑆳𑆠𑇀𑆫𑆁 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴𑇆𑇓𑇕𑇆
𑆠𑆢𑆶𑆥𑆠𑆳𑆥𑆳𑆢𑆳𑆠𑆶𑆫𑆂 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆩𑆕𑇀𑆓𑆳𑆫𑆽𑆫𑆴𑆮𑆳𑆑𑆵𑆫𑇀𑆪𑆩𑆳𑆟𑆁 𑆩𑆤𑇀𑆪𑆠𑆼, 𑆗𑆫𑇀𑆢𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆳𑆲𑆩𑆾𑆲𑆘𑇀𑆮𑆫𑆠𑆩𑆑𑆳𑆫𑆾𑆖𑆑𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆨𑆼𑆢𑆠𑆸𑆰𑇀𑆟𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆕𑇀𑆓𑆨𑆼𑆢𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖𑆳𑆨𑆴𑆨𑆷𑆪𑆠𑆼, 𑆪𑆁 𑆪𑆁 𑆖𑆳𑆮𑆑𑆳𑆯𑆁 𑆮𑆴𑆱𑆫𑇀𑆥𑆾𑇁𑆤𑆶𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆾𑇁𑆮𑆑𑆳𑆯𑆂 𑆯𑆳𑆤𑇀𑆠𑆳𑆕𑇀𑆓𑆳𑆫𑆥𑇀𑆫𑆑𑆳𑆯𑆾𑇁𑆠𑆴𑆫𑆑𑇀𑆠𑆾 𑆮𑆳 𑆨𑆮𑆠𑆴, 𑆃𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆥𑇀𑆫𑆑𑆳𑆫𑆽𑆯𑇀𑆖 𑆱𑇀𑆦𑆾𑆛𑆽𑆫𑆶𑆥𑆖𑆵𑆪𑆠𑆼, 𑆱 𑆯𑆵𑆔𑇀𑆫𑆓𑆠𑇀𑆮𑆳𑆢𑆳𑆯𑇀𑆮𑆼𑆮 𑆩𑆫𑇀𑆩𑆳𑆤𑆶𑆱𑆳𑆫𑆵 𑆨𑆮𑆠𑆴, 𑆩𑆫𑇀𑆩𑆟𑆴 𑆖𑆾𑆥𑆠𑆥𑇀𑆠𑆼 𑆥𑆮𑆤𑆾𑇁𑆠𑆴𑆧𑆬𑆾 𑆨𑆴𑆤𑆠𑇀𑆠𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆩𑆾𑆲𑆪𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁, 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆿 𑆘𑆤𑆪𑆠𑆴, 𑆤𑆳𑆯𑆪𑆠𑆴 𑆤𑆴𑆢𑇀𑆫𑆳𑆁, 𑆱 𑆤𑆰𑇀𑆛𑆤𑆴𑆢𑇀𑆫𑆂 𑆥𑇀𑆫𑆩𑆷𑆞𑆱𑆚𑇀𑆘𑇀𑆚𑆾 𑆮𑇀𑆪𑆡𑆴𑆠𑆖𑆼𑆠𑆳 𑆤 𑆑𑇀𑆮𑆖𑆤 𑆱𑆶𑆒𑆩𑆶𑆥𑆬𑆨𑆠𑆼, 𑆃𑆫𑆠𑆴𑆥𑆫𑆵𑆠𑆂 𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆳𑆱𑆤𑆳𑆖𑇀𑆗𑆪𑇀𑆪𑆳𑆁 𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆠𑆴, 𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆯𑇀𑆖𑆳𑆯𑆶 𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆨𑆘𑆠𑆴, 𑆢𑆶𑆫𑇀𑆧𑆬𑆾 𑆢𑆶𑆂𑆒𑆥𑇀𑆫𑆧𑆾𑆣𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆠𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆩𑆓𑇀𑆤𑆴𑆮𑆴𑆱𑆫𑇀𑆥𑆥𑆫𑆵𑆠𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇖𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑇀𑆠𑆁 𑆧𑆬𑆮𑆠𑇀 𑆱𑇀𑆮𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳𑇅 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑇀𑆪𑆼𑆑𑆢𑆼𑆯𑆼 𑆠𑆶 𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆪𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇗𑇆
𑆠𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆂- 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆂 𑆯𑆴𑆫𑆾𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆢𑆳𑆲𑆂 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆩𑆕𑇀𑆓𑆳𑆮𑆱𑆢𑆤𑆁 𑆤𑆴𑆢𑇀𑆫𑆳 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆩𑆾𑆲𑆾𑇁𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆾𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑆯𑆾 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆱𑇀𑆡𑆴𑆨𑆼𑆢𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑆴𑆥𑆳𑆱𑆳 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆘𑆳𑆝𑇀𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆪𑆾𑆥𑆮𑆼𑆯𑆤𑆩𑆕𑇀𑆓𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾𑇁𑆫𑆠𑆴𑆫𑆿𑆠𑇀𑆱𑆶𑆑𑇀𑆪𑆁 𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼, 𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆳𑆩𑆳𑆯𑆪𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑇀𑆪𑆬𑆱𑆑 𑆍𑆑𑆢𑆼𑆯𑆓𑇀𑆫𑆳𑆲𑆵 𑆖, 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆳𑆮𑆑𑆳𑆯𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆾 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆾𑇁𑆮𑆑𑆳𑆯𑆾 𑆫𑆑𑇀𑆠𑆥𑆵𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆥𑆴𑆝𑆑𑆳𑆮𑆑𑆵𑆫𑇀𑆟 𑆅𑆮 𑆩𑆼𑆖𑆑𑆳𑆨𑆂 𑆑𑆳𑆬𑆾 𑆩𑆬𑆴𑆤𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆧𑆲𑆷𑆰𑇀𑆩𑆳 𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆮𑆼𑆢𑆤𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆳𑆤𑇀 𑆓𑆩𑇀𑆨𑆵𑆫𑆥𑆳𑆑𑆾 𑆤𑆴𑆫𑆳𑆱𑇀𑆫𑆳𑆮𑆂 𑆯𑆵𑆔𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆂 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆠𑇀𑆮𑆑𑇀 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆬𑇀𑆥𑆫𑆶𑆑𑇀 𑆥𑆫𑆳𑆩𑆸𑆰𑇀𑆛𑆾𑇁𑆮𑆢𑆵𑆫𑇀𑆪𑆠𑆼 𑆑𑆫𑇀𑆢𑆩 𑆅𑆮𑆳𑆮𑆥𑆵𑆝𑆴𑆠𑆾𑇁𑆤𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆠𑇀𑆪𑆶𑆥𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆠𑇀𑆪𑆳𑆓𑆵 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆢𑆫𑇀𑆯𑆵 𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑆵 𑆖 𑆨𑆮𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆱𑇀𑆩𑆸𑆠𑆴𑆲𑆤𑇀𑆠𑆳 𑆖; 𑆠𑆁 𑆑𑆫𑇀𑆢𑆩𑆮𑆴𑆱𑆫𑇀𑆥𑆥𑆫𑆵𑆠𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇘𑇆
𑆱𑇀𑆡𑆴𑆫𑆓𑆶𑆫𑆶𑆑𑆜𑆴𑆤𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆱𑆼𑆮𑆴𑆤𑆳𑆩𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆴𑆱𑆼𑆮𑆴𑆤𑆳𑆩𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆯𑆵𑆬𑆳𑆤𑆳𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆮𑆳𑆪𑆶𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆳𑆮𑆶𑆨𑆿 𑆢𑆶𑆰𑇀𑆛𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆮𑆠𑆴𑆧𑆬𑆿 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆢𑆷𑆰𑇀𑆪𑆳𑆤𑇀 𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆪 𑆑𑆬𑇀𑆥𑆼𑆠𑆼; 𑆠𑆠𑇀𑆫 𑆮𑆳𑆪𑆶𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆱𑇀𑆠𑆩𑆼𑆮 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆤𑆼𑆑𑆣𑆳 𑆨𑆴𑆤𑇀𑆢𑆤𑇀 𑆑𑇀𑆫𑆩𑆼𑆟 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆩𑆳𑆬𑆳𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆥𑆳𑆑𑆱𑆳𑆣𑇀𑆪𑆳𑆁 𑆑𑆦𑆳𑆯𑆪𑆼 𑆱𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆇𑆠𑇀𑆱𑆤𑇀𑆤𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆳 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆫𑆑𑇀𑆠𑆁 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆩𑆳𑆁𑆱𑆠𑇀𑆮𑆓𑆳𑆯𑇀𑆫𑆴𑆠𑆁 𑆓𑇀𑆫𑆤𑇀𑆡𑆵𑆤𑆳𑆁 𑆩𑆳𑆬𑆳𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆠𑆵𑆮𑇀𑆫𑆫𑆶𑆘𑆳𑆤𑆳𑆁 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑆳𑆩𑆟𑆷𑆤𑆳𑆁 𑆮𑆳 𑆢𑆵𑆫𑇀𑆔𑆮𑆸𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆤𑆳𑆁, 𑆠𑆢𑆶𑆥𑆠𑆳𑆥𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆳𑆠𑆴𑆱𑆳𑆫𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆰- 𑆥𑇀𑆫𑆩𑆾𑆲𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆱𑆼𑆑𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆕𑇀𑆓𑆨𑆕𑇀𑆓𑆤𑆴𑆢𑇀𑆫𑆳𑆫𑆠𑆴𑆱𑆢𑆤𑆳𑆢𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂; 𑆱 𑆍𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆮𑆴𑆰𑆪𑆩𑆠𑆴𑆥𑆠𑆴𑆠𑆾 𑆮𑆴𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆾 𑆨𑆮𑆠𑆵𑆠𑆴 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆮𑆴𑆱𑆫𑇀𑆥𑆂𑇆𑇓𑇙𑇆
𑆇𑆥𑆢𑇀𑆫𑆮𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆫𑆾𑆓𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆘𑆾 𑆫𑆾𑆓𑆳𑆯𑇀𑆫𑆪𑆾 𑆫𑆾𑆓 𑆍𑆮 𑆱𑇀𑆡𑆷𑆬𑆾𑇁𑆟𑆶𑆫𑇀𑆮𑆳, 𑆫𑆾𑆓𑆳𑆠𑇀 𑆥𑆯𑇀𑆖𑆳𑆘𑇀𑆘𑆳𑆪𑆠 𑆅𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆂𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆣𑆳𑆤𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆂, 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆓𑆶𑆟𑆨𑆷𑆠 𑆇𑆥𑆢𑇀𑆫𑆮𑆂, 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆥𑇀𑆫𑆯𑆩𑆼 𑆥𑇀𑆫𑆯𑆩𑆾 𑆨𑆮𑆠𑆴𑇅 𑆱 𑆠𑆶 𑆥𑆵𑆝𑆳𑆑𑆫𑆠𑆫𑆾 𑆨𑆮𑆠𑆴 𑆥𑆯𑇀𑆖𑆳𑆢𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆴𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆁 𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆾𑇁𑆨𑆴𑆧𑆳𑆣𑆼𑆠𑇆𑇔𑇐𑇆
𑆱𑆫𑇀𑆮𑆳𑆪𑆠𑆤𑆱𑆩𑆶𑆠𑇀𑆡𑆁 𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆮𑇀𑆪𑆳𑆥𑆴𑆤𑆁 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑇀𑆮𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆩𑆳𑆯𑆶𑆑𑆳𑆫𑆴𑆟𑆁 𑆩𑆲𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆩𑆴𑆠𑆴 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇑𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂 𑆱𑆳𑆣𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆃𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆢𑆩𑆳𑆒𑇀𑆪𑆿 𑆥𑆶𑆤𑆫𑆤𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆩𑆫𑇀𑆩𑆟𑆴 𑆃𑆤𑆶𑆥𑆓𑆠𑆼 𑆮𑆳 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆩𑆳𑆁𑆱𑆑𑇀𑆬𑆼𑆢𑆼 𑆱𑆳𑆣𑆳𑆫𑆟𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆴𑆫𑆶𑆨𑆳𑆮𑆼𑆮𑆳𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆿 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆪𑆳𑆠𑆳𑆩𑇀, 𑆃𑆤𑆳𑆢𑆫𑆾𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆂 𑆥𑆶𑆤𑆱𑇀𑆠𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆾 𑆲𑆤𑇀𑆪𑆳𑆢𑇀𑆢𑆼𑆲𑆩𑆳𑆯𑇀𑆮𑆼𑆮𑆳𑆯𑆵𑆮𑆴𑆰𑆮𑆠𑇀; 𑆠𑆡𑆳 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆮𑆴𑆱𑆫𑇀𑆥𑆩𑆘𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆩𑆳𑆫𑆨𑆼𑆠 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆶𑆩𑇀, 𑆇𑆥𑆢𑇀𑆫𑆮𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆠𑇀𑆮𑆼𑆤𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑆁 𑆠𑆶 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑇀𑆮𑆤𑆶𑆱𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆢𑆳𑆯𑆶𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆱𑆳𑆣𑆤𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇔𑇓𑇆
𑆬𑆕𑇀𑆔𑆤𑆾𑆬𑇀𑆬𑆼𑆒𑆤𑆼 𑆯𑆱𑇀𑆠𑆼 𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆤𑆳𑆁 𑆖 𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼 𑆱𑆳𑆩𑆼 𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆽𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆪𑆼𑆠𑇀𑇆𑇔𑇔𑇆
𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼𑇁𑆥𑇀𑆪𑆼𑆠𑆠𑇀 𑆱𑆳𑆩𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪𑆳𑆮𑆱𑆼𑆑𑆁 𑆖 𑆮𑆴𑆫𑆼𑆑𑆁 𑆖 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇆𑇔𑇕𑇆
𑆩𑆳𑆫𑆶𑆠𑆳𑆯𑆪𑆱𑆩𑇀𑆨𑆷𑆠𑆼𑇁𑆥𑇀𑆪𑆳𑆢𑆴𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆮𑆪𑆼𑇁𑆥𑇀𑆪𑆳𑆢𑆿 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆤 𑆲𑆴𑆠𑆁 𑆩𑆠𑆩𑇀𑇆𑇔𑇖𑇆
𑆮𑆳𑆠𑆾𑆬𑇀𑆧𑆟𑆼 𑆠𑆴𑆑𑇀𑆠𑆔𑆸𑆠𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆖 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆬𑆔𑆶𑆢𑆾𑆰𑆼, 𑆩𑆲𑆳𑆢𑆾𑆰𑆼 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇔𑇗𑇆
𑆤 𑆔𑆸𑆠𑆁 𑆧𑆲𑆶𑆢𑆾𑆰𑆳𑆪 𑆢𑆼𑆪𑆁 𑆪𑆤𑇀𑆤 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆠𑆼𑆤 𑆢𑆾𑆰𑆾 𑆲𑇀𑆪𑆶𑆥𑆰𑇀𑆛𑆧𑇀𑆣𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆫𑆶𑆣𑆴𑆫𑆁 𑆥𑆖𑆼𑆠𑇀𑇆𑇔𑇘𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆑𑆩𑆼𑆮𑆳𑆢𑆿 𑆯𑆱𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆱𑆫𑇀𑆥𑆴𑆟𑆂𑇅 𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆪𑆳𑆮𑆱𑆼𑆑𑆁 𑆖 𑆠𑆢𑇀𑆣𑇀𑆪𑆱𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆩𑇀𑇆𑇔𑇙𑇆
𑆅𑆠𑆴 𑆮𑆵𑆱𑆫𑇀𑆥𑆤𑆶𑆠𑇀 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆁 𑆱𑆩𑆳𑆱𑆼𑆤 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆍𑆠𑆢𑆼𑆮 𑆥𑆶𑆤𑆂 𑆱𑆫𑇀𑆮𑆁 𑆮𑇀𑆪𑆳𑆱𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇕𑇐𑇆
𑆩𑆢𑆤𑆁 𑆩𑆣𑆶𑆑𑆁 𑆤𑆴𑆩𑇀𑆧𑆁 𑆮𑆠𑇀𑆱𑆑𑆱𑇀𑆪 𑆦𑆬𑆳𑆤𑆴 𑆖𑇅 𑆮𑆩𑆤𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆳𑆠𑆮𑇀𑆪𑆁 𑆮𑆴𑆱𑆫𑇀𑆥𑆼 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆘𑆼𑇆𑇕𑇑𑇆
𑆥𑆛𑆾𑆬𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳 𑆩𑆢𑆤𑆼𑆤 𑆖𑇅 𑆮𑆴𑆱𑆫𑇀𑆥𑆼 𑆮𑆩𑆤𑆁 𑆯𑆱𑇀𑆠𑆁 𑆠𑆡𑆳 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆽𑆂 𑆱𑆲𑇆𑇕𑇒𑇆
𑆪𑆳𑆁𑆯𑇀𑆖 𑆪𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆨𑆴 𑆑𑆬𑇀𑆥𑆼𑆰𑆶 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆳𑆩𑇀𑇅 𑆮𑆴𑆱𑆫𑇀𑆥𑆴𑆟𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆱𑇀𑆠𑆼 𑆢𑆾𑆰𑆤𑆴𑆫𑇀𑆲𑆫𑆟𑆳𑆂 𑆯𑆴𑆮𑆳𑆂𑇆𑇕𑇓𑇆
𑆩𑆶𑆱𑇀𑆠𑆤𑆴𑆩𑇀𑆧𑆥𑆛𑆾𑆬𑆳𑆤𑆳𑆁 𑆖𑆤𑇀𑆢𑆤𑆾𑆠𑇀𑆥𑆬𑆪𑆾𑆫𑆥𑆴𑇅 𑆱𑆳𑆫𑆴𑆮𑆳𑆩𑆬𑆑𑆾𑆯𑆵𑆫𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇆𑇕𑇔𑇆
𑆑𑆰𑆳𑆪𑆳𑆤𑇀 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆮𑆵𑆱𑆫𑇀𑆥𑆤𑆳𑆯𑆤𑆳𑆤𑇀𑇅 𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆬𑆾𑆣𑇀𑆫𑆁 𑆖𑆤𑇀𑆢𑆤𑆁 𑆱𑆢𑆶𑆫𑆳𑆬𑆨𑆩𑇀𑇆𑇕𑇕𑇆
𑆤𑆳𑆓𑆫𑆁 𑆥𑆢𑇀𑆩𑆑𑆴𑆚𑇀𑆘𑆬𑇀𑆑𑆩𑆶𑆠𑇀𑆥𑆬𑆁 𑆱𑆧𑆴𑆨𑆵𑆠𑆑𑆩𑇀𑇅 𑆩𑆣𑆶𑆑𑆁 𑆤𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆁 𑆖 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆵𑆱𑆫𑇀𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇆𑇕𑇖𑇆
𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆩𑆣𑆶𑆑𑆁 𑆥𑆢𑇀𑆩𑆑𑆴𑆚𑇀𑆘𑆬𑇀𑆑𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀𑇅 𑆤𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆁 𑆖 𑆬𑆾𑆣𑇀𑆫𑆁 𑆖 𑆠𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇕𑇗𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆥𑆫𑇀𑆥𑆛𑆑𑆁 𑆯𑆶𑆟𑇀𑆜𑆵𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆁 𑆣𑆤𑇀𑆮𑆪𑆳𑆱𑆑𑆩𑇀𑇅 𑆤𑆴𑆯𑆳𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆮𑆵𑆱𑆫𑇀𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇆𑇕𑇘𑇆

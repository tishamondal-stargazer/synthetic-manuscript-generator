𑆫𑆑𑇀𑆠𑆾 𑆩𑆳𑆬𑆳𑆓𑆶𑆟𑆳𑆢𑆁𑆯𑆾 𑆣𑆷𑆩𑆓𑆤𑇀𑆣𑆾𑇁𑆠𑆴𑆮𑆼𑆢𑆤𑆂 𑇅 𑆧𑆲𑆶𑆣𑆳 𑆖 𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆼𑆠 𑆢𑆳𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑆮𑆴𑆠𑆂 𑇆𑇑𑇒𑇗𑇆
𑆃𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑇀𑆮𑆥𑇀𑆪𑆨𑆴𑆲𑆴𑆠𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆳𑆯𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆢𑆾𑆰𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆢𑆳𑆲𑆖𑇀𑆗𑆼𑆢𑆮𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇆𑇑𑇒𑇘𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆨𑆴𑆫𑆳𑆨𑆴𑆫𑇀𑆬𑆷𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑆠𑇀𑆫𑆼𑆟 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆱𑆩𑇀𑆪𑆓𑆳𑆢𑆁𑆯𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀 𑇆𑇑𑇒𑇙𑇆
𑆃𑆩𑆫𑇀𑆩𑆟𑆴 𑆮𑆴𑆣𑆳𑆤𑆘𑇀𑆚𑆾 𑆮𑆫𑇀𑆘𑆴𑆠𑆱𑇀𑆪 𑆘𑇀𑆮𑆫𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆢𑆁𑆯𑆱𑇀𑆪𑆾𑆠𑇀𑆑𑆫𑇀𑆠𑆤𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆬𑇀𑆥𑆯𑇀𑆮𑆪𑆡𑆶𑆑𑆱𑇀𑆪 𑆖 𑇆𑇑𑇓𑇐𑇆
𑆩𑆣𑆶𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆓𑆢𑆽𑆫𑇀𑆬𑆼𑆥𑆪𑆼𑆠𑇀𑆠𑆠𑆂 𑇅 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆫𑆘𑆤𑆵𑆑𑆶𑆰𑇀𑆜𑆱𑆩𑆕𑇀𑆓𑆳𑆩𑆣𑆶𑆑𑆽𑆱𑇀𑆠𑆡𑆳 𑇆𑇑𑇓𑇑𑇆
𑆱𑆳𑆫𑆴𑆮𑆳𑆁 𑆩𑆣𑆶𑆑𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆥𑆪𑆱𑇀𑆪𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆾𑆫𑆛𑆩𑇀 𑇅 𑆮𑆴𑆢𑆳𑆫𑆵𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆣𑆶𑆑𑆁 𑆥𑆳𑆪𑆪𑆼𑆠 𑆮𑆳 𑇆𑇑𑇓𑇒𑇆
𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆳𑆁 𑆠𑇀𑆮𑆑𑇀𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆶𑆯𑆵𑆠𑆼𑆤 𑆖 𑆱𑆼𑆖𑆪𑆼𑆠𑇀 𑇅 𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆽𑆫𑆼𑆮 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇓𑇓𑇆
𑆤𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆥𑆳𑆤𑆣𑆷𑆩𑆁 𑆠𑆡𑆳𑇁𑆮𑆥𑆵𑆝𑆁 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆁 𑆖 𑇅 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆖𑆾𑆨𑆪𑆠𑆂 𑆥𑇀𑆫𑆓𑆳𑆞𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑆼𑆮 𑆖𑆳𑆠𑇀𑆫 𑇆𑇑𑇓𑇔𑇆
𑆑𑆵𑆛𑆢𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆳𑆤𑇀 𑆱𑆫𑇀𑆮𑆳𑆤𑆲𑆴𑆢𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆳𑆤𑆥𑆴 𑇅 𑆄𑆢𑆳𑆲𑆥𑆳𑆑𑆳𑆠𑇀𑆠𑆳𑆤𑇀 𑆱𑆫𑇀𑆮𑆳𑆚𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆮𑆢𑇀𑆨𑆴𑆰𑆓𑇀 𑇆𑇑𑇓𑇕𑇆
𑆮𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆼 𑆠𑆠𑆂 𑆯𑆾𑆦𑆼 𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆥𑆳𑆠𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆤𑆴𑆩𑇀𑆧𑆥𑆠𑇀𑆫𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑆤𑇀𑆠𑆵 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆁 𑆑𑆶𑆱𑆶𑆩𑆁 𑆩𑆣𑆶 𑇆𑇑𑇓𑇖𑇆
𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆂 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆑𑆴𑆟𑇀𑆮𑆁 𑆮𑆫𑇀𑆖𑆂 𑆥𑆳𑆫𑆳𑆮𑆠𑆱𑇀𑆪 𑆖 𑇅 𑆮𑆴𑆰𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆁 𑆖𑆳𑆤𑇀𑆤𑆁 𑆲𑆴𑆠𑇀𑆮𑆳 𑆱𑆩𑇀𑆨𑆾𑆘𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇆𑇑𑇓𑇗𑇆
𑆮𑆴𑆰𑆼𑆨𑇀𑆪𑆂 𑆒𑆬𑆶 𑆱𑆫𑇀𑆮𑆼𑆨𑇀𑆪𑆂 𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆩𑆫𑆶𑆘𑆳𑆁 𑆱𑇀𑆡𑆴𑆫𑆳𑆩𑇀 𑇅 𑆥𑇀𑆫𑆖𑇀𑆗𑆪𑆴𑆠𑇀𑆮𑆳 𑆩𑆣𑆷𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆽𑆂 𑆯𑆾𑆣𑆤𑆵𑆪𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇓𑇘𑇆
𑆱𑆥𑇀𑆠𑆰𑆰𑇀𑆜𑆱𑇀𑆪 𑆑𑆵𑆛𑆳𑆤𑆳𑆁 𑆯𑆠𑆱𑇀𑆪𑆽𑆠𑆢𑇀𑆮𑆴𑆨𑆳𑆓𑆯𑆂 𑇅 𑆢𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆖𑆳𑆥𑇀𑆪𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇆𑇑𑇓𑇙𑇆
𑆱𑆤𑆳𑆠𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆼𑆢𑆳𑆤𑆳𑆩𑆑𑇀𑆰𑆫𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆠𑆡𑆳 𑆢𑆸𑆰𑇀𑆛𑆦𑆬𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆲𑆴𑆠𑆠𑇀𑆮𑆳𑆢𑆥𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇆𑇑𑇔𑇑𑇆
𑆮𑆳𑆑𑇀𑆱𑆩𑆷𑆲𑆳𑆫𑇀𑆡𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆳𑆠𑇀 𑆥𑆷𑆘𑆴𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆢𑆼𑆲𑆴𑆨𑆴𑆂 𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆠𑇀 𑆥𑆶𑆟𑇀𑆪𑆠𑆩𑆁 𑆤 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆥𑆴 𑆯𑆶𑆯𑇀𑆫𑆶𑆩𑆂 𑇆𑇑𑇔𑇒𑇆
𑆉𑆰𑆼𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆪𑆳𑆩𑆸𑆠𑆪𑆾𑆤𑆼𑆫𑇀𑆨𑆴𑆰𑆓𑇀𑆓𑆶𑆫𑆾𑆂 𑇅 𑆣𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆮𑆴𑆩𑆬𑆁 𑆩𑆠𑆁 𑆥𑆫𑆩𑆱𑆩𑇀𑆩𑆠𑆩𑇀 𑇅 𑆇𑆑𑇀𑆠𑆳𑆲𑆳𑆫𑆱𑆩𑆳𑆖𑆳𑆫 𑆅𑆲 𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆖 𑆩𑆾𑆢𑆠𑆼 𑇆𑇑𑇔𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑇀𑆮𑆴𑆮𑇀𑆫𑆟𑆵𑆪𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑇀𑆮𑆿 𑆮𑇀𑆫𑆟𑆿 𑆨𑆮𑆠𑆂- 𑆯𑆳𑆫𑆵𑆫, 𑆄𑆓𑆤𑇀𑆠𑆶𑆯𑇀𑆖 𑇅 𑆠𑆪𑆾𑆂 𑆯𑆳𑆫𑆵𑆫𑆂 𑆥𑆮𑆤𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂; 𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑆥𑆴 𑆥𑆶𑆫𑆶𑆰𑆥𑆯𑆶𑆥𑆑𑇀𑆰𑆴𑆮𑇀𑆪𑆳𑆬𑆱𑆫𑆵𑆱𑆸𑆥𑆥𑇀𑆫𑆥𑆠𑆤𑆥𑆵𑆝𑆤𑆥𑇀𑆫𑆲𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆮𑆴𑆰𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆿𑆰𑆣𑆯𑆑𑆬𑆑𑆥𑆳𑆬𑆯𑆸𑆕𑇀𑆓- 𑆖𑆑𑇀𑆫𑆼𑆰𑆶𑆥𑆫𑆯𑆶𑆯𑆑𑇀𑆠𑆴𑆑𑆶𑆤𑇀𑆠𑆳𑆢𑇀𑆪𑆳𑆪𑆶𑆣𑆳𑆨𑆴𑆔𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆠𑆶𑆬𑇀𑆪𑆼 𑆮𑇀𑆫𑆟𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆼 𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆟𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆳𑆢𑇀 ‘𑆢𑇀𑆮𑆴𑆮𑇀𑆫𑆟𑆵𑆪’ 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮𑆳𑆓𑆤𑇀𑆠𑆶𑆮𑇀𑆫𑆟𑆼 𑆠𑆠𑇀𑆑𑆳𑆬𑆩𑆼𑆮 𑆑𑇀𑆰𑆠𑆾𑆰𑇀𑆩𑆟𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆱𑇀𑆪𑆾𑆥𑆯𑆩𑆳𑆫𑇀𑆡𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆖𑇀𑆗𑆵𑆠𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆖𑆳𑆫𑆟𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆖 𑆩𑆣𑆶𑆔𑆸𑆠𑆥𑇀𑆫𑆪𑆾𑆓 𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆟𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆩𑇀, 𑆇𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆠𑆶 𑆢𑆾𑆰𑆾𑆥𑆥𑇀𑆬𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆗𑆳𑆫𑆵𑆫𑆮𑆠𑇀 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 𑇆𑇔𑇆
𑆢𑆾𑆰𑆾𑆥𑆥𑇀𑆬𑆮𑆮𑆴𑆯𑆼𑆰𑆂 𑆥𑆶𑆤𑆂 𑆱𑆩𑆳𑆱𑆠𑆂 𑆥𑆚𑇀𑆖𑆢𑆯𑆥𑇀𑆫𑆑𑆳𑆫𑆂, 𑆥𑇀𑆫𑆱𑆫𑆟𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆳𑆠𑇀, 𑆪𑆡𑆾𑆑𑇀𑆠𑆾 𑆮𑇀𑆫𑆟𑆥𑇀𑆫𑆯𑇀𑆤𑆳𑆣𑆴𑆑𑆳𑆫𑆼; 𑆯𑆶𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀 𑆰𑆾𑆝𑆯𑆥𑇀𑆫𑆑𑆳𑆫 𑆅𑆠𑇀𑆪𑆼𑆑𑆼 𑇆𑇕𑇆
𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁- 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁, 𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆁 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆫𑆶𑆑𑇀 𑇅 ‘𑆮𑇀𑆫𑆟’ 𑆓𑆳𑆠𑇀𑆫𑆮𑆴𑆖𑆷𑆫𑇀𑆟𑆤𑆼, 𑆮𑇀𑆫𑆟𑆪𑆠𑆵𑆠𑆴 𑆮𑇀𑆫𑆟𑆂 𑇅 𑆮𑆴𑆯𑆼𑆰𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆠𑆳𑆢𑆴𑆬𑆴𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆂 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆳𑆨𑆱𑇀𑆠𑆤𑆶𑆂 𑆯𑆵𑆠𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆾𑇁𑆬𑇀𑆥𑆱𑇀𑆫𑆳𑆮𑆵 𑆫𑆷𑆑𑇀𑆰𑆯𑇀𑆖𑆛𑆖𑆛𑆳𑆪𑆤𑆯𑆵𑆬𑆂 𑆱𑇀𑆦𑆶𑆫𑆟𑆳𑆪𑆳𑆩𑆠𑆾𑆢𑆨𑆼𑆢𑆮𑆼𑆢𑆤𑆳𑆧𑆲𑆶𑆬𑆾 𑆤𑆴𑆫𑇀𑆩𑆳𑆁𑆱𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆳𑆠𑇀, 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆘𑆂 𑆥𑆵𑆠𑆤𑆵𑆬𑆳𑆨𑆂 𑆑𑆴𑆁𑆯𑆶𑆑𑆾𑆢𑆑𑆳𑆨𑆾𑆰𑇀𑆟𑆱𑇀𑆫𑆳𑆮𑆵 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆮𑆴𑆑𑆳𑆫𑆑𑆳𑆫𑆵 𑆥𑆵𑆠𑆥𑆴𑆝𑆑𑆳𑆘𑆶𑆰𑇀𑆛𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀, 𑆥𑇀𑆫𑆠𑆠𑆖𑆟𑇀𑆝𑆑𑆟𑇀𑆝𑆷𑆧𑆲𑆶𑆬𑆂 𑆱𑇀𑆡𑆷𑆬𑆿𑆰𑇀𑆜𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆘𑆳𑆬𑆳𑆮𑆠𑆠𑆂 𑆑𑆜𑆴𑆤𑆂 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆮𑆨𑆳𑆱𑆾 𑆩𑆤𑇀𑆢𑆮𑆼𑆢𑆤𑆂 𑆯𑆶𑆑𑇀𑆬𑆯𑆵𑆠𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆵 𑆓𑆶𑆫𑆶𑆯𑇀𑆖𑆼𑆠𑆴 𑆑𑆦𑆳𑆠𑇀, 𑆥𑇀𑆫𑆮𑆳𑆬𑆢𑆬𑆤𑆴𑆖𑆪𑆥𑇀𑆫𑆑𑆳𑆯𑆂 𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆦𑆾𑆛𑆥𑆴𑆝𑆑𑆳𑆘𑆳𑆬𑆾𑆥𑆖𑆴𑆠𑆱𑇀𑆠𑆶𑆫𑆕𑇀𑆓𑆱𑇀𑆡𑆳𑆤𑆓𑆤𑇀𑆣𑆴𑆂 𑆱𑆮𑆼𑆢𑆤𑆾 𑆣𑆷𑆩𑆳𑆪𑆤𑆯𑆵𑆬𑆾 𑆫𑆑𑇀𑆠𑆱𑇀𑆫𑆳𑆮𑆵 𑆥𑆴𑆠𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑆫𑆑𑇀𑆠𑆳𑆠𑇀, 𑆠𑆾𑆢𑆢𑆳𑆲𑆣𑆷𑆩𑆳𑆪𑆤𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆵𑆠𑆳𑆫𑆶𑆟𑆳𑆨𑆱𑇀𑆠𑆢𑇀𑆮𑆫𑇀𑆟𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆑𑆟𑇀𑆝𑆷𑆪𑆤𑆯𑆵𑆬𑆂 𑆱𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆾 𑆫𑆷𑆑𑇀𑆰𑆾 𑆓𑆶𑆫𑆶𑆫𑇀𑆢𑆳𑆫𑆶𑆟𑆾 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆯𑆵𑆠𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆬𑇀𑆥𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆨𑇀𑆪𑆳𑆁, 𑆓𑆶𑆫𑆶𑆂 𑆱𑆢𑆳𑆲 𑆇𑆰𑇀𑆟𑆂 𑆥𑆵𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆨𑇀𑆪𑆳𑆁, 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆠𑆤𑆶𑆱𑇀𑆠𑆾𑆢𑆧𑆲𑆶𑆬𑆂 𑆱𑆶𑆥𑇀𑆠 𑆅𑆮 𑆖 𑆫𑆑𑇀𑆠𑆳𑆫𑆶𑆟𑆳𑆨𑆱𑇀𑆠𑆢𑇀𑆮𑆫𑇀𑆟𑆳𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆳𑆨𑆾 𑆩𑆵𑆤𑆣𑆳𑆮𑆤𑆠𑆾𑆪𑆓𑆤𑇀𑆣𑆴𑆫𑇀𑆩𑆸𑆢𑆶𑆫𑇀𑆮𑆴𑆱𑆫𑇀𑆥𑇀𑆪𑆶𑆰𑇀𑆟𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆫𑆑𑇀𑆠𑆾 𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆂 𑆑𑆟𑇀𑆝𑆷𑆥𑇀𑆫𑆳𑆪𑆂 𑆱𑇀𑆡𑆴𑆫𑆾 𑆱𑆫𑆑𑇀𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆟𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆱𑇀𑆦𑆶𑆫𑆟𑆠𑆾𑆢𑆢𑆳𑆲𑆣𑆷𑆩𑆳𑆪𑆤𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆵𑆠𑆠𑆤𑆶𑆫𑆑𑇀𑆠𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆼𑆨𑇀𑆪𑆂, 𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆦𑆶𑆫𑆟𑆖𑆶𑆩𑆖𑆶𑆩𑆳𑆪𑆩𑆳𑆤𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆔𑆤𑆫𑆑𑇀𑆠𑆳𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆟𑆴𑆠𑆼𑆨𑇀𑆪𑆂, 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆑𑆟𑇀𑆝𑆷𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆔𑆤𑆫𑆑𑇀𑆠𑆳𑆱𑇀𑆫𑆳𑆮𑆵 𑆖𑆼𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆟𑆴𑆠𑆼𑆨𑇀𑆪𑆂, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆫𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆾𑆥𑆼𑆠𑆂 𑆥𑆮𑆤𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆼𑆨𑇀𑆪𑆂, 𑆤𑆴𑆫𑇀𑆢𑆲𑆤𑆤𑆴𑆫𑇀𑆩𑆡𑆤𑆱𑇀𑆦𑆶𑆫𑆟𑆠𑆾𑆢𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆮𑆳𑆥𑆧𑆲𑆶𑆬𑆾 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆫𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆾𑆥𑆼𑆠𑆂 𑆥𑆮𑆤𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆼𑆨𑇀𑆪𑆂, 𑆘𑆴𑆲𑇀𑆮𑆳𑆠𑆬𑆳𑆨𑆾 𑆩𑆸𑆢𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆾 𑆮𑆴𑆓𑆠𑆮𑆼𑆢𑆤𑆂 𑆱𑆶𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆾 𑆤𑆴𑆫𑆳𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑆶𑆢𑇀𑆣𑆾 𑆮𑇀𑆫𑆟 𑆅𑆠𑆴 𑇆𑇗𑇆
𑆠𑆱𑇀𑆪 𑆮𑇀𑆫𑆟𑆱𑇀𑆪 𑆰𑆰𑇀𑆛𑆴𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆥𑆠𑆫𑇀𑆥𑆟𑆩𑆳𑆬𑆼𑆥𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆾𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆂 𑆱𑇀𑆮𑆼𑆢𑆾 𑆮𑆴𑆩𑇀𑆬𑆳𑆥𑆤𑆩𑆶𑆥𑆤𑆳𑆲𑆂 𑆥𑆳𑆖𑆤𑆁 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆁 𑆱𑇀𑆤𑆼𑆲𑆾 𑆮𑆩𑆤𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆗𑆼𑆢𑆤𑆁 𑆨𑆼𑆢𑆤𑆁 𑆢𑆳𑆫𑆟𑆁 𑆬𑆼𑆒𑆤𑆩𑆼𑆰𑆟𑆩𑆳𑆲𑆫𑆟𑆁 𑆮𑇀𑆪𑆣𑆤𑆁 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆁 𑆱𑆵𑆮𑆤𑆁 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆥𑆵𑆝𑆤𑆁 𑆯𑆾𑆟𑆴𑆠𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆟𑆩𑆶𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳 𑆑𑆰𑆳𑆪𑆾 𑆮𑆫𑇀𑆠𑆴𑆂 𑆑𑆬𑇀𑆑𑆂 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑇁𑆮𑆖𑆷𑆫𑇀𑆟𑆤𑆁 𑆮𑇀𑆫𑆟𑆣𑆷𑆥𑆤𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆩𑆮𑆱𑆳𑆢𑆤𑆁 𑆩𑆸𑆢𑆶𑆑𑆫𑇀𑆩 𑆢𑆳𑆫𑆶𑆟𑆑𑆫𑇀𑆩 𑆑𑇀𑆰𑆳𑆫𑆑𑆫𑇀𑆩𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩 𑆑𑆸𑆰𑇀𑆟𑆑𑆫𑇀𑆩 𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆁 𑆫𑆾𑆩𑆱𑆚𑇀𑆘𑆤𑆤𑆁 𑆬𑆾𑆩𑆳𑆥𑆲𑆫𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆾𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆧𑆤𑇀𑆣𑆂 𑆥𑆠𑇀𑆫𑆢𑆳𑆤𑆁 𑆑𑆸𑆩𑆴𑆔𑇀𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆁 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆤𑆱𑇀𑆪𑆁 𑆑𑆮𑆬𑆣𑆳𑆫𑆟𑆁 𑆣𑆷𑆩𑆾 𑆩𑆣𑆶 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆳𑆲𑆳𑆫𑆾 𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑇆𑇘𑇆
𑆠𑆼𑆰𑆶 𑆑𑆰𑆳𑆪𑆾 𑆮𑆫𑇀𑆠𑆴𑆂 𑆑𑆬𑇀𑆑𑆂 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑇁𑆮𑆖𑆷𑆫𑇀𑆟𑆤𑆩𑆴𑆠𑆴 𑆯𑆾𑆣𑆤𑆫𑆾𑆥𑆟𑆳𑆤𑆴, 𑆠𑆼𑆰𑇀𑆮𑆰𑇀𑆛𑆿 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂, 𑆯𑆾𑆟𑆴𑆠𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆑𑇀𑆰𑆳𑆫𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆳𑆲𑆳𑆫𑆾 𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆳𑆤𑆁 𑆧𑆤𑇀𑆣𑆮𑆴𑆣𑆳𑆤𑆁 𑆖𑆾𑆑𑇀𑆠𑆳𑆤𑆴, 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆤𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆤𑆱𑇀𑆪𑆣𑆷𑆩𑆑𑆮𑆬𑆣𑆳𑆫𑆟𑆳𑆤𑇀𑆪𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 , 𑆪𑆢𑆤𑇀𑆪𑆢𑆮𑆯𑆴𑆰𑇀𑆛𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆘𑆳𑆠𑆁 𑆠𑆢𑆴𑆲 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇙𑇆
𑆃𑆥𑆠𑆫𑇀𑆥𑆟𑆩𑆳𑆢𑇀𑆪 𑆇𑆥𑆑𑇀𑆫𑆩𑆂; 𑆍𑆰 𑆱𑆫𑇀𑆮𑆯𑆾𑆦𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆯𑇀𑆖 𑇆𑇑𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 - 𑆢𑆾𑆰𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆾𑆰𑆳𑆤𑆢𑇀𑆣𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆃𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆳𑆟𑆁 𑆖 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑆥𑆠𑆫𑇀𑆥𑆟𑆩𑇀 𑇆𑇑𑇒𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆫𑆶𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆑𑇀𑆰𑆶𑆤𑇀𑆩𑆶𑆒𑆯𑆾𑆰𑆯𑇀𑆫𑆩𑆳𑆤𑇀𑆮𑆴𑆠𑆽𑆂 𑇅 𑆤 𑆑𑆳𑆫𑇀𑆪𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆮𑆸𑆢𑇀𑆣𑆧𑆳𑆬𑆢𑆶𑆫𑇀𑆧𑆬𑆨𑆵𑆫𑆶𑆨𑆴𑆂 𑇆𑇑𑇓𑇆
𑆯𑆾𑆦𑆼𑆰𑆷𑆠𑇀𑆡𑆴𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆮𑇀𑆫𑆟𑆼𑆰𑆷𑆓𑇀𑆫𑆫𑆶𑆘𑆼𑆰𑆶 𑆖 𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆽𑆫𑆿𑆰𑆣𑆽𑆫𑇀𑆬𑆼𑆥𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆯𑇀𑆪𑆼𑆤 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆪𑆡𑆳 𑆥𑇀𑆫𑆮𑆘𑇀𑆮𑆬𑆴𑆠𑆼 𑆮𑆼𑆯𑇀𑆩𑆤𑇀𑆪𑆩𑇀𑆨𑆱𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆤𑆩𑇀 𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆥𑇀𑆫𑆯𑆩𑆪𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆼𑆮𑆩𑆳𑆬𑆼𑆥𑆤𑆁 𑆫𑆶𑆘𑆂 𑇆𑇑𑇕𑇆
𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆤𑆼 𑆯𑆾𑆣𑆤𑆼 𑆖 𑆯𑆾𑆦𑆱𑇀𑆪 𑆲𑆫𑆟𑆼 𑆠𑆡𑆳 𑇅 𑆇𑆠𑇀𑆱𑆳𑆢𑆤𑆼 𑆫𑆾𑆥𑆟𑆼 𑆖 𑆬𑆼𑆥𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆶 𑆠𑆢𑆫𑇀𑆡𑆑𑆸𑆠𑇀 𑇆𑇑𑇖𑇆
𑆮𑆳𑆠𑆯𑆾𑆦𑆼 𑆠𑆶 𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆩𑆳𑆫𑇀𑆡𑆁 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆩𑆳𑆁𑆱𑆫𑆱𑆮𑆳𑆠𑆲𑆫𑆿𑆰𑆣𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑆽𑆫𑆯𑆵𑆠𑆽𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆰𑆶 𑆑𑇀𑆰𑆵𑆫𑆔𑆸𑆠𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆾𑆢𑆑𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑆽𑆫𑆤𑆶𑆰𑇀𑆟𑆽𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆦𑆼 𑆠𑆶 𑆠𑆽𑆬𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆱𑆶𑆫𑆳𑆯𑆶𑆑𑇀𑆠𑆑𑆦𑆔𑇀𑆤𑆿𑆰𑆣𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑆽𑆫𑆯𑆵𑆠𑆽𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇑𑇗𑇆
𑆪𑆡𑆳𑇁𑆩𑇀𑆧𑆶𑆨𑆴𑆂 𑆱𑆴𑆖𑇀𑆪𑆩𑆳𑆤𑆂 𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆓𑇀𑆤𑆴𑆫𑇀𑆤𑆴𑆪𑆖𑇀𑆗𑆠𑆴 𑇅 𑆢𑆾𑆰𑆳𑆓𑇀𑆤𑆴𑆫𑆼𑆮𑆁 𑆱𑆲𑆱𑆳 𑆥𑆫𑆴𑆰𑆼𑆑𑆼𑆟 𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑇆𑇑𑇘𑇆
𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆩𑆳𑆬𑆾𑆑𑇀𑆪𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆾 𑆢𑆾𑆰𑆾𑆥𑆯𑆩𑆁 𑆩𑆸𑆢𑆶𑆠𑆳𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴 𑇆𑇑𑇙𑇆
𑆱𑇀𑆮𑆼𑆢𑆮𑆴𑆩𑇀𑆬𑆳𑆥𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆑𑇀 𑆱 𑆇𑆖𑇀𑆪𑆠𑆼 𑇅 𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆑𑆫𑇀𑆩𑆱𑆶 𑆖𑆳𑆢𑆴𑆰𑇀𑆛𑆂 𑆱 𑆖 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆢𑆴𑆰𑆶 𑇆𑇒𑇐𑇆
𑆫𑆶𑆘𑆳𑆮𑆠𑆳𑆁 𑆢𑆳𑆫𑆶𑆟𑆳𑆤𑆳𑆁 𑆑𑆜𑆴𑆤𑆳𑆤𑆳𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆯𑆾𑆦𑆳𑆤𑆳𑆁 𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆪𑆼 𑆖𑆳𑆥𑇀𑆪𑆼𑆮𑆁𑆮𑆴𑆣𑆳 𑆮𑇀𑆫𑆟𑆳𑆂 𑇆𑇒𑇑𑇆
𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆳𑆁 𑆫𑆶𑆘𑆠𑆳𑆁 𑆩𑆤𑇀𑆢𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆮𑆴𑆩𑇀𑆬𑆳𑆥𑆤𑆁 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆃𑆨𑇀𑆪𑆘𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆮𑆼𑆟𑆶𑆤𑆳𑆝𑇀𑆪𑆳 𑆠𑆠𑆂 𑆯𑆤𑆽𑆂 𑇆𑇒𑇒𑇆
𑆮𑆴𑆩𑆫𑇀𑆢𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆱𑇀𑆠𑆬𑆼𑆤𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆑𑆼𑆤 𑆮𑆳 𑇅 𑆯𑆾𑆦𑆪𑆾𑆫𑆶𑆥𑆤𑆳𑆲𑆁 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆳𑆩𑆮𑆴𑆢𑆓𑇀𑆣𑆪𑆾𑆂 𑇆𑇒𑇓𑇆
𑆃𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆯𑆩𑆁 𑆪𑆳𑆠𑆴 𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆥𑆳𑆑𑆩𑆼𑆠𑆴 𑆖 𑇅 𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑆤 𑆪𑆂 𑆯𑆾𑆦𑆾 𑆮𑆴𑆫𑆼𑆑𑆳𑆤𑇀𑆠𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆂 𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆪 𑆱𑆩𑇀𑆥𑆳𑆖𑆤𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑆩𑆳𑆲𑆸𑆠𑇀𑆪𑆿𑆰𑆣𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆢𑆣𑆴𑆠𑆑𑇀𑆫𑆱𑆶𑆫𑆳𑆯𑆶𑆑𑇀𑆠𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆽𑆫𑇀𑆪𑆾𑆘𑆴𑆠𑆳𑆤𑆴 𑆠𑆶 𑇆𑇒𑇕𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆬𑆮𑆟𑆵𑆑𑆸𑆠𑇀𑆪 𑆥𑆖𑆼𑆢𑆶𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆁 𑆯𑆶𑆨𑆳𑆩𑇀 𑇅 𑆱𑆽𑆫𑆟𑇀𑆝𑆥𑆠𑇀𑆫𑆪𑆳 𑆯𑆾𑆦𑆁 𑆤𑆳𑆲𑆪𑆼𑆢𑆶𑆰𑇀𑆟𑆪𑆳 𑆠𑆪𑆳 𑇆𑇒𑇖𑇆
𑆲𑆴𑆠𑆁 𑆱𑆩𑇀𑆨𑆾𑆘𑆤𑆁 𑆖𑆳𑆥𑆴 𑆥𑆳𑆑𑆳𑆪𑆳𑆨𑆴𑆩𑆶𑆒𑆾 𑆪𑆢𑆴 𑇅 𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆩𑆳𑆫𑇀𑆡𑆳𑆪 𑆠𑆡𑆳 𑆥𑆳𑆑𑆯𑆩𑆳𑆪 𑆖 𑇆𑇒𑇗𑇆
𑆃𑆖𑆴𑆫𑆾𑆠𑇀𑆥𑆠𑆴𑆠𑆼 𑆯𑆾𑆦𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆱𑆯𑆾𑆦𑆼 𑆑𑆜𑆴𑆤𑆼 𑆣𑇀𑆪𑆳𑆩𑆼 𑆱𑆫𑆑𑇀𑆠𑆼 𑆮𑆼𑆢𑆤𑆳𑆮𑆠𑆴 𑇆𑇒𑇘𑇆
𑆱𑆁𑆫𑆧𑇀𑆣𑆼 𑆮𑆴𑆰𑆩𑆼 𑆖𑆳𑆥𑆴 𑆮𑇀𑆫𑆟𑆼 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆱𑆮𑆴𑆰𑆼 𑆖 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆘𑆬𑆿𑆑𑆾𑆨𑆴𑆂 𑆥𑆢𑆽𑆱𑇀𑆠𑆡𑆳 𑇆𑇒𑇙𑇆
𑆮𑆼𑆢𑆤𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆳𑆑𑆱𑇀𑆪𑆳𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆪𑆼 𑆠𑆡𑆳 𑇅 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆟𑆳𑆁 𑆫𑆷𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆑𑆸𑆯𑆳𑆤𑆳𑆁 𑆮𑇀𑆫𑆟𑆯𑆾𑆰𑆴𑆟𑆳𑆩𑇀 𑇆𑇓𑇐𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆿𑆰𑆣𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆁 𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑇅 𑆇𑆠𑇀𑆱𑆤𑇀𑆤𑆩𑆳𑆁𑆱𑆯𑆾𑆦𑆼 𑆠𑆶 𑆑𑆦𑆘𑆶𑆰𑇀𑆛𑆼 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇓𑇑𑇆
𑆱𑆕𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆯𑇀𑆪𑆳(𑆣𑇀𑆪𑆳)𑆩𑆫𑆶𑆣𑆴𑆫𑆼 𑆮𑇀𑆫𑆟𑆼 𑆥𑇀𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅𑇓𑇒𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆼𑆰𑆶 𑆢𑆵𑆫𑇀𑆔𑆑𑆳𑆬𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆴𑆰𑆶 𑇆𑇓𑇒𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆮𑇀𑆫𑆟𑆼𑆰𑆶 𑆮𑇀𑆫𑆟𑆑𑆾𑆮𑆴𑆢𑆳𑆂 𑇅𑇓𑇓𑇅 𑆃𑆥𑆳𑆑𑆼𑆰𑆶 𑆠𑆶 𑆫𑆾𑆓𑆼𑆰𑆶 𑆑𑆜𑆴𑆤𑆼𑆰𑆶 𑆱𑇀𑆡𑆴𑆫𑆼𑆰𑆶 𑆖 𑇆𑇓𑇓𑇆
𑆱𑇀𑆤𑆳𑆪𑆶𑆑𑆾𑆡𑆳𑆢𑆴𑆰𑆶 𑆠𑆡𑆳 𑆖𑇀𑆗𑆼𑆢𑆤𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇅𑇓𑇔𑇅 𑆃𑆤𑇀𑆠𑆂𑆥𑆷𑆪𑆼𑆰𑇀𑆮𑆮𑆑𑇀𑆠𑇀𑆫𑆼𑆰𑆶 𑆠𑆡𑆽𑆮𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆮𑆠𑇀𑆱𑇀𑆮𑆥𑆴 𑇆𑇓𑇔𑇆
𑆓𑆠𑆴𑆩𑆠𑇀𑆱𑆶 𑆖 𑆫𑆾𑆓𑆼𑆰𑆶 𑆨𑆼𑆢𑆤𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇅𑇓𑇕𑇅 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆳𑆱𑆲𑆑𑇀𑆰𑆵𑆟𑆨𑆵𑆫𑆷𑆟𑆳𑆁 𑆪𑆾𑆰𑆴𑆠𑆳𑆩𑆥𑆴 𑇆𑇓𑇕𑇆
𑆩𑆫𑇀𑆩𑆾𑆥𑆫𑆴 𑆖 𑆘𑆳𑆠𑆼𑆰𑆶 𑆫𑆾𑆓𑆼𑆰𑆷𑆑𑇀𑆠𑆼𑆰𑆶 𑆢𑆳𑆫𑆟𑆩𑇀 𑇅 𑆱𑆶𑆥𑆑𑇀𑆮𑆼 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆼 𑆯𑆾𑆦𑆼 𑆥𑆵𑆝𑆤𑆽𑆫𑆶𑆥𑆥𑆵𑆝𑆴𑆠𑆼 𑇆𑇓𑇖𑇆
𑆥𑆳𑆑𑆾𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑆰𑆶 𑆢𑆾𑆰𑆼𑆰𑆶 𑆠𑆠𑇀𑆠𑆶 𑆑𑆳𑆫𑇀𑆪𑆁 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇅 𑆱𑆶𑆥𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆢𑆳𑆫𑆟𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆽𑆂 𑆑𑇀𑆰𑆳𑆫𑆼𑆟 𑆮𑆳 𑆥𑆶𑆤𑆂 𑇆𑇓𑇗𑇆
𑆑𑆜𑆴𑆤𑆳𑆤𑇀 𑆱𑇀𑆡𑆷𑆬𑆮𑆸𑆠𑇀𑆠𑆿𑆰𑇀𑆜𑆳𑆤𑇀 𑆢𑆵𑆫𑇀𑆪𑆩𑆳𑆟𑆳𑆤𑇀 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆂 𑇅 𑆑𑆜𑆴𑆤𑆾𑆠𑇀𑆱𑆤𑇀𑆤𑆩𑆳𑆁𑆱𑆳𑆁𑆯𑇀𑆖 𑆬𑆼𑆒𑆤𑆼𑆤𑆳𑆖𑆫𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇘𑇆
𑆱𑆩𑆁 𑆬𑆴𑆒𑆼𑆠𑇀 𑆱𑆶𑆬𑆴𑆒𑆴𑆠𑆁 𑆬𑆴𑆒𑆼𑆤𑇀𑆤𑆴𑆫𑆮𑆯𑆼𑆰𑆠𑆂 𑇅 𑆮𑆫𑇀𑆠𑇀𑆩𑆤𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆱𑆩𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆤𑆴𑆫𑇀𑆬𑆴𑆒𑆼𑆠𑇀 𑇆𑇓𑇙𑇆
𑆑𑇀𑆰𑆿𑆩𑆁 𑆥𑇀𑆬𑆾𑆠𑆁 𑆥𑆴𑆖𑆶𑆁 𑆦𑆼𑆤𑆁 𑆪𑆳𑆮𑆯𑆷𑆑𑆁 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀 𑇅 𑆑𑆫𑇀𑆑𑆯𑆳𑆤𑆴 𑆖 𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆬𑆼𑆒𑆤𑆳𑆫𑇀𑆡𑆼 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇐𑇆
𑆤𑆳𑆝𑆵𑆮𑇀𑆫𑆟𑆳𑆚𑇀 𑆯𑆬𑇀𑆪𑆓𑆫𑇀𑆨𑆳𑆤𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑇀𑆪𑆶𑆠𑇀𑆱𑆕𑇀𑆓𑆴𑆤𑆂 𑆯𑆤𑆽𑆂 𑇅 𑆑𑆫𑆵𑆫𑆧𑆳𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆨𑆴𑆫𑆼𑆰𑆟𑇀𑆪𑆳 𑆮𑆽𑆰𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇔𑇑𑇆
𑆤𑆼𑆠𑇀𑆫𑆮𑆫𑇀𑆠𑇀𑆩𑆓𑆶𑆢𑆳𑆨𑇀𑆪𑆳𑆱𑆤𑆳𑆝𑇀𑆪𑆾𑇁𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆂 𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆂 𑇅 𑆖𑆶𑆖𑇀𑆖𑆷𑆥𑆾𑆢𑆑𑆘𑆽𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆽𑆂 𑆑𑆫𑆵𑆫𑆽𑆫𑆼𑆰𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆳𑆂 𑇆𑇔𑇒𑇆
𑆱𑆁𑆮𑆸𑆠𑆳𑆱𑆁𑆮𑆸𑆠𑆳𑆱𑇀𑆪𑆼𑆰𑆶 𑆮𑇀𑆫𑆟𑆼𑆰𑆶 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑆳𑆲𑆫𑆼𑆖𑇀𑆗𑆬𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆾𑆢𑇀𑆣𑆫𑆟𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇔𑇓𑇆
𑆫𑆾𑆓𑆼 𑆮𑇀𑆪𑆣𑆤𑆱𑆳𑆣𑇀𑆪𑆼 𑆠𑆶 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆂 𑇅 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆁 𑆖 𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆁 𑆪𑆡𑆳 𑇆𑇔𑇔𑇆

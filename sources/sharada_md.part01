𑆘𑆕𑇀𑆓𑆩𑆱𑇀𑆪 𑆮𑆴𑆰𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆤𑆴 𑆰𑆾𑆝𑆯 𑇅 𑆱𑆩𑆳𑆱𑆼𑆤 𑆩𑆪𑆳 𑆪𑆳𑆤𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆱𑇀𑆠𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆢𑆸𑆰𑇀𑆛𑆴𑆤𑆴𑆂𑆯𑇀𑆮𑆳𑆱𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆤𑆒𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑆶𑆑𑇀𑆫𑆬𑆳𑆬𑆳𑆫𑇀𑆠𑆮𑆩𑆶𑆒𑆱𑆤𑇀𑆢𑆁𑆯- 𑆮𑆴𑆯𑆫𑇀𑆣𑆴𑆠𑆠𑆶𑆟𑇀𑆝𑆳𑆱𑇀𑆡𑆴𑆥𑆴𑆠𑇀𑆠𑆯𑆷𑆑𑆯𑆮𑆳𑆤𑆵𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫, 𑆢𑆸𑆰𑇀𑆛𑆴𑆤𑆴𑆂𑆯𑇀𑆮𑆳𑆱𑆮𑆴𑆰𑆳 𑆢𑆴𑆮𑇀𑆪𑆳𑆂 𑆱𑆫𑇀𑆥𑆳𑆂, 𑆨𑆿𑆩𑆳𑆱𑇀𑆠𑆶 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆴𑆰𑆳𑆂, 𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆯𑇀𑆮𑆮𑆳𑆤𑆫𑆩𑆑𑆫𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆳𑆑𑆩𑆠𑇀𑆱𑇀𑆪𑆓𑆾𑆣𑆳𑆯𑆩𑇀𑆧𑆷𑆑𑆥𑇀𑆫𑆖𑆬𑆳𑆑𑆓𑆸𑆲𑆓𑆾𑆣𑆴𑆑𑆳𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆑𑆵𑆛𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆼 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆤𑆒𑆮𑆴𑆰𑆳𑆂, 𑆖𑆴𑆥𑆴𑆛𑆥𑆴𑆖𑇀𑆖𑆴𑆛𑆑𑆑𑆰𑆳𑆪𑆮𑆳𑆱𑆴𑆑𑆱𑆫𑇀𑆰𑆥𑆑𑆠𑆾𑆛𑆑𑆮𑆫𑇀𑆖𑆂𑆑𑆵𑆛𑆑𑆿𑆟𑇀𑆝𑆴𑆤𑇀𑆪𑆑𑆳𑆂 𑆯𑆑𑆸𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆰𑆳𑆂, 𑆩𑆷𑆰𑆴𑆑𑆳𑆂 𑆯𑆶𑆑𑇀𑆫𑆮𑆴𑆰𑆳𑆂, 𑆬𑆷𑆠𑆳 𑆬𑆳𑆬𑆳𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆩𑆶𑆒𑆱𑆤𑇀𑆢𑆁𑆯𑆤𑆒𑆯𑆶𑆑𑇀𑆫𑆳𑆫𑇀𑆠𑆮𑆮𑆴𑆰𑆳𑆂 , 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆮𑆴𑆯𑇀𑆮𑆩𑇀𑆨𑆫𑆮𑆫𑆛𑆵𑆫𑆳𑆘𑆵𑆮𑆩𑆠𑇀𑆱𑇀𑆪𑆾𑆖𑇀𑆖𑆴𑆛𑆴𑆕𑇀𑆓𑆳𑆂 𑆱𑆩𑆶𑆢𑇀𑆫𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆯𑇀𑆖𑆳𑆬(𑆫)𑆮𑆴𑆰𑆳𑆂, 𑆖𑆴𑆠𑇀𑆫𑆯𑆴𑆫𑆂𑆱𑆫𑆳𑆮𑆑𑆶𑆫𑇀𑆢𑆴𑆯𑆠𑆢𑆳𑆫𑆶𑆑𑆳𑆫𑆴𑆩𑆼𑆢𑆑𑆱𑆳𑆫𑆴𑆑𑆳𑆩𑆶𑆒𑆳 𑆩𑆶𑆒𑆱𑆤𑇀𑆢𑆁𑆯𑆮𑆴𑆯𑆫𑇀𑆣𑆴𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆴𑆰𑆳𑆂, 𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆑𑆟𑆨𑆘𑆬𑆳𑆪𑆶𑆑𑆳 𑆩𑆶𑆒𑆱𑆤𑇀𑆢𑆁𑆯𑆮𑆴𑆰𑆳𑆂, 𑆮𑆴𑆰𑆲𑆠𑆳𑆱𑇀𑆡𑆴 𑆱𑆫𑇀𑆥𑆑𑆟𑇀𑆛𑆑𑆮𑆫𑆛𑆵𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆱𑇀𑆡𑆴 𑆖𑆼𑆠𑇀𑆪𑆱𑇀𑆡𑆴𑆮𑆴𑆰𑆳𑆟𑆴, 𑆯𑆑𑆶𑆬𑆵𑆩𑆠𑇀𑆱𑇀𑆪𑆫𑆑𑇀𑆠𑆫𑆳𑆘𑆴𑆮𑆫𑆑𑆵(𑆛𑆵)𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆰𑆳𑆂, 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑆶𑆟𑇀𑆝𑆾𑆖𑇀𑆖𑆴𑆛𑆴𑆕𑇀𑆓𑆮𑆫𑆛𑆵𑆯𑆠𑆥𑆢𑆵𑆯𑆷𑆑𑆮𑆬𑆨𑆴𑆑𑆳𑆯𑆸𑆕𑇀𑆓𑆴𑆨𑇀𑆫𑆩𑆫𑆳𑆂 𑆯𑆷𑆑𑆠𑆶𑆟𑇀𑆝𑆮𑆴𑆰𑆳𑆂, 𑆑𑆵𑆛𑆱𑆫𑇀𑆥𑆢𑆼𑆲𑆳 𑆓𑆠𑆳𑆱𑆮𑆂 𑆯𑆮𑆮𑆴𑆰𑆳𑆂; 𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆑𑇀𑆠𑆳 𑆩𑆶𑆒𑆱𑆤𑇀𑆢𑆁𑆯𑆮𑆴𑆰𑆼𑆰𑇀𑆮𑆼𑆮 𑆓𑆟𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆫𑆳𑆘𑇀𑆚𑆾𑇁𑆫𑆴𑆢𑆼𑆯𑆼 𑆫𑆴𑆥𑆮𑆱𑇀𑆠𑆸𑆟𑆳𑆩𑇀𑆧𑆶𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑇀𑆤𑆣𑆷𑆩𑆯𑇀𑆮𑆱𑆤𑆳𑆤𑇀 𑆮𑆴𑆰𑆼𑆟 𑇅 𑆱𑆤𑇀𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑇀𑆪𑆼𑆨𑆴𑆫𑆠𑆴𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑇀 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆨𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀𑆠𑆳𑆤𑇀 𑇆𑇖𑇆
𑆢𑆶𑆰𑇀𑆛𑆁 𑆘𑆬𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑆶𑆓𑇀𑆫𑆓𑆤𑇀𑆣𑆴 𑆦𑆼𑆤𑆳𑆤𑇀𑆮𑆴𑆠𑆁 𑆫𑆳𑆘𑆴𑆨𑆴𑆫𑆳𑆮𑆸𑆠𑆁 𑆖 𑇅 𑆩𑆟𑇀𑆝𑆷𑆑𑆩𑆠𑇀𑆱𑇀𑆪𑆁 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆮𑆴𑆲𑆕𑇀𑆓𑆳 𑆩𑆠𑇀𑆠𑆳𑆯𑇀𑆖 𑆱𑆳𑆤𑆷𑆥𑆖𑆫𑆳 𑆨𑇀𑆫𑆩𑆤𑇀𑆠𑆴 𑇆𑇗𑇆
𑆩𑆘𑇀𑆘𑆤𑇀𑆠𑆴 𑆪𑆼 𑆖𑆳𑆠𑇀𑆫 𑆤𑆫𑆳𑆯𑇀𑆮𑆤𑆳𑆓𑆳𑆱𑇀𑆠𑆼 𑆗𑆫𑇀𑆢𑆴𑆩𑆾𑆲𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆯𑆾𑆦𑆳𑆤𑇀 𑇅 𑆉(𑆓)𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆠𑆼𑆰𑆳𑆩𑆥𑆲𑆸𑆠𑇀𑆪 𑆢𑆾𑆰𑆳𑆤𑇀 𑆢𑆶𑆰𑇀𑆛𑆁 𑆘𑆬𑆁 𑆯𑆾𑆣𑆪𑆴𑆠𑆶𑆁 𑆪𑆠𑆼𑆠 𑇆𑇘𑇆
𑆣𑆮𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆳𑆱𑆤𑆥𑆳𑆫𑆴𑆨𑆢𑇀𑆫𑆳𑆤𑇀 𑆱𑆥𑆳𑆛𑆬𑆳𑆤𑇀 𑆱𑆴𑆢𑇀𑆣𑆑𑆩𑆾𑆑𑇀𑆰𑆑𑆿 𑆖 𑇅 𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆱𑆫𑆳𑆘𑆢𑇀𑆫𑆶𑆩𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆳𑆁𑆱𑇀𑆠𑆢𑇀𑆨𑆱𑇀𑆩 𑆯𑆵𑆠𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀 𑆱𑆫𑆂𑆱𑆶 𑇆𑇙𑇆
𑆨𑆱𑇀𑆩𑆳𑆚𑇀𑆘𑆬𑆴𑆁 𑆖𑆳𑆥𑆴 𑆔𑆛𑆼 𑆤𑆴𑆣𑆳𑆪 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆢𑆵𑆥𑇀𑆱𑆴𑆠𑆩𑆼𑆮𑆩𑆩𑇀𑆨𑆂 𑇅𑇑𑇐𑇅 𑆑𑇀𑆰𑆴𑆠𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆁 𑆮𑆴𑆰𑆢𑆷𑆰𑆴𑆠𑆁 𑆠𑆶 𑆯𑆴𑆬𑆳𑆠𑆬𑆁 𑆠𑆵𑆫𑇀𑆡𑆩𑆡𑆼𑆫𑆴𑆟𑆁 𑆮𑆳 𑇆𑇑𑇐𑇆
𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆴 𑆓𑆳𑆠𑇀𑆫𑆼𑆟 𑆠𑆶 𑆪𑆼𑆤 𑆪𑆼𑆤 𑆓𑆾𑆮𑆳𑆘𑆴𑆤𑆳𑆓𑆾𑆰𑇀𑆛𑇀𑆫𑆒𑆫𑆳 𑆤𑆫𑆳 𑆮𑆳 𑇅 𑆠𑆖𑇀𑆗𑆷𑆤𑆠𑆳𑆁 𑆪𑆳𑆠𑇀𑆪𑆡 𑆢𑆲𑇀𑆪𑆠𑆼 𑆖 𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑆫𑆾𑆩𑆤𑆒𑆁 𑆠𑆡𑆽𑆮 𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆤𑆤𑇀𑆠𑆳𑆁 𑆱𑆲 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆽𑆂 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆱𑆶𑆫𑆳𑆨𑆴𑆫𑇀𑆮𑆴𑆤𑆴𑆪𑆾𑆘𑇀𑆪 𑆩𑆳𑆫𑇀𑆓𑆩𑇀 𑇅 𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀 𑆥𑆪𑆾𑆨𑆴𑆂 𑆱𑆶𑆩𑆸𑆢𑆤𑇀𑆮𑆠𑆽𑆱𑇀𑆠𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆳𑆜𑆳𑆑𑆛𑆨𑆵𑆘𑆬𑆽𑆫𑇀𑆮𑆳 𑇆𑇑𑇒𑇆
𑆠𑆸𑆟𑆼𑆰𑆶 𑆨𑆑𑇀𑆠𑆼𑆰𑆶 𑆖 𑆢𑆷𑆰𑆴𑆠𑆼𑆰𑆶 𑆱𑆵𑆢𑆤𑇀𑆠𑆴 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆮𑆩𑆤𑇀𑆠𑆴 𑆖𑆳𑆤𑇀𑆪𑆼 𑇅 𑆮𑆴𑆝𑇀𑆨𑆼𑆢𑆩𑆸𑆖𑇀𑆗𑆤𑇀𑆠𑇀𑆪𑆡𑆮𑆳 𑆩𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑆠𑆼𑆰𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆥𑇀𑆫𑆟𑆪𑆼𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆩𑇀 𑇆𑇑𑇓𑇆
𑆮𑆴𑆰𑆳𑆥𑆲𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆓𑆢𑆽𑆫𑇀𑆮𑆴𑆬𑆴𑆥𑇀𑆪 𑆮𑆳𑆢𑇀𑆪𑆳𑆤𑆴 𑆖𑆴𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆥𑆴 𑆮𑆳𑆢𑆪𑆼𑆠 𑇅 𑆠𑆳𑆫𑆂 𑆱𑆶𑆠𑆳𑆫𑆂 𑆱𑆱𑆶𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆓𑆾𑆥𑆂 𑆱𑆫𑇀𑆮𑆽𑆯𑇀𑆖 𑆠𑆶𑆬𑇀𑆪𑆂 𑆑𑆶𑆫𑆶𑆮𑆴𑆤𑇀𑆢𑆨𑆳𑆓𑆂 𑇆𑇑𑇔𑇆
𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆪𑆶𑆑𑇀𑆠𑆂 𑆑𑆥𑆴𑆬𑆳𑆤𑇀𑆮𑆪𑆼𑆤 𑆮𑆳𑆢𑇀𑆪𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆮𑆴𑆲𑆴𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆂 𑇅 𑆮𑆳𑆢𑇀𑆪𑆱𑇀𑆪 𑆯𑆧𑇀𑆢𑆼𑆤 𑆲𑆴 𑆪𑆳𑆤𑇀𑆠𑆴 𑆤𑆳𑆯𑆁 𑆮𑆴𑆰𑆳𑆟𑆴 𑆔𑆾𑆫𑆳𑆟𑇀𑆪𑆥𑆴 𑆪𑆳𑆤𑆴 𑆱𑆤𑇀𑆠𑆴 𑇆𑇑𑇕𑇆

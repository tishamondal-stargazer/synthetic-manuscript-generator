𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆨𑇀𑆪𑆳𑆲𑆠𑆼 𑆠𑆶 𑆤𑆪𑆤𑆼 𑆧𑆲𑆶𑆣𑆳 𑆤𑆫𑆳𑆟𑆳𑆁 𑆱𑆁𑆫𑆩𑇀𑆨𑆫𑆳𑆓𑆠𑆶𑆩𑆶𑆬𑆳𑆱𑆶 𑆫𑆶𑆘𑆳𑆱𑆶 𑆣𑆵𑆩𑆳𑆤𑇀 𑇅 𑆤𑆱𑇀𑆪𑆳𑆱𑇀𑆪𑆬𑆼𑆥𑆥𑆫𑆴𑆰𑆼𑆖𑆤𑆠𑆫𑇀𑆥𑆟𑆳𑆢𑇀𑆪𑆩𑆶𑆑𑇀𑆠𑆁 𑆥𑆶𑆤𑆂 𑆑𑇀𑆰𑆠𑆘𑆥𑆴𑆠𑇀𑆠𑆘𑆯𑆷𑆬𑆥𑆡𑇀𑆪𑆩𑇀 𑇆𑇓𑇆
𑆢𑆸𑆰𑇀𑆛𑆴𑆥𑇀𑆫𑆱𑆳𑆢𑆘𑆤𑆤𑆁 𑆮𑆴𑆣𑆴𑆩𑆳𑆯𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑇀𑆲𑆴𑆩𑆽𑆯𑇀𑆖 𑆩𑆣𑆶𑆫𑆽𑆯𑇀𑆖 𑆠𑆡𑆳 𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆂 𑇅𑇔𑇅 𑆱𑇀𑆮𑆼𑆢𑆳𑆓𑇀𑆤𑆴𑆣𑆷𑆩𑆨𑆪𑆯𑆾𑆑𑆫𑆶𑆘𑆳𑆨𑆴𑆔𑆳𑆠𑆽𑆫𑆨𑇀𑆪𑆳𑆲𑆠𑆳𑆩𑆥𑆴 𑆠𑆡𑆽𑆮 𑆨𑆴𑆰𑆑𑇀 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠𑇀 𑇆𑇔𑇆
𑆱𑆢𑇀𑆪𑆾𑆲𑆠𑆼 𑆤𑆪𑆤 𑆍𑆰 𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑇀𑆪𑆤𑇀𑆢𑆼𑆫𑆴𑆠𑆾 𑆨𑆮𑆠𑆴 𑆢𑆾𑆰𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆂 𑇅𑇕𑇅 𑆃𑆨𑇀𑆪𑆳𑆲𑆠𑆁 𑆤𑆪𑆤𑆩𑆵𑆰𑆢𑆡𑆳𑆱𑇀𑆪𑆧𑆳𑆰𑇀𑆥𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑆴𑆠𑆁 𑆨𑆮𑆠𑆴 𑆠𑆤𑇀𑆤𑆴𑆫𑆶𑆘𑆁 𑆑𑇀𑆰𑆟𑆼𑆤 𑇆𑇕𑇆
𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆢𑆸𑆰𑇀𑆛𑆴𑆠𑆤𑆶𑆫𑆳𑆓𑆩𑆱𑆠𑇀𑆥𑇀𑆫𑆢𑆫𑇀𑆯𑆴, 𑆱𑆳𑆣𑇀𑆪𑆁 𑆪𑆡𑆳𑆱𑇀𑆡𑆴𑆠𑆩𑆤𑆳𑆮𑆴𑆬𑆢𑆫𑇀𑆯𑆤𑆁 𑆖 𑇅𑇗𑇅 𑆥𑇀𑆫𑆳𑆟𑆾𑆥𑆫𑆾𑆣𑆮𑆩𑆤𑆑𑇀𑆰𑆶𑆠𑆑𑆟𑇀𑆜𑆫𑆾𑆣𑆽𑆫𑆶𑆤𑇀𑆤𑆩𑇀𑆪𑆩𑆳𑆯𑆶 𑆤𑆪𑆤𑆁 𑆪𑆢𑆠𑆴𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆩𑇀 𑇆𑇗𑇆
𑆤𑆼𑆠𑇀𑆫𑆼 𑆮𑆴𑆬𑆩𑇀𑆧𑆴𑆤𑆴 𑆮𑆴𑆣𑆴𑆫𑇀𑆮𑆴𑆲𑆴𑆠𑆂 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆢𑆶𑆖𑇀𑆗𑆴𑆕𑇀𑆔𑆤𑆁 𑆯𑆴𑆫𑆱𑆴 𑆮𑆳𑆫𑇀𑆪𑆮𑆱𑆼𑆖𑆤𑆁 𑆖 𑇅𑇘𑇅 𑆰𑆛𑇀𑆱𑆥𑇀𑆠𑆠𑆴𑆫𑇀𑆤𑆪𑆤𑆘𑆳 𑆪 𑆅𑆩𑆼 𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆳 𑆫𑆾𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆩𑆲𑆠𑆳𑆁 𑆩𑆲𑆠𑆳𑆁 𑆖 𑆠𑆼𑆨𑇀𑆪𑆂 𑇆𑇘𑇆
𑆱𑇀𑆠𑆤𑇀𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆑𑆦𑆩𑆳𑆫𑆶𑆠𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆽𑆫𑇀𑆧𑆳𑆬𑆳𑆑𑇀𑆰𑆴𑆮𑆫𑇀𑆠𑇀𑆩𑆨𑆮 𑆍𑆮 𑆑𑆶𑆑𑆷𑆟𑆑𑆾𑇁𑆤𑇀𑆪𑆂 𑇅𑇙𑇅 𑆩𑆸𑆢𑇀𑆓𑆳𑆠𑆴 𑆤𑆼𑆠𑇀𑆫𑆩𑆠𑆴𑆑𑆟𑇀𑆝𑆶𑆩𑆡𑆳𑆑𑇀𑆰𑆴𑆑𑆷𑆛𑆁 𑆤𑆳𑆱𑆳𑆬𑆬𑆳𑆛𑆩𑆥𑆴 𑆠𑆼𑆤 𑆯𑆴𑆯𑆶𑆂 𑆱 𑆤𑆴𑆠𑇀𑆪𑆩𑇀 𑇆𑇙𑇆
𑆱𑆷𑆫𑇀𑆪𑆥𑇀𑆫𑆨𑆳𑆁 𑆤 𑆱𑆲𑆠𑆼 𑆱𑇀𑆫𑆮𑆠𑆴 𑆥𑇀𑆫𑆧𑆢𑇀𑆣𑆁, 𑆠𑆱𑇀𑆪𑆳𑆲𑆫𑆼𑆢𑇀𑆫𑆶𑆣𑆴𑆫𑆩𑆳𑆯𑆶 𑆮𑆴𑆤𑆴𑆫𑇀𑆬𑆴𑆒𑆼𑆖𑇀𑆖 𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆪𑆶𑆠𑆽𑆯𑇀𑆖 𑆑𑆛𑆶𑆨𑆴𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆪𑆼𑆠𑇀𑆠𑆶 𑆩𑆳𑆠𑆶𑆂 𑆯𑆴𑆯𑆾𑆫𑆨𑆴𑆲𑆴𑆠𑆁 𑆖 𑆮𑆴𑆣𑆴𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆟𑆶𑆢𑆬𑆽𑆂 𑆥𑆫𑆴𑆣𑆳𑆮𑆤𑆳𑆫𑇀𑆡𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆑𑆰𑆳𑆪𑆩𑆮𑆱𑆼𑆖𑆤𑆩𑆼𑆮 𑆖𑆳𑆥𑆴 𑇅𑇑𑇓𑇅 𑆄𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆼 𑆖 𑆲𑆴𑆠𑆩𑆠𑇀𑆫 𑆔𑆸𑆠𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆡𑆳𑇁𑇁𑆲𑆶𑆫𑆥𑆴 𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑇀 𑇆𑇑𑇓𑇆
𑆮𑇀𑆪𑆾𑆰𑆁 𑆥𑆬𑆳𑆟𑇀𑆝𑆶 𑆩𑆣𑆶𑆑𑆁 𑆬𑆮𑆟𑆾𑆠𑇀𑆠𑆩𑆁 𑆖 𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆖 𑆓𑆿𑆫𑆴𑆑𑆪𑆶𑆠𑆳𑆁 𑆓𑆶𑆛𑆴𑆑𑆳𑆚𑇀𑆘𑆤𑆁 𑆮𑆳 𑇅 𑆤𑆴𑆩𑇀𑆧𑆖𑇀𑆗𑆢𑆁 𑆩𑆣𑆶𑆑𑆢𑆳𑆫𑇀𑆮𑆴 𑆱𑆠𑆳𑆩𑇀𑆫𑆬𑆾𑆣𑇀𑆫𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆨𑆴𑆰𑆘𑆾𑇁𑆚𑇀𑆘𑆤𑆩𑆁𑆯𑆠𑆶𑆬𑇀𑆪𑆩𑇀 𑇆𑇑𑇕𑇆
𑆱𑆩𑆶𑆢𑇀𑆫 𑆅𑆮 𑆓𑆩𑇀𑆨𑆵𑆫𑆁 𑆤𑆽𑆮 𑆯𑆑𑇀𑆪𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇅 𑆮𑆑𑇀𑆠𑆶𑆁 𑆤𑆴𑆫𑆮𑆯𑆼𑆰𑆼𑆟 𑆯𑇀𑆬𑆾𑆑𑆳𑆤𑆳𑆩𑆪𑆶𑆠𑆽𑆫𑆥𑆴 𑇆𑇑𑇗𑇆

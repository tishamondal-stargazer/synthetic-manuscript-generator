𑆃𑆘𑆳𑆘𑆵𑆁 𑆖𑆳𑆘𑆓𑆤𑇀𑆣𑆳𑆁 𑆖 𑆥𑆵𑆬𑆷𑆤𑇀𑆪𑆼𑆬𑆳𑆁 𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑆩𑇀𑇅 𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆁 𑆱𑆶𑆫𑆱𑆳𑆁 𑆯𑇀𑆮𑆼𑆠𑆳𑆁 𑆑𑆶𑆜𑆼𑆫𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑𑆿𑇆𑇔𑇆
𑆯𑆴𑆫𑆵𑆰𑆧𑆵𑆘𑆁 𑆬𑆯𑆶𑆤𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆬𑆮𑆟𑆢𑇀𑆮𑆪𑆩𑇀𑇅 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆖 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆵𑆫𑇀𑆰𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇆𑇕𑇆
𑆓𑆿𑆫𑆮𑆼 𑆯𑆴𑆫𑆱𑆂 𑆯𑆷𑆬𑆼 𑆥𑆵𑆤𑆱𑆼𑇁𑆫𑇀𑆣𑆳𑆮𑆨𑆼𑆢𑆑𑆼𑇅 𑆑𑇀𑆫𑆴𑆩𑆴𑆮𑇀𑆪𑆳𑆣𑆳𑆮𑆥𑆱𑇀𑆩𑆳𑆫𑆼 𑆔𑇀𑆫𑆳𑆟𑆤𑆳𑆯𑆼 𑆥𑇀𑆫𑆩𑆾𑆲𑆑𑆼𑇆𑇖𑇆
𑆩𑆢𑆤𑆁 𑆩𑆣𑆶𑆑𑆁 𑆤𑆴𑆩𑇀𑆧𑆁 𑆘𑆵𑆩𑆷𑆠𑆁 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆩𑇀𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆶𑆛𑆘𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆷𑆟𑇀𑆪𑆼𑆬𑆳𑆁 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆳𑆟𑆴 𑆖𑇆𑇗𑇆
𑆇𑆥𑆱𑇀𑆡𑆴𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆳𑆮𑆳𑆩𑆳𑆯𑆪𑆳𑆯𑇀𑆫𑆪𑆼𑇅 𑆮𑆩𑆤𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆨𑆴𑆰𑆓𑇀𑆢𑆼𑆲𑆩𑆢𑆷𑆰𑆪𑆤𑇀𑇆𑇘𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆢𑆤𑇀𑆠𑆵𑆁 𑆤𑆵𑆬𑆴𑆤𑆵𑆁 𑆱𑆥𑇀𑆠𑆬𑆳𑆁 𑆮𑆖𑆳𑆩𑇀𑇅 𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆁 𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆁 𑆖 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆵𑆩𑆶𑆢𑆑𑆵𑆫𑇀𑆪𑆑𑆳𑆩𑇀𑇆𑇙𑇆
𑆥𑆵𑆬𑆷𑆤𑇀𑆪𑆳𑆫𑆓𑇀𑆮𑆣𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆁 𑆤𑆴𑆖𑆶𑆬𑆳𑆤𑆴 𑆖𑇅 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆓𑆠𑆼 𑆢𑆾𑆰𑆼 𑆮𑆴𑆫𑆼𑆑𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇆
𑆥𑆳𑆛𑆬𑆳𑆁 𑆖𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆁 𑆖 𑆧𑆴𑆬𑇀𑆮𑆁 𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆩𑆼𑆮 𑆖𑇅 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆁 𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆁 𑆖 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵𑆁 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑆩𑇀𑇆𑇑𑇑𑇆
𑆧𑆬𑆳𑆁 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆁 𑆧𑆸𑆲𑆠𑆵𑆩𑆼𑆫𑆟𑇀𑆝𑆁 𑆱𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆩𑇀𑇅 𑆪𑆮𑆳𑆤𑇀 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑇀 𑆑𑆾𑆬𑆳𑆤𑆴 𑆓𑆶𑆝𑆷𑆖𑆵𑆁 𑆩𑆢𑆤𑆳𑆤𑆴 𑆖𑇆𑇑𑇒𑇆
𑆥𑆬𑆳𑆯𑆁 𑆑𑆠𑇀𑆠𑆸𑆟𑆁 𑆖𑆽𑆮 𑆱𑇀𑆤𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇅 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆼 𑆮𑆴𑆧𑆤𑇀𑆣𑆼𑆰𑆶 𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆼𑆰𑆶 𑆖𑇆𑇑𑇓𑇆
𑆃𑆠 𑆍𑆮𑆿𑆰𑆣𑆓𑆟𑆳𑆠𑇀 𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑇀𑆪𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇅 𑆩𑆳𑆫𑆶𑆠𑆔𑇀𑆤𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆥𑆳𑆚𑇀𑆖𑆑𑆫𑇀𑆩𑆴𑆑𑆂𑇆𑇑𑇔𑇆
𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆥𑆳𑆢𑆤𑆽𑆂𑇅 𑆥𑆚𑇀𑆖𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆩𑆳𑆠𑇀𑆫𑆳𑆑𑆳𑆬𑆿 𑆮𑆴𑆖𑆳𑆫𑆪𑆤𑇀𑇆𑇑𑇕𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆑𑆳𑆬𑆳𑆯𑇀𑆫𑆪𑆳 𑆪𑆶𑆑𑇀𑆠𑆴𑆂, 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆿 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆳𑇅 𑆠𑆴𑆰𑇀𑆜𑆠𑇀𑆪𑆶𑆥𑆫𑆴 𑆪𑆶𑆑𑇀𑆠𑆴𑆘𑇀𑆚𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆳𑆁 𑆱𑆢𑆳𑇆𑇑𑇖𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆿𑆰𑆣𑆳𑆂𑇅 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆠𑆠𑇀𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆪𑆼𑇆𑇑𑇗𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆽𑆂𑇅 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆢𑆵𑆥𑆤𑆵𑆪𑆳 𑆱𑇀𑆪𑆳𑆖𑇀𑆗𑆷𑆬𑆔𑇀𑆤𑆵 𑆖𑆾𑆥𑆱𑆳𑆣𑆴𑆠𑆳𑇆𑇑𑇘𑇆
𑆢𑆣𑆴𑆠𑇀𑆡𑆧𑆴𑆬𑇀𑆮𑆖𑆳𑆕𑇀𑆓𑆼𑆫𑆵𑆠𑆑𑇀𑆫𑆢𑆳𑆝𑆴𑆩𑆱𑆳𑆣𑆴𑆠𑆳𑇅 𑆥𑆳𑆖𑆤𑆵 𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑆵, 𑆥𑆼𑆪𑆳 𑆱𑆮𑆳𑆠𑆼 𑆥𑆳𑆚𑇀𑆖𑆩𑆷𑆬𑆴𑆑𑆵𑇆𑇑𑇙𑇆
𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆧𑆬𑆳𑆧𑆴𑆬𑇀𑆮𑆽𑆂 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑇀𑆪𑆳 𑆖 𑆱𑆳𑆣𑆴𑆠𑆳𑇅 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑇀𑆬𑆳 𑆲𑆴𑆠𑆳 𑆥𑆼𑆪𑆳 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆴𑆱𑆳𑆫𑆴𑆟𑆳𑆩𑇀𑇆𑇒𑇐𑇆
𑆥𑆪𑆱𑇀𑆪𑆫𑇀𑆣𑆾𑆢𑆑𑆼 𑆖𑇀𑆗𑆳𑆓𑆼 𑆲𑇀𑆫𑆵𑆮𑆼𑆫𑆾𑆠𑇀𑆥𑆬𑆤𑆳𑆓𑆫𑆽𑆂𑇅 𑆥𑆼𑆪𑆳 𑆫𑆑𑇀𑆠𑆳𑆠𑆴𑆱𑆳𑆫𑆔𑇀𑆤𑆵 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑇀𑆪𑆳 𑆖 𑆱𑆳𑆣𑆴𑆠𑆳𑇆𑇒𑇑𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆯𑆴𑆓𑇀𑆫𑆶𑆨𑆴𑆫𑇀𑆩𑆫𑆴𑆖𑆼𑆤 𑆖𑇅 𑆠𑆑𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳 𑆪𑆮𑆳𑆓𑆷𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆵 𑆱𑆱𑆶𑆮𑆫𑇀𑆖𑆴𑆑𑆳𑇆𑇒𑇓𑇆
𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆱𑆳𑆫𑆴𑆮𑆳𑆬𑆳𑆘𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆣𑆶𑆤𑆳𑆓𑆫𑆽𑆂𑇅 𑆥𑆴𑆥𑆳𑆱𑆳𑆔𑇀𑆤𑆵, 𑆮𑆴𑆰𑆔𑇀𑆤𑆵 𑆖 𑆱𑆾𑆩𑆫𑆳𑆘𑆵𑆮𑆴𑆥𑆳𑆖𑆴𑆠𑆳𑇆𑇒𑇔𑇆
𑆱𑆴𑆢𑇀𑆣𑆳 𑆮𑆫𑆳𑆲𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆧𑆸𑆁𑆲𑆟𑆵 𑆩𑆠𑆳𑇅 𑆓𑆮𑆼𑆣𑆶𑆑𑆳𑆤𑆳𑆁 𑆨𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆯𑆤𑆵𑆪𑆳 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆳𑇆𑇒𑇕𑇆
𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆩𑆠𑆵 𑆧𑆲𑆶𑆠𑆴𑆬𑆳 𑆱𑇀𑆤𑆼𑆲𑆤𑆵 𑆬𑆮𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑇅 𑆑𑆶𑆯𑆳𑆩𑆬𑆑𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆳𑆤𑆳𑆁 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆵𑇆𑇒𑇖𑇆
𑆢𑆯𑆩𑆷𑆬𑆵𑆯𑆸𑆠𑆳 𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆦𑆳𑆥𑆲𑆳𑇅 𑆪𑆩𑆑𑆼 𑆩𑆢𑆴𑆫𑆳𑆱𑆴𑆢𑇀𑆣𑆳 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆫𑆶𑆘𑆳𑆥𑆲𑆳𑇆𑇒𑇗𑇆
𑆯𑆳𑆑𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆽𑆱𑇀𑆠𑆴𑆬𑆽𑆫𑇀𑆩𑆳𑆰𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆳 𑆮𑆫𑇀𑆖𑆾 𑆤𑆴𑆫𑆱𑇀𑆪𑆠𑆴𑇅 𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆢𑆣𑆴𑆠𑇀𑆡𑆳𑆩𑇀𑆬𑆧𑆴𑆬𑇀𑆮𑆽𑆂 𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆵 𑆩𑆠𑆳𑇆𑇒𑇘𑇆
𑆑𑇀𑆰𑆳𑆫𑆖𑆴𑆠𑇀𑆫𑆑𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆽𑆫𑇀𑆨𑆼𑆢𑆴𑆤𑆵 𑆩𑆠𑆳𑇅 𑆃𑆨𑆪𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆮𑆴𑆯𑇀𑆮𑆽𑆫𑇀𑆮𑆳𑆠𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆵 𑇆𑇒𑇙𑇆

𑆤𑆢𑇀𑆪𑆂 𑆥𑆳𑆰𑆳𑆟𑆮𑆴𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆮𑆴𑆑𑇀𑆰𑆶𑆧𑇀𑆣𑆳𑆨𑆴𑆲𑆠𑆾𑆢𑆑𑆳𑆂 𑇅 𑆲𑆴𑆩𑆮𑆠𑇀𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆥𑆡𑇀𑆪𑆳𑆂 𑆥𑆶𑆟𑇀𑆪𑆳 𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆱𑆼𑆮𑆴𑆠𑆳𑆂𑇆𑇒𑇐𑇙𑇆
𑆤𑆢𑇀𑆪𑆂 𑆥𑆳𑆰𑆳𑆟𑆱𑆴𑆑𑆠𑆳𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆾 𑆮𑆴𑆩𑆬𑆾𑆢𑆑𑆳𑆂𑇅 𑆩𑆬𑆪𑆥𑇀𑆫𑆨𑆮𑆳 𑆪𑆳𑆯𑇀𑆖 𑆘𑆬𑆁 𑆠𑆳𑆱𑇀𑆮𑆩𑆸𑆠𑆾𑆥𑆩𑆩𑇀𑇆𑇒𑇑𑇐𑇆
𑆥𑆯𑇀𑆖𑆴𑆩𑆳𑆨𑆴𑆩𑆶𑆒𑆳 𑆪𑆳𑆯𑇀𑆖 𑆥𑆡𑇀𑆪𑆳𑆱𑇀𑆠𑆳 𑆤𑆴𑆫𑇀𑆩𑆬𑆾𑆢𑆑𑆳𑆂𑇅 𑆥𑇀𑆫𑆳𑆪𑆾 𑆩𑆸𑆢𑆶𑆮𑆲𑆳 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆾 𑆪𑆳𑆯𑇀𑆖 𑆥𑆷𑆫𑇀𑆮𑆱𑆩𑆶𑆢𑇀𑆫𑆓𑆳𑆂𑇆𑇒𑇑𑇑𑇆
𑆥𑆳𑆫𑆴𑆪𑆳𑆠𑇀𑆫𑆨𑆮𑆳 𑆪𑆳𑆯𑇀𑆖 𑆮𑆴𑆤𑇀𑆣𑇀𑆪𑆱𑆲𑇀𑆪𑆨𑆮𑆳𑆯𑇀𑆖 𑆪𑆳𑆂𑇅 𑆯𑆴𑆫𑆾𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁 𑆠𑆳 𑆲𑆼𑆠𑆶𑆂 𑆯𑇀𑆬𑆵𑆥𑆢𑆱𑇀𑆪 𑆖𑇆𑇒𑇑𑇒𑇆
𑆮𑆱𑆶𑆣𑆳𑆑𑆵𑆛𑆱𑆫𑇀𑆥𑆳𑆒𑆶𑆩𑆬𑆱𑆤𑇀𑆢𑆷𑆰𑆴𑆠𑆾𑆢𑆑𑆳𑆂𑇅 𑆮𑆫𑇀𑆰𑆳𑆘𑆬𑆮𑆲𑆳 𑆤𑆢𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆱𑆩𑆵𑆫𑆟𑆳𑆂𑇆𑇒𑇑𑇓𑇆
𑆮𑆳𑆥𑆵𑆑𑆷𑆥𑆠𑆝𑆳𑆓𑆾𑆠𑇀𑆱𑆱𑆫𑆂𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆟𑆳𑆢𑆴𑆰𑆶𑇅 𑆄𑆤𑆷𑆥𑆯𑆽𑆬𑆣𑆤𑇀𑆮𑆳𑆤𑆳𑆁 𑆓𑆶𑆟𑆢𑆾𑆰𑆽𑆫𑇀𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀𑇆𑇒𑇑𑇔𑇆
𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆬𑆁 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆁 𑆥𑆫𑇀𑆟𑆯𑆽𑆮𑆳𑆬𑆑𑆫𑇀𑆢𑆩𑆽𑆂𑇅 𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆮𑆴𑆫𑆱𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆁 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆁 𑆤 𑆲𑆴𑆠𑆁 𑆘𑆬𑆩𑇀𑇆𑇒𑇑𑇕𑇆
𑆮𑆴𑆱𑇀𑆫𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆁 𑆬𑆮𑆟𑆩𑆩𑇀𑆧𑆶 𑆪𑆢𑇀𑆮𑆫𑆶𑆟𑆳𑆬𑆪𑆩𑇀𑇅 𑆅𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆮𑆫𑇀𑆓𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾𑇁𑆪𑆩𑆰𑇀𑆛𑆩𑆂 𑆱𑆶𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆂𑇆𑇒𑇑𑇖𑇆
𑆅𑆠𑆴 𑆘𑆬𑆮𑆫𑇀𑆓𑆾𑇁𑆰𑇀𑆛𑆩𑆂𑇅 𑆃𑆡 𑆓𑆾𑆫𑆱𑆮𑆫𑇀𑆓𑆂- 𑆱𑇀𑆮𑆳𑆢𑆶 𑆯𑆵𑆠𑆁 𑆩𑆸𑆢𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆧𑆲𑆬𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑇀𑇅 𑆓𑆶𑆫𑆶 𑆩𑆤𑇀𑆢𑆁 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆁 𑆖 𑆓𑆮𑇀𑆪𑆁 𑆢𑆯𑆓𑆶𑆟𑆁 𑆥𑆪𑆂𑇆𑇒𑇑𑇗𑇆
𑆠𑆢𑆼𑆮𑆕𑇀𑆓𑆶𑆟𑆩𑆼𑆮𑆿𑆘𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆢𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀𑇅 𑆥𑇀𑆫𑆮𑆫𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆑𑇀𑆠𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇒𑇑𑇘𑇆
𑆩𑆲𑆴𑆰𑆵𑆟𑆳𑆁 𑆓𑆶𑆫𑆶𑆠𑆫𑆁 𑆓𑆮𑇀𑆪𑆳𑆖𑇀𑆗𑆵𑆠𑆠𑆫𑆁 𑆥𑆪𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀𑆪𑆷𑆤𑆩𑆤𑆴𑆢𑇀𑆫𑆳𑆪 𑆲𑆴𑆠𑆩𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆼 𑆖 𑆠𑆠𑇀𑇆𑇒𑇑𑇙𑇆
𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆰𑇀𑆛𑇀𑆫𑆵𑆟𑆳𑆩𑆵𑆰𑆠𑇀𑆱𑆬𑆮𑆟𑆁 𑆬𑆔𑆶𑇅 𑆯𑆱𑇀𑆠𑆁 𑆮𑆳𑆠𑆑𑆦𑆳𑆤𑆳𑆲𑆑𑇀𑆫𑆴𑆩𑆴𑆯𑆾𑆦𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇆𑇒𑇒𑇐𑇆
𑆧𑆬𑇀𑆪𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆁 𑆱𑆫𑇀𑆮𑆩𑆶𑆰𑇀𑆟𑆁 𑆖𑆽𑆑𑆯𑆦𑆁 𑆥𑆪𑆂𑇅 𑆱𑆳𑆩𑇀𑆬𑆁 𑆱𑆬𑆮𑆟𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆯𑆳𑆒𑆳𑆮𑆳𑆠𑆲𑆫𑆁 𑆬𑆔𑆶𑇆𑇒𑇒𑇑𑇆
𑆗𑆳𑆓𑆁 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆁 𑆯𑆵𑆠𑆁 𑆓𑇀𑆫𑆳𑆲𑆴 𑆥𑆪𑆾 𑆬𑆔𑆶𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑆴𑆱𑆳𑆫𑆔𑇀𑆤𑆁 𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆘𑇀𑆮𑆫𑆳𑆥𑆲𑆩𑇀𑇆𑇒𑇒𑇒𑇆
𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆫𑆁 𑆠𑆷𑆰𑇀𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆩𑆳𑆮𑆴𑆑𑆩𑇀𑇅 𑆲𑆱𑇀𑆠𑆴𑆤𑆵𑆤𑆳𑆁 𑆥𑆪𑆾 𑆧𑆬𑇀𑆪𑆁 𑆓𑆶𑆫𑆶 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆁 𑆥𑆫𑆩𑇀𑇆𑇒𑇒𑇓𑇆
𑆘𑆵𑆮𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆩𑆳𑆤𑆶𑆰𑆁 𑆥𑆪𑆂𑇅 𑆤𑆳𑆮𑆤𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆠𑆫𑇀𑆥𑆟𑆁 𑆖𑆳𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆴𑆤𑆳𑆩𑇀𑇆𑇒𑇒𑇔𑇆
𑆫𑆾𑆖𑆤𑆁 𑆢𑆵𑆥𑆤𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇅 𑆥𑆳𑆑𑆼𑇁𑆩𑇀𑆬𑆩𑆶𑆰𑇀𑆟𑆁 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆩𑆕𑇀𑆓𑆬𑇀𑆪𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆢𑆣𑆴𑇆𑇒𑇒𑇕𑇆
𑆥𑆵𑆤𑆱𑆼 𑆖𑆳𑆠𑆴𑆱𑆳𑆫𑆼 𑆖 𑆯𑆵𑆠𑆑𑆼 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆼𑇅 𑆃𑆫𑆶𑆖𑆿 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆖 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆼 𑆖 𑆢𑆣𑆴 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇒𑇒𑇖𑇆
𑆯𑆫𑆢𑇀𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆱𑆤𑇀𑆠𑆼𑆰𑆶 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆢𑆣𑆴 𑆓𑆫𑇀𑆲𑆴𑆠𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆾𑆠𑇀𑆡𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆲𑆴𑆠𑆁 𑆖 𑆠𑆠𑇀𑇆𑇒𑇒𑇗𑇆
𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆁 𑆩𑆤𑇀𑆢𑆑𑆁, 𑆘𑆳𑆠𑆁 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆢𑆣𑆴, 𑆯𑆶𑆑𑇀𑆫𑆬𑆂𑇅 𑆱𑆫𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆤𑆴𑆬𑆔𑇀𑆤𑆱𑇀𑆠𑆶 𑆩𑆟𑇀𑆝𑆂 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆯𑆾𑆣𑆤𑆂𑇆𑇒𑇒𑇘𑇆
𑆯𑆾𑆦𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆾𑆢𑆫𑆳𑆫𑆶𑆖𑆿𑇅 𑆱𑇀𑆤𑆼𑆲𑆮𑇀𑆪𑆳𑆥𑆢𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑇀𑆮𑆼 𑆠𑆑𑇀𑆫𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆓𑆫𑆼𑆰𑆶 𑆖𑇆𑇒𑇒𑇙𑇆
𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆢𑆵𑆥𑆤𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆤𑆮𑆤𑆵𑆠𑆁 𑆤𑆮𑆾𑆢𑇀𑆣𑆸𑆠𑆩𑇀𑇅 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆾𑆮𑆴𑆑𑆳𑆫𑆔𑇀𑆤𑆩𑆫𑇀𑆢𑆴𑆠𑆳𑆫𑆶𑆖𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇒𑇓𑇐𑇆

𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆾 𑆩𑆶𑆒𑆱𑇀𑆫𑆳𑆮𑆾 𑆓𑆶𑆢𑆢𑆳𑆲𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳 𑇅 𑆥𑆶𑆫𑆵𑆰𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆨𑆸𑆯𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇕𑇔𑇆
𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆫𑆷𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆑𑆾𑆫𑆢𑆷𑆰𑆳𑆤𑇀𑆤𑆠𑆑𑇀𑆫𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆯𑆑𑇀𑆠𑆶𑆨𑆴𑆂 𑇆𑇕𑇕𑇆
𑆢𑆵𑆥𑇀𑆠𑆳𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆂 𑆥𑆫𑆴𑆯𑆶𑆢𑇀𑆣𑆑𑆾𑆰𑇀𑆜𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆓𑇀𑆫𑆣𑆳𑆠𑆶𑆫𑇀𑆧𑆬𑆮𑆫𑇀𑆟𑆪𑆶𑆑𑇀𑆠𑆂 𑇅 𑆢𑆸𑆞𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾 𑆩𑆤𑇀𑆢𑆘𑆫𑆂 𑆯𑆠𑆳𑆪𑆶𑆂 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆱𑆼𑆮𑆵 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆼𑆠𑇀𑆠𑆶 𑇆𑇕𑇖𑇆
𑆱𑇀𑆤𑆼𑆲𑆾 𑆲𑆴𑆠𑆾 𑆢𑆶𑆫𑇀𑆧𑆬𑆮𑆲𑇀𑆤𑆴𑆢𑆼𑆲𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆱𑇀𑆪 𑇅 𑆧𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆿 𑆨𑆾𑆘𑆤𑆢𑆾𑆰𑆘𑆳𑆠𑆽𑆂 𑆥𑇀𑆫𑆩𑆫𑇀𑆢𑆴𑆠𑆶𑆁 𑆠𑆿 𑆱𑆲𑆱𑆳 𑆤 𑆱𑆳𑆣𑇀𑆪𑆿 𑇆𑇕𑇗𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆮𑆼𑆢𑆳𑆮𑆖𑆳𑆫𑆟𑆵𑆪𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑆱𑇀𑆮𑆼𑆢𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑆳𑆥𑆱𑇀𑆮𑆼𑆢, 𑆈𑆰𑇀𑆩𑆱𑇀𑆮𑆼𑆢, 𑆇𑆥𑆤𑆳𑆲𑆱𑇀𑆮𑆼𑆢𑆾, 𑆢𑇀𑆫𑆮𑆱𑇀𑆮𑆼𑆢 𑆅𑆠𑆴; 𑆃𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆱𑇀𑆮𑆼𑆢𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆮𑆫𑆾𑆣𑆂 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆠𑆳𑆥𑆱𑇀𑆮𑆼𑆢𑆂 𑆥𑆳𑆟𑆴𑆑𑆳𑆁𑆱𑇀𑆪𑆑𑆤𑇀𑆢𑆶𑆑𑆑𑆥𑆳𑆬𑆮𑆳𑆬𑆶𑆑𑆳𑆮𑆱𑇀𑆠𑇀𑆫𑆽𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼, 𑆯𑆪𑆳𑆤𑆱𑇀𑆪 𑆖𑆳𑆕𑇀𑆓𑆠𑆳𑆥𑆾 𑆧𑆲𑆶𑆯𑆂 𑆒𑆳𑆢𑆴𑆫𑆳𑆕𑇀𑆓𑆳𑆫𑆽𑆫𑆴𑆠𑆴 𑇆𑇔𑇆
𑆈𑆰𑇀𑆩𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆶 𑆑𑆥𑆳𑆬𑆥𑆳𑆰𑆳𑆟𑆼𑆰𑇀𑆛𑆑𑆳𑆬𑆾𑆲𑆥𑆴𑆟𑇀𑆝𑆳𑆤𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆟𑆳𑆤𑆢𑇀𑆨𑆴𑆫𑆳𑆱𑆴𑆚𑇀𑆖𑆼𑆢𑆩𑇀𑆬𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆮𑆳, 𑆠𑆽𑆫𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆬𑆑𑇀𑆠𑆑𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆽𑆫𑆕𑇀𑆓𑆥𑇀𑆫𑆢𑆼𑆯𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇅 𑆩𑆳𑆁𑆱𑆫𑆱𑆥𑆪𑆾𑆢𑆣𑆴𑆱𑇀𑆤𑆼𑆲𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆮𑆳𑆠𑆲𑆫𑆥𑆠𑇀𑆫𑆨𑆕𑇀𑆓𑆑𑇀𑆮𑆳𑆡𑆥𑆷𑆫𑇀𑆟𑆳𑆁 𑆮𑆳 𑆑𑆶𑆩𑇀𑆨𑆵𑆩𑆤𑆶𑆠𑆥𑇀𑆠𑆳𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆠𑇀𑆪𑆾𑆰𑇀𑆩𑆳𑆟𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀 𑇅 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆟 𑆮𑆳 𑆑𑆶𑆩𑇀𑆨𑆼𑆤𑆳𑆣𑆾𑆩𑆶𑆒𑆼𑆤 𑆠𑆱𑇀𑆪𑆳 𑆩𑆶𑆒𑆩𑆨𑆴𑆱𑆤𑇀𑆣𑆳𑆪 𑆠𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆴𑆢𑇀𑆫𑆼 𑆲𑆱𑇀𑆠𑆴𑆯𑆶𑆟𑇀𑆝𑆳𑆑𑆳𑆫𑆳𑆁 𑆤𑆳𑆝𑆵𑆁 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪 𑆠𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆁 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆳𑆮𑆫𑆟𑆳𑆮𑆸𑆠𑆩𑇀 𑇅 𑆲𑆱𑇀𑆠𑆴𑆯𑆶𑆟𑇀𑆝𑆴𑆑𑆪𑆳 𑆤𑆳𑆝𑇀𑆪𑆳 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆢𑇀𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆟𑆩𑇀 𑇅 𑆱𑆶𑆒𑆳 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆓𑆳 𑆲𑇀𑆪𑆼𑆰𑆳 𑆤 𑆖 𑆑𑇀𑆬𑆴𑆯𑇀𑆤𑆳𑆠𑆴 𑆩𑆳𑆤𑆮𑆩𑇀 𑇆𑇖𑇆
𑆮𑇀𑆪𑆳𑆩𑆳𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑇀𑆫𑆴𑆫𑇀𑆮𑆑𑇀𑆫𑆳 𑆲𑆱𑇀𑆠𑆴𑆲𑆱𑇀𑆠𑆱𑆩𑆳𑆑𑆸𑆠𑆴𑆂 𑇅 𑆱𑇀𑆮𑆼𑆢𑆤𑆳𑆫𑇀𑆡𑆼 𑆲𑆴𑆠𑆳 𑆤𑆳𑆝𑆵 𑆑𑆽𑆬𑆴𑆚𑇀𑆘𑆵 𑆲𑆱𑇀𑆠𑆴𑆯𑆶𑆟𑇀𑆝𑆴𑆑𑆳 𑇆𑇗𑇆
𑆥𑆶𑆫𑆶𑆰𑆳𑆪𑆳𑆩𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆖 𑆨𑆷𑆩𑆴𑆩𑆶𑆠𑇀𑆑𑆵𑆫𑇀𑆪 𑆒𑆳𑆢𑆴𑆫𑆽𑆂 𑇅 𑆑𑆳𑆰𑇀𑆜𑆽𑆫𑇀𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆠𑆡𑆳𑇁𑇁𑆨𑇀𑆪𑆶𑆑𑇀𑆰𑇀𑆪 𑆑𑇀𑆰𑆵𑆫𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆮𑆳𑆫𑆴𑆨𑆴𑆂 𑇆𑇘𑇆
𑆥𑆠𑇀𑆫𑆨𑆕𑇀𑆓𑆽𑆫𑆮𑆖𑇀𑆗𑆳𑆢𑇀𑆪 𑆯𑆪𑆳𑆤𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀𑆠𑆠𑆂 𑇅 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆢𑇀𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆨𑆱𑇀𑆩𑆳𑆥𑆾𑆲𑇀𑆪𑆳𑆥𑆴 𑆮𑆳 𑆯𑆴𑆬𑆳𑆩𑇀 𑇆𑇙𑇆
𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆑𑆶𑆛𑆵𑆁 𑆮𑆳 𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆮𑆳𑆫𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆱𑇀𑆪𑆳𑆩𑆶𑆥𑆮𑆴𑆰𑇀𑆛𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆮𑆳𑆫𑆼𑇁𑆕𑇀𑆓𑆳𑆫𑆳𑆤𑆶𑆥𑆱𑆤𑇀𑆣𑆳𑆪 𑆠𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆑𑆾𑆯𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆮𑆳 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆪 𑆑𑆴𑆬𑆴𑆚𑇀𑆘𑆼𑇁𑆤𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆳 𑆠𑆠𑇀𑆥𑇀𑆫𑆠𑆴𑆫𑆷𑆥𑆑𑆼 𑆯𑆪𑆳𑆤𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆠𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀; 𑆍𑆮𑆁 𑆥𑆳𑆁𑆯𑆶𑆓𑆾𑆯𑆑𑆸𑆠𑇀𑆠𑆶𑆰𑆧𑆶𑆱𑆥𑆬𑆳𑆬𑆾𑆰𑇀𑆩𑆨𑆴𑆂 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆇𑆥𑆤𑆳𑆲𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆲𑆫𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆽𑆫𑆩𑇀𑆬𑆥𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆬𑆮𑆟𑆥𑇀𑆫𑆓𑆳𑆞𑆽𑆂 𑆱𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇅 𑆍𑆮𑆁 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑆼𑆬𑆳𑆢𑆴𑆨𑆴𑆂 𑆱𑆶𑆫𑆱𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆴𑆬𑆳𑆠𑆱𑆵𑆱𑆫𑇀𑆰𑆥𑆑𑆬𑇀𑆑𑆽𑆂 𑆑𑆸𑆯𑆫𑆳𑆥𑆳𑆪𑆱𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆨𑆴𑆫𑇀𑆮𑆼𑆯𑆮𑆳𑆫𑆽𑆂 𑆱𑆳𑆬𑇀𑆮𑆟𑆽𑆫𑇀𑆮𑆳 𑆠𑆤𑆶𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆽𑆂 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆢𑇀𑆫𑆮𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆲𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆮𑆳𑆡𑆥𑆷𑆫𑇀𑆟𑆼 𑆑𑆾𑆰𑇀𑆟𑆑𑆛𑆳𑆲𑆼 𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆮𑆳𑇁𑆮𑆓𑆳𑆲𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆍𑆮𑆁 𑆥𑆪𑆾𑆩𑆳𑆁𑆱𑆫𑆱𑆪𑆷𑆰𑆠𑆽𑆬𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆔𑆸𑆠𑆮𑆱𑆳𑆩𑆷𑆠𑇀𑆫𑆼𑆰𑇀𑆮𑆮𑆓𑆳𑆲𑆼𑆠; 𑆍𑆠𑆽𑆫𑆼𑆮 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆽𑆂 𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆼𑆢𑆴𑆠𑆴 𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫 𑆠𑆳𑆥𑆾𑆰𑇀𑆩𑆱𑇀𑆮𑆼𑆢𑆿 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆿, 𑆇𑆥𑆤𑆳𑆲𑆱𑇀𑆮𑆼𑆢𑆾 𑆮𑆳𑆠𑆔𑇀𑆤𑆂, 𑆃𑆤𑇀𑆪𑆠𑆫𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆴𑆠𑇀𑆠𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆢𑇀𑆫𑆮𑆱𑇀𑆮𑆼𑆢 𑆅𑆠𑆴 𑇆𑇑𑇔𑇆
𑆑𑆦𑆩𑆼𑆢𑆾𑆤𑇀𑆮𑆴𑆠𑆼 𑆮𑆳𑆪𑆿 𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆳𑆮𑆫𑆟𑆤𑆴𑆪𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆮𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆨𑆳𑆫𑆲𑆫𑆟𑆳𑆩𑆫𑇀𑆰𑆽𑆂 𑆱𑇀𑆮𑆼𑆢𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆼𑆢𑆴𑆠𑆴 𑇆𑇑𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾 𑆪𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆾 𑆢𑇀𑆮𑆴𑆣𑆳 𑆱𑇀𑆮𑆼𑆢𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑇅 𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮 𑆢𑆼𑆲𑆼 𑆠𑆶 𑆢𑆼𑆲𑆱𑇀𑆪𑆳𑆮𑆪𑆮𑆼 𑆠𑆡𑆳 𑇆𑇑𑇖𑇆
𑆪𑆼𑆰𑆳𑆁 𑆤𑆱𑇀𑆪𑆁 𑆮𑆴𑆣𑆳𑆠𑆮𑇀𑆪𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖𑆽𑆮 𑆲𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆯𑆾𑆣𑆤𑆵𑆪𑆳𑆯𑇀𑆖 𑆪𑆼 𑆑𑆼𑆖𑆴𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆠𑆼 𑆩𑆠𑆳𑆂 𑇆𑇑𑇗𑇆
𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳 𑆲𑆸𑆠𑆼 𑆯𑆬𑇀𑆪𑆼 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆳𑇁𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆳 𑇅 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆘𑆳𑆠𑆳 𑆑𑆳𑆬𑆼 𑆪𑆳 𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇆𑇑𑇘𑇆
𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆖 𑆥𑆯𑇀𑆖𑆳𑆖𑇀𑆖 𑆨𑆓𑆤𑇀𑆢𑆫𑇀𑆪𑆫𑇀𑆯𑆱𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆯𑇀𑆩𑆫𑇀𑆪𑆳 𑆖𑆳𑆠𑆶𑆫𑆾 𑆘𑆤𑇀𑆠𑆶𑆂 𑆯𑆼𑆰𑆳𑆚𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼 𑇆𑇑𑇙𑇆
𑆤𑆳𑆤𑆨𑇀𑆪𑆑𑇀𑆠𑆼 𑆤𑆳𑆥𑆴 𑆖𑆳𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆢𑆼𑆲𑆼 𑆱𑇀𑆮𑆼𑆢𑆾 𑆪𑆾𑆘𑇀𑆪𑆂 𑆱𑇀𑆮𑆼𑆢𑆮𑆴𑆢𑇀𑆨𑆴𑆂 𑆑𑆡𑆚𑇀𑆖𑆴𑆠𑇀 𑇅 𑆢𑆸𑆰𑇀𑆛𑆁 𑆬𑆾𑆑𑆼 𑆑𑆳𑆰𑇀𑆜𑆩𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆳𑆯𑆶 𑆓𑆖𑇀𑆗𑆼𑆢𑇀𑆨𑆕𑇀𑆓𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆾𑆓𑆽𑆫𑇀𑆓𑆸𑆲𑆵𑆠𑆩𑇀 𑇆𑇒𑇐𑇆
𑆱𑇀𑆤𑆼𑆲𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳 𑆣𑆳𑆠𑆶𑆱𑆁𑆱𑇀𑆡𑆳𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆂 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆱𑇀𑆡𑆳 𑆪𑆼 𑆖 𑆩𑆳𑆫𑇀𑆓𑆼𑆰𑆶 𑆬𑆵𑆤𑆳𑆂 𑇅 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑇀𑆮𑆼𑆢𑆽𑆫𑇀𑆪𑆾𑆘𑆴𑆠𑆽𑆱𑇀𑆠𑆼 𑆢𑇀𑆫𑆮𑆠𑇀𑆮𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆂 𑆑𑆾𑆰𑇀𑆜𑆁 𑆯𑆾𑆣𑆤𑆽𑆫𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆪𑆯𑆼𑆰𑆩𑇀 𑇆𑇒𑇑𑇆
𑆃𑆓𑇀𑆤𑆼𑆫𑇀𑆢𑆵𑆥𑇀𑆠𑆴𑆁 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆨𑆑𑇀𑆠𑆯𑇀𑆫𑆢𑇀𑆣𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆤𑆴𑆫𑇀𑆩𑆬𑆠𑇀𑆮𑆩𑇀 𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆾 𑆲𑆤𑇀𑆠𑆴 𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆱𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆱𑆤𑇀𑆣𑆵𑆤𑇀 𑆱𑇀𑆠𑆧𑇀𑆣𑆳𑆁𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆪𑆼𑆢𑆳𑆯𑆶 𑆪𑆶𑆑𑇀𑆠𑆂 𑇆𑇒𑇒𑇆
𑆱𑇀𑆮𑆼𑆢𑆳𑆱𑇀𑆫𑆳𑆮𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆲𑆳𑆤𑆴𑆫𑇀𑆬𑆔𑆶𑆠𑇀𑆮𑆁 𑆯𑆵𑆠𑆳𑆫𑇀𑆡𑆴𑆠𑇀𑆮𑆁 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆖𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑇅 𑆱𑆩𑇀𑆪𑆑𑇀𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑇀𑆫𑆳𑆲𑆶𑆫𑆼𑆠𑆤𑇀𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆮𑇀𑆪𑆠𑇀𑆪𑆪𑆼𑆤𑆽𑆠𑆢𑆼𑆮 𑇆𑇒𑇓𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑆤𑇀𑆣𑆴𑆥𑆵𑆝𑆳 𑆮𑆴𑆢𑆳𑆲𑆂 𑆱𑇀𑆦𑆾𑆛𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆂 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆢𑆳𑆲𑆠𑆸𑆰𑇀𑆟𑆼 𑆑𑇀𑆬𑆩𑆯𑇀𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆷𑆫𑇀𑆟𑆁 𑆠𑆠𑇀𑆫 𑆯𑆵𑆠𑆁 𑆮𑆴𑆣𑆳𑆤𑆩𑇀 𑇆𑇒𑇔𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑇀𑆩𑆼𑆲𑆵 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆵 𑆑𑇀𑆰𑆪𑆳𑆫𑇀𑆠𑆂 𑆑𑇀𑆰𑆳𑆩𑆾𑇁𑆘𑆵𑆫𑇀𑆟𑆵 𑆖𑆾𑆢𑆫𑆳𑆫𑇀𑆠𑆾 𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆂 𑇅 𑆠𑆸𑆝𑇀𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆳𑆫𑇀𑆠𑆾 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆥𑆵𑆠𑆩𑆢𑇀𑆪𑆾 𑆤𑆽𑆠𑆼 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳 𑆪𑆯𑇀𑆖 𑆩𑆫𑇀𑆠𑇀𑆪𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑆵 𑇅 𑆱𑇀𑆮𑆼𑆢𑆳𑆢𑆼𑆰𑆳𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆢𑆼𑆲𑆳 𑆮𑆴𑆤𑆳𑆯𑆁 𑆤𑆾𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆖𑆽𑆰𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑇆𑇒𑇕𑇆
𑆱𑇀𑆮𑆼𑆢𑆽𑆂 𑆱𑆳𑆣𑇀𑆪𑆾 𑆢𑆶𑆫𑇀𑆧𑆬𑆾𑇁𑆘𑆵𑆫𑇀𑆟𑆨𑆑𑇀𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑆳𑆁 𑆖𑆼𑆢𑇀𑆢𑇀𑆮𑆿 𑆱𑇀𑆮𑆼𑆢𑆤𑆵𑆪𑆿 𑆠𑆠𑆱𑇀𑆠𑆿 𑇅 𑆍𑆠𑆼𑆰𑆳𑆁 𑆱𑇀𑆮𑆼𑆢𑆱𑆳𑆣𑇀𑆪𑆳 𑆪𑆼 𑆮𑇀𑆪𑆳𑆣𑆪𑆱𑇀𑆠𑆼𑆰𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆩𑆸𑆢𑆷𑆤𑇀 𑆱𑇀𑆮𑆼𑆢𑆳𑆤𑇀 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆠𑆡𑆳 𑆲𑆸𑆤𑇀𑆩𑆶𑆰𑇀𑆑𑆢𑆸𑆰𑇀𑆛𑆴𑆰𑆶 𑇆𑇒𑇖𑇆
𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆱𑇀𑆮𑆼𑆢𑆳𑆤𑇀𑆤𑆴𑆮𑆳𑆠𑆼 𑆖 𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆯𑆵𑆠𑆽𑆫𑆳𑆖𑇀𑆗𑆳𑆢𑇀𑆪 𑆖𑆑𑇀𑆰𑆶𑆰𑆵 𑇆𑇒𑇗𑇆
𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆖 𑆩𑆶𑆲𑆶𑆫𑇀𑆲𑆸𑆢𑆪𑆁 𑆯𑆵𑆠𑆬𑆽𑆂 𑆱𑇀𑆥𑆸𑆯𑆼𑆠𑇀 𑇅 𑆱𑆩𑇀𑆪𑆑𑇀𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆮𑆴𑆩𑆸𑆢𑆴𑆠𑆁 𑆱𑇀𑆤𑆳𑆠𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆨𑆴𑆂 𑆯𑆤𑆽𑆂 𑇆𑇒𑇘𑇆
𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆠𑆳𑆕𑇀𑆓𑆁 𑆖 𑆤𑆴𑆮𑆳𑆠𑆯𑆫𑆟𑆱𑇀𑆡𑆴𑆠𑆩𑇀 𑇅 𑆨𑆾𑆘𑆪𑆼𑆢𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆱𑆫𑇀𑆮𑆁 𑆖𑆳𑆖𑆳𑆫𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑆳𑆣𑇀𑆪𑆾𑆥𑆢𑇀𑆫𑆮𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑆾𑆰𑆳𑆂 𑆑𑇀𑆰𑆵𑆟𑆳 𑆧𑆸𑆁𑆲𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂, 𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆥𑇀𑆫𑆯𑆩𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂, 𑆮𑆸𑆢𑇀𑆣𑆳 𑆤𑆴𑆫𑇀𑆲𑆫𑇀𑆠𑆮𑇀𑆪𑆳𑆂, 𑆱𑆩𑆳𑆂 𑆥𑆫𑆴𑆥𑆳𑆬𑇀𑆪𑆳 𑆅𑆠𑆴 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂 𑇆𑇓𑇆
𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆼𑆤 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆮𑆫𑇀𑆠𑆼𑆠𑆼 𑆤𑆴𑆫𑇀𑆲𑆫𑆟𑆼 𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆪𑆾𑆫𑇀𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪 𑇆𑇔𑇆
𑆃𑆡𑆳𑆠𑆶𑆫𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆨𑆴𑆫𑆳𑆲𑆳𑆫𑆽𑆫𑆤𑆮𑆧𑆢𑇀𑆣𑆢𑆾𑆰𑆩𑆮𑆬𑆾𑆑𑇀𑆪 𑆯𑇀𑆮𑆾 𑆮𑆩𑆤𑆁 𑆥𑆳𑆪𑆪𑆴𑆠𑆳𑇁𑆱𑇀𑆩𑆵𑆠𑆴 𑆱𑆩𑇀𑆨𑆾𑆘𑆪𑆼𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑆴𑆁 𑆧𑆬𑆮𑆤𑇀𑆠𑆁 𑆧𑆲𑆶𑆢𑆾𑆰𑆁 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆵𑆠𑆁 𑆮𑆩𑆤𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆖 𑇆𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆼𑆯𑆬𑆽𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑆤𑇀𑆤𑆽𑆫𑇀𑆢𑆾𑆰𑆳𑆤𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆪 𑆮𑆩𑆤𑆁 𑆢𑆠𑇀𑆠𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇖𑇆
𑆃𑆡𑆳𑆥𑆫𑆼𑆢𑇀𑆪𑆶𑆂 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆱𑆳𑆣𑆳𑆫𑆟𑆼 𑆑𑆳𑆬𑆼 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆑𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆳𑆪𑆪𑆴𑆠𑇀𑆮𑆳 𑆮𑆳𑆩𑆪𑆼𑆢𑇀𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆑𑆾𑆰𑇀𑆜𑆮𑆴𑆯𑆼𑆰𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪; 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆧𑆵𑆨𑆠𑇀𑆱𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆢𑆶𑆫𑇀𑆢𑆫𑇀𑆯𑆤𑆳𑆤𑆴 𑆖 𑆮𑆩𑆤𑆳𑆤𑆴 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆴; 𑆠𑆠𑇀𑆫 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆁 𑆑𑆸𑆯𑆁 𑆧𑆳𑆬𑆁 𑆮𑆸𑆢𑇀𑆣𑆁 𑆨𑆵𑆫𑆶𑆁 𑆮𑆳 𑆮𑆩𑆤𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆠𑆑𑇀𑆫𑆪𑆮𑆳𑆓𑆷𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆳𑆑𑆟𑇀𑆜𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆥𑆵𑆠𑆿𑆰𑆣𑆁 𑆖 𑆥𑆳𑆟𑆴𑆨𑆴𑆫𑆓𑇀𑆤𑆴𑆠𑆥𑇀𑆠𑆽𑆂 𑆥𑇀𑆫𑆠𑆳𑆥𑇀𑆪𑆩𑆳𑆤𑆁 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠; 𑆠𑆱𑇀𑆪 𑆖 𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆼𑆟 𑆯𑆴𑆡𑆴𑆬𑆠𑆳𑆩𑆳𑆥𑆤𑇀𑆤𑆁 𑆱𑇀𑆮𑆼𑆨𑇀𑆪𑆂 𑆱𑇀𑆡𑆳𑆤𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆖𑆬𑆴𑆠𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆩𑆤𑆶𑆱𑆸𑆠𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆘𑆳𑆤𑆶𑆩𑆳𑆠𑇀𑆫𑆳𑆱𑆤𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆩𑆳𑆥𑇀𑆠𑆽𑆫𑇀𑆬𑆬𑆳𑆛𑆼 𑆥𑆸𑆰𑇀𑆜𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂 𑆑𑆟𑇀𑆜𑆼 𑆖 𑆥𑆳𑆟𑆴𑆨𑆴𑆂 𑆱𑆶𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆩𑆕𑇀𑆓𑆶𑆬𑆵𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆲𑆱𑇀𑆠𑆾𑆠𑇀𑆥𑆬𑆤𑆳𑆬𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆑𑆟𑇀𑆜𑆩𑆨𑆴𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆁 𑆮𑆳𑆩𑆪𑆼𑆠𑇀𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆳𑆤𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆵𑆠𑆴 𑇆𑇗𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆁 𑆲𑆸𑆢𑆪𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆁 𑆑𑆟𑇀𑆝𑆷𑆁 𑆖 𑆢𑆶𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆠𑆬𑆴𑆕𑇀𑆓𑆩𑆳𑆲𑆶𑆂 𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑆴𑆪𑆾𑆓𑆁 𑆖 𑆮𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆠𑆳𑆁 𑆖 𑆲𑆸𑆠𑇀𑆑𑆟𑇀𑆜𑆥𑆵𑆝𑆳𑆩𑆥𑆴 𑆖𑆳𑆠𑆴𑆮𑆳𑆤𑇀𑆠𑆼 𑇆𑇘𑇆
𑆥𑆴𑆠𑇀𑆠𑆼 𑆑𑆦𑆱𑇀𑆪𑆳𑆤𑆶 𑆱𑆶𑆒𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆼 𑆯𑆶𑆢𑇀𑆣𑆼𑆰𑆶 𑆲𑆸𑆠𑇀𑆑𑆟𑇀𑆜𑆯𑆴𑆫𑆂𑆱𑆶 𑆖𑆳𑆥𑆴 𑇅 𑆬𑆔𑆿 𑆖 𑆢𑆼𑆲𑆼 𑆑𑆦𑆱𑆁𑆱𑇀𑆫𑆮𑆼 𑆖 𑆱𑇀𑆡𑆴𑆠𑆼 𑆱𑆶𑆮𑆳𑆤𑇀𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆳𑆤𑇀𑆠𑆁 𑆖𑆽𑆤𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆩𑆤𑆳𑆤𑆳𑆁 𑆣𑆷𑆩𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆠𑆂 𑆥𑆳𑆪𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑇁𑆖𑆳𑆫𑆴𑆑𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆠𑆾𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆯𑆶𑆖𑆴𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆩𑆶𑆰𑇀𑆟𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆂 𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆩𑇀 𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆩𑆶𑆢𑇀𑆓𑆳𑆞𑆑𑆴𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆳𑆁 𑆪𑆷𑆰𑆽 𑆫𑆱𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆥𑆨𑆾𑆘𑆪𑆼𑆠𑇀𑆠𑆶 𑇆𑇑𑇑𑇆
𑆑𑆳𑆱𑆾𑆥𑆬𑆼𑆥𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆤𑆴𑆢𑇀𑆫𑆳𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆱𑇀𑆪𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆮𑆴𑆰𑆾𑆥𑆱𑆫𑇀𑆓𑆳𑆂 𑇅 𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑇀𑆫𑆢𑆾𑆰𑆳 𑆤 𑆱𑆤𑇀𑆠𑆴 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆮𑆩𑆠𑆂 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑇆𑇑𑇒𑇆
𑆗𑆴𑆤𑇀𑆤𑆼 𑆠𑆫𑆿 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆥𑇀𑆫𑆫𑆾𑆲𑆳 𑆪𑆡𑆳 𑆮𑆴𑆤𑆳𑆯𑆁 𑆱𑆲𑆱𑆳 𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑆴 𑇅 𑆠𑆡𑆳 𑆲𑆸𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆯𑆾𑆣𑆤𑆼𑆤 𑆠𑆘𑇀𑆘𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆯𑆩𑆁 𑆥𑇀𑆫𑆪𑆳𑆤𑇀𑆠𑆴 𑇆𑇑𑇓𑇆
𑆤 𑆮𑆳𑆩𑆪𑆼𑆠𑇀𑆠𑆽𑆩𑆴𑆫𑆴𑆑𑆾𑆫𑇀𑆣𑇀𑆮𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆥𑇀𑆬𑆵𑆲𑆑𑆸𑆩𑆴𑆯𑇀𑆫𑆩𑆳𑆫𑇀𑆠𑆳𑆤𑇀 𑇅 𑆱𑇀𑆡𑆷𑆬𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆑𑆸𑆯𑆳𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆳𑆠𑆶𑆫𑆳𑆤𑇀 𑆑𑆼𑆮𑆬𑆮𑆳𑆠𑆫𑆾𑆓𑆳𑆤𑇀 𑇆𑇑𑇔𑇆
𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠𑆳𑆣𑇀𑆪𑆪𑆤𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆢𑆶𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆢𑆶𑆂𑆑𑆾𑆰𑇀𑆜𑆠𑆸𑆝𑆳𑆫𑇀𑆠𑆧𑆳𑆬𑆳𑆤𑇀 𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆳𑆱𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆴𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆳𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆴𑆤𑆴𑆫𑆷𑆲𑆴𑆠𑆳𑆁𑆯𑇀𑆖 𑇆𑇑𑇕𑇆
𑆃𑆮𑆩𑇀𑆪𑆮𑆩𑆤𑆳𑆢𑇀𑆫𑆾𑆓𑆳𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆳𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆃𑆱𑆳𑆣𑇀𑆪𑆠𑆳𑆁 𑆮𑆳 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆤𑆽𑆠𑆼 𑆮𑆳𑆩𑇀𑆪𑆳𑆱𑇀𑆠𑆠𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇖𑇆
𑆍𑆠𑆼𑇁𑆥𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆮𑇀𑆪𑆡𑆴𑆠𑆳 𑆮𑆳𑆩𑇀𑆪𑆳 𑆪𑆼 𑆖 𑆮𑆴𑆰𑆳𑆠𑆶𑆫𑆳𑆂 𑇅 𑆃𑆠𑆵𑆮 𑆖𑆾𑆬𑇀𑆧𑆟𑆑𑆦𑆳𑆱𑇀𑆠𑆼 𑆖 𑆱𑇀𑆪𑆶𑆫𑇀𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇆𑇑𑇗𑇆
𑆮𑆳𑆩𑇀𑆪𑆳𑆱𑇀𑆠𑆶- 𑆮𑆴𑆰𑆯𑆾𑆰𑆱𑇀𑆠𑆤𑇀𑆪𑆢𑆾𑆰𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑇀𑆪𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆯𑇀𑆬𑆵𑆥𑆢𑆳𑆫𑇀𑆧𑆶𑆢𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳𑆩𑆼𑆢𑆾𑆩𑆼𑆲𑆓𑆫𑆘𑇀𑆮𑆫𑆳𑆫𑆶𑆖𑇀𑆪𑆥𑆖𑇀𑆪𑆳𑆩𑆳𑆠𑆵𑆱𑆳𑆫𑆲𑆸𑆢𑇀𑆫𑆾𑆓- 𑆖𑆴𑆠𑇀𑆠𑆮𑆴𑆨𑇀𑆫𑆩𑆮𑆴𑆱𑆫𑇀𑆥𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆩𑆶𑆒𑆥𑇀𑆫𑆱𑆼𑆑𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆥𑆵𑆤𑆱𑆥𑆷𑆠𑆵𑆤𑆳𑆱𑆑𑆟𑇀𑆜𑆿𑆰𑇀𑆜𑆮𑆑𑇀𑆠𑇀𑆫𑆥𑆳𑆑- 𑆑𑆫𑇀𑆟𑆱𑇀𑆫𑆳𑆮𑆳𑆣𑆴𑆘𑆴𑆲𑇀𑆮𑆾𑆥𑆘𑆴𑆲𑇀𑆮𑆴𑆑𑆳𑆓𑆬𑆯𑆶𑆟𑇀𑆝𑆴𑆑𑆳𑆣𑆂𑆯𑆾𑆟𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆂 𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆘𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼 𑆖 𑆑𑆦𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆵𑆠𑆳 𑆅𑆠𑆴 𑇆𑇑𑇘𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑆥𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆪 𑆮𑆳𑆤𑇀𑆠𑆳𑆪 𑆖 𑆢𑆼𑆪𑆩𑇀; 𑆃𑆮𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆲𑆴 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆫𑆵𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆱𑆠𑆾𑇁𑆣𑆂 𑆱𑇀𑆫𑆱𑇀𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆓𑇀𑆫𑆲𑆟𑆵𑆁 𑆗𑆳𑆢𑆪𑆠𑆴, 𑆓𑆿𑆫𑆮𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆁 𑆮𑆳 𑆘𑆤𑆪𑆠𑆴 𑇆𑇑𑇙𑇆
𑆃𑆡𑆳𑆠𑆶𑆫𑆁 𑆯𑇀𑆮𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆥𑆳𑆪𑆪𑆴𑆠𑆳𑇁𑆱𑇀𑆩𑆵𑆠𑆴 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆬𑆔𑆶 𑆨𑆾𑆘𑆪𑆼𑆠𑇀, 𑆦𑆬𑆳𑆩𑇀𑆬𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆁 𑆖𑆽𑆤𑆩𑆤𑆶𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇅 𑆃𑆡𑆳𑆥𑆫𑆼𑇁𑆲𑆤𑆴 𑆮𑆴𑆓𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆣𑆳𑆠𑆶𑆩𑆳𑆠𑆶𑆫𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆵𑆪𑆳𑆢𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑆶𑆫𑆩𑆡𑆳𑆱𑇀𑆩𑆽 𑆐𑆰𑆣𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆳𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆠𑆠𑇀𑆫 𑆩𑆸𑆢𑆶𑆂, 𑆑𑇀𑆫𑆷𑆫𑆾, 𑆩𑆣𑇀𑆪𑆩 𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂 𑆑𑆾𑆰𑇀𑆜𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆧𑆲𑆶𑆥𑆴𑆠𑇀𑆠𑆾 𑆩𑆸𑆢𑆶𑆂, 𑆱 𑆢𑆶𑆓𑇀𑆣𑆼𑆤𑆳𑆥𑆴 𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼; 𑆧𑆲𑆶𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆑𑇀𑆫𑆷𑆫𑆂, 𑆱 𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆂; 𑆱𑆩𑆢𑆾𑆰𑆾 𑆩𑆣𑇀𑆪𑆩𑆂, 𑆱 𑆱𑆳𑆣𑆳𑆫𑆟 𑆅𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆩𑆸𑆢𑆿 𑆩𑆳𑆠𑇀𑆫𑆳 𑆩𑆸𑆢𑇀𑆮𑆵, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳 𑆑𑇀𑆫𑆷𑆫𑆼, 𑆩𑆣𑇀𑆪𑆼 𑆩𑆣𑇀𑆪𑆳 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆼𑆠𑆴 𑇅 𑆥𑆵𑆠𑆿𑆰𑆣𑆯𑇀𑆖 𑆠𑆤𑇀𑆩𑆤𑆳𑆂 𑆯𑆪𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆯𑆼 𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇑𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆥𑆵𑆠𑆮𑆳𑆁𑆱𑇀𑆠𑆶 𑆤 𑆮𑆼𑆓𑆳𑆤𑇀 𑆣𑆳𑆫𑆪𑆼𑆢𑇀𑆧𑆶𑆣𑆂 𑇅 𑆤𑆴𑆮𑆳𑆠𑆯𑆳𑆪𑆵 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶 𑆤 𑆱𑇀𑆥𑆸𑆯𑆼𑆤𑇀𑆤 𑆥𑇀𑆫𑆮𑆳𑆲𑆪𑆼𑆠𑇀 𑇆𑇒𑇒𑇆
𑆪𑆡𑆳 𑆖 𑆮𑆩𑆤𑆼 𑆥𑇀𑆫𑆱𑆼𑆑𑆿𑆰𑆣𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆂 𑆑𑇀𑆫𑆩𑆼𑆟 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴, 𑆍𑆮𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆥𑆴𑆠𑇀𑆠𑆿𑆰𑆣𑆑𑆦𑆳 𑆅𑆠𑆴 𑇆𑇒𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆲𑆸𑆠𑇀𑆑𑆶𑆑𑇀𑆰𑇀𑆪𑆯𑆶𑆢𑇀𑆣𑆴𑆂 𑆥𑆫𑆴𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆷𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆯𑇀𑆖 𑆤 𑆱𑆢𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆼 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆓𑆶𑆢𑆨𑇀𑆫𑆁𑆯𑆑𑆦𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆂 𑆯𑆷𑆬𑆾𑆢𑇀𑆓𑆩𑆯𑇀𑆖𑆳𑆠𑆴𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆩𑇀 𑇆𑇒𑇔𑇆

𑆑𑇀𑆫𑆩𑆯𑆂... 𑇅𑇑𑇒𑇗𑇅 ...𑆧𑆬𑆴𑆤𑆼 𑆢𑆼𑆪𑆁 𑆮𑆩𑆤𑆁 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆘𑇀𑆮𑆫𑆼 𑇅 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆳𑆪𑆼 𑆮𑆴𑆫𑆼𑆑𑆱𑇀𑆠𑆶 𑆑𑆳𑆫𑇀𑆪𑆂 𑆥𑇀𑆫𑆯𑆴𑆡𑆴𑆬𑆳𑆯𑆪𑆼 𑇆𑇑𑇒𑇗𑇆
𑆱𑆫𑆶𑆘𑆼𑇁𑆤𑆴𑆬𑆘𑆼 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆼 𑆤𑆴𑆫𑆷𑆲𑆟𑆩𑇀 𑇅 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆠𑆱𑇀𑆪 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆼𑆫𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇑𑇒𑇘𑇆
𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪 𑆱𑆩𑆳𑆣𑇀𑆩𑆳𑆠𑆩𑆶𑆢𑆫𑆁 𑆱𑆫𑆶𑆘𑆁 𑆢𑆴𑆲𑆼𑆠𑇀 𑇅 𑆢𑆳𑆫𑆶𑆲𑆽𑆩𑆮𑆠𑆵𑆑𑆶𑆰𑇀𑆜𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂 𑇆𑇑𑇓𑇐𑇆
𑆃𑆩𑇀𑆬𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆽𑆯𑇀𑆖... 𑇅𑇑𑇓𑇑𑇅 ...𑆥𑆮𑆤𑆼 𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆓𑆠𑆼 𑇅 𑆫𑆶𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆥𑆷𑆫𑆵𑆰𑆳𑆪 𑆓𑆶𑆢𑆼 𑆮𑆫𑇀𑆠𑆴𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇓𑇑𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆪𑆮𑆳𑆤𑆵𑆖𑆮𑇀𑆪𑆱𑆳𑆣𑆴𑆠𑆳𑆩𑇀 𑇅 𑆥𑆳𑆪𑆪𑆼𑆠 𑆪𑆮𑆳𑆓𑆷𑆁 𑆮𑆳 𑆩𑆳𑆫𑆶𑆠𑆳𑆢𑇀𑆪𑆤𑆶𑆬𑆾𑆩𑆴𑆤𑆵𑆩𑇀 𑇆𑇑𑇓𑇒𑇆
𑆑𑆸𑆯𑆁 𑆖𑆽𑆮𑆳𑆬𑇀𑆥𑆢𑆾𑆰𑆁 𑆖 𑆯𑆩𑆤𑆵𑆪𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆇𑆥𑆮𑆳𑆱𑆽𑆫𑇀𑆧𑆬𑆱𑇀𑆡𑆁 𑆠𑆶 𑆘𑇀𑆮𑆫𑆼 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆾𑆠𑇀𑆡𑆴𑆠𑆼 𑇆𑇑𑇓𑇔𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆩𑇀𑆨𑆱𑆳 𑆥𑆯𑇀𑆖𑆳𑆘𑇀𑆘𑆵𑆫𑇀𑆟𑆼 𑆪𑆷𑆰𑆫𑆱𑆿𑆢𑆤𑆩𑇀 𑇅 𑆇𑆥𑆮𑆳𑆱𑆯𑇀𑆫𑆩𑆑𑆸𑆠𑆼 𑆑𑇀𑆰𑆵𑆟𑆁(𑆟𑆼) 𑆮𑆳𑆠𑆳𑆣𑆴𑆑𑆼 𑆘𑇀𑆮𑆫𑆼 𑇆𑇑𑇓𑇖𑇆
𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆴𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆤𑆫𑆁 𑆩𑆳𑆁𑆱𑆫𑆱𑆿𑆢𑆤𑆩𑇀 𑇅 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆿𑆢𑆤𑆯𑇀𑆖𑆳𑆥𑆴 𑆲𑆴𑆠𑆂 𑆑𑆦𑆱𑆩𑆶𑆠𑇀𑆡𑆴𑆠𑆼 𑇆𑇑𑇓𑇗𑇆
𑆲𑇀𑆫𑆱𑇀𑆮𑆩𑆷𑆬𑆑𑆪𑆷𑆰𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆣𑆴𑆑𑆼 𑆲𑆴𑆠𑆂 𑇅 𑆥𑆛𑆾𑆬𑆤𑆴𑆩𑇀𑆧𑆪𑆷𑆰𑆱𑇀𑆠𑆶 𑆥𑆡𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆼 𑇆𑇑𑇓𑇙𑇆
𑆢𑆳𑆲𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆪𑆶𑆠𑆁 𑆑𑇀𑆰𑆳𑆩𑆁 𑆤𑆴𑆫𑆤𑇀𑆤𑆁 𑆠𑆸𑆰𑇀𑆟𑆪𑆳𑇁𑆫𑇀𑆢𑆴𑆠𑆩𑇀 𑇅 𑆱𑆴𑆠𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆠𑆁 𑆬𑆳𑆘𑆠𑆫𑇀𑆥𑆟𑆁 𑆥𑆳𑆪𑆪𑆼𑆠 𑆖 𑇆𑇑𑇔𑇐𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆥𑆫𑆵𑆠𑆱𑇀𑆪 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼𑇁𑆱𑆸𑆑𑇀𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆱𑇀𑆠𑆡𑆳 𑇅 𑆩𑆢𑇀𑆪𑆤𑆴𑆠𑇀𑆪𑆱𑇀𑆪 𑆤 𑆲𑆴𑆠𑆳 𑆪𑆮𑆳𑆓𑆷𑆱𑇀𑆠𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇔𑇑𑇆
𑆮𑆴𑆧𑆢𑇀𑆣𑆂 𑆱𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆯𑇀𑆖 𑆫𑆷𑆑𑇀𑆰𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆘𑇀𑆮𑆫𑆵 𑇅 𑆥𑆴𑆥𑆳𑆱𑆳𑆫𑇀𑆠𑆂 𑆱𑆢𑆳𑆲𑆾 𑆮𑆳 𑆥𑆪𑆱𑆳 𑆱 𑆱𑆶𑆒𑆵 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇔𑇔𑇆
𑆃𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑆲𑇀𑆪𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆂 𑆑𑇀𑆰𑆵𑆪𑆠𑆼 𑆩𑇀𑆫𑆴𑆪𑆠𑆼𑇁𑆡𑆮𑆳 𑇅 𑆱 𑆑𑇀𑆰𑆵𑆟𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆳𑆁 𑆪𑆳𑆠𑆴 𑆪𑆳𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆩𑆼𑆮 𑆖 𑇆𑇑𑇔𑇗𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆑𑇀𑆰𑆼𑆢𑇀𑆧𑆬𑆁 𑆥𑆶𑆁𑆱𑆳𑆁 𑆧𑆬𑆼 𑆱𑆠𑆴 𑆲𑆴 𑆘𑆵𑆮𑆴𑆠𑆩𑇀 𑇅 𑆓𑆶𑆫𑇀𑆮𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑇀𑆪𑆑𑆳𑆬𑆼 𑆖 𑆘𑇀𑆮𑆫𑆵 𑆤𑆳𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆡𑆚𑇀𑆖𑆤 𑇆𑇑𑇔𑇘𑇆
𑆑𑆫𑇀𑆑𑆾𑆛𑆑𑆁 𑆥𑆫𑇀𑆥𑆛𑆑𑆁 𑆓𑆾𑆘𑆴𑆲𑇀𑆮𑆳𑆁 𑆧𑆳𑆬𑆩𑆷𑆬𑆑𑆩𑇀 𑇅 𑆥𑆠𑇀𑆫𑆁 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆳𑆂 𑆯𑆳𑆑𑆳𑆫𑇀𑆡𑆼 𑆘𑇀𑆮𑆫𑆴𑆠𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇒𑇆
𑆬𑆳𑆮𑆳𑆤𑇀 𑆑𑆥𑆴𑆚𑇀𑆘𑆬𑆳𑆤𑆼𑆟𑆳𑆤𑇀 𑆥𑆸𑆰𑆠𑆳𑆚𑇀𑆗𑆫𑆨𑆳𑆚𑇀𑆗𑆯𑆳𑆤𑇀 𑇅 𑆑𑆳𑆬𑆥𑆶𑆖𑇀𑆗𑆳𑆤𑇀 𑆑𑆶𑆫𑆕𑇀𑆓𑆳𑆁𑆯𑇀𑆖 𑆠𑆡𑆽𑆮 𑆩𑆸𑆓𑆩𑆳𑆠𑆸𑆑𑆳𑆤𑇀 𑇆𑇑𑇕𑇓𑇆
(𑆱𑇀𑆤𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑆵𑆠𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆪𑆾𑆰𑆴𑆠𑆂) 𑇅 𑆑𑆰𑆳𑆪𑆓𑆶𑆫𑆶𑆫𑆷𑆑𑇀𑆰𑆳𑆟𑆴 𑆑𑇀𑆫𑆾𑆣𑆳𑆢𑆵𑆤𑆴 𑆠𑆡𑆽𑆮 𑆖 𑇆𑇑𑇕𑇗𑇆
𑆱𑆳𑆫𑆮𑆤𑇀𑆠𑆴 𑆖 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑆠𑆫𑆶𑆟𑆘𑇀𑆮𑆫𑆵 𑇅 𑆠𑆡𑆽𑆮 𑆤𑆮𑆣𑆳𑆤𑇀𑆪𑆳𑆢𑆴𑆁 𑆮𑆫𑇀𑆘𑆪𑆼𑆖𑇀𑆖 𑆱𑆩𑆳𑆱𑆠𑆂 𑇆𑇑𑇕𑇘𑇆
𑆃𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆢𑆾𑆰𑆳𑆓𑇀𑆤𑆼𑆫𑆼𑆨𑆴𑆂 𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆴𑆠𑆾 𑆘𑇀𑆮𑆫𑆂 𑇅 𑆓𑆩𑇀𑆨𑆵𑆫𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆮𑆼𑆓𑆠𑇀𑆮𑆁 𑆪𑆳𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆩𑆼𑆮 𑆖 𑇆𑇑𑇕𑇙𑇆
𑆯𑆵𑆠𑆠𑆾𑆪𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆑𑇀𑆫𑆾𑆣𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆪𑆾𑆰𑆴𑆠𑆂 𑇅 𑆤 𑆱𑆼𑆮𑆼𑆠 𑆘𑇀𑆮𑆫𑆾𑆠𑇀𑆱𑆸𑆰𑇀𑆛𑆾 𑆪𑆳𑆮𑆤𑇀𑆤 𑆧𑆬𑆮𑆳𑆤𑇀 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇖𑇐𑇆
𑆩𑆶𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆘𑇀𑆮𑆫𑆼𑆟𑆳𑆯𑆶 𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪𑆳𑆲𑆴𑆠𑆽𑆫𑇀𑆘𑇀𑆮𑆫𑆂 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆾 𑆢𑆲𑆼𑆢𑇀𑆢𑆼𑆲𑆁 𑆯𑆶𑆰𑇀𑆑𑆁 𑆮𑆸𑆑𑇀𑆰𑆩𑆴𑆮𑆳𑆤𑆬𑆂 𑇆𑇑𑇖𑇑𑇆

𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆼 𑆱𑇀𑆮𑆼𑆢𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆁 𑆔𑆸𑆠𑆼𑆤 𑆬𑆮𑆟𑆼𑆤 𑆖𑇅 𑆱𑆼𑆑𑆳𑆁𑆯𑇀𑆖𑆾𑆰𑇀𑆟𑆳𑆤𑇀 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆨𑆾𑆘𑇀𑆪𑆁 𑆥𑆳𑆤𑆁 𑆖 𑆱𑆫𑇀𑆥𑆴𑆰𑆂𑇆𑇑𑇗𑇓𑇆
𑆍𑆠𑆢𑆼𑆮𑆾𑆖𑇀𑆖𑆴𑆛𑆴𑆕𑇀𑆓𑆼𑇁𑆥𑆴 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆁 𑆖 𑆥𑆳𑆁𑆯𑆶𑆨𑆴𑆂𑇅 𑆇𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆁 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆷𑆰𑇀𑆟𑆽𑆱𑇀𑆠𑆡𑆳𑇁𑆮𑆖𑇀𑆗𑆳𑆢𑆤𑆁 𑆔𑆤𑆽𑆂𑇆𑇑𑇗𑇔𑇆
𑆯𑇀𑆮𑆳 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆠𑇀𑆠𑆶 𑆠𑆡𑆳 𑆣𑆳𑆠𑆶𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀𑇅 𑆯𑆴𑆫𑆾𑇁𑆨𑆴𑆠𑆳𑆥𑆵 𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆣𑆾𑆮𑆑𑇀𑆠𑇀𑆫𑆱𑇀𑆠𑆡𑆳 𑆨𑆮𑆼𑆠𑇀𑇆𑇑𑇗𑇕𑇆
𑆃𑆤𑇀𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁𑆮𑆴𑆣𑆳 𑆮𑇀𑆪𑆳𑆬𑆳𑆂 𑆑𑆦𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆂𑇅 𑆲𑆸𑆖𑇀𑆗𑆴𑆫𑆾𑆫𑆶𑆓𑇀𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆩𑇀𑆨𑆠𑆸𑆰𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆑𑆫𑆳 𑆩𑆠𑆳𑆂𑇆𑇑𑇗𑇖𑇆
𑆑𑆟𑇀𑆝𑆷𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆱𑆶𑆥𑇀𑆠𑆴𑆑𑇀𑆬𑆼𑆢𑆾𑆥𑆯𑆾𑆰𑆟𑆩𑇀𑇅 𑆮𑆴𑆢𑆳𑆲𑆫𑆳𑆓𑆫𑆶𑆑𑇀𑆥𑆳𑆑𑆳𑆂 𑆯𑆾𑆦𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆤𑆴𑆑𑆶𑆚𑇀𑆖𑆤𑆩𑇀𑇆𑇑𑇗𑇗𑇆
𑆢𑆁𑆯𑆳𑆮𑆢𑆫𑆟𑆁 𑆱𑇀𑆦𑆾𑆛𑆳𑆂 𑆑𑆫𑇀𑆟𑆴𑆑𑆳 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆖𑇅 𑆘𑇀𑆮𑆫𑆯𑇀𑆖 𑆱𑆮𑆴𑆰𑆼 𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆠𑆶 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆼𑇆𑇑𑇗𑇘𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆼 𑆪𑆡𑆳𑆮𑆱𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆳𑆂𑇅 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳 𑆮𑆴𑆣𑆴𑆩𑆤𑇀𑆪𑆁 𑆖 𑆪𑆡𑆳𑆮𑆢𑇀𑆧𑇀𑆫𑆶𑆮𑆠𑆂 𑆯𑆸𑆟𑆶𑇆𑇑𑇗𑇙𑇆
𑆲𑆸𑆢𑇀𑆮𑆴𑆢𑆳𑆲𑆼 𑆥𑇀𑆫𑆱𑆼𑆑𑆼 𑆮𑆳 𑆮𑆴𑆫𑆼𑆑𑆮𑆩𑆤𑆁 𑆨𑆸𑆯𑆩𑇀𑇅 𑆪𑆡𑆳𑆮𑆱𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆯𑆶𑆢𑇀𑆣𑆼 𑆱𑆁𑆱𑆫𑇀𑆘𑆤𑆑𑇀𑆫𑆩𑆂𑇆𑇑𑇘𑇐𑇆
𑆯𑆴𑆫𑆾𑆓𑆠𑆼 𑆮𑆴𑆰𑆼 𑆤𑆱𑇀𑆠𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆩𑆷𑆬𑆳𑆤𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀𑇅 𑆧𑆤𑇀𑆣𑆶𑆘𑆵𑆮𑆱𑇀𑆪 𑆨𑆳𑆫𑇀𑆓𑇀𑆪𑆳𑆯𑇀𑆖 𑆱𑆶𑆫𑆱𑆱𑇀𑆪𑆳𑆱𑆴𑆠𑆱𑇀𑆪 𑆖𑇆𑇑𑇘𑇑𑇆
𑆢𑆑𑇀𑆰𑆑𑆳𑆑𑆩𑆪𑆷𑆫𑆳𑆟𑆳𑆁 𑆩𑆳𑆁𑆱𑆳𑆱𑆸𑆕𑇀𑆩𑆱𑇀𑆠𑆑𑆼 𑆑𑇀𑆰𑆠𑆼𑇅 𑆇𑆥𑆣𑆼𑆪𑆩𑆣𑆾𑆢𑆰𑇀𑆛𑆱𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆥𑆳𑆢𑆪𑆾𑆂𑇆𑇑𑇘𑇒𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆑𑇀𑆰𑆳𑆫𑆮𑆖𑆳𑆱𑆽𑆤𑇀𑆣𑆮𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆳𑆂𑇅 𑆥𑆴𑆰𑇀𑆛𑆳 𑆫𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆔𑇀𑆤𑆤𑇀𑆠𑇀𑆪𑆑𑇀𑆰𑆴𑆓𑆠𑆩𑆚𑇀𑆘𑆤𑆳𑆠𑇀𑇆𑇑𑇘𑇓𑇆
𑆑𑆥𑆴𑆠𑇀𑆡𑆩𑆳𑆩𑆁 𑆱𑆱𑆴𑆠𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆑𑆟𑇀𑆜𑆓𑆠𑆼 𑆮𑆴𑆰𑆼𑇅 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑆳𑆩𑆳𑆯𑆪𑆓𑆠𑆼 𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆥𑆬𑆁 𑆤𑆠𑆳𑆠𑇀𑇆𑇑𑇘𑇔𑇆
𑆮𑆴𑆰𑆼 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆓𑆠𑆼 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆫𑆘𑆤𑆵𑆢𑇀𑆮𑆪𑆩𑇀𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆁 𑆖 𑆱𑆩𑆁 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆓𑆾𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆤𑆫𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇘𑇕𑇆
𑆫𑆑𑇀𑆠𑆁 𑆩𑆳𑆁𑆱𑆁 𑆖 𑆓𑆾𑆣𑆳𑆪𑆳𑆂 𑆯𑆶𑆰𑇀𑆑𑆁 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆲𑆴𑆠𑆩𑇀𑇅 𑆮𑆴𑆰𑆼 𑆫𑆱𑆓𑆠𑆼 𑆥𑆳𑆤𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆫𑆱𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇑𑇘𑇖𑇆
𑆯𑆼𑆬𑆾𑆫𑇀𑆩𑆷𑆬𑆠𑇀𑆮𑆓𑆓𑇀𑆫𑆳𑆟𑆴 𑆧𑆳𑆢𑆫𑆿𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆟𑆴 𑆖𑇅 𑆑𑆛𑆨𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆴𑆧𑆼𑆢𑇀𑆫𑆑𑇀𑆠𑆓𑆠𑆼, 𑆩𑆳𑆁𑆱𑆓𑆠𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇘𑇗𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆒𑆢𑆴𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆁 𑆑𑆿𑆛𑆘𑆁 𑆩𑆷𑆬𑆩𑆩𑇀𑆨𑆱𑆳𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆖 𑆧𑆬𑆼 𑆢𑇀𑆮𑆼 𑆠𑆶 𑆩𑆣𑆷𑆑𑆁 𑆩𑆣𑆶𑆑𑆁 𑆤𑆠𑆩𑇀𑇆𑇑𑇘𑇘𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆑𑇀𑆰𑆳𑆫𑆁 𑆤𑆮𑆤𑆵𑆠𑆼𑆤 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆩𑇀𑇅 𑆑𑆦𑆼 𑆨𑆴𑆰𑆓𑆶𑆢𑆵𑆫𑇀𑆟𑆼 𑆠𑆶 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆩𑇀𑇆𑇑𑇘𑇙𑇆
𑆩𑆳𑆁𑆱𑆵𑆑𑆶𑆕𑇀𑆑𑆶𑆩𑆥𑆠𑇀𑆫𑆠𑇀𑆮𑆓𑇀𑆫𑆘𑆤𑆵𑆤𑆠𑆖𑆤𑇀𑆢𑆤𑆽𑆂𑇅 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆤𑆒𑆱𑆶𑆫𑆱𑆽𑆫𑆩𑇀𑆧𑆶𑆥𑆼𑆰𑆴𑆠𑆽𑆂𑇆𑇑𑇙𑇐𑇆
𑆥𑆳𑆤𑆤𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆤𑆳𑆬𑆼𑆥𑆳𑆂 𑆱𑆫𑇀𑆮𑆯𑆾𑆡𑆮𑆴𑆰𑆳𑆥𑆲𑆳𑆂𑇅 𑆖𑆤𑇀𑆢𑆤𑆁 𑆠𑆓𑆫𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆢𑇀𑆮𑆼 𑆠𑇀𑆮𑆓𑆼𑆮 𑆖𑇆𑇑𑇙𑇑𑇆
𑆩𑆤𑆂𑆯𑆴𑆬𑆳 𑆠𑆩𑆳𑆬𑆯𑇀𑆖 𑆫𑆱𑆂 𑆑𑆽𑆯𑆫 𑆍𑆮 𑆖𑇅 𑆯𑆳𑆫𑇀𑆢𑆷𑆬𑆱𑇀𑆪 𑆤𑆒𑆯𑇀𑆖𑆽𑆮 𑆱𑆶𑆥𑆴𑆰𑇀𑆛𑆁 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇆𑇑𑇙𑇒𑇆
𑆲𑆤𑇀𑆠𑆴 𑆱𑆫𑇀𑆮𑆮𑆴𑆰𑆳𑆟𑇀𑆪𑆼𑆮 𑆮𑆘𑇀𑆫𑆴𑆮𑆘𑇀𑆫𑆩𑆴𑆮𑆳𑆱𑆶𑆫𑆳𑆤𑇀𑇅 𑆫𑆱𑆼 𑆯𑆴𑆫𑆵𑆰𑆥𑆶𑆰𑇀𑆥𑆱𑇀𑆪 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆩𑆫𑆴𑆖𑆁 𑆱𑆴𑆠𑆩𑇀𑇆𑇑𑇙𑇓𑇆
𑆨𑆳𑆮𑆴𑆠𑆁 𑆱𑆫𑇀𑆥𑆢𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆤𑆱𑇀𑆪𑆥𑆳𑆤𑆳𑆚𑇀𑆘𑆤𑆼 𑆲𑆴𑆠𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆥𑆬𑆁 𑆤𑆠𑆑𑆶𑆰𑇀𑆜𑆳𑆨𑇀𑆪𑆳𑆁 𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆖𑆠𑆶𑆰𑇀𑆥𑆬𑆩𑇀𑇆𑇑𑇙𑇔𑇆
𑆃𑆥𑆴 𑆠𑆑𑇀𑆰𑆑𑆢𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆥𑆳𑆤𑆩𑆼𑆠𑆠𑇀 𑆱𑆶𑆒𑆥𑇀𑆫𑆢𑆩𑇀𑇅 𑆱𑆴𑆤𑇀𑆣𑆶𑆮𑆳𑆫𑆱𑇀𑆪 𑆩𑆷𑆬𑆁 𑆖 𑆯𑇀𑆮𑆼𑆠𑆳 𑆖 𑆓𑆴𑆫𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑇆𑇑𑇙𑇕𑇆
𑆥𑆳𑆤𑆁 𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆤𑆱𑇀𑆪𑆁 𑆱𑆩𑆣𑆶 𑆥𑆳𑆑𑆬𑆩𑇀𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳 𑆩𑆣𑆶𑆪𑆰𑇀𑆛𑆵 𑆖 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆱𑆴𑆠𑆳𑇆𑇑𑇙𑇖𑇆
𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆁 𑆮𑆛𑆯𑆶𑆕𑇀𑆓𑆳𑆤𑆴 𑆥𑆳𑆤𑆁 𑆩𑆟𑇀𑆝𑆬𑆴𑆤𑆳𑆁 𑆮𑆴𑆰𑆼𑇅 𑆮𑇀𑆪𑆾𑆰𑆁 𑆱𑆳𑆠𑆴𑆮𑆴𑆰𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆓𑆸𑆲𑆣𑆷𑆩𑆾 𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑇆𑇑𑇙𑇗𑇆

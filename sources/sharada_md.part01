𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆽𑆂 𑆱𑇀𑆮𑆼𑆢𑆽𑆫𑇀𑆪𑆡𑆳𑆪𑆾𑆓𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆑𑇀𑆠𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆕𑇀𑆓𑆁 𑆠𑆶 𑆮𑆑𑇀𑆫𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆡𑆳𑆥𑆴 𑆮𑆳𑇆𑇗𑇙𑇆
𑆯𑆤𑆽𑆫𑇀𑆤𑆳𑆩𑆪𑆴𑆠𑆶𑆁 𑆯𑆑𑇀𑆪𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆯𑆶𑆰𑇀𑆑𑆢𑆳𑆫𑆶𑆮𑆠𑇀𑇅 𑆲𑆫𑇀𑆰𑆠𑆾𑆢𑆫𑆶𑆓𑆳𑆪𑆳𑆩𑆯𑆾𑆡𑆱𑇀𑆠𑆩𑇀𑆨𑆓𑇀𑆫𑆲𑆳𑆢𑆪𑆂𑇆𑇘𑇐𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆯𑆶 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆱𑇀𑆤𑆼𑆲𑆯𑇀𑆖 𑆣𑆳𑆠𑆷𑆤𑇀𑆱𑆁𑆯𑆶𑆰𑇀𑆑𑆳𑆤𑇀 𑆥𑆶𑆰𑇀𑆟𑆳𑆠𑇀𑆪𑆳𑆯𑆶 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆂𑇆𑇘𑇑𑇆
𑆧𑆬𑆩𑆓𑇀𑆤𑆴𑆧𑆬𑆁 𑆥𑆶𑆰𑇀𑆛𑆴𑆁 𑆥𑇀𑆫𑆳𑆟𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀𑇅 𑆃𑆱𑆑𑆸𑆠𑇀𑆠𑆁 𑆥𑆶𑆤𑆂 𑆱𑇀𑆤𑆼𑆲𑆽𑆂 𑆱𑇀𑆮𑆼𑆢𑆽𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆥𑆳𑆢𑆪𑆼𑆠𑇀𑇆𑇘𑇒𑇆
𑆠𑆡𑆳 𑆱𑇀𑆤𑆼𑆲𑆩𑆸𑆢𑆿 𑆑𑆾𑆰𑇀𑆜𑆼 𑆤 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑇀𑆪𑆤𑆴𑆬𑆳𑆩𑆪𑆳𑆂𑇅𑇘𑇓𑇅 𑆪𑆢𑇀𑆪𑆤𑆼𑆤 𑆱𑆢𑆾𑆰𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑆫𑇀𑆩𑆟𑆳 𑆤 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇘𑇓𑇆
𑆩𑆸𑆢𑆶𑆨𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆿𑆰𑆣𑆽𑆱𑇀𑆠𑆁 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀𑇅 𑆔𑆸𑆠𑆁 𑆠𑆴𑆬𑇀𑆮𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑆳𑆠𑆬𑆳𑆱𑆴𑆢𑇀𑆣𑆩𑆼𑆮 𑆮𑆳𑇆𑇘𑇔𑇆
𑆥𑆪𑆱𑆽𑆫𑆟𑇀𑆝𑆠𑆽𑆬𑆁 𑆮𑆳 𑆥𑆴𑆧𑆼𑆢𑇀𑆢𑆾𑆰𑆲𑆫𑆁 𑆯𑆴𑆮𑆩𑇀𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆾𑆰𑇀𑆟𑆳𑆢𑇀𑆪𑆽𑆫𑆳𑆲𑆳𑆫𑆽𑆫𑇀𑆲𑆴 𑆩𑆬𑆯𑇀𑆖𑆴𑆠𑆂𑇆𑇘𑇕𑇆
𑆱𑇀𑆫𑆾𑆠𑆾 𑆧𑆢𑇀𑆣𑇀𑆮𑆳𑇁𑆤𑆴𑆬𑆁 𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆩𑆤𑆶𑆬𑆾𑆩𑆪𑆼𑆠𑇀 𑇅 𑆢𑆶𑆫𑇀𑆧𑆬𑆾 𑆪𑆾𑇁𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆁 𑆤𑆴𑆫𑆷𑆲𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇘𑇖𑇆
𑆥𑆳𑆖𑆤𑆽𑆫𑇀𑆢𑆵𑆥𑆤𑆵𑆪𑆽𑆫𑇀𑆮𑆳 𑆨𑆾𑆘𑆤𑆽𑆱𑇀𑆠𑆢𑇀𑆪𑆶𑆠𑆽𑆫𑇀𑆤𑆫𑆩𑇀𑇅 𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪𑆾𑆠𑇀𑆡𑆴𑆠𑆼 𑆖𑆳𑆓𑇀𑆤𑆿 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆥𑆶𑆤𑆫𑇀𑆲𑆴𑆠𑆿𑇆𑇘𑇗𑇆
𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑆳𑆲𑆳𑆫𑆽𑆂 𑆱𑆠𑆠𑆁 𑆥𑆶𑆤𑆂𑇅 𑆤𑆳𑆮𑆤𑆽𑆫𑇀𑆣𑆷𑆩𑆥𑆳𑆤𑆽𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆳𑆤𑆼𑆮𑆾𑆥𑆥𑆳𑆢𑆪𑆼𑆠𑇀𑇆𑇘𑇘𑇆
𑆅𑆠𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅𑇘𑇙𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆡𑆼 𑆮𑆳𑆠𑆼 𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂𑇆𑇘𑇙𑇆
𑆥𑆳𑆖𑆤𑆽𑆫𑇀𑆢𑆵𑆥𑆤𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆩𑇀𑆬𑆽𑆫𑇀𑆮𑆳 𑆥𑆳𑆖𑆪𑆼𑆤𑇀𑆩𑆬𑆳𑆤𑇀𑇅 𑆓𑆶𑆢𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆼 𑆠𑆶 𑆑𑆫𑇀𑆩𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆤𑆶𑆢𑇀𑆣𑆴𑆠𑆩𑇀𑇆𑇙𑇐𑇆
𑆄𑆩𑆳𑆯𑆪𑆱𑇀𑆡𑆼 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆪𑆡𑆳𑆢𑆾𑆰𑆲𑆫𑆵𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆂𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆑𑆶𑆥𑆴𑆠𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆾 𑆧𑆱𑇀𑆠𑆪𑆂 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆂𑇆𑇙𑇑𑇆
𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆮𑆓𑆳𑆲𑆳𑆯𑇀𑆖 𑆲𑆸𑆢𑇀𑆪𑆁 𑆖𑆳𑆤𑇀𑆤𑆁 𑆠𑇀𑆮𑆓𑆳𑆯𑇀𑆫𑆴𑆠𑆼𑇅 𑆯𑆵𑆠𑆳𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆳 𑆫𑆑𑇀𑆠𑆱𑇀𑆡𑆼 𑆮𑆴𑆫𑆼𑆑𑆾 𑆫𑆑𑇀𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇙𑇒𑇆
𑆮𑆴𑆫𑆼𑆑𑆾 𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆂𑆱𑇀𑆡𑆼 𑆤𑆴𑆫𑆷𑆲𑆳𑆂 𑆯𑆩𑆤𑆳𑆤𑆴 𑆖𑇅 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆓𑆠𑆁 𑆘𑆪𑆼𑆠𑇀𑇆𑇙𑇓𑇆
𑆲𑆫𑇀𑆰𑆾𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆡𑆼 𑆧𑆬𑆯𑆶𑆑𑇀𑆫𑆑𑆫𑆁 𑆲𑆴𑆠𑆩𑇀𑇅 𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆮𑆳 𑆯𑆶𑆑𑇀𑆫𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇙𑇔𑇆
𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆥𑇀𑆫𑆠𑆴𑆨𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇅 𑆓𑆫𑇀𑆨𑆼 𑆯𑆶𑆰𑇀𑆑𑆼 𑆠𑆶 𑆮𑆳𑆠𑆼𑆤 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆖𑆳𑆥𑆴 𑆯𑆶𑆰𑇀𑆪𑆠𑆳𑆩𑇀𑇆𑇙𑇕𑇆
𑆱𑆴𑆠𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆩𑆣𑆶𑆑𑆽𑆫𑇀𑆲𑆴𑆠𑆩𑆶𑆠𑇀𑆡𑆳𑆥𑆤𑆼 𑆥𑆪𑆂𑇅 𑆲𑆸𑆢𑆴 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆼 𑆱𑆴𑆢𑇀𑆣𑆩𑆁𑆯𑆶𑆩𑆠𑇀𑆪𑆳 𑆥𑆪𑆾 𑆲𑆴𑆠𑆩𑇀𑇆𑇙𑇖𑇆
𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆳𑆨𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆱𑇀𑆡𑆼 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆧𑆴𑆬𑇀𑆮𑆯𑆬𑆳𑆛𑆶𑆨𑆴𑆂𑇅 𑆮𑆳𑆪𑆶𑆤𑆳 𑆮𑆼𑆰𑇀𑆛𑇀𑆪𑆩𑆳𑆤𑆼 𑆠𑆶 𑆓𑆳𑆠𑇀𑆫𑆼 𑆱𑇀𑆪𑆳𑆢𑆶𑆥𑆤𑆳𑆲𑆤𑆩𑇀𑇆𑇙𑇗𑇆
𑆠𑆽𑆬𑆁 𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆾 𑆩𑆳𑆰𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆳𑆣𑆴𑆠𑆩𑇀𑇅 𑆧𑆳𑆲𑆶𑆯𑆵𑆫𑇀𑆰𑆓𑆠𑆼 𑆤𑆱𑇀𑆪𑆁 𑆥𑆳𑆤𑆁 𑆖𑆿𑆠𑇀𑆠𑆫𑆨𑆑𑇀𑆠𑆴𑆑𑆩𑇀𑇆𑇙𑇘𑇆
𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆠𑇀𑆮𑆣𑆾 𑆤𑆳𑆨𑆼𑆂 𑆯𑆱𑇀𑆪𑆠𑆼 𑆖𑆳𑆮𑆥𑆵𑆝𑆑𑆂𑇅𑇙𑇙𑇅 𑆃𑆫𑇀𑆢𑆴𑆠𑆼 𑆤𑆳𑆮𑆤𑆁 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆠𑆽𑆬𑆁 𑆠𑆫𑇀𑆥𑆟𑆩𑆼𑆮 𑆖𑇆𑇙𑇙𑇆
𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆤𑆳𑆲𑆳𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆳𑆤𑆷𑆥𑆥𑆴𑆯𑆴𑆠𑆽𑆫𑇀𑆲𑆴𑆠𑆳𑆂𑇅 𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆼 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇑𑇐𑇐𑇆
𑆃𑆤𑇀𑆠𑆫𑆳𑆑𑆟𑇀𑆝𑆫𑆳𑆓𑆶𑆬𑇀𑆦𑆁 𑆱𑆴𑆫𑆳 𑆧𑆱𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩 𑆖𑇅 𑆓𑆸𑆣𑇀𑆫𑆱𑆵𑆰𑆶 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆒𑆬𑇀𑆬𑇀𑆪𑆳𑆁 𑆠𑆷𑆰𑇀𑆟𑆾𑆥𑆤𑆳𑆲𑆤𑆩𑇀𑇆𑇑𑇐𑇑𑇆
𑆥𑆳𑆪𑆱𑆽𑆂 𑆑𑆸𑆯𑆫𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆽𑆂 𑆯𑆱𑇀𑆠𑆁 𑆠𑆽𑆬𑆔𑆸𑆠𑆳𑆤𑇀𑆮𑆴𑆠𑆽𑆂𑇅 𑆮𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆤𑆤𑆼 𑆲𑆤𑆶𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆩𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪 𑆖𑇆𑇑𑇐𑇒𑇆
𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆨𑇀𑆪𑆳𑆁 𑆖𑆾𑆤𑇀𑆤𑆳𑆨𑇀𑆪 𑆖𑆴𑆧𑆶𑆑𑆾𑆤𑇀𑆤𑆳𑆩𑆤𑆁 𑆲𑆴𑆠𑆩𑇀𑇅 𑆱𑇀𑆫𑆱𑇀𑆠𑆁 𑆱𑇀𑆮𑆁 𑆓𑆩𑆪𑆼𑆠𑇀𑆱𑇀𑆡𑆳𑆤𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆮𑆴𑆤𑆳𑆩𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇓𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆁 𑆱𑇀𑆡𑆳𑆤𑆢𑆷𑆰𑇀𑆪𑆳𑆢𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇅𑇑𑇐𑇔𑇅 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆱𑆼𑆑𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆧𑆱𑇀𑆠𑆪𑆂 𑇆𑇑𑇐𑇔𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆂 𑆱𑇀𑆮𑆼𑆢𑆳 𑆤𑆴𑆮𑆳𑆠𑆁 𑆖 𑆱𑇀𑆡𑆳𑆤𑆁 𑆥𑇀𑆫𑆳𑆮𑆫𑆟𑆳𑆤𑆴 𑆖𑇅 𑆫𑆱𑆳𑆂 𑆥𑆪𑆳𑆁𑆱𑆴 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇆𑇑𑇐𑇕𑇆
𑆧𑆸𑆁𑆲𑆟𑆁 𑆪𑆖𑇀𑆖 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀𑇅𑇑𑇐𑇖𑇅 𑆧𑆬𑆳𑆪𑆳𑆂 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆱𑇀𑆪 𑆢𑆯𑆩𑆷𑆬𑆱𑇀𑆪 𑆮𑆳 𑆫𑆱𑆼𑇆𑇑𑇐𑇖𑇆
𑆃𑆘𑆯𑆵𑆫𑇀𑆰𑆳𑆩𑇀𑆧𑆶𑆘𑆳𑆤𑆷𑆥𑆩𑆳𑆁𑆱𑆳𑆢𑆥𑆴𑆯𑆴𑆠𑆽𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆫𑆱𑆳𑆤𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆮𑇀𑆪𑆾𑆰𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆤𑇀𑇆𑇑𑇐𑇗𑇆
𑆨𑆾𑆘𑆪𑆼𑆢𑇀𑆮𑆳𑆠𑆫𑆾𑆓𑆳𑆫𑇀𑆠𑆁 𑆠𑆽𑆫𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆬𑆮𑆟𑆽𑆫𑇀𑆤𑆫𑆩𑇀𑇅 𑆍𑆠𑆽𑆫𑆼𑆮𑆾𑆥𑆤𑆳𑆲𑆳𑆁𑆯𑇀𑆖 𑆥𑆴𑆯𑆴𑆠𑆽𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇘𑇆

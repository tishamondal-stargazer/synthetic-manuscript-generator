𑆠𑆽𑆫𑆱𑇀𑆪 𑆓𑇀𑆫𑆡𑆴𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆨𑆴𑆮𑆴𑆬𑆵𑆪𑆠𑆼𑇅 𑆒𑆳𑆤𑆴 𑆩𑆳𑆫𑇀𑆢𑆮𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆠𑆠𑆾 𑆮𑆳𑆠𑆳𑆤𑆶𑆬𑆾𑆩𑆠𑆳𑇆𑇗𑇒𑇆
𑆪𑆡𑆳𑇁𑆢𑇀𑆫𑆴𑆑𑆶𑆚𑇀𑆘𑆼𑆰𑇀𑆮𑆫𑇀𑆑𑆳𑆁𑆯𑆶𑆠𑆥𑇀𑆠𑆁 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆲𑆴𑆩𑆩𑇀𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑆥𑇀𑆠𑆂 𑆱𑇀𑆡𑆴𑆫𑆾 𑆢𑆼𑆲𑆼 𑆱𑇀𑆮𑆼𑆢𑆽𑆫𑇀𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆠𑆡𑆳𑇆𑇗𑇓𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆠𑆠𑆱𑇀𑆠𑆷𑆫𑇀𑆟𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆾𑆢𑆤𑆩𑇀𑇅 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆁 𑆯𑆷𑆑𑆫𑆳𑆟𑆳𑆁 𑆮𑆳 𑆫𑆱𑆽𑆫𑇀𑆢𑆣𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆼𑆟 𑆮𑆳𑇆𑇗𑇔𑇆
𑆠𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆼 𑆮𑆩𑆤𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆩𑇀𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆽𑆤𑇀𑆣𑆮𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳𑆠𑆳𑆮𑆴𑆫𑆾𑆣𑆴 𑆪𑆠𑇀𑇆𑇗𑇕𑇆
𑆤𑆴𑆫𑇀𑆲𑆸𑆠𑆼 𑆱𑆶𑆒𑆩𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆱 𑆑𑆦𑆼 𑆢𑆶𑆰𑇀𑆛𑆮𑆴𑆓𑇀𑆫𑆲𑆼𑇅 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑆶 𑆖 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆼𑆰𑆶 𑆖𑆫𑆠𑇀𑆪𑆮𑆴𑆲𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇗𑇖𑇆
𑆬𑆵𑆤𑆯𑇀𑆖𑆼𑆢𑇀𑆢𑆾𑆰𑆯𑆼𑆰𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆣𑆷𑆩𑆽𑆱𑇀𑆠𑆁 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑇀𑆧𑆶𑆣𑆂𑇅 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆁 𑆥𑆠𑇀𑆫𑆩𑆼𑆫𑆟𑇀𑆝𑆩𑆷𑆬𑆁 𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆩𑇀𑇆𑇗𑇗𑇆
𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆁 𑆔𑆸𑆠𑆁 𑆩𑆬𑇀𑆬𑆑𑆱𑆩𑇀𑆥𑆶𑆛𑆼𑇅 𑆑𑆸𑆠𑇀𑆮𑆳 𑆣𑆷𑆩𑆁 𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑆸𑆕𑇀𑆓𑆁 𑆧𑆳𑆬𑆁 𑆮𑆳 𑆱𑇀𑆤𑆳𑆪𑆶 𑆮𑆳 𑆓𑆮𑆳𑆩𑇀𑇆𑇗𑇙𑇆
𑆱𑇀𑆪𑆾𑆤𑆳𑆑𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆤𑆳𑆝𑆵𑆁 𑆯𑆶𑆰𑇀𑆑𑆳𑆁 𑆑𑆶𑆯𑆱𑇀𑆪 𑆮𑆳𑇅 𑆥𑆢𑇀𑆩𑆑𑆁 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆁 𑆬𑆾𑆲𑆁 𑆯𑆬𑇀𑆬𑆑𑆵𑆁 𑆮𑆳 𑆔𑆸𑆠𑆳𑆥𑇀𑆬𑆶𑆠𑆩𑇀𑇆𑇘𑇐𑇆
𑆱𑇀𑆮𑆫𑆑𑇀𑆰𑆵𑆟𑆳𑆠𑆴𑆱𑆳𑆫𑆳𑆱𑆸𑆑𑇀𑆥𑆴𑆠𑇀𑆠𑆢𑆳𑆲𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆘𑆳𑆤𑇀𑇅 𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆳𑆤𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇘𑇑𑇆
𑆤 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆢𑆳𑆲𑆳𑆫𑇀𑆠𑆳 𑆫𑆑𑇀𑆠𑆱𑇀𑆮𑆼𑆢𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆴𑆤𑆂𑇅 𑆑𑇀𑆰𑆵𑆟𑆣𑆳𑆠𑆶𑆧𑆬𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆂𑇆𑇘𑇒𑇆
𑆑𑆾𑆰𑇀𑆟𑆽𑆂 𑆑𑆳𑆩𑆩𑆶𑆫𑆂𑆑𑆟𑇀𑆜𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆼𑆑𑆽𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆽𑆂𑇅 𑆇𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆾𑆥𑆤𑆳𑆲𑆽𑆯𑇀𑆖 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆤𑇀 𑆩𑆸𑆢𑆶𑆨𑆴𑆂 𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇘𑇓𑇆
𑆠𑆴𑆬𑆾𑆩𑆳𑆩𑆳𑆰𑆓𑆾𑆣𑆷𑆩𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑇀𑆮𑆳𑆠𑆲𑆫𑆽𑆂 𑆱𑆲𑇅 𑆱𑇀𑆤𑆼𑆲𑆽𑆯𑇀𑆖𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳 𑆱𑆳𑆩𑇀𑆬𑆽𑆂 𑆱𑆑𑇀𑆰𑆵𑆫𑆽𑆫𑇀𑆮𑆳 𑆑𑆸𑆠𑆳 𑆲𑆴𑆠𑆳𑇆𑇘𑇔𑇆
𑆤𑆮𑆘𑇀𑆮𑆫𑆳𑆩𑆢𑆾𑆰𑆼𑆰𑆶 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆮𑆼𑆢𑆁 𑆮𑆴𑆬𑆕𑇀𑆔𑆤𑆩𑇀𑇅 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆾𑆬𑇀𑆬𑆼𑆒𑆤𑆁 𑆮𑆳𑇁𑆥𑆴 𑆑𑆳𑆫𑆪𑆼𑆬𑇀𑆬𑆮𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇆𑇘𑇕𑇆
𑆃𑆠𑆴𑆪𑆾𑆓𑆾𑆢𑇀𑆣𑆠𑆁 𑆮𑆳𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆮𑆳𑆠𑆲𑆫𑆽𑆫𑇀𑆨𑆴𑆰𑆑𑇀𑇅 𑆫𑆱𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆤𑆳𑆠𑆴𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆽𑆫𑆨𑇀𑆪𑆕𑇀𑆓𑆽𑆯𑇀𑆖 𑆯𑆩𑆁 𑆤𑆪𑆼𑆠𑇀𑇆𑇘𑇖𑇆
𑆑𑆑𑆳𑆣𑆴𑆑𑆼 𑆧𑆬𑆱𑇀𑆡𑆼 𑆖 𑆮𑆩𑆤𑆁 𑆱𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑆡𑇀𑆪𑆳𑆯𑆴𑆤𑆼 𑆣𑆷𑆩𑆬𑆼𑆲𑆳𑆢𑆴𑆯𑆩𑆤𑆁 𑆠𑆠𑆂𑇆𑇘𑇙𑇆

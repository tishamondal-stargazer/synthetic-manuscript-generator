𑆥𑆫𑇀𑆟𑆳𑆤𑆴 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆱𑇀𑆪 𑆠𑆑𑇀𑆫𑆼𑆟 𑆥𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆡 𑆑𑆳𑆑𑆩𑆳𑆖𑇀𑆪𑆳𑆂𑇅 𑆠𑆽𑆬𑆳𑆑𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆤𑆫𑆱𑇀𑆪 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆶𑆢𑇀𑆮𑆫𑇀𑆠𑆪𑆼𑆢𑆯𑇀𑆮𑆲𑆤𑆖𑇀𑆗𑆢𑆽𑆯𑇀𑆖𑇆𑇑𑇗𑇆
𑆑𑆾𑆬𑆁 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆂 𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆫𑆳𑆱𑇀𑆤𑆳𑆩𑆳𑆰𑆳𑆠𑆱𑆵𑆠𑆽𑆬𑆦𑆬𑆳𑆤𑆴 𑆑𑆶𑆰𑇀𑆜𑆩𑇀𑇅 𑆮𑆖𑆳 𑆯𑆠𑆳𑆲𑇀𑆮𑆳 𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆩𑆩𑇀𑆬𑆩𑆶𑆰𑇀𑆟𑆳𑆤𑆴 𑆮𑆳𑆠𑆳𑆩𑆪𑆴𑆤𑆳𑆁 𑆥𑇀𑆫𑆢𑆼𑆲𑆂𑇆𑇑𑇘𑇆
𑆠𑆑𑇀𑆫𑆼𑆟 𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆁 𑆱𑆑𑇀𑆰𑆳𑆫𑆩𑆫𑇀𑆠𑆴𑆁 𑆘𑆜𑆫𑆼 𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆁 𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆁 𑆱𑆮𑆖𑆳𑆁 𑆪𑆮𑆳𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆱𑆠𑆽𑆬𑆳𑆩𑇀𑆬𑆩𑆶𑆯𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆼𑇆𑇒𑇐𑇆
𑆇𑆨𑆼 𑆯𑆠𑆳𑆲𑇀𑆮𑆼 𑆩𑆣𑆶𑆑𑆁 𑆩𑆣𑆷𑆑𑆁 𑆧𑆬𑆳𑆁 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆁 𑆖 𑆑𑆯𑆼𑆫𑆶𑆑𑆁 𑆖𑇅 𑆔𑆸𑆠𑆁 𑆮𑆴𑆢𑆳𑆫𑆵𑆁 𑆖 𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆁 𑆥𑆮𑆤𑆼 𑆱𑆫𑆑𑇀𑆠𑆼𑇆𑇒𑇑𑇆
𑆫𑆳𑆱𑇀𑆤𑆳 𑆓𑆶𑆝𑆷𑆖𑆵 𑆩𑆣𑆶𑆑𑆁 𑆧𑆬𑆼 𑆢𑇀𑆮𑆼 𑆱𑆘𑆵𑆮𑆑𑆁 𑆱𑆫𑇀𑆰𑆨𑆑𑆁 𑆥𑆪𑆯𑇀𑆖𑇅 𑆔𑆸𑆠𑆁 𑆖 𑆱𑆴𑆢𑇀𑆣𑆁 𑆩𑆣𑆶𑆯𑆼𑆰𑆪𑆶𑆑𑇀𑆠𑆁 𑆫𑆑𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆫𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆟𑆶𑆢𑆼𑆠𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆂𑇆𑇒𑇒𑇆
𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆱𑆶𑆫𑆢𑆳𑆫𑆶 𑆑𑆶𑆰𑇀𑆜𑆁 𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆩𑆼𑆬𑆳 𑆑𑆩𑆬𑆾𑆠𑇀𑆥𑆬𑆼 𑆖𑇅 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆳𑆪𑆳𑆁 𑆱𑆔𑆸𑆠𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆾 𑆬𑆾𑆲𑆽𑆫𑆑𑆳𑆥𑆢𑇀𑆩𑆑𑆖𑆾𑆫𑆑𑆽𑆯𑇀𑆖𑇆𑇒𑇔𑇆
𑆫𑆳𑆱𑇀𑆤𑆳 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆤𑆬𑆢𑆁 𑆯𑆠𑆳𑆲𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆢𑆼𑆮𑆢𑆳𑆫𑆷𑆟𑆴 𑆱𑆴𑆠𑆾𑆥𑆬𑆳 𑆖𑇅 𑆘𑆵𑆮𑆤𑇀𑆠𑆴𑆩𑆷𑆬𑆁 𑆱𑆔𑆸𑆠𑆁 𑆱𑆠𑆽𑆬𑆩𑆳𑆬𑆼𑆥𑆤𑆁 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆫𑆶𑆘𑆳𑆱𑆶 𑆑𑆾𑆰𑇀𑆟𑆩𑇀𑇆𑇒𑇕𑇆
𑆯𑆽𑆮𑆳𑆬𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆮𑆼𑆠𑇀𑆫𑆠𑆶𑆕𑇀𑆓𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆳𑆟𑇀𑆪𑆩𑆸𑆟𑆳𑆬𑆬𑆾𑆣𑇀𑆫𑆩𑇀𑇅 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆑𑆳𑆬𑆼𑆪𑆑𑆖𑆤𑇀𑆢𑆤𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆟𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆔𑆸𑆠𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆂𑇆𑇒𑇖𑇆
𑆯𑆴𑆫𑆵𑆰𑆬𑆳𑆩𑆘𑇀𑆘𑆑𑆲𑆼𑆩𑆬𑆾𑆣𑇀𑆫𑆽𑆱𑇀𑆠𑇀𑆮𑆓𑇀𑆢𑆾𑆰𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑆲𑆫𑆂 𑆥𑇀𑆫𑆔𑆫𑇀𑆰𑆂𑇅 𑆥𑆠𑇀𑆫𑆳𑆩𑇀𑆧𑆶𑆬𑆾𑆣𑇀𑆫𑆳𑆨𑆪𑆖𑆤𑇀𑆢𑆤𑆳𑆤𑆴 𑆯𑆫𑆵𑆫𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆲𑆫𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆂𑇆𑇒𑇙𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆅𑆲𑆳𑆠𑇀𑆫𑆴𑆘𑆂 𑆱𑆴𑆢𑇀𑆣𑆠𑆩𑆳𑆤𑆶𑆮𑆳𑆖 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑆁 𑆱𑆴𑆢𑇀𑆣𑆩𑆲𑆫𑇀𑆰𑆴𑆥𑆷𑆘𑇀𑆪𑆂𑇅 𑆖𑆷𑆫𑇀𑆟𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆣𑆳𑆩𑆪𑆔𑇀𑆤𑆳𑆤𑆳𑆫𑆓𑇀𑆮𑆣𑆵𑆪𑆼 𑆘𑆓𑆠𑆾 𑆲𑆴𑆠𑆳𑆫𑇀𑆡𑆩𑇀𑇆𑇓𑇐𑇆
𑆃𑆡𑆳𑆠𑆂 𑆰𑆝𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆯𑇀𑆫𑆴𑆠𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆰𑆝𑇀 𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆰𑆝𑇀 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆯𑇀𑆫𑆪𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆑𑆰𑆳𑆪𑆪𑆾𑆤𑆪𑆂, 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆥𑆤𑆁, 𑆥𑆚𑇀𑆖𑆳𑆯𑆤𑇀𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆑𑆰𑆳𑆪𑆯𑆠𑆳𑆤𑆴, 𑆅𑆠𑆴 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇆𑇓𑇆
𑆰𑆝𑇀 𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆤𑆴, 𑆅𑆠𑆴 𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆠𑆢𑆴𑆲 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆾𑆢𑆳𑆲𑆸𑆠𑇀𑆪 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆑𑆬𑇀𑆥𑆾𑆥𑆤𑆴𑆰𑆢𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; (𑆠𑆠𑇀𑆫 ) 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆪𑆾𑆓𑆯𑆠𑆁 𑆥𑇀𑆫𑆟𑆵𑆠𑆁 𑆦𑆬𑆼𑆰𑆶, 𑆍𑆑𑆾𑆤𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆘𑇀𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆰𑆶 𑆪𑆾𑆓𑆳𑆂, 𑆥𑆚𑇀𑆖𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑆴𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆰𑆶, 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆂 𑆰𑆰𑇀𑆛𑆴𑆣𑆳 𑆨𑆮𑆠𑆴 𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆂, 𑆑𑆶𑆛𑆘𑆱𑇀𑆠𑇀𑆮𑆰𑇀𑆛𑆳𑆢𑆯𑆣𑆳 𑆪𑆾𑆓𑆩𑆼𑆠𑆴, 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆁 𑆰𑆰𑇀𑆛𑆴𑆣𑆳 𑆨𑆮𑆠𑆴 𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆁, 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆪𑆾𑆓𑆯𑆠𑆁 𑆥𑇀𑆫𑆟𑆵𑆠𑆁 𑆢𑆯𑆳𑆥𑆫𑆼 𑆖𑆳𑆠𑇀𑆫 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆾𑆓𑆳𑆂, 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆾 𑆢𑇀𑆮𑆳𑆢𑆯𑆣𑆳 𑆪𑆾𑆓𑆩𑆼𑆠𑆴, 𑆬𑆾𑆣𑇀𑆫𑆁 𑆮𑆴𑆣𑆿 𑆰𑆾𑆝𑆯𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆁, 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆾 𑆨𑆮𑆠𑆴 𑆮𑆴𑆁𑆯𑆠𑆴𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆂, 𑆍𑆑𑆾𑆤𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑇀𑆪𑆾𑆫𑇀𑆪𑆾𑆓𑆳𑆂, 𑆃𑆰𑇀𑆛𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑇀𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪𑆾𑆂, 𑆅𑆠𑆴 𑆰𑆝𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆤𑆴𑇆𑇔𑇆
𑆰𑆝𑇀 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆯𑇀𑆫𑆪𑆳 𑆅𑆠𑆴 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆳𑆤𑆵𑆠𑆴𑇆𑇕𑇆
𑆥𑆚𑇀𑆖 𑆑𑆰𑆳𑆪𑆪𑆾𑆤𑆪 𑆅𑆠𑆴 𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆾𑇁𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆂 𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂 𑆑𑆰𑆳𑆪𑆑𑆰𑆳𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑇆𑇖𑇆
𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆥𑆤𑆩𑆴𑆠𑆴 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑇀𑆮𑆫𑆱𑆂, 𑆑𑆬𑇀𑆑𑆂, 𑆯𑆸𑆠𑆂, 𑆯𑆵𑆠𑆂, 𑆦𑆳𑆟𑇀𑆛𑆂, 𑆑𑆰𑆳𑆪 𑆅𑆠𑆴𑇅 (𑆪𑆤𑇀𑆠𑇀𑆫𑆤𑆴𑆰𑇀𑆥𑆵𑆝𑆴𑆠𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆢𑇀𑆫𑆱𑆂 𑆱𑇀𑆮𑆫𑆱 𑆇𑆖𑇀𑆪𑆠𑆼 𑇅 𑆪𑆂 𑆥𑆴𑆟𑇀𑆝𑆾 𑆫𑆱𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆱 𑆑𑆬𑇀𑆑𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆 𑆮𑆲𑇀𑆤𑆿 𑆠𑆶 𑆑𑇀𑆮𑆡𑆴𑆠𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆯𑆸𑆠𑆩𑆳𑆲𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆳𑆂 𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆢𑆳𑆥𑆾𑆠𑇀𑆡𑆴𑆠𑆳𑆠𑇀𑆠𑆾𑆪𑆼 𑆥𑇀𑆫𑆠𑆥𑇀𑆠𑆼 𑆤𑆴𑆯𑆴 𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆳𑆠𑇀 𑇆 𑆑𑆰𑆳𑆪𑆾 𑆪𑆾𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆪𑆳𑆠𑆴 𑆱 𑆯𑆵𑆠𑆂 𑆱𑆩𑆶𑆢𑆳𑆲𑆸𑆠𑆂 𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑇀𑆮𑆾𑆰𑇀𑆟𑆠𑆾𑆪𑆼 𑆩𑆸𑆢𑆴𑆠𑆁 𑆠𑆠𑇀 𑆦𑆳𑆟𑇀𑆛𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆) 𑆠𑆼𑆰𑆳𑆁 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆧𑆬𑆳𑆣𑆴𑆑𑇀𑆪𑆩𑇀; 𑆃𑆠𑆂 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆥𑆤𑆳 𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆳𑆠𑆶𑆫𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆵; 𑆤 𑆠𑇀𑆮𑆼𑆮𑆁 𑆒𑆬𑆶 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆾𑆥𑆪𑆾𑆓𑆵𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇗𑇆
‘𑆥𑆚𑇀𑆖𑆳𑆯𑆤𑇀𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆳’ 𑆅𑆠𑆴 𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆠𑆢𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑆵𑆮𑆤𑆵𑆪𑆾 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆾 𑆬𑆼𑆒𑆤𑆵𑆪𑆾 𑆨𑆼𑆢𑆤𑆵𑆪𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆵𑆪𑆾 𑆢𑆵𑆥𑆤𑆵𑆪 𑆅𑆠𑆴 𑆰𑆛𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆧𑆬𑇀𑆪𑆾 𑆮𑆫𑇀𑆟𑇀𑆪𑆂 𑆑𑆟𑇀𑆜𑇀𑆪𑆾 𑆲𑆸𑆢𑇀𑆪 𑆅𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆠𑆸𑆥𑇀𑆠𑆴𑆔𑇀𑆤𑆾𑇁𑆫𑇀𑆯𑆾𑆔𑇀𑆤𑆂 𑆑𑆶𑆰𑇀𑆜𑆔𑇀𑆤𑆂 𑆑𑆟𑇀𑆝𑆷𑆔𑇀𑆤𑆂 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆾 𑆮𑆴𑆰𑆔𑇀𑆤 𑆅𑆠𑆴 𑆰𑆛𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆱𑇀𑆠𑆤𑇀𑆪𑆘𑆤𑆤𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆯𑆾𑆣𑆤𑆂 𑆯𑆶𑆑𑇀𑆫𑆘𑆤𑆤𑆂 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆣𑆤 𑆅𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆓𑆂 𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆓𑆾 𑆮𑆩𑆤𑆾𑆥𑆓𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆾𑆥𑆓 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆾𑆥𑆓𑆾𑇁𑆤𑆶𑆮𑆳𑆱𑆤𑆾𑆥𑆓𑆂 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆾𑆥𑆓 𑆅𑆠𑆴 𑆱𑆥𑇀𑆠𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆗𑆫𑇀𑆢𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆾 𑆲𑆴𑆑𑇀𑆑𑆳𑆤𑆴𑆓𑇀𑆫𑆲𑆟 𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆥𑆶𑆫𑆵𑆰𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆪𑆂 𑆥𑆶𑆫𑆵𑆰𑆮𑆴𑆫𑆘𑆤𑆵𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆫𑆘𑆤𑆵𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆫𑆼𑆖𑆤𑆵𑆪 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆑𑆳𑆱𑆲𑆫𑆂 𑆯𑇀𑆮𑆳𑆱𑆲𑆫𑆂 𑆯𑆾𑆡𑆲𑆫𑆾 𑆘𑇀𑆮𑆫𑆲𑆫𑆂 𑆯𑇀𑆫𑆩𑆲𑆫 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆢𑆳𑆲𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆯𑆵𑆠𑆥𑇀𑆫𑆯𑆩𑆤 𑆇𑆢𑆫𑇀𑆢𑆥𑇀𑆫𑆯𑆩𑆤𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆯𑆷𑆬𑆥𑇀𑆫𑆯𑆩𑆤 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆡𑆳𑆥𑆤𑆾 𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆂 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆂 𑆥𑇀𑆫𑆘𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆾 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂; 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆳𑆯𑆤𑇀𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆳 𑆩𑆲𑆠𑆳𑆁 𑆖 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆾𑆢𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆩𑆼𑆑𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆼 𑆢𑆯 𑆢𑆯𑆳𑆮𑆪𑆮𑆴𑆑𑆳𑆤𑇀 𑆑𑆰𑆳𑆪𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑆚𑇀𑆖 𑆑𑆰𑆳𑆪𑆯𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇘𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆩𑆼𑆢𑆳 𑆩𑆲𑆳𑆩𑆼𑆢𑆳 𑆑𑆳𑆑𑆾𑆬𑆵 𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵 𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑆵𑆩𑆳𑆰𑆥𑆫𑇀𑆟𑇀𑆪𑆿 𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆩𑆣𑆶𑆑𑆩𑆴𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑), 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆵 𑆫𑆳𑆘𑆑𑇀𑆰𑆮𑆑𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆮𑆳𑆛𑇀𑆪𑆳𑆪𑆤𑆵𑆨𑆢𑇀𑆫𑆿𑆢𑆤𑆵𑆨𑆳𑆫𑆢𑇀𑆮𑆳𑆘𑆵𑆥𑆪𑆱𑇀𑆪𑆫𑇀𑆰𑇀𑆪𑆓𑆤𑇀𑆣𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒), 𑆩𑆶𑆱𑇀𑆠𑆑𑆶𑆰𑇀𑆜𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆮𑆖𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆖𑆴𑆫𑆧𑆴𑆬𑇀𑆮𑆲𑆽𑆩𑆮𑆠𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆬𑆼𑆒𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓), 𑆱𑆶𑆮𑆲𑆳𑆫𑇀𑆑𑆾𑆫𑆶𑆧𑆶𑆑𑆳𑆓𑇀𑆤𑆴𑆩𑆶𑆒𑆵𑆖𑆴𑆠𑇀𑆫𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆖𑆴𑆫𑆧𑆴𑆬𑇀𑆮𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆯𑆑𑆶𑆬𑆳𑆢𑆤𑆵𑆱𑇀𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆨𑆼𑆢𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔), 𑆩𑆣𑆶𑆑𑆩𑆣𑆶𑆥𑆫𑇀𑆟𑆵𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑇀𑆪𑆩𑇀𑆧𑆰𑇀𑆜𑆑𑆵𑆱𑆩𑆕𑇀𑆓𑆳𑆩𑆾𑆖𑆫𑆱𑆣𑆳𑆠𑆑𑆵𑆬𑆾𑆣𑇀𑆫𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆑𑆛𑇀𑆦𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑆤𑇀𑆣𑆳𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇕), 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆩𑆫𑆴𑆖𑆳𑆘𑆩𑆾𑆢𑆳𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆱𑇀𑆡𑆴𑆲𑆴𑆕𑇀𑆓𑆶𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆢𑆵𑆥𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇖), 𑆅𑆠𑆴 𑆰𑆛𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇙𑇆
𑆎𑆤𑇀𑆢𑇀𑆫𑇀𑆪𑆸𑆰𑆨𑇀𑆪𑆠𑆴𑆫𑆱𑆫𑇀𑆰𑇀𑆪𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆱𑇀𑆡𑆴𑆫𑆳𑆫𑆾𑆲𑆴𑆟𑆵𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆧𑆬𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇗), 𑆖𑆤𑇀𑆢𑆤𑆠𑆶𑆕𑇀𑆓𑆥𑆢𑇀𑆩𑆑𑆾𑆯𑆵𑆫𑆩𑆣𑆶𑆑𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆱𑆳𑆫𑆴𑆮𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆱𑆴𑆠𑆳𑆬𑆠𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆫𑇀𑆟𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇘), 𑆱𑆳𑆫𑆴𑆮𑆼𑆑𑇀𑆰𑆶𑆩𑆷𑆬𑆩𑆣𑆶𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑆽𑆛𑆫𑇀𑆪𑆲𑆁𑆱𑆥𑆳𑆢𑆵𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆑𑆟𑇀𑆜𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇙), 𑆄𑆩𑇀𑆫𑆳𑆩𑇀𑆫𑆳𑆠𑆑𑆬𑆴𑆑𑆶𑆖𑆑𑆫𑆩𑆫𑇀𑆢𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆢𑆳𑆝𑆴𑆩𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆲𑆸𑆢𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇐), 𑆅𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇐𑇆
𑆤𑆳𑆓𑆫𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆷𑆫𑇀𑆮𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆮𑆖𑆳𑆩𑆶𑆱𑇀𑆠𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆛𑆾𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆠𑆸𑆥𑇀𑆠𑆴𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇑), 𑆑𑆶𑆛𑆘𑆧𑆴𑆬𑇀𑆮𑆖𑆴𑆠𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆨𑆪𑆳𑆣𑆤𑇀𑆮𑆪𑆳𑆱𑆑𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆮𑆖𑆳𑆖𑆮𑇀𑆪𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆾𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇒), 𑆒𑆢𑆴𑆫𑆳𑆨𑆪𑆳𑆩𑆬𑆑𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆫𑆶𑆰𑇀𑆑𑆫𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆫𑆓𑇀𑆮𑆣𑆑𑆫𑆮𑆵𑆫𑆮𑆴𑆝𑆕𑇀𑆓𑆘𑆳𑆠𑆵𑆥𑇀𑆫𑆮𑆳𑆬𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆑𑆶𑆰𑇀𑆜𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇓), 𑆖𑆤𑇀𑆢𑆤𑆤𑆬𑆢𑆑𑆸𑆠𑆩𑆳𑆬𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆤𑆴𑆩𑇀𑆧𑆑𑆶𑆛𑆘𑆱𑆫𑇀𑆰𑆥𑆩𑆣𑆶𑆑𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆑𑆟𑇀𑆝𑆷𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇔), 𑆃𑆑𑇀𑆰𑆵𑆮𑆩𑆫𑆴𑆖𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆼𑆧𑆶𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑇀𑆝𑆵𑆑𑆴𑆟𑆴𑆲𑆵𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆸𑆰𑆥𑆫𑇀𑆟𑆴𑆑𑆳𑆒𑆶𑆥𑆫𑇀𑆟𑆴𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇕), 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆱𑆶𑆮𑆲𑆳𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆽𑆬𑆳𑆥𑆳𑆬𑆴𑆤𑇀𑆢𑆵𑆖𑆤𑇀𑆢𑆤𑆑𑆠𑆑𑆯𑆴𑆫𑆵𑆰𑆱𑆴𑆤𑇀𑆣𑆶𑆮𑆳𑆫𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆴𑆰𑆔𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇖), 𑆅𑆠𑆴 𑆰𑆛𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇑𑇆
𑆮𑆵𑆫𑆟𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆼𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆢𑆫𑇀𑆨𑆑𑆶𑆯𑆑𑆳𑆯𑆓𑆶𑆤𑇀𑆢𑇀𑆫𑆼𑆠𑇀𑆑𑆛𑆑𑆠𑇀𑆠𑆸𑆟𑆩𑆷𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑇀𑆠𑆤𑇀𑆪𑆘𑆤𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇗), 𑆥𑆳𑆜𑆳𑆩𑆲𑆿𑆰𑆣𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆩𑆶𑆱𑇀𑆠𑆩𑆷𑆫𑇀𑆮𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆮𑆠𑇀𑆱𑆑𑆦𑆬𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆱𑆳𑆫𑆴𑆮𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑇀𑆠𑆤𑇀𑆪𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇘), 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑆵𑆩𑆳𑆰𑆥𑆫𑇀𑆟𑆵𑆩𑆼𑆢𑆳𑆮𑆸𑆢𑇀𑆣𑆫𑆶𑆲𑆳𑆘𑆛𑆴𑆬𑆳𑆑𑆶𑆬𑆴𑆕𑇀𑆓𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆶𑆑𑇀𑆫𑆘𑆤𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇑𑇙), 𑆑𑆶𑆰𑇀𑆜𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆑𑆛𑇀𑆦𑆬𑆱𑆩𑆶𑆢𑇀𑆫𑆦𑆼𑆤𑆑𑆢𑆩𑇀𑆧𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆼𑆑𑇀𑆰𑆶𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑇀𑆮𑆴𑆑𑇀𑆰𑆶𑆫𑆑𑆮𑆱𑆶𑆑𑆾𑆯𑆵𑆫𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇐), 𑆅𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇒𑇆
𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆩𑆣𑆶𑆑𑆩𑆣𑆶𑆥𑆫𑇀𑆟𑆵𑆩𑆼𑆢𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆬𑆾𑆬𑆵𑆘𑆵𑆮𑆑𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇑), 𑆯𑆾𑆨𑆳𑆚𑇀𑆘𑆤𑆑𑆽𑆫𑆟𑇀𑆝𑆳𑆫𑇀𑆑𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆪𑆮𑆠𑆴𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆩𑆳𑆰𑆧𑆢𑆫𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇒), 𑆩𑆣𑆶𑆩𑆣𑆶𑆑𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆑𑆫𑇀𑆧𑆶𑆢𑆳𑆫𑆤𑆵𑆥𑆮𑆴𑆢𑆶𑆬𑆧𑆴𑆩𑇀𑆧𑆵𑆯𑆟𑆥𑆶𑆰𑇀𑆥𑆵𑆱𑆢𑆳𑆥𑆶𑆰𑇀𑆥𑆳𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆩𑆤𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇓), 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆥𑆫𑆷𑆰𑆑𑆳𑆨𑆪𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆥𑆵𑆬𑆷𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇔), 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆧𑆴𑆬𑇀𑆮𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆶𑆰𑇀𑆜𑆱𑆫𑇀𑆰𑆥𑆮𑆖𑆳𑆮𑆠𑇀𑆱𑆑𑆦𑆬𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆩𑆣𑆶𑆑𑆩𑆢𑆤𑆦𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇕), 𑆫𑆳𑆱𑇀𑆤𑆳𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆧𑆴𑆬𑇀𑆮𑆩𑆢𑆤𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇖), 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆑𑇀𑆰𑆮𑆑𑆩𑆫𑆴𑆖𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑆴𑆓𑇀𑆫𑆶𑆱𑆫𑇀𑆰𑆥𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆯𑇀𑆮𑆼𑆠𑆳𑆩𑆲𑆳𑆯𑇀𑆮𑆼𑆠𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆾𑆥𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇗), 𑆅𑆠𑆴 𑆱𑆥𑇀𑆠𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇓𑇆
𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆥𑆬𑇀𑆬𑆮𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆩𑇀𑆬𑆧𑆢𑆫𑆢𑆳𑆝𑆴𑆩𑆪𑆮𑆪𑆰𑇀𑆛𑆴𑆑𑆾𑆯𑆵𑆫𑆩𑆸𑆬𑇀𑆬𑆳𑆘𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆗𑆫𑇀𑆢𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇘), 𑆤𑆳𑆓𑆫𑆣𑆤𑇀𑆮𑆪𑆮𑆳𑆱𑆑𑆩𑆶𑆱𑇀𑆠𑆥𑆫𑇀𑆥𑆛𑆑𑆖𑆤𑇀𑆢𑆤𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆓𑆶𑆝𑆷𑆖𑆵𑆲𑇀𑆫𑆵𑆮𑆼𑆫𑆣𑆳𑆤𑇀𑆪𑆑𑆥𑆛𑆾𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇒𑇙), 𑆯𑆛𑆵𑆥𑆶𑆰𑇀𑆑𑆫𑆩𑆷𑆬𑆧𑆢𑆫𑆧𑆵𑆘𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆧𑆸𑆲𑆠𑆵𑆮𑆸𑆑𑇀𑆰𑆫𑆶𑆲𑆳𑆨𑆪𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆢𑆶𑆫𑆳𑆬𑆨𑆳𑆑𑆶𑆬𑆵𑆫𑆯𑆸𑆕𑇀𑆓𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆲𑆴𑆑𑇀𑆑𑆳𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇐), 𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇔𑇆
𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆤𑆤𑇀𑆠𑆳𑆩𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆬𑆾𑆣𑇀𑆫𑆩𑆾𑆖𑆫𑆱𑆱𑆩𑆕𑇀𑆓𑆳𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆥𑆢𑇀𑆩𑆳𑆥𑆢𑇀𑆩𑆑𑆼𑆯𑆫𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆥𑆶𑆫𑆵𑆰𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇑), 𑆘𑆩𑇀𑆧𑆶𑆯𑆬𑇀𑆬𑆑𑆵𑆠𑇀𑆮𑆑𑇀𑆑𑆖𑇀𑆗𑆶𑆫𑆳𑆩𑆣𑆷𑆑𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆯𑇀𑆫𑆵𑆮𑆼𑆰𑇀𑆛𑆑𑆨𑆸𑆰𑇀𑆛𑆩𑆸𑆠𑇀𑆥𑆪𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆬𑆠𑆴𑆬𑆑𑆟𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆥𑆶𑆫𑆵𑆰𑆮𑆴𑆫𑆘𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇒), 𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆥𑇀𑆬𑆑𑇀𑆰𑆮𑆛𑆑𑆥𑆵𑆠𑆤𑆾𑆝𑆶𑆩𑇀𑆧𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇓), 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆤𑆬𑆴𑆤𑆑𑆶𑆩𑆶𑆢𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆯𑆠𑆥𑆠𑇀𑆫𑆩𑆣𑆶𑆑𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆫𑆘𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇔), 𑆮𑆸𑆑𑇀𑆰𑆳𑆢𑆤𑆵𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆱𑆶𑆑𑆮𑆯𑆴𑆫𑆥𑆳𑆰𑆳𑆟𑆨𑆼𑆢𑆢𑆫𑇀𑆨𑆑𑆶𑆯𑆑𑆳𑆯𑆓𑆶𑆤𑇀𑆢𑇀𑆫𑆼𑆠𑇀𑆑𑆛𑆩𑆷𑆬𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆫𑆼𑆖𑆤𑆵𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇕), 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇕𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆨𑆪𑆳𑆩𑆬𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆢𑆶𑆫𑆳𑆬𑆨𑆳𑆯𑆸𑆕𑇀𑆓𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆠𑆳𑆩𑆬𑆑𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆑𑆳𑆱𑆲𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇖), 𑆯𑆛𑆵𑆥𑆶𑆰𑇀𑆑𑆫𑆩𑆷𑆬𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆽𑆬𑆳𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆓𑆶𑆫𑆶𑆱𑆶𑆫𑆱𑆳𑆠𑆳𑆩𑆬𑆑𑆵𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆖𑆟𑇀𑆝𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑇀𑆮𑆳𑆱𑆲𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇗), 𑆥𑆳𑆛𑆬𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆧𑆴𑆬𑇀𑆮𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆧𑆸𑆲𑆠𑆵𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑇀𑆮𑆪𑆡𑆶𑆲𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇘), 𑆱𑆳𑆫𑆴𑆮𑆳𑆯𑆫𑇀𑆑𑆫𑆳𑆥𑆳𑆜𑆳𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆥𑆵𑆬𑆶𑆥𑆫𑆷𑆰𑆑𑆳𑆨𑆪𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆘𑇀𑆮𑆫𑆲𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇓𑇙), 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆒𑆫𑇀𑆘𑆷𑆫𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆧𑆢𑆫𑆢𑆳𑆝𑆴𑆩𑆦𑆬𑇀𑆓𑆶𑆥𑆫𑆷𑆰𑆑𑆼𑆑𑇀𑆰𑆶𑆪𑆮𑆰𑆰𑇀𑆛𑆴𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑇀𑆫𑆩𑆲𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇐), 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇖𑇆
𑆬𑆳𑆘𑆳𑆖𑆤𑇀𑆢𑆤𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆦𑆬𑆩𑆣𑆷𑆑𑆯𑆫𑇀𑆑𑆫𑆳𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆾𑆯𑆵𑆫𑆱𑆳𑆫𑆴𑆮𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆲𑇀𑆫𑆵𑆧𑆼𑆫𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆢𑆳𑆲𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇑), 𑆠𑆓𑆫𑆳𑆓𑆶𑆫𑆶𑆣𑆳𑆤𑇀𑆪𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆨𑆷𑆠𑆵𑆑𑆮𑆖𑆳𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆵𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇒), 𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆧𑆢𑆫𑆒𑆢𑆴𑆫𑆑𑆢𑆫𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆳𑆫𑇀𑆘𑆶𑆤𑆳𑆱𑆤𑆳𑆫𑆴𑆩𑆼𑆢𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑇀𑆪𑆶𑆢𑆫𑇀𑆢𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇓), 𑆮𑆴𑆢𑆳𑆫𑆵𑆓𑆤𑇀𑆣𑆳𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆽𑆫𑆟𑇀𑆝𑆑𑆳𑆑𑆾𑆬𑆵𑆖𑆤𑇀𑆢𑆤𑆾𑆯𑆵𑆫𑆽𑆬𑆳𑆩𑆣𑆶𑆑𑆳𑆤𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑇀𑆪𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇔), 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆩𑆫𑆴𑆖𑆳𑆘𑆩𑆾𑆢𑆳𑆘𑆓𑆤𑇀𑆣𑆳𑆘𑆳𑆘𑆵𑆓𑆟𑇀𑆝𑆵𑆫𑆳𑆟𑆵𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆷𑆬𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇕), 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇗𑇆
𑆩𑆣𑆶𑆩𑆣𑆶𑆑𑆫𑆶𑆣𑆴𑆫𑆩𑆾𑆖𑆫𑆱𑆩𑆸𑆠𑇀𑆑𑆥𑆳𑆬𑆬𑆾𑆣𑇀𑆫𑆓𑆽𑆫𑆴𑆑𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆯𑆫𑇀𑆑𑆫𑆳𑆬𑆳𑆘𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇖), 𑆯𑆳𑆬𑆑𑆛𑇀𑆦𑆬𑆑𑆢𑆩𑇀𑆧𑆥𑆢𑇀𑆩𑆑𑆠𑆶𑆩𑇀𑆧𑆩𑆾𑆖𑆫𑆱𑆯𑆴𑆫𑆵𑆰𑆮𑆚𑇀𑆘𑆶𑆬𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆳𑆯𑆾𑆑𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇗), 𑆲𑆴𑆕𑇀𑆓𑆶𑆑𑆽𑆛𑆫𑇀𑆪𑆳𑆫𑆴𑆩𑆼𑆢𑆳𑆮𑆖𑆳𑆖𑆾𑆫𑆑𑆮𑆪𑆱𑇀𑆡𑆳𑆓𑆾𑆬𑆾𑆩𑆵𑆘𑆛𑆴𑆬𑆳𑆥𑆬𑆕𑇀𑆑𑆰𑆳𑆯𑆾𑆑𑆫𑆾𑆲𑆴𑆟𑇀𑆪 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇘), 𑆎𑆤𑇀𑆢𑇀𑆫𑆵𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆯𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆱𑆲𑆱𑇀𑆫𑆮𑆵𑆫𑇀𑆪𑆳𑇁𑆩𑆾𑆔𑆳𑇁𑆮𑇀𑆪𑆡𑆳𑆯𑆴𑆮𑆳𑇁𑆫𑆴𑆰𑇀𑆛𑆳𑆮𑆳𑆛𑇀𑆪𑆥𑆶𑆰𑇀𑆥𑆵𑆮𑆴𑆰𑇀𑆮𑆑𑇀𑆱𑆼𑆤𑆑𑆳𑆤𑇀𑆠𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆥𑇀𑆫𑆘𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇔𑇙), 𑆃𑆩𑆸𑆠𑆳𑇁𑆨𑆪𑆳𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆶𑆑𑇀𑆠𑆳𑆯𑇀𑆮𑆼𑆠𑆳𑆘𑆵𑆮𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆫𑆱𑆳𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑆵𑆱𑇀𑆡𑆴𑆫𑆳𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳 𑆅𑆠𑆴 𑆢𑆯𑆼𑆩𑆳𑆤𑆴 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇕𑇐), 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆂 𑆑𑆰𑆳𑆪𑆮𑆫𑇀𑆓𑆂𑇆𑇑𑇘𑇆
𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆑𑆰𑆳𑆪𑆯𑆠𑆳𑆤𑇀𑆪𑆨𑆴𑆱𑆩𑆱𑇀𑆪 𑆥𑆚𑇀𑆖𑆳𑆯𑆤𑇀𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆳 𑆩𑆲𑆠𑆳𑆁 𑆖 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆾𑆢𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇙𑇆
𑆤𑆲𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆱𑇀𑆠𑆴, 𑆤 𑆖𑆳𑆥𑇀𑆪𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆾𑇁𑆬𑇀𑆥𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑆳𑆁 𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆼𑆟𑆳𑆤𑆠𑆴𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆖𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆂𑇅 𑆍𑆠𑆳𑆮𑆤𑇀𑆠𑆾 𑆲𑇀𑆪𑆬𑆩𑆬𑇀𑆥𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑆳𑆁 𑆮𑇀𑆪𑆮𑆲𑆳𑆫𑆳𑆪, 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆁 𑆖 𑆱𑇀𑆮𑆳𑆬𑆑𑇀𑆰𑆟𑇀𑆪𑆳𑆤𑆶𑆩𑆳𑆤𑆪𑆶𑆑𑇀𑆠𑆴𑆑𑆶𑆯𑆬𑆳𑆤𑆳𑆩𑆤𑆶𑆑𑇀𑆠𑆳𑆫𑇀𑆡𑆘𑇀𑆚𑆳𑆤𑆳𑆪𑆼𑆠𑆴𑇆𑇒𑇐𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆤𑆽𑆠𑆳𑆤𑆴 𑆨𑆓𑆮𑆤𑇀! 𑆥𑆚𑇀𑆖 𑆑𑆰𑆳𑆪𑆯𑆠𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆳𑆤𑆴 𑆠𑆳𑆤𑆴 𑆲𑇀𑆪𑆼𑆮𑆳𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆶𑆥𑆥𑇀𑆬𑆮𑆤𑇀𑆠𑆼 𑆠𑆼𑆰𑆶 𑆠𑆼𑆰𑆶 𑆩𑆲𑆳𑆑𑆰𑆳𑆪𑆼𑆰𑇀𑆮𑆴𑆠𑆴𑇆𑇒𑇑𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆤𑆽𑆠𑆢𑆼𑆮𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳 𑆢𑇀𑆫𑆰𑇀𑆛𑆮𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑇅 𑆍𑆑𑆾𑇁𑆥𑆴 𑆲𑇀𑆪𑆤𑆼𑆑𑆳𑆁 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆠𑆼 𑆑𑆳𑆫𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆶𑆫𑆶𑆰𑆾 𑆧𑆲𑆷𑆤𑆳𑆁 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆑𑆫𑆟𑆼 𑆱𑆩𑆫𑇀𑆡𑆾 𑆨𑆮𑆠𑆴, 𑆱 𑆪𑆢𑇀𑆪𑆠𑇀 𑆑𑆫𑇀𑆩 𑆑𑆫𑆾𑆠𑆴 𑆠𑆱𑇀𑆪 𑆠𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆂 𑆑𑆫𑇀𑆠𑆸-𑆑𑆫𑆟-𑆑𑆳𑆫𑇀𑆪𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆠𑇀𑆠𑆢𑇀𑆓𑆿𑆟𑆁 𑆤𑆳𑆩𑆮𑆴𑆯𑆼𑆰𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴, 𑆠𑆢𑇀𑆮𑆢𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆥𑆴 𑆢𑇀𑆫𑆰𑇀𑆛𑆮𑇀𑆪𑆩𑇀𑇅 𑆪𑆢𑆴 𑆖𑆽𑆑𑆩𑆼𑆮 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆳𑆱𑆳𑆢𑆪𑆳𑆩𑆱𑇀𑆠𑆡𑆳𑆓𑆶𑆟𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆑𑆫𑆟𑆼 𑆱𑆩𑆫𑇀𑆡𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆑𑆱𑇀𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆢𑆴𑆖𑇀𑆗𑆼𑆢𑆶𑆥𑆣𑆳𑆫𑆪𑆴𑆠𑆶𑆩𑆶𑆥𑆢𑆼𑆰𑇀𑆛𑆶𑆁 𑆮𑆳 𑆯𑆴𑆰𑇀𑆪𑆼𑆨𑇀𑆪 𑆅𑆠𑆴𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆪𑆠𑆾 𑆪𑆳𑆮𑆤𑇀𑆠𑆴 𑆪𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆤𑆴 𑆰𑆛𑇀𑇅 𑆇𑆑𑇀𑆠𑆳𑆤𑆴 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆼𑆲 𑆠𑆡𑆽𑆮𑆽𑆰𑆳𑆁 𑆰𑆝𑆳𑆯𑇀𑆫𑆪𑆳𑆂𑇆𑇒𑇓𑇆
𑆫𑆱𑆳 𑆬𑆮𑆟𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆯𑇀𑆖 𑆑𑆰𑆳𑆪 𑆅𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆳 𑆪𑆾𑆤𑆴𑆂 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆩𑆶𑆢𑆳𑆲𑆸𑆠𑆳𑇆𑇒𑇔𑇆
𑆠𑆡𑆳 𑆑𑆬𑇀𑆥𑆤𑆩𑆥𑇀𑆪𑆼𑆰𑆳𑆩𑆶𑆑𑇀𑆠𑆁 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆥𑆶𑆤𑆂𑇅 𑆩𑆲𑆠𑆳𑆁 𑆖 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑇆𑇒𑇕𑇆
𑆥𑆚𑇀𑆖 𑆖𑆳𑆥𑆴 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆯𑆠𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆨𑆳𑆓𑆯𑆂𑇅 𑆬𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁, 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆲𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆱𑇀𑆪 𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼𑇆𑇒𑇖𑇆
𑆤 𑆖𑆳𑆬𑆩𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆂 𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆠𑆼𑇅 𑆃𑆬𑇀𑆥𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑆪𑆁 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆳𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆮𑆴𑆱𑇀𑆠𑆫𑆂𑇆𑇒𑇗𑇆
𑆩𑆤𑇀𑆢𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆮𑆲𑆳𑆫𑆳𑆪, 𑆧𑆶𑆣𑆳𑆤𑆳𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆸𑆢𑇀𑆣𑆪𑆼𑇅 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀𑆑𑆾 𑆲𑇀𑆪𑆪𑆁 𑆮𑆫𑇀𑆓𑆂 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆩𑆶𑆢𑆳𑆲𑆸𑆠𑆂𑇆𑇒𑇘𑇆
𑆠𑆼𑆰𑆳𑆁 𑆑𑆫𑇀𑆩𑆱𑆶 𑆧𑆳𑆲𑇀𑆪𑆼𑆰𑆶 𑆪𑆾𑆓𑆩𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆖𑇅 𑆱𑆁𑆪𑆾𑆓𑆁 𑆖 𑆥𑇀𑆫𑆪𑆾𑆓𑆁 𑆖 𑆪𑆾 𑆮𑆼𑆢 𑆱 𑆨𑆴𑆰𑆓𑇀𑆮𑆫𑆂𑇆𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆯𑆴𑆠𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆯𑆵 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆄𑆲𑆳𑆫𑆩𑆳𑆠𑇀𑆫𑆳 𑆥𑆶𑆤𑆫𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆵𑇆𑇓𑇆
𑆪𑆳𑆮𑆢𑇀𑆣𑇀𑆪𑆱𑇀𑆪𑆳𑆯𑆤𑆩𑆯𑆴𑆠𑆩𑆤𑆶𑆥𑆲𑆠𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆘𑆫𑆳𑆁 𑆓𑆖𑇀𑆗𑆠𑆴 𑆠𑆳𑆮𑆢𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆮𑆼𑆢𑆴𑆠𑆮𑇀𑆪𑆁 𑆨𑆮𑆠𑆴𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆶𑆢𑇀𑆓𑆬𑆳𑆮𑆑𑆥𑆴𑆚𑇀𑆘𑆬𑆽𑆟𑆯𑆯𑆯𑆫𑆨𑆯𑆩𑇀𑆧𑆫𑆳𑆢𑆵𑆤𑇀𑆪𑆳𑆲𑆳𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆬𑆔𑆷𑆤𑇀𑆪𑆥𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆥𑆼𑆑𑇀𑆰𑆵𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆡𑆳 𑆥𑆴𑆰𑇀𑆛𑆼𑆑𑇀𑆰𑆶𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆑𑆸𑆠𑆴𑆠𑆴𑆬𑆩𑆳𑆰𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆥𑆴𑆯𑆴𑆠𑆳𑆢𑆵𑆤𑇀𑆪𑆳𑆲𑆳𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆓𑆶𑆫𑆷𑆟𑇀𑆪𑆥𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆩𑆼𑆮𑆳𑆥𑆼𑆑𑇀𑆰𑆤𑇀𑆠𑆼𑇆𑇕𑇆
𑆤 𑆖𑆽𑆮𑆩𑆶𑆑𑇀𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆩𑆑𑆳𑆫𑆟𑆁 𑆩𑆤𑇀𑆪𑆼𑆠, 𑆬𑆔𑆷𑆤𑆴 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆥𑆸𑆡𑇀𑆮𑆵𑆱𑆾𑆩𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑆵𑆠𑆫𑆳𑆟𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆮𑆓𑆶𑆟𑆳𑆢𑆥𑆴 𑆬𑆔𑆷𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑇀𑆪𑆬𑇀𑆥𑆢𑆾𑆰𑆳𑆟𑆴 𑆖𑆾𑆖𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆥𑆴 𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴, 𑆓𑆶𑆫𑆷𑆟𑆴 𑆥𑆶𑆤𑆫𑇀𑆤𑆳𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑇀𑆪𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀, 𑆃𑆠𑆯𑇀𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆢𑆾𑆰𑆮𑆤𑇀𑆠𑆴 𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆠𑇀; 𑆱𑆽𑆰𑆳 𑆨𑆮𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆵 𑆩𑆳𑆠𑇀𑆫𑆳𑇆𑇖𑇆
𑆤 𑆖 𑆤𑆳𑆥𑆼𑆑𑇀𑆰𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆁; 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆥𑆼𑆑𑇀𑆰𑆪𑆳 𑆖 𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆩𑆫𑇀𑆣𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆮𑆳 𑆓𑆶𑆫𑆷𑆟𑆳𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼, 𑆬𑆔𑆷𑆤𑆳𑆩𑆥𑆴 𑆖 𑆤𑆳𑆠𑆴𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆩𑆓𑇀𑆤𑆼𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑇀𑇆𑇗𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑇀𑆣𑇀𑆪𑆯𑆤𑆩𑆯𑆴𑆠𑆩𑆤𑆶𑆥𑆲𑆠𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆶𑆒𑆳𑆪𑆶𑆰𑆳 𑆪𑆾𑆘𑆪𑆠𑇀𑆪𑆶𑆥𑆪𑆾𑆑𑇀𑆠𑆳𑆫𑆩𑆮𑆯𑇀𑆪𑆩𑆴𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆶𑆫𑆶 𑆥𑆴𑆰𑇀𑆛𑆩𑆪𑆁 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆤𑇀 𑆥𑆸𑆡𑆶𑆑𑆳𑆤𑆥𑆴𑇅 𑆤 𑆘𑆳𑆠𑆶 𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀 𑆒𑆳𑆢𑆼𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆒𑆳𑆢𑆼𑆢𑇀𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆂𑇆𑇙𑇆
𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆚𑇀𑆗𑆳𑆬𑆴𑆩𑆶𑆢𑇀𑆓𑆳𑆁𑆯𑇀𑆖 𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆩𑆬𑆑𑆼 𑆪𑆮𑆳𑆤𑇀𑇅 𑆄𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆁 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆘𑆳𑆕𑇀𑆓𑆬𑆁 𑆩𑆣𑆶 𑆖𑆳𑆨𑇀𑆪𑆱𑆼𑆠𑇀𑇆𑇑𑇒𑇆
𑆠𑆖𑇀𑆖 𑆤𑆴𑆠𑇀𑆪𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆱𑇀𑆮𑆳𑆱𑇀𑆡𑇀𑆪𑆁 𑆪𑆼𑆤𑆳𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆃𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆤𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆑𑆫𑆁 𑆖 𑆪𑆠𑇀𑇆𑇑𑇓𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆩𑆑𑇀𑆰𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆢𑆴𑆑𑆩𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆓𑆶𑆟𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇆
𑆱𑆿𑆮𑆵𑆫𑆩𑆚𑇀𑆘𑆤𑆁 𑆤𑆴𑆠𑇀𑆪𑆁 𑆲𑆴𑆠𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆥𑆚𑇀𑆖𑆫𑆳𑆠𑇀𑆫𑆼𑇁𑆰𑇀𑆛𑆫𑆳𑆠𑇀𑆫𑆼 𑆮𑆳 𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆫𑇀𑆡𑆼 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇆𑇑𑇕𑇆
𑆖𑆑𑇀𑆰𑆶𑆱𑇀𑆠𑆼𑆘𑆾𑆩𑆪𑆁 𑆠𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆠𑆾 𑆨𑆪𑆩𑇀𑇅 𑆠𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆲𑆫𑆁 𑆑𑆫𑇀𑆩 𑆲𑆴𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑆼𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑇀𑇆𑇑𑇖𑇆
𑆢𑆴𑆮𑆳 𑆠𑆤𑇀𑆤 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆤𑆼𑆠𑇀𑆫𑆪𑆾𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆚𑇀𑆘𑆤𑆩𑇀𑇅 𑆮𑆴𑆫𑆼𑆑𑆢𑆶𑆫𑇀𑆧𑆬𑆳 𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑆳𑆢𑆴𑆠𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆱𑆵𑆢𑆠𑆴𑇆𑇑𑇗𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁 𑆤𑆴𑆯𑆳𑆪𑆳𑆁 𑆠𑆶 𑆣𑇀𑆫𑆶𑆮𑆩𑆚𑇀𑆘𑆤𑆩𑆴𑆰𑇀𑆪𑆠𑆼𑇅𑇑𑇘𑇅 𑆪𑆡𑆳 𑆲𑆴 𑆑𑆤𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆩𑆬𑆴𑆤𑆳𑆁 𑆮𑆴𑆮𑆴𑆣𑆳𑆠𑇀𑆩𑆤𑆳𑆩𑇀𑇆𑇑𑇘𑇆
𑆣𑆿𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆫𑇀𑆩𑆬𑆳 𑆯𑆶𑆢𑇀𑆣𑆴𑆱𑇀𑆠𑆽𑆬𑆖𑆼𑆬𑆑𑆖𑆳𑆢𑆴𑆨𑆴𑆂𑇅 𑆍𑆮𑆁 𑆤𑆼𑆠𑇀𑆫𑆼𑆰𑆶 𑆩𑆫𑇀𑆠𑇀𑆪𑆳𑆤𑆳𑆩𑆚𑇀𑆘𑆤𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇑𑇙𑇆
𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑇀𑆤𑆴𑆫𑆳𑆑𑆶𑆬𑆳 𑆨𑆳𑆠𑆴 𑆤𑆴𑆫𑇀𑆩𑆬𑆼 𑆤𑆨𑆱𑆵𑆤𑇀𑆢𑆶𑆮𑆠𑇀𑇅𑇒𑇐𑇅 𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑆁 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆁 𑆖 𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆁 𑆑𑆼𑆯𑆫𑆁 𑆤𑆒𑆩𑇀𑇆𑇒𑇐𑇆
𑆲𑇀𑆫𑆵𑆮𑆼𑆫𑆁 𑆖𑆤𑇀𑆢𑆤𑆁 𑆥𑆠𑇀𑆫𑆁 𑆠𑇀𑆮𑆓𑆼𑆬𑆾𑆯𑆵𑆫𑆥𑆢𑇀𑆩𑆑𑆩𑇀𑇅 𑆣𑇀𑆪𑆳𑆩𑆑𑆁 𑆩𑆣𑆶𑆑𑆁 𑆩𑆳𑆁𑆱𑆵 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑇀𑆮𑆓𑆶𑆫𑆶𑆯𑆫𑇀𑆑𑆫𑆩𑇀𑇆𑇒𑇑𑇆
𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆥𑇀𑆬𑆑𑇀𑆰𑆬𑆾𑆣𑇀𑆫𑆠𑇀𑆮𑆖𑆂 𑆯𑆶𑆨𑆳𑆂𑇅 𑆮𑆤𑇀𑆪𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆯𑆽𑆬𑆼𑆪𑆁 𑆑𑆩𑆬𑆾𑆠𑇀𑆥𑆬𑆼𑇆𑇒𑇒𑇆
𑆯𑇀𑆫𑆵𑆮𑆼𑆰𑇀𑆛𑆑𑆁 𑆯𑆬𑇀𑆬𑆑𑆵𑆁 𑆖 𑆯𑆶𑆑𑆧𑆫𑇀𑆲𑆩𑆡𑆳𑆥𑆴 𑆖𑇅 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆬𑆴𑆩𑇀𑆥𑆼𑆖𑇀𑆗𑆫𑆼𑆰𑆵𑆑𑆳𑆁 𑆠𑆳𑆁 𑆮𑆫𑇀𑆠𑆴𑆁 𑆪𑆮𑆱𑆤𑇀𑆤𑆴𑆨𑆳𑆩𑇀𑇆𑇒𑇓𑇆
𑆃𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆱𑆩𑆳𑆁 𑆨𑆴𑆰𑆑𑇀𑇅 𑆯𑆶𑆰𑇀𑆑𑆳𑆁 𑆤𑆴𑆓𑆫𑇀𑆨𑆳𑆁 𑆠𑆳𑆁 𑆮𑆫𑇀𑆠𑆴𑆁 𑆣𑆷𑆩𑆤𑆼𑆠𑇀𑆫𑆳𑆫𑇀𑆥𑆴𑆠𑆳𑆁 𑆤𑆫𑆂𑇆𑇒𑇔𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆑𑇀𑆠𑆳𑆩𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆥𑇀𑆬𑆶𑆰𑇀𑆛𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆵𑆁 𑆱𑆶𑆒𑆳𑆩𑇀𑇅𑇒𑇕𑇅 𑆮𑆱𑆳𑆔𑆸𑆠𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆫𑆿𑆰𑆣𑆽𑆂𑇆𑇒𑇕𑇆
𑆮𑆫𑇀𑆠𑆴𑆁 𑆩𑆣𑆶𑆫𑆑𑆽𑆂 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆵𑆁 𑆣𑆷𑆩𑆩𑆳𑆖𑆫𑆼𑆠𑇀𑇅𑇒𑇖𑇅 𑆯𑇀𑆮𑆼𑆠𑆳 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵 𑆖𑆽𑆮 𑆲𑆫𑆴𑆠𑆳𑆬𑆁 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑇆𑇒𑇖𑇆
𑆓𑆤𑇀𑆣𑆳𑆯𑇀𑆖𑆳𑆓𑆶𑆫𑆶𑆥𑆠𑇀𑆫𑆳𑆢𑇀𑆪𑆳 𑆣𑆷𑆩𑆁 𑆩𑆷𑆫𑇀𑆣𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑇅𑇒𑇗𑇅 𑆓𑆿𑆫𑆮𑆁 𑆯𑆴𑆫𑆱𑆂 𑆯𑆷𑆬𑆁 𑆥𑆵𑆤𑆱𑆳𑆫𑇀𑆣𑆳𑆮𑆨𑆼𑆢𑆑𑆿𑇆𑇒𑇗𑇆
𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆁 𑆑𑆳𑆱𑆯𑇀𑆖 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆿 𑆓𑆬𑆓𑇀𑆫𑆲𑆂𑇅 𑆢𑆤𑇀𑆠𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆔𑇀𑆫𑆳𑆟𑆳𑆑𑇀𑆰𑆴𑆢𑆾𑆰𑆘𑆂𑇆𑇒𑇘𑇆
𑆥𑆷𑆠𑆴𑆫𑇀𑆔𑇀𑆫𑆳𑆟𑆳𑆱𑇀𑆪𑆓𑆤𑇀𑆣𑆯𑇀𑆖 𑆢𑆤𑇀𑆠𑆯𑆷𑆬𑆩𑆫𑆾𑆖𑆑𑆂𑇅 𑆲𑆤𑆶𑆩𑆤𑇀𑆪𑆳𑆓𑇀𑆫𑆲𑆂 𑆑𑆟𑇀𑆝𑆷𑆂 𑆑𑇀𑆫𑆴𑆩𑆪𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳 𑆩𑆶𑆒𑆼𑇆𑇒𑇙𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆱𑆼𑆑𑆾 𑆮𑆽𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆓𑆬𑆯𑆶𑆟𑇀𑆝𑇀𑆪𑆶𑆥𑆘𑆴𑆲𑇀𑆮𑆴𑆑𑆳𑇅 𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆁 𑆥𑆴𑆚𑇀𑆘𑆫𑆠𑇀𑆮𑆁 𑆖 𑆑𑆼𑆯𑆳𑆤𑆳𑆁 𑆥𑆠𑆤𑆁 𑆠𑆡𑆳𑇆𑇓𑇐𑇆
𑆑𑇀𑆰𑆮𑆡𑆶𑆯𑇀𑆖𑆳𑆠𑆴𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆖 𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑇀𑆩𑆾𑆲𑆾𑇁𑆠𑆴𑆤𑆴𑆢𑇀𑆫𑆠𑆳𑇅 𑆣𑆷𑆩𑆥𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆧𑆬𑆁 𑆨𑆮𑆠𑆴 𑆖𑆳𑆣𑆴𑆑𑆩𑇀𑇆𑇓𑇑𑇆
𑆯𑆴𑆫𑆾𑆫𑆶𑆲𑆑𑆥𑆳𑆬𑆳𑆤𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆫𑆱𑇀𑆪 𑆖𑇅 𑆤 𑆖 𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆳𑆤𑆾 𑆧𑆬𑆴𑆤𑆾𑇁𑆥𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆘𑆳𑆂𑇆𑇓𑇒𑇆
𑆣𑆷𑆩𑆮𑆑𑇀𑆠𑇀𑆫𑆑𑆥𑆳𑆤𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆱𑇀𑆪𑆶𑆂 𑆯𑆴𑆫𑆾𑆓𑆠𑆳𑆂𑇅𑇓𑇓𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆥𑆳𑆤𑆼 𑆠𑆱𑇀𑆪𑆳𑆰𑇀𑆛𑆿 𑆑𑆳𑆬𑆳𑆂 𑆱𑆩𑇀𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂𑇆𑇓𑇓𑇆
𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆂 𑆑𑆳𑆬𑆼𑆰𑇀𑆮𑆼𑆰𑆶 𑆲𑆴 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆱𑇀𑆤𑆳𑆠𑇀𑆮𑆳 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆱𑆩𑆶𑆬𑇀𑆬𑆴𑆒𑇀𑆪 𑆑𑇀𑆰𑆶𑆠𑇀𑆮𑆳 𑆢𑆤𑇀𑆠𑆳𑆤𑇀𑆤𑆴𑆔𑆸𑆰𑇀𑆪 𑆖𑇅 𑆤𑆳𑆮𑆤𑆳𑆚𑇀𑆘𑆤𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑇀𑆠𑆼 𑆖𑆳𑆠𑇀𑆩𑆮𑆳𑆤𑇀 𑆣𑆷𑆩𑆥𑆾 𑆨𑆮𑆼𑆠𑇀𑇅 𑆠𑆡𑆳 𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆳𑆤𑆾 𑆤 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆘𑆳𑆂𑇆𑇓𑇕𑇆
𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆠𑆶 𑆥𑆼𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆳𑆥𑆳𑆤𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆱𑇀𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇅𑇓𑇖𑇅 𑆥𑆫𑆁 𑆢𑇀𑆮𑆴𑆑𑆳𑆬𑆥𑆳𑆪𑆵 𑆱𑇀𑆪𑆳𑆢𑆲𑇀𑆤𑆂 𑆑𑆳𑆬𑆼𑆰𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀𑇆𑇓𑇖𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆼, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆼 𑆠𑇀𑆮𑆼𑆑𑆁, 𑆮𑆽𑆫𑆼𑆖𑇀𑆪𑆁 𑆠𑇀𑆫𑆴𑆖𑆠𑆶𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆲𑆸𑆠𑇀𑆑𑆟𑇀𑆜𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆬𑆔𑆶𑆠𑇀𑆮𑆁 𑆯𑆴𑆫𑆱𑆂 𑆯𑆩𑆂𑇆𑇓𑇗𑇆

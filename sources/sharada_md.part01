𑆥𑆳𑆥𑆮𑆸𑆠𑇀𑆠𑆮𑆖𑆂𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆂 𑆱𑆷𑆖𑆑𑆳𑆂 𑆑𑆬𑆲𑆥𑇀𑆫𑆴𑆪𑆳𑆂𑇅 𑆩𑆫𑇀𑆩𑆾𑆥𑆲𑆳𑆱𑆴𑆤𑆾 𑆬𑆶𑆧𑇀𑆣𑆳𑆂 𑆥𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆢𑇀𑆮𑆴𑆰𑆂 𑆯𑆜𑆳𑆂𑇆𑇕𑇖𑇆
𑆥𑆫𑆳𑆥𑆮𑆳𑆢𑆫𑆠𑆪𑆯𑇀𑆖𑆥𑆬𑆳 𑆫𑆴𑆥𑆶𑆱𑆼𑆮𑆴𑆤𑆂𑇅 𑆤𑆴𑆫𑇀𑆔𑆸𑆟𑆳𑆱𑇀𑆠𑇀𑆪𑆑𑇀𑆠𑆣𑆫𑇀𑆩𑆳𑆟𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑇀𑆪𑆳 𑆤𑆫𑆳𑆣𑆩𑆳𑆂𑇆𑇕𑇗𑇆
𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆴𑆢𑇀𑆪𑆳𑆮𑆪𑆂𑆯𑆵𑆬𑆣𑆽𑆫𑇀𑆪𑆱𑇀𑆩𑆸𑆠𑆴𑆱𑆩𑆳𑆣𑆴𑆨𑆴𑆂𑇅 𑆮𑆸𑆢𑇀𑆣𑆾𑆥𑆱𑆼𑆮𑆴𑆤𑆾 𑆮𑆸𑆢𑇀𑆣𑆳𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆘𑇀𑆚𑆳 𑆓𑆠𑆮𑇀𑆪𑆡𑆳𑆂𑇆𑇕𑇘𑇆
𑆱𑆶𑆩𑆶𑆒𑆳𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆳𑆂 𑆯𑆁𑆱𑆴𑆠𑆮𑇀𑆫𑆠𑆳𑆂𑇅 𑆱𑆼𑆮𑇀𑆪𑆳𑆂 𑆱𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆮𑆑𑇀𑆠𑆳𑆫𑆂 𑆥𑆶𑆟𑇀𑆪𑆯𑇀𑆫𑆮𑆟𑆢𑆫𑇀𑆯𑆤𑆳𑆂𑇆𑇕𑇙𑇆
𑆄𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆖𑆼𑆰𑇀𑆛𑆳𑆱𑆶 𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆵 𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆖𑆼𑆲 𑆖𑇅 𑆥𑆫𑆁 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆩𑆳𑆠𑆴𑆰𑇀𑆜𑆼𑆢𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑆲𑆴𑆠𑆱𑆼𑆮𑆤𑆼𑇆𑇖𑇐𑇆
𑆤 𑆤𑆑𑇀𑆠𑆁 𑆢𑆣𑆴 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆤 𑆖𑆳𑆥𑇀𑆪𑆔𑆸𑆠𑆯𑆫𑇀𑆑𑆫𑆩𑇀𑇅 𑆤𑆳𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆁 𑆤𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆤𑆾𑆰𑇀𑆟𑆁 𑆤𑆳𑆩𑆬𑆑𑆽𑆫𑇀𑆮𑆴𑆤𑆳 𑇆𑇖𑇑𑇆
𑆘𑇀𑆮𑆫𑆳𑆱𑆸𑆑𑇀𑆥𑆴𑆠𑇀𑆠𑆮𑆵𑆱𑆫𑇀𑆥𑆑𑆶𑆰𑇀𑆜𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆨𑇀𑆫𑆩𑆳𑆤𑇀𑇅 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑆑𑆳𑆩𑆬𑆳𑆁 𑆖𑆾𑆓𑇀𑆫𑆳𑆁 𑆮𑆴𑆣𑆴𑆁 𑆲𑆴𑆠𑇀𑆮𑆳 𑆢𑆣𑆴𑆥𑇀𑆫𑆴𑆪𑆂𑇆𑇖𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆮𑆼𑆓𑆳 𑆮𑆼𑆓𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆯𑇀𑆖 𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆖 𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆪𑆼𑆰𑆳𑆁 𑆮𑆼𑆓𑆳 𑆮𑆴𑆣𑆳𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆢𑆫𑇀𑆡𑆁 𑆪𑆢𑇀𑆣𑆴𑆠𑆳𑆲𑆴𑆠𑆩𑇀𑇆𑇖𑇓𑇆
𑆇𑆖𑆴𑆠𑆼 𑆖𑆳𑆲𑆴𑆠𑆼 𑆮𑆫𑇀𑆘𑇀𑆪𑆼 𑆱𑆼𑆮𑇀𑆪𑆼 𑆖𑆳𑆤𑆶𑆖𑆴𑆠𑆼 𑆑𑇀𑆫𑆩𑆂𑇅 𑆪𑆡𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆴 𑆖𑆳𑆲𑆳𑆫𑆾 𑆩𑆬𑆳𑆪𑆤𑆓𑆢𑆿𑆰𑆣𑆩𑇀𑇆𑇖𑇔𑇆
𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆳𑆩𑆤𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆿 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆿𑆰𑆣𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆂 𑆱𑆼𑆮𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆳 𑆣𑆵𑆩𑆠𑆳𑇁𑇁𑆠𑇀𑆩𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆴𑆤𑆳𑇆𑇖𑇕𑇆
𑆮𑆴𑆣𑆴𑆤𑆳 𑆢𑆣𑆴 𑆱𑆼𑆮𑇀𑆪𑆁 𑆖 𑆪𑆼𑆤 𑆪𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆠𑇀𑆫𑆴𑆘𑆂𑇅 𑆤𑆮𑆼𑆓𑆳𑆤𑇀𑆣𑆳𑆫𑆟𑆼𑇁𑆣𑇀𑆪𑆳𑆪𑆼 𑆱𑆫𑇀𑆮𑆩𑆼𑆮𑆳𑆮𑆢𑆤𑇀𑆩𑆶𑆤𑆴𑆂𑇆𑇖𑇖𑇆
𑆃𑆡𑆳𑆠 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴, 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴, 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆤𑆴, 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆂, 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆶𑆢𑇀𑆣𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆣𑆴𑆑𑆳𑆫𑆼𑇆𑇓𑇆
𑆃𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆤𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆁, ‘𑆖𑆼𑆠𑆂’ 𑆅𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆼𑆑𑆼, 𑆠𑆢𑆫𑇀𑆡𑆳𑆠𑇀𑆩𑆱𑆩𑇀𑆥𑆢𑆳𑆪𑆠𑇀𑆠𑆖𑆼𑆰𑇀𑆛𑆁 𑆖𑆼𑆰𑇀𑆛𑆳𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆨𑆷𑆠𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑇀𑇆𑇔𑇆
𑆱𑇀𑆮𑆳𑆫𑇀𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆮𑇀𑆪𑆨𑆴𑆖𑆫𑆟𑆳𑆖𑇀𑆖𑆳𑆤𑆼𑆑𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆶𑆫𑆶𑆰𑆼 𑆱𑆠𑇀𑆠𑇀𑆮𑆁, 𑆫𑆘𑆱𑇀𑆠𑆩𑆂𑆱𑆠𑇀𑆠𑇀𑆮𑆓𑆶𑆟𑆪𑆾𑆓𑆳𑆖𑇀𑆖; 𑆤 𑆖𑆳𑆤𑆼𑆑𑆠𑇀𑆮𑆁, 𑆤𑆲𑇀𑆪𑆼𑆑𑆁 𑆲𑇀𑆪𑆼𑆑𑆑𑆳𑆬𑆩𑆤𑆼𑆑𑆼𑆰𑆶 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 ; 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆽𑆑𑆑𑆳𑆬𑆳 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂𑇆𑇕𑇆
𑆪𑆢𑇀𑆓𑆶𑆟𑆁 𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆥𑆶𑆫𑆶𑆰𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆠𑆠𑇀𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆼𑆮𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆩𑆶𑆤𑆪𑆾 𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆤𑆶𑆯𑆪𑆳𑆠𑇀𑇆𑇖𑇆
𑆩𑆤𑆂𑆥𑆶𑆫𑆂𑆱𑆫𑆳𑆟𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆫𑇀𑆡𑆓𑇀𑆫𑆲𑆟𑆱𑆩𑆫𑇀𑆡𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆖𑆑𑇀𑆰𑆶𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆔𑇀𑆫𑆳𑆟𑆁 𑆫𑆱𑆤𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆩𑆴𑆠𑆴 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴𑇆𑇘𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴- 𑆒𑆁 𑆮𑆳𑆪𑆶𑆫𑇀𑆘𑇀𑆪𑆾𑆠𑆴𑆫𑆳𑆥𑆾 𑆨𑆷𑆫𑆴𑆠𑆴𑇆𑇙𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆤𑆴- 𑆃𑆑𑇀𑆰𑆴𑆟𑆵 𑆑𑆫𑇀𑆟𑆿 𑆤𑆳𑆱𑆴𑆑𑆼 𑆘𑆴𑆲𑇀𑆮𑆳 𑆠𑇀𑆮𑆑𑇀 𑆖𑆼𑆠𑆴𑇆𑇑𑇐𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆂- 𑆯𑆧𑇀𑆢𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆳𑆂𑇆𑇑𑇑𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆶𑆢𑇀𑆣𑆪𑆂- 𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳𑆢𑆴𑆑𑆳𑆂; 𑆠𑆳𑆂 𑆥𑆶𑆤𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆘𑆳𑆂, 𑆑𑇀𑆰𑆟𑆴𑆑𑆳, 𑆤𑆴𑆯𑇀𑆖𑆪𑆳𑆠𑇀𑆩𑆴𑆑𑆳𑆯𑇀𑆖, 𑆅𑆠𑇀𑆪𑆼𑆠𑆠𑇀 𑆥𑆚𑇀𑆖𑆥𑆚𑇀𑆖𑆑𑆩𑇀𑇆𑇑𑇒𑇆
𑆩𑆤𑆾 𑆩𑆤𑆾𑆫𑇀𑆡𑆾 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆳𑆠𑇀𑆩𑆳 𑆖𑆼𑆠𑇀𑆪𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆟𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆯𑇀𑆖, 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆴𑆠𑆁 𑆖 𑆑𑆫𑇀𑆩; 𑆪𑆢𑆶𑆖𑇀𑆪𑆠𑆼 𑆑𑇀𑆫𑆴𑆪𑆼𑆠𑆴𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑆶𑆩𑆳𑆤𑆓𑆩𑇀𑆪𑆳𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑆶𑆢𑆳𑆪𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑆳𑆩𑆥𑆴 𑆱𑆠𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆠𑆼𑆘𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆴, 𑆒𑆁 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆼, 𑆔𑇀𑆫𑆳𑆟𑆼 𑆑𑇀𑆰𑆴𑆠𑆴𑆂, 𑆄𑆥𑆾 𑆫𑆱𑆤𑆼, 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼𑇁𑆤𑆴𑆬𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆠𑆠𑇀𑆫 𑆪𑆢𑇀𑆪𑆢𑆳𑆠𑇀𑆩𑆑𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀𑆠𑆠𑇀𑆠𑆢𑆳𑆠𑇀𑆩𑆑𑆩𑆼𑆮𑆳𑆫𑇀𑆡𑆩𑆤𑆶𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆴, 𑆠𑆠𑇀𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆢𑇀𑆮𑆴𑆨𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑇆𑇑𑇔𑇆
𑆠𑆢𑆫𑇀𑆡𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆳𑆠𑇀 𑆱𑆩𑆤𑆱𑇀𑆑𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆔𑆳𑆠𑆳𑆪 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼, 𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆪𑆾𑆓𑆳𑆠𑇀 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆠𑆴𑇆𑇑𑇕𑇆
𑆩𑆤𑆱𑆱𑇀𑆠𑆶 𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆩𑆫𑇀𑆡𑆂𑇅 𑆠𑆠𑇀𑆫 𑆩𑆤𑆱𑆾 𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆼𑆯𑇀𑆖 𑆠 𑆍𑆮 𑆱𑆩𑆳𑆤𑆳𑆠𑆴𑆲𑆵𑆤𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆲𑆼𑆠𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆱𑆩𑆤𑆱𑇀𑆑𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆠𑆥𑇀𑆠𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆠𑆳𑆥𑆳𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆳𑆮𑆼 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆩𑆼𑆨𑆴𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆼𑆤 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆱𑆩𑇀𑆪𑆓𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆠𑆴𑆥𑆳𑆢𑆤𑆼𑆤, 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆠𑇀𑆩𑆓𑆶𑆟𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑆥𑆳𑆱𑆤𑆼𑆤 𑆖𑆼𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆠𑇀𑆩𑆲𑆴𑆠𑆁 𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆠𑆳 𑆱𑆫𑇀𑆮𑆼𑆟 𑆱𑆫𑇀𑆮𑆁 𑆱𑆫𑇀𑆮𑆢𑆳 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆱𑇀𑆡𑆳𑆪 𑆱𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆩𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆩𑇀𑇆𑇑𑇗𑇆
𑆠𑆢𑇀𑆣𑇀𑆪𑆤𑆶𑆠𑆴𑆰𑇀𑆜𑆤𑇀 𑆪𑆶𑆓𑆥𑆠𑇀 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆠𑇀𑆪𑆫𑇀𑆡𑆢𑇀𑆮𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑆪𑆁 𑆖𑆼𑆠𑆴; 𑆠𑆠𑇀 𑆱𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆩𑆒𑆴𑆬𑆼𑆤𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯 ! 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆼𑆮𑆓𑆾𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆖𑆳𑆫𑇀𑆪𑆳𑆤𑆫𑇀𑆖𑆪𑆼𑆠𑇀, 𑆃𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆖𑆫𑆼𑆠𑇀, 𑆏𑆰𑆣𑆵𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳 𑆣𑆳𑆫𑆪𑆼𑆠𑇀, 𑆢𑇀𑆮𑆿 𑆑𑆳𑆬𑆳𑆮𑆶𑆥𑆱𑇀𑆥𑆸𑆯𑆼𑆠𑇀, 𑆩𑆬𑆳𑆪𑆤𑆼𑆰𑇀𑆮𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆥𑆳𑆢𑆪𑆾𑆯𑇀𑆖 𑆮𑆽𑆩𑆬𑇀𑆪𑆩𑆳𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑇀𑆫𑆴𑆂𑆥𑆑𑇀𑆰𑆱𑇀𑆪 𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆬𑆾𑆩𑆤𑆒𑆳𑆤𑇀 𑆱𑆁𑆲𑆳𑆫𑆪𑆼𑆠𑇀, 𑆤𑆴𑆠𑇀𑆪𑆩𑆤𑆶𑆥𑆲𑆠𑆮𑆳𑆱𑆳𑆂 𑆱𑆶𑆩𑆤𑆳𑆂 𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆱𑆳𑆣𑆶𑆮𑆼𑆯𑆂, 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆑𑆼𑆯𑆂 , 𑆩𑆷𑆫𑇀𑆣𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆔𑇀𑆫𑆳𑆟𑆥𑆳𑆢𑆠𑆽𑆬𑆤𑆴𑆠𑇀𑆪𑆂, 𑆣𑆷𑆩𑆥𑆂, 𑆥𑆷𑆫𑇀𑆮𑆳𑆨𑆴𑆨𑆳𑆰𑆵, 𑆱𑆶𑆩𑆶𑆒𑆂, 𑆢𑆶𑆫𑇀𑆓𑆼𑆰𑇀𑆮𑆨𑇀𑆪𑆶𑆥𑆥𑆠𑇀𑆠𑆳, 𑆲𑆾𑆠𑆳, 𑆪𑆰𑇀𑆛𑆳, 𑆢𑆳𑆠𑆳, 𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆳𑆤𑆳𑆁 𑆤𑆩𑆱𑇀𑆑𑆫𑇀𑆠𑆳, 𑆧𑆬𑆵𑆤𑆳𑆩𑆶𑆥𑆲𑆫𑇀𑆠𑆳, 𑆃𑆠𑆴𑆡𑆵𑆤𑆳𑆁 𑆥𑆷𑆘𑆑𑆂, 𑆥𑆴𑆠𑆸𑆨𑇀𑆪𑆂 𑆥𑆴𑆟𑇀𑆝𑆢𑆂, 𑆑𑆳𑆬𑆼 𑆲𑆴𑆠𑆩𑆴𑆠𑆩𑆣𑆶𑆫𑆳𑆫𑇀𑆡𑆮𑆳𑆢𑆵, 𑆮𑆯𑇀𑆪𑆳𑆠𑇀𑆩𑆳, 𑆣𑆫𑇀𑆩𑆳𑆠𑇀𑆩𑆳, 𑆲𑆼𑆠𑆳𑆮𑆵𑆫𑇀𑆰𑇀𑆪𑆶𑆂, 𑆦𑆬𑆼 𑆤𑆼𑆫𑇀𑆰𑇀𑆪𑆶𑆂, 𑆤𑆴𑆯𑇀𑆖𑆴𑆤𑇀𑆠𑆂, 𑆤𑆴𑆫𑇀𑆨𑆵𑆑𑆂, 𑆲𑇀𑆫𑆵𑆩𑆳𑆤𑇀, 𑆣𑆵𑆩𑆳𑆤𑇀, 𑆩𑆲𑆾𑆠𑇀𑆱𑆳𑆲𑆂, 𑆢𑆑𑇀𑆰𑆂, 𑆑𑇀𑆰𑆩𑆳𑆮𑆳𑆤𑇀, 𑆣𑆳𑆫𑇀𑆩𑆴𑆑𑆂, 𑆄𑆱𑇀𑆠𑆴𑆑𑆂, 𑆮𑆴𑆤𑆪𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆴𑆢𑇀𑆪𑆳𑆨𑆴𑆘𑆤𑆮𑆪𑆾𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆖𑆳𑆫𑇀𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆳𑆱𑆴𑆠𑆳 , 𑆗𑆠𑇀𑆫𑆵 𑆢𑆟𑇀𑆝𑆵 𑆩𑆿𑆬𑆵 𑆱𑆾𑆥𑆳𑆤𑆠𑇀𑆑𑆾 𑆪𑆶𑆓𑆩𑆳𑆠𑇀𑆫𑆢𑆸𑆓𑇀𑆮𑆴𑆖𑆫𑆼𑆠𑇀 , 𑆩𑆕𑇀𑆓𑆬𑆳𑆖𑆳𑆫𑆯𑆵𑆬𑆂, 𑆑𑆶𑆖𑆼𑆬𑆳𑆱𑇀𑆡𑆴𑆑𑆟𑇀𑆛𑆑𑆳𑆩𑆼𑆣𑇀𑆪𑆑𑆼𑆯𑆠𑆶𑆰𑆾𑆠𑇀𑆑𑆫𑆨𑆱𑇀𑆩𑆑𑆥𑆳𑆬𑆱𑇀𑆤𑆳𑆤𑆧𑆬𑆴𑆨𑆷𑆩𑆵𑆤𑆳𑆁 𑆥𑆫𑆴𑆲𑆫𑇀𑆠𑆳, 𑆥𑇀𑆫𑆳𑆑𑇀 𑆯𑇀𑆫𑆩𑆳𑆢𑇀 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑆫𑇀𑆘𑆵 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆰𑆶 𑆧𑆤𑇀𑆣𑆶𑆨𑆷𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑆳𑆩𑆤𑆶𑆤𑆼𑆠𑆳, 𑆨𑆵𑆠𑆳𑆤𑆳𑆩𑆳𑆯𑇀𑆮𑆳𑆱𑆪𑆴𑆠𑆳, 𑆢𑆵𑆤𑆳𑆤𑆳𑆩𑆨𑇀𑆪𑆶𑆥𑆥𑆠𑇀𑆠𑆳, 𑆱𑆠𑇀𑆪𑆱𑆤𑇀𑆣𑆂, 𑆱𑆳𑆩𑆥𑇀𑆫𑆣𑆳𑆤𑆂 , 𑆥𑆫𑆥𑆫𑆶𑆰𑆮𑆖𑆤𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆂, 𑆃𑆩𑆫𑇀𑆰𑆔𑇀𑆤𑆂, 𑆥𑇀𑆫𑆯𑆩𑆓𑆶𑆟𑆢𑆫𑇀𑆯𑆵, 𑆫𑆳𑆓𑆢𑇀𑆮𑆼𑆰𑆲𑆼𑆠𑆷𑆤𑆳𑆁 𑆲𑆤𑇀𑆠𑆳 𑆖𑇆𑇑𑇘𑇆

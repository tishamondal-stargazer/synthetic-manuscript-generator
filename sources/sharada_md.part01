𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆳𑆱𑇀𑆠𑆶 𑆠𑆫𑆶𑆟𑆳 𑆮𑆸𑆢𑇀𑆣𑆳 𑆩𑆟𑇀𑆝𑆬𑆴𑆤𑆱𑇀𑆠𑆡𑆳 𑇅 𑆫𑆳𑆘𑆴𑆩𑆤𑇀𑆠𑆾 𑆮𑆪𑆾𑆩𑆣𑇀𑆪𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆸𑆠𑇀𑆪𑆶𑆲𑆼𑆠𑆮𑆂 𑇆𑇓𑇒𑇆
𑆤𑆑𑆶𑆬𑆳𑆑𑆶𑆬𑆴𑆠𑆳 𑆧𑆳𑆬𑆳 𑆮𑆳𑆫𑆴𑆮𑆴𑆥𑇀𑆫𑆲𑆠𑆳𑆂 𑆑𑆸𑆯𑆳𑆂 𑇅 𑆮𑆸𑆢𑇀𑆣𑆳 𑆩𑆶𑆑𑇀𑆠𑆠𑇀𑆮𑆖𑆾 𑆨𑆵𑆠𑆳𑆂 𑆱𑆫𑇀𑆥𑆳𑆱𑇀𑆠𑇀𑆮𑆬𑇀𑆥𑆮𑆴𑆰𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇓𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆳𑆂- 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆾, 𑆩𑆲𑆳𑆑𑆸𑆰𑇀𑆟𑆂, 𑆑𑆸𑆰𑇀𑆟𑆾𑆢𑆫𑆂 𑆯𑇀𑆮𑆼𑆠𑆑𑆥𑆾𑆠𑆾, 𑆩𑆲𑆳𑆑𑆥𑆾𑆠𑆾, 𑆧𑆬𑆳𑆲𑆑𑆾, 𑆩𑆲𑆳𑆱𑆫𑇀𑆥𑆂, 𑆯𑆕𑇀𑆒𑆑𑆥𑆳𑆬𑆾 , 𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆾, 𑆓𑆮𑆼𑆣𑆶𑆑𑆂, 𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆂, 𑆒𑆟𑇀𑆝𑆦𑆟𑆂, 𑆑𑆑𑆶𑆢𑆂, 𑆥𑆢𑇀𑆩𑆾, 𑆩𑆲𑆳𑆥𑆢𑇀𑆩𑆾, 𑆢𑆫𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆾, 𑆢𑆣𑆴𑆩𑆶𑆒𑆂, 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆾, 𑆨𑇀𑆫𑆷𑆑𑆶𑆛𑆵𑆩𑆶𑆒𑆾, 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆂, 𑆥𑆶𑆰𑇀𑆥𑆳𑆨𑆴𑆑𑆵𑆫𑇀𑆟𑆾, 𑆓𑆴𑆫𑆴𑆱𑆫𑇀𑆥𑆂, 𑆉𑆘𑆶𑆱𑆫𑇀𑆥𑆂, 𑆯𑇀𑆮𑆼𑆠𑆾𑆢𑆫𑆾, 𑆩𑆲𑆳𑆯𑆴𑆫𑆳, 𑆃𑆬𑆓𑆫𑇀𑆢, 𑆄𑆯𑆵𑆮𑆴𑆰 𑆅𑆠𑆴 (𑇑); 𑆩𑆟𑇀𑆝𑆬𑆴𑆤𑆱𑇀𑆠𑆶- 𑆄𑆢𑆫𑇀𑆯𑆩𑆟𑇀𑆝𑆬𑆂, 𑆯𑇀𑆮𑆼𑆠𑆩𑆟𑇀𑆝𑆬𑆾, 𑆫𑆑𑇀𑆠𑆩𑆟𑇀𑆝𑆬𑆂, 𑆖𑆴𑆠𑇀𑆫𑆩𑆟𑇀𑆝𑆬𑆂, 𑆥𑆸𑆰𑆠𑆾, 𑆫𑆾𑆣𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆾, 𑆩𑆴𑆬𑆴𑆤𑇀𑆢𑆑𑆾, 𑆓𑆾𑆤𑆱𑆾, 𑆮𑆸𑆢𑇀𑆣𑆓𑆾𑆤𑆱𑆂, 𑆥𑆤𑆱𑆾, 𑆩𑆲𑆳𑆥𑆤𑆱𑆾, 𑆮𑆼𑆟𑆶𑆥𑆠𑇀𑆫𑆑𑆂, 𑆯𑆴𑆯𑆶𑆑𑆾 𑆩𑆢𑆤𑆂, 𑆥𑆳𑆬𑆴𑆤𑇀𑆢𑆴𑆫𑆂, 𑆥𑆴𑆕𑇀𑆓𑆬𑆂 , 𑆠𑆤𑇀𑆠𑆶𑆑𑆂 𑆥𑆶𑆰𑇀𑆥𑆥𑆳𑆟𑇀𑆝𑆶𑆂, 𑆰𑆝𑆕𑇀𑆓𑆾, 𑆃𑆓𑇀𑆤𑆴𑆑𑆾 𑆧𑆨𑇀𑆫𑆶𑆂, 𑆑𑆰𑆳𑆪𑆂, 𑆑𑆬𑆶𑆰𑆂 𑆥𑆳𑆫𑆳𑆮𑆠𑆾, 𑆲𑆱𑇀𑆠𑆳𑆨𑆫𑆟𑆂, 𑆖𑆴𑆠𑇀𑆫𑆑𑆂, 𑆍𑆟𑆵𑆥𑆢 𑆅𑆠𑆴 (𑇒); 𑆫𑆳𑆘𑆴𑆩𑆤𑇀𑆠𑆱𑇀𑆠𑆶- 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆾 𑆫𑆳𑆘𑆴𑆖𑆴𑆠𑇀𑆫𑆾, 𑆃𑆕𑇀𑆓𑆶𑆬𑆫𑆳𑆘𑆴𑆂, 𑆧𑆴𑆤𑇀𑆢𑆶𑆫𑆳𑆘𑆴𑆂, 𑆑𑆫𑇀𑆢𑆩𑆑𑆂, 𑆠𑆸𑆟𑆯𑆾𑆰𑆑𑆂, 𑆱𑆫𑇀𑆰𑆥𑆑𑆂 𑆯𑇀𑆮𑆼𑆠𑆲𑆤𑆶𑆂, 𑆢𑆫𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆯𑇀𑆖𑆑𑇀𑆫𑆑𑆾, 𑆓𑆾𑆣𑆷𑆩𑆑𑆂, 𑆑𑆴𑆑𑇀𑆑𑆴𑆱𑆳𑆢 𑆅𑆠𑆴 (𑇓); 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆳𑆱𑇀𑆠𑆶- 𑆓𑆬𑆓𑆾𑆬𑆵, 𑆯𑆷𑆑𑆥𑆠𑇀𑆫𑆾, 𑆃𑆘𑆓𑆫𑆾, 𑆢𑆴𑆮𑇀𑆪𑆑𑆾, 𑆮𑆫𑇀𑆰𑆳𑆲𑆴𑆑𑆂, 𑆥𑆶𑆰𑇀𑆥𑆯𑆑𑆬𑆵, 𑆘𑇀𑆪𑆾𑆠𑆵𑆫𑆡𑆂, 𑆑𑇀𑆰𑆵𑆫𑆴𑆑𑆳𑆥𑆶𑆰𑇀𑆥𑆑𑆾, 𑆃𑆲𑆴𑆥𑆠𑆳𑆑𑆾, 𑆃𑆤𑇀𑆣𑆳𑆲𑆴𑆑𑆾, 𑆓𑆿𑆫𑆳𑆲𑆴𑆑𑆾, 𑆮𑆸𑆑𑇀𑆰𑆼𑆯𑆪 𑆅𑆠𑆴 (𑇔); 𑆮𑆽𑆑𑆫𑆚𑇀𑆘𑆳𑆱𑇀𑆠𑆶 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑇀𑆪𑆠𑆴𑆑𑆫𑆳𑆘𑇀𑆘𑆳𑆠𑆳𑆂, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆳𑆑𑆶𑆬𑆴𑆂, 𑆥𑆾𑆛𑆓𑆬𑆂, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆳𑆘𑆴𑆫𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆼𑆟 𑆓𑆾𑆤𑆱𑇀𑆪𑆳𑆁 𑆮𑆽𑆥𑆫𑆵𑆠𑇀𑆪𑆼𑆤 𑆮𑆳 𑆘𑆳𑆠𑆾 𑆩𑆳𑆑𑆶𑆬𑆴𑆂; 𑆫𑆳𑆘𑆴𑆬𑆼𑆤 𑆓𑆾𑆤𑆱𑇀𑆪𑆳𑆁 𑆮𑆽𑆥𑆫𑆵𑆠𑇀𑆪𑆼𑆤 𑆮𑆳 𑆘𑆳𑆠𑆂 𑆥𑆾𑆛𑆓𑆬𑆂; 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆼𑆟 𑆫𑆳𑆘𑆴𑆩𑆠𑇀𑆪𑆳𑆁 𑆮𑆽𑆥𑆫𑆵𑆠𑇀𑆪𑆼𑆤 𑆮𑆳 𑆘𑆳𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆳𑆘𑆴𑆫𑆴𑆠𑆴 𑇅 𑆠𑆼𑆰𑆳𑆩𑆳𑆢𑇀𑆪𑆱𑇀𑆪 𑆥𑆴𑆠𑆸𑆮𑆢𑇀𑆮𑆴𑆰𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆾, 𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆩𑆳𑆠𑆸𑆮𑆢𑆴𑆠𑇀𑆪𑆼𑆑𑆼 (𑇕) 𑇅𑇓𑇔𑇅 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆮𑆽𑆑𑆫𑆚𑇀𑆘𑆳𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆴𑆮𑇀𑆪𑆼𑆬𑆑𑆫𑆾𑆣𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆑𑆫𑆳𑆘𑆴𑆖𑆴𑆠𑇀𑆫𑆑𑆥𑆾𑆛𑆓𑆬𑆥𑆶𑆰𑇀𑆥𑆳𑆨𑆴𑆑𑆵𑆫𑇀𑆟𑆢𑆫𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆮𑆼𑆬𑇀𑆬𑆴𑆠𑆑𑆳𑆂 𑆱𑆥𑇀𑆠; 𑆠𑆼𑆰𑆳𑆩𑆳𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆫𑆳𑆘𑆴𑆬𑆮𑆠𑇀, 𑆯𑆼𑆰𑆳 𑆩𑆟𑇀𑆝𑆬𑆴𑆮𑆠𑇀, 𑆍𑆮𑆩𑆼𑆠𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆥𑆳𑆟𑆳𑆩𑆯𑆵𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑇆𑇓𑇔𑇆
𑆠𑆠𑇀𑆫 𑆩𑆲𑆳𑆤𑆼𑆠𑇀𑆫𑆘𑆴𑆲𑇀𑆮𑆳𑆱𑇀𑆪𑆯𑆴𑆫𑆱𑆂 𑆥𑆶𑆩𑆳𑆁𑆱𑆂, 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆤𑆼𑆠𑇀𑆫𑆘𑆴𑆲𑇀𑆮𑆳𑆱𑇀𑆪𑆯𑆴𑆫𑆱𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂, 𑆇𑆨𑆪𑆬𑆑𑇀𑆰𑆟𑆳 𑆩𑆤𑇀𑆢𑆮𑆴𑆰𑆳 𑆃𑆑𑇀𑆫𑆾𑆣𑆳 𑆤𑆥𑆶𑆁𑆱𑆑𑆳 𑆅𑆠𑆴 𑇆𑇓𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆥𑆳𑆟𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠 𑆍𑆮 𑆢𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁? 𑆮𑆴𑆰𑆁 𑆲𑆴 𑆤𑆴𑆯𑆴𑆠𑆤𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆳𑆯𑆤𑆴𑆲𑆶𑆠𑆮𑆲𑆢𑆼𑆯𑇀𑆪𑆩𑆳𑆯𑆶𑆑𑆳𑆫𑆴 𑆩𑆶𑆲𑆫𑇀𑆠𑆩𑆥𑇀𑆪𑆶𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆩𑆳𑆠𑆶𑆫𑆩𑆠𑆴𑆥𑆳𑆠𑆪𑆠𑆴, 𑆤 𑆖𑆳𑆮𑆑𑆳𑆯𑆾𑇁𑆱𑇀𑆠𑆴 𑆮𑆳𑆑𑇀𑆱𑆩𑆷𑆲𑆩𑆶𑆥𑆱𑆫𑇀𑆠𑆶𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆩𑆥𑆴 𑆢𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆼𑇁𑆨𑆴𑆲𑆴𑆠𑆼 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆠𑇀𑆫𑆽𑆮𑆴𑆣𑇀𑆪𑆁 𑆨𑆮𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆠𑇀𑆫𑆽𑆮𑆴𑆣𑇀𑆪𑆩𑆼𑆮 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂; 𑆍𑆠𑆢𑇀𑆣𑇀𑆪𑆳𑆠𑆶𑆫𑆲𑆴𑆠𑆩𑆱𑆩𑇀𑆩𑆾𑆲𑆑𑆫𑆁 𑆖, 𑆃𑆥𑆴 𑆖𑆳𑆠𑇀𑆫𑆽𑆮 𑆱𑆫𑇀𑆮𑆱𑆫𑇀𑆥𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆮𑆫𑆾𑆣𑆂 𑇆𑇓𑇖𑇆
𑆠𑆠𑇀𑆫, 𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆮𑆴𑆰𑆼𑆟 𑆠𑇀𑆮𑆕𑇀𑆤𑆪𑆤𑆤𑆒𑆢𑆯𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆢𑆁𑆯𑆑𑆸𑆰𑇀𑆟𑆠𑇀𑆮𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆯𑆴𑆫𑆱𑆾 𑆓𑆿𑆫𑆮𑆁 𑆱𑆤𑇀𑆣𑆴𑆮𑆼𑆢𑆤𑆳 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆓𑇀𑆫𑆵𑆮𑆳𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆘𑆸𑆩𑇀𑆨𑆟𑆁 𑆮𑆼𑆥𑆡𑆶𑆂 𑆱𑇀𑆮𑆫𑆳𑆮𑆱𑆳𑆢𑆾 𑆔𑆶𑆫𑇀𑆔𑆶𑆫𑆑𑆾 𑆘𑆝𑆠𑆳 𑆯𑆶𑆰𑇀𑆑𑆾𑆢𑇀𑆓𑆳𑆫𑆂 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆿 𑆲𑆴𑆑𑇀𑆑𑆳 𑆮𑆳𑆪𑆾𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆩𑆤𑆁 𑆯𑆷𑆬𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆠𑆸𑆰𑇀𑆟𑆳 𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆂 𑆦𑆼𑆤𑆳𑆓𑆩𑆤𑆁 𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆮𑆫𑆾𑆣𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆳𑆯𑇀𑆖 𑆮𑆳𑆠𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆩𑆟𑇀𑆝𑆬𑆴𑆮𑆴𑆰𑆼𑆟 𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆵𑆠𑆠𑇀𑆮𑆁 𑆯𑆵𑆠𑆳𑆨𑆴𑆬𑆳𑆰𑆂 𑆥𑆫𑆴𑆣𑆷𑆥𑆤𑆁 𑆢𑆳𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆩𑆢𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆘𑇀𑆮𑆫𑆂 𑆯𑆾𑆟𑆴𑆠𑆳𑆓𑆩𑆤𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆯𑇀𑆖 𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆩𑆮𑆯𑆳𑆠𑆤𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆢𑆁𑆯𑆑𑆾𑆡𑆂 𑆥𑆵𑆠𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆩𑆳𑆯𑆶𑆑𑆾𑆥𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆳𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆫𑆳𑆘𑆴𑆩𑆢𑇀𑆮𑆴𑆰𑆼𑆟 𑆯𑆶𑆑𑇀𑆬𑆠𑇀𑆮𑆁 𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆾 𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆠𑇀𑆮𑆁 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆳𑆢𑆁𑆯𑆯𑆾𑆦𑆂 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆑𑆟𑇀𑆝𑆷𑆂 𑆑𑆟𑇀𑆜𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆔𑆶𑆫𑇀𑆔𑆶𑆫𑆑 𑆇𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆤𑆴𑆫𑆾𑆣𑆱𑇀𑆠𑆩𑆂𑆥𑇀𑆫𑆮𑆼𑆯𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆳𑆯𑇀𑆖 𑆑𑆦𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇗𑇆
𑆥𑆶𑆫𑆶𑆰𑆳𑆨𑆴𑆢𑆰𑇀𑆛 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆠𑆼, 𑆃𑆣𑆱𑇀𑆠𑆳𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆱𑆴𑆫𑆳𑆯𑇀𑆖𑆾𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆬𑆬𑆳𑆛𑆼, 𑆤𑆥𑆶𑆁𑆱𑆑𑆳𑆨𑆴𑆢𑆰𑇀𑆛𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆵 𑆨𑆮𑆠𑆴, 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆥𑆳𑆟𑇀𑆝𑆶𑆩𑆶𑆒𑆾𑆣𑇀𑆩𑆳𑆠𑆯𑇀𑆖, 𑆱𑆷𑆠𑆴𑆑𑆪𑆳 𑆑𑆶𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆳𑆫𑇀𑆠𑆂 𑆱𑆫𑆶𑆣𑆴𑆫𑆁 𑆩𑆼𑆲𑆠𑇀𑆪𑆶𑆥𑆘𑆴𑆲𑇀𑆮𑆴𑆑𑆳 𑆖𑆳𑆱𑇀𑆪 𑆨𑆮𑆠𑆴, 𑆓𑇀𑆫𑆳𑆱𑆳𑆫𑇀𑆡𑆴𑆤𑆳𑇁𑆤𑇀𑆤𑆁 𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆠𑆴, 𑆮𑆸𑆢𑇀𑆣𑆼𑆤 𑆖𑆴𑆫𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆳𑆯𑇀𑆖 𑆮𑆼𑆓𑆳𑆂, 𑆧𑆳𑆬𑆼𑆤𑆳𑆯𑆶 𑆩𑆸𑆢𑆮𑆯𑇀𑆖, 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆼𑆟𑆳𑆮𑆴𑆰𑆬𑆴𑆕𑇀𑆓𑆁, 𑆃𑆤𑇀𑆣𑆳𑆲𑆴𑆑𑆼𑆤𑆳𑆤𑇀𑆣𑆠𑇀𑆮𑆩𑆴𑆠𑇀𑆪𑆼𑆑𑆼, 𑆓𑇀𑆫𑆱𑆤𑆳𑆠𑇀 𑆃𑆘𑆓𑆫𑆂 𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆾 𑆤 𑆮𑆴𑆰𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆲𑆴𑆢𑆰𑇀𑆛𑆂 𑆥𑆠𑆠𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆯𑆤𑆴𑆲𑆠 𑆅𑆮 𑆨𑆷𑆩𑆿, 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆂 𑆱𑇀𑆮𑆥𑆴𑆠𑆴 𑇆𑇓𑇘𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆥𑆳𑆟𑆳𑆁 𑆮𑆴𑆰𑆱𑇀𑆪 𑆱𑆥𑇀𑆠 𑆮𑆼𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆢𑆫𑇀𑆮𑆵𑆑𑆫𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆡𑆩𑆼 𑆮𑆼𑆓𑆼 𑆮𑆴𑆰𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆠𑇀 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆁 𑆑𑆸𑆰𑇀𑆟𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴, 𑆠𑆼𑆤 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆟𑆩𑆴𑆮 𑆖𑆳𑆕𑇀𑆓𑆼 𑆨𑆮𑆠𑆴; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆩𑆳𑆁𑆱𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆑𑆸𑆰𑇀𑆟𑆠𑆳 𑆯𑆾𑆦𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆪𑆯𑇀𑆖𑆳𑆕𑇀𑆓𑆼 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆸𑆠𑆵𑆪𑆼 𑆩𑆼𑆢𑆾 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆢𑆁𑆯𑆑𑇀𑆬𑆼𑆢𑆂 𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆁 𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆓𑇀𑆫𑆲𑆟𑆁 𑆖; 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆑𑆾𑆰𑇀𑆜𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆑𑆦𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑇀 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆥𑇀𑆫𑆱𑆼𑆑𑆱𑆤𑇀𑆣𑆴𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆥𑆚𑇀𑆖𑆩𑆼𑇁𑆱𑇀𑆡𑆵𑆤𑇀𑆪𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆥𑇀𑆫𑆳𑆟𑆩𑆓𑇀𑆤𑆴𑆁 𑆖 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆾 𑆲𑆴𑆑𑇀𑆑𑆳 𑆢𑆳𑆲𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆰𑆰𑇀𑆜𑆼 𑆩𑆘𑇀𑆘𑆳𑆤𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆓𑇀𑆫𑆲𑆟𑆵𑆁 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆓𑆿𑆫𑆮𑆩𑆠𑆵𑆱𑆳𑆫𑆾 𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖 𑆨𑆮𑆠𑆴; 𑆱𑆥𑇀𑆠𑆩𑆼 𑆯𑆶𑆑𑇀𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆮𑇀𑆪𑆳𑆤𑆁 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆑𑆾𑆥𑆪𑆠𑆴 𑆑𑆦𑆁 𑆖 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆖𑇀𑆪𑆳𑆮𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆫𑇀𑆠𑆴𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆨𑆕𑇀𑆓𑆂 𑆱𑆫𑇀𑆮𑆖𑆼𑆰𑇀𑆛𑆳𑆮𑆴𑆔𑆳𑆠𑆾 𑆬𑆳𑆬𑆳𑆱𑇀𑆮𑆼𑆢𑆪𑆾𑆫𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆤𑆴𑆫𑆾𑆣𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇅 𑆩𑆟𑇀𑆝𑆬𑆴𑆤𑆳𑆁 𑆥𑇀𑆫𑆡𑆩𑆼 𑆮𑆼𑆓𑆼 𑆮𑆴𑆰𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆠𑇀 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆁 𑆥𑆵𑆠𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆥𑆫𑆴𑆢𑆳𑆲𑆂 𑆥𑆵𑆠𑆳𑆮𑆨𑆳𑆱𑆠𑆳 𑆖𑆳𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆨𑆮𑆠𑆴; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆩𑆳𑆁𑆱𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆵𑆠𑆠𑆳 𑆥𑆫𑆴𑆢𑆳𑆲𑆾 𑆢𑆁𑆯𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆠𑆸𑆠𑆵𑆪𑆼 𑆩𑆼𑆢𑆾 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆥𑆷𑆫𑇀𑆮𑆮𑆖𑇀𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆓𑇀𑆫𑆲𑆟𑆁 𑆠𑆸𑆰𑇀𑆟𑆳 𑆢𑆁𑆯𑆑𑇀𑆬𑆼𑆢𑆂 𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆖; 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆑𑆾𑆰𑇀𑆜𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆘𑇀𑆮𑆫𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴; 𑆥𑆚𑇀𑆖𑆩𑆼 𑆥𑆫𑆴𑆢𑆳𑆲𑆁 𑆱𑆫𑇀𑆮𑆓𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆑𑆫𑆾𑆠𑆴, 𑆰𑆰𑇀𑆜𑆱𑆥𑇀𑆠𑆩𑆪𑆾𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇅 𑆫𑆳𑆘𑆴𑆩𑆠𑆳𑆁 𑆥𑇀𑆫𑆡𑆩𑆼 𑆮𑆼𑆓𑆼 𑆮𑆴𑆰𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆢𑆷𑆰𑆪𑆠𑆴 𑆠𑆠𑇀 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴, 𑆠𑆼𑆤 𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆂 𑆯𑆶𑆑𑇀𑆬𑆳𑆮𑆨𑆳𑆱𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆩𑆳𑆁𑆱𑆁 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆘𑆳𑆝𑇀𑆪𑆁 𑆯𑆴𑆫𑆂𑆯𑆾𑆦𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆠𑆸𑆠𑆵𑆪𑆼 𑆩𑆼𑆢𑆾 𑆢𑆷𑆰𑆪𑆠𑆴, 𑆠𑆼𑆤 𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆓𑇀𑆫𑆲𑆟𑆁 𑆢𑆁𑆯𑆑𑇀𑆬𑆼𑆢𑆂 𑆱𑇀𑆮𑆼𑆢𑆾 𑆔𑇀𑆫𑆳𑆟𑆳𑆑𑇀𑆰𑆴𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆑𑆾𑆰𑇀𑆜𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴; 𑆥𑆚𑇀𑆖𑆩𑆼 𑆮𑆳𑆑𑇀𑆱𑆕𑇀𑆓𑆁 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴; 𑆰𑆰𑇀𑆜𑆱𑆥𑇀𑆠𑆩𑆪𑆾𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆴𑆠𑆴 𑇆𑇓𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆣𑆳𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆪𑆳𑆂 𑆱𑆥𑇀𑆠 𑆑𑆬𑆳𑆂 𑆱𑆩𑇀𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆠𑆳𑆱𑇀𑆮𑆼𑆑𑆽𑆑𑆳𑆩𑆠𑆴𑆑𑇀𑆫𑆩𑇀𑆪 𑆮𑆼𑆓𑆁 𑆥𑇀𑆫𑆑𑆶𑆫𑆶𑆠𑆼 𑆮𑆴𑆰𑆩𑇀 𑇆𑇔𑇐𑇆
𑆪𑆼𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆠𑆶 𑆑𑆬𑆳𑆁 𑆑𑆳𑆬𑆑𑆬𑇀𑆥𑆁 𑆨𑆴𑆤𑆠𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆱𑆩𑆵𑆫𑆟𑆼𑆤𑆾𑆲𑇀𑆪𑆩𑆳𑆤𑆁 𑆠𑆠𑇀𑆠𑆶 𑆮𑆼𑆓𑆳𑆤𑇀𑆠𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇔𑇑𑇆
𑆯𑆷𑆤𑆳𑆕𑇀𑆓𑆂 𑆥𑇀𑆫𑆡𑆩𑆼 𑆮𑆼𑆓𑆼 𑆥𑆯𑆶𑆫𑇀𑆣𑇀𑆪𑆳𑆪𑆠𑆴 𑆢𑆶𑆂𑆒𑆴𑆠𑆂 𑇅 𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆾 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆠𑆶 𑆑𑆸𑆰𑇀𑆟𑆳𑆕𑇀𑆓𑆂 𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑆲𑆸𑆢𑆴 𑇆𑇔𑇒𑇆

𑆘𑇀𑆚𑆼𑆪𑆂 𑆥𑆡𑇀𑆪𑆠𑆩𑆯𑇀𑆖𑆽𑆮 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆂 𑆑𑆸𑆠𑆳𑆑𑆸𑆠𑆂 𑇅𑇓𑇖𑇗𑇅 𑆱 𑆠𑆶 𑆢𑆳𑆝𑆴𑆩𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆪𑆶𑆑𑇀𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆫𑆳𑆓𑆰𑆳𑆝𑆮𑆂 𑇆𑇓𑇖𑇗𑇆
𑆫𑆶𑆖𑆴𑆰𑇀𑆪𑆾 𑆬𑆔𑆶𑆥𑆳𑆑𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆖𑆳𑆮𑆴𑆫𑆾𑆣𑆑𑆸𑆠𑇀 𑇅𑇓𑇖𑇘𑇅 𑆩𑆱𑆷𑆫𑆩𑆶𑆢𑇀𑆓𑆓𑆾𑆣𑆷𑆩𑆑𑆶𑆬𑆠𑇀𑆡𑆬𑆮𑆟𑆽𑆂 𑆑𑆸𑆠𑆂 𑇆𑇓𑇖𑇘𑇆
𑆫𑆾𑆖𑆤𑆾 𑆢𑆵𑆥𑆤𑆾 𑆲𑆸𑆢𑇀𑆪𑆾 𑆬𑆔𑆶𑆥𑆳𑆑𑇀𑆪𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇅𑇓𑇗𑇐𑇅 𑆥𑆛𑆾𑆬𑆤𑆴𑆩𑇀𑆧𑆪𑆷𑆰𑆿 𑆠𑆶 𑆑𑆦𑆩𑆼𑆢𑆾𑆮𑆴𑆯𑆾𑆰𑆴𑆟𑆿 𑇆𑇓𑇗𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆿 𑆢𑆵𑆥𑆤𑆿 𑆲𑆸𑆢𑇀𑆪𑆿 𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆘𑇀𑆮𑆫𑆳𑆥𑆲𑆿 𑇅𑇓𑇗𑇑𑇅 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆫𑆾𑆖𑆑𑆘𑇀𑆮𑆫𑆳𑆤𑇀 𑇆𑇓𑇗𑇑𑇆
𑆲𑆤𑇀𑆠𑆴 𑆩𑆷𑆬𑆑𑆪𑆷𑆰𑆱𑇀𑆠𑆶 𑆑𑆦𑆩𑆼𑆢𑆾𑆓𑆬𑆓𑇀𑆫𑆲𑆳𑆤𑇀 𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆷𑆰𑆾𑇁𑆤𑆴𑆬𑆲𑆳 𑆯𑇀𑆮𑆳𑆱𑆥𑆵𑆤𑆱𑆤𑆳𑆯𑆤𑆂 𑇆𑇓𑇗𑇒𑇆
𑆠𑆷𑆟𑆵𑆥𑇀𑆫𑆠𑆷𑆟𑆵𑆑𑆳𑆱𑆳𑆯𑇀𑆩𑆓𑆶𑆬𑇀𑆩𑆩𑆼𑆢𑆂𑆑𑆦𑆳𑆮𑆲𑆂 𑇅𑇓𑇗𑇓𑇅 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆽𑆫𑇀𑆪𑆷𑆰𑆾 𑆲𑆸𑆢𑇀𑆪𑆂 𑆱𑆁𑆯𑆩𑆤𑆾 𑆬𑆔𑆶𑆂 𑇆𑇓𑇗𑇓𑇆
𑆥𑇀𑆫𑆳𑆟𑆳𑆓𑇀𑆤𑆴𑆘𑆤𑆤𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆩𑆼𑆢𑆾𑆔𑇀𑆤𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑆴𑆠𑇀 𑇅𑇓𑇗𑇔𑇅 𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆱𑇀𑆠𑆶 𑆓𑇀𑆫𑆳𑆲𑆵 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆼 𑆲𑆴𑆠𑆂 𑇆𑇓𑇗𑇔𑇆
𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆪𑆷𑆰𑆂 𑆑𑆟𑇀𑆜𑇀𑆪𑆾𑇁𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇅𑇓𑇗𑇕𑇅 𑆱𑆫𑇀𑆮𑆣𑆳𑆤𑇀𑆪𑆑𑆸𑆠𑆱𑇀𑆠𑆢𑇀𑆮𑆢𑇀𑆧𑆸𑆁𑆲𑆟𑆂 𑆥𑇀𑆫𑆳𑆟𑆮𑆫𑇀𑆣𑆤𑆂 𑇆𑇓𑇗𑇕𑇆
𑆒𑆝𑆑𑆳𑆩𑇀𑆧𑆬𑆴𑆑𑆿 𑆲𑆸𑆢𑇀𑆪𑆿 𑆠𑆡𑆳 𑆮𑆳𑆠𑆑𑆦𑆼 𑆲𑆴𑆠𑆿 𑇅𑇓𑇗𑇖𑇅 𑆧𑆬𑇀𑆪𑆂 𑆑𑆦𑆳𑆤𑆴𑆬𑆿 𑆲𑆤𑇀𑆠𑆴 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑇀𑆬𑆾𑇁𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆂 𑇆𑇓𑇗𑇖𑇆
𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆂 𑆑𑆦𑆑𑆸𑆢𑇀𑆧𑆬𑇀𑆪𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆮𑆳𑆠𑆲𑆫𑆾 𑆓𑆶𑆫𑆶𑆂 𑇅 𑆠𑆑𑇀𑆫𑆳𑆩𑇀𑆬𑆂 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑇀 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾 𑆮𑆴𑆰𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆂 𑇆𑇓𑇗𑇗𑇆
𑆒𑆝𑆳𑆂 𑆒𑆝𑆪𑆮𑆳𑆓𑇀𑆮𑆯𑇀𑆖 𑆰𑆳(𑆒𑆳)𑆝𑆮𑆳𑆂 𑆥𑆳𑆤𑆑𑆳𑆤𑆴 𑆖 𑇅 𑆍𑆮𑆩𑆳𑆢𑆵𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆑𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑆮𑆽𑆢𑇀𑆪𑆮𑆳𑆑𑇀𑆪𑆠𑆂 𑇆𑇓𑇗𑇘𑇆
𑆃𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆁 𑆱𑆫𑇀𑆮𑆩𑆑𑆸𑆠𑆁 𑆑𑆛𑆶𑆑𑆽𑆫𑇀𑆮𑆴𑆤𑆳 𑇅 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆁 𑆬𑆮𑆟𑆱𑇀𑆤𑆼𑆲𑆑𑆛𑆶𑆑𑆽𑆂 𑆱𑆁𑆪𑆶𑆠𑆁 𑆑𑆸𑆠𑆩𑇀 𑇆𑇓𑇗𑇙𑇆
𑆃𑆡 𑆓𑆾𑆫𑆱𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆦𑆬𑆳𑆩𑇀𑆬𑆽𑆫𑆩𑇀𑆬𑆴𑆠𑆁 𑆖 𑆪𑆠𑇀 𑇅 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆬𑆔𑆶 𑆲𑆴𑆠𑆁 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆁 𑆫𑆱𑆩𑇀 𑇆𑇓𑇘𑇐𑇆
𑆢𑆣𑆴𑆩𑆱𑇀𑆠𑇀𑆮𑆩𑇀𑆬𑆱𑆴𑆢𑇀𑆣𑆱𑇀𑆠𑆶 𑆪𑆷𑆰𑆂 𑆑𑆳𑆩𑇀𑆧𑆬𑆴𑆑𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅𑇓𑇘𑇑𑇅 𑆠𑆴𑆬𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆮𑆴𑆑𑆸𑆠𑆴𑆂 𑆯𑆶𑆰𑇀𑆑𑆯𑆳𑆑𑆁 𑆮𑆴𑆫𑆷𑆞𑆑𑆩𑇀 𑇆𑇓𑇘𑇑𑇆
𑆱𑆴𑆟𑇀𑆝𑆳𑆑𑆵 𑆖 𑆓𑆶𑆫𑆷𑆟𑆴 𑆱𑇀𑆪𑆶𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆳𑆟𑆴 𑆖 𑇅𑇓𑇘𑇒𑇅 𑆠𑆢𑇀𑆮𑆖𑇀𑆖 𑆮𑆛𑆑𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆫𑇀𑆮𑆴𑆢𑆳𑆲𑆵𑆤𑆴 𑆓𑆶𑆫𑆷𑆟𑆴 𑆖 𑇆𑇓𑇘𑇒𑇆
𑆬𑆔𑆮𑆾 𑆧𑆸𑆁𑆲𑆟𑆳 𑆮𑆸𑆰𑇀𑆪𑆳 𑆲𑆸𑆢𑇀𑆪𑆳 𑆫𑆾𑆖𑆤𑆢𑆵𑆥𑆤𑆳𑆂 𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆯𑇀𑆫𑆩𑆔𑇀𑆤𑆳 𑆫𑆳𑆓𑆰𑆳𑆝𑆮𑆳𑆂 𑇆𑇓𑇘𑇓𑇆
𑆫𑆱𑆳𑆬𑆳 𑆧𑆸𑆁𑆲𑆟𑆵 𑆧𑆬𑇀𑆪𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆮𑆸𑆰𑇀𑆪𑆳 𑆖 𑆫𑆾𑆖𑆤𑆵 𑇅𑇓𑇘𑇔𑇅 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆓𑆶𑆝𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆢𑆣𑇀𑆪𑆤𑆴𑆬𑆳𑆥𑆲𑆩𑇀 𑇆𑇓𑇘𑇔𑇆
𑆱𑆑𑇀𑆠𑆮𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑆨𑇀𑆪𑆑𑇀𑆠𑆳𑆂 𑆯𑆵𑆠𑆮𑆳𑆫𑆴𑆥𑆫𑆴𑆥𑇀𑆬𑆶𑆠𑆳𑆂 𑇅 𑆤𑆳𑆠𑆴𑆢𑇀𑆫𑆮𑆳 𑆤𑆳𑆠𑆴𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆳 𑆩𑆤𑇀𑆡 𑆅𑆠𑇀𑆪𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇆𑇓𑇘𑇕𑇆
𑆩𑆤𑇀𑆡𑆂 𑆱𑆢𑇀𑆪𑆾𑆧𑆬𑆑𑆫𑆂 𑆥𑆴𑆥𑆳𑆱𑆳𑆯𑇀𑆫𑆩𑆤𑆳𑆯𑆤𑆂 𑇅 𑆱𑆳𑆩𑇀𑆬𑆱𑇀𑆤𑆼𑆲𑆓𑆶𑆝𑆾 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆤𑆳𑆯𑆤𑆂 𑇆𑇓𑇘𑇖𑇆
𑆯𑆫𑇀𑆑𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑆣𑆷𑆢𑆑𑆪𑆶𑆠𑆂 𑆑𑆦𑆫𑆾𑆓𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆂 𑇆𑇓𑇘𑇗𑇆
𑆮𑆫𑇀𑆓𑆠𑇀𑆫𑆪𑆼𑆟𑆾𑆥𑆲𑆴𑆠𑆾 𑆩𑆬𑆢𑆾𑆰𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆂 𑇅𑇓𑇘𑇘𑇅 𑆓𑆿𑆝𑆩𑆩𑇀𑆬𑆩𑆤𑆩𑇀𑆬𑆁 𑆮𑆳 𑆥𑆳𑆤𑆑𑆁 𑆓𑆶𑆫𑆶 𑆩𑆷𑆠𑇀𑆫𑆬𑆩𑇀 𑇆𑇓𑇘𑇘𑇆
𑆠𑆢𑆼𑆮 𑆒𑆟𑇀𑆝𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑆲𑆴𑆠𑆁 𑆥𑆶𑆤𑆂 𑇅 𑆱𑆳𑆩𑇀𑆬𑆁 𑆱𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆲𑆴𑆩𑆁 𑆥𑆳𑆤𑆑𑆁 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆫𑆠𑇀𑆪𑆪𑆩𑇀 𑇆𑇓𑇘𑇙𑇆
𑆩𑆳𑆫𑇀𑆢𑇀𑆮𑆵𑆑𑆁 𑆠𑆶 𑆯𑇀𑆫𑆩𑆲𑆫𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆳𑆲𑆠𑆸𑆰𑆳𑆥𑆲𑆩𑇀 𑇅 𑆥𑆫𑆷𑆰𑆑𑆳𑆟𑆳𑆁 𑆑𑆾𑆬𑆳𑆤𑆳𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆥𑆳𑆤𑆑𑆩𑇀 𑇆𑇓𑇙𑇐𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆠𑆂 𑇅 𑆥𑆳𑆤𑆑𑆳𑆤𑆳𑆁 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇓𑇙𑇑𑇆
𑆅𑆠𑆴 𑆑𑆸𑆠𑆳𑆤𑇀𑆤𑆮𑆫𑇀𑆓𑆂 𑇅 𑆃𑆡 𑆨𑆑𑇀𑆰𑇀𑆪𑆮𑆫𑇀𑆓𑆂 𑇅 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆠𑆂 𑆥𑆫𑆁 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀 𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆠𑆂 𑇅𑇓𑇙𑇒𑇅 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆑𑆸𑆠𑆳 𑆧𑆬𑇀𑆪𑆳 𑆮𑆸𑆰𑇀𑆪𑆳 𑆲𑆸𑆢𑇀𑆪𑆳𑆂 𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆤𑆂 𑇆𑇓𑇙𑇒𑇆
𑆃𑆢𑆳𑆲𑆴𑆤𑆂 𑆥𑆶𑆰𑇀𑆛𑆴𑆑𑆫𑆳 𑆢𑆵𑆥𑆤𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆤𑆳𑆂 𑇅𑇓𑇙𑇓𑇅 𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆑𑆫𑆳 𑆲𑆸𑆢𑇀𑆪𑆳 𑆔𑆸𑆠𑆥𑆷𑆫𑆳𑆂 𑆑𑆦𑆳𑆮𑆲𑆳𑆂 𑇆𑇓𑇙𑇓𑇆

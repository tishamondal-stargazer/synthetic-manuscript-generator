𑆠𑆤𑆶𑆤𑆳 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆼𑆟 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆳𑆁 𑆫𑆱𑆼𑆤 𑆮𑆳𑇅 𑆃𑆤𑇀𑆤𑆑𑆳𑆬𑆼𑆰𑆶 𑆖𑆳𑆥𑇀𑆪𑆱𑇀𑆩𑆽 𑆮𑆴𑆣𑆼𑆪𑆁 𑆢𑆤𑇀𑆠𑆣𑆳𑆮𑆤𑆩𑇀𑇆𑇑𑇕𑇗𑇆
𑆪𑆾𑇁𑆱𑇀𑆪 𑆮𑆑𑇀𑆠𑇀𑆫𑆫𑆱𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆥𑇀𑆫𑆴𑆪𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆠𑆢𑆱𑇀𑆪 𑆩𑆶𑆒𑆮𑆽𑆯𑆢𑇀𑆪𑆁 𑆥𑇀𑆫𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆁 𑆖𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆪𑆾𑆂𑇆𑇑𑇕𑇘𑇆
𑆣𑆠𑇀𑆠𑆼 𑆫𑆱𑆮𑆴𑆯𑆼𑆰𑆳𑆟𑆳𑆩𑆨𑆴𑆘𑇀𑆚𑆠𑇀𑆮𑆁 𑆑𑆫𑆾𑆠𑆴 𑆪𑆠𑇀𑇅 𑆮𑆴𑆯𑆾𑆣𑇀𑆪 𑆢𑇀𑆫𑆶𑆩𑆯𑆳𑆒𑆳𑆓𑇀𑆫𑆽𑆫𑆳𑆱𑇀𑆪𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆖𑆳𑆱𑆑𑆸𑆠𑇀𑇆𑇑𑇕𑇙𑇆
𑆩𑆱𑇀𑆠𑇀𑆮𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆪𑆡𑆳𑆲𑆳𑆫𑆩𑆮𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑇅𑇑𑇖𑇐𑇅 𑆥𑆳𑆖𑆤𑆁 𑆯𑆩𑆤𑆵𑆪𑆁 𑆮𑆳 𑆑𑆰𑆳𑆪𑆁 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇖𑇐𑇆
𑆘𑇀𑆮𑆫𑆴𑆠𑆁 𑆰𑆝𑆲𑆼𑇁𑆠𑆵𑆠𑆼 𑆬𑆔𑇀𑆮𑆤𑇀𑆤𑆥𑇀𑆫𑆠𑆴𑆨𑆾𑆘𑆴𑆠𑆩𑇀𑇅𑇑𑇖𑇑𑇅 𑆱𑇀𑆠𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑆤 𑆮𑆴𑆥𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆩𑇀𑇆𑇑𑇖𑇑𑇆
𑆢𑆾𑆰𑆳 𑆧𑆢𑇀𑆣𑆳𑆂 𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑇀𑆠𑆩𑇀𑆨𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆫𑆶𑆟𑆼 𑆘𑇀𑆮𑆫𑆼𑇅 𑆤 𑆠𑆶 𑆑𑆬𑇀𑆥𑆤𑆩𑆶𑆢𑇀𑆢𑆴𑆯𑇀𑆪 𑆑𑆰𑆳𑆪𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆣𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇒𑇆
𑆪𑆂 𑆑𑆰𑆳𑆪𑆑𑆰𑆳𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱 𑆮𑆫𑇀𑆘𑇀𑆪𑆱𑇀𑆠𑆫𑆶𑆟𑆘𑇀𑆮𑆫𑆼𑇅𑇑𑇖𑇓𑇅 𑆪𑆷𑆰𑆽𑆫𑆩𑇀𑆬𑆽𑆫𑆤𑆩𑇀𑆬𑆽𑆫𑇀𑆮𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆫𑇀𑆮𑆳 𑆫𑆱𑆽𑆫𑇀𑆲𑆴𑆠𑆽𑆂𑇆𑇑𑇖𑇓𑇆
𑆢𑆯𑆳𑆲𑆁 𑆪𑆳𑆮𑆢𑆯𑇀𑆤𑆵𑆪𑆳𑆬𑇀𑆬𑆔𑇀𑆮𑆤𑇀𑆤𑆁 𑆘𑇀𑆮𑆫𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇅𑇑𑇖𑇔𑇅 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆑𑆦𑆼 𑆩𑆤𑇀𑆢𑆼 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆘𑇀𑆮𑆫𑆼𑇆𑇑𑇖𑇔𑇆
𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆼𑆰𑆶 𑆢𑆾𑆰𑆼𑆰𑆶 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆥𑆳𑆤𑆁 𑆪𑆡𑆳𑇁𑆩𑆸𑆠𑆩𑇀𑇅𑇑𑇖𑇕𑇅 𑆤𑆴𑆫𑇀𑆢𑆯𑆳𑆲𑆩𑆥𑆴 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆩𑆬𑆕𑇀𑆔𑆴𑆠𑆩𑇀𑇆𑇑𑇖𑇕𑇆
𑆤 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆂 𑆑𑆰𑆳𑆪𑆽𑆱𑇀𑆠𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆪𑆳𑆮𑆬𑇀𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆢𑆯𑆤𑆁 𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆁𑆱𑆫𑆱𑆼𑆤 𑆖𑇆𑇑𑇖𑇖𑇆
𑆧𑆬𑆁 𑆲𑇀𑆪𑆬𑆁 𑆤𑆴𑆓𑇀𑆫𑆲𑆳𑆪 𑆢𑆾𑆰𑆳𑆟𑆳𑆁, 𑆧𑆬𑆑𑆸𑆖𑇀𑆖 𑆠𑆠𑇀 𑇅𑇑𑇖𑇗𑇅 𑆢𑆳𑆲𑆠𑆸𑆰𑇀𑆟𑆳𑆥𑆫𑆵𑆠𑆱𑇀𑆪 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆘𑇀𑆮𑆫𑆩𑇀𑇆𑇑𑇖𑇗𑇆
𑆧𑆢𑇀𑆣𑆥𑇀𑆫𑆖𑇀𑆪𑆶𑆠𑆢𑆾𑆰𑆁 𑆮𑆳 𑆤𑆴𑆫𑆳𑆩𑆁 𑆥𑆪𑆱𑆳 𑆘𑆪𑆼𑆠𑇀𑇅𑇑𑇖𑇘𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆴𑆫𑆳𑆨𑆴𑆂 𑆥𑇀𑆫𑆯𑆩𑆁 𑆤 𑆥𑇀𑆫𑆪𑆳𑆠𑆴 𑆪𑆢𑆳 𑆘𑇀𑆮𑆫𑆂𑇆𑇑𑇖𑇘𑇆
𑆃𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆳𑆓𑇀𑆤𑆼𑆂 𑆯𑆩𑆪𑆼𑆠𑇀𑆠𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂𑇅𑇑𑇖𑇙𑇅 𑆘𑇀𑆮𑆫𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆤 𑆲𑆴𑆠𑆁 𑆮𑆩𑆤𑆁 𑆤 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇑𑇖𑇙𑇆
𑆑𑆳𑆩𑆁 𑆠𑆶 𑆥𑆪𑆱𑆳 𑆠𑆱𑇀𑆪 𑆤𑆴𑆫𑆷𑆲𑆽𑆫𑇀𑆮𑆳 𑆲𑆫𑆼𑆤𑇀𑆩𑆬𑆳𑆤𑇀𑇅 𑆤𑆴𑆫𑆷𑆲𑆾 𑆧𑆬𑆩𑆓𑇀𑆤𑆴𑆁 𑆖 𑆮𑆴𑆘𑇀𑆮𑆫𑆠𑇀𑆮𑆁 𑆩𑆶𑆢𑆁 𑆫𑆶𑆖𑆴𑆩𑇀𑇆𑇑𑇗𑇐𑇆
𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆼𑆰𑆶 𑆢𑆾𑆰𑆼𑆰𑆶 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑆯𑆵𑆔𑇀𑆫𑆩𑆳𑆮𑆲𑆼𑆠𑇀𑇅𑇑𑇗𑇑𑇅 𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳 𑆥𑆴𑆠𑇀𑆠𑆳𑆯𑆪𑆓𑆠𑆁 𑆲𑆫𑆼𑆠𑇀𑇆𑇑𑇗𑇑𑇆
𑆱𑇀𑆫𑆁𑆱𑆤𑆁 𑆠𑇀𑆫𑆵𑆤𑇀𑆩𑆬𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑇀𑇅𑇑𑇗𑇒𑇅 𑆘𑇀𑆮𑆫𑆼 𑆥𑆶𑆫𑆳𑆟𑆼 𑆱𑆕𑇀𑆑𑇀𑆰𑆵𑆟𑆼 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆼 𑆢𑆸𑆞𑆳𑆓𑇀𑆤𑆪𑆼𑇆𑇑𑇗𑇒𑇆
𑆫𑆷𑆑𑇀𑆰𑆧𑆢𑇀𑆣𑆥𑆶𑆫𑆵𑆰𑆳𑆪 𑆥𑇀𑆫𑆢𑆢𑇀𑆪𑆳𑆢𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇅𑇑𑇗𑇓𑇅 𑆓𑆿𑆫𑆮𑆼 𑆯𑆴𑆫𑆱𑆂 𑆯𑆷𑆬𑆼 𑆮𑆴𑆧𑆢𑇀𑆣𑆼𑆰𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆰𑆶 𑆖𑇆𑇑𑇗𑇓𑇆
𑆘𑆵𑆫𑇀𑆟𑆘𑇀𑆮𑆫𑆼 𑆫𑆶𑆖𑆴𑆑𑆫𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆩𑆷𑆫𑇀𑆣𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅𑇑𑇗𑇔𑇅 𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆤𑆼𑇆𑇑𑇗𑇔𑇆

𑆒𑆫𑇀𑆘𑆷𑆫𑆁 𑆠𑆳𑆬𑆯𑆱𑇀𑆪𑆁 𑆖 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑇀𑆰𑆪𑆳𑆥𑆲𑆩𑇀𑇅 𑆠𑆫𑆷𑆛𑆧𑆴𑆱𑆯𑆳𑆬𑆷𑆑𑆑𑇀𑆫𑆿𑆚𑇀𑆖𑆳𑆢𑆤𑆑𑆯𑆼𑆫𑆶𑆑𑆩𑇀𑇆𑇑𑇑𑇖𑇆
𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆕𑇀𑆑𑆬𑆾𑆝𑇀𑆪𑆁 𑆖 𑆓𑆶𑆫𑆶 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆑𑆶𑆩𑆶𑆢𑆾𑆠𑇀𑆥𑆬𑆤𑆳𑆬𑆳𑆱𑇀𑆠𑆶 𑆱𑆥𑆶𑆰𑇀𑆥𑆳𑆂 𑆱𑆦𑆬𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇑𑇑𑇗𑇆
𑆯𑆵𑆠𑆳𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑆶 𑆑𑆦𑆩𑆳𑆫𑆶𑆠𑆑𑆾𑆥𑆤𑆳𑆂𑇅 𑆑𑆰𑆳𑆪𑆩𑆵𑆰𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇑𑇘𑇆
𑆥𑆿𑆰𑇀𑆑𑆫𑆁 𑆠𑆶 𑆨𑆮𑆼𑆢𑇀𑆧𑆵𑆘𑆁 𑆩𑆣𑆶𑆫𑆁 𑆫𑆱𑆥𑆳𑆑𑆪𑆾𑆂𑇅 𑆧𑆬𑇀𑆪𑆂 𑆯𑆵𑆠𑆾 𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆾 𑆧𑆸𑆁𑆲𑆟𑆳𑆠𑇀𑆩𑆑𑆂𑇆𑇑𑇑𑇙𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆮𑆸𑆰𑇀𑆪𑆾 𑆩𑆶𑆚𑇀𑆘𑆳𑆠𑆑𑆂 𑆥𑆫𑆩𑇀𑇅 𑆘𑆵𑆮𑆤𑆾 𑆧𑆸𑆁𑆲𑆟𑆾 𑆮𑆸𑆰𑇀𑆪𑆂 𑆑𑆟𑇀𑆜𑇀𑆪𑆂 𑆯𑆱𑇀𑆠𑆾 𑆫𑆱𑆳𑆪𑆤𑆼𑇆𑇑𑇒𑇐𑇆
𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆤𑇀𑆢𑆾 𑆧𑆬𑇀𑆪𑆯𑇀𑆖 𑆩𑆷𑆠𑇀𑆫𑆬𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆯𑆵𑆠𑆬𑆂𑇅 𑆃𑆩𑇀𑆬𑆴𑆑𑆳𑆪𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑆑𑆤𑇀𑆢𑆾 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆾𑆲𑆴𑆠𑆾 𑆬𑆔𑆶𑆂𑇆𑇑𑇒𑇑𑇆
𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆂 𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆾 𑆓𑇀𑆫𑆳𑆲𑆵 𑆯𑆱𑇀𑆠𑆾 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆼𑇅 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆁 𑆧𑆢𑇀𑆣𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆳𑆫𑇀𑆰𑆥𑆁 𑆯𑆳𑆑𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇒𑇆
(𑆠𑆢𑇀𑆮𑆠𑇀 𑆱𑇀𑆪𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆤𑆳𑆬𑆱𑇀𑆪 𑆫𑆷𑆑𑇀𑆰𑆩𑆩𑇀𑆬𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇅) 𑆠𑆢𑇀𑆮𑆠𑇀 𑆥𑆴𑆟𑇀𑆝𑆳𑆬𑆶𑆑𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆤𑇀𑆢𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆩𑆶𑆒𑆥𑇀𑆫𑆴𑆪𑆩𑇀𑇅 𑆱𑆫𑇀𑆥𑆖𑇀𑆗𑆠𑇀𑆫𑆑𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆧𑆲𑇀𑆮𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆳𑆯𑇀𑆗𑆠𑇀𑆫𑆘𑆳𑆠𑆪𑆂𑇆𑇑𑇒𑇓𑇆
𑆯𑆵𑆠𑆳𑆂 𑆥𑆵𑆤𑆱𑆑𑆫𑇀𑆠𑇀𑆫𑇀𑆪𑆯𑇀𑆖 𑆩𑆣𑆶𑆫𑆳 𑆓𑆶𑆫𑇀𑆮𑇀𑆪 𑆍𑆮 𑆖𑇅 𑆖𑆠𑆶𑆫𑇀𑆡𑆂 𑆯𑆳𑆑𑆮𑆫𑇀𑆓𑆾𑇁𑆪𑆁 𑆥𑆠𑇀𑆫𑆑𑆤𑇀𑆢𑆦𑆬𑆳𑆯𑇀𑆫𑆪𑆂𑇆𑇑𑇒𑇔𑇆
𑆅𑆠𑆴 𑆯𑆳𑆑𑆮𑆫𑇀𑆓𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆂𑇅 𑆃𑆡 𑆦𑆬𑆮𑆫𑇀𑆓𑆂- 𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆪𑆳𑆤𑇀𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆁 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆁 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆩𑇀𑇆𑇑𑇒𑇕𑇆
𑆠𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆪𑆠𑆳𑆩𑆳𑆱𑇀𑆪𑆯𑆾𑆰𑆁 𑆑𑆳𑆱𑆁 𑆖𑆳𑆯𑆶 𑆮𑇀𑆪𑆥𑆾𑆲𑆠𑆴𑇅 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳 𑆧𑆸𑆁𑆲𑆟𑆵 𑆮𑆸𑆰𑇀𑆪𑆳 𑆩𑆣𑆶𑆫𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆬𑆳𑇆𑇑𑇒𑇖𑇆
𑆩𑆣𑆶𑆫𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆒𑆫𑇀𑆘𑆷𑆫𑆁 𑆓𑆶𑆫𑆶 𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆑𑇀𑆰𑆪𑆼𑇁𑆨𑆴𑆔𑆳𑆠𑆼 𑆢𑆳𑆲𑆼 𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆠𑆢𑇀𑆣𑆴𑆠𑆩𑇀𑇆𑇑𑇒𑇗𑇆
𑆠𑆫𑇀𑆥𑆟𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆦𑆬𑇀𑆓𑆶 𑆓𑆶𑆫𑆶 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆥𑆫𑆷𑆰𑆑𑆁 𑆩𑆣𑆷𑆑𑆁 𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇘𑇆
𑆩𑆣𑆶𑆫𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆧𑆬𑇀𑆪𑆩𑆳𑆩𑇀𑆫𑆳𑆠𑆁 𑆠𑆫𑇀𑆥𑆟𑆁 𑆓𑆶𑆫𑆶𑇅 𑆱𑆱𑇀𑆤𑆼𑆲𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆁 𑆯𑆵𑆠𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆮𑆴𑆰𑇀𑆛𑆨𑇀𑆪 𑆘𑆵𑆫𑇀𑆪𑆠𑆴𑇆𑇑𑇒𑇙𑇆
𑆠𑆳𑆬𑆯𑆱𑇀𑆪𑆳𑆤𑆴 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆴 𑆤𑆳𑆫𑆴𑆑𑆼𑆬𑆦𑆬𑆳𑆤𑆴 𑆖𑇅 𑆧𑆸𑆁𑆲𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆳𑆤𑆴 𑆧𑆬𑇀𑆪𑆳𑆤𑆴 𑆩𑆣𑆶𑆫𑆳𑆟𑆴 𑆖𑇆𑇑𑇓𑇐𑇆
𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆁 𑆖 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆓𑆶𑆫𑆶 𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆫𑆁 𑆨𑆮𑇀𑆪𑆁 𑆓𑇀𑆫𑆳𑆲𑆴 𑆮𑆑𑇀𑆫𑆮𑆴𑆯𑆾𑆣𑆤𑆩𑇀𑇆𑇑𑇓𑇑𑇆
𑆃𑆩𑇀𑆬𑆁 𑆥𑆫𑆷𑆰𑆑𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳 𑆧𑆢𑆫𑆳𑆟𑇀𑆪𑆳𑆫𑆶𑆑𑆳𑆟𑆴 𑆖𑇅 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆾𑆥𑆵𑆟𑆴 𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆤𑆴𑆑𑆶𑆖𑆳𑆤𑇀𑆪𑆥𑆴𑇆𑇑𑇓𑇒𑇆
𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆓𑆶𑆫𑆶 𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆁 𑆱𑇀𑆮𑆳𑆢𑆶𑆥𑇀𑆫𑆳𑆪𑆁 𑆩𑆶𑆒𑆥𑇀𑆫𑆴𑆪𑆩𑇀𑇅 𑆧𑆸𑆁𑆲𑆟𑆁 𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆤𑆳𑆠𑆴𑆢𑆾𑆰𑆬𑆩𑆳𑆫𑆶𑆑𑆩𑇀𑇆𑇑𑇓𑇓𑇆
𑆨𑆮𑇀𑆪𑆳𑆢𑆬𑇀𑆥𑆳𑆤𑇀𑆠𑆫𑆓𑆶𑆟𑆁 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆦𑆬𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆠𑆡𑆽𑆮𑆳𑆬𑇀𑆥𑆳𑆤𑇀𑆠𑆫𑆓𑆶𑆟𑆁 𑆠𑆷𑆢𑆩𑆩𑇀𑆬𑆁 𑆥𑆫𑆷𑆰𑆑𑆳𑆠𑇀𑇆𑇑𑇓𑇕𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆁 𑆛𑆕𑇀𑆑𑆁 𑆮𑆳𑆠𑆬𑆁 𑆓𑆶𑆫𑆶 𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆑𑆥𑆴𑆠𑇀𑆡𑆩𑆳𑆩𑆁 𑆑𑆟𑇀𑆜𑆔𑇀𑆤𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆁 𑆓𑇀𑆫𑆳𑆲𑆴 𑆮𑆳𑆠𑆬𑆩𑇀 𑇆𑇑𑇓𑇖𑇆
𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆳𑆖𑇀𑆖 𑆫𑆶𑆖𑆴𑆥𑇀𑆫𑆢𑆩𑇀𑇅 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆁 𑆖 𑆢𑆾𑆰𑆔𑇀𑆤𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆁 𑆓𑇀𑆫𑆳𑆲𑆴 𑆓𑆶𑆫𑇀𑆮𑆥𑆴𑇆𑇑𑇓𑇗𑇆
𑆧𑆴𑆬𑇀𑆮𑆁 𑆠𑆶 𑆢𑆶𑆫𑇀𑆘𑆫𑆁 𑆥𑆑𑇀𑆮𑆁 𑆢𑆾𑆰𑆬𑆁 𑆥𑆷𑆠𑆴𑆩𑆳𑆫𑆶𑆠𑆩𑇀𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆠𑆢𑇀𑆧𑆳𑆬𑆁 𑆢𑆵𑆥𑆤𑆁 𑆑𑆦𑆮𑆳𑆠𑆘𑆴𑆠𑇀𑇆𑇑𑇓𑇘𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆁 𑆧𑆳𑆬𑆩𑆳𑆥𑆷𑆫𑇀𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇅 𑆥𑆑𑇀𑆮𑆩𑆳𑆩𑇀𑆫𑆁 𑆘𑆪𑆼𑆢𑇀𑆮𑆳𑆪𑆶𑆁 𑆩𑆳𑆁𑆱𑆯𑆶𑆑𑇀𑆫𑆧𑆬𑆥𑇀𑆫𑆢𑆩𑇀𑇆𑇑𑇓𑇙𑇆

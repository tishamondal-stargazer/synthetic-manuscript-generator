𑆩𑆤𑇀𑆢𑆳𑆱𑇀𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆧𑆬𑆳𑆂 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳 𑆢𑆾𑆰𑆳𑆂 𑆱𑆶𑆠𑆵𑆮𑇀𑆫𑆁 𑆠𑆤𑆶𑆫𑆑𑇀𑆠𑆥𑆳𑆑𑆩𑇀𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆯𑆾𑆡𑆁 𑆘𑇀𑆮𑆫𑆠𑆫𑇀𑆰𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆱𑆫𑇀𑆥𑆟𑆁 𑆘𑆳𑆬𑆑𑆓𑆫𑇀𑆢𑆨𑆳𑆒𑇀𑆪𑆩𑇀𑇆𑇙𑇙𑇆
𑆮𑆴𑆬𑆕𑇀𑆔𑆤𑆁 𑆫𑆑𑇀𑆠𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆟𑆁 𑆖 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆁 𑆑𑆳𑆪𑆮𑆴𑆯𑆾𑆣𑆤𑆁 𑆖𑇅 𑆣𑆳𑆠𑇀𑆫𑆵𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆚𑇀 𑆯𑆴𑆯𑆴𑆫𑆳𑆤𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑆢𑆳 𑆘𑆳𑆬𑆑𑆓𑆫𑇀𑆢𑆨𑆱𑇀𑆪𑇆𑇑𑇐𑇐𑇆
𑆍𑆮𑆁𑆮𑆴𑆣𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆥𑆫𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆯𑆾𑆡𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑆤𑆴𑆬𑆳𑆢𑆴𑆬𑆴𑆕𑇀𑆓𑆽𑆂𑇅 𑆯𑆳𑆤𑇀𑆠𑆴𑆁 𑆤𑆪𑆼𑆢𑇀𑆢𑆾𑆰𑆲𑆫𑆽𑆫𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆳𑆬𑆼𑆥𑆤𑆖𑇀𑆗𑆼𑆢𑆤𑆨𑆼𑆢𑆢𑆳𑆲𑆽𑆂𑇆𑇑𑇐𑇑𑇆
𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆨𑆴𑆔𑆳𑆠𑆳𑆢𑆤𑆴𑆬𑆂 𑆱𑆫𑆑𑇀𑆠𑆂 𑆯𑆾𑆡𑆁 𑆱𑆫𑆳𑆓𑆁 𑆥𑇀𑆫𑆑𑆫𑆾𑆠𑆴 𑆠𑆠𑇀𑆫𑇅 𑆮𑆵𑆱𑆫𑇀𑆥𑆤𑆶𑆤𑇀𑆩𑆳𑆫𑆶𑆠𑆫𑆑𑇀𑆠𑆤𑆶𑆖𑇀𑆖 𑆑𑆳𑆫𑇀𑆪𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆁 𑆮𑆴𑆰𑆘𑆼 𑆖 𑆑𑆫𑇀𑆩𑇆𑇑𑇐𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆱𑇀𑆪 𑆢𑆾𑆰𑆨𑆼𑆢𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆳𑆫𑇀𑆣𑆳𑆮𑆪𑆮𑆓𑆳𑆠𑇀𑆫𑆨𑆼𑆢𑆳𑆖𑇀𑆖𑇅 𑆯𑇀𑆮𑆪𑆡𑆾𑆫𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆱𑇀𑆪 𑆠𑆡𑆳 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆖𑆾𑆑𑇀𑆠𑆩𑇀𑇆𑇑𑇐𑇓𑇆
𑆃𑆡𑆳𑆠 𑆇𑆢𑆫𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆱𑆴𑆢𑇀𑆣𑆮𑆴𑆢𑇀𑆪𑆳𑆣𑆫𑆳𑆑𑆵𑆫𑇀𑆟𑆼 𑆑𑆽𑆬𑆳𑆱𑆼 𑆤𑆤𑇀𑆢𑆤𑆾𑆥𑆩𑆼𑇅 𑆠𑆥𑇀𑆪𑆩𑆳𑆤𑆁 𑆠𑆥𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆁 𑆱𑆳𑆑𑇀𑆰𑆳𑆢𑇀𑆣𑆫𑇀𑆩𑆩𑆴𑆮 𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇓𑇆
𑆄𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆮𑆴𑆢𑆳𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆨𑆴𑆰𑆓𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆑𑆩𑇀𑇅 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆁 𑆘𑆴𑆠𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆾𑇁𑆧𑇀𑆫𑆮𑆵𑆢𑇀𑆮𑆖𑆂𑇆𑇔𑇆
𑆨𑆓𑆮𑆤𑇀𑆤𑆶𑆢𑆫𑆽𑆫𑇀𑆢𑆶𑆂𑆒𑆽𑆫𑇀𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆲𑇀𑆪𑆫𑇀𑆢𑆴𑆠𑆳 𑆤𑆫𑆳𑆂𑇅 𑆯𑆶𑆰𑇀𑆑𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆂 𑆑𑆸𑆯𑆽𑆫𑇀𑆓𑆳𑆠𑇀𑆫𑆽𑆫𑆳𑆣𑇀𑆩𑆳𑆠𑆾𑆢𑆫𑆑𑆶𑆑𑇀𑆰𑆪𑆂𑇆𑇕𑇆
𑆥𑇀𑆫𑆤𑆰𑇀𑆛𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆲𑆳𑆫𑆳𑆂 𑆱𑆫𑇀𑆮𑆖𑆼𑆰𑇀𑆛𑆳𑆱𑇀𑆮𑆤𑆵𑆯𑇀𑆮𑆫𑆳𑆂𑇅 𑆢𑆵𑆤𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆳𑆮𑆳𑆘𑇀𑆘𑆲𑆠𑆾𑇁𑆱𑆷𑆤𑆤𑆳𑆡𑆮𑆠𑇀𑇆𑇖𑇆
𑆠𑆼𑆰𑆳𑆩𑆳𑆪𑆠𑆤𑆁 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆫𑆷𑆥𑆳𑆑𑆸𑆠𑆴𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆪𑆡𑆳𑆮𑆖𑇀𑆗𑇀𑆫𑆾𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆳𑆩𑆴 𑆓𑆶𑆫𑆶𑆟𑆳 𑆱𑆩𑇀𑆪𑆓𑆵𑆫𑆴𑆠𑆩𑇀𑇆𑇗𑇆
𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆲𑆴𑆠𑆳𑆪𑆫𑇀𑆰𑆴𑆂 𑆯𑆴𑆰𑇀𑆪𑆼𑆟𑆽𑆮𑆁 𑆥𑇀𑆫𑆖𑆾𑆢𑆴𑆠𑆂𑇅 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆲𑆴𑆠𑆁 𑆮𑆳𑆑𑇀𑆪𑆁 𑆮𑇀𑆪𑆳𑆲𑆫𑇀𑆠𑆶𑆩𑆶𑆥𑆖𑆑𑇀𑆫𑆩𑆼𑇆𑇘𑇆
𑆃𑆓𑇀𑆤𑆴𑆢𑆾𑆰𑆳𑆤𑇀𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆫𑆾𑆓𑆱𑆕𑇀𑆔𑆳𑆂 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆂𑇅 𑆩𑆬𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆾𑆢𑆫𑆳𑆟𑆴 𑆠𑆶𑇆𑇙𑇆
𑆩𑆤𑇀𑆢𑆼𑇁𑆓𑇀𑆤𑆿 𑆩𑆬𑆴𑆤𑆽𑆫𑇀𑆨𑆶𑆑𑇀𑆠𑆽𑆫𑆥𑆳𑆑𑆳𑆢𑇀𑆢𑆾𑆰𑆱𑆚𑇀𑆖𑆪𑆂𑇅 𑆥𑇀𑆫𑆳𑆟𑆳𑆓𑇀𑆤𑇀𑆪𑆥𑆳𑆤𑆳𑆤𑇀 𑆱𑆤𑇀𑆢𑆷𑆰𑇀𑆪 𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑇀𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳𑇁𑆣𑆫𑆾𑆠𑇀𑆠𑆫𑆳𑆤𑇀𑇆𑇑𑇐𑇆
𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆠𑆫𑆩𑆳𑆓𑆩𑇀𑆪 𑆑𑆶𑆑𑇀𑆰𑆴𑆩𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆤𑇀 𑆨𑆸𑆯𑆩𑇀𑇅 𑆘𑆤𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆱𑇀𑆪 𑆲𑆼𑆠𑆶𑆁 𑆯𑆸𑆟𑆶 𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇑𑇆
𑆃𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆬𑆮𑆟𑆑𑇀𑆰𑆳𑆫𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆩𑇀𑆬𑆓𑆫𑆳𑆯𑆤𑆳𑆠𑇀𑇅 𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑆁𑆱𑆫𑇀𑆘𑆤𑆳𑆢𑇀𑆫𑆷𑆑𑇀𑆰𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆯𑆶𑆖𑆴𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇆𑇑𑇒𑇆
𑆥𑇀𑆬𑆵𑆲𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆑𑆫𑇀𑆯𑆤𑆳𑆠𑇀 𑆑𑆫𑇀𑆩𑆮𑆴𑆨𑇀𑆫𑆩𑆳𑆠𑇀𑇅 𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆳𑆤𑆳𑆩𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆳𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆟𑆳𑆠𑇀𑇆𑇑𑇓𑇆
𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆢𑆷𑆰𑆟𑆳𑆢𑆳𑆩𑆳𑆠𑇀 𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆳𑆢𑆠𑆴𑆥𑆷𑆫𑆟𑆳𑆠𑇀𑇅 𑆃𑆫𑇀𑆯𑆾𑆧𑆳𑆬𑆯𑆑𑆸𑆢𑇀𑆫𑆾𑆣𑆳𑆢𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆦𑆶𑆛𑆤𑆨𑆼𑆢𑆤𑆳𑆠𑇀𑇆𑇑𑇔𑇆
𑆃𑆠𑆴𑆱𑆚𑇀𑆖𑆴𑆠𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆥𑆳𑆥𑆁 𑆑𑆫𑇀𑆩 𑆖 𑆑𑆶𑆫𑇀𑆮𑆠𑆳𑆩𑇀𑇅 𑆇𑆢𑆫𑆳𑆟𑇀𑆪𑆶𑆥𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆵𑆤𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇆𑇑𑇕𑇆
𑆑𑇀𑆰𑆶𑆤𑇀𑆤𑆳𑆯𑆂 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆁 𑆥𑆖𑇀𑆪𑆠𑆼 𑆖𑆴𑆫𑆳𑆠𑇀𑇅 𑆨𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑆱𑆫𑇀𑆮𑆁 𑆘𑆵𑆫𑇀𑆟𑆳𑆘𑆵𑆫𑇀𑆟𑆁 𑆤 𑆮𑆼𑆠𑇀𑆠𑆴 𑆖𑇆𑇑𑇖𑇆
𑆱𑆲𑆠𑆼 𑆤𑆳𑆠𑆴𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆩𑆵𑆰𑆖𑇀𑆗𑆾𑆦𑆯𑇀𑆖 𑆥𑆳𑆢𑆪𑆾𑆂𑇅 𑆯𑆯𑇀𑆮𑆢𑇀𑆧𑆬𑆑𑇀𑆰𑆪𑆾𑇁𑆬𑇀𑆥𑆼𑇁𑆥𑆴 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆼 𑆯𑇀𑆮𑆳𑆱𑆩𑆸𑆖𑇀𑆗𑆠𑆴𑇆𑇑𑇗𑇆
𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆥𑆶𑆫𑆵𑆰𑆤𑆴𑆖𑆪𑆾 𑆫𑆷𑆑𑇀𑆰𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆲𑆼𑆠𑆶𑆑𑆳𑇅 𑆧𑆱𑇀𑆠𑆴𑆱𑆤𑇀𑆣𑆿 𑆫𑆶𑆓𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆮𑆫𑇀𑆣𑆠𑆼 𑆥𑆳𑆛𑇀𑆪𑆠𑆼𑇁𑆥𑆴 𑆖𑇆𑇑𑇘𑇆
𑆄𑆠𑆤𑇀𑆪𑆠𑆼 𑆖 𑆘𑆜𑆫𑆩𑆥𑆴 𑆬𑆔𑇀𑆮𑆬𑇀𑆥𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇅 𑆫𑆳𑆘𑆵𑆘𑆤𑇀𑆩 𑆮𑆬𑆵𑆤𑆳𑆯 𑆅𑆠𑆴 𑆬𑆴𑆕𑇀𑆓𑆁 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆳𑆩𑇀𑇆𑇑𑇙𑇆
𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑇀𑆮𑆼𑆢𑆳𑆩𑇀𑆧𑆶𑆮𑆳𑆲𑆵𑆤𑆴 𑆢𑆾𑆰𑆳𑆂 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆱𑆚𑇀𑆖𑆴𑆠𑆳𑆂𑇅 𑆥𑇀𑆫𑆳𑆟𑆳𑆓𑇀𑆤𑇀𑆪𑆥𑆳𑆤𑆳𑆤𑇀 𑆱𑆤𑇀𑆢𑆷𑆰𑇀𑆪 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇒𑇐𑇆
𑆑𑆶𑆑𑇀𑆰𑆼𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆩𑆳𑆛𑆾𑆥𑆂 𑆯𑆾𑆦𑆂 𑆥𑆳𑆢𑆑𑆫𑆱𑇀𑆪 𑆖𑇅 𑆩𑆤𑇀𑆢𑆾𑇁𑆓𑇀𑆤𑆴𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆓𑆟𑇀𑆝𑆠𑇀𑆮𑆁 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆁 𑆖𑆾𑆢𑆫𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇒𑇑𑇆
𑆥𑆸𑆡𑆓𑇀𑆢𑆾𑆰𑆽𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆥𑇀𑆬𑆵𑆲𑆧𑆢𑇀𑆣𑆑𑇀𑆰𑆠𑆾𑆢𑆑𑆽𑆂𑇅 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆳𑆟𑇀𑆪𑆰𑇀𑆛𑆿 𑆠𑆼𑆰𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑆸𑆡𑆑𑇀 𑆯𑆸𑆟𑆶𑇆𑇒𑇒𑇆
𑆫𑆷𑆑𑇀𑆰𑆳𑆬𑇀𑆥𑆨𑆾𑆘𑆤𑆳𑆪𑆳𑆱𑆮𑆼𑆓𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆑𑆫𑇀𑆯𑆤𑆽𑆂𑇅 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆑𑆶𑆑𑇀𑆰𑆴𑆲𑆸𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆢𑆩𑆳𑆫𑇀𑆓𑆓𑆂𑇆𑇒𑇓𑇆
𑆲𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆁 𑆑𑆦𑆩𑆶𑆢𑇀𑆣𑆷𑆪 𑆠𑆼𑆤 𑆫𑆷𑆢𑇀𑆣𑆓𑆠𑆴𑆱𑇀𑆠𑆠𑆂𑇅 𑆄𑆖𑆴𑆤𑆾𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆘𑆤𑇀𑆠𑆾𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆠𑆫𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆂𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆑𑆶𑆑𑇀𑆰𑆴𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆮𑆸𑆰𑆟𑆯𑇀𑆮𑆪𑆡𑆶𑆂, 𑆇𑆢𑆫𑆮𑆴𑆥𑆳𑆛𑆤𑆩𑇀, 𑆃𑆤𑆴𑆪𑆠𑆿 𑆖 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆿, 𑆑𑆶𑆑𑇀𑆰𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆯𑆶𑆰𑇀𑆑𑆑𑆳𑆱𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆂, 𑆃𑆣𑆾𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁, 𑆮𑆳𑆠𑆮𑆫𑇀𑆖𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆂, 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆠𑇀𑆮𑆁 𑆖 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑆳𑆩𑇀, 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆁 𑆠𑆤𑇀𑆮𑆱𑆴𑆠𑆫𑆳𑆘𑆵𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆠𑆠𑆩𑇀, 𑆄𑆲𑆠𑆩𑆳𑆣𑇀𑆩𑆳𑆠𑆢𑆸𑆠𑆴𑆯𑆧𑇀𑆢𑆮𑆢𑇀𑆨𑆮𑆠𑆴, 𑆮𑆳𑆪𑆶𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆑𑇀 𑆖 𑆱𑆯𑆷𑆬𑆯𑆧𑇀𑆢𑆯𑇀𑆖𑆫𑆠𑆴, 𑆍𑆠𑆢𑇀𑆮𑆳𑆠𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇕𑇆
𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑇀𑆪𑆳𑆠𑆥𑆱𑆼𑆮𑆤𑆽𑆂𑇅 𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆣𑇀𑆪𑆯𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆽𑆯𑇀𑆖𑆳𑆯𑆶 𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆩𑆳𑆖𑆴𑆠𑆩𑇀𑇆𑇒𑇖𑇆
𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆤𑆴𑆬𑆑𑆦𑆿 𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆩𑆳𑆫𑇀𑆓𑆩𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇅 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆼 𑆮𑆲𑇀𑆤𑆴𑆁 𑆘𑆤𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆠𑆂𑇆𑇒𑇗𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆠𑆵𑆱𑆳𑆫𑆨𑇀𑆫𑆩𑆳𑆂, 𑆑𑆛𑆶𑆑𑆳𑆱𑇀𑆪𑆠𑇀𑆮𑆁, 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆠𑇀𑆮𑆁 𑆖 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑆳𑆩𑇀, 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆁 𑆤𑆵𑆬𑆥𑆵𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆲𑆫𑆴𑆠𑆠𑆳𑆩𑇀𑆫𑆫𑆳𑆘𑆵𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆁, 𑆢𑆲𑇀𑆪𑆠𑆼, 𑆢𑆷𑆪𑆠𑆼, 𑆣𑆷𑆥𑇀𑆪𑆠𑆼, 𑆈𑆰𑇀𑆩𑆳𑆪𑆠𑆼, 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆼, 𑆑𑇀𑆬𑆴𑆢𑇀𑆪𑆠𑆼, 𑆩𑆸𑆢𑆶𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆥𑆳𑆑𑆁 𑆖 𑆨𑆮𑆠𑆴; 𑆍𑆠𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇘𑇆
𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆼𑆤 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆳𑆮𑆸𑆠𑆼𑆰𑇀𑆮𑆳𑆮𑆸𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇅 𑆠𑆩𑆼𑆮 𑆥𑆵𑆝𑆪𑆤𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆶𑆢𑆫𑆁 𑆧𑆲𑆴𑆫𑆤𑇀𑆠𑇀𑆫𑆓𑆂 𑇆𑇓𑇐𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆓𑆿𑆫𑆮𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆳𑆂, 𑆱𑆶𑆥𑇀𑆠𑆴𑆂, 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆩𑆶𑆰𑇀𑆑𑆾𑆫𑆶𑆯𑆾𑆦𑆂, 𑆇𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆂, 𑆯𑆶𑆑𑇀𑆬𑆠𑇀𑆮𑆁 𑆖 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑆳𑆩𑇀; 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆁 𑆯𑆶𑆑𑇀𑆬𑆫𑆳𑆘𑆵𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆠𑆠𑆁, 𑆓𑆶𑆫𑆶, 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆁, 𑆱𑇀𑆡𑆴𑆫𑆁, 𑆑𑆜𑆴𑆤𑆁 𑆖 𑆨𑆮𑆠𑆴; 𑆍𑆠𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇑𑇆
𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑆼𑆫𑆥𑆡𑇀𑆪𑆳𑆩𑆮𑆴𑆫𑆾𑆣𑆴𑆓𑆶𑆫𑆶𑆨𑆾𑆘𑆤𑆽𑆂𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆢𑆠𑇀𑆠𑆽𑆯𑇀𑆖 𑆫𑆘𑆾𑆫𑆾𑆩𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆤𑆒𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇓𑇒𑇆
𑆮𑆴𑆰𑆽𑆯𑇀𑆖 𑆩𑆤𑇀𑆢𑆽𑆫𑇀𑆮𑆳𑆠𑆳𑆢𑇀𑆪𑆳𑆂 𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆱𑆚𑇀𑆖𑆪𑆁 𑆠𑇀𑆫𑆪𑆂𑇅 𑆯𑆤𑆽𑆂 𑆑𑆾𑆰𑇀𑆜𑆼 𑆥𑇀𑆫𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆾 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇓𑇓𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆶𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼, 𑆮𑆫𑇀𑆟𑆳𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆼 𑆤𑆒𑆳𑆢𑆴𑆰𑆶, 𑆇𑆢𑆫𑆩𑆥𑆴 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆫𑆳𑆘𑆵𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆠𑆠𑆁 𑆨𑆮𑆠𑆴; 𑆍𑆠𑆠𑇀 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇔𑇆
𑆃𑆯𑆴𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆳𑆢𑇀𑆪𑆳𑆤𑆪𑆳𑆤𑆳𑆠𑆴𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆽𑆂𑇅 𑆃𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆨𑆳𑆫𑆳𑆣𑇀𑆮𑆮𑆩𑆤𑆮𑇀𑆪𑆳𑆣𑆴𑆑𑆫𑇀𑆯𑆤𑆽𑆂𑇆𑇓𑇕𑇆
𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆯𑇀𑆫𑆴𑆠𑆂 𑆥𑇀𑆬𑆵𑆲𑆳 𑆖𑇀𑆪𑆶𑆠𑆂 𑆱𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆣𑆠𑆼𑇅 𑆯𑆾𑆟𑆴𑆠𑆁 𑆮𑆳 𑆫𑆱𑆳𑆢𑆴𑆨𑇀𑆪𑆾 𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆁 𑆠𑆁 𑆮𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀𑇆𑇓𑇖𑇆
𑆠𑆱𑇀𑆪 𑆥𑇀𑆬𑆵𑆲𑆳 𑆑𑆜𑆴𑆤𑆾𑇁𑆰𑇀𑆜𑆵𑆬𑆼𑆮𑆳𑆢𑆿 𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆂 𑆑𑆖𑇀𑆗𑆥𑆱𑆁𑆱𑇀𑆡𑆳𑆤 𑆇𑆥𑆬𑆨𑇀𑆪𑆠𑆼; 𑆱 𑆖𑆾𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆂 𑆑𑇀𑆫𑆩𑆼𑆟 𑆑𑆶𑆑𑇀𑆰𑆴𑆁 𑆘𑆜𑆫𑆩𑆓𑇀𑆤𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆖 𑆥𑆫𑆴𑆑𑇀𑆰𑆴𑆥𑆤𑇀𑆤𑆶𑆢𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇓𑇗𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆮𑆫𑇀𑆖𑆾𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆠𑆩𑆂𑆥𑇀𑆫𑆮𑆼𑆯𑆥𑆴𑆥𑆳𑆱𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆕𑇀𑆓𑆱𑆳𑆢- 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆩𑆸𑆢𑆶𑆘𑇀𑆮𑆫𑆳𑆤𑆳𑆲𑆳𑆓𑇀𑆤𑆴𑆤𑆳𑆯𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆳𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆑𑆾𑆰𑇀𑆜𑆮𑆳𑆠𑆯𑆷𑆬𑆳𑆤𑆴, 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆩𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆁 𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆮𑆳 𑆤𑆵𑆬𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆫𑆳𑆘𑆴𑆩𑆢𑇀𑆨𑆮𑆠𑆴; 𑆍𑆮𑆩𑆼𑆮 𑆪𑆑𑆸𑆢𑆥𑆴 𑆢𑆑𑇀𑆰𑆴𑆟𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑇀𑆡𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆠𑆶𑆬𑇀𑆪𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆿𑆰𑆣𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑇀𑆬𑆵𑆲𑆘𑆜𑆫 𑆍𑆮𑆳𑆮𑆫𑆾𑆣 𑆅𑆠𑆴; 𑆍𑆠𑆠𑇀 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇘𑇆
𑆥𑆑𑇀𑆰𑇀𑆩𑆧𑆳𑆬𑆽𑆂 𑆱𑆲𑆳𑆤𑇀𑆤𑆼𑆤 𑆨𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆧𑆢𑇀𑆣𑆳𑆪𑆤𑆼 𑆓𑆶𑆢𑆼𑇅 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆽𑆱𑇀𑆠𑆡𑆳𑇁𑆫𑇀𑆯𑆾𑆨𑆴𑆫𑆤𑇀𑆠𑇀𑆫𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑆼𑆤 𑆮𑆳𑇆𑇓𑇙𑇆
𑆃𑆥𑆳𑆤𑆾 𑆩𑆳𑆫𑇀𑆓𑆱𑆁𑆫𑆾𑆣𑆳𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆁 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇅 𑆮𑆫𑇀𑆖𑆂𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑇀 𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆘𑆤𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆠𑆂𑇆𑇔𑇐𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆩𑆶𑆒𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆾𑆫𑆶𑆱𑆳𑆢𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑- 𑆮𑆫𑇀𑆖𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆣𑇀𑆩𑆳𑆤𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆑𑇀𑆰𑆮𑆡𑆶𑆯𑆴𑆫𑆾𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆓𑆶𑆢𑆯𑆷𑆬𑆳𑆤𑆴, 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆁 𑆩𑆷𑆞𑆮𑆳𑆠𑆁 𑆱𑇀𑆡𑆴𑆫𑆩𑆫𑆶𑆟𑆁 𑆤𑆵𑆬𑆫𑆳𑆘𑆴 𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆫𑆳𑆘𑆴𑆑𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆪𑆾 𑆤𑆳𑆨𑇀𑆪𑆶𑆥𑆫𑆴 𑆓𑆾𑆥𑆶𑆖𑇀𑆗𑆮𑆢𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆠 𑆅𑆠𑆴; 𑆍𑆠𑆢𑇀𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇑𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆠𑆸𑆟𑆑𑆳𑆰𑇀𑆜𑆳𑆱𑇀𑆡𑆴𑆑𑆟𑇀𑆛𑆑𑆽𑆫𑆤𑇀𑆤𑆱𑆁𑆪𑆶𑆠𑆽𑆂𑇅 𑆨𑆴𑆢𑇀𑆪𑆼𑆠𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆪𑆢𑆳 𑆨𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆘𑆸𑆩𑇀𑆨𑆪𑆳𑇁𑆠𑇀𑆪𑆯𑆤𑆼𑆤 𑆮𑆳𑇆𑇔𑇒𑇆
𑆥𑆳𑆑𑆁 𑆓𑆖𑇀𑆗𑆼𑆢𑇀𑆫𑆱𑆱𑇀𑆠𑆼𑆨𑇀𑆪𑆯𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆢𑇀𑆧𑆲𑆴𑆂𑇅 𑆥𑆷𑆫𑆪𑆤𑇀 𑆓𑆶𑆢𑆩𑆤𑇀𑆠𑇀𑆫𑆁 𑆖 𑆘𑆤𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆠𑆂𑇆𑇔𑇓𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆠𑆢𑆣𑆾 𑆤𑆳𑆨𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆨𑆴𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆩𑆶𑆢𑆑𑆾𑆢𑆫𑆁 𑆨𑆮𑆠𑆴, 𑆪𑆡𑆳𑆧𑆬𑆁 𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆫𑆷𑆥𑆳𑆟𑆴 𑆢𑆫𑇀𑆯𑆪𑆠𑆴, 𑆃𑆥𑆴 𑆖𑆳𑆠𑆶𑆫𑆂 𑆱𑆬𑆾𑆲𑆴𑆠𑆤𑆵𑆬𑆥𑆵𑆠𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑇀𑆪𑆳𑆩𑆮𑆫𑇀𑆖 𑆇𑆥𑆮𑆼𑆯𑆠𑆼, 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆠𑆸𑆰𑇀𑆟𑆳𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆥𑆫𑆵𑆠𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆍𑆠𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇔𑇆
𑆱𑇀𑆤𑆼𑆲𑆥𑆵𑆠𑆱𑇀𑆪 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆼𑆂 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪𑆳𑆠𑆴𑆑𑆸𑆯𑆱𑇀𑆪 𑆮𑆳𑇅 𑆃𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆥𑆳𑆤𑆳𑆤𑇀𑆤𑆰𑇀𑆛𑆼𑇁𑆓𑇀𑆤𑆿 𑆩𑆳𑆫𑆶𑆠𑆂 𑆑𑇀𑆬𑆾𑆩𑇀𑆤𑆴 𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆂𑇆𑇔𑇕𑇆
𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑆶 𑆫𑆶𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆼𑆰𑆶 𑆑𑆦𑆯𑇀𑆖𑆾𑆢𑆑𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆂𑇅 𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑆳𑆁 𑆠𑆢𑆼𑆮𑆳𑆩𑇀𑆧𑆶 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆶𑆢𑆫𑆳𑆪 𑆠𑆿𑇆𑇔𑇖𑇆
𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆃𑆤𑆤𑇀𑆤𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆥𑆴𑆥𑆳𑆱𑆳𑆓𑆶𑆢𑆱𑇀𑆫𑆳𑆮𑆯𑆷𑆬𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑆴, 𑆃𑆥𑆴 𑆖𑆾𑆢𑆫𑆁 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆫𑆳𑆘𑆴𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆠𑆠𑆩𑆶𑆢𑆑𑆥𑆷𑆫𑇀𑆟𑆢𑆸𑆠𑆴𑆑𑇀𑆰𑆾𑆨𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆨𑆮𑆠𑆴, 𑆍𑆠𑆢𑆶𑆢𑆑𑆾𑆢𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇗𑇆
𑆠𑆠𑇀𑆫 𑆃𑆖𑆴𑆫𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆩𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆩𑆤𑆶𑆢𑆑𑆩𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆶𑆢𑆫𑆁 𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠𑇀; 𑆇𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆳𑆤𑆳𑆁 𑆲𑇀𑆪𑆼𑆰𑆳𑆁 𑆢𑆾𑆰𑆳𑆂 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆥𑆮𑆸𑆠𑇀𑆠𑆳 𑆥𑆫𑆴𑆥𑆳𑆑𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑆵𑆨𑆷𑆠𑆳𑆂 𑆱𑆤𑇀𑆣𑆵𑆤𑇀 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆖𑆾𑆥𑆑𑇀𑆬𑆼𑆢𑆪𑆤𑇀𑆠𑆴, 𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆖 𑆧𑆳𑆲𑇀𑆪𑆼𑆰𑆶 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑆶 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆓𑆠𑆴𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑆮𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆱𑇀𑆠𑆢𑆼𑆮𑆾𑆢𑆑𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆥𑆴𑆖𑇀𑆗𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆿 𑆩𑆟𑇀𑆝𑆬𑆩𑆶𑆢𑆫𑆁 𑆓𑆶𑆫𑆶 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆩𑆳𑆑𑆾𑆜𑆴𑆠𑆩𑆯𑆧𑇀𑆢𑆁 𑆩𑆸𑆢𑆶𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑆥𑆓𑆠𑆫𑆳𑆘𑆵𑆑𑆩𑆳𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆁 𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆮𑆾𑆥𑆱𑆫𑇀𑆥𑆠𑆴𑇅 𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆶𑆢𑆑𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂𑇅 𑆠𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴- 𑆑𑆶𑆑𑇀𑆰𑆼𑆫𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆂, 𑆱𑆴𑆫𑆳𑆤𑇀𑆠𑆫𑇀𑆣𑆳𑆤𑆓𑆩𑆤𑆩𑇀, 𑆇𑆢𑆑𑆥𑆷𑆫𑇀𑆟𑆢𑆸𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆠𑇀𑆮𑆁 𑆖𑇆𑇔𑇘𑇆
𑆠𑆢𑆳𑇁𑇁𑆠𑆶𑆫𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆴- 𑆗𑆫𑇀𑆢𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆠𑆩𑆑𑆠𑆸𑆰𑇀𑆟𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆳𑆫𑆶𑆖𑆴𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆢𑆪𑆂; 𑆠𑆡𑆳𑆮𑆴𑆣𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇔𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆳𑆠𑆳𑆠𑇀𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀𑆑𑆦𑆳𑆠𑇀 𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆠𑇀𑆠𑆡𑆾𑆢𑆑𑆳𑆠𑇀𑇅 𑆥𑆫𑆁 𑆥𑆫𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆫𑆩𑆶𑆢𑆫𑆁 𑆨𑆴𑆰𑆓𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇕𑇐𑇆
𑆥𑆑𑇀𑆰𑆳𑆢𑇀𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆁 𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆫𑇀𑆮𑆁 𑆘𑆳𑆠𑆾𑆢𑆑𑆁 𑆠𑆡𑆳𑇅 𑆥𑇀𑆫𑆳𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆨𑆳𑆮𑆳𑆪 𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆖𑆾𑆢𑆫𑆁 𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇕𑇑𑇆
𑆯𑆷𑆤𑆳𑆑𑇀𑆰𑆁 𑆑𑆶𑆛𑆴𑆬𑆾𑆥𑆱𑇀𑆡𑆩𑆶𑆥𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆠𑆤𑆶𑆠𑇀𑆮𑆖𑆩𑇀𑇅 𑆧𑆬𑆯𑆾𑆟𑆴𑆠𑆩𑆳𑆁𑆱𑆳𑆓𑇀𑆤𑆴𑆥𑆫𑆴𑆑𑇀𑆰𑆵𑆟𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇕𑇒𑇆
𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆱𑆫𑇀𑆮𑆩𑆫𑇀𑆩𑆾𑆠𑇀𑆡𑆂 𑆯𑇀𑆮𑆳𑆱𑆾 𑆲𑆴𑆑𑇀𑆑𑆳𑇁𑆫𑆶𑆖𑆴𑆂 𑆱𑆠𑆸𑆛𑇀𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆠𑆵𑆱𑆳𑆫𑆾 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆴𑆟𑆁 𑆤𑆫𑆩𑇀𑇆𑇕𑇓𑇆
𑆘𑆤𑇀𑆩𑆤𑆽𑆮𑆾𑆢𑆫𑆁 𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆩𑆁 𑆩𑆠𑆩𑇀𑇅 𑆧𑆬𑆴𑆤𑆱𑇀𑆠𑆢𑆘𑆳𑆠𑆳𑆩𑇀𑆧𑆶 𑆪𑆠𑇀𑆤𑆱𑆳𑆣𑇀𑆪𑆁 𑆤𑆮𑆾𑆠𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇕𑇔𑇆
𑆃𑆘𑆳𑆠𑆯𑆾𑆡𑆩𑆫𑆶𑆟𑆁 𑆱𑆯𑆧𑇀𑆢𑆁 𑆤𑆳𑆠𑆴𑆨𑆳𑆫𑆴𑆑𑆩𑇀𑇅 𑆱𑆢𑆳 𑆓𑆶𑆝𑆓𑆶𑆝𑆳𑆪𑆖𑇀𑆖 𑆱𑆴𑆫𑆳𑆘𑆳𑆬𑆓𑆮𑆳𑆑𑇀𑆰𑆴𑆠𑆩𑇀𑇆𑇕𑇕𑇆
𑆤𑆳𑆨𑆴𑆁 𑆮𑆴𑆰𑇀𑆛𑆨𑇀𑆪 𑆥𑆳𑆪𑆿 𑆠𑆶 𑆮𑆼𑆓𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆟𑆯𑇀𑆪𑆠𑆴𑇅 𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆑𑆛𑆵𑆓𑆶𑆢𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆯𑆷𑆬𑆴𑆤𑆂𑇆𑇕𑇖𑇆
𑆑𑆫𑇀𑆑𑆯𑆁 𑆱𑆸𑆘𑆠𑆾 𑆮𑆳𑆠𑆁 𑆤𑆳𑆠𑆴𑆩𑆤𑇀𑆢𑆼 𑆖 𑆥𑆳𑆮𑆑𑆼𑇅 𑆬𑆾𑆬𑆱𑇀𑆪𑆳𑆮𑆴𑆫𑆱𑆼 𑆖𑆳𑆱𑇀𑆪𑆼 𑆩𑆷𑆠𑇀𑆫𑆼𑇁𑆬𑇀𑆥𑆼 𑆱𑆁𑆲𑆠𑆼 𑆮𑆴𑆰𑆴𑇆𑇕𑇗𑇆
𑆃𑆘𑆳𑆠𑆾𑆢𑆑𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆽𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆂𑇅 𑆇𑆥𑆳𑆑𑇀𑆫𑆩𑆼𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆢𑆾𑆰𑆧𑆬𑆑𑆳𑆬𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆠𑇀𑇆𑇕𑇘𑇆
𑆮𑆳𑆠𑆾𑆢𑆫𑆁 𑆧𑆬𑆩𑆠𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆪 𑆱𑇀𑆮𑆼𑆢𑆴𑆠𑆳𑆕𑇀𑆓𑆳𑆪 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇕𑇙𑇆
𑆲𑆸𑆠𑆼 𑆢𑆾𑆰𑆼 𑆥𑆫𑆴𑆩𑇀𑆬𑆳𑆤𑆁 𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆢𑇀𑆮𑆳𑆱𑆱𑆾𑆢𑆫𑆩𑇀𑇅 𑆠𑆡𑆳𑇁𑆱𑇀𑆪𑆳𑆤𑆮𑆑𑆳𑆯𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆤𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂𑇆𑇖𑇐𑇆

𑆩𑆳𑆱𑆩𑆼𑆑𑆁 𑆠𑆠𑆯𑇀𑆖𑆽𑆮 𑆠𑆸𑆰𑆴𑆠𑆂 𑆱𑇀𑆮𑆫𑆱𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆍𑆮𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆲𑆸𑆠𑆼 𑆢𑆾𑆰𑆼 𑆯𑆳𑆑𑆽𑆫𑇀𑆩𑆳𑆱𑆳𑆠𑇀 𑆥𑆫𑆁 𑆠𑆠𑆂𑇆𑇑𑇘𑇓𑇆
𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆪 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑇀 𑆑𑆳𑆫𑆨𑆁 𑆥𑆪𑆂𑇅𑇑𑇘𑇔𑇅 𑆅𑆢𑆁 𑆠𑆶 𑆯𑆬𑇀𑆪𑆲𑆫𑇀𑆠𑆹𑆟𑆳𑆁 𑆑𑆫𑇀𑆩 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀𑇆𑇑𑇘𑇔𑇆
𑆮𑆳𑆩𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆁 𑆩𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆤𑆳𑆨𑇀𑆪𑆣𑆯𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆩𑇀𑇅 𑆩𑆳𑆠𑇀𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆥𑆳𑆛𑆪𑆼𑆤𑇀𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇘𑇕𑇆
𑆮𑆴𑆥𑆳𑆛𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆠𑆠𑆂 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆧𑆢𑇀𑆣𑆑𑇀𑆰𑆠𑆳𑆤𑇀𑆠𑇀𑆫𑆪𑆾𑆂𑇅 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑆨𑇀𑆪𑆘𑇀𑆪 𑆑𑆼𑆯𑆳𑆢𑆵𑆤𑆮𑆩𑆸𑆘𑇀𑆪 𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇑𑇘𑇖𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑆳𑆢𑇀𑆪𑆖𑇀𑆖 𑆱𑆩𑇀𑆩𑆷𑆞𑆩𑆤𑇀𑆠𑇀𑆫𑆁 𑆠𑆖𑇀𑆖 𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇅 𑆗𑆴𑆢𑇀𑆫𑆳𑆟𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆠𑆶 𑆱𑇀𑆡𑆷𑆬𑆽𑆫𑇀𑆢𑆁𑆯𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆽𑆂𑇆𑇑𑇘𑇗𑇆
𑆧𑆲𑆶𑆯𑆂 𑆱𑆕𑇀𑆓𑆸𑆲𑆵𑆠𑆳𑆤𑆴 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆖𑇀𑆗𑆴𑆠𑇀𑆮𑆳 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆤𑇀𑇅 𑆥𑇀𑆫𑆠𑆴𑆪𑆾𑆓𑆽𑆂 𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆼𑆪𑆽𑆂 𑆱𑆵𑆮𑇀𑆪𑆼𑆢𑇀𑆮𑇀𑆫𑆟𑆁 𑆠𑆠𑆂𑇆𑇑𑇘𑇘𑇆
𑆠𑆡𑆳 𑆘𑆳𑆠𑆾𑆢𑆑𑆁 𑆱𑆫𑇀𑆮𑆩𑆶𑆢𑆫𑆁 𑆮𑇀𑆪𑆣𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀𑇅 𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆠𑇀𑆮𑆣𑆾 𑆤𑆳𑆨𑆼𑆫𑇀𑆤𑆳𑆝𑆵𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆖 𑆓𑆳𑆬𑆪𑆼𑆠𑇀𑇆𑇑𑇘𑇙𑇆
𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆖 𑆮𑆴𑆩𑆸𑆢𑇀𑆪𑆽𑆠𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆢𑇀𑆮𑆳𑆱𑆱𑆾𑆢𑆫𑆩𑇀𑇅 𑆠𑆡𑆳 𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆫𑆼𑆑𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆩𑇀𑆬𑆳𑆤𑆁 𑆱𑆫𑇀𑆮𑆁 𑆖 𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇐𑇆
𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆼 𑆬𑆕𑇀𑆔𑆴𑆠𑆂 𑆥𑆼𑆪𑆳𑆩𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆠𑆶 𑆰𑆟𑇀𑆩𑆳𑆱𑆳𑆤𑇀 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆼𑆤𑇀𑆤𑆫𑆂𑇆𑇑𑇙𑇑𑇆
𑆠𑇀𑆫𑆵𑆤𑇀 𑆩𑆳𑆱𑆳𑆤𑇀 𑆥𑆪𑆱𑆳 𑆥𑆼𑆪𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆨𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆁 𑆑𑆾𑆫𑆢𑆷𑆰𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆳𑆬𑆮𑆟𑆁 𑆬𑆔𑆶𑇆𑇑𑇙𑇒𑇆
𑆤𑆫𑆂 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆼𑆟𑆽𑆮𑆁 𑆘𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆘𑆬𑆾𑆢𑆫𑆩𑇀𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆟𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆤𑆶 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇓𑇆
𑆢𑆾𑆰𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆫𑆑𑇀𑆰𑆳𑆫𑇀𑆡𑆁 𑆧𑆬𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆳𑆫𑇀𑆡𑆩𑆼𑆮 𑆖𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆥𑆖𑆴𑆠𑆳𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆲𑆴𑆠𑆁 𑆲𑇀𑆪𑆶𑆢𑆫𑆴𑆟𑆳𑆁 𑆥𑆪𑆂𑇅 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆼𑆮𑆳𑆤𑆳𑆩𑆩𑆸𑆠𑆁 𑆪𑆡𑆳𑇆𑇑𑇙𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆲𑆼𑆠𑆶𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆫𑆷𑆥𑆩𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑇀𑆪𑆳𑆱𑆱𑆩𑆳𑆱𑆠𑆂𑇅 𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑆓𑆫𑆵𑆪𑆱𑇀𑆠𑇀𑆮𑆁 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆩𑆼𑆮 𑆖𑇆𑇑𑇙𑇕𑇆
𑆘𑆳𑆠𑆳𑆘𑆳𑆠𑆳𑆩𑇀𑆧𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆖𑆾𑆑𑇀𑆠𑆮𑆳𑆤𑆸𑆰𑆴𑆂𑇅 𑆱𑆩𑆳𑆱𑆮𑇀𑆪𑆳𑆱𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆽𑆫𑆶𑆢𑆫𑆳𑆟𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑇆𑇑𑇙𑇖𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆫𑇀𑆯𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆄𑆱𑆵𑆤𑆁 𑆩𑆶𑆤𑆴𑆩𑆮𑇀𑆪𑆓𑇀𑆫𑆁 𑆑𑆸𑆠𑆘𑆳𑆥𑇀𑆪𑆁 𑆑𑆸𑆠𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆥𑆸𑆰𑇀𑆛𑆮𑆳𑆤𑆫𑇀𑆯𑆱𑆳𑆁 𑆪𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑇀𑇆𑇓𑇆
𑆥𑇀𑆫𑆑𑆾𑆥𑆲𑆼𑆠𑆶𑆁 𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆁 𑆱𑇀𑆡𑆳𑆤𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆨𑆳𑆓𑆁 𑆖 𑆠𑆱𑇀𑆩𑆽 𑆠𑆤𑇀𑆩𑆶𑆤𑆴𑆫𑆧𑇀𑆫𑆮𑆵𑆠𑇀𑇆𑇔𑇆
𑆅𑆲 𑆒𑆬𑇀𑆮𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴- 𑆑𑆳𑆤𑆴𑆖𑆴𑆠𑇀 𑆱𑆲𑆘𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆘𑇀𑆘𑆳𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆘𑆳𑆤𑆴𑇅 𑆠𑆠𑇀𑆫 𑆧𑆵𑆘𑆁 𑆓𑆶𑆢𑆮𑆬𑆴𑆧𑆵𑆘𑆾𑆥𑆠𑆥𑇀𑆠𑆩𑆳𑆪𑆠𑆤𑆩𑆫𑇀𑆯𑆱𑆳𑆁 𑆱𑆲𑆘𑆳𑆤𑆳𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆾 𑆧𑆵𑆘𑆾𑆥𑆠𑆥𑇀𑆠𑆿 𑆲𑆼𑆠𑆶𑆂- 𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑇀𑆫𑆾𑆫𑆥𑆖𑆳𑆫𑆂, 𑆥𑆷𑆫𑇀𑆮𑆑𑆸𑆠𑆁 𑆖 𑆑𑆫𑇀𑆩; 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆥𑆴 𑆱𑆲𑆘𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆱𑆲𑆘𑆳𑆤𑆴 𑆱𑆲 𑆘𑆳𑆠𑆳𑆤𑆴 𑆯𑆫𑆵𑆫𑆼𑆟, 𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑇀𑆪𑆣𑆴𑆩𑆳𑆁𑆱𑆮𑆴𑆑𑆳𑆫𑆳𑆂𑇆𑇕𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆖𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆁- 𑆓𑆶𑆢𑆱𑇀𑆪𑆳𑆫𑇀𑆣𑆥𑆚𑇀𑆖𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆮𑆑𑆳𑆯𑆼 𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆳𑆤𑇀𑆠𑆫𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆾 𑆓𑆶𑆢𑆮𑆬𑆪𑆂 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆩𑆴𑆠𑆴; 𑆑𑆼𑆖𑆴𑆠𑇀𑆠𑆶 𑆨𑆷𑆪𑆳𑆁𑆱𑆩𑆼𑆮 𑆢𑆼𑆯𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆯𑆱𑆳𑆁- 𑆯𑆴𑆯𑇀𑆤𑆩𑆥𑆠𑇀𑆪𑆥𑆡𑆁 𑆓𑆬𑆠𑆳𑆬𑆶𑆩𑆶𑆒𑆤𑆳𑆱𑆴𑆑𑆳𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆤𑆴 𑆠𑇀𑆮𑆑𑇀 𑆖𑆼𑆠𑆴𑇅 𑆠𑆢𑆱𑇀𑆠𑇀𑆪𑆣𑆴𑆩𑆳𑆁𑆱𑆢𑆼𑆯𑆠𑆪𑆳, 𑆓𑆶𑆢𑆮𑆬𑆴𑆘𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆖𑆳𑆫𑇀𑆯𑆱𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁- 𑆩𑆼𑆢𑆾 𑆩𑆳𑆁𑆱𑆁 𑆠𑇀𑆮𑆑𑇀 𑆖𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆱𑆲𑆘𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑆟𑆷𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆤𑇀𑆩𑆲𑆳𑆤𑇀𑆠𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑇀𑆢𑆵𑆫𑇀𑆔𑆳𑆟𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑇀𑆣𑇀𑆫𑆱𑇀𑆮𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑇀𑆮𑆴𑆰𑆩𑆮𑆴𑆱𑆸𑆠𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑆤𑇀𑆠𑆂𑆑𑆶𑆛𑆴𑆬𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑇀𑆧𑆲𑆴𑆂𑆑𑆶𑆛𑆴𑆬𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆘𑇀𑆘𑆛𑆴𑆬𑆳𑆤𑆴, 𑆑𑆳𑆤𑆴𑆖𑆴𑆢𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆳𑆤𑆴, 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆢𑆾𑆰𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆳𑆤𑆴𑇆𑇗𑇆
𑆠𑆽𑆫𑆶𑆥𑆲𑆠𑆾 𑆘𑆤𑇀𑆩𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆨𑆮𑆠𑇀𑆪𑆠𑆴𑆑𑆸𑆯𑆾 𑆮𑆴𑆮𑆫𑇀𑆟𑆂 𑆑𑇀𑆰𑆳𑆩𑆾 𑆢𑆵𑆤𑆂 𑆥𑇀𑆫𑆖𑆶𑆫𑆮𑆴𑆧𑆢𑇀𑆣𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆂 𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆩𑆳𑆤𑇀, 𑆠𑆡𑆳𑇁𑆤𑆴𑆪𑆠𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆶𑆑𑇀𑆠𑆥𑆑𑇀𑆮𑆳𑆩𑆯𑆶𑆰𑇀𑆑𑆨𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆖𑆳 𑆃𑆤𑇀𑆠𑆫𑆳𑇁𑆤𑇀𑆠𑆫𑆳 𑆯𑇀𑆮𑆼𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆲𑆫𑆴𑆠𑆥𑆵𑆠𑆫𑆑𑇀𑆠𑆳𑆫𑆶𑆟𑆠𑆤𑆶𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑇀𑆪𑆳𑆩𑆥𑆶𑆫𑆵𑆰𑆾𑆥𑆮𑆼𑆯𑆵, 𑆤𑆳𑆨𑆴𑆧𑆱𑇀𑆠𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆾𑆢𑇀𑆢𑆼𑆯𑆼 𑆥𑇀𑆫𑆖𑆶𑆫𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳𑆤𑇀𑆮𑆴𑆠𑆂, 𑆱𑆓𑆶𑆢𑆯𑆷𑆬𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆥𑆫𑆴𑆲𑆫𑇀𑆰𑆥𑇀𑆫𑆩𑆼𑆲𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆲𑆸𑆢𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆬𑆼𑆥𑆂 𑆥𑇀𑆫𑆖𑆶𑆫𑆮𑆴𑆧𑆢𑇀𑆣𑆠𑆴𑆑𑇀𑆠𑆳𑆩𑇀𑆬𑆾𑆢𑇀𑆓𑆳𑆫𑆂, 𑆱𑆶𑆢𑆶𑆫𑇀𑆧𑆬𑆂, 𑆱𑆶𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑆴𑆂, 𑆃𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆂, 𑆑𑇀𑆫𑆾𑆣𑆤𑆾, 𑆢𑆶𑆂𑆒𑆾𑆥𑆖𑆳𑆫𑆯𑆵𑆬𑆂, 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆠𑆩𑆑𑆠𑆸𑆰𑇀𑆟𑆳𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆥𑆵𑆤𑆱𑆑𑇀𑆰𑆮𑆡𑆶𑆥𑆫𑆵𑆠𑆂, 𑆠𑆽𑆩𑆴𑆫𑆴𑆑𑆂, 𑆯𑆴𑆫𑆂𑆯𑆷𑆬𑆵, 𑆑𑇀𑆰𑆳𑆩𑆨𑆴𑆤𑇀𑆤𑆱𑆤𑇀𑆤𑆱𑆑𑇀𑆠𑆘𑆫𑇀𑆘𑆫𑆱𑇀𑆮𑆫𑆂, 𑆑𑆫𑇀𑆟𑆫𑆾𑆓𑆵, 𑆯𑆷𑆤𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆮𑆢𑆤𑆳𑆑𑇀𑆰𑆴𑆑𑆷𑆛𑆂, 𑆱𑆘𑇀𑆮𑆫𑆂, 𑆱𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆂, 𑆱𑆫𑇀𑆮𑆥𑆫𑇀𑆮𑆳𑆱𑇀𑆡𑆴𑆯𑆷𑆬𑆵 𑆖, 𑆃𑆤𑇀𑆠𑆫𑆳𑇁𑆤𑇀𑆠𑆫𑆳 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆑𑆶𑆑𑇀𑆰𑆴𑆧𑆱𑇀𑆠𑆴𑆲𑆸𑆢𑆪𑆥𑆸𑆰𑇀𑆜𑆠𑇀𑆫𑆴𑆑𑆓𑇀𑆫𑆲𑆾𑆥𑆠𑆥𑇀𑆠𑆂, 𑆥𑇀𑆫𑆣𑇀𑆪𑆳𑆤𑆥𑆫𑆂, 𑆥𑆫𑆩𑆳𑆬𑆱𑆯𑇀𑆖𑆼𑆠𑆴; 𑆘𑆤𑇀𑆩𑆥𑇀𑆫𑆨𑆸𑆠𑇀𑆪𑆱𑇀𑆪 𑆓𑆶𑆢𑆘𑆽𑆫𑆳𑆮𑆸𑆠𑆾 𑆩𑆳𑆫𑇀𑆓𑆾𑆥𑆫𑆾𑆣𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑆥𑆳𑆤𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆫𑆾𑆲𑆤𑇀 𑆱𑆩𑆳𑆤𑆮𑇀𑆪𑆳𑆤𑆥𑇀𑆫𑆳𑆟𑆾𑆢𑆳𑆤𑆳𑆤𑇀 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆿 𑆖 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆠𑆴, 𑆍𑆠𑆼 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆥𑆚𑇀𑆖 𑆮𑆳𑆪𑆮𑆂 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆿 𑆖𑆳𑆫𑇀𑆯𑆱𑆩𑆨𑆴𑆢𑇀𑆫𑆮𑆤𑇀𑆠 𑆍𑆠𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆶𑆥𑆘𑆤𑆪𑆤𑇀𑆠𑆴; 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆱𑆲𑆘𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴𑇆𑇘𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆘𑆳𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆘𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆮𑆴𑆢𑆳𑆲𑆴𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆘𑆵𑆫𑇀𑆟𑆥𑇀𑆫𑆩𑆴𑆠𑆳𑆯𑆤𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆨𑆾𑆘𑆤𑆳𑆢𑇀𑆓𑆮𑇀𑆪𑆩𑆳𑆠𑇀𑆱𑇀𑆪𑆮𑆳𑆫𑆳𑆲𑆩𑆳𑆲𑆴𑆰𑆳𑆘𑆳𑆮𑆴𑆑𑆥𑆴𑆯𑆴𑆠𑆨𑆑𑇀𑆰𑆟𑆳𑆠𑇀 𑆑𑆸𑆯𑆯𑆶𑆰𑇀𑆑𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆥𑆽𑆰𑇀𑆛𑆴𑆑𑆥𑆫𑆩𑆳𑆤𑇀𑆤𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆠𑆴𑆬𑆓𑆶𑆝𑆮𑆴𑆑𑆸𑆠𑆴𑆱𑆼𑆮𑆤𑆳𑆤𑇀𑆩𑆳𑆰𑆪𑆷𑆰𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆥𑆴𑆟𑇀𑆝𑆳𑆬𑆶𑆑𑆯𑆶𑆰𑇀𑆑𑆯𑆳𑆑- 𑆯𑆶𑆑𑇀𑆠𑆬𑆯𑆶𑆤𑆑𑆴𑆬𑆳𑆛𑆠𑆑𑇀𑆫𑆥𑆴𑆟𑇀𑆝𑆑𑆧𑆴𑆱𑆩𑆸𑆟𑆳𑆬𑆯𑆳𑆬𑆷𑆑𑆑𑇀𑆫𑆿𑆚𑇀𑆖𑆳𑆢𑆤𑆑𑆯𑆼𑆫𑆶𑆑𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆠𑆫𑆷𑆛𑆮𑆴𑆫𑆷𑆞𑆤𑆮𑆯𑆷𑆑𑆯𑆩𑆵- 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑆩𑆷𑆬𑆑𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆦𑆬𑆯𑆳𑆑𑆫𑆳𑆓𑆲𑆫𑆴𑆠𑆑𑆩𑆫𑇀𑆢𑆑𑆮𑆱𑆳𑆯𑆴𑆫𑆱𑇀𑆥𑆢𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆥𑆷𑆠𑆴𑆯𑆵𑆠𑆱𑆕𑇀𑆑𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆤𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆳𑆤𑇀𑆩𑆤𑇀𑆢- 𑆑𑆳𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆩𑆢𑇀𑆪𑆥𑆳𑆤𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆓𑆶𑆫𑆶𑆱𑆬𑆴𑆬𑆥𑆳𑆤𑆳𑆢𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆳𑆢𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆮𑆴𑆨𑇀𑆫𑆩𑆳𑆢𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆢𑇀𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆠𑇀 𑆱𑆶𑆒𑆯𑆪𑆤𑆳𑆱𑆤𑆱𑇀𑆡𑆳𑆤𑆱𑆼𑆮𑆤𑆳𑆖𑇀𑆖𑆾𑆥𑆲𑆠𑆳𑆓𑇀𑆤𑆼𑆫𑇀𑆩𑆬𑆾𑆥𑆖𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁, 𑆠𑆡𑆾𑆠𑇀𑆑𑆛𑆑𑆮𑆴𑆰𑆩𑆑𑆜𑆴𑆤𑆳𑆱𑆤𑆱𑆼𑆮𑆤𑆳𑆢𑆶𑆢𑇀𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆪𑆳𑆤𑆾𑆰𑇀𑆛𑇀𑆫𑆪𑆳𑆤𑆳𑆢𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆤𑆼𑆠𑇀𑆫𑆳𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆢𑇀𑆓𑆶𑆢𑆑𑇀𑆰𑆟𑆤𑆳𑆢𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆖𑇀𑆖𑆼𑆬𑆬𑆾𑆰𑇀𑆛𑆠𑆸𑆟𑆳𑆢𑆴𑆔𑆫𑇀𑆰𑆟𑆳𑆠𑇀 𑆥𑇀𑆫𑆠𑆠𑆳𑆠𑆴𑆤𑆴𑆫𑇀𑆮𑆳𑆲𑆟𑆳𑆢𑇀𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆾𑆢𑆵𑆫𑆟𑆳𑆠𑇀 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆮𑆼𑆓𑆮𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆳𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆖𑆳𑆩𑆓𑆫𑇀𑆨𑆨𑇀𑆫𑆁𑆯𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆾𑆠𑇀𑆥𑆵𑆝𑆤𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆥𑇀𑆫𑆱𑆷𑆠𑆴𑆨𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑆥𑆳𑆤𑆱𑇀𑆠𑆁 𑆩𑆬𑆩𑆶𑆥𑆖𑆴𑆠𑆩𑆣𑆾𑆓𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆓𑆶𑆢𑆮𑆬𑆴𑆰𑇀𑆮𑆳𑆣𑆠𑇀𑆠𑆼, 𑆠𑆠𑆱𑇀𑆠𑆳𑆱𑇀𑆮𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇙𑇆
𑆱𑆫𑇀𑆰𑆥𑆩𑆱𑆷𑆫𑆩𑆳𑆰𑆩𑆶𑆢𑇀𑆓𑆩𑆑𑆶𑆰𑇀𑆜𑆑𑆪𑆮𑆑𑆬𑆳𑆪𑆥𑆴𑆟𑇀𑆝𑆴𑆛𑆴𑆟𑇀𑆛𑆴𑆑𑆼𑆫𑆑𑆼𑆧𑆶𑆑𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆑𑆳𑆑𑆟𑆤𑇀𑆠𑆴𑆑𑆳𑆧𑆴𑆩𑇀𑆧𑆵𑆧𑆢𑆫𑆑𑆫𑆵𑆫𑆾𑆢𑆶𑆩𑇀𑆧𑆫- 𑆒𑆫𑇀𑆘𑆷𑆫𑆘𑆳𑆩𑇀𑆧𑆮𑆓𑆾𑆱𑇀𑆠𑆤𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆑𑆯𑆼𑆫𑆶𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆯𑆸𑆕𑇀𑆓𑆵𑆢𑆑𑇀𑆰𑆯𑆴𑆒𑆴𑆯𑆶𑆑𑆠𑆶𑆟𑇀𑆝𑆘𑆴𑆲𑇀𑆮𑆳𑆥𑆢𑇀𑆩𑆩𑆶𑆑𑆶𑆬𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆥𑇀𑆫𑆧𑆬𑆳𑆤𑆴𑇆𑇑𑇐𑇆
𑆠𑆼𑆰𑆳𑆩𑆪𑆁 𑆮𑆴𑆯𑆼𑆰𑆂- 𑆯𑆶𑆰𑇀𑆑𑆩𑇀𑆬𑆳𑆤𑆑𑆜𑆴𑆤𑆥𑆫𑆶𑆰𑆫𑆷𑆑𑇀𑆰𑆯𑇀𑆪𑆳𑆮𑆳𑆤𑆴, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆫𑆳𑆟𑆴, 𑆮𑆑𑇀𑆫𑆳𑆟𑆴, 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆩𑆶𑆒𑆳𑆤𑆴, 𑆮𑆴𑆰𑆩𑆮𑆴𑆱𑆸𑆠𑆳𑆤𑆴, 𑆯𑆷𑆬𑆳𑆑𑇀𑆰𑆼𑆥𑆠𑆾𑆢𑆱𑇀𑆦𑆶𑆫𑆟𑆖𑆴𑆩𑆴𑆖𑆴𑆩𑆳𑆱𑆁𑆲𑆫𑇀𑆰𑆥𑆫𑆵𑆠𑆳𑆤𑆴, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆾𑆥𑆯𑆪𑆳𑆤𑆴, 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆣𑇀𑆩𑆳𑆤𑆯𑆴𑆯𑇀𑆤𑆮𑆸𑆰𑆟𑆧𑆱𑇀𑆠𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆲𑆸𑆢𑆪𑆢𑇀𑆫𑆮𑆥𑇀𑆫𑆧𑆬𑆳𑆤𑆴, 𑆥𑇀𑆫𑆠𑆠𑆮𑆴𑆧𑆢𑇀𑆣𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆳𑆁𑆱𑆴, 𑆈𑆫𑆶𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆠𑇀𑆫𑆴𑆑𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆑𑆶𑆑𑇀𑆰𑆴𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆯𑆴𑆫𑆾𑇁𑆨𑆴𑆠𑆳𑆥𑆑𑇀𑆰𑆮𑆡𑆷𑆢𑇀𑆓𑆳𑆫𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆑𑆳𑆱𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆪𑆳𑆩𑆯𑆾𑆰𑆯𑆾𑆡- 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆫𑆾𑆖𑆑𑆩𑆶𑆒𑆮𑆽𑆫𑆱𑇀𑆪𑆠𑆽𑆩𑆴𑆫𑇀𑆪𑆑𑆟𑇀𑆝𑆷𑆤𑆳𑆱𑆳𑆑𑆫𑇀𑆟𑆯𑆕𑇀𑆒𑆯𑆷𑆬𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆳𑆟𑆴, 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆥𑆫𑆶𑆰𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆪 𑆮𑆳𑆠𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆴 𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆬𑆔𑆷𑆤𑆴 𑆖𑇅 𑆥𑇀𑆫𑆩𑆴𑆠𑆳𑆬𑇀𑆥𑆳𑆯𑆤𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆢𑇀𑆪𑆩𑆽𑆡𑆶𑆤𑆱𑆼𑆮𑆤𑆩𑇀𑇆𑇑𑇒𑇆
𑆬𑆕𑇀𑆔𑆤𑆁 𑆢𑆼𑆯𑆑𑆳𑆬𑆿 𑆖 𑆯𑆵𑆠𑆿 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆑𑆫𑇀𑆩 𑆖𑇅 𑆯𑆾𑆑𑆾 𑆮𑆳𑆠𑆳𑆠𑆥𑆱𑇀𑆥𑆫𑇀𑆯𑆾 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆳𑆠𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆩𑆠𑆂𑇆𑇑𑇓𑇆
𑆩𑆸𑆢𑆶𑆯𑆴𑆡𑆴𑆬𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑇀𑆪𑆱𑇀𑆥𑆫𑇀𑆯𑆱𑆲𑆳𑆤𑆴, 𑆫𑆑𑇀𑆠𑆥𑆵𑆠𑆤𑆵𑆬𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑆴, 𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆑𑇀𑆬𑆼𑆢𑆧𑆲𑆶𑆬𑆳𑆤𑆴, 𑆮𑆴𑆱𑇀𑆫𑆓𑆤𑇀𑆣𑆴𑆠𑆤𑆶𑆥𑆵𑆠𑆫𑆑𑇀𑆠𑆱𑇀𑆫𑆳𑆮𑆵𑆟𑆴 , 𑆫𑆶𑆣𑆴𑆫𑆮𑆲𑆳𑆤𑆴, 𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆷𑆯𑆷𑆬𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆥𑆳𑆑𑆮𑆤𑇀𑆠𑆴, 𑆯𑆵𑆠𑆾𑆥𑆯𑆪𑆳𑆤𑆴, 𑆱𑆩𑇀𑆨𑆴𑆤𑇀𑆤𑆥𑆵𑆠𑆲𑆫𑆴𑆠𑆮𑆫𑇀𑆖𑆳𑆁𑆱𑆴, 𑆥𑆵𑆠𑆮𑆴𑆱𑇀𑆫𑆓𑆤𑇀𑆣𑆴𑆥𑇀𑆫𑆖𑆶𑆫𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑆴, 𑆥𑆴𑆥𑆳𑆱𑆳𑆘𑇀𑆮𑆫𑆠𑆩𑆑𑆱𑆩𑇀𑆩𑆾𑆲𑆨𑆾𑆘𑆤𑆢𑇀𑆮𑆼𑆰𑆑𑆫𑆳𑆟𑆴 𑆥𑆵𑆠𑆤𑆒𑆤𑆪𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆑𑆛𑆷𑆰𑇀𑆟𑆬𑆮𑆟𑆑𑇀𑆰𑆳𑆫𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆓𑇀𑆤𑇀𑆪𑆳𑆠𑆥𑆥𑇀𑆫𑆨𑆳𑆂 𑇅 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆮𑆯𑆴𑆯𑆴𑆫𑆿 𑆑𑇀𑆫𑆾𑆣𑆾 𑆩𑆢𑇀𑆪𑆩𑆱𑆷𑆪𑆤𑆩𑇀𑇆𑇑𑇕𑇆
𑆮𑆴𑆢𑆳𑆲𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆁 𑆖 𑆱𑆫𑇀𑆮𑆁 𑆥𑆳𑆤𑆳𑆤𑇀𑆤𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑆳𑆁 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆼 𑆲𑆼𑆠𑆶𑆫𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫 𑆪𑆳𑆤𑆴 𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆤𑇀𑆠𑆴, 𑆇𑆥𑆖𑆴𑆠𑆳𑆤𑆴, 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴, 𑆱𑇀𑆥𑆫𑇀𑆯𑆱𑆲𑆳𑆤𑆴 , 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑇀𑆮𑆼𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆤𑆴, 𑆱𑇀𑆠𑆧𑇀𑆣𑆳𑆤𑆴, 𑆓𑆶𑆫𑆷𑆟𑆴, 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆳𑆤𑆴, 𑆱𑆶𑆥𑇀𑆠𑆱𑆶𑆥𑇀𑆠𑆳𑆤𑆴, 𑆱𑇀𑆡𑆴𑆫𑆯𑇀𑆮𑆪𑆡𑆷𑆤𑆴, 𑆑𑆟𑇀𑆝𑆷𑆧𑆲𑆶𑆬𑆳𑆤𑆴, 𑆧𑆲𑆶𑆥𑇀𑆫𑆠𑆠𑆥𑆴𑆚𑇀𑆘𑆫𑆯𑇀𑆮𑆼𑆠𑆫𑆑𑇀𑆠𑆥𑆴𑆖𑇀𑆗𑆳𑆱𑇀𑆫𑆳𑆮𑆵𑆟𑆴, 𑆓𑆶𑆫𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆯𑇀𑆮𑆼𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴, 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆾𑆥𑆯𑆪𑆳𑆤𑆴, 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆳𑆤𑆳𑆲𑆮𑆤𑇀𑆠𑆴, 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆴𑆑𑆳𑆑𑆳𑆱𑆳𑆫𑆾𑆖𑆑𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆓𑆿𑆫𑆮𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆯𑆾𑆰𑆯𑆾𑆡- 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆲𑆸𑆢𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆬𑆼𑆥𑆳𑆱𑇀𑆪𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆥𑇀𑆫𑆩𑆼𑆲𑆑𑆫𑆳𑆟𑆴, 𑆢𑆵𑆫𑇀𑆔𑆑𑆳𑆬𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆵𑆤𑆴 , 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑇀𑆢𑆮𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆑𑆫𑆳𑆟𑆴, 𑆄𑆩𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆧𑆬𑆳𑆤𑆴, 𑆯𑆶𑆑𑇀𑆬𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆪 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇗𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆳𑆤𑆴 𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆓𑆶𑆫𑆷𑆟𑆴 𑆖𑇅 𑆃𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆂 𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆱𑆶𑆒𑆼 𑆫𑆠𑆴𑆂𑇆𑇑𑇘𑇆
𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆳𑆠𑆱𑆼𑆮𑆳 𑆯𑆵𑆠𑆿 𑆖 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆮𑆖𑆴𑆤𑇀𑆠𑆤𑆩𑇀𑇅 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆳𑆟𑆳𑆁 𑆱𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆩𑆼𑆠𑆠𑇀 𑆑𑆳𑆫𑆟𑆩𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇆𑇑𑇙𑇆
𑆲𑆼𑆠𑆶𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑆴 𑆖𑇅 𑆱𑆫𑇀𑆮𑆾 𑆲𑆼𑆠𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆲𑆘𑆽𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆽𑆂 𑆱𑆩𑆩𑇀𑇆𑇒𑇐𑇆
𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆾𑇁𑆤𑇀𑆤𑆱𑇀𑆪 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆑𑆶𑆑𑇀𑆰𑆼𑆫𑆳𑆛𑆾𑆥 𑆍𑆮 𑆖𑇅 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆩𑆶𑆢𑇀𑆓𑆳𑆫𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆁 𑆱𑆑𑇀𑆡𑆴𑆱𑆳𑆢𑆾𑇁𑆬𑇀𑆥𑆮𑆴𑆛𑇀𑆑𑆠𑆳𑇆𑇒𑇑𑇆
𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆫𑇀𑆠𑆼𑆫𑆳𑆯𑆕𑇀𑆑𑆳 𑆖𑆾𑆢𑆫𑆱𑇀𑆪 𑆖𑇅 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆱𑆳𑆩𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆪𑆼𑇆𑇒𑇒𑇆
𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆒𑆬𑆶 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆤𑆳𑆱𑆤𑇀𑆤𑆴𑆥𑆠𑆴𑆠𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆂𑇅 𑆢𑆾𑆰𑆽𑆫𑇀𑆢𑆾𑆰𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆂 𑆑𑆬𑇀𑆥𑇀𑆪𑆠𑆼𑇁𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇆𑇒𑇓𑇆
𑆥𑆚𑇀𑆖𑆳𑆠𑇀𑆩𑆳 𑆩𑆳𑆫𑆶𑆠𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆦𑆾 𑆓𑆶𑆢𑆮𑆬𑆴𑆠𑇀𑆫𑆪𑆩𑇀𑇅 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴 𑆓𑆶𑆢𑆘𑆳𑆤𑆳𑆁 𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆼𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆢𑆶𑆂𑆒𑆳𑆤𑆴 𑆧𑆲𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆑𑆫𑆳𑆟𑆴 𑆖𑇅 𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆾𑆥𑆠𑆳𑆥𑆵𑆤𑆴 𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆩𑆳𑆤𑆴 𑆖𑇆𑇒𑇕𑇆
𑆲𑆱𑇀𑆠𑆼 𑆥𑆳𑆢𑆼 𑆩𑆶𑆒𑆼 𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆓𑆶𑆢𑆼 𑆮𑆸𑆰𑆟𑆪𑆾𑆱𑇀𑆠𑆡𑆳𑇅 𑆯𑆾𑆡𑆾 𑆲𑆸𑆠𑇀𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆁 𑆖 𑆪𑆱𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆫𑇀𑆯𑆱𑆾 𑆲𑆴 𑆱𑆂𑇆𑇒𑇖𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆁 𑆱𑆩𑇀𑆩𑆾𑆲𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆕𑇀𑆓𑆱𑇀𑆪 𑆫𑆶𑆓𑇀 𑆘𑇀𑆮𑆫𑆂𑇅 𑆠𑆸𑆰𑇀𑆟𑆳 𑆓𑆶𑆢𑆱𑇀𑆪 𑆥𑆳𑆑𑆯𑇀𑆖 𑆤𑆴𑆲𑆤𑇀𑆪𑆫𑇀𑆓𑆶𑆢𑆘𑆳𑆠𑆶𑆫𑆩𑇀𑇆𑇒𑇗𑇆
𑆱𑆲𑆘𑆳𑆤𑆴 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆳𑆟𑆴 𑆪𑆳𑆤𑆴 𑆖𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆁 𑆮𑆬𑆴𑆩𑇀𑇅 𑆘𑆳𑆪𑆤𑇀𑆠𑆼𑇁𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆠𑆳𑆤𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇒𑇘𑇆
𑆯𑆾𑆰𑆠𑇀𑆮𑆳𑆢𑆳𑆪𑆶𑆰𑆱𑇀𑆠𑆳𑆤𑆴 𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆼𑇅 𑆪𑆳𑆥𑇀𑆪𑆤𑇀𑆠𑆼 𑆢𑆵𑆥𑇀𑆠𑆑𑆳𑆪𑆳𑆓𑇀𑆤𑆼𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑇀𑆪𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇆𑇒𑇙𑇆
𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆳𑆤𑆴 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳𑆪𑆳𑆁 𑆮𑆬𑆿 𑆪𑆳𑆤𑇀𑆪𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆖𑇅 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴 𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆂 𑆥𑆫𑆴𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆟𑆴 𑆖𑇆𑇓𑇐𑇆
𑆧𑆳𑆲𑇀𑆪𑆳𑆪𑆳𑆁 𑆠𑆶 𑆮𑆬𑆿 𑆘𑆳𑆠𑆳𑆤𑇀𑆪𑆼𑆑𑆢𑆾𑆰𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑆴 𑆖𑇅 𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴 𑆤 𑆖𑆴𑆫𑆾𑆠𑇀𑆥𑆳𑆠𑆠𑆳𑆤𑆴 𑆖𑇆𑇓𑇑𑇆
𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆯𑆩𑆤𑆼 𑆪𑆠𑇀𑆤𑆩𑆳𑆯𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇅 𑆠𑆳𑆤𑇀𑆪𑆳𑆯𑆶 𑆲𑆴 𑆓𑆶𑆢𑆁 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆶𑆫𑇀𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆾𑆢𑆫𑆩𑇀𑇆𑇓𑇒𑇆
𑆠𑆠𑇀𑆫𑆳𑆲𑆶𑆫𑆼𑆑𑆼 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆑𑆫𑇀𑆠𑆤𑆁 𑆲𑆴𑆠𑆩𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇅 𑆢𑆳𑆲𑆁 𑆑𑇀𑆰𑆳𑆫𑆼𑆟 𑆖𑆳𑆥𑇀𑆪𑆼𑆑𑆼, 𑆢𑆳𑆲𑆩𑆼𑆑𑆼 𑆠𑆡𑆳𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑇆𑇓𑇓𑇆
𑆃𑆱𑇀𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆨𑆷𑆫𑆴𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆟 𑆣𑆵𑆩𑆠𑆳 𑆢𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆟𑆳𑇅 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩 𑆨𑇀𑆫𑆁𑆯𑆱𑇀𑆠𑆠𑇀𑆫 𑆱𑆶𑆢𑆳𑆫𑆶𑆟𑆂𑇆𑇓𑇔𑇆
𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆾𑆥𑆔𑆳𑆠𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆓𑆶𑆢𑆼 𑆮𑆼𑆓𑆮𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆂𑇅 𑆄𑆣𑇀𑆩𑆳𑆤𑆁 𑆢𑆳𑆫𑆶𑆟𑆁 𑆯𑆷𑆬𑆁 𑆮𑇀𑆪𑆡𑆳 𑆫𑆑𑇀𑆠𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇆𑇓𑇕𑇆
𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆫𑆾𑆲𑆾 𑆫𑆷𑆞𑆳𑆤𑆳𑆁 𑆑𑇀𑆬𑆼𑆢𑆾 𑆨𑇀𑆫𑆁𑆯𑆾 𑆓𑆶𑆢𑆱𑇀𑆪 𑆖𑇅 𑆩𑆫𑆟𑆁 𑆮𑆳 𑆨𑆮𑆼𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆮𑆴𑆨𑇀𑆫𑆩𑆳𑆠𑇀𑇆𑇓𑇖𑇆
𑆪𑆠𑇀𑆠𑆶 𑆑𑆫𑇀𑆩 𑆱𑆶𑆒𑆾𑆥𑆳𑆪𑆩𑆬𑇀𑆥𑆨𑇀𑆫𑆁𑆯𑆩𑆢𑆳𑆫𑆶𑆟𑆩𑇀𑇅 𑆠𑆢𑆫𑇀𑆯𑆱𑆳𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆮𑆴𑆮𑆸𑆠𑇀𑆠𑆪𑆼𑇆𑇓𑇗𑇆
𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆂 𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆠𑆢𑇀𑆮𑆴𑆢𑆂𑇅 𑆥𑇀𑆫𑆱𑇀𑆫𑆳𑆮𑆵𑆟𑆴 𑆠𑆡𑆳𑇁𑇁𑆫𑇀𑆢𑇀𑆫𑆳𑆟𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆬𑇀𑆧𑆟𑆳𑆤𑆴 𑆖𑇆𑇓𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑆶𑆰𑇀𑆑𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆱𑇀𑆠𑆧𑇀𑆣𑆳𑆤𑆴 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑆾𑆦𑆯𑆷𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆤𑆴 𑆖𑇆𑇓𑇙𑇆
𑆯𑆑𑇀𑆠𑆷𑆤𑆳𑆁 𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆳𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆳𑆁 𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆯𑆶𑆰𑇀𑆑𑆩𑆷𑆬𑆑𑆥𑆴𑆟𑇀𑆝𑆽𑆫𑇀𑆮𑆳 𑆥𑆴𑆟𑇀𑆝𑆽𑆫𑇀𑆮𑆳 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆴𑆑𑆽𑆂𑇆𑇔𑇒𑇆
𑆫𑆳𑆱𑇀𑆤𑆳𑆥𑆴𑆟𑇀𑆝𑆽𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆳 𑆱𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑇀𑆲𑆳𑆥𑆶𑆰𑆽𑆫𑆥𑆴𑇅 𑆅𑆰𑇀𑆛𑆑𑆱𑇀𑆪 𑆒𑆫𑆳𑆲𑇀𑆮𑆳𑆪𑆳𑆂 𑆯𑆳𑆑𑆽𑆫𑇀𑆓𑆸𑆚𑇀𑆘𑆤𑆑𑆱𑇀𑆪 𑆮𑆳𑇆𑇔𑇓𑇆
𑆃𑆨𑇀𑆪𑆘𑇀𑆪 𑆑𑆶𑆰𑇀𑆜𑆠𑆽𑆬𑆼𑆤 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑆥𑆾𑆛𑇀𑆛𑆬𑆵𑆑𑆸𑆠𑆽𑆂𑇅 𑆮𑆸𑆰𑆳𑆫𑇀𑆑𑆽𑆫𑆟𑇀𑆝𑆧𑆴𑆬𑇀𑆮𑆳𑆤𑆳𑆁 𑆥𑆠𑇀𑆫𑆾𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑆽𑆯𑇀𑆖 𑆱𑆼𑆖𑆪𑆼𑆠𑇀𑇆𑇔𑇔𑇆
𑆩𑆷𑆬𑆑𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑇀𑆑𑆳𑆟𑆳𑆁 𑆮𑆼𑆟𑆷𑆤𑆳𑆁 𑆮𑆫𑆶𑆟𑆱𑇀𑆪 𑆖𑇅 𑆃𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆱𑇀𑆪 𑆯𑆴𑆓𑇀𑆫𑆾𑆯𑇀𑆖 𑆥𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆱𑇀𑆪 𑆖𑇆𑇔𑇕𑇆
𑆘𑆬𑆼𑆤𑆾𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆯𑆷𑆬𑆳𑆫𑇀𑆠𑆁 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆩𑆮𑆓𑆳𑆲𑆪𑆼𑆠𑇀𑇅 𑆑𑆾𑆬𑆾𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑆼𑇁𑆡𑆮𑆳 𑆑𑆾𑆰𑇀𑆟𑆼 𑆱𑆿𑆮𑆵𑆫𑆑𑆠𑆶𑆰𑆾𑆢𑆑𑆼𑇆𑇔𑇖𑇆
𑆧𑆴𑆬𑇀𑆮𑆑𑇀𑆮𑆳𑆡𑆼𑇁𑆡𑆮𑆳 𑆠𑆑𑇀𑆫𑆼 𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆳𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆼𑇅 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼 𑆮𑆳 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼 𑆠𑆁 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆩𑆮𑆓𑆳𑆲𑆪𑆼𑆠𑇀𑇆𑇔𑇗𑇆
𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆮𑆫𑆳𑆲𑆾𑆰𑇀𑆛𑇀𑆫𑆘𑆠𑆶𑆑𑆳𑆮𑆸𑆰𑆢𑆁𑆯𑆘𑆳𑆩𑇀𑇅 𑆮𑆱𑆳𑆩𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆼 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆣𑆷𑆥𑆤𑆁 𑆖𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆲𑆴𑆠𑆩𑇀𑇆𑇔𑇘𑇆
𑆤𑆸𑆑𑆼𑆯𑆳𑆂 𑆱𑆫𑇀𑆥𑆤𑆴𑆫𑇀𑆩𑆾𑆑𑆾 𑆮𑆸𑆰𑆢𑆁𑆯𑆱𑇀𑆪 𑆖𑆫𑇀𑆩 𑆖𑇅 𑆃𑆫𑇀𑆑𑆩𑆷𑆬𑆁 𑆯𑆩𑆵𑆥𑆠𑇀𑆫𑆩𑆫𑇀𑆯𑆾𑆨𑇀𑆪𑆾 𑆣𑆷𑆥𑆤𑆁 𑆲𑆴𑆠𑆩𑇀𑇆𑇔𑇙𑇆
𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆷𑆟𑆴 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆴 𑆢𑆼𑆮𑆢𑆳𑆫𑇀𑆮𑆑𑇀𑆰𑆠𑆳 𑆔𑆸𑆠𑆩𑇀𑇅 𑆧𑆸𑆲𑆠𑆵 𑆖𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳 𑆖 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆱𑆶𑆫𑆱𑆳 𑆔𑆸𑆠𑆩𑇀𑇆𑇕𑇐𑇆
𑆮𑆫𑆳𑆲𑆮𑆸𑆰𑆮𑆴𑆛𑇀 𑆖𑆽𑆮 𑆣𑆷𑆥𑆤𑆁 𑆱𑆑𑇀𑆠𑆮𑆾 𑆔𑆸𑆠𑆩𑇀𑇅 𑆑𑆶𑆚𑇀𑆘𑆫𑆱𑇀𑆪 𑆥𑆶𑆫𑆵𑆰𑆁 𑆠𑆶 𑆔𑆸𑆠𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆱𑇀𑆠𑆡𑆳𑇆𑇕𑇑𑇆

𑆪𑆢𑇀𑆣𑆴 𑆩𑆳𑆤𑆁 𑆠𑆶𑆬𑆳 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆥𑆬𑆁 𑆮𑆳 𑆠𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆃𑆤𑆶𑆑𑇀𑆠𑆼 𑆥𑆫𑆴𑆩𑆳𑆟𑆼 𑆠𑆶 𑆠𑆶𑆬𑇀𑆪𑆁 𑆩𑆳𑆤𑆁 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀𑇆𑇙𑇙𑇆
𑆢𑇀𑆫𑆮𑆑𑆳𑆫𑇀𑆪𑆼𑇁𑆥𑆴 𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆼 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆱𑆬𑆴𑆬𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇅 𑆪𑆠𑆯𑇀𑆖 𑆥𑆳𑆢𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆱𑇀𑆠𑆠𑆯𑇀𑆖 𑆱𑆂𑇆𑇑𑇐𑇐𑇆
𑆘𑆬𑆱𑇀𑆤𑆼𑆲𑆿𑆰𑆣𑆳𑆤𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆪𑆠𑇀𑆫 𑆤𑆼𑆫𑆴𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆱𑇀𑆪𑆳𑆢𑆿𑆰𑆣𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑇀𑆠𑆾𑆪𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀𑇆𑇑𑇐𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆑𑆱𑇀𑆠𑇀𑆫𑆴𑆣𑆳 𑆘𑇀𑆚𑆼𑆪𑆾 𑆩𑆸𑆢𑆶𑆫𑇀𑆩𑆣𑇀𑆪𑆂 𑆒𑆫𑆱𑇀𑆠𑆡𑆳𑇅 𑆠𑆶𑆬𑇀𑆪𑆼 𑆑𑆬𑇀𑆑𑆼𑆤 𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆼 𑆨𑆼𑆰𑆘𑆳𑆤𑆳𑆁 𑆩𑆸𑆢𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇑𑇐𑇒𑇆
𑆱𑆁𑆪𑆳𑆮 𑆅𑆮 𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆼 𑆩𑆣𑇀𑆪𑆾 𑆢𑆫𑇀𑆮𑆵𑆁 𑆮𑆴𑆩𑆶𑆚𑇀𑆖𑆠𑆴𑇅 𑆯𑆵𑆫𑇀𑆪𑆩𑆳𑆟𑆼 𑆠𑆶 𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆼 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆼 𑆒𑆫𑆱𑇀𑆠𑆡𑆳𑇆𑇑𑇐𑇓𑇆
𑆒𑆫𑆾𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆱𑇀𑆩𑆸𑆠𑆂 𑆥𑆳𑆑𑆾, 𑆩𑆸𑆢𑆶𑆫𑇀𑆤𑆱𑇀𑆠𑆂𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆖𑇅 𑆩𑆣𑇀𑆪𑆥𑆳𑆑𑆁 𑆠𑆶 𑆥𑆳𑆤𑆳𑆫𑇀𑆡𑆼 𑆧𑆱𑇀𑆠𑆿 𑆖 𑆮𑆴𑆤𑆴𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇔𑇆
𑆩𑆳𑆤𑆁 𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆥𑇀𑆫𑆳𑆲𑆶𑆂 𑆑𑆳𑆬𑆴𑆕𑇀𑆓𑆁 𑆩𑆳𑆓𑆣𑆁 𑆠𑆡𑆳𑇅 𑆑𑆳𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆩𑆳𑆓𑆣𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆼𑆮𑆁 𑆩𑆳𑆤𑆮𑆴𑆢𑆾 𑆮𑆴𑆢𑆶𑆂𑇆𑇑𑇐𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆑𑆬𑇀𑆥𑆳𑆫𑇀𑆡𑆂 𑆯𑆾𑆣𑆤𑆁 𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆥𑆸𑆡𑆓𑇀𑆔𑆼𑆠𑆶𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆼𑇅 𑆢𑆼𑆯𑆳𑆢𑆵𑆤𑆳𑆁 𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆓𑆶𑆟𑆳 𑆪𑆾𑆓𑆯𑆠𑆳𑆤𑆴 𑆰𑆛𑇀𑇆𑇑𑇐𑇖𑇆
𑆮𑆴𑆑𑆬𑇀𑆥𑆲𑆼𑆠𑆶𑆫𑇀𑆤𑆳𑆩𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆣𑇀𑆪𑆳𑆬𑇀𑆥𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆑𑆾 𑆩𑆳𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆑𑆯𑇀𑆖 𑆢𑆫𑇀𑆯𑆴𑆠𑆂𑇆𑇑𑇐𑇗𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆨𑆪𑆳𑆩𑆬𑆑𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆥𑆳𑆢𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆲𑆫𑆁 𑆥𑆡𑇀𑆪𑆁 𑆱𑆳𑆣𑆤𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆲𑆴𑆠𑆩𑇀𑇆𑇓𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆤𑆳𑆩𑆳𑆤𑆴, ...𑇅𑇔𑇅  𑆨𑆼𑆰𑆘𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆖 𑆠𑆠𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪𑆾𑆫𑇀𑆘𑆱𑇀𑆑𑆫𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆳𑆫𑇀𑆠𑆱𑇀𑆪 𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇔𑇆
𑆃𑆨𑆼𑆰𑆘𑆁 𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆧𑆳𑆣𑆤𑆁 𑆱𑆳𑆤𑆶𑆧𑆳𑆣𑆤𑆩𑇀𑇅𑇕𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪𑆾𑆫𑇀𑆘𑆱𑇀𑆑𑆫𑆁 𑆪𑆠𑇀𑆠𑆶 𑆠𑆢𑇀𑆮𑆸𑆰𑇀𑆪𑆁 𑆠𑆢𑇀𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇕𑇆
𑆥𑇀𑆫𑆳𑆪𑆂, 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆥𑇀𑆫𑆯𑆩𑆼 𑆩𑆠𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆪𑆂𑆯𑆧𑇀𑆢𑆾 𑆮𑆴𑆯𑆼𑆰𑆳𑆫𑇀𑆡𑆾 𑆲𑇀𑆪𑆶𑆨𑆪𑆁 𑆲𑇀𑆪𑆶𑆨𑆪𑆳𑆫𑇀𑆡𑆑𑆸𑆠𑇀𑇆𑇖𑇆
𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆁 𑆩𑆼𑆣𑆳𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆠𑆫𑆶𑆟𑆁 𑆮𑆪𑆂𑇅 𑆥𑇀𑆫𑆨𑆳𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆿𑆢𑆳𑆫𑇀𑆪𑆁 𑆢𑆼𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆁 𑆥𑆫𑆩𑇀𑇆𑇗𑇆
𑆮𑆳𑆑𑇀𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆟𑆠𑆴𑆁 𑆑𑆳𑆤𑇀𑆠𑆴𑆁 𑆬𑆨𑆠𑆼 𑆤𑆳 𑆫𑆱𑆳𑆪𑆤𑆳𑆠𑇀𑇅 𑆬𑆳𑆨𑆾𑆥𑆳𑆪𑆾 𑆲𑆴 𑆯𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇘𑇆
𑆃𑆥𑆠𑇀𑆪𑆱𑆤𑇀𑆠𑆳𑆤𑆑𑆫𑆁 𑆪𑆠𑇀 𑆱𑆢𑇀𑆪𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆟𑆩𑇀𑇅 𑆮𑆳𑆘𑆵𑆮𑆳𑆠𑆴𑆧𑆬𑆾 𑆪𑆼𑆤 𑆪𑆳𑆠𑇀𑆪𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂𑇆𑇙𑇆
𑆨𑆮𑆠𑇀𑆪𑆠𑆴𑆥𑇀𑆫𑆴𑆪𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆪𑆼𑆤 𑆪𑆼𑆤𑆾𑆥𑆖𑆵𑆪𑆠𑆼𑇅 𑆘𑆵𑆫𑇀𑆪𑆠𑆾𑇁𑆥𑇀𑆪𑆑𑇀𑆰𑆪𑆁 𑆯𑆶𑆑𑇀𑆫𑆁 𑆦𑆬𑆮𑆢𑇀𑆪𑆼𑆤 𑆢𑆸𑆯𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆨𑆷𑆠𑆯𑆳𑆒𑆂 𑆯𑆳𑆒𑆵𑆮 𑆪𑆼𑆤 𑆖𑆽𑆠𑇀𑆪𑆾 𑆪𑆡𑆳 𑆩𑆲𑆳𑆤𑇀𑇅 𑆨𑆮𑆠𑇀𑆪𑆫𑇀𑆖𑇀𑆪𑆾 𑆧𑆲𑆶𑆩𑆠𑆂 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁 𑆱𑆶𑆧𑆲𑆶𑆥𑇀𑆫𑆘𑆂𑇆𑇑𑇑𑇆
𑆱𑆤𑇀𑆠𑆳𑆤𑆩𑆷𑆬𑆁 𑆪𑆼𑆤𑆼𑆲 𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆖𑆳𑆤𑆤𑇀𑆠𑇀𑆪𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇅 𑆪𑆯𑆂 𑆯𑇀𑆫𑆴𑆪𑆁 𑆧𑆬𑆁 𑆥𑆶𑆰𑇀𑆛𑆴𑆁 𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆩𑆼𑆮 𑆠𑆠𑇀𑇆𑇑𑇒𑇆
𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪𑆾𑆫𑇀𑆘𑆱𑇀𑆑𑆫𑆁 𑆠𑇀𑆮𑆼𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆪𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆫𑇀𑆔𑆳𑆠𑆑𑆫𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆠𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑇆𑇑𑇓𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆫𑇀𑆡 𑆍𑆠𑆳𑆮𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆪𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑆳𑆓𑇀𑆫𑆼 𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆩𑆼𑆮 𑆖𑇆𑇑𑇔𑇆
𑆃𑆨𑆼𑆰𑆘𑆩𑆴𑆠𑆴 𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆪𑆢𑆿𑆰𑆣𑆳𑆠𑇀𑇅 𑆠𑆢𑆱𑆼𑆮𑇀𑆪𑆁 𑆤𑆴𑆰𑆼𑆮𑇀𑆪𑆁 𑆠𑆶 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆪𑆢𑆿𑆰𑆣𑆩𑇀𑇆𑇑𑇕𑇆
𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆩𑆸𑆰𑆪𑆾 𑆮𑆴𑆢𑆶𑆂𑇅 𑆑𑆶𑆛𑆵𑆥𑇀𑆫𑆳𑆮𑆼𑆯𑆴𑆑𑆁 𑆖𑆽𑆮 𑆮𑆳𑆠𑆳𑆠𑆥𑆴𑆑𑆩𑆼𑆮 𑆖𑇆𑇑𑇖𑇆
𑆑𑆶𑆛𑆵𑆥𑇀𑆫𑆳𑆮𑆼𑆯𑆴𑆑𑆱𑇀𑆪𑆳𑆢𑆿 𑆮𑆴𑆣𑆴𑆂 𑆱𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆤𑆸𑆥𑆮𑆽𑆢𑇀𑆪𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆵𑆤𑆳𑆁 𑆱𑆳𑆣𑆷𑆤𑆳𑆁 𑆥𑆶𑆟𑇀𑆪𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀𑇆𑇑𑇗𑇆

𑆱𑆼𑆮𑆼𑆠 𑆮𑆳 𑆩𑆫𑆴𑆖𑆘𑆵𑆫𑆑𑆤𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆮𑆴𑆯𑇀𑆮𑆖𑆮𑆴𑆑𑆽𑆬𑆪𑆶𑆠𑆳𑆤𑇀 𑆫𑆱𑆳𑆁𑆯𑇀𑆖 𑇅 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆩𑇀𑆧𑆫𑆱𑇀𑆫𑆶𑆠𑆲𑆴𑆩𑆳𑆁𑆯𑇀𑆖 𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆓𑆤𑇀𑆣𑆳𑆤𑇀 𑆥𑆳𑆤𑆾𑆢𑇀𑆨𑆮𑆳𑆤𑇀𑆤𑆶𑆢𑆠𑆴 𑆱𑆥𑇀𑆠𑆓𑆢𑆳𑆤𑆯𑆼𑆰𑆳𑆤𑇀 𑇆𑇔𑇒𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆮𑆴𑆰𑆪𑆳 𑆩𑆸𑆢𑆶𑆥𑆳𑆤𑆪𑆾𑆓𑆳 𑆲𑆸𑆢𑇀𑆪𑆳𑆂 𑆱𑆶𑆒𑆳𑆯𑇀𑆖 𑆩𑆤𑆱𑆂 𑆱𑆠𑆠𑆁 𑆤𑆴𑆰𑆼𑆮𑇀𑆪𑆳𑆂 𑇅 𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆼𑆰𑆶 𑆮𑆴𑆑𑆛𑆾𑆫𑆶𑆤𑆴𑆠𑆩𑇀𑆧𑆮𑆠𑇀𑆪𑆂 𑆥𑆵𑆤𑆾𑆤𑇀𑆤𑆠𑆱𑇀𑆠𑆤𑆨𑆫𑆳𑆤𑆠𑆩𑆣𑇀𑆪𑆢𑆼𑆯𑆳𑆂 𑇆𑇔𑇓𑇆
𑆥𑇀𑆫𑆿𑆞𑆳𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆾𑇁𑆨𑆴𑆤𑆮𑆪𑆿𑆮𑆤𑆥𑆵𑆤𑆓𑆳𑆠𑇀𑆫𑇀𑆪𑆂 𑆱𑆼𑆮𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆚𑇀𑆖𑆮𑆴𑆰𑆪𑆳𑆠𑆴𑆯𑆪𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆂 𑇆𑇔𑇔𑇆
𑆥𑆴𑆧𑆼𑆢𑇀𑆫𑆱𑆁 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆾𑆢𑇀𑆨𑆮𑆁 𑆮𑆳 𑆱𑆴𑆠𑆳𑆩𑆣𑆷𑆑𑆠𑇀𑆫𑆴𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆩𑇀 𑇅 𑆱𑆚𑇀𑆖𑆷𑆫𑇀𑆟𑇀𑆪 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆖 𑆤𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑆘𑆳𑆘𑆴𑆑𑆸𑆰𑇀𑆟𑆳𑆩𑆫𑆴𑆖𑆽𑆯𑇀𑆖 𑆠𑆶𑆬𑇀𑆪𑆽𑆂 𑇆𑇔𑇕𑇆
𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆩𑆣𑆷𑆑𑆬𑆳𑆑𑇀𑆰𑆳𑆠𑇀𑆮𑆑𑇀𑆑𑆫𑇀𑆧𑆶𑆢𑆳𑆫𑆳𑆕𑇀𑆑𑆶𑆫𑆘𑆵𑆫𑆑𑆳𑆟𑆴 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆖 𑆑𑆸𑆰𑇀𑆟𑆳𑆩𑆡 𑆑𑆼𑆯𑆫𑆁 𑆖 𑆑𑇀𑆰𑆵𑆫𑆼 𑆱𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆶𑆒𑆼𑆥𑇀𑆱𑆶𑆂 𑇆𑇔𑇖𑇆
𑆨𑆮𑆼𑆖𑇀𑆖 𑆩𑆢𑇀𑆪𑆼𑆤 𑆠𑆶 𑆪𑆼𑆤 𑆥𑆳𑆠𑆴𑆠𑆂 𑆥𑇀𑆫𑆑𑆳𑆩𑆥𑆵𑆠𑆼𑆤 𑆱𑆶𑆫𑆳𑆱𑆮𑆳𑆢𑆴𑆤𑆳 𑇅 𑆠𑆢𑆼𑆮 𑆠𑆱𑇀𑆩𑆽 𑆮𑆴𑆣𑆴𑆮𑆠𑇀 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆢𑇀𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼 𑆨𑇀𑆫𑆁𑆯𑆩𑆮𑆯𑇀𑆪𑆩𑆸𑆖𑇀𑆗𑆠𑆴 𑇆𑇔𑇗𑇆
𑆪𑆡𑆳 𑆤𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆾𑆥𑆲𑆠𑆱𑇀𑆪 𑆑𑆱𑇀𑆪𑆖𑆴𑆢𑇀𑆨𑆮𑆼𑆠𑇀 𑆥𑇀𑆫𑆱𑆳𑆢𑆱𑇀𑆠𑆠 𑆍𑆮 𑆤𑆳𑆤𑇀𑆪𑆠𑆂 𑇅 𑆣𑇀𑆫𑆶𑆮𑆁 𑆠𑆡𑆳 𑆩𑆢𑇀𑆪𑆲𑆠𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆾 𑆨𑆮𑆼𑆠𑇀 𑆥𑇀𑆫𑆱𑆳𑆢𑆱𑇀𑆠𑆠 𑆍𑆮 𑆤𑆳𑆤𑇀𑆪𑆠𑆂 𑇆𑇔𑇘𑇆
𑆮𑆴𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆩𑆢𑇀𑆪𑆂 𑆱𑆲𑆱𑆳 𑆪𑆾𑇁𑆠𑆴𑆩𑆢𑇀𑆪𑆁 𑆤𑆴𑆰𑆼𑆮𑆠𑆼 𑇅 𑆠𑆱𑇀𑆪 𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇔𑇙𑇆
𑆩𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆿 𑆓𑆶𑆟𑆳𑆮𑆩𑇀𑆧𑆶(𑆩𑇀𑆨𑆾)𑆮𑆲𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆯𑆾𑆰𑆪𑆼𑆪𑆳𑆠𑆳𑆁 𑆠𑆼𑆤 𑆠𑆸𑆰𑇀𑆟𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇆𑇕𑇐𑇆
𑆥𑆳𑆛𑆬𑆾𑆠𑇀𑆥𑆬𑆑𑆤𑇀𑆢𑆼𑆰𑆶 𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆁 𑆖 𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇅 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆳𑆓𑆣𑆴𑆑𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆁 𑆠𑆠𑇀𑆫𑆳𑆩𑇀𑆨𑆾 𑆲𑆴𑆩𑆯𑆵𑆠𑆬𑆩𑇀 𑇆𑇕𑇑𑇆
𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆢𑆣𑆴𑆨𑆸𑆕𑇀𑆓𑆫𑆱𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀 𑇅 𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆧𑆴𑆬𑇀𑆮𑆪𑆮𑆪𑆾𑆂 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆽𑆯𑇀𑆖 𑆥𑆼𑆰𑆴𑆠𑆽𑆂 𑇆𑇕𑇒𑇆
𑆥𑆑𑇀𑆮𑆩𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁...𑆱𑆼𑆑𑆼 𑆑𑇀𑆮𑆳𑆡𑆯𑇀𑆖 𑆯𑆵𑆠𑆬𑆂 𑇅𑇕𑇓𑇅 𑆫𑆱𑆮𑆤𑇀𑆠𑆴 𑆖 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇕𑇓𑇆
𑆥𑆳𑆤𑆑𑆳𑆤𑆴 𑆱𑆶𑆯𑆵𑆠𑆳𑆤𑆴 𑆲𑆸𑆢𑇀𑆪𑆳𑆤𑆴 𑆱𑆶𑆫𑆨𑆵𑆟𑆴 𑆖 𑇅 𑆠𑇀𑆮𑆖𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆱𑇀𑆠𑆶 𑆥𑆳𑆤𑆾𑆰𑇀𑆩𑆳 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆨𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆂 𑇅 𑆢𑆳𑆲𑆁 𑆥𑇀𑆫𑆑𑆶𑆫𑆶𑆠𑆼 𑆔𑆾𑆫𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆠𑇀𑆠𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆩𑇀 𑇆𑇕𑇔𑇆
𑆯𑆵𑆠𑆁 𑆮𑆴𑆣𑆳𑆤𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆲𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆼 𑆢𑆳𑆲𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆑𑆫𑆩𑆸𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆁 𑆤𑆫𑆳𑆟𑆳𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆠𑆾 𑆩𑆬𑆪𑆘𑆼𑆤 𑆲𑆴𑆠𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆯𑇀𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆁𑆯𑆶𑆲𑆳𑆫𑆠𑆶𑆲𑆴𑆤𑆾𑆢𑆑𑆯𑆵𑆠𑆬𑆼𑆤 𑇆𑇕𑇕𑇆
𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆯𑆵𑆠𑆬𑆠𑆫𑆽𑆯𑇀𑆖 𑆯𑆪𑆳𑆤𑆩𑆼𑆤𑆁 𑆲𑆳𑆫𑆽𑆫𑇀𑆩𑆸𑆟𑆳𑆬𑆮𑆬𑆪𑆽𑆫𑆧𑆬𑆳𑆂 𑆱𑇀𑆥𑆸𑆯𑆼𑆪𑆶𑆂 𑇅 𑆨𑆴𑆤𑇀𑆤𑆾𑆠𑇀𑆥𑆬𑆾𑆘𑇀𑆘𑇀𑆮𑆬𑆲𑆴𑆩𑆼 𑆯𑆪𑆤𑆼 𑆯𑆪𑆵𑆠 𑆥𑆠𑇀𑆫𑆼𑆰𑆶 𑆮𑆳 𑆱𑆘𑆬𑆧𑆴𑆤𑇀𑆢𑆶𑆰𑆶 𑆥𑆢𑇀𑆩𑆴𑆤𑆵𑆤𑆳𑆩𑇀 𑇆𑇕𑇖𑇆
𑆄𑆱𑆳𑆢𑆪𑆤𑇀 𑆥𑆮𑆤𑆩𑆳𑆲𑆸𑆠𑆩𑆕𑇀𑆓𑆤𑆳𑆨𑆴𑆂 𑆑𑆲𑇀𑆬𑆳𑆫𑆥𑆢𑇀𑆩𑆢𑆬𑆯𑆽𑆮𑆬𑆱𑆚𑇀𑆖𑆪𑆼𑆰𑆶 𑇅 𑆑𑆳𑆤𑇀𑆠𑆽𑆫𑇀𑆮𑆤𑆳𑆤𑇀𑆠𑆥𑆮𑆤𑆽𑆂 𑆥𑆫𑆴𑆩𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆂 𑆯𑆑𑇀𑆠𑆯𑇀𑆖𑆫𑆼𑆢𑇀𑆨𑆮𑆤𑆑𑆳𑆤𑆤𑆢𑆵𑆫𑇀𑆔𑆴𑆑𑆳𑆱𑆶 𑇆𑇕𑇗𑇆
𑆢𑆳𑆲𑆳𑆨𑆴𑆨𑆷𑆠𑆩𑆡𑆮𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀𑆠𑆶 𑆬𑆳𑆩𑆘𑇀𑆘𑆑𑆳𑆩𑇀𑆧𑆶𑆫𑆶𑆲𑆖𑆤𑇀𑆢𑆤𑆠𑆾𑆪𑆠𑆾𑆪𑆽𑆂 𑇅 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆠𑆳𑆁 𑆲𑆸𑆠𑆩𑆬𑆳𑆁 𑆤𑆮𑆮𑆳𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆳𑆁 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆳𑆑𑆶𑆬𑆘𑆬𑆳𑆩𑆣𑆴𑆮𑆳𑆱𑆴𑆠𑆳𑆩𑇀𑆧𑆶𑆩𑇀 𑇆𑇕𑇘𑇆
𑆮𑆳𑆥𑆵𑆁 𑆨𑆘𑆼𑆠 𑆲𑆫𑆴𑆖𑆤𑇀𑆢𑆤𑆨𑆷𑆰𑆴𑆠𑆳𑆕𑇀𑆓𑆂 𑆑𑆳𑆤𑇀𑆠𑆳𑆑𑆫𑆱𑇀𑆥𑆸𑆯𑆤𑆑𑆫𑇀𑆑𑆯𑆫𑆾𑆩𑆑𑆷𑆥𑆂 𑇅 𑆠𑆠𑇀𑆫𑆽𑆤𑆩𑆩𑇀𑆧𑆶𑆫𑆶𑆲𑆥𑆠𑇀𑆫𑆱𑆩𑆽𑆂 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑇀𑆪𑆂 𑆯𑆵𑆠𑆽𑆂 𑆑𑆫𑆾𑆫𑆶𑆮𑆢𑆤𑆽𑆂 𑆑𑆜𑆴𑆤𑆽𑆂 𑆱𑇀𑆠𑆤𑆽𑆯𑇀𑆖 𑇆𑇕𑇙𑇆
𑆠𑆾𑆪𑆳𑆮𑆓𑆳𑆲𑆑𑆶𑆯𑆬𑆳 𑆩𑆣𑆶𑆫𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆂 𑆱𑆁𑆲𑆫𑇀𑆰𑆪𑆼𑆪𑆶𑆫𑆧𑆬𑆳𑆂 𑆱𑆶𑆑𑆬𑆽𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆽𑆂 𑇅 𑆣𑆳𑆫𑆳𑆓𑆸𑆲𑆼 𑆥𑇀𑆫𑆓𑆬𑆴𑆠𑆾𑆢𑆑𑆢𑆶𑆫𑇀𑆢𑆴𑆤𑆳𑆨𑆼 𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆂 𑆯𑆪𑆵𑆠 𑆱𑆬𑆴𑆬𑆳𑆤𑆴𑆬𑆯𑆵𑆠𑆑𑆶𑆑𑇀𑆰𑆿 𑇆𑇖𑇐𑇆
𑆓𑆤𑇀𑆣𑆾𑆢𑆑𑆽𑆂 𑆱𑆑𑆶𑆱𑆶𑆩𑆽𑆫𑆶𑆥𑆱𑆴𑆑𑇀𑆠𑆨𑆷𑆩𑆿 𑆥𑆠𑇀𑆫𑆳𑆩𑇀𑆧𑆶𑆖𑆤𑇀𑆢𑆤𑆫𑆱𑆽𑆫𑆶𑆥𑆬𑆴𑆥𑇀𑆠𑆑𑆶𑆝𑇀𑆪𑆼 𑇅 𑆘𑆳𑆠𑇀𑆪𑆶𑆠𑇀𑆥𑆬𑆥𑇀𑆫𑆴𑆪𑆑𑆑𑆼𑆯𑆫𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆥𑆶𑆤𑇀𑆤𑆳𑆓𑆤𑆳𑆓𑆑𑆫𑆮𑆵𑆫𑆑𑆸𑆠𑆾𑆥𑆖𑆳𑆫𑆼 𑇆𑇖𑇑𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆓𑆸𑆲𑆼 𑆑𑆩𑆬𑆫𑆼𑆟𑇀𑆮𑆫𑆶𑆟𑆼 𑆯𑆪𑆵𑆠 𑆪𑆠𑇀𑆤𑆳𑆲𑆸𑆠𑆳𑆤𑆴𑆬𑆮𑆴𑆑𑆩𑇀𑆥𑆴𑆠𑆥𑆶𑆰𑇀𑆥𑆢𑆳𑆩𑇀𑆤𑆴 𑇅 𑆲𑆼𑆩𑆤𑇀𑆠𑆮𑆴𑆤𑇀𑆣𑇀𑆪𑆲𑆴𑆩𑆮𑆤𑇀𑆩𑆬𑆪𑆳𑆖𑆬𑆳𑆤𑆳𑆁 𑆯𑆵𑆠𑆳𑆩𑇀𑆨𑆱𑆳𑆁 𑆱𑆑𑆢𑆬𑆵𑆲𑆫𑆴𑆠𑆢𑇀𑆫𑆶𑆩𑆳𑆟𑆳𑆩𑇀 𑇆𑇖𑇒𑇆

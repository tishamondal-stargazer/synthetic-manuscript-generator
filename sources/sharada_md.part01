𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆅𑆠𑇀𑆪𑆼𑆠𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆧𑆱𑇀𑆠𑆼𑆂 𑆱𑆳𑆑𑆸𑆠𑆴𑆨𑆼𑆰𑆘𑆳𑆂𑇅 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆠𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆵𑆤𑇀𑆤𑆴𑆪𑆶𑆚𑇀𑆘𑆤𑇀𑆤𑆳𑆥𑆫𑆳𑆣𑇀𑆪𑆠𑆴𑇆𑇖𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆱𑆸𑆠𑆪𑆾𑆓𑆵𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆡𑆼𑆩𑆳𑆤𑇀 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑆳𑆁 𑆤𑆴𑆫𑆷𑆲𑆳𑆤𑇀 𑆱𑇀𑆤𑆼𑆲𑆤𑆳𑆤𑇀 𑆩𑆸𑆢𑆷𑆤𑇀𑇅 𑆑𑆫𑇀𑆩𑆟𑆳 𑆮𑆴𑆥𑇀𑆬𑆶𑆠𑆳𑆤𑆳𑆁 𑆖 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆥𑇀𑆫𑆱𑆸𑆠𑆽𑆂 𑆥𑆸𑆡𑆑𑇀𑇆𑇓𑇆
𑆑𑇀𑆰𑆵𑆫𑆳𑆢𑇀𑆢𑇀𑆮𑆿 𑆥𑇀𑆫𑆱𑆸𑆠𑆿 𑆑𑆳𑆫𑇀𑆪𑆿 𑆩𑆣𑆶𑆠𑆽𑆬𑆔𑆸𑆠𑆳𑆠𑇀𑆠𑇀𑆫𑆪𑆂𑇅 𑆒𑆘𑆼𑆤 𑆩𑆡𑆴𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆔𑇀𑆤𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆑𑆸𑆠𑇀𑇆𑇔𑇆
𑆍𑆑𑆽𑆑𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆱𑇀𑆠𑆽𑆬𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆩𑇀𑇅 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆩𑆷𑆬𑆑𑇀𑆮𑆳𑆡𑆳𑆢𑇀𑆢𑇀𑆮𑆿 𑆑𑆿𑆬𑆠𑇀𑆡𑆳𑆢𑇀𑆢𑇀𑆮𑆿 𑆱 𑆮𑆳𑆠𑆤𑆶𑆠𑇀𑇆𑇕𑇆
𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆫𑆱𑆳𑆠𑇀 𑆥𑆚𑇀𑆖 𑆢𑇀𑆮𑆿 𑆠𑆽𑆬𑆳𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆂𑇅 𑆍𑆑𑆽𑆑𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆤𑆵𑆪𑆾𑇁𑆤𑆴𑆬𑆳𑆥𑆲𑆂𑇆𑇖𑇆
𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆫𑇀𑆣𑆳𑆑𑇀𑆰 𑆍𑆑𑆽𑆑𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆠𑆽𑆬𑆥𑆪𑆾𑆔𑆸𑆠𑆳𑆠𑇀𑇅 𑆥𑇀𑆫𑆱𑆸𑆠𑆾 𑆲𑆥𑆶𑆰𑆳𑆑𑆫𑇀𑆰𑆾 𑆤𑆴𑆫𑆷𑆲𑆂 𑆯𑆶𑆑𑇀𑆫𑆑𑆸𑆠𑇀 𑆥𑆫𑆩𑇀𑇆𑇗𑇆
𑆥𑆛𑆾𑆬𑆤𑆴𑆩𑇀𑆧𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆫𑆳𑆱𑇀𑆤𑆳𑆱𑆥𑇀𑆠𑆖𑇀𑆗𑆢𑆳𑆩𑇀𑆨𑆱𑆂𑇅 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆳 𑆍𑆑𑆾 𑆔𑆸𑆠𑆳𑆠𑇀 𑆱𑆫𑇀𑆰𑆥𑆑𑆬𑇀𑆑𑆴𑆠𑆂𑇆𑇘𑇆
𑆤𑆴𑆫𑆷𑆲𑆂 𑆥𑆚𑇀𑆖𑆠𑆴𑆑𑇀𑆠𑆾𑇁𑆪𑆁 𑆩𑆼𑆲𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆑𑆶𑆰𑇀𑆜𑆤𑆶𑆠𑇀 𑇅𑇙𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆯𑆴𑆓𑇀𑆫𑆶𑆦𑆬𑆩𑆶𑆱𑇀𑆠𑆳𑆒𑆶𑆥𑆫𑇀𑆟𑆴𑆘𑆳𑆠𑇀𑇆𑇙𑇆
𑆑𑆰𑆳𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑆥𑆚𑇀𑆖 𑆠𑆽𑆬𑆳𑆢𑆼𑆑𑆾 𑆮𑆴𑆩𑆡𑇀𑆪 𑆠𑆳𑆤𑇀𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆬𑇀𑆑𑆾 𑆤𑆴𑆫𑆷𑆲𑆂 𑆑𑇀𑆫𑆴𑆩𑆴𑆤𑆳𑆯𑆤𑆂𑇆𑇑𑇐𑇆
𑆥𑆪𑆱𑇀𑆪𑆼𑆑𑇀𑆰𑆶𑆱𑇀𑆡𑆴𑆫𑆳𑆫𑆳𑆱𑇀𑆤𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆩𑇀𑇅 𑆍𑆑𑆽𑆑𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆂 𑆑𑆸𑆰𑇀𑆟𑆳𑆑𑆬𑇀𑆑𑆾 𑆮𑆸𑆰𑆠𑇀𑆮𑆑𑆸𑆠𑇀𑇆𑇑𑇑𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆱𑇀𑆠𑆽𑆬𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆳𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆳𑆠𑇀𑇅 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑆱𑆫𑇀𑆰𑆥𑆽𑆂 𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆴𑆛𑇀𑆱𑆕𑇀𑆓𑆳𑆤𑆳𑆲𑆨𑆼𑆢𑆤𑆂 𑇆𑇑𑇒𑇆
𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑇀𑆩𑆨𑆴𑆢𑆼𑆫𑆟𑇀𑆝𑆫𑆱𑆳𑆠𑇀𑆠𑆽𑆬𑆳𑆠𑇀 𑆱𑆶𑆫𑆳𑆱𑆮𑆳𑆠𑇀𑇅 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑆥𑆚𑇀𑆖 𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆑𑆿𑆤𑇀𑆠𑆵𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆱𑆴𑆠𑆳𑆂𑇆𑇑𑇓𑇆
𑆑𑆬𑇀𑆑𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆠𑆶 𑆱𑆳𑆤𑆳𑆲𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆠𑇀𑆠𑆩𑆂𑇅 𑆍𑆠𑆼 𑆱𑆬𑆮𑆟𑆳𑆂 𑆑𑆾𑆰𑇀𑆟𑆳 𑆤𑆴𑆫𑆷𑆲𑆳𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆽𑆫𑇀𑆤𑆮𑇆𑇑𑇔𑇆
𑆩𑆸𑆢𑆶𑆧𑆱𑇀𑆠𑆴𑆘𑆝𑆵𑆨𑆷𑆠𑆼 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑇁𑆤𑇀𑆪𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆴𑆑𑆫𑇀𑆰𑆴𑆠𑆼 𑆱𑇀𑆮𑆳𑆢𑆶 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇑𑇕𑇆
𑆮𑆳𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆱𑇀𑆪𑆾𑆰𑇀𑆟𑆽𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆓𑆶𑆢𑆢𑆳𑆲𑆳𑆢𑆪𑆾 𑆪𑆢𑆴𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆑𑆬𑇀𑆑𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆩𑇀𑇆𑇑𑇖𑇆
𑆠𑆢𑇀𑆣𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑆑𑆸𑆢𑇀𑆮𑆳𑆠𑆳𑆤𑇀 𑆲𑆸𑆠𑇀𑆮𑆳 𑆢𑆳𑆲𑆳𑆢𑆴𑆑𑆳𑆚𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆯𑆶𑆢𑇀𑆣𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑆵𑆠𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆶𑆠𑆳𑆩𑇀𑇆𑇑𑇗𑇆
𑆃𑆡𑆮𑆳𑇁𑆠𑆴𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆰𑆵𑆟𑆮𑆴𑆛𑇀𑆑𑆂 𑆱 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇅 𑆩𑆳𑆰𑆪𑆷𑆰𑆼𑆟 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆤𑇀 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆣𑇀𑆮𑆡𑆮𑆳 𑆱𑆶𑆫𑆳𑆩𑇀𑇆𑇑𑇘𑇆
𑆱𑆳𑆩𑆁 𑆖𑆼𑆠𑇀 𑆑𑆶𑆟𑆥𑆁 𑆯𑆷𑆬𑆽𑆫𑆶𑆥𑆮𑆴𑆯𑆼𑆢𑆫𑆾𑆖𑆑𑆵𑇅 𑆱 𑆔𑆤𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆑𑆶𑆰𑇀𑆜𑆤𑆠𑆢𑆳𑆫𑆶𑆮𑆖𑆳𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇙𑇆
𑆯𑆑𑆸𑆢𑇀𑆮𑆳𑆠𑆩𑆱𑆸𑆑𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆦𑆁 𑆮𑆳 𑆪𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼𑇅 𑆥𑆑𑇀𑆮𑆁 , 𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆮𑆫𑇀𑆓𑆵𑆪𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆩𑇀𑇆𑇒𑇐𑇆
𑆰𑆟𑇀𑆟𑆳𑆩𑆼𑆰𑆳𑆁 𑆢𑇀𑆮𑆴𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀 𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆨𑆼𑆢𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆶𑇅 𑆑𑆼𑆮𑆬𑆽𑆂 𑆱𑆲 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑆥𑆴𑇆𑇒𑇑𑇆
𑆯𑆷𑆬𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆣𑇀𑆩𑆳𑆤𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑇀𑆪𑆫𑆶𑆖𑆴𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑇅 𑆠𑆸𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆢𑆳𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆵𑆁𑆯𑇀𑆖𑆽𑆰𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫𑆳𑆩𑆼𑇁𑆤𑇀𑆠𑆫𑆥𑆳𑆤𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆮𑇀𑆪𑆾𑆰𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀𑇅 𑆥𑆳𑆖𑆤𑆁 𑆯𑆱𑇀𑆪𑆠𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆳𑆩𑆼 𑆲𑆴 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆣𑇀𑆪𑆠𑆼𑇆𑇒𑇓𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆽𑆫𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆮𑆫𑇀𑆓𑆵𑆪𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆂 𑆯𑆑𑆸𑆠𑆴 𑆯𑆱𑇀𑆪𑆠𑆼𑇅𑇒𑇔𑇅 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆽𑆂 𑆯𑆱𑇀𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑆩𑆵𑆫𑆟𑆼𑇆𑇒𑇔𑇆
𑆫𑆑𑇀𑆠𑆼 𑆫𑆑𑇀𑆠𑆼𑆤, 𑆥𑆴𑆠𑇀𑆠𑆼 𑆠𑆶 𑆑𑆰𑆳𑆪𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆽𑆂𑇅 𑆱𑆳𑆫𑇀𑆪𑆩𑆳𑆟𑆼 𑆑𑆦𑆼 𑆧𑆱𑇀𑆠𑆴𑆂 𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆽𑆂𑇆𑇒𑇕𑇆
𑆯𑆑𑆸𑆠𑆳 𑆮𑆳𑆪𑆶𑆤𑆳 𑆮𑆳𑇁𑇁𑆩𑆼 𑆠𑆼𑆤 𑆮𑆫𑇀𑆖𑆱𑇀𑆪𑆡𑆳𑆤𑆴𑆬𑆼𑇅 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼𑇁𑆤𑇀𑆠𑆫𑆥𑆳𑆤𑆁 𑆱𑇀𑆪𑆳𑆢𑇀 𑆮𑇀𑆪𑆾𑆰𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀𑇆𑇒𑇖𑇆
𑆥𑆴𑆠𑇀𑆠𑆼𑆤𑆳𑆩𑆼𑇁𑆱𑆸𑆘𑆳 𑆮𑆳𑇁𑆥𑆴 𑆠𑆪𑆾𑆫𑆳𑆩𑆼𑆤 𑆮𑆳 𑆥𑆶𑆤𑆂𑇅 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆪𑆾𑆫𑇀𑆨𑆮𑆼𑆠𑇀 𑆥𑆳𑆤𑆁 𑆱𑆮𑇀𑆪𑆾𑆰𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆩𑇀𑇆𑇒𑇗𑇆
𑆠𑆡𑆳𑇁𑇁𑆩𑆼 𑆑𑆦𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆑𑆰𑆳𑆪𑆮𑇀𑆪𑆾𑆰𑆠𑆴𑆑𑇀𑆠𑆑𑆩𑇀𑇅 𑆄𑆩𑆼𑆤 𑆠𑆶 𑆑𑆦𑆼 𑆮𑇀𑆪𑆾𑆰𑆑𑆰𑆳𑆪𑆬𑆮𑆟𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀𑇆𑇒𑇘𑇆
𑆮𑆳𑆠𑆼𑆤 𑆮𑆴𑆯𑆴 𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆳 𑆮𑆴𑆛𑇀𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆠𑆡𑆳𑇁𑆤𑆴𑆬𑆼𑇅 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆠𑇀𑆠𑆩𑆂𑇆𑇒𑇙𑇆
𑆯𑆑𑆸𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆪𑆾𑆂 𑆥𑆴𑆠𑇀𑆠𑆯𑆑𑆸𑆠𑆾 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆪𑆾𑆂𑇅 𑆧𑆱𑇀𑆠𑆴𑆫𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆑𑆰𑆳𑆪𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆂𑇆𑇓𑇐𑇆
𑆑𑆦𑆼𑆤 𑆮𑆴𑆯𑆴 𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆳 𑆑𑆦𑆼 𑆮𑆴𑆛𑇀𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆽𑆂𑇅 𑆮𑇀𑆪𑆾𑆰𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆠𑇀𑆠𑆩𑆂𑇆𑇓𑇑𑇆
𑆱𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆾𑆰𑆠𑆴𑆑𑇀𑆠𑆳𑆩𑇀𑆬𑆂 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆮𑆳𑆪𑆶𑆤𑆳 𑆑𑆦𑆼𑇅 𑆩𑆣𑆶𑆫𑆮𑇀𑆪𑆾𑆰𑆠𑆴𑆑𑇀𑆠𑆱𑇀𑆠𑆶 𑆫𑆑𑇀𑆠𑆼 𑆑𑆦𑆮𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆼𑇆𑇓𑇒𑇆
𑆩𑆳𑆫𑆶𑆠𑆼 𑆑𑆦𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆮𑇀𑆪𑆾𑆰𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆾 𑆨𑆮𑆼𑆠𑇀𑇅 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆼𑆤 𑆥𑆴𑆠𑇀𑆠𑆼 𑆠𑆶 𑆑𑆳𑆫𑇀𑆪𑆂 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆠𑆴𑆑𑇀𑆠𑆑𑆂𑇆𑇓𑇓𑇆
𑆠𑇀𑆫𑆴𑆖𑆠𑆶𑆂𑆥𑆚𑇀𑆖𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆤𑆼𑆮𑆩𑆼𑆮 𑆮𑆴𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇅 𑆪𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆖𑆽𑆰𑆳𑆠𑆴𑆱𑆳𑆫𑆾𑆑𑇀𑆠𑆳 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆥𑆴 𑆱𑇀𑆩𑆸𑆠𑆳𑇆𑇓𑇔𑇆
𑆪𑆶𑆓𑆥𑆠𑇀 𑆰𑆝𑇀𑆫𑆱𑆁 𑆰𑆟𑇀𑆟𑆳𑆁 𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆥𑆳𑆖𑆤𑆁 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆤𑆴𑆫𑆳𑆩𑆳𑆟𑆳𑆁 𑆠𑆶 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆁 𑆧𑆱𑇀𑆠𑆴𑆂 𑆰𑆳𑆝𑇀𑆫𑆱𑆴𑆑𑆾 𑆩𑆠𑆂𑇆𑇓𑇕𑇆
𑆇𑆢𑆶𑆩𑇀𑆧𑆫𑆯𑆬𑆳𑆛𑆷𑆤𑆴 𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆠𑇀𑆮𑆖𑆂𑇅 𑆯𑆕𑇀𑆒𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆁 𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆑𑆫𑇀𑆢𑆩𑆁 𑆖 𑆥𑆬𑆳𑆁𑆯𑆴𑆑𑆩𑇀𑇆𑇓𑇖𑇆
𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆠𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆴𑆠𑆁 𑆥𑆖𑆼𑆠𑇀𑇅 𑆃𑆠𑆵𑆱𑆳𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆥𑆼𑆪𑆩𑆼𑆠𑆢𑇀𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇆𑇓𑇗𑇆
𑆑𑆖𑇀𑆗𑆶𑆫𑆳𑆣𑆳𑆠𑆑𑆵𑆧𑆴𑆬𑇀𑆮𑆱𑆩𑆕𑇀𑆓𑆳𑆫𑆑𑇀𑆠𑆯𑆳𑆬𑆴𑆨𑆴𑆂𑇅 𑆩𑆱𑆷𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆯𑆶𑆕𑇀𑆓𑆽𑆯𑇀𑆖 𑆪𑆮𑆳𑆓𑆷𑆂 𑆱𑇀𑆪𑆳𑆘𑇀𑆘𑆬𑆼 𑆯𑆸𑆠𑆽𑆂𑇆𑇓𑇘𑇆
𑆧𑆳𑆬𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆱𑆩𑆕𑇀𑆓𑆳𑆥𑇀𑆬𑆑𑇀𑆰𑆥𑆬𑇀𑆬𑆮𑆽𑆂 𑇅 𑆩𑆱𑆷𑆫𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆧𑆬𑆳𑆨𑆴𑆯𑇀𑆖 𑆠𑆡𑆳 𑆨𑆮𑆼𑆠𑇀𑇆𑇓𑇙𑇆
𑆱𑇀𑆡𑆴𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆧𑆬𑆳𑆢𑆵𑆤𑆳𑆩𑆴𑆑𑇀𑆰𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑆡𑆳𑆥𑆴 𑆮𑆳𑇅 𑆑𑇀𑆮𑆳𑆡𑆼𑆰𑆶 𑆱𑆩𑆱𑆷𑆫𑆳𑆟𑆳𑆁 𑆪𑆮𑆳𑆓𑇀𑆮𑆂 𑆱𑇀𑆪𑆶𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀𑇆𑇔𑇐𑇆
𑆑𑆖𑇀𑆗𑆶𑆫𑆳𑆩𑆷𑆬𑆯𑆳𑆬𑇀𑆪𑆳𑆢𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆽𑆫𑆶𑆥𑆱𑆳𑆣𑆴𑆠𑆳𑆂𑇅 𑆢𑆣𑆴𑆠𑆑𑇀𑆫𑆳𑆫𑆤𑆳𑆬𑆳𑆩𑇀𑆬𑆑𑇀𑆰𑆵𑆫𑆼𑆰𑇀𑆮𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆼𑇁𑆥𑆴 𑆮𑆳𑇆𑇔𑇑𑇆
𑆯𑆵𑆠𑆳𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆠𑆴𑆱𑆳𑆫𑆤𑆳𑆯𑆤𑆳𑆂𑇅 𑆱𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆫𑆴𑆖𑆳𑆘𑆳𑆘𑇀𑆪𑆾 𑆩𑆣𑆶𑆫𑆳 𑆬𑆮𑆟𑆳𑆂 𑆯𑆴𑆮𑆳𑆂𑇆𑇔𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆩𑆣𑆶𑆫𑆁 𑆥𑆳𑆤𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆩𑆳𑆫𑆶𑆠𑆼 𑆑𑆾𑆰𑇀𑆟𑆂𑇅 𑆯𑆵𑆠𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆫𑆁 𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆫𑆑𑇀𑆠𑆼 𑆖𑇆𑇔𑇓𑇆
𑆠𑆴𑆑𑇀𑆠𑆾𑆰𑇀𑆟𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆮𑆳𑆠𑆤𑆶𑆖𑇀𑆗𑆑𑆸𑆠𑆴𑇅 𑆥𑆳𑆖𑆤𑆩𑆳𑆩𑆼 𑆥𑆳𑆤𑆁 𑆥𑆴𑆖𑇀𑆗𑆳𑆱𑆸𑆓𑇀𑆧𑆱𑇀𑆠𑆪𑆾 𑆫𑆑𑇀𑆠𑆼𑇆𑇔𑇔𑇆
𑆃𑆠𑆴𑆱𑆳𑆫𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆩𑆴𑆯𑇀𑆫𑆁 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆳𑆢𑆴𑆪𑆾𑆓𑆘𑆼𑆰𑇀𑆮𑆥𑆴 𑆖𑇅 𑆠𑆠𑇀𑆫𑆾𑆢𑇀𑆫𑆼𑆑𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆢𑆾𑆰𑆼𑆰𑆷𑆥𑆑𑇀𑆫𑆩𑆂 𑆑𑆳𑆫𑇀𑆪𑆂𑇆𑇔𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆥𑇀𑆫𑆳𑆱𑆸𑆠𑆴𑆑𑆳𑆂 𑆱𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆑𑇀𑆫𑆴𑆪𑆳 𑆤𑆴𑆫𑆷𑆲𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆠𑆴𑆱𑆳𑆫𑆲𑆴𑆠𑆳𑆂𑇅 𑆫𑆱𑆑𑆬𑇀𑆥𑆔𑆸𑆠𑆪𑆮𑆳𑆓𑇀𑆮𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆓𑆶𑆫𑆶𑆟𑆳 𑆥𑇀𑆫𑆱𑆸𑆠𑆱𑆴𑆢𑇀𑆣𑆿𑇆𑇔𑇖𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆩𑆫𑇀𑆩𑆵𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆱𑆥𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆩𑆫𑇀𑆩𑆯𑆠𑆩𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆫𑆵𑆫𑆼 𑆱𑇀𑆑𑆤𑇀𑆣𑆯𑆳𑆒𑆳𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯!𑇅 𑆠𑆼𑆰𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆥𑆵𑆝𑆳𑆪𑆳𑆁 𑆱𑆩𑆣𑆴𑆑𑆳 𑆥𑆵𑆝𑆳 𑆨𑆮𑆠𑆴, 𑆖𑆼𑆠𑆤𑆳𑆤𑆴𑆧𑆤𑇀𑆣𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫 𑆯𑆳𑆒𑆳𑆯𑇀𑆫𑆴𑆠𑆼𑆨𑇀𑆪𑆾 𑆩𑆫𑇀𑆩𑆨𑇀𑆪𑆂 𑆱𑇀𑆑𑆤𑇀𑆣𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆓𑆫𑆵𑆪𑆳𑆁𑆱𑆴, 𑆯𑆳𑆒𑆳𑆤𑆳𑆁 𑆠𑆢𑆳𑆯𑇀𑆫𑆴𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱𑇀𑆑𑆤𑇀𑆣𑆳𑆯𑇀𑆫𑆴𑆠𑆼𑆨𑇀𑆪𑆾𑇁𑆥𑆴 𑆲𑆸𑆢𑇀𑆮𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆳𑆁𑆱𑆴, 𑆠𑆤𑇀𑆩𑆷𑆬𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆱𑇀𑆪𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆲𑆸𑆢𑆪𑆼 𑆢𑆯 𑆣𑆩𑆤𑇀𑆪𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆥𑆳𑆤𑆿 𑆩𑆤𑆾 𑆧𑆶𑆢𑇀𑆣𑆴𑆯𑇀𑆖𑆼𑆠𑆤𑆳 𑆩𑆲𑆳𑆨𑆷𑆠𑆳𑆤𑆴 𑆖 𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆫𑆳 𑆅𑆮 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆳𑆤𑆴, 𑆯𑆴𑆫𑆱𑆴 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆳𑆤𑆴 𑆖 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆱𑆷𑆫𑇀𑆪𑆩𑆴𑆮 𑆓𑆨𑆱𑇀𑆠𑆪𑆂 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴, 𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆠𑆶 𑆱𑇀𑆡𑆷𑆬𑆓𑆶𑆢𑆩𑆶𑆰𑇀𑆑𑆱𑆼𑆮𑆤𑆵𑆯𑆶𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆲𑆴𑆤𑆵𑆤𑆳𑆁 𑆤𑆳𑆝𑆵(𑆬𑆵)𑆤𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆩𑆷𑆠𑇀𑆫𑆣𑆳𑆫𑆾𑇁𑆩𑇀𑆧𑆶𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆶𑆢𑆣𑆴𑆫𑆴𑆮𑆳𑆥𑆓𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳 , 𑆧𑆲𑆶𑆨𑆴𑆯𑇀𑆖 𑆠𑆤𑇀𑆩𑆷𑆬𑆽𑆫𑇀𑆩𑆫𑇀𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆽𑆂 𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑆴𑆫𑇀𑆓𑆓𑆤𑆩𑆴𑆮 𑆢𑆴𑆤𑆑𑆫𑆑𑆫𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆩𑆴𑆢𑆁 𑆯𑆫𑆵𑆫𑆩𑇀𑇆𑇔𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪𑆳𑆥𑆴 𑆨𑆼𑆢𑆳𑆢𑆳𑆯𑇀𑆮𑆼𑆮 𑆯𑆫𑆵𑆫𑆨𑆼𑆢𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆄𑆯𑇀𑆫𑆪𑆤𑆳𑆯𑆳𑆢𑆳𑆯𑇀𑆫𑆴𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆮𑆴𑆤𑆳𑆯𑆂; 𑆠𑆢𑆶𑆥𑆔𑆳𑆠𑆳𑆠𑇀𑆠𑆶 𑆔𑆾𑆫𑆠𑆫𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂; 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆫𑆑𑇀𑆰𑇀𑆪𑆳𑆟𑆴 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑆴𑆔𑆳𑆢𑇀𑆮𑆳𑆠𑆳𑆢𑆴𑆨𑇀𑆪𑆯𑇀𑆖𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆲𑆸𑆢𑇀𑆪𑆨𑆴𑆲𑆠𑆼 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆧𑆬𑆑𑇀𑆰𑆪𑆑𑆟𑇀𑆜𑆯𑆾𑆰𑆑𑇀𑆬𑆾𑆩𑆳𑆑𑆫𑇀𑆰𑆟𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆴𑆫𑇀𑆓𑆩𑆩𑆶𑆒𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆾𑆤𑇀𑆩𑆳𑆢𑆥𑇀𑆫𑆬𑆳𑆥𑆖𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆳𑆢𑆪𑆂 𑆱𑇀𑆪𑆶𑆂; 𑆯𑆴𑆫𑆱𑇀𑆪𑆨𑆴𑆲𑆠𑆼 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆫𑇀𑆢𑆴𑆠𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆮𑆴𑆨𑇀𑆫𑆩𑆩𑆾𑆲𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆖𑆼𑆰𑇀𑆛𑆳𑆤𑆳𑆯𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆲𑆤𑆶𑆓𑇀𑆫𑆲𑆩𑆷𑆑𑆓𑆢𑇀𑆓𑆢𑆠𑇀𑆮𑆳𑆑𑇀𑆰𑆴𑆤𑆴𑆩𑆵𑆬𑆤- 𑆓𑆟𑇀𑆝𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆘𑆸𑆩𑇀𑆨𑆟𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆱𑇀𑆮𑆫𑆲𑆳𑆤𑆴𑆮𑆢𑆤𑆘𑆴𑆲𑇀𑆩𑆠𑇀𑆮𑆳𑆢𑆵𑆤𑆴, 𑆧𑆱𑇀𑆠𑆿 𑆠𑆶 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆾𑆤𑆴𑆓𑇀𑆫𑆲𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆩𑆼𑆲𑆤𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆑𑆶𑆟𑇀𑆝𑆬𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆴𑆬𑆳𑆰𑇀𑆜𑆵𑆬𑆾𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆳𑆨𑆴𑆑𑆶𑆑𑇀𑆰𑆴𑆓𑆶𑆢𑆯𑇀𑆫𑆾𑆟𑆴𑆓𑇀𑆫𑆲𑆳𑆢𑆪𑆂 ; 𑆮𑆳𑆠𑆳𑆢𑇀𑆪𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆼𑆰𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆣𑆵𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴𑇆𑇖𑇆
𑆑𑆴𑆤𑇀𑆠𑇀𑆮𑆼𑆠𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆾𑇁𑆤𑆴𑆬𑆳𑆢𑇀𑆫𑆑𑇀𑆰𑇀𑆪𑆳𑆟𑆴, 𑆃𑆤𑆴𑆬𑆾 𑆲𑆴 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆩𑆶𑆢𑆵𑆫𑆟𑆼 𑆲𑆼𑆠𑆶𑆂 𑆥𑇀𑆫𑆳𑆟𑆩𑆷𑆬𑆁 𑆖, 𑆱 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆱𑆳𑆣𑇀𑆪𑆠𑆩𑆂, 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆧𑆱𑇀𑆠𑆴𑆱𑆩𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆑𑆫𑇀𑆩 𑆩𑆫𑇀𑆩𑆥𑆫𑆴𑆥𑆳𑆬𑆤𑆩𑆱𑇀𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆰𑆝𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆳𑆤𑇀 𑆮𑆴𑆩𑆳𑆤𑆼 𑆢𑇀𑆮𑆿 𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆳𑆮𑆴𑆲 𑆖 𑆮𑆴𑆲𑆴𑆠𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆵𑆤𑇀 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆮𑆴𑆖𑆳𑆫𑇀𑆪 𑆩𑆲𑆳𑆩𑆫𑇀𑆩𑆥𑆫𑆴𑆥𑆳𑆬𑆤𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆢𑇀𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆖𑇆𑇗𑇆
𑆨𑆷𑆪𑆯𑇀𑆖 𑆲𑆸𑆢𑇀𑆪𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆲𑆴𑆕𑇀𑆓𑆶𑆖𑆷𑆫𑇀𑆟𑆁 𑆬𑆮𑆟𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆖𑆷𑆫𑇀𑆟𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆱𑇀𑆪 𑆫𑆱𑆼𑆤𑆳𑆤𑇀𑆪𑆼𑆤 𑆮𑆳𑇁𑆩𑇀𑆬𑆼𑆤 𑆲𑆸𑆢𑇀𑆪𑆼𑆤 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆱𑇀𑆡𑆴𑆫𑆳𑆢𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆫𑆱𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆂 𑆥𑆳𑆤𑆳𑆫𑇀𑆡𑆁, 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆫𑆱𑆱𑆴𑆢𑇀𑆣𑆳 𑆖 𑆪𑆮𑆳𑆓𑆷𑆂, 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆮𑆴𑆲𑆴𑆠𑆁 𑆖 𑆑𑆫𑇀𑆩; 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆠𑆶 𑆮𑆳𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆮𑆼𑆢𑆤𑆾𑆥𑆤𑆳𑆲𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆤𑆱𑇀𑆠𑆂𑆑𑆫𑇀𑆩𑆳𑆮𑆥𑆵𑆝𑆤𑆣𑆷𑆩𑆳𑆢𑆵𑆤𑆴; 𑆧𑆱𑇀𑆠𑆿 𑆠𑆶 𑆑𑆶𑆩𑇀𑆨𑆵𑆱𑇀𑆮𑆼𑆢𑆂, 𑆮𑆫𑇀𑆠𑆪𑆂, 𑆯𑇀𑆪𑆳𑆩𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆾 𑆤𑆴𑆫𑆷𑆲𑆂, 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖 𑆱𑆶𑆫𑆳𑆱𑆴𑆢𑇀𑆣𑆂, 𑆯𑆫𑆑𑆳𑆯𑆼𑆑𑇀𑆰𑆶𑆢𑆫𑇀𑆨𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆩𑆷𑆬𑆯𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆽𑆯𑇀𑆖 𑆠𑇀𑆫𑆥𑆶𑆱𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆒𑆫𑆳𑆯𑇀𑆮𑆳𑆧𑆵𑆘𑆪𑆮𑆫𑇀𑆰𑆨𑆑𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆬𑇀𑆑𑆴𑆠𑆾 𑆤𑆴𑆫𑆷𑆲𑆂, 𑆥𑆵𑆠𑆢𑆳𑆫𑆶𑆱𑆴𑆢𑇀𑆣𑆠𑆽𑆬𑆼𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆁, 𑆠𑆽𑆬𑇀𑆮𑆑𑆁 𑆖 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆴𑆫𑆼𑆑𑆳𑆫𑇀𑆡𑆁, 𑆯𑆠𑆳𑆮𑆫𑆵𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆾𑆯𑆵𑆫𑆩𑆣𑆶𑆑𑆢𑇀𑆮𑆴𑆱𑆳𑆫𑆴𑆮𑆳𑆬𑆾𑆣𑇀𑆫𑆯𑇀𑆫𑆼𑆪𑆱𑆵𑆑𑆶𑆯𑆑𑆳𑆯𑆩𑆷𑆬𑆑𑆰𑆳𑆪𑆑𑇀𑆰𑆵𑆫𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆁 𑆧𑆬𑆳𑆮𑆸𑆰𑆫𑇀𑆰𑆨𑆑𑆒𑆫𑆳𑆯𑇀𑆮𑆾𑆥𑆑𑆶𑆚𑇀𑆖𑆴𑆑𑆳𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆫𑆥𑆶𑆱𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆧𑆵𑆘𑆯𑆴𑆠𑆴𑆮𑆳𑆫𑆑𑆩𑆣𑆶𑆑𑆮𑆖𑆳𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆯𑇀𑆩𑆨𑆼𑆢𑆑𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆩𑆢𑆤𑆦𑆬𑆑𑆬𑇀𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆩𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆤𑆴𑆫𑆷𑆲𑆾 𑆮𑆳 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆑𑆳𑆫𑆲𑆫 𑆅𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆲𑆸𑆢𑆪𑆼 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆧𑆱𑇀𑆠𑆿 𑆖 𑆤𑆸𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆳𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆼𑆰𑆳𑆁 𑆱𑆢𑆳 𑆪𑆠𑇀𑆤𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆥𑆫𑆴𑆥𑆳𑆬𑆤𑆼𑇆𑇙𑇆
𑆄𑆧𑆳𑆣𑆮𑆫𑇀𑆘𑆤𑆁 𑆤𑆴𑆠𑇀𑆪𑆁 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆶𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇅 𑆇𑆠𑇀𑆥𑆤𑇀𑆤𑆳𑆫𑇀𑆠𑆴𑆮𑆴𑆔𑆳𑆠𑆯𑇀𑆖 𑆩𑆫𑇀𑆩𑆟𑆳𑆁 𑆥𑆫𑆴𑆥𑆳𑆬𑆤𑆩𑇀𑇆𑇑𑇐𑇆
𑆃𑆠 𑆇𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆴𑆑𑆳𑆫𑆳 𑆪𑆼 𑆠𑇀𑆫𑆴𑆩𑆫𑇀𑆩𑆵𑆪𑆼 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑇅 𑆤 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆩𑆫𑇀𑆩𑆘𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆑𑆳𑆁𑆯𑇀𑆖𑆴𑆢𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆿𑆰𑆣𑆳𑆤𑇀𑇆𑇑𑇑𑇆
𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆂 𑆱𑇀𑆮𑆽𑆂 𑆑𑆾𑆥𑆤𑆽𑆫𑇀𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆥𑆵𑆝𑆪𑆤𑇀 𑆲𑆸𑆢𑆪𑆁 𑆓𑆠𑇀𑆮𑆳 𑆯𑆴𑆫𑆂 𑆯𑆕𑇀𑆒𑆿 𑆖 𑆥𑆵𑆝𑆪𑆤𑇀𑇆𑇑𑇒𑇆
𑆣𑆤𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆩𑆪𑆼𑆢𑇀𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆳𑆑𑇀𑆰𑆴𑆥𑆼𑆤𑇀𑆩𑆾𑆲𑆪𑆼𑆠𑇀𑆠𑆡𑆳𑇅 (𑆤𑆩𑆪𑆼𑆖𑇀𑆖𑆳𑆑𑇀𑆰𑆴𑆥𑆼𑆖𑇀𑆖𑆳𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆁 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆖)𑇅 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟 𑆖𑆳𑆥𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆮𑆱𑆴𑆠𑆴 𑆱𑇀𑆠𑆧𑇀𑆣𑆳𑆑𑇀𑆰𑆾𑇁𑆡 𑆤𑆴𑆩𑆵𑆬𑆑𑆂 𑇆𑇑𑇓𑇆

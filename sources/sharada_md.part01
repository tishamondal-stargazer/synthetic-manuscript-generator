𑆃𑆡 𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑆴 𑇅 𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑆴 𑆓𑆾𑆩𑆲𑆴𑆰𑇀𑆪𑆘𑆳𑆮𑆴𑆓𑆘𑆲𑆪𑆒𑆫𑆾𑆰𑇀𑆛𑇀𑆫𑆳𑆟𑆳𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆤𑆴 𑆑𑆛𑆷𑆤𑆴 𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆴 𑆬𑆮𑆟𑆳𑆤𑆶𑆫𑆱𑆳𑆤𑆴 𑆬𑆔𑆷𑆤𑆴 𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆑𑆦𑆮𑆳𑆠𑆑𑆸𑆩𑆴𑆩𑆼𑆢𑆾𑆮𑆴𑆰𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆢𑆫𑆑𑆶𑆰𑇀𑆜𑆯𑆾𑆦𑆳𑆫𑆾𑆖𑆑𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆲𑆫𑆳𑆟𑆴 𑆲𑆸𑆢𑇀𑆪𑆳𑆤𑆴 𑆢𑆵𑆥𑆤𑆳𑆤𑆴 𑆖 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆂 𑇆𑇒𑇑𑇗𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆑𑆛𑆶 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆁 𑆬𑆮𑆟𑆳𑆤𑆶𑆫𑆱𑆁 𑆬𑆔𑆶 𑇅 𑆯𑆾𑆣𑆤𑆁 𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆑𑆸𑆩𑆴𑆩𑆼𑆢𑆾𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇆𑇒𑇑𑇘𑇆
𑆃𑆫𑇀𑆯𑆾𑆘𑆜𑆫𑆓𑆶𑆬𑇀𑆩𑆔𑇀𑆤𑆁 𑆯𑆾𑆦𑆳𑆫𑆾𑆖𑆑𑆤𑆳𑆯𑆤𑆩𑇀 𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆲𑆫𑆁 𑆨𑆼𑆢𑆴 𑆲𑆸𑆢𑇀𑆪𑆁 𑆢𑆵𑆥𑆤𑆥𑆳𑆖𑆤𑆩𑇀 𑇆𑇒𑇑𑇙𑇆
𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑆛𑆶 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆁 𑆱𑆑𑇀𑆰𑆳𑆫𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆮𑆳𑆠𑆬𑆩𑇀 𑇅 𑆬𑆔𑇀𑆮𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆥𑆴𑆠𑇀𑆠𑆬𑆁 𑆑𑆦𑆮𑆳𑆠𑆤𑆶𑆠𑇀 𑇆𑇒𑇒𑇐𑇆
𑆯𑆷𑆬𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆤𑆳𑆲𑆮𑆴𑆫𑆼𑆑𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆢𑆴𑆰𑆶 𑇅 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑆶 𑆓𑆮𑇀𑆪𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇒𑇑𑇆
𑆢𑆶𑆫𑇀𑆤𑆳𑆩𑆾𑆢𑆫𑆯𑆷𑆬𑆼𑆰𑆶 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆰𑆶 𑇅 𑆄𑆤𑆳𑆲𑆯𑆾𑆦𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑆶 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆼 𑆖 𑆩𑆳𑆲𑆴𑆰𑆩𑇀 𑇆𑇒𑇒𑇒𑇆
𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆥𑆲𑆁 𑆯𑆾𑆦𑆑𑆳𑆩𑆬𑆳𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆤𑆶𑆠𑇀 𑇅 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑇀𑆮𑆴𑆠𑆁 𑆗𑆳𑆓𑆩𑆵𑆰𑆤𑇀𑆩𑆳𑆫𑆶𑆠𑆑𑆾𑆥𑆤𑆩𑇀 𑇆𑇒𑇒𑇓𑇆
𑆑𑆳𑆱𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆰𑆮𑆫𑇀𑆖𑆾𑆓𑇀𑆫𑆲𑆼 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆱𑆑𑇀𑆰𑆳𑆫𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆩𑆶𑆰𑇀𑆟𑆁 𑆮𑆳𑆠𑆔𑇀𑆤𑆩𑆳𑆮𑆴𑆑𑆩𑇀 𑇆𑇒𑇒𑇔𑇆
𑆢𑆵𑆥𑆤𑆁 𑆑𑆛𑆶 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆁 𑆮𑆳𑆠𑆖𑆼𑆠𑆾𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀 𑇅 𑆄𑆯𑇀𑆮𑆁 𑆑𑆦𑆲𑆫𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑆸𑆩𑆴𑆢𑆢𑇀𑆫𑆶𑆰𑆶 𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇒𑇒𑇕𑇆
𑆱𑆠𑆴𑆑𑇀𑆠𑆁 𑆬𑆮𑆟𑆁 𑆨𑆼𑆢𑆴 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆑𑆾𑆥𑆤𑆩𑇀 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆑𑇀𑆰𑆳𑆫𑆼 𑆑𑆴𑆬𑆳𑆱𑆼 𑆖 𑆤𑆳𑆓𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇒𑇖𑇆
𑆓𑆫𑆖𑆼𑆠𑆾𑆮𑆴𑆑𑆳𑆫𑆔𑇀𑆤𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆓𑇀𑆫𑆲𑆟𑆴𑆫𑆾𑆓𑆤𑆶𑆠𑇀 𑇅 𑆢𑆵𑆥𑆤𑆁 𑆓𑆳𑆫𑇀𑆢𑆨𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑆸𑆩𑆴𑆮𑆳𑆠𑆑𑆦𑆳𑆥𑆲𑆩𑇀 𑇆𑇒𑇒𑇗𑇆
𑆢𑇀𑆫𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑆩𑆳𑆱𑆳𑆠𑇀 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆑𑆳𑆬𑆢𑆼𑆯𑆮𑆴𑆨𑆳𑆓𑆘𑇀𑆚𑆾 𑆤𑆸𑆥𑆠𑆼𑆫𑇀𑆢𑆳𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴 𑇆𑇒𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆩𑆨𑆴𑆮𑆳𑆢𑇀𑆪 𑆱𑆶𑆯𑇀𑆫𑆶𑆠 𑆇𑆮𑆳𑆖- 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆂 ‘𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆷𑆬𑆩𑆳𑆲𑆳𑆫𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆿𑆘𑆱𑆳𑆁 𑆖, 𑆱 𑆰𑆛𑇀𑆱𑆶 𑆫𑆱𑆼𑆰𑇀𑆮𑆳𑆪𑆠𑇀𑆠𑆂, 𑆫𑆱𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆴𑆟𑆂,’ 𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼 𑆖 𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆵 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆳𑆩𑇀𑆪𑆁 𑆖, 𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆢𑆼𑆫𑆥𑆴 𑆖 𑆬𑆾𑆑𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆂 𑆱𑇀𑆡𑆴𑆠𑇀𑆪𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆮𑆴𑆤𑆳𑆯𑆲𑆼𑆠𑆶𑆂, 𑆄𑆲𑆳𑆫𑆳𑆢𑆼𑆮𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆧𑆬𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆱𑆳𑆢𑆯𑇀𑆖, 𑆠𑆡𑆳 𑆲𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆽𑆰𑆩𑇀𑆪𑆳𑆢𑆱𑇀𑆮𑆳𑆱𑇀𑆡𑇀𑆪𑆁; 𑆠𑆱𑇀𑆪𑆳𑆯𑆴𑆠𑆥𑆵𑆠𑆬𑆵𑆞𑆒𑆳𑆢𑆴𑆠𑆱𑇀𑆪 𑆤𑆳𑆤𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆠𑇀𑆩𑆑𑆱𑇀𑆪𑆳𑆤𑆼𑆑𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆱𑇀𑆪𑆳𑆤𑆼𑆑𑆮𑆴𑆣𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆪 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆑𑆫𑇀𑆩𑆳𑆟𑆵𑆖𑇀𑆗𑆳𑆩𑆴 𑆘𑇀𑆚𑆳𑆠𑆶𑆁, 𑆤 𑆲𑇀𑆪𑆤𑆮𑆧𑆶𑆢𑇀𑆣𑆱𑇀𑆮𑆨𑆳𑆮𑆳 𑆨𑆴𑆰𑆘𑆂 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆶𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆫𑆾𑆓𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆁 𑆖 𑆑𑆫𑇀𑆠𑆶𑆁 𑆱𑆩𑆫𑇀𑆡𑆳𑆂; 𑆄𑆲𑆳𑆫𑆳𑆪𑆠𑇀𑆠𑆳𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆾 𑆪𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆴𑆩𑆶𑆥𑆢𑆴𑆯𑆠𑆶 𑆩𑆼 𑆨𑆓𑆮𑆳𑆤𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂- 𑆃𑆡 𑆒𑆬𑆶 𑆮𑆠𑇀𑆱 𑆱𑆶𑆯𑇀𑆫𑆶𑆠! 𑆪𑆡𑆳𑆥𑇀𑆫𑆯𑇀𑆤𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪𑆱𑇀𑆮- 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆬𑆾𑆲𑆴𑆠𑆯𑆳𑆬𑆴𑆑𑆬𑆩𑆑𑆫𑇀𑆢𑆩𑆑𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆱𑆶𑆓𑆤𑇀𑆣𑆑𑆯𑆑𑆶𑆤𑆳𑆲𑆸𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑇀𑆝𑆑𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆩𑆲𑆳𑆯𑆳𑆬𑆴𑆯𑆵𑆠𑆨𑆵𑆫𑆶𑆑𑆫𑆾𑆣𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆑- 𑆢𑆵𑆫𑇀𑆔𑆯𑆷𑆑𑆑𑆳𑆚𑇀𑆖𑆤𑆑𑆩𑆲𑆴𑆰𑆩𑆲𑆳𑆯𑆷𑆑𑆲𑆳𑆪𑆤𑆑𑆢𑆷𑆰𑆑𑆩𑆲𑆳𑆢𑆷𑆰𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂 𑆯𑆳𑆬𑆪𑆂 𑇆𑇔𑇆
𑆩𑆣𑆶𑆫𑆳 𑆮𑆵𑆫𑇀𑆪𑆠𑆂 𑆯𑆵𑆠𑆳 𑆬𑆔𑆶𑆥𑆳𑆑𑆳 𑆧𑆬𑆳𑆮𑆲𑆳𑆂 𑇅 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆬𑇀𑆥𑆳𑆤𑆴𑆬𑆑𑆦𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆧𑆢𑇀𑆣𑆳𑆬𑇀𑆥𑆮𑆫𑇀𑆖𑆱𑆂 𑇆𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆬𑆾𑆲𑆴𑆠𑆑𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆢𑆾𑆰𑆔𑇀𑆤𑆂 𑆯𑆶𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆬𑆂 𑇅 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆾 𑆮𑆫𑇀𑆟𑆧𑆬𑆑𑆸𑆠𑇀 𑆱𑇀𑆮𑆫𑇀𑆪𑆾 𑆲𑆸𑆢𑇀𑆪𑆱𑇀𑆠𑆸𑆰𑆳𑆥𑆲𑆂 𑇆𑇖𑇆
𑆰𑆰𑇀𑆛𑆴𑆑𑆑𑆳𑆕𑇀𑆓𑆶𑆑𑆩𑆶𑆑𑆶𑆤𑇀𑆢𑆑𑆥𑆵𑆠𑆑𑆥𑇀𑆫𑆩𑆾𑆢𑆑𑆑𑆳𑆑𑆬𑆑𑆳𑆱𑆤𑆥𑆶𑆰𑇀𑆥𑆑𑆩𑆲𑆳𑆰𑆰𑇀𑆛𑆴𑆑𑆖𑆷𑆫𑇀𑆟𑆑𑆑𑆶𑆫𑆮𑆑𑆑𑆼𑆢𑆳𑆫𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂 𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆂 𑇆𑇘𑇆
𑆫𑆱𑆼 𑆥𑆳𑆑𑆼 𑆖 𑆩𑆣𑆶𑆫𑆳𑆂 𑆯𑆩𑆤𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆪𑆾𑆂 𑇅 𑆯𑆳𑆬𑆵𑆤𑆳𑆁 𑆖 𑆓𑆶𑆟𑆽𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆳 𑆧𑆸𑆁𑆲𑆟𑆳𑆂 𑆑𑆦𑆯𑆶𑆑𑇀𑆫𑆬𑆳𑆂 𑇆𑇙𑇆
𑆰𑆰𑇀𑆛𑆴𑆑𑆂 𑆥𑇀𑆫𑆮𑆫𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆾 𑆬𑆔𑆶𑆂 𑇅 𑆩𑆸𑆢𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆂 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆸𑆢𑇀𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆂 𑇆𑇑𑇐𑇆
𑆑𑆸𑆰𑇀𑆟𑆮𑇀𑆫𑆵𑆲𑆴𑆯𑆳𑆬𑆳𑆩𑆶𑆒𑆘𑆠𑆶𑆩𑆶𑆒𑆤𑆤𑇀𑆢𑆵𑆩𑆶𑆒𑆬𑆳𑆮𑆳𑆑𑇀𑆰𑆑𑆠𑇀𑆮𑆫𑆴𑆠𑆑𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆳𑆟𑇀𑆝𑆑𑆥𑆳𑆫𑆳𑆮𑆠𑆑𑆥𑆳𑆛𑆬𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾 𑆮𑇀𑆫𑆵𑆲𑆪𑆂 𑇆𑇑𑇒𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆳𑆂 𑆥𑆳𑆑𑆼𑇁𑆩𑆣𑆶𑆫𑆳 𑆮𑆵𑆫𑇀𑆪𑆠𑆾𑇁𑆲𑆴𑆩𑆳𑆂 𑇅 𑆃𑆬𑇀𑆥𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆳𑆂 𑆰𑆰𑇀𑆛𑆴𑆑𑆽𑆫𑇀𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆱𑆂 𑇆𑇑𑇓𑇆
𑆑𑆸𑆰𑇀𑆟𑆮𑇀𑆫𑆵𑆲𑆴𑆫𑇀𑆮𑆫𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆾 𑆬𑆔𑆶𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆬𑇀𑆥𑆳𑆤𑇀𑆠𑆫𑆓𑆶𑆟𑆳𑆂 𑆑𑇀𑆫𑆩𑆯𑆾 𑆮𑇀𑆫𑆵𑆲𑆪𑆾𑇁𑆥𑆫𑆼 𑇆𑇑𑇔𑇆
𑆢𑆓𑇀𑆣𑆳𑆪𑆳𑆩𑆮𑆤𑆿 𑆘𑆳𑆠𑆳𑆂 𑆯𑆳𑆬𑆪𑆾 𑆬𑆔𑆶𑆥𑆳𑆑𑆴𑆤𑆂 𑇅 𑆑𑆰𑆳𑆪𑆳 𑆧𑆢𑇀𑆣𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆳𑆂 𑇆𑇑𑇕𑇆
𑆱𑇀𑆡𑆬𑆘𑆳𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆂 𑆑𑆰𑆳𑆪𑆳𑆂 𑆑𑆛𑆶𑆑𑆳𑆤𑇀𑆮𑆪𑆳𑆂 𑇅 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆱𑆠𑆴𑆑𑇀𑆠𑆩𑆣𑆶𑆫𑆳𑆂 𑆥𑆮𑆤𑆳𑆤𑆬𑆮𑆫𑇀𑆣𑆤𑆳𑆂 𑇆𑇑𑇖𑇆
𑆑𑆽𑆢𑆳𑆫𑆳 𑆩𑆣𑆶𑆫𑆳 𑆮𑆸𑆰𑇀𑆪𑆳 𑆧𑆬𑇀𑆪𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆳𑆂 𑇅 𑆆𑆰𑆠𑇀𑆑𑆰𑆳𑆪𑆳𑆬𑇀𑆥𑆩𑆬𑆳 𑆓𑆶𑆫𑆮𑆂 𑆑𑆦𑆯𑆶𑆑𑇀𑆫𑆬𑆳𑆂 𑇆𑇑𑇗𑇆
𑆫𑆾𑆥𑇀𑆪𑆳𑆠𑆴𑆫𑆾𑆥𑇀𑆪𑆳 𑆬𑆔𑆮𑆂 𑆯𑆵𑆔𑇀𑆫𑆥𑆳𑆑𑆳 𑆓𑆶𑆟𑆾𑆠𑇀𑆠𑆫𑆳𑆂 𑇅 𑆃𑆢𑆳𑆲𑆴𑆤𑆾 𑆢𑆾𑆰𑆲𑆫𑆳 𑆧𑆬𑇀𑆪𑆳 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆂 𑇆𑇑𑇘𑇆
𑆯𑆳𑆬𑆪𑆯𑇀𑆗𑆴𑆤𑇀𑆤𑆫𑆷𑆞𑆳 𑆪𑆼 𑆫𑆷𑆑𑇀𑆰𑆳𑆱𑇀𑆠𑆼 𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆱𑆂 𑇅 𑆠𑆴𑆑𑇀𑆠𑆳𑆂 𑆑𑆰𑆳𑆪𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳 𑆬𑆔𑆶𑆥𑆳𑆑𑆳𑆂 𑆑𑆦𑆳𑆥𑆲𑆳𑆂 𑇆𑇑𑇙𑇆
𑆑𑆾𑆫𑆢𑆷𑆰𑆑𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆤𑆵𑆮𑆳𑆫𑆯𑆳𑆤𑇀𑆠𑆤𑆶𑆮𑆫𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆩𑆣𑆷𑆬𑆴𑆑𑆳𑆤𑆤𑇀𑆢𑆵𑆩𑆶𑆒𑆵- 𑆑𑆶𑆫𑆶𑆮𑆴𑆤𑇀𑆢𑆓𑆮𑆼𑆣𑆶𑆑𑆱𑆫𑆧𑆫𑆶𑆑𑆠𑆾𑆢(𑆪)𑆥𑆫𑇀𑆟𑆵𑆩𑆶𑆑𑆶𑆤𑇀𑆢𑆑𑆮𑆼𑆟𑆶𑆪𑆮𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂 𑆑𑆶𑆣𑆳𑆤𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑇆𑇒𑇑𑇆
𑆇𑆰𑇀𑆟𑆳𑆂 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆂 𑆑𑆛𑆶𑆮𑆴𑆥𑆳𑆑𑆴𑆤𑆂 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆳 𑆧𑆢𑇀𑆣𑆤𑆴𑆱𑇀𑆪𑆤𑇀𑆢𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆂 𑇆𑇒𑇒𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆯𑆵𑆠𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆥𑆲𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆑𑆾𑆢𑇀𑆫𑆮𑆯𑇀𑆖 𑆱𑆤𑆵𑆮𑆳𑆫𑆂 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆯𑇀𑆖 𑆱𑆯𑆳𑆤𑇀𑆠𑆤𑆶𑆂 𑇆𑇒𑇓𑇆
𑆑𑆸𑆰𑇀𑆟𑆳 𑆫𑆑𑇀𑆠𑆳𑆯𑇀𑆖 𑆥𑆵𑆠𑆳𑆯𑇀𑆖 𑆯𑇀𑆮𑆼𑆠𑆳𑆯𑇀𑆖𑆽𑆮 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆮𑆂 𑇅 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆂 𑆱𑇀𑆪𑆷 𑆫𑆷𑆑𑇀𑆰𑆳𑆂 𑆑𑆦𑆲𑆫𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇒𑇔𑇆
𑆫𑆷𑆑𑇀𑆰𑆳 𑆮𑆼𑆟𑆶𑆪𑆮𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆮𑆵𑆫𑇀𑆪𑆾𑆰𑇀𑆟𑆳 𑆑𑆛𑆶𑆥𑆳𑆑𑆴𑆤𑆂 𑇅 𑆧𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆳𑆂 𑆑𑆦𑆲𑆫𑆳𑆂 𑆑𑆰𑆳𑆪𑆳 𑆮𑆳𑆠𑆑𑆾𑆥𑆤𑆳𑆂 𑇆𑇒𑇖𑇆
𑆩𑆶𑆢𑇀𑆓𑆮𑆤𑆩𑆶𑆢𑇀𑆓𑆑𑆬𑆳𑆪𑆩𑆑𑆶𑆰𑇀𑆜𑆩𑆱𑆷𑆫𑆩𑆕𑇀𑆓𑆬𑇀𑆪𑆖𑆟𑆑𑆱𑆠𑆵𑆤𑆠𑇀𑆫𑆴𑆥𑆶𑆛𑆑𑆲𑆫𑆼𑆟𑇀𑆮𑆳𑆞𑆑𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾 𑆮𑆽𑆢𑆬𑆳𑆂 𑇆𑇒𑇗𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆳𑆂 𑆯𑆵𑆠𑆳𑆂 𑆑𑆛𑆶𑆥𑆳𑆑𑆳 𑆩𑆫𑆶𑆠𑇀𑆑𑆫𑆳𑆂 𑇅 𑆧𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆲𑆫𑆳𑆱𑇀𑆠𑆡𑆳 𑇆𑇒𑇘𑇆
𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆳𑆠𑆬𑆳𑆱𑇀𑆠𑆼𑆰𑆶 𑆩𑆶𑆢𑇀𑆓𑆳 𑆢𑆸𑆰𑇀𑆛𑆴𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆳𑆂 𑇅 𑆥𑇀𑆫𑆣𑆳𑆤𑆳 𑆲𑆫𑆴𑆠𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆮𑆤𑇀𑆪𑆳 𑆩𑆶𑆢𑇀𑆓𑆱𑆩𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇒𑇙𑇆
𑆮𑆴𑆥𑆳𑆑𑆼 𑆩𑆣𑆶𑆫𑆳𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆩𑆱𑆷𑆫𑆳 𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆱𑆂 𑇅 𑆩𑆑𑆶𑆰𑇀𑆜𑆑𑆳𑆂 𑆑𑆸𑆩𑆴𑆑𑆫𑆳𑆂.... 𑆑𑆬𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆖𑆶𑆫𑆳𑆤𑆴𑆬𑆳𑆂 𑇆𑇓𑇐𑇆

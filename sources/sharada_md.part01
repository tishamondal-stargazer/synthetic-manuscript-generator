𑆗𑆫𑇀𑆢𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆳𑆂𑇅 𑆨𑇀𑆫𑆩𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆾 𑆫𑆷𑆥𑆳𑆟𑆳𑆩𑆱𑆠𑆳𑆁 𑆖𑆽𑆮 𑆢𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇑𑇐𑇔𑇆
𑆠𑆸𑆟𑆨𑆱𑇀𑆩𑆬𑆠𑆳𑆥𑆫𑇀𑆟𑆥𑆳𑆁𑆯𑆶𑆨𑆴𑆯𑇀𑆖𑆳𑆮𑆥𑆷𑆫𑆟𑆩𑇀𑇅 𑆥𑇀𑆫𑆣𑆫𑇀𑆰𑆟𑆁 𑆮𑆴𑆲𑆕𑇀𑆓𑆽𑆯𑇀𑆖 𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆖𑆼𑆠𑆳𑆂 𑆱 𑆩𑆤𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇕𑇆
𑆮𑇀𑆪𑆳𑆑𑆶𑆬𑆳𑆤𑆳𑆩𑆯𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆤𑆳𑆁 𑆢𑆫𑇀𑆯𑆤𑆳𑆤𑆴 𑆖𑇅 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆱𑇀𑆪 𑆫𑆷𑆥𑆳𑆟𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇖𑇆
𑆱𑆫𑇀𑆮𑆁 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆩𑆣𑆴𑆑𑆁 𑆠𑆶 𑆪𑆩𑇀𑇅 𑆢𑆾𑆰𑆁 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆼 𑆥𑆯𑇀𑆪𑆼𑆠𑇀 𑆠𑆱𑇀𑆪𑆳𑆢𑆿 𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇆𑇑𑇐𑇗𑇆
𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳 𑆖 𑆑𑇀𑆫𑆴𑆪𑆳 𑆑𑆳𑆫𑇀𑆪𑆳 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆼𑇅 𑆥𑆴𑆠𑇀𑆠𑆩𑆳𑆫𑆶𑆠𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆲𑆴 𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆂𑇆𑇑𑇐𑇘𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆠𑆴𑆲𑆵𑆤𑆥𑆵𑆠𑆼𑆤 𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆱𑆩𑆥𑆵𑆠𑆼𑆤 𑆠𑆼𑆤𑆽𑆮 𑆱 𑆩𑆢𑇀𑆪𑆼𑆤𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇑𑇐𑇙𑇆
𑆘𑆵𑆫𑇀𑆟𑆳𑆩𑆩𑆢𑇀𑆪𑆢𑆾𑆰𑆳𑆪 𑆩𑆢𑇀𑆪𑆩𑆼𑆮 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆥𑇀𑆫𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆬𑆳𑆔𑆮𑆼 𑆘𑆳𑆠𑆼 𑆪𑆢𑇀𑆪𑆢𑆱𑇀𑆩𑆽 𑆲𑆴𑆠𑆁 𑆨𑆮𑆼𑆠𑇀𑇆𑇑𑇑𑇐𑇆
𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆳𑆤𑆶𑆱𑆁𑆮𑆴𑆢𑇀𑆣𑆁 𑆯𑆵𑆠𑆁 𑆱𑆧𑆴𑆝𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀𑇅 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆾𑆥𑆼𑆠𑆁 𑆘𑆬𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆠𑇀 𑇆𑇑𑇑𑇑𑇆
𑆠𑆵𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆼𑆤𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆥𑆵𑆠𑆼𑆤𑆳𑆩𑇀𑆬𑆮𑆴𑆢𑆳𑆲𑆴𑆤𑆳𑇅 𑆩𑆢𑇀𑆪𑆼𑆤𑆳𑆤𑇀𑆤𑆫𑆱𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆢𑆾 𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆑𑇀𑆰𑆳𑆫𑆠𑆳𑆁 𑆓𑆠𑆂𑇆𑇑𑇑𑇒𑇆
𑆃𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆁 𑆘𑇀𑆮𑆫𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆥𑇀𑆫𑆩𑆾𑆲𑆁 𑆮𑆴𑆨𑇀𑆫𑆩𑆁 𑆩𑆢𑆩𑇀𑇅 𑆘𑆤𑆪𑆠𑇀𑆪𑆳𑆯𑆶 𑆠𑆖𑇀𑆗𑆳𑆤𑇀𑆠𑇀𑆪𑆽 𑆩𑆢𑇀𑆪𑆩𑆼𑆮 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇑𑇓𑇆
𑆑𑇀𑆰𑆳𑆫𑆾 𑆲𑆴 𑆪𑆳𑆠𑆴 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁 𑆯𑆵𑆔𑇀𑆫𑆩𑆩𑇀𑆬𑆾𑆥𑆱𑆁𑆲𑆴𑆠𑆂𑇅 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆩𑇀𑆬𑆼𑆰𑆶 𑆩𑆢𑇀𑆪𑆁 𑆖 𑆪𑆽𑆫𑇀𑆓𑆶𑆟𑆽𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑆫𑆁 𑆯𑆸𑆟𑆶𑇆𑇑𑇑𑇔𑇆
𑆩𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆩𑇀𑆬𑆱𑇀𑆮𑆨𑆳𑆮𑆱𑇀𑆪 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆤𑆶𑆫𑆱𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇅 𑆩𑆣𑆶𑆫𑆯𑇀𑆖 𑆑𑆰𑆳𑆪𑆯𑇀𑆖 𑆠𑆴𑆑𑇀𑆠𑆂 𑆑𑆛𑆶𑆑 𑆍𑆮 𑆖𑇆𑇑𑇑𑇕𑇆
𑆓𑆶𑆟𑆳𑆯𑇀𑆖 𑆢𑆯 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆨𑆴𑆫𑇀𑆓𑆶𑆟𑆽𑆂𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆩𑆢𑇀𑆪𑆩𑆩𑇀𑆬𑆳𑆤𑆳𑆩𑆶𑆥𑆫𑇀𑆪𑆶𑆥𑆫𑆴 𑆠𑆴𑆰𑇀𑆜𑆠𑆴𑇆𑇑𑇑𑇖𑇆
𑆩𑆢𑇀𑆪𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆼𑆤 𑆢𑆾𑆰𑆼𑆟 𑆫𑆶𑆢𑇀𑆣𑆂 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑆶 𑆩𑆳𑆫𑆶𑆠𑆂𑇅 𑆑𑆫𑆾𑆠𑆴 𑆮𑆼𑆢𑆤𑆳𑆁 𑆠𑆵𑆮𑇀𑆫𑆳𑆁 𑆯𑆴𑆫𑆱𑇀𑆪𑆱𑇀𑆡𑆴𑆰𑆶 𑆱𑆤𑇀𑆣𑆴𑆰𑆶𑇆𑇑𑇑𑇗𑇆
𑆢𑆾𑆰𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆤𑆳𑆫𑇀𑆡𑆁 𑆲𑆴 𑆠𑆱𑇀𑆩𑆽 𑆩𑆢𑇀𑆪𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇅 𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆠𑆪𑆳 𑆢𑆼𑆪𑆩𑆩𑇀𑆬𑆼(𑆤𑇀𑆪𑆼)𑆰𑆶 𑆱𑆠𑇀𑆱𑇀𑆮𑆥𑆴𑇆𑇑𑇑𑇘𑇆
𑆫𑆶𑆘𑆂 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆫𑆶𑆢𑇀𑆣𑆼𑆰𑆶 𑆩𑆳𑆫𑆶𑆠𑆼 𑆖𑆳𑆤𑆶𑆬𑆾𑆩𑆴𑆠𑆼𑇅 𑆤𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆮𑆴𑆑𑆳𑆫𑆳𑆯𑇀𑆖 𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆱𑇀𑆪 𑆩𑆢𑆾𑆢𑆪𑆳𑆂𑇆𑇑𑇒𑇐𑇆
𑆧𑆵𑆘𑆥𑆷𑆫𑆑𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆑𑆾𑆬𑆢𑆳𑆝𑆴𑆩𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆪𑆮𑆳𑆤𑆵𑆲𑆥𑆶𑆰𑆳𑆘𑆳𑆘𑆵𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆳𑆮𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑇀𑇆𑇑𑇒𑇑𑇆
𑆱𑆱𑇀𑆤𑆼𑆲𑆽𑆂 𑆯𑆑𑇀𑆠𑆶𑆨𑆴𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆮𑆢𑆁𑆯𑆽𑆫𑇀𑆮𑆴𑆫𑆾𑆖𑆴𑆠𑆩𑇀 𑇅 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆬𑆮𑆟𑆁 𑆩𑆢𑇀𑆪𑆁 𑆥𑆽𑆰𑇀𑆛𑆴𑆑𑆁 𑆮𑆳𑆠𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇆𑇑𑇒𑇒𑇆
𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆮𑆳𑆠𑆾𑆬𑇀𑆧𑆟𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆫𑆱𑆽𑆯𑇀𑆖𑆽𑆤𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇅 𑆬𑆳𑆮𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆢𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆩𑇀𑆬𑆽𑆂 𑆯𑆴𑆒𑆴𑆤𑆳𑆩𑆥𑆴𑇆𑇑𑇒𑇓𑇆
𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆁 𑆩𑆸𑆓𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆩𑆳𑆤𑆷𑆥𑆳𑆤𑆳𑆁 𑆖 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆽𑆂𑇅 𑆨𑆷𑆯𑆪𑆥𑇀𑆫𑆱𑆲𑆳𑆤𑆳𑆁 𑆖 𑆫𑆱𑆽𑆂 𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆼𑆤 𑆖𑇆𑇑𑇒𑇔𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆽𑆯𑇀𑆖 𑆮𑆼𑆯𑆮𑆳𑆫𑆽𑆫𑇀𑆩𑆶𑆒𑆥𑇀𑆫𑆴𑆪𑆽𑆂𑇅 𑆖𑆴𑆠𑇀𑆫𑆽𑆫𑇀𑆓𑆿𑆣𑆷𑆩𑆴𑆑𑆽𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆟𑆵𑆩𑆟𑇀𑆝𑆱𑆁𑆪𑆶𑆠𑆽𑆂 𑇆𑇑𑇒𑇕𑇆
𑆥𑆴𑆯𑆴𑆠𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆓𑆫𑇀𑆨𑆳𑆨𑆴𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆨𑆴𑆂 𑆥𑆷𑆥𑆮𑆫𑇀𑆠𑆴𑆨𑆴𑆂𑇅 𑆩𑆳𑆰𑆥𑆷𑆥𑆬𑆴𑆑𑆳𑆨𑆴𑆯𑇀𑆖 𑆮𑆳𑆠𑆴𑆑𑆁 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇑𑇒𑇖𑇆

𑆠𑆸𑆰𑇀𑆟𑆳 𑆢𑆳𑆲𑆾 𑆩𑆢𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆠𑆵𑆮𑇀𑆫𑆁 𑆯𑆷𑆬𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆯𑆵𑆠𑆳𑆨𑆴𑆑𑆳𑆩𑆾 𑆨𑆮𑆠𑆴 𑆯𑆵𑆠𑆼𑆤𑆽𑆮 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑇆𑇘𑇔𑇆
𑆃𑆠𑆵𑆮 𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆰𑇀𑆜𑆠𑇀𑆮𑆁 𑆠𑆡𑆽𑆮 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳 𑇅 𑆍𑆠𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆩𑆶𑆠𑇀𑆡𑆱𑇀𑆪 𑆯𑆷𑆬𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆁 𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇆𑇘𑇖𑇆
𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆫𑆷𑆥𑆳𑆟𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆩𑇀 𑇅 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇘𑇗𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆗𑆳𑆑𑆼𑆤 𑆮𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆶𑆰𑇀𑆟𑆁 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆨𑆾𑆘𑆤𑆩𑇀 𑇅 𑆖𑆴𑆫𑆧𑆴𑆬𑇀𑆮𑆳𑆕𑇀𑆑𑆶𑆫𑆳𑆤𑇀 𑆮𑆳𑆥𑆴 𑆠𑆽𑆬𑆨𑆸𑆰𑇀𑆛𑆳𑆁𑆱𑇀𑆠𑆶 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇆𑇙𑇐𑇆
𑆱𑆶𑆫𑆳 𑆱𑆿𑆮𑆵𑆫𑆑𑆁 𑆖𑆶𑆑𑇀𑆫𑆁 𑆩𑆱𑇀𑆠𑆷𑆢𑆯𑇀𑆮𑆴𑆠𑇀𑆠𑆡𑆳 𑆢𑆣𑆴 𑇅 𑆱𑆑𑆳𑆬𑆬𑆮𑆟𑆁 𑆥𑆼𑆪𑆁 𑆯𑆷𑆬𑆼 𑆮𑆳𑆠𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆼 𑇆𑇙𑇒𑇆
𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆷𑆰𑆾 𑆪𑆶𑆑𑇀𑆠𑆳𑆩𑇀𑆬𑆾 𑆬𑆳𑆮𑆑𑆵𑆪𑆷𑆰𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆂 𑇅 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆂 𑆱𑆩𑆫𑆴𑆖𑆾 𑆮𑆳𑆠𑆯𑆷𑆬𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇆𑇙𑇓𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆥𑆡𑇀𑆪𑆳𑆯𑇀𑆪𑆳𑆩𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆳𑆤𑇀 𑇅 𑆱𑆶𑆫𑆱𑆳𑆩𑆯𑇀𑆮𑆩𑆷𑆠𑇀𑆫𑆵𑆁 𑆖 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆪𑆶𑆠𑆳𑆤𑇀 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇙𑇔𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆖𑆼𑆠𑆴 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀 𑇅 𑆠𑆳𑆤𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆥𑆪𑆱𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑆳𑆩𑇀𑆧𑆬𑆴𑆑𑆼𑆤 𑆮𑆳 𑇆𑇙𑇖𑇆
𑆩𑆣𑇀𑆮𑆳𑆱𑆮𑆼𑆤 𑆖𑆶𑆑𑇀𑆫𑆼𑆟 𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆼𑆟 𑆮𑆳 𑇅 𑆃𑆡𑆮𑆽(𑆖𑆽)𑆠𑆳𑆤𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆫𑆱𑆼𑆤 𑆮𑆳 𑇆𑇙𑇗𑇆
𑆠𑆡𑆳 𑆧𑆢𑆫𑆪𑆷𑆰𑆼𑆟 𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆴 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆂 𑇅 𑆠𑆳𑆤𑆴 𑆲𑆴𑆕𑇀𑆓𑆶𑆥𑇀𑆫𑆓𑆳𑆞𑆳𑆤𑆴 𑆱𑆲 𑆯𑆫𑇀𑆑𑆫𑆪𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇙𑇘𑇆
𑆱𑆲 𑆢𑆳𑆝𑆴𑆩𑆱𑆳𑆫𑆼𑆟 𑆮𑆫𑇀𑆠𑆴𑆂 𑆑𑆳𑆫𑇀𑆪𑆳 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆳 𑇅 𑆱𑆳 𑆮𑆫𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆴𑆑𑆁 𑆯𑆷𑆬𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆼𑆮 𑆮𑇀𑆪𑆥𑆾𑆲𑆠𑆴 𑇆𑇙𑇙𑇆
𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆂 𑆥𑇀𑆫𑆢𑆼𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆔𑆸𑆠𑆥𑆷𑆫𑆳 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇅 𑆮𑆳𑆫𑆶𑆟𑆵𑆁 𑆖 𑆥𑆴𑆧𑆼𑆘𑇀𑆘𑆤𑇀𑆠𑆶𑆱𑇀𑆠𑆡𑆳 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆶𑆒𑆵 𑇆𑇑𑇐𑇒𑇆
𑆱 𑆱𑆶𑆒𑆁 𑆗𑆫𑇀𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆥𑆵𑆠𑇀𑆮𑆳 𑆯𑆵𑆠𑆾𑆢𑆑𑆁 𑆤𑆫𑆂 𑇅 𑆯𑆵𑆠𑆬𑆳𑆤𑆴 𑆖 𑆱𑆼𑆮𑆼𑆠 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆤𑆴 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇔𑇆
𑆩𑆟𑆴𑆫𑆳𑆘𑆠𑆠𑆳𑆩𑇀𑆫𑆳𑆟𑆴 𑆨𑆳𑆘𑆤𑆳𑆤𑆴 𑆖 𑆱𑆫𑇀𑆮𑆯𑆂 𑇅 𑆮𑆳𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆠𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆯𑆷𑆬𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆤𑆴𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀 𑇆𑇑𑇐𑇕𑇆
𑆓𑆶𑆝𑆂 𑆯𑆳𑆬𑆴𑆫𑇀𑆪𑆮𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆂𑆥𑆳𑆤𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇅 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆴 𑆖 𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆨𑆼𑆰𑆘𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑆷𑆬𑆴𑆤𑆳𑆩𑇀 𑇆𑇑𑇐𑇖𑇆
𑆫𑆱𑆳𑆤𑇀 𑆱𑆼𑆮𑆼𑆠 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆤𑇀 𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆤𑆴 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆥𑆳𑆬𑆳𑆯𑆁 𑆣𑆳𑆤𑇀𑆮𑆤𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆷𑆰𑆁 𑆱𑆯𑆫𑇀𑆑𑆫𑆩𑇀 𑇆𑇑𑇐𑇗𑇆
𑆥𑆫𑆶𑆰𑆑𑆳𑆟𑆴 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆒𑆫𑇀𑆘𑆷𑆫𑆾𑆢𑆑𑆘𑆳𑆤𑇀𑆪𑆥𑆴 𑇅 𑆠𑆠𑇀 𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑆫𑇀𑆑𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑆷𑆬𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇆𑇑𑇐𑇘𑇆
𑆃𑆯𑆤𑆼 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆠𑆶 𑆥𑇀𑆫𑆑𑆾𑆥𑆂 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆱𑇀𑆪 𑆖 𑇅 𑆮𑆩𑆤𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑆠𑆠𑇀𑆫 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆳𑆫𑆴𑆟𑆳 𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇐𑇙𑇆
𑆫𑆷𑆑𑇀𑆰𑆂 𑆱𑇀𑆮𑆼𑆢𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆳𑆯𑇀𑆖𑆾𑆰𑇀𑆟𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳 𑆲𑆴𑆠𑆳𑆂 𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆁 𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆷𑆬𑆼 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆩𑇀 𑇆𑇑𑇑𑇐𑇆
𑆥𑆳𑆜𑆳𑆁 𑆮𑆖𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆁 𑆠𑆡𑆳 𑆑𑆛𑆶𑆑𑆫𑆾𑆲𑆴𑆟𑆵𑆩𑇀 𑇅 𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑇀𑆪 𑆖 𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆷𑆰𑆁 𑆱𑆲𑆳𑆫𑇀𑆘𑆑𑆩𑇀 𑇆𑇑𑇑𑇑𑇆
𑆍𑆫𑆟𑇀𑆝𑆦𑆬𑆩𑆷𑆬𑆳𑆤𑆴 𑆩𑆷𑆬𑆁 𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆱𑇀𑆪 𑆖 𑇅 𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆁 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵𑆁 𑆧𑆸𑆲𑆠𑆵𑆁 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆩𑇀 𑇆𑇑𑇑𑇒𑇆

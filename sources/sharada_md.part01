𑆑𑆶𑆯𑆬𑆱𑇀𑆪𑆳𑆥𑆴 𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆪 𑆪𑆠𑆂 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆴𑆲𑆳𑆣𑇀𑆫𑆶𑆮𑆳 𑇅 𑆇𑆥𑆑𑇀𑆫𑆩𑆾 𑆘𑆔𑆤𑇀𑆪𑆾𑇁𑆪𑆩𑆠𑆂 𑆱𑆩𑇀𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇒𑇘𑇆
𑆃𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆳𑆁 𑆣𑇀𑆫𑆶𑆮𑆾 𑆩𑆸𑆠𑇀𑆪𑆶𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆳𑆁 𑆱𑆁𑆯𑆪𑆾 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆥𑆸𑆖𑇀𑆗𑇀𑆪 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑆵𑆯𑇀𑆮𑆫𑆁 𑆱𑆳𑆣𑆶𑆑𑆳𑆫𑆴𑆟𑆳 𑇆𑇒𑇙𑇆
𑆃𑆡 𑆫𑆾𑆓𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑆶𑆥𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆥𑆑𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆩𑆵𑆰𑆠𑇀𑆑𑆫𑇀𑆯𑆴𑆠𑆩𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆯𑆫𑆵𑆫𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆁 𑆑𑆸𑆠𑆧𑆬𑆴𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆩𑆓𑇀𑆫𑆾𑆥𑆲𑆫𑆟𑆵𑆪𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆑𑆬𑇀𑆥𑆴𑆠𑆱𑆩𑇀𑆨𑆳𑆫𑆩𑆳𑆯𑇀𑆮𑆳𑆱𑇀𑆪, 𑆠𑆠𑆾 𑆧𑆬𑆮𑆤𑇀𑆠𑆩𑆮𑆴𑆑𑇀𑆬𑆮𑆩𑆳𑆘𑆳𑆤𑆶𑆱𑆩𑆼 𑆦𑆬𑆑𑆼 𑆥𑇀𑆫𑆳𑆓𑆶𑆥𑆮𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆪𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆼 𑆤𑆴𑆰𑆟𑇀𑆟𑆥𑆷𑆫𑇀𑆮𑆑𑆳𑆪𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆩𑆶𑆤𑇀𑆤𑆠𑆑𑆛𑆵𑆑𑆁 𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆣𑆳𑆫𑆑𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆁 𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆘𑆳𑆤𑆶𑆑𑆷𑆫𑇀𑆥𑆫𑆩𑆴𑆠𑆫𑆼𑆟 𑆱𑆲𑆳𑆮𑆧𑆢𑇀𑆣𑆁 𑆱𑆷𑆠𑇀𑆫𑆼𑆟 𑆯𑆳𑆛𑆑𑆽𑆫𑇀𑆮𑆳, 𑆠𑆠𑆂 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆤𑆳𑆨𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆱𑇀𑆪 𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆁 𑆮𑆴𑆩𑆸𑆢𑇀𑆪 𑆩𑆶𑆰𑇀𑆛𑆴𑆤𑆳𑇁𑆮𑆥𑆵𑆝𑆪𑆼𑆢𑆣𑆾𑆤𑆳𑆨𑆼𑆫𑇀𑆪𑆳𑆮𑆢𑆯𑇀𑆩𑆫𑇀𑆪𑆣𑆂 𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆼𑆠𑆴, 𑆠𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆼 𑆑𑇀𑆬𑆸𑆥𑇀𑆠𑆤𑆒𑆼 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆩𑆣𑇀𑆪𑆩𑆼 𑆃𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆿 𑆥𑆳𑆪𑆿 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪𑆳𑆤𑆶𑆱𑆼𑆮𑆤𑆵𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆧𑆬𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆳𑆪𑆶𑆩𑆼𑆞𑇀𑆫𑆳𑆤𑇀𑆠𑆫𑆩𑆳𑆤𑆵𑆪, 𑆤𑆴𑆫𑇀𑆮𑇀𑆪𑆬𑆵𑆑𑆩𑆤𑆳𑆪𑆠𑆩𑆮𑆴𑆰𑆩𑆁 𑆖 𑆧𑆱𑇀𑆠𑆴𑆁 𑆱𑆤𑇀𑆤𑆴𑆮𑆼𑆯𑇀𑆪, 𑆨𑆸𑆯𑆩𑆶𑆠𑇀𑆥𑆵𑆝𑆪𑆼𑆢𑆕𑇀𑆓𑆶𑆬𑆴𑆨𑇀𑆪𑆳𑆁 𑆪𑆡𑆳 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑆴𑆮𑆾𑆤𑇀𑆤𑆠𑆁 𑆯𑆬𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 𑇆𑇓𑇐𑇆
𑆱 𑆖𑆼𑆢𑇀𑆓𑆸𑆲𑆵𑆠𑆯𑆬𑇀𑆪𑆼 𑆠𑆶 𑆮𑆴𑆮𑆸𑆠𑆳𑆑𑇀𑆰𑆾 𑆮𑆴𑆖𑆼𑆠𑆤𑆂 𑇅 𑆲𑆠𑆮𑆬𑇀𑆬𑆩𑇀𑆧𑆯𑆵𑆫𑇀𑆰𑆯𑇀𑆖 𑆤𑆴𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆾 𑆩𑆸𑆠𑆾𑆥𑆩𑆂 𑇆𑇓𑇑𑇆
𑆤 𑆠𑆱𑇀𑆪 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆖𑇀𑆗𑆬𑇀𑆪𑆁 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀𑆠𑆶 𑆩𑇀𑆫𑆴𑆪𑆼𑆠 𑆱𑆂 𑇅 𑆮𑆴𑆤𑆳 𑆠𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆫𑆷𑆥𑆼𑆰𑆶 𑆤𑆴𑆫𑇀𑆲𑆫𑇀𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑆮𑆽 𑇆𑇓𑇒𑇆
𑆠𑆠𑆂 𑆱𑆮𑇀𑆪𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆱𑆼𑆮𑆤𑆵𑆁 𑆪𑆮𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆩𑆶𑆑𑇀𑆠𑇀𑆮𑆳𑇁𑆮𑆖𑆳𑆫𑆪𑆼𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆩𑆯𑇀𑆩𑆫𑆵𑆥𑇀𑆫𑆩𑆳𑆟𑆁, 𑆢𑆑𑇀𑆰𑆴𑆟𑆠𑆾 𑆮𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆿𑆑𑆫𑇀𑆪𑆲𑆼𑆠𑆾𑆫𑆴𑆠𑇀𑆪𑆼𑆑𑆼, 𑆪𑆡𑆳 𑆱𑆳 𑆤 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑆖𑆷𑆫𑇀𑆟𑇀𑆪𑆠𑆼 𑆮𑆳 𑆠𑆡𑆳 𑆥𑇀𑆫𑆪𑆠𑆼𑆠, 𑆖𑆷𑆫𑇀𑆟𑆩𑆬𑇀𑆥𑆩𑆥𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆁 𑆲𑆴 𑆥𑆶𑆤𑆂 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆼𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆩𑆱𑇀𑆠𑆳𑆩𑆓𑇀𑆫𑆮𑆑𑇀𑆫𑆼𑆟𑆳𑆢𑆢𑆵𑆠; 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆠𑆶 𑆧𑆱𑇀𑆠𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆓𑆠𑆾 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆂 𑆱𑆤𑇀𑆤𑆴𑆑𑆸𑆰𑇀𑆛𑆂, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆳𑆱𑆳𑆩𑆶𑆠𑇀𑆱𑆕𑇀𑆓𑆮𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆳𑆠𑆪𑆼𑆠𑇀, 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆒𑆬𑇀𑆮𑆳𑆱𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆳𑆮𑆵 𑆮𑇀𑆫𑆟𑆾 𑆨𑆮𑆼𑆠𑇀, 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆱𑆼𑆑𑆑𑇀𑆰𑆟𑆤𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆫𑆟𑆩𑇀; 𑆃𑆯𑇀𑆩𑆫𑆵𑆮𑇀𑆫𑆟𑆳𑆢𑆸𑆠𑆼 𑆨𑆴𑆤𑇀𑆤𑆧𑆱𑇀𑆠𑆴𑆫𑆼𑆑𑆣𑆳𑇁𑆥𑆴 𑆤 𑆨𑆮𑆠𑆴, 𑆢𑇀𑆮𑆴𑆣𑆳 𑆨𑆴𑆤𑇀𑆤𑆧𑆱𑇀𑆠𑆴𑆫𑆳𑆯𑇀𑆩𑆫𑆴𑆑𑆾 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴, 𑆃𑆯𑇀𑆩𑆫𑆵𑆮𑇀𑆫𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆼𑆑𑆣𑆳𑆨𑆴𑆤𑇀𑆤𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆘𑆵𑆮𑆠𑆴 ,𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑇀𑆪𑆳𑆱𑆳𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆲𑆴𑆠𑆖𑇀𑆗𑆼𑆢𑆳𑆤𑇀𑆤𑆴𑆂 - 𑆱𑇀𑆪𑆤𑇀𑆢𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆯𑆬𑇀𑆪𑆱𑇀𑆪𑆼𑆠𑆴 𑇅 𑆇𑆢𑇀𑆣𑆸𑆠𑆯𑆬𑇀𑆪𑆁 𑆠𑆷𑆰𑇀𑆟𑆾𑆢𑆑𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆩𑆮𑆓𑆳𑆲𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆠𑆡𑆳 𑆲𑆴 𑆧𑆱𑇀𑆠𑆴𑆫𑆱𑆸𑆘𑆳 𑆤 𑆥𑆷𑆫𑇀𑆪𑆠𑆼; 𑆥𑆷𑆫𑇀𑆟𑆼 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆁 𑆥𑆶𑆰𑇀𑆥𑆤𑆼𑆠𑇀𑆫𑆼𑆟 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇓𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆱𑇀𑆠𑆶 𑆥𑆶𑆰𑇀𑆥𑆤𑆼𑆠𑇀𑆫𑆼𑆟 𑆪𑆾𑆘𑆴𑆠𑆂 𑇅 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑆯𑇀𑆩𑆫𑆵𑆁 𑆠𑆷𑆫𑇀𑆟𑆁 𑆫𑆑𑇀𑆠𑆁 𑆧𑆱𑇀𑆠𑆴𑆓𑆠𑆁 𑆖 𑆪𑆠𑇀 𑇆𑇓𑇔𑇆
𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆮𑆴𑆯𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆓𑆶𑆝𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀; 𑆇𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆖𑆽𑆤𑆁 𑆩𑆣𑆶𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆮𑇀𑆫𑆟𑆁 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆯𑆾𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆴𑆢𑇀𑆣𑆳𑆩𑆶𑆰𑇀𑆟𑆳𑆁 𑆱𑆔𑆸𑆠𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑆾𑆨𑆪𑆑𑆳𑆬𑆁 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁; 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆓𑆶𑆝𑆥𑇀𑆫𑆓𑆳𑆞𑆼𑆤 𑆥𑆪𑆱𑆳 𑆩𑆸𑆢𑇀𑆮𑆾𑆢𑆤𑆩𑆬𑇀𑆥𑆁 𑆨𑆾𑆘𑆪𑆼𑆢𑇀𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 (𑆩𑆷𑆠𑇀𑆫𑆳𑆱𑆸𑆓𑇀𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑇀𑆫𑆟𑆑𑇀𑆬𑆼𑆢𑆤𑆳𑆫𑇀𑆡𑆁 𑆖), 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆦𑆬𑆳𑆩𑇀𑆬𑆽𑆫𑇀𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀; 𑆠𑆠𑆾 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 𑆖𑆽𑆤𑆩𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆂 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆢𑇀𑆫𑆮𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑆮𑆳; 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆼𑆟 𑆖𑆳𑆱𑇀𑆪 𑆮𑇀𑆫𑆟𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆪𑆼𑆠𑇀; 𑆫𑆾𑆣𑇀𑆫𑆩𑆣𑆶𑆑𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑇀𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑆴𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀; 𑆍𑆠𑆼𑆰𑇀𑆮𑆼𑆮 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆪𑆶𑆠𑆼𑆰𑆶 𑆠𑆽𑆬𑆁 𑆔𑆸𑆠𑆁 𑆮𑆳 𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆮𑇀𑆫𑆟𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆩𑆴𑆠𑆴; 𑆱𑇀𑆠𑇀𑆪𑆳𑆤𑆯𑆾𑆟𑆴𑆠𑆁 𑆖𑆾𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀; 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆖𑇀𑆖 𑆱𑇀𑆮𑆩𑆳𑆫𑇀𑆓𑆩𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆼 𑆩𑆷𑆠𑇀𑆫𑆼 𑆮𑇀𑆫𑆟𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆢𑆲𑆼𑆢𑆓𑇀𑆤𑆴𑆤𑆳, 𑆱𑇀𑆮𑆩𑆳𑆫𑇀𑆓𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆼 𑆖𑆾𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆤𑇀𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆽𑆫𑆴𑆠𑆴; 𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆳 𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆳𑆩𑆤𑇀𑆠𑆫𑆳𑆱𑆑𑇀𑆠𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆁 𑆮𑆳 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑇁𑆥𑆲𑆫𑆼𑆠𑇀, 𑆍𑆮𑆁 𑆖𑆳𑆯𑆑𑇀𑆪𑆼 𑆮𑆴𑆢𑆳𑆫𑇀𑆪 𑆤𑆳𑆝𑆵𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆧𑆝𑆴𑆯𑆼𑆤𑆾𑆢𑇀𑆣𑆫𑆼𑆠𑇀 𑇅 𑆫𑆷𑆞𑆮𑇀𑆫𑆟𑆯𑇀𑆖𑆳𑆕𑇀𑆓𑆤𑆳𑆯𑇀𑆮𑆤𑆓𑆤𑆳𑆓𑆫𑆡𑆢𑇀𑆫𑆶𑆩𑆳𑆤𑇀 𑆤𑆳𑆫𑆾𑆲𑆼𑆠 𑆮𑆫𑇀𑆰𑆁, 𑆤𑆳𑆥𑇀𑆱𑆶 𑆥𑇀𑆬𑆮𑆼𑆠, 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆮𑆳 𑆓𑆶𑆫𑆶 𑇆𑇓𑇕𑇆
𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆩𑆶𑆰𑇀𑆑𑆱𑇀𑆫𑆾𑆠𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆱𑆼𑆑𑆱𑆼𑆮𑆤𑆵𑆪𑆾𑆤𑆴𑆓𑆶𑆢𑆧𑆱𑇀𑆠𑆵𑆤𑆰𑇀𑆛𑆿 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆖𑇀𑆗𑆼𑆢𑆳𑆤𑇀𑆩𑆫𑆟𑆁 𑆩𑆷𑆠𑇀𑆫𑆥𑆷𑆫𑇀𑆟𑆧𑆱𑇀𑆠𑆼𑆂, 𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆖𑇀𑆗𑆼𑆢𑆳𑆤𑇀𑆩𑆫𑆟𑆁 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆁 𑆮𑆳, 𑆩𑆶𑆰𑇀𑆑𑆱𑇀𑆫𑆾𑆠-𑆇𑆥𑆔𑆳𑆠𑆳𑆢𑇀 𑆣𑇀𑆮𑆘𑆨𑆕𑇀𑆓𑆂, 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆱𑆼𑆑𑆑𑇀𑆰𑆟𑆤𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆑𑇀𑆰𑆫𑆟𑆁, 𑆱𑆼𑆮𑆤𑆵𑆪𑆾𑆤𑆴𑆖𑇀𑆗𑆼𑆢𑆳𑆢𑇀𑆫𑆶𑆘𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂, 𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆢𑆮𑆴𑆢𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆩𑆴𑆠𑆴 𑇆𑇓𑇖𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆰𑇀𑆛𑆳𑆮𑆱𑆩𑇀𑆧𑆶𑆣𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆳𑆤𑆴 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆼𑆢𑇀𑆧𑆲𑆷𑆤𑇀𑆩𑆫𑇀𑆠𑇀𑆪𑆳𑆤𑇀 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆥𑆛𑆶𑆫𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇗𑇆
𑆱𑆼𑆮𑆤𑆵 𑆯𑆶𑆑𑇀𑆫𑆲𑆫𑆟𑆵 𑆱𑇀𑆫𑆾𑆠𑆱𑆵 𑆦𑆬𑆪𑆾𑆫𑇀𑆓𑆶𑆢𑆩𑇀 𑇅 𑆩𑆷𑆠𑇀𑆫𑆱𑆼𑆑𑆁 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆁 𑆪𑆾𑆤𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆠𑆡𑆳𑇁𑆰𑇀𑆛𑆩𑆂 𑇆𑇓𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆟𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑆚𑇀𑆖 𑆨𑆓𑆤𑇀𑆢𑆫𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 , 𑆠𑆼𑆰𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆂 𑆯𑆩𑇀𑆧𑆷𑆑𑆳𑆮𑆫𑇀𑆠𑆂 𑆯𑆬𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆯𑇀𑆖; 𑆯𑆼𑆰𑆳𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆂 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆨𑆓𑆤𑇀𑆢𑆫𑆥𑆴𑆝𑆑𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑆳𑆠𑆶𑆫𑆩𑆥𑆠𑆫𑇀𑆥𑆟𑆳𑆢𑆴𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑇀𑆠𑆼𑆤𑆽𑆑𑆳𑆢𑆯𑆮𑆴𑆣𑆼𑆤𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆟𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑆳𑆥𑆑𑇀𑆮𑆥𑆴𑆝𑆑𑆁, 𑆥𑆑𑇀𑆮𑆼𑆰𑆶 𑆖𑆾𑆥𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆮𑆓𑆳𑆲𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆮𑆼𑆯𑇀𑆪𑆳𑆫𑇀𑆯𑆱𑆩𑆴𑆮 𑆪𑆤𑇀𑆠𑇀𑆫𑆪𑆴𑆠𑇀𑆮𑆳, 𑆨𑆓𑆤𑇀𑆢𑆫𑆁 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑆫𑆳𑆖𑆵𑆤𑆩𑆮𑆳𑆖𑆵𑆤𑆁 𑆮𑆳, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪𑆽𑆰𑆟𑆵𑆩𑆶𑆤𑇀𑆤𑆩𑇀𑆪 𑆱𑆳𑆯𑆪𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆼𑆟; 𑆃𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆼 𑆖𑆽𑆮𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪 𑆥𑇀𑆫𑆮𑆳𑆲𑆩𑆳𑆟𑆱𑇀𑆪 𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑆶𑆒𑆩𑆳𑆱𑆳𑆢𑇀𑆪𑆽𑆰𑆟𑆵𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆳𑆠𑆪𑆼𑆠𑇀; 𑆄𑆱𑆳𑆢𑇀𑆪 𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆁 𑆑𑇀𑆰𑆳𑆫𑆁 𑆖𑆼𑆠𑆴; 𑆍𑆠𑆠𑇀 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑇆𑇔𑇆
𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶- 𑆤𑆳𑆝𑇀𑆪𑆤𑇀𑆠𑆫𑆼 𑆮𑇀𑆫𑆟𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆠𑆶 𑆯𑆠𑆥𑆾𑆤𑆑𑆼 𑇅 𑆠𑆠𑆱𑇀𑆠𑆼𑆰𑆷𑆥𑆫𑆷𑆞𑆼𑆰𑆶 𑆯𑆼𑆰𑆳 𑆤𑆳𑆝𑆵𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇕𑇆
𑆓𑆠𑆪𑆾𑇁𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆳 𑆧𑆳𑆲𑇀𑆪𑆳𑆯𑇀𑆗𑆼𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆤𑆼𑆑𑆣𑆳 𑇅 𑆤𑆳𑆝𑆵𑆫𑆤𑆨𑆴𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆳 𑆪𑆯𑇀𑆗𑆴𑆤𑆠𑇀𑆠𑇀𑆪𑆼𑆑𑆣𑆳 𑆨𑆴𑆰𑆑𑇀 𑇆𑇖𑇆
𑆱 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆮𑆸𑆠𑆁 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆮𑇀𑆫𑆟𑆁 𑆓𑆶𑆢𑆮𑆴𑆢𑆳𑆫𑆟𑆩𑇀 𑇅 𑆠𑆱𑇀𑆪 𑆠𑆢𑇀𑆮𑆴𑆮𑆸𑆠𑆁 𑆩𑆳𑆫𑇀𑆓𑆁 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆩𑆤𑆶𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇗𑇆
𑆄𑆛𑆾𑆥𑆁 𑆓𑆶𑆢𑆯𑆷𑆬𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴 𑆥𑆮𑆤𑆾 𑆨𑆸𑆯𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫𑆳𑆣𑆴𑆓𑆠𑆠𑆤𑇀𑆠𑇀𑆫𑆾𑇁𑆥𑆴 𑆨𑆴𑆰𑆕𑇀𑆩𑆶𑆲𑇀𑆪𑆼𑆢𑆱𑆁𑆯𑆪𑆩𑇀 𑇆𑇘𑇆
𑆃𑆫𑇀𑆣𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑆯𑇀𑆗𑆼𑆢𑆂 𑆑𑆳𑆫𑇀𑆪𑆾 𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑆾𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆱𑆫𑇀𑆮𑆠𑆾𑆨𑆢𑇀𑆫𑆑𑆾 𑆮𑆳𑇁𑆥𑆴 𑆑𑆳𑆫𑇀𑆪𑆾 𑆓𑆾𑆠𑆵𑆫𑇀𑆡𑆑𑆾𑇁𑆥𑆴 𑆮𑆳 𑇆𑇑𑇐𑇆
𑆱𑆫𑇀𑆮𑆠𑆂 𑆱𑇀𑆫𑆳𑆮𑆩𑆳𑆫𑇀𑆓𑆳𑆁𑆱𑇀𑆠𑆶 𑆢𑆲𑆼𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆠𑆡𑆳𑇁𑆓𑇀𑆤𑆴𑆤𑆳 𑇅 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆨𑆵𑆫𑆾𑆫𑇀𑆲𑆴 𑆢𑆶𑆰𑇀𑆑𑆫𑆂 𑆯𑆠𑆥𑆾𑆤𑆑𑆂 𑇆𑇑𑇑𑇆
𑆫𑆶𑆘𑆳𑆱𑇀𑆫𑆳𑆮𑆳𑆥𑆲𑆁 𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆼𑆢𑆩𑆳𑆯𑆶 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆱𑇀𑆮𑆼𑆢𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆽𑆂 𑆑𑆸𑆯𑆫𑆳𑆥𑆳𑆪𑆱𑆳𑆢𑆴𑆨𑆴𑆂 𑇆𑇑𑇒𑇆
𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆽𑆫𑇀𑆬𑆳𑆮𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆽𑆂 𑇅 𑆮𑆸𑆑𑇀𑆰𑆳𑆢𑆤𑆵𑆩𑆡𑆽𑆫𑆟𑇀𑆝𑆁 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆁 𑆖 𑆓𑆟𑆁 𑆠𑆡𑆳 𑇆𑇑𑇓𑇆
𑆑𑆰𑆳𑆪𑆁 𑆱𑆶𑆑𑆸𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆑𑆶𑆩𑇀𑆨𑆼 𑆤𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀 𑇅 𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑆠𑆼𑆤𑆳𑆱𑇀𑆪 𑆠𑆁 𑆮𑇀𑆫𑆟𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇔𑇆
𑆠𑆴𑆬𑆽𑆫𑆟𑇀𑆝𑆳𑆠𑆱𑆵𑆩𑆳𑆰𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆱𑆫𑇀𑆰𑆥𑆳𑆤𑇀 𑇅 𑆬𑆮𑆟𑆳𑆤𑇀𑆪𑆩𑇀𑆬𑆮𑆫𑇀𑆓𑆁 𑆖 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆩𑆼𑆮𑆾𑆥𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆄𑆠𑆶𑆫𑆁 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀𑆠𑆼𑆤 𑆠𑆡𑆳 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆑𑆶𑆫𑇀𑆮𑆠𑆂 𑇅 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆖 𑆥𑆳𑆪𑆪𑆼𑆢𑆼𑆤𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖 𑇆𑇑𑇖𑇆
𑆮𑆖𑆳𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆘𑆩𑆾𑆢𑆁 𑆖 𑆱𑆩𑆨𑆳𑆓𑆳𑆤𑆴 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑇅 𑆩𑆳𑆫𑇀𑆢𑇀𑆮𑆵𑆑𑆼𑆤𑆳𑆡𑆮𑆳𑇁𑆩𑇀𑆬𑆼𑆤 𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆼𑆟 𑆮𑆳 𑇆𑇑𑇗𑇆
𑆠𑆠𑆾 𑆩𑆣𑆶𑆑𑆠𑆽𑆬𑆼𑆤 𑆠𑆱𑇀𑆪 𑆱𑆴𑆚𑇀𑆖𑆼𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆮𑇀𑆫𑆟𑆩𑇀 𑇅 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆼𑆢𑇀𑆓𑆶𑆢𑆁 𑆖𑆳𑆱𑇀𑆪 𑆠𑆽𑆬𑆽𑆫𑇀𑆮𑆳𑆠𑆫𑆶𑆘𑆳𑆥𑆲𑆽𑆂 𑇆𑇑𑇘𑇆

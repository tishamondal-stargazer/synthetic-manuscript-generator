𑆢𑆳𑆫𑇀𑆮𑆵 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆁 𑆮𑆳 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑇀𑆫𑆧𑆳𑆣𑆠𑆼 𑆑𑆶𑆰𑇀𑆜𑆩𑇀𑇅 𑆃𑆨𑆪𑆳 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆳 𑆮𑆳 𑆩𑆳𑆱𑆁 𑆱𑆮𑇀𑆪𑆾𑆰𑆓𑆶𑆝𑆠𑆽𑆬𑆳𑇆𑇖𑇑𑇆
𑆩𑆷𑆬𑆁 𑆥𑆛𑆾𑆬𑆱𑇀𑆪 𑆠𑆡𑆳 𑆓𑆮𑆳𑆑𑇀𑆰𑇀𑆪𑆳𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆬𑆳𑆁𑆯𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆠𑇀𑆮𑆖𑆯𑇀𑆖 𑇅 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆳𑆪𑆩𑆳𑆟𑆳 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵 𑆖 𑆨𑆳𑆓𑆳𑆫𑇀𑆣𑆴𑆑𑆳 𑆤𑆳𑆓𑆫𑆥𑆳𑆢𑆪𑆶𑆑𑇀𑆠𑆳𑇆𑇖𑇒𑇆
𑆥𑆬𑆁 𑆠𑆡𑆽𑆰𑆳𑆁 𑆱𑆲 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆤𑆳𑆁 𑆘𑆬𑆼 𑆯𑆸𑆠𑆁 𑆢𑆾𑆰𑆲𑆫𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆳𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆫𑆱𑆽𑆫𑇀𑆣𑆤𑇀𑆮𑆩𑆸𑆓𑆢𑇀𑆮𑆴𑆘𑆳𑆤𑆳𑆁 𑆥𑆶𑆫𑆳𑆟𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆩𑆳𑆢𑆢𑆵𑆠𑇆𑇖𑇓𑇆
𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆯𑆾𑆦𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆟𑆴 𑆲𑆬𑆵𑆩𑆑𑆁 𑆖𑇅 𑆰𑆝𑇀𑆫𑆳𑆠𑇀𑆫𑆪𑆾𑆓𑆼𑆤 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆖𑆽𑆰 𑆲𑆸𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆁 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆁 𑆖𑇆𑇖𑇔𑇆
𑆩𑆶𑆱𑇀𑆠𑆁 𑆮𑇀𑆪𑆾𑆰𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳 𑆢𑆳𑆫𑆶 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆢𑇀𑆮𑆼𑇅 𑆱𑆥𑇀𑆠𑆖𑇀𑆗𑆢𑆤𑆴𑆩𑇀𑆧𑆠𑇀𑆮𑆑𑇀 𑆱𑆮𑆴𑆯𑆳𑆬𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆩𑆷𑆫𑇀𑆮𑆳𑇆𑇖𑇕𑇆
𑆖𑆷𑆫𑇀𑆟𑆁 𑆠𑆫𑇀𑆥𑆟𑆨𑆳𑆓𑆽𑆫𑇀𑆤𑆮𑆨𑆴𑆂 𑆱𑆁𑆪𑆾𑆘𑆴𑆠𑆁 𑆱𑆩𑆣𑇀𑆮𑆳𑆘𑇀𑆪𑆩𑇀 𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑆶𑆰𑇀𑆜𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆁 𑆨𑆑𑇀𑆰𑇀𑆪𑆩𑇀𑇆𑇖𑇖𑇆
𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆱𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆯𑇀𑆮𑆴𑆠𑇀𑆫𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆫𑇀𑆯𑆳𑆁𑆱𑆴𑇅 𑆧𑇀𑆫𑆔𑇀𑆤𑆨𑆓𑆤𑇀𑆢𑆫𑆥𑆴𑆝𑆑𑆳𑆑𑆟𑇀𑆝𑆷𑆑𑆾𑆜𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆴𑇆𑇖𑇗𑇆
𑆅𑆠𑆴 𑆩𑆶𑆱𑇀𑆠𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆑𑆛𑆶𑆑𑆳𑆤𑆴𑆩𑇀𑆧𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆮𑆖𑆳𑆥𑆛𑆾𑆬𑆳𑆤𑆳𑆩𑇀𑇅 𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆫𑆘𑆤𑆵𑆢𑇀𑆮𑆪𑆥𑆢𑇀𑆩𑆑𑆩𑆷𑆫𑇀𑆮𑆳𑆮𑆴𑆯𑆳𑆬𑆳𑆤𑆳𑆩𑇀𑇆𑇖𑇘𑇆
𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆥𑆬𑆳𑆯𑆳𑆤𑆳𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆥𑆬𑆁 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆳𑇅 𑆠𑆱𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆶𑆤𑆫𑇀𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆱𑆶𑆥𑇀𑆠𑆴𑆤𑆶𑆠𑇀 𑆥𑆫𑆩𑆩𑇀𑇆𑇖𑇙𑇆
𑆬𑆼𑆬𑆵𑆠𑆑𑆥𑇀𑆫𑆪𑆾𑆓𑆾 𑆫𑆱𑆼𑆤 𑆘𑆳𑆠𑇀𑆪𑆳𑆂 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆂 𑆥𑆫𑆩𑆂𑇅 𑆱𑆥𑇀𑆠𑆢𑆯𑆑𑆶𑆰𑇀𑆜𑆔𑆳𑆠𑆵 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆣𑆳𑆠𑆶𑆯𑇀𑆖 𑆩𑆷𑆠𑇀𑆫𑆼𑆟𑇆𑇗𑇐𑇆
𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆓𑆤𑇀𑆣𑆑𑆪𑆾𑆓𑆳𑆠𑇀 𑆱𑆶𑆮𑆫𑇀𑆟𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆳𑇅 𑆱𑆫𑇀𑆮𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆩𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆵 𑆫𑆱𑆁 𑆖 𑆤𑆴𑆓𑆸𑆲𑆵𑆠𑆩𑇀𑇆𑇗𑇑𑇆
𑆮𑆘𑇀𑆫𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆱𑆲𑆴𑆠𑆁 𑆱𑆲𑆴𑆠𑆁 𑆮𑆳 𑆪𑆾𑆓𑆫𑆳𑆘𑆼𑆤𑇅 𑆱𑆫𑇀𑆮𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆢𑇀𑆪𑆳𑆠𑇀𑆑𑆶𑆰𑇀𑆜𑆵 𑆤𑆴𑆓𑆸𑆲𑇀𑆪 𑆤𑆴𑆠𑇀𑆪𑆁 𑆖𑇆𑇗𑇒𑇆
𑆒𑆢𑆴𑆫𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆱𑆳𑆫𑆁 𑆯𑇀𑆫𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆢𑇀𑆫𑆱𑆼𑆤 𑆠𑆾𑆪𑆳𑆫𑇀𑆡𑆂𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆑𑆳𑆫𑇀𑆪𑆂 𑆑𑆳𑆫𑇀𑆪𑆼 𑆠𑆼 𑆖𑆳𑆰𑇀𑆛𑆥𑆬𑆴𑆑𑆼 𑆖𑇆𑇗𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆰𑇀𑆛𑆥𑆬𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀𑆠𑆡𑆳𑇁𑆩𑆷𑆤𑆴𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆽𑆬𑆼 𑆠𑇀𑆮𑆕𑇀𑆩𑆫𑆴𑆖𑆁 𑆥𑆠𑇀𑆫𑆁 𑆑𑆤𑆑𑆁 𑆖 𑆑𑆫𑇀𑆰𑆳𑆁𑆯𑆩𑇀𑇆𑇗𑇔𑇆
𑆩𑆠𑇀𑆱𑇀𑆪𑆟𑇀𑆝𑆴𑆑𑆳 𑆩𑆣𑆶𑆱𑆩𑆳 𑆠𑆤𑇀𑆩𑆳𑆱𑆁 𑆘𑆳𑆠𑆩𑆳𑆪𑆱𑆼 𑆨𑆳𑆟𑇀𑆝𑆼𑇅 𑆩𑆣𑇀𑆮𑆳𑆱𑆮𑆩𑆳𑆖𑆫𑆠𑆂 𑆑𑆶𑆰𑇀𑆜𑆑𑆴𑆬𑆳𑆱𑆼 𑆯𑆩𑆁 𑆪𑆳𑆠𑆂𑇆𑇗𑇕𑇆
𑆅𑆠𑆴 𑆩𑆣𑇀𑆮𑆳𑆱𑆮𑆂𑇅 𑆒𑆢𑆴𑆫𑆑𑆰𑆳𑆪𑆢𑇀𑆫𑆾𑆟𑆁 𑆑𑆶𑆩𑇀𑆨𑆼 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆤𑆴 𑆖 𑆰𑆛𑇀𑆥𑆬𑆴𑆑𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆢𑆼𑆪𑆳𑆤𑆴𑇆𑇗𑇖𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆝𑆕𑇀𑆓𑆫𑆘𑆤𑆵𑆩𑆶𑆱𑇀𑆠𑆳𑆛𑆫𑆷𑆰𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆳𑆂𑇅 𑆱𑆿𑆮𑆫𑇀𑆟𑆵 𑆖 𑆠𑆡𑆳 𑆠𑇀𑆮𑆑𑇀 𑆗𑆴𑆤𑇀𑆤𑆫𑆶𑆲𑆳 𑆖𑆼𑆠𑆴 𑆠𑆤𑇀𑆩𑆳𑆱𑆩𑇀𑇆𑇗𑇗𑇆
𑆤𑆴𑆢𑆣𑆵𑆠 𑆣𑆳𑆤𑇀𑆪𑆩𑆣𑇀𑆪𑆼 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆠𑆾 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳𑇅 𑆩𑆳𑆱𑆼𑆤 𑆩𑆲𑆳𑆑𑆶𑆰𑇀𑆜𑆁 𑆲𑆤𑇀𑆠𑇀𑆪𑆼𑆮𑆳𑆬𑇀𑆥𑆁 𑆠𑆶 𑆥𑆑𑇀𑆰𑆼𑆟𑇆𑇗𑇘𑇆
𑆃𑆫𑇀𑆯𑆂𑆯𑇀𑆮𑆳𑆱𑆨𑆓𑆤𑇀𑆢𑆫𑆑𑆳𑆱𑆑𑆴𑆬𑆳𑆱𑆥𑇀𑆫𑆩𑆼𑆲𑆯𑆾𑆰𑆳𑆁𑆯𑇀𑆖𑇅 𑆤𑆳 𑆨𑆮𑆠𑆴 𑆑𑆤𑆑𑆮𑆫𑇀𑆟𑆂 𑆥𑆵𑆠𑇀𑆮𑆳𑇁𑆫𑆴𑆰𑇀𑆛𑆁 𑆑𑆤𑆑𑆧𑆴𑆤𑇀𑆢𑆶𑆩𑇀𑇆𑇗𑇙𑇆
𑆅𑆠𑆴 𑆑𑆤𑆑𑆧𑆴𑆤𑇀𑆢𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆩𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑇀𑆮𑆤𑆴𑆬𑆑𑆦𑆑𑆸𑆠𑆼𑆰𑇀𑆮𑆼𑆮𑆁 𑆥𑆼𑆪𑆱𑇀𑆠𑆡𑆳𑇁𑆥𑆴 𑆥𑆽𑆠𑇀𑆠𑆼𑆰𑆶𑇅 𑆑𑆸𑆠𑆩𑆳𑆬𑆑𑇀𑆮𑆳𑆡𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆼𑆰 𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀 𑆑𑆦𑆑𑆸𑆠𑆼𑆰𑆶𑇆𑇘𑇐𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆱𑆮𑆯𑇀𑆖 𑆓𑆿𑆝𑆂 𑆱𑆖𑆴𑆠𑇀𑆫𑆑𑆂 𑆑𑆶𑆰𑇀𑆜𑆫𑆾𑆓𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆳𑇅 𑆑𑇀𑆫𑆩𑆶𑆑𑆢𑆯𑆩𑆷𑆬𑆢𑆤𑇀𑆠𑆵𑆮𑆫𑆳𑆕𑇀𑆓𑆩𑆣𑆶𑆪𑆾𑆓𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆂𑇆𑇘𑇑𑇆
𑆬𑆔𑆷𑆤𑆴 𑆖𑆳𑆤𑇀𑆤𑆳𑆤𑆴 𑆲𑆴𑆠𑆳𑆤𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆯𑆳𑆑𑆤𑆴 𑆖 𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆤𑆴𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆽𑆂 𑆱𑆠𑇀𑆫𑆴𑆦𑆬𑆽𑆂 𑆱𑆤𑆴𑆩𑇀𑆧𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆤𑆳𑆤𑆴 𑆔𑆸𑆠𑆳𑆤𑆴 𑆖𑆽𑆮𑇆𑇘𑇒𑇆
𑆥𑆶𑆫𑆳𑆟𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆡 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆴 𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆩𑆶𑆢𑇀𑆓𑆳𑆯𑇀𑆖 𑆥𑆛𑆾𑆬𑆪𑆶𑆑𑇀𑆠𑆳𑆂𑇅 𑆯𑆱𑇀𑆠𑆳, 𑆤 𑆓𑆶𑆫𑇀𑆮𑆩𑇀𑆬𑆥𑆪𑆾𑆢𑆣𑆵𑆤𑆴 𑆤𑆳𑆤𑆷𑆥𑆩𑆠𑇀𑆱𑇀𑆪𑆳 𑆤 𑆓𑆶𑆝𑆱𑇀𑆠𑆴𑆬𑆳𑆯𑇀𑆖𑇆𑇘𑇓𑇆
𑆍𑆬𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆢𑆳𑆫𑇀𑆮𑆵 𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳 𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑇀𑆖𑇅 𑆑𑆶𑆰𑇀𑆜𑆳𑆬𑆼𑆥𑆤𑆩𑆴𑆰𑇀𑆛𑆁 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆁 𑆖𑆳𑆨𑆪𑆳 𑆖𑆽𑆮𑇆𑇘𑇔𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆼𑆬𑆳𑆁 𑆧𑆴𑆩𑇀𑆧𑆵𑆁 𑆮𑆸𑆰𑆑𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑆫𑇀𑆑𑆤𑆳𑆓𑆫𑆑𑆩𑇀𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆩𑆰𑇀𑆛𑆳𑆲𑆁 𑆨𑆳𑆮𑆪𑆴𑆠𑆮𑇀𑆪𑆁 𑆥𑆬𑆳𑆯𑆱𑇀𑆪𑇆𑇘𑇕𑇆

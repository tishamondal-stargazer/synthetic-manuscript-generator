𑆲𑆴𑆠𑆁 𑆯𑆾𑆟𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆨𑇀𑆪𑆂 𑆑𑇀𑆰𑆵𑆫𑆩𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆫𑇀𑆑𑆯𑆼𑆬𑆶𑆯𑆴𑆫𑆵𑆰𑆳𑆟𑆳𑆩𑆳𑆱𑆮𑆳𑆱𑇀𑆠𑆶 𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆴𑆰𑆶 𑇆𑇔𑇓𑇑𑇆
𑆃𑆠𑆂 𑆥𑆫𑆁 𑆠𑆶 𑆮𑆫𑇀𑆓𑆳𑆟𑆳𑆩𑆤𑆶𑆥𑆳𑆤𑆁 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀 𑇅 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆼𑆟 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆩𑆼 𑆯𑆸𑆟𑆶 𑇆𑇔𑇓𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆯𑆱𑇀𑆪𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆧𑆢𑆫𑆳𑆩𑇀𑆬𑆁, 𑆮𑆽𑆢𑆬𑆳𑆤𑆳𑆁 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆁, 𑆘𑆕𑇀𑆔𑆳𑆬𑆳𑆤𑆳𑆁 𑆣𑆤𑇀𑆮𑆘𑆳𑆤𑆳𑆁 𑆖 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆱𑆮𑆂, 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆳𑆟𑆳𑆁 𑆑𑆾𑆬𑆧𑆢𑆫𑆳𑆱𑆮𑆂, 𑆥𑇀𑆫𑆠𑆶𑆢𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆳𑆱𑆮𑆂, 𑆓𑆶𑆲𑆳𑆯𑆪𑆳𑆤𑆳𑆁 𑆒𑆫𑇀𑆘𑆷𑆫𑆤𑆳𑆬𑆴𑆑𑆼𑆫𑆳𑆱𑆮𑆂, 𑆥𑇀𑆫𑆱𑆲𑆳𑆤𑆳𑆩𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆱𑆮𑆂, 𑆥𑆫𑇀𑆟𑆩𑆸𑆓𑆳𑆟𑆳𑆁 𑆑𑆸𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆳𑆱𑆮𑆂, 𑆧𑆴𑆬𑆼𑆯𑆪𑆳𑆤𑆳𑆁 𑆦𑆬𑆳𑆱𑆮𑆂 , 𑆍𑆑𑆯𑆦𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆱𑆮𑆂, 𑆃𑆤𑆼𑆑𑆯𑆦𑆳𑆤𑆳𑆁 𑆒𑆢𑆴𑆫𑆳𑆱𑆮𑆂, 𑆑𑆷𑆬𑆖𑆫𑆳𑆟𑆳𑆁 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆑𑆯𑆼𑆫𑆶𑆑𑆳𑆱𑆮𑆂, 𑆑𑆾𑆯𑆮𑆳𑆱𑆴𑆤𑆳𑆁 𑆥𑆳𑆢𑆴𑆤𑆳𑆁 𑆖 𑆱 𑆍𑆮, 𑆥𑇀𑆬𑆮𑆳𑆤𑆳𑆩𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆳𑆱𑆮𑆂, 𑆤𑆳𑆢𑆼𑆪𑆳𑆤𑆳𑆁 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆁 𑆩𑆸𑆟𑆳𑆬𑆳𑆱𑆮𑆂, 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆳𑆟𑆳𑆁 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆱𑆮𑆂, 𑆃𑆩𑇀𑆬𑆳𑆤𑆳𑆁 𑆦𑆬𑆳𑆤𑆳𑆁 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆑𑆤𑇀𑆢𑆳𑆱𑆮𑆂, 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆢𑆳𑆝𑆴𑆩𑆮𑆼𑆠𑇀𑆫𑆳𑆱𑆮𑆂, 𑆩𑆣𑆶𑆫𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆪𑆶𑆑𑇀𑆠𑆂 𑆒𑆟𑇀𑆝𑆳𑆱𑆮𑆂, 𑆠𑆳𑆬𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆁, 𑆑𑆛𑆶𑆑𑆳𑆤𑆳𑆁 𑆢𑆷𑆫𑇀𑆮𑆳𑆤𑆬𑆮𑆼𑆠𑇀𑆫𑆳𑆱𑆮𑆂, 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆱𑆶𑆑𑆳𑆱𑆮𑆂, 𑆑𑆷𑆰𑇀𑆩𑆳𑆟𑇀𑆝𑆳𑆢𑆵𑆤𑆳𑆁 𑆢𑆳𑆫𑇀𑆮𑆵𑆑𑆫𑆵𑆫𑆳𑆱𑆮𑆂, 𑆖𑆶𑆖𑇀𑆖𑆶𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆳𑆁 𑆬𑆾𑆣𑇀𑆫𑆳𑆱𑆮𑆂, 𑆘𑆵𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆱𑆮𑆂, 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆯𑆳𑆑𑆱𑇀𑆪 𑆱 𑆍𑆮, 𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆩𑆲𑆳𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆱𑆮𑆂, 𑆠𑆳𑆬𑆩𑆱𑇀𑆠𑆑𑆳𑆢𑆵𑆤𑆳𑆩𑆩𑇀𑆬𑆦𑆬𑆳𑆱𑆮𑆂, 𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆶𑆫𑆳𑆱𑆮 𑆄𑆫𑆤𑆳𑆬𑆁 𑆖, 𑆠𑆾𑆪𑆁 𑆮𑆳 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆼𑆠𑆴 𑇆𑇔𑇓𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆤𑆶𑆥𑆳𑆤𑆳𑆤𑆳𑆁 𑆩𑆳𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆁 𑆠𑆾𑆪𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇅 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆮𑆳 𑆪𑆱𑇀𑆪 𑆪𑆠𑇀𑆠𑆾𑆪𑆁 𑆠𑆠𑇀𑆠𑆱𑇀𑆩𑆽 𑆲𑆴𑆠𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇔𑇓𑇔𑇆
𑆇𑆰𑇀𑆟𑆁 𑆮𑆳𑆠𑆼 𑆑𑆦𑆼 𑆠𑆾𑆪𑆁 𑆥𑆴𑆠𑇀𑆠𑆼 𑆫𑆑𑇀𑆠𑆼 𑆖 𑆯𑆵𑆠𑆬𑆩𑇀 𑇅 𑆢𑆾𑆰𑆮𑆢𑇀𑆓𑆶𑆫𑆶 𑆮𑆳 𑆨𑆶𑆑𑇀𑆠𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇆𑇔𑇓𑇕𑇆
𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤𑆳𑆤𑆶𑆥𑆳𑆤𑆼𑆤 𑆱𑆶𑆒𑆩𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑇅 𑆫𑆾𑆖𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆢𑆾𑆰𑆱𑆕𑇀𑆔𑆳𑆠𑆨𑆼𑆢𑆤𑆩𑇀 𑇆𑇔𑇓𑇖𑇆
𑆠𑆫𑇀𑆥𑆟𑆁 𑆩𑆳𑆫𑇀𑆢𑆮𑆑𑆫𑆁 𑆯𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆲𑆫𑆁 𑆱𑆶𑆒𑆩𑇀 𑇅 𑆢𑆵𑆥𑆤𑆁 𑆢𑆾𑆰𑆯𑆩𑆤𑆁 𑆥𑆴𑆥𑆳𑆱𑆳𑆖𑇀𑆗𑆼𑆢𑆤𑆁 𑆥𑆫𑆩𑇀 𑇆𑇔𑇓𑇗𑇆
𑆧𑆬𑇀𑆪𑆁 𑆮𑆫𑇀𑆟𑆑𑆫𑆁 𑆱𑆩𑇀𑆪𑆓𑆤𑆶𑆥𑆳𑆤𑆁 𑆱𑆢𑆾𑆖𑇀𑆪𑆠𑆼 𑇅 𑆠𑆢𑆳𑆢𑆿 𑆑𑆫𑇀𑆯𑆪𑆼𑆠𑇀𑆥𑆵𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆤𑇀𑆩𑆣𑇀𑆪𑆱𑆼𑆮𑆴𑆠𑆩𑇀 𑇆𑇔𑇓𑇘𑇆
𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆥𑆵𑆠𑆁 𑆧𑆸𑆁𑆲𑆪𑆠𑆴 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆱𑇀𑆡𑆴𑆫𑆠𑆳𑆁 𑆓𑆠𑆩𑆬𑇀𑆑𑆴𑆤𑇀𑆤𑆩𑆤𑇀𑆤𑆩𑆢𑇀𑆫𑆮𑆥𑆳𑆪𑆴𑆤𑆳𑆩𑇀 𑇆𑇔𑇓𑇙𑇆
𑆨𑆮𑆠𑇀𑆪𑆳𑆧𑆳𑆣𑆘𑆤𑆤𑆩𑆤𑆶𑆥𑆳𑆤𑆩𑆠𑆂 𑆥𑆴𑆧𑆼𑆠𑇀 𑇅 𑆤 𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆫𑇀𑆠𑆾 𑆫𑆾𑆓𑆼 𑆖𑆳𑆥𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆓𑆼 𑇆𑇔𑇔𑇐𑇆
𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆁 𑆠𑆢𑇀𑆣𑆴 𑆠𑆱𑇀𑆪 𑆑𑆟𑇀𑆜𑆾𑆫𑆱𑆴 𑆱𑇀𑆡𑆴𑆠𑆩𑇀 𑇅 𑆱𑇀𑆪𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆩𑆪𑆳𑆚𑇀𑆘𑆤𑆪𑆼𑆢𑇀𑆧𑆲𑆷𑆤𑇀 𑇆𑇔𑇔𑇒𑇆
𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆖𑆴𑆤𑇀𑆠𑆼𑆪𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆁 𑆤𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆠𑆡𑆳 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆩𑆳𑆠𑇀𑆫𑆳𑆤𑇀𑆤𑆑𑆳𑆬𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇔𑇔𑇓𑇆
𑆩𑆤𑇀𑆢𑆑𑆫𑇀𑆩𑆳𑆤𑆬𑆳𑆫𑆾𑆓𑇀𑆪𑆳𑆂 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆂 𑆱𑆶𑆒𑆾𑆖𑆴𑆠𑆳𑆂 𑇅 𑆘𑆤𑇀𑆠𑆮𑆾 𑆪𑆼 𑆠𑆶 𑆠𑆼𑆰𑆳𑆁 𑆲𑆴 𑆖𑆴𑆤𑇀𑆠𑆼𑆪𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇔𑇔𑇔𑇆
𑆧𑆬𑆴𑆤𑆂 𑆒𑆫𑆨𑆑𑇀𑆰𑇀𑆪𑆳 𑆪𑆼 𑆪𑆼 𑆖 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆪𑆾 𑆤𑆫𑆳𑆂 𑇅 𑆑𑆫𑇀𑆩𑆤𑆴𑆠𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆼 𑆠𑆼𑆰𑆳𑆁 𑆤𑆳𑆮𑆯𑇀𑆪𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇔𑇔𑇕𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆠𑆽𑆫𑇀𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆨𑆑𑇀𑆰𑇀𑆪𑆩𑆤𑇀𑆤𑆁 𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆩𑇀 𑇅 𑆯𑆶𑆖𑆿 𑆢𑆼𑆯𑆼 𑆱𑆶𑆱𑆕𑇀𑆓𑆶𑆥𑇀𑆠𑆁 𑆱𑆩𑆶𑆥𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇔𑇔𑇗𑇆
𑆮𑆴𑆰𑆔𑇀𑆤𑆽𑆫𑆓𑆢𑆽𑆂 𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑆁 𑆥𑇀𑆫𑆾𑆑𑇀𑆰𑆴𑆠𑆁 𑆮𑇀𑆪𑆘𑆤𑆾𑆢𑆑𑆽𑆂 𑇅 𑆱𑆴𑆢𑇀𑆣𑆽𑆫𑇀𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆫𑇀𑆲𑆠𑆮𑆴𑆰𑆁 𑆱𑆴𑆢𑇀𑆣𑆩𑆤𑇀𑆤𑆁 𑆤𑆴𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑇆𑇔𑇔𑇘𑇆
𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆠𑆂 𑆥𑆫𑆁 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆤𑆳𑆩𑇀 𑇅 𑆔𑆸𑆠𑆁 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑆳𑆪𑆱𑆼 𑆢𑆼𑆪𑆁, 𑆥𑆼𑆪𑆳 𑆢𑆼𑆪𑆳 𑆠𑆶 𑆫𑆳𑆘𑆠𑆼 𑇆𑇔𑇔𑇙𑇆
𑆦𑆬𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆽 𑆢𑆬𑆼𑆰𑆶 𑆠𑆶 𑇅 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆱𑆿𑆮𑆫𑇀𑆟𑆼𑆰𑆶 𑆥𑇀𑆫𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇕𑇐𑇆
𑆥𑇀𑆫𑆢𑇀𑆫𑆮𑆳𑆟𑆴 𑆫𑆱𑆳𑆁𑆯𑇀𑆖𑆽𑆮𑆁 𑆫𑆳𑆘𑆠𑆼𑆰𑆷𑆥𑆲𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆑𑆛𑇀𑆮𑆫𑆳𑆟𑆴 𑆒𑆝𑆳𑆁𑆯𑇀𑆖𑆽𑆮 𑆱𑆫𑇀𑆮𑆳𑆚𑇀𑆗𑆽𑆬𑆼𑆰𑆶 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇕𑇑𑇆
𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆩𑇀𑆫𑆩𑆪𑆼 𑆥𑆳𑆠𑇀𑆫𑆼 𑆱𑆶𑆯𑆵𑆠𑆁 𑆱𑆶𑆯𑆸𑆠𑆁 𑆥𑆪𑆂 𑇅 𑆥𑆳𑆤𑆵𑆪𑆁, 𑆥𑆳𑆤𑆑𑆁 𑆩𑆢𑇀𑆪𑆁 𑆩𑆸𑆤𑇀𑆩𑆪𑆼𑆰𑆶 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇕𑇒𑇆
𑆑𑆳𑆖𑆱𑇀𑆦𑆛𑆴𑆑𑆥𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆯𑆵𑆠𑆬𑆼𑆰𑆶 𑆯𑆶𑆨𑆼𑆰𑆶 𑆖 𑇅 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆼𑆰𑆶 𑆫𑆳𑆓𑆰𑆳𑆝𑆮𑆱𑆛𑇀𑆛𑆑𑆳𑆤𑇀 𑇆𑇔𑇕𑇓𑇆
𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆢𑇀𑆮𑆴𑆩𑆬𑆼 𑆥𑆳𑆠𑇀𑆫𑆼 𑆱𑆶𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆼 𑆩𑆤𑆾𑆫𑆩𑆼 𑇅 𑆱𑆷𑆢𑆂 𑆱𑆷𑆥𑆿𑆢𑆤𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆤𑇀 𑇆𑇔𑇕𑇔𑇆
𑆦𑆬𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆴 𑆪𑆳𑆤𑆴 𑆖 𑇅 𑆠𑆳𑆤𑆴 𑆢𑆑𑇀𑆰𑆴𑆟𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆠𑆶 𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆱𑇀𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇕𑇕𑇆
𑆥𑇀𑆫𑆢𑇀𑆫𑆮𑆳𑆟𑆴 𑆫𑆱𑆳𑆁𑆯𑇀𑆖𑆽𑆮 𑆥𑆳𑆤𑆵𑆪𑆁 𑆥𑆳𑆤𑆑𑆁 𑆥𑆪𑆂 𑇅 𑆒𑆝𑆳𑆤𑇀 𑆪𑆷𑆰𑆳𑆁𑆯𑇀𑆖 𑆥𑆼𑆪𑆳𑆁𑆯𑇀𑆖 𑆱𑆮𑇀𑆪𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇕𑇖𑇆
𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆓𑆶𑆝𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆫𑆳𑆓𑆰𑆳𑆝𑆮𑆱𑆛𑇀𑆛𑆑𑆳𑆤𑇀 𑇅 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆠𑇀 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆢𑇀𑆮𑆪𑆾𑆫𑆥𑆴 𑆖 𑆩𑆣𑇀𑆪𑆠𑆂 𑇆𑇔𑇕𑇗𑇆
𑆍𑆮𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆾𑆘𑆤𑆱𑇀𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆤𑆳𑆩𑇀 𑇅 𑆨𑆾𑆑𑇀𑆠𑆳𑆫𑆁 𑆮𑆴𑆘𑆤𑆼 𑆫𑆩𑇀𑆪𑆼 𑆤𑆴𑆂𑆱𑆩𑇀𑆥𑆳𑆠𑆼 𑆯𑆶𑆨𑆼 𑆯𑆶𑆖𑆿 𑇆𑇔𑇕𑇘𑇆
𑆱𑆶𑆓𑆤𑇀𑆣𑆥𑆶𑆰𑇀𑆥𑆫𑆖𑆴𑆠𑆼 𑆱𑆩𑆼 𑆢𑆼𑆯𑆼 𑆖 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆩𑆴𑆰𑇀𑆛𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆽𑆂 𑆥𑆡𑇀𑆪𑆽𑆫𑆴𑆰𑇀𑆛𑆽 𑆫𑆱𑆳𑆢𑆴𑆨𑆴𑆂 𑇆𑇔𑇕𑇙𑇆
𑆩𑆤𑆾𑆘𑇀𑆚𑆁 𑆯𑆶𑆖𑆴 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆓𑇀𑆫𑆩𑆯𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆥𑆷𑆫𑇀𑆮𑆁 𑆩𑆣𑆶𑆫𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆤𑇀𑆩𑆣𑇀𑆪𑆼𑇁𑆩𑇀𑆬𑆬𑆮𑆟𑆿 𑆫𑆱𑆿 𑇆𑇔𑇖𑇐𑇆
𑆥𑆯𑇀𑆖𑆳𑆖𑇀𑆗𑆼𑆰𑆳𑆤𑇀 𑆫𑆱𑆳𑆤𑇀 𑆮𑆽𑆢𑇀𑆪𑆾 𑆨𑆾𑆘𑆤𑆼𑆰𑇀𑆮𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆄𑆢𑆿 𑆦𑆬𑆳𑆤𑆴 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆢𑆳𑆝𑆴𑆩𑆳𑆢𑆵𑆤𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇔𑇖𑇑𑇆
𑆠𑆠𑆂 𑆥𑆼𑆪𑆳𑆁𑆱𑇀𑆠𑆠𑆾 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆁𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆳𑆁𑆱𑇀𑆠𑆠𑆂 𑆥𑆫𑆩𑇀 𑇅 𑆔𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆫𑇀𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆩𑇀 𑇆𑇔𑇖𑇒𑇆
𑆄𑆢𑆳𑆮𑆤𑇀𑆠𑆼 𑆖 𑆩𑆣𑇀𑆪𑆼 𑆖 𑆨𑆾𑆘𑆤𑆱𑇀𑆪 𑆠𑆶 𑆯𑆱𑇀𑆪𑆠𑆼 𑇅 𑆤𑆴𑆫𑆠𑇀𑆪𑆪𑆁 𑆢𑆾𑆰𑆲𑆫𑆁 𑆦𑆬𑆼𑆰𑇀𑆮𑆳𑆩𑆬𑆑𑆁 𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇔𑇖𑇓𑇆
𑆩𑆸𑆟𑆳𑆬𑆧𑆴𑆱𑆯𑆳𑆬𑆷𑆑𑆑𑆤𑇀𑆢𑆼𑆑𑇀𑆰𑆶𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆖 𑇅 𑆥𑆷𑆫𑇀𑆮𑆁 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆨𑆴𑆰𑆘𑆳 𑆤 𑆠𑆶 𑆨𑆶𑆑𑇀𑆠𑆼 𑆑𑆢𑆳𑆖𑆤 𑇆𑇔𑇖𑇔𑇆
𑆱𑆶𑆒𑆩𑆶𑆖𑇀𑆖𑆽𑆂 𑆱𑆩𑆳𑆱𑆵𑆤𑆂 𑆱𑆩𑆢𑆼𑆲𑆾𑇁𑆤𑇀𑆤𑆠𑆠𑇀𑆥𑆫𑆂 𑇅 𑆑𑆳𑆬𑆼 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆬𑆔𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆶𑆰𑇀𑆟𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆢𑇀𑆫𑆮𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇔𑇖𑇕𑇆
𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆾𑇁𑆤𑇀𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑇀𑆮𑆴𑆢𑆴𑆠𑆳𑆓𑆩𑆂 𑇅𑇔𑇖𑇖𑇅 𑆑𑆳𑆬𑆼 𑆥𑇀𑆫𑆵𑆟𑆪𑆠𑆼 𑆨𑆶𑆑𑇀𑆠𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆤𑇀𑆤𑆁 𑆤 𑆧𑆳𑆣𑆠𑆼 𑇆𑇔𑇖𑇖𑇆
𑆬𑆔𑆶 𑆯𑆵𑆔𑇀𑆫𑆁 𑆮𑇀𑆫𑆘𑆼𑆠𑇀 𑆥𑆳𑆑𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆁 𑆧𑆬𑆮𑆲𑇀𑆤𑆴𑆢𑆩𑇀 𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆨𑆶𑆑𑇀𑆠𑆁 𑆱𑆩𑆁 𑆥𑆳𑆑𑆁 𑆪𑆳𑆠𑇀𑆪𑆢𑆾𑆰𑆁 𑆢𑇀𑆫𑆮𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇔𑇖𑇗𑇆
𑆱𑆶𑆒𑆁 𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑇀𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁 𑆑𑆫𑆾𑆠𑆴 𑆖 𑇅 𑆃𑆠𑆵𑆮𑆳𑆪𑆠𑆪𑆳𑆩𑆳𑆱𑇀𑆠𑆶 𑆑𑇀𑆰𑆥𑆳 𑆪𑆼𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇔𑇖𑇘𑇆
𑆠𑆼𑆰𑆶 𑆠𑆠𑇀𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆳𑆞𑇀𑆪𑆁 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆥𑇀𑆫𑆳𑆠𑆫𑆼𑆮 𑆠𑆶 𑇅 𑆪𑆼𑆰𑆶 𑆖𑆳𑆥𑆴 𑆨𑆮𑆼𑆪𑆶𑆯𑇀𑆖 𑆢𑆴𑆮𑆱𑆳 𑆨𑆸𑆯𑆩𑆳𑆪𑆠𑆳𑆂 𑇆𑇔𑇖𑇙𑇆
𑆠𑆼𑆰𑆶 𑆠𑆠𑇀𑆑𑆳𑆬𑆮𑆴𑆲𑆴𑆠𑆩𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇅 𑆫𑆘𑆤𑇀𑆪𑆾 𑆢𑆴𑆮𑆱𑆳𑆯𑇀𑆖𑆽𑆮 𑆪𑆼𑆰𑆶 𑆖𑆳𑆥𑆴 𑆱𑆩𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇔𑇗𑇐𑇆

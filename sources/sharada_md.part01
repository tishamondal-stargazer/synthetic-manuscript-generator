𑆠𑆠𑇀𑆠𑇀𑆮𑆤𑆼𑆑𑆿𑆰𑆣𑆴𑆫𑆱𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆥𑇀𑆫𑆳𑆟𑆢𑆁 𑆓𑆶𑆫𑆶 𑇅 𑆩𑆣𑆶𑆫𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆯𑆵𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆫𑆁 𑆩𑆸𑆢𑆶 𑇅 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆳𑆁 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆴𑆲𑆾𑆖𑇀𑆪𑆠𑆼 𑇆𑇔𑇘𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆩𑆼𑆮 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆁 𑆘𑆳𑆠𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆠𑇀, 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑆳𑆤𑆱𑆼𑆰𑇀𑆮𑆥𑆴 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁, 𑆘𑆵𑆫𑇀𑆟𑆘𑇀𑆮𑆫𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆰𑆑𑇀𑆰𑆪𑆓𑆶𑆬𑇀𑆩𑆾𑆤𑇀𑆩𑆳𑆢𑆾𑆢𑆫𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆩𑆢𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳𑆲𑆸𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆢𑆾𑆰- 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆳𑆫𑇀𑆯𑆂𑆯𑆷𑆬𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆠𑆴𑆱𑆳𑆫𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆪𑆾𑆤𑆴𑆫𑆾𑆓𑆓𑆫𑇀𑆨𑆳𑆱𑇀𑆫𑆳𑆮𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆲𑆫𑆁, 𑆥𑆳𑆥𑇀𑆩𑆳𑆥𑆲𑆁 𑆧𑆬𑇀𑆪𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆁 𑆫𑆱𑆳𑆪𑆤𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆘𑆵𑆮𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆿𑆘𑆱𑆾 𑆮𑆫𑇀𑆣𑆤𑆁 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆶𑆢𑇀𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆑𑆫𑇀𑆯𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆥𑆡𑇀𑆪𑆠𑆩𑆩𑇀 𑇆𑇔𑇙𑇆
𑆃𑆬𑇀𑆥𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆓𑆾𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆓𑆶𑆫𑆶 𑆫𑆱𑆳𑆪𑆤𑆩𑇀 𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆯𑆵𑆠𑆁 𑆩𑆣𑆶𑆫𑆁 𑆫𑆱𑆥𑆳𑆑𑆪𑆾𑆂 𑇆𑇕𑇐𑇆
𑆘𑆵𑆮𑆤𑆵𑆪𑆁 𑆠𑆡𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆁 𑆥𑆫𑆩𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅𑇕𑇑𑇅 𑆓𑆮𑇀𑆪𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆁 𑆠𑇀𑆮𑆳𑆘𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆗𑆾𑆰𑆴𑆟𑆳𑆁 𑆲𑆴𑆠𑆩𑇀 𑇆𑇕𑇑𑇆
𑆢𑆵𑆥𑆤𑆁 𑆬𑆔𑆶 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆱𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆤𑆶𑆠𑇀 𑇅 𑆃𑆘𑆳𑆤𑆳𑆩𑆬𑇀𑆥𑆑𑆳𑆪𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀 𑇆𑇕𑇒𑇆
𑆤𑆳𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆥𑆳𑆤𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆮𑇀𑆪𑆳𑆣𑆴𑆲𑆫𑆁 𑆥𑆪𑆂 𑇅𑇕𑇓𑇅 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆁 𑆬𑆮𑆟𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆿𑆰𑇀𑆛𑇀𑆫𑆁 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑆱𑆁 𑆬𑆔𑆶 𑇆𑇕𑇓𑇆
𑆯𑆾𑆦𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆾𑆔𑇀𑆤𑆁 𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇅𑇕𑇔𑇅 𑆄𑆮𑆴𑆑𑆁 𑆩𑆣𑆶𑆫𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆓𑆶𑆫𑆶 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆮𑆲𑆩𑇀 𑇆𑇕𑇔𑇆
𑆥𑆡𑇀𑆪𑆁 𑆑𑆼𑆮𑆬𑆮𑆳𑆠𑆼𑆰𑆶 𑆑𑆳𑆱𑆼 𑆖𑆳𑆤𑆴𑆬𑆱𑆩𑇀𑆨𑆮𑆼 𑇅𑇕𑇕𑇅 𑆩𑆲𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆩𑆣𑆶𑆫𑆁 𑆩𑆳𑆲𑆴𑆰𑆁 𑆮𑆲𑇀𑆤𑆴𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇕𑇕𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑆫𑆁 𑆯𑆵𑆠𑆠𑆫𑆁 𑆓𑆮𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆠𑆫𑆁 𑆓𑆶𑆫𑆶 𑇅𑇕𑇖𑇅 𑆇𑆰𑇀𑆟𑆩𑆽𑆑𑆯𑆦𑆁 𑆧𑆬𑇀𑆪𑆁 𑆯𑆳𑆒𑆳𑆮𑆳𑆠𑆲𑆫𑆁 𑆥𑆪𑆂 𑇆𑇕𑇖𑇆
𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆫𑆱𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆬𑆮𑆟𑆳𑆤𑆶𑆫𑆱𑆁 𑆬𑆔𑆶 𑇅𑇕𑇗𑇅 𑆤𑆳𑆫𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆩𑆣𑆶𑆫𑆁 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆲𑆴𑆩𑆩𑇀 𑇆𑇕𑇗𑇆
𑆤𑆱𑇀𑆪𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆪𑆾𑆂 𑆥𑆡𑇀𑆪𑆁 𑆘𑆵𑆮𑆤𑆁 𑆬𑆔𑆶 𑆢𑆵𑆥𑆤𑆩𑇀 𑇅𑇕𑇘𑇅 𑆲𑆱𑇀𑆠𑆴𑆤𑇀𑆪𑆳 𑆩𑆣𑆶𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆓𑆶𑆫𑆶 𑇆𑇕𑇘𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆁 𑆯𑆵𑆠𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇅𑇕𑇙𑇅 𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑇀𑆫𑆳𑆨𑆳𑆠𑆴𑆑𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆓𑆶𑆫𑆶 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆯𑆵𑆠𑆬𑆩𑇀 𑇆𑇕𑇙𑇆
𑆫𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆂 𑆱𑆾𑆩𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆨𑆳𑆮𑆠𑆱𑇀𑆠𑆡𑆳 𑇅𑇖𑇐𑇅 𑆢𑆴𑆮𑆳𑆑𑆫𑆳𑆨𑆴𑆠𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆤𑆴𑆬𑆱𑆼𑆮𑆤𑆳𑆠𑇀 𑇆𑇖𑇐𑇆
𑆯𑇀𑆫𑆩𑆔𑇀𑆤𑆁 𑆮𑆳𑆠𑆤𑆶𑆖𑇀𑆖𑆽𑆮 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆖𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆴𑆑𑆩𑇀 𑇅𑇖𑇑𑇅 𑆥𑆪𑆾𑇁𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆓𑆶𑆫𑇀𑆮𑆳𑆩𑆁 𑆥𑇀𑆫𑆳𑆪𑆯𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇖𑇑𑇆
𑆠𑆢𑆼𑆮𑆾𑆑𑇀𑆠𑆁 𑆬𑆔𑆶𑆠𑆫𑆩𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆮𑆽 𑆯𑆸𑆠𑆩𑇀 𑇅𑇖𑇒𑇅 𑆮𑆫𑇀𑆘𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆩𑆳𑆩𑆩𑆼𑆮 𑆲𑆴 𑆠𑆢𑇀𑆣𑆴𑆠𑆩𑇀 𑇆𑇖𑇒𑇆

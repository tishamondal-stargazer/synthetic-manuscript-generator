𑆮𑆸𑆠𑇀𑆠𑆨𑆾𑆓𑆾 𑆩𑆲𑆳𑆑𑆳𑆪𑆂 𑆯𑇀𑆮𑆱𑆤𑇀𑆤𑆷𑆫𑇀𑆣𑇀𑆮𑆼𑆑𑇀𑆰𑆟𑆂 𑆥𑆶𑆩𑆳𑆤𑇀𑇅 𑆱𑇀𑆡𑆷𑆬𑆩𑆷𑆫𑇀𑆣𑆳 𑆱𑆩𑆳𑆕𑇀𑆓𑆯𑇀𑆖 𑆱𑇀𑆠𑇀𑆫𑆵 𑆠𑇀𑆮𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀𑇆𑇑𑇓𑇐𑇆
𑆑𑇀𑆬𑆵𑆧𑆱𑇀𑆠𑇀𑆫𑆱𑆠𑇀𑆪𑆣𑆾𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑆱𑇀𑆮𑆫𑆲𑆵𑆤𑆂 𑆥𑇀𑆫𑆑𑆩𑇀𑆥𑆠𑆼𑇅 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆢𑆰𑇀𑆛𑆾 𑆮𑆴𑆥𑆫𑇀𑆪𑆱𑇀𑆠𑆽𑆫𑆼𑆠𑆽𑆂 𑆥𑆶𑆁𑆱𑆳 𑆤𑆫𑆾 𑆩𑆠𑆂𑇆𑇑𑇓𑇑𑇆
𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆼𑆠𑆽𑆱𑇀𑆠𑆶 𑆑𑇀𑆬𑆵𑆧𑆢𑆰𑇀𑆛𑆁 𑆤𑆫𑆁 𑆮𑆢𑆼𑆠𑇀𑇅 𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑆶𑆑𑇀𑆠𑆁 𑆱𑆫𑇀𑆥𑆳𑆟𑆳𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆕𑇀𑆑𑇀𑆬𑆵𑆧𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇑𑇓𑇒𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆑𑇀𑆠𑇀𑆫𑆱𑇀𑆠𑆶 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆯𑆷𑆤𑆿𑆰𑇀𑆜𑆾𑇁𑆥𑇀𑆪𑆱𑆴𑆠𑆼𑆑𑇀𑆰𑆟𑆂𑇅 𑆘𑆸𑆩𑇀𑆨𑆳𑆑𑇀𑆫𑆾𑆣𑆾𑆥𑆘𑆴𑆲𑇀𑆮𑆳𑆫𑇀𑆠𑆂 𑆱𑆷𑆠𑆪𑆳 𑆫𑆑𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆤𑇀𑇆𑇑𑇓𑇓𑇆
𑆱𑆫𑇀𑆥𑆾 𑆓𑆿𑆣𑆼𑆫(𑆪)𑆑𑆾 𑆤𑆳𑆩 𑆓𑆾𑆣𑆳𑆪𑆳𑆁 𑆱𑇀𑆪𑆳𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑆢𑆂𑇅 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆼𑆟 𑆠𑆶𑆬𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆳𑆤𑆳 𑆱𑇀𑆪𑆶𑆫𑇀𑆩𑆴𑆯𑇀𑆫𑆘𑆳𑆠𑆪𑆂𑇆𑇑𑇓𑇔𑇆
𑆓𑆷𑆞𑆱𑆩𑇀𑆥𑆳𑆢𑆴𑆠𑆁 𑆮𑆸𑆠𑇀𑆠𑆁 𑆥𑆵𑆝𑆴𑆠𑆁 𑆬𑆩𑇀𑆧𑆴𑆠𑆳𑆫𑇀𑆥𑆴𑆠𑆩𑇀𑇅 𑆱𑆫𑇀𑆥𑆴𑆠𑆁 𑆖 𑆨𑆸𑆯𑆳𑆧𑆳𑆣𑆁, 𑆢𑆁𑆯𑆳 𑆪𑆼𑇁𑆤𑇀𑆪𑆼 𑆤 𑆠𑆼 𑆨𑆸𑆯𑆳𑆂𑇆𑇑𑇓𑇕𑇆
𑆠𑆫𑆶𑆟𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆳𑆱𑇀𑆠𑆶 𑆓𑆾𑆤𑆱𑆳𑆂 𑆱𑇀𑆡𑆮𑆴𑆫𑆳𑆱𑇀𑆠𑆡𑆳𑇅 𑆫𑆳𑆘𑆴𑆩𑆤𑇀𑆠𑆾 𑆮𑆪𑆾𑆩𑆣𑇀𑆪𑆼 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆵𑆮𑆴𑆰𑆾𑆥𑆩𑆳𑆂𑇆𑇑𑇓𑇖𑇆
𑆱𑆫𑇀𑆥𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆱𑇀𑆠𑆶 𑆠𑆳𑆱𑆳𑆁 𑆮𑆳𑆩𑆳𑆣𑆫𑆳 𑆱𑆴𑆠𑆳𑇅 𑆥𑆵𑆠𑆳 𑆮𑆳𑆩𑆾𑆠𑇀𑆠𑆫𑆳 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆫𑆑𑇀𑆠𑆯𑇀𑆪𑆳𑆮𑆳𑇁𑆣𑆫𑆾𑆠𑇀𑆠𑆫𑆳 𑇆𑇑𑇓𑇗𑇆
𑆪𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆂 𑆥𑆠𑆠𑆼 𑆧𑆴𑆤𑇀𑆢𑆶𑆫𑇀𑆓𑆾𑆧𑆳𑆬𑆳𑆠𑇀 𑆱𑆬𑆴𑆬𑆾𑆢𑇀𑆣𑆸𑆠𑆳𑆠𑇀𑇅 𑆮𑆳𑆩𑆳𑆣𑆫𑆳𑆪𑆳𑆁 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆪𑆳𑆁 𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆁 𑆱𑇀𑆪𑆳𑆢𑆲𑆼𑆫𑇀𑆮𑆴𑆰𑆩𑇀𑇆𑇑𑇓𑇘𑇆
𑆍𑆑𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆖𑆠𑆶𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆮𑆴𑆰𑆨𑆳𑆓𑆾𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆳𑆂𑇅 𑆱𑆮𑆫𑇀𑆟𑆳𑆱𑇀𑆠𑆠𑇀𑆑𑆸𑆠𑆳 𑆢𑆁𑆯𑆳 𑆧𑆲𑆷𑆠𑇀𑆠𑆫𑆮𑆴𑆰𑆳 𑆨𑆸𑆯𑆳𑆂𑇆𑇑𑇓𑇙𑇆
𑆱𑆫𑇀𑆥𑆳𑆟𑆳𑆩𑆼𑆮 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆠𑇀 𑆑𑆵𑆛𑆳𑆂 𑆱𑇀𑆪𑆶𑆂 𑆑𑆵𑆛𑆱𑆩𑇀𑆩𑆠𑆳𑆂𑇅 𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳 𑆅𑆠𑆴 𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆠𑆾 𑆩𑆠𑆳𑆂𑇆𑇑𑇔𑇐𑇆
𑆓𑆳𑆠𑇀𑆫𑆁 𑆫𑆑𑇀𑆠𑆁 𑆱𑆴𑆠𑆁 𑆑𑆸𑆰𑇀𑆟𑆁 𑆯𑇀𑆪𑆳𑆮𑆁 𑆮𑆳 𑆥𑆴𑆝𑆑𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇅 𑆱𑆑𑆟𑇀𑆝𑆷𑆢𑆳𑆲𑆮𑆵𑆱𑆫𑇀𑆥𑆥𑆳𑆑𑆴 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆶𑆡𑆴𑆠𑆁 𑆠𑆡𑆳𑇆𑇑𑇔𑇑𑇆
𑆑𑆵𑆛𑆽𑆫𑇀𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆁 𑆯𑆸𑆟𑆶𑇅 𑆱𑆫𑇀𑆥𑆢𑆰𑇀𑆛𑆼 𑆪𑆡𑆳 𑆯𑆾𑆡𑆾 𑆮𑆫𑇀𑆣𑆠𑆼 𑆱𑆾𑆓𑇀𑆫𑆓𑆤𑇀𑆣𑇀𑆪𑆱𑆸𑆑𑇀𑇆𑇑𑇔𑇒𑇆
𑆢𑆁𑆯𑆾𑇁𑆑𑇀𑆰𑆴𑆓𑆿𑆫𑆮𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆱 𑆫𑆶𑆓𑆳𑆫𑇀𑆠𑆂 𑆯𑇀𑆮𑆱𑆴𑆠𑇀𑆪𑆥𑆴𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆫𑆶𑆖𑆴𑆥𑆫𑆵𑆠𑆯𑇀𑆖 𑆨𑆮𑆼𑆢𑇀𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆳𑆫𑇀𑆢𑆴𑆠𑆂𑇆𑇑𑇔𑇓𑇆
𑆢𑆁𑆯𑆱𑇀𑆪 𑆩𑆣𑇀𑆪𑆼 𑆪𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆁 𑆯𑇀𑆪𑆳𑆮𑆁 𑆮𑆳 𑆘𑆳𑆬𑆑𑆳𑆮𑆸𑆠𑆩𑇀𑇅 𑆢𑆓𑇀𑆣𑆳𑆑𑆸𑆠𑆴 𑆨𑆸𑆯𑆁 𑆥𑆳𑆑𑆴 𑆑𑇀𑆬𑆼𑆢𑆯𑆾𑆡𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇆𑇑𑇔𑇔𑇆
𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆳𑆨𑆴𑆫𑇀𑆬𑆷𑆠𑆳𑆨𑆴𑆱𑇀𑆠𑆁 𑆢𑆰𑇀𑆛𑆩𑆴𑆠𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀𑇅 𑆱𑆫𑇀𑆮𑆳𑆱𑆳𑆩𑆼𑆮 𑆠𑆳𑆱𑆳𑆁 𑆖 𑆢𑆁𑆯𑆼 𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇕𑇆
𑆯𑆾𑆦𑆂 𑆯𑇀𑆮𑆼𑆠𑆳𑆱𑆴𑆠𑆳 𑆫𑆑𑇀𑆠𑆳𑆂 𑆥𑆵𑆠𑆳 𑆮𑆳 𑆥𑆴𑆝𑆑𑆳 𑆘𑇀𑆮𑆫𑆂𑇅 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀𑆠𑆴𑆑𑆾 𑆨𑆮𑆼𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆾 𑆢𑆳𑆲𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆲𑆳𑆂𑇆𑇑𑇔𑇖𑇆
𑆄𑆢𑆁𑆯𑆳𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆁 𑆥𑆳𑆟𑇀𑆝𑆶 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆘𑇀𑆮𑆫𑆾𑇁𑆫𑆶𑆖𑆴𑆂𑇅 𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆯𑇀𑆖 𑆢𑆳𑆲𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆳𑆒𑆶𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆳𑆫𑇀𑆢𑆴𑆠𑆼𑇆𑇑𑇔𑇗𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆕𑇀𑆓𑆯𑆾𑆡𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆑𑇀𑆬𑆼𑆢𑆯𑆧𑇀𑆢𑆳𑆯𑇀𑆫𑆶𑆠𑆴𑆘𑇀𑆮𑆫𑆳𑆂𑇅 𑆯𑆴𑆫𑆾𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆬𑆳𑆬𑆳𑆱𑆸𑆑𑇀𑆗𑆫𑇀𑆢𑆴𑆯𑇀𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆩𑆷𑆰𑆴𑆑𑆽𑆂𑇆𑇑𑇔𑇘𑇆
𑆯𑇀𑆪𑆳𑆮𑆠𑇀𑆮𑆩𑆡 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆮𑆳 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆠𑇀𑆮𑆩𑆼𑆮 𑆮𑆳𑇅 𑆩𑆾𑆲𑆂 𑆥𑆶𑆫𑆵𑆰𑆨𑆼𑆢𑆯𑇀𑆖 𑆢𑆰𑇀𑆛𑆼 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆸𑆑𑆬𑆳𑆱𑆑𑆽𑆂𑇆𑇑𑇔𑇙𑇆
𑆢𑆲𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑆴𑆮𑆳𑆢𑆿 𑆠𑆶 𑆨𑆴𑆤𑆠𑇀𑆠𑆵𑆮𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆯𑆶 𑆖𑇅 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆱𑇀𑆪 𑆮𑆴𑆰𑆁 𑆪𑆳𑆠𑆴 𑆢𑆁𑆯𑆼 𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆠𑆶 𑆠𑆴𑆰𑇀𑆜𑆠𑆴𑇆𑇑𑇕𑇐𑇆
𑆢𑆰𑇀𑆛𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆠𑆶 𑆢𑆸𑆓𑇀𑆔𑇀𑆫𑆳𑆟𑆫𑆱𑆤𑆾𑆥𑆲𑆠𑆾 𑆤𑆫𑆂𑇅 𑆩𑆳𑆁𑆱𑆽𑆂 𑆥𑆠𑆢𑇀𑆨𑆴𑆫𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆼𑆢𑆤𑆳𑆫𑇀𑆠𑆾 𑆘𑆲𑆳𑆠𑇀𑆪𑆱𑆷𑆤𑇀𑇆𑇑𑇕𑇑𑇆
𑆮𑆴𑆱𑆫𑇀𑆥𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆯𑆷𑆬𑆁 𑆘𑇀𑆮𑆫𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆡𑆳𑆥𑆴 𑆖𑇅 𑆬𑆑𑇀𑆰𑆟𑆁 𑆑𑆟𑆨𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆢𑆁𑆯𑆯𑇀𑆖𑆽𑆮 𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆠𑆼𑇆𑇑𑇕𑇒𑇆
𑆲𑆸𑆰𑇀𑆛𑆫𑆾𑆩𑆾𑆖𑇀𑆖𑆴𑆛𑆴𑆕𑇀𑆓𑆼𑆤 𑆱𑇀𑆠𑆧𑇀𑆣𑆬𑆴𑆕𑇀𑆓𑆾 𑆨𑆸𑆯𑆳𑆫𑇀𑆠𑆴𑆩𑆳𑆤𑇀𑇅 𑆢𑆰𑇀𑆛𑆂 𑆯𑆵𑆠𑆾𑆢𑆑𑆼𑆤𑆼𑆮 𑆱𑆴𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆴 𑆩𑆤𑇀𑆪𑆠𑆼𑇆𑇑𑇕𑇓𑇆
𑆍𑆑𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆫𑇀𑆢𑆴𑆠𑆂 𑆯𑆷𑆤𑆂 𑆱𑆫𑆶𑆑𑇀 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆵𑆠𑆑𑆂 𑆱𑆠𑆸𑆛𑇀𑇅 𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆤𑆴𑆢𑇀𑆫𑆳 𑆖 𑆩𑆟𑇀𑆝𑆷𑆑𑆽𑆂 𑆱𑆮𑆴𑆰𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇕𑇔𑇆
𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆱𑆮𑆴𑆰𑆳𑆂 𑆑𑆶𑆫𑇀𑆪𑆶𑆫𑇀𑆢𑆳𑆲𑆯𑆾𑆦𑆫𑆶𑆘𑆱𑇀𑆠𑆡𑆳𑇅 𑆑𑆟𑇀𑆝𑆷𑆁 𑆯𑆾𑆡𑆁 𑆘𑇀𑆮𑆫𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆱𑆮𑆴𑆰𑆳𑆱𑇀𑆠𑆶 𑆘𑆬𑆿𑆑𑆱𑆂𑇆𑇑𑇕𑇕𑇆
𑆢𑆳𑆲𑆠𑆾𑆢𑆱𑇀𑆮𑆼𑆢𑆯𑆾𑆡𑆑𑆫𑆵 𑆠𑆶 𑆓𑆸𑆲𑆓𑆾𑆣𑆴𑆑𑆳 𑇅 𑆢𑆁𑆯𑆼 𑆱𑇀𑆮𑆼𑆢𑆁 𑆫𑆶𑆘𑆁 𑆢𑆳𑆲𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆠𑆥𑆢𑆵𑆮𑆴𑆰𑆩𑇀𑇆𑇑𑇕𑇖𑇆

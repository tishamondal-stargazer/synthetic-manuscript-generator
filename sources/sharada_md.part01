𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆣𑆴𑆑𑆫𑆟𑆁(𑇑), 𑆪𑆾𑆓𑆂(𑇒), 𑆥𑆢𑆳𑆫𑇀𑆡𑆂(𑇓), 𑆲𑆼𑆠𑇀𑆮𑆫𑇀𑆡𑆂(𑇔), 𑆇𑆢𑇀𑆢𑆼𑆯𑆂(𑇕), 𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆂(𑇖), 𑆇𑆥𑆢𑆼𑆯𑆂(𑇗), 𑆃𑆥𑆢𑆼𑆯𑆂(𑇘), 𑆥𑇀𑆫𑆢𑆼𑆯𑆂(𑇙), 𑆃𑆠𑆴𑆢𑆼𑆯𑆂(𑇑𑇐), 𑆃𑆥𑆮𑆫𑇀𑆘𑆂(𑇑𑇑), 𑆮𑆳𑆑𑇀𑆪𑆯𑆼𑆰𑆂(𑇑𑇒), 𑆃𑆫𑇀𑆡𑆳𑆥𑆠𑇀𑆠𑆴𑆂(𑇑𑇓), 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆂(𑇑𑇔), 𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆂(𑇑𑇕), 𑆍𑆑𑆳𑆤𑇀𑆠𑆂(𑇑𑇖), 𑆃𑆤𑆼𑆑𑆳𑆤𑇀𑆠𑆂(𑇑𑇗), 𑆥𑆷𑆫𑇀𑆮𑆥𑆑𑇀𑆰𑆂(𑇑𑇘), 𑆤𑆴𑆫𑇀𑆟𑆪𑆂(𑇑𑇙), 𑆃𑆤𑆶𑆩𑆠𑆁(𑇒𑇐), 𑆮𑆴𑆣𑆳𑆤𑆩𑇀(𑇒𑇑), 𑆃𑆤𑆳𑆓𑆠𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑇀(𑇒𑇒), 𑆃𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆁(𑇒𑇓), 𑆱𑆁𑆯𑆪𑆂(𑇒𑇔), 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆤𑆁(𑇒𑇕), 𑆱𑇀𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆳(𑇒𑇖), 𑆤𑆴𑆫𑇀𑆮𑆖𑆤𑆁(𑇒𑇗), 𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆁(𑇒𑇘), 𑆤𑆴𑆪𑆾𑆓𑆂(𑇒𑇙), 𑆮𑆴𑆑𑆬𑇀𑆥𑆂(𑇓𑇐), 𑆱𑆩𑆶𑆖𑇀𑆖𑆪𑆂(𑇓𑇑), 𑆈𑆲𑇀𑆪𑆩𑇀(𑇓𑇒) 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆃𑆠𑇀𑆫𑆳𑆱𑆳𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆵𑆤𑆳𑆁 𑆑𑆴𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆩𑇀? 𑆇𑆖𑇀𑆪𑆠𑆼- 𑆮𑆳𑆑𑇀𑆪𑆪𑆾𑆘𑆤𑆩𑆫𑇀𑆡𑆪𑆾𑆘𑆤𑆁 𑆖 𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆃𑆱𑆢𑇀𑆮𑆳𑆢𑆴𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆳𑆑𑇀𑆪𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆤𑆩𑇀 𑇅 𑆱𑇀𑆮𑆮𑆳𑆑𑇀𑆪𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆥𑆴 𑆖 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆴𑆠𑆂 𑇆𑇕𑇆
𑆮𑇀𑆪𑆑𑇀𑆠𑆳 𑆤𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆪𑆼 𑆲𑇀𑆪𑆳𑆫𑇀𑆡𑆳 𑆬𑆵𑆤𑆳 𑆪𑆼 𑆖𑆳𑆥𑇀𑆪𑆤𑆴𑆫𑇀𑆩𑆬𑆳𑆂 𑇅 𑆬𑆼𑆯𑆾𑆑𑇀𑆠𑆳 𑆪𑆼 𑆖 𑆑𑆼𑆖𑆴𑆠𑇀𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆖𑆳𑆥𑆴 𑆥𑇀𑆫𑆱𑆳𑆣𑆤𑆩𑇀 𑇆𑇖𑇆
𑆪𑆡𑆳𑇁𑆩𑇀𑆧𑆶𑆘𑆮𑆤𑆱𑇀𑆪𑆳𑆫𑇀𑆑𑆂 𑆥𑇀𑆫𑆢𑆵𑆥𑆾 𑆮𑆼𑆯𑇀𑆩𑆤𑆾 𑆪𑆡𑆳 𑇅 𑆥𑇀𑆫𑆧𑆾𑆣𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆫𑇀𑆡𑆁 𑆠𑆡𑆳 𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆪𑆶𑆑𑇀𑆠𑆪𑆂 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆪𑆩𑆫𑇀𑆡𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪𑆾𑆖𑇀𑆪𑆠𑆼 𑆠𑆢𑆣𑆴𑆑𑆫𑆟𑆁; 𑆪𑆡𑆳 𑆫𑆱𑆁 𑆢𑆾𑆰𑆁 𑆮𑆳 𑇆𑇘𑇆
𑆪𑆼𑆤 𑆮𑆳𑆑𑇀𑆪𑆁 𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑆱 𑆪𑆾𑆓𑆂 𑇅 𑆪𑆡𑆳- ‘𑆠𑆽𑆬𑆁 𑆥𑆴𑆧𑆼𑆖𑇀𑆖𑆳𑆩𑆸𑆠𑆮𑆬𑇀𑆬𑆴𑆤𑆴𑆩𑇀𑆧𑆲𑆴𑆁𑆱𑇀𑆫𑆳𑆨𑆪𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆨𑆴𑆂 𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆧𑆬𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆱𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆲𑆴𑆠𑆳𑆪 𑆤𑆴𑆠𑇀𑆪𑆁 𑆓𑆬𑆓𑆟𑇀𑆝𑆫𑆾𑆓𑆼’ 𑇅 𑆅𑆠𑇀𑆪𑆠𑇀𑆫 𑆠𑆽𑆬𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆴𑆧𑆼𑆢𑆴𑆠𑆴 𑆥𑇀𑆫𑆡𑆩𑆁 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆼 𑆠𑆸𑆠𑆵𑆪𑆥𑆳𑆢𑆼 𑆱𑆴𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁, 𑆍𑆮𑆁 𑆢𑆷𑆫𑆱𑇀𑆡𑆳𑆤𑆳𑆩𑆥𑆴 𑆥𑆢𑆳𑆤𑆳𑆩𑆼𑆑𑆵𑆑𑆫𑆟𑆁 𑆪𑆾𑆓𑆂 𑇆𑇙𑇆
𑆪𑆾𑇁𑆫𑇀𑆡𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆂 𑆱𑆷𑆠𑇀𑆫𑆼 𑆥𑆢𑆼 𑆮𑆳 𑆱 𑆥𑆢𑆳𑆫𑇀𑆡𑆂 𑆥𑆢𑆱𑇀𑆪 𑆥𑆢𑆪𑆾𑆂 𑆥𑆢𑆳𑆤𑆳𑆁 𑆮𑆳𑇁𑆫𑇀𑆡𑆂 𑆥𑆢𑆳𑆫𑇀𑆡𑆂; 𑆃𑆥𑆫𑆴𑆩𑆴𑆠𑆳𑆯𑇀𑆖 𑆥𑆢𑆳𑆫𑇀𑆡𑆳𑆂 𑇅 𑆪𑆡𑆳- 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆚𑇀𑆘𑆤𑆼𑆰𑆶 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆼𑆰𑆶 𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆮𑆳𑇁𑆫𑇀𑆡𑆳𑆤𑆳𑆩𑆶𑆥𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆢𑆸𑆯𑇀𑆪𑆠𑆼, 𑆠𑆠𑇀𑆫 𑆪𑆾𑇁𑆫𑇀𑆡𑆂 𑆥𑆷𑆫𑇀𑆮𑆳𑆥𑆫𑆪𑆾𑆓𑆱𑆴𑆢𑇀𑆣𑆾 𑆨𑆮𑆠𑆴 𑆱 𑆓𑇀𑆫𑆲𑆵𑆠𑆮𑇀𑆪𑆂; 𑆪𑆡𑆳- ‘𑆮𑆼𑆢𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩’ 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆱𑆤𑇀𑆢𑆴𑆲𑇀𑆪𑆠𑆼 𑆧𑆶𑆢𑇀𑆣𑆴𑆂- 𑆑𑆠𑆩𑆱𑇀𑆪 𑆮𑆼𑆢𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆵𑆠𑆴, 𑆪𑆠𑆂 𑆉𑆓𑇀𑆮𑆼𑆢𑆳𑆢𑆪𑆱𑇀𑆠𑆶 𑆮𑆼𑆢𑆳𑆂; ‘𑆮𑆴𑆢 𑆮𑆴𑆖𑆳𑆫𑆟𑆼, 𑆮𑆴𑆢𑇀𑆬𑆸 𑆬𑆳𑆨𑆼,’ 𑆅𑆠𑇀𑆪𑆼𑆠𑆪𑆾𑆯𑇀𑆖 𑆣𑆳𑆠𑇀𑆮𑆾𑆫𑆤𑆼𑆑𑆳𑆫𑇀𑆡𑆪𑆾𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆠𑇀, 𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆳𑆥𑆫𑆪𑆾𑆓𑆩𑆶𑆥𑆬𑆨𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆠𑆴- 𑆄𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆩𑆪𑆁 𑆮𑆴𑆮𑆑𑇀𑆰𑆶𑆫𑆴𑆠𑆴; 𑆍𑆰 𑆥𑆢𑆳𑆫𑇀𑆡𑆂 𑇆𑇑𑇐𑇆
𑆪𑆢𑆤𑇀𑆪𑆢𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆪𑆳𑆫𑇀𑆡𑆱𑆳𑆣𑆑𑆁 𑆨𑆮𑆠𑆴 𑆱 𑆲𑆼𑆠𑇀𑆮𑆫𑇀𑆡𑆂 𑇅 𑆪𑆡𑆳- 𑆩𑆸𑆠𑇀𑆥𑆴𑆟𑇀𑆝𑆾𑇁𑆢𑇀𑆨𑆴𑆂 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆔𑆠𑆼 𑆠𑆡𑆳 𑆩𑆳𑆰𑆢𑆶𑆓𑇀𑆣𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑇀𑆫𑆟𑆂 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆔𑆠 𑆅𑆠𑆴 𑇆𑇑𑇑𑇆
𑆱𑆩𑆳𑆱𑆮𑆖𑆤𑆩𑆶𑆢𑇀𑆢𑆼𑆯𑆂 𑇅 𑆪𑆡𑆳- 𑆯𑆬𑇀𑆪𑆩𑆴𑆠𑆴 𑇆𑇑𑇒𑇆
𑆮𑆴𑆱𑇀𑆠𑆫𑆮𑆖𑆤𑆁 𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆂 𑇅 𑆪𑆡𑆳- 𑆯𑆳𑆫𑆵𑆫𑆩𑆳𑆓𑆤𑇀𑆠𑆶𑆑𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇓𑇆
𑆍𑆮𑆩𑆴𑆠𑇀𑆪𑆶𑆥𑆢𑆼𑆯𑆂 𑇅 𑆪𑆡𑆳- ‘𑆠𑆡𑆳 𑆤 𑆘𑆳𑆓𑆸𑆪𑆳𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆿 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀’ 𑆅𑆠𑆴 𑇆𑇑𑇔𑇆
𑆃𑆤𑆼𑆤 𑆑𑆳𑆫𑆟𑆼𑆤𑆼𑆠𑇀𑆪𑆥𑆢𑆼𑆯𑆂, 𑆪𑆡𑆳𑇁𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼- 𑆩𑆣𑆶𑆫𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆠𑆵𑆠𑆴 𑇆𑇑𑇕𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑆤 𑆱𑆳𑆣𑆤𑆁 𑆥𑇀𑆫𑆢𑆼𑆯𑆂 𑇅 𑆪𑆡𑆳- 𑆢𑆼𑆮𑆢𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆼𑆤 𑆯𑆬𑇀𑆪𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑆁 𑆠𑆡𑆳 𑆪𑆘𑇀𑆚𑆢𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆪𑆩𑆶𑆢𑇀𑆣𑆫𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴 𑇆𑇑𑇖𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆱𑇀𑆪𑆳𑆤𑆳𑆓𑆠𑆱𑇀𑆪 𑆱𑆳𑆣𑆤𑆩𑆠𑆴𑆢𑆼𑆯𑆂 𑇅 𑆪𑆡𑆳- 𑆪𑆠𑆾𑇁𑆱𑇀𑆪 𑆮𑆳𑆪𑆶𑆫𑆶𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆼 𑆠𑆼𑆤𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆵 𑆱𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑇆𑇑𑇗𑇆
𑆃𑆨𑆴𑆮𑇀𑆪𑆳𑆥𑇀𑆪𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆩𑆥𑆮𑆫𑇀𑆓𑆂 𑇅 𑆪𑆡𑆳- 𑆃𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳 𑆮𑆴𑆰𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆂, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫 𑆑𑆵𑆛𑆮𑆴𑆰𑆳𑆢𑆴𑆠𑆴 𑇆𑇑𑇘𑇆
𑆪𑆼𑆤 𑆥𑆢𑆼𑆤𑆳𑆤𑆶𑆑𑇀𑆠𑆼𑆤 𑆮𑆳𑆑𑇀𑆪𑆁 𑆱𑆩𑆳𑆥𑇀𑆪𑆼𑆠 𑆱 𑆮𑆳𑆑𑇀𑆪𑆯𑆼𑆰𑆂 𑇅 𑆪𑆡𑆳- 𑆯𑆴𑆫𑆂 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆾𑆢𑆫𑆾𑆫𑆱𑆳𑆩𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆥𑆶𑆫𑆶𑆰𑆓𑇀𑆫𑆲𑆟𑆁 𑆮𑆴𑆤𑆳𑇁𑆥𑆴 𑆓𑆩𑇀𑆪𑆠𑆼 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆼𑆠𑆴 𑇆𑇑𑇙𑇆
𑆪𑆢𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑆫𑇀𑆡𑆳𑆢𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆳𑇁𑆫𑇀𑆡𑆳𑆥𑆠𑇀𑆠𑆴𑆂 𑇅 𑆪𑆡𑆳- 𑆏𑆢𑆤𑆁 𑆨𑆾𑆑𑇀𑆰𑇀𑆪𑆼 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼𑇁𑆫𑇀𑆡𑆳𑆢𑆳𑆥𑆤𑇀𑆤𑆁 𑆨𑆮𑆠𑆴- 𑆤𑆳𑆪𑆁 𑆥𑆴𑆥𑆳𑆱𑆶𑆫𑇀𑆪𑆮𑆳𑆓𑆷𑆩𑆴𑆠𑆴 𑇆𑇒𑇐𑇆
𑆪𑆢𑇀𑆪𑆠𑇀𑆫𑆳𑆨𑆴𑆲𑆴𑆠𑆁 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆠𑆴𑆬𑆾𑆩𑇀𑆪𑆁 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆂 𑇅 𑆪𑆡𑆳- 𑆑𑆸𑆯𑆳𑆬𑇀𑆥𑆥𑇀𑆫𑆳𑆟𑆨𑆵𑆫𑆮𑆾 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆳 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆓𑆸𑆲𑇀𑆪𑆠𑆼 𑆢𑆸𑆞𑆳𑆢𑆪𑆂 𑆱𑆶𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆳 𑆅𑆠𑆴 𑇆𑇒𑇑𑇆
𑆥𑇀𑆫𑆑𑆫𑆟𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆱𑆩𑆳𑆥𑆤𑆁 𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆂, 𑆪𑆢𑇀𑆮𑆳 𑆥𑇀𑆫𑆑𑆫𑆟𑆳𑆤𑇀𑆠𑆫𑆴𑆠𑆾 𑆪𑆾𑇁𑆫𑇀𑆡𑆾𑇁𑆱𑆑𑆸𑆢𑆶𑆑𑇀𑆠𑆂 𑆱𑆩𑆳𑆥𑇀𑆪𑆠𑆼 𑆱 𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆂 𑇅 𑆪𑆡𑆳- 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆯𑆫𑆵𑆫𑆴𑆱𑆩𑆮𑆳𑆪𑆂 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳 𑆱𑆾𑇁𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆴𑆠𑆴 𑆮𑆼𑆢𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆳𑆮𑆨𑆴𑆣𑆳𑆪, 𑆨𑆷𑆠𑆖𑆴𑆤𑇀𑆠𑆳𑆪𑆳𑆁 𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁- 𑆪𑆠𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆁 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆯𑆫𑆵𑆫𑆴𑆱𑆩𑆮𑆳𑆪𑆂 𑆥𑆶𑆫𑆷𑆰 𑆅𑆠𑆴, 𑆱 𑆒𑆬𑇀𑆮𑆼𑆰 𑆑𑆫𑇀𑆩𑆥𑆶𑆫𑆶𑆰𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆣𑆴𑆑𑆸𑆠 𑆅𑆠𑆴 𑇆𑇒𑇒𑇆
(𑆱𑆫𑇀𑆮𑆠𑇀𑆫 )𑆪𑆢𑆮𑆣𑆳𑆫𑆟𑆼𑆤𑆾𑆖𑇀𑆪𑆠𑆼 𑆱 𑆍𑆑𑆳𑆤𑇀𑆠𑆂 𑇅 𑆪𑆡𑆳- 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆪𑆠𑆴, 𑆩𑆢𑆤𑆦𑆬𑆁 𑆮𑆳𑆩𑆪𑆠𑆴(𑆍𑆮) 𑇆𑇒𑇓𑇆
𑆑𑇀𑆮𑆖𑆴𑆠𑇀𑆠𑆡𑆳 𑆑𑇀𑆮𑆖𑆴𑆢𑆤𑇀𑆪𑆡𑆼𑆠𑆴 𑆪𑆂 𑆱𑆾𑇁𑆤𑆼𑆑𑆳𑆤𑇀𑆠𑆂 𑇅 𑆪𑆡𑆳- 𑆑𑆼𑆖𑆴𑆢𑆳𑆖𑆳𑆫𑇀𑆪𑆳 𑆧𑇀𑆫𑆶𑆮𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆑𑆼𑆖𑆴𑆢𑇀𑆫𑆱𑆁, 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆴𑆥𑆳𑆑𑆩𑆴𑆠𑆴 𑇆𑇒𑇔𑇆
𑆄𑆑𑇀𑆰𑆼𑆥𑆥𑆷𑆫𑇀𑆮𑆑𑆂 𑆥𑇀𑆫𑆯𑇀𑆤𑆂 𑆥𑆷𑆫𑇀𑆮𑆥𑆑𑇀𑆰𑆂 𑇅 𑆪𑆡𑆳- 𑆑𑆡𑆁 𑆮𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑇀𑆫𑆩𑆼𑆲 𑆃𑆱𑆳𑆣𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆵𑆠𑆴 𑇆𑇒𑇕𑇆
𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆁 𑆤𑆴𑆫𑇀𑆟𑆪𑆂 𑇅 𑆪𑆡𑆳- 𑆯𑆫𑆵𑆫𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪 𑆥𑆯𑇀𑆖𑆳𑆢𑆣𑆾 𑆓𑆠𑇀𑆮𑆳 𑆮𑆱𑆳𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆳𑆤𑆶𑆮𑆴𑆢𑇀𑆣𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆮𑆴𑆱𑆸𑆘𑆠𑆴 𑆮𑆳𑆠𑆂 𑆍𑆮𑆩𑆱𑆳𑆣𑇀𑆪𑆳 𑆮𑆳𑆠𑆘𑆳 𑆅𑆠𑆴 𑇆𑇒𑇖𑇆
𑆠𑆡𑆳 𑆖𑆾𑆑𑇀𑆠𑆩𑇀- 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆫𑆵𑆫𑆁 𑆤𑆴𑆰𑇀𑆥𑆵𑆝𑇀𑆪 𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆳𑆮𑆱𑆳𑆪𑆶𑆠𑆂 𑇅 𑆃𑆣𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆼 𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆼𑆤𑆳𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆘𑆳𑆂 𑇆𑇒𑇗𑇆
𑆥𑆫𑆩𑆠𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆩𑆤𑆶𑆩𑆠𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆃𑆤𑇀𑆪𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆱𑆥𑇀𑆠 𑆫𑆱𑆳 𑆅𑆠𑆴, 𑆠𑆖𑇀𑆖𑆳𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆳𑆢𑆤𑆶𑆩𑆤𑇀𑆪𑆠𑆼 𑆑𑆡𑆚𑇀𑆖𑆴𑆢𑆴𑆠𑆴 𑇆𑇒𑇘𑇆
𑆥𑇀𑆫𑆑𑆫𑆟𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳𑇁𑆨𑆴𑆲𑆴𑆠𑆁 𑆮𑆴𑆣𑆳𑆤𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆱𑆑𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆼𑆑𑆳𑆢𑆯 𑆥𑇀𑆫𑆑𑆫𑆟𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳𑇁𑆨𑆴𑆲𑆴𑆠𑆳𑆤𑆴 𑇆𑇒𑇙𑇆
𑆍𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆵𑆠𑇀𑆪𑆤𑆳𑆓𑆠𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆯𑇀𑆬𑆾𑆑𑆱𑇀𑆡𑆳𑆤𑆼 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆵𑆠𑆴 𑇆𑇓𑇐𑇆
𑆪𑆠𑇀𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆁 𑆠𑆢𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑆰𑆶 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆯𑇀𑆬𑆾𑆑𑆱𑇀𑆡𑆳𑆤𑆼 𑆪𑆢𑆵𑆫𑆴𑆠𑆩𑆴𑆠𑆴 𑇆𑇓𑇑𑇆
𑆇𑆨𑆪𑆲𑆼𑆠𑆶𑆢𑆫𑇀𑆯𑆤𑆁 𑆱𑆁𑆯𑆪𑆂 𑇅 𑆪𑆡𑆳 - 𑆠𑆬𑆲𑆸𑆢𑆪𑆳𑆨𑆴𑆔𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆂, 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆖𑇀𑆗𑆼𑆢𑆤𑆩𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆩𑆴𑆠𑆴 𑇆𑇓𑇒𑇆
𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑇁𑆠𑆴𑆯𑆪𑆾𑆥𑆮𑆫𑇀𑆟𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆤𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆅𑆲 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆑𑆂 𑆥𑆶𑆫𑆷𑆰𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆠𑆼, 𑆃𑆤𑇀𑆪𑆼𑆰𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑆶 𑆨𑆷𑆠𑆳𑆢𑆴𑆥𑇀𑆫𑆨𑆸𑆠𑇀𑆪𑆳𑆫𑆨𑇀𑆪 𑆖𑆴𑆤𑇀𑆠𑆳 𑇆𑇓𑇓𑇆
𑆃𑆤𑇀𑆪𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳 𑆱𑇀𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑇅 𑆪𑆡𑆳- 𑆩𑆴𑆡𑆶𑆤𑆩𑆴𑆠𑆴 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆫𑇀𑆓𑇀𑆫𑆓𑆟𑆁; 𑆬𑆾𑆑𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆩𑆶𑆢𑆳𑆲𑆫𑆟𑆁 𑆮𑆳 𑇆𑇓𑇔𑇆
𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆁 𑆮𑆖𑆤𑆁 𑆤𑆴𑆫𑇀𑆮𑆖𑆤𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆄𑆪𑆶𑆫𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆤𑆼𑆤 𑆮𑆳 𑆄𑆪𑆶𑆫𑇀𑆮𑆴𑆤𑇀𑆢𑆠𑆵𑆠𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆂 𑇆𑇓𑇕𑇆
𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆫𑇀𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆃𑆓𑇀𑆤𑆴𑆫𑇀𑆮𑆳𑆪𑆶𑆤𑆳 𑆱𑆲𑆴𑆠𑆂 𑆑𑆑𑇀𑆰𑆼 𑆮𑆸𑆫𑇀𑆢𑇀𑆣𑆴 𑆓𑆖𑇀𑆗𑆠𑆴 𑆠𑆡𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆢𑆶𑆰𑇀𑆛𑆾 𑆮𑇀𑆫𑆟 𑆅𑆠𑆴 𑇆𑇓𑇖𑇆
𑆅𑆢𑆩𑆼𑆮 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑆴 𑆤𑆴𑆪𑆾𑆓𑆂 𑇅 𑆪𑆡𑆳- 𑆥𑆡𑇀𑆪𑆩𑆼𑆮 𑆨𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑆴 𑇆𑇓𑇗𑇆
𑆅𑆢𑆁 𑆖𑆼𑆢𑆁 𑆖𑆼𑆠𑆴 𑆱𑆩𑆶𑆖𑇀𑆖𑆪𑆂 𑇅 𑆪𑆡𑆳- 𑆩𑆳𑆁𑆱𑆮𑆫𑇀𑆓𑆼 𑆍𑆟𑆲𑆫𑆴𑆟𑆳𑆢𑆪𑆾 𑆬𑆳𑆮𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆴𑆯𑆳𑆫𑆕𑇀𑆓𑆯𑇀𑆖 𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆤𑆵𑆠𑆴 𑇆𑇓𑇘𑇆
𑆅𑆢𑆁 𑆮𑆼𑆢𑆁 𑆮𑆼𑆠𑆴 𑆮𑆴𑆑𑆬𑇀𑆥𑆂 𑇅 𑆪𑆡𑆳- 𑆫𑆱𑆿𑆢𑆤𑆂 𑆱𑆔𑆸𑆠𑆳 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆮𑆳 (𑆨𑆮𑆠𑇀𑆮𑆴𑆠𑆴) 𑇆𑇓𑇙𑇆
𑆪𑆢𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆧𑆶𑆢𑇀𑆣𑆪𑆳𑇁𑆮𑆓𑆩𑇀𑆪𑆠𑆼 𑆠𑆢𑆷𑆲𑇀𑆪𑆩𑇀 𑇅 𑆪𑆡𑆳- 𑆃𑆨𑆴𑆲𑆴𑆠𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆿 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆖𑆳𑆤𑇀𑆤𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼- 𑆨𑆑𑇀𑆰𑇀𑆪𑆁 𑆨𑆾𑆘𑇀𑆪𑆁 𑆬𑆼𑆲𑇀𑆪𑆁 𑆥𑆼𑆪𑆩𑆴𑆠𑆴, 𑆍𑆮𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆼 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆼 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆨𑆴𑆲𑆴𑆠𑆩𑇀; 𑆅𑆢𑆩𑆠𑇀𑆫𑆾𑆲𑇀𑆪𑆩𑇀- 𑆃𑆤𑇀𑆤𑆥𑆳𑆤𑆼 𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆓𑇀𑆫𑆲𑆟𑆼 𑆑𑆸𑆠𑆼 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆩𑆥𑆴 𑆓𑇀𑆫𑆲𑆟𑆁 𑆨𑆮𑆠𑆵𑆠𑆴; 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆯𑇀𑆖𑆳𑆲𑆳𑆫𑆂 𑆥𑇀𑆫𑆮𑆴𑆫𑆬𑆂, 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆢𑇀𑆮𑆴𑆮𑆴𑆣 𑆍𑆮; 𑆃𑆠𑆾 𑆢𑇀𑆮𑆴𑆠𑇀𑆮𑆁 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑇅 𑆑𑆴𑆚𑇀𑆖𑆳𑆤𑇀𑆪𑆠𑇀- 𑆃𑆤𑇀𑆤𑆼𑆤 𑆨𑆑𑇀𑆰𑇀𑆪𑆩𑆮𑆫𑆶𑆢𑇀𑆣𑆁, 𑆔𑆤𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆳𑆠𑇀; 𑆥𑆼𑆪𑆼𑆤 𑆬𑆼𑆲𑇀𑆪𑆁, 𑆢𑇀𑆫𑆮𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆳𑆠𑇀 𑇆𑇔𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆢𑆫𑇀𑆯𑆤𑆼𑆤𑆳𑆱𑆳𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆳 𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆫𑇀𑆯𑆴𑆠𑆳 𑇅 𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆶 𑆪𑆡𑆳𑆪𑆾𑆓𑆩𑆶𑆥𑆣𑆳𑆫𑇀𑆪𑆾 𑆮𑆴𑆥𑆯𑇀𑆖𑆴𑆠𑆳 𑇆𑇔𑇑𑇆
𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆪𑆾 𑆲𑇀𑆪𑆼𑆠𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆳𑆫𑆓𑆮𑆼𑆰𑆟𑆼 𑇅 𑆩𑆪𑆳 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆤𑆴𑆲𑆴𑆠𑆳𑆂 𑆯𑆧𑇀𑆢𑆳𑆫𑇀𑆡𑆤𑇀𑆪𑆳𑆪𑆱𑆁𑆪𑆶𑆠𑆳𑆂 𑇆𑇔𑇒𑇆
𑆪𑆾 𑆲𑇀𑆪𑆾𑆠𑆳 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆮𑆼𑆠𑇀𑆠𑆴 𑆢𑆵𑆥𑆵𑆨𑆷𑆠𑆳𑆱𑇀𑆠𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆱 𑆥𑆷𑆘𑆳𑆫𑇀𑆲𑆾 𑆨𑆴𑆰𑆑𑇀𑆯𑇀𑆫𑆼𑆰𑇀𑆜 𑆅𑆠𑆴 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆼𑆫𑇀𑆩𑆠𑆩𑇀 𑇆𑇔𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑆾𑆰𑆨𑆼𑆢𑆮𑆴𑆑𑆬𑇀𑆥𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆮𑆼𑆢𑆮𑆴𑆢𑇀𑆮𑆳𑆁𑆱𑆁 𑆢𑆴𑆮𑆾𑆢𑆳𑆱𑆁 𑆩𑆲𑆿𑆘𑆱𑆩𑇀 𑇅 𑆗𑆴𑆤𑇀𑆤𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆱𑆤𑇀𑆢𑆼𑆲𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆓𑆳𑆣𑆳𑆓𑆩𑆾𑆢𑆣𑆴𑆩𑇀 𑇆𑇓𑇆
𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆠𑆶 𑆱𑆲𑆱𑇀𑆫𑆁 𑆪𑆖𑇀𑆗𑆠𑆁 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆼𑆮 𑆖 𑇅 𑆯𑆠𑆁 𑆖 𑆥𑆚𑇀𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆱𑆥𑇀𑆠𑆠𑇀𑆪𑆣𑆴𑆑𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇘𑇆
𑆠𑇀𑆫𑆪 𑆍𑆮 𑆥𑆸𑆡𑆑𑇀 𑆢𑆾𑆰𑆳 𑆢𑇀𑆮𑆴𑆯𑆾 𑆤𑆮 𑆱𑆩𑆳𑆣𑆴𑆑𑆽𑆂 𑇅 𑆠𑇀𑆫𑆪𑆾𑆢𑆯𑆳𑆣𑆴𑆑𑆽𑆑𑆢𑇀𑆮𑆴𑆱𑆩𑆩𑆣𑇀𑆪𑆾𑆬𑇀𑆧𑆟𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆯𑆂 𑇆𑇑𑇐𑇆
𑆥𑆚𑇀𑆖𑆳𑆯𑆢𑆼𑆮𑆁 𑆠𑆶 𑆱𑆲 𑆨𑆮𑆤𑇀𑆠𑆴 𑆑𑇀𑆰𑆪𑆩𑆳𑆓𑆠𑆽𑆂 𑇅 𑆑𑇀𑆰𑆵𑆟𑆩𑆣𑇀𑆪𑆳𑆣𑆴𑆑𑆑𑇀𑆰𑆵𑆟𑆑𑇀𑆰𑆵𑆟𑆮𑆸𑆢𑇀𑆣𑆽𑆱𑇀𑆠𑆡𑆳𑇁𑆥𑆫𑆽𑆂 𑇆𑇑𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆁 𑆱𑆁𑆪𑆩𑇀𑆪 𑆢𑆾𑆰𑆨𑆼𑆢𑆮𑆴𑆑𑆬𑇀𑆥𑆤𑆽𑆂 𑇅 𑆫𑆾𑆓𑆁 𑆮𑆴𑆢𑆴𑆠𑇀𑆮𑆾𑆥𑆖𑆫𑆼𑆢𑇀𑆫𑆱𑆨𑆼𑆢𑆽𑆫𑇀𑆪𑆡𑆽𑆫𑆴𑆠𑆽𑆂 𑇆𑇑𑇓𑇆
𑆨𑆴𑆰𑆑𑇀 𑆑𑆫𑇀𑆠𑆳𑇁𑆡 𑆑𑆫𑆟𑆁 𑆫𑆱𑆳 𑆢𑆾𑆰𑆳𑆱𑇀𑆠𑆶 𑆑𑆳𑆫𑆟𑆩𑇀 𑇅 𑆑𑆳𑆫𑇀𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆼𑆮𑆽𑆑𑆩𑆤𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑇆𑇑𑇔𑇆
𑆃𑆣𑇀𑆪𑆳𑆪𑆳𑆤𑆳𑆁 𑆠𑆶 𑆰𑆛𑇀𑆰𑆰𑇀𑆛𑇀𑆪𑆳 𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆫𑇀𑆡𑆥𑆢𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆍𑆮𑆩𑆼𑆠𑆢𑆯𑆼𑆰𑆼𑆟 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆶𑆠𑇀𑆠𑆫𑆩𑆸𑆢𑇀𑆣𑆴𑆩𑆠𑇀 𑇆𑇑𑇕𑇆
𑆱𑇀𑆥𑆰𑇀𑆛𑆓𑆷𑆞𑆳𑆫𑇀𑆡𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆓𑆳𑆞𑆩𑆤𑇀𑆢𑆖𑆼𑆠𑆱𑆳𑆩𑇀 𑇅 𑆪𑆡𑆳𑆮𑆴𑆣𑆴 𑆪𑆡𑆳𑆥𑇀𑆫𑆯𑇀𑆤𑆁 𑆨𑆮𑆠𑆳𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇑𑇖𑇆

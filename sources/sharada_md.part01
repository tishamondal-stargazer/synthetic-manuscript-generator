𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆪𑆶𑆠𑆁 𑆥𑆵𑆠𑆁 𑆠𑆢𑆼𑆮 𑆒𑆢𑆴𑆫𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇅 𑆥𑆑𑇀𑆰𑆴𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆲𑆳𑆫𑆁 𑆑𑆫𑆾𑆠𑆴 𑆢𑇀𑆮𑆴𑆯𑆠𑆳𑆪𑆶𑆰𑆩𑇀 𑇆𑇓𑇒𑇆
𑆠𑆢𑆼𑆮 𑆤𑆱𑇀𑆪𑆼 𑆥𑆚𑇀𑆖𑆳𑆯𑆢𑇀𑆢𑆴𑆮𑆱𑆳𑆤𑆶𑆥𑆪𑆾𑆘𑆴𑆠𑆩𑇀 𑇅 𑆮𑆥𑆶𑆰𑇀𑆩𑆤𑇀𑆠𑆁 𑆯𑇀𑆫𑆶𑆠𑆴𑆣𑆫𑆁 𑆑𑆫𑆾𑆠𑆴 𑆠𑇀𑆫𑆴𑆯𑆠𑆳𑆪𑆶𑆰𑆩𑇀 𑇆𑇓𑇓𑇆
𑆯𑆾𑆣𑆪𑆤𑇀𑆠𑆴 𑆤𑆫𑆁 𑆥𑆵𑆠𑆳 𑆩𑆘𑇀𑆘𑆳𑆤𑆱𑇀𑆠𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑇅 𑆩𑆲𑆳𑆮𑆵𑆫𑇀𑆪𑆱𑇀𑆠𑆶𑆮𑆫𑆑𑆂 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆳𑆥𑆲𑆂 𑆥𑆫𑆂 𑇆𑇓𑇔𑇆
𑆱𑆳𑆤𑇀𑆠𑆫𑇀𑆣𑆷𑆩𑆱𑇀𑆠𑆱𑇀𑆪 𑆩𑆘𑇀𑆘𑆳 𑆠𑆶 𑆢𑆓𑇀𑆣𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆱𑇀𑆠𑆽𑆬𑆼 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆖𑆳𑆚𑇀𑆘𑆤𑆁 𑆖 𑇅 𑆥𑆽𑆬𑇀𑆬𑇀𑆪𑆁 𑆲𑆤𑇀𑆪𑆳𑆢𑆫𑇀𑆩𑆤𑆑𑇀𑆠𑆳𑆤𑇀𑆣𑇀𑆪𑆑𑆳𑆖𑆳𑆤𑇀 𑆤𑆵𑆬𑆵𑆫𑆾𑆓𑆁 𑆠𑆽𑆩𑆴𑆫𑆁 𑆖𑆳𑆚𑇀𑆘𑆤𑆼𑆤 𑇆𑇓𑇕𑇆
𑆃𑆡𑆳𑆠 𑆇𑆢𑆫𑆳𑆟𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆰𑇀𑆛𑆳𑆮𑆶𑆢𑆫𑆳𑆟𑆴 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑇅 𑆠𑆼𑆰𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆁 𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆁 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴 𑆖; 𑆃𑆮𑆯𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴; 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑇅 𑆠𑆼𑆰𑇀𑆮𑆳𑆢𑇀𑆪𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆫𑇀𑆓𑆾 𑆨𑆼𑆰𑆘𑆱𑆳𑆣𑇀𑆪𑆂, 𑆇𑆠𑇀𑆠𑆫𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆂, 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮 𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴 𑆮𑆫𑇀𑆘𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆤𑆴 𑆮𑆳 𑇆𑇓𑇆
𑆇𑆢𑆫𑆵 𑆠𑆶 𑆓𑆶𑆫𑇀𑆮𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆫𑆷𑆑𑇀𑆰𑆮𑆴𑆢𑆳𑆲𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆥𑆴𑆯𑆴𑆠𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆳𑆤𑇀 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆤𑆵𑆮𑆳𑆫𑆳𑆤𑇀 𑆤𑆴𑆠𑇀𑆪𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆾𑆢𑆫𑆴𑆟𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆱𑇀𑆤𑆼𑆲𑆪𑆴𑆠𑇀𑆮𑆳, 𑆠𑆴𑆬𑇀𑆮𑆑𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪, 𑆖𑆴𑆠𑇀𑆫𑆳𑆦𑆬𑆠𑆽𑆬𑆥𑇀𑆫𑆓𑆳𑆞𑆼𑆤 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖, 𑆱𑆳𑆬𑇀𑆮𑆟𑆼𑆤 𑆖𑆾𑆥𑆤𑆳𑆲𑆪𑆼𑆢𑆶𑆢𑆫𑆁, 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆼𑆤 𑆖, 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆖𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑇀 𑇆𑇕𑇆
𑆥𑆴𑆠𑇀𑆠𑆾𑆢𑆫𑆴𑆟𑆁 𑆠𑆶 𑆩𑆣𑆶𑆫𑆓𑆟𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆱𑇀𑆤𑆼𑆲𑆪𑆴𑆠𑇀𑆮𑆳, 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪, 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆔𑆸𑆠𑆥𑇀𑆫𑆓𑆳𑆞𑆼𑆤 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖, 𑆥𑆳𑆪𑆱𑆼𑆤𑆾𑆥𑆤𑆳𑆲𑆪𑆼𑆢𑆶𑆢𑆫𑆁, 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆥𑆪𑆱𑆳 𑇆𑇖𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆢𑆫𑆴𑆟𑆁 𑆠𑆶 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆥𑆱𑇀𑆤𑆼𑆲𑇀𑆪, 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪, 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆠𑆽𑆬𑆥𑇀𑆫𑆓𑆳𑆞𑆼𑆤 𑆩𑆶𑆰𑇀𑆑𑆑𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖, 𑆯𑆟𑆳𑆠𑆱𑆵𑆣𑆳𑆠𑆑𑆵𑆑𑆴𑆟𑇀𑆮𑆱𑆫𑇀𑆰𑆥𑆩𑆷𑆬𑆑𑆧𑆵𑆘𑆑𑆬𑇀𑆑𑆽𑆯𑇀𑆖𑆾𑆥𑆤𑆳𑆲𑆪𑆼𑆢𑆶𑆢𑆫𑆁, 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆥𑇀𑆫𑆓𑆳𑆞𑆼𑆤 𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆷𑆰𑆼𑆟 𑆥𑆳𑆪𑆱𑆼𑆤 𑆮𑆳, 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆖𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑇀 𑇆𑇗𑇆
𑆢𑆷𑆰𑇀𑆪𑆾𑆢𑆫𑆴𑆟𑆁 𑆠𑆶 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪 𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆱𑇀𑆮𑆫𑆱𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆮𑆴𑆫𑆖𑆪𑆼𑆤𑇀𑆩𑆳𑆱𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆮𑆳, 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆱𑆶𑆫𑆳𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆮𑆳; 𑆯𑆶𑆢𑇀𑆣𑆑𑆾𑆰𑇀𑆜𑆁 𑆠𑆶 𑆩𑆢𑇀𑆪𑆼𑆤𑆳𑆯𑇀𑆮𑆩𑆳𑆫𑆑𑆓𑆶𑆚𑇀𑆘𑆳𑆑𑆳𑆑𑆳𑆢𑆤𑆵𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆅𑆑𑇀𑆰𑆶𑆑𑆳𑆟𑇀𑆝𑆳𑆤𑆴 𑆮𑆳 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆼𑆟 𑆢𑆁𑆯𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆑𑇀𑆰𑆪𑆼𑆢𑇀𑆮𑆬𑇀𑆬𑆵𑆦𑆬𑆳𑆤𑆴 𑆮𑆳, 𑆩𑆷𑆬𑆘𑆁 𑆑𑆤𑇀𑆢𑆘𑆁 𑆮𑆳 𑆮𑆴𑆰𑆩𑆳𑆱𑆼𑆮𑆪𑆼𑆠𑇀, 𑆠𑆼𑆤𑆳𑆓𑆢𑆾 𑆨𑆮𑆠𑇀𑆪𑆤𑇀𑆪𑆁 𑆮𑆳 𑆨𑆳𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑇆𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑆶𑆥𑆴𑆠𑆳𑆤𑆴𑆬𑆩𑆷𑆬𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆚𑇀𑆖𑆴𑆠𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆬𑆱𑇀𑆪 𑆖 𑇅 𑆱𑆫𑇀𑆮𑆾𑆢𑆫𑆼𑆰𑆶 𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆧𑆲𑆶𑆯𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆬𑆾𑆩𑆤𑆩𑇀 𑇆𑇙𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆪𑆾𑆓𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆍𑆫𑆟𑇀𑆝𑆠𑆽𑆬𑆩𑆲𑆫𑆲𑆫𑇀𑆩𑆳𑆱𑆁 𑆢𑇀𑆮𑆿 𑆮𑆳 𑆑𑆼𑆮𑆬𑆁 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠𑆾𑆢𑆑𑆮𑆫𑇀𑆘𑆵, 𑆩𑆳𑆲𑆴𑆰𑆁 𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆤𑆴𑆫𑆳𑆲𑆳𑆫𑆂𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑇀, 𑆇𑆰𑇀𑆛𑇀𑆫𑆵𑆑𑇀𑆰𑆵𑆫𑆳𑆲𑆳𑆫𑆾 𑆮𑆳𑇁𑆤𑇀𑆤𑆮𑆳𑆫𑆴𑆮𑆫𑇀𑆘𑆵 𑆥𑆑𑇀𑆰𑆁, 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆮𑆳 𑆩𑆳𑆱𑆁 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆳𑆱𑆼𑆮𑆼𑆠, 𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆘𑆩𑆾𑆢𑆳𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆠𑆽𑆬𑆩𑇀, 𑆄𑆫𑇀𑆢𑇀𑆫𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆫𑆱𑆥𑆳𑆠𑇀𑆫𑆯𑆠𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆮𑆳𑆠𑆯𑆷𑆬𑆼𑇁𑆮𑆖𑆳𑆫𑇀𑆪𑆁, 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆫𑆱𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆳𑆱𑆼𑆮𑆼𑆠, 𑆖𑆮𑇀𑆪𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆥𑆪𑆱𑆳 𑆱𑆫𑆬𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆼𑆮 𑆮𑆳, 𑆩𑆶𑆫𑆕𑇀𑆓𑆵𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆯𑇀𑆪𑆳𑆩𑆳𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆑𑆬𑇀𑆑𑆁 𑆮𑆳, 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆑𑆦𑆬𑆠𑆽𑆬𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆩𑆴𑆯𑇀𑆫𑆁 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆓𑆶𑆝𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳𑆁 𑆮𑆳 𑆲𑆫𑆵𑆠𑆑𑆵𑆁 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆁 𑆑𑆳𑆬𑆼𑆤, 𑆥𑆡𑇀𑆪𑆳𑆑𑆸𑆰𑇀𑆟𑆳𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆨𑆳𑆮𑆴𑆠𑆩𑆶𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆁 𑆥𑆑𑇀𑆮𑆳𑆁 𑆢𑆳𑆥𑆪𑆼𑆠𑇀; 𑆲𑆫𑆵𑆠𑆑𑆵𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆳𑆞𑆑𑆼 𑆔𑆸𑆠𑆱𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆪𑆳𑆕𑇀𑆓𑆳𑆫𑆼𑆰𑇀𑆮𑆨𑆴𑆮𑆴𑆬𑆳𑆥𑇀𑆪 𑆒𑆘𑆼𑆤𑆳𑆨𑆴𑆩𑆡𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳𑇁𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆪𑆮𑆥𑆬𑇀𑆬𑆼 𑆮𑆳𑆱𑆪𑆼𑆠𑇀, 𑆠𑆠𑆯𑇀𑆖𑆾𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆲𑆫𑆵𑆠𑆑𑆵𑆑𑇀𑆮𑆳𑆡𑆳𑆩𑇀𑆬𑆢𑆣𑆵𑆤𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆠𑆢𑇀𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆩𑆳𑆱𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆓𑆮𑇀𑆪𑆼 𑆥𑆪𑆱𑆴 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆖𑆳𑆮𑆠𑆳𑆫𑇀𑆪 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆁 𑆩𑆤𑇀𑆡𑆳𑆤𑆼𑆤𑆳𑆨𑆴𑆩𑆡𑇀𑆪 𑆤𑆮𑆤𑆵𑆠𑆩𑆳𑆢𑆳𑆪 𑆨𑆷𑆪𑆾 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆽𑆮 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆠𑆢𑇀𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆩𑆳𑆱𑆁 𑆩𑆳𑆱𑆳𑆫𑇀𑆣𑆁 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆢𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆮𑆴𑆰𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆳𑆫𑆴𑆮𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆘𑆩𑆾𑆢𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆳𑆤𑆳𑆩𑆫𑇀𑆣𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆳 𑆨𑆳𑆓𑆳, 𑆫𑆳𑆘𑆮𑆸𑆑𑇀𑆰𑆦𑆬𑆩𑆘𑇀𑆘𑇀𑆚𑆳𑆩𑆰𑇀𑆛𑆿 𑆑𑆫𑇀𑆰𑆳𑆂, 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆥𑆬𑆼 𑆢𑇀𑆮𑆼, 𑆓𑆮𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆪𑆾𑆫𑆰𑇀𑆛𑆳𑆮𑆰𑇀𑆛𑆿 𑆥𑆬𑆳𑆤𑆴, 𑆍𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆠𑆢𑇀𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆩𑆳𑆱𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆍𑆠𑆳𑆤𑆴 𑆠𑆴𑆬𑇀𑆮𑆑𑆔𑆸𑆠𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆤𑆴 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑇀𑆪𑆶𑆢𑆫𑆓𑆶𑆬𑇀𑆩𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆰𑇀𑆜𑆵𑆬𑆳𑆤𑆳𑆲𑆑𑆶𑆰𑇀𑆜𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆼𑆰𑆷𑆥𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆫𑇀𑆡𑆁; 𑆩𑆷𑆠𑇀𑆫𑆳𑆱𑆮𑆳𑆫𑆴𑆰𑇀𑆛𑆱𑆶𑆫𑆳𑆯𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆱𑆩𑇀𑆨𑆸𑆠𑆳𑆂 𑆱𑆼𑆮𑆼𑆠; 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑆰𑆳𑆪𑆁 𑆮𑆳 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆥𑇀𑆫𑆓𑆳𑆞𑆩𑇀 𑇆𑇑𑇐𑇆
𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑆳𑆬𑆴𑆑𑆳 𑆨𑆳𑆓𑆳𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆮𑆖𑆳𑆢𑆴𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑆴𑆥𑆫𑆴𑆥𑆜𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆖 𑆬𑆮𑆟𑆳𑆤𑆳𑆁 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆩𑆷𑆠𑇀𑆫𑆓𑆟𑆼 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆖 𑆩𑆸𑆢𑇀𑆮𑆓𑇀𑆤𑆴𑆤𑆳𑇁𑆮𑆔𑆛𑇀𑆛𑆪𑆤𑇀 𑆮𑆴𑆥𑆖𑆼𑆢𑆥𑇀𑆫𑆢𑆓𑇀𑆣𑆑𑆬𑇀𑆑𑆁, 𑆠𑆠𑇀𑆱𑆳𑆣𑆶𑆱𑆴𑆢𑇀𑆣𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆩𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳 𑆓𑆶𑆛𑆴𑆑𑆳 𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀, 𑆠𑆳𑆱𑆳𑆩𑆼𑆑𑆳𑆁 𑆢𑇀𑆮𑆼 𑆠𑆴𑆱𑇀𑆫𑆾 𑆮𑆳 𑆓𑆶𑆛𑆴𑆑𑆳 𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆪𑆳 𑆩𑆳𑆱𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆍𑆰𑆳𑇁𑇁𑆤𑆳𑆲𑆁𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆷𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼 (𑆮𑆴𑆯𑆼𑆰𑆼𑆟) 𑆑𑆾𑆰𑇀𑆜𑆘𑆳𑆁𑆯𑇀𑆖 𑆑𑆸𑆩𑆵𑆤𑆥𑆲𑆤𑇀𑆠𑆴 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆤𑆳𑆯𑆪𑆠𑆴 𑇆𑇑𑇑𑇆
𑆩𑆢𑆤𑆦𑆬𑆩𑆘𑇀𑆘𑆑𑆶𑆛𑆘𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆱𑆫𑇀𑆰𑆥𑆬𑆮𑆟𑆳𑆤𑆴 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆳𑆫𑇀𑆠𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆾𑆢𑆫𑆴𑆟 𑆄𑆤𑆳𑆲𑆼 𑆠𑆽𑆬𑆬𑆮𑆟𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆓𑆶𑆢𑆱𑇀𑆪𑆽𑆑𑆳𑆁 𑆢𑇀𑆮𑆼 𑆠𑆴𑆱𑇀𑆫𑆾 𑆮𑆳 𑆥𑆳𑆪𑆿 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆍𑆰𑆳𑇁𑇁𑆤𑆳𑆲𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆣𑇀𑆩𑆳𑆤𑆳𑆤𑆳𑆲𑆼𑆰𑆶 𑆮𑆴𑆣𑆼𑆪𑆳 𑇆𑇑𑇒𑇆
𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆴𑆟𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆢𑆣𑇀𑆤𑆳 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆾 𑆮𑆳𑆩𑆧𑆳𑆲𑆿 𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀, 𑆮𑆴𑆩𑆫𑇀𑆢𑆪𑆼𑆖𑇀𑆖 𑆥𑆳𑆟𑆴𑆤𑆳 𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆁 𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆪𑆤𑇀𑆢𑆤𑆳𑆫𑇀𑆡𑆁; 𑆠𑆠𑆂 𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆁 𑆱𑆩𑆶𑆢𑇀𑆫𑆯𑆶𑆑𑇀𑆠𑆴𑆑𑆳𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑆪𑆱𑆳 𑆥𑆳𑆪𑆪𑆼𑆠, 𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆿𑆮𑆫𑇀𑆖𑆴𑆑𑆼 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆼𑆟, 𑆱𑇀𑆫𑆶𑆠𑆼𑆤 𑆥𑆬𑆳𑆯𑆑𑇀𑆰𑆳𑆫𑆼𑆟 𑆮𑆳 𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆁, 𑆑𑆴𑆁𑆯𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆼𑆤 𑆮𑆳 𑆧𑆲𑆶𑆯𑆂 𑆱𑇀𑆫𑆶𑆠𑆼𑆤 𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆁, 𑆥𑆳𑆫𑆴𑆘𑆳𑆠𑆑𑆼𑆑𑇀𑆰𑆶𑆫𑆑𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆑𑇀𑆰𑆳𑆫𑆁 𑆮𑆳, 𑆠𑆽𑆬𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆯𑆾𑆨𑆳𑆚𑇀𑆘𑆤𑆑𑆪𑆷𑆰𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆽𑆤𑇀𑆣𑆮𑆖𑆴𑆠𑇀𑆫𑆑𑆪𑆶𑆑𑇀𑆠𑆁, 𑆥𑆷𑆠𑆴𑆑𑆫𑆚𑇀𑆘𑆑𑇀𑆰𑆳𑆫𑆁 𑆮𑆳𑇁𑆩𑇀𑆬𑆱𑇀𑆫𑆶𑆠𑆁 𑆮𑆴𑆝𑇀𑆬𑆮𑆟𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑇀𑆫𑆓𑆳𑆞𑆩𑇀 𑇆𑇑𑇓𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆤𑆳𑆁 𑆥𑆳𑆬𑆴𑆑𑆳 𑆨𑆳𑆓𑆳𑆂, 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆠𑆠𑇀𑆠𑆶𑆬𑇀𑆪𑆁 𑆖 𑆑𑇀𑆰𑆵𑆫𑆁 𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀, 𑆍𑆠𑆠𑇀 𑆰𑆛𑇀𑆥𑆬𑆑𑆁 𑆤𑆳𑆩 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆬𑆵𑆲𑆳𑆓𑇀𑆤𑆴𑆱𑆕𑇀𑆓𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆮𑆳𑆠𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆤𑆥𑆲𑆤𑇀𑆠𑆴 𑇅 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆫𑇀𑆮𑆳 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆑𑆁 𑆖𑆷𑆫𑇀𑆟𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇆𑇑𑇔𑇆
𑆪𑆑𑆸𑆢𑇀𑆢𑆳𑆬𑇀𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆰 𑆍𑆮 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆨𑆳𑆓𑆂 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆢𑆑𑇀𑆰𑆴𑆟𑆧𑆳𑆲𑆿 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆂 𑇆𑇑𑇕𑇆
𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆁 𑆱𑆑𑆸𑆤𑇀𑆤𑆳𑆩𑇀𑆪 𑆮𑆳𑆩𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆱𑆩𑆵𑆫𑆴𑆠𑆳𑆩𑇀 𑇅 𑆢𑆲𑆼𑆠𑇀 𑆱𑆴𑆫𑆳𑆁 𑆯𑆫𑆼𑆟𑆳𑆯𑆶 𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆾 𑆮𑆽𑆢𑇀𑆪𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇑𑇖𑇆
𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆼 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑆴 𑆖 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆣𑆾 𑆤𑆳𑆨𑆼𑆫𑇀𑆮𑆳𑆩𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆩𑆥𑆲𑆳𑆪 𑆫𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆳 𑆇𑆢𑆫𑆁 𑆥𑆳𑆛𑆪𑆴𑆠𑇀𑆮𑆳 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆤𑆴𑆰𑇀𑆑𑆸𑆰𑇀𑆪 𑆤𑆴𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆫𑆾𑆣𑆑𑆫𑆩𑆯𑇀𑆩𑆳𑆤𑆁 𑆧𑆳𑆬𑆁 𑆮𑆳𑇁𑆥𑆾𑆲𑇀𑆪 𑆩𑆬𑆘𑆳𑆠𑆁 𑆮𑆳 𑆠𑆠𑆾 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆘𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆪𑆡𑆳𑆱𑇀𑆡𑆳𑆤𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆧𑆳𑆲𑇀𑆪𑆁 𑆮𑇀𑆫𑆟𑆩𑆶𑆢𑆫𑆱𑇀𑆪 𑆱𑆵𑆮𑇀𑆪𑆼𑆠𑇀 𑇅 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑇀𑆪𑆥𑇀𑆪𑆼𑆮𑆩𑆼𑆮 𑆯𑆬𑇀𑆪𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆫𑆳𑆮𑆳𑆤𑇀 𑆱𑆁𑆯𑆾𑆣𑇀𑆪 , 𑆠𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆩𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆱𑆩𑆳𑆣𑆳𑆪 𑆑𑆳𑆬𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆨𑆴𑆫𑇀𑆢𑆁𑆯𑆪𑆼𑆠𑇀, 𑆢𑆰𑇀𑆛𑆼 𑆖 𑆠𑆳𑆱𑆳𑆁 𑆑𑆳𑆪𑆳𑆤𑆥𑆲𑆫𑆼𑆤𑇀𑆤 𑆯𑆴𑆫𑆳𑆁𑆱𑆴, 𑆠𑆠𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆱𑆵𑆮𑇀𑆪𑆼𑆠𑇀, 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆖 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀, 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆩𑆴𑆯𑇀𑆫𑆪𑆳 𑆖 𑆑𑆸𑆰𑇀𑆟𑆩𑆸𑆢𑆳𑇁𑆮𑆬𑆴𑆥𑇀𑆪 𑆧𑆤𑇀𑆣𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆠𑆠𑆾 𑆤𑆴𑆮𑆳𑆠𑆩𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪𑆳𑆖𑆳𑆫𑆴𑆑𑆩𑆶𑆥𑆢𑆴𑆯𑆼𑆠𑇀, 𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆁 𑆠𑆽𑆬𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆮𑆳 𑆥𑆪𑆾𑆮𑆸𑆠𑇀𑆠𑆴𑆩𑆴𑆠𑆴 𑇆𑇑𑇗𑇆
𑆇𑆢𑆑𑆾𑆢𑆫𑆴𑆟𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆲𑆫𑆠𑆽𑆬𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆪𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆱𑇀𑆡𑆴𑆠𑆱𑇀𑆪𑆳𑆥𑇀𑆠𑆽𑆂 𑆱𑆶𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆱𑇀𑆪𑆳𑆑𑆑𑇀𑆰𑆳𑆠𑇀 𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆱𑇀𑆪𑆳𑆣𑆾𑆤𑆳𑆨𑆼𑆫𑇀𑆮𑆳𑆩𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆩𑆥𑆲𑆳𑆪 𑆫𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆳 𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆼𑆤𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆾𑆢𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆮𑆓𑆳𑆞𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀, 𑆠𑆠𑇀𑆫 𑆠𑇀𑆫𑆥𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆤𑆳𑆝𑆵𑆁 𑆢𑇀𑆮𑆴𑆢𑇀𑆮𑆳𑆫𑆳𑆁 𑆥𑆑𑇀𑆰𑆤𑆳𑆝𑆵𑆁 𑆮𑆳 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆢𑆾𑆰𑆾𑆢𑆑𑆩𑆮𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀, 𑆠𑆠𑆾 𑆤𑆳𑆝𑆵𑆩𑆥𑆲𑆸𑆠𑇀𑆪 𑆠𑆽𑆬𑆬𑆮𑆟𑆼𑆤𑆳𑆨𑇀𑆪𑆘𑇀𑆪 𑆮𑇀𑆫𑆟𑆁 𑆧𑆤𑇀𑆣𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆤 𑆖𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮 𑆢𑆴𑆮𑆱𑆼 𑆱𑆫𑇀𑆮𑆁 𑆢𑆾𑆰𑆾𑆢𑆑𑆩𑆥𑆲𑆫𑆼𑆠𑇀, 𑆱𑆲𑆱𑆳 𑆲𑇀𑆪𑆥𑆲𑆸𑆠𑆼 𑆠𑆸𑆰𑇀𑆟𑆳𑆘𑇀𑆮𑆫𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆳𑆠𑆵𑆱𑆳𑆫𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆥𑆳𑆢𑆢𑆳𑆲𑆳 𑆇𑆠𑇀𑆥𑆢𑇀𑆪𑆼𑆫𑆤𑇀𑆤𑆳𑆥𑆷𑆫𑇀𑆪𑆠𑆼 𑆮𑆳 𑆨𑆸𑆯𑆠𑆫𑆩𑆶𑆢𑆫𑆩𑆱𑆚𑇀𑆘𑆳𑆠𑆥𑇀𑆫𑆳𑆟𑆱𑇀𑆪, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆠𑆵𑆪𑆖𑆠𑆶𑆫𑇀𑆡𑆥𑆚𑇀𑆖𑆩𑆰𑆰𑇀𑆜𑆳𑆰𑇀𑆛𑆩𑆢𑆯𑆩𑆢𑇀𑆮𑆳𑆢𑆯𑆰𑆾𑆝𑆯𑆫𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆤𑇀𑆠𑆫𑆵𑆑𑆸𑆠𑇀𑆪 𑆢𑆾𑆰𑆾𑆢𑆑𑆩𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆩𑆮𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀; 𑆤𑆴𑆂𑆱𑆸𑆠𑆼 𑆖 𑆢𑆾𑆰𑆼 𑆓𑆳𑆞𑆠𑆫𑆩𑆳𑆮𑆴𑆑𑆑𑆿𑆯𑆼𑆪𑆖𑆫𑇀𑆩𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆢𑆶𑆢𑆫𑆁, 𑆠𑆡𑆳 𑆤𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆠𑆴 𑆮𑆳𑆪𑆶𑆂; 𑆰𑆟𑇀𑆩𑆳𑆱𑆳𑆁𑆯𑇀𑆖 𑆥𑆪𑆱𑆳 𑆨𑆾𑆘𑆪𑆼𑆘𑇀𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆼𑆤 𑆮𑆳, 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑇀𑆩𑆳𑆱𑆳𑆤𑆫𑇀𑆣𑆾𑆢𑆑𑆼𑆤 𑆥𑆪𑆱𑆳 𑆦𑆬𑆳𑆩𑇀𑆬𑆼𑆤 𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆼𑆤 𑆮𑆳, 𑆃𑆮𑆯𑆴𑆰𑇀𑆛𑆁 𑆩𑆳𑆱𑆠𑇀𑆫𑆪𑆩𑆤𑇀𑆤𑆁 𑆬𑆔𑆶 𑆲𑆴𑆠𑆁 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆍𑆮𑆁 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆼𑆟𑆳𑆓𑆢𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆼 𑆖𑆽𑆮 𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆖 𑆥𑆳𑆤𑆼 𑆠𑆡𑆳𑇁𑇁𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑇅 𑆱𑆫𑇀𑆮𑆾𑆢𑆫𑆴𑆨𑇀𑆪𑆂 𑆑𑆶𑆯𑆬𑆽𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆯𑆸𑆠𑆁 𑆘𑆳𑆕𑇀𑆓𑆬𑆘𑆾 𑆫𑆱𑆾 𑆮𑆳 𑇆𑇑𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆳𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑇀 𑆑𑆰𑇀𑆛𑆠𑆩𑆩𑆱𑇀𑆠𑆴 𑆪𑆡𑆳 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆩𑇀; 𑆃𑆠𑇀𑆫 𑆲𑆴 𑆪𑆾𑆤𑆴𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑇀𑆠𑇀𑆫𑆮𑆴𑆮𑆫𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆳𑆤𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆑𑆫𑇀𑆩 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆼𑆤, 𑆇𑆠𑇀𑆑𑆫𑇀𑆰𑆟𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆱𑇀𑆡𑆳𑆤𑆳𑆥𑆮𑆫𑇀𑆠𑆤𑆾𑆠𑇀𑆑𑆫𑇀𑆠𑆤𑆨𑆼𑆢𑆤𑆖𑇀𑆗𑆼𑆢𑆤𑆥𑆵𑆝𑆤𑆫𑇀𑆘𑆷𑆑𑆫𑆟𑆢𑆳𑆫𑆟𑆳𑆤𑆴 𑆖𑆽𑆑𑆲𑆱𑇀𑆠𑆼𑆤 𑆓𑆫𑇀𑆨𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆁 𑆖𑆳𑆲𑆴𑆁𑆱𑆠𑆳, 𑆠𑆱𑇀𑆩𑆳𑆢𑆣𑆴𑆥𑆠𑆴𑆩𑆳𑆥𑆸𑆖𑇀𑆗𑇀𑆪 𑆥𑆫𑆁 𑆖 𑆪𑆠𑇀𑆤𑆩𑆳𑆱𑇀𑆡𑆳𑆪𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑆩𑆳𑆱𑆼𑆤𑆳𑆰𑇀𑆛𑆮𑆴𑆣𑆳 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆓𑆠𑆴𑆫𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳; 𑆱𑇀𑆮𑆨𑆳𑆮𑆓𑆠𑆳 𑆃𑆥𑆴 𑆠𑇀𑆫𑆪𑆂 𑆱𑆕𑇀𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑆴- 𑆯𑆴𑆫𑆱𑆾 𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆳𑆢𑆁𑆱𑆪𑆾𑆫𑇀𑆘𑆔𑆤𑆱𑇀𑆪 𑆮𑆳 𑇆𑇔𑇆
𑆘𑆵𑆮𑆠𑆴 𑆠𑆶 𑆓𑆫𑇀𑆨𑆼 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆫𑇀𑆨𑆤𑆴𑆫𑇀𑆲𑆫𑆟𑆼 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑇅 𑆤𑆴𑆫𑇀𑆲𑆫𑇀𑆠𑆶𑆩𑆯𑆑𑇀𑆪𑆼 𑆖𑇀𑆪𑆳𑆮𑆤𑆳𑆤𑇀 𑆩𑆤𑇀𑆠𑇀𑆫𑆳𑆤𑆶𑆥𑆯𑆸𑆟𑆶𑆪𑆳𑆠𑇀; 𑆠𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇕𑇆
‘𑆅𑆲𑆳𑆩𑆸𑆠𑆁 𑆖 𑆱𑆾𑆩𑆯𑇀𑆖 𑆖𑆴𑆠𑇀𑆫𑆨𑆳𑆤𑆶𑆯𑇀𑆖 𑆨𑆳𑆩𑆴𑆤𑆴 𑇅 𑆇𑆖𑇀𑆖𑆽𑆂𑆯𑇀𑆫𑆮𑆳𑆯𑇀𑆖 𑆠𑆶𑆫𑆓𑆾 𑆩𑆤𑇀𑆢𑆴𑆫𑆼 𑆤𑆴𑆮𑆱𑆤𑇀𑆠𑆶 𑆠𑆼 𑇆𑇖𑇆
𑆅𑆢𑆩𑆩𑆸𑆠𑆩𑆥𑆳𑆁 𑆱𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑆁 𑆮𑆽 𑆠𑆮 𑆬𑆔𑆶 𑆓𑆫𑇀𑆨𑆩𑆴𑆩𑆁 𑆥𑇀𑆫𑆩𑆶𑆚𑇀𑆖𑆠𑆶 𑆱𑇀𑆠𑇀𑆫𑆴 𑇅 𑆠𑆢𑆤𑆬𑆥𑆮𑆤𑆳𑆫𑇀𑆑𑆮𑆳𑆱𑆮𑆳𑆱𑇀𑆠𑆼 𑆱𑆲 𑆬𑆮𑆟𑆳𑆩𑇀𑆧𑆶𑆣𑆫𑆽𑆫𑇀𑆢𑆴𑆯𑆤𑇀𑆠𑆶 𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑇀 𑇆𑇗𑇆
𑆩𑆶𑆑𑇀𑆠𑆳𑆂 𑆥𑆯𑆾𑆫𑇀𑆮𑆴𑆥𑆳𑆯𑆳𑆯𑇀𑆖 𑆩𑆶𑆑𑇀𑆠𑆳𑆂 𑆱𑆷𑆫𑇀𑆪𑆼𑆟 𑆫𑆯𑇀𑆩𑆪𑆂 𑇅 𑆩𑆶𑆑𑇀𑆠𑆂 𑆱𑆫𑇀𑆮𑆨𑆪𑆳𑆢𑇀𑆓𑆫𑇀𑆨 𑆍𑆲𑇀𑆪𑆼𑆲𑆴 𑆮𑆴𑆫𑆩𑆳𑆮𑆴𑆠𑆂 𑇆𑇘𑇆
𑆐𑆰𑆣𑆳𑆤𑆴 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑇅 𑆩𑆸𑆠𑆼 𑆖𑆾𑆠𑇀𑆠𑆳𑆤𑆳𑆪𑆳 𑆄𑆨𑆶𑆓𑇀𑆤𑆱𑆑𑇀𑆡𑇀𑆪𑆳 𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆣𑆳𑆫𑆑𑆾𑆤𑇀𑆤𑆩𑆴𑆠𑆑𑆛𑇀𑆪𑆳 𑆣𑆤𑇀𑆮𑆤𑆤𑆓𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆳𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆩𑆸𑆠𑇀𑆱𑇀𑆤𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑇀𑆫𑆑𑇀𑆰𑆪𑆴𑆠𑇀𑆮𑆳 𑆲𑆱𑇀𑆠𑆁 𑆪𑆾𑆤𑆿 𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪 𑆓𑆫𑇀𑆨𑆩𑆶𑆥𑆲𑆫𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆑𑇀𑆡𑆴𑆨𑇀𑆪𑆳𑆩𑆳𑆓𑆠𑆩𑆤𑆶𑆬𑆾𑆩𑆩𑆼𑆮𑆳𑆚𑇀𑆗𑆼𑆠𑇀, 𑆍𑆑𑆱𑆑𑇀𑆡𑇀𑆤𑆳 𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆱𑇀𑆪𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆥𑇀𑆫𑆱𑆳𑆫𑇀𑆪𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆱𑇀𑆦𑆴𑆓𑇀𑆢𑆼𑆯𑆼𑆤𑆳𑆓𑆠𑆱𑇀𑆪 𑆱𑇀𑆦𑆴𑆓𑇀𑆢𑆼𑆯𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆱𑆑𑇀𑆡𑆴𑆤𑆵 𑆥𑇀𑆫𑆱𑆳𑆫𑇀𑆪𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆠𑆴𑆫𑇀𑆪𑆓𑆳𑆓𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆔𑆱𑇀𑆪𑆼𑆮 𑆠𑆴𑆫𑆯𑇀𑆖𑆵𑆤𑆱𑇀𑆪 𑆥𑆯𑇀𑆖𑆳𑆢𑆫𑇀𑆣𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆳𑆫𑇀𑆣𑆩𑆥𑆠𑇀𑆪𑆥𑆡𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆫𑇀𑆘𑆮𑆩𑆳𑆤𑆵𑆪𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆥𑆮𑆸𑆠𑇀𑆠𑆯𑆴𑆫𑆱𑆩𑆁𑆱𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆯𑆴𑆫𑆾𑇁𑆥𑆠𑇀𑆪𑆥𑆡𑆩𑆳𑆤𑆵𑆪𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆧𑆳𑆲𑆶𑆢𑇀𑆮𑆪𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆱𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆥𑆵𑆝𑇀𑆪𑆳𑆁𑆱𑆿 𑆯𑆴𑆫𑆾𑇁𑆤𑆶𑆬𑆾𑆩𑆩𑆳𑆤𑆵𑆪𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆢𑇀𑆮𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆮𑆱𑆳𑆣𑇀𑆪𑆿 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆿, 𑆍𑆮𑆩𑆯𑆑𑇀𑆪𑆼 𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆱𑆖𑆼𑆠𑆤𑆁 𑆖 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆤 𑆑𑆡𑆚𑇀𑆖𑆤 𑆢𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆢𑆳𑆫𑇀𑆪𑆩𑆳𑆟𑆾 𑆲𑆴 𑆘𑆤𑆤𑆵𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆖𑆽𑆮 𑆔𑆳𑆠𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆃𑆮𑆴𑆰𑆲𑇀𑆪𑆼 𑆮𑆴𑆑𑆳𑆫𑆼 𑆠𑆶 𑆯𑇀𑆫𑆼𑆪𑆾 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆥𑆳𑆠𑆤𑆩𑇀 𑇅 𑆤 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆮𑆴𑆥𑆫𑇀𑆪𑆳𑆱𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆤 𑆲𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆠𑆠𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆩𑆳𑆯𑇀𑆮𑆳𑆱𑇀𑆪 𑆩𑆟𑇀𑆝𑆬𑆳𑆓𑇀𑆫𑆼𑆟𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆮𑆳 𑆯𑆴𑆫𑆾 𑆮𑆴𑆢𑆳𑆫𑇀𑆪, 𑆯𑆴𑆫𑆂𑆑𑆥𑆳𑆬𑆳𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑇀𑆪, 𑆯𑆕𑇀𑆑𑆶𑆤𑆳 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆾𑆫𑆱𑆴 𑆑𑆑𑇀𑆰𑆳𑆪𑆳𑆁 𑆮𑆳𑇁𑆥𑆲𑆫𑆼𑆠𑇀; 𑆃𑆨𑆴𑆤𑇀𑆤𑆯𑆴𑆫𑆱𑆩𑆑𑇀𑆰𑆴𑆑𑆷𑆛𑆼 𑆓𑆟𑇀𑆝𑆼 𑆮𑆳, 𑆃𑆁𑆱𑆱𑆁𑆱𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆁𑆱𑆢𑆼𑆯𑆼 𑆧𑆳𑆲𑆷 𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳, 𑆢𑆸𑆠𑆴𑆩𑆴𑆮𑆳𑆠𑆠𑆁 𑆮𑆳𑆠𑆥𑆷𑆫𑇀𑆟𑆾𑆢𑆫𑆁 𑆮𑆳 𑆮𑆴𑆢𑆳𑆫𑇀𑆪 𑆤𑆴𑆫𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆯𑆴𑆡𑆴𑆬𑆵𑆨𑆷𑆠𑆩𑆳𑆲𑆫𑆼𑆠𑇀, 𑆘𑆔𑆤𑆱𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆳 𑆘𑆔𑆤𑆑𑆥𑆳𑆬𑆳𑆤𑆵𑆠𑆴 𑇆𑇑𑇒𑇆
𑆑𑆴𑆩𑇀𑆧𑆲𑆶𑆤𑆳- 𑆪𑆢𑇀𑆪𑆢𑆕𑇀𑆓𑆁 𑆲𑆴 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆠𑆱𑇀𑆪 𑆱𑆘𑇀𑆘𑆠𑆴 𑆠𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆖𑇀𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳 𑆫𑆑𑇀𑆰𑆼𑆤𑇀𑆤𑆳𑆫𑆵𑆁 𑆖 𑆪𑆠𑇀𑆤𑆠𑆂 𑇆𑇑𑇓𑇆
𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆓𑆠𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼𑇁𑆤𑆴𑆬𑆑𑆾𑆥𑆠𑆂 𑇅 𑆠𑆠𑇀𑆫𑆳𑆤𑆬𑇀𑆥𑆩𑆠𑆴𑆫𑇀𑆮𑆽𑆢𑇀𑆪𑆾 𑆮𑆫𑇀𑆠𑆼𑆠 𑆮𑆴𑆣𑆴𑆥𑆷𑆫𑇀𑆮𑆑𑆩𑇀 𑇆𑇑𑇔𑇆
𑆤𑆾𑆥𑆼𑆑𑇀𑆰𑆼𑆠 𑆩𑆸𑆠𑆁 𑆓𑆫𑇀𑆨𑆁 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆩𑆥𑆴 𑆥𑆟𑇀𑆝𑆴𑆠𑆂 𑇅 𑆱 𑆲𑇀𑆪𑆳𑆯𑆶 𑆘𑆤𑆤𑆵𑆁 𑆲𑆤𑇀𑆠𑆴 𑆤𑆴𑆫𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆁 𑆥𑆯𑆶𑆁 𑆪𑆡𑆳 𑇆𑇑𑇕𑇆

𑆤𑆼𑆠𑇀𑆫 𑆍𑆮 𑆱𑇀𑆡𑆴𑆠𑆼 𑆢𑆾𑆰𑆼 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆚𑇀𑆘𑆤𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆬𑆼𑆒𑆤𑆁 𑆫𑆾𑆥𑆟𑆁 𑆖𑆳𑆥𑆴 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇆𑇕𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆚𑇀𑆖 𑆫𑆱𑆳𑆤𑇀 𑆮𑇀𑆪𑆱𑇀𑆠𑆳𑆤𑆳𑆢𑇀𑆪𑆽𑆑𑆫𑆱𑆮𑆫𑇀𑆘𑆴𑆠𑆳𑆤𑇀 𑇅 𑆥𑆚𑇀𑆖𑆣𑆳 𑆬𑆼𑆒𑆤𑆁 𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆳𑆢𑆾𑆰𑆩𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆂 𑇆𑇕𑇓𑇆
𑆤𑆼𑆠𑇀𑆫𑆮𑆫𑇀𑆠𑇀𑆩𑆱𑆴𑆫𑆳𑆑𑆾𑆯𑆱𑇀𑆫𑆾𑆠𑆂𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀 𑇅 𑆩𑆶𑆒𑆤𑆳𑆱𑆳𑆑𑇀𑆰𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆩𑆾𑆘𑆱𑆳 𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆠𑇀 𑇆𑇕𑇔𑇆
𑆑𑆰𑆳𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆮𑆳𑇁𑆥𑆴 𑆱𑆱𑇀𑆤𑆼𑆲𑆁 𑆫𑆾𑆥𑆟𑆁 𑆩𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆱𑇀𑆤𑆼𑆲𑆯𑆽𑆠𑇀𑆪𑆳𑆢𑇀𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑆼𑆯𑇀𑆖 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇕𑇕𑇆
𑆩𑆣𑆶𑆫𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆚𑇀𑆘𑆤𑆁 𑆠𑆶 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑇀 𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆢𑆾𑆰𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆫𑇀𑆡𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆳𑆫𑇀𑆡𑆁 𑆖 𑆠𑆢𑇀𑆣𑆴𑆠𑆩𑇀 𑇆𑇕𑇖𑇆
𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆠𑆳𑆤𑆴 𑆫𑆾𑆓𑆮𑆴𑆯𑆳𑆫𑆢𑆽𑆂 𑇅 𑆃𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆲𑇀𑆟𑆱𑆳𑆪𑆳𑆲𑇀𑆤𑆫𑆳𑆠𑇀𑆫𑆴𑆰𑆶 𑇆𑇕𑇗𑇆
𑆓𑆶𑆛𑆴𑆑𑆳𑆫𑆱𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑆤𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆧𑆬𑆁 𑆠𑆼𑆰𑆳𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆳𑆲𑆶𑆫𑇀𑆩𑆤𑆵𑆰𑆴𑆟𑆂 𑇆𑇕𑇘𑇆
𑆲𑆫𑆼𑆟𑆶𑆩𑆳𑆠𑇀𑆫𑆳 𑆮𑆫𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆬𑇀𑆬𑆼𑆒𑆤𑆱𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆂 𑇅 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆱𑇀𑆪 𑆖𑆳𑆣𑇀𑆪𑆫𑇀𑆣𑆳 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆳 𑆫𑆾𑆥𑆟𑆱𑇀𑆪 𑆖 𑇆𑇕𑇙𑇆
𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑆶 𑆪𑆡𑆳𑆮𑆫𑇀𑆠𑆴𑆩𑆴𑆠𑆳 𑆩𑆠𑆳 𑇅 𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆖𑆠𑆶𑆂𑆯𑆬𑆳𑆑𑆳𑆯𑇀𑆖 𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆯𑆂 𑇆𑇖𑇐𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆳𑆤𑇀𑆪𑆼𑆮 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆨𑆳𑆘𑆤𑆳𑆤𑇀𑆪𑆥𑆴 𑇅 𑆱𑆿𑆮𑆫𑇀𑆟𑆁 𑆫𑆳𑆘𑆠𑆁 𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆁 𑆠𑆳𑆩𑇀𑆫𑆁 𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆑𑆳𑆁𑆱𑇀𑆪𑆘𑆩𑇀 𑇆𑇖𑇑𑇆
𑆄𑆪𑆱𑆳𑆤𑆴 𑆖 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆯𑆬𑆳𑆑𑆳𑆯𑇀𑆖 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆮𑆑𑇀𑆠𑇀𑆫𑆪𑆾𑆫𑇀𑆩𑆶𑆑𑆶𑆬𑆳𑆑𑆳𑆫𑆳 𑆑𑆬𑆳𑆪𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆳 𑇆𑇖𑇒𑇆
𑆃𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆳 𑆠𑆤𑆶𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆱𑆶𑆑𑆸𑆠𑆳 𑆱𑆳𑆣𑆶𑆤𑆴𑆓𑇀𑆫𑆲𑆳 𑇅𑇖𑇓𑇅 𑆐𑆢𑆶𑆩𑇀𑆧𑆫𑇀𑆪𑆯𑇀𑆩𑆘𑆳 𑆮𑆳𑇁𑆥𑆴 𑆯𑆳𑆫𑆵𑆫𑆵 𑆮𑆳 𑆲𑆴𑆠𑆳 𑆨𑆮𑆼𑆠𑇀 𑇆𑇖𑇓𑇆
𑆮𑆳𑆩𑆼𑆤𑆳𑆑𑇀𑆰𑆴 𑆮𑆴𑆤𑆴𑆫𑇀𑆨𑆶𑆘𑇀𑆪 𑆲𑆱𑇀𑆠𑆼𑆤 𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆂 𑇅 𑆯𑆬𑆳𑆑𑆪𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆤 𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀 𑆑𑆳𑆤𑆵𑆤𑆩𑆚𑇀𑆘𑆤𑆩𑇀 𑇆𑇖𑇔𑇆
𑆄𑆥𑆳𑆕𑇀𑆓𑇀𑆪𑆁 𑆮𑆳 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆥𑆴 𑆓𑆠𑆳𑆓𑆠𑆩𑇀 𑇅 𑆮𑆫𑇀𑆠𑇀𑆩𑆾𑆥𑆬𑆼𑆥𑆴 𑆮𑆳 𑆪𑆠𑇀𑆠𑆢𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆽𑆮 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇖𑇕𑇆
𑆃𑆑𑇀𑆰𑆴 𑆤𑆳𑆠𑇀𑆪𑆤𑇀𑆠𑆪𑆾𑆫𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑇀𑆧𑆳𑆣𑆩𑆳𑆤𑆾𑇁𑆥𑆴 𑆮𑆳 𑆨𑆴𑆰𑆑𑇀 𑇅𑇖𑇖𑇅 𑆤 𑆖𑆳𑆤𑆴𑆫𑇀𑆮𑆳𑆤𑇀𑆠𑆢𑆾𑆰𑆼𑇁𑆑𑇀𑆰𑇀𑆟𑆴 𑆣𑆳𑆮𑆤𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇖𑇖𑇆
𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆠𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆂 𑆱𑆤𑇀 𑆲𑆤𑇀𑆪𑆳𑆢𑇀 𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑇀𑆧𑆬𑆁 𑆠𑆡𑆳 𑇅 𑆓𑆠𑆢𑆾𑆰𑆩𑆥𑆼𑆠𑆳𑆯𑇀𑆫𑆶 𑆥𑆯𑇀𑆪𑆼𑆢𑇀𑆪𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑆩𑇀𑆨𑆱𑆳 𑇆𑇖𑇗𑇆
𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪𑆳𑆑𑇀𑆰𑆴 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆚𑇀𑆘𑆤𑆁 𑆠𑆠𑆂 𑇅𑇖𑇘𑇅 𑆯𑇀𑆫𑆩𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆫𑆶𑆢𑆴𑆠𑆩𑆢𑇀𑆪𑆑𑇀𑆫𑆾𑆣𑆨𑆪𑆘𑇀𑆮𑆫𑆽𑆂 𑇆𑇖𑇘𑇆
𑆮𑆼𑆓𑆳𑆔𑆳𑆠𑆯𑆴𑆫𑆾𑆢𑆾𑆰𑆽𑆯𑇀𑆖𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆤𑆼𑆰𑇀𑆪𑆠𑆼𑇁𑆚𑇀𑆘𑆤𑆩𑇀 𑇅 𑆫𑆳𑆓𑆫𑆶𑆑𑇀𑆠𑆴𑆩𑆴𑆫𑆳𑆱𑇀𑆫𑆳𑆮𑆯𑆷𑆬𑆱𑆁𑆫𑆩𑇀𑆨𑆱𑆩𑇀𑆨𑆮𑆳𑆠𑇀 𑇆𑇖𑇙𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆪𑆼 𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑆑𑇀𑆠𑆴𑆁, 𑆥𑇀𑆫𑆮𑆳𑆠𑆼 𑆢𑆸𑆓𑇀𑆧𑆬𑆑𑇀𑆰𑆪𑆩𑇀 𑇅 𑆫𑆘𑆾𑆣𑆷𑆩𑆲𑆠𑆼 𑆫𑆳𑆓𑆱𑇀𑆫𑆳𑆮𑆳𑆣𑆵𑆩𑆤𑇀𑆡𑆱𑆩𑇀𑆨𑆮𑆩𑇀 𑇆𑇗𑇐𑇆
𑆱𑆁𑆫𑆩𑇀𑆨𑆯𑆷𑆬𑆿 𑆤𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆼, 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆴 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆩𑇀 𑇅 𑆯𑆴𑆫𑆂𑆱𑇀𑆤𑆳𑆠𑆼𑇁𑆠𑆴𑆯𑆵𑆠𑆼 𑆖 𑆫𑆮𑆳𑆮𑆤𑆶𑆢𑆴𑆠𑆼𑇁𑆥𑆴 𑆖 𑇆𑇗𑇑𑇆
𑆢𑆾𑆰𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆳𑆢𑆥𑆳𑆫𑇀𑆡𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆁 𑆑𑆫𑆾𑆠𑆴 𑆖 𑇅 𑆃𑆘𑆵𑆫𑇀𑆟𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆩𑆼𑆮 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆾𑆩𑆳𑆫𑇀𑆓𑆳𑆮𑆫𑆾𑆣𑆤𑆳𑆠𑇀 𑇆𑇗𑇒𑇆
𑆢𑆾𑆰𑆮𑆼𑆓𑆾𑆢𑆪𑆼 𑆢𑆠𑇀𑆠𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆫𑆴𑆲𑆫𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑆚𑇀𑆘𑆤𑆁 𑆱𑆳𑆣𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇗𑇓𑇆
𑆬𑆼𑆒𑆤𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆑𑆳𑆬 𑆍𑆰 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇅 𑆮𑇀𑆪𑆳𑆥𑆢𑆯𑇀𑆖 𑆘𑆪𑆼𑆢𑆼𑆠𑆳𑆂 𑆱𑆼𑆑𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆬𑆼𑆥𑆤𑆽𑆂 𑇆𑇗𑇔𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆣𑆷𑆩𑆑𑆮𑆬𑆽𑆫𑇀𑆤𑆱𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆥𑆴 𑆱𑆩𑆶𑆠𑇀𑆡𑆴𑆠𑆳𑆂 𑇅 𑆮𑆴𑆯𑆢𑆁 𑆬𑆔𑇀𑆮𑆤𑆳𑆱𑇀𑆫𑆳𑆮𑆴 𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆛𑆶 𑆱𑆶𑆤𑆴𑆫𑇀𑆩𑆬𑆩𑇀 𑇆𑇗𑇕𑇆
𑆱𑆁𑆯𑆳𑆤𑇀𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆤𑆼𑆠𑇀𑆫𑆁 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆘𑆴𑆲𑇀𑆩𑆁 𑆢𑆳𑆫𑆶𑆟𑆢𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑆁 𑆱𑇀𑆫𑆱𑇀𑆠𑆁 𑆫𑆷𑆑𑇀𑆰𑆩𑆠𑆵𑆮 𑆖 𑇆𑇗𑇖𑇆
𑆤𑆼𑆠𑇀𑆫𑆁 𑆮𑆴𑆫𑆼𑆑𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆱𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆯𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆮𑆴𑆣𑆳𑆤𑆁 𑆖𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆩𑇀 𑇆𑇗𑇗𑇆
𑆃𑆑𑇀𑆰𑆴 𑆩𑆤𑇀𑆢𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆱𑇀𑆪𑆳𑆢𑆶𑆢𑆓𑇀𑆫𑆠𑆫𑆢𑆾𑆰𑆮𑆠𑇀 𑇅 𑆣𑆷𑆩𑆤𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆤𑆽𑆱𑇀𑆠𑆠𑇀𑆫 𑆲𑆴𑆠𑆁 𑆢𑆾𑆰𑆳𑆮𑆱𑆼𑆖𑆤𑆩𑇀 𑇆𑇗𑇘𑇆
𑆱𑇀𑆤𑆼𑆲𑆮𑆫𑇀𑆟𑆧𑆬𑆾𑆥𑆼𑆠𑆁 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆁 𑆢𑆾𑆰𑆮𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇅 𑆘𑇀𑆚𑆼𑆪𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆼 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆼𑇁𑆑𑇀𑆰𑆴 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑆩𑇀 𑇆𑇗𑇙𑇆
𑆑𑆴𑆚𑇀𑆘𑆴𑆢𑇀𑆣𑆵𑆤𑆮𑆴𑆑𑆳𑆫𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆫𑇀𑆥𑆟𑆳𑆢𑇀𑆣𑆴 𑆑𑆸𑆠𑆳𑆢𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆲𑆫𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆨𑆼𑆰𑆘𑆁 𑆯𑆱𑇀𑆪𑆠𑆼 𑆩𑆸𑆢𑆶 𑇆𑇘𑇐𑇆
𑆱𑆳𑆣𑆳𑆫𑆟𑆩𑆥𑆴 𑆘𑇀𑆚𑆼𑆪𑆩𑆼𑆮𑆁 𑆫𑆾𑆥𑆟𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆮𑆢𑆳𑆖𑆰𑇀𑆛𑆼 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆪𑆶𑆑𑇀𑆠𑆼𑇁𑆠𑆴𑆨𑆼𑆰𑆘𑆩𑇀 𑇆𑇘𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆫𑆾𑆥𑆟𑆁 𑆮𑆳𑇁𑆥𑆴 𑆲𑆵𑆤𑆪𑆶𑆑𑇀𑆠𑆩𑆥𑆳𑆫𑇀𑆡𑆑𑆩𑇀 𑇅𑇘𑇒𑇅 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆠𑆱𑇀𑆩𑆳𑆢𑆚𑇀𑆘𑆤𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆴𑆖𑇀𑆗𑆠𑆳 𑇆𑇘𑇒𑇆
𑆥𑆶𑆛𑆥𑆳𑆑𑆑𑇀𑆫𑆴𑆪𑆢𑇀𑆪𑆳𑆱𑆶 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆮𑆼𑆰𑆽(𑆑𑆽)𑆮 𑆑𑆬𑇀𑆥𑆤𑆳 𑇅 𑆱𑆲𑆱𑇀𑆫𑆯𑆯𑇀𑆖𑆳𑆚𑇀𑆘𑆤𑆼𑆰𑆶 𑆧𑆵𑆘𑆼𑆤𑆾𑆑𑇀𑆠𑆼𑆤 𑆥𑆷𑆘𑆴𑆠𑆳𑆂 𑇆𑇘𑇓𑇆
𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑇀𑆧𑆬𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆪𑆳𑆥𑇀𑆪𑆫𑆾𑆓𑆑𑇀𑆰𑆪𑆳𑆪 𑆖 𑇅 𑆫𑆳𑆘𑆳𑆫𑇀𑆲𑆳𑆤𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆓𑇀𑆫𑇀𑆪𑆳𑆟𑆴 𑆤𑆴𑆧𑆾𑆣𑆼𑆩𑆳𑆤𑇀𑆪𑆠𑆂 𑆥𑆫𑆩𑇀 𑇆𑇘𑇔𑇆
𑆃𑆰𑇀𑆛𑆿 𑆨𑆳𑆓𑆳𑆤𑆚𑇀𑆘𑆤𑆱𑇀𑆪 𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆱𑆩𑆠𑇀𑆮𑆴𑆰𑆂 𑇅 𑆐𑆢𑆶𑆩𑇀𑆧𑆫𑆁 𑆯𑆳𑆠𑆑𑆶𑆩𑇀𑆨𑆁 𑆫𑆳𑆘𑆠𑆁 𑆖 𑆱𑆩𑆳𑆱𑆠𑆂 𑇆𑇘𑇕𑇆
𑆍𑆑𑆳𑆢𑆯𑆽𑆠𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆁𑆱𑇀𑆠𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆩𑆷𑆰𑆳𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆁 𑆠𑆢𑆳𑆣𑇀𑆩𑆳𑆠𑆩𑆳𑆮𑆸𑆠𑆁 𑆘𑆳𑆠𑆮𑆼𑆢𑆱𑆴 𑇆𑇘𑇖𑇆
𑆒𑆢𑆴𑆫𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆳𑆕𑇀𑆓𑆳𑆫𑆽𑆫𑇀𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆨𑆴𑆫𑆡𑆳𑆥𑆴 𑆮𑆳 𑇅 𑆓𑆮𑆳𑆁 𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆼 𑆩𑆷𑆠𑇀𑆫𑆼 𑆢𑆣𑇀𑆤𑆴 𑆱𑆫𑇀𑆥𑆴𑆰𑆴 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆼 𑇆𑇘𑇗𑇆
𑆠𑆽𑆬𑆩𑆢𑇀𑆪𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆾𑆢𑆑𑆼𑆰𑆶 𑆖 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆼𑆑𑇀𑆰𑆶𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆼𑆰𑆶 𑆱𑆶𑆲𑆴𑆩𑆼𑆰𑆶 𑆖 𑇆𑇘𑇘𑇆
𑆱𑆳𑆫𑆴𑆮𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼 𑆖 𑆑𑆰𑆳𑆪𑆼 𑆖𑆾𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆑𑆼 𑇅 𑆤𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀 𑆥𑆸𑆡𑆑𑇀 𑆖𑆽𑆤𑆁 𑆣𑇀𑆩𑆳𑆠𑆁 𑆣𑇀𑆩𑆳𑆠𑆁 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆂 𑇆𑇘𑇙𑇆
𑆠𑆠𑆾𑇁𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆼 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆥𑇀𑆬𑆾𑆠𑆧𑆢𑇀𑆣𑆁 𑆱𑇀𑆡𑆴𑆠𑆁 𑆘𑆬𑆼 𑇅 𑆮𑆴𑆯𑆾𑆰𑇀𑆪 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆤𑇀𑆩𑆶𑆑𑇀𑆠𑆳𑆁 𑆱𑇀𑆦𑆛𑆴𑆑𑆁 𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆁 𑆠𑆡𑆳 𑇆𑇙𑇐𑇆
𑆑𑆳𑆬𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆮𑆳𑆁 𑆖𑆳𑆥𑆴 𑆯𑆶𑆖𑆴𑆫𑆳𑆮𑆳𑆥𑇀𑆪 𑆪𑆾𑆓𑆠𑆂 𑇅 𑆍𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆚𑇀𑆘𑆤𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆤𑆴𑆲𑆴𑆠𑆁 𑆨𑆳𑆘𑆤𑆼 𑆯𑆶𑆨𑆼 𑇆𑇙𑇑𑇆
𑆠𑆼𑆤𑆳𑆚𑇀𑆘𑆴𑆠𑆳𑆑𑇀𑆰𑆾 𑆤𑆸𑆥𑆠𑆴𑆫𑇀𑆨𑆮𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆘𑆤𑆥𑇀𑆫𑆴𑆪𑆂 𑇅 𑆃𑆣𑆸𑆰𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑆾𑆓𑆮𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆂 𑇆𑇙𑇓𑇆
𑆑𑆶𑆰𑇀𑆜𑆁 𑆖𑆤𑇀𑆢𑆤𑆩𑆼𑆬𑆳𑆯𑇀𑆖 𑆥𑆠𑇀𑆫𑆁 𑆩𑆣𑆶𑆑𑆩𑆚𑇀𑆘𑆤𑆩𑇀 𑇅 𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆱𑇀𑆪 𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆮𑆑𑇀𑆫𑆁 𑆫𑆠𑇀𑆤𑆳𑆤𑆴 𑆱𑆥𑇀𑆠 𑆖 𑇆𑇙𑇔𑇆
𑆇𑆠𑇀𑆥𑆬𑆱𑇀𑆪 𑆧𑆸𑆲𑆠𑇀𑆪𑆾𑆯𑇀𑆖 𑆥𑆢𑇀𑆩𑆱𑇀𑆪𑆳𑆥𑆴 𑆖 𑆑𑆼𑆯𑆫𑆩𑇀 𑇅 𑆤𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆩𑆶𑆯𑆵𑆫𑆳𑆟𑆴 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆠𑆶𑆠𑇀𑆡𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇙𑇕𑇆
𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆳𑆟𑇀𑆝𑆑𑆥𑆳𑆬𑆳𑆤𑆴 𑆢𑆳𑆫𑇀𑆮𑆵𑆁 𑆥𑆡𑇀𑆪𑆳𑆁 𑆱𑆫𑆾𑆖𑆤𑆳𑆩𑇀 𑇅 𑆩𑆫𑆴𑆖𑆳𑆤𑇀𑆪𑆑𑇀𑆰𑆩𑆘𑇀𑆘𑆳𑆤𑆁 𑆠𑆶𑆬𑇀𑆪𑆳𑆁 𑆖 𑆓𑆸𑆲𑆓𑆾𑆥𑆴𑆑𑆳𑆩𑇀 𑇆𑇙𑇖𑇆
𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆠𑆠𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆤𑇀𑆪𑆱𑆼𑆢𑆨𑇀𑆪𑆫𑇀𑆖𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇅 𑆍𑆠𑆢𑇀𑆨𑆢𑇀𑆫𑆾𑆢𑆪𑆁 𑆤𑆳𑆩 𑆱𑆢𑆽𑆮𑆳𑆫𑇀𑆲𑆠𑆴 𑆨𑆷𑆩𑆴𑆥𑆂 𑇆𑇙𑇗𑇆

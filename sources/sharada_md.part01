𑆱𑆫𑇀𑆮𑆱𑆫𑆳𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑇆𑇖𑇔𑇆
𑆱𑇀𑆦𑆾𑆛𑆽𑆂 𑆱𑆠𑆾𑆢𑆽𑆫𑇀𑆮𑆢𑆤𑆁 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆖𑆴𑆠𑆁 𑆱𑆫𑇀𑆮𑆱𑆫𑆂 𑆱 𑆮𑆳𑆠𑆳𑆠𑇀 𑇅 𑆫𑆑𑇀𑆠𑆽𑆂 𑆱𑆢𑆳𑆲𑆽𑆱𑇀𑆠𑆤𑆶𑆨𑆴𑆂 𑆱𑆥𑆵𑆠𑆽𑆫𑇀𑆪𑆱𑇀𑆪𑆳𑆖𑆴𑆠𑆁 𑆖𑆳𑆥𑆴 𑆱 𑆥𑆴𑆠𑇀𑆠𑆑𑆾𑆥𑆳𑆠𑇀 𑇆𑇖𑇕𑇆
𑆑𑆟𑇀𑆝𑆷𑆪𑆶𑆠𑆽𑆫𑆬𑇀𑆥𑆫𑆶𑆘𑆽𑆂 𑆱𑆮𑆫𑇀𑆟𑆽𑆫𑇀𑆪𑆱𑇀𑆪𑆳𑆖𑆴𑆠𑆁 𑆖𑆳𑆥𑆴 𑆱 𑆮𑆽 𑆑𑆦𑆼𑆤 𑇅 𑆫𑆑𑇀𑆠𑆼𑆤 𑆥𑆴𑆠𑇀𑆠𑆾𑆢𑆴𑆠 𑆍𑆑 𑆍𑆮 𑆑𑆽𑆯𑇀𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆾 𑆩𑆶𑆒𑆥𑆳𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑇆𑇖𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆖𑆴𑆤𑇀𑆠𑆳𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆑𑆳𑆫𑆟𑆩𑆑𑆳𑆫𑆟𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆬𑆑𑇀𑆰𑆟𑆩𑆰𑇀𑆛𑆫𑆷𑆥𑆩𑆒𑆴𑆬𑆱𑇀𑆪 𑆘𑆓𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆲𑆼𑆠𑆶𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆤𑆳𑆩 𑇅 𑆠𑆢𑆼𑆑𑆁 𑆧𑆲𑆷𑆤𑆳𑆁 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆳𑆤𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆱𑆩𑆶𑆢𑇀𑆫 𑆅𑆮𑆿𑆢𑆑𑆳𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑇀 𑇆𑇓𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆳𑆤𑇀𑆩𑆲𑆳𑆤𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆠𑆬𑇀𑆬𑆴𑆕𑇀𑆓 𑆍𑆮 𑇅 𑆠𑆬𑇀𑆬𑆴𑆕𑇀𑆓𑆳𑆖𑇀𑆖 𑆩𑆲𑆠𑆱𑇀𑆠𑆬𑇀𑆬𑆑𑇀𑆰𑆟 𑆍𑆮𑆳𑆲𑆕𑇀𑆑𑆳𑆫 𑆇𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼; 𑆱 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆱𑇀𑆠𑆽𑆘𑆱𑆾 𑆨𑆷𑆠𑆳𑆢𑆴𑆫𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳𑆢𑆲𑆕𑇀𑆑𑆳𑆫𑆳𑆠𑇀𑆠𑆽𑆘𑆱𑆱𑆲𑆳𑆪𑆳𑆠𑇀𑆠𑆬𑇀𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆼𑆮𑆽𑆑𑆳𑆢𑆯𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆠𑇀𑆮𑆑𑇀𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆘𑆴𑆲𑇀𑆮𑆳𑆔𑇀𑆫𑆳𑆟𑆮𑆳𑆓𑇀𑆔𑆱𑇀𑆠𑆾𑆥𑆱𑇀𑆡𑆥𑆳𑆪𑆶𑆥𑆳𑆢𑆩𑆤𑆳𑆁𑆱𑆵𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆴 𑆥𑆚𑇀𑆖 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴, 𑆅𑆠𑆫𑆳𑆟𑆴 𑆥𑆚𑇀𑆖 𑆑𑆫𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴, 𑆇𑆨𑆪𑆳𑆠𑇀𑆩𑆑𑆁 𑆩𑆤𑆂; 𑆨𑆷𑆠𑆳𑆢𑆼𑆫𑆥𑆴 𑆠𑆽𑆘𑆱𑆱𑆲𑆳𑆪𑆳𑆠𑇀𑆠𑆬𑇀𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑆚𑇀𑆖𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼- 𑆯𑆧𑇀𑆢𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆁, 𑆱𑇀𑆥𑆫𑇀𑆯𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆁, 𑆫𑆷𑆥𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆁, 𑆫𑆱𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆁, 𑆓𑆤𑇀𑆣𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆩𑆴𑆠𑆴; 𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆂- 𑆯𑆧𑇀𑆢𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆳𑆂; 𑆠𑆼𑆨𑇀𑆪𑆾 𑆨𑆷𑆠𑆳𑆤𑆴- 𑆮𑇀𑆪𑆾𑆩𑆳𑆤𑆴𑆬𑆳𑆤𑆬𑆘𑆬𑆾𑆫𑇀𑆮𑇀𑆪𑆂; 𑆍𑆮𑆩𑆼𑆰𑆳 𑆠𑆠𑇀𑆠𑇀𑆮𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆯𑆧𑇀𑆢𑆳𑆢𑆪𑆾 𑆮𑆴𑆰𑆪𑆳𑆂; 𑆑𑆫𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆁 𑆮𑆖𑆤𑆳𑆢𑆳𑆤𑆳𑆤𑆤𑇀𑆢𑆮𑆴𑆱𑆫𑇀𑆓𑆮𑆴𑆲𑆫𑆟𑆳𑆤𑆴 𑇆𑇕𑇆
𑆃𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆩𑆲𑆳𑆤𑆲𑆕𑇀𑆑𑆳𑆫𑆂 𑆥𑆚𑇀𑆖𑆠𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆖𑆼𑆠𑇀𑆪𑆰𑇀𑆛𑆿 𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂; 𑆯𑆼𑆰𑆳𑆂 𑆰𑆾𑆝𑆯 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑇆𑇖𑇆
𑆱𑇀𑆮𑆂 𑆱𑇀𑆮𑆯𑇀𑆖𑆽𑆰𑆳𑆁 𑆮𑆴𑆰𑆪𑆾𑇁𑆣𑆴𑆨𑆷𑆠𑆁; 𑆱𑇀𑆮𑆪𑆩𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆩𑇀; 𑆃𑆣𑆴𑆢𑆽𑆮𑆠𑆩𑇀- 𑆃𑆡 𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑇀𑆧𑇀𑆫𑆲𑇀𑆩𑆳, 𑆃𑆲𑆕𑇀𑆑𑆳𑆫𑆱𑇀𑆪𑆼𑆯𑇀𑆮𑆫𑆂, 𑆩𑆤𑆱𑆯𑇀𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆳𑆂, 𑆢𑆴𑆯𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆱𑇀𑆪, 𑆠𑇀𑆮𑆖𑆾 𑆮𑆳𑆪𑆶𑆂, 𑆱𑆷𑆫𑇀𑆪𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆂, 𑆫𑆱𑆤𑆱𑇀𑆪𑆳𑆥𑆂, 𑆥𑆸𑆡𑆴𑆮𑆵 𑆔𑇀𑆫𑆳𑆟𑆱𑇀𑆪, 𑆮𑆳𑆖𑆾𑇁𑆓𑇀𑆤𑆴𑆂, 𑆲𑆱𑇀𑆠𑆪𑆾𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆂, 𑆥𑆳𑆢𑆪𑆾𑆫𑇀𑆮𑆴𑆰𑇀𑆟𑆶𑆂, 𑆥𑆳𑆪𑆾𑆫𑇀𑆩𑆴𑆠𑇀𑆫𑆂, 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆫𑆶𑆥𑆱𑇀𑆡𑆱𑇀𑆪𑆼𑆠𑆴 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆖𑆼𑆠𑆤 𑆍𑆰 𑆮𑆫𑇀𑆓𑆂, 𑆥𑆶𑆫𑆶𑆰𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆠𑆩𑆂 𑆑𑆳𑆫𑇀𑆪𑆑𑆳𑆫𑆟𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆯𑇀𑆖𑆼𑆠𑆪𑆴𑆠𑆳 𑆨𑆮𑆠𑆴 𑇅 𑆱𑆠𑇀𑆪𑆥𑇀𑆪𑆖𑆽𑆠𑆤𑇀𑆪𑆼 𑆥𑇀𑆫𑆣𑆳𑆤𑆱𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆑𑆽𑆮𑆬𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴, 𑆑𑇀𑆰𑆵𑆫𑆳𑆢𑆵𑆁𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆲𑆼𑆠𑆷𑆤𑆶𑆢𑆳𑆲𑆫𑆤𑇀𑆠𑆴 𑇆𑇘𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆥𑆶𑆫𑆶𑆰𑆪𑆾𑆂 𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆮𑆽𑆣𑆫𑇀𑆩𑇀𑆪𑆼 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆇𑆨𑆳𑆮𑆥𑇀𑆪𑆤𑆳𑆢𑆵, 𑆇𑆨𑆳𑆮𑆥𑇀𑆪𑆤𑆤𑇀𑆠𑆿, 𑆇𑆨𑆳𑆮𑆥𑇀𑆪𑆬𑆴𑆕𑇀𑆓𑆿, 𑆇𑆨𑆳𑆮𑆥𑆴 𑆤𑆴𑆠𑇀𑆪𑆿, 𑆇𑆨𑆳𑆮𑆥𑇀𑆪𑆤𑆥𑆫𑆿 , 𑆇𑆨𑆿 𑆖 𑆱𑆫𑇀𑆮𑆓𑆠𑆳𑆮𑆴𑆠𑆴; 𑆍𑆑𑆳 𑆠𑆶 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆖𑆼𑆠𑆤𑆳 𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆳 𑆧𑆵𑆘𑆣𑆫𑇀𑆩𑆴𑆟𑆵 𑆥𑇀𑆫𑆱𑆮𑆣𑆫𑇀𑆩𑆴𑆟𑇀𑆪𑆩𑆣𑇀𑆪𑆱𑇀𑆡𑆣𑆫𑇀𑆩𑆴𑆟𑆵 𑆖𑆼𑆠𑆴, 𑆧𑆲𑆮𑆱𑇀𑆠𑆶 𑆥𑆶𑆫𑆶𑆰𑆳𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆮𑆤𑇀𑆠𑆾𑇁𑆓𑆶𑆟𑆳 𑆃𑆧𑆵𑆘𑆣𑆫𑇀𑆩𑆳𑆟𑆾𑇁𑆥𑇀𑆫𑆱𑆮𑆣𑆫𑇀𑆩𑆳𑆟𑆾 𑆩𑆣𑇀𑆪𑆱𑇀𑆡𑆣𑆫𑇀𑆩𑆳𑆟𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆑𑆳𑆫𑆟𑆳𑆤𑆶𑆫𑆷𑆥𑆁 𑆑𑆳𑆫𑇀𑆪𑆩𑆴𑆠𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑆫𑇀𑆮 𑆍𑆮𑆽𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆩𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑆚𑇀𑆘𑆤𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆤𑇀𑆩𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆠𑆢𑇀𑆓𑆶𑆟𑆳 𑆍𑆮 𑆥𑆶𑆫𑆶𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆵𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼 𑇆𑇑𑇐𑇆
𑆮𑆽𑆢𑇀𑆪𑆑𑆼 𑆠𑆶- 𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆵𑆯𑇀𑆮𑆫𑆁 𑆑𑆳𑆬𑆁 𑆪𑆢𑆸𑆖𑇀𑆗𑆳𑆁 𑆤𑆴𑆪𑆠𑆴𑆁 𑆠𑆡𑆳 𑇅 𑆥𑆫𑆴𑆟𑆳𑆩𑆁 𑆖 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆥𑆸𑆡𑆶𑆢𑆫𑇀𑆯𑆴𑆤𑆂 𑇆𑇑𑇑𑇆
𑆠𑆤𑇀𑆩𑆪𑆳𑆤𑇀𑆪𑆼𑆮 𑆨𑆷𑆠𑆳𑆤𑆴 𑆠𑆢𑇀𑆓𑆶𑆟𑆳𑆤𑇀𑆪𑆼𑆮 𑆖𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆠𑆽𑆯𑇀𑆖 𑆠𑆬𑇀𑆬𑆑𑇀𑆰𑆟𑆂 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆾 𑆨𑆷𑆠𑆓𑇀𑆫𑆳𑆩𑆾 𑆮𑇀𑆪𑆘𑆤𑇀𑆪𑆠 𑇆𑇑𑇒𑇆
𑆠𑆱𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆥𑇀𑆫𑆠𑆴 𑆱𑆫𑇀𑆮𑆢𑆳 𑇅 𑆨𑆷𑆠𑆼𑆨𑇀𑆪𑆾 𑆲𑆴 𑆥𑆫𑆁 𑆪𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆖𑆴𑆤𑇀𑆠𑆳 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑇆𑇑𑇓𑇆
𑆪𑆠𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆁- “𑆠𑆠𑇀𑆱𑆩𑇀𑆨𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑆷𑆲𑆾 𑆨𑆷𑆠𑆳𑆢𑆴𑆫𑆶𑆑𑇀𑆠𑆂” 𑆨𑆿𑆠𑆴𑆑𑆳𑆤𑆴 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆼 𑆮𑆫𑇀𑆟𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆂 𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆁 𑆠𑆶 𑆱𑇀𑆮𑆁 𑆱𑇀𑆮𑆁 𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆴 𑆩𑆳𑆤𑆮𑆂 𑇅 𑆤𑆴𑆪𑆠𑆁 𑆠𑆶𑆬𑇀𑆪𑆪𑆾𑆤𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆳𑆤𑇀𑆪𑆼𑆤𑆳𑆤𑇀𑆪𑆩𑆴𑆠𑆴 𑆱𑇀𑆡𑆴𑆠𑆴𑆂 𑇆𑇑𑇕𑇆
𑆤 𑆖𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆫𑇀𑆮𑆓𑆠𑆳𑆂 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆳 𑆤𑆴𑆠𑇀𑆪𑆳𑆯𑇀𑆖; 𑆃𑆱𑆫𑇀𑆮𑆓𑆠𑆼𑆰𑆶 𑆖 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆼𑆰𑆶 𑆤𑆴𑆠𑇀𑆪𑆥𑆶𑆫𑆶𑆰𑆒𑇀𑆪𑆳𑆥𑆑𑆳𑆤𑇀 𑆲𑆼𑆠𑆷𑆤𑆶𑆢𑆳𑆲𑆫𑆤𑇀𑆠𑆴; 𑆄𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼𑆰𑇀𑆮𑆱𑆫𑇀𑆮𑆓𑆠𑆳𑆂 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆳 𑆤𑆴𑆠𑇀𑆪𑆳𑆯𑇀𑆖, 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆴𑆩𑆳𑆤𑆶𑆰𑆢𑆼𑆮𑆼𑆰𑆶 𑆱𑆚𑇀𑆖𑆫𑆤𑇀𑆠𑆴 𑆣𑆫𑇀𑆩𑆳𑆣𑆫𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁; 𑆠 𑆍𑆠𑆼𑇁𑆤𑆶𑆩𑆳𑆤𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆳𑆂 𑆥𑆫𑆩𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆮𑆤𑇀𑆠𑆂 𑆯𑆳𑆯𑇀𑆮𑆠𑆳 𑆬𑆾𑆲𑆴𑆠𑆫𑆼𑆠𑆱𑆾𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆰𑇀𑆮𑆨𑆴𑆮𑇀𑆪𑆘𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆠𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆁- ‘𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆯𑆫𑆵𑆫𑆴𑆱𑆩𑆮𑆳𑆪𑆂 𑆥𑆶𑆫𑆶𑆰𑆂’ 𑆅𑆠𑆴; 𑆱 𑆍𑆰 𑆑𑆫𑇀𑆩𑆥𑆶𑆫𑆶𑆰𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆣𑆴𑆑𑆸𑆠𑆂 𑇆𑇑𑇖𑇆
𑆠𑆱𑇀𑆪 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆼 𑆅𑆖𑇀𑆗𑆳𑆢𑇀𑆮𑆼𑆰𑆿 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆥𑆳𑆤𑆳𑆮𑆶𑆤𑇀𑆩𑆼𑆰𑆤𑆴𑆩𑆼𑆰𑆿 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆩𑆤𑆂 𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆾 𑆮𑆴𑆖𑆳𑆫𑆟𑆳 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆣𑇀𑆪𑆮𑆱𑆳𑆪𑆾 𑆮𑆴𑆰𑆪𑆾𑆥𑆬𑆧𑇀𑆣𑆴𑆯𑇀𑆖 𑆓𑆶𑆟𑆳𑆂 𑇆𑇑𑇗𑇆
𑆱𑆳𑆠𑇀𑆠𑇀𑆮𑆴𑆑𑆳𑆱𑇀𑆠𑆶- 𑆄𑆤𑆸𑆯𑆁𑆱𑇀𑆪𑆁 𑆱𑆁𑆮𑆴𑆨𑆳𑆓𑆫𑆶𑆖𑆴𑆠𑆳 𑆠𑆴𑆠𑆴𑆑𑇀𑆰𑆳 𑆱𑆠𑇀𑆪𑆁 𑆣𑆫𑇀𑆩 𑆄𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆁 𑆘𑇀𑆚𑆳𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆩𑆼𑆣𑆳 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆣𑆸𑆠𑆴𑆫𑆤𑆨𑆴𑆰𑆕𑇀𑆓𑆯𑇀𑆖; 𑆫𑆳𑆘𑆱𑆳𑆱𑇀𑆠𑆶- 𑆢𑆶𑆂𑆒𑆧𑆲𑆶𑆬𑆠𑆳𑇁𑆛𑆤𑆯𑆵𑆬𑆠𑆳𑇁𑆣𑆸𑆠𑆴𑆫𑆲𑆕𑇀𑆑𑆳𑆫 𑆄𑆤𑆸𑆠𑆴𑆑𑆠𑇀𑆮𑆩𑆑𑆳𑆫𑆶𑆟𑇀𑆪𑆁 𑆢𑆩𑇀𑆨𑆾 𑆩𑆳𑆤𑆾 𑆲𑆫𑇀𑆰𑆂 𑆑𑆳𑆩𑆂 𑆑𑇀𑆫𑆾𑆣𑆯𑇀𑆖; 𑆠𑆳𑆩𑆱𑆳𑆱𑇀𑆠𑆶- 𑆮𑆴𑆰𑆳𑆢𑆴𑆠𑇀𑆮𑆁 𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆩𑆣𑆫𑇀𑆩𑆯𑆵𑆬𑆠𑆳 𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑇀𑆤𑆴𑆫𑆾𑆣𑆾𑇁𑆘𑇀𑆚𑆳𑆤𑆁 𑆢𑆶𑆫𑇀𑆩𑆼𑆣𑆱𑇀𑆠𑇀𑆮𑆩𑆑𑆫𑇀𑆩𑆯𑆵𑆬𑆠𑆳 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆶𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇘𑇆
𑆄𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆳𑆂- 𑆯𑆧𑇀𑆢𑆂 𑆯𑆧𑇀𑆢𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆱𑆫𑇀𑆮𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆱𑆩𑆷𑆲𑆾 𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆠𑆳 𑆖; 𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆱𑇀𑆠𑆶- 𑆱𑇀𑆥𑆫𑇀𑆯𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆱𑆫𑇀𑆮𑆖𑆼𑆰𑇀𑆛𑆳𑆱𑆩𑆷𑆲𑆂 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆁 𑆬𑆔𑆶𑆠𑆳 𑆖; 𑆠𑆽𑆘𑆱𑆳𑆱𑇀𑆠𑆶- 𑆫𑆷𑆥𑆁 𑆫𑆷𑆥𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑆫𑇀𑆟𑆂 𑆱𑆤𑇀𑆠𑆳𑆥𑆾 𑆨𑇀𑆫𑆳𑆘𑆴𑆰𑇀𑆟𑆶𑆠𑆳 𑆥𑆑𑇀𑆠𑆴𑆫𑆩𑆫𑇀𑆰𑆱𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆯𑆿𑆫𑇀𑆪𑆁 𑆖; 𑆄𑆥𑇀𑆪𑆳𑆱𑇀𑆠𑆶- 𑆫𑆱𑆾 𑆫𑆱𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆱𑆫𑇀𑆮𑆢𑇀𑆫𑆮𑆱𑆩𑆷𑆲𑆾 𑆓𑆶𑆫𑆶𑆠𑆳 𑆯𑆽𑆠𑇀𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆾 𑆫𑆼𑆠𑆯𑇀𑆖; 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆱𑇀𑆠𑆶- 𑆓𑆤𑇀𑆣𑆾 𑆓𑆤𑇀𑆣𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆱𑆫𑇀𑆮𑆩𑆷𑆫𑇀𑆠𑆱𑆩𑆷𑆲𑆾 𑆓𑆶𑆫𑆶𑆠𑆳 𑆖𑆼𑆠𑆴 𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆲𑆶𑆬𑆩𑆳𑆑𑆳𑆯𑆁, 𑆫𑆘𑆾𑆧𑆲𑆶𑆬𑆾 𑆮𑆳𑆪𑆶𑆂, 𑆱𑆠𑇀𑆠𑇀𑆮𑆫𑆘𑆾𑆧𑆲𑆶𑆬𑆾𑇁𑆓𑇀𑆤𑆴𑆂, 𑆱𑆠𑇀𑆠𑇀𑆮𑆠𑆩𑆾𑆧𑆲𑆶𑆬𑆳 𑆄𑆥𑆂, 𑆠𑆩𑆾𑆧𑆲𑆶𑆬𑆳 𑆥𑆸𑆡𑆴𑆮𑆵𑆠𑆴 𑇆𑇒𑇐𑇆
𑆯𑇀𑆬𑆾𑆑𑆿 𑆖𑆳𑆠𑇀𑆫 𑆨𑆮𑆠𑆂- 𑆃𑆤𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆳𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆱𑇀𑆮𑆼 𑆱𑇀𑆮𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆠𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆬𑆑𑇀𑆰𑆟𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇒𑇑𑇆
𑆃𑆰𑇀𑆛𑆿 𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆰𑆾𑆝𑆯𑆽𑆮 𑆠𑆶 𑇅 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆯𑇀𑆖 𑆱𑆩𑆳𑆱𑆼𑆤 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆥𑆫𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆾𑆂 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆯𑆶𑆢𑇀𑆣𑆴𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆳𑆠-𑆥𑆴𑆠𑇀𑆠-𑆯𑇀𑆬𑆼𑆰𑇀𑆩-𑆑𑆶𑆟𑆥 -𑆓𑇀𑆫𑆤𑇀𑆡𑆴-𑆥𑆷𑆠𑆴𑆥𑆷𑆪-𑆑𑇀𑆰𑆵𑆟-𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆱𑆂 𑆥𑇀𑆫𑆘𑆾𑆠𑇀𑆥𑆳𑆢𑆤𑆼 𑆤 𑆱𑆩𑆫𑇀𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇆
𑆠𑆼𑆰𑆶 𑆮𑆳𑆠𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆁 𑆮𑆳𑆠𑆼𑆤, 𑆥𑆴𑆠𑇀𑆠𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆼𑆤, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳, 𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑇀𑆪𑆤𑆬𑇀𑆥𑆁 𑆖 𑆫𑆑𑇀𑆠𑆼𑆤, 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆨𑆷𑆠𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆥𑆷𑆠𑆴𑆥𑆷𑆪𑆤𑆴𑆨𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆨𑇀𑆪𑆳𑆁, 𑆑𑇀𑆰𑆵𑆟𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆩𑆳𑆫𑆶𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆓𑆤𑇀𑆣𑆴 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆤𑆼𑆠𑆴 𑇅 𑆠𑆼𑆰𑆶 𑆑𑆶𑆟𑆥𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆥𑆷𑆠𑆴𑆥𑆷𑆪𑆑𑇀𑆰𑆵𑆟𑆫𑆼𑆠𑆱𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆂, 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆱𑆱𑇀𑆠𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆳 𑆅𑆠𑆴 𑇆𑇔𑇆
𑆄𑆫𑇀𑆠𑆮𑆩𑆥𑆴 𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆽𑆂 𑆯𑆾𑆟𑆴𑆠𑆖𑆠𑆶𑆫𑇀𑆡𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆽𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆩𑆧𑆵𑆘𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑆥𑆴 𑆢𑆾𑆰𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆩𑇀 𑇅 𑆠𑆼𑆰𑆶 𑆑𑆶𑆟𑆥𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆥𑆷𑆠𑆴𑆥𑆷𑆪𑆑𑇀𑆰𑆵𑆟𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆥𑇀𑆫𑆑𑆳𑆯𑆩𑆱𑆳𑆣𑇀𑆪𑆁 , 𑆱𑆳𑆣𑇀𑆪𑆩𑆤𑇀𑆪𑆖𑇀𑆖𑆼𑆠𑆴 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆼𑆰𑇀𑆮𑆳𑆢𑇀𑆪𑆳𑆚𑇀 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑇀 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆩𑆠𑆴𑆩𑆳𑆁𑆱𑇀𑆠𑆡𑆳 𑆖𑆾𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂 𑇆𑇖𑇆
𑆥𑆳𑆪𑆪𑆼𑆠 𑆤𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆰𑆑𑇀 𑆑𑆶𑆟𑆥𑆫𑆼𑆠𑆱𑆴 𑇅 𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆒𑆢𑆴𑆫𑆢𑆳𑆝𑆴𑆩𑆳𑆫𑇀𑆘𑆶𑆤𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇆𑇗𑇆
𑆥𑆳𑆪𑆪𑆼𑆢𑆡𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇅 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆨𑆷𑆠𑆼 𑆯𑆛𑆵𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆳𑆬𑆳𑆯𑆼 𑆮𑆳𑇁𑆥𑆴 𑆨𑆱𑇀𑆩𑆤𑆴 𑇆𑇘𑇆
𑆥𑆫𑆷𑆰𑆑𑆮𑆛𑆳𑆢𑆴𑆨𑇀𑆪𑆳𑆁 𑆥𑆷𑆪𑆥𑇀𑆫𑆒𑇀𑆪𑆼 𑆖 𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇅 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆪𑆖𑇀𑆖 𑆠𑆠𑇀 𑆑𑆳𑆫𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆟𑆫𑆼𑆠𑆱𑆴 𑇆𑇙𑇆
𑆮𑆴𑆛𑇀𑆥𑇀𑆫𑆨𑆼 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆾𑆯𑆵𑆫𑆲𑆴𑆕𑇀𑆓𑆶𑆨𑆴𑆂 𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆮𑆳𑆤𑇀𑆠𑆁 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆖 𑆤𑆴𑆫𑆷𑆞𑆩𑆤𑆶𑆮𑆳𑆱𑆴𑆠𑆩𑇀 𑇆𑇑𑇐𑇆
𑆪𑆾𑆘𑆪𑆼𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆳𑆫𑇀𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆤𑆳 𑇅𑇑𑇑𑇅 𑆱𑇀𑆦𑆛𑆴𑆑𑆳𑆨𑆁 𑆢𑇀𑆫𑆮𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆩𑆣𑆶𑆫𑆁 𑆩𑆣𑆶𑆓𑆤𑇀𑆣𑆴 𑆖 𑇆𑇑𑇑𑇆
𑆯𑆶𑆑𑇀𑆫𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴, 𑆑𑆼𑆖𑆴𑆠𑇀𑆠𑆶 𑆠𑆽𑆬𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆤𑆴𑆨𑆁 𑆠𑆡𑆳 𑇅𑇑𑇒𑇅 𑆮𑆴𑆣𑆴𑆩𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑇀𑆪𑆤𑇀𑆠𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆳𑆫𑇀𑆠𑆮𑆯𑆶𑆢𑇀𑆣𑆪𑆼 𑇆𑇑𑇒𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆖𑆠𑆱𑆸𑆰𑇀𑆮𑆳𑆫𑇀𑆠𑆮𑆳𑆫𑇀𑆠𑆴𑆰𑆶 𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆑𑆬𑇀𑆑𑆳𑆤𑇀 𑆥𑆴𑆖𑆷𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆡𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆖𑆩𑆤𑆳𑆤𑆴 𑆖 𑇆𑇑𑇓𑇆
𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆨𑆷𑆠𑆼 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆳𑆜𑆳𑆁 𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆁 𑆮𑆸𑆑𑇀𑆰𑆑𑆳𑆟𑆴 𑆖 𑇅 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆴𑆥𑆷𑆪𑆱𑆕𑇀𑆑𑆳𑆯𑆼 𑆩𑆘𑇀𑆘𑆠𑆶𑆬𑇀𑆪𑆼 𑆠𑆡𑆳𑇁𑇁𑆫𑇀𑆠𑆮𑆼 𑇆𑇑𑇔𑇆
𑆥𑆴𑆧𑆼𑆢𑇀𑆨𑆢𑇀𑆫𑆯𑇀𑆫𑆴𑆪𑆂 𑆑𑇀𑆮𑆳𑆡𑆁 𑆖𑆤𑇀𑆢𑆤𑆑𑇀𑆮𑆳𑆡𑆩𑆼𑆮 𑆖 𑇅 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆲𑆫𑆳𑆟𑆳𑆁 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆮𑆖𑆳𑆫𑆟𑆩𑇀 𑇆𑇑𑇕𑇆
𑆪𑆾𑆓𑆳𑆤𑆳𑆁 𑆯𑆶𑆢𑇀𑆣𑆴𑆑𑆫𑆟𑆁 𑆯𑆼𑆰𑆳𑆱𑇀𑆮𑆥𑇀𑆪𑆳𑆫𑇀𑆠𑆮𑆳𑆫𑇀𑆠𑆴𑆰𑆶 𑇅 𑆃𑆤𑇀𑆤𑆁 𑆯𑆳𑆬𑆴𑆪𑆮𑆁 𑆩𑆢𑇀𑆪𑆁 𑆲𑆴𑆠𑆁 𑆩𑆳𑆁𑆱𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆬𑆩𑇀 𑇆𑇑𑇖𑇆
𑆯𑆯𑆳𑆱𑆸𑆑𑇀𑆥𑇀𑆫𑆠𑆴𑆩𑆁 𑆪𑆠𑇀𑆠𑆶 𑆪𑆢𑇀𑆮𑆳 𑆬𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆾𑆥𑆩𑆩𑇀 𑇅 𑆠𑆢𑆳𑆫𑇀𑆠𑆮𑆁 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆪𑆢𑇀𑆮𑆳𑆱𑆾 𑆤 𑆮𑆴𑆫𑆚𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆠𑆢𑆼𑆮𑆳𑆠𑆴𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆼𑆤 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆩𑆤𑆸𑆠𑆳𑆮𑆥𑆴 𑇅 𑆃𑆱𑆸𑆓𑇀𑆢𑆫𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑆠𑆾𑇁𑆤𑇀𑆪𑆢𑇀𑆫𑆑𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆳𑆠𑇀 𑇆𑇑𑇘𑇆
𑆃𑆱𑆸𑆓𑇀𑆢𑆫𑆾 𑆨𑆮𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆂 𑆱𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆂 𑆱𑆮𑆼𑆢𑆤𑆂 𑇅 𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆿 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆨𑇀𑆫𑆩𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆠𑆩𑆱𑇀𑆠𑆸𑆰𑆳 𑇆𑇑𑇙𑇆
𑆢𑆳𑆲𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑇀𑆮𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆫𑆾𑆓𑆳𑆯𑇀𑆖 𑆮𑆳𑆠𑆘𑆳𑆂 𑇅 𑆠𑆫𑆶𑆟𑇀𑆪𑆳 𑆲𑆴𑆠𑆱𑆼𑆮𑆴𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑆬𑇀𑆥𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆨𑆴𑆰𑆑𑇀 𑇆𑇒𑇐𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆪𑆡𑆳𑆮𑆠𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅    𑆢𑆾𑆰𑆽𑆫𑆳𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆢𑆳𑆫𑇀𑆠𑆮𑆁 𑆤𑆯𑇀𑆪𑆠𑆴 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂 𑇆𑇒𑇑𑇆
𑆑𑇀𑆰𑆵𑆟𑆁 𑆥𑇀𑆫𑆳𑆓𑆵𑆫𑆴𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆱𑆬𑆑𑇀𑆰𑆟𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇅 𑆠𑆡𑆳𑇁𑆥𑇀𑆪𑆠𑇀𑆫 𑆮𑆴𑆣𑆳𑆠𑆮𑇀𑆪𑆁 𑆮𑆴𑆣𑆳𑆤𑆁 𑆤𑆰𑇀𑆛𑆫𑆑𑇀𑆠𑆮𑆠𑇀 𑇆𑇒𑇓𑇆
𑆍𑆮𑆩𑆢𑆶𑆰𑇀𑆛𑆯𑆶𑆑𑇀𑆫𑆂 𑆯𑆶𑆢𑇀𑆣𑆳𑆫𑇀𑆠𑆮𑆳 𑆖 𑇆𑇒𑇔𑇆
𑆉𑆠𑆿 𑆥𑇀𑆫𑆡𑆩𑆢𑆴𑆮𑆱𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑆵 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆚𑇀𑆘𑆤𑆳𑆯𑇀𑆫𑆶𑆥𑆳𑆠𑆱𑇀𑆤𑆳𑆤𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆤𑆒𑆖𑇀𑆗𑆼𑆢𑆤𑆥𑇀𑆫𑆣𑆳𑆮𑆤𑆲𑆱𑆤𑆑𑆡𑆤𑆳𑆠𑆴𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆳𑆮𑆬𑆼𑆒𑆤𑆳𑆤𑆴𑆬𑆳𑆪𑆳𑆱𑆳𑆤𑇀 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁? 𑆢𑆴𑆮𑆳 𑆱𑇀𑆮𑆥𑆤𑇀𑆠𑇀𑆪𑆳𑆂 𑆱𑇀𑆮𑆳𑆥𑆯𑆵𑆬𑆂, 𑆃𑆚𑇀𑆘𑆤𑆳𑆢𑆤𑇀𑆣𑆂, 𑆫𑆾𑆢𑆤𑆳𑆢𑇀𑆮𑆴𑆑𑆸𑆠𑆢𑆸𑆰𑇀𑆛𑆴𑆂, 𑆱𑇀𑆤𑆳𑆤𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆳𑆢𑇀𑆢𑆶𑆂𑆒𑆯𑆵𑆬𑆂 , 𑆠𑆽𑆬𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆵, 𑆤𑆒𑆳𑆥𑆑𑆫𑇀𑆠𑆤𑆳𑆠𑇀 𑆑𑆶𑆤𑆒𑆵, 𑆥𑇀𑆫𑆣𑆳𑆮𑆤𑆳𑆖𑇀𑆖𑆚𑇀𑆖𑆬𑆂, 𑆲𑆱𑆤𑆳𑆖𑇀𑆗𑇀𑆪𑆳𑆮𑆢𑆤𑇀𑆠𑆿𑆰𑇀𑆜𑆠𑆳𑆬𑆶𑆘𑆴𑆲𑇀𑆮𑆂, 𑆥𑇀𑆫𑆬𑆳𑆥𑆵 𑆖𑆳𑆠𑆴𑆑𑆡𑆤𑆳𑆠𑇀 , 𑆃𑆠𑆴𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆳𑆢𑇀𑆧𑆣𑆴𑆫𑆂, 𑆃𑆮𑆬𑆼𑆒𑆤𑆳𑆠𑇀 𑆒𑆬𑆠𑆴𑆂, 𑆩𑆳𑆫𑆶𑆠𑆳𑆪𑆳𑆱𑆱𑆼𑆮𑆤𑆳𑆢𑆶𑆤𑇀𑆩𑆠𑇀𑆠𑆾 𑆓𑆫𑇀𑆨𑆾 𑆨𑆮𑆠𑆵𑆠𑇀𑆪𑆼𑆮𑆩𑆼𑆠𑆳𑆤𑇀 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆢𑆫𑇀𑆨𑆱𑆁𑆱𑇀𑆠𑆫𑆯𑆳𑆪𑆴𑆤𑆵𑆁 𑆑𑆫𑆠𑆬𑆯𑆫𑆳𑆮𑆥𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆠𑆩𑆨𑆾𑆘𑆴𑆤𑆵𑆁 𑆲𑆮𑆴𑆰𑇀𑆪𑆁, 𑆠𑇀𑆫𑇀𑆪𑆲𑆁 𑆖 𑆨𑆫𑇀𑆠𑆶𑆂 𑆱𑆁𑆫𑆑𑇀𑆰𑆼𑆠𑇀 𑇅 𑆠𑆠𑆂 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆤𑆳𑆠𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆡𑆼𑇁𑆲𑆤𑇀𑆪𑆲𑆠𑆮𑆳𑆱𑆂𑆱𑆩𑆬𑆕𑇀𑆑𑆸𑆠𑆳𑆁 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆳𑆁 𑆨𑆫𑇀𑆠𑆳𑆫𑆁 𑆢𑆫𑇀𑆯𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀 𑆑𑆱𑇀𑆪 𑆲𑆼𑆠𑆾𑆂? 𑇆𑇒𑇕𑇆
𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑆯𑇀𑆪𑆼𑆢𑆸𑆠𑆶𑆱𑇀𑆤𑆳𑆠𑆳 𑆪𑆳𑆢𑆸𑆯𑆁 𑆤𑆫𑆩𑆕𑇀𑆓𑆤𑆳 𑇅 𑆠𑆳𑆢𑆸𑆯𑆁 𑆘𑆤𑆪𑆼𑆠𑇀 𑆥𑆶𑆠𑇀𑆫𑆁 𑆨𑆫𑇀𑆠𑆳𑆫𑆁 𑆢𑆫𑇀𑆯𑆪𑆼𑆢𑆠𑆂 𑇆𑇒𑇖𑇆
𑆠𑆠𑆾 𑆮𑆴𑆣𑆳𑆤𑆁 𑆥𑆶𑆠𑇀𑆫𑆵𑆪𑆩𑆶𑆥𑆳𑆣𑇀𑆪𑆳𑆪𑆂 𑆱𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆑𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆼 𑆖 𑆑𑇀𑆫𑆩𑆁 𑆲𑇀𑆪𑆼𑆠𑆩𑆳𑆫𑆨𑆼𑆠 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇆𑇒𑇗𑇆
𑆠𑆠𑆾𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆥𑆶𑆩𑆳𑆤𑇀 𑆩𑆳𑆱𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆵 𑆱𑆫𑇀𑆥𑆴𑆂𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆱𑆫𑇀𑆥𑆴𑆂𑆑𑇀𑆰𑆵𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆁 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆩𑆳𑆱𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑆵𑆁 𑆠𑆽𑆬𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆁 𑆠𑆽𑆬𑆩𑆳𑆰𑆾𑆠𑇀𑆠𑆫𑆳𑆲𑆳𑆫𑆳𑆁 𑆤𑆳𑆫𑆵𑆩𑆶𑆥𑆼𑆪𑆳𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆿 𑆱𑆳𑆩𑆨𑆴𑆫𑆨𑆴𑆮𑆴𑆯𑇀𑆮𑆳𑆱𑇀𑆪 ; 𑆮𑆴𑆑𑆬𑇀𑆥𑇀𑆪𑆽𑆮𑆁 𑆖𑆠𑆶𑆫𑇀𑆡𑇀𑆪𑆳𑆁 𑆰𑆰𑇀𑆜𑇀𑆪𑆳𑆩𑆰𑇀𑆛𑆩𑇀𑆪𑆳𑆁 𑆢𑆯𑆩𑇀𑆪𑆳𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑇀𑆪𑆳𑆁 𑆖𑆾𑆥𑆼𑆪𑆳𑆢𑆴𑆠𑆴 𑆥𑆶𑆠𑇀𑆫𑆑𑆳𑆩𑆂 𑇆𑇒𑇘𑇆
𑆍𑆰𑆷𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆳𑆪𑆶𑆫𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆼𑆮 𑆖 𑇅 𑆥𑇀𑆫𑆘𑆳𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆩𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆁 𑆧𑆬𑆁 𑆖 𑆢𑆴𑆮𑆱𑆼𑆰𑆶 𑆮𑆽 𑇆𑇒𑇙𑇆
𑆃𑆠𑆂 𑆥𑆫𑆁 𑆥𑆚𑇀𑆖𑆩𑇀𑆪𑆳𑆁 𑆱𑆥𑇀𑆠𑆩𑇀𑆪𑆳𑆁 𑆤𑆮𑆩𑇀𑆪𑆳𑆩𑆼𑆑𑆳𑆢𑆯𑇀𑆪𑆳𑆁 𑆖 𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆳𑆩𑆂; 𑆠𑇀𑆫𑆪𑆾𑆢𑆯𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾 𑆤𑆴𑆤𑇀𑆢𑇀𑆪𑆳𑆂 𑇆𑇓𑇐𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆡𑆩𑆼 𑆢𑆴𑆮𑆱𑆼 𑆉𑆠𑆶𑆩𑆠𑇀𑆪𑆳𑆁 𑆩𑆽𑆡𑆶𑆤𑆓𑆩𑆤𑆩𑆤𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆥𑆶𑆁𑆱𑆳𑆁 𑆨𑆮𑆠𑆴, 𑆪𑆯𑇀𑆖 𑆠𑆠𑇀𑆫𑆳𑆣𑆵𑆪𑆠𑆼 𑆓𑆫𑇀𑆨𑆂 𑆱 𑆥𑇀𑆫𑆱𑆮𑆩𑆳𑆤𑆾 𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆼 ; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆸𑆲𑆼 𑆮𑆳; 𑆠𑆸𑆠𑆵𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆩𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆳𑆕𑇀𑆓𑆾𑇁𑆬𑇀𑆥𑆳𑆪𑆶𑆫𑇀𑆮𑆳 𑆨𑆮𑆠𑆴; 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆠𑆶 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆳𑆕𑇀𑆓𑆾 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇅 𑆤 𑆖 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆼 𑆫𑆑𑇀𑆠𑆼 𑆧𑆵𑆘𑆁 𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆁 𑆓𑆶𑆟𑆑𑆫𑆁 𑆨𑆮𑆠𑆴, 𑆪𑆡𑆳 𑆤𑆢𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆱𑇀𑆫𑆾𑆠𑆂 𑆥𑇀𑆬𑆳𑆮𑆴𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆁 𑆥𑇀𑆫𑆠𑆴𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆁 𑆓𑆖𑇀𑆗𑆠𑆴 𑆠𑆢𑇀𑆮𑆢𑆼𑆠𑆢𑇀𑆢𑇀𑆫𑆰𑇀𑆛𑆮𑇀𑆪𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆪𑆩𑆮𑆠𑆵𑆁 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆩𑆳𑆱𑆳𑆢𑆶𑆥𑆼𑆪𑆳𑆠𑇀 𑇆𑇓𑇑𑇆
𑆬𑆧𑇀𑆣𑆓𑆫𑇀𑆨𑆳𑆪𑆳𑆯𑇀𑆖𑆽𑆠𑆼𑆰𑇀𑆮𑆲𑆂𑆱𑆶 𑆬𑆑𑇀𑆰𑇀𑆩𑆟𑆳𑆮𑆛𑆯𑆶𑆕𑇀𑆓𑆱𑆲𑆢𑆼𑆮𑆳𑆮𑆴𑆯𑇀𑆮𑆢𑆼𑆮𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆳𑆨𑆴𑆰𑆶𑆠𑇀𑆪 𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾 𑆮𑆳 𑆧𑆴𑆤𑇀𑆢𑆷𑆤𑇀 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆑𑇀𑆰𑆴𑆟𑆼 𑆤𑆳𑆱𑆳𑆥𑆶𑆛𑆼 𑆥𑆶𑆠𑇀𑆫𑆑𑆳𑆩𑆳𑆪𑆽 , 𑆤 𑆖 𑆠𑆳𑆤𑇀𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆼𑆠𑇀 𑇆𑇓𑇒𑇆
𑆣𑇀𑆫𑆶𑆮𑆁 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆣𑇀𑆪𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆣𑆴𑆥𑆷𑆫𑇀𑆮𑆑𑆩𑇀 𑇅 𑆉𑆠𑆶𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆳𑆩𑇀𑆧𑆶𑆧𑆵𑆘𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆓𑇀𑆫𑇀𑆪𑆳𑆢𑆕𑇀𑆑𑆶𑆫𑆾 𑆪𑆡𑆳 𑇆𑇓𑇓𑇆
𑆍𑆮𑆁 𑆘𑆳𑆠𑆳 𑆫𑆷𑆥𑆮𑆤𑇀𑆠𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆤𑇀𑆠𑆯𑇀𑆖𑆴𑆫𑆳𑆪𑆶𑆰𑆂 𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆸𑆟𑆱𑇀𑆪 𑆩𑆾𑆑𑇀𑆠𑆳𑆫𑆂 𑆱𑆠𑇀𑆥𑆶𑆠𑇀𑆫𑆳𑆂 𑆥𑆶𑆠𑇀𑆫𑆴𑆟𑆼 𑆲𑆴𑆠𑆳𑆂 𑇆𑇓𑇔𑇆
𑆠𑆠𑇀𑆫 𑆠𑆼𑆘𑆾𑆣𑆳𑆠𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆨𑆮𑆂, 𑆱 𑆪𑆢𑆳 𑆓𑆫𑇀𑆨𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆳𑆮𑆧𑇀𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆾 𑆨𑆮𑆠𑆴 𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆁 𑆓𑆿𑆫𑆁 𑆑𑆫𑆾𑆠𑆴, 𑆥𑆸𑆡𑆴𑆮𑆵𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆸𑆰𑇀𑆟𑆁, 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆑𑆳𑆯𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆸𑆰𑇀𑆟𑆯𑇀𑆪𑆳𑆩𑆁, 𑆠𑆾𑆪𑆳𑆑𑆳𑆯𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆾 𑆓𑆿𑆫𑆯𑇀𑆪𑆳𑆩𑆩𑇀 𑇅 ‘𑆪𑆳𑆢𑆸𑆓𑇀𑆮𑆫𑇀𑆟𑆩𑆳𑆲𑆳𑆫𑆩𑆶𑆥𑆱𑆼𑆮𑆠𑆼 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆠𑆳𑆢𑆸𑆓𑇀𑆮𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑆮𑆳 𑆨𑆮𑆠𑆴’ 𑆅𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼 𑇅 𑆠𑆠𑇀𑆫 𑆢𑆸𑆰𑇀𑆛𑆴𑆨𑆳𑆓𑆩𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆁 𑆠𑆼𑆘𑆾 𑆘𑆳𑆠𑇀𑆪𑆤𑇀𑆣𑆁 𑆑𑆫𑆾𑆠𑆴, 𑆠𑆢𑆼𑆮 𑆫𑆑𑇀𑆠𑆳𑆤𑆶𑆓𑆠𑆁 𑆫𑆑𑇀𑆠𑆳𑆑𑇀𑆰𑆁, 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆶𑆓𑆠𑆁 𑆥𑆴𑆕𑇀𑆓𑆳𑆑𑇀𑆰𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆤𑆶𑆓𑆠𑆁 𑆯𑆶𑆑𑇀𑆬𑆳𑆑𑇀𑆰𑆁, 𑆮𑆳𑆠𑆳𑆤𑆶𑆓𑆠𑆁 𑆮𑆴𑆑𑆸𑆠𑆳𑆑𑇀𑆰𑆩𑆴𑆠𑆴 𑇆𑇓𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆔𑆸𑆠𑆥𑆴𑆟𑇀𑆝𑆾 𑆪𑆡𑆽𑆮𑆳𑆓𑇀𑆤𑆴𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆬𑆵𑆪𑆠𑆼 𑇅 𑆮𑆴𑆱𑆫𑇀𑆥𑆠𑇀𑆪𑆳𑆫𑇀𑆠𑆮𑆁 𑆤𑆳𑆫𑇀𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑆥𑆶𑆁𑆱𑆳𑆁 𑆱𑆩𑆳𑆓𑆩𑆼 𑇆𑇓𑇖𑇆
𑆧𑆵𑆘𑆼𑇁𑆤𑇀𑆠𑆫𑇀𑆮𑆳𑆪𑆶𑆤𑆳 𑆨𑆴𑆤𑇀𑆤𑆼 𑆢𑇀𑆮𑆿 𑆘𑆵𑆮𑆿 𑆑𑆶𑆑𑇀𑆰𑆴𑆩𑆳𑆓𑆠𑆿 𑇅 𑆪𑆩𑆳𑆮𑆴𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆼𑆠𑆼 𑆣𑆫𑇀𑆩𑆼𑆠𑆫𑆥𑆶𑆫𑆂𑆱𑆫𑆿 𑇆𑇓𑇗𑇆
𑆥𑆴𑆠𑇀𑆫𑆾𑆫𑆠𑇀𑆪𑆬𑇀𑆥𑆧𑆵𑆘𑆠𑇀𑆮𑆳𑆢𑆳𑆱𑆼𑆑𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆱 𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆳𑆯𑇀𑆪 𑆬𑆨𑆠𑆼 𑆣𑇀𑆮𑆘𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆩𑆱𑆁𑆯𑆪𑆩𑇀 𑇆𑇓𑇘𑇆
𑆪𑆂 𑆥𑆷𑆠𑆴𑆪𑆾𑆤𑆿 𑆘𑆳𑆪𑆼𑆠 𑆱 𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇅 𑆱 𑆪𑆾𑆤𑆴𑆯𑆼𑆦𑆱𑆾𑆫𑇀𑆓𑆤𑇀𑆣𑆩𑆳𑆔𑇀𑆫𑆳𑆪 𑆬𑆨𑆠𑆼 𑆧𑆬𑆩𑇀 𑇆𑇓𑇙𑇆
𑆱𑇀𑆮𑆼 𑆓𑆶𑆢𑆼𑇁𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆳𑆢𑇀𑆪𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆥𑆶𑆁𑆮𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆑𑆶𑆩𑇀𑆨𑆵𑆑𑆂 𑆱 𑆠𑆶 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂.....𑆆𑆫𑇀𑆰𑇀𑆪𑆑𑆁 𑆯𑆸𑆟𑆶 𑆖𑆳𑆥𑆫𑆩𑇀 𑇆𑇔𑇐𑇆
𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆮𑇀𑆪𑆮𑆳𑆪𑆩𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆼 𑆪𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆆𑆫𑇀𑆰𑇀𑆪𑆑𑆂 𑆱 𑆠𑆶 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂,......𑆰𑆟𑇀𑆞𑆑𑆁 𑆯𑆸𑆟𑆶 𑆥𑆚𑇀𑆖𑆩𑆩𑇀 𑇆𑇔𑇑𑇆
𑆪𑆾 𑆨𑆳𑆫𑇀𑆪𑆳𑆪𑆳𑆩𑆸𑆠𑆿 𑆩𑆾𑆲𑆳𑆢𑆕𑇀𑆓𑆤𑆼𑆮 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆠𑆠𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆳𑆑𑆳𑆫𑆾 𑆘𑆳𑆪𑆠𑆼 𑆰𑆟𑇀𑆞𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇆𑇔𑇒𑇆
𑆉𑆠𑆿 𑆥𑆶𑆫𑆶𑆰𑆮𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆼𑆠𑆳𑆕𑇀𑆓𑆤𑆳 𑆪𑆢𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆑𑆤𑇀𑆪𑆳 𑆪𑆢𑆴 𑆨𑆮𑆼𑆠𑇀 𑆱𑆳 𑆨𑆮𑆼𑆤𑇀𑆤𑆫𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆳 𑇆𑇔𑇓𑇆
𑆄𑆱𑆼𑆑𑇀𑆪𑆯𑇀𑆖 𑆱𑆶𑆓𑆤𑇀𑆣𑆵 𑆖 𑆑𑆶𑆩𑇀𑆨𑆵𑆑𑆯𑇀𑆖𑆼𑆫𑇀𑆰𑇀𑆪𑆑𑆱𑇀𑆠𑆡𑆳 𑇅 𑆱𑆫𑆼𑆠𑆱𑆱𑇀𑆠𑇀𑆮𑆩𑆵 𑆘𑇀𑆚𑆼𑆪𑆳 𑆃𑆯𑆶𑆑𑇀𑆫𑆂 𑆰𑆟𑇀𑆞𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇆𑇔𑇔𑇆
𑆃𑆤𑆪𑆳 𑆮𑆴𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆠𑆶 𑆠𑆼𑆰𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑇅 𑆲𑆫𑇀𑆰𑆳𑆠𑇀 𑆱𑇀𑆦𑆶𑆛𑆠𑇀𑆮𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆣𑇀𑆮𑆘𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆱𑇀𑆠𑆠𑆾 𑆨𑆮𑆼𑆠𑇀 𑇆𑇔𑇕𑇆
𑆄𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆖𑆼𑆰𑇀𑆛𑆳𑆨𑆴𑆫𑇀𑆪𑆳𑆢𑆸𑆯𑆵𑆨𑆴𑆂 𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆿 𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆿 𑆱𑆩𑆶𑆥𑆼𑆪𑆳𑆠𑆳𑆁 𑆠𑆪𑆾𑆂 𑆥𑆶𑆠𑇀𑆫𑆾𑇁𑆥𑆴 𑆠𑆳𑆢𑆸𑆯𑆂 𑇆𑇔𑇖𑇆
𑆪𑆢𑆳 𑆤𑆳𑆫𑇀𑆪𑆳𑆮𑆶𑆥𑆼𑆪𑆳𑆠𑆳𑆁 𑆮𑆸𑆰𑆱𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆿 𑆑𑆡𑆚𑇀𑆖𑆤 𑇅 𑆩𑆶𑆚𑇀𑆖𑆠𑆂 𑆯𑆶𑆑𑇀𑆫𑆩𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆩𑆤𑆱𑇀𑆡𑆴𑆱𑇀𑆠𑆠𑇀𑆫 𑆘𑆳𑆪𑆠𑆼 𑇆𑇔𑇗𑇆
𑆉𑆠𑆶𑆱𑇀𑆤𑆳𑆠𑆳 𑆠𑆶 𑆪𑆳 𑆤𑆳𑆫𑆵 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆩𑆽𑆡𑆶𑆤𑆩𑆳𑆮𑆲𑆼𑆠𑇀 𑇅 𑆄𑆫𑇀𑆠𑆮𑆁 𑆮𑆳𑆪𑆶𑆫𑆳𑆢𑆳𑆪 𑆑𑆶𑆑𑇀𑆰𑆿 𑆓𑆫𑇀𑆨𑆁 𑆑𑆫𑆾𑆠𑆴 𑆲𑆴 𑇆𑇔𑇘𑇆
𑆩𑆳𑆱𑆴 𑆩𑆳𑆱𑆴 𑆮𑆴𑆮𑆫𑇀𑆣𑆼𑆠 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆑𑆬𑆬𑆁 𑆘𑆳𑆪𑆠𑆼 𑆠𑆱𑇀𑆪𑆳 𑆮𑆫𑇀𑆘𑆴𑆠𑆁 𑆥𑆽𑆠𑆸𑆑𑆽𑆫𑇀𑆓𑆶𑆟𑆽𑆂 𑇆𑇔𑇙𑇆
𑆱𑆫𑇀𑆥𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆑𑆷𑆰𑇀𑆩𑆳𑆟𑇀𑆝𑆮𑆴𑆑𑆸𑆠𑆳𑆑𑆸𑆠𑆪𑆯𑇀𑆖 𑆪𑆼 𑇅 𑆓𑆫𑇀𑆨𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆼 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖𑆽𑆮 𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑆳𑆥𑆑𑆸𑆠𑆾 𑆨𑆸𑆯𑆩𑇀 𑇆𑇕𑇐𑇆
𑆓𑆫𑇀𑆨𑆾 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆼𑆟 𑆢𑆿𑆲𑆸𑆢𑆼 𑆮𑆳𑇁𑆮𑆩𑆳𑆤𑆴𑆠𑆼 𑇅 𑆨𑆮𑆼𑆠𑇀 𑆑𑆶𑆧𑇀𑆘𑆂 𑆑𑆶𑆟𑆴𑆂 𑆥𑆕𑇀𑆓𑆶𑆫𑇀𑆩𑆷𑆑𑆾 𑆩𑆴𑆤𑇀𑆩𑆴𑆟 𑆍𑆮 𑆮𑆳 𑇆𑇕𑇑𑇆
𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑇀𑆫𑆾𑆱𑇀𑆠𑆶 𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆳𑆢𑆯𑆶𑆨𑆽𑆯𑇀𑆖 𑆥𑆶𑆫𑆳𑆑𑆸𑆠𑆽𑆂 𑇅 𑆮𑆳𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆼𑆟 𑆓𑆫𑇀𑆨𑆾 𑆮𑆽𑆑𑆸𑆠𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇆𑇕𑇒𑇆
𑆩𑆬𑆳𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆢𑆪𑆾𑆓𑆳𑆖𑇀𑆖 𑆮𑆳𑆪𑆾𑆂 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆪 𑆖 𑇅 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆤 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆂 𑆑𑆫𑆾𑆠𑆴 𑆲𑆴 𑇆𑇕𑇓𑇆
𑆘𑆫𑆳𑆪𑆶𑆟𑆳 𑆩𑆶𑆒𑆼 𑆖𑇀𑆗𑆤𑇀𑆤𑆼 𑆑𑆟𑇀𑆜𑆼 𑆖 𑆑𑆦𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆼 𑇅 𑆮𑆳𑆪𑆾𑆫𑇀𑆩𑆳𑆫𑇀𑆓𑆤𑆴𑆫𑆾𑆣𑆳𑆖𑇀𑆖 𑆤 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆂 𑆥𑇀𑆫𑆫𑆾𑆢𑆴𑆠𑆴 𑇆𑇕𑇔𑇆
𑆤𑆴𑆂𑆯𑇀𑆮𑆳𑆱𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆤𑇀 𑆓𑆫𑇀𑆨𑆾𑇁𑆣𑆴𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆩𑆳𑆠𑆶𑆫𑇀𑆤𑆴𑆯𑇀𑆮𑆱𑆴𑆠𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆩𑇀𑆨𑆮𑆳𑆤𑇀 𑇆𑇕𑇕𑇆
𑆱𑆤𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆯𑆫𑆵𑆫𑆳𑆟𑆳𑆁 𑆢𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆥𑆠𑆤𑆾𑆢𑇀𑆨𑆮𑆿 𑇅 𑆠𑆬𑆼𑆰𑇀𑆮𑆱𑆩𑇀𑆨𑆮𑆾 𑆪𑆯𑇀𑆖 𑆫𑆾𑆩𑇀𑆟𑆳𑆩𑆼𑆠𑆠𑇀 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂 𑇆𑇕𑇖𑇆
𑆨𑆳𑆮𑆴𑆠𑆳𑆂 𑆥𑆷𑆫𑇀𑆮𑆢𑆼𑆲𑆼𑆰𑆶 𑆱𑆠𑆠𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆧𑆶𑆢𑇀𑆣𑆪𑆂 𑇅 𑆨𑆮𑆤𑇀𑆠𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆂 𑆥𑆷𑆫𑇀𑆮𑆘𑆳𑆠𑆴𑆱𑇀𑆩𑆫𑆳 𑆤𑆫𑆳𑆂 𑇆𑇕𑇗𑇆
𑆑𑆫𑇀𑆩𑆟𑆳 𑆖𑆾𑆢𑆴𑆠𑆾 𑆪𑆼𑆤 𑆠𑆢𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆼 𑇅 𑆃𑆨𑇀𑆪𑆱𑇀𑆠𑆳𑆂 𑆥𑆷𑆫𑇀𑆮𑆢𑆼𑆲𑆼 𑆪𑆼 𑆠𑆳𑆤𑆼𑆮 𑆨𑆘𑆠𑆼 𑆓𑆶𑆟𑆳𑆤𑇀 𑇆𑇕𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆓𑆫𑇀𑆨𑆳𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆿𑆩𑇀𑆪𑆁 𑆯𑆶𑆑𑇀𑆫𑆩𑆳𑆫𑇀𑆠𑆮𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆩𑆴𑆠𑆫𑆼𑆰𑆳𑆩𑆥𑇀𑆪𑆠𑇀𑆫 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆣𑇀𑆪𑆩𑆱𑇀𑆠𑇀𑆪𑆟𑆶𑆤𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟, 𑆥𑆫𑆱𑇀𑆥𑆫𑆾𑆥𑆑𑆳𑆫𑆳𑆠𑇀 (𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆠𑇀,) 𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆤𑆶𑆥𑇀𑆫𑆮𑆼𑆯𑆳𑆖𑇀𑆖 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆪𑆾𑆂 𑆱𑆁𑆪𑆾𑆓𑆼 𑆠𑆼𑆘𑆂 𑆯𑆫𑆵𑆫𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑆶𑆢𑆵𑆫𑆪𑆠𑆴, 𑆠𑆠𑆱𑇀𑆠𑆼𑆘𑆾𑆤𑆴𑆬𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆁 𑆖𑇀𑆪𑆶𑆠𑆁 𑆪𑆾𑆤𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆠𑆼 𑆖𑆳𑆫𑇀𑆠𑆮𑆼𑆤, 𑆠𑆠𑆾𑇁𑆓𑇀𑆤𑆵𑆰𑆾𑆩𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆩𑆳𑆤𑆾 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆘𑇀𑆚𑆾 𑆮𑆼𑆢𑆪𑆴𑆠𑆳 𑆱𑇀𑆥𑇀𑆫𑆰𑇀𑆛𑆳 𑆔𑇀𑆫𑆳𑆠𑆳 𑆢𑇀𑆫𑆰𑇀𑆛𑆳 𑆯𑇀𑆫𑆾𑆠𑆳 𑆫𑆱𑆪𑆴𑆠𑆳 𑆥𑆶𑆫𑆶𑆰𑆂 𑆱𑇀𑆫𑆰𑇀𑆛𑆳 𑆓𑆤𑇀𑆠𑆳 𑆱𑆳𑆑𑇀𑆰𑆵 𑆣𑆳𑆠𑆳 𑆮𑆑𑇀𑆠𑆳 𑆪𑆂 𑆑𑆾𑇁𑆱𑆳𑆮𑆴𑆠𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑆫𑇀𑆪𑆳𑆪𑆮𑆳𑆖𑆑𑆽𑆫𑇀𑆤𑆳𑆩𑆨𑆴𑆫𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑆢𑆽𑆮𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑆑𑇀𑆰𑆪𑆾𑇁𑆮𑇀𑆪𑆪𑆾𑇁𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆾 𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆤𑆳 𑆱𑆲𑆳𑆤𑇀𑆮𑆑𑇀𑆰𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆨𑆴𑆫𑇀𑆢𑆽𑆮𑆳𑆱𑆶𑆫𑆽𑆫𑆥𑆫𑆽𑆯𑇀𑆖 𑆨𑆳𑆮𑆽𑆫𑇀𑆮𑆳𑆪𑆶𑆤𑆳𑇁𑆨𑆴𑆥𑇀𑆫𑆼𑆫𑇀𑆪𑆩𑆳𑆟𑆾 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑆶𑆑𑇀𑆫𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆥𑆶𑆩𑆳𑆤𑇀, 𑆄𑆫𑇀𑆠𑆮𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆵, 𑆱𑆳𑆩𑇀𑆪𑆳𑆢𑆶𑆨𑆪𑆾𑆫𑇀𑆤𑆥𑆶𑆁𑆱𑆑𑆩𑆴𑆠𑆴 𑇆𑇕𑇆
𑆉𑆠𑆶𑆱𑇀𑆠𑆶 𑆢𑇀𑆮𑆳𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 𑆨𑆮𑆠𑆴 𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆠𑆮𑆂; 𑆃𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆠𑆮𑆳𑇁𑆥𑇀𑆪𑆱𑇀𑆠𑆵𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼 𑇆𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆵𑆤𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆮𑆢𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆠𑇀𑆩𑆩𑆶𑆒𑆢𑇀𑆮𑆴𑆘𑆳𑆩𑇀 𑇅 𑆤𑆫𑆑𑆳𑆩𑆳𑆁 𑆥𑇀𑆫𑆴𑆪𑆑𑆡𑆳𑆁 𑆱𑇀𑆫𑆱𑇀𑆠𑆑𑆶𑆑𑇀𑆰𑇀𑆪𑆑𑇀𑆰𑆴𑆩𑆷𑆫𑇀𑆣𑆘𑆳𑆩𑇀 𑇆𑇗𑇆
𑆱𑇀𑆦𑆶𑆫𑆢𑇀𑆨𑆶𑆘𑆑𑆶𑆖𑆯𑇀𑆫𑆾𑆟𑆴𑆤𑆳𑆨𑇀𑆪𑆷𑆫𑆶𑆘𑆔𑆤𑆱𑇀𑆦𑆴𑆖𑆳𑆩𑇀 𑇅 𑆲𑆫𑇀𑆰𑆿𑆠𑇀𑆱𑆶𑆑𑇀𑆪𑆥𑆫𑆳𑆁 𑆖𑆳𑆥𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆸𑆠𑆶𑆩𑆠𑆵𑆩𑆴𑆠𑆴 𑇆𑇘𑇆
𑆤𑆴𑆪𑆠𑆁 𑆢𑆴𑆮𑆱𑆼𑇁𑆠𑆵𑆠𑆼 𑆱𑆕𑇀𑆑𑆶𑆖𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆘𑆁 𑆪𑆡𑆳 𑇅 𑆉𑆠𑆿 𑆮𑇀𑆪𑆠𑆵𑆠𑆼 𑆤𑆳𑆫𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆪𑆾𑆤𑆴𑆂 𑆱𑆁𑆮𑇀𑆫𑆴𑆪𑆠𑆼 𑆠𑆡𑆳 𑇆𑇙𑇆
𑆩𑆳𑆱𑆼𑆤𑆾𑆥𑆖𑆴𑆠𑆁 𑆑𑆳𑆬𑆼 𑆣𑆩𑆤𑆵𑆨𑇀𑆪𑆳𑆁 𑆠𑆢𑆳𑆫𑇀𑆠𑆮𑆩𑇀 𑇅 𑆆𑆰𑆠𑇀𑆑𑆸𑆰𑇀𑆟𑆁 𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆖 𑆮𑆳𑆪𑆶𑆫𑇀𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆤𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆠𑆢𑇀𑆮𑆫𑇀𑆰𑆳𑆢𑇀𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆠𑇀 𑆑𑆳𑆬𑆼 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆩𑆱𑆸𑆑𑇀 𑆥𑆶𑆤𑆂 𑇅 𑆘𑆫𑆳𑆥𑆑𑇀𑆮𑆯𑆫𑆵𑆫𑆳𑆟𑆳𑆁 𑆪𑆳𑆠𑆴 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑆂 𑆑𑇀𑆰𑆪𑆩𑇀 𑇆𑇑𑇑𑇆
𑆪𑆶𑆓𑇀𑆩𑆼𑆰𑆶 𑆠𑆶 𑆥𑆶𑆩𑆳𑆤𑇀 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾 𑆢𑆴𑆮𑆱𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆡𑆳𑇁𑆧𑆬𑆳 𑇅 𑆥𑆶𑆰𑇀𑆥𑆑𑆳𑆬𑆼 𑆯𑆶𑆖𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆥𑆠𑇀𑆪𑆳𑆫𑇀𑆡𑆾 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆁 𑆮𑇀𑆫𑆘𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆾𑆓𑆸𑆲𑆵𑆠𑆓𑆫𑇀𑆨𑆳𑆪𑆳 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴- 𑆯𑇀𑆫𑆩𑆾 𑆓𑇀𑆬𑆳𑆤𑆴𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆱𑆑𑇀𑆡𑆴𑆱𑆢𑆤𑆁 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆪𑆾𑆫𑆮𑆧𑆤𑇀𑆣𑆂 𑆱𑇀𑆦𑆶𑆫𑆟𑆁 𑆖 𑆪𑆾𑆤𑆼𑆂 𑇆𑇑𑇓𑇆
𑆱𑇀𑆠𑆤𑆪𑆾𑆂 𑆑𑆸𑆰𑇀𑆟𑆩𑆶𑆒𑆠𑆳 𑆫𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆶𑆢𑇀𑆓𑆩𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆑𑇀𑆰𑆴𑆥𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆴 𑆖𑆳𑆥𑇀𑆪𑆱𑇀𑆪𑆳𑆂 𑆱𑆩𑇀𑆩𑆵𑆬𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇔𑇆
𑆃𑆑𑆳𑆩𑆠𑆯𑇀𑆗𑆫𑇀𑆢𑆪𑆠𑆴 𑆓𑆤𑇀𑆣𑆳𑆢𑆶𑆢𑇀𑆮𑆴𑆘𑆠𑆼 𑆯𑆶𑆨𑆳𑆠𑇀 𑇅 𑆥𑇀𑆫𑆱𑆼𑆑𑆂 𑆱𑆢𑆤𑆁 𑆖𑆳𑆥𑆴 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆬𑆴𑆕𑇀𑆓𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇕𑇆
𑆠𑆢𑆳 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆮𑇀𑆪𑆮𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆩𑆠𑆴𑆠𑆫𑇀𑆥𑆟𑆩𑆠𑆴𑆑𑆫𑇀𑆯𑆤𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆫𑆳𑆠𑇀𑆫𑆴𑆘𑆳𑆓𑆫𑆟𑆁 𑆯𑆾𑆑𑆁 𑆪𑆳𑆤𑆳𑆫𑆾𑆲𑆟𑆁 𑆨𑆪𑆩𑆶𑆠𑇀𑆑𑆶𑆛𑆶𑆑𑆳𑆱𑆤𑆁 𑆖𑆽𑆑𑆳𑆤𑇀𑆠𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆯𑆾𑆟𑆴𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆁 𑆖𑆳𑆑𑆳𑆬𑆼 𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆟𑆁 𑆖 𑆤 𑆱𑆼𑆮𑆼𑆠 𑇆𑇑𑇖𑇆
𑆢𑆾𑆰𑆳𑆨𑆴𑆔𑆳𑆠𑆽𑆫𑇀𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆪𑆾 𑆪𑆾 𑆨𑆳𑆓𑆂 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑇅 𑆱 𑆱 𑆨𑆳𑆓𑆂 𑆯𑆴𑆯𑆾𑆱𑇀𑆠𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆱𑇀𑆪 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆡𑆩𑆼 𑆩𑆳𑆱𑆴 𑆑𑆬𑆬𑆁 𑆘𑆳𑆪𑆠𑆼; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆯𑆵𑆠𑆾𑆰𑇀𑆩𑆳𑆤𑆴𑆬𑆽𑆫𑆨𑆴𑆥𑇀𑆫𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆩𑆲𑆳𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆱𑆕𑇀𑆔𑆳𑆠𑆾 𑆔𑆤𑆂 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼, 𑆪𑆢𑆴 𑆥𑆴𑆟𑇀𑆝𑆂 𑆥𑆶𑆩𑆳𑆤𑇀, 𑆱𑇀𑆠𑇀𑆫𑆵 𑆖𑆼𑆠𑇀 𑆥𑆼𑆯𑆵, 𑆤𑆥𑆶𑆁𑆱𑆑𑆁 𑆖𑆼𑆢𑆫𑇀𑆧𑆶𑆢𑆩𑆴𑆠𑆴; 𑆠𑆸𑆠𑆵𑆪𑆼 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆯𑆴𑆫𑆱𑆳𑆁 𑆥𑆚𑇀𑆖𑆥𑆴𑆟𑇀𑆝𑆑𑆳 𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇁𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆨𑆳𑆓𑆯𑇀𑆖 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆾 𑆨𑆮𑆠𑆴; 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆨𑆳𑆓𑆂 𑆥𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆨𑆮𑆠𑆴, 𑆓𑆫𑇀𑆨𑆲𑆸𑆢𑆪𑆥𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆨𑆳𑆮𑆳𑆖𑇀𑆖𑆼𑆠𑆤𑆳𑆣𑆳𑆠𑆶𑆫𑆨𑆴𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆨𑆮𑆠𑆴, 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆠𑆠𑇀𑆱𑇀𑆡𑆳𑆤𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆩𑆳𑆱𑇀𑆪𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆼𑆰𑆶 𑆑𑆫𑆾𑆠𑆴, 𑆢𑇀𑆮𑆴𑆲𑆸𑆢𑆪𑆳𑆁 𑆖 𑆤𑆳𑆫𑆵𑆁 𑆢𑆿𑆲𑆸𑆢𑆴𑆤𑆵𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇅 𑆢𑆿𑆲𑆸𑆢𑆮𑆴𑆩𑆳𑆤𑆤𑆳𑆠𑇀 𑆑𑆶𑆧𑇀𑆘𑆁 𑆑𑆶𑆟𑆴𑆁 𑆒𑆚𑇀𑆘𑆁 𑆘𑆝𑆁 𑆮𑆳𑆩𑆤𑆁 𑆮𑆴𑆑𑆸𑆠𑆳𑆑𑇀𑆰𑆩𑆤𑆑𑇀𑆰𑆁 𑆮𑆳 𑆤𑆳𑆫𑆵 𑆱𑆶𑆠𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆳 𑆪𑆢𑇀𑆪𑆢𑆴𑆖𑇀𑆗𑆼𑆠𑇀𑆠𑆠𑇀𑆠𑆱𑇀𑆪𑆽 𑆢𑆳𑆥𑆪𑆼𑆠𑇀, 𑆬𑆧𑇀𑆣𑆢𑆿𑆲𑆸𑆢𑆳 𑆲𑆴 𑆮𑆵𑆫𑇀𑆪𑆮𑆤𑇀𑆠𑆁 𑆖𑆴𑆫𑆳𑆪𑆶𑆰𑆁 𑆖 𑆥𑆶𑆠𑇀𑆫𑆁 𑆘𑆤𑆪𑆠𑆴 𑇆𑇑𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆁𑆱𑇀𑆠𑆶 𑆪𑆳𑆤𑇀 𑆪𑆳𑆤𑇀 𑆱𑆳 𑆨𑆾𑆑𑇀𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆠𑆴 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆓𑆫𑇀𑆨𑆳𑆧𑆳𑆣𑆨𑆪𑆳𑆠𑇀𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆨𑆴𑆰𑆓𑆳𑆲𑆸𑆠𑇀𑆪 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆱𑆳 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆢𑆿𑆲𑆸𑆢𑆳 𑆥𑆶𑆠𑇀𑆫𑆁 𑆘𑆤𑆪𑆼𑆠 𑆓𑆶𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇅 𑆃𑆬𑆧𑇀𑆣𑆢𑆿𑆲𑆸𑆢𑆳 𑆓𑆫𑇀𑆨𑆼 𑆬𑆨𑆼𑆠𑆳𑆠𑇀𑆩𑆤𑆴 𑆮𑆳 𑆨𑆪𑆩𑇀 𑇆𑇒𑇐𑇆
𑆪𑆼𑆰𑆶 𑆪𑆼𑆰𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆼𑆰𑆶 𑆢𑆿𑆲𑆸𑆢𑆼 𑆮𑆽 𑆮𑆴𑆩𑆳𑆤𑆤𑆳 𑇅 𑆥𑇀𑆫𑆘𑆳𑆪𑆼𑆠 𑆱𑆶𑆠𑆱𑇀𑆪𑆳𑆫𑇀𑆠𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼 𑇆𑇒𑇑𑇆
𑆫𑆳𑆘𑆱𑆤𑇀𑆢𑆫𑇀𑆯𑆤𑆼 𑆪𑆱𑇀𑆪𑆳 𑆢𑆿𑆫𑇀𑆲𑆸𑆢𑆁 𑆘𑆳𑆪𑆠𑆼 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂 𑇅 𑆃𑆫𑇀𑆡𑆮𑆤𑇀𑆠𑆁 𑆩𑆲𑆳𑆨𑆳𑆓𑆁 𑆑𑆶𑆩𑆳𑆫𑆁 𑆱𑆳 𑆥𑇀𑆫𑆱𑆷𑆪𑆠𑆼 𑇆𑇒𑇒𑇆
𑆢𑆶𑆑𑆷𑆬𑆥𑆛𑇀𑆛𑆑𑆿𑆯𑆼𑆪𑆨𑆷𑆰𑆟𑆳𑆢𑆴𑆰𑆶 𑆢𑆿𑆲𑆸𑆢𑆳𑆠𑇀 𑇅 𑆃𑆬𑆕𑇀𑆑𑆳𑆫𑆽𑆰𑆴𑆟𑆁 𑆥𑆶𑆠𑇀𑆫𑆁 𑆬𑆬𑆴𑆠𑆁 𑆱𑆳 𑆥𑇀𑆫𑆱𑆷𑆪𑆠𑆼 𑇆𑇒𑇓𑇆
𑆄𑆯𑇀𑆫𑆩𑆼 𑆱𑆁𑆪𑆠𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆣𑆫𑇀𑆩𑆯𑆵𑆬𑆁 𑆥𑇀𑆫𑆱𑆷𑆪𑆠𑆼 𑇅 𑆢𑆼𑆮𑆠𑆳𑆥𑇀𑆫𑆠𑆴𑆩𑆳𑆪𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆱𑆷𑆠𑆼 𑆥𑆳𑆫𑇀𑆰𑆢𑆾𑆥𑆩𑆩𑇀 𑇅 𑆢𑆫𑇀𑆯𑆤𑆼 𑆮𑇀𑆪𑆳𑆬𑆘𑆳𑆠𑆵𑆤𑆳𑆁 𑆲𑆴𑆁𑆱𑆳𑆯𑆵𑆬𑆁 𑆥𑇀𑆫𑆱𑆷𑆪𑆠𑆼 𑇆𑇒𑇔𑇆
𑆃𑆠𑆾𑇁𑆤𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆪𑆳 𑆤𑆳𑆫𑆵 𑆱𑆩𑆨𑆴𑆣𑇀𑆪𑆳𑆠𑆴 𑆢𑆿𑆫𑇀𑆲𑆸𑆢𑆩𑇀 𑇅 𑆯𑆫𑆵𑆫𑆳𑆖𑆳𑆫𑆯𑆵𑆬𑆽𑆂 𑆱𑆳 𑆱𑆩𑆳𑆤𑆁 𑆘𑆤𑆪𑆴𑆰𑇀𑆪𑆠𑆴 𑇆𑇒𑇘𑇆
𑆑𑆫𑇀𑆩𑆟𑆳 𑆖𑆾𑆢𑆴𑆠𑆁 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆨𑆮𑆴𑆠𑆮𑇀𑆪𑆁 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆼𑆠𑇀 𑇅 𑆪𑆡𑆳 𑆠𑆡𑆳 𑆢𑆽𑆮𑆪𑆾𑆓𑆳𑆢𑇀𑆢𑆿𑆫𑇀𑆲𑆸𑆢𑆁 𑆘𑆤𑆪𑆼𑆢𑇀𑆣𑆸𑆢𑆴 𑇆𑇒𑇙𑇆
𑆩𑆳𑆠𑆶𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆫𑆱𑆮𑆲𑆳𑆪𑆳𑆁 𑆤𑆳𑆝𑇀𑆪𑆳𑆁 𑆓𑆫𑇀𑆨𑆤𑆳𑆨𑆴𑆤𑆳𑆝𑆵𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆳, 𑆱𑆳𑇁𑆱𑇀𑆪 𑆩𑆳𑆠𑆶𑆫𑆳𑆲𑆳𑆫𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆩𑆨𑆴𑆮𑆲𑆠𑆴 𑇅 𑆠𑆼𑆤𑆾𑆥𑆱𑇀𑆤𑆼𑆲𑆼𑆤𑆳𑆱𑇀𑆪𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇅 𑆃𑆱𑆚𑇀𑆘𑆳𑆠𑆳𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆩𑆳𑆤𑆴𑆰𑆼𑆑𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆵𑆤𑆳𑆁 𑆫𑆱𑆮𑆲𑆳𑆤𑆳𑆁 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆠𑆳𑆤𑆳𑆁 𑆣𑆩𑆤𑆵𑆤𑆳𑆩𑆶𑆥𑆱𑇀𑆤𑆼𑆲𑆾 𑆘𑆵𑆮𑆪𑆠𑆴 𑇆𑇓𑇑𑇆
𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆒𑆬𑆶 𑆱𑆩𑇀𑆨𑆮𑆠𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑆴𑆫𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆵𑆠𑇀𑆪𑆳𑆲 𑆯𑆿𑆤𑆑𑆂, 𑆯𑆴𑆫𑆾𑆩𑆷𑆬𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆣𑆳𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 ; 𑆲𑆸𑆢𑆪𑆩𑆴𑆠𑆴 𑆑𑆸𑆠𑆮𑆵𑆫𑇀𑆪𑆾, 𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑇀𑆩𑆤𑆱𑆯𑇀𑆖 𑆱𑇀𑆡𑆳𑆤𑆠𑇀𑆮𑆳𑆠𑇀; 𑆤𑆳𑆨𑆴𑆫𑆴𑆠𑆴 𑆥𑆳𑆫𑆳𑆯𑆫𑇀𑆪𑆂, 𑆠𑆠𑆾 𑆲𑆴 𑆮𑆫𑇀𑆣𑆠𑆼 𑆢𑆼𑆲𑆾 𑆢𑆼𑆲𑆴𑆤𑆂; 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆩𑆴𑆠𑆴 𑆩𑆳𑆫𑇀𑆑𑆟𑇀𑆝𑆼𑆪𑆂, 𑆠𑆤𑇀𑆩𑆷𑆬𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆪𑆳 𑆓𑆫𑇀𑆨𑆱𑇀𑆪; 𑆩𑆣𑇀𑆪𑆯𑆫𑆵𑆫𑆩𑆴𑆠𑆴 𑆱𑆶𑆨𑆷𑆠𑆴𑆫𑇀𑆓𑆿𑆠𑆩𑆂, 𑆠𑆤𑇀𑆤𑆴𑆧𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆓𑆳𑆠𑇀𑆫𑆱𑆩𑇀𑆨𑆮𑆱𑇀𑆪 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆴 𑆪𑆶𑆓𑆥𑆠𑇀 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆵𑆠𑇀𑆪𑆳𑆲 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂, 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆁𑆯𑆳𑆕𑇀𑆑𑆶𑆫𑆮𑆖𑇀𑆖𑆷𑆠𑆦𑆬𑆮𑆖𑇀𑆖; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆖𑆷𑆠𑆦𑆬𑆼 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆼 𑆑𑆼𑆯𑆫𑆩𑆳𑆁𑆱𑆳𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆳𑆤𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑇀𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆠𑇀, 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆠𑆫𑆶𑆟𑆼 𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆼𑆰𑆳𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆳𑆁 𑆑𑆼𑆯𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆳𑆬𑆂 𑆥𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆳𑆁 𑆑𑆫𑆾𑆠𑆴; 𑆍𑆠𑆼𑆤𑆽𑆮 𑆮𑆁𑆯𑆳𑆕𑇀𑆑𑆶𑆫𑆾𑇁𑆥𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂 𑇅 𑆍𑆮𑆁 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆠𑆳𑆫𑆶𑆟𑇀𑆪𑆼 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆼𑆰𑆶 𑆱𑆠𑇀𑆱𑇀𑆮𑆥𑆴 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆢𑆤𑆶𑆥𑆬𑆧𑇀𑆣𑆴𑆂, 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇒𑇆
𑆠𑆠𑇀𑆫 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆥𑆴𑆠𑆸𑆘𑆩𑆳𑆠𑆸𑆘𑆫𑆱𑆘𑆳𑆠𑇀𑆩𑆘𑆱𑆠𑇀𑆠𑇀𑆮𑆘𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆳𑆤𑆴 𑆯𑆫𑆵𑆫𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇅 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆬𑆾𑆩𑆳𑆱𑇀𑆡𑆴𑆤𑆒𑆢𑆤𑇀𑆠𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆣𑆩𑆤𑆵𑆫𑆼𑆠𑆂𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆴 𑆥𑆴𑆠𑆸𑆘𑆳𑆤𑆴, 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑇀𑆠𑇀𑆫𑆓𑆶𑆢𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆩𑆸𑆢𑆷𑆤𑆴 𑆩𑆳𑆠𑆸𑆘𑆳𑆤𑆴, 𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆾 𑆧𑆬𑆁 𑆮𑆫𑇀𑆟𑆂 𑆱𑇀𑆡𑆴𑆠𑆴𑆫𑇀𑆲𑆳𑆤𑆴𑆯𑇀𑆖 𑆫𑆱𑆘𑆳𑆤𑆴, 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆘𑇀𑆚𑆳𑆤𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆳𑆪𑆶𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆳𑆢𑆴𑆑𑆁 𑆖𑆳𑆠𑇀𑆩𑆘𑆳𑆤𑆴, 𑆱𑆠𑇀𑆠𑇀𑆮𑆘𑆳𑆤𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆠𑇀𑆫 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆮𑆵𑆫𑇀𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆿 𑆩𑆼𑆣𑆳 𑆖 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆳𑆤𑆴 𑇆𑇓𑇓𑇆
𑆠𑆠𑇀𑆫 𑆪𑆱𑇀𑆪𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼 𑆱𑇀𑆠𑆤𑆼 𑆥𑇀𑆫𑆳𑆑𑇀 𑆥𑆪𑆾𑆢𑆫𑇀𑆯𑆤𑆁 𑆨𑆮𑆠𑆴 𑆢𑆑𑇀𑆰𑆴𑆟𑆑𑆶𑆑𑇀𑆰𑆴𑆩𑆲𑆠𑇀𑆠𑇀𑆮𑆁 𑆖 𑆥𑆷𑆫𑇀𑆮𑆁 𑆖 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆱𑆑𑇀𑆡𑇀𑆪𑆶𑆠𑇀𑆑𑆫𑇀𑆰𑆠𑆴 𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆖𑇀𑆖 𑆥𑆶𑆤𑇀𑆤𑆳𑆩𑆣𑆼𑆪𑆼𑆰𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑆶 𑆢𑆿𑆫𑇀𑆲𑆸𑆢𑆩𑆨𑆴𑆣𑇀𑆪𑆳𑆪𑆠𑆴 𑆱𑇀𑆮𑆥𑇀𑆤𑆼𑆰𑆶 𑆖𑆾𑆥𑆬𑆨𑆠𑆼 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆑𑆶𑆩𑆶𑆢𑆳𑆩𑇀𑆫𑆳𑆠𑆑𑆳𑆢𑆵𑆤𑆴 𑆥𑆶𑆤𑇀𑆤𑆳𑆩𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆩𑆶𑆒𑆮𑆫𑇀𑆟𑆳 𑆖 𑆨𑆮𑆠𑆴 𑆠𑆳𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀 𑆥𑆶𑆠𑇀𑆫𑆩𑆴𑆪𑆁 𑆘𑆤𑆪𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴, 𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼 𑆑𑆤𑇀𑆪𑆳𑆁, 𑆪𑆱𑇀𑆪𑆳𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆢𑇀𑆮𑆪𑆩𑆮𑆤𑆠𑆁 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆤𑇀𑆤𑆴𑆫𑇀𑆓𑆠𑆩𑆶𑆢𑆫𑆁 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆁 𑆖 𑆬𑆑𑇀𑆰𑆟𑆁 𑆖 𑆠𑆱𑇀𑆪𑆳 𑆤𑆥𑆶𑆁𑆱𑆑𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆪𑆱𑇀𑆪𑆳 𑆩𑆣𑇀𑆪𑆼 𑆤𑆴𑆩𑇀𑆤𑆁 𑆢𑇀𑆫𑆾𑆟𑆵𑆨𑆷𑆠𑆩𑆶𑆢𑆫𑆁 𑆱𑆳 𑆪𑆶𑆓𑇀𑆩𑆁 𑆥𑇀𑆫𑆱𑆷𑆪𑆠 𑆅𑆠𑆴 𑇆𑇓𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆢𑆼𑆮𑆠𑆳𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆥𑆫𑆳𑆂 𑆯𑆿𑆖𑆳𑆖𑆳𑆫𑆲𑆴𑆠𑆼 𑆫𑆠𑆳𑆂 𑇅 𑆩𑆲𑆳𑆓𑆶𑆟𑆳𑆤𑇀 𑆥𑇀𑆫𑆱𑆷𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆱𑇀𑆠𑆶 𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑆳𑆤𑇀 𑇆𑇓𑇕𑇆
𑆃𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆢𑆼𑆮 𑆘𑆳𑆪𑆠𑆼 𑇅 𑆃𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆿 𑆪𑆼 𑆨𑆮𑆤𑇀𑆠𑆴 𑆓𑆶𑆟𑆳𑆓𑆶𑆟𑆳𑆂 𑇅 𑆠𑆼 𑆠𑆼 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆣𑆫𑇀𑆩𑆳𑆣𑆫𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆳𑆂 𑇆𑇓𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆓𑆫𑇀𑆨𑆮𑇀𑆪𑆳𑆑𑆫𑆟𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆓𑇀𑆤𑆴𑆂 𑆱𑆾𑆩𑆾 𑆮𑆳𑆪𑆶𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆫𑆘𑆱𑇀𑆠𑆩𑆂 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆼𑆠𑆴 𑆥𑇀𑆫𑆳𑆟𑆳𑆂 𑇆𑇓𑇆
𑆠𑆱𑇀𑆪 𑆒𑆬𑇀𑆮𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆱𑇀𑆪 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪𑆳𑆨𑆴𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆑𑇀𑆰𑆵𑆫𑆱𑇀𑆪𑆼𑆮 𑆱𑆤𑇀𑆠𑆳𑆤𑆴𑆑𑆳𑆂 𑆱𑆥𑇀𑆠 𑆠𑇀𑆮𑆖𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆥𑇀𑆫𑆡𑆩𑆳𑇁𑆮𑆨𑆳𑆱𑆴𑆤𑆵 𑆤𑆳𑆩, 𑆪𑆳 𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆮𑆫𑇀𑆟𑆳𑆤𑆮𑆨𑆳𑆱𑆪𑆠𑆴 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆳𑆁 𑆖 𑆗𑆳𑆪𑆳𑆁 𑆥𑇀𑆫𑆑𑆳𑆯𑆪𑆠𑆴, 𑆱𑆳 𑆮𑇀𑆫𑆵𑆲𑆼𑆫𑆰𑇀𑆛𑆳𑆢𑆯𑆨𑆳𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆱𑆴𑆣𑇀𑆩𑆥𑆢𑇀𑆩𑆑𑆟𑇀𑆛𑆑𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳 𑆬𑆾𑆲𑆴𑆠𑆳 𑆤𑆳𑆩, 𑆰𑆾𑆝𑆯𑆨𑆳𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆤𑇀𑆪𑆖𑇀𑆗𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆠𑆸𑆠𑆵𑆪𑆳 𑆯𑇀𑆮𑆼𑆠𑆳 𑆤𑆳𑆩, 𑆢𑇀𑆮𑆳𑆢𑆯𑆨𑆳𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆖𑆫𑇀𑆩𑆢𑆬𑆳𑆘𑆓𑆬𑇀𑆬𑆵𑆩𑆰𑆑𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆖𑆠𑆶𑆫𑇀𑆡𑆵 𑆠𑆳𑆩𑇀𑆫𑆳 𑆤𑆳𑆩𑆳𑆰𑇀𑆛𑆨𑆳𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆮𑆴𑆮𑆴𑆣𑆑𑆴𑆬𑆳𑆱𑆑𑆶𑆰𑇀𑆜𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆥𑆚𑇀𑆖𑆩𑆵 𑆮𑆼𑆢𑆴𑆤𑆵 𑆤𑆳𑆩 𑆥𑆚𑇀𑆖𑆨𑆳𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆰𑆰𑇀𑆜𑆵 𑆫𑆾𑆲𑆴𑆟𑆵 𑆤𑆳𑆩 𑆮𑇀𑆫𑆵𑆲𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆓𑇀𑆫𑆤𑇀𑆡𑇀𑆪𑆥𑆖𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆯𑇀𑆬𑆵𑆥𑆢𑆓𑆬𑆓𑆟𑇀𑆝𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳; 𑆱𑆥𑇀𑆠𑆩𑆵 𑆩𑆳𑆁𑆱𑆣𑆫𑆳 𑆤𑆳𑆩 𑆮𑇀𑆫𑆵𑆲𑆴𑆢𑇀𑆮𑆪𑆥𑇀𑆫𑆩𑆳𑆟𑆳, 𑆨𑆓𑆤𑇀𑆢𑆫𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆫𑇀𑆯𑆾𑇁𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳 𑇅 𑆪𑆢𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆠𑆤𑇀𑆩𑆳𑆁𑆱𑆬𑆼𑆰𑇀𑆮𑆮𑆑𑆳𑆯𑆼𑆰𑆶, 𑆤 𑆬𑆬𑆳𑆛𑆼 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆖; 𑆪𑆠𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆼𑆰𑆶- ‘𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆼𑆤𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆾𑆢𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆮𑆓𑆳𑆞𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀’ (𑆖𑆴.𑇑𑇔) 𑆅𑆠𑆴 𑇆𑇔𑇆
𑆑𑆬𑆳𑆂 𑆒𑆬𑇀𑆮𑆥𑆴 𑆱𑆥𑇀𑆠 𑆨𑆮𑆤𑇀𑆠𑆴 𑆣𑆳𑆠𑇀𑆮𑆳𑆯𑆪𑆳𑆤𑇀𑆠𑆫𑆩𑆫𑇀𑆪𑆳𑆢𑆳𑆂 𑇆𑇕𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳 𑆲𑆴 𑆱𑆳𑆫𑆂 𑆑𑆳𑆰𑇀𑆜𑆼𑆰𑆶 𑆗𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆼𑆰𑆶 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑇅 𑆠𑆡𑆳𑆲𑆴 𑆣𑆳𑆠𑆶𑆫𑇀𑆩𑆳𑆁𑆱𑆼𑆰𑆶 𑆗𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆼𑆰𑆶 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑇆𑇖𑇆
𑆱𑇀𑆤𑆳𑆪𑆶𑆨𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆠𑆴𑆖𑇀𑆗𑆤𑇀𑆤𑆳𑆤𑇀 𑆱𑆤𑇀𑆠𑆠𑆳𑆁𑆯𑇀𑆖 𑆘𑆫𑆳𑆪𑆶𑆟𑆳 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆑𑆬𑆳𑆨𑆳𑆓𑆳𑆁𑆱𑇀𑆠𑆶 𑆠𑆳𑆤𑇀 𑆮𑆴𑆢𑆶𑆂 𑇆𑇗𑇆
𑆠𑆳𑆱𑆳𑆁 𑆥𑇀𑆫𑆡𑆩𑆳 𑆩𑆳𑆁𑆱𑆣𑆫𑆳, 𑆪𑆱𑇀𑆪𑆳𑆁 𑆩𑆳𑆁𑆱𑆼 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆣𑆩𑆤𑆵𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆥𑇀𑆫𑆠𑆳𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇘𑇆
𑆪𑆡𑆳 𑆧𑆴𑆱𑆩𑆸𑆟𑆳𑆬𑆳𑆤𑆴 𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑇀𑆠𑆼 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑇅 𑆨𑆷𑆩𑆿 𑆥𑆕𑇀𑆑𑆾𑆢𑆑𑆱𑇀𑆡𑆳𑆤𑆴 𑆠𑆡𑆳 𑆩𑆳𑆁𑆱𑆼 𑆱𑆴𑆫𑆳𑆢𑆪𑆂 𑇆𑇙𑇆
𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳 𑆫𑆑𑇀𑆠𑆣𑆫𑆳 𑆩𑆳𑆁𑆱𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂, 𑆠𑆱𑇀𑆪𑆳𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖 𑆱𑆴𑆫𑆳𑆱𑆶 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆾𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇑𑇐𑇆
𑆮𑆸𑆑𑇀𑆰𑆳𑆢𑇀𑆪𑆡𑆳𑆨𑆴𑆥𑇀𑆫𑆲𑆠𑆳𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆂 𑆑𑇀𑆰𑆵𑆫𑆴𑆩𑆳𑆮𑆲𑆼𑆠𑇀 𑇅 𑆩𑆳𑆁𑆱𑆳𑆢𑆼𑆮𑆁 𑆑𑇀𑆰𑆠𑆳𑆠𑇀 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑆴𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇑𑇆
𑆠𑆸𑆠𑆵𑆪𑆳 𑆩𑆼𑆢𑆾𑆣𑆫𑆳; 𑆩𑆼𑆢𑆾 𑆲𑆴 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆶𑆢𑆫𑆱𑇀𑆡𑆩𑆟𑇀𑆮𑆱𑇀𑆡𑆴𑆰𑆶 𑆖, 𑆩𑆲𑆠𑇀𑆱𑆶 𑆖 𑆩𑆘𑇀𑆘𑆳 𑆨𑆮𑆠𑆴 𑇆𑇑𑇒𑇆
𑆱𑇀𑆡𑆷𑆬𑆳𑆱𑇀𑆡𑆴𑆰𑆶 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆩𑆘𑇀𑆘𑆳 𑆠𑇀𑆮𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆯𑇀𑆫𑆴𑆠𑆂 𑇅 𑆃𑆡𑆼𑆠𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆱𑆫𑆑𑇀𑆠𑆁 𑆩𑆼𑆢 𑆇𑆖𑇀𑆪𑆠𑆼 𑇅 𑆯𑆶𑆢𑇀𑆣𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑆳 𑆮𑆱𑆳 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳 𑇆𑇑𑇓𑇆
𑆖𑆠𑆶𑆫𑇀𑆡𑆵 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆣𑆫𑆳 𑆱𑆫𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆳𑆁 𑆨𑆮𑆠𑆴 𑇆𑇑𑇔𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆼 𑆪𑆡𑆳 𑆲𑇀𑆪𑆑𑇀𑆰𑆼 𑆖𑆑𑇀𑆫𑆁 𑆱𑆳𑆣𑆶 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆱𑆤𑇀𑆣𑆪𑆂 𑆱𑆳𑆣𑆶 𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆱𑆁𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆠𑆡𑆳 𑇆𑇑𑇕𑇆
𑆥𑆚𑇀𑆖𑆩𑆵 𑆥𑆶𑆫𑆵𑆰𑆣𑆫𑆳 𑆤𑆳𑆩; 𑆪𑆳𑇁𑆤𑇀𑆠𑆂𑆑𑆾𑆰𑇀𑆜𑆼 𑆩𑆬𑆩𑆨𑆴𑆮𑆴𑆨𑆘𑆠𑆼 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆳 𑇆𑇑𑇖𑇆
𑆪𑆑𑆸𑆠𑇀𑆱𑆩𑆤𑇀𑆠𑆳𑆠𑇀 𑆑𑆾𑆰𑇀𑆜𑆁 𑆖 𑆠𑆡𑆳𑇁𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆳 𑇅 𑆇𑆟𑇀𑆝𑆶(𑆤𑇀𑆢𑆶)𑆑𑆱𑇀𑆡𑆁 𑆮𑆴𑆨𑆘𑆠𑆼 𑆩𑆬𑆁 𑆩𑆬𑆣𑆫𑆳 𑆑𑆬𑆳 𑇆𑇑𑇗𑇆
𑆰𑆰𑇀𑆜𑆵 𑆥𑆴𑆠𑇀𑆠𑆣𑆫𑆳 ; 𑆪𑆳 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆩𑆳𑆩𑆳𑆯𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆖𑇀𑆪𑆶𑆠𑆁 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆾𑆥𑆱𑇀𑆡𑆴𑆠𑆁 𑆣𑆳𑆫𑆪𑆠𑆴 𑇆𑇑𑇘𑇆
𑆃𑆯𑆴𑆠𑆁 𑆒𑆳𑆢𑆴𑆠𑆁 𑆥𑆵𑆠𑆁 𑆬𑆵𑆞𑆁 𑆑𑆾𑆰𑇀𑆜𑆓𑆠𑆁 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆠𑆘𑇀𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆯𑆾𑆰𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆠𑆼𑆘𑆱𑆳 𑇆𑇑𑇙𑇆
𑆱𑆥𑇀𑆠𑆩𑆵 𑆯𑆶𑆑𑇀𑆫𑆣𑆫𑆳, 𑆪𑆳 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆮𑇀𑆪𑆳𑆥𑆴𑆤𑆵 𑇆𑇒𑇐𑇆
𑆪𑆡𑆳 𑆥𑆪𑆱𑆴 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆶 𑆓𑆷𑆞𑆯𑇀𑆖𑆼𑆑𑇀𑆰𑆿 𑆫𑆱𑆾 𑆪𑆡𑆳 𑇅 𑆯𑆫𑆵𑆫𑆼𑆰𑆶 𑆠𑆡𑆳 𑆯𑆶𑆑𑇀𑆫𑆁 𑆤𑆸𑆟𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆮𑆫𑆂 𑇆𑇒𑇑𑇆
𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼 𑆢𑆑𑇀𑆰𑆴𑆟𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆧𑆱𑇀𑆠𑆴𑆢𑇀𑆮𑆳𑆫𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆣𑆂 𑇅 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆂𑆥𑆡𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆁 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇒𑇒𑇆
𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆢𑆼𑆲𑆳𑆯𑇀𑆫𑆴𑆠𑆁 𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆩𑆤𑆱𑆱𑇀𑆠𑆡𑆳 𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆮𑇀𑆪𑆳𑆪𑆖𑇀𑆗𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆲𑆫𑇀𑆰𑆳𑆠𑇀𑆠𑆠𑇀 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇒𑇓𑇆
𑆓𑆸𑆲𑆵𑆠𑆓𑆫𑇀𑆨𑆳𑆟𑆳𑆩𑆳𑆫𑇀𑆠𑆮𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆤𑇀𑆪𑆮𑆫𑆶𑆣𑇀𑆪𑆤𑇀𑆠𑆼 𑆓𑆫𑇀𑆨𑆼𑆟, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆓𑆸𑆲𑆵𑆠𑆓𑆫𑇀𑆨𑆳𑆟𑆳𑆩𑆳𑆫𑇀𑆠𑆮𑆁 𑆤 𑆢𑆸𑆯𑇀𑆪𑆠𑆼; 𑆠𑆠𑆱𑇀𑆠𑆢𑆣𑆂 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆓𑆠𑆩𑆥𑆫𑆁 𑆖𑆾𑆥𑆖𑆵𑆪𑆩𑆳𑆤𑆩𑆥𑆫𑆼𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼; 𑆯𑆼𑆰𑆁 𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆠𑆫𑆩𑆳𑆓𑆠𑆁 𑆥𑆪𑆾𑆣𑆫𑆳𑆮𑆨𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆂 𑆥𑆵𑆤𑆾𑆤𑇀𑆤𑆠𑆥𑆪𑆾𑆣𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇒𑇔𑇆
𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆿 𑆯𑆾𑆟𑆴𑆠𑆘𑆿, 𑆯𑆾𑆟𑆴𑆠𑆦𑆼𑆤𑆥𑇀𑆫𑆨𑆮𑆂 𑆦𑆶𑆥𑇀𑆦𑆶𑆱𑆂 , 𑆯𑆾𑆟𑆴𑆠𑆑𑆴𑆛𑇀𑆛𑆥𑇀𑆫𑆨𑆮 𑆇𑆟𑇀𑆝𑆶𑆑𑆂 𑇆𑇒𑇕𑇆
𑆃𑆱𑆸𑆘𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆯𑇀𑆖𑆳𑆥𑆴 𑆪𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆂 𑆥𑆫𑆾 𑆩𑆠𑆂 𑇅 𑆠𑆁 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆮𑆳𑆪𑆶𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆣𑆳𑆮𑆠𑆴 𑇆𑇒𑇖𑇆
𑆠𑆠𑆾𑇁𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆓𑆶𑆢𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆇𑆢𑆫𑆼 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆩𑆳𑆣𑇀𑆩𑆳𑆤𑆳𑆢𑇀𑆫𑆶𑆑𑇀𑆩𑆱𑆳𑆫𑆮𑆠𑇀 𑇆𑇒𑇗𑇆
𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁 𑆱𑆳𑆫𑆳𑆘𑇀𑆘𑆴𑆲𑇀𑆮𑆳 𑆥𑇀𑆫𑆘𑆳𑆪𑆠𑆼 𑇅 𑆪𑆡𑆳𑆫𑇀𑆡𑆩𑆷𑆰𑇀𑆩𑆟𑆳 𑆪𑆶𑆑𑇀𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆢𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇘𑇆
𑆃𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆥𑆴𑆯𑆴𑆠𑆁 𑆥𑆼𑆯𑆵𑆫𑇀𑆮𑆴𑆨𑆘𑆠𑆼 𑆠𑆡𑆳 𑇅 𑆩𑆼𑆢𑆱𑆂 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆢𑆳𑆪 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆠𑇀𑆮𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇆𑇒𑇙𑇆
𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆠𑆶 𑆩𑆸𑆢𑆶𑆂 𑆥𑆳𑆑𑆂 𑆱𑇀𑆤𑆳𑆪𑆷𑆤𑆳𑆁 𑆖 𑆠𑆠𑆂 𑆒𑆫𑆂 𑇅 𑆄𑆯𑆪𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆱𑆪𑆾𑆓𑆼𑆤 𑆑𑆫𑆾𑆠𑇀𑆪𑆳𑆯𑆪𑆱𑆩𑇀𑆨𑆮𑆩𑇀 𑇆𑇓𑇐𑇆
𑆫𑆑𑇀𑆠𑆩𑆼𑆢𑆂𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆢𑇀𑆮𑆸𑆑𑇀𑆑𑆿; 𑆩𑆳𑆁𑆱𑆳𑆱𑆸𑆑𑇀𑆑𑆦𑆩𑆼𑆢𑆂𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆢𑇀𑆮𑆸𑆰𑆟𑆿; 𑆯𑆾𑆟𑆴𑆠𑆑𑆦𑆥𑇀𑆫𑆱𑆳𑆢𑆘𑆁 𑆲𑆸𑆢𑆪𑆁, 𑆪𑆢𑆳𑆯𑇀𑆫𑆪𑆳 𑆲𑆴 𑆣𑆩𑆤𑇀𑆪𑆂 𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆳𑆂; 𑆠𑆱𑇀𑆪𑆳𑆣𑆾 𑆮𑆳𑆩𑆠𑆂 𑆥𑇀𑆬𑆵𑆲𑆳 𑆦𑆶𑆥𑇀𑆦𑆶𑆱𑆯𑇀𑆖, 𑆢𑆑𑇀𑆰𑆴𑆟𑆠𑆾 𑆪𑆑𑆸𑆠𑇀 𑆑𑇀𑆬𑆾𑆩 𑆖; 𑆠𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆖𑆼𑆠𑆤𑆳𑆱𑇀𑆡𑆳𑆤𑆩𑇀, 𑆃𑆠𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆩𑆱𑆳𑇁𑇁𑆮𑆸𑆠𑆼 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆂 𑆱𑇀𑆮𑆥𑆤𑇀𑆠𑆴 𑇆𑇓𑇑𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆼𑆟 𑆱𑆢𑆸𑆯𑆁 𑆲𑆸𑆢𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑆣𑆾𑆩𑆶𑆒𑆩𑇀 𑇅 𑆘𑆳𑆓𑇀𑆫𑆠𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆑𑆱𑆠𑆴 𑆱𑇀𑆮𑆥𑆠𑆯𑇀𑆖 𑆤𑆴𑆩𑆵𑆬𑆠𑆴 𑇆𑇓𑇒𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆠𑆶 𑆮𑆽𑆰𑇀𑆟𑆮𑆵𑆁 𑆥𑆳𑆥𑇀𑆩𑆳𑆤𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴, 𑆱𑆳 𑆱𑇀𑆮𑆨𑆳𑆮𑆠 𑆍𑆮 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆾𑇁𑆨𑆴𑆱𑇀𑆥𑆸𑆯𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆪𑆢𑆳 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆠𑆩𑆾𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑆠𑆢𑆳 𑆠𑆳𑆩𑆱𑆵 𑆤𑆳𑆩 𑆤𑆴𑆢𑇀𑆫𑆳 𑆱𑆩𑇀𑆨𑆮𑆠𑇀𑆪𑆤𑆮𑆧𑆾𑆣𑆴𑆤𑆵, 𑆱𑆳 𑆥𑇀𑆫𑆬𑆪𑆑𑆳𑆬𑆼; 𑆠𑆩𑆾𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑆲𑆂𑆱𑆶 𑆤𑆴𑆯𑆳𑆱𑆶 𑆖 𑆨𑆮𑆠𑆴, 𑆫𑆘𑆾𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁, 𑆱𑆠𑇀𑆠𑇀𑆮𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆼; 𑆑𑇀𑆰𑆵𑆟𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆩𑆤𑆴𑆬𑆧𑆲𑆶𑆬𑆳𑆤𑆳𑆁 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆨𑆴𑆠𑆳𑆥𑆮𑆠𑆳𑆁 𑆖 𑆤𑆽𑆮, 𑆱𑆳 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆵 𑆨𑆮𑆠𑆴 𑇆𑇓𑇓𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆲𑆸𑆢𑆪𑆁 𑆖𑆼𑆠𑆤𑆳𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆱𑆶𑆯𑇀𑆫𑆶𑆠 ! 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆠𑆩𑆾𑆨𑆴𑆨𑆷𑆠𑆼 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆶 𑆤𑆴𑆢𑇀𑆫𑆳 𑆮𑆴𑆯𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆩𑇀 𑇆𑇓𑇔𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆲𑆼𑆠𑆶𑆱𑇀𑆠𑆩𑆂, 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆧𑆾𑆣𑆤𑆼 𑆲𑆼𑆠𑆶𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆱𑇀𑆮𑆨𑆳𑆮 𑆍𑆮 𑆮𑆳 𑆲𑆼𑆠𑆶𑆫𑇀𑆓𑆫𑆵𑆪𑆳𑆤𑇀 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇓𑇕𑇆
𑆥𑆷𑆫𑇀𑆮𑆢𑆼𑆲𑆳𑆤𑆶𑆨𑆷𑆠𑆳𑆁𑆱𑇀𑆠𑆶 𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆳 𑆱𑇀𑆮𑆥𑆠𑆂 𑆥𑇀𑆫𑆨𑆶𑆂 𑇅 𑆫𑆘𑆾𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆩𑆤𑆱𑆳 𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆳𑆚𑇀 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆳𑆤𑇀 𑇆𑇓𑇖𑇆
𑆑𑆫𑆟𑆳𑆤𑆳𑆁 𑆠𑆶 𑆮𑆽𑆑𑆬𑇀𑆪𑆼 𑆠𑆩𑆱𑆳𑇁𑆨𑆴𑆥𑇀𑆫𑆮𑆫𑇀𑆣𑆴𑆠𑆼 𑇅 𑆃𑆱𑇀𑆮𑆥𑆤𑇀𑆤𑆥𑆴 𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆳 𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠 𑆅𑆮 𑆖𑆾𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇗𑇆
𑆱𑆫𑇀𑆮𑆫𑇀𑆠𑆶𑆰𑆶 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆳𑆥𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆾𑇁𑆤𑇀𑆪𑆠𑇀𑆫 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆳𑆠𑇀, 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆼𑆰𑇀𑆮𑆥𑆴 𑆠𑆶 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑇀𑆯𑆴𑆠𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆩𑆢𑇀𑆪𑆤𑆴𑆠𑇀𑆪𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆳𑆣𑇀𑆮𑆑𑆫𑇀𑆩𑆥𑆫𑆴𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆩𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆳𑆁 𑆩𑆼𑆢𑆂𑆱𑇀𑆮𑆼𑆢𑆑𑆦𑆫𑆱𑆫𑆑𑇀𑆠𑆑𑇀𑆰𑆵𑆟𑆳𑆤𑆳𑆩𑆘𑆵𑆫𑇀𑆟𑆴𑆤𑆳𑆁 𑆖 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑆤𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆩𑇀 𑇅 𑆫𑆳𑆠𑇀𑆫𑆳𑆮𑆥𑆴 𑆘𑆳𑆓𑆫𑆴𑆠𑆮𑆠𑆳𑆁 𑆘𑆳𑆓𑆫𑆴𑆠𑆑𑆳𑆬𑆳𑆢𑆫𑇀𑆣𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑆤𑆩𑇀 𑇅 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑇀𑆲𑆴 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆾 𑆤𑆳𑆩; 𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆥𑆠𑆳𑆩𑆣𑆫𑇀𑆩𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆯𑇀𑆖, 𑆠𑆠𑇀𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆖𑇀𑆖 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆳𑆫𑆾𑆖𑆑𑆘𑇀𑆮𑆫𑆳𑆓𑇀𑆤𑆴𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆫𑆳𑆠𑇀𑆫𑆳𑆮𑆥𑆴 𑆘𑆳𑆓𑆫𑆴𑆠𑆮𑆠𑆳𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆱𑇀𑆠 𑆍𑆮𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆘𑆳𑆓𑆸𑆪𑆳𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆿 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆢𑆾𑆰𑆑𑆫𑆳𑆮𑆼𑆠𑆿 𑆧𑆶𑆣𑆂 𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆩𑆴𑆠𑆁 𑆖𑆫𑆼𑆠𑇀 𑇆𑇓𑇙𑇆
𑆃𑆫𑆾𑆓𑆂 𑆱𑆶𑆩𑆤𑆳 𑆲𑇀𑆪𑆼𑆮𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆾 𑆮𑆸𑆰𑆂 𑇅 𑆤𑆳𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆑𑆸𑆯𑆂 𑆯𑇀𑆫𑆵𑆩𑆳𑆤𑇀 𑆤𑆫𑆾 𑆘𑆵𑆮𑆼𑆠𑇀 𑆱𑆩𑆳𑆂 𑆯𑆠𑆩𑇀 𑇆𑇔𑇐𑇆
(𑆤𑆴𑆢𑇀𑆫𑆳 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆵𑆑𑆸𑆠𑆳 𑆪𑆽𑆱𑇀𑆠𑆶 𑆫𑆳𑆠𑇀𑆫𑆿 𑆖 𑆪𑆢𑆴 𑆮𑆳 𑆢𑆴𑆮𑆳𑇅) 𑆢𑆴𑆮𑆳𑆫𑆳𑆠𑇀𑆫𑆿 𑆖 𑆪𑆼 𑆤𑆴𑆠𑇀𑆪𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆘𑆳𑆓𑆫𑆟𑆾𑆖𑆴𑆠𑆳𑆂 𑇅 𑆤 𑆠𑆼𑆰𑆳𑆁 𑆱𑇀𑆮𑆥𑆠𑆳𑆁 𑆢𑆾𑆰𑆾 𑆘𑆳𑆓𑇀𑆫𑆠𑆳𑆁 𑆮𑆳𑇁𑆥𑆴 𑆘𑆳𑆪𑆠𑆼 𑇆𑇔𑇑𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆾𑇁𑆤𑆴𑆬𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆩𑆤𑆱𑇀𑆠𑆳𑆥𑆳𑆠𑇀 𑆑𑇀𑆰𑆪𑆳𑆢𑆥𑆴 𑇅 𑆱𑆩𑇀𑆨𑆮𑆠𑇀𑆪𑆨𑆴𑆔𑆳𑆠𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆽𑆂 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑇆𑇔𑇒𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆪𑆾𑆓𑆾 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆠𑆽𑆬𑆤𑆴𑆰𑆼𑆮𑆟𑆩𑇀 𑇅 𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆪𑆾𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆁 𑆖𑆽𑆮 𑆲𑆴𑆠𑆁 𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆤𑆴 𑆖 𑇆𑇔𑇓𑇆
𑆯𑆳𑆬𑆴𑆓𑆾𑆣𑆷𑆩𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆨𑆑𑇀𑆰𑇀𑆪𑆽𑆫𑆽𑆑𑇀𑆰𑆮𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆽𑆂 𑇅 𑆨𑆾𑆘𑆤𑆁 𑆩𑆣𑆶𑆫𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆢𑆴𑆨𑆴𑆂 𑇆𑇔𑇔𑇆
𑆫𑆱𑆽𑆫𑇀𑆧𑆴𑆬𑆼𑆯𑆪𑆳𑆤𑆳𑆁 𑆖 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆳𑆟𑆳𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆱𑆴𑆠𑆼𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆾 𑆨𑆮𑆼𑆤𑇀𑆤𑆴𑆯𑆴 𑇆𑇔𑇕𑇆
𑆯𑆪𑆤𑆳𑆱𑆤𑆪𑆳𑆤𑆳𑆤𑆴 𑆩𑆤𑆾𑆘𑇀𑆚𑆳𑆤𑆴 𑆩𑆸𑆢𑆷𑆤𑆴 𑆖 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆼 𑆠𑆶 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆥𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇔𑇖𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆮𑆩𑆤𑆁 𑆲𑆴𑆠𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆬𑆕𑇀𑆔𑆤𑆁 𑆫𑆑𑇀𑆠𑆩𑆾𑆑𑇀𑆰𑆯𑇀𑆖 𑆩𑆤𑆾𑆮𑇀𑆪𑆳𑆑𑆶𑆬𑆤𑆳𑆤𑆴 𑆖 𑇆𑇔𑇗𑇆
𑆑𑆦𑆩𑆼𑆢𑆾𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆫𑆳𑆠𑇀𑆫𑆿 𑆘𑆳𑆓𑆫𑆟𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅𑇔𑇘𑇅 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑇀𑆖 𑆠𑆸𑆛𑇀𑆯𑆷𑆬𑆲𑆴𑆑𑇀𑆑𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆠𑆴𑆱𑆳𑆫𑆴𑆟𑆳𑆩𑇀 𑇆𑇔𑇘𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆼𑆰𑇀𑆮𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆫𑇀𑆓𑆿𑆫𑆮𑆁 𑆘𑆸𑆩𑇀𑆨𑆟𑆁 𑆑𑇀𑆬𑆩𑆂 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆫𑇀𑆠𑆱𑇀𑆪𑆼𑆮 𑆪𑆱𑇀𑆪𑆼𑆲𑆳 𑆠𑆱𑇀𑆪 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇔𑇙𑇆
𑆥𑆵𑆠𑇀𑆮𑆽𑆑𑆩𑆤𑆴𑆬𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆩𑆶𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑇀 𑆮𑆴𑆮𑆸𑆠𑆳𑆤𑆤𑆂 𑇅 𑆪𑆁 𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑆱𑆤𑆼𑆠𑇀𑆫𑆳𑆱𑇀𑆫𑆁 𑆱 𑆘𑆸𑆩𑇀𑆨 𑆅𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇆𑇕𑇐𑇆
𑆪𑆾𑇁𑆤𑆳𑆪𑆳𑆱𑆂 𑆯𑇀𑆫𑆩𑆾 𑆢𑆼𑆲𑆼 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆂 𑆯𑇀𑆮𑆳𑆱𑆮𑆫𑇀𑆘𑆴𑆠𑆂 𑇅 𑆑𑇀𑆬𑆩𑆂 𑆱 𑆅𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆼𑆪 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆥𑇀𑆫𑆧𑆳𑆣𑆑𑆂 𑇆𑇕𑇑𑇆
𑆱𑆶𑆒𑆱𑇀𑆥𑆫𑇀𑆯𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆴𑆠𑇀𑆮𑆁 𑆢𑆶𑆂𑆒𑆢𑇀𑆮𑆼𑆰𑆟𑆬𑆾𑆬𑆠𑆳 𑇅 𑆯𑆑𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆠𑇀𑆱𑆳𑆲𑆂 𑆑𑆫𑇀𑆩𑆱𑇀𑆮𑆳𑆬𑆱𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇕𑇒𑇆
𑆇𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪𑆳𑆤𑇀𑆤𑆁 𑆤 𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆼𑆠𑇀 𑆥𑇀𑆫𑆱𑆼𑆑𑆰𑇀𑆜𑆵𑆮𑆤𑆼𑆫𑆴𑆠𑆩𑇀 𑇅 𑆲𑆸𑆢𑆪𑆁 𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑆖𑆳𑆱𑇀𑆪 𑆠𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇕𑇓𑇆
𑆮𑆑𑇀𑆠𑇀𑆫𑆼 𑆩𑆣𑆶𑆫𑆠𑆳 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆲𑆸𑆢𑆪𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆨𑇀𑆫𑆩𑆂 𑇅 𑆤 𑆖𑆳𑆤𑇀𑆤𑆩𑆨𑆴𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆼𑆠 𑆓𑇀𑆬𑆳𑆤𑆴𑆁 𑆠𑆱𑇀𑆪 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇕𑇔𑇆
𑆄𑆫𑇀𑆢𑇀𑆫𑆖𑆫𑇀𑆩𑆳𑆮𑆤𑆢𑇀𑆣𑆁 𑆮𑆳 𑆪𑆾 𑆓𑆳𑆠𑇀𑆫𑆁 𑆩𑆤𑇀𑆪𑆠𑆼 𑆤𑆫𑆂 𑇅 𑆠𑆡𑆳 𑆓𑆶𑆫𑆶 𑆯𑆴𑆫𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆓𑆿𑆫𑆮𑆁 𑆠𑆢𑇀𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇕𑇕𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑆴𑆠𑇀𑆠𑆠𑆩𑆂𑆥𑇀𑆫𑆳𑆪𑆳, 𑆫𑆘𑆂𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆢𑇀𑆨𑇀𑆫𑆩𑆂 𑇅 𑆠𑆩𑆾𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳, 𑆤𑆴𑆢𑇀𑆫𑆳 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆠𑆩𑆾𑆨𑆮𑆳 𑇆𑇕𑇖𑇆
𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆒𑆬𑆶 𑆫𑆱𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆩𑆳𑆫𑆶𑆠𑆳𑆣𑇀𑆩𑆳𑆤𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆖 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇕𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆤𑆳𑆨𑆼𑆱𑇀𑆠𑆶 𑆘𑇀𑆪𑆾𑆠𑆴𑆂𑆱𑇀𑆡𑆳𑆤𑆁 𑆣𑇀𑆫𑆶𑆮𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆠𑆢𑆳𑆣𑆩𑆠𑆴 𑆮𑆳𑆠𑆱𑇀𑆠𑆶 𑆢𑆼𑆲𑆱𑇀𑆠𑆼𑆤𑆳𑆱𑇀𑆪 𑆮𑆫𑇀𑆣𑆠𑆼 𑇆𑇕𑇘𑇆
𑆈𑆰𑇀𑆩𑆟𑆳 𑆱𑆲𑆴𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆢𑆳𑆫𑆪𑆠𑇀𑆪𑆱𑇀𑆪 𑆩𑆳𑆫𑆶𑆠𑆂 𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑆴𑆫𑇀𑆪𑆓𑆣𑆱𑇀𑆠𑆳𑆖𑇀𑆖 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆥𑆴 𑆪𑆡𑆳 𑆠𑆡𑆳 𑇆𑇕𑇙𑇆
𑆢𑆸𑆰𑇀𑆛𑆴𑆯𑇀𑆖 𑆫𑆾𑆩𑆑𑆷𑆥𑆳𑆯𑇀𑆖 𑆤 𑆮𑆫𑇀𑆣𑆤𑇀𑆠𑆼 𑆑𑆢𑆳𑆖𑆤 𑇅 𑆣𑇀𑆫𑆶𑆮𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆩𑆫𑇀𑆠𑇀𑆪𑆳𑆤𑆳𑆩𑆴𑆠𑆴 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆼𑆫𑇀𑆩𑆠𑆩𑇀 𑇆𑇖𑇐𑇆
𑆯𑆫𑆵𑆫𑆼 𑆑𑇀𑆰𑆵𑆪𑆩𑆳𑆟𑆼𑇁𑆥𑆴 𑆮𑆫𑇀𑆣𑆼𑆠𑆼 𑆢𑇀𑆮𑆳𑆮𑆴𑆩𑆿 𑆱𑆢𑆳 𑇅 𑆱𑇀𑆮𑆨𑆳𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤𑆒𑆑𑆼𑆯𑆳𑆮𑆴𑆠𑆴 𑆱𑇀𑆡𑆴𑆠𑆴𑆂 𑇆𑇖𑇑𑇆
𑆱𑆥𑇀𑆠 𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴- 𑆢𑆾𑆰𑆽𑆂 𑆥𑆸𑆡𑆑𑇀, 𑆢𑇀𑆮𑆴𑆯𑆂, 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑇆𑇖𑇒𑇆
𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆱𑆁𑆪𑆾𑆓𑆼 𑆪𑆾 𑆨𑆮𑆼𑆢𑇀𑆢𑆾𑆰 𑆇𑆠𑇀𑆑𑆛𑆂 𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆘𑆳𑆪𑆠𑆼 𑆠𑆼𑆤 𑆠𑆱𑇀𑆪𑆳 𑆩𑆼 𑆬𑆑𑇀𑆰𑆟𑆁 𑆯𑆸𑆟𑆶 𑇆𑇖𑇓𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆂 𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆷𑆑𑆂 𑆯𑆵𑆠𑆢𑇀𑆮𑆼𑆰𑆵 𑆢𑆶𑆫𑇀𑆨𑆓𑆂 𑆱𑇀𑆠𑆼𑆤𑆾 𑆩𑆠𑇀𑆱𑆫𑇀𑆪𑆤𑆳𑆫𑇀𑆪𑆾 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆖𑆴𑆠𑇀𑆠𑆂 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆑𑆫𑆖𑆫𑆟𑆾𑇁𑆬𑇀𑆥𑆫𑆷𑆑𑇀𑆰𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆤𑆒𑆑𑆼𑆯𑆂 𑆑𑇀𑆫𑆳𑆡𑆵 𑆢𑆤𑇀𑆠𑆒𑆳𑆢𑆵 𑆖 𑆨𑆮𑆠𑆴 𑇆𑇖𑇔𑇆
𑆃𑆣𑆸𑆠𑆴𑆫𑆢𑆸𑆞𑆱𑆿𑆲𑆸𑆢𑆂 𑆑𑆸𑆠𑆔𑇀𑆤𑆂 𑆑𑆸𑆯𑆥𑆫𑆶𑆰𑆾 𑆣𑆩𑆤𑆵𑆠𑆠𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆵 𑇅 𑆢𑇀𑆫𑆶𑆠𑆓𑆠𑆴𑆫𑆛𑆤𑆾𑇁𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆠𑇀𑆩𑆳 𑆮𑆴𑆪𑆠𑆴 𑆖 𑆓𑆖𑇀𑆗𑆠𑆴 𑆱𑆩𑇀𑆨𑇀𑆫𑆩𑆼𑆟 𑆱𑆶𑆥𑇀𑆠𑆂 𑇆𑇖𑇕𑇆
𑆃𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆠𑆴𑆯𑇀𑆖𑆬𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑇀𑆩𑆤𑇀𑆢𑆫𑆠𑇀𑆤𑆣𑆤𑆱𑆚𑇀𑆖𑆪𑆩𑆴𑆠𑇀𑆫𑆂 𑇅 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆼𑆮 𑆮𑆴𑆬𑆥𑆠𑇀𑆪𑆤𑆴𑆧𑆢𑇀𑆣𑆁 𑆩𑆳𑆫𑆶𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆼𑆰 𑆩𑆤𑆶𑆰𑇀𑆪𑆂 𑇆𑇖𑇖𑇆
(𑆮𑆳𑆠𑆴𑆑𑆳𑆯𑇀𑆖𑆳𑆘𑆓𑆾𑆩𑆳𑆪𑆶𑆯𑆯𑆳𑆒𑆷𑆰𑇀𑆛𑇀𑆫𑆯𑆶𑆤𑆳𑆁 𑆠𑆡𑆳 𑇅 𑆓𑆸𑆣𑇀𑆫𑆑𑆳𑆑𑆒𑆫𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑆷𑆑𑆽𑆂 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳 𑆤𑆫𑆳𑆂) 𑇆𑇖𑇗𑇆
𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆠𑆶 𑆱𑇀𑆮𑆼𑆢𑆤𑆾 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆂 𑆥𑆵𑆠𑆯𑆴𑆡𑆴𑆬𑆳𑆕𑇀𑆓𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆤𑆒𑆤𑆪𑆤𑆠𑆳𑆬𑆶𑆘𑆴𑆲𑇀𑆮𑆿𑆰𑇀𑆜𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆾 𑆢𑆶𑆫𑇀𑆨𑆓𑆾 𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆘𑆶𑆰𑇀𑆛𑆾 𑆧𑆲𑆶𑆨𑆶𑆓𑆶𑆰𑇀𑆟𑆢𑇀𑆮𑆼𑆰𑆵 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆑𑆾𑆥𑆥𑇀𑆫𑆱𑆳𑆢𑆾 𑆩𑆣𑇀𑆪𑆧𑆬𑆾 𑆩𑆣𑇀𑆪𑆳𑆪𑆶𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇖𑇘𑇆
𑆩𑆼𑆣𑆳𑆮𑆵 𑆤𑆴𑆥𑆶𑆟𑆩𑆠𑆴𑆫𑇀𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆮𑆑𑇀𑆠𑆳 𑆠𑆼𑆘𑆱𑇀𑆮𑆵 𑆱𑆩𑆴𑆠𑆴𑆰𑆶 𑆢𑆶𑆫𑇀𑆤𑆴𑆮𑆳𑆫𑆮𑆵𑆫𑇀𑆪𑆂 𑇅 𑆱𑆶𑆥𑇀𑆠𑆂 𑆱𑆤𑇀 𑆑𑆤𑆑𑆥𑆬𑆳𑆯𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆱𑆩𑇀𑆥𑆯𑇀𑆪𑆼𑆢𑆥𑆴 𑆖 𑆲𑆶𑆠𑆳𑆯𑆮𑆴𑆢𑇀𑆪𑆶𑆢𑆶𑆬𑇀𑆑𑆳𑆂 𑇆𑇖𑇙𑇆
𑆤 𑆨𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆟𑆩𑆼𑆢𑆤𑆠𑆼𑆰𑇀𑆮𑆩𑆸𑆢𑆶𑆂 𑆥𑇀𑆫𑆟𑆠𑆼𑆰𑇀𑆮𑆥𑆴 𑆱𑆳𑆤𑇀𑆠𑇀𑆮𑆤𑆢𑆳𑆤𑆫𑆶𑆖𑆴𑆂 𑇅 𑆨𑆮𑆠𑆵𑆲 𑆱𑆢𑆳 𑆮𑇀𑆪𑆡𑆴𑆠𑆳𑆱𑇀𑆪𑆓𑆠𑆴𑆂 𑆱 𑆨𑆮𑆼𑆢𑆴𑆲 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆂 𑇆𑇗𑇐𑇆
(𑆨𑆶𑆘𑆕𑇀𑆓𑆾𑆬𑆷𑆑𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆪𑆑𑇀𑆰𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆮𑆳𑆤𑆫𑆽𑆂 𑇅 𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆫𑇀𑆑𑇀𑆰𑆤𑆑𑆶𑆬𑆳𑆤𑆷𑆑𑆽𑆂 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆳𑆱𑇀𑆠𑆶 𑆤𑆫𑆳𑆂𑆱𑇀𑆩𑆸𑆠𑆳𑆂 ) 𑇆𑇗𑇑𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆠𑆶 𑆢𑆷𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑆵𑆮𑆫𑆤𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆑𑆯𑆫𑆑𑆳𑆟𑇀𑆝𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆮𑆫𑇀𑆟𑆂 𑆱𑆶𑆨𑆓𑆂 𑆥𑇀𑆫𑆴𑆪𑆢𑆫𑇀𑆯𑆤𑆾 𑆩𑆣𑆶𑆫𑆥𑇀𑆫𑆴𑆪𑆂 𑆑𑆸𑆠𑆘𑇀𑆚𑆾 𑆣𑆸𑆠𑆴𑆩𑆳𑆤𑇀 𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆫𑆬𑆾𑆬𑆶𑆥𑆾 𑆧𑆬𑆮𑆳𑆁𑆯𑇀𑆖𑆴𑆫𑆓𑇀𑆫𑆳𑆲𑆵 𑆢𑆸𑆞𑆮𑆽𑆫𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇗𑇒𑇆
𑆯𑆶𑆑𑇀𑆬𑆳𑆑𑇀𑆰𑆂 𑆱𑇀𑆡𑆴𑆫𑆑𑆶𑆛𑆴𑆬𑆳𑆬𑆴𑆤𑆵𑆬𑆑𑆼𑆯𑆾 𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆮𑆳𑆤𑇀 𑆘𑆬𑆢𑆩𑆸𑆢𑆕𑇀𑆓𑆱𑆴𑆁𑆲𑆔𑆾𑆰𑆂 𑇅 𑆱𑆶𑆥𑇀𑆠𑆂 𑆱𑆤𑇀 𑆱𑆑𑆩𑆬𑆲𑆁𑆱𑆖𑆑𑇀𑆫𑆮𑆳𑆑𑆳𑆤𑇀 𑆱𑆩𑇀𑆥𑆯𑇀𑆪𑆼𑆢𑆥𑆴 𑆖 𑆘𑆬𑆳𑆯𑆪𑆳𑆤𑇀 𑆩𑆤𑆾𑆘𑇀𑆚𑆳𑆤𑇀 𑇆𑇗𑇓𑇆
𑆫𑆑𑇀𑆠𑆳𑆤𑇀𑆠𑆤𑆼𑆠𑇀𑆫𑆂 𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆖𑇀𑆗𑆮𑆴𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆓𑆶𑆟𑆾𑆥𑆥𑆤𑇀𑆤𑆂 𑇅 𑆑𑇀𑆬𑆼𑆯𑆑𑇀𑆰𑆩𑆾 𑆩𑆳𑆤𑆪𑆴𑆠𑆳 𑆓𑆶𑆫𑆷𑆟𑆳𑆁 𑆘𑇀𑆚𑆼𑆪𑆾 𑆧𑆬𑆳𑆱𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆩𑆤𑆶𑆰𑇀𑆪𑆂 𑇆𑇗𑇔𑇆
(𑆢𑆸𑆞𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆠𑆴𑆂 𑆱𑇀𑆡𑆴𑆫𑆩𑆴𑆠𑇀𑆫𑆣𑆤𑆂 𑆥𑆫𑆴𑆓𑆟𑇀𑆪 𑆖𑆴𑆫𑆳𑆠𑇀 𑆥𑇀𑆫𑆢𑆢𑆳𑆠𑆴 𑆧𑆲𑆶 𑇅 𑆥𑆫𑆴𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆮𑆳𑆑𑇀𑆪𑆥𑆢𑆂 𑆱𑆠𑆠𑆁 𑆓𑆶𑆫𑆶𑆩𑆳𑆤𑆑𑆫𑆯𑇀𑆖 𑆨𑆮𑆼𑆠𑇀 𑆱 𑆱𑆢𑆳 𑇆𑇗𑇕𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑆶𑆢𑇀𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆮𑆫𑆶𑆟𑆽𑆂 𑆱𑆴𑆁𑆲𑆳𑆯𑇀𑆮𑆓𑆘𑆓𑆾𑆮𑆸𑆰𑆽𑆂 𑇅 𑆠𑆳𑆫𑇀𑆑𑇀𑆰𑇀𑆪𑆲𑆁𑆱𑆱𑆩𑆳𑆤𑆷𑆑𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆾 𑆤𑆫𑆳𑆂 ) 𑇆𑇗𑇖𑇆
𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆮𑆳 𑆠𑆴𑆱𑆸𑆟𑆳𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆤𑆳𑆁 𑆠𑆶 𑆬𑆑𑇀𑆰𑆟𑆽𑆂 𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆱𑆁𑆱𑆫𑇀𑆓𑆘𑆳 𑆮𑆽𑆢𑇀𑆪𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆫𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇗𑇗𑇆
𑆥𑇀𑆫𑆑𑆾𑆥𑆾 𑆮𑆳𑇁𑆤𑇀𑆪𑆡𑆳𑆨𑆳𑆮𑆾 𑆑𑇀𑆰𑆪𑆾 𑆮𑆳 𑆤𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆤𑆳𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆼𑆤 𑆘𑆳𑆪𑆠𑆼 𑆠𑆶 𑆓𑆠𑆳𑆪𑆶𑆰𑆂 𑇆𑇗𑇘𑇆
𑆮𑆴𑆰𑆘𑆳𑆠𑆾 𑆪𑆡𑆳 𑆑𑆵𑆛𑆾 𑆤 𑆮𑆴𑆰𑆼𑆟 𑆮𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆢𑇀𑆮𑆠𑇀𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆾 𑆩𑆫𑇀𑆠𑇀𑆪𑆁 𑆯𑆑𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑆴 𑆤 𑆧𑆳𑆣𑆴𑆠𑆶𑆩𑇀 𑇆𑇗𑇙𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆴𑆲 𑆤𑆫𑆳𑆟𑆳𑆁 𑆨𑆿𑆠𑆴𑆑𑆵𑆁 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂 𑆥𑆮𑆤𑆢𑆲𑆤𑆠𑆾𑆪𑆽𑆂 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆠𑆴𑆱𑇀𑆫𑆂 𑇅 𑆱𑇀𑆡𑆴𑆫𑆮𑆴𑆥𑆶𑆬𑆯𑆫𑆵𑆫𑆂 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆯𑇀𑆖 𑆑𑇀𑆰𑆩𑆳𑆮𑆳𑆚𑇀 𑆯𑆶𑆖𑆴𑆫𑆡 𑆖𑆴𑆫𑆘𑆵𑆮𑆵 𑆤𑆳𑆨𑆱𑆂 𑆒𑆽𑆫𑇀𑆩𑆲𑆢𑇀𑆨𑆴𑆂 𑇆𑇘𑇐𑇆
𑆯𑆿𑆖𑆩𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆩𑆨𑇀𑆪𑆳𑆱𑆾 𑆮𑆼𑆢𑆼𑆰𑆶 𑆓𑆶𑆫𑆶𑆥𑆷𑆘𑆤𑆩𑇀 𑇅 𑆥𑇀𑆫𑆴𑆪𑆳𑆠𑆴𑆡𑆴𑆠𑇀𑆮𑆩𑆴𑆘𑇀𑆪𑆳 𑆖 𑆧𑇀𑆫𑆲𑇀𑆩𑆑𑆳𑆪𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇘𑇑𑇆
𑆩𑆳𑆲𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆯𑆿𑆫𑇀𑆪𑆩𑆳𑆘𑇀𑆚𑆳 𑆖 𑆱𑆠𑆠𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆧𑆶𑆢𑇀𑆣𑆴𑆠𑆳 𑇅 𑆨𑆸𑆠𑇀𑆪𑆳𑆤𑆳𑆁 𑆨𑆫𑆟𑆁 𑆖𑆳𑆥𑆴 𑆩𑆳𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇘𑇒𑇆
𑆯𑆵𑆠𑆱𑆼𑆮𑆳 𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆁 𑆥𑆽𑆕𑇀𑆓𑆬𑇀𑆪𑆁 𑆲𑆫𑆴𑆑𑆼𑆯𑆠𑆳 𑇅 𑆥𑇀𑆫𑆴𑆪𑆮𑆳𑆢𑆴𑆠𑇀𑆮𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆮𑆳𑆫𑆶𑆟𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇘𑇓𑇆
𑆩𑆣𑇀𑆪𑆱𑇀𑆡𑆠𑆳 𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆩𑆫𑇀𑆡𑆱𑇀𑆪𑆳𑆓𑆩𑆱𑆚𑇀𑆖𑆪𑆿 𑇅 𑆩𑆲𑆳𑆥𑇀𑆫𑆱𑆮𑆯𑆑𑇀𑆠𑆴𑆠𑇀𑆮𑆁 𑆑𑆿𑆧𑆼𑆫𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇘𑇔𑇆
𑆓𑆤𑇀𑆣𑆩𑆳𑆬𑇀𑆪𑆥𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆁 𑆖 𑆤𑆸𑆠𑇀𑆪𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆑𑆳𑆩𑆴𑆠𑆳 𑇅 𑆮𑆴𑆲𑆳𑆫𑆯𑆵𑆬𑆠𑆳 𑆖𑆽𑆮 𑆓𑆳𑆤𑇀𑆣𑆫𑇀𑆮𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇘𑇕𑇆
𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆫𑆵 𑆢𑆸𑆞𑆾𑆠𑇀𑆡𑆳𑆤𑆾 𑆤𑆴𑆫𑇀𑆨𑆪𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆚𑇀𑆗𑆶𑆖𑆴𑆂 𑇅 𑆫𑆳𑆓𑆩𑆾𑆲𑆩𑆢𑆢𑇀𑆮𑆼𑆰𑆽𑆫𑇀𑆮𑆫𑇀𑆘𑆴𑆠𑆾 𑆪𑆳𑆩𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆳𑆤𑇀 𑇆𑇘𑇖𑇆
𑆘𑆥𑆮𑇀𑆫𑆠𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆲𑆾𑆩𑆳𑆣𑇀𑆪𑆪𑆤𑆱𑆼𑆮𑆴𑆤𑆩𑇀 𑇅 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆸𑆰𑆴𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆤𑆫𑆁 𑆮𑆴𑆢𑆶𑆂 𑇆𑇘𑇗𑇆
𑆱𑆥𑇀𑆠𑆽𑆠𑆼 𑆱𑆳𑆠𑇀𑆠𑇀𑆮𑆴𑆑𑆳𑆂 𑆑𑆳𑆪𑆳... 𑇅𑇘𑇘𑇅 ...𑆫𑆳𑆘𑆱𑆳𑆁𑆱𑇀𑆠𑆶 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇅 𑆎𑆯𑇀𑆮𑆫𑇀𑆪𑆮𑆤𑇀𑆠𑆁 𑆫𑆿𑆢𑇀𑆫𑆁 𑆖 𑆯𑆷𑆫𑆁 𑆖𑆟𑇀𑆝𑆩𑆱𑆷𑆪𑆑𑆩𑇀 𑇆𑇘𑇘𑇆
𑆍𑆑𑆳𑆯𑆴𑆤𑆁 𑆖𑆿𑆢𑆫𑆴𑆑𑆩𑆳𑆱𑆶𑆫𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆵𑆢𑆸𑆯𑆩𑇀 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆳𑆪𑆳𑆱𑆴𑆤𑆁 𑆨𑆵𑆫𑆶𑆁 𑆖𑆟𑇀𑆝𑆁 𑆩𑆳𑆪𑆳𑆤𑇀𑆮𑆴𑆠𑆁 𑆠𑆡𑆳 𑇆𑇘𑇙𑇆
𑆮𑆴𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆖𑆥𑆬𑆁 𑆱𑆫𑇀𑆥𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆮𑆴𑆢𑆶𑆫𑇀𑆤𑆫𑆩𑇀 𑇅 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆑𑆳𑆩𑆱𑆼𑆮𑆵 𑆖𑆳𑆥𑇀𑆪𑆘𑆱𑇀𑆫𑆳𑆲𑆳𑆫 𑆍𑆮 𑆖 𑇆𑇙𑇐𑇆
𑆃𑆩𑆫𑇀𑆰𑆟𑆾𑇁𑆤𑆮𑆱𑇀𑆡𑆳𑆪𑆵 𑆯𑆳𑆑𑆶𑆤𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆍𑆑𑆳𑆤𑇀𑆠𑆓𑇀𑆫𑆳𑆲𑆴𑆠𑆳 𑆫𑆿𑆢𑇀𑆫𑆩𑆱𑆷𑆪𑆳 𑆣𑆫𑇀𑆩𑆧𑆳𑆲𑇀𑆪𑆠𑆳 𑇆𑇙𑇑𑇆
𑆨𑆸𑆯𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆩𑆯𑇀𑆖𑆳𑆥𑆴 𑆫𑆳𑆑𑇀𑆰𑆱𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆇𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆠𑆳 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆱𑆳𑆲𑆱𑆥𑇀𑆫𑆴𑆪𑆠𑆳 𑆠𑆡𑆳 𑇆𑇙𑇒𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆬𑆾𑆬𑆶𑆥𑆠𑇀𑆮𑆁 𑆤𑆽𑆫𑇀𑆬𑆘𑇀𑆘𑇀𑆪𑆁 𑆥𑆽𑆯𑆳𑆖𑆁 𑆑𑆳𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆃𑆱𑆁𑆮𑆴𑆨𑆳𑆓𑆩𑆬𑆱𑆁 𑆢𑆶𑆂𑆒𑆯𑆵𑆬𑆩𑆱𑆷𑆪𑆑𑆩𑇀 𑇆𑇙𑇓𑇆
𑆬𑆾𑆬𑆶𑆥𑆁 𑆖𑆳𑆥𑇀𑆪𑆢𑆳𑆠𑆳𑆫𑆁 𑆥𑇀𑆫𑆼𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆮𑆴𑆢𑆶𑆫𑇀𑆤𑆫𑆩𑇀 𑇅 𑆰𑆝𑆼𑆠𑆼 𑆫𑆳𑆘𑆱𑆳𑆂 𑆑𑆳𑆪𑆳𑆂,.. 𑇅𑇙𑇕𑇅 ...𑆠𑆳𑆩𑆱𑆳𑆁𑆱𑇀𑆠𑆶 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇆𑇙𑇔𑇆
𑆢𑆶𑆫𑇀𑆩𑆼𑆣𑆱𑇀𑆠𑇀𑆮𑆁 𑆩𑆤𑇀𑆢𑆠𑆳 𑆖 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆩𑆽𑆡𑆶𑆤𑆤𑆴𑆠𑇀𑆪𑆠𑆳 𑇅 𑆤𑆴𑆫𑆳𑆑𑆫𑆴𑆰𑇀𑆟𑆶𑆠𑆳 𑆖𑆽𑆮 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑆳𑆯𑆮𑆳 𑆓𑆶𑆟𑆳𑆂 𑇆𑇙𑇕𑇆
𑆃𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆠𑆳 𑆩𑆿𑆫𑇀𑆒𑇀𑆪𑆁 𑆨𑆵𑆫𑆶𑆠𑇀𑆮𑆁 𑆱𑆬𑆴𑆬𑆳𑆫𑇀𑆡𑆴𑆠𑆳 𑇅 𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆨𑆴𑆩𑆫𑇀𑆢𑆯𑇀𑆖 𑆩𑆠𑇀𑆱𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇙𑇖𑇆
𑆍𑆑𑆱𑇀𑆡𑆳𑆤𑆫𑆠𑆴𑆫𑇀𑆤𑆴𑆠𑇀𑆪𑆩𑆳𑆲𑆳𑆫𑆼 𑆑𑆼𑆮𑆬𑆼 𑆫𑆠𑆂 𑇅 𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆾 𑆤𑆫𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆣𑆫𑇀𑆩𑆑𑆳𑆩𑆳𑆫𑇀𑆡𑆮𑆫𑇀𑆘𑆴𑆠𑆂 𑇆𑇙𑇗𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑆂 𑆑𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆮𑆽 𑆠𑆳𑆩𑆱𑆳𑆱𑇀𑆠𑆡𑆳 𑇅𑇙𑇘𑇅 𑆑𑆳𑆪𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆫𑇀𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆠𑇀𑆮𑆤𑆶𑆫𑆷𑆥𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆖𑆫𑆼𑆠𑇀 𑇆𑇙𑇘𑇆
𑆩𑆲𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆳 𑆫𑆘𑆂𑆱𑆠𑇀𑆠𑇀𑆮𑆠𑆩𑆂𑆑𑆸𑆠𑆳𑆂 𑇅 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆬𑆑𑇀𑆰𑆟𑆠𑆂 𑆱𑆩𑇀𑆪𑆓𑇀𑆨𑆴𑆰𑆑𑇀 𑆠𑆳𑆯𑇀𑆖 𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇙𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆫𑆵𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆮𑇀𑆪𑆳𑆑𑆫𑆟𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆁 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆱𑇀𑆡𑆩𑆳𑆠𑇀𑆩𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆁 ‘𑆓𑆫𑇀𑆨’ 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆠𑆁 𑆖𑆼𑆠𑆤𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆁 𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆴𑆨𑆘𑆠𑆴, 𑆠𑆼𑆘 𑆍𑆤𑆁 𑆥𑆖𑆠𑆴, 𑆄𑆥𑆂 𑆑𑇀𑆬𑆼𑆢𑆪𑆤𑇀𑆠𑆴, 𑆥𑆸𑆡𑆴𑆮𑆵 𑆱𑆁𑆲𑆤𑇀𑆠𑆴, 𑆄𑆑𑆳𑆯𑆁 𑆮𑆴𑆮𑆫𑇀𑆣𑆪𑆠𑆴; 𑆍𑆮𑆁 𑆮𑆴𑆮𑆫𑇀𑆣𑆴𑆠𑆂 𑆱 𑆪𑆢𑆳 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆘𑆴𑆲𑇀𑆮𑆳𑆔𑇀𑆫𑆳𑆟𑆑𑆫𑇀𑆟𑆤𑆴𑆠𑆩𑇀𑆧𑆳𑆢𑆴𑆨𑆴𑆫𑆕𑇀𑆓𑆽𑆫𑆶𑆥𑆼𑆠𑆱𑇀𑆠𑆢𑆳 ‘𑆯𑆫𑆵𑆫𑆁’ 𑆅𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆠𑆼 𑇅 𑆠𑆖𑇀𑆖 𑆰𑆝𑆕𑇀𑆓𑆁- 𑆯𑆳𑆒𑆳𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆾, 𑆩𑆣𑇀𑆪𑆁 𑆥𑆚𑇀𑆖𑆩𑆁, 𑆰𑆰𑇀𑆜𑆁 𑆯𑆴𑆫 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆃𑆠𑆂 𑆥𑆫𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼- 𑆩𑆱𑇀𑆠𑆑𑆾𑆢𑆫𑆥𑆸𑆰𑇀𑆜𑆤𑆳𑆨𑆴𑆬𑆬𑆳𑆛𑆤𑆳𑆱𑆳𑆖𑆴𑆧𑆶𑆑𑆧𑆱𑇀𑆠𑆴𑆓𑇀𑆫𑆵𑆮𑆳 𑆅𑆠𑇀𑆪𑆼𑆠𑆳 𑆍𑆑𑆽𑆑𑆳𑆂, 𑆑𑆫𑇀𑆟𑆤𑆼𑆠𑇀𑆫𑆨𑇀𑆫𑆷𑆯𑆕𑇀𑆒𑆳𑆁𑆱𑆓𑆟𑇀𑆝𑆑𑆑𑇀𑆰𑆱𑇀𑆠𑆤𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆮𑆸𑆰𑆟𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑇀𑆦𑆴𑆓𑇀𑆘𑆳𑆤𑆶𑆑𑆷𑆫𑇀𑆥𑆫𑆧𑆳𑆲𑆷𑆫𑆶𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼, 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆕𑇀𑆓𑆶𑆬𑆪𑆂, 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆩𑆳𑆟𑆳𑆤𑆴 , 𑆍𑆰 𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆨𑆳𑆓 𑆇𑆑𑇀𑆠𑆂 𑇆𑇔𑇆
𑆠𑆱𑇀𑆪 𑆥𑆶𑆤𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆤𑆁 - 𑆠𑇀𑆮𑆖𑆂 𑆑𑆬𑆳 𑆣𑆳𑆠𑆮𑆾 𑆩𑆬𑆳 𑆢𑆾𑆰𑆳 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆿 𑆦𑆶𑆥𑇀𑆦𑆶𑆱 𑆇𑆟𑇀𑆝𑆶𑆑𑆾 𑆲𑆸𑆢𑆪𑆩𑆳𑆯𑆪𑆳 𑆃𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆮𑆸𑆑𑇀𑆑𑆿 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆑𑆟𑇀𑆝𑆫𑆳 𑆘𑆳𑆬𑆳𑆤𑆴 𑆑𑆷𑆫𑇀𑆖𑆳 𑆫𑆘𑇀𑆘𑆮𑆂 𑆱𑆼𑆮𑆤𑇀𑆪𑆂 𑆱𑆕𑇀𑆔𑆳𑆠𑆳𑆂 𑆱𑆵𑆩𑆤𑇀𑆠𑆳 𑆃𑆱𑇀𑆡𑆵𑆤𑆴 𑆱𑆤𑇀𑆣𑆪𑆂 𑆱𑇀𑆤𑆳𑆪𑆮𑆂 𑆥𑆼𑆯𑇀𑆪𑆾 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆱𑆴𑆫𑆳 𑆣𑆩𑆤𑇀𑆪𑆾 𑆪𑆾𑆓𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆖 𑇆𑇕𑇆
𑆠𑇀𑆮𑆖𑆂 𑆱𑆥𑇀𑆠, 𑆑𑆬𑆳𑆂 𑆱𑆥𑇀𑆠, 𑆄𑆯𑆪𑆳𑆂 𑆱𑆥𑇀𑆠, 𑆣𑆳𑆠𑆮𑆂 𑆱𑆥𑇀𑆠, 𑆱𑆥𑇀𑆠 𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴, 𑆥𑆚𑇀𑆖 𑆥𑆼𑆯𑆵𑆯𑆠𑆳𑆤𑆴, 𑆤𑆮 𑆱𑇀𑆤𑆳𑆪𑆶𑆯𑆠𑆳𑆤𑆴, 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆱𑇀𑆡𑆴𑆯𑆠𑆳𑆤𑆴, 𑆢𑇀𑆮𑆼 𑆢𑆯𑆾𑆠𑇀𑆠𑆫𑆼 𑆱𑆤𑇀𑆣𑆴𑆯𑆠𑆼, 𑆱𑆥𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆩𑆫𑇀𑆩𑆯𑆠𑆁, 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳𑆂, 𑆠𑇀𑆫𑆪𑆾 𑆩𑆬𑆳𑆂, 𑆤𑆮 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴, (𑆰𑆾𑆝𑆯 𑆑𑆟𑇀𑆝𑆫𑆳𑆂, 𑆰𑆾𑆝𑆯 𑆘𑆳𑆬𑆳𑆤𑆴, 𑆰𑆛𑇀 𑆑𑆷𑆫𑇀𑆖𑆳𑆂, 𑆖𑆠𑆱𑇀𑆫𑆾 𑆫𑆘𑇀𑆘𑆮𑆂, 𑆱𑆥𑇀𑆠 𑆱𑆼𑆮𑆤𑇀𑆪𑆂, 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆱𑆕𑇀𑆔𑆳𑆠𑆳𑆂, 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆱𑆵𑆩𑆤𑇀𑆠𑆳𑆂, 𑆢𑇀𑆮𑆳𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆪𑆾𑆓𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴, 𑆢𑇀𑆮𑆴𑆑𑆳𑆤𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 ) 𑆖𑆼𑆠𑆴 𑆱𑆩𑆳𑆱𑆂 𑇆𑇖𑇆
𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆾𑇁𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁- 𑆠𑇀𑆮𑆖𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆳𑆂 𑆑𑆬𑆳 𑆣𑆳𑆠𑆮𑆾 𑆩𑆬𑆳 𑆢𑆾𑆰𑆳 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆿 𑆦𑆶𑆥𑇀𑆦𑆶𑆱 𑆇𑆟𑇀𑆝𑆶𑆑𑆾 𑆲𑆸𑆢𑆪𑆁 𑆮𑆸𑆑𑇀𑆑𑆿 𑆖 𑇆𑇗𑇆
𑆄𑆯𑆪𑆳𑆱𑇀𑆠𑆶- 𑆮𑆳𑆠𑆳𑆯𑆪𑆂, 𑆥𑆴𑆠𑇀𑆠𑆳𑆯𑆪𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆯𑆪𑆾, 𑆫𑆑𑇀𑆠𑆳𑆯𑆪, 𑆄𑆩𑆳𑆯𑆪𑆂, 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆾, 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆂 , 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆾𑇁𑆰𑇀𑆛𑆩 𑆅𑆠𑆴 𑇆𑇘𑇆
𑆱𑆳𑆫𑇀𑆣𑆠𑇀𑆫𑆴𑆮𑇀𑆪𑆳𑆩𑆳𑆤𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑆶𑆁𑆱𑆳𑆁, 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆩𑆫𑇀𑆣𑆮𑇀𑆪𑆳𑆩𑆲𑆵𑆤𑆳𑆤𑆴 𑇆𑇙𑇆
𑆯𑇀𑆫𑆮𑆟𑆤𑆪𑆤𑆮𑆢𑆤𑆔𑇀𑆫𑆳𑆟𑆓𑆶𑆢𑆩𑆼𑆞𑇀𑆫𑆳𑆟𑆴 𑆤𑆮 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆤𑆫𑆳𑆟𑆳𑆁 𑆧𑆲𑆴𑆫𑇀𑆩𑆶𑆒𑆳𑆤𑆴, 𑆍𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆩𑆥𑆫𑆳𑆟𑆴 𑆖 𑆠𑇀𑆫𑆵𑆟𑆴 𑆢𑇀𑆮𑆼 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑆣𑆱𑇀𑆠𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆮𑆲𑆁 𑆖 𑇆𑇑𑇐𑇆
𑆰𑆾𑆝𑆯 𑆑𑆟𑇀𑆝𑆫𑆳𑆂- 𑆠𑆳𑆱𑆳𑆁 𑆖𑆠𑆱𑇀𑆫𑆂 𑆥𑆳𑆢𑆪𑆾𑆂, 𑆠𑆳𑆮𑆠𑇀𑆪𑆾 𑆲𑆱𑇀𑆠𑆓𑇀𑆫𑆵𑆮𑆳𑆥𑆸𑆰𑇀𑆜𑆼𑆰𑆶; 𑆠𑆠𑇀𑆫 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆓𑆠𑆳𑆤𑆳𑆁 𑆑𑆟𑇀𑆝𑆫𑆳𑆟𑆳𑆁 𑆤𑆒𑆳 𑆃𑆓𑇀𑆫𑆥𑇀𑆫𑆫𑆾𑆲𑆳𑆂, 𑆓𑇀𑆫𑆵𑆮𑆳𑆲𑆸𑆢𑆪𑆤𑆴𑆧𑆤𑇀𑆣𑆴𑆤𑆵𑆤𑆳𑆩𑆣𑆾𑆨𑆳𑆓𑆓𑆠𑆳𑆤𑆳𑆁 𑆩𑆼𑆞𑇀𑆫𑆁, 𑆯𑇀𑆫𑆾𑆟𑆴𑆥𑆸𑆰𑇀𑆛𑆤𑆴𑆧𑆤𑇀𑆣𑆴𑆤𑆵𑆤𑆳𑆩𑆣𑆾𑆨𑆳𑆓𑆓𑆠𑆳𑆤𑆳𑆁 𑆧𑆴𑆩𑇀𑆧𑆁 , 𑆩𑆷𑆫𑇀𑆣𑆾𑆫𑆶𑆮𑆑𑇀𑆰𑆾𑆁𑇁𑆱𑆥𑆴𑆟𑇀𑆝𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑇆𑇑𑇑𑇆
𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆘𑆳𑆬𑆳𑆤𑆴 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆁 𑆖𑆠𑇀𑆮𑆳𑆫𑆴; 𑆠𑆳𑆤𑆴 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆓𑆶𑆬𑇀𑆦𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆥𑆫𑆱𑇀𑆥𑆫𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆤𑆴 𑆥𑆫𑆱𑇀𑆥𑆫𑆓𑆮𑆳𑆑𑇀𑆰𑆴𑆠𑆳𑆤𑆴 𑆖𑆼𑆠𑆴, 𑆪𑆽𑆫𑇀𑆓𑆮𑆳𑆑𑇀𑆰𑆴𑆠𑆩𑆴𑆢𑆁 𑆯𑆫𑆵𑆫𑆩𑇀 𑇆𑇑𑇒𑇆
𑆰𑆛𑇀 𑆑𑆷𑆫𑇀𑆖𑆳𑆂, 𑆠𑆼 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆓𑇀𑆫𑆵𑆮𑆳𑆩𑆼𑆞𑇀𑆫𑆼𑆰𑆶; 𑆲𑆱𑇀𑆠𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆿, 𑆥𑆳𑆢𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆿, 𑆓𑇀𑆫𑆵𑆮𑆳𑆩𑆼𑆞𑇀𑆫𑆪𑆾𑆫𑆼𑆑𑆽𑆑𑆂 𑇆𑇑𑇓𑇆
𑆩𑆲𑆠𑇀𑆪𑆾 𑆩𑆳𑆁𑆱𑆫𑆘𑇀𑆘𑆮𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂- 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆩𑆶𑆨𑆪𑆠𑆂 𑆥𑆼𑆯𑆵𑆤𑆴𑆧𑆤𑇀𑆣𑆤𑆳𑆫𑇀𑆡𑆁 𑆢𑇀𑆮𑆼 𑆧𑆳𑆲𑇀𑆪𑆼, 𑆄𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆼 𑆖 𑆢𑇀𑆮𑆼 𑇆𑇑𑇔𑇆
𑆱𑆥𑇀𑆠 𑆱𑆼𑆮𑆤𑇀𑆪𑆂 ; 𑆱𑆴𑆫𑆱𑆴 𑆮𑆴𑆨𑆑𑇀𑆠𑆳𑆂 𑆥𑆚𑇀𑆖, 𑆘𑆴𑆲𑇀𑆮𑆳𑆯𑆼𑆦𑆱𑆾𑆫𑆼𑆑𑆽𑆑𑆳; 𑆠𑆳𑆂 𑆥𑆫𑆴𑆲𑆫𑇀𑆠𑆮𑇀𑆪𑆳𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑇆𑇑𑇕𑇆
𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆱𑆕𑇀𑆔𑆳𑆠𑆳𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑆪𑆾 𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑆶𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼𑆰𑆶, 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿, 𑆠𑇀𑆫𑆴𑆑𑆯𑆴𑆫𑆱𑆾𑆫𑆼𑆑𑆽𑆑𑆂 𑇆𑇑𑇖𑇆
𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆽𑆮 𑆱𑆵𑆩𑆤𑇀𑆠𑆳𑆂; 𑆠𑆼 𑆖𑆳𑆱𑇀𑆡𑆴𑆱𑆕𑇀𑆔𑆳𑆠𑆮𑆢𑇀𑆓𑆟𑆤𑆵𑆪𑆳𑆂, 𑆪𑆠𑆱𑇀𑆠𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳 𑆃𑆱𑇀𑆡𑆴𑆱𑆕𑇀𑆔𑆳𑆠𑆳𑆂; 𑆪𑆼 𑆲𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆱𑆕𑇀𑆔𑆳𑆠𑆳𑆱𑇀𑆠𑆼 𑆒𑆬𑇀𑆮𑆰𑇀𑆛𑆳𑆢𑆯𑆽𑆑𑆼𑆰𑆳𑆩𑇀 𑇆𑇑𑇗𑇆
𑆠𑇀𑆫𑆵𑆟𑆴 𑆱𑆰𑆰𑇀𑆛𑆳𑆤𑇀𑆪𑆱𑇀𑆡𑆴𑆯𑆠𑆳𑆤𑆴 𑆮𑆼𑆢𑆮𑆳𑆢𑆴𑆤𑆾 𑆨𑆳𑆰𑆤𑇀𑆠𑆼; 𑆯𑆬𑇀𑆪𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑆶 𑆠𑆶 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆼𑆮 𑆯𑆠𑆳𑆤𑆴 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑆮𑆴𑆁𑆯𑆩𑆱𑇀𑆡𑆴𑆯𑆠𑆁 𑆯𑆳𑆒𑆳𑆱𑆶, 𑆱𑆥𑇀𑆠𑆢𑆯𑆾𑆠𑇀𑆠𑆫𑆁 𑆯𑆠𑆁 𑆯𑇀𑆫𑆾𑆟𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆾𑆫𑆂𑆱𑆶, 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆂, 𑆍𑆮𑆩𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆠𑇀𑆫𑆵𑆟𑆴 𑆯𑆠𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇑𑇘𑇆
𑆍𑆑𑆽𑆑𑆱𑇀𑆪𑆳𑆁 𑆠𑆶 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑆁 𑆠𑇀𑆫𑆵𑆟𑆴 𑆠𑇀𑆫𑆵𑆟𑆴 𑆠𑆳𑆤𑆴 𑆥𑆚𑇀𑆖𑆢𑆯, 𑆠𑆬𑆑𑆷𑆫𑇀𑆖𑆓𑆶𑆬𑇀𑆦𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆢𑆯, 𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆩𑆼𑆑𑆁, 𑆘𑆕𑇀𑆔𑆳𑆪𑆳𑆁 𑆢𑇀𑆮𑆼, 𑆘𑆳𑆤𑆶𑆤𑇀𑆪𑆼𑆑𑆩𑇀, 𑆍𑆑𑆩𑆷𑆫𑆳𑆮𑆴𑆠𑆴, 𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆼𑆮𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆯𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆥𑆚𑇀𑆖, 𑆠𑆼𑆰𑆳𑆁 𑆓𑆶𑆢𑆨𑆓𑆤𑆴𑆠𑆩𑇀𑆧𑆼𑆰𑆶 𑆖𑆠𑇀𑆮𑆳𑆫𑆴, 𑆠𑇀𑆫𑆴𑆑𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆩𑆼𑆑𑆁, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 , 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁, 𑆥𑆸𑆰𑇀𑆜𑆼 𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀, 𑆃𑆰𑇀𑆛𑆳𑆮𑆶𑆫𑆱𑆴 , 𑆢𑇀𑆮𑆼 𑆃𑆁𑆱𑆦𑆬𑆑𑆼 ; 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁 𑆤𑆮, 𑆑𑆟𑇀𑆜𑆤𑆳𑆝𑇀𑆪𑆳𑆁 𑆖𑆠𑇀𑆮𑆳𑆫𑆴, 𑆢𑇀𑆮𑆼 𑆲𑆤𑇀𑆮𑆾𑆂 , 𑆢𑆤𑇀𑆠𑆳 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀, 𑆤𑆳𑆱𑆳𑆪𑆳𑆁 𑆠𑇀𑆫𑆵𑆟𑆴, 𑆍𑆑𑆁 𑆠𑆳𑆬𑆶𑆤𑆴, 𑆓𑆟𑇀𑆝𑆑𑆫𑇀𑆟𑆯𑆕𑇀𑆒𑆼𑆰𑇀𑆮𑆼𑆑𑆽𑆑𑆁, 𑆰𑆛𑇀 𑆯𑆴𑆫𑆱𑆵𑆠𑆴 𑇆𑇑𑇙𑇆
𑆍𑆠𑆳𑆤𑆴 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆥𑆳𑆬𑆫𑆶𑆖𑆑𑆠𑆫𑆶𑆟𑆮𑆬𑆪𑆤𑆬𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆤𑆴 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆘𑆳𑆤𑆶𑆤𑆴𑆠𑆩𑇀𑆧𑆳𑆁𑆱𑆓𑆟𑇀𑆝𑆠𑆳𑆬𑆶𑆯𑆕𑇀𑆒𑆯𑆴𑆫𑆂𑆱𑆶 𑆑𑆥𑆳𑆬𑆳𑆤𑆴, 𑆢𑆯𑆤𑆳𑆱𑇀𑆠𑆶 𑆫𑆶𑆖𑆑𑆳𑆤𑆴 , 𑆔𑇀𑆫𑆳𑆟𑆑𑆫𑇀𑆟𑆓𑇀𑆫𑆵𑆮𑆳𑆑𑇀𑆰𑆴𑆑𑆾𑆰𑆼𑆰𑆶 𑆠𑆫𑆶𑆟𑆳𑆤𑆴, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆾𑆫𑆂𑆱𑆶 𑆮𑆬𑆪𑆳𑆤𑆴 , 𑆯𑆼𑆰𑆳𑆟𑆴 𑆤𑆬𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆤𑆴 𑇆𑇒𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆓𑆠𑆽𑆂 𑆱𑆳𑆫𑆽𑆫𑇀𑆪𑆡𑆳 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆨𑆷𑆫𑆶𑆲𑆳𑆂 𑇅 𑆃𑆱𑇀𑆡𑆴𑆱𑆳𑆫𑆽𑆱𑇀𑆠𑆡𑆳 𑆢𑆼𑆲𑆳 𑆣𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆣𑇀𑆫𑆶𑆮𑆩𑇀 𑇆𑇒𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆖𑆴𑆫𑆮𑆴𑆤𑆰𑇀𑆛𑆼𑆰𑆶 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆼𑆰𑆶 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆃𑆱𑇀𑆡𑆵𑆤𑆴 𑆤 𑆮𑆴𑆤𑆯𑇀𑆪𑆤𑇀𑆠𑆴 𑆱𑆳𑆫𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆤𑆴 𑆱𑆴𑆫𑆳𑆨𑆴𑆂 𑆱𑇀𑆤𑆳𑆪𑆶𑆨𑆴𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆱𑇀𑆡𑆵𑆤𑇀𑆪𑆳𑆬𑆩𑇀𑆧𑆤𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤 𑆯𑆵𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆥𑆠𑆤𑇀𑆠𑆴 𑆮𑆳 𑇆𑇒𑇓𑇆
𑆱𑆤𑇀𑆣𑆪𑆱𑇀𑆠𑆶 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆮𑆤𑇀𑆠𑆂 , 𑆱𑇀𑆡𑆴𑆫𑆳𑆯𑇀𑆖 𑇆𑇒𑇔𑇆
𑆯𑆳𑆒𑆳𑆱𑆶 𑆲𑆤𑇀𑆮𑆾𑆂 𑆑𑆛𑇀𑆪𑆳𑆁 𑆖 𑆖𑆼𑆰𑇀𑆛𑆳𑆮𑆤𑇀𑆠𑆱𑇀𑆠𑆶 𑆱𑆤𑇀𑆣𑆪𑆂 𑇅 𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆶 𑆱𑆤𑇀𑆣𑆪𑆂 𑆱𑆫𑇀𑆮𑆼 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆲𑆴 𑆱𑇀𑆡𑆴𑆫𑆳 𑆧𑆶𑆣𑆽𑆂 𑇆𑇒𑇕𑇆
𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆱𑇀𑆠𑆶 𑆢𑆯𑆾𑆠𑇀𑆠𑆫𑆼 𑆢𑇀𑆮𑆼 𑆯𑆠𑆼 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆯𑆳𑆒𑆳𑆱𑇀𑆮𑆰𑇀𑆛𑆰𑆰𑇀𑆛𑆴𑆂, 𑆍𑆑𑆾𑆤𑆰𑆰𑇀𑆛𑆴𑆂 𑆑𑆾𑆰𑇀𑆜𑆼, 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑇀𑆫𑇀𑆪𑆯𑆵𑆠𑆴𑆂 𑇅 𑆍𑆑𑆽𑆑𑆱𑇀𑆪𑆳𑆁 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑆁 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆂, 𑆢𑇀𑆮𑆳𑆮𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆼, 𑆠𑆼 𑆖𑆠𑆶𑆫𑇀𑆢𑆯; 𑆘𑆳𑆤𑆶𑆓𑆶𑆬𑇀𑆦𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼𑆰𑇀𑆮𑆼𑆑𑆽𑆑𑆂, 𑆍𑆮𑆁 𑆱𑆥𑇀𑆠𑆢𑆯𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆠𑇀𑆫𑆪𑆂 𑆑𑆛𑆵𑆑𑆥𑆳𑆬𑆼𑆰𑆶, 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆼, 𑆠𑆳𑆮𑆤𑇀𑆠 𑆍𑆮 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂, 𑆇𑆫𑆱𑇀𑆪𑆰𑇀𑆛𑆿; 𑆠𑆳𑆮𑆤𑇀𑆠 𑆍𑆮 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁, 𑆠𑇀𑆫𑆪𑆂 𑆑𑆟𑇀𑆜𑆼, 𑆤𑆳𑆝𑆵𑆰𑆶 𑆲𑆸𑆢𑆪𑆑𑇀𑆬𑆾𑆩𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆱𑇀𑆮𑆰𑇀𑆛𑆳𑆢𑆯, 𑆢𑆤𑇀𑆠𑆥𑆫𑆴𑆩𑆳𑆟𑆳 𑆢𑆤𑇀𑆠𑆩𑆷𑆬𑆼𑆰𑆶, 𑆍𑆑𑆂 𑆑𑆳𑆑𑆬𑆑𑆼 𑆤𑆳𑆱𑆳𑆪𑆳𑆁 𑆖, 𑆢𑇀𑆮𑆿 𑆮𑆫𑇀𑆠𑇀𑆩𑆩𑆟𑇀𑆝𑆬𑆪𑆾𑆫𑇀𑆤𑆼𑆠𑇀𑆫𑆳𑆯𑇀𑆫𑆪𑆿, 𑆓𑆟𑇀𑆝𑆑𑆫𑇀𑆟𑆯𑆕𑇀𑆒𑆼𑆰𑇀𑆮𑆼𑆑𑆽𑆑𑆂, 𑆢𑇀𑆮𑆿 𑆲𑆤𑆶𑆱𑆤𑇀𑆣𑆵, 𑆢𑇀𑆮𑆳𑆮𑆶𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆢𑇀𑆨𑇀𑆫𑆶𑆮𑆾𑆂 𑆯𑆕𑇀𑆒𑆪𑆾𑆯𑇀𑆖, 𑆥𑆚𑇀𑆖 𑆯𑆴𑆫𑆂𑆑𑆥𑆳𑆬𑆼𑆰𑆶, 𑆍𑆑𑆾 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑇆𑇒𑇖𑇆
𑆠 𑆍𑆠𑆼 𑆱𑆤𑇀𑆣𑆪𑆾𑇁𑆰𑇀𑆛𑆮𑆴𑆣𑆳𑆂- 𑆑𑆾𑆫𑆾𑆬𑆷𑆒𑆬𑆱𑆳𑆩𑆶𑆢𑇀𑆓𑆥𑇀𑆫𑆠𑆫𑆠𑆶𑆤𑇀𑆤𑆱𑆼𑆮𑆤𑆵𑆮𑆳𑆪𑆱𑆠𑆶𑆟𑇀𑆝𑆩𑆟𑇀𑆝𑆬𑆯𑆕𑇀𑆒𑆳𑆮𑆫𑇀𑆠𑆳𑆂 𑇅 𑆠𑆼𑆰𑆳𑆩𑆕𑇀𑆓𑆶𑆬𑆴𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑆶𑆑𑆷𑆫𑇀𑆥𑆫𑆼𑆰𑆶 𑆑𑆾𑆫𑆳𑆂 𑆱𑆤𑇀𑆣𑆪𑆂, 𑆑𑆑𑇀𑆰𑆳𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆢𑆯𑆤𑆼𑆰𑆷𑆬𑆷𑆒𑆬𑆳𑆂, 𑆃𑆁𑆱𑆥𑆵𑆜𑆓𑆶𑆢𑆨𑆓𑆤𑆴𑆠𑆩𑇀𑆧𑆼𑆰𑆶 𑆱𑆳𑆩𑆶𑆢𑇀𑆓𑆳𑆂, 𑆓𑇀𑆫𑆵𑆮𑆳𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆪𑆾𑆂 𑆥𑇀𑆫𑆠𑆫𑆳𑆂, 𑆯𑆴𑆫𑆂𑆑𑆛𑆵𑆑𑆥𑆳𑆬𑆼𑆰𑆶 𑆠𑆶𑆤𑇀𑆤𑆱𑆼𑆮𑆤𑇀𑆪𑆂, 𑆲𑆤𑇀𑆮𑆾𑆫𑆶𑆨𑆪𑆠𑆱𑇀𑆠𑆶 𑆮𑆳𑆪𑆱𑆠𑆶𑆟𑇀𑆝𑆳𑆂, 𑆑𑆟𑇀𑆜𑆲𑆸𑆢𑆪𑆤𑆼𑆠𑇀𑆫𑆑𑇀𑆬𑆾𑆩𑆤𑆳𑆝𑆵𑆰𑆶 𑆩𑆟𑇀𑆝𑆬𑆳𑆂, 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆼𑆰𑆶 𑆯𑆕𑇀𑆒𑆳𑆮𑆫𑇀𑆠𑆳𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆤𑆳𑆩𑆨𑆴𑆫𑆼𑆮𑆳𑆑𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇒𑇗𑇆
𑆃𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆠𑆶 𑆱𑆤𑇀𑆣𑆪𑆾 𑆲𑇀𑆪𑆼𑆠𑆼 𑆑𑆼𑆮𑆬𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆥𑆼𑆯𑆵𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆠𑆶 𑆱𑆤𑇀𑆣𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑇆𑇒𑇘𑇆
𑆤𑆮 𑆱𑇀𑆤𑆳𑆪𑆶𑆯𑆠𑆳𑆤𑆴 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆯𑆳𑆒𑆳𑆱𑆶 𑆰𑆛𑇀𑆯𑆠𑆳𑆤𑆴, 𑆢𑇀𑆮𑆼 𑆯𑆠𑆼 𑆠𑇀𑆫𑆴𑆁𑆯𑆖𑇀𑆖 𑆑𑆾𑆰𑇀𑆜𑆼, 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆥𑇀𑆠𑆠𑆴𑆂 𑇅 𑆍𑆑𑆽𑆑𑆱𑇀𑆪𑆳𑆁 𑆠𑆶 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑆁 𑆰𑆟𑇀𑆤𑆴𑆖𑆴𑆠𑆳𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 , 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮 𑆠𑆬𑆑𑆷𑆫𑇀𑆖𑆓𑆶𑆬𑇀𑆦𑆼𑆰𑆶, 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮 𑆘𑆕𑇀𑆔𑆳𑆪𑆳𑆁, 𑆢𑆯 𑆘𑆳𑆤𑆶𑆤𑆴, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑆷𑆫𑆿, 𑆢𑆯 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼, 𑆯𑆠𑆩𑆣𑇀𑆪𑆫𑇀𑆣𑆩𑆼𑆮𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆰𑆰𑇀𑆛𑆴𑆂 𑆑𑆛𑇀𑆪𑆳𑆁, 𑆥𑆸𑆰𑇀𑆜𑆼𑇁𑆯𑆵𑆠𑆴𑆂, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂 𑆰𑆰𑇀𑆛𑆴𑆂, 𑆇𑆫𑆱𑆴 𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀; 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁, 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆖𑆠𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀; 𑆍𑆮𑆁 𑆤𑆮 𑆱𑇀𑆤𑆳𑆪𑆶𑆯𑆠𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇒𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆤𑆳𑆪𑆷𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆱𑆫𑇀𑆮𑆳 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇅 𑆥𑇀𑆫𑆠𑆳𑆤𑆮𑆠𑇀𑆪𑆾 𑆮𑆸𑆠𑇀𑆠𑆳𑆯𑇀𑆖 𑆥𑆸𑆡𑇀𑆮𑇀𑆪𑆯𑇀𑆖 𑆯𑆶𑆰𑆴𑆫𑆳𑆱𑇀𑆠𑆡𑆳 𑇆𑇓𑇐𑇆
𑆥𑇀𑆫𑆠𑆳𑆤𑆮𑆠𑇀𑆪𑆂 𑆯𑆳𑆒𑆳𑆱𑆶 𑆱𑆫𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆖𑆳𑆥𑇀𑆪𑆡 𑇅 𑆮𑆸𑆠𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆑𑆟𑇀𑆝𑆫𑆳𑆂 𑆱𑆫𑇀𑆮𑆳 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆑𑆶𑆯𑆬𑆽𑆫𑆴𑆲 𑇆𑇓𑇑𑇆
𑆄𑆩𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆳𑆤𑇀𑆠𑆼𑆰𑆶 𑆧𑆱𑇀𑆠𑆿 𑆖 𑆯𑆶𑆰𑆴𑆫𑆳𑆂 𑆒𑆬𑆶 𑇅 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆫𑆱𑆴 𑆠𑆡𑆳 𑆥𑆸𑆰𑇀𑆜𑆼 𑆥𑆸𑆡𑆶𑆬𑆳𑆯𑇀𑆖 𑆯𑆴𑆫𑆱𑇀𑆪𑆡 𑇆𑇓𑇒𑇆
𑆤𑆿𑆫𑇀𑆪𑆡𑆳 𑆦𑆬𑆑𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆳 𑆧𑆤𑇀𑆣𑆤𑆽𑆫𑇀𑆧𑆲𑆶𑆨𑆴𑆫𑇀𑆪𑆶𑆠𑆳 𑇅 𑆨𑆳𑆫𑆑𑇀𑆰𑆩𑆳 𑆨𑆮𑆼𑆢𑆥𑇀𑆱𑆶 𑆤𑆸𑆪𑆶𑆑𑇀𑆠𑆳 𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆳 𑇆𑇓𑇓𑇆
𑆍𑆮𑆩𑆼𑆮 𑆯𑆫𑆵𑆫𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆱𑆤𑇀𑆣𑆪𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇅 𑆱𑇀𑆤𑆳𑆪𑆶𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆨𑆴𑆫𑇀𑆧𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆼𑆤 𑆨𑆳𑆫𑆱𑆲𑆳 𑆤𑆫𑆳𑆂 𑇆𑇓𑇔𑇆
𑆤 𑆲𑇀𑆪𑆱𑇀𑆡𑆵𑆤𑆴 𑆤 𑆮𑆳 𑆥𑆼𑆯𑇀𑆪𑆾 𑆤 𑆱𑆴𑆫𑆳 𑆤 𑆖 𑆱𑆤𑇀𑆣𑆪𑆂 𑇅 𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆴𑆠𑆳𑆱𑇀𑆠𑆡𑆳 𑆲𑆤𑇀𑆪𑆶𑆫𑇀𑆪𑆡𑆳 𑆱𑇀𑆤𑆳𑆪𑆶𑆂 𑆯𑆫𑆵𑆫𑆴𑆟𑆩𑇀 𑇆𑇓𑇕𑇆
𑆪𑆂 𑆱𑇀𑆤𑆳𑆪𑆷𑆂 𑆥𑇀𑆫𑆮𑆴𑆘𑆳𑆤𑆳𑆠𑆴 𑆧𑆳𑆲𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆱𑇀𑆠𑆡𑆳 𑇅 𑆱 𑆓𑆷𑆞𑆁 𑆯𑆬𑇀𑆪𑆩𑆳𑆲𑆫𑇀𑆠𑆶𑆁 𑆢𑆼𑆲𑆳𑆖𑇀𑆗𑆑𑇀𑆤𑆾𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇆𑇓𑇖𑇆
𑆥𑆚𑇀𑆖 𑆥𑆼𑆯𑆵𑆯𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆯𑆠𑆳𑆤𑆴 𑆯𑆳𑆒𑆳𑆱𑆶, 𑆑𑆾𑆰𑇀𑆜𑆼 𑆰𑆛𑇀𑆰𑆰𑇀𑆛𑆴𑆂, 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆠𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑇅 𑆍𑆑𑆽𑆑𑆱𑇀𑆪𑆳𑆁 𑆠𑆶 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑆁 𑆠𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆂 𑆥𑆚𑇀𑆖𑆢𑆯, 𑆢𑆯 𑆥𑇀𑆫𑆥𑆢𑆼, 𑆥𑆳𑆢𑆾𑆥𑆫𑆴 𑆑𑆷𑆫𑇀𑆖𑆱𑆤𑇀𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮, 𑆢𑆯 𑆓𑆶𑆬𑇀𑆦𑆠𑆬𑆪𑆾𑆂, 𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆼 𑆮𑆴𑆁𑆯𑆠𑆴𑆂, 𑆥𑆚𑇀𑆖 𑆘𑆳𑆤𑆶𑆤𑆴, 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆷𑆫𑆿 , 𑆢𑆯 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼, 𑆯𑆠𑆩𑆼𑆮𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆠𑆴; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆠𑆴𑆱𑇀𑆫𑆂 𑆥𑆳𑆪𑆿, 𑆍𑆑𑆳 𑆩𑆼𑆞𑇀𑆫𑆼, 𑆱𑆼𑆮𑆤𑇀𑆪𑆳𑆁 𑆖𑆳𑆥𑆫𑆳, 𑆢𑇀𑆮𑆼 𑆮𑆸𑆰𑆟𑆪𑆾𑆂 , 𑆱𑇀𑆦𑆴𑆖𑆾𑆂 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖, 𑆢𑇀𑆮𑆼 𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆱𑆴, 𑆥𑆚𑇀𑆖𑆾𑆢𑆫𑆼 , 𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆑𑆳, 𑆥𑆸𑆰𑇀𑆜𑆾𑆫𑇀𑆣𑇀𑆮𑆱𑆤𑇀𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆳𑆂 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖 𑆢𑆵𑆫𑇀𑆔𑆳𑆂, 𑆰𑆛𑇀 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂, 𑆢𑆯 𑆮𑆑𑇀𑆰𑆱𑆴, 𑆃𑆑𑇀𑆰𑆑𑆳𑆁𑆱𑆿 𑆥𑇀𑆫𑆠𑆴 𑆱𑆩𑆤𑇀𑆠𑆳𑆠𑇀 𑆱𑆥𑇀𑆠, 𑆢𑇀𑆮𑆼 𑆲𑆸𑆢𑆪𑆳𑆩𑆳𑆯𑆪𑆪𑆾𑆂, 𑆰𑆛𑇀 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆾𑆟𑇀𑆝𑆶(𑆤𑇀𑆢𑆶)𑆑𑆼𑆰𑆶; 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁 𑆖𑆠𑆱𑇀𑆫𑆂, 𑆃𑆰𑇀𑆛𑆿 𑆲𑆤𑇀𑆮𑆾𑆂 , 𑆍𑆑𑆽𑆑𑆳 𑆑𑆳𑆑𑆬𑆑𑆓𑆬𑆪𑆾𑆂, 𑆢𑇀𑆮𑆼 𑆠𑆳𑆬𑆶𑆤𑆴, 𑆍𑆑𑆳 𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆁 , 𑆢𑇀𑆮𑆼 𑆏𑆰𑇀𑆜𑆪𑆾𑆂, 𑆢𑇀𑆮𑆼 𑆤𑆳𑆱𑆳𑆪𑆳𑆁 , 𑆢𑇀𑆮𑆼 𑆤𑆼𑆠𑇀𑆫𑆪𑆾𑆂, 𑆓𑆟𑇀𑆝𑆪𑆾𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂, 𑆑𑆫𑇀𑆟𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆼, 𑆖𑆠𑆱𑇀𑆫𑆾 𑆬𑆬𑆳𑆛𑆼, 𑆍𑆑𑆳 𑆯𑆴𑆫𑆱𑆵𑆠𑆴 ; 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆥𑆚𑇀𑆖 𑆥𑆼𑆯𑆵𑆯𑆠𑆳𑆤𑆴 𑇆𑇓𑇗𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆥𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑆤𑇀𑆣𑆪𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆥𑆼𑆯𑆵𑆨𑆴𑆂 𑆱𑆁𑆮𑆸𑆠𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆧𑆬𑆮𑆤𑇀𑆠𑆴 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆠𑆂 𑇆𑇓𑇘𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆠𑆶 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆣𑆴𑆑𑆳 𑇅 𑆢𑆯 𑆠𑆳𑆱𑆳𑆁 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑆼𑆑𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖𑆼𑆠𑆴, 𑆪𑆿𑆮𑆤𑆼 𑆠𑆳𑆱𑆳𑆁 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆂; 𑆃𑆥𑆠𑇀𑆪𑆥𑆡𑆼 𑆖𑆠𑆱𑇀𑆫𑆂- 𑆠𑆳𑆱𑆳𑆁 𑆥𑇀𑆫𑆱𑆸𑆠𑆼 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆾 𑆢𑇀𑆮𑆼, 𑆩𑆶𑆒𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑆧𑆳𑆲𑇀𑆪𑆼 𑆖 𑆮𑆸𑆠𑇀𑆠𑆼 𑆢𑇀𑆮𑆼, 𑆓𑆫𑇀𑆨𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆂, 𑆯𑆶𑆑𑇀𑆫𑆳𑆫𑇀𑆠𑆮𑆥𑇀𑆫𑆮𑆼𑆯𑆴𑆤𑇀𑆪𑆱𑇀𑆠𑆴𑆱𑇀𑆫 𑆍𑆮 𑇅 𑆥𑆴𑆠𑇀𑆠𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆓𑆫𑇀𑆨𑆯𑆪𑇀𑆪𑆳, 𑆪𑆠𑇀𑆫 𑆓𑆫𑇀𑆨𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇆𑇓𑇙𑇆
𑆠𑆳𑆱𑆳𑆁 𑆧𑆲𑆬𑆥𑆼𑆬𑆮𑆱𑇀𑆡𑆷𑆬𑆳𑆟𑆶𑆥𑆸𑆡𑆶𑆮𑆸𑆠𑇀𑆠𑆲𑇀𑆫𑆱𑇀𑆮𑆢𑆵𑆫𑇀𑆔𑆱𑇀𑆡𑆴𑆫𑆩𑆸𑆢𑆶𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆑𑆫𑇀𑆑𑆯𑆨𑆳𑆮𑆳𑆂 𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆢𑆑𑆳 𑆪𑆡𑆳𑆥𑇀𑆫𑆢𑆼𑆯𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆠 𑆍𑆮 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇔𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆶𑆁𑆱𑆳𑆁 𑆥𑆼𑆯𑇀𑆪𑆂 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆢𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆰𑇀𑆑𑆘𑆳𑆂 𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆩𑆳𑆮𑆸𑆠𑇀𑆪 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆦𑆬𑆩𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆁 𑆲𑆴 𑆠𑆳𑆂 𑇆𑇔𑇑𑇆
𑆩𑆫𑇀𑆩𑆱𑆴𑆫𑆳𑆣𑆩𑆤𑆵𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆤𑇀𑆪𑆠𑇀𑆫 𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆂 𑇆𑇔𑇒𑇆
𑆯𑆕𑇀𑆒𑆤𑆳𑆨𑇀𑆪𑆳𑆑𑆸𑆠𑆴𑆫𑇀𑆪𑆾𑆤𑆴𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆳𑆮𑆫𑇀𑆠𑆳 𑆱𑆳 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳 𑇅 𑆠𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆼 𑆠𑇀𑆮𑆳𑆮𑆫𑇀𑆠𑆼 𑆓𑆫𑇀𑆨𑆯𑆪𑇀𑆪𑆳 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆳 𑇆𑇔𑇓𑇆
𑆪𑆡𑆳 𑆫𑆾𑆲𑆴𑆠𑆩𑆠𑇀𑆱𑇀𑆪𑆱𑇀𑆪 𑆩𑆶𑆒𑆁 𑆨𑆮𑆠𑆴 𑆫𑆷𑆥𑆠𑆂 𑇅 𑆠𑆠𑇀𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆠𑆡𑆳𑆫𑆷𑆥𑆳𑆁 𑆓𑆫𑇀𑆨𑆯𑆪𑇀𑆪𑆳𑆁 𑆮𑆴𑆢𑆶𑆫𑇀𑆧𑆶𑆣𑆳𑆂 𑇆𑇔𑇔𑇆
𑆄𑆨𑆶𑆓𑇀𑆤𑆾𑇁𑆨𑆴𑆩𑆶𑆒𑆂 𑆯𑆼𑆠𑆼 𑆓𑆫𑇀𑆨𑆾 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆼 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂 𑇅 𑆱 𑆪𑆾𑆤𑆴𑆁 𑆯𑆴𑆫𑆱𑆳 𑆪𑆳𑆠𑆴 𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆮𑆁 𑆥𑇀𑆫𑆠𑆴 𑇆𑇔𑇕𑇆
𑆠𑇀𑆮𑆑𑇀𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆱𑇀𑆪 𑆢𑆼𑆲𑆱𑇀𑆪 𑆪𑆾𑇁𑆪𑆩𑆕𑇀𑆓𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂 𑇅 𑆯𑆬𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆳𑆢𑆸𑆠𑆼 𑆤𑆽𑆰 𑆮𑆫𑇀𑆟𑇀𑆪𑆠𑆼𑇁𑆕𑇀𑆓𑆼𑆰𑆶 𑆑𑆼𑆰𑆶𑆖𑆴𑆠𑇀 𑇆𑇔𑇖𑇆
𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆂𑆱𑆁𑆯𑆪𑆁 𑆘𑇀𑆚𑆳𑆤𑆁 𑆲𑆫𑇀𑆠𑇀𑆫𑆳 𑆯𑆬𑇀𑆪𑆱𑇀𑆪 𑆮𑆳𑆚𑇀𑆗𑆠𑆳 𑇅 𑆯𑆾𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆩𑆸𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑇀𑆫𑆰𑇀𑆛𑆮𑇀𑆪𑆾𑇁𑆕𑇀𑆓𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂 𑇆𑇔𑇗𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆠𑆾 𑆲𑆴 𑆪𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆢𑆸𑆰𑇀𑆛𑆁 𑆖 𑆪𑆢𑇀𑆨𑆮𑆼𑆠𑇀 𑇅 𑆱𑆩𑆳𑆱𑆠𑆱𑇀𑆠𑆢𑆶𑆨𑆪𑆁 𑆨𑆷𑆪𑆾 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇔𑇘𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆩𑆱𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆩𑆮𑆴𑆰𑆾𑆥𑆲𑆠𑆩𑆢𑆵𑆫𑇀𑆔𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆵𑆝𑆴𑆠𑆩𑆮𑆫𑇀𑆰𑆯𑆠𑆴𑆑𑆁 𑆤𑆴𑆂𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆁 𑆥𑆶𑆫𑆶𑆰𑆩𑆳𑆮𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆩𑆳𑆥𑆓𑆳𑆪𑆳𑆁 𑆤𑆴𑆧𑆢𑇀𑆣𑆁 𑆥𑆚𑇀𑆘𑆫𑆱𑇀𑆡𑆁 𑆩𑆶𑆚𑇀𑆘𑆮𑆬𑇀𑆑𑆬𑆑𑆶𑆯𑆯𑆟𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤𑆳𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆳𑆕𑇀𑆓𑆩𑆥𑇀𑆫𑆑𑆳𑆯𑆼 𑆢𑆼𑆯𑆼 𑆑𑆾𑆡𑆪𑆼𑆠𑇀, 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆑𑆶𑆡𑆴𑆠𑆁 𑆖𑆾𑆢𑇀𑆣𑆸𑆠𑇀𑆪, 𑆠𑆠𑆾 𑆢𑆼𑆲𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆶𑆯𑆵𑆫𑆧𑆳𑆬𑆮𑆼𑆟𑆶𑆧𑆬𑇀𑆮𑆘𑆑𑆷𑆫𑇀𑆖𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆫𑆮𑆔𑆫𑇀𑆰𑆪𑆁𑆱𑇀𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆤𑇀 𑆱𑆫𑇀𑆮𑆳𑆤𑆼𑆮 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆤𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑇀 𑆬𑆑𑇀𑆰𑆪𑆼𑆖𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆳 𑇆𑇔𑇙𑇆
𑆤 𑆯𑆑𑇀𑆪𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆳 𑆢𑇀𑆫𑆰𑇀𑆛𑆶𑆁 𑆢𑆼𑆲𑆼 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑆩𑆾 𑆮𑆴𑆨𑆶𑆂 𑇅 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑆘𑇀𑆚𑆳𑆤𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆨𑆴𑆱𑇀𑆠𑆥𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆨𑆴𑆫𑆼𑆮 𑆖 𑇆𑇕𑇐𑇆
𑆯𑆫𑆵𑆫𑆼 𑆖𑆽𑆮 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆖 𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆯𑆳𑆫𑆢𑆂 𑇅 𑆢𑆸𑆰𑇀𑆛𑆯𑇀𑆫𑆶𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆤𑇀𑆢𑆼𑆲𑆩𑆮𑆳𑆥𑆾𑆲𑇀𑆪𑆳𑆖𑆫𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑇆𑇕𑇑𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆩𑆫𑇀𑆩𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆥𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆩𑆫𑇀𑆩𑆯𑆠𑆩𑇀 𑇅 𑆠𑆳𑆤𑆴 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆥𑆚𑇀𑆖𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆳𑆁𑆱𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆱𑆴𑆫𑆳𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆱𑇀𑆤𑆳𑆪𑆶𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆃𑆱𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆱𑆤𑇀𑆣𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇅 𑆤 𑆒𑆬𑆶 𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆮𑇀𑆪𑆠𑆴𑆫𑆼𑆑𑆼𑆟𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆪𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆽𑆑𑆳𑆢𑆯 𑆩𑆳𑆁𑆱𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆍𑆑𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆱𑆴𑆫𑆳𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆱𑆥𑇀𑆠𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆱𑇀𑆤𑆳𑆪𑆶𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆃𑆰𑇀𑆛𑆳𑆮𑆱𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆱𑆤𑇀𑆣𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆢𑆼𑆠𑆠𑇀 𑆱𑆥𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆩𑆫𑇀𑆩𑆯𑆠𑆩𑇀 𑇆𑇔𑇆
𑆠𑆼𑆰𑆳𑆩𑆼𑆑𑆳𑆢𑆯𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿, 𑆇𑆢𑆫𑆾𑆫𑆱𑆾𑆫𑇀𑆢𑇀𑆮𑆳𑆢𑆯, 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆥𑆸𑆰𑇀𑆜𑆼, 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆥𑇀𑆠𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑆑𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆠𑆬𑆲𑆸𑆢𑆪𑆑𑆷𑆫𑇀𑆖𑆑𑆷𑆫𑇀𑆖𑆯𑆴𑆫𑆾𑆓𑆶𑆬𑇀𑆦𑆼𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆘𑆳𑆤𑇀𑆮𑆳𑆟𑇀𑆪𑆶𑆫𑇀𑆮𑆴𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆳𑆟𑆴 𑆮𑆴𑆛𑆥𑆁 𑆖𑆼𑆠𑆴, 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆠𑇀𑆱𑆑𑇀𑆡𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑇀 𑇅 𑆇𑆢𑆫𑆾𑆫𑆱𑆾𑆱𑇀𑆠𑆶 𑆓𑆶𑆢𑆧𑆱𑇀𑆠𑆴𑆤𑆳𑆨𑆴𑆲𑆸𑆢𑆪𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆱𑇀𑆠𑆤𑆫𑆾𑆲𑆴𑆠𑆳𑆥𑆬𑆳𑆥𑆳𑆤𑇀𑆪𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆿 𑆖𑆼𑆠𑆴 𑇅 𑆥𑆸𑆰𑇀𑆜𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆠𑆶 𑆑𑆛𑆵𑆑𑆠𑆫𑆶𑆟𑆑𑆶𑆑𑆶𑆤𑇀𑆢𑆫𑆤𑆴𑆠𑆩𑇀𑆧𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆧𑆸𑆲𑆠𑇀𑆪𑆁𑆱𑆦𑆬𑆑𑆳𑆤𑇀𑆪𑆁𑆱𑆿 𑆖𑆼𑆠𑆴 𑇅 𑆧𑆳𑆲𑆶𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆠𑆶 𑆯𑆴𑆥𑇀𑆫𑆠𑆬𑆲𑆸𑆢𑆪𑆑𑆷𑆫𑇀𑆖𑆑𑆷𑆫𑇀𑆖𑆯𑆴𑆫𑆾𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆼𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆟𑇀𑆪𑆶𑆫𑇀𑆮𑆵𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆳𑆟𑆴 𑆑𑆑𑇀𑆰𑆣𑆫𑆁 𑆖𑆼𑆠𑆴; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆾 𑆧𑆳𑆲𑆶𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂 𑇅 𑆘𑆠𑇀𑆫𑆶𑆟 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆠𑆱𑇀𑆫𑆾 𑆣𑆩𑆤𑇀𑆪𑆾𑇁𑆰𑇀𑆛𑆿 𑆩𑆳𑆠𑆸𑆑𑆳 𑆢𑇀𑆮𑆼 𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆼 𑆢𑇀𑆮𑆼 𑆮𑆴𑆣𑆶𑆫𑆼 𑆢𑇀𑆮𑆼 𑆦𑆟𑆼 𑆢𑇀𑆮𑆳𑆮𑆥𑆳𑆕𑇀𑆓𑆿 𑆢𑇀𑆮𑆳𑆮𑆳𑆮𑆫𑇀𑆠𑆿 𑆢𑇀𑆮𑆳𑆮𑆶𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆿 𑆢𑇀𑆮𑆿 𑆯𑆕𑇀𑆒𑆳𑆮𑆼𑆑𑆳 𑆱𑇀𑆡𑆥𑆤𑆵 𑆥𑆚𑇀𑆖 𑆱𑆵𑆩𑆤𑇀𑆠𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆤𑇀𑆪𑆼𑆑𑆾𑇁𑆣𑆴𑆥𑆠𑆴𑆫𑆴𑆠𑆴 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆠𑆬𑆲𑆸𑆢𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆢𑆱𑇀𑆠𑆤𑆫𑆾𑆲𑆴𑆠𑆳𑆤𑆴 𑆩𑆳𑆁𑆱𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆤𑆵𑆬𑆣𑆩𑆤𑆵𑆩𑆳𑆠𑆸𑆑𑆳𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆥𑆳𑆕𑇀𑆓𑆱𑇀𑆡𑆥𑆤𑆵𑆦𑆟𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆳𑆥𑆬𑆳𑆥𑆳𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆲𑆸𑆢𑆪𑆤𑆳𑆨𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆧𑆸𑆲𑆠𑆵𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆾𑆫𑇀𑆮𑇀𑆪𑆂 𑆱𑆴𑆫𑆳𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆄𑆟𑆵(𑆟𑆴)𑆮𑆴𑆛𑆥𑆑𑆑𑇀𑆰𑆣𑆫𑆑𑆷𑆫𑇀𑆖𑆑𑆷𑆫𑇀𑆖𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆳𑆁𑆱𑆮𑆴𑆣𑆶𑆫𑆾𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆳𑆂 𑆱𑇀𑆤𑆳𑆪𑆶𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆑𑆛𑆵𑆑𑆠𑆫𑆶𑆟𑆤𑆴𑆠𑆩𑇀𑆧𑆳𑆁𑆱𑆦𑆬𑆑𑆯𑆕𑇀𑆒𑆳𑆱𑇀𑆠𑇀𑆮𑆱𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆘𑆳𑆤𑆶𑆑𑆷𑆫𑇀𑆥𑆫𑆱𑆵𑆩𑆤𑇀𑆠𑆳𑆣𑆴𑆥𑆠𑆴𑆓𑆶𑆬𑇀𑆦𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆑𑆶𑆑𑆶𑆤𑇀𑆢𑆫𑆳𑆮𑆫𑇀𑆠𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆤𑇀𑆣𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑇆𑇗𑇆
𑆠𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆥𑆚𑇀𑆖𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴, 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴, 𑆮𑆴𑆯𑆬𑇀𑆪𑆔𑇀𑆤𑆳𑆤𑆴, 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆳𑆟𑆴, 𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑇀𑆪𑆼𑆑𑆾𑆤𑆮𑆴𑆁𑆯𑆠𑆴𑆂, 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀, 𑆠𑇀𑆫𑆵𑆟𑆴 𑆮𑆴𑆯𑆬𑇀𑆪𑆔𑇀𑆤𑆳𑆤𑆴, 𑆖𑆠𑆶𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑇀𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆳𑆟𑆴, 𑆃𑆰𑇀𑆛𑆿 𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑆵𑆠𑆴 𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆤𑇀𑆪𑆣𑆴𑆥𑆠𑆴𑆂 𑆯𑆕𑇀𑆒𑆿 𑆑𑆟𑇀𑆜𑆱𑆴𑆫𑆳 𑆓𑆶𑆢𑆩𑇀 𑇅 𑆲𑆸𑆢𑆪𑆁 𑆧𑆱𑇀𑆠𑆴𑆤𑆳𑆨𑇀𑆪𑆿(𑆨𑆵) 𑆖 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆱𑆢𑇀𑆪𑆾 𑆲𑆠𑆳𑆤𑆴 𑆠𑆶 𑇆𑇙𑇆
𑆮𑆑𑇀𑆰𑆾𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆱𑆵𑆩𑆤𑇀𑆠𑆠𑆬𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆪𑆂 𑇅 𑆑𑆛𑆵𑆑𑆠𑆫𑆶𑆟𑆼 𑆱𑆤𑇀𑆣𑆵 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆘𑆿 𑆧𑆸𑆲𑆠𑆵 𑆖 𑆪𑆳 𑇆𑇑𑇐𑇆
𑆤𑆴𑆠𑆩𑇀𑆧𑆳𑆮𑆴𑆠𑆴 𑆖𑆽𑆠𑆳𑆤𑆴 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆲𑆫𑆳𑆟𑆴 𑆠𑆶 𑇅 𑆇𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆿 𑆱𑇀𑆡𑆥𑆤𑆵 𑆖𑆽𑆮 𑆮𑆴𑆯𑆬𑇀𑆪𑆔𑇀𑆤𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆳𑆟𑆴 𑆘𑆳𑆤𑆷𑆫𑇀𑆮𑆵𑆑𑆷𑆫𑇀𑆖𑆮𑆴𑆛𑆥𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆂 𑇅 𑆑𑆶𑆑𑆶𑆤𑇀𑆢𑆫𑆼 𑆑𑆑𑇀𑆰𑆣𑆫𑆼 𑆮𑆴𑆣𑆶𑆫𑆼 𑆱𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆼 𑇆𑇑𑇒𑇆
𑆃𑆁𑆱𑆳𑆁𑆱𑆦𑆬𑆑𑆳𑆥𑆳𑆕𑇀𑆓𑆳 𑆤𑆵𑆬𑆼 𑆩𑆤𑇀𑆪𑆼 𑆦𑆟𑆿 𑆠𑆡𑆳 𑇅 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆟𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆫𑆳𑆮𑆫𑇀𑆠𑆿 𑆢𑇀𑆮𑆿 𑆠𑆡𑆽𑆮 𑆖 𑇆𑇑𑇓𑇆
𑆓𑆶𑆬𑇀𑆦𑆿 𑆢𑇀𑆮𑆿 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆿 𑆢𑇀𑆮𑆿 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆑𑆷𑆫𑇀𑆖𑆯𑆴𑆫𑆳𑆁𑆱𑆴 𑆖 𑇅 𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑆴 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑆰𑇀𑆛𑆳𑆮𑆼𑆠𑆳𑆤𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆳𑆟𑆴 𑆮𑆴𑆢𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆖 𑇆𑇑𑇔𑇆
𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆂; 𑆠𑆼𑆰𑆶 𑆱𑇀𑆮𑆨𑆳𑆮𑆠 𑆍𑆮 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑇀𑆫𑆳𑆟𑆳𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆫𑇀𑆩𑆱𑇀𑆮𑆨𑆴𑆲𑆠𑆳𑆱𑇀𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆳𑆤𑆴, 𑆃𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆼𑆰𑇀𑆮𑆳𑆯𑆶 𑆑𑇀𑆰𑆵𑆟𑆼𑆰𑆶 𑆑𑇀𑆰𑆥𑆪𑆤𑇀𑆠𑆴; 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆱𑆿𑆩𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆳𑆤𑆴, 𑆃𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆼𑆰𑇀𑆮𑆳𑆯𑆶 𑆑𑇀𑆰𑆵𑆟𑆼𑆰𑆶 𑆑𑇀𑆫𑆩𑆼𑆟 𑆖 𑆱𑆾𑆩𑆓𑆶𑆟𑆼𑆰𑆶 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆑𑇀𑆰𑆥𑆪𑆤𑇀𑆠𑆴; 𑆮𑆴𑆯𑆬𑇀𑆪𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆤𑆴, 𑆯𑆬𑇀𑆪𑆩𑆶𑆒𑆳𑆮𑆫𑆶𑆢𑇀𑆣𑆾 𑆪𑆳𑆮𑆢𑆤𑇀𑆠𑆫𑇀𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆠𑆳𑆮𑆘𑇀𑆘𑆵𑆮𑆠𑆴, 𑆇𑆢𑇀𑆣𑆸𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆠𑆶 𑆯𑆬𑇀𑆪𑆼 𑆩𑆫𑇀𑆩𑆱𑇀𑆡𑆳𑆤𑆳𑆯𑇀𑆫𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆳𑆩𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆯𑆬𑇀𑆪𑆾 𑆘𑆵𑆮𑆠𑇀𑆪𑆶𑆢𑇀𑆣𑆸𑆠𑆯𑆬𑇀𑆪𑆾 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 (𑆥𑆳𑆑𑆳𑆠𑇀𑆥𑆠𑆴𑆠𑆯𑆬𑇀𑆪𑆾 𑆮𑆳 𑆘𑆵𑆮𑆠𑆴); 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆳𑆟𑆴 𑆱𑆿𑆩𑇀𑆪𑆳𑆤𑆴, 𑆱𑆾𑆩𑆾 𑆲𑆴 𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆳𑆟𑆳𑆮𑆬𑆩𑇀𑆧𑆤𑆁 𑆑𑆫𑆾𑆠𑆴; 𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆳𑆪𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆴, 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖 𑆠𑆿 𑆫𑆶𑆘𑆳𑆑𑆫𑆿; 𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆵𑆁 𑆖 𑆫𑆶𑆘𑆳𑆩𑆳𑆲𑆶𑆫𑆼𑆑𑆼 𑇆𑇑𑇖𑇆
𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆫𑇀𑆩𑆳𑆁𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑆥𑆴 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆱𑆩𑆮𑆳𑆪𑆳𑆠𑇀 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴, 𑆍𑆑𑆲𑆵𑆤𑆳𑆤𑆳𑆩𑆬𑇀𑆥𑆳𑆤𑆳𑆁 𑆮𑆳 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴, 𑆢𑇀𑆮𑆴𑆲𑆵𑆤𑆳𑆤𑆳𑆁 𑆮𑆴𑆯𑆬𑇀𑆪𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 , 𑆠𑇀𑆫𑆴𑆲𑆵𑆤𑆳𑆤𑆳𑆁 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆳𑆟𑆴, 𑆍𑆑𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮 𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑆵𑆠𑆴 𑇅 𑆤𑆽𑆮𑆁, 𑆪𑆠𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆱𑇀𑆮𑆥𑇀𑆪𑆨𑆴𑆲𑆠𑆼𑆰𑆶 𑆯𑆾𑆟𑆴𑆠𑆳𑆓𑆩𑆤𑆁 𑆨𑆮𑆠𑆴 𑇆𑇑𑇗𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳 𑆪𑆳𑆱𑇀𑆠𑆶 𑆱𑆴𑆫𑆳𑆂 𑆯𑆫𑆵𑆫𑆼 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆠𑆳 𑆩𑆫𑇀𑆩𑆱𑆶 𑆱𑆤𑇀𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆳𑆂 𑇅 𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆠𑆡𑆽𑆮 𑆱𑆤𑇀𑆣𑆵𑆤𑇀 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑇀𑆪 𑆢𑆼𑆲𑆁 𑆥𑇀𑆫𑆠𑆴𑆪𑆳𑆥𑆪𑆤𑇀𑆠𑆴 𑇆𑇑𑇘𑇆
𑆠𑆠𑆂 𑆑𑇀𑆰𑆠𑆼 𑆩𑆫𑇀𑆩𑆟𑆴 𑆠𑆳𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆂 𑆱𑆩𑆤𑇀𑆠𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑆨𑆴𑆱𑇀𑆠𑆸𑆟𑆾𑆠𑆴 𑇅 𑆮𑆴𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆱𑇀𑆠𑆶 𑆱 𑆩𑆳𑆠𑆫𑆴𑆯𑇀𑆮𑆳 𑆫𑆶𑆘𑆂 𑆱𑆶𑆠𑆵𑆮𑇀𑆫𑆳𑆂 𑆥𑇀𑆫𑆠𑆤𑆾𑆠𑆴 𑆑𑆳𑆪𑆼 𑇆𑇑𑇙𑇆
𑆫𑆶𑆘𑆳𑆨𑆴𑆨𑆷𑆠𑆁 𑆠𑆶 𑆠𑆠𑆂 𑆯𑆫𑆵𑆫𑆁 𑆥𑇀𑆫𑆬𑆵𑆪𑆠𑆼 𑆤𑆯𑇀𑆪𑆠𑆴 𑆖𑆳𑆱𑇀𑆪 𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑇅 𑆃𑆠𑆾 𑆲𑆴 𑆯𑆬𑇀𑆪𑆁 𑆮𑆴𑆤𑆴𑆲𑆫𑇀𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆪𑆠𑇀𑆤𑆼𑆤 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆑𑆫𑇀𑆰𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆍𑆠𑆼𑆤 𑆯𑆼𑆰𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑇀 𑇆𑇒𑇑𑇆
𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆩𑆤𑇀𑆠𑆼 𑆮𑆴𑆢𑇀𑆣𑆁 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆩𑆳𑆫𑆪𑆠𑆴, 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆩𑆤𑇀𑆠𑆼 𑆮𑆴𑆢𑇀𑆣𑆁 𑆮𑆽𑆑𑆬𑇀𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆮𑆴𑆯𑆬𑇀𑆪𑆔𑇀𑆤𑆁 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆁 𑆖 𑆨𑆮𑆠𑆴, 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆁 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆑𑇀𑆬𑆼𑆯𑆪𑆠𑆴 𑆫𑆶𑆘𑆳𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴, 𑆫𑆶𑆘𑆳𑆑𑆫𑆩𑆠𑆵𑆮𑇀𑆫𑆮𑆼𑆢𑆤𑆁 𑆨𑆮𑆠𑆴 𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆤𑇀𑆩𑆳𑆫𑆪𑆤𑇀𑆠𑆴, 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆥𑆑𑇀𑆰𑆳𑆤𑇀𑆩𑆳𑆱𑆳𑆢𑇀𑆮𑆳, 𑆠𑆼𑆰𑇀𑆮𑆥𑆴 𑆠𑆶 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆳𑆟𑆴 𑆑𑆢𑆳𑆖𑆴𑆢𑆳𑆯𑆶 𑆩𑆳𑆫𑆪𑆤𑇀𑆠𑆴, 𑆮𑆴𑆯𑆬𑇀𑆪𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆮𑆽𑆑𑆬𑇀𑆪𑆑𑆫𑆳𑆟𑆴 𑆖 𑆑𑆢𑆳𑆖𑆴𑆢𑆠𑇀𑆪𑆨𑆴𑆲𑆠𑆳𑆤𑆴 𑆩𑆳𑆫𑆪𑆤𑇀𑆠𑆴 𑇆𑇒𑇓𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆑𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆥𑆳𑆢𑆱𑇀𑆪𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆤𑆳𑆩 𑆩𑆫𑇀𑆩, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆼𑆟 𑆩𑆫𑆟𑆁; 𑆩𑆣𑇀𑆪𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆩𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆼𑆟 𑆩𑆣𑇀𑆪𑆼 𑆥𑆳𑆢𑆠𑆬𑆱𑇀𑆪 𑆠𑆬𑆲𑆸𑆢𑆪𑆁 𑆤𑆳𑆩 , 𑆠𑆠𑇀𑆫 𑆫𑆶𑆘𑆳𑆨𑆴𑆫𑇀𑆩𑆫𑆟𑆁; 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆱𑇀𑆪𑆾𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆢𑆶𑆨𑆪𑆠𑆂 𑆑𑆷𑆫𑇀𑆖𑆾 𑆤𑆳𑆩, 𑆠𑆠𑇀𑆫 𑆥𑆳𑆢𑆱𑇀𑆪 𑆨𑇀𑆫𑆩𑆟𑆮𑆼𑆥𑆤𑆼 𑆨𑆮𑆠𑆂; 𑆓𑆶𑆬𑇀𑆦𑆱𑆤𑇀𑆣𑆼𑆫𑆣 𑆇𑆨𑆪𑆠𑆂 𑆑𑆷𑆫𑇀𑆖𑆯𑆴𑆫𑆂, 𑆠𑆠𑇀𑆫 𑆫𑆶𑆘𑆳𑆯𑆾𑆦𑆿; 𑆥𑆳𑆢𑆘𑆕𑇀𑆔𑆪𑆾𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆼 𑆓𑆶𑆬𑇀𑆦𑆂, 𑆠𑆠𑇀𑆫 𑆫𑆶𑆘𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆥𑆳𑆢𑆠𑆳 𑆒𑆚𑇀𑆘𑆠𑆳 𑆮𑆳; 𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑆴𑆁 𑆥𑇀𑆫𑆠𑆴 𑆘𑆕𑇀𑆔𑆳𑆩𑆣𑇀𑆪𑆼 𑆅𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆂, 𑆠𑆠𑇀𑆫 𑆯𑆾𑆟𑆴𑆠𑆑𑇀𑆰𑆪𑆼𑆟 𑆩𑆫𑆟𑆁; 𑆘𑆕𑇀𑆔𑆾𑆫𑇀𑆮𑆾𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆼 𑆘𑆳𑆤𑆶, 𑆠𑆠𑇀𑆫 𑆒𑆚𑇀𑆘𑆠𑆳; 𑆘𑆳𑆤𑆶𑆤 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆨𑆪𑆠𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆩𑆳𑆟𑆵 , 𑆠𑆠𑇀𑆫 𑆯𑆾𑆦𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆱𑆑𑇀𑆡𑆴𑆠𑆳 𑆖; 𑆈𑆫𑆶𑆩𑆣𑇀𑆪𑆼 𑆇𑆫𑇀𑆮𑆵, 𑆠𑆠𑇀𑆫 𑆯𑆾𑆟𑆴𑆠𑆑𑇀𑆰𑆪𑆳𑆠𑇀 𑆱𑆑𑇀𑆡𑆴𑆯𑆾𑆰𑆂; 𑆇𑆫𑇀𑆮𑇀𑆪𑆳 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆾 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆱𑆤𑇀𑆣𑆼𑆫𑆷𑆫𑆶𑆩𑆷𑆬𑆼 𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆁, 𑆠𑆠𑇀𑆫 𑆬𑆾𑆲𑆴𑆠𑆑𑇀𑆰𑆪𑆼𑆟 𑆩𑆫𑆟𑆁 𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆾 𑆮𑆳; 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆮𑆸𑆰𑆟𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼 𑆮𑆴𑆛𑆥𑆁, 𑆠𑆠𑇀𑆫 𑆰𑆳𑆟𑇀𑆞𑇀𑆪𑆩𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆠𑆳 𑆮𑆳 𑆨𑆮𑆠𑆴; 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑇀𑆪𑆼𑆑𑆳𑆢𑆯 𑆱𑆑𑇀𑆡𑆴𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇅 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆪𑆳𑆤𑆴 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑆶𑆮𑆴𑆛𑆥𑆳𑆤𑆴, 𑆠𑆳𑆤𑆴 𑆧𑆳𑆲𑆿 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆑𑆷𑆫𑇀𑆥𑆫𑆑𑆑𑇀𑆰𑆣𑆫𑆳𑆟𑆴 ; 𑆪𑆡𑆳 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆮𑆸𑆰𑆟𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼 𑆮𑆴𑆛𑆥𑆩𑆼𑆮𑆁 𑆮𑆑𑇀𑆰𑆂𑆑𑆑𑇀𑆰𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆑𑆑𑇀𑆰𑆣𑆫𑆁, 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆴𑆢𑇀𑆣𑆼 𑆠 𑆍𑆮𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆂; 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆼 𑆑𑆶𑆟𑇀𑆜𑆠𑆳, 𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆒𑇀𑆪𑆼 𑆑𑆶𑆟𑆴𑆂, 𑆑𑆑𑇀𑆰𑆣𑆫𑆼 𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆂 𑇅 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆖𑆠𑆶𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆖𑇀𑆗𑆳𑆒𑆳𑆱𑆶 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇆𑇒𑇔𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆢𑆫𑆾𑆫𑆱𑆾𑆫𑇀𑆩𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 - 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆮𑆫𑇀𑆖𑆾𑆤𑆴𑆫𑆱𑆤𑆁 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆁 𑆓𑆶𑆢𑆁 𑆤𑆳𑆩 𑆩𑆫𑇀𑆩, 𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆁; 𑆃𑆬𑇀𑆥𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆾𑇁𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂 𑆑𑆛𑇀𑆪𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆾 𑆧𑆱𑇀𑆠𑆴𑆂, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆩𑆯𑇀𑆩𑆫𑆵𑆮𑇀𑆫𑆟𑆳𑆢𑆸𑆠𑆼, 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆶𑆨𑆪𑆠𑆾 𑆨𑆴𑆤𑇀𑆤𑆼 𑆤 𑆘𑆵𑆮𑆠𑆴, 𑆍𑆑𑆠𑆾 𑆨𑆴𑆤𑇀𑆤𑆼 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆳𑆮𑆵 𑆮𑇀𑆫𑆟𑆾 𑆨𑆮𑆠𑆴, 𑆱 𑆠𑆶 𑆪𑆠𑇀𑆤𑆼𑆤𑆾𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆾 𑆫𑆾𑆲𑆠𑆴; 𑆥𑆑𑇀𑆮𑆳𑆩𑆳𑆯𑆪𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆱𑆴𑆫𑆳𑆥𑇀𑆫𑆨𑆮𑆳 𑆤𑆳𑆨𑆴𑆂, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑆢𑇀𑆪𑆾 𑆩𑆫𑆟𑆁; 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆪𑆾𑆫𑆱𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆢𑇀𑆮𑆳𑆫𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆫𑆘𑆱𑇀𑆠𑆩𑆱𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆲𑆸𑆢𑆪𑆁, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑆢𑇀𑆪 𑆍𑆮 𑆩𑆫𑆟𑆁; 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑆣𑆱𑇀𑆠𑆳𑆢𑇀 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆩𑆶𑆨𑆪𑆠𑆂 𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆼, 𑆠𑆠𑇀𑆫 𑆑𑆦𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆰𑇀𑆜𑆠𑆪𑆳 (𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆨𑇀𑆪𑆳𑆁 ) 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆱𑇀𑆠𑆤𑆖𑆷𑆖𑆶𑆑𑆪𑆾𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆩𑆶𑆨𑆪𑆠𑆂 𑆱𑇀𑆠𑆤𑆫𑆾𑆲𑆴𑆠𑆿 , 𑆠𑆠𑇀𑆫 𑆬𑆾𑆲𑆴𑆠𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆰𑇀𑆜𑆠𑆪𑆳 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆃𑆁𑆱𑆑𑆷𑆛𑆪𑆾𑆫𑆣𑆱𑇀𑆠𑆳𑆠𑇀 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆥𑆫𑆴𑆨𑆳𑆓𑆪𑆾𑆫𑆥𑆬𑆳𑆥𑆿 𑆤𑆳𑆩, 𑆠𑆠𑇀𑆫 𑆫𑆑𑇀𑆠𑆼𑆤 𑆥𑆷𑆪𑆨𑆳𑆮𑆁 𑆓𑆠𑆼𑆤 𑆩𑆫𑆟𑆁; 𑆇𑆨𑆪𑆠𑇀𑆫𑆾𑆫𑆱𑆾 𑆤𑆳𑆝𑇀𑆪𑆿 𑆮𑆳𑆠𑆮𑆲𑆼 𑆃𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆿 𑆤𑆳𑆩, 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆰𑇀𑆜𑆠𑆪𑆳 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆩𑆫𑆟𑆩𑇀; 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑇀𑆪𑆶𑆢𑆫𑆾𑆫𑆱𑆾𑆫𑇀𑆢𑇀𑆮𑆳𑆢𑆯 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇆𑇒𑇕𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑆸𑆰𑇀𑆜𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 - 𑆠𑆠𑇀𑆫 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆩𑆶𑆨𑆪𑆠𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆫𑆾𑆟𑆴𑆑𑆳𑆟𑇀𑆝𑆩𑆱𑇀𑆡𑆴𑆤𑆵 𑆑𑆛𑆵𑆑𑆠𑆫𑆶𑆟𑆼, 𑆠𑆠𑇀𑆫 𑆯𑆾𑆟𑆴𑆠𑆑𑇀𑆰𑆪𑆳𑆠𑇀 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑇀𑆮𑆴𑆮𑆫𑇀𑆟𑆾 𑆲𑆵𑆤𑆫𑆷𑆥𑆯𑇀𑆖 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆫𑇀𑆘𑆔𑆤𑆧𑆲𑆴𑆫𑇀𑆨𑆳𑆓𑆼 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆩𑆶𑆨𑆪𑆠𑆾 𑆑𑆶𑆑𑆶𑆤𑇀𑆢𑆫𑆼, 𑆠𑆠𑇀𑆫 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆘𑇀𑆚𑆳𑆤𑆩𑆣𑆂𑆑𑆳𑆪𑆼 𑆖𑆼𑆰𑇀𑆛𑆾𑆥𑆔𑆳𑆠𑆯𑇀𑆖; 𑆯𑇀𑆫𑆾𑆟𑆵𑆑𑆳𑆟𑇀𑆝𑆪𑆾𑆫𑆶𑆥𑆫𑇀𑆪𑆳𑆯𑆪𑆳𑆖𑇀𑆗𑆳𑆢𑆤𑆿 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆿 𑆤𑆴𑆠𑆩𑇀𑆧𑆿, 𑆠𑆠𑇀𑆫𑆳𑆣𑆂𑆑𑆳𑆪𑆯𑆾𑆰𑆾 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆖𑇀𑆖 𑆩𑆫𑆟𑆁; 𑆃𑆣𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆿 𑆘𑆔𑆤𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆩𑆣𑇀𑆪𑆪𑆾𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆘𑆔𑆤𑆳𑆠𑇀 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆤𑇀𑆣𑆵, 𑆠𑆠𑇀𑆫 𑆬𑆾𑆲𑆴𑆠𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆰𑇀𑆜𑆠𑆪𑆳 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆳𑆢𑆸𑆘𑆷𑆨𑆪𑆠𑆂 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆱𑇀𑆪 𑆧𑆸𑆲𑆠𑆵, 𑆠𑆠𑇀𑆫 𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆫𑇀𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆥𑆸𑆰𑇀𑆜𑆾𑆥𑆫𑆴 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆩𑆶𑆨𑆪𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆼 𑆃𑆁𑆱𑆦𑆬𑆑𑆼, 𑆠𑆠𑇀𑆫 𑆧𑆳𑆲𑇀𑆮𑆾𑆂 𑆱𑇀𑆮𑆳𑆥𑆯𑆾𑆰𑆿 ; 𑆧𑆳𑆲𑆶𑆩𑆷𑆫𑇀𑆣𑆓𑇀𑆫𑆵𑆮𑆳𑆩𑆣𑇀𑆪𑆼𑆁𑇁𑆱𑆥𑆵𑆜𑆱𑇀𑆑𑆤𑇀𑆣𑆧𑆤𑇀𑆣𑆤𑆳𑆮𑆁𑆱𑆿, 𑆠𑆠𑇀𑆫 𑆱𑇀𑆠𑆧𑇀𑆣𑆧𑆳𑆲𑆶𑆠𑆳; 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆥𑆸𑆰𑇀𑆜𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇆𑇒𑇖𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆓𑆠𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆑𑆟𑇀𑆜𑆤𑆳𑆝𑆵𑆩𑆶𑆨𑆪𑆠𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆾 𑆣𑆩𑆤𑇀𑆪𑆾 𑆢𑇀𑆮𑆼 𑆤𑆵𑆬𑆼 𑆢𑇀𑆮𑆼 𑆖 𑆩𑆤𑇀𑆪𑆼 𑆮𑇀𑆪𑆠𑇀𑆪𑆳𑆱𑆼𑆤 , 𑆠𑆠𑇀𑆫 𑆩𑆷𑆑𑆠𑆳 𑆱𑇀𑆮𑆫𑆮𑆽𑆑𑆸𑆠𑆩𑆫𑆱𑆓𑇀𑆫𑆳𑆲𑆴𑆠𑆳 𑆖; 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆩𑆶𑆨𑆪𑆠𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂 𑆱𑆴𑆫𑆳 𑆩𑆳𑆠𑆸𑆑𑆳𑆂, 𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆁; 𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆪𑆾𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆼 𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆼, 𑆠𑆠𑇀𑆫 𑆖𑆬𑆩𑆷𑆫𑇀𑆣𑆠𑆳; 𑆑𑆫𑇀𑆟𑆥𑆸𑆰𑇀𑆜𑆠𑆾𑇁𑆣𑆂𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆼 𑆮𑆴𑆣𑆶𑆫𑆼, 𑆠𑆠𑇀𑆫 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁; 𑆔𑇀𑆫𑆳𑆟𑆩𑆳𑆫𑇀𑆓𑆩𑆶𑆨𑆪𑆠𑆂 𑆱𑇀𑆫𑆾𑆠𑆾𑆩𑆳𑆫𑇀𑆓𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆼 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂 𑆦𑆟𑆼, 𑆠𑆠𑇀𑆫 𑆓𑆤𑇀𑆣𑆳𑆘𑇀𑆚𑆳𑆤𑆁; 𑆨𑇀𑆫𑆷𑆥𑆶𑆖𑇀𑆗𑆳𑆤𑇀𑆠𑆪𑆾𑆫𑆣𑆾𑇁𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑇀𑆧𑆳𑆲𑇀𑆪𑆠𑆾𑇁𑆥𑆳𑆕𑇀𑆓𑆿, 𑆠𑆠𑇀𑆫𑆳𑆤𑇀𑆣𑇀𑆪𑆁 𑆢𑆸𑆰𑇀𑆛𑆪𑆶𑆥𑆔𑆳𑆠𑆾 𑆮𑆳; 𑆨𑇀𑆫𑆶𑆮𑆾𑆫𑆶𑆥𑆫𑆴 𑆤𑆴𑆩𑇀𑆤𑆪𑆾𑆫𑆳𑆮𑆫𑇀𑆠𑆿 𑆤𑆳𑆩, 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆤𑇀𑆣𑇀𑆪𑆁 𑆢𑆸𑆰𑇀𑆛𑆪𑆶𑆥𑆔𑆳𑆠𑆾 𑆮𑆳; 𑆨𑇀𑆫𑆶𑆮𑆾𑆫𑆤𑇀𑆠𑆪𑆾𑆫𑆶𑆥𑆫𑆴 𑆑𑆫𑇀𑆟𑆬𑆬𑆳𑆛𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆯𑆕𑇀𑆒𑆿, 𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆁; 𑆯𑆕𑇀𑆒𑆪𑆾𑆫𑆶𑆥𑆫𑆴 𑆑𑆼𑆯𑆳𑆤𑇀𑆠 𑆇𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆿, 𑆠𑆠𑇀𑆫 𑆱𑆯𑆬𑇀𑆪𑆾 𑆘𑆵𑆮𑆼𑆠𑇀 𑆥𑆳𑆑𑆳𑆠𑇀 𑆥𑆠𑆴𑆠𑆯𑆬𑇀𑆪𑆾 𑆮𑆳 𑆤𑆾𑆢𑇀𑆣𑆸𑆠𑆯𑆬𑇀𑆪𑆂; 𑆨𑇀𑆫𑆶𑆮𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆱𑇀𑆡𑆥𑆤𑆵, 𑆠𑆠𑇀𑆫𑆾𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆮𑆠𑇀; 𑆥𑆚𑇀𑆖 𑆱𑆤𑇀𑆣𑆪𑆂 𑆯𑆴𑆫𑆱𑆴 𑆮𑆴𑆨𑆑𑇀𑆠𑆳𑆂 𑆱𑆵𑆩𑆤𑇀𑆠𑆳 𑆤𑆳𑆩, 𑆠𑆠𑇀𑆫𑆾𑆤𑇀𑆩𑆳𑆢𑆨𑆪𑆖𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆽𑆫𑇀𑆩𑆫𑆟𑆁; 𑆔𑇀𑆫𑆳𑆟𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆘𑆴𑆲𑇀𑆮𑆳𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆵𑆤𑆳𑆁 𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆂 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆳𑆤𑆴 , 𑆠𑆳𑆤𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆩𑆫𑇀𑆩𑆳𑆟𑆴, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆁 ; 𑆩𑆱𑇀𑆠𑆑𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆾𑆥𑆫𑆴𑆰𑇀𑆜𑆳𑆠𑇀 𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆣𑆴𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆾 𑆫𑆾𑆩𑆳𑆮𑆫𑇀𑆠𑆾𑇁𑆣𑆴𑆥𑆠𑆴𑆂, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑆢𑇀𑆪 𑆍𑆮 𑇅 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆱𑆥𑇀𑆠𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆓𑆠𑆳𑆤𑆴 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇆𑇒𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆇𑆫𑇀𑆮𑇀𑆪𑆂 𑆯𑆴𑆫𑆳𑆁𑆱𑆴 𑆮𑆴𑆛𑆥𑆼 𑆖 𑆱𑆑𑆑𑇀𑆰𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆍𑆑𑆽𑆑𑆩𑆕𑇀𑆓𑆶𑆬𑆩𑆴𑆠𑆁 𑆱𑇀𑆠𑆤𑆥𑆷𑆫𑇀𑆮𑆩𑆷𑆬𑆩𑇀 𑇅 𑆮𑆴𑆢𑇀𑆣𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆢𑇀𑆮𑆪𑆩𑆴𑆠𑆁 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆓𑆶𑆬𑇀𑆦𑆁 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆼𑆮 𑆘𑆳𑆤𑆶 𑆱𑆥𑆫𑆁 𑆱𑆲 𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆨𑇀𑆪𑆳𑆩𑇀 𑇆𑇒𑇘𑇆
𑆲𑆸𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆑𑆷𑆫𑇀𑆖𑆓𑆶𑆢𑆤𑆳𑆨𑆴 𑆮𑆢𑆤𑇀𑆠𑆴 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆥𑆚𑇀𑆖 𑆖 𑆓𑆬𑆼 𑆢𑆯 𑆪𑆳𑆤𑆴 𑆖 𑆢𑇀𑆮𑆼 𑇅 𑆠𑆳𑆤𑆴 𑆱𑇀𑆮𑆥𑆳𑆟𑆴𑆠𑆬𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆤𑆴 𑆯𑆼𑆰𑆳𑆟𑇀𑆪𑆮𑆼𑆲𑆴 𑆥𑆫𑆴𑆮𑆴𑆱𑇀𑆠𑆫𑆠𑆾𑇁𑆕𑇀𑆓𑆶𑆬𑆳𑆫𑇀𑆣𑆩𑇀 𑇆𑇒𑇙𑇆
𑆍𑆠𑆠𑇀𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆨𑆴𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆮𑆢𑆤𑇀𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆑𑆫𑇀𑆩𑆑𑆫𑆟𑆁 𑆥𑆫𑆴𑆲𑆸𑆠𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆩𑇀 𑇅 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆨𑆴𑆔𑆳𑆠𑆴𑆠𑆩𑆥𑆵𑆲 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆩𑆫𑇀𑆩 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆴 𑆩𑆫𑇀𑆩𑆱𑆢𑆤𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆩𑇀 𑇆𑇓𑇐𑇆
𑆗𑆴𑆤𑇀𑆤𑆼𑆰𑆶 𑆥𑆳𑆟𑆴𑆖𑆫𑆟𑆼𑆰𑆶 𑆱𑆴𑆫𑆳 𑆤𑆫𑆳𑆟𑆳𑆁 𑆱𑆕𑇀𑆑𑆾𑆖𑆩𑆵𑆪𑆶𑆫𑆱𑆸𑆓𑆬𑇀𑆥𑆩𑆠𑆾 𑆤𑆴𑆫𑆼𑆠𑆴 𑇅 𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆩𑆴𑆠𑆮𑇀𑆪𑆱𑆤𑆩𑆶𑆓𑇀𑆫𑆩𑆠𑆾 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆂 𑆱𑆚𑇀𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆯𑆳𑆒𑆠𑆫𑆶𑆮𑆤𑇀𑆤𑆴𑆣𑆤𑆁 𑆤 𑆪𑆳𑆤𑇀𑆠𑆴 𑇆𑇓𑇑𑇆
𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆼𑆰𑆶 𑆠𑆠𑇀𑆫 𑆱𑆠𑆬𑆼𑆰𑆶 𑆲𑆠𑆼𑆰𑆶 𑆫𑆑𑇀𑆠𑆁 𑆓𑆖𑇀𑆗𑆠𑇀𑆪𑆠𑆵𑆮 𑆥𑆮𑆤𑆯𑇀𑆖 𑆫𑆶𑆘𑆁 𑆑𑆫𑆾𑆠𑆴 𑇅 𑆍𑆮𑆁 𑆮𑆴𑆤𑆳𑆯𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑆲𑆴 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆳 𑆮𑆸𑆑𑇀𑆰𑆳 𑆅𑆮𑆳𑆪𑆶𑆣𑆤𑆴𑆥𑆳𑆠𑆤𑆴𑆑𑆸𑆠𑇀𑆠𑆩𑆷𑆬𑆳𑆂 𑇆𑇓𑇒𑇆
𑆫𑆶𑆘𑆯𑇀𑆖 𑆮𑆴𑆮𑆴𑆣𑆳𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶𑆲𑆫𑆼 𑆲𑆠𑆼 𑇅 𑆲𑆠𑆼 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆔𑇀𑆤𑆼 𑆠𑆶 𑆣𑇀𑆫𑆶𑆮𑆁 𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆾 𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇓𑇗𑇆
𑆠𑆠𑆾 𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆳𑆘𑇀𑆘𑆤𑇀𑆠𑆶𑆫𑇀𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆯𑇀𑆖 𑆤𑆯𑇀𑆪𑆠𑆴 𑇅 𑆲𑆠𑆼 𑆮𑆽𑆑𑆬𑇀𑆪𑆘𑆤𑆤𑆼 𑆑𑆼𑆮𑆬𑆁 𑆮𑆽𑆢𑇀𑆪𑆤𑆽𑆥𑆶𑆟𑆳𑆠𑇀 𑇆𑇓𑇘𑇆
𑆯𑆫𑆵𑆫𑆁 𑆑𑇀𑆫𑆴𑆪𑆪𑆳 𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆑𑆬𑆠𑇀𑆮𑆩𑆮𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇅 𑆮𑆴𑆯𑆬𑇀𑆪𑆔𑇀𑆤𑆼 𑆠𑆶 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆁 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆁 𑆪𑆖𑇀𑆖 𑆑𑆳𑆫𑆟𑆩𑇀 𑇆𑇓𑇙𑇆
𑆫𑆶𑆘𑆳𑆑𑆫𑆳𑆟𑆴 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆑𑇀𑆰𑆠𑆳𑆤𑆴 𑆮𑆴𑆮𑆴𑆣𑆳 𑆫𑆶𑆘𑆂 𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆤𑇀𑆠𑆼 𑆖 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆑𑆶𑆮𑆽𑆢𑇀𑆪𑆮𑆯𑆓𑆾 𑆪𑆢𑆴 𑇆𑇔𑇐𑇆
𑆗𑆼𑆢𑆨𑆼𑆢𑆳𑆨𑆴𑆔𑆳𑆠𑆼𑆨𑇀𑆪𑆾 𑆢𑆲𑆤𑆳𑆢𑇀𑆢𑆳𑆫𑆟𑆳𑆢𑆥𑆴 𑇅 𑆇𑆥𑆔𑆳𑆠𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆤𑇀𑆩𑆫𑇀𑆩𑆟𑆳𑆁 𑆠𑆶𑆬𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇔𑇑𑇆
𑆩𑆫𑇀𑆩𑆳𑆨𑆴𑆔𑆳𑆠𑆱𑇀𑆠𑆶 𑆤 𑆑𑆯𑇀𑆖𑆴𑆢𑆱𑇀𑆠𑆴 𑆪𑆾𑇁𑆬𑇀𑆥𑆳𑆠𑇀𑆪𑆪𑆾 𑆮𑆳𑇁𑆥𑆴 𑆤𑆴𑆫𑆠𑇀𑆪𑆪𑆾 𑆮𑆳 𑇅 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆩𑆫𑇀𑆩𑆱𑇀𑆮𑆨𑆴𑆠𑆳𑆝𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆮𑆽𑆑𑆬𑇀𑆪𑆩𑆸𑆖𑇀𑆗𑆤𑇀𑆠𑇀𑆪𑆡𑆮𑆳 𑆩𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑇆𑇔𑇒𑇆
𑆩𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆲𑆴 𑆪𑆼 𑆮𑆴𑆑𑆳𑆫𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆑𑆳𑆪𑆼 𑆮𑆴𑆮𑆴𑆣𑆳 𑆤𑆫𑆳𑆟𑆳𑆩𑇀 𑇅 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆠𑆼 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆤𑆫𑆱𑇀𑆪 𑆪𑆠𑇀𑆤𑆽𑆫𑆥𑆴 𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑇆𑇔𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑆴𑆫𑆳𑆮𑆫𑇀𑆟𑆮𑆴𑆨𑆑𑇀𑆠𑆴𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆥𑇀𑆠 𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆳𑆨𑆴𑆫𑆴𑆢𑆁 𑆯𑆫𑆵𑆫𑆩𑆳𑆫𑆳𑆩 𑆅𑆮 𑆘𑆬𑆲𑆳𑆫𑆴𑆟𑆵𑆨𑆴𑆂 𑆑𑆼𑆢𑆳𑆫 𑆅𑆮 𑆖 𑆑𑆶𑆬𑇀𑆪𑆳𑆨𑆴𑆫𑆶𑆥𑆱𑇀𑆤𑆴𑆲𑇀𑆪𑆠𑆼𑇁𑆤𑆶𑆓𑆸𑆲𑇀𑆪𑆠𑆼 𑆖𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆂; 𑆢𑇀𑆫𑆶𑆩𑆥𑆠𑇀𑆫𑆱𑆼𑆮𑆤𑆵𑆤𑆳𑆩𑆴𑆮 𑆠𑆳𑆱𑆳𑆁 𑆥𑇀𑆫𑆠𑆳𑆤𑆳𑆂; 𑆠𑆳𑆱𑆳𑆁 𑆤𑆳𑆨𑆴𑆫𑇀𑆩𑆷𑆬𑆁, 𑆠𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆱𑆫𑆤𑇀𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆑𑇀 𑆖 𑇆𑇓𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆪𑆳𑆮𑆠𑇀𑆪𑆱𑇀𑆠𑆶 𑆱𑆴𑆫𑆳𑆂 𑆑𑆳𑆪𑆼 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆫𑇀𑆮𑆳 𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆠𑆤𑇀𑆮𑆤𑇀𑆠𑆴 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑇆𑇔𑇆
𑆤𑆳𑆨𑆴𑆱𑇀𑆡𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀𑆤𑆳𑆨𑆴𑆫𑇀𑆮𑇀𑆪𑆶𑆥𑆳𑆯𑇀𑆫𑆴𑆠𑆳 𑇅 𑆱𑆴𑆫𑆳𑆨𑆴𑆫𑆳𑆮𑆸𑆠𑆳 𑆤𑆳𑆨𑆴𑆯𑇀𑆖𑆑𑇀𑆫𑆤𑆳𑆨𑆴𑆫𑆴𑆮𑆳𑆫𑆑𑆽𑆂 𑇆𑇕𑇆
𑆠𑆳𑆱𑆳𑆁 𑆩𑆷𑆬𑆱𑆴𑆫𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀; 𑆠𑆳𑆱𑆳𑆁 𑆮𑆳𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆾 𑆢𑆯, 𑆥𑆴𑆠𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆾 𑆢𑆯, 𑆑𑆦𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆾 𑆢𑆯, 𑆢𑆯 𑆫𑆑𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆂 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆠𑆶 𑆮𑆳𑆠𑆮𑆳𑆲𑆴𑆤𑆵𑆤𑆳𑆁 𑆮𑆳𑆠𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆳𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆱𑆥𑇀𑆠𑆠𑆴𑆯𑆠𑆁 𑆨𑆮𑆠𑆴, 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮 𑆥𑆴𑆠𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆡𑆳𑆤𑆼, 𑆑𑆦𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆼, 𑆫𑆑𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆾𑆂; 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆱𑆥𑇀𑆠 𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆂 𑆱𑆴𑆫𑆳 𑆍𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆂; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆑𑆾𑆰𑇀𑆜𑆼 𑆖𑆠𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀; 𑆠𑆳𑆱𑆳𑆁 𑆓𑆶𑆢𑆩𑆼𑆞𑇀𑆫𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑆯𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆩𑆰𑇀𑆛𑆿, 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂, 𑆰𑆛𑇀 𑆥𑆸𑆰𑇀𑆜𑆼, 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮𑆾𑆢𑆫𑆼, 𑆢𑆯 𑆮𑆑𑇀𑆰𑆱𑆴 𑇅 𑆍𑆑𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆘𑇀𑆘𑆠𑇀𑆫𑆶𑆟 𑆈𑆫𑇀𑆣𑇀𑆮𑆁; 𑆠𑆳𑆱𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁, 𑆑𑆫𑇀𑆟𑆪𑆾𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂, 𑆤𑆮 𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆁, 𑆰𑆟𑇀 𑆤𑆳𑆱𑆴𑆑𑆳𑆪𑆳𑆁, 𑆃𑆰𑇀𑆛𑆿 𑆤𑆼𑆠𑇀𑆫𑆪𑆾𑆂, 𑆍𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑆚𑇀𑆖𑆱𑆥𑇀𑆠𑆠𑆴𑆯𑆠𑆁 𑆮𑆳𑆠𑆮𑆳𑆲𑆴𑆤𑆵𑆤𑆳𑆁 𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆨𑆮𑆠𑆴 𑇅 𑆍𑆰 𑆍𑆮 𑆮𑆴𑆨𑆳𑆓𑆂 𑆯𑆼𑆰𑆳𑆟𑆳𑆩𑆥𑆴 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆾 𑆤𑆼𑆠𑇀𑆫𑆪𑆾𑆫𑇀𑆢𑆯, 𑆑𑆫𑇀𑆟𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆼; 𑆍𑆮𑆁 𑆫𑆑𑇀𑆠𑆮𑆲𑆳𑆂 𑆑𑆦𑆮𑆲𑆳𑆯𑇀𑆖 𑇅 𑆍𑆮𑆩𑆼𑆠𑆳𑆤𑆴 𑆱𑆥𑇀𑆠 𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴 𑆱𑆮𑆴𑆨𑆳𑆓𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑇆𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆥𑇀𑆫𑆠𑆵𑆔𑆳𑆠𑆩𑆩𑆾𑆲𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀 𑇅 𑆑𑆫𑆾𑆠𑇀𑆪𑆤𑇀𑆪𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆥𑆮𑆤𑆯𑇀𑆖𑆫𑆤𑇀 𑇆𑇘𑇆
𑆪𑆢𑆳 𑆠𑆶 𑆑𑆶𑆥𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆢𑆳𑇁𑆱𑇀𑆪 𑆮𑆴𑆮𑆴𑆣𑆳 𑆫𑆾𑆓𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆮𑆳𑆠𑆱𑆩𑇀𑆨𑆮𑆳𑆂 𑇆𑇙𑇆
𑆨𑇀𑆫𑆳𑆘𑆴𑆰𑇀𑆟𑆶𑆠𑆳𑆩𑆤𑇀𑆤𑆫𑆶𑆖𑆴𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑇀𑆠𑆴𑆩𑆫𑆾𑆓𑆠𑆳𑆩𑇀 𑇅 𑆱𑆁𑆱𑆫𑇀𑆥𑆠𑇀 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑆥𑆴 𑇆𑇑𑇐𑇆
𑆪𑆢𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆼𑆮𑆠𑆼 𑆱𑇀𑆮𑆮𑆲𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑇅 𑆠𑆢𑆳𑇁𑆱𑇀𑆪 𑆮𑆴𑆮𑆴𑆣𑆳 𑆫𑆾𑆓𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆥𑆴𑆠𑇀𑆠𑆱𑆩𑇀𑆨𑆮𑆳𑆂 𑇆𑇑𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆩𑆕𑇀𑆓𑆼𑆰𑆶 𑆱𑆤𑇀𑆣𑆵𑆤𑆳𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆧𑆬𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆠𑆳𑆩𑇀 𑇅 𑆑𑆫𑆾𑆠𑇀𑆪𑆤𑇀𑆪𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆧𑆬𑆳𑆱𑆂 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆯𑇀𑆖𑆫𑆤𑇀 𑇆𑇑𑇒𑇆
𑆪𑆢𑆳 𑆠𑆶 𑆑𑆶𑆥𑆴𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆢𑆳𑇁𑆱𑇀𑆪 𑆮𑆴𑆮𑆴𑆣𑆳 𑆫𑆾𑆓𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆩𑇀𑆨𑆮𑆳𑆂 𑇆𑇑𑇓𑇆
𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆥𑆷𑆫𑆟𑆁 𑆮𑆫𑇀𑆟𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆘𑇀𑆚𑆳𑆤𑆩𑆱𑆁𑆯𑆪𑆩𑇀 𑇅 𑆱𑇀𑆮𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆱𑆚𑇀𑆖𑆫𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑆥𑆴 𑇆𑇑𑇔𑇆
𑆪𑆢𑆳 𑆠𑆶 𑆑𑆶𑆥𑆴𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆱𑆼𑆮𑆠𑆼 𑆱𑇀𑆮𑆮𑆲𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑇅 𑆠𑆢𑆳𑇁𑆱𑇀𑆪 𑆮𑆴𑆮𑆴𑆣𑆳 𑆫𑆾𑆓𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆫𑆑𑇀𑆠𑆱𑆩𑇀𑆨𑆮𑆳𑆂 𑇆𑇑𑇕𑇆
𑆤 𑆲𑆴 𑆮𑆳𑆠𑆁 𑆱𑆴𑆫𑆳𑆂 𑆑𑆳𑆯𑇀𑆖𑆴𑆤𑇀𑆤 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆼𑆮𑆬𑆁 𑆠𑆡𑆳 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆮𑆳 𑆮𑆲𑆤𑇀𑆠𑇀𑆪𑆼𑆠𑆳 𑆃𑆠𑆂 𑆱𑆫𑇀𑆮𑆮𑆲𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇖𑇆
𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆲𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆣𑆳𑆮𑆠𑆳𑆩𑇀 𑇅 𑆣𑇀𑆫𑆶𑆮𑆩𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆓𑆩𑆤𑆩𑆠𑆂 𑆱𑆫𑇀𑆮𑆮𑆲𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫𑆳𑆫𑆶𑆟𑆳 𑆮𑆳𑆠𑆮𑆲𑆳𑆂 𑆥𑆷𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆳𑆪𑆶𑆤𑆳 𑆱𑆴𑆫𑆳𑆂 𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆶𑆰𑇀𑆟𑆳𑆯𑇀𑆖 𑆤𑆵𑆬𑆳𑆯𑇀𑆖, 𑆯𑆵𑆠𑆳 𑆓𑆿𑆫𑇀𑆪𑆂 𑆱𑇀𑆡𑆴𑆫𑆳𑆂 𑆑𑆦𑆳𑆠𑇀 𑆃𑆱𑆸𑆓𑇀𑆮𑆲𑆳𑆱𑇀𑆠𑆶 𑆫𑆾𑆲𑆴𑆟𑇀𑆪𑆂 𑆱𑆴𑆫𑆳 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆯𑆵𑆠𑆬𑆳𑆂 𑇆𑇑𑇘𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆤 𑆮𑆴𑆣𑇀𑆪𑆼𑆢𑇀𑆪𑆳𑆂 𑆱𑆴𑆫𑆳 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑆴 𑆮𑇀𑆪𑆣𑆳𑆠𑇀𑆠𑆳𑆱𑆳𑆁 𑆣𑇀𑆫𑆶𑆮𑆁 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆒𑆳𑆱𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆖𑇀𑆖 𑆯𑆠𑆁 𑆑𑆾𑆰𑇀𑆜𑆼 𑆖𑆠𑆶𑆂𑆰𑆰𑇀𑆛𑆁 𑆖 𑆩𑆷𑆫𑇀𑆣𑆤𑆴 𑇆𑇒𑇐𑇆
𑆯𑆳𑆒𑆳𑆱𑆶 𑆰𑆾𑆝𑆯 𑆱𑆴𑆫𑆳𑆂 𑆑𑆾𑆰𑇀𑆜𑆼 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆼𑆮 𑆠𑆶 𑇅 𑆥𑆚𑇀𑆖𑆳𑆯𑆘𑇀𑆘𑆠𑇀𑆫𑆶𑆟𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇆𑇒𑇑𑇆
𑆠𑆠𑇀𑆫 𑆱𑆴𑆫𑆳𑆯𑆠𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆑𑇀𑆡𑇀𑆤𑆴 𑆨𑆮𑆠𑆴; 𑆠𑆳𑆱𑆳𑆁 𑆘𑆳𑆬𑆣𑆫𑆳 𑆠𑇀𑆮𑆼𑆑𑆳, 𑆠𑆴𑆱𑇀𑆫𑆯𑇀𑆖𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆂- 𑆠𑆠𑇀𑆫𑆾𑆫𑇀𑆮𑆵𑆱𑆚𑇀𑆘𑇀𑆚𑆼 𑆢𑇀𑆮𑆼, 𑆬𑆾𑆲𑆴𑆠𑆳𑆑𑇀𑆰𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆖𑆽𑆑𑆳, 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆂; 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆍𑆮𑆩𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂 𑆰𑆾𑆝𑆯 𑆯𑆳𑆒𑆳𑆱𑆶 𑇅 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆖𑇀𑆗𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁, 𑆠𑆳𑆱𑆳𑆩𑆰𑇀𑆛𑆳𑆮𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂- 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆮𑆴𑆛𑆥𑆪𑆾𑆂 , 𑆑𑆛𑆵𑆑𑆠𑆫𑆶𑆟𑆪𑆾𑆯𑇀𑆖; 𑆃𑆰𑇀𑆛𑆳𑆮𑆰𑇀𑆛𑆳𑆮𑆼𑆑𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼, 𑆠𑆳𑆱𑆳𑆩𑆼𑆑𑆽𑆑𑆳𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆳𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆼 𑆖 𑆢𑇀𑆮𑆼; 𑆖𑆠𑆱𑇀𑆫𑆾 𑆮𑆴𑆁𑆯𑆠𑆴𑆯𑇀𑆖 𑆥𑆸𑆰𑇀𑆜𑆼 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆩𑆶𑆨𑆪𑆠𑆂, 𑆠𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆳𑆩𑆴𑆤𑇀𑆪𑆿 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆫𑆴𑆲𑆫𑆼𑆢𑇀𑆧𑆸𑆲𑆠𑆵𑆱𑆴𑆫𑆼; 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮𑆾𑆢𑆫𑆼, 𑆠𑆳𑆱𑆳𑆁 𑆩𑆼𑆞𑇀𑆫𑆾𑆥𑆫𑆴 𑆫𑆾𑆩𑆫𑆳𑆘𑆵𑆩𑆶𑆨𑆪𑆠𑆾 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑇀𑆮𑆑𑇀𑆰𑆱𑆴, 𑆠𑆳𑆱𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂- 𑆲𑆸𑆢𑆪𑆼 𑆢𑇀𑆮𑆼, 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆼, 𑆱𑇀𑆠𑆤𑆫𑆾𑆲𑆴𑆠𑆳𑆥𑆬𑆳𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆼𑆰𑆷𑆨𑆪𑆠𑆾𑇁𑆰𑇀𑆛𑆿; 𑆍𑆮𑆁 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂 𑆥𑆸𑆰𑇀𑆜𑆾𑆢𑆫𑆾𑆫𑆂𑆱𑆶 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆖𑆠𑆶𑆂𑆰𑆰𑇀𑆛𑆁 𑆱𑆴𑆫𑆳𑆯𑆠𑆁 𑆘𑆠𑇀𑆫𑆶𑆟 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆰𑆛𑇀𑆥𑆚𑇀𑆖𑆳𑆯𑆖𑇀𑆗𑆴𑆫𑆾𑆣𑆫𑆳𑆪𑆳𑆁 , 𑆠𑆳𑆱𑆳𑆩𑆰𑇀𑆛𑆿 𑆖𑆠𑆱𑇀𑆫𑆯𑇀𑆖 𑆩𑆫𑇀𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆂 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆢𑇀𑆮𑆼 𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆪𑆾𑆂, 𑆢𑇀𑆮𑆼 𑆮𑆴𑆣𑆶𑆫𑆪𑆾𑆂, 𑆍𑆮𑆁 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁 𑆰𑆾𑆝𑆯𑆳𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆂; 𑆲𑆤𑇀𑆮𑆾𑆫𑆶𑆨𑆪𑆠𑆾𑇁𑆰𑇀𑆛𑆳𑆮𑆰𑇀𑆛𑆿, 𑆠𑆳𑆱𑆳𑆁 𑆠𑆶 𑆱𑆤𑇀𑆣𑆴𑆣𑆩𑆤𑇀𑆪𑆿 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆘𑇀𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆁, 𑆠𑆳𑆱𑆳𑆩𑆣𑆂 𑆰𑆾𑆝𑆯𑆳𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂, 𑆫𑆱𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆮𑆳𑆓𑇀𑆮𑆲𑆼 𑆖 𑆢𑇀𑆮𑆼; 𑆢𑇀𑆮𑆴𑆫𑇀𑆢𑇀𑆮𑆳𑆢𑆯 𑆤𑆳𑆱𑆳𑆪𑆳𑆁, 𑆠𑆳𑆱𑆳𑆩𑆿𑆥𑆤𑆳𑆱𑆴𑆑𑇀𑆪𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆠𑆳𑆱𑆳𑆩𑆼𑆮 𑆖 𑆠𑆳𑆬𑆶𑆤𑇀𑆪𑆼𑆑𑆳𑆁 𑆩𑆸𑆢𑆳𑆮𑆶𑆢𑇀𑆢𑆼𑆯𑆼; 𑆃𑆰𑇀𑆛𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆶𑆨𑆪𑆾𑆫𑇀𑆤𑆼𑆠𑇀𑆫𑆪𑆾𑆂 , 𑆠𑆳𑆱𑆳𑆩𑆼𑆑𑆽𑆑𑆳𑆩𑆥𑆳𑆕𑇀𑆓𑆪𑆾𑆂 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆑𑆫𑇀𑆟𑆪𑆾𑆫𑇀𑆢𑆯, 𑆠𑆳𑆱𑆳𑆁 𑆯𑆧𑇀𑆢𑆮𑆳𑆲𑆴𑆤𑆵𑆩𑆼𑆑𑆽𑆑𑆳𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆤𑆳𑆱𑆳𑆤𑆼𑆠𑇀𑆫𑆓𑆠𑆳𑆱𑇀𑆠𑆶 𑆬𑆬𑆳𑆛𑆼 𑆰𑆰𑇀𑆛𑆴𑆂, 𑆠𑆳𑆱𑆳𑆁 𑆑𑆼𑆯𑆳𑆤𑇀𑆠𑆳𑆤𑆶𑆓𑆠𑆳𑆯𑇀𑆖𑆠𑆱𑇀𑆫, 𑆄𑆮𑆫𑇀𑆠𑆪𑆾𑆫𑆼𑆑𑆽𑆑𑆳, 𑆱𑇀𑆡𑆥𑆤𑇀𑆪𑆳𑆁 𑆖𑆽𑆑𑆳 𑆥𑆫𑆴𑆲𑆫𑇀𑆠𑆮𑇀𑆪𑆳; 𑆯𑆕𑇀𑆒𑆪𑆾𑆫𑇀𑆢𑆯, 𑆠𑆳𑆱𑆳𑆁 𑆯𑆕𑇀𑆒𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆳𑆩𑆼𑆑𑆽𑆑𑆳𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀; 𑆢𑇀𑆮𑆳𑆢𑆯 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴, 𑆠𑆳𑆱𑆳𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆼 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆱𑆵𑆩𑆤𑇀𑆠𑆼𑆰𑇀𑆮𑆼𑆑𑆽𑆑𑆳𑆩𑇀, 𑆍𑆑𑆳𑆩𑆣𑆴𑆥𑆠𑆳𑆮𑆴𑆠𑆴; 𑆍𑆮𑆩𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖𑆳𑆯𑆘𑇀𑆘𑆠𑇀𑆫𑆶𑆟 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆴𑆠𑆴 𑇆𑇒𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑇀𑆪𑆳𑆥𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑇀𑆪𑆨𑆴𑆠𑆾 𑆢𑆼𑆲𑆁 𑆤𑆳𑆨𑆴𑆠𑆂 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑇅 𑆥𑇀𑆫𑆠𑆳𑆤𑆳𑆂 𑆥𑆢𑇀𑆩𑆴𑆤𑆵𑆑𑆤𑇀𑆢𑆳𑆢𑇀𑆧𑆴𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆡𑆳 𑆘𑆬𑆩𑇀 𑇆𑇒𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆮𑆴𑆣𑆴𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆧𑆳𑆬𑆱𑇀𑆡𑆮𑆴𑆫𑆫𑆷𑆑𑇀𑆰𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆨𑆵𑆫𑆶𑆥𑆫𑆴𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆩𑆢𑇀𑆪𑆥𑆳𑆣𑇀𑆮𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑇀𑆯𑆴𑆠𑆮𑆩𑆴𑆠𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆡𑆳𑆥𑆴𑆠𑆳𑆤𑆶𑆮𑆳𑆱𑆴𑆠𑆘𑆳𑆓𑆫𑆴𑆠𑆑𑇀𑆬𑆵𑆧𑆑𑆸𑆯𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆤𑆳𑆁 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆰𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆘𑇀𑆮𑆫𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆾𑆥𑆮𑆳𑆱𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆱𑆴𑆫𑆳𑆁 𑆤 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 , 𑆪𑆳𑆯𑇀𑆖𑆳𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆂, 𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆢𑆸𑆰𑇀𑆛𑆳𑆂, 𑆢𑆸𑆰𑇀𑆛𑆳𑆯𑇀𑆖𑆳𑆪𑆤𑇀𑆠𑇀𑆫𑆴𑆠𑆳𑆂, 𑆪𑆤𑇀𑆠𑇀𑆫𑆴𑆠𑆳𑆯𑇀𑆖𑆳𑆤𑆶𑆠𑇀𑆡𑆴𑆠𑆳 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆯𑆾𑆟𑆴𑆠𑆳𑆮𑆱𑆼𑆑𑆱𑆳𑆣𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆼 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆳𑆱𑇀𑆠𑆼𑆰𑆶 𑆖𑆳𑆥𑆑𑇀𑆮𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆪𑆡𑆳𑆨𑇀𑆪𑆳𑆱𑆁 𑆪𑆡𑆳𑆤𑇀𑆪𑆳𑆪𑆁 𑆖 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇆𑇔𑇆
𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆩𑆥𑆴 𑆖 𑆮𑆴𑆰𑆾𑆥𑆱𑆫𑇀𑆓𑆼 𑆄𑆠𑇀𑆪𑆪𑆴𑆑𑆼 𑆖 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆤𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆩𑇀 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆳𑆠𑆶𑆫𑆁 𑆪𑆡𑆳𑆢𑆾𑆰𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆁 𑆢𑇀𑆫𑆮𑆥𑇀𑆫𑆳𑆪𑆩𑆤𑇀𑆤𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆥𑆵𑆠𑆮𑆤𑇀𑆠𑆁 𑆮𑆳 𑆪𑆡𑆳𑆑𑆳𑆬𑆩𑆶𑆥𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆳𑆱𑆵𑆤𑆁 𑆱𑇀𑆡𑆴𑆠𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑆧𑆳𑆣𑆩𑆳𑆤𑆾 𑆮𑆱𑇀𑆠𑇀𑆫𑆥𑆛𑇀𑆛𑆖𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆫𑇀𑆮𑆬𑇀𑆑𑆬𑆬𑆠𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆪𑆤𑇀𑆠𑇀𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆤𑆳𑆠𑆴𑆓𑆳𑆞𑆁 𑆤𑆳𑆠𑆴𑆯𑆴𑆡𑆴𑆬𑆁 𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆢𑆼𑆯𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆳𑆢𑆳𑆪 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇆𑇖𑇆
𑆤𑆽𑆮𑆳𑆠𑆴𑆯𑆵𑆠𑆼 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆼 𑆤 𑆥𑇀𑆫𑆮𑆳𑆠𑆼 𑆤 𑆖𑆳𑆨𑇀𑆫𑆴𑆠𑆼 𑇅 𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆣𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆩𑆫𑆾𑆓𑆼 𑆮𑆳 𑆑𑆢𑆳𑆖𑆤 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆮𑇀𑆪𑆣𑇀𑆪𑆱𑆴𑆫𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆢𑆴𑆠𑇀𑆪𑆩𑆶𑆒𑆩𑆫𑆠𑇀𑆤𑆴𑆩𑆳𑆠𑇀𑆫𑆾𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆼 𑆇𑆥𑆮𑆼𑆯𑇀𑆪𑆳𑆱𑆤𑆼 𑆱𑆑𑇀𑆡𑇀𑆤𑆾𑆫𑆳𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆪𑆾𑆫𑇀𑆤𑆴𑆮𑆼𑆯𑇀𑆪 𑆑𑆷𑆫𑇀𑆥𑆫𑆼 𑆱𑆤𑇀𑆣𑆴𑆢𑇀𑆮𑆪𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆲𑆱𑇀𑆠𑆳𑆮𑆤𑇀𑆠𑆫𑇀𑆓𑆷𑆞𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆑𑆸𑆠𑆩𑆶𑆰𑇀𑆛𑆵 𑆩𑆤𑇀𑆪𑆪𑆾𑆂 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆯𑆳𑆛𑆑𑆁 𑆓𑇀𑆫𑆵𑆮𑆳𑆩𑆶𑆰𑇀𑆛𑇀𑆪𑆾𑆫𑆶𑆥𑆫𑆴 𑆥𑆫𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆳𑆤𑇀𑆪𑆼𑆤 𑆥𑆶𑆫𑆶𑆰𑆼𑆟 𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆱𑇀𑆡𑆴𑆠𑆼𑆤 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆼𑆤𑆾𑆠𑇀𑆠𑆳𑆤𑆼𑆤 𑆯𑆳𑆛𑆑𑆳𑆤𑇀𑆠𑆢𑇀𑆮𑆪𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆠𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆢𑆑𑇀𑆰𑆴𑆟𑆲𑆱𑇀𑆠𑆼𑆤 𑆱𑆴𑆫𑆾𑆠𑇀𑆡𑆳𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆤𑆳𑆠𑇀𑆪𑆳𑆪𑆠𑆯𑆴𑆡𑆴𑆬𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆳𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆠𑆴, 𑆃𑆱𑆸𑆑𑇀𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆫𑇀𑆡𑆁 𑆖 𑆪𑆤𑇀𑆠𑇀𑆫𑆁 𑆥𑆸𑆰𑇀𑆜𑆩𑆣𑇀𑆪𑆼 𑆥𑆵𑆝𑆪𑆼𑆠𑆴, 𑆑𑆫𑇀𑆩𑆥𑆶𑆫𑆶𑆰𑆁 𑆖 𑆮𑆳𑆪𑆶𑆥𑆷𑆫𑇀𑆟𑆩𑆶𑆒𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀 ; 𑆍𑆰 𑆇𑆠𑇀𑆠𑆩𑆳𑆕𑇀𑆓𑆓𑆠𑆳𑆤𑆳𑆩𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆮𑆫𑇀𑆘𑆳𑆤𑆳𑆁 𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆣𑆤𑆼 𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆮𑆴𑆣𑆴𑆂 𑇅 𑆥𑆳𑆢𑆮𑇀𑆪𑆣𑇀𑆪𑆱𑆴𑆫𑆱𑇀𑆪 𑆥𑆳𑆢𑆁 𑆱𑆩𑆼 𑆱𑇀𑆡𑆳𑆤𑆼 𑆱𑆶𑆱𑇀𑆡𑆴𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆤𑇀𑆪𑆁 𑆥𑆳𑆢𑆩𑆵𑆰𑆠𑇀𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆩𑆶𑆖𑇀𑆖𑆽𑆂 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑇀𑆪𑆣𑇀𑆪𑆱𑆴𑆫𑆁 𑆥𑆳𑆢𑆁 𑆘𑆳𑆤𑆶𑆱𑆤𑇀𑆣𑆼𑆫𑆣𑆂 𑆯𑆳𑆛𑆑𑆼𑆤𑆳𑆮𑆼𑆰𑇀𑆛𑇀𑆪 𑆲𑆱𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪 𑆓𑆶𑆬𑇀𑆦𑆁 𑆮𑇀𑆪𑆣𑇀𑆪𑆥𑇀𑆫𑆢𑆼𑆯𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼 𑆥𑇀𑆬𑆾𑆠𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆮𑆳 𑆥𑆳𑆢𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇅 𑆃𑆡𑆾𑆥𑆫𑆴𑆰𑇀𑆜𑆳𑆢𑇀𑆣𑆱𑇀𑆠𑆿 𑆓𑆷𑆞𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆑𑆸𑆠𑆩𑆶𑆰𑇀𑆛𑆵 𑆱𑆩𑇀𑆪𑆓𑆳𑆱𑆤𑆼 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆁 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆲𑆱𑇀𑆠𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇅 𑆓𑆸𑆣𑇀𑆫𑆱𑆵𑆮𑆴𑆯𑇀𑆮𑆳𑆖𑇀𑆪𑆾𑆂 𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆘𑆳𑆤𑆶𑆑𑆷𑆫𑇀𑆥𑆫𑆱𑇀𑆪 𑇅 𑆯𑇀𑆫𑆾𑆟𑆵𑆥𑆸𑆰𑇀𑆜𑆱𑇀𑆑𑆤𑇀𑆣𑆼𑆰𑆷𑆤𑇀𑆤𑆳𑆩𑆴𑆠𑆥𑆸𑆰𑇀𑆜𑆱𑇀𑆪𑆳𑆮𑆳𑆑𑇀𑆯𑆴𑆫𑆱𑇀𑆑𑆱𑇀𑆪𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑇅 𑆮𑆴𑆱𑇀𑆦𑆷𑆫𑇀𑆘𑆴𑆠𑆥𑆸𑆰𑇀𑆜𑆱𑇀𑆪 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇅 𑆇𑆢𑆫𑆾𑆫𑆱𑆾𑆂 𑆥𑇀𑆫𑆱𑆳𑆫𑆴𑆠𑆾𑆫𑆱𑇀𑆑𑆱𑇀𑆪𑆾𑆤𑇀𑆤𑆳𑆩𑆴𑆠𑆯𑆴𑆫𑆱𑇀𑆑𑆱𑇀𑆪 𑆮𑆴𑆱𑇀𑆦𑆷𑆫𑇀𑆘𑆴𑆠𑆢𑆼𑆲𑆱𑇀𑆪 𑇅 𑆧𑆳𑆲𑆶𑆨𑇀𑆪𑆳𑆩𑆮𑆬𑆩𑇀𑆧𑆩𑆳𑆤𑆢𑆼𑆲𑆱𑇀𑆪 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂 𑇅 𑆃𑆤𑆳𑆩𑆴𑆠𑆩𑆼𑆞𑇀𑆫𑆱𑇀𑆪 𑆩𑆼𑆞𑇀𑆫𑆼 𑇅 𑆇𑆤𑇀𑆤𑆩𑆴𑆠𑆮𑆴𑆢𑆰𑇀𑆛𑆘𑆴𑆲𑇀𑆮𑆳𑆓𑇀𑆫𑆱𑇀𑆪𑆳𑆣𑆾𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆩𑇀 𑇅 𑆃𑆠𑆴𑆮𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆤𑆤𑆱𑇀𑆪 𑆠𑆳𑆬𑆶𑆤𑆴 𑆢𑆤𑇀𑆠𑆩𑆷𑆬𑆼𑆰𑆶 𑆖 𑇅 𑆍𑆮𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆾𑆥𑆳𑆪𑆳𑆤𑆤𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆱𑆴𑆫𑆾𑆠𑇀𑆡𑆳𑆥𑆤𑆲𑆼𑆠𑆷𑆤𑇀 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳𑇁𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆯𑆫𑆵𑆫𑆮𑆯𑆼𑆤 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆯𑆼𑆤 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇘𑇆
𑆩𑆳𑆁𑆱𑆬𑆼𑆰𑇀𑆮𑆮𑆑𑆳𑆯𑆼𑆰𑆶 𑆪𑆮𑆩𑆳𑆠𑇀𑆫𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇁𑆫𑇀𑆣𑆪𑆮𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆼𑆤, 𑆃𑆱𑇀𑆡𑇀𑆤𑆳𑆩𑆶𑆥𑆫𑆴 𑆑𑆶𑆜𑆳𑆫𑆴𑆑𑆪𑆳 𑆮𑆴𑆣𑇀𑆪𑆼𑆢𑆫𑇀𑆣𑆪𑆮𑆩𑆳𑆠𑇀𑆫𑆩𑇀 𑇆𑇙𑇆
𑆮𑇀𑆪𑆨𑇀𑆫𑆼 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀𑆠𑆶 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆑𑆳𑆬𑆼 𑆠𑆶 𑆯𑆵𑆠𑆬𑆼 𑇅 𑆲𑆼𑆩𑆤𑇀𑆠𑆑𑆳𑆬𑆼 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆳𑆬𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇐𑇆
𑆱𑆩𑇀𑆪𑆑𑇀𑆯𑆱𑇀𑆠𑇀𑆫𑆤𑆴𑆥𑆳𑆠𑆼𑆤 𑆣𑆳𑆫𑆪𑆳 𑆪𑆳 𑆱𑇀𑆫𑆮𑆼𑆢𑆱𑆸𑆑𑇀 𑇅 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆁 𑆫𑆶𑆢𑇀𑆣𑆳 𑆠𑆴𑆰𑇀𑆜𑆼𑆖𑇀𑆖 𑆱𑆶𑆮𑆴𑆢𑇀𑆣𑆳𑆁 𑆠𑆳𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆪𑆡𑆳 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆼𑆨𑇀𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆫𑆮𑆠𑆴 𑆥𑆵𑆠𑆴𑆑𑆳 𑇅 𑆠𑆡𑆳 𑆱𑆴𑆫𑆳𑆱𑆶 𑆮𑆴𑆢𑇀𑆣𑆳𑆱𑆶 𑆢𑆶𑆰𑇀𑆛𑆩𑆓𑇀𑆫𑆼 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇑𑇒𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆨𑆵𑆠𑆱𑇀𑆪 𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆠𑆸𑆰𑆴𑆠𑆱𑇀𑆪 𑆖 𑇅 𑆤 𑆮𑆲𑆤𑇀𑆠𑆴 𑆱𑆴𑆫𑆳 𑆮𑆴𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆤𑆶𑆠𑇀𑆡𑆴𑆠𑆪𑆤𑇀𑆠𑇀𑆫𑆴𑆠𑆳𑆂 𑇆𑇑𑇓𑇆
𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆧𑆲𑆶𑆢𑆾𑆰𑆱𑇀𑆪 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆪𑆳𑇁𑆨𑆴𑆲𑆠𑆱𑇀𑆪 𑆖 𑇅 𑆨𑆷𑆪𑆾𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳 𑆱𑆳𑇁𑆥𑆫𑆼𑆢𑇀𑆪𑆶𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆼𑇁𑆥𑆴 𑆮𑆳 𑇆𑇑𑇔𑇆
𑆫𑆑𑇀𑆠𑆁 𑆱𑆯𑆼𑆰𑆢𑆾𑆰𑆁 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆥𑆴 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆤 𑆖𑆳𑆠𑆴𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆼𑆰𑆁 𑆱𑆁𑆯𑆩𑆤𑆽𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆧𑆬𑆴𑆤𑆾 𑆧𑆲𑆶𑆢𑆾𑆰𑆱𑇀𑆪 𑆮𑆪𑆂𑆱𑇀𑆡𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆴𑆟𑆂 𑇅 𑆥𑆫𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆯𑆾𑆟𑆴𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆼 𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫 𑆥𑆳𑆢𑆢𑆳𑆲𑆥𑆳𑆢𑆲𑆫𑇀𑆰𑆖𑆴𑆥𑇀𑆥𑆮𑆴𑆱𑆫𑇀𑆥𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆮𑆳𑆠𑆑𑆟𑇀𑆛𑆑𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳𑆥𑆳𑆢𑆢𑆳𑆫𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆫𑇀𑆩𑆟 𑆇𑆥𑆫𑆴𑆰𑇀𑆜𑆳𑆢𑇀 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼 𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆼𑆤 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀, 𑆯𑇀𑆬𑆵𑆥𑆢𑆼 𑆠𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆪𑆡𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼, 𑆑𑇀𑆫𑆾𑆰𑇀𑆛𑆶𑆑𑆯𑆴𑆫𑆂- 𑆒𑆚𑇀𑆘𑆥𑆕𑇀𑆓𑆶𑆬𑆮𑆳𑆠𑆮𑆼𑆢𑆤𑆳𑆱𑆶 𑆘𑆕𑇀𑆔𑆳𑆪𑆳𑆁 𑆓𑆶𑆬𑇀𑆦𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼, 𑆃𑆥𑆖𑇀𑆪𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆼𑆫𑆣𑆱𑇀𑆠𑆳𑆢𑇀 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼, 𑆘𑆳𑆤𑆶𑆱𑆤𑇀𑆣𑆼𑆫𑆶𑆥𑆫𑇀𑆪𑆣𑆾 𑆮𑆳 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼 𑆓𑆸𑆣𑇀𑆫𑆱𑇀𑆪𑆳𑆁, 𑆈𑆫𑆶𑆩𑆷𑆬𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆁 𑆓𑆬𑆓𑆟𑇀𑆝𑆼, 𑆍𑆠𑆼𑆤𑆼𑆠𑆫𑆱𑆑𑇀𑆡𑆴 𑆧𑆳𑆲𑆷 𑆖 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿; 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆮𑆳𑆩𑆧𑆳𑆲𑆿 𑆑𑆷𑆫𑇀𑆥𑆫𑆱𑆤𑇀𑆣𑆼𑆫𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆾 𑆧𑆳𑆲𑆶𑆩𑆣𑇀𑆪𑆼 𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆴 𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳𑆤𑆳𑆩𑆴𑆑𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆮𑆳, 𑆍𑆮𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆧𑆳𑆲𑆿 𑆪𑆑𑆸𑆢𑇀𑆢𑆳𑆬𑇀𑆪𑆼 (𑆑𑆦𑆾𑆢𑆫𑆼 𑆖,) 𑆍𑆠𑆳𑆩𑆼𑆮 𑆖 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆪𑆾𑆫𑆥𑇀𑆪𑆳𑆢𑆴𑆯𑆤𑇀𑆠𑆴, 𑆓𑆸𑆣𑇀𑆫𑆱𑇀𑆪𑆳𑆩𑆴𑆮 𑆮𑆴𑆯𑇀𑆮𑆳𑆖𑇀𑆪𑆳𑆁, 𑆯𑇀𑆫𑆾𑆟𑆴𑆁 𑆥𑇀𑆫𑆠𑆴 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆪𑆳𑆁 𑆯𑆷𑆬𑆴𑆤𑇀𑆪𑆳𑆁, 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆴𑆑𑆾𑆥𑆢𑆁𑆯𑆯𑆷𑆑𑆢𑆾𑆰𑆯𑆶𑆑𑇀𑆫𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑆶 𑆩𑆼𑆞𑇀𑆫𑆩𑆣𑇀𑆪𑆼, (𑆮𑆸𑆰𑆟𑆪𑆾𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆩𑆷𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳𑆁, 𑆤𑆳𑆨𑆼𑆫𑆣𑆯𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼 𑆱𑆼𑆮𑆤𑇀𑆪𑆳 𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆢𑆑𑆾𑆢𑆫𑆼 ,) 𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆑𑆑𑇀𑆰𑆳𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼𑇁𑆤𑇀𑆠𑆫𑇀𑆮𑆴𑆢𑇀𑆫𑆣𑆿 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆼 𑆖, 𑆧𑆳𑆲𑆶𑆯𑆾𑆰𑆳𑆮𑆧𑆳𑆲𑆶𑆑𑆪𑆾𑆫𑆥𑇀𑆪𑆼𑆑𑆼 𑆮𑆢𑆤𑇀𑆠𑇀𑆪𑆁𑆱𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼, 𑆠𑇀𑆫𑆴𑆑𑆱𑆤𑇀𑆣𑆴𑆩𑆣𑇀𑆪𑆓𑆠𑆳𑆁 𑆠𑆸𑆠𑆵𑆪𑆑𑆼, 𑆃𑆣𑆂𑆱𑇀𑆑𑆤𑇀𑆣𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆳𑆩𑆤𑇀𑆪𑆠𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆡𑆑𑆼, 𑆲𑆤𑆶𑆱𑆤𑇀𑆣𑆴𑆩𑆣𑇀𑆪𑆓𑆠𑆳𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆼, 𑆯𑆕𑇀𑆒𑆑𑆼𑆯𑆳𑆤𑇀𑆠𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆳𑆩𑆶𑆫𑆾𑇁𑆥𑆳𑆕𑇀𑆓𑆬𑆬𑆳𑆛𑆼𑆰𑆶 𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆼, 𑆘𑆴𑆲𑇀𑆮𑆳𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆣𑆾𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆁 𑆢𑆤𑇀𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆖, 𑆠𑆳𑆬𑆶𑆤𑆴 𑆠𑆳𑆬𑆮𑇀𑆪𑆼𑆰𑆶, 𑆑𑆫𑇀𑆟𑆪𑆾𑆫𑆶𑆥𑆫𑆴 𑆱𑆩𑆤𑇀𑆠𑆳𑆠𑇀 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆼 𑆠𑆢𑇀𑆫𑆾𑆓𑆼𑆰𑆶 𑆖, 𑆓𑆤𑇀𑆣𑆳𑆓𑇀𑆫𑆲𑆟𑆼 𑆤𑆳𑆱𑆳𑆫𑆾𑆓𑆼𑆰𑆶 𑆖 𑆤𑆳𑆱𑆳𑆓𑇀𑆫𑆼, 𑆠𑆴𑆩𑆴𑆫𑆳𑆑𑇀𑆰𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆪𑆼𑆰𑆷𑆥𑆤𑆳𑆱𑆴𑆑𑆼 𑆬𑆳𑆬𑆳𑆛𑇀𑆪𑆳𑆩𑆥𑆳𑆕𑇀𑆓𑇀𑆪𑆳𑆁 𑆮𑆳, 𑆍𑆠𑆳 𑆍𑆮 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆣𑆴𑆩𑆤𑇀𑆡𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆴𑆠𑆴 𑇆𑇑𑇗𑇆
𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆪𑆣𑆳 𑆮𑆴𑆁𑆯𑆠𑆴𑆂- 𑆢𑆶𑆫𑇀𑆮𑆴𑆢𑇀𑆣𑆳𑇁𑆠𑆴𑆮𑆴𑆢𑇀𑆮𑆳 𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆳 𑆥𑆴𑆖𑇀𑆖𑆴𑆠𑆳 𑆑𑆶𑆛𑇀𑆛𑆴𑆠𑆳𑇁𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆳𑇁𑆠𑇀𑆪𑆶𑆢𑆵𑆫𑇀𑆟𑆳𑇁𑆤𑇀𑆠𑆼 𑆮𑆴𑆢𑇀𑆣𑆳 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆳 𑆑𑆷𑆟𑆴𑆠𑆳 𑆮𑆼𑆥𑆴𑆠𑆳𑇁𑆤𑆶𑆠𑇀𑆡𑆴𑆠𑆮𑆴𑆢𑇀𑆣𑆳 𑆯𑆱𑇀𑆠𑇀𑆫𑆲𑆠𑆳 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆮𑆴𑆢𑇀𑆣𑆳𑆮𑆴𑆢𑇀𑆣𑆳𑇁𑆮𑇀𑆪𑆣𑇀𑆪𑆳 𑆮𑆴𑆢𑇀𑆫𑆶𑆠𑆳 𑆣𑆼𑆤𑆶𑆑𑆳 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆢𑇀𑆣𑆳 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆩𑆫𑇀𑆩𑆱𑆶 𑆖𑆼𑆠𑆴 𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫 𑆪𑆳 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆯𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆢𑇀𑆣𑆳𑇁𑆮𑇀𑆪𑆑𑇀𑆠𑆩𑆱𑆸𑆑𑇀 𑆱𑇀𑆫𑆮𑆠𑆴 𑆫𑆶𑆘𑆳𑆯𑆾𑆦𑆮𑆠𑆵 𑆖 𑆱𑆳 𑆢𑆶𑆫𑇀𑆮𑆴𑆢𑇀𑆣𑆳, 𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆠𑆴𑆫𑆴𑆑𑇀𑆠𑆮𑆴𑆢𑇀𑆣𑆳𑆪𑆳𑆩𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆯𑆾𑆟𑆴𑆠𑆁 𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆮𑆳 𑆱𑆳𑇁𑆠𑆴𑆮𑆴𑆢𑇀𑆣𑆳, 𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆳𑆪𑆳𑆩𑆥𑇀𑆪𑆼𑆮𑆁, 𑆑𑆶𑆟𑇀𑆜𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆩𑆡𑆴𑆠𑆳 𑆥𑆸𑆡𑆶𑆬𑆵𑆨𑆳𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆳 𑆥𑆴𑆖𑇀𑆖𑆴𑆠𑆳, 𑆃𑆤𑆳𑆱𑆳𑆢𑆴𑆠𑆳 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆫𑆤𑇀𑆠𑆪𑆾𑆯𑇀𑆖 𑆧𑆲𑆶𑆯𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆨𑆴𑆲𑆠𑆳 𑆑𑆶𑆛𑇀𑆛𑆴𑆠𑆳, 𑆯𑆵𑆠𑆨𑆪𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑆴𑆫𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆳 𑆃𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆳, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆲𑆳𑆩𑆶𑆒𑆯𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆢𑇀𑆣𑆳𑇁𑆠𑇀𑆪𑆶𑆢𑆵𑆫𑇀𑆟𑆳, 𑆃𑆬𑇀𑆥𑆫𑆑𑇀𑆠𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑇀𑆪𑆤𑇀𑆠𑆼𑆮𑆴𑆢𑇀𑆣𑆳, 𑆑𑇀𑆰𑆵𑆟𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪𑆳𑆤𑆴𑆬𑆥𑆷𑆫𑇀𑆟𑆳 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆳, 𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆳𑆱𑆳𑆢𑆴𑆠𑆳 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆳 𑆑𑆷𑆟𑆴𑆠𑆳, 𑆢𑆶𑆂𑆱𑇀𑆡𑆳𑆤𑆧𑆤𑇀𑆣𑆤𑆳𑆢𑇀𑆮𑆼𑆥𑆩𑆳𑆤𑆳𑆪𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆱𑆩𑇀𑆩𑆾𑆲𑆾 𑆨𑆮𑆠𑆴 𑆱𑆳 𑆮𑆼𑆥𑆴𑆠𑆳, 𑆃𑆤𑆶𑆠𑇀𑆡𑆴𑆠𑆮𑆴𑆢𑇀𑆣𑆳𑆪𑆳𑆩𑆥𑇀𑆪𑆼𑆮𑆁, 𑆗𑆴𑆤𑇀𑆤𑆳𑇁𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆕𑇀𑆓𑆑𑆫𑆵 𑆯𑆱𑇀𑆠𑇀𑆫𑆲𑆠𑆳, 𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆟𑆴𑆲𑆴𑆠𑆯𑆱𑇀𑆠𑇀𑆫𑆳 𑆑𑆴𑆚𑇀𑆖𑆴𑆖𑇀𑆗𑆼𑆰𑆳 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆮𑆴𑆢𑇀𑆣𑆳, 𑆧𑆲𑆶𑆯𑆂 𑆑𑇀𑆰𑆠𑆳 𑆲𑆵𑆤𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆼𑆤𑆳𑆮𑆴𑆢𑇀𑆣𑆳, 𑆃𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆃𑆮𑇀𑆪𑆣𑇀𑆪𑆳, 𑆃𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆮𑆴𑆢𑇀𑆣𑆳 𑆮𑆴𑆢𑇀𑆫𑆶𑆠𑆳, 𑆥𑇀𑆫𑆢𑆼𑆯𑆱𑇀𑆪 𑆧𑆲𑆶𑆯𑆾𑇁𑆮𑆔𑆛𑇀𑆛𑆤𑆳𑆢𑆳𑆫𑆾𑆲𑆢𑇀𑆮𑇀𑆪𑆣𑆳 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆫𑆳𑆮𑆳 𑆣𑆼𑆤𑆶𑆑𑆳, 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆯𑆱𑇀𑆠𑇀𑆫𑆮𑇀𑆪𑆣𑆤𑆳𑆢𑇀𑆧𑆲𑆶𑆯𑆾 𑆨𑆴𑆤𑇀𑆤𑆳 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆢𑇀𑆣𑆳, 𑆱𑇀𑆤𑆳𑆪𑇀𑆮𑆱𑇀𑆡𑆴𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆣𑆴𑆩𑆫𑇀𑆩𑆱𑆶 𑆮𑆴𑆢𑇀𑆣𑆳 𑆫𑆶𑆘𑆳𑆁 𑆯𑆾𑆦𑆁 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑇆𑇑𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆴𑆫𑆳𑆱𑆶 𑆯𑆴𑆑𑇀𑆰𑆴𑆠𑆾 𑆤𑆳𑆱𑇀𑆠𑆴 𑆖𑆬𑆳 𑆲𑇀𑆪𑆼𑆠𑆳𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂 𑇅 𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆠𑇀 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆠𑇀𑆤𑆼𑆤 𑆠𑆳𑆝𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆃𑆘𑆳𑆤𑆠𑆳 𑆓𑆸𑆲𑆵𑆠𑆼 𑆠𑆶 𑆯𑆱𑇀𑆠𑇀𑆫𑆼 𑆑𑆳𑆪𑆤𑆴𑆥𑆳𑆠𑆴𑆠𑆼 𑇅 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑇀𑆪𑆳𑆥𑆢𑆯𑇀𑆖𑆽𑆠𑆳 𑆧𑆲𑆮𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂 𑇆𑇒𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆨𑆴𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆾𑆓𑆽𑆫𑇀𑆤 𑆠𑆡𑆳 𑆬𑆼𑆥𑆤𑆽𑆫𑆥𑆴 𑇅 𑆪𑆳𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆯𑆳𑆤𑇀𑆠𑆴𑆁 𑆪𑆡𑆳 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆫𑇀𑆣𑆁 𑆯𑆬𑇀𑆪𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇅 𑆪𑆡𑆳 𑆥𑇀𑆫𑆟𑆴𑆲𑆴𑆠𑆂 𑆱𑆩𑇀𑆪𑆓𑇀𑆧𑆱𑇀𑆠𑆴𑆂 𑆑𑆳𑆪𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑇆𑇒𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆮𑆳𑆤𑇀𑆠𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆡𑆳𑆥𑆴𑆠𑆳𑆤𑆶𑆮𑆱𑆴𑆠𑆱𑆴𑆫𑆳𑆮𑆴𑆢𑇀𑆣𑆽𑆂 𑆥𑆫𑆴𑆲𑆫𑇀𑆠𑆮𑇀𑆪𑆳𑆤𑆴- 𑆑𑇀𑆫𑆾𑆣𑆳𑆪𑆳𑆱𑆩𑆽𑆡𑆶𑆤𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆮𑆳𑆓𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆪𑆳𑆤𑆳𑆣𑇀𑆪𑆪𑆤𑆱𑇀𑆡𑆳𑆤𑆳𑆱𑆤𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆯𑆵𑆠𑆮𑆳𑆠𑆳𑆠𑆥𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆳𑆧𑆬𑆬𑆳𑆨𑆳𑆠𑇀 , 𑆩𑆳𑆱𑆩𑆼𑆑𑆼 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑇅 𑆍𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆱𑇀𑆠𑆫𑆩𑆶𑆥𑆫𑆴𑆰𑇀𑆜𑆳𑆢𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇒𑇔𑇆
𑆱𑆴𑆫𑆳𑆮𑆴𑆰𑆳𑆟𑆠𑆶𑆩𑇀𑆧𑆽𑆱𑇀𑆠𑆶 𑆘𑆬𑆿𑆑𑆳𑆨𑆴𑆂 𑆥𑆢𑆽𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆮𑆓𑆳𑆞𑆁 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆩𑇀 𑇆𑇒𑇕𑇆
𑆃𑆮𑆓𑆳𑆞𑆼 𑆘𑆬𑆿𑆑𑆳 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆖𑇀𑆗𑆤𑇀𑆤𑆁 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆼 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆱𑆴𑆫𑆳𑇁𑆕𑇀𑆓𑆮𑇀𑆪𑆳𑆥𑆑𑆼 𑆫𑆑𑇀𑆠𑆼 𑆯𑆸𑆕𑇀𑆓𑆳𑆬𑆳𑆧𑆷 𑆠𑇀𑆮𑆖𑆴 𑆱𑇀𑆡𑆴𑆠𑆼 𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆣𑆩𑆤𑆵𑆮𑇀𑆪𑆳𑆑𑆫𑆟𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆣𑆩𑆤𑇀𑆪𑆾 𑆤𑆳𑆨𑆴𑆥𑇀𑆫𑆨𑆮𑆳 𑆃𑆨𑆴𑆲𑆴𑆠𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂- 𑆱𑆴𑆫𑆳𑆣𑆩𑆤𑆵𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆮𑆴𑆨𑆳𑆓𑆂, 𑆱𑆴𑆫𑆳𑆮𑆴𑆑𑆳𑆫𑆳 𑆍𑆮 𑆲𑆴 𑆣𑆩𑆤𑇀𑆪𑆂 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆃𑆤𑇀𑆪𑆳 𑆍𑆮 𑆲𑆴 𑆣𑆩𑆤𑇀𑆪𑆂 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆖 𑆱𑆴𑆫𑆳𑆨𑇀𑆪𑆂; 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆤𑇀𑆪𑆠𑇀𑆮𑆳𑆤𑇀, 𑆩𑆷𑆬𑆱𑆤𑇀𑆤𑆴𑆪𑆩𑆳𑆠𑇀, 𑆑𑆫𑇀𑆩𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆳𑆠𑇀, 𑆄𑆓𑆩𑆳𑆖𑇀𑆖; 𑆑𑆼𑆮𑆬𑆁 𑆠𑆶 𑆥𑆫𑆱𑇀𑆥𑆫𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆳𑆠𑇀 𑆱𑆢𑆸𑆯𑆳𑆓𑆩𑆑𑆫𑇀𑆩𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆖𑇀𑆖 𑆮𑆴𑆨𑆑𑇀𑆠𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑆥𑇀𑆪𑆮𑆴𑆨𑆳𑆓 𑆅𑆮 𑆑𑆫𑇀𑆩𑆱𑆶 𑆨𑆮𑆠𑆴 𑇆𑇓𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆓𑆳𑆂 𑆯𑆧𑇀𑆢𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆥𑇀𑆫𑆯𑇀𑆮𑆳𑆱𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆘𑆸𑆩𑇀𑆨𑆴𑆠𑆑𑇀𑆰𑆶𑆢𑇀𑆣𑆱𑆴𑆠𑆑𑆡𑆴𑆠𑆫𑆶𑆢𑆴𑆠𑆳𑆢𑆵𑆤𑇀 𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆨𑆴𑆮𑆲𑆤𑇀𑆠𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆁 𑆣𑆳𑆫𑆪𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆱𑇀𑆠𑆶 𑆲𑆸𑆢𑆪𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆣𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆠𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆫𑆱𑆳𑆤𑇀 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆮𑆲𑆠𑆱𑇀𑆠𑆳 𑆢𑆯, 𑆯𑆧𑇀𑆢𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆳𑆤𑆰𑇀𑆛𑆳𑆨𑆴𑆫𑇀𑆓𑆸𑆲𑇀𑆟𑆵𑆠𑆼, 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆨𑆳𑆰𑆠𑆼, 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆔𑆾𑆰𑆁 𑆑𑆫𑆾𑆠𑆴, 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑇀𑆮𑆥𑆴𑆠𑆴, 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆧𑆶𑆣𑇀𑆪𑆠𑆼, 𑆢𑇀𑆮𑆼 𑆖𑆳𑆯𑇀𑆫𑆶𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆿, 𑆢𑇀𑆮𑆼 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆮𑆲𑆠𑆂 𑆱𑇀𑆠𑆤𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆼, 𑆠𑆼 𑆍𑆮 𑆯𑆶𑆑𑇀𑆫𑆁 𑆤𑆫𑆱𑇀𑆪 𑆱𑇀𑆠𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆨𑆴𑆮𑆲𑆠𑆂, 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑆱𑆮𑆴𑆨𑆳𑆓𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇅 𑆍𑆠𑆳𑆨𑆴𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆤𑆳𑆨𑆼𑆫𑆶𑆢𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆾𑆫𑆂𑆱𑇀𑆑𑆤𑇀𑆣𑆓𑇀𑆫𑆵𑆮𑆳𑆧𑆳𑆲𑆮𑆾 𑆣𑆳𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆳𑆥𑇀𑆪𑆤𑇀𑆠𑆼 𑆖 𑇆𑇕𑇆
𑆃𑆣𑆾𑆓𑆩𑆳𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑆶𑆑𑇀𑆫𑆳𑆫𑇀𑆠𑆮𑆳𑆢𑆵𑆤𑇀𑆪𑆣𑆾 𑆮𑆲𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆱𑇀𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆳𑆯𑆪𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆠𑇀𑆫𑆱𑇀𑆡𑆩𑆼𑆮𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆫𑆱𑆁 𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑆿𑆰𑇀𑆟𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆮𑆼𑆖𑆪𑆤𑇀𑆠𑇀𑆪𑆾𑇁𑆨𑆴𑆮𑆲𑆤𑇀𑆠𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆁 𑆠𑆫𑇀𑆥𑆪𑆤𑇀𑆠𑆴, 𑆃𑆫𑇀𑆥𑆪𑆤𑇀𑆠𑆴 𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆓𑆳𑆤𑆳𑆁 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆳𑆟𑆳𑆁 𑆖, 𑆫𑆱𑆱𑇀𑆡𑆳𑆤𑆁 𑆖𑆳𑆨𑆴𑆥𑆷𑆫𑆪𑆤𑇀𑆠𑆴, 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆮𑆼𑆢𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆮𑆼𑆖𑆪𑆤𑇀𑆠𑆴; 𑆄𑆩𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆳𑆤𑇀𑆠𑆫𑆼 𑆖 𑆠𑇀𑆫𑆴𑆣𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀; 𑆠𑆳𑆱𑆳𑆁 𑆠𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆫𑆱𑆳𑆤𑇀 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆮𑆲𑆠𑆱𑇀𑆠𑆳 𑆢𑆯, 𑆢𑇀𑆮𑆼 𑆃𑆤𑇀𑆤𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆳𑆮𑆤𑇀𑆠𑇀𑆫𑆳𑆯𑇀𑆫𑆴𑆠𑆼, 𑆠𑆾𑆪𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆩𑆷𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆼 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆼 𑆢𑇀𑆮𑆼 𑆯𑆶𑆑𑇀𑆫𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆳𑆪, 𑆢𑇀𑆮𑆼 𑆮𑆴𑆱𑆫𑇀𑆓𑆳𑆪, 𑆠𑆼 𑆍𑆮 𑆫𑆑𑇀𑆠𑆩𑆨𑆴𑆮𑆲𑆠𑆾 𑆮𑆴𑆱𑆸𑆘𑆠𑆯𑇀𑆖 𑆤𑆳𑆫𑆵𑆟𑆳𑆩𑆳𑆫𑇀𑆠𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆁, 𑆢𑇀𑆮𑆼 𑆮𑆫𑇀𑆖𑆾𑆤𑆴𑆫𑆱𑆤𑇀𑆪𑆿 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆼, 𑆃𑆰𑇀𑆛𑆳𑆮𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆳𑆩𑆴𑆤𑆵𑆤𑆳𑆁 𑆣𑆩𑆤𑆵𑆤𑆳𑆁 𑆱𑇀𑆮𑆼𑆢𑆩𑆫𑇀𑆥𑆪𑆤𑇀𑆠𑆴; 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑆱𑆮𑆴𑆨𑆳𑆓𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇅 𑆍𑆠𑆳𑆨𑆴𑆫𑆣𑆾𑆤𑆳𑆨𑆼𑆂 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆑𑆛𑆵𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆓𑆶𑆢𑆧𑆱𑇀𑆠𑆴𑆩𑆼𑆞𑇀𑆫𑆱𑆑𑇀𑆡𑆵𑆤𑆴 𑆣𑆳𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆳𑆥𑇀𑆪𑆤𑇀𑆠𑆼 𑆖 𑇆𑇗𑇆
𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆳𑆟𑆳𑆁 𑆠𑆶 𑆖𑆠𑆱𑆸𑆟𑆳𑆁 𑆣𑆩𑆤𑆵𑆤𑆳𑆩𑆼𑆑𑆽𑆑𑆳 𑆯𑆠𑆣𑆳 𑆱𑆲𑆱𑇀𑆫𑆣𑆳 𑆖𑆾𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆁 𑆮𑆴𑆨𑆘𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆂, 𑆠𑆳𑆨𑆴𑆫𑆴𑆢𑆁 𑆯𑆫𑆵𑆫𑆁 𑆓𑆮𑆳𑆑𑇀𑆰𑆴𑆠𑆁 𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆳𑆠𑆠𑆁 𑆖, 𑆠𑆳𑆱𑆳𑆁 𑆩𑆶𑆒𑆳𑆤𑆴 𑆫𑆾𑆩𑆑𑆷𑆥𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆳𑆤𑆴, 𑆪𑆽𑆂 𑆱𑇀𑆮𑆼𑆢𑆩𑆨𑆴𑆮𑆲𑆤𑇀𑆠𑆴 𑆫𑆱𑆁 𑆖𑆳𑆨𑆴𑆠𑆫𑇀𑆥𑆪𑆤𑇀𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆧𑆲𑆴𑆯𑇀𑆖 , 𑆠𑆽𑆫𑆼𑆮 𑆖𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆳𑆬𑆼𑆥𑆤𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑇀𑆪𑆤𑇀𑆠𑆂𑆯𑆫𑆵𑆫𑆩𑆨𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑇀𑆮𑆖𑆴 𑆮𑆴𑆥𑆑𑇀𑆮𑆳𑆤𑆴, 𑆠𑆽𑆫𑆼𑆮 𑆖 𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆱𑆶𑆒𑆩𑆱𑆶𑆒𑆁 𑆮𑆳 𑆓𑆸𑆲𑇀𑆟𑆵𑆠𑆼, 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆳𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆾 𑆣𑆩𑆤𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆓𑆠𑆳𑆂 𑆱𑆮𑆴𑆨𑆳𑆓𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇙𑇆
𑆪𑆡𑆳 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂 𑆒𑆳𑆤𑆴 𑆩𑆸𑆟𑆳𑆬𑆼𑆰𑆶 𑆧𑆴𑆱𑆼𑆰𑆶 𑆖 𑇅 𑆣𑆩𑆤𑆵𑆤𑆳𑆁 𑆠𑆡𑆳 𑆒𑆳𑆤𑆴 𑆫𑆱𑆾 𑆪𑆽𑆫𑆶𑆥𑆖𑆵𑆪𑆠𑆼 𑇆𑇑𑇐𑇆
𑆥𑆚𑇀𑆖𑆳𑆨𑆴𑆨𑆷𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆡 𑆥𑆚𑇀𑆖𑆑𑆸𑆠𑇀𑆮𑆂 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆥𑆚𑇀𑆖𑆱𑆶 𑆨𑆳𑆮𑆪𑆤𑇀𑆠𑆴 𑇅 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆥𑆚𑇀𑆖𑆱𑆶 𑆨𑆳𑆮𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆚𑇀𑆖𑆠𑇀𑆮𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆮𑆴𑆤𑆳𑆯𑆑𑆳𑆬𑆼 𑇆𑇑𑇑𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆩𑆷𑆬𑆮𑆴𑆢𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆳𑆤𑆴 𑆠𑆶 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀𑆤𑆾𑆢𑆑𑆫𑆱𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑆶𑆑𑇀𑆫𑆳𑆫𑇀𑆠𑆮𑆮𑆲𑆳𑆤𑆴, 𑆪𑆼𑆰𑇀𑆮𑆣𑆴𑆑𑆳𑆫𑆂; 𑆍𑆑𑆼𑆰𑆳𑆁 𑆧𑆲𑆷𑆤𑆴; 𑆍𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆳 𑆧𑆲𑆮𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆲𑆸𑆢𑆪𑆁 𑆫𑆱𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆑𑇀𑆫𑆾𑆯𑆤𑆮𑆴𑆤𑆩𑆤𑆩𑆾𑆲𑆤𑆨𑇀𑆫𑆩𑆟𑆮𑆼𑆥𑆤𑆳𑆤𑆴 𑆩𑆫𑆟𑆁 𑆮𑆳 𑆨𑆮𑆠𑆴; 𑆃𑆤𑇀𑆤𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆩𑆳𑆩𑆳𑆯𑆪𑆾𑇁𑆤𑇀𑆤𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆯𑆷𑆬𑆾𑇁𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆂 𑆥𑆴𑆥𑆳𑆱𑆳𑇁𑇁𑆤𑇀𑆣𑇀𑆪𑆁 𑆩𑆫𑆟𑆁 𑆖; 𑆇𑆢𑆑𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆠𑆳𑆬𑆶 𑆑𑇀𑆬𑆾𑆩 𑆖, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆥𑆴𑆥𑆳𑆱𑆳 𑆱𑆢𑇀𑆪𑆾𑆩𑆫𑆟𑆁 𑆖; 𑆫𑆱𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆲𑆸𑆢𑆪𑆁 𑆫𑆱𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆯𑆾𑆰𑆂𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆮𑆴𑆢𑇀𑆣𑆮𑆖𑇀𑆖 𑆩𑆫𑆟𑆁 𑆠𑆬𑇀𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖; 𑆫𑆑𑇀𑆠𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆿 𑆫𑆑𑇀𑆠𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂 , 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆯𑇀𑆪𑆳𑆮𑆳𑆕𑇀𑆓𑆠𑆳 𑆘𑇀𑆮𑆫𑆾 𑆢𑆳𑆲𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳 𑆯𑆾𑆟𑆴𑆠𑆳𑆓𑆩𑆤𑆁 𑆫𑆑𑇀𑆠𑆤𑆼𑆠𑇀𑆫𑆠𑆳 𑆖; 𑆩𑆳𑆁𑆱𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆱𑇀𑆤𑆳𑆪𑆶𑆠𑇀𑆮𑆖𑆁 𑆫𑆑𑇀𑆠𑆮𑆲𑆳𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆰𑆂 𑆱𑆴𑆫𑆳𑆓𑇀𑆫𑆤𑇀𑆡𑆪𑆾 𑆩𑆫𑆟𑆁 𑆖; 𑆩𑆼𑆢𑆾𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆑𑆛𑆵 𑆮𑆸𑆑𑇀𑆑𑆿 𑆖, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑇀𑆮𑆼𑆢𑆳𑆓𑆩𑆤𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆕𑇀𑆓𑆠𑆳 𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆂 𑆱𑇀𑆡𑆷𑆬𑆯𑆾𑆦𑆠𑆳 𑆥𑆴𑆥𑆳𑆱𑆳 𑆖; 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆩𑆼𑆞𑇀𑆫𑆁 𑆖, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆤𑆢𑇀𑆣𑆧𑆱𑇀𑆠𑆴𑆠𑆳 𑆩𑆷𑆠𑇀𑆫𑆤𑆴𑆫𑆾𑆣𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆼𑆞𑇀𑆫𑆠𑆳 𑆖; 𑆥𑆶𑆫𑆵𑆰𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆾 𑆓𑆶𑆢𑆁 𑆖, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆤𑆳𑆲𑆾 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆠𑆳 𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆤𑇀𑆠𑇀𑆫𑆠𑆳 𑆖; 𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆱𑇀𑆠𑆤𑆿 𑆮𑆸𑆰𑆟𑆿 𑆖, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆑𑇀𑆬𑆵𑆧𑆠𑆳 𑆖𑆴𑆫𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆼𑆑𑆾 𑆫𑆑𑇀𑆠𑆯𑆶𑆑𑇀𑆫𑆠𑆳 𑆖 ; 𑆄𑆫𑇀𑆠𑆮𑆲𑆼 𑆢𑇀𑆮𑆼, 𑆠𑆪𑆾𑆫𑇀𑆩𑆷𑆬𑆁 𑆓𑆫𑇀𑆨𑆳𑆯𑆪 𑆄𑆫𑇀𑆠𑆮𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆠𑆠𑇀𑆫 𑆮𑆴𑆢𑇀𑆣𑆳𑆪𑆳 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆠𑇀𑆮𑆁 𑆩𑆽𑆡𑆶𑆤𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆩𑆳𑆫𑇀𑆠𑆮𑆤𑆳𑆯𑆯𑇀𑆖; 𑆱𑆼𑆮𑆤𑆵𑆖𑇀𑆗𑆼𑆢𑆳𑆢𑇀𑆫𑆶𑆘𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂; 𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆢𑆮𑆴𑆢𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆩𑆴𑆠𑆴 𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆢𑇀𑆣𑆁 𑆠𑆶 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆇𑆢𑇀𑆣𑆸𑆠𑆯𑆬𑇀𑆪𑆁 𑆠𑆶 𑆑𑇀𑆰𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆷𑆬𑆳𑆠𑇀 𑆒𑆳𑆢𑆤𑇀𑆠𑆫𑆁 𑆢𑆼𑆲𑆼 𑆥𑇀𑆫𑆱𑆸𑆠𑆁 𑆠𑇀𑆮𑆨𑆴𑆮𑆳𑆲𑆴 𑆪𑆠𑇀 𑇅 𑆱𑇀𑆠𑇀𑆫𑆾𑆠𑆱𑇀𑆠𑆢𑆴𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆁 𑆱𑆴𑆫𑆳𑆣𑆩𑆤𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆮𑇀𑆪𑆳𑆑𑆫𑆟𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆮𑆩𑆼 𑆩𑆳𑆱𑆴 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆳𑆫𑆩𑆼𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼 𑆠𑆴𑆡𑇀𑆪𑆳𑆢𑆿 𑇅 𑆠𑆠𑇀𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆑𑇀𑆰𑆠𑇀𑆫𑆴𑆪𑆮𑆽𑆯𑇀𑆪𑆯𑆷𑆢𑇀𑆫𑆳𑆟𑆳𑆁 𑆯𑇀𑆮𑆼𑆠𑆫𑆑𑇀𑆠𑆥𑆵𑆠𑆑𑆸𑆰𑇀𑆟𑆼𑆰𑆶 𑆨𑆷𑆩𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆼𑆰𑆶 𑆧𑆴𑆬𑇀𑆮𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆤𑆴𑆫𑇀𑆩𑆴𑆠𑆱𑆫𑇀𑆮𑆳𑆓𑆳𑆫𑆁 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆁 𑆠𑆤𑇀𑆩𑆪𑆥𑆫𑇀𑆪𑆕𑇀𑆑𑆁 𑆱𑆩𑆶𑆥𑆬𑆴𑆥𑇀𑆠𑆨𑆴𑆠𑇀𑆠𑆴𑆁 𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆥𑆫𑆴𑆖𑇀𑆗𑆢𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆢𑇀𑆮𑆳𑆫𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆢𑇀𑆮𑆳𑆫𑆁 𑆮𑆳𑇁𑆰𑇀𑆛𑆲𑆱𑇀𑆠𑆳𑆪𑆠𑆁 𑆖𑆠𑆶𑆫𑇀𑆲𑆱𑇀𑆠𑆮𑆴𑆱𑇀𑆠𑆸𑆠𑆁 𑆫𑆑𑇀𑆰𑆳𑆩𑆕𑇀𑆓𑆬𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆮𑆴𑆣𑆼𑆪𑆩𑇀 𑇆𑇕𑇆
𑆘𑆳𑆠𑆼 𑆲𑆴 𑆯𑆴𑆡𑆴𑆬𑆼 𑆑𑆶𑆑𑇀𑆰𑆿 𑆩𑆶𑆑𑇀𑆠𑆼 𑆲𑆸𑆢𑆪𑆧𑆤𑇀𑆣𑆤𑆼 𑇅 𑆱𑆯𑆷𑆬𑆼 𑆘𑆔𑆤𑆼 𑆤𑆳𑆫𑆵 𑆘𑇀𑆚𑆼𑆪𑆳 𑆱𑆳 𑆠𑆶 𑆥𑇀𑆫𑆘𑆳𑆪𑆴𑆤𑆵 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫𑆾𑆥𑆱𑇀𑆡𑆴𑆠𑆥𑇀𑆫𑆱𑆮𑆳𑆪𑆳𑆂 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆠𑆴 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆠𑇀𑆪𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆥𑆶𑆫𑆵𑆰𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆱𑆴𑆖𑇀𑆪𑆠𑆼 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆖 𑇆𑇗𑇆
𑆥𑇀𑆫𑆘𑆤𑆪𑆴𑆰𑇀𑆪𑆩𑆳𑆟𑆳𑆁 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆳𑆁 𑆑𑆶𑆩𑆳𑆫𑆥𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆥𑆶𑆤𑇀𑆤𑆳𑆩𑆦𑆬𑆲𑆱𑇀𑆠𑆳𑆁 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆳𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆳𑆩𑆡𑆽𑆤𑆳𑆁 𑆱𑆩𑇀𑆨𑆸𑆠𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆩𑆳𑆑𑆟𑇀𑆜𑆳𑆠𑇀 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆑𑆸𑆠𑆾𑆥𑆣𑆳𑆤𑆼 𑆩𑆸𑆢𑆶𑆤𑆴 𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆼 𑆯𑆪𑆤𑆼 𑆱𑇀𑆡𑆴𑆠𑆳𑆩𑆳𑆨𑆶𑆓𑇀𑆤𑆱𑆑𑇀𑆡𑆵𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆳𑆩𑆯𑆕𑇀𑆑𑆤𑆵𑆪𑆳𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂 𑆥𑆫𑆴𑆟𑆠𑆮𑆪𑆱𑆂 𑆥𑇀𑆫𑆘𑆤𑆤𑆑𑆶𑆯𑆬𑆳𑆂 𑆑𑆫𑇀𑆠𑆴𑆠𑆤𑆒𑆳𑆂 𑆥𑆫𑆴𑆖𑆫𑆼𑆪𑆶𑆫𑆴𑆠𑆴 𑇆𑇘𑇆
𑆃𑆡𑆳𑆱𑇀𑆪𑆳 𑆮𑆴𑆯𑆴𑆒𑆳𑆤𑇀𑆠𑆫𑆩𑆤𑆶𑆬𑆾𑆩𑆩𑆤𑆶𑆱𑆶𑆒𑆩𑆨𑇀𑆪𑆘𑇀𑆪𑆳𑆤𑆶𑆧𑇀𑆫𑆷𑆪𑆳𑆖𑇀𑆖𑆽𑆠𑆳𑆩𑆼𑆑𑆳 - 𑆱𑆶𑆨𑆓𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆱𑇀𑆮𑆼𑆠𑆴, 𑆤𑆖𑆳𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆮𑆵 𑆥𑇀𑆫𑆮𑆳𑆲𑆱𑇀𑆮, 𑆠𑆠𑆾 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆼 𑆓𑆫𑇀𑆨𑆤𑆳𑆝𑆵𑆥𑇀𑆫𑆧𑆤𑇀𑆣𑆼 𑆱𑆯𑆷𑆬𑆼𑆰𑆶 𑆯𑇀𑆫𑆾𑆟𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆂𑆱𑆶 𑆖 𑆥𑇀𑆫𑆮𑆳𑆲𑆼𑆡𑆳𑆂 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆂, 𑆠𑆠𑆾 𑆓𑆫𑇀𑆨𑆤𑆴𑆫𑇀𑆓𑆩𑆼 𑆥𑇀𑆫𑆓𑆳𑆞𑆁, 𑆠𑆠𑆾 𑆓𑆫𑇀𑆨𑆼 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆼 𑆓𑆳𑆞𑆠𑆫𑆩𑆳𑆮𑆴𑆯𑆬𑇀𑆪𑆨𑆳𑆮𑆳𑆠𑇀; 𑆃𑆑𑆳𑆬𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆳𑆢𑇀𑆧𑆣𑆴𑆫𑆁 𑆩𑆷𑆑𑆁 𑆑𑆶𑆧𑇀𑆘𑆁 𑆮𑇀𑆪𑆱𑇀𑆠𑆲𑆤𑆶𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆳𑆨𑆴𑆔𑆳𑆠𑆴𑆤𑆁 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆰𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆮𑆴𑆑𑆛𑆁 𑆮𑆳 𑆘𑆤𑆪𑆠𑆴 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆩𑆤𑆶𑆬𑆾𑆩𑆪𑆼𑆠𑇀, 𑆥𑇀𑆫𑆳𑆚𑇀𑆘𑆬𑆩𑆳𑆑𑆫𑇀𑆰𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆓𑆫𑇀𑆨𑆱𑆕𑇀𑆓𑆼 𑆠𑆶 𑆪𑆾𑆤𑆴𑆁 𑆣𑆷𑆥𑆪𑆼𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆤𑆴𑆫𑇀𑆩𑆾𑆑𑆼𑆟 𑆥𑆴𑆟𑇀𑆝𑆵𑆠𑆑𑆼𑆤 𑆮𑆳, 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆢𑇀𑆣𑆴𑆫𑆟𑇀𑆪𑆥𑆶𑆰𑇀𑆥𑆵𑆩𑆷𑆬𑆁 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆪𑆾𑆂, 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆁 𑆮𑆴𑆯𑆬𑇀𑆪𑆳𑆁 𑆮𑆳 𑇆𑇑𑇑𑇆
𑆃𑆡 𑆘𑆳𑆠𑆱𑇀𑆪𑆾𑆬𑇀𑆧𑆁 𑆩𑆶𑆒𑆁 𑆖 𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆮𑆴𑆯𑆾𑆣𑇀𑆪, 𑆔𑆸𑆠𑆳𑆑𑇀𑆠𑆁 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆥𑆴𑆖𑆶𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆠𑆾 𑆤𑆳𑆨𑆴𑆤𑆳𑆝𑆵𑆩𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑆳𑆪𑆩𑇀𑆪 𑆱𑆷𑆠𑇀𑆫𑆼𑆟 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆗𑆼𑆢𑆪𑆼𑆠𑇀, 𑆠𑆠𑇀𑆱𑆷𑆠𑇀𑆫𑆽𑆑𑆢𑆼𑆯𑆁 𑆖 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁 𑆱𑆩𑇀𑆪𑆓𑇀 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇑𑇒𑇆
𑆃𑆡 𑆑𑆶𑆩𑆳𑆫𑆁 𑆯𑆵𑆠𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆫𑆳𑆯𑇀𑆮𑆳𑆱𑇀𑆪 𑆘𑆳𑆠𑆑𑆫𑇀𑆩𑆟𑆴 𑆑𑆸𑆠𑆼 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑆤𑆤𑇀𑆠𑆖𑆷𑆫𑇀𑆟𑆩𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑇁𑆤𑆳𑆩𑆴𑆑𑆪𑆳 𑆬𑆼𑆲𑆪𑆼𑆠𑇀; 𑆠𑆠𑆾 𑆧𑆬𑆳𑆠𑆽𑆬𑆼𑆤𑆳𑆨𑇀𑆪𑆘𑇀𑆪, 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆾𑆢𑆑𑆼𑆤 𑆮𑆳 𑆫𑆷𑆥𑇀𑆪𑆲𑆼𑆩𑆥𑇀𑆫𑆠𑆥𑇀𑆠𑆼𑆤 𑆮𑆳 𑆮𑆳𑆫𑆴𑆟𑆳 𑆱𑇀𑆤𑆳𑆥𑆪𑆼𑆢𑆼𑆤𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆥𑆠𑇀𑆫𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆳 𑆑𑆾𑆰𑇀𑆟𑆼𑆤 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆪𑆡𑆳𑆮𑆴𑆨𑆮𑆁 𑆖 𑇆𑇑𑇓𑇆
𑆣𑆩𑆤𑆵𑆤𑆳𑆁 𑆲𑆸𑆢𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆮𑆴𑆮𑆸𑆠𑆠𑇀𑆮𑆳𑆢𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇅 𑆖𑆠𑆷𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑇀𑆮𑆳 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇑𑇔𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆡𑆩𑆼𑇁𑆲𑇀𑆤𑆴 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑆤𑆤𑇀𑆠𑆩𑆴𑆯𑇀𑆫𑆁 𑆩𑆤𑇀𑆠𑇀𑆫𑆥𑆷𑆠𑆁 𑆠𑇀𑆫𑆴𑆑𑆳𑆬𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆬𑆑𑇀𑆰𑇀𑆩𑆟𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂, 𑆠𑆸𑆠𑆵𑆪𑆼 𑆖; 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆕𑇀𑆤𑆴𑆮𑆳𑆫𑆴𑆠𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑇀𑆮𑆥𑆳𑆟𑆴𑆠𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆁 𑆢𑇀𑆮𑆴𑆑𑆳𑆬𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆣𑆤𑇀𑆮𑆨𑆷𑆩𑆴𑆘𑆳𑆠𑆳𑆁 𑆠𑆶 𑆱𑆷𑆠𑆴𑆑𑆳𑆁 𑆔𑆸𑆠𑆠𑆽𑆬𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆥𑆳𑆤𑆳𑆁, 𑆱𑇀𑆤𑆼𑆲𑆤𑆴𑆠𑇀𑆪𑆳 𑆖 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆥𑆚𑇀𑆖𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆧𑆬𑆮𑆠𑆵 ; 𑆃𑆧𑆬𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆥𑆚𑇀𑆖𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑇅 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼𑆤𑆳𑆤𑇀𑆤𑆱𑆁𑆱𑆫𑇀𑆓𑆼𑆟𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆥𑇀𑆫𑆳𑆪𑆯𑆯𑇀𑆖𑆽𑆤𑆳𑆁 𑆥𑇀𑆫𑆨𑆷𑆠𑆼𑆤𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆼𑆤 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆼𑆠𑇀, 𑆑𑇀𑆫𑆾𑆣𑆳𑆪𑆳𑆱𑆩𑆽𑆡𑆶𑆤𑆳𑆢𑆵𑆁𑆯𑇀𑆖 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇑𑇘𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆖𑆳𑆫𑆳𑆠𑇀 𑆱𑆷𑆠𑆴𑆑𑆳𑆪𑆳 𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼 𑇅 𑆱 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆾 𑆮𑆳 𑆨𑆮𑆼𑆢𑆠𑇀𑆪𑆥𑆠𑆫𑇀𑆥𑆟𑆳𑆠𑇀 𑇆𑇑𑇙𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆳𑆁 𑆢𑆼𑆯𑆑𑆳𑆬𑆿 𑆖 𑆮𑇀𑆪𑆳𑆣𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤 𑆑𑆫𑇀𑆩𑆟𑆳 𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆾𑆥𑆖𑆫𑆼𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆩𑆼𑆮𑆁 𑆤𑆳𑆠𑇀𑆪𑆪𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇆𑇒𑇐𑇆
𑆃𑆡𑆳𑆥𑆫𑆳𑇁𑆥𑆠𑆤𑇀𑆠𑇀𑆪𑆳𑆤𑆳𑆲𑆳𑆣𑇀𑆩𑆳𑆤𑆿 𑆑𑆶𑆫𑆶𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑆟𑇀𑆜𑆩𑆱𑇀𑆪𑆳𑆂 𑆑𑆼𑆯𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆪𑆳𑇁𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳 𑆥𑇀𑆫𑆩𑆸𑆘𑆼𑆠𑇀, 𑆑𑆛𑆶𑆑𑆳𑆬𑆳𑆧𑆶𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆱𑆫𑇀𑆰𑆥𑆱𑆫𑇀𑆥𑆤𑆴𑆫𑇀𑆩𑆾𑆑𑆽𑆫𑇀𑆮𑆳 𑆑𑆛𑆶𑆠𑆽𑆬𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑇀𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆣𑆷𑆥𑆪𑆼𑆠𑇀, 𑆬𑆳𑆕𑇀𑆓𑆬𑆵𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆼𑆤 𑆮𑆳𑇁𑆱𑇀𑆪𑆳𑆂 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆩𑆳𑆬𑆴𑆩𑇀𑆥𑆼𑆠𑇀, 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆮𑆳𑇁𑆱𑇀𑆪𑆳 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆩𑆤𑆶𑆱𑆼𑆖𑆪𑆼𑆠𑇀, 𑆑𑆶𑆰𑇀𑆜𑆬𑆳𑆕𑇀𑆓𑆬𑆵𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆩𑆢𑇀𑆪𑆩𑆷𑆠𑇀𑆫𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆯𑆳𑆬𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆁 𑆮𑆳 𑆩𑆢𑇀𑆪𑆼𑆤, 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆑𑆶𑆰𑇀𑆜𑆬𑆳𑆕𑇀𑆓𑆬𑆵𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆩𑆴𑆯𑇀𑆫𑆼𑆟 𑆱𑆶𑆫𑆳𑆩𑆟𑇀𑆝𑆼𑆤 𑆮𑆳𑇁𑇁𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀, 𑆍𑆠𑆽𑆫𑆼𑆮 𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆠𑆽𑆬𑆼𑆤𑆾𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼𑆤 𑆮𑆳 𑆑𑆸𑆠𑇀𑆠𑆤𑆒𑆼𑆤 𑆲𑆱𑇀𑆠𑆼𑆤𑆳𑆥𑆲𑆫𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆪𑆳𑆯𑇀𑆖 𑆤𑆳𑆫𑇀𑆪𑆳 𑆫𑆷𑆑𑇀𑆰𑆯𑆫𑆵𑆫𑆳𑆪𑆳𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑆮𑆴𑆯𑆾𑆣𑆴𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆮𑆳𑆪𑆶𑆤𑆳 𑆠𑆢𑇀𑆢𑆼𑆯𑆓𑆠𑆼𑆤𑆳𑆠𑆴𑆱𑆁𑆫𑆶𑆢𑇀𑆣𑆁 𑆤𑆳𑆨𑆼𑆫𑆣𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆫𑇀𑆧𑆱𑇀𑆠𑆿 𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆱𑆴 𑆮𑆳 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆁 𑆑𑆫𑆾𑆠𑆴; 𑆠𑆠𑆯𑇀𑆖 𑆤𑆳𑆨𑆴𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆯𑆷𑆬𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆱𑆷𑆖𑆵𑆨𑆴𑆫𑆴𑆮 𑆤𑆴𑆱𑇀𑆠𑆶𑆢𑇀𑆪𑆠𑆼 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑆢𑆵𑆫𑇀𑆪𑆠 𑆅𑆮 𑆖 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆂, 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑆳𑆣𑇀𑆩𑆳𑆤𑆩𑆶𑆢𑆫𑆼 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆯𑇀𑆖 𑆨𑆮𑆠𑆵𑆠𑆴 𑆩𑆑𑇀𑆑𑆬𑇀𑆬𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆮𑆵𑆫𑆠𑆫𑇀𑆮𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆁 𑆘𑆬𑆩𑆶𑆰𑆑𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆱𑆶𑆒𑆾𑆢𑆑𑆼𑆤 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆮𑆳, 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆱𑆶𑆫𑆳𑆩𑆟𑇀𑆝𑆼𑆤, 𑆮𑆫𑆶𑆟𑆳𑆢𑆴𑆑𑇀𑆮𑆳𑆡𑆁 𑆮𑆳 𑆥𑆚𑇀𑆖𑆑𑆾𑆬𑆽𑆬𑆳𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁, 𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆢𑆴𑆑𑇀𑆮𑆳𑆡𑆁 𑆮𑆳 𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆩𑆫𑆴𑆖𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁, 𑆥𑆶𑆫𑆳𑆟𑆓𑆶𑆝𑆁 𑆮𑆳 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆖𑆠𑆶𑆫𑇀𑆘𑆳𑆠𑆑𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆩𑆴𑆯𑇀𑆫𑆁 𑆒𑆳𑆢𑆼𑆠𑇀, 𑆃𑆖𑇀𑆗𑆁 𑆮𑆳 𑆥𑆴𑆧𑆼𑆢𑆫𑆴𑆰𑇀𑆛𑆩𑆴𑆠𑆴 𑇆𑇒𑇒𑇆
𑆃𑆡 𑆧𑆳𑆬𑆁 𑆑𑇀𑆰𑆿𑆩𑆥𑆫𑆴𑆮𑆸𑆠𑆁 𑆑𑇀𑆰𑆿𑆩𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆱𑇀𑆠𑆸𑆠𑆳𑆪𑆳𑆁 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆯𑆳𑆪𑆪𑆼𑆠𑇀, 𑆥𑆵𑆬𑆶𑆧𑆢𑆫𑆵𑆤𑆴𑆩𑇀𑆧𑆥𑆫𑆷𑆰𑆑𑆯𑆳𑆒𑆳𑆨𑆴𑆯𑇀𑆖𑆽𑆤𑆁 𑆥𑆫𑆴𑆮𑆵𑆘𑆪𑆼𑆠𑇀, 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆖𑆳𑆱𑇀𑆪𑆳𑆲𑆫𑆲𑆱𑇀𑆠𑆽𑆬𑆥𑆴𑆖𑆶𑆩𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀, 𑆣𑆷𑆥𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆁 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆽𑆫𑇀𑆣𑆷𑆥𑆽𑆂, 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆮𑆮𑆱𑆸𑆘𑆼𑆠𑇀, 𑆠𑆴𑆬𑆳𑆠𑆱𑆵𑆱𑆫𑇀𑆰𑆥𑆑𑆟𑆳𑆁𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆴𑆫𑆼𑆠𑇀, 𑆃𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼 𑆖𑆳𑆓𑇀𑆤𑆴𑆁 𑆥𑇀𑆫𑆘𑇀𑆮𑆳𑆬𑆪𑆼𑆠𑇀, 𑆮𑇀𑆫𑆟𑆴𑆠𑆾𑆥𑆳𑆱𑆤𑆵𑆪𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑆼𑆠 𑇆𑇒𑇓𑇆
𑆠𑆠𑆾 𑆢𑆯𑆩𑆼𑇁𑆲𑆤𑆴 𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑆫𑆿 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆑𑆿𑆠𑆶𑆑𑆿 𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤𑆳𑆩 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑆳𑆁 𑆪𑆢𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑆁 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆤𑆳𑆩 𑆮𑆳 𑇆𑇒𑇔𑇆
𑆠𑆠𑆾 𑆪𑆡𑆳𑆮𑆫𑇀𑆟𑆁 𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆶𑆥𑆼𑆪𑆳𑆤𑇀𑆩𑆣𑇀𑆪𑆩𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆁 𑆩𑆣𑇀𑆪𑆩𑆮𑆪𑆱𑇀𑆑𑆳(𑆱𑆳)𑆩𑆫𑆾𑆓𑆳𑆁 𑆯𑆵𑆬𑆮𑆠𑆵𑆩𑆖𑆥𑆬𑆳𑆩𑆬𑆾𑆬𑆶𑆥𑆳𑆩𑆑𑆸𑆯𑆳𑆩𑆱𑇀𑆡𑆷𑆬𑆳𑆁 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆑𑇀𑆰𑆵𑆫𑆳𑆩𑆬𑆩𑇀𑆧𑆿𑆰𑇀𑆜𑆵𑆩𑆬𑆩𑇀𑆧𑆾𑆫𑇀𑆣𑇀𑆮𑆱𑇀𑆠𑆤𑆵𑆩𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆩𑆮𑇀𑆪𑆱𑆤𑆴𑆤𑆵𑆁 𑆘𑆵𑆮𑆢𑇀𑆮𑆠𑇀𑆱𑆳𑆁 𑆢𑆾𑆓𑇀𑆣𑇀𑆫𑆵𑆁 𑆮𑆠𑇀𑆱𑆬𑆳𑆩𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆫𑇀𑆩𑆴𑆟𑆵𑆁 𑆑𑆶𑆬𑆼 𑆘𑆳𑆠𑆳𑆩𑆠𑆾 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆽𑆯𑇀𑆖 𑆓𑆶𑆟𑆽𑆫𑆤𑇀𑆮𑆴𑆠𑆳𑆁 𑆯𑇀𑆩𑆳𑆩𑆳𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆪𑆼 𑆧𑆳𑆬𑆱𑇀𑆪 𑇅 𑆠𑆠𑇀𑆫𑆾𑆫𑇀𑆣𑇀𑆮𑆱𑇀𑆠𑆤𑆵 𑆑𑆫𑆳𑆬𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆬𑆩𑇀𑆧𑆱𑇀𑆠𑆤𑆵 𑆤𑆳𑆱𑆴𑆑𑆳𑆩𑆶𑆒𑆁 𑆗𑆳𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆩𑆫𑆟𑆩𑆳𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆪𑆳𑆁 𑆠𑆴𑆡𑆿 𑆯𑆴𑆫𑆂𑆱𑇀𑆤𑆳𑆠𑆩𑆲𑆠𑆮𑆳𑆱𑆱𑆩𑆶𑆢𑆕𑇀𑆩𑆶𑆒𑆁 𑆯𑆴𑆯𑆶𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 𑆣𑆳𑆠𑇀𑆫𑆵𑆁 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆶𑆒𑆵𑆁 𑆖𑆾𑆥𑆮𑆼𑆯𑇀𑆪 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆱𑇀𑆠𑆤𑆁 𑆣𑆿𑆠𑆩𑆵𑆰𑆠𑇀𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆩𑆨𑆴𑆩𑆤𑇀𑆠𑇀𑆫𑇀𑆪 𑆩𑆤𑇀𑆠𑇀𑆫𑆼𑆟𑆳𑆤𑆼𑆤 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇆𑇒𑇕𑇆
‘𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆱𑆳𑆓𑆫𑆳𑆱𑇀𑆠𑆶𑆨𑇀𑆪𑆁 𑆱𑇀𑆠𑆤𑆪𑆾𑆂 𑆑𑇀𑆰𑆵𑆫𑆮𑆳𑆲𑆴𑆤𑆂 𑇅 𑆨𑆮𑆤𑇀𑆠𑆶 𑆱𑆶𑆨𑆓𑆼 𑆤𑆴𑆠𑇀𑆪𑆁 𑆧𑆳𑆬𑆱𑇀𑆪 𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆪𑆼 𑇆𑇒𑇖𑇆
𑆥𑆪𑆾𑇁𑆩𑆸𑆠𑆫𑆱𑆁 𑆥𑆵𑆠𑇀𑆮𑆳 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆠𑆼 𑆯𑆶𑆨𑆳𑆤𑆤𑆼 𑇅 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆶 𑆢𑆼𑆮𑆳𑆂 𑆥𑇀𑆫𑆳𑆯𑇀𑆪𑆳𑆩𑆸𑆠𑆁 𑆪𑆡𑆳 𑇆𑇒𑇗𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆤𑆳𑆤𑆳𑆱𑇀𑆠𑆤𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆱𑇀𑆪𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆘𑆤𑇀𑆩 𑆨𑆮𑆠𑆴 𑇆𑇒𑇘𑇆
𑆃𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆼𑇁𑆥𑇀𑆪𑆠𑆴𑆱𑇀𑆠𑆧𑇀𑆣𑆱𑇀𑆠𑆤𑇀𑆪𑆥𑆷𑆫𑇀𑆟𑆱𑇀𑆠𑆤𑆥𑆳𑆤𑆳𑆢𑆶𑆠𑇀𑆱𑆶𑆲𑆴𑆠𑆱𑇀𑆫𑆾𑆠𑆱𑆂 𑆯𑆴𑆯𑆾𑆂 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆮𑆩𑆵𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆤 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇆𑇒𑇙𑇆
𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆳𑆮𑆳𑆠𑇀𑆱𑆬𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂𑆱𑇀𑆠𑆤𑇀𑆪𑆤𑆳𑆯𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆃𑆡𑆳𑆱𑇀𑆪𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆘𑆤𑆤𑆳𑆫𑇀𑆡𑆁 𑆱𑆿𑆩𑆤𑆱𑇀𑆪𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑇀𑆪𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆳𑆁𑆱𑆫𑆱𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆬𑆯𑆶𑆤𑆩𑆠𑇀𑆱𑇀𑆪𑆑𑆯𑆼𑆫𑆶𑆑𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑- 𑆧𑆴𑆱𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆤𑇀𑆢𑆩𑆣𑆶𑆑𑆯𑆠𑆳𑆮𑆫𑆵𑆤𑆳𑆬𑆴𑆑𑆳𑆬𑆳𑆧𑆷𑆑𑆳𑆬𑆯𑆳𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇓𑇐𑇆
𑆃𑆡𑆳𑆱𑇀𑆪𑆳𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆩𑆥𑇀𑆱𑆶 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆠𑆖𑇀𑆖𑆼𑆖𑇀𑆗𑆵𑆠𑆬𑆩𑆩𑆬𑆁 𑆠𑆤𑆶 𑆯𑆕𑇀𑆒𑆳𑆮𑆨𑆳𑆱𑆩𑆥𑇀𑆱𑆶 𑆤𑇀𑆪𑆱𑇀𑆠𑆩𑆼𑆑𑆵𑆨𑆳𑆮𑆁 𑆓𑆖𑇀𑆗𑆠𑇀𑆪𑆦𑆼𑆤𑆴𑆬𑆩𑆠𑆤𑇀𑆠𑆶𑆩𑆤𑇀𑆤𑆾𑆠𑇀𑆥𑇀𑆬𑆮𑆠𑆼𑇁𑆮𑆱𑆵𑆢𑆠𑆴 𑆮𑆳 𑆠𑆖𑇀𑆗𑆶𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆠𑆼𑆤 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆾 𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇅 𑆤 𑆖 𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆯𑆾𑆑𑆳𑆫𑇀𑆠𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆣𑆳𑆠𑆶𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆘𑇀𑆮𑆫𑆴𑆠𑆳𑆠𑆴𑆑𑇀𑆰𑆵𑆟𑆳𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆮𑆴𑆢𑆓𑇀𑆣𑆨𑆑𑇀𑆠𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆲𑆳𑆫𑆠𑆫𑇀𑆥𑆴𑆠𑆳𑆪𑆳𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆁 𑆖 𑆧𑆳𑆬𑆁, 𑆢𑆾𑆰𑆿𑆰𑆣𑆩𑆬𑆳𑆤𑆳𑆁 𑆠𑆵𑆮𑇀𑆫𑆮𑆼𑆓𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆨𑆪𑆳𑆠𑇀 𑇆𑇓𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆓𑆶𑆫𑆶𑆨𑆴𑆫𑇀𑆨𑆾𑆘𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆰𑆩𑆽𑆫𑇀𑆢𑆾𑆰𑆬𑆽𑆱𑇀𑆠𑆡𑆳 𑇅 𑆢𑆾𑆰𑆳 𑆢𑆼𑆲𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴 𑆠𑆠𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆪𑆠𑆴 𑇆𑇓𑇒𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆴𑆟𑇀𑆪𑆳 𑆢𑆶𑆰𑇀𑆛𑆳 𑆮𑆳𑆠𑆳𑆢𑆪𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆂 𑇅 𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑆴 𑆥𑆪𑆱𑇀𑆠𑆼𑆤 𑆯𑆳𑆫𑆵𑆫𑆳 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆯𑆴𑆯𑆾𑆂 𑇅 𑆨𑆮𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆨𑆴𑆰𑆑𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇓𑇓𑇆
𑆃𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆢𑆼𑆯𑆼 𑆠𑆶 𑆫𑆶𑆘𑆳 𑆪𑆠𑇀𑆫𑆳𑆱𑇀𑆪 𑆘𑆳𑆪𑆠𑆼 𑇅 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆱𑇀𑆥𑆸𑆯𑆠𑆴 𑆠𑆁 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆼 𑆖 𑆫𑆾𑆢𑆴𑆠𑆴 𑇆𑇓𑇔𑇆
𑆤𑆴𑆩𑆵𑆬𑆴𑆠𑆳𑆑𑇀𑆰𑆾 𑆩𑆷𑆫𑇀𑆣𑆱𑇀𑆡𑆼 𑆯𑆴𑆫𑆾 𑆫𑆾𑆓𑆼 𑆤 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆡𑆼 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆫𑇀𑆠𑆾 𑆫𑆶𑆘𑆳 𑆠𑆸𑆰𑇀𑆪𑆠𑆴 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆠𑆴 𑇆𑇓𑇕𑇆
𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆳𑆣𑇀𑆩𑆳𑆤𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆽𑆂 𑇅 𑆑𑆾𑆰𑇀𑆜𑆼 𑆢𑆾𑆰𑆳𑆤𑇀 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆱𑇀𑆡𑆳𑆁𑆯𑇀𑆖 𑆫𑆾𑆢𑆤𑆽𑆂 𑇆𑇓𑇖𑇆
𑆠𑆼𑆰𑆶 𑆪𑆡𑆳𑆨𑆴𑆲𑆴𑆠𑆁 𑆩𑆸𑆢𑇀𑆮𑆖𑇀𑆗𑆼𑆢𑆤𑆵𑆪𑆩𑆿𑆰𑆣𑆁 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆑𑇀𑆰𑆵𑆫𑆥𑆱𑇀𑆪 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆑𑆼𑆮𑆬𑆁, 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆳𑆢𑆱𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆴 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀, 𑆃𑆤𑇀𑆤𑆳𑆢𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆳𑆢𑆵𑆤𑆳𑆠𑇀𑆩𑆤𑇀𑆪𑆼𑆮 𑆤 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆂 𑇆𑇓𑇗𑇆
𑆠𑆠𑇀𑆫 𑆩𑆳𑆱𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆪𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑇀𑆮𑆢𑇀𑆮𑆪𑆓𑇀𑆫𑆲𑆟𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆩𑆿𑆰𑆣𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆑𑆾𑆬𑆳𑆱𑇀𑆡𑆴𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆁 𑆑𑆬𑇀𑆑𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆳𑆢𑆳𑆪, 𑆑𑆾𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆩𑆤𑇀𑆤𑆳𑆢𑆳𑆪𑆼𑆠𑆴 𑇆𑇓𑇘𑇆
𑆪𑆼𑆰𑆳𑆁 𑆓𑆢𑆳𑆤𑆳𑆁 𑆪𑆼 𑆪𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆓𑆢𑆕𑇀𑆑𑆫𑆳𑆂 𑇅 𑆠𑆼𑆰𑆶 𑆠𑆠𑇀𑆑𑆬𑇀𑆑𑆱𑆁𑆬𑆴𑆥𑇀𑆠𑆿 𑆥𑆳𑆪𑆪𑆼𑆠 𑆯𑆴𑆯𑆶𑆁 𑆱𑇀𑆠𑆤𑆿 𑇆𑇓𑇙𑇆
𑆍𑆑𑆁 𑆢𑇀𑆮𑆼 𑆠𑇀𑆫𑆵𑆟𑆴 𑆖𑆳𑆲𑆳𑆤𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆘𑇀𑆮𑆫𑆼 𑇅 𑆱𑇀𑆠𑆤𑇀𑆪𑆥𑆳𑆪𑆳𑆲𑆴𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆴𑆠𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆪𑆡𑆳𑆫𑇀𑆡𑆠𑆂 𑇆𑇔𑇐𑇆
𑆤 𑆖 𑆠𑆸𑆰𑇀𑆟𑆳𑆨𑆪𑆳𑆢𑆠𑇀𑆫 𑆥𑆳𑆪𑆪𑆼𑆠 𑆯𑆴𑆯𑆶𑆁 𑆱𑇀𑆠𑆤𑆿 𑇅 𑆮𑆴𑆫𑆼𑆑𑆧𑆱𑇀𑆠𑆴𑆮𑆩𑆤𑆳𑆤𑇀𑆪𑆸𑆠𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖 𑆤𑆳𑆠𑇀𑆪𑆪𑆳𑆠𑇀 𑇆𑇔𑇑𑇆
𑆩𑆱𑇀𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆪𑆱𑇀𑆪 𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆳𑆬𑇀𑆮𑆱𑇀𑆡𑆴 𑆤𑆳𑆩𑆪𑆼𑆠𑇀 𑇅 𑆠𑆱𑇀𑆪 𑆠𑆸𑆝𑇀𑆢𑆽𑆤𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆫𑆑𑆽𑆂 𑆯𑆸𑆠𑆩𑇀 𑇆𑇔𑇒𑇆
𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆪𑆾𑆫𑇀𑆪𑆾𑆘𑇀𑆪𑆁 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆷𑆢𑇀𑆮𑆼𑆘𑆤𑆁 𑆠𑆡𑆳 𑇅𑇔𑇓𑇅 𑆮𑆳𑆠𑆼𑆤𑆳𑆣𑇀𑆩𑆳𑆥𑆴𑆠𑆳𑆁 𑆤𑆳𑆨𑆴𑆁 𑆱𑆫𑆶𑆘𑆳𑆁 𑆠𑆶𑆟𑇀𑆝𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑆩𑇀 𑇆𑇔𑇓𑇆
𑆩𑆳𑆫𑆶𑆠𑆔𑇀𑆤𑆽𑆂 𑆥𑇀𑆫𑆯𑆩𑆪𑆼𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆤𑆳𑆲𑆤𑆽𑆂 𑇅 𑆓𑆶𑆢𑆥𑆳𑆑𑆼 𑆠𑆶 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆵𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇅 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑆳𑆤𑆳𑆬𑆼𑆥𑆤𑆪𑆾𑆫𑇀𑆲𑆴𑆠𑆩𑇀 𑇆𑇔𑇔𑇆
𑆑𑇀𑆰𑆵𑆫𑆳𑆲𑆳𑆫𑆳𑆪 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆮𑆖𑆳𑆩𑆳𑆁𑆱𑆵𑆥𑆪𑆱𑇀𑆪𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆯𑆠𑆳𑆮𑆫𑆵𑆱𑆳𑆫𑆴𑆮𑆳𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆴𑆢𑇀𑆣𑆁, 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆳𑆢𑆳𑆪 𑆩𑆣𑆶𑆑𑆮𑆖𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆱𑆴𑆢𑇀𑆣𑆩𑇀, 𑆃𑆤𑇀𑆤𑆳𑆢𑆳𑆪 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆠𑆓𑆫𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆩𑆫𑆴𑆖𑆩𑆣𑆶𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆫𑇀𑆣𑆴𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆱𑆴𑆢𑇀𑆣𑆁 ; 𑆠𑆼𑆤𑆳𑆫𑆾𑆓𑇀𑆪𑆧𑆬𑆩𑆼𑆣𑆳𑆪𑆷𑆁𑆰𑆴 𑆯𑆴𑆯𑆾𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇔𑇕𑇆
𑆧𑆳𑆬𑆁 𑆥𑆶𑆤𑆫𑇀𑆓𑆳𑆠𑇀𑆫𑆱𑆶𑆒𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀, 𑆤 𑆖𑆽𑆤𑆁 𑆠𑆫𑇀𑆘𑆪𑆼𑆠𑇀, 𑆱𑆲𑆱𑆳 𑆤 𑆥𑇀𑆫𑆠𑆴𑆧𑆾𑆣𑆪𑆼𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆨𑆪𑆳𑆠𑇀, 𑆱𑆲𑆱𑆳 𑆤𑆳𑆥𑆲𑆫𑆼𑆢𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑆼𑆢𑇀𑆮𑆳 𑆮𑆳𑆠𑆳𑆢𑆴𑆮𑆴𑆔𑆳𑆠𑆨𑆪𑆳𑆠𑇀, 𑆤𑆾𑆥𑆮𑆼𑆯𑆪𑆼𑆠𑇀 𑆑𑆿𑆧𑇀𑆘𑇀𑆪𑆨𑆪𑆳𑆠𑇀, 𑆤𑆴𑆠𑇀𑆪𑆁 𑆖𑆽𑆤𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆼𑆠 𑆥𑇀𑆫𑆴𑆪𑆯𑆠𑆽𑆫𑆘𑆴𑆔𑆳𑆁𑆱𑆶𑆂; 𑆍𑆮𑆩𑆮𑆴𑆲𑆠𑆩𑆤𑆳 𑆲𑇀𑆪𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑆤𑆴𑆠𑇀𑆪𑆩𑆶𑆢𑆓𑇀𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆾 𑆤𑆵𑆫𑆾𑆓𑆂 𑆱𑆶𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆩𑆤𑆳𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇅 𑆮𑆳𑆠𑆳𑆠𑆥𑆮𑆴𑆢𑇀𑆪𑆶𑆠𑇀𑆥𑇀𑆫𑆨𑆳𑆥𑆳𑆢𑆥𑆬𑆠𑆳𑆯𑆷𑆤𑇀𑆪𑆳𑆓𑆳𑆫𑆤𑆴𑆩𑇀𑆤𑆱𑇀𑆡𑆳𑆤𑆓𑇀𑆫𑆲𑆖𑇀𑆗𑆳𑆪𑆳𑆢𑆴𑆨𑇀𑆪𑆾 𑆢𑆶𑆫𑇀𑆓𑇀𑆫𑆲𑆾𑆥𑆱𑆫𑇀𑆓𑆠𑆯𑇀𑆖 𑆧𑆳𑆬𑆁 𑆫𑆑𑇀𑆰𑆼𑆠𑇀 𑇆𑇔𑇖𑇆
𑆤𑆳𑆯𑆶𑆖𑆿 𑆮𑆴𑆱𑆸𑆘𑆼𑆢𑇀𑆧𑆳𑆬𑆁 𑆤𑆳𑆑𑆳𑆯𑆼 𑆮𑆴𑆰𑆩𑆼 𑆤 𑆖 𑇅 𑆤𑆾𑆰𑇀𑆩𑆩𑆳𑆫𑆶𑆠𑆮𑆫𑇀𑆰𑆼𑆰𑆶 𑆫𑆘𑆾𑆣𑆷𑆩𑆾𑆢𑆑𑆼𑆰𑆶 𑆖 𑇆𑇔𑇗𑇆
𑆑𑇀𑆰𑆵𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆪𑆳 𑆑𑇀𑆰𑆵𑆫𑆩𑆳𑆘𑆁 𑆓𑆮𑇀𑆪𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇅 𑆢𑆢𑇀𑆪𑆳𑆢𑆳𑆱𑇀𑆠𑆤𑇀𑆪𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆼𑆫𑇀𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑇆𑇔𑇘𑇆
𑆰𑆟𑇀𑆩𑆳𑆱𑆁 𑆖𑆽𑆤𑆩𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆳𑆯𑆪𑆼𑆬𑇀𑆬𑆔𑆶 𑆲𑆴𑆠𑆁 𑆖 𑇆𑇔𑇙𑇆
𑆤𑆴𑆠𑇀𑆪𑆩𑆮𑆫𑆾𑆣𑆫𑆠𑆯𑇀𑆖 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆸𑆠𑆫𑆑𑇀𑆰 𑆇𑆥𑆱𑆫𑇀𑆓𑆨𑆪𑆳𑆠𑇀; 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆠𑆯𑇀𑆖 𑆓𑇀𑆫𑆲𑆾𑆥𑆱𑆫𑇀𑆓𑆼𑆨𑇀𑆪𑆾 𑆫𑆑𑇀𑆰𑇀𑆪𑆳 𑆧𑆳𑆬𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇕𑇐𑇆
𑆃𑆡 𑆑𑆶𑆩𑆳𑆫 𑆇𑆢𑇀𑆮𑆴𑆘𑆠𑆼 𑆠𑇀𑆫𑆱𑇀𑆪𑆠𑆴 𑆫𑆾𑆢𑆴𑆠𑆴 𑆤𑆰𑇀𑆛𑆱𑆚𑇀𑆘𑇀𑆚𑆾 𑆨𑆮𑆠𑆴 𑆤𑆒𑆢𑆯𑆤𑆽𑆫𑇀𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆖 𑆥𑆫𑆴𑆟𑆶𑆢𑆠𑆴 𑆢𑆤𑇀𑆠𑆳𑆤𑇀 𑆒𑆳𑆢𑆠𑆴 𑆑𑆷𑆘𑆠𑆴 𑆘𑆸𑆩𑇀𑆨𑆠𑆼 𑆨𑇀𑆫𑆶𑆮𑆿 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆤𑆴𑆫𑆵𑆑𑇀𑆰𑆠𑆼 𑆦𑆼𑆤𑆩𑆶𑆢𑇀𑆮𑆩𑆠𑆴 𑆱𑆤𑇀𑆢𑆰𑇀𑆛𑆿𑆰𑇀𑆜𑆂𑆑𑇀𑆫𑆷𑆫𑆾 𑆨𑆴𑆤𑇀𑆤𑆳𑆩𑆮𑆫𑇀𑆖𑆳 𑆢𑆵𑆤𑆳𑆫𑇀𑆠𑆱𑇀𑆮𑆫𑆾 𑆤𑆴𑆯𑆴 𑆘𑆳𑆓𑆫𑇀𑆠𑆴 𑆢𑆶𑆫𑇀𑆧𑆬𑆾 𑆩𑇀𑆬𑆳𑆤𑆳𑆕𑇀𑆓𑆾 𑆩𑆠𑇀𑆱𑇀𑆪𑆖𑇀𑆗𑆶𑆖𑇀𑆗𑇀𑆫𑆶𑆤𑇀𑆢𑆫𑆴𑆩𑆠𑇀𑆑𑆶𑆟𑆓𑆤𑇀𑆣𑆾 𑆪𑆡𑆳 𑆥𑆶𑆫𑆳 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆩𑆨𑆴𑆬𑆰𑆠𑆴 𑆠𑆡𑆳 𑆤𑆳𑆨𑆴𑆬𑆰𑆠𑆵𑆠𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆼𑆤 𑆓𑇀𑆫𑆲𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆁, 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆾𑆠𑇀𑆠𑆫𑆼 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇕𑇑𑇆
𑆯𑆑𑇀𑆠𑆴𑆩𑆤𑇀𑆠𑆁 𑆖𑆽𑆤𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆮𑆫𑇀𑆟𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀 𑇆𑇕𑇒𑇆
𑆃𑆡𑆳𑆱𑇀𑆩𑆽 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆮𑆫𑇀𑆰𑆳𑆪 𑆰𑆾𑆝𑆯𑆢𑆯𑆮𑆫𑇀𑆰𑆳𑆁 𑆥𑆠𑇀𑆤𑆵𑆩𑆳𑆮𑆲𑆼𑆠𑇀 𑆥𑆴𑆠𑇀𑆫𑇀𑆪𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆥𑇀𑆫𑆘𑆳𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆱𑇀𑆪𑆠𑆵𑆠𑆴 𑇆𑇕𑇓𑇆
𑆈𑆤𑆰𑆾𑆝𑆯𑆮𑆫𑇀𑆰𑆳𑆪𑆳𑆩𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆩𑇀 𑇅 𑆪𑆢𑇀𑆪𑆳𑆣𑆠𑇀𑆠𑆼 𑆥𑆶𑆩𑆳𑆤𑇀 𑆓𑆫𑇀𑆨𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆱𑇀𑆡𑆂 𑆱 𑆮𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇆𑇕𑇔𑇆
𑆘𑆳𑆠𑆾 𑆮𑆳 𑆤 𑆖𑆴𑆫𑆁 𑆘𑆵𑆮𑆼𑆘𑇀𑆘𑆵𑆮𑆼𑆢𑇀𑆮𑆳 𑆢𑆶𑆫𑇀𑆧𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆠𑇀𑆪𑆤𑇀𑆠𑆧𑆳𑆬𑆳𑆪𑆳𑆁 𑆓𑆫𑇀𑆨𑆳𑆣𑆳𑆤𑆁 𑆤 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇕𑇕𑇆
𑆃𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆪𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆫𑆾𑆓𑆴𑆟𑇀𑆪𑆳𑆩𑆤𑇀𑆪𑆼𑆤 𑆮𑆳 𑆮𑆴𑆑𑆳𑆫𑆼𑆟𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆪𑆳𑆁 𑆓𑆫𑇀𑆨𑆳𑆣𑆳𑆤𑆁 𑆤𑆽𑆮 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇅 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆼𑆮𑆁𑆮𑆴𑆣𑆱𑇀𑆪 𑆠 𑆍𑆮 𑆢𑆾𑆰𑆳𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇕𑇖𑇆
𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆽𑆂 𑆑𑆳𑆫𑆟𑆽𑆂 𑆥𑆠𑆴𑆰𑇀𑆪𑆠𑆴 𑆓𑆫𑇀𑆨𑆼 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆑𑆛𑆵𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆳𑆤𑆴 𑆫𑆑𑇀𑆠𑆢𑆫𑇀𑆯𑆤𑆁 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆯𑆵𑆠𑆽𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆢𑆴𑆨𑆴𑆫𑆶𑆥𑆖𑆫𑆼𑆘𑇀𑆘𑆵𑆮𑆤𑆵𑆪𑆯𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆤𑆽𑆯𑇀𑆖 𑇅 𑆓𑆫𑇀𑆨𑆱𑇀𑆦𑆶𑆫𑆟𑆼 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆱𑇀𑆠𑆠𑇀𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇅 𑆥𑇀𑆫𑆱𑇀𑆫𑆁𑆱𑆩𑆳𑆤𑆼 𑆱𑆢𑆳𑆲𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆯𑆷𑆬𑆳𑆱𑆸𑆓𑇀𑆢𑆫𑆳𑆤𑆳𑆲𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆂, 𑆱𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆱𑇀𑆡𑆳𑆤𑆁 𑆖 𑆥𑇀𑆫𑆑𑇀𑆫𑆳𑆩𑆠𑆴 𑆓𑆫𑇀𑆨𑆼 𑆑𑆾𑆰𑇀𑆜𑆼 𑆱𑆁𑆫𑆩𑇀𑆨𑆂, 𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑇅 𑆮𑆼𑆢𑆤𑆳𑆪𑆳𑆁 𑆩𑆲𑆳𑆱𑆲𑆳𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆱𑆲𑆳𑆩𑆣𑆶𑆑𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆪𑆂 𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆴𑆯𑇀𑆫𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆼 𑆢𑆫𑇀𑆨𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆩𑇀; 𑆄𑆤𑆳𑆲𑆼 𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆬𑆯𑆶𑆤𑆮𑆖𑆳𑆱𑆴𑆢𑇀𑆣𑆩𑇀 𑇅 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑇀𑆫𑆮𑆠𑆴 𑆫𑆑𑇀𑆠𑆼 𑆑𑆾𑆰𑇀𑆜𑆳𑆓𑆳𑆫𑆴𑆑𑆳𑆓𑆳𑆫𑆩𑆸𑆠𑇀𑆥𑆴𑆟𑇀𑆝𑆱𑆩𑆕𑇀𑆓𑆳𑆣𑆳𑆠𑆑𑆵𑆑𑆶𑆱𑆶𑆩𑆤𑆮𑆩𑆳𑆬𑆴𑆑𑆳𑆓𑆽𑆫𑆴𑆑𑆱𑆫𑇀𑆘𑆫𑆱𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆖𑆷𑆫𑇀𑆟𑆁 𑆩𑆣𑆶𑆤𑆳𑇁𑆮𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀, 𑆪𑆡𑆳𑆬𑆳𑆨𑆁 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆮𑆳𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆥𑆪𑆱𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆇𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆑𑆯𑆼𑆫𑆶𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆯𑆳𑆬𑆷𑆑𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆯𑆸𑆠𑆼𑆤 𑆥𑆪𑆱𑆳, 𑆇𑆢𑆶𑆩𑇀𑆧𑆫𑆦𑆬𑆿𑆢𑆑𑆑𑆤𑇀𑆢𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆮𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆼𑆟 𑆯𑆳𑆬𑆴𑆥𑆴𑆰𑇀𑆛𑆁; 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆁 𑆮𑆳 𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆮𑆪𑆮𑆁 𑆪𑆾𑆤𑇀𑆪𑆳𑆁 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆃𑆡𑆳𑆢𑆸𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆮𑆼𑆢𑆤𑆳𑆪𑆳𑆁 𑆩𑆣𑆶𑆑𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆪𑆂 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑆢𑆼𑆮𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆯𑆠𑆳𑆮𑆫𑆵𑆥𑆪𑆱𑇀𑆪𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆾𑆠𑇀𑆥𑆬𑆯𑆠𑆳𑆮𑆫𑆵𑆱𑆳𑆫𑆴𑆮𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆩𑆣𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳; 𑆍𑆮𑆩𑆶𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆪𑆳 𑆇𑆥𑆳𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆫𑆶𑆘𑆾 𑆓𑆫𑇀𑆨𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆳𑆪𑆠𑆼 𑇅 𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆼 𑆖 𑆓𑆫𑇀𑆨𑆼 𑆓𑆮𑇀𑆪𑆼𑆤𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆯𑆬𑆳𑆛𑆶𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆥𑆪𑆱𑆳 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆃𑆠𑆵𑆠𑆼 𑆬𑆮𑆟𑆱𑇀𑆤𑆼𑆲𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆨𑆴𑆫𑇀𑆪𑆮𑆳𑆓𑆷𑆨𑆴𑆫𑆶𑆢𑇀𑆢𑆳𑆬𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆳𑆖𑆤𑆵𑆪𑆾𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆨𑆴𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑆪𑆳𑆮𑆤𑇀𑆠𑆾 𑆩𑆳𑆱𑆳 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆠𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆲𑆳𑆤𑆴 𑇅 𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆢𑆫𑆯𑆷𑆬𑆼𑆰𑆶 𑆥𑆶𑆫𑆳𑆟𑆓𑆶𑆝𑆁 𑆢𑆵𑆥𑆤𑆵𑆪𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆳𑆪𑆪𑆼𑆢𑆫𑆴𑆰𑇀𑆛𑆁 𑆮𑆳 𑇅 𑆮𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆓𑆸𑆲𑆵𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆬𑆵𑆪𑆠𑆼 𑆓𑆫𑇀𑆨𑆂, 𑆱𑆾𑇁𑆠𑆴𑆑𑆳𑆬𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆾 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆳𑆁 𑆩𑆸𑆢𑆶𑆤𑆳 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆑𑇀𑆫𑆩𑆼𑆟𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆇𑆠𑇀𑆑𑇀𑆫𑆾𑆯𑆫𑆱𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆳𑆩𑆤𑆬𑇀𑆥𑆱𑇀𑆤𑆼𑆲𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆩𑆳𑆰𑆠𑆴𑆬𑆧𑆴𑆬𑇀𑆮𑆯𑆬𑆳𑆛𑆶𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆮𑆳 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑆪𑆼𑆤𑇀𑆩𑆣𑆶𑆩𑆳𑆣𑇀𑆮𑆵𑆑𑆁 𑆖𑆳𑆤𑆶𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑇀 𑇅 𑆑𑆳𑆬𑆳𑆠𑆵𑆠𑆱𑇀𑆡𑆳𑆪𑆴𑆤𑆴 𑆓𑆫𑇀𑆨𑆼 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆱𑆣𑆳𑆤𑇀𑆪𑆩𑆶𑆢𑆷𑆒𑆬 𑆩𑆶𑆱𑆬𑆼𑆤𑆳𑆨𑆴𑆲𑆤𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆼 𑆮𑆳 𑆪𑆳𑆤𑆳𑆱𑆤𑆼 𑆱𑆼𑆮𑆼𑆠 𑇅 𑆮𑆳𑆠𑆳𑆨𑆴𑆥𑆤𑇀𑆤 𑆍𑆮 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆓𑆫𑇀𑆨𑆂, 𑆱 𑆩𑆳𑆠𑆶𑆂 𑆑𑆶𑆑𑇀𑆰𑆴𑆁 𑆤 𑆥𑆷𑆫𑆪𑆠𑆴 𑆩𑆤𑇀𑆢𑆁 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆖, 𑆠𑆁 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆽𑆂 𑆥𑆪𑆾𑆨𑆴𑆫𑇀𑆩𑆳𑆁𑆱𑆫𑆱𑆽𑆯𑇀𑆖𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇅 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆁 𑆮𑆳𑆪𑆶𑆤𑆳𑇁𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆩𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆘𑆵𑆮𑆩𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆠𑇀𑆪𑆶𑆢𑆫𑆁, 𑆠𑆁 𑆑𑆢𑆳𑆖𑆴𑆢𑇀𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆁 𑆤𑆽𑆓𑆩𑆼𑆰𑆳𑆥𑆲𑆸𑆠𑆩𑆴𑆠𑆴 𑆨𑆳𑆰𑆤𑇀𑆠𑆼, 𑆠𑆩𑆼𑆮 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆬𑆵𑆪𑆩𑆳𑆤𑆁 𑆤𑆳𑆓𑆾𑆢𑆫𑆩𑆴𑆠𑇀𑆪𑆳𑆲𑆶𑆂; 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆬𑆵𑆤𑆮𑆠𑇀 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 𑇆𑇕𑇗𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆩𑆳𑆱𑆳𑆤𑆶𑆩𑆳𑆱𑆴𑆑𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑇆𑇕𑇘𑇆
𑆩𑆣𑆶𑆑𑆁 𑆯𑆳𑆑𑆧𑆵𑆘𑆁 𑆖 𑆥𑆪𑆱𑇀𑆪𑆳 𑆱𑆶𑆫𑆢𑆳𑆫𑆶 𑆖 𑇅 𑆃𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆱𑇀𑆠𑆴𑆬𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆳𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆮𑆬𑇀𑆬𑆵 𑆯𑆠𑆳𑆮𑆫𑆵 𑇆𑇕𑇙𑇆
𑆮𑆸𑆑𑇀𑆰𑆳𑆢𑆤𑆵 𑆥𑆪𑆱𑇀𑆪𑆳 𑆖 𑆬𑆠𑆳 𑆱𑆾𑆠𑇀𑆥𑆬𑆱𑆳𑆫𑆴𑆮𑆳 𑇅 𑆃𑆤𑆤𑇀𑆠𑆳 𑆱𑆳𑆫𑆴𑆮𑆳 𑆫𑆳𑆱𑇀𑆤𑆳 𑆥𑆢𑇀𑆩𑆳 𑆩𑆣𑆶𑆑𑆩𑆼𑆮 𑆖 𑇆𑇖𑇐𑇆
𑆧𑆸𑆲𑆠𑇀𑆪𑆿 𑆑𑆳𑆯𑇀𑆩𑆫𑆵 𑆖𑆳𑆥𑆴 𑆑𑇀𑆰𑆵𑆫𑆴𑆯𑆶𑆕𑇀𑆓𑆳𑆱𑇀𑆠𑇀𑆮𑆖𑆾 𑆔𑆸𑆠𑆩𑇀 𑇅 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵 𑆧𑆬𑆳 𑆯𑆴𑆓𑇀𑆫𑆶𑆂 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆩𑆣𑆶𑆥𑆫𑇀𑆟𑆴𑆑𑆳 𑇆𑇖𑇑𑇆

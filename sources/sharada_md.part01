𑆨𑆵𑆰𑆪𑆼𑆠𑇀 𑆱𑆁𑆪𑆠𑆁 𑆥𑆳𑆯𑆽𑆂 𑆑𑆯𑆳𑆨𑆴𑆫𑇀𑆮𑆳𑇁𑆡 𑆠𑆳𑆝𑆪𑆼𑆠𑇀 𑇅 𑆪𑆤𑇀𑆠𑇀𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆮𑆳𑆁 𑆠𑇀𑆫𑆳𑆱𑆪𑆼𑆠𑇀𑆠𑆁 𑆠𑆸𑆟𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑇆𑇑𑇘𑇆
𑆘𑆬𑆼𑆤 𑆠𑆫𑇀𑆘𑆪𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆫𑆘𑇀𑆘𑆶𑆔𑆳𑆠𑆽𑆫𑇀𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇅 𑆧𑆬𑆮𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆱𑆁𑆫𑆑𑇀𑆰𑆼𑆠𑇀 𑆘𑆬𑆼𑇁𑆤𑇀𑆠𑆂 𑆥𑆫𑆴𑆮𑆳𑆱𑆪𑆼𑆠𑇀 𑇅 𑆥𑇀𑆫𑆠𑆶𑆢𑆼𑆢𑆳𑆫𑆪𑆳 𑆖𑆽𑆤𑆁 𑆩𑆫𑇀𑆩𑆳𑆔𑆳𑆠𑆁 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆮𑆼𑆯𑇀𑆩𑆤𑆾𑇁𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆽𑆤𑆁 𑆫𑆑𑇀𑆰𑆁𑆱𑇀𑆠𑆢𑇀𑆮𑆼𑆯𑇀𑆩 𑆢𑆵𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆱𑆳𑆥𑆴𑆣𑆳𑆤𑆼 𑆘𑆫𑆠𑇀𑆑𑆷𑆥𑆼 𑆱𑆠𑆠𑆁 𑆮𑆳 𑆤𑆴𑆮𑆳𑆱𑆪𑆼𑆠𑇀 𑇅𑇒𑇐𑇅 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆢𑇀𑆪𑆮𑆳𑆓𑆷𑆯𑇀𑆖 𑆠𑆫𑇀𑆥𑆟𑆳𑆤𑇀 𑆮𑆳 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆑𑆼𑆮𑆬𑆳𑆤𑆩𑇀𑆧𑆶𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀 𑆮𑆳 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆤𑇀 𑆮𑆳 𑆧𑆲𑆶𑆯𑇀𑆫𑆶𑆠𑆂 𑇅 𑆲𑆸𑆢𑇀𑆪𑆁 𑆪𑆢𑇀𑆢𑆵𑆥𑆤𑆵𑆪𑆁 𑆖 𑆠𑆠𑇀𑆥𑆡𑇀𑆪𑆁 𑆠𑆱𑇀𑆪 𑆨𑆾(𑆪𑆾)𑆘𑆪𑆼𑆠𑇀 𑇅 (𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆩𑆶𑆱𑇀𑆠𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆢𑆳𑆝𑆴𑆩𑆾𑆠𑇀𑆥𑆬𑆽𑆂 𑇅 𑆯𑇀𑆪𑆳𑆩𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆽𑆬𑆳𑆨𑆴𑆯𑇀𑆖𑆤𑇀𑆢𑆤𑆳𑆩𑆫𑆢𑆳𑆫𑆶𑆨𑆴𑆂 𑇆𑇒𑇒𑇆
𑆢𑇀𑆮𑆴𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆳𑆣𑆴𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆳𑆬𑆠𑆵𑆑𑆶𑆱𑆶𑆩𑆽𑆂 𑆱𑆲 𑇅 𑆓𑆶𑆬𑇀𑆩𑆑𑆳𑆱𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆑𑇀𑆰𑆪𑆾𑆤𑇀𑆩𑆳𑆢𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇆𑇒𑇔𑇆
𑆍𑆠𑆢𑆼𑆮 𑆲𑆴 𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆾𑆥𑆱𑆩𑇀𑆨𑆸𑆠𑆩𑇀 𑇅 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑆤 𑆢𑆶𑆓𑇀𑆣𑆼𑆤 𑆩𑆲𑆳𑆑𑆬𑇀𑆪𑆳𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇕𑇆
𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆁 𑆓𑇀𑆫𑆲𑆁 𑆯𑆾𑆰𑆁 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆁 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆩𑆧𑆵𑆘𑆠𑆳𑆩𑇀 𑇅 𑆔𑆸𑆠𑆩𑆼𑆠𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆪𑆼 𑆖𑆳𑆢𑆿 𑆓𑆢𑆴𑆠𑆳 𑆓𑆢𑆳𑆂 𑇆𑇒𑇖𑇆
𑆧𑆫𑇀𑆲𑆴𑆰𑇀𑆜𑆑𑆶𑆰𑇀𑆜𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆑𑆛𑆶𑆑𑆽𑆬𑆳𑆤𑆴𑆯𑆳𑆲𑇀𑆮𑆪𑆽𑆂 𑇅 𑆠𑆓𑆫𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆮𑆳𑆘𑆴𑆓𑆤𑇀𑆣𑆳𑆩𑆫𑆢𑇀𑆫𑆶𑆩𑆽𑆂 𑇆𑇒𑇗𑇆
𑆮𑆖𑆳𑇁𑆘𑆩𑆾𑆢𑆳𑆑𑆳𑆑𑆾𑆬𑆵𑆩𑆼𑆢𑆳𑆩𑆣𑆶𑆑𑆥𑆢𑇀𑆩𑆑𑆽𑆂 𑇅 𑆱𑆯𑆫𑇀𑆑𑆫𑆁 𑆲𑆴𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆑𑇀𑆮𑆁 𑆑𑇀𑆰𑆵𑆫𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀 𑇆𑇒𑇘𑇆
𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆓𑇀𑆫𑆲𑆘𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆥𑆶𑆁𑆱𑆳 𑆢𑆶𑆰𑇀𑆛𑆳𑆬𑇀𑆥𑆫𑆼𑆠𑆱𑆳𑆩𑇀 𑇅 𑆒𑇀𑆪𑆳𑆠𑆁 𑆦𑆬𑆔𑆸𑆠𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆖𑆳𑆯𑆶 𑆓𑆫𑇀𑆨𑆢𑆩𑇀) 𑇆𑇒𑇙𑇆
𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆩𑆽𑆤𑇀𑆢𑇀𑆫𑆵𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆴 𑆮𑇀𑆪𑆾𑆰𑆁 𑆲𑆴𑆕𑇀𑆓𑆶 𑆱𑆶𑆫𑆳𑆁 𑆘𑆛𑆳𑆩𑇀 𑇅 𑆮𑆴𑆰𑆔𑇀𑆤𑆵𑆁 𑆬𑆯𑆶𑆤𑆁 𑆫𑆳𑆱𑇀𑆤𑆳𑆁 𑆮𑆴𑆯𑆬𑇀𑆪𑆳𑆁 𑆱𑆶𑆫𑆱𑆳𑆁 𑆮𑆖𑆳𑆩𑇀 𑇆𑇓𑇐𑇆
𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆖 𑆃𑆤𑆤𑇀𑆠𑆳𑆩𑆨𑆪𑆳𑆁 𑆠𑆡𑆳 𑇅 𑆱𑆿𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆵𑆁 𑆖 𑆱𑆩𑆳𑆁𑆯𑆳𑆤𑆴 𑆓𑆘𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆼𑆰𑆪𑆼𑆠𑇀 𑇆𑇓𑇑𑇆
𑆗𑆳𑆪𑆳𑆮𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆫𑇀𑆠𑆵𑆫𑇀𑆪𑆾𑆘𑆪𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆑𑆾𑆮𑆴𑆢𑆂 𑇅 𑆃𑆮𑆥𑆵𑆝𑆼𑇁𑆚𑇀𑆘𑆤𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆤𑆱𑇀𑆪𑆼 𑆣𑆷𑆩𑆼 𑆥𑇀𑆫𑆬𑆼𑆥𑆤𑆼 𑇆𑇓𑇒𑇆
𑆇𑆫𑆾𑆥𑆳𑆕𑇀𑆓𑆬𑆬𑆳𑆛𑆼𑆰𑆶 𑆱𑆴𑆫𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅𑇓𑇓𑇅 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆖𑆳𑆥𑆴 𑆓𑇀𑆫𑆲𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆁 𑆖 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇓𑇓𑇆
𑆯𑆳𑆤𑇀𑆠𑆢𑆾𑆰𑆁 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆁 𑆖 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆫𑆳𑆖𑆫𑆼𑆠𑇀 𑇅𑇓𑇔𑇅 𑆇𑆤𑇀𑆩𑆳𑆢𑆼𑆰𑆶 𑆖 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑇀 𑇅 𑆩𑆸𑆢𑆶𑆥𑆷𑆫𑇀𑆮𑆳𑆁 𑆩𑆢𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆩𑆸𑆢𑇀𑆮𑆵𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠 𑇆𑇓𑇔𑇆
𑆯𑆾𑆑𑆯𑆬𑇀𑆪𑆁 𑆮𑇀𑆪𑆥𑆤𑆪𑆼𑆢𑆶𑆤𑇀𑆩𑆳𑆢𑆼 𑆥𑆚𑇀𑆖𑆩𑆼 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆮𑆴𑆰𑆘𑆼 𑆩𑆸𑆢𑆶𑆥𑆷𑆫𑇀𑆮𑆳𑆁 𑆖 𑆮𑆴𑆰𑆔𑇀𑆤𑆵𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇆𑇓𑇕𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆱𑆨𑆼𑆢𑆮𑆴𑆑𑆬𑇀𑆥𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆥𑆚𑇀𑆖𑆢𑆯𑆣𑆳 𑆥𑇀𑆫𑆱𑆫𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆱𑇀𑆠𑆶 𑆪𑆂 𑇅 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑇀𑆪𑆳 𑆫𑆱𑆳𑆨𑆼𑆢𑆳𑆤𑆳𑆁 𑆠𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆃𑆮𑆴𑆢𑆓𑇀𑆣𑆳 𑆮𑆴𑆢𑆓𑇀𑆣𑆳𑆯𑇀𑆖 𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆼 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆣𑆳 𑇅 𑆫𑆱𑆨𑆼𑆢𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆁 𑆠𑆶 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆮𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇔𑇆
𑆍𑆑𑆽𑆑𑆼𑆤𑆳𑆤𑆶𑆓𑆩𑆤𑆁 𑆨𑆳𑆓𑆯𑆾 𑆪𑆢𑆶𑆢𑆵𑆫𑆴𑆠𑆩𑇀 𑇅 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 , 𑆠𑆠𑇀𑆫 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆁 𑆠𑆶 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑇀𑆮𑆴𑆑𑆼𑆰𑆶 𑆩𑆣𑆶𑆫𑆾 𑆫𑆱𑆂 𑇅 𑆥𑆚𑇀𑆖𑆳𑆤𑆶𑆑𑇀𑆫𑆩𑆠𑆼 𑆪𑆾𑆓𑆳𑆤𑆩𑇀𑆬𑆯𑇀𑆖𑆠𑆶𑆫 𑆍𑆮 𑆠𑆶 𑇆𑇖𑇆
𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆳𑆤𑆶𑆓𑆖𑇀𑆗𑆠𑆴 𑆫𑆱𑆾 𑆬𑆮𑆟𑆂 𑆑𑆛𑆶𑆑𑆾 𑆢𑇀𑆮𑆪𑆩𑇀 𑇅 𑆠𑆴𑆑𑇀𑆠𑆂 𑆑𑆰𑆳𑆪𑆩𑆤𑇀𑆮𑆼𑆠𑆴 𑆠𑆼 𑆢𑇀𑆮𑆴𑆑𑆳 𑆢𑆯 𑆥𑆚𑇀𑆖 𑆖 𑇆𑇗𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆂(𑇑), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆂(𑇒), 𑆩𑆣𑆶𑆫𑆑𑆛𑆶𑆑𑆂(𑇓), 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆂(𑇔), 𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆂(𑇕), 𑆍𑆠𑆼𑆥𑆚𑇀𑆖𑆳𑆤𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳 𑆩𑆣𑆶𑆫𑆼𑆟; 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆂(𑇑), 𑆃𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆂(𑇒), 𑆃𑆩𑇀𑆬𑆠𑆴𑆑𑇀𑆠𑆂(𑇓), 𑆃𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆂(𑇔), 𑆍𑆠𑆼 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆤𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳 𑆃𑆩𑇀𑆬𑆼𑆤; 𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆂(𑇑), 𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆂(𑇒), 𑆬𑆮𑆟𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆍𑆠𑆼 𑆠𑇀𑆫𑆪𑆾𑇁𑆤𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳 𑆬𑆮𑆟𑆼𑆤; 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆂(𑇑), 𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇒), 𑆢𑇀𑆮𑆳𑆮𑆼𑆠𑆳𑆮𑆤𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆿 𑆑𑆛𑆶𑆑𑆼𑆤; 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑) 𑆍𑆑 𑆍𑆮𑆳𑆤𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆼𑆤; 𑆍𑆮𑆩𑆼𑆠𑆼 𑆥𑆚𑇀𑆖𑆢𑆯 𑆢𑇀𑆮𑆴𑆑𑆱𑆁𑆪𑆾𑆓𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇘𑇆
𑆠𑇀𑆫𑆴𑆑𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆄𑆢𑆿 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆠𑆶 𑆩𑆣𑆶𑆫𑆾 𑆢𑆯 𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆰𑆝𑆩𑇀𑆬𑆾 𑆬𑆮𑆟𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆫𑇀𑆣𑆩𑆼𑆑𑆁 𑆠𑆡𑆳 𑆑𑆛𑆶𑆂 𑇆𑇙𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆂(𑇑), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆂(𑇒), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆠𑆴𑆑𑇀𑆠𑆂(𑇓), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆰𑆳𑆪𑆂(𑇔), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆂(𑇕), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆳𑆂(𑇖), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆑𑆰𑆳𑆪𑆂(𑇗), 𑆩𑆣𑆶𑆫𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆂(𑇘), 𑆩𑆣𑆶𑆫𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇙), 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑𑇐), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆢𑆯𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆱𑆁𑆪𑆾𑆓𑆳𑆤𑆳𑆩𑆳𑆢𑆿 𑆩𑆣𑆶𑆫𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆂(𑇑), 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆂(𑇒), 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆃𑆩𑇀𑆬𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆂(𑇔), 𑆃𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇕), 𑆃𑆩𑇀𑆬𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇖), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆰𑆟𑇀𑆟𑆳𑆩𑆳𑆢𑆳𑆮𑆩𑇀𑆬𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆂(𑇑), 𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇒), 𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆳𑆢𑆿 𑆬𑆮𑆟𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑), 𑆍𑆮𑆩𑆼𑆑𑆱𑇀𑆪𑆳𑆢𑆿 𑆑𑆛𑆶𑆑𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆍𑆮𑆩𑆼𑆠𑆼 𑆠𑇀𑆫𑆴𑆑𑆱𑆁𑆪𑆾𑆓𑆳 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇐𑇆
𑆖𑆠𑆶𑆰𑇀𑆑𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆖𑆠𑆶𑆰𑇀𑆑𑆫𑆱𑆱𑆁𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆣𑆶𑆫𑆾 𑆢𑆯 𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆖𑆠𑆶𑆫𑆾𑇁𑆩𑇀𑆬𑆾𑇁𑆤𑆶𑆓𑆖𑇀𑆗𑆼𑆖𑇀𑆖 𑆬𑆮𑆟𑆱𑇀𑆠𑇀𑆮𑆼𑆑𑆩𑆼𑆮 𑆠𑆶 𑇆𑇑𑇑𑇆
𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆂(𑇑), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆂(𑇒), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆂(𑇔), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇕), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇖), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆂(𑇗), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇘), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇙), 𑆩𑆣𑆶𑆫𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑𑇐), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆢𑆯𑆳𑆤𑆳𑆩𑆳𑆢𑆿 𑆩𑆣𑆶𑆫𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆂(𑇑), 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇒), 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆃𑆩𑇀𑆬𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇔), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆩𑆳𑆢𑆳𑆮𑆩𑇀𑆬𑆂; 𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑), 𑆍𑆮𑆩𑆼𑆑𑆱𑇀𑆪𑆳𑆢𑆿 𑆬𑆮𑆟𑆂; 𑆍𑆮𑆩𑆼𑆠𑆼 𑆖𑆠𑆶𑆰𑇀𑆑𑆫𑆱𑆱𑆁𑆪𑆾𑆓𑆳𑆂 𑆥𑆚𑇀𑆖𑆢𑆯 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇆𑇑𑇒𑇆
𑆥𑆚𑇀𑆖𑆑𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆥𑆚𑇀𑆖𑆑𑆳𑆤𑇀 𑆥𑆚𑇀𑆖 𑆩𑆣𑆶𑆫 𑆍𑆑𑆩𑆩𑇀𑆬𑆱𑇀𑆠𑆶 𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇑𑇓𑇆
𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆂(𑇑), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆂(𑇒), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇓), 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇔), 𑆩𑆣𑆶𑆫𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇕), 𑆍𑆮𑆩𑆼𑆰𑆳𑆁 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑆳𑆢𑆿 𑆩𑆣𑆶𑆫𑆂 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂(𑇑), 𑆍𑆮𑆩𑆼𑆑𑆱𑇀𑆪𑆳𑆢𑆳𑆮𑆩𑇀𑆬𑆂; 𑆍𑆮𑆩𑆼𑆠𑆼 𑆰𑆛𑇀 𑆥𑆚𑇀𑆖𑆑𑆱𑆁𑆪𑆾𑆓𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇔𑇆
𑆰𑆛𑇀𑆑𑆩𑆼𑆑𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂; 𑆍𑆑𑆱𑇀𑆠𑆶 𑆰𑆛𑇀𑆑𑆱𑆁𑆪𑆾𑆓𑆂- 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆂; 𑆍𑆰 𑆍𑆑 𑆍𑆮 𑆰𑆛𑇀𑆱𑆁𑆪𑆾𑆓𑆂 𑇆𑇑𑇕𑇆
𑆍𑆑𑆽𑆑𑆯𑇀𑆖 𑆰𑆝𑇀𑆫𑆱𑆳 𑆨𑆮𑆤𑇀𑆠𑆴- 𑆩𑆣𑆶𑆫𑆂(𑇑), 𑆃𑆩𑇀𑆬𑆂(𑇒), 𑆬𑆮𑆟𑆂(𑇓), 𑆑𑆛𑆶𑆑𑆂(𑇔), 𑆠𑆴𑆑𑇀𑆠𑆂(𑇕), 𑆑𑆰𑆳𑆪𑆂(𑇖), 𑆅𑆠𑆴 𑇆𑇑𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆍𑆰𑆳 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆫𑆱𑆳𑆤𑆳𑆁 𑆫𑆱𑆖𑆴𑆤𑇀𑆠𑆑𑆽𑆂 𑇅 𑆢𑆾𑆰𑆨𑆼𑆢𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑇀𑆪𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆽𑆂 𑇆𑇑𑇗𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆

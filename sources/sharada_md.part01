𑆠𑇀𑆫𑆴𑆁𑆯𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆠𑆂 𑆑𑆬𑇀𑆥𑆳𑆤𑇀 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼𑇅 𑆦𑆬𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆑𑆬𑇀𑆥𑆾 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆱𑇀𑆪 𑆖𑇆𑇖𑇒𑇆
𑆥𑆚𑇀𑆖𑆩𑆾 𑆮𑆠𑇀𑆱𑆑𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆂 𑆰𑆰𑇀𑆜𑆯𑇀𑆖 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆼𑇅 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆪𑆾𑆂 𑆑𑆬𑇀𑆥𑆱𑇀𑆠𑆡𑆽𑆮 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼𑇆𑇖𑇓𑇆
𑆠𑆴𑆬𑇀𑆮𑆑𑆱𑇀𑆪 𑆱𑆶𑆣𑆳𑆪𑆳𑆯𑇀𑆖 𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆰𑆶 𑆖𑇅 𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪𑆾𑆂 𑆑𑆬𑇀𑆥𑆯𑇀𑆖 𑆢𑇀𑆮𑆳𑆢𑆯𑆾𑇁𑆪𑆁 𑆱𑆩𑆳𑆥𑇀𑆪𑆠𑆼𑇆𑇖𑇔𑇆
𑆑𑆬𑇀𑆥𑆤𑆳 𑆥𑆚𑇀𑆖𑆑𑆫𑇀𑆩𑆳𑆒𑇀𑆪𑆳 𑆧𑆱𑇀𑆠𑆴𑆱𑆷𑆠𑇀𑆫𑆵 𑆠𑆡𑆽𑆮 𑆖𑇅 𑆱𑇀𑆤𑆼𑆲𑆮𑇀𑆪𑆳𑆥𑆢𑆴𑆑𑆵 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆤𑆼𑆠𑇀𑆫𑆮𑇀𑆪𑆳𑆥𑆢𑆴𑆑𑆵 𑆠𑆡𑆳𑇆𑇖𑇕𑇆
𑆱𑆴𑆢𑇀𑆣𑆴𑆂 𑆯𑆾𑆣𑆤𑆪𑆾𑆯𑇀𑆖𑆽𑆮 𑆧𑆱𑇀𑆠𑆴𑆱𑆴𑆢𑇀𑆣𑆴𑆱𑇀𑆠𑆡𑆽𑆮 𑆖𑇅 𑆥𑇀𑆫𑆳𑆱𑆸𑆠𑆵 𑆩𑆫𑇀𑆩𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳 𑆖 𑆪𑆳𑇆𑇖𑇖𑇆
𑆦𑆬𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑆡𑆳 𑆱𑆴𑆢𑇀𑆣𑆴𑆂 𑆱𑆴𑆢𑇀𑆣𑆴𑆯𑇀𑆖𑆾𑆠𑇀𑆠𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑇅 𑆱𑆴𑆢𑇀𑆣𑆪𑆾 𑆢𑇀𑆮𑆳𑆢𑆯𑆽𑆮𑆽𑆠𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆁 𑆖𑆳𑆱𑆶 𑆱𑆩𑆳𑆥𑇀𑆪𑆠𑆼𑇆𑇖𑇗𑇆
𑆱𑇀𑆮𑆼 𑆱𑇀𑆮𑆼 𑆱𑇀𑆡𑆳𑆤𑆼 𑆠𑆡𑆳𑇁𑆣𑇀𑆪𑆳𑆪𑆼 𑆖𑆳𑆣𑇀𑆪𑆳𑆪𑆳𑆫𑇀𑆡𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆠𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑆂 𑆱𑆫𑇀𑆮𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆲𑇀𑆪𑆫𑇀𑆡𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆳𑆠𑇀𑇆𑇖𑇘𑇆
𑆥𑆸𑆖𑇀𑆗𑆳 𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆢𑇀𑆪𑆡𑆳𑆩𑇀𑆤𑆳𑆪𑆁 𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑇀𑆫𑆯𑇀𑆤 𑆇𑆖𑇀𑆪𑆠𑆼𑇅 𑆥𑇀𑆫𑆯𑇀𑆤𑆳𑆫𑇀𑆡𑆾 𑆪𑆶𑆑𑇀𑆠𑆴𑆩𑆳𑆁𑆱𑇀𑆠𑆱𑇀𑆪 𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆟𑆽𑆮𑆳𑆫𑇀𑆡𑆤𑆴𑆯𑇀𑆖𑆪𑆂 𑇆𑇖𑇙𑇆
𑆤𑆴𑆫𑆶𑆑𑇀𑆠𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆟𑆳𑆠𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆁, 𑆱𑇀𑆡𑆳𑆤𑆩𑆫𑇀𑆡𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆪𑆳𑇅 𑆃𑆣𑆴𑆑𑆸𑆠𑇀𑆪𑆳𑆫𑇀𑆡𑆩𑆣𑇀𑆪𑆳𑆪𑆤𑆳𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆳 𑇆𑇗𑇐𑇆
𑆅𑆠𑆴 𑆱𑆫𑇀𑆮𑆁 𑆪𑆡𑆳𑆥𑇀𑆫𑆯𑇀𑆤𑆩𑆰𑇀𑆛𑆑𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀𑇅 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆖𑆾𑆑𑇀𑆠𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆱𑆶𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆂𑇆𑇗𑇑𑇆
𑆱𑆤𑇀𑆠𑆴 𑆥𑆳𑆬𑇀𑆬𑆮𑆴𑆑𑆾𑆠𑇀𑆥𑆳𑆠𑆳𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴 𑆪𑆼𑇅 𑆮𑆫𑇀𑆠𑆑𑆳𑆤𑆳𑆩𑆴𑆮𑆾𑆠𑇀𑆥𑆳𑆠𑆳𑆂 𑆱𑆲𑆱𑆽𑆮𑆳𑆮𑆴𑆨𑆳𑆮𑆴𑆠𑆳𑆂𑇆𑇗𑇒𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆳𑆤𑇀 𑆥𑆷𑆫𑇀𑆮𑆱𑆚𑇀𑆘𑆬𑇀𑆥𑆼 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆳𑆰𑇀𑆛𑆑𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇅 𑆥𑆫𑆳𑆮𑆫𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆫𑇀𑆡𑆁 𑆠𑆠𑇀𑆫 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆢𑆳𑆁 𑆧𑆬𑆩𑇀𑇆𑇗𑇓𑇆
𑆯𑆧𑇀𑆢𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆑𑆼𑆮𑆬𑆱𑇀𑆪𑆽𑆑𑆢𑆼𑆯𑆴𑆑𑆳𑆂𑇅 𑆨𑇀𑆫𑆩𑆤𑇀𑆠𑇀𑆪𑆬𑇀𑆥𑆧𑆬𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆘𑇀𑆪𑆳𑆯𑆧𑇀𑆢𑆼𑆤𑆼𑆮 𑆮𑆫𑇀𑆠𑆑𑆳𑆂𑇆𑇗𑇔𑇆
𑆥𑆯𑆶𑆂 𑆥𑆯𑆷𑆤𑆳𑆁 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆠𑇀 𑆑𑆯𑇀𑆖𑆴𑆤𑇀𑆩𑆣𑇀𑆪𑆼 𑆮𑆸𑆑𑆳𑆪𑆠𑆼𑇅 𑆱 𑆱𑆠𑇀𑆪𑆁 𑆮𑆸𑆑𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆨𑆘𑆠𑆼 𑆥𑆯𑆶𑆂𑇆𑇗𑇕𑇆
𑆠𑆢𑇀𑆮𑆢𑆘𑇀𑆚𑆾𑇁𑆘𑇀𑆚𑆩𑆣𑇀𑆪𑆱𑇀𑆡𑆂 𑆑𑆯𑇀𑆖𑆴𑆤𑇀𑆩𑆿𑆒𑆫𑇀𑆪𑆱𑆳𑆣𑆤𑆂𑇅 𑆱𑇀𑆡𑆳𑆥𑆪𑆠𑇀𑆪𑆳𑆥𑇀𑆠𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆥𑇀𑆠𑆁 𑆠𑇀𑆮𑆳𑆱𑆳𑆢𑇀𑆪 𑆨𑆴𑆢𑇀𑆪𑆠𑆼𑇆𑇗𑇖𑇆
𑆧𑆨𑇀𑆫𑆶𑆫𑇀𑆓𑆷𑆞 𑆅𑆮𑆾𑆫𑇀𑆟𑆳𑆨𑆴𑆫𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆧𑆲𑆶𑆯𑇀𑆫𑆶𑆠𑆂𑇅 𑆑𑆴𑆁 𑆮𑆽 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆴 𑆱𑆚𑇀𑆘𑆬𑇀𑆥𑆼 𑆑𑆶𑆟𑇀𑆝𑆨𑆼𑆢𑆵 𑆘𑆝𑆾 𑆪𑆡𑆳𑇆𑇗𑇗𑇆
𑆱𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆽𑆫𑇀𑆤 𑆮𑆴𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑆬𑇀𑆥𑆯𑇀𑆫𑆶𑆠𑆽𑆫𑆥𑆴𑇅 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑇀𑆤𑆳𑆰𑇀𑆛𑆑𑆼𑆤𑆳𑆢𑆳𑆮𑆴𑆠𑆫𑆳𑆁𑆱𑇀𑆠𑇀𑆮𑆳𑆥𑇀𑆠𑆩𑆳𑆤𑆴𑆤𑆂 𑇆𑇗𑇘𑇆
𑆢𑆩𑇀𑆨𑆴𑆤𑆾 𑆩𑆶𑆒𑆫𑆳 𑆲𑇀𑆪𑆘𑇀𑆚𑆳𑆂 𑆥𑇀𑆫𑆨𑆷𑆠𑆳𑆧𑆢𑇀𑆣𑆨𑆳𑆰𑆴𑆟𑆂𑇅 𑆥𑇀𑆫𑆳𑆪𑆂, 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆱𑆶𑆩𑆶𑆒𑆳𑆂 𑆱𑆤𑇀𑆠𑆾 𑆪𑆶𑆑𑇀𑆠𑆳𑆬𑇀𑆥𑆨𑆳𑆰𑆴𑆟𑆂𑇆𑇗𑇙𑇆
𑆠𑆠𑇀𑆠𑇀𑆮𑆘𑇀𑆚𑆳𑆤𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆫𑇀𑆡𑆩𑆲𑆕𑇀𑆑𑆳𑆫𑆩𑆤𑆳𑆯𑇀𑆫𑆴𑆠𑆂𑇅 𑆱𑇀𑆮𑆬𑇀𑆥𑆳𑆣𑆳𑆫𑆳𑆘𑇀𑆚𑆩𑆶𑆒𑆫𑆳𑆤𑇀𑆩𑆫𑇀𑆰𑆪𑆼𑆤𑇀𑆤 𑆮𑆴𑆮𑆳𑆢𑆴𑆤𑆂𑇆𑇘𑇐𑇆
𑆥𑆫𑆾 𑆨𑆷𑆠𑆼𑆰𑇀𑆮𑆤𑆶𑆑𑇀𑆫𑆾𑆯𑆱𑇀𑆠𑆠𑇀𑆠𑇀𑆮𑆘𑇀𑆚𑆳𑆤(𑆤𑆼)𑆥𑆫𑆳 𑆢𑆪𑆳𑇅 𑆪𑆼𑆰𑆳𑆁 𑆠𑆼𑆰𑆳𑆩𑆱𑆢𑇀𑆮𑆳𑆢𑆤𑆴𑆓𑇀𑆫𑆲𑆼 𑆤𑆴𑆫𑆠𑆳 𑆩𑆠𑆴𑆂𑇆𑇘𑇑𑇆
𑆃𑆱𑆠𑇀𑆥𑆑𑇀𑆰𑆳𑆑𑇀𑆰𑆟𑆴𑆠𑇀𑆮𑆳𑆫𑇀𑆠𑆴𑆢𑆩𑇀𑆨𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆱𑆳𑆣𑆤𑆳𑆂𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆤𑆳𑆥𑇀𑆠𑆳𑆂 𑆱𑇀𑆮𑆼 𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆫𑆮𑆴𑆑𑆠𑇀𑆡𑆑𑆳𑆂𑇆𑇘𑇒𑇆
𑆠𑆳𑆤𑇀 𑆑𑆳𑆬𑆥𑆳𑆯𑆱𑆢𑆸𑆯𑆳𑆤𑇀 𑆮𑆫𑇀𑆘𑆪𑆼𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆢𑆷𑆰𑆑𑆳𑆤𑇀𑇅 𑆥𑇀𑆫𑆯𑆩𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆥𑆷𑆫𑇀𑆟𑆳𑆂 𑆱𑆼𑆮𑇀𑆪𑆳 𑆨𑆴𑆰𑆑𑇀𑆠𑆩𑆳𑆂𑇆𑇘𑇓𑇆
𑆱𑆩𑆓𑇀𑆫𑆁 𑆢𑆶𑆂𑆒𑆩𑆳𑆪𑆠𑇀𑆠𑆩𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆢𑇀𑆮𑆪𑆳𑆯𑇀𑆫𑆪𑆩𑇀𑇅 𑆱𑆶𑆒𑆁 𑆱𑆩𑆓𑇀𑆫𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆮𑆴𑆩𑆬𑆼 𑆖 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆩𑇀𑇆𑇘𑇔𑇆
𑆅𑆢𑆩𑆼𑆮𑆩𑆶𑆢𑆳𑆫𑆳𑆫𑇀𑆡𑆩𑆘𑇀𑆚𑆳𑆤𑆳𑆁 𑆤 𑆥𑇀𑆫𑆑𑆳𑆯𑆑𑆩𑇀𑇅 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆥𑇀𑆫𑆟𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆪𑆡𑆽𑆮𑆳𑆢𑆴𑆠𑇀𑆪𑆩𑆟𑇀𑆝𑆬𑆩𑇀𑇆𑇘𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆃𑆫𑇀𑆡𑆼 𑆢𑆯𑆩𑆲𑆳𑆩𑆷𑆬𑆳𑆂 𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆖𑆳𑆱𑆳𑆁 𑆪𑆡𑆳 𑆑𑆸𑆠𑆳𑇅 𑆃𑆪𑆤𑆳𑆤𑇀𑆠𑆳𑆂 𑆰𑆝𑆓𑇀𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆫𑆷𑆥𑆁 𑆮𑆼𑆢𑆮𑆴𑆢𑆳𑆁 𑆖 𑆪𑆠𑇀𑇆𑇘𑇖𑇆
𑆱𑆥𑇀𑆠𑆑𑆯𑇀𑆖𑆳𑆰𑇀𑆛𑆑𑆯𑇀𑆖𑆽𑆮 𑆥𑆫𑆴𑆥𑇀𑆫𑆯𑇀𑆤𑆳𑆂 𑆱𑆤𑆴𑆫𑇀𑆟𑆪𑆳𑆂𑇅 𑆪𑆡𑆳 𑆮𑆳𑆖𑇀𑆪𑆁 𑆪𑆢𑆫𑇀𑆡𑆁 𑆖 𑆰𑆝𑇀𑆮𑆴𑆣𑆳𑆯𑇀𑆖𑆽𑆑𑆢𑆼𑆯𑆴𑆑𑆳𑆂𑇆𑇘𑇗𑇆
𑆃𑆫𑇀𑆡𑆼𑆢𑆯𑆩𑆲𑆳𑆩𑆷𑆬𑆼 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀𑇅 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆯𑇀𑆖𑆳𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪𑆳𑆱𑇀𑆪𑆽𑆮 𑆑𑆼𑆮𑆬𑆂𑇆𑇘𑇘𑇆
𑆪𑆡𑆳 𑆱𑆶𑆩𑆤𑆱𑆳𑆁 𑆱𑆷𑆠𑇀𑆫𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆁 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆁 𑆠𑆡𑆳𑇁𑆫𑇀𑆡𑆳𑆤𑆳𑆩𑆸𑆰𑆴𑆟𑆳 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆑𑆸𑆠𑆂𑇆𑇘𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆬𑇀𑆥𑆤𑆳𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆑𑆳 𑆑𑆬𑇀𑆥𑆤𑆳 𑆥𑆚𑇀𑆖𑆱𑆶 𑆑𑆫𑇀𑆩𑆱𑆷𑆑𑇀𑆠𑆳, 𑆑𑇀𑆫𑆩𑆯𑇀𑆖 𑆑𑆂, 𑆑𑆴𑆁 𑆖 𑆑𑆸𑆠𑆳𑆑𑆸𑆠𑆼𑆰𑆶𑇅 𑆬𑆴𑆝𑇀𑆓𑆁 𑆠𑆡𑆽𑆮𑆳𑆠𑆴𑆑𑆸𑆠𑆼𑆰𑆶, 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆑𑆳, 𑆑𑆴𑆕𑇀𑆓𑆶𑆟𑆂, 𑆑𑆼𑆰𑆶 𑆖 𑆑𑆯𑇀𑆖 𑆧𑆱𑇀𑆠𑆴𑆂𑇆𑇓𑇆
𑆑𑆴𑆁 𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆑𑆳𑆬𑆼, 𑆑𑆸𑆠𑆼 𑆑𑆴𑆪𑆳𑆤𑇀 𑆮𑆳 𑆥𑆫𑆴𑆲𑆳𑆫𑆑𑆳𑆬𑆂𑇅 𑆥𑇀𑆫𑆟𑆵𑆪𑆩𑆳𑆤𑆯𑇀𑆖 𑆤 𑆪𑆳𑆠𑆴 𑆑𑆼𑆤, 𑆑𑆼𑆤𑆽𑆠𑆴 𑆯𑆵𑆔𑇀𑆫𑆁, 𑆱𑆶𑆖𑆴𑆫𑆳𑆖𑇀𑆖 𑆧𑆱𑇀𑆠𑆴𑆂𑇆𑇔𑇆
𑆱𑆳𑆣𑇀𑆪𑆳 𑆓𑆢𑆳𑆂 𑆱𑇀𑆮𑆽𑆂 𑆯𑆩𑆤𑆽𑆯𑇀𑆖 𑆑𑆼𑆖𑆴𑆠𑇀 𑆑𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆤 𑆯𑆩𑆁 𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑆴𑇅 𑆥𑇀𑆫𑆖𑆾𑆢𑆴𑆠𑆂 𑆯𑆴𑆰𑇀𑆪𑆮𑆫𑆼𑆟 𑆱𑆩𑇀𑆪𑆓𑆴𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆼𑆤 𑆨𑆴𑆰𑆓𑇀𑆮𑆫𑆴𑆰𑇀𑆜𑆂𑇆𑇕𑇆
𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆮𑆴𑆢𑆳𑆲 𑆠𑆱𑇀𑆩𑆽 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁 𑆲𑆴𑆠𑆑𑆳𑆩𑇀𑆪𑆪𑆼𑆢𑆩𑇀𑇅𑇖𑇅 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆮𑆫𑆁 𑆱𑆥𑇀𑆠𑆢𑆴𑆤𑆁 𑆥𑆫𑆁 𑆠𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆤𑆫𑆂 𑆱𑇀𑆮𑆼𑆢𑆪𑆴𑆠𑆮𑇀𑆪 𑆇𑆑𑇀𑆠𑆂 𑇆𑇖𑇆
𑆤𑆳𑆠𑆂 𑆥𑆫𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆩𑆳𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆵𑆨𑆮𑆼𑆠𑇀 𑆱𑆥𑇀𑆠𑆢𑆴𑆤𑆳𑆠𑇀 𑆥𑆫𑆁 𑆠𑆶𑇅𑇗𑇅 𑆱𑇀𑆤𑆼𑆲𑆾𑇁𑆤𑆴𑆬𑆁 𑆲𑆤𑇀𑆠𑆴 𑆩𑆸𑆢𑆷𑆑𑆫𑆾𑆠𑆴 𑆢𑆼𑆲𑆁 𑆩𑆬𑆳𑆤𑆳𑆁 𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆱𑆕𑇀𑆓𑆩𑇀𑇆𑇗𑇆
𑆃𑆣𑆂 𑆑𑆦𑆼𑇁𑆬𑇀𑆥𑆼 𑆮𑆩𑆤𑆁 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆮𑆸𑆢𑇀𑆣𑆑𑆦𑆼 𑆠𑆡𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑇀𑇅𑇑𑇐𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆪 𑆢𑆼𑆪𑆁 𑆮𑆩𑆤𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆮𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆥𑆼𑆪𑆳𑆢𑆴𑆫𑆤𑆶𑆑𑇀𑆫𑆩𑆯𑇀𑆖𑇆𑇑𑇐𑇆
𑆑𑇀𑆫𑆩𑆼𑆟 𑆱𑆼𑆮𑆼𑆠 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆑𑆳𑆪𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆣𑇀𑆪𑆳𑆮𑆫𑆯𑆶𑆢𑇀𑆣𑆴𑆯𑆶𑆢𑇀𑆣𑆂𑇅𑇑𑇒𑇅 𑆪𑆡𑆳𑇁𑆟𑆶𑆫𑆓𑇀𑆤𑆴𑆱𑇀𑆠𑆸𑆟𑆓𑆾𑆩𑆪𑆳𑆢𑇀𑆪𑆽𑆂 𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑇀𑆪𑆩𑆳𑆟𑆾 𑆨𑆮𑆠𑆴 𑆑𑇀𑆫𑆩𑆼𑆟𑇆𑇑𑇒𑇆
𑆩𑆲𑆳𑆤𑇀 𑆱𑇀𑆡𑆴𑆫𑆂 𑆱𑆫𑇀𑆮𑆥𑆖𑆱𑇀𑆠𑆡𑆽𑆮 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆥𑆼𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆂𑇅𑇑𑇓𑇅 𑆘𑆔𑆤𑇀𑆪𑆩𑆣𑇀𑆪𑆥𑇀𑆫𑆮𑆫𑆼 𑆠𑆶 𑆮𑆼𑆓𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫 𑆅𑆰𑇀𑆛𑆳 𑆮𑆩𑆤𑆼 𑆰𑆝𑆰𑇀𑆛𑆿𑇆𑇑𑇓𑇆
𑆢𑆯𑆽𑆮 𑆠𑆼 𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆳 𑆮𑆴𑆫𑆼𑆑𑆼 𑆥𑇀𑆫𑆱𑇀𑆡𑆱𑇀𑆠𑆡𑆳 𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆯𑇀𑆖𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆠𑆩𑆴𑆰𑇀𑆛𑆁 𑆮𑆩𑆤𑆁 𑆮𑆴𑆫𑆼𑆑𑆳𑆢𑆫𑇀𑆣𑆁 𑆑𑆦𑆳𑆤𑇀𑆠𑆁 𑆖 𑆮𑆴𑆫𑆼𑆑𑆩𑆳𑆲𑆶𑆂𑇆𑇑𑇔𑇆
𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆳𑆤𑇀 𑆱𑆮𑆴𑆛𑇀𑆑𑆳𑆤𑆥𑆤𑆵𑆪 𑆮𑆼𑆓𑆳𑆤𑇀𑆩𑆼𑆪𑆁 𑆮𑆴𑆫𑆼𑆑𑆼 𑆮𑆩𑆤𑆼 𑆠𑆶 𑆥𑆵𑆠𑆩𑇀𑇅𑇑𑇕𑇅 𑆑𑇀𑆫𑆩𑆳𑆠𑇀 𑆑𑆦𑆂 𑆥𑆴𑆠𑇀𑆠𑆩𑆡𑆳𑆤𑆴𑆬𑆯𑇀𑆖 𑆪𑆱𑇀𑆪𑆽𑆠𑆴 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆩𑆴𑆠𑆂 𑆱 𑆅𑆰𑇀𑆛𑆂𑇆𑇑𑇕𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆩𑆷𑆫𑇀𑆣𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆳𑆫𑇀𑆓𑆯𑆶𑆢𑇀𑆣𑆿 𑆠𑆡𑆳 𑆬𑆔𑆶𑆠𑇀𑆮𑆼𑇁𑆥𑆴 𑆖 𑆬𑆑𑇀𑆰𑇀𑆪𑆩𑆳𑆟𑆼𑇅𑇑𑇖𑇅 𑆢𑆶𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆠𑆼 𑆱𑇀𑆦𑆾𑆛𑆑𑆑𑆾𑆜𑆑𑆟𑇀𑆝𑆷𑆲𑆸𑆠𑇀𑆒𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳𑆁 𑆖𑇆𑇑𑇖𑇆
𑆠𑆸𑆟𑇀𑆩𑆾𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆤𑆴𑆬𑆑𑆾𑆥𑆤𑆴𑆢𑇀𑆫𑆳𑆧𑆬𑆳𑆢𑆴𑆲𑆳𑆤𑆴𑆫𑇀𑆮𑆩𑆤𑆼𑇁𑆠𑆴 𑆖 𑆱𑇀𑆪𑆳𑆠𑇀𑇅𑇑𑇗𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆿 𑆬𑆔𑆶𑆠𑇀𑆮𑆩𑆷𑆫𑇀𑆘𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑆤𑆳𑆩𑆪𑆠𑇀𑆮𑆩𑇀𑇆𑇑𑇗𑇆
𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆯𑇀𑆖 𑆮𑆴𑆛𑇀𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑆴𑆬𑆳𑆤𑆳𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆱𑇀𑆪 𑆨𑆮𑆼𑆠𑇀 𑆑𑇀𑆫𑆩𑆼𑆟𑇅𑇑𑇘𑇅 𑆱𑇀𑆪𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆾𑆥𑆂 𑆱𑆳𑆢𑆱𑇀𑆠𑆡𑆳𑇁𑆓𑇀𑆤𑆼𑆫𑇀𑆓𑆶𑆫𑆶𑆠𑆳 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑇆𑇑𑇘𑇆

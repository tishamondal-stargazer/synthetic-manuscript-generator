𑆖𑆴𑆫𑆳𑆠𑇀 𑆥𑆳𑆑𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑇀𑆮𑆫𑆳𑆑𑆸𑆠𑆴𑆂𑇅𑇑𑇐𑇙𑇅 𑆢𑆾𑆰𑆼 𑆮𑆴𑆧𑆢𑇀𑆣𑆼 𑆤𑆰𑇀𑆛𑆼𑇁𑆓𑇀𑆤𑆿 𑆱𑆫𑇀𑆮𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆬𑆑𑇀𑆰𑆟𑆂𑇆𑇑𑇐𑇙𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑇀𑆮𑆫𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇅𑇑𑇑𑇐𑇅 𑆤𑆴𑆢𑆳𑆤𑆼 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆪𑆳 𑆥𑆸𑆡𑆓𑇀𑆘𑆘𑇀𑆮𑆫𑆳𑆑𑆸𑆠𑆴𑆂𑇆𑇑𑇑𑇐𑇆
𑆱𑆁𑆱𑆫𑇀𑆓𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆤𑆳𑆁 𑆠𑆪𑆳 𑆖𑆾𑆑𑇀𑆠𑆁 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅𑇑𑇑𑇑𑇅 𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑆰𑇀𑆛𑆩𑆾 𑆪𑆱𑇀𑆠𑆶 𑆱 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂𑇆𑇑𑇑𑇑𑇆
𑆃𑆨𑆴𑆔𑆳𑆠𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆨𑇀𑆪𑆳𑆩𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆠𑆂𑇅 𑆯𑆱𑇀𑆠𑇀𑆫𑆬𑆾𑆰𑇀𑆛𑆑𑆯𑆳𑆑𑆳𑆰𑇀𑆜𑆩𑆶𑆰𑇀𑆛𑇀𑆪𑆫𑆠𑇀𑆤𑆴𑆠𑆬𑆢𑇀𑆮𑆴𑆘𑆽𑆂𑇆𑇑𑇑𑇒𑇆
𑆠𑆢𑇀𑆮𑆴𑆣𑆽𑆯𑇀𑆖 𑆲𑆠𑆼 𑆓𑆳𑆠𑇀𑆫𑆼 𑆘𑇀𑆮𑆫𑆂 𑆱𑇀𑆪𑆳𑆢𑆨𑆴𑆔𑆳𑆠𑆘𑆂𑇅 𑆠𑆠𑇀𑆫𑆳𑆨𑆴𑆔𑆳𑆠𑆘𑆼 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆳𑆪𑆾 𑆫𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆢𑆷𑆰𑆪𑆤𑇀𑇆𑇑𑇑𑇓𑇆
𑆱𑆮𑇀𑆪𑆡𑆳𑆯𑆾𑆦𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆑𑆫𑆾𑆠𑆴 𑆱𑆫𑆶𑆘𑆁 𑆘𑇀𑆮𑆫𑆩𑇀𑇅𑇑𑇑𑇔𑇅 𑆑𑆳𑆩𑆯𑆾𑆑𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆽𑆫𑆨𑆴𑆰𑆑𑇀𑆠𑆱𑇀𑆪 𑆪𑆾 𑆘𑇀𑆮𑆫𑆂𑇆𑇑𑇑𑇔𑇆
𑆱𑆾𑇁𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆘𑇀𑆮𑆫𑆾 𑆘𑇀𑆚𑆼𑆪𑆾 𑆪𑆯𑇀𑆖 𑆨𑆷𑆠𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆘𑆂𑇅 𑆑𑆳𑆩𑆯𑆾𑆑𑆨𑆪𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆂, 𑆑𑇀𑆫𑆾𑆣𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁, 𑆠𑇀𑆫𑆪𑆾 𑆩𑆬𑆳𑆂𑇆𑇑𑇑𑇕𑇆
𑆨𑆷𑆠𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆠𑇀 𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴 𑆨𑆷𑆠𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆳𑆂𑇅 𑆨𑆷𑆠𑆳𑆣𑆴𑆑𑆳𑆫𑆼 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆠𑆢𑆰𑇀𑆛𑆮𑆴𑆣𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇑𑇖𑇆
𑆮𑆴𑆰𑆮𑆸𑆑𑇀𑆰𑆳𑆤𑆴𑆬𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆠𑇀𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆰𑆱𑆩𑇀𑆨𑆮𑆽𑆂𑇅 𑆃𑆨𑆴𑆰𑆑𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆳𑆲𑆶𑆫𑇀𑆘𑇀𑆮𑆫𑆩𑆼𑆑𑆼𑇁𑆨𑆴𑆰𑆕𑇀𑆓𑆘𑆩𑇀𑇆𑇑𑇑𑇗𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆪𑆳 𑆮𑆴𑆰𑆔𑇀𑆤𑇀𑆪𑆽𑆮 𑆱 𑆯𑆩𑆁 𑆬𑆨𑆠𑆼 𑆤𑆫𑆂𑇅 𑆃𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆪𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇑𑇑𑇘𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑇀𑆮𑆫𑆾 𑆔𑆾𑆫𑆂 𑆱 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆱𑆶𑆢𑆶𑆂𑆱𑆲𑆂𑇅 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆪𑆠𑇀𑆠𑆱𑇀𑆪 𑆠𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇑𑇙𑇆
𑆖𑆴𑆠𑇀𑆠𑆾𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆯𑆫𑆵𑆫𑆳𑆟𑆳𑆩𑆫𑇀𑆠𑆪𑆾𑇁𑆤𑇀𑆪𑆳𑆯𑇀𑆖 𑆤𑆽𑆑𑆯𑆂𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆁 𑆠𑇀𑆮𑆨𑆴𑆖𑆳𑆫𑆱𑇀𑆪 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆯𑆳𑆥𑆱𑇀𑆪 𑆖𑆽𑆮 𑆲𑆴𑇆𑇑𑇒𑇐𑇆
𑆱𑇀𑆮𑆪𑆁 𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳𑇁𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆥𑇀𑆫𑆯𑆩𑆼𑆤 𑆮𑆳𑇅 𑆮𑆽𑆮𑆴𑆣𑇀𑆪𑆳𑆢𑆨𑆴𑆖𑆳𑆫𑆱𑇀𑆪 𑆯𑆳𑆥𑆱𑇀𑆪 𑆖 𑆠𑆢𑆳𑆠𑇀𑆩𑆑𑆼𑇆𑇑𑇒𑇑𑇆
𑆪𑆡𑆳𑆑𑆫𑇀𑆩𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆩𑇀𑇅 𑆣𑇀𑆪𑆳𑆤𑆤𑆴𑆂𑆯𑇀𑆮𑆳𑆱𑆧𑆲𑆶𑆬𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆑𑆳𑆩𑆘𑇀𑆮𑆫𑆼 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇒𑇒𑇆
𑆯𑆾𑆑𑆘𑆼 𑆧𑆳𑆰𑇀𑆥𑆧𑆲𑆶𑆬𑆁 𑆠𑇀𑆫𑆳𑆱𑆥𑇀𑆫𑆳𑆪𑆁 𑆨𑆪𑆘𑇀𑆮𑆫𑆼𑇅 𑆑𑇀𑆫𑆾𑆣𑆘𑆼 𑆧𑆲𑆶𑆱𑆁𑆫𑆩𑇀𑆨𑆁 𑆨𑆷𑆠𑆳𑆮𑆼𑆯𑆼 𑆠𑇀𑆮𑆩𑆳𑆤𑆶𑆰𑆩𑇀𑇆𑇑𑇒𑇓𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆩𑆾𑆲𑆩𑆢𑆓𑇀𑆬𑆳𑆤𑆴𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆮𑆴𑆰𑆱𑆩𑇀𑆨𑆮𑆼𑇅 𑆑𑆼𑆰𑆳𑆚𑇀𑆖𑆴𑆢𑆼𑆰𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆱𑆤𑇀𑆠𑆳𑆥𑆾 𑆘𑆳𑆪𑆠𑆼 𑆥𑆶𑆫𑆂𑇆𑇑𑇒𑇔𑇆
𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆠𑆶𑆬𑇀𑆪𑆁 𑆠𑆶 𑆑𑆼𑆰𑆳𑆚𑇀𑆖𑆴𑆢𑆼𑆰𑆶 𑆑𑆳𑆩𑆘𑇀𑆮𑆫𑆳𑆢𑆴𑆰𑆶𑇅 𑆑𑆳𑆩𑆳𑆢𑆴𑆘𑆳𑆤𑆳𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆘𑇀𑆮𑆫𑆳𑆟𑆳𑆁 𑆪𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆟𑆩𑇀𑇆𑇑𑇒𑇕𑇆
𑆑𑆳𑆩𑆳𑆢𑆴𑆘𑆳𑆤𑆳𑆁 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆥𑆴 𑆠𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇅 𑆩𑆤𑆱𑇀𑆪𑆨𑆴𑆲𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆑𑆳𑆩𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆤 𑆠𑆡𑆳 𑆧𑆬𑆩𑇀𑇆𑇑𑇒𑇖𑇆
𑆘𑇀𑆮𑆫𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆮𑆳𑆠𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆢𑆼𑆲𑆾 𑆪𑆳𑆮𑆤𑇀𑆤 𑆢𑆷𑆰𑇀𑆪𑆠𑆴𑇅 𑆢𑆼𑆲𑆼 𑆖𑆳𑆨𑆴𑆲(𑆢𑇀𑆫𑆶)𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆳𑆠𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆤 𑆠𑆡𑆳 𑆧𑆬𑆩𑇀𑇆𑇑𑇒𑇗𑇆
𑆘𑇀𑆮𑆫𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆑𑆳𑆩𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆩𑆤𑆾 𑆪𑆳𑆮𑆤𑇀𑆤 𑆢𑆷𑆰𑇀𑆪𑆠𑆴𑇅𑇑𑇒𑇘𑇅 𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆑𑆼𑆮𑆬𑆳𑆂 𑆥𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆴𑆘𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆬𑆑𑇀𑆰𑆟𑆳𑆂𑇆𑇑𑇒𑇘𑇆
𑆲𑆼𑆠𑇀𑆮𑆿𑆰𑆣𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆓𑆤𑇀𑆠𑆮𑆾 𑆘𑇀𑆮𑆫𑆳𑆂𑇅𑇑𑇒𑇙𑇅 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆠𑆴𑆠𑆳𑆂 𑆥𑆸𑆡𑆓𑇀𑆮𑆳 𑆑𑆶𑆥𑆴𑆠𑆳 𑆩𑆬𑆳𑆂𑇆𑇑𑇒𑇙𑇆
𑆫𑆱𑆳𑆒𑇀𑆪𑆁 𑆣𑆳𑆠𑆶𑆩𑆤𑇀𑆮𑆼𑆠𑇀𑆪 𑆥𑆑𑇀𑆠𑆴𑆁 𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑇀𑆤𑆴𑆫𑆱𑇀𑆪 𑆖𑇅 𑆱𑇀𑆮𑆼𑆤 𑆠𑆼𑆤𑆾𑆰𑇀𑆩𑆟 𑆖𑆽𑆮 𑆑𑆸𑆠𑇀𑆮𑆳 𑆢𑆼𑆲𑆾𑆰𑇀𑆩𑆟𑆾 𑆧𑆬𑆩𑇀𑇆𑇑𑇓𑇐𑇆
𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆂 𑆑𑆼𑆮𑆬𑆁 𑆢𑆼𑆲𑆩𑆶𑆬𑇀𑆧𑆟𑆳𑆂𑇅 𑆱𑆤𑇀𑆠𑆳𑆥𑆩𑆣𑆴𑆑𑆁 𑆢𑆼𑆲𑆼 𑆘𑆤𑆪𑆤𑇀𑆠𑆴 𑆤𑆫𑆱𑇀𑆠𑆢𑆳𑇆𑇑𑇓𑇑𑇆
𑆨𑆮𑆠𑇀𑆪𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆾 𑆘𑇀𑆮𑆫𑆴𑆠𑆱𑇀𑆠𑆼𑆤 𑆖𑆾𑆖𑇀𑆪𑆠𑆼𑇅𑇑𑇓𑇒𑇅 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆁 𑆤𑆳 𑆤𑆳𑆣𑆴𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇑𑇓𑇒𑇆

𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆑𑆛𑆷𑆰𑇀𑆟𑆳𑆁𑆯𑇀𑆖 𑆫𑆱𑆳𑆤𑇀 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆧𑆸𑆁𑆲𑆴𑆠𑆳𑆤𑇀𑇅 𑆬𑆳𑆮𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆴𑆢𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆮𑆫𑇀𑆠𑆑𑆳𑆤𑆳𑆁 𑆖 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇖𑇖𑇆
𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆁 𑆱𑆪𑆮𑆁 𑆱𑆑𑆶𑆬𑆠𑇀𑆡𑆁 𑆱𑆤𑆳𑆓𑆫𑆩𑇀𑇅 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆾𑆥𑆼𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆳𑆘𑆁 𑆫𑆱𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇖𑇗𑇆
𑆠𑆼𑆤 𑆰𑆝𑇀𑆮𑆴𑆤𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑆵𑆤𑆱𑆳𑆢𑆪𑆂𑇅 𑆩𑆷𑆬𑆑𑆳𑆤𑆳𑆁 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆪𑆷𑆰𑆽𑆫𑇀𑆮𑆳 𑆱𑆷𑆥𑆑𑆬𑇀𑆥𑆴𑆠𑆽𑆂 𑇆𑇖𑇘𑇆
𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆯𑆳𑆬𑇀𑆪𑆤𑇀𑆤𑆽𑆫𑇀𑆪𑆡𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇅 𑆥𑆴𑆧𑆼𑆠𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆮𑆳𑆫𑆶𑆟𑇀𑆪𑆳 𑆘𑆬𑆁 𑆮𑆳 𑆥𑆳𑆚𑇀𑆖𑆩𑆷𑆬𑆴𑆑𑆩𑇀𑇆𑇖𑇙𑇆
𑆣𑆳𑆤𑇀𑆪𑆤𑆳𑆓𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆠𑆳𑆩𑆬𑆑𑇀𑆪𑆳𑇁𑆡𑆮𑆳 𑆯𑆸𑆠𑆩𑇀𑇅 𑆥𑆫𑇀𑆟𑆴𑆤𑆵𑆨𑆴𑆯𑇀𑆖𑆠𑆱𑆸𑆨𑆴𑆱𑇀𑆠𑆼𑆤 𑆖𑆳𑆤𑇀𑆤𑆳𑆤𑆴 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇗𑇐𑇆
𑆑𑆸𑆯𑆫𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆩𑆳𑆰𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆮𑆥𑆳𑆪𑆱𑆽𑆂𑇅 𑆱𑆕𑇀𑆑𑆫𑆱𑇀𑆮𑆼𑆢𑆮𑆴𑆣𑆴𑆤𑆳 𑆑𑆟𑇀𑆜𑆁 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆩𑆶𑆫𑆂 𑆯𑆴𑆫𑆂𑇆𑇗𑇑𑇆
𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀 𑆥𑆠𑇀𑆫𑆨𑆕𑇀𑆓𑆼𑆟 𑆯𑆴𑆫𑆯𑇀𑆖 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆧𑆬𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆩𑆣𑆶𑆑𑆯𑆸𑆠𑆽𑆫𑇀𑆮𑆳 𑆮𑆳𑆫𑆴𑆨𑆴𑆂 𑆱𑆶𑆒𑆽𑆂𑇆𑇗𑇒𑇆
𑆧𑆱𑇀𑆠𑆩𑆠𑇀𑆱𑇀𑆪𑆯𑆴𑆫𑆾𑆨𑆴𑆫𑇀𑆮𑆳 𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆑𑆟𑇀𑆜𑆼 𑆯𑆴𑆫𑆱𑆴 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆖 𑆥𑆪𑆾𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆮𑆳𑆠𑆴𑆑𑆽𑆂𑇆𑇗𑇓𑇆
𑆐𑆢𑆑𑆳𑆤𑆷𑆥𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆱𑆬𑆴𑆬𑆁 𑆥𑆳𑆚𑇀𑆖𑆩𑆷𑆬𑆴𑆑𑆩𑇀𑇅 𑆱𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆫𑆤𑆳𑆬𑆁 𑆮𑆳 𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇗𑇔𑇆
𑆐𑆢𑆑𑆳𑆤𑆷𑆥𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆩𑆶𑆥𑆤𑆳𑆲𑆳𑆂 𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆂𑇅 𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆖𑆠𑆶𑆂𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆯𑆴𑆫𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆁𑆱𑆯𑆷𑆬𑆴𑆤𑆳𑆩𑇀𑇆𑇗𑇖𑇆
𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳 𑆱𑆩𑆣𑆶𑆑𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆓𑆫𑆖𑆤𑇀𑆢𑆤𑆼𑇅 𑆄𑆬𑆼𑆥𑆤𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆔𑆸𑆠𑆁 𑆯𑆴𑆫𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆁𑆱𑆯𑆷𑆬𑆤𑆶𑆠𑇀𑇆𑇗𑇗𑇆
𑆧𑆬𑆳 𑆫𑆳𑆱𑇀𑆤𑆳 𑆠𑆴𑆬𑆳𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆑𑆁 𑆤𑆵𑆬𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀𑇅 𑆥𑆬𑆕𑇀𑆑𑆰𑆳 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖𑆤𑇀𑆢𑆤𑆁 𑆑𑆼𑆯𑆫𑆁 𑆔𑆸𑆠𑆩𑇀𑇆𑇗𑇘𑇆
𑆮𑆵𑆫𑆳 𑆧𑆬𑆳 𑆮𑆴𑆢𑆳𑆫𑆵 𑆖 𑆑𑆸𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆳 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑇅 𑆯𑆠𑆳𑆮𑆫𑆵 𑆥𑆪𑆱𑇀𑆪𑆳 𑆖 𑆑𑆠𑇀𑆠𑆸𑆟𑆁 𑆩𑆣𑆶𑆑𑆁 𑆔𑆸𑆠𑆩𑇀𑇆𑇗𑇙𑇆
𑆖𑆠𑇀𑆮𑆳𑆫 𑆍𑆠𑆼 𑆯𑇀𑆬𑆾𑆑𑆳𑆫𑇀𑆣𑆽𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂𑇅 𑆯𑆱𑇀𑆠𑆳𑆂 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆯𑆴𑆫𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆁𑆱𑆯𑆷𑆬𑆴𑆤𑆳𑆩𑇀𑇆𑇘𑇐𑇆
𑆤𑆳𑆮𑆤𑆁 𑆣𑆷𑆩𑆥𑆳𑆤𑆳𑆤𑆴 𑆱𑇀𑆤𑆼𑆲𑆳𑆯𑇀𑆖𑆿𑆠𑇀𑆠𑆫𑆨𑆑𑇀𑆠𑆴𑆑𑆳𑆂𑇅 𑆠𑆽𑆬𑆳𑆤𑇀𑆪𑆨𑇀𑆪𑆕𑇀𑆓𑆪𑆾𑆓𑆵𑆤𑆴 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆠𑆡𑆳 𑆥𑆫𑆩𑇀𑇆𑇘𑇑𑇆
𑆯𑆸𑆕𑇀𑆓𑆳𑆬𑆳𑆧𑆶𑆘𑆬𑆿𑆑𑆾𑆨𑆴𑆂 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆁 𑆮𑇀𑆪𑆣𑆤𑆼𑆤 𑆮𑆳𑇅 𑆯𑆴𑆫𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆁𑆱𑆯𑆷𑆬𑆼𑆰𑆶 𑆫𑆶𑆣𑆴𑆫𑆁 𑆠𑆱𑇀𑆪 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀𑇆𑇘𑇒𑇆
𑆥𑇀𑆫𑆢𑆼𑆲𑆂 𑆱𑆔𑆸𑆠𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆂 𑆥𑆢𑇀𑆩𑆑𑆾𑆯𑆵𑆫𑆖𑆤𑇀𑆢𑆤𑆽𑆂𑇅 𑆢𑆷𑆫𑇀𑆮𑆳𑆩𑆣𑆶𑆑𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆑𑆼𑆯𑆫𑆽𑆫𑇀𑆮𑆳 𑆔𑆸𑆠𑆳𑆥𑇀𑆬𑆶𑆠𑆽𑆂𑇆𑇘𑇓𑇆
𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑇀𑆝𑆵𑆥𑆢𑇀𑆩𑆑𑆼𑆯𑆫𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀 𑇅 𑆑𑆯𑆼𑆫𑆶𑆑𑆳𑆂 𑆥𑆪𑆱𑇀𑆪𑆳 𑆖 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆁 𑆥𑇀𑆫𑆬𑆼𑆥𑆤𑆩𑇀𑇆𑇘𑇔𑇆
𑆖𑆤𑇀𑆢𑆤𑆳𑆢𑇀𑆪𑆼𑆤 𑆠𑆽𑆬𑆼𑆤 𑆯𑆠𑆣𑆿𑆠𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆂, 𑆥𑆪𑆱𑆳 𑆱𑆼𑆑𑆂 𑆯𑆱𑇀𑆠𑆯𑇀𑆖 𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇆𑇘𑇕𑇆
𑆩𑆳𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆼𑆟 𑆱𑆶𑆯𑆵𑆠𑆼𑆤 𑆖𑆤𑇀𑆢𑆤𑆳𑆢𑆴𑆯𑆸𑆠𑆼𑆤 𑆮𑆳𑇅 𑆥𑆫𑆴𑆰𑆼𑆑𑆂 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪 𑆅𑆠𑆴 𑆱𑆁𑆯𑆩𑆤𑆵 𑆑𑇀𑆫𑆴𑆪𑆳𑇆𑇘𑇖𑇆
𑆢𑆾𑆰𑆳𑆣𑆴𑆑𑆳𑆤𑆳𑆁 𑆮𑆩𑆤𑆁 𑆯𑆱𑇀𑆪𑆠𑆼 𑆱𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆁 𑆱𑆱𑇀𑆤𑆼𑆲𑆁 𑆪𑆤𑇀𑆤 𑆑𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇘𑇗𑇆
𑆯𑆾𑆰𑆵 𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆫𑆁𑆱𑆤𑆳𑆢𑆥𑆴𑇅 𑆃𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆵𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆴𑆁 𑆥𑆶𑆤𑆫𑇀𑆪𑆾 𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼𑇆𑇘𑇘𑇆

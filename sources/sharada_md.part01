𑆠𑇀𑆫𑆴𑆰𑆶 𑆱𑇀𑆡𑆴𑆠𑆾𑆬𑇀𑆥𑆂 𑆥𑆛𑆬𑆼𑆰𑆶 𑆢𑆾𑆰𑆾 𑆤𑆑𑇀𑆠𑆳𑆤𑇀𑆣𑇀𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑆥𑇀𑆫𑆱𑆲𑇀𑆪 𑇅 𑆢𑆴𑆮𑆳 𑆱 𑆱𑆷𑆫𑇀𑆪𑆳𑆤𑆶𑆓𑆸𑆲𑆵𑆠𑆖𑆑𑇀𑆰𑆶𑆫𑆴𑆑𑇀𑆰𑆼𑆠 𑆫𑆷𑆥𑆳𑆟𑆴 𑆑𑆦𑆳𑆬𑇀𑆥𑆨𑆳𑆮𑆳𑆠𑇀 𑇆𑇓𑇘𑇆
𑆯𑆾𑆑𑆘𑇀𑆮𑆫𑆳𑆪𑆳𑆱𑆯𑆴𑆫𑆾𑆨𑆴𑆠𑆳𑆥𑆽𑆫𑆨𑇀𑆪𑆳𑆲𑆠𑆳 𑆪𑆱𑇀𑆪 𑆤𑆫𑆱𑇀𑆪 𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑇅 𑆱𑆣𑆷𑆩𑆑𑆳𑆤𑇀 𑆥𑆯𑇀𑆪𑆠𑆴 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆳𑆁𑆱𑇀𑆠𑆁 𑆣𑆷𑆩𑆢𑆫𑇀𑆯𑆵𑆠𑆴 𑆮𑆢𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆩𑇀 𑇆𑇓𑇙𑇆
𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆠𑆱𑇀𑆠𑆠𑇀𑆫 𑆯𑆴𑆫𑆾𑆨𑆴𑆠𑆳𑆥𑆳𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆱𑇀𑆠𑇀𑆮𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆽𑆯𑇀𑆖 𑇅𑇔𑇓𑇅 𑆱𑆶𑆫𑆫𑇀𑆰𑆴𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆩𑆲𑆾𑆫𑆓𑆳𑆟𑆳𑆁 𑆱𑆤𑇀𑆢𑆫𑇀𑆯𑆤𑆼𑆤𑆳𑆥𑆴 𑆖 𑆨𑆳𑆱𑇀𑆮𑆫𑆳𑆟𑆳𑆩𑇀 𑇆𑇔𑇓𑇆
𑆲𑆤𑇀𑆪𑆼𑆠 𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑇀𑆩𑆤𑆶𑆘𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆱 𑆬𑆴𑆕𑇀𑆓𑆤𑆳𑆯𑆱𑇀𑆠𑇀𑆮𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑇅 𑆠𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴 𑆮𑆴𑆱𑇀𑆥𑆰𑇀𑆛𑆩𑆴𑆮𑆳𑆮𑆨𑆳𑆠𑆴 𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆮𑆫𑇀𑆟𑆳 𑆮𑆴𑆩𑆬𑆳 𑆖 𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑇆𑇔𑇔𑇆
𑆮𑆴𑆢𑆵𑆫𑇀𑆪𑆠𑆼 𑆱𑆵𑆢𑆠𑆴 𑆲𑆵𑆪𑆠𑆼 𑆮𑆳 𑆤𑆸𑆟𑆳𑆩𑆨𑆵𑆔𑆳𑆠𑆲𑆠𑆳 𑆠𑆶 𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑇆𑇔𑇕𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆤𑆪𑆤𑆓𑆠𑆳 𑆩𑆪𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑆥𑆸𑆡𑆓𑆴𑆲 𑆰𑆛𑇀 𑆖 𑆱𑆥𑇀𑆠𑆠𑆴𑆯𑇀𑆖 𑇅 𑆍𑆠𑆼𑆰𑆳𑆁 𑆥𑆸𑆡𑆓𑆴𑆲 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆱𑆫𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆼𑇁𑆲𑆁 𑆠𑆢𑆤𑆶 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆪𑆡𑆳𑆮𑆠𑇀 𑇆𑇔𑇖𑇆
𑆃𑆡𑆳𑆠𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 (𑆱𑆶𑆯𑇀𑆫𑆶𑆠𑆳𑆪) 𑇆𑇒𑇆
𑆰𑆛𑇀𑆱𑆥𑇀𑆠𑆠𑆴𑆫𑇀𑆪𑆼𑇁𑆨𑆴𑆲𑆴𑆠𑆳 𑆮𑇀𑆪𑆳𑆣𑆪𑆾 𑆤𑆳𑆩𑆬𑆑𑇀𑆰𑆟𑆽𑆂 𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆴𑆢𑆁 𑆠𑆼𑆰𑆳𑆁 𑆱𑆩𑆳𑆱𑆮𑇀𑆪𑆳𑆱𑆠𑆂 𑆯𑆸𑆟𑆶 𑇆𑇓𑇆
𑆗𑆼𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆼𑆰𑆶 𑆢𑆯𑆽𑆑𑆯𑇀𑆖 𑆤𑆮 𑆬𑆼𑆒𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆨𑆼𑆢𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆮𑇀𑆪𑆣𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖𑆢𑆯𑆽𑆮 𑆠𑆶 𑇆𑇔𑇆
𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑇁𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆳𑆥𑇀𑆪𑆳𑆂 𑆱𑆥𑇀𑆠 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆫𑆾𑆓𑆳 𑆮𑆫𑇀𑆘𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆢𑆯 𑆥𑆚𑇀𑆖 𑆖 𑆘𑆳𑆤𑆠𑆳 𑇅 𑆃𑆱𑆳𑆣𑇀𑆪𑆿 𑆮𑆳 𑆨𑆮𑆼𑆠𑆳𑆁 𑆠𑆶 𑆪𑆳𑆥𑇀𑆪𑆿 𑆖𑆳𑆓𑆤𑇀𑆠𑆶𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆿 𑇆𑇕𑇆
𑆃𑆫𑇀𑆯𑆾𑇁𑆤𑇀𑆮𑆴𑆠𑆁 𑆨𑆮𑆠𑆴 𑆮𑆫𑇀𑆠𑇀𑆩 𑆠𑆶 𑆪𑆠𑇀𑆠𑆡𑆳𑇁𑆫𑇀𑆯𑆂 𑆯𑆶𑆰𑇀𑆑𑆁 𑆠𑆡𑆳𑇁𑆫𑇀𑆧𑆶𑆢𑆩𑆡𑆾 𑆥𑆴𑆝𑆑𑆳𑆂 𑆱𑆴𑆫𑆳𑆘𑆳𑆂 𑇅 𑆘𑆳𑆬𑆁 𑆱𑆴𑆫𑆳𑆘𑆩𑆥𑆴 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆠𑆡𑆳𑇁𑆫𑇀𑆩 𑆗𑆼𑆢𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆱𑆲 𑆥𑆫𑇀𑆮𑆟𑆴𑆑𑆳𑆩𑆪𑆼𑆤 𑇆𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆳𑆠𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑆶𑆫𑆳𑆟𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆿 𑆱𑇀𑆪𑆤𑇀𑆢𑆳𑆣𑆵𑆩𑆤𑇀𑆡𑆥𑆵𑆝𑆴𑆠𑆿 𑇅 𑆱𑇀𑆮𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆤𑇀𑆪𑆳𑆪𑆁 𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆼𑆟 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇓𑇆
𑆨𑆴𑆰𑆑𑇀 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆼𑆢𑆼𑆠𑆳𑆮𑆶𑆥𑆤𑆳𑆲𑆽𑆯𑇀𑆖 𑆥𑆷𑆘𑆴𑆠𑆽𑆂 𑇅 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆫𑆱𑆽𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆂 𑆦𑆬𑆫𑆱𑆳𑆤𑇀𑆮𑆴𑆠𑆽𑆂 𑇆𑇗𑇆
𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆽𑆂 𑆥𑆪𑆾𑆨𑆴𑆯𑇀𑆖 𑆠𑆪𑆾𑆫𑆳𑆲𑆳𑆫 𑆅𑆰𑇀𑆪𑆠𑆼 𑇅 𑆠𑆡𑆳 𑆖𑆾𑆥𑆫𑆴 𑆨𑆑𑇀𑆠𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆂𑆥𑆳𑆤𑆁(𑆤𑆼)𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇘𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑇀𑆮𑆳𑆡𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑆼𑆮𑆬𑆁 𑆘𑆵𑆫𑇀𑆟𑆩𑆼𑆮 𑆮𑆳 𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳𑆠𑆲𑆫𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑇀𑆫𑆡𑆩𑆼𑆤 𑆓𑆟𑆼𑆤 𑆮𑆳 𑇆𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆱𑇀𑆠𑆽𑆬𑆳𑆢𑇀𑆮𑆴𑆤𑆳 𑆱𑆴𑆢𑇀𑆣𑆳 𑆮𑆳𑆠𑆔𑇀𑆤𑆽𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆼 𑆲𑆴𑆠𑆳𑆂 𑇅 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆂 𑆥𑆶𑆛𑆥𑆳𑆑𑆯𑇀𑆖 𑆣𑆷𑆩𑆾 𑆤𑆱𑇀𑆪𑆁 𑆖 𑆠𑆢𑇀𑆮𑆴𑆣𑆩𑇀 𑇆𑇑𑇐𑇆
𑆤𑆱𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆱𑇀𑆡𑆴𑆫𑆳𑆑𑇀𑆰𑆵𑆫𑆩𑆣𑆶𑆫𑆽𑆱𑇀𑆠𑆽𑆬𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆍𑆫𑆟𑇀𑆝𑆥𑆬𑇀𑆬𑆮𑆼 𑆩𑆷𑆬𑆼 𑆠𑇀𑆮𑆖𑆴 𑆮𑆳𑇁𑇁𑆘𑆁 𑆥𑆪𑆂 𑆯𑆸𑆠𑆩𑇀 𑇆𑇑𑇑𑇆
𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆩𑆷𑆬𑆼𑆰𑆶 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆱𑆼𑆖𑆤𑆼 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆱𑆽𑆤𑇀𑆣𑆮𑆾𑆢𑆵𑆖𑇀𑆪𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆨𑆴𑆂 𑆯𑆸𑆠𑆁 𑆥𑆪𑆂 𑇆𑇑𑇒𑇆

𑆑𑆬𑇀𑆥𑆪𑆼𑆤𑇀𑆤𑆴𑆫𑇀𑆓𑆠𑆁 𑆯𑆶𑆰𑇀𑆑𑇀𑆫𑆁 𑆮𑇀𑆫𑆟𑆳𑆤𑇀𑆠𑆼𑇁𑆱𑇀𑆡𑆴 𑆱𑆩𑆳𑆲𑆴𑆠𑆂 𑇅 𑆱𑆤𑇀𑆣𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑆮𑇀𑆫𑆟𑆼 𑆮𑇀𑆫𑆟𑆨𑆓𑇀𑆤𑆮𑆠𑇀 𑇆𑇕𑇓𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆑𑆳𑆪𑆼 𑆠𑆶 𑆨𑆓𑇀𑆤𑆳𑆤𑆳𑆁 𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑇀𑆪𑆁 𑆑𑆫𑇀𑆟𑆥𑆷𑆫𑆟𑆩𑇀 𑇅 𑆔𑆸𑆠𑆥𑆳𑆤𑆁 𑆲𑆴𑆠𑆁 𑆤𑆱𑇀𑆪𑆁 𑆥𑇀𑆫𑆯𑆳𑆒𑆳𑆱𑇀𑆮𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇕𑇔𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆠𑆽𑆬𑆁 𑆨𑆓𑇀𑆤𑆥𑇀𑆫𑆱𑆳𑆣𑆑𑆩𑇀 𑇅 𑆫𑆳𑆠𑇀𑆫𑆿 𑆫𑆳𑆠𑇀𑆫𑆿 𑆠𑆴𑆬𑆳𑆤𑇀 𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑇀 𑆮𑆳𑆱𑆪𑆼𑆢𑆱𑇀𑆡𑆴𑆫𑆼 𑆘𑆬𑆼 𑇆𑇕𑇕𑇆
𑆢𑆴𑆮𑆳 𑆢𑆴𑆮𑆳 𑆯𑆾𑆰𑆪𑆴𑆠𑇀𑆮𑆳 𑆓𑆮𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇅 𑆠𑆸𑆠𑆵𑆪𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆠𑆶 𑆨𑆳𑆮𑆪𑆼𑆤𑇀𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇆𑇕𑇖𑇆
𑆠𑆠𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆶𑆤𑆂 𑆥𑆵𑆠𑆳𑆤𑇀 𑆱𑆶𑆯𑆶𑆰𑇀𑆑𑆳𑆁𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇅 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆁 𑆱𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆁 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆁 𑆱𑆳𑆫𑆴𑆮𑆳𑆁 𑆠𑆡𑆳 𑇆𑇕𑇗𑇆
𑆑𑆶𑆰𑇀𑆜𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆁 𑆩𑆳𑆁𑆱𑆵𑆁 𑆱𑆶𑆫𑆢𑆳𑆫𑆶 𑆱𑆖𑆤𑇀𑆢𑆤𑆩𑇀 𑇅 𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆁 𑆖 𑆱𑆚𑇀𑆖𑆷𑆫𑇀𑆟𑇀𑆪 𑆠𑆴𑆬𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇕𑇘𑇆
𑆥𑆵𑆝𑆤𑆳𑆫𑇀𑆡𑆁 𑆖 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆯𑆸𑆠𑆁 𑆥𑆪𑆂 𑇅 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑆤 𑆥𑆪𑆱𑆳 𑆠𑆠𑇀𑆠𑆽𑆬𑆁 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇕𑇙𑇆
𑆍𑆬𑆳𑆩𑆁𑆯𑆶𑆩𑆠𑆵𑆁 𑆥𑆠𑇀𑆫𑆁 𑆘𑆵𑆮𑆑𑆁 𑆠𑆓𑆫𑆁 𑆠𑆡𑆳 𑇅 𑆫𑆾𑆣𑇀𑆫𑆁 𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆖 𑆠𑆡𑆳 𑆑𑆳𑆬𑆳𑆤𑆶𑆱𑆳𑆫𑆴(𑆮𑆳)𑆟𑆩𑇀 𑇆𑇖𑇐𑇆
𑆱𑆽𑆫𑆼𑆪𑆑𑆁 𑆑𑇀𑆰𑆵𑆫𑆯𑆶𑆑𑇀𑆬𑆳𑆩𑆤𑆤𑇀𑆠𑆳𑆁 𑆱𑆩𑆣𑆷𑆬𑆴𑆑𑆳𑆩𑇀 𑇅 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆁 𑆖𑆽𑆮 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆿𑆰𑆣𑆳𑆤𑆴 𑆖 𑇆𑇖𑇑𑇆
𑆍𑆨𑆴𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆥𑆖𑆼𑆠𑇀𑆠𑆽𑆬𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆤𑇀𑆩𑆸𑆢𑆶𑆤𑆳𑇁𑆓𑇀𑆤𑆴𑆤𑆳 𑇅 𑆍𑆠𑆠𑇀𑆠𑆽𑆬𑆁 𑆱𑆢𑆳 𑆥𑆡𑇀𑆪𑆁 𑆨𑆓𑇀𑆤𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆱𑆶 𑇆𑇖𑇒𑇆
𑆄𑆑𑇀𑆰𑆼𑆥𑆑𑆼 𑆥𑆑𑇀𑆰𑆔𑆳𑆠𑆼 𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆼 𑆠𑆡𑆳𑇁𑆫𑇀𑆢𑆴𑆠𑆼 𑇅 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆼 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆼 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆼 𑆲𑆤𑆶𑆓𑇀𑆫𑆲𑆼 𑇆𑇖𑇓𑇆
𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆼 𑆠𑆴𑆩𑆴𑆫𑆼 𑆖𑆽𑆮 𑆪𑆼 𑆖 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆑𑇀𑆰𑆪𑆁 𑆓𑆠𑆳𑆂 𑇅 𑆥𑆡𑇀𑆪𑆁 𑆥𑆳𑆤𑆼 𑆠𑆡𑆳𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆤𑆱𑇀𑆪𑆼 𑆧𑆱𑇀𑆠𑆴𑆰𑆶 𑆨𑆾𑆘𑆤𑆼 𑇆𑇖𑇔𑇆
𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆑𑆤𑇀𑆣𑆾𑆫𑆱𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑆩𑆶𑆤𑆽𑆮𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇅 𑆩𑆶𑆒𑆁 𑆖 𑆥𑆢𑇀𑆩𑆥𑇀𑆫𑆠𑆴𑆩𑆁 𑆱𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆱𑆩𑆵𑆫𑆟𑆩𑇀 𑇆𑇖𑇕𑇆
𑆓𑆤𑇀𑆣𑆠𑆽𑆬𑆩𑆴𑆢𑆁 𑆤𑆳𑆩𑇀𑆤𑆳 𑆱𑆫𑇀𑆮𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀 𑇅 𑆫𑆳𑆘𑆳𑆫𑇀𑆲𑆩𑆼𑆠𑆠𑇀 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁 𑆫𑆳𑆘𑇀𑆚𑆳𑆩𑆼𑆮 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆽𑆂 𑇆𑇖𑇖𑇆
𑆠𑇀𑆫𑆥𑆶𑆱𑆳𑆑𑇀𑆰𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆳𑆤𑆳𑆁 𑆠𑆽𑆬𑆳𑆤𑆴 𑆩𑆣𑆶𑆫𑆽𑆂 𑆱𑆲 𑇅 𑆮𑆱𑆳𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆬𑆳𑆨𑆁 𑆑𑇀𑆰𑆵𑆫𑆼 𑆢𑆯𑆓𑆶𑆟𑆼 𑆥𑆖𑆼𑆠𑇀 𑇆𑇖𑇗𑇆
𑆱𑇀𑆤𑆼𑆲𑆾𑆠𑇀𑆠𑆩𑆩𑆴𑆢𑆁 𑆖𑆳𑆯𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆓𑇀𑆤𑆥𑇀𑆫𑆱𑆳𑆣𑆤𑆩𑇀 𑇅 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆤𑆱𑇀𑆪𑆼𑆰𑆶 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆟𑆴 𑆱𑆼𑆖𑆤𑆼 𑇆𑇖𑇘𑇆
𑆨𑆓𑇀𑆤𑆁 𑆤𑆽𑆠𑆴 𑆪𑆡𑆳𑆥𑆳𑆑𑆁 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑆠𑆡𑆳 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆥𑆑𑇀𑆮𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶 𑆠𑆢𑇀𑆣𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑇆𑇖𑇙𑇆
𑆨𑆓𑇀𑆤𑆁 𑆱𑆤𑇀𑆣𑆴𑆩𑆤𑆳𑆮𑆴𑆢𑇀𑆣𑆩𑆲𑆵𑆤𑆳𑆕𑇀𑆓𑆩𑆤𑆶𑆬𑇀𑆧𑆟𑆩𑇀 𑇅 𑆱𑆶𑆒𑆖𑆼𑆰𑇀𑆛𑆳𑆥𑇀𑆫𑆖𑆳𑆫𑆁 𑆖 𑆱𑆁𑆲𑆴𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇗𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆄𑆩𑆳𑆯𑆪𑆓𑆠𑆼 𑆮𑆳𑆠𑆼 𑆖𑇀𑆗𑆫𑇀𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆢𑆼𑆪𑆂 𑆰𑆝𑇀𑆣𑆫𑆟𑆾 𑆪𑆾𑆓𑆂 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇆𑇓𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆼 𑆥𑆳𑆜𑆳 𑆑𑆛𑆶𑆑𑆳𑇁𑆠𑆴𑆮𑆴𑆰𑆳𑇁𑆨𑆪𑆳 𑇅 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆾 𑆪𑆾𑆓𑆂 𑆰𑆝𑇀𑆣𑆫𑆟𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇔𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆓𑆠𑆼 𑆖𑆳𑆥𑆴 𑆢𑆼𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇅 𑆧𑆱𑇀𑆠𑆪𑆂 𑆯𑆾𑆣𑆤𑆵𑆪𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆳𑆯𑆳𑆯𑇀𑆖 𑆬𑆮𑆟𑆾𑆠𑇀𑆠𑆫𑆳𑆂 𑇆𑇕𑇆
𑆑𑆳𑆫𑇀𑆪𑆾 𑆧𑆱𑇀𑆠𑆴𑆓𑆠𑆼 𑆖𑆳𑆥𑆴 𑆮𑆴𑆣𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆯𑆾𑆣𑆤𑆂 𑇅𑇖𑇅 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆢𑆴𑆰𑆶 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆼 𑆑𑆳𑆫𑇀𑆪𑆯𑇀𑆖𑆳𑆤𑆴𑆬𑆲𑆳 𑆑𑇀𑆫𑆩𑆂 𑇆𑇖𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆥𑆤𑆳𑆲𑆳𑆯𑇀𑆖 𑆩𑆫𑇀𑆢𑆤𑆳𑆬𑆼𑆥𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆱𑆸𑆑𑇀𑆱𑆴𑆫𑆳𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆖𑆳𑆱𑆸𑆓𑇀𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇗𑇆
𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆤𑆳𑆲𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆧𑆤𑇀𑆣𑆤𑆾𑆤𑇀𑆩𑆫𑇀𑆢𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆪𑆳𑆮𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆂 𑇆𑇘𑇆
𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆼𑇁𑆱𑇀𑆡𑆤𑆴 𑆮𑆳 𑆮𑆳𑆪𑆿 𑆥𑆳𑆟𑆴𑆩𑆤𑇀𑆡𑆼𑆤 𑆢𑆳𑆫𑆴𑆠𑆼 𑇅 𑆤𑆳𑆝𑆵𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑆱𑇀𑆡𑆤𑆴 𑆨𑆴𑆰𑆑𑇀 𑆖𑆷𑆰𑆪𑆼𑆠𑇀𑆥𑆮𑆤𑆁 𑆧𑆬𑆵 𑇆𑇙𑇆
𑆯𑆶𑆑𑇀𑆫𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼𑇁𑆤𑆴𑆬𑆼 𑆑𑆳𑆫𑇀𑆪𑆁 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇅𑇑𑇐𑇅 𑆃𑆮𑆓𑆳𑆲𑆑𑆶𑆛𑆵𑆑𑆫𑇀𑆰𑆷𑆥𑇀𑆫𑆱𑇀𑆠𑆫𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂 𑇆𑇑𑇐𑇆
𑆘𑆪𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆘𑆁 𑆮𑆳𑆠𑆁 𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆽𑆯𑇀𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆍𑆑𑆳𑆕𑇀𑆓𑆓𑆁 𑆖 𑆩𑆠𑆴𑆩𑆳𑆚𑇀𑆗𑆸𑆕𑇀𑆓𑆽𑆯𑇀𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆁 𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆧𑆬𑆳𑆱𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆽𑆱𑇀𑆠𑆶 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆩𑆮𑆴𑆫𑆾𑆣𑆴𑆨𑆴𑆂 𑇅𑇑𑇒𑇅 𑆱𑆶𑆥𑇀𑆠𑆴𑆮𑆳𑆠𑆼 𑆠𑇀𑆮𑆱𑆸𑆕𑇀𑆩𑆾𑆑𑇀𑆰𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆶 𑆧𑆲𑆶𑆯𑆾 𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇒𑇆
𑆢𑆴𑆲𑇀𑆪𑆳𑆖𑇀𑆖 𑆬𑆮𑆟𑆳𑆓𑆳𑆫𑆣𑆷𑆩𑆽𑆱𑇀𑆠𑆽𑆬𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆽𑆂 𑇅 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆯𑆸𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆦𑆬𑆳𑆩𑇀𑆬𑆾 𑆫𑆱 𑆍𑆮 𑆖 𑇆𑇑𑇓𑇆
𑆱𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆣𑆳𑆤𑇀𑆪𑆪𑆷𑆰𑆾 𑆮𑆳 𑆲𑆴𑆠𑆾 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆂 𑆱𑆮𑆳𑆠𑆔𑇀𑆤𑆂 𑆱𑆫𑇀𑆮𑆳𑆩𑇀𑆬𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆶𑆠𑆂 𑇆𑇑𑇔𑇆
𑆠𑆼𑆤𑆾𑆥𑆤𑆳𑆲𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆱𑆫𑇀𑆮𑆢𑆳 𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀 𑇅 𑆑𑆶𑆚𑇀𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆫𑆶𑆘𑆳𑆫𑇀𑆠𑆁 𑆮𑆳 𑆓𑆳𑆠𑇀𑆫𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇆𑇑𑇖𑇆
𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆢𑇀𑆮𑆳 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆱𑆳𑆬𑇀𑆮𑆟𑆼𑆤𑆾𑆥𑆤𑆳𑆲𑆴𑆠𑆩𑇀 𑇅 𑆱𑇀𑆑𑆤𑇀𑆣𑆮𑆑𑇀𑆰𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆮𑆳𑆪𑆶𑆁 𑆩𑆤𑇀𑆪𑆳𑆓𑆠𑆁 𑆠𑆡𑆳 𑇆𑇑𑇘𑇆
𑆮𑆩𑆤𑆁 𑆲𑆤𑇀𑆠𑆴 𑆤𑆱𑇀𑆪𑆁 𑆖 𑆑𑆶𑆯𑆬𑆼𑆤 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆩𑇀 𑇅 𑆯𑆴𑆫𑆾𑆓𑆠𑆁 𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆲𑆤𑇀𑆠𑆴 𑆮𑆳𑇁𑆱𑆸𑆓𑇀𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇑𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆱𑆲𑆱𑇀𑆫𑆁 𑆠𑆶 𑆣𑆳𑆫𑆪𑆼𑆠𑇀𑆠𑆠𑇀𑆫 𑆪𑆾𑆓𑆠𑆂 𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆓𑆠𑆩𑆼𑆑𑆳𑆕𑇀𑆓𑆱𑇀𑆡𑆴𑆠𑆁 𑆮𑆳𑇁𑆥𑆴 𑆱𑆩𑆵𑆫𑆟𑆩𑇀 𑇆𑇒𑇐𑇆
𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆑𑆼𑆮𑆬𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆪𑆶𑆮𑆼𑆓𑆩𑆴𑆮𑆳𑆖𑆬𑆂 𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆡𑆳𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆾 𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇆𑇒𑇑𑇆
𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑆴𑆂 𑆯𑆴𑆫𑆂𑆱𑇀𑆤𑆼𑆲𑆾 𑆣𑆷𑆩𑆂 𑆱𑇀𑆤𑆽𑆲𑆴𑆑 𑆍𑆮 𑆖 𑇅 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆂 𑆱𑇀𑆤𑆼𑆲𑆓𑆟𑇀𑆝𑆷𑆰𑆾 𑆤𑆱𑇀𑆪𑆁 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆩𑆼𑆮 𑆖 𑇆𑇒𑇒𑇆
𑆫𑆱𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆴 𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀𑆮𑆴𑆠𑆁 𑆖 𑆪𑆠𑇀 𑇅 𑆨𑆾𑆘𑆤𑆳𑆤𑆴 𑆦𑆬𑆳𑆩𑇀𑆬𑆳𑆤𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖 𑇆𑇒𑇓𑇆
𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆳𑆯𑇀𑆖 𑆥𑆫𑆵𑆰𑆼𑆑𑆳𑆱𑇀𑆠𑆡𑆳 𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆑𑆶𑆕𑇀𑆑𑆶𑆩𑆳𑆓𑆶𑆫𑆶𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆑𑆶𑆰𑇀𑆜𑆽𑆬𑆳𑆠𑆓𑆫𑆳𑆟𑆴 𑆖 𑇆𑇒𑇔𑇆
𑆑𑆿𑆯𑆼𑆪𑆿𑆫𑇀𑆟𑆴𑆑𑆫𑆿𑆩𑆳𑆟𑆴 𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆳𑆤𑆴 𑆓𑆶𑆫𑆷𑆟𑆴 𑆖 𑇅 𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆠𑆡𑆳 𑆓𑆫𑇀𑆨𑆓𑆸𑆲𑆳𑆟𑆴 𑆖 𑇆𑇒𑇕𑇆
𑆩𑆸𑆢𑇀𑆮𑆵 𑆯𑆪𑇀𑆪𑆳𑇁𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆳𑆥𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆱𑆩𑆳𑆱𑆼𑆤𑆽𑆮𑆩𑆳𑆢𑆵𑆤𑆴 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑇀𑆪𑆤𑆴𑆬𑆫𑆾𑆓𑆴𑆰𑆶 𑇆𑇒𑇖𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑆤𑇀𑆠𑆵𑆱𑆶𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆵𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑆑𑇀𑆰𑆱𑆩𑆳𑆂 𑆨𑆳𑆓𑆳𑆂 , 𑆧𑆴𑆬𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆂 𑆑𑆬𑇀𑆑𑆱𑇀𑆠𑆴𑆬𑇀𑆮𑆑𑆩𑆷𑆬𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆪𑆾𑆂, 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆢𑆣𑆴𑆥𑆳𑆠𑇀𑆫𑆼 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼, 𑆔𑆸𑆠𑆥𑆳𑆠𑇀𑆫𑆩𑆼𑆑𑆁, 𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀; 𑆠𑆴𑆬𑇀𑆮𑆑𑆱𑆫𑇀𑆥𑆴𑆫𑆼𑆠𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆰𑆶 𑇅 𑆠𑆴𑆬𑇀𑆮𑆑𑆮𑆴𑆣𑆴𑆫𑆼𑆮𑆳𑆯𑆾𑆑𑆫𑆩𑇀𑆪𑆑𑆪𑆾𑆫𑇀𑆢𑇀𑆫𑆰𑇀𑆛𑆮𑇀𑆪𑆂 𑇆𑇒𑇗𑇆
𑆠𑆴𑆬𑆥𑆫𑆴𑆥𑆵𑆝𑆤𑆾𑆥𑆑𑆫𑆟𑆑𑆳𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑇀𑆪𑆳𑆤𑆬𑇀𑆥𑆑𑆳𑆬𑆁 𑆠𑆽𑆬𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑇀𑆪𑆟𑆷𑆤𑆴 𑆒𑆟𑇀𑆝𑆯𑆂 𑆑𑆬𑇀𑆥𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆮𑆑𑇀𑆰𑆶𑆢𑇀𑆪 𑆩𑆲𑆠𑆴 𑆑𑆛𑆳𑆲𑆼 𑆥𑆳𑆤𑆵𑆪𑆼𑆤𑆳𑆨𑆴𑆥𑇀𑆬𑆳𑆮𑇀𑆪 𑆑𑇀𑆮𑆳𑆡𑆪𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆩𑆩𑇀𑆧𑆶𑆥𑆸𑆰𑇀𑆜𑆳𑆢𑇀𑆪𑆢𑆶𑆢𑆼𑆠𑆴 𑆠𑆠𑇀 𑆱𑆫𑆑𑆥𑆳𑆟𑇀𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟𑆳𑆢𑆳𑆪 𑆮𑆳𑆠𑆔𑇀𑆤𑆿𑆰𑆣𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆑𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆍𑆠𑆢𑆟𑆶𑆠𑆽𑆬𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆰𑆶; 𑆃𑆟𑆶𑆨𑇀𑆪𑆱𑇀𑆠𑆽𑆬𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆤𑆴𑆰𑇀𑆥𑆳𑆢𑇀𑆪𑆠 𑆅𑆠𑇀𑆪𑆟𑆶𑆠𑆽𑆬𑆩𑇀 𑇆𑇒𑇘𑇆
𑆃𑆡 𑆩𑆲𑆳𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆑𑆳𑆰𑇀𑆜𑆽𑆫𑇀𑆧𑆲𑆶𑆨𑆴𑆫𑆮𑆢𑆲𑇀𑆪𑆳𑆮𑆤𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆩𑆱𑆴𑆠𑆩𑆶𑆰𑆴𑆠𑆩𑆼𑆑𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆯𑆳𑆤𑇀𑆠𑆼𑇁𑆓𑇀𑆤𑆳𑆮𑆥𑆾𑆲𑇀𑆪 𑆨𑆱𑇀𑆩 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆳𑆁 𑆨𑆷𑆩𑆴𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆠𑆽𑆬𑆔𑆛𑆯𑆠𑆼𑆤 𑆠𑆶𑆬𑇀𑆪𑆥𑆪𑆱𑆳𑇁𑆨𑆴𑆰𑆴𑆖𑇀𑆪𑆽𑆑𑆫𑆳𑆠𑇀𑆫𑆩𑆮𑆱𑇀𑆡𑆳𑆥𑇀𑆪 𑆠𑆠𑆾 𑆪𑆳𑆮𑆠𑆵 𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆩𑆳𑆢𑆳𑆪𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆼𑆤 𑆩𑆲𑆠𑆴 𑆑𑆛𑆳𑆲𑆼𑇁𑆨𑇀𑆪𑆳𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀, 𑆠𑆠𑇀𑆫 𑆪𑆠𑇀𑆠𑆽𑆬𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆠𑆠𑇀 𑆥𑆳𑆟𑆴𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑇀𑆪𑆳𑆢𑆳𑆪 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀; 𑆠𑆠𑆱𑇀𑆠𑆽𑆬𑆁 𑆮𑆳𑆠𑆲𑆫𑆿𑆰𑆣𑆑𑇀𑆮𑆳𑆡𑆩𑆳𑆁𑆱𑆫𑆱𑆑𑇀𑆰𑆵𑆫𑆳𑆩𑇀𑆬𑆨𑆳𑆓𑆱𑆲𑆱𑇀𑆫𑆼𑆟 𑆱𑆲𑆱𑇀𑆫𑆥𑆳𑆑𑆁 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆪𑆳𑆮𑆠𑆳 𑆑𑆳𑆬𑆼𑆤 𑆯𑆑𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑆥𑆑𑇀𑆠𑆶𑆁, 𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆲𑆽𑆩𑆮𑆠𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆥𑆡𑆓𑆳𑆯𑇀𑆖 𑆓𑆤𑇀𑆣𑆳 𑆮𑆳𑆠𑆔𑇀𑆤𑆳𑆤𑆴 𑆖, 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆯𑆕𑇀𑆒𑆳𑆤𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆼𑆢𑇀𑆢𑆶𑆤𑇀𑆢𑆶𑆨𑆵𑆤𑆳𑆔𑆳𑆠𑆪𑆼𑆖𑇀𑆗𑆠𑇀𑆫𑆁 𑆣𑆳𑆫𑆪𑆼𑆢𑇀𑆧𑆳𑆬𑆮𑇀𑆪𑆘𑆤𑆽𑆯𑇀𑆖 𑆮𑆵𑆘𑆪𑆼𑆢𑇀𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆱𑆲𑆱𑇀𑆫𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀, 𑆠𑆠𑇀 𑆱𑆳𑆣𑆶 𑆱𑆴𑆢𑇀𑆣𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆱𑆿𑆮𑆫𑇀𑆟𑆼 𑆫𑆳𑆘𑆠𑆼 𑆩𑆸𑆤𑇀𑆩𑆪𑆼 𑆮𑆳 𑆥𑆳𑆠𑇀𑆫𑆼 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆢𑆼𑆠𑆠𑇀 𑆱𑆲𑆱𑇀𑆫𑆥𑆳𑆑𑆩𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆫𑆮𑆵𑆫𑇀𑆪𑆁 𑆫𑆳𑆘𑆳𑆫𑇀𑆲𑆁 𑆠𑆽𑆬𑆩𑇀; 𑆍𑆮𑆁 𑆨𑆳𑆓𑆯𑆠𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆯𑆠𑆥𑆳𑆑𑆩𑇀 𑇆𑇒𑇙𑇆
𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆲𑆱𑇀𑆠𑆩𑆶𑆰𑇀𑆑𑆑𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆳𑆛𑆫𑆷𑆰𑆑𑆥𑆷𑆠𑆵𑆑𑆳𑆫𑆓𑇀𑆮𑆣𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆟𑆴 𑆬𑆮𑆟𑆼𑆤 𑆱𑆲𑆾𑆢𑆷𑆒𑆬𑆼𑇁𑆮𑆑𑇀𑆰𑆶𑆢𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆔𑆛𑆼 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆳𑆮𑆬𑆴𑆥𑇀𑆪 𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆨𑆴𑆫𑇀𑆢𑆳𑆲𑆪𑆼𑆠𑇀; 𑆍𑆠𑆠𑇀𑆥𑆠𑇀𑆫𑆬𑆮𑆟𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆫𑆾𑆓𑆼𑆰𑆶 𑇆𑇓𑇐𑇆
𑆍𑆮𑆁 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑆳𑆟𑇀𑆝𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆬𑆮𑆟𑆳𑆤𑆴 𑆱𑆕𑇀𑆑𑇀𑆰𑆶𑆢𑇀𑆪 𑆔𑆛𑆁 𑆥𑆷𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆨𑆴𑆂 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆳𑆮𑆬𑆴𑆥𑇀𑆪 𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆨𑆴𑆫𑇀𑆢𑆳𑆲𑆪𑆼𑆠𑇀; 𑆍𑆠𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆫𑆾𑆓𑆼𑆰𑆶 𑇅 (𑆅𑆠𑆴 𑆑𑆳𑆟𑇀𑆝𑆬𑆮𑆟𑆩𑇀) 𑇆𑇓𑇑𑇆
𑆓𑆟𑇀𑆝𑆵𑆫𑆥𑆬𑆳𑆯𑆑𑆶𑆛𑆘𑆧𑆴𑆬𑇀𑆮𑆳𑆫𑇀𑆑𑆱𑇀𑆤𑆶𑆲𑇀𑆪𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆥𑆳𑆛𑆬𑆳𑆥𑆳𑆫𑆴𑆨𑆢𑇀𑆫𑆑𑆤𑆳𑆢𑆼𑆪𑆵𑆑𑆸𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆳𑆤𑆵𑆥𑆤𑆴𑆩𑇀𑆧𑆤𑆴𑆫𑇀𑆢𑆲𑆤𑇀𑆪𑆛𑆫𑆷𑆰𑆑𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆑- 𑆥𑆷𑆠𑆴𑆑𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆮𑆽𑆘𑆪𑆤𑇀𑆠𑆵𑆑𑆢𑆬𑆵𑆧𑆳𑆰𑇀𑆥𑆢𑇀𑆮𑆪𑆼𑆑𑇀𑆰𑆶𑆫𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆮𑆳𑆫𑆶𑆟𑆵𑆯𑇀𑆮𑆼𑆠𑆩𑆾𑆑𑇀𑆰𑆑𑆳𑆯𑆾𑆑𑆳 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆮𑆫𑇀𑆓𑆁 𑆱𑆩𑆷𑆬𑆥𑆠𑇀𑆫𑆯𑆳𑆒𑆩𑆳𑆫𑇀𑆢𑇀𑆫𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆬𑆮𑆟𑆼𑆤 𑆱𑆲 𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆑𑇀𑆰𑆳𑆫𑆑𑆬𑇀𑆥𑆼𑆤 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑇅 𑆅𑆠𑇀𑆪𑆼𑆠𑆠𑇀 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆬𑆮𑆟𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆓𑆶𑆬𑇀𑆩𑆥𑇀𑆬𑆵𑆲𑆳𑆓𑇀𑆤𑆴𑆰𑆕𑇀𑆓𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆫𑇀𑆯𑆾𑇁𑆫𑆾𑆖𑆑𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑆳𑆱𑆳𑆢𑆴𑆨𑆴𑆂 𑆑𑆸𑆩𑆴𑆨𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆼𑆰𑇀𑆮𑆥𑆵𑆠𑆴 𑇆𑇓𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆤𑆳𑆢𑆶𑆰𑇀𑆟𑆨𑆳𑆮𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆖 𑆮𑆴𑆥𑆳𑆖𑆤𑆳𑆠𑇀 𑇅 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆥𑆳𑆖𑆤𑆳𑆖𑇀𑆖𑆼𑆢𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆼𑆰𑆶 𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇓𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆲𑆳𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆩𑆮𑆓𑆳𑆞𑆁 𑆖𑆼𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼; 𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆠𑆢𑇀𑆣𑆴 𑆑𑆶𑆰𑇀𑆜𑆮𑆢𑆶𑆠𑇀𑆠𑆳𑆤𑆁 𑆨𑆷𑆠𑇀𑆮𑆳 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆮𑆓𑆳𑆞𑆵𑆨𑆮𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑇀 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆧𑆬𑆮𑆢𑇀𑆮𑆴𑆓𑇀𑆫𑆲𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆪 𑆮𑆳𑆪𑆾𑆫𑇀𑆓𑆶𑆫𑆷𑆰𑇀𑆟𑆳𑆣𑇀𑆪𑆯𑆤𑆯𑆵𑆬𑆱𑇀𑆪 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆮𑆸𑆠𑇀𑆪 𑆮𑆳𑆠𑆼𑆤 𑆱𑆲𑆽𑆑𑆵𑆨𑆷𑆠𑆁 𑆪𑆶𑆓𑆥𑆢𑇀𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆁 𑆮𑆼𑆢𑆤𑆳𑆁 𑆘𑆤𑆪𑆠𑆵𑆠𑆴 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆁 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆪𑆾𑆫𑆮𑆱𑇀𑆡𑆳𑆤𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆢𑆼𑆲𑆁 𑆮𑇀𑆪𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑇅 𑆠𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴𑆠𑆾𑆢𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆷𑆯𑆾𑆦𑆱𑇀𑆠𑆩𑇀𑆨𑆠𑇀𑆮𑆑𑇀𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆣𑆩𑆤𑆵𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆱𑆑𑇀𑆡𑆴𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑆴 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆩𑆟𑇀𑆝𑆬𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆯𑇀𑆖𑆳𑆑𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆓𑆶𑆬𑇀𑆦𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶, 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆴𑆟𑆾𑇁𑆥𑆖𑆳𑆫𑆴𑆟𑆯𑇀𑆖 𑆫𑆾𑆓𑆾 𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆫𑆂, 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆁; 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆴𑆟𑆾 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 𑇆𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑇀𑆫𑆳𑆪𑆯𑆂 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑆳𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑆳𑆁 𑆱𑆶𑆒𑆴𑆤𑆳𑆁 𑆖𑆳𑆥𑆴 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆴 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆟𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆥𑆴𑆥𑆳𑆱𑆳𑆘𑇀𑆮𑆫𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆮𑆴𑆱𑆫𑆟𑆱𑆕𑇀𑆑𑆾𑆖𑆤𑆽𑆫𑆤𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆧𑆬𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆁 𑆖𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫, 𑆄𑆢𑆳𑆮𑆼𑆮 𑆧𑆲𑆶𑆮𑆳𑆠𑆫𑆷𑆑𑇀𑆰𑆩𑇀𑆬𑆳𑆤𑆳𑆕𑇀𑆓𑆳𑆢𑆸𑆠𑆼 𑆩𑆳𑆫𑇀𑆓𑆳𑆮𑆫𑆟𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆩𑆱𑆑𑆸𑆢𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆩𑆮𑆱𑆴𑆚𑇀𑆖𑆼𑆢𑇀𑆮𑆳𑆠𑆑𑆾𑆥𑆨𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑆾 𑆮𑆩𑆤𑆳𑆢𑆴𑆨𑆴𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆫𑆶𑆥𑆥𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆨𑆑𑇀𑆠𑆁 𑆮𑆳𑆠𑆥𑇀𑆫𑆧𑆬𑆼 𑆥𑆶𑆫𑆳𑆟𑆔𑆸𑆠𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇅 𑆃𑆘𑆳𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆳𑇁𑆫𑇀𑆣𑆠𑆽𑆬𑆁 𑆩𑆣𑆶𑆑𑆳𑆑𑇀𑆰𑆪𑆪𑆶𑆑𑇀𑆠𑆁, 𑆯𑆸𑆓𑆳𑆬𑆮𑆴𑆤𑇀𑆤𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆁, 𑆯𑆶𑆟𑇀𑆜𑆵𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆑𑆯𑆼𑆫𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆯𑇀𑆪𑆳𑆩𑆳𑆫𑆳𑆱𑇀𑆤𑆳𑆱𑆶𑆰𑆮𑆵𑆯𑆸𑆓𑆳𑆬𑆮𑆴𑆤𑇀𑆤𑆳𑆥𑆵𑆬𑆶𑆯𑆠𑆳𑆮𑆫𑆵𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑇅 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆑𑇀𑆮𑆳𑆡𑆳𑆰𑇀𑆛𑆓𑆶𑆟𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆥𑆪𑆱𑆳 𑆩𑆣𑆶𑆑𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆱𑆫𑆬𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆮𑆖𑆳𑆱𑆶𑆫𑆨𑆴𑆑𑆬𑇀𑆑𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆠𑆽𑆬𑆁 𑆥𑆳𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆳𑆤𑆳𑆢𑆴𑆰𑆷𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑆪𑆷𑆫𑆑𑆑𑆴𑆟𑆴𑆲𑇀𑆪𑆘𑆩𑆾𑆢𑆳𑆩𑆣𑆶𑆑𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆢𑆳𑆫𑆵𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆠𑆸𑆟𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆑𑇀𑆮𑆳𑆡𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆥𑆁, 𑆧𑆬𑆳𑆠𑆽𑆬𑆁 𑆯𑆠𑆥𑆳𑆑𑆁 𑆮𑆼𑆠𑆴 𑇅 𑆮𑆳𑆠𑆲𑆫𑆩𑆷𑆬𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆖 𑆥𑆪𑆱𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆤𑆩𑆩𑇀𑆬𑆽𑆫𑇀𑆮𑆳 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇅 𑆪𑆮𑆩𑆣𑆶𑆑𑆽𑆫𑆟𑇀𑆝𑆠𑆴𑆬𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆨𑆴𑆫𑇀𑆮𑆳 𑆥𑇀𑆫𑆢𑆼𑆲𑆂 𑆑𑆳𑆫𑇀𑆪𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆼𑆰𑆶 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆠𑆴𑆬𑆩𑆶𑆢𑇀𑆓𑆩𑆳𑆰𑆼𑆰𑆶 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆯𑆂 𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆧𑆴𑆱𑆩𑆸𑆟𑆳𑆬𑆯𑆸𑆓𑆳𑆬𑆮𑆴𑆤𑇀𑆤𑆳𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵- 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑆯𑆼𑆫𑆶𑆑𑆱𑆶𑆫𑆨𑆴𑆮𑆖𑆳𑆑𑆬𑇀𑆑𑆩𑆴𑆯𑇀𑆫𑆼𑆰𑆷𑆥𑆤𑆳𑆲𑆳𑆫𑇀𑆡𑆁 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆢𑆶𑆓𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆥𑆚𑇀𑆖 𑆥𑆳𑆪𑆱𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆦𑆬𑆱𑆳𑆫𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳 𑆮𑆳, 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆼𑆰𑆶 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆠𑆴𑆬𑆩𑆶𑆢𑇀𑆮𑆩𑆳𑆰𑆼𑆰𑆶 𑆩𑆠𑇀𑆱𑇀𑆪𑆥𑆴𑆯𑆴𑆠𑆮𑆼𑆯𑆮𑆳𑆫𑆾 𑆮𑆳, 𑆧𑆴𑆬𑇀𑆮𑆥𑆼𑆯𑆴𑆑𑆳𑆠𑆓𑆫𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆱𑆫𑆬𑆳𑆫𑆳𑆱𑇀𑆤𑆳𑆲𑆫𑆼𑆟𑆶𑆑𑆶𑆰𑇀𑆜𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆽𑆬𑆳𑆱𑆶𑆫𑆳𑆢𑆣𑆴𑆩𑆱𑇀𑆠𑆶𑆪𑆶𑆑𑇀𑆠 𑆇𑆥𑆤𑆳𑆲𑆂, 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆩𑇀𑆬𑆱𑆽𑆤𑇀𑆣𑆮𑆔𑆸𑆠𑆩𑆴𑆯𑇀𑆫𑆁 𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆷𑆬𑆩𑆳𑆬𑆼𑆥𑆱𑇀𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆾 𑆮𑆼𑆠𑆴 𑆮𑆳𑆠𑆥𑇀𑆫𑆧𑆬𑆼 𑇆𑇗𑇆
𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆧𑆬𑆼 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆫𑆼𑆮𑆠𑆑𑆛𑇀𑆦𑆬𑆥𑆪𑆱𑇀𑆪𑆳𑆩𑆣𑆶𑆑𑆖𑆤𑇀𑆢𑆤𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆑𑆰𑆳𑆪𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑆣𑆶𑆑𑆥𑆛𑆾𑆬𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆑𑆰𑆳𑆪𑆁 , 𑆓𑆶𑆝𑆷𑆖𑆵𑆑𑆰𑆳𑆪𑆁 𑆮𑆳, 𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆲𑆫𑆁 𑆮𑆳 𑆖𑆤𑇀𑆢𑆤𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆁, 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂; 𑆧𑆴𑆱𑆩𑆸𑆟𑆳𑆬𑆨𑆢𑇀𑆫𑆯𑇀𑆫𑆴𑆪𑆥𑆢𑇀𑆩𑆑𑆑𑆰𑆳𑆪𑆼𑆟𑆳𑆫𑇀𑆣𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆥𑆫𑆴𑆰𑆼𑆑𑆂, 𑆑𑇀𑆰𑆵𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆽𑆫𑇀𑆩𑆣𑆶𑆑𑆯𑆫𑇀𑆑𑆫𑆳𑆠𑆟𑇀𑆝𑆶𑆬𑆾𑆢𑆑𑆽𑆫𑇀𑆮𑆳 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆼𑆑𑇀𑆰𑆶𑆑𑆰𑆳𑆪𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆩𑆱𑇀𑆠𑆶𑆩𑆢𑇀𑆪𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆽𑆂; 𑆘𑆵𑆮𑆤𑆵𑆪𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆂, 𑆯𑆠𑆣𑆿𑆠𑆔𑆸𑆠𑆼𑆤 𑆮𑆳, 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑆬𑇀𑆑𑆑𑆰𑆳𑆪𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆳; 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆤𑆬𑆮𑆚𑇀𑆘𑆶𑆬𑆠𑆳𑆬𑆵𑆱𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆓𑆬𑆾𑆝𑇀𑆪𑆓𑆿𑆫𑆵𑆓𑆽𑆫𑆴𑆑𑆯𑆽𑆮𑆬𑆥𑆢𑇀𑆩𑆑𑆥𑆢𑇀𑆩𑆥𑆠𑇀𑆫𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆾 𑆔𑆸𑆠𑆩𑆴𑆯𑇀𑆫𑆂, 𑆮𑆳𑆠𑆥𑇀𑆫𑆧𑆬𑆼𑇁𑆥𑇀𑆪𑆼𑆰 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆂 𑆑𑆳𑆫𑇀𑆪𑆂 𑇆𑇘𑇆
𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆧𑆬𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁, 𑆧𑆲𑆶𑆯𑆯𑇀𑆖 𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆱𑆼𑆖𑆪𑆼𑆠𑇀, 𑆯𑆵𑆠𑆠𑆩𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆂 𑆑𑆳𑆫𑇀𑆪𑆳 𑆅𑆠𑆴 𑇆𑇙𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆧𑆬𑆼 𑆠𑇀𑆮𑆳𑆩𑆬𑆑𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆰𑆳𑆪𑆁 𑆮𑆳 ; 𑆩𑆣𑆶𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆲𑆫𑆵𑆠𑆑𑆵𑆠𑆴𑆑𑇀𑆠𑆫𑆾𑆲𑆴𑆟𑆵𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁, 𑆩𑆷𑆠𑇀𑆫𑆠𑆾𑆪𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟 𑆓𑆶𑆝𑆲𑆫𑆵𑆠𑆑𑆵𑆁 𑆮𑆳 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀; 𑆠𑆽𑆬𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆱𑆶𑆫𑆳𑆯𑆶𑆑𑇀𑆠𑆑𑆦𑆔𑇀𑆤𑆿𑆰𑆣𑆤𑆴𑆂𑆑𑇀𑆮𑆳𑆡𑆽𑆯𑇀𑆖 𑆥𑆫𑆴𑆰𑆼𑆑𑆂, 𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆮𑆾𑆰𑇀𑆟𑆽𑆂; 𑆩𑆱𑇀𑆠𑆶𑆩𑆷𑆠𑇀𑆫𑆱𑆶𑆫𑆳𑆯𑆶𑆑𑇀𑆠𑆩𑆣𑆶𑆑𑆱𑆳𑆫𑆴𑆮𑆳𑆥𑆢𑇀𑆩𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆔𑆸𑆠𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆂; 𑆠𑆴𑆬𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆑𑆑𑆥𑆴𑆠𑇀𑆡𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆴𑆯𑇀𑆫𑆳𑆟𑆴 𑆑𑇀𑆰𑆳𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆥𑇀𑆫𑆢𑆼𑆲𑆂; 𑆯𑇀𑆮𑆼𑆠𑆱𑆫𑇀𑆰𑆥𑆑𑆬𑇀𑆑𑆂, 𑆠𑆴𑆬𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆑𑆬𑇀𑆑𑆂, 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆱𑆼𑆬𑆶𑆑𑆥𑆴𑆠𑇀𑆡𑆑𑆬𑇀𑆑𑆂, 𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆑𑆬𑇀𑆑𑆂, 𑆮𑇀𑆪𑆾𑆰𑆠𑆴𑆑𑇀𑆠𑆳𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑆵𑆧𑆸𑆲𑆠𑆵𑆑𑆬𑇀𑆑 𑆅𑆠𑇀𑆪𑆼𑆠𑆼𑆰𑆳𑆁 𑆥𑆚𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆳𑆂 𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆥𑆴𑆰𑇀𑆛𑆳𑆂, 𑆯𑆳𑆬𑆴𑆥𑆫𑇀𑆟𑆵 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵 𑆧𑆸𑆲𑆠𑇀𑆪𑆿 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆩𑆴𑆯𑇀𑆫𑆳𑆂 𑇆𑇑𑇐𑇆
𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆖 𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆡𑆩𑆶𑆑𑇀𑆠𑆁 𑆩𑆴𑆯𑇀𑆫𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇑𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆖 𑆓𑆶𑆝𑆲𑆫𑆵𑆠𑆑𑆵𑆩𑆳𑆱𑆼𑆮𑆼𑆠; 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆫𑇀𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆳 𑆮𑆳𑆫𑆴𑆥𑆴𑆰𑇀𑆛𑆳 𑆮𑆳 𑆥𑆚𑇀𑆖𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆢𑆯𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆮𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆿𑆢𑆤𑆳𑆲𑆳𑆫𑆾 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁, 𑆨𑆷𑆪𑆯𑇀𑆖𑆳𑆥𑆑𑆫𑇀𑆰𑆪𑆼𑆠𑇀, 𑆍𑆮𑆁 𑆪𑆳𑆮𑆠𑇀 𑆥𑆚𑇀𑆖 𑆢𑆯 𑆮𑆼𑆠𑆴; 𑆠𑆢𑆼𑆠𑆠𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆑𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆫𑆾𑆖𑆑𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆂𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆯𑆾𑆦𑆯𑆾𑆰𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆾𑆢𑆫𑆳𑆟𑇀𑆪𑆥𑆲𑆤𑇀𑆠𑆴; 𑆘𑆵𑆮𑆤𑆵𑆪𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆪𑆱𑆳 𑆥𑆳𑆖𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆨𑇀𑆪𑆘𑇀𑆪𑆳𑆠𑇀; 𑆱𑆲𑆳𑆱𑆲𑆢𑆼𑆮𑆳𑆖𑆤𑇀𑆢𑆤𑆩𑆷𑆫𑇀𑆮𑆳𑆩𑆶𑆱𑇀𑆠𑆳𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆯𑆠𑆳𑆮𑆫𑆵𑆑𑆯𑆼𑆫𑆶𑆥𑆢𑇀𑆩𑆑𑆩𑆣𑆶𑆑𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆾 𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆪𑆶𑆑𑇀𑆠𑆂, 𑆱𑆽𑆫𑆼𑆪𑆑𑆳𑆛𑆫𑆷𑆰𑆑𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆱𑆶𑆰𑆮𑆵𑆑𑆬𑇀𑆑𑆾 𑆮𑆳 𑆖𑇀𑆗𑆳𑆓𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆂, 𑆓𑆾𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆂 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆩𑆣𑆶𑆑𑆠𑆫𑇀𑆥𑆟𑆑𑆬𑇀𑆑𑆾 𑆮𑆳; 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆱𑆫𑇀𑆘𑆫𑆱𑆱𑆳𑆫𑆴𑆮𑆳𑆑𑇀𑆰𑆵𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆴𑆟𑇀𑆝𑆠𑆽𑆬𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆂; 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆖 𑆥𑆶𑆫𑆳𑆟𑆔𑆸𑆠𑆩𑆳𑆩𑆬𑆑𑆫𑆱𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆮𑆳 𑆥𑆳𑆤𑆳𑆫𑇀𑆡𑆼; 𑆘𑆵𑆮𑆤𑆵𑆪𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆫𑇀𑆡𑆼, 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑇀𑆮𑆳𑆡𑆑𑆬𑇀𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳; 𑆱𑆶𑆰𑆮𑆵𑆑𑇀𑆮𑆳𑆡𑆑𑆬𑇀𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆑𑆳𑆫𑆮𑆼𑆬𑇀𑆬𑆑𑆑𑇀𑆮𑆳𑆡𑆩𑆳𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳; 𑆧𑆬𑆳𑆠𑆽𑆬𑆁 𑆮𑆳 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆧𑆱𑇀𑆠𑆴𑆨𑆾𑆘𑆤𑆼𑆰𑆶; 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆳𑆤𑇀𑆤𑆩𑆤𑆮𑆁 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆥𑆪𑆱𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆼𑆤 𑆮𑆳 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆼𑆟 𑆮𑆳𑇁𑆤𑆩𑇀𑆬𑆼𑆤; 𑆯𑆾𑆟𑆴𑆠𑆩𑆾𑆑𑇀𑆰𑆁 𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆇𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆢𑆾𑆰𑆼 𑆖 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆑𑆫𑇀𑆩 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑇀 𑇆𑇑𑇒𑇆
(𑆥𑆛𑆾𑆬𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆨𑆵𑆫𑆶𑆓𑆶𑆝𑆷𑆖𑆵𑆑𑆛𑆶𑆑𑆳𑆑𑆸𑆠𑆩𑇀 𑇅 𑆑𑇀𑆮𑆳𑆡𑆁 𑆥𑆵𑆠𑇀𑆮𑆳 𑆘𑆪𑆠𑇀𑆪𑆳𑆯𑆶 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆁 𑆫𑆶𑆘𑆩𑇀 ) 𑇆𑇑𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆍𑆮𑆩𑆳𑆢𑇀𑆪𑆽𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆾𑆓𑆽𑆫𑆖𑆴𑆫𑆾𑆠𑇀𑆥𑆠𑆴𑆠𑆁 𑆱𑆶𑆒𑆩𑇀 𑇅 𑆮𑆳𑆠𑆳𑆱𑆸𑆑𑇀 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆮𑆽𑆢𑇀𑆪𑆽𑆫𑇀𑆪𑆳𑆥𑇀𑆪𑆠𑆼 𑆠𑆶 𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆩𑇀 𑇆𑇑𑇔𑇆
𑆇𑆥𑆤𑆳𑆲𑆥𑆫𑆵𑆰𑆼𑆑𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆯𑆫𑆟𑆳𑆤𑇀𑆪𑆥𑇀𑆫𑆮𑆳𑆠𑆳𑆤𑆴 𑆩𑆤𑆾𑆘𑇀𑆚𑆳𑆤𑆴 𑆩𑆲𑆳𑆤𑇀𑆠𑆴 𑆖 𑇆𑇑𑇕𑇆
𑆩𑆸𑆢𑆶𑆓𑆟𑇀𑆝𑆾𑆥𑆣𑆳𑆤𑆳𑆤𑆴 𑆯𑆪𑆤𑆳𑆤𑆴 𑆱𑆶𑆒𑆳𑆤𑆴 𑆖 𑇅 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆩𑆸𑆢𑆶𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆤𑆴 𑆖 𑇆𑇑𑇖𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆁 𑆩𑆽𑆡𑆶𑆤𑆁 𑆑𑆾𑆥𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆯𑆤𑆩𑇀 𑇅 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆓𑆶𑆫𑆶 𑆖𑆳𑆤𑇀𑆤𑆁 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑆩𑇀𑆬𑆳𑆤𑆓𑆳𑆠𑇀𑆫𑆁 𑆱𑆫𑆶𑆘𑆩𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆁 𑆖𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆓𑆼𑆮 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆩𑆸𑆢𑆶𑆤𑆳 𑆯𑆾𑆣𑆤𑆼𑆤 𑆱𑆁𑆯𑆾𑆣𑇀𑆪𑆳𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑇀𑆪 𑆖 𑆪𑆡𑆳𑆑𑆳𑆬𑆩𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀; 𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑇀𑆪𑆂 𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑆴𑆂 , 𑆃𑆟𑆶𑆠𑆽𑆬𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆫𑇀𑆡𑆼, 𑆱𑆳𑆬𑇀𑆮𑆟𑆩𑆶𑆥𑆤𑆳𑆲𑆳𑆫𑇀𑆡𑆼, 𑆧𑆬𑆳𑆠𑆽𑆬𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆫𑇀𑆡𑆼; 𑆍𑆮𑆩𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆱𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾 𑆮𑆳 𑆩𑆳𑆱𑆳𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑇆𑇑𑇙𑇆
𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆼𑇁𑆥𑇀𑆪𑆼𑆠𑆢𑆼𑆮 𑆮𑆴𑆣𑆳𑆤𑆁, 𑆮𑆴𑆯𑆼𑆰𑆠𑆾 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆲𑆫𑆽𑆫𑇀𑆤𑆱𑇀𑆪𑆽 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆮𑆼𑆢𑆽𑆯𑇀𑆖𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆃𑆥𑆠𑆤𑇀𑆠𑇀𑆫𑆑𑆳𑆠𑆶𑆫𑆁 𑆤𑆳𑆥𑆠𑆫𑇀𑆥𑆪𑆼𑆠𑇀, 𑆮𑆩𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆤 𑆤𑆴𑆰𑆼𑆮𑆼𑆠, 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆥𑆫𑆶𑆢𑇀𑆣𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆣𑇀𑆩𑆳𑆥𑆤𑆽𑆫𑇀𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆥𑆶𑆰𑇀𑆑𑆫𑆳𑆲𑇀𑆮𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆥𑆡𑇀𑆪𑆳𑆬𑆮𑆟𑆠𑇀𑆫𑆪𑆁 𑆪𑆮𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆥𑆳𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆥𑆡𑇀𑆪𑆳𑆯𑆠𑆳𑆫𑇀𑆣𑆼 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆢𑇀𑆮𑆴𑆥𑆬𑆼 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼 𑆥𑆪𑆱𑆴 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆱𑆴𑆢𑇀𑆣𑆁; 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆥𑆤𑆶𑆖𑇀𑆖 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇑𑇆
𑆃𑆫𑇀𑆢𑆴𑆠𑆳𑆠𑆶𑆫𑆁 𑆧𑆬𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆁 𑆖 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆽𑆯𑇀𑆖 𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑇀𑆪𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑆴𑆤𑆱𑇀𑆪𑆣𑆷𑆩𑆾𑆥𑆤𑆳𑆲𑆱𑇀𑆤𑆼𑆲𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆳𑆢𑆴𑆨𑆴𑆂; 𑆠𑆠𑆂 𑆱𑆠𑆸𑆟𑆁 𑆩𑆲𑆳𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆁 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆩𑆿𑆢𑆑𑆳𑆤𑆷𑆥𑆩𑆳𑆁𑆱𑆁 𑆠𑆡𑆽𑆮𑆿𑆢𑆑𑆑𑆤𑇀𑆢𑆳𑆁𑆯𑇀𑆖𑆳𑆲𑆸𑆠𑇀𑆪 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆾𑆢𑆑𑆼 𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆫𑆾𑆟𑆼 𑆤𑆴𑆂𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆑𑇀𑆰𑆵𑆫𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆠𑆽𑆬𑆥𑇀𑆫𑆱𑇀𑆡𑆼𑆤𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑇀𑆪 𑆥𑆶𑆤𑆫𑆓𑇀𑆤𑆳𑆮𑆣𑆴𑆯𑇀𑆫𑆪𑆼𑆠𑇀, 𑆠𑆠𑆱𑇀𑆠𑆽𑆬𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑆶𑆓𑆠𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆩𑆨𑆴𑆩𑆡𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆠𑆠𑇀𑆫 𑆪𑆂 𑆱𑇀𑆤𑆼𑆲 𑆇𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆠𑆩𑆳𑆢𑆳𑆪 𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆱𑆲𑆳𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆍𑆠𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆠𑆽𑆬𑆩𑆫𑇀𑆢𑆴𑆠𑆳𑆠𑆶𑆫𑆳𑆟𑆳𑆁 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆢𑆴𑆰𑆷𑆥𑆪𑆾𑆘𑇀𑆪𑆁, 𑆠𑆽𑆬𑆲𑆵𑆤𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑆑𑇀𑆰𑆴𑆠𑆫𑇀𑆥𑆟𑆩𑆴𑆠𑆴 𑇆𑇒𑇒𑇆
𑆓𑆸𑆣𑇀𑆫𑆱𑆵𑆮𑆴𑆯𑇀𑆮𑆳𑆖𑆵𑆑𑇀𑆫𑆾𑆰𑇀𑆛𑆶𑆑𑆯𑆴𑆫𑆂𑆒𑆚𑇀𑆘𑆥𑆕𑇀𑆓𑆶𑆬𑆮𑆳𑆠𑆑𑆟𑇀𑆛𑆑𑆥𑆳𑆢𑆢𑆳𑆲𑆥𑆳𑆢𑆲𑆫𑇀𑆰𑆳𑆮𑆧𑆳𑆲𑆶𑆑𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆣𑆩𑆤𑆵𑆓𑆠𑆮𑆳𑆠𑆫𑆾𑆓𑆼𑆰𑆶 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆁 𑆖 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫𑆳𑆮𑆧𑆳𑆲𑆶𑆑𑆳𑆠𑇀; 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑆼𑆠 𑇆𑇒𑇓𑇆
𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆼 𑆠𑆶 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆫𑆱𑆁 𑆠𑆽𑆬𑆩𑆣𑆶𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆾𑆥𑆲𑆴𑆠𑆁 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆑𑆫𑇀𑆟𑆼 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆃𑆘𑆳𑆩𑆷𑆠𑇀𑆫𑆩𑆣𑆶𑆠𑆽𑆬𑆳𑆤𑆴 𑆮𑆳, 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆢𑆳𑆝𑆴𑆩𑆠𑆴𑆤𑇀𑆠𑆴𑆝𑆵𑆑𑆱𑇀𑆮𑆫𑆱𑆩𑆷𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁, 𑆯𑆶𑆑𑇀𑆠𑆱𑆶𑆫𑆳𑆠𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆬𑆮𑆟𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳; 𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆽𑆯𑇀𑆖 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑆼𑆠; 𑆨𑆷𑆪𑆯𑇀𑆖𑆾𑆠𑇀𑆠𑆫𑆼 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇒𑇔𑇆
𑆠𑆷𑆤𑆵𑆥𑇀𑆫𑆠𑆷𑆤𑇀𑆪𑆾𑆂 𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆼𑆤 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳, 𑆲𑆴𑆕𑇀𑆓𑆶𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆥𑇀𑆫𑆓𑆳𑆞𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂, 𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆯𑇀𑆖𑆽𑆤𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇆𑇒𑇕𑇆
𑆄𑆣𑇀𑆩𑆳𑆤𑆼 𑆠𑇀𑆮𑆥𑆠𑆫𑇀𑆥𑆟𑆥𑆳𑆟𑆴𑆠𑆳𑆥(𑆢𑆵𑆥𑆤𑆖𑆷𑆫𑇀𑆟 )𑆦𑆬𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆳𑆖𑆤𑆵𑆪𑆢𑆵𑆥𑆤𑆵𑆪𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀; 𑆬𑆕𑇀𑆔𑆤𑆳𑆤𑆤𑇀𑆠𑆫𑆁 𑆖𑆳𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑆣𑆳𑆤𑇀𑆪𑆑𑆘𑆵𑆫𑆑𑆳𑆢𑆴𑆢𑆵𑆥𑆤𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆤𑇀𑆤𑆳𑆤𑆴 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆣𑇀𑆩𑆳𑆤𑆼 𑆗𑆫𑇀𑆢𑆤𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆢𑆵𑆥𑆤𑆳𑆤𑆴 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇖𑇆
𑆃𑆰𑇀𑆜𑆵𑆬𑆳𑆥𑇀𑆫𑆠𑇀𑆪𑆰𑇀𑆜𑆵𑆬𑆪𑆾𑆫𑇀𑆓𑆶𑆬𑇀𑆩𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆮𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆨𑆳𑆓 𑆅𑆠𑆴 𑇆𑇒𑇗𑇆
𑆲𑆴𑆕𑇀𑆓𑆶𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆮𑆖𑆳𑆘𑆩𑆾𑆢𑆳𑆣𑆳𑆤𑇀𑆪𑆳𑆘𑆓𑆤𑇀𑆣𑆳𑆢𑆳𑆝𑆴𑆩𑆠𑆴𑆤𑇀𑆠𑆴𑆝𑆵𑆑𑆥𑆳𑆜𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆱𑆽𑆤𑇀𑆣𑆮𑆮𑆴𑆝𑆱𑆿𑆫𑇀𑆮𑆖𑆬- 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆯𑆛𑆵𑆥𑆶𑆰𑇀𑆑𑆫𑆩𑆷𑆬𑆲𑆥𑆶𑆰𑆳𑆖𑆮𑇀𑆪𑆳𑆘𑆳𑆘𑆵𑆥𑆡𑇀𑆪𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆪𑆴𑆠𑇀𑆮𑆳 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆩𑇀𑆬𑆼𑆤 𑆧𑆲𑆶𑆯𑆂 𑆥𑆫𑆴𑆨𑆳𑆮𑇀𑆪𑆳𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳 𑆓𑆶𑆛𑆴𑆑𑆳𑆂 𑆑𑆳𑆫𑆪𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆼𑆑𑆽𑆑𑆳𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆵 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆍𑆰 𑆪𑆾𑆓𑆂 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆫𑆾𑆖𑆑𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆳𑆣𑇀𑆩𑆳𑆤𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆳𑆤𑆳𑆲𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆥𑇀𑆬𑆵𑆲𑆳𑆫𑇀𑆯𑆱𑇀𑆠𑆷𑆤𑆵𑆥𑇀𑆫𑆠𑆷𑆤𑆵𑆫𑆥𑆲𑆤𑇀𑆠𑆴 𑇆𑇒𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑆼𑆮𑆬𑆾 𑆢𑆾𑆰𑆪𑆶𑆑𑇀𑆠𑆾 𑆮𑆳 𑆣𑆳𑆠𑆶𑆨𑆴𑆫𑇀𑆮𑆳𑇁𑇁𑆮𑆸𑆠𑆾𑇁𑆤𑆴𑆬𑆂 𑇅 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆬𑆑𑇀𑆰𑆟𑆾𑆲𑆳𑆨𑇀𑆪𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆯𑇀𑆖𑆳𑆮𑆴𑆫𑆾𑆣𑆠𑆂 𑇆𑇒𑇙𑇆
𑆫𑆶𑆘𑆳𑆮𑆤𑇀𑆠𑆁 𑆔𑆤𑆁 𑆯𑆵𑆠𑆁 𑆯𑆾𑆦𑆁 𑆩𑆼𑆢𑆾𑆪𑆶𑆠𑆾𑇁𑆤𑆴𑆬𑆂 𑇅 𑆑𑆫𑆾𑆠𑆴 𑆪𑆱𑇀𑆪 𑆠𑆁 𑆮𑆽𑆢𑇀𑆪𑆂 𑆯𑆾𑆡𑆮𑆠𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇓𑇐𑇆
𑆑𑆦𑆩𑆼𑆢𑆾𑆮𑆸𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆪𑆢𑆾𑆫𑆷 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆢𑆳𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪 𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆫𑆶𑆘𑆳𑆘𑇀𑆮𑆫𑆽𑆂 𑇆𑇓𑇑𑇆
𑆤𑆴𑆢𑇀𑆫𑆪𑆳 𑆖𑆳𑆫𑇀𑆢𑆴𑆠𑆿 𑆱𑇀𑆠𑆧𑇀𑆣𑆿 𑆯𑆵𑆠𑆬𑆳𑆮𑆥𑇀𑆫𑆖𑆼𑆠𑆤𑆿 𑇅 𑆓𑆶𑆫𑆶𑆑𑆳𑆮𑆱𑇀𑆡𑆴𑆫𑆳𑆮𑆷𑆫𑆷 𑆤 𑆱𑇀𑆮𑆳𑆮𑆴𑆮 𑆖 𑆩𑆤𑇀𑆪𑆠𑆼 𑇆𑇓𑇒𑇆
𑆠𑆩𑆷𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆩𑆴𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆳𑆞𑇀𑆪𑆮𑆳𑆠𑆩𑆡𑆳𑆥𑆫𑆼 𑇅 𑆱𑇀𑆤𑆼𑆲𑆮𑆫𑇀𑆘𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆠𑇀𑆫 𑆖𑆷𑆫𑇀𑆟𑆁 𑆰𑆝𑇀𑆣𑆫𑆟𑆁 𑆤𑆫𑆂 𑇆𑇓𑇓𑇆
𑆲𑆴𑆠𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆠𑆢𑇀𑆮𑆠𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆓𑆟𑆽𑆂 𑆑𑆸𑆠𑆩𑇀 𑇅 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑆠𑇀𑆫𑆽𑆦𑆬𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆑𑆛𑆶𑆑𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇆𑇓𑇔𑇆
𑆩𑆷𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆯𑆴𑆬𑆳𑆘𑆠𑆶 𑇅 𑆠𑆠𑆾 𑆲𑆤𑇀𑆠𑆴 𑆑𑆦𑆳𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆁 𑆱𑆩𑆼𑆢𑆱𑇀𑆑𑆁 𑆥𑇀𑆫𑆨𑆚𑇀𑆘𑆤𑆩𑇀 𑇆𑇓𑇕𑇆
𑆯𑆶𑆰𑇀𑆑𑆩𑆷𑆬𑆑𑆪𑆷𑆰𑆼𑆟 𑆥𑆛𑆾𑆬𑆱𑇀𑆪 𑆫𑆱𑆼𑆤 𑆮𑆳 𑇅 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆫𑆔𑆸𑆠𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆽𑆂 𑆯𑆳𑆑𑆽𑆯𑇀𑆖𑆳𑆬𑆮𑆟𑆽𑆫𑇀𑆲𑆴𑆠𑆽𑆂 𑇆𑇓𑇘𑇆
𑆪𑆢𑆳 𑆱𑇀𑆪𑆳𑆠𑆳𑆁 𑆥𑆫𑆴𑆑𑇀𑆰𑆵𑆟𑆼 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆼 𑆑𑆦𑆩𑆼𑆢𑆱𑆵 𑇅 𑆠𑆢𑆳 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆑𑆁 𑆑𑆫𑇀𑆩 𑆥𑆶𑆤𑆫𑆠𑇀𑆫𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇓𑇙𑇆
𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆂 𑆱𑆶𑆬𑆔𑆶𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆂 𑆑𑆛𑆶𑆑𑆾 𑆫𑆱𑆼 𑇅 𑆑𑆛𑆶𑆥𑆳𑆑𑆂 𑆱𑆫𑆾 𑆲𑆸𑆢𑇀𑆪𑆾 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆂 𑇆𑇔𑇐𑇆
𑆱 𑆤𑆮𑆾 𑆧𑆸𑆁𑆲𑆟𑆾 𑆮𑆸𑆰𑇀𑆪𑆂 𑆥𑆶𑆫𑆳𑆟𑆱𑇀𑆠𑇀𑆮𑆥𑆑𑆫𑇀𑆰𑆟𑆂 𑇅 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆂 𑆱𑆫𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆬𑆥𑆴𑆠𑇀𑆠𑆤𑆶𑆠𑇀 𑇆𑇔𑇑𑇆
𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆳𑆠𑇀 𑆥𑆷𑆠𑆴𑆑𑆾𑆰𑇀𑆜𑆔𑇀𑆤𑆂 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆤𑆬𑆢𑆵𑆥𑆤𑆂 𑇅 𑆠𑆁 𑆥𑇀𑆫𑆳𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆢𑆳𑆫𑇀𑆮𑆵𑆥𑆛𑆾𑆬𑆑𑆶𑆯𑆮𑆳𑆫𑆴𑆨𑆴𑆂 𑇆𑇔𑇒𑇆
𑆥𑆴𑆧𑆼𑆢𑆳𑆮𑆳𑆥𑇀𑆪 𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆽𑆂 𑆑𑇀𑆰𑆳𑆫𑆽𑆫𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆼𑆤 𑆮𑆳 𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆪𑆷𑆰𑆫𑆱𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆽𑆫𑇀𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆾 𑆲𑆤𑇀𑆠𑆴 𑆩𑆳𑆱𑆠𑆂 𑇆𑇔𑇓𑇆
𑆓𑆶𑆬𑇀𑆩𑆁 𑆩𑆼𑆲𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆩𑆶𑆢𑆫𑆁 𑆱𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑇀 𑇅 𑆑𑆸𑆩𑆴𑆑𑆟𑇀𑆝𑇀𑆮𑆫𑆶𑆖𑆴𑆯𑇀𑆮𑆴𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆁 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆩𑆼𑆮 𑆖 𑇆𑇔𑇔𑇆
𑆤𑆳𑆝𑇀𑆪𑆳𑆞𑇀𑆪𑆮𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆷𑆤𑇀 𑆑𑆶𑆰𑇀𑆜𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆳𑆁𑆯𑇀𑆖 𑆱𑆂 𑇅 𑆑𑆾𑆰𑇀𑆜𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆓𑆁 𑆮𑆳𑆪𑆶𑆁 𑆮𑆸𑆑𑇀𑆰𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑆤𑆴𑆫𑇀𑆪𑆡𑆳 𑇆𑇔𑇕𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆫𑇀𑆯𑆱𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾𑇁𑆫𑇀𑆯𑆱𑆳𑆁 𑆱𑆳𑆣𑆤𑆾𑆥𑆳𑆪𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆨𑆼𑆰𑆘𑆁 𑆑𑇀𑆰𑆳𑆫𑆾𑇁𑆓𑇀𑆤𑆴𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆃𑆖𑆴𑆫𑆑𑆳𑆬𑆘𑆳𑆠𑆳𑆤𑇀𑆪𑆬𑇀𑆥𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆟𑆴 𑆨𑆼𑆰𑆘𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴, 𑆩𑆸𑆢𑆶𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆮𑆓𑆳𑆞𑆳𑆤𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆑𑇀𑆰𑆳𑆫𑆼𑆟, 𑆑𑆫𑇀𑆑𑆯𑆱𑇀𑆡𑆴𑆫𑆥𑆸𑆡𑆶𑆑𑆜𑆴𑆤𑆳𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆤𑆳, 𑆠𑆤𑆶𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆑𑇀𑆬𑆼𑆢𑆮𑆤𑇀𑆠𑆴 𑆖 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑇅 𑆠𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆩𑆫𑇀𑆯𑆱𑆳𑆩𑆢𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆁 𑆖 𑆨𑆼𑆰𑆘𑆁 𑆨𑆮𑆠𑆴, 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑆶 𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆧𑆬𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑆶𑆫𑆩𑆫𑇀𑆯𑆾𑆨𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑆶𑆥𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆥𑆫𑆴𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆤𑆴𑆬𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆳𑆫𑇀𑆡𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆶𑆰𑇀𑆟𑆩𑆬𑇀𑆥𑆩𑆤𑇀𑆤𑆁 𑆢𑇀𑆫𑆮𑆥𑇀𑆫𑆳𑆪𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 𑆱𑆁𑆮𑆸(𑆨𑆸)𑆠𑆼 𑆯𑆶𑆖𑆿 𑆢𑆼𑆯𑆼 𑆱𑆳𑆣𑆳𑆫𑆟𑆼 𑆮𑇀𑆪𑆨𑇀𑆫𑆼 𑆑𑆳𑆬𑆼 𑆱𑆩𑆼 𑆦𑆬𑆑𑆼 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆮𑆳 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆢𑆴𑆠𑇀𑆪𑆓𑆶𑆢𑆩𑆤𑇀𑆪𑆱𑇀𑆪𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆼 𑆤𑆴𑆰𑆟𑇀𑆟𑆥𑆷𑆫𑇀𑆮𑆑𑆳𑆪𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆶𑆤𑇀𑆤𑆠𑆑𑆛𑆴𑆑𑆁 𑆮𑆱𑇀𑆠𑇀𑆫𑆑𑆩𑇀𑆧𑆬𑆑𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆯𑆳𑆛𑆑𑆼𑆤 𑆥𑆫𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑆑𑇀𑆡𑆴𑆁 𑆥𑆫𑆴𑆑𑆫𑇀𑆩𑆴𑆨𑆴𑆂 𑆱𑆶𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆩𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆯𑆫𑆵𑆫𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆠𑆾𑇁𑆱𑇀𑆩𑆽 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆓𑆶𑆢𑆳𑆪 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆸𑆘𑇀𑆮𑆤𑆶𑆩𑆶𑆒𑆁 𑆥𑆳𑆪𑆿 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆩𑆳𑆟𑆱𑇀𑆪 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪, 𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆼 𑆖𑆳𑆫𑇀𑆯𑆾 𑆮𑆵𑆑𑇀𑆰𑇀𑆪, 𑆯𑆬𑆳𑆑𑆪𑆾𑆠𑇀𑆥𑆵𑆝𑇀𑆪, 𑆥𑆴𑆖𑆶𑆮𑆱𑇀𑆠𑇀𑆫𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟 𑆥𑇀𑆫𑆩𑆸𑆘𑇀𑆪, 𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑆳𑆠𑆪𑆼𑆠𑇀; 𑆥𑆳𑆠𑆪𑆴𑆠𑇀𑆮𑆳 𑆖 𑆥𑆳𑆟𑆴𑆤𑆳 𑆪𑆤𑇀𑆠𑇀𑆫𑆢𑇀𑆮𑆳𑆫𑆁 𑆥𑆴𑆣𑆳𑆪 𑆮𑆳𑆑𑇀𑆖𑇀𑆗𑆠𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆩𑆸𑆘𑇀𑆪 𑆑𑇀𑆰𑆳𑆫𑆧𑆬𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆬𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆥𑆶𑆤𑆫𑆳𑆬𑆼𑆥𑆪𑆼𑆠𑇀, 𑆃𑆡𑆳𑆫𑇀𑆯𑆂 𑆥𑆑𑇀𑆮𑆘𑆳𑆩𑇀𑆧𑆮𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆯𑆩𑆮𑆱𑆤𑇀𑆤𑆩𑆵𑆰𑆤𑇀𑆤𑆠𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆾𑆥𑆳𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀, 𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆪𑆼𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆼𑆤 𑆢𑆣𑆴𑆩𑆱𑇀𑆠𑆶𑆯𑆶𑆑𑇀𑆠𑆦𑆬𑆳𑆩𑇀𑆬𑆽𑆫𑇀𑆮𑆳, 𑆠𑆠𑆾 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆩𑆴𑆯𑇀𑆫𑆼𑆟 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑇀𑆪 𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆥𑆤𑆵𑆪𑆾𑆠𑇀𑆡𑆳𑆥𑇀𑆪𑆳𑆠𑆶𑆫𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆁 𑆯𑆵𑆠𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆂 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆼𑆠𑇀, 𑆃𑆯𑆵𑆠𑆳𑆨𑆴𑆫𑆴𑆠𑇀𑆪𑆼𑆑𑆼, 𑆠𑆠𑆾 𑆤𑆴𑆫𑇀𑆮𑆳𑆠𑆩𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪𑆳𑆖𑆳𑆫𑆴𑆑𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀; 𑆱𑆳𑆮𑆯𑆼𑆰𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆲𑆼𑆠𑇀; 𑆍𑆮𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆼𑆑𑆽𑆑𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠; 𑆠𑆠𑇀𑆫 𑆧𑆲𑆶𑆰𑆶 𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆢𑇀𑆮𑆳𑆩𑆁, 𑆮𑆳𑆩𑆳𑆠𑇀 𑆥𑆸𑆰𑇀𑆜𑆘𑆁, 𑆠𑆠𑆾𑇁𑆓𑇀𑆫𑆘𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆑𑇀𑆰𑆳𑆫𑆼𑆟𑆽𑆮 𑆩𑆸𑆢𑆶𑆤𑆳 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆴 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪𑆩𑆤𑇀𑆤𑆫𑆶𑆖𑆴𑆫𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑇀𑆠𑆴𑆫𑇀𑆬𑆳𑆔𑆮𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆩𑆤𑆱𑇀𑆠𑆶𑆰𑇀𑆛𑆴𑆫𑆴𑆠𑆴 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴, 𑆃𑆠𑆴𑆢𑆓𑇀𑆣𑆼 𑆠𑆶 𑆓𑆶𑆢𑆳𑆮𑆢𑆫𑆟𑆁 𑆢𑆳𑆲𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆘𑇀𑆮𑆫𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆯𑇀𑆖𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆣𑇀𑆪𑆳𑆩𑆳𑆬𑇀𑆥𑆮𑇀𑆫𑆟𑆠𑆳 𑆑𑆟𑇀𑆝𑆷𑆫𑆤𑆴𑆬𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆥𑇀𑆫𑆱𑆳𑆢𑆾 𑆮𑆴𑆑𑆳𑆫𑆱𑇀𑆪 𑆖𑆳𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆲𑆵𑆤𑆢𑆓𑇀𑆣𑆼 𑇆𑇖𑇆
𑆩𑆲𑆳𑆤𑇀𑆠𑆴 𑆖 𑆥𑇀𑆫𑆳𑆟𑆮𑆠𑆯𑇀𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳 𑆢𑆲𑆼𑆠𑇀, 𑆤𑆴𑆫𑇀𑆓𑆠𑆳𑆤𑆴 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆾𑆰𑆥𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆢𑇀𑆮𑆴𑆤𑆳 𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆤𑆼𑆲𑆳𑆮𑆓𑆳𑆲𑆾𑆥𑆤𑆳𑆲𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆬𑆼𑆥𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆯𑆱𑇀𑆠𑇀𑆫𑆽𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀; 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆤𑆴 𑆖 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤, 𑆨𑆴𑆤𑇀𑆤𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴𑆖𑆳𑆠𑆵𑆱𑆳𑆫𑆮𑆴𑆣𑆳𑆤𑆼𑆤, 𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆳𑆁𑆱𑆴 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆮𑆳; 𑆍𑆰 𑆱𑆫𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆳𑆤𑆳𑆩𑆫𑇀𑆯𑆱𑆳𑆁 𑆢𑆲𑆤𑆑𑆬𑇀𑆥𑆂 𑇆𑇗𑇆
𑆄𑆱𑆳𑆢𑇀𑆪 𑆖 𑆢𑆫𑇀𑆮𑆵𑆑𑆷𑆫𑇀𑆖𑆑𑆯𑆬𑆳𑆑𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑆳𑆠𑆪𑆼𑆠𑇀 𑇅 𑆨𑇀𑆫𑆰𑇀𑆛𑆓𑆶𑆢𑆱𑇀𑆪 𑆠𑆶 𑆮𑆴𑆤𑆳 𑆪𑆤𑇀𑆠𑇀𑆫𑆼𑆟 𑆑𑇀𑆰𑆳𑆫𑆳𑆢𑆴𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆖 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆳𑆤𑇀𑆤𑆁 𑆱𑆫𑇀𑆥𑆴𑆂𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑆥𑆪𑆱𑆳 𑆤𑆴𑆩𑇀𑆧𑆪𑆷𑆰𑆼𑆟 𑆥𑆛𑆾𑆬𑆪𑆷𑆰𑆼𑆟 𑆮𑆳, 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆯𑆳𑆑𑆽𑆫𑇀𑆮𑆳𑆱𑇀𑆠𑆷𑆑𑆠𑆟𑇀𑆝𑆶𑆬𑆵𑆪𑆑𑆘𑆵𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆾𑆢𑆴𑆑𑆳𑆯𑇀𑆮𑆧𑆬𑆳𑆧𑆳𑆬𑆩𑆷𑆬𑆑𑆥𑆳𑆬𑆕𑇀𑆑𑇀𑆪𑆱𑆤𑆖𑆴𑆬𑇀𑆬𑆵𑆖𑆶𑆖𑇀𑆖𑆷𑆑𑆬𑆳𑆪𑆮𑆬𑇀𑆬𑆵𑆨𑆴𑆫𑆤𑇀𑆪𑆽𑆫𑇀𑆮𑆳 𑇅 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆩𑆫𑇀𑆯𑆾𑆔𑇀𑆤𑆁 𑆱𑆸𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆁 𑆖 𑆠𑆢𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑇆𑇘𑇆
𑆢𑆓𑇀𑆣𑆼𑆰𑆶 𑆖𑆳𑆫𑇀𑆯𑆂𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆾𑇁𑆤𑆬𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆩𑆤𑆴𑆬𑆥𑇀𑆫𑆑𑆾𑆥𑆱𑆁𑆫𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁 𑆖 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆳𑆫𑇀𑆯𑆂𑆱𑆶 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆖 𑆮𑆳𑆠𑆲𑆫𑆢𑆵𑆥𑆤𑆵𑆪𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆴 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆥𑆴𑆠𑇀𑆠𑆳𑆫𑇀𑆯𑆂𑆱𑆶 𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆰𑆳𑆪𑆼𑆟 𑆢𑆵𑆥𑆤𑆵𑆪𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 , 𑆯𑆾𑆟𑆴𑆠𑆳𑆫𑇀𑆯𑆂𑆱𑆶 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆶𑆫𑆶𑆕𑇀𑆓𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆰𑆳𑆪𑆼 𑆥𑆳𑆖𑆪𑆼𑆠𑇀, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆫𑇀𑆯𑆂𑆱𑆶 𑆱𑆶𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆰𑆳𑆪𑆼 𑇅 𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆁𑆯𑇀𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇙𑇆
𑆥𑆫𑆁 𑆖 𑆪𑆠𑇀𑆤𑆩𑆳𑆱𑇀𑆡𑆳𑆪 𑆓𑆶𑆢𑆼 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀, 𑆠𑆢𑇀𑆮𑆴𑆨𑇀𑆫𑆩𑆳𑆢𑇀𑆣𑆴 𑆰𑆳𑆟𑇀𑆞𑇀𑆪𑆯𑆾𑆦𑆢𑆳𑆲𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆛𑆾𑆥𑆳𑆤𑆳𑆲𑆳𑆠𑆵𑆱𑆳𑆫𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆩𑆫𑆟𑆁 𑆮𑆳 𑇆𑇑𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆪𑆤𑇀𑆠𑇀𑆫𑆁 𑆬𑆿𑆲𑆁 𑆢𑆳𑆤𑇀𑆠𑆁 𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆁 𑆮𑆳𑆫𑇀𑆑𑇀𑆰𑆁 𑆮𑆳 𑆓𑆾𑆱𑇀𑆠𑆤𑆳𑆑𑆳𑆫𑆁 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆁 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆥𑆶𑆁𑆱𑆳𑆁, 𑆰𑆝𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆤𑆳𑆫𑆵𑆟𑆳𑆁 𑆠𑆬𑆳𑆪𑆠𑆁; 𑆠𑆢𑇀 𑆢𑇀𑆮𑆴𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆁 𑆢𑆫𑇀𑆯𑆤𑆳𑆫𑇀𑆡𑆩𑇀, 𑆍𑆑𑆗𑆴𑆢𑇀𑆫𑆁 𑆠𑆶 𑆑𑆫𑇀𑆩𑆟𑆴; 𑆍𑆑𑆢𑇀𑆮𑆳𑆫𑆼 𑆲𑆴 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆵𑆤𑆳𑆩𑆠𑆴𑆑𑇀𑆫𑆩𑆾 𑆤 𑆨𑆮𑆠𑆴; 𑆗𑆴𑆢𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆠𑆶 𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆩𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆾𑆢𑆫𑆥𑆫𑆴𑆟𑆳𑆲𑆁, 𑆪𑆢𑆕𑇀𑆓𑆶𑆬𑆩𑆮𑆯𑆴𑆰𑇀𑆛𑆁 𑆠𑆱𑇀𑆪𑆳𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆢𑆣𑆱𑇀𑆠𑆳𑆢𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆾𑆥𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑆑𑆫𑇀𑆟𑆴𑆑𑆩𑇀; 𑆍𑆰 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆑𑆸𑆠𑆴𑆱𑆩𑆳𑆱𑆂 𑇆𑇑𑇑𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆫𑇀𑆯𑆱𑆳𑆩𑆳𑆬𑆼𑆥𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆖𑆷𑆫𑇀𑆟𑆩𑆳𑆬𑆼𑆥𑆂 𑆥𑇀𑆫𑆡𑆩𑆂, 𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆥𑆶𑆫𑆵𑆰𑆓𑆶𑆚𑇀𑆘𑆳𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆷𑆫𑇀𑆟𑆩𑆴𑆠𑆴 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆥𑆴𑆰𑇀𑆛𑆾 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆂, 𑆢𑆤𑇀𑆠𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑆶𑆮𑆫𑇀𑆖𑆴𑆑𑆳𑆬𑆳𑆕𑇀𑆓𑆬𑆵𑆑𑆬𑇀𑆑𑆾 𑆮𑆳 𑆓𑆾𑆥𑆴𑆠𑇀𑆠𑆥𑆴𑆰𑇀𑆛𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆂, 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆽𑆤𑇀𑆣𑆮𑆑𑆶𑆰𑇀𑆜𑆯𑆴𑆫𑆵𑆰𑆦𑆬𑆑𑆬𑇀𑆑𑆂 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆾𑇁𑆫𑇀𑆑𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆾 𑆮𑆳 𑆖𑆠𑆶𑆫𑇀𑆡𑆂, 𑆑𑆳𑆱𑆵𑆱𑆲𑆫𑆴𑆠𑆳𑆬𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆯𑇀𑆮𑆩𑆳𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆷𑆠𑆵𑆑𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆘𑆩𑇀𑆧𑇀𑆮𑆫𑇀𑆑𑆾𑆠𑇀𑆠𑆩𑆳𑆫𑆟𑆵𑆢𑆤𑇀𑆠𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆬𑆫𑇀𑆑𑆱𑇀𑆤𑆶𑆲𑆵𑆥𑆪𑆂𑆱𑆶 𑆠𑆽𑆬𑆁 𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆼𑆤𑆳𑆫𑇀𑆯𑆂 𑆯𑆳𑆠𑆪𑆠𑆴 𑇆𑇑𑇒𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆨𑆼𑆰𑆘𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑇀𑆮𑆢𑆸𑆯𑇀𑆪𑆼𑆰𑇀𑆮𑆫𑇀𑆯𑆂𑆱𑆶 𑆪𑆾𑆓𑆳𑆤𑇀 𑆪𑆳𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆓𑆶𑆝𑆲𑆫𑆵𑆠𑆑𑆵𑆩𑆳𑆱𑆼𑆮𑆼𑆠, 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆵 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆢𑇀𑆫𑆾𑆟𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆲𑆫𑆵𑆠𑆑𑆵𑆯𑆠𑆁 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆪𑆡𑆳𑆧𑆬𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟, 𑆃𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆩𑆷𑆬𑆁 𑆮𑆳 𑆠𑆟𑇀𑆝𑆶𑆬𑆾𑆢𑆑𑆼𑆤 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆲𑆫𑆲𑆂, 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆼𑆟, 𑆖𑆴𑆠𑇀𑆫𑆑𑆖𑆷𑆫𑇀𑆟𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆱𑆵𑆣𑆶𑆁 𑆥𑆫𑆳𑆫𑇀𑆣𑇀𑆪𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆖𑆷𑆫𑇀𑆟𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆱𑆑𑇀𑆠𑆶𑆩𑆤𑇀𑆡𑆩𑆬𑆮𑆟𑆁 𑆠𑆑𑇀𑆫𑆼𑆟, 𑆑𑆬𑆯𑆼 𑆮𑆳𑇁𑆤𑇀𑆠𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆳𑆮𑆬𑆴𑆥𑇀𑆠𑆼 𑆤𑆴𑆰𑆴𑆑𑇀𑆠𑆁 𑆠𑆑𑇀𑆫𑆩𑆩𑇀𑆬𑆩𑆤𑆩𑇀𑆬𑆁 𑆮𑆳 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆼𑆰𑆷𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆍𑆰 𑆍𑆮 𑆨𑆳𑆫𑇀𑆓𑇀𑆪𑆳𑆱𑇀𑆦𑆾𑆠𑆳𑆪𑆮𑆳𑆤𑇀𑆪𑆳𑆩𑆬𑆑𑆓𑆶𑆝𑆷𑆖𑆵𑆰𑆶 𑆠𑆑𑇀𑆫𑆑𑆬𑇀𑆥𑆂, 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑆶𑆟𑇀𑆜𑆵𑆲𑆫𑆵𑆠𑆑𑆵𑆰𑆶 𑆖 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆼𑆮, 𑆤𑆴𑆫𑆤𑇀𑆤𑆾 𑆮𑆳 𑆠𑆑𑇀𑆫𑆩𑆲𑆫𑆲𑆫𑇀𑆩𑆳𑆱𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠, 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆥𑆪𑆂, 𑆑𑆶𑆛𑆘𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀𑆦𑆳𑆟𑆴𑆠𑆁 𑆮𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟, 𑆩𑆲𑆳𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑆠𑆑𑇀𑆫𑆳𑆲𑆳𑆫𑆂 𑆑𑇀𑆰𑆵𑆫𑆳𑆲𑆳𑆫𑆾 𑆮𑆳, 𑆑𑇀𑆰𑆳𑆫𑆬𑆮𑆟𑆳𑆁𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆮𑆳 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆥𑆪𑆂 𑆥𑆬𑆳𑆯𑆠𑆫𑆷𑆑𑇀𑆰𑆳𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆥𑆬𑆳𑆯𑆠𑆫𑆷𑆑𑇀𑆰𑆳𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆮𑆳 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆤𑇀, 𑆥𑆳𑆛𑆬𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆧𑆸𑆲𑆠𑆵𑆥𑆬𑆳𑆯𑆑𑇀𑆰𑆳𑆫𑆁 𑆮𑆳 𑆥𑆫𑆴𑆱𑇀𑆤𑆶𑆠𑆩𑆲𑆫𑆲𑆫𑇀𑆔𑆸𑆠𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁, 𑆑𑆶𑆛𑆘𑆧𑆤𑇀𑆢𑆳𑆑𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆠𑆑𑇀𑆫𑆼𑆟, 𑆖𑆴𑆠𑇀𑆫𑆑𑆥𑆷𑆠𑆵𑆑𑆤𑆳𑆓𑆫𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆥𑆷𑆠𑆵𑆑𑆑𑇀𑆰𑆳𑆫𑆼𑆟, 𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁, 𑆑𑆸𑆰𑇀𑆟𑆠𑆴𑆬𑆥𑇀𑆫𑆱𑆸𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆚𑇀𑆖𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑆯𑆵𑆠𑆾𑆢𑆑𑆳𑆤𑆶𑆥𑆳𑆤𑆩𑇀; 𑆍𑆨𑆴𑆫𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼𑇁𑆓𑇀𑆤𑆴𑆫𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆖𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑇆𑇑𑇓𑇆
𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆢𑆤𑇀𑆠𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆥𑆡𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑆶𑆬𑆳𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆘𑆬𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆫𑆾𑆟𑆼 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆥𑆳𑆢𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆁 𑆑𑆰𑆳𑆪𑆩𑆳𑆢𑆳𑆪 𑆱𑆶𑆯𑆵𑆠𑆁 𑆓𑆶𑆝𑆠𑆶𑆬𑆪𑆳 𑆱𑆲𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑇀𑆪 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆼 𑆤𑆴𑆂𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆩𑆳𑆱𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠 𑆪𑆮𑆥𑆬𑇀𑆬𑆼, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆳𑆪𑆪𑆼𑆠, 𑆠𑆼𑆤𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆫𑆾𑆖𑆑𑆳 𑆤 𑆨𑆮𑆤𑇀𑆠𑆴 𑆢𑆵𑆥𑇀𑆠𑆯𑇀𑆖𑆳𑆓𑇀𑆤𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇑𑇔𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆮𑆴𑆝𑆕𑇀𑆓𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆬𑆾𑆣𑇀𑆫𑆳𑆟𑆳𑆁 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆬𑆼, 𑆅𑆤𑇀𑆢𑇀𑆫𑆮𑆳𑆫𑆶𑆟𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖 𑆥𑆬𑆳𑆤𑆴, 𑆑𑆥𑆴𑆠𑇀𑆡𑆩𑆣𑇀𑆪𑆱𑇀𑆪 𑆢𑆯, 𑆥𑆡𑇀𑆪𑆳𑆦𑆬𑆳𑆤𑆳𑆩𑆫𑇀𑆣𑆥𑇀𑆫𑆱𑇀𑆡𑆂, 𑆥𑇀𑆫𑆱𑇀𑆡𑆾 𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆳𑆤𑆳𑆁, 𑆍𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆘𑆬𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆫𑆾𑆟𑆼 𑆮𑆴𑆥𑆳𑆖𑇀𑆪, 𑆥𑆳𑆢𑆳𑆮𑆯𑆼𑆰𑆁 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪, 𑆱𑆶𑆯𑆵𑆠𑆁 𑆓𑆶𑆝𑆠𑆶𑆬𑆳𑆢𑇀𑆮𑆪𑆼𑆤𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑇀𑆪, 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆼 𑆤𑆴𑆂𑆑𑇀𑆰𑆴𑆥𑇀𑆪, 𑆥𑆑𑇀𑆰𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠 𑆪𑆮𑆥𑆬𑇀𑆬𑆼; 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇅 𑆍𑆰 𑆒𑆬𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆬𑆵𑆲𑆳𑆓𑇀𑆤𑆴𑆰𑆕𑇀𑆓𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆲𑆸𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆯𑆾𑆦𑆑𑆶𑆰𑇀𑆜𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆑𑆸𑆩𑆴𑆲𑆫𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆑𑆫𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆥𑇀𑆫𑆳𑆪𑆼𑆰𑆶 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆁, 𑆥𑆴𑆠𑇀𑆠𑆘𑆼𑆰𑆶 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀, 𑆍𑆮𑆁 𑆫𑆑𑇀𑆠𑆘𑆼𑆰𑆶 𑆱𑆁𑆯𑆩𑆤𑆁, 𑆑𑆦𑆘𑆼𑆰𑆶 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆑𑆶𑆬𑆠𑇀𑆡𑆾𑆥𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆲𑆫𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆱𑆫𑇀𑆮𑆘𑆼𑆰𑆶, 𑆪𑆡𑆳𑆱𑇀𑆮𑆿𑆰𑆣𑆴𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆥𑆪𑆂 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆴𑆠𑆴 𑇆𑇑𑇖𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑆴 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆳𑆤𑇀𑆪𑆤𑆶𑆥𑆲𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑇀𑆪 𑆠𑆠 𑆍𑆑𑆩𑆳𑆢𑆳𑆪 𑆢𑇀𑆮𑆴𑆣𑆳 𑆠𑇀𑆫𑆴𑆣𑆳 𑆖𑆠𑆶𑆫𑇀𑆣𑆳 𑆮𑆳 𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆠𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆱𑇀𑆪 𑆯𑆶𑆑𑇀𑆠𑆴𑆩𑆤𑆶𑆰𑇀𑆟𑆳𑆁 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆠𑆳𑆬𑆶𑆘𑆴𑆲𑇀𑆮𑆿𑆰𑇀𑆜𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆥𑆱𑆼𑆮𑆼𑆠, 𑆠𑆠𑆾𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂; 𑆍𑆮𑆩𑆼𑆑𑆽𑆑𑆁 𑆮𑆫𑇀𑆣𑆪𑆼𑆢𑇀𑆪𑆳𑆮𑆠𑇀 𑆥𑆚𑇀𑆖𑆠𑆴, 𑆠𑆠𑆂 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆢𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆥𑇀𑆠𑆠𑆴𑆫𑆴𑆠𑆴, 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆖 𑆱𑆥𑇀𑆠𑆠𑆴𑆩𑆥𑆑𑆫𑇀𑆰𑆪𑆼𑆢𑇀𑆨𑆷𑆪𑆂 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖 𑆪𑆳𑆮𑆠𑇀 𑆥𑆚𑇀𑆖𑆼𑆠𑆴, 𑆥𑆚𑇀𑆖𑆨𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆼𑆑𑆽𑆑𑆁 𑆪𑆳𑆮𑆢𑆼𑆑𑆩𑆴𑆠𑆴 𑇅 𑆍𑆮𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆱𑆲𑆱𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆱𑆫𑇀𑆮𑆑𑆶𑆰𑇀𑆜𑆳𑆫𑇀𑆯𑆾𑆨𑆴𑆫𑇀𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆾 𑆧𑆬𑆮𑆳𑆤𑆫𑆾𑆓𑆂 𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇑𑇗𑇆
𑆢𑇀𑆮𑆴𑆮𑇀𑆫𑆟𑆵𑆪𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆤𑆴𑆯𑇀𑆖𑇀𑆪𑆶𑆠𑆴𑆠𑆁 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆢𑆳𑆪 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆯𑆶𑆑𑇀𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆳𑆲𑆳𑆫𑆂 𑆦𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆯𑇀𑆖 𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆩𑆘𑇀𑆘𑆨𑇀𑆪𑆾 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆢𑆳𑆪𑆳𑆥𑆑𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆨𑆑𑇀𑆠𑆾 𑆤𑆴𑆮𑆳𑆠𑆩𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆪𑆡𑆳𑆧𑆬𑆁 𑆥𑇀𑆫𑆱𑆸𑆠𑆴𑆁 𑆥𑇀𑆫𑆑𑆶𑆚𑇀𑆖𑆁 𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆠𑆱𑇀𑆩𑆴𑆚𑇀𑆘𑆵𑆫𑇀𑆟𑆼 𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆍𑆮𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆩𑆳𑆱𑆠𑇀𑆫𑆪𑆩𑆳𑆢𑆴𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆾 𑆫𑆑𑇀𑆰𑆼𑆢𑆳𑆠𑇀𑆩𑆳𑆤𑆁; 𑆠𑆠𑆂 𑆱𑆫𑇀𑆮𑆾𑆥𑆠𑆳𑆥𑆳𑆤𑆥𑆲𑆸𑆠𑇀𑆪 𑆮𑆫𑇀𑆟𑆮𑆳𑆤𑇀 𑆧𑆬𑆮𑆳𑆚𑇀 𑆯𑇀𑆫𑆮𑆟𑆓𑇀𑆫𑆲𑆟𑆣𑆳𑆫𑆟𑆯𑆑𑇀𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆾 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴, 𑆩𑆳𑆱𑆼 𑆩𑆳𑆱𑆼 𑆖 𑆥𑇀𑆫𑆪𑆾𑆓𑆼 𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆳𑆪𑆶𑆰𑆾𑇁𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴, 𑆍𑆮𑆁 𑆢𑆯𑆩𑆳𑆱𑆳𑆤𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆮𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇑𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆲𑆠𑆂 𑆒𑆢𑆴𑆫𑆧𑆵𑆘𑆑𑆿 𑇅 𑆠𑆡𑆽𑆮𑆳𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆮𑆸𑆑𑇀𑆰𑆑𑆳𑆫𑆶𑆰𑇀𑆑𑆫𑆿 𑆲𑆠𑆂 𑇆𑇑𑇙𑇆
𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆅𑆮 𑆰𑆾𑆝𑆯 𑇅 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆵 𑆤𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆠𑆡𑆳 𑆢𑆸𑆯𑇀𑆪𑆳 𑆓𑆶𑆢𑆾𑆢𑇀𑆨𑆮𑆳𑆂 𑇆𑇒𑇐𑇆
𑆔𑆸𑆠𑆳𑆤𑆴 𑆢𑆵𑆥𑆤𑆵𑆪𑆳𑆤𑆴 𑆬𑆼𑆲𑆳𑆪𑆱𑇀𑆑𑆸𑆠𑆪𑆂 𑆱𑆶𑆫𑆳𑆂 𑇅 𑆄𑆱𑆮𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆴𑆩𑇀 𑇆𑇒𑇑𑇆
𑆮𑆼𑆓𑆳𑆮𑆫𑆾𑆣𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆸𑆰𑇀𑆜𑆪𑆳𑆤𑆳𑆤𑇀𑆪𑆶𑆠𑇀𑆑𑆶𑆛𑆶𑆑𑆳𑆱𑆤𑆩𑇀 𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆢𑆾𑆰𑆬𑆁 𑆖𑆳𑆤𑇀𑆤𑆩𑆫𑇀𑆯𑆂𑆱𑆶 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆯𑇀𑆩𑆫𑆵𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆯𑇀𑆩𑆫𑆵 𑆢𑆳𑆫𑆶𑆟𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆤𑇀𑆠𑆑𑆥𑇀𑆫𑆠𑆴𑆩𑆾 𑆩𑆠𑆂 𑇅 𑆐𑆰𑆣𑆽𑆱𑇀𑆠𑆫𑆶𑆟𑆂 𑆱𑆳𑆣𑇀𑆪𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆯𑇀𑆗𑆼𑆢𑆩𑆫𑇀𑆲𑆠𑆴 𑇆𑇓𑇆
𑆠𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆼𑆰𑆶 𑆫𑆷𑆥𑆼𑆰𑆶 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆑𑇀𑆫𑆩 𑆅𑆰𑇀𑆪𑆠𑆼 𑇅 𑆠𑆼𑆤𑆳𑆱𑇀𑆪𑆳𑆥𑆖𑆪𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆯𑆼𑆰𑆠𑆂 𑇆𑇔𑇆

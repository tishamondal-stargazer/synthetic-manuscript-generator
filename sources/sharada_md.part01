𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆵 𑆱𑇀𑆫𑆮𑆠𑆴 𑆯𑇀𑆮𑆼𑆠𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆧𑆲𑆬𑆁 𑆧𑆲𑆶𑇅 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆫𑇀𑆮𑆩𑆼𑆮𑆽𑆠𑆢𑇀𑆨𑆘𑆠𑆼 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆵𑇆𑇑𑇐𑇐𑇆
𑆃𑆡𑆳𑆱𑆳𑆁 𑆮𑆴𑆢𑇀𑆫𑆣𑆵𑆤𑆳𑆁 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆱𑇀𑆡𑆳𑆤𑆑𑆸𑆠𑆁 𑆬𑆴𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆫𑇀𑆩𑆘𑆳𑆪𑆳𑆁 𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆳𑆁 𑆲𑆸𑆢𑇀𑆣𑆛𑇀𑆛𑆤𑆠𑆩𑆑𑆥𑇀𑆫𑆩𑆾𑆲𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆂, 𑆑𑇀𑆬𑆾𑆩𑆘𑆳𑆪𑆳𑆁 𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆶𑆒𑆯𑆾𑆰𑆓𑆬𑆓𑇀𑆫𑆲𑆳𑆂, 𑆪𑆑𑆸𑆘𑇀𑆘𑆳𑆪𑆳𑆁 𑆯𑇀𑆮𑆳𑆱𑆂, 𑆥𑇀𑆬𑆵𑆲𑆘𑆳𑆪𑆳𑆩𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆾𑆥𑆫𑆾𑆣𑆂, 𑆑𑆶𑆑𑇀𑆰𑆴𑆘𑆳𑆪𑆳𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆤𑇀𑆠𑆫𑆳𑆁𑆱𑆯𑆷𑆬𑆁, 𑆮𑆸𑆑𑇀𑆑𑆘𑆳𑆪𑆳𑆁 𑆥𑆸𑆰𑇀𑆜𑆑𑆛𑆴𑆓𑇀𑆫𑆲𑆂, 𑆤𑆳𑆨𑆴𑆘𑆳𑆪𑆳𑆁 𑆲𑆴𑆑𑇀𑆑𑆳, 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆘𑆳𑆪𑆳𑆁 𑆱𑆑𑇀𑆡𑆴𑆱𑆳𑆢𑆂, 𑆧𑆱𑇀𑆠𑆴𑆘𑆳𑆪𑆳𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆥𑆷𑆠𑆴𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴𑇆𑇑𑇐𑇑𑇆
𑆥𑆑𑇀𑆮𑆥𑇀𑆫𑆨𑆴𑆤𑇀𑆤𑆳𑆱𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆳𑆱𑆶 𑆩𑆶𑆒𑆳𑆠𑇀 𑆱𑇀𑆫𑆳𑆮𑆂 𑆱𑇀𑆫𑆮𑆠𑆴, 𑆃𑆣𑆾𑆘𑆳𑆱𑆶 𑆓𑆶𑆢𑆳𑆠𑇀, 𑆇𑆨𑆪𑆠𑆱𑇀𑆠𑆶 𑆤𑆳𑆨𑆴𑆘𑆳𑆱𑆶𑇆𑇑𑇐𑇒𑇆
𑆄𑆱𑆳𑆁 𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆧𑆱𑇀𑆠𑆴𑆘𑆳𑆂 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆳𑆂 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆵 𑆖 𑆩𑆫𑆟𑆳𑆪; 𑆯𑆼𑆰𑆳𑆂 𑆥𑆶𑆤𑆂 𑆑𑆶𑆯𑆬𑆩𑆳𑆯𑆶𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆴𑆟𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆩𑆳𑆱𑆳𑆢𑇀𑆪𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆳𑆁 𑆮𑆴𑆢𑇀𑆫𑆣𑆵𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆫𑇀𑆥𑆮𑆴𑆢𑇀𑆪𑆶𑆢𑆓𑇀𑆤𑆴𑆠𑆶𑆬𑇀𑆪𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆫𑆳𑆯𑇀𑆮𑆼𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆯𑆾 𑆓𑆶𑆬𑇀𑆩𑆮𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇐𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆴𑆤𑆳 𑆥𑇀𑆫𑆩𑆼𑆲𑆩𑆥𑇀𑆪𑆼𑆠𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆢𑆶𑆰𑇀𑆛𑆩𑆼𑆢𑆱𑆂𑇅 𑆠𑆳𑆮𑆖𑇀𑆖𑆽𑆠𑆳 𑆤 𑆬𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆳𑆮𑆢𑇀𑆮𑆳𑆱𑇀𑆠𑆶𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆂𑇆𑇑𑇐𑇔𑇆
𑆯𑆫𑆳𑆮𑆴𑆑𑆳 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳 𑆘𑆳𑆬𑆴𑆤𑆵 𑆖𑆼𑆠𑆴 𑆢𑆶𑆂𑆱𑆲𑆳𑆂𑇅 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆠𑆳 𑆲𑇀𑆪𑆠𑆴𑆧𑆬𑆳𑆂 𑆥𑇀𑆫𑆨𑆷𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆼𑆢𑆱𑆂𑇆𑇑𑇐𑇕𑇆
𑆱𑆫𑇀𑆰𑆥𑆵 𑆖𑆳𑆬𑆘𑆵 𑆖𑆽𑆮 𑆮𑆴𑆤𑆠𑆳 𑆮𑆴𑆢𑇀𑆫𑆣𑆵 𑆖 𑆪𑆳𑆂𑇅 𑆱𑆳𑆣𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆾𑆬𑇀𑆧𑆟𑆳𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆬𑇀𑆥𑆩𑆼𑆢𑆱𑆂𑇆𑇑𑇐𑇖𑇆
𑆩𑆫𑇀𑆩𑆱𑇀𑆮𑆁𑆱𑆼 𑆓𑆶𑆢𑆼 𑆥𑆳𑆟𑇀𑆪𑆾𑆂 𑆱𑇀𑆠𑆤𑆼 𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆥𑆳𑆢𑆪𑆾𑆂𑇅 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆪𑆱𑇀𑆪 𑆥𑆴𑆝𑆴𑆑𑆳𑆂 𑆱 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆤 𑆘𑆵𑆮𑆠𑆴𑇆𑇑𑇐𑇗𑇆
𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆳𑆂 𑆥𑆴𑆝𑆑𑆳𑆂 𑆱𑆤𑇀𑆠𑆴 𑆫𑆑𑇀𑆠𑆥𑆵𑆠𑆳𑆱𑆴𑆠𑆳𑆫𑆶𑆟𑆳𑆂𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆳𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆫𑇀𑆟𑆳𑆯𑇀𑆖 𑆨𑆱𑇀𑆩𑆳𑆨𑆳 𑆩𑆼𑆖𑆑𑆥𑇀𑆫𑆨𑆳𑆂𑇆𑇑𑇐𑇘𑇆
𑆩𑆸𑆢𑇀𑆮𑇀𑆪𑆯𑇀𑆖 𑆑𑆜𑆴𑆤𑆳𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆂 𑆱𑇀𑆡𑆷𑆬𑆳𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆥𑆫𑆳𑆂𑇅 𑆩𑆤𑇀𑆢𑆮𑆼𑆓𑆳 𑆩𑆲𑆳𑆮𑆼𑆓𑆳𑆂 𑆱𑇀𑆮𑆬𑇀𑆥𑆯𑆷𑆬𑆳 𑆩𑆲𑆳𑆫𑆶𑆘𑆂𑇆𑇑𑇐𑇙𑇆
𑆠𑆳 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆩𑆳𑆫𑆶𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆽𑆫𑇀𑆲𑆼𑆠𑆶𑆬𑆑𑇀𑆰𑆟𑆽𑆂𑇅 𑆧𑇀𑆫𑆷𑆪𑆳𑆢𑆶𑆥𑆖𑆫𑆼𑆖𑇀𑆖𑆳𑆯𑆶 𑆥𑇀𑆫𑆳𑆓𑆶𑆥𑆢𑇀𑆫𑆮𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀𑇆𑇑𑇑𑇐𑇆
𑆠𑆸𑆛𑇀𑆯𑇀𑆮𑆳𑆱𑆩𑆳𑆁𑆱𑆱𑆕𑇀𑆑𑆾𑆡𑆩𑆾𑆲𑆲𑆴𑆑𑇀𑆑𑆳𑆩𑆢𑆘𑇀𑆮𑆫𑆳𑆂𑇅 𑆮𑆵𑆱𑆫𑇀𑆥𑆩𑆫𑇀𑆩𑆱𑆁𑆫𑆾𑆣𑆳𑆂 𑆥𑆴𑆝𑆑𑆳𑆤𑆳𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂𑇆𑇑𑇑𑇑𑇆
𑆑𑇀𑆰𑆪𑆂 𑆱𑇀𑆡𑆳𑆤𑆁 𑆖 𑆮𑆸𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆓𑆠𑆴𑆂𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆳𑆣𑆯𑇀𑆖 𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆖 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑇁𑆥𑆫𑆳𑇆𑇑𑇑𑇒𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆖𑆳𑆥𑆫𑆳 𑆑𑆾𑆰𑇀𑆜𑆯𑆳𑆒𑆳𑆩𑆫𑇀𑆩𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆰𑆶𑇅 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆼𑆤 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆓𑆠𑆴𑆂𑇆𑇑𑇑𑇓𑇆
𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆥𑇀𑆫𑆯𑆩𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆼𑆑𑆽𑆑𑆯𑆂 𑆰𑆛𑇀𑆱𑆶 𑆑𑆳𑆬𑆼𑆰𑇀𑆮𑆨𑇀𑆫𑆳𑆓𑆩𑆳𑆢𑆴𑆰𑆶𑇆𑇑𑇑𑇔𑇆
𑆓𑆠𑆴𑆂 𑆑𑆳𑆬𑆑𑆸𑆠𑆳 𑆖𑆽𑆰𑆳 𑆖𑆪𑆳𑆢𑇀𑆪𑆳 𑆥𑆶𑆤𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇅𑇑𑇑𑇕𑇅 𑆓𑆠𑆴𑆯𑇀𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆢𑆸𑆰𑇀𑆛𑆳 𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆵 𑆮𑆽𑆑𑆸𑆠𑆵 𑆖 𑆪𑆳𑇆𑇑𑇑𑇕𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆼𑆮𑆾𑆰𑇀𑆩𑆟𑆂 𑆥𑆑𑇀𑆠𑆴𑆫𑇀𑆤𑆫𑆳𑆟𑆳𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆠𑆖𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆑𑆶𑆫𑆶𑆠𑆼 𑆧𑆲𑆷𑆤𑇀𑇆𑇑𑇑𑇖𑇆
𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆱𑇀𑆠𑆶 𑆧𑆬𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆮𑆴𑆑𑆸𑆠𑆾 𑆩𑆬 𑆇𑆖𑇀𑆪𑆠𑆼𑇅 𑆱 𑆖𑆽𑆮𑆿𑆘𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑆑𑆳𑆪𑆼 𑆱 𑆖 𑆥𑆳𑆥𑇀𑆩𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇑𑇑𑇗𑇆
𑆱𑆫𑇀𑆮𑆳 𑆲𑆴 𑆖𑆼𑆰𑇀𑆛𑆳 𑆮𑆳𑆠𑆼𑆤 𑆱 𑆥𑇀𑆫𑆳𑆟𑆂 𑆥𑇀𑆫𑆳𑆟𑆵𑆤𑆳𑆁 𑆱𑇀𑆩𑆸𑆠𑆂𑇅 𑆠𑆼𑆤𑆽𑆮 𑆫𑆾𑆓𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆠𑆼𑆤 𑆖𑆽𑆮𑆾𑆥𑆫𑆶𑆣𑇀𑆪𑆠𑆼𑇆𑇑𑇑𑇘𑇆
𑆤𑆴𑆠𑇀𑆪𑆁 𑆱𑆤𑇀𑆤𑆴𑆲𑆴𑆠𑆳𑆩𑆴𑆠𑇀𑆫𑆁 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆠𑇀𑆩𑆮𑆳𑆤𑇀𑇅 𑆤𑆴𑆠𑇀𑆪𑆁 𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑆫𑆴𑆖𑆫𑆼𑆢𑆴𑆖𑇀𑆗𑆤𑇀𑆤𑆳𑆪𑆶𑆫𑆤𑆴𑆠𑇀𑆮𑆫𑆩𑇀𑇆𑇑𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆂 𑆱𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆳 𑆫𑆾𑆓𑆳 𑆩𑆳𑆤𑆮𑆴𑆑𑆬𑇀𑆥𑆘𑆳𑆂𑇅 𑆑𑇀𑆰𑆪𑆳𑆂 𑆱𑆥𑆴𑆝𑆑𑆳𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆓𑆠𑆴𑆫𑆼𑆮 𑆖𑇆𑇑𑇒𑇐𑇆
𑆑𑆴𑆪𑆤𑇀𑆠𑆂𑆯𑆴𑆫𑆱𑆵𑆪𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆣𑇀𑆪𑆳𑆪𑆼 𑆠𑆠𑇀𑆠𑇀𑆮𑆢𑆫𑇀𑆯𑆴𑆤𑆳𑇅 𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆨𑆴𑆰𑆘𑆳𑆁 𑆖𑆽𑆮 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁 𑆖 𑆲𑆴𑆠𑆽𑆰𑆴𑆟𑆳𑇆𑇑𑇒𑇑𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆯𑆾𑆡𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆠𑇀𑆫𑆪𑆂 𑆯𑆾𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆠𑆼 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆨𑆼𑆢𑆼𑆤𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆓𑆤𑇀𑆠𑆮𑆯𑇀𑆗𑆼𑆢𑆤𑆨𑆼𑆢𑆤𑆑𑇀𑆰𑆟𑆤𑆨𑆚𑇀𑆘𑆤𑆥𑆴𑆖𑇀𑆗𑆤𑆾𑆠𑇀𑆥𑆼𑆰𑆟𑆥𑇀𑆫𑆲𑆳𑆫𑆮𑆣𑆧𑆤𑇀𑆣𑆤𑆮𑆼𑆰𑇀𑆛𑆤𑆮𑇀𑆪𑆣𑆤𑆥𑆵𑆝𑆤𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆫𑆱𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆯𑆷𑆑𑆑𑇀𑆫𑆴𑆩𑆴𑆯𑆷𑆑𑆳𑆲𑆴𑆠𑆥𑆠𑇀𑆫𑆬𑆠𑆳𑆓𑆶𑆬𑇀𑆩𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆽𑆫𑇀𑆮𑆳 𑆱𑇀𑆮𑆼𑆢𑆤𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆟𑆳𑆮𑆩𑆷𑆠𑇀𑆫𑆟𑆽𑆫𑇀𑆮𑆳 𑆮𑆴𑆰𑆴𑆟𑆳𑆁 𑆱𑆮𑆴𑆰𑆥𑇀𑆫𑆳𑆟𑆴𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆢𑆤𑇀𑆠𑆮𑆴𑆰𑆳𑆟𑆤𑆒𑆤𑆴𑆥𑆳𑆠𑆽𑆫𑇀𑆮𑆳 𑆱𑆳𑆓𑆫𑆮𑆴𑆰𑆮𑆳𑆠𑆲𑆴𑆩𑆢𑆲𑆤𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆽𑆫𑇀𑆮𑆳 𑆯𑆾𑆡𑆳𑆂 𑆱𑆩𑆶𑆥𑆘𑆳𑆪𑆤𑇀𑆠𑆼𑇆𑇔𑇆
𑆠𑆼 𑆥𑆶𑆤𑆫𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆲𑆼𑆠𑆶𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆽𑆫𑆳𑆢𑆳𑆮𑆶𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑆤𑆴𑆘𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆽𑆑𑆢𑆼𑆯𑆮𑆴𑆥𑆫𑆵𑆠𑆽𑆂; 𑆧𑆤𑇀𑆣𑆩𑆤𑇀𑆠𑇀𑆫𑆳𑆓𑆢𑆥𑇀𑆫𑆬𑆼𑆥𑆥𑇀𑆫𑆠𑆳𑆥𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆟𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖𑆾𑆥𑆑𑇀𑆫𑆩𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑇀𑆪𑆩𑆳𑆟𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇕𑇆
𑆤𑆴𑆘𑆳𑆂 𑆥𑆶𑆤𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆳𑆩𑆪𑆡𑆳𑆮𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑆁𑆱𑆫𑇀𑆘𑆤𑆳𑆢𑇀𑆮𑆳 𑆗𑆫𑇀𑆢𑇀𑆪𑆬𑆱𑆑𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆠𑆴𑆱𑆳𑆫𑆯𑆾𑆰𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆾𑆢𑆫𑆘𑇀𑆮𑆫𑆥𑇀𑆫𑆢𑆫𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆫𑇀𑆯𑆾𑆮𑆴𑆑𑆳𑆫𑆳𑆠𑆴𑆑𑆫𑇀𑆯𑆤𑆽𑆫𑇀𑆮𑆳 𑆑𑆶𑆰𑇀𑆜𑆑𑆟𑇀𑆝𑆷𑆥𑆴𑆝𑆑𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆗𑆫𑇀𑆢𑆴𑆑𑇀𑆰𑆮𑆡𑆷𑆢𑇀𑆓𑆳𑆫𑆯𑆶𑆑𑇀𑆫𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆣𑆳𑆫𑆟𑆽𑆫𑇀𑆮𑆳 𑆑𑆫𑇀𑆩𑆫𑆾𑆓𑆾𑆥𑆮𑆳𑆱𑆳𑆣𑇀𑆮𑆑𑆫𑇀𑆯𑆴𑆠𑆱𑇀𑆪 𑆮𑆳 𑆱𑆲𑆱𑆳𑇁𑆠𑆴𑆓𑆶𑆫𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆦𑆬𑆯𑆳𑆑𑆫𑆳𑆓𑆢𑆣𑆴𑆲𑆫𑆴𑆠𑆑𑆩𑆢𑇀𑆪𑆩𑆤𑇀𑆢𑆑𑆮𑆴𑆫𑆷𑆞𑆤𑆮𑆯𑆷𑆑𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑- 𑆥𑆴𑆯𑆴𑆠𑆾𑆥𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆸𑆠𑇀𑆥𑆕𑇀𑆑𑆬𑆾𑆰𑇀𑆛𑆨𑆑𑇀𑆰𑆟𑆳𑆬𑇀𑆬𑆮𑆟𑆳𑆠𑆴𑆨𑆑𑇀𑆰𑆟𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆱𑆩𑇀𑆥𑆵𑆝𑆤𑆳𑆢𑆳𑆩𑆓𑆫𑇀𑆨𑆥𑇀𑆫𑆥𑆠𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆖 𑆩𑆴𑆡𑇀𑆪𑆾𑆥𑆖𑆳𑆫𑆳𑆢𑆶𑆢𑆵𑆫𑇀𑆟𑆢𑆾𑆰𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆯𑆾𑆦𑆳𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴; 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆾 𑆲𑆼𑆠𑆶𑆂𑇆𑇖𑇆
𑆃𑆪𑆁 𑆠𑇀𑆮𑆠𑇀𑆫 𑆮𑆴𑆯𑆼𑆰𑆂- 𑆯𑆵𑆠𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆮𑆴𑆯𑆢𑆯𑇀𑆫𑆩𑆾𑆥𑆮𑆳𑆱𑆳𑆠𑆴𑆑𑆫𑇀𑆯𑆤𑆑𑇀𑆰𑆥𑆟𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆢𑆵𑆤𑇀𑆪𑆨𑆴𑆨𑆷𑆪 𑆯𑆾𑆦𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆱 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆯𑆩𑆾 𑆨𑆮𑆠𑆴, 𑆠𑆡𑆳 𑆯𑇀𑆪𑆳𑆩𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆾 𑆮𑆳, 𑆖𑆬𑆂 𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆂 𑆒𑆫𑆥𑆫𑆶𑆰𑆨𑆴𑆤𑇀𑆤𑆠𑇀𑆮𑆓𑇀𑆫𑆾𑆩𑆳 𑆗𑆴𑆢𑇀𑆪𑆠 𑆅𑆮 𑆨𑆴𑆢𑇀𑆪𑆠 𑆅𑆮 𑆥𑆵𑆝𑇀𑆪𑆠 𑆅𑆮 𑆱𑆷𑆖𑆵𑆨𑆴𑆫𑆴𑆮 𑆠𑆶𑆢𑇀𑆪𑆠𑆼 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆨𑆴𑆫𑆴𑆮 𑆱𑆁𑆱𑆸𑆥𑇀𑆪𑆠𑆼 𑆱𑆫𑇀𑆰𑆥𑆑𑆬𑇀𑆑𑆳𑆮𑆬𑆴𑆥𑇀𑆠 𑆅𑆮 𑆖𑆴𑆩𑆴𑆖𑆴𑆩𑆳𑆪𑆠𑆼 𑆱𑆕𑇀𑆑𑆶𑆖𑇀𑆪𑆠 𑆄𑆪𑆩𑇀𑆪𑆠 𑆅𑆮𑆼𑆠𑆴 𑆮𑆳𑆠𑆯𑆾𑆡𑆂 (𑇑); 𑆇𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆑𑆛𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆳𑆘𑆵𑆫𑇀𑆟𑆨𑆾𑆘𑆤𑆽𑆫𑆓𑇀𑆤𑇀𑆪𑆳𑆠𑆥𑆥𑇀𑆫𑆠𑆳𑆥𑆽𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆤𑇀𑆪𑆨𑆴𑆨𑆷𑆪 𑆯𑆾𑆡𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆱 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆯𑆩𑆾 𑆨𑆮𑆠𑆴, 𑆑𑆸𑆰𑇀𑆟𑆥𑆵𑆠𑆤𑆵𑆬𑆠𑆳𑆩𑇀𑆫𑆳𑆮𑆨𑆳𑆱 𑆇𑆰𑇀𑆟𑆾 𑆩𑆸𑆢𑆶𑆂 𑆑𑆥𑆴𑆬𑆠𑆳𑆩𑇀𑆫𑆫𑆾𑆩𑆳 𑆇𑆰𑇀𑆪𑆠𑆼 𑆢𑆷𑆪𑆠𑆼 𑆣𑆷𑆥𑇀𑆪𑆠𑆼 𑆈𑆰𑇀𑆩𑆳𑆪𑆠𑆼 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑆑𑇀𑆬𑆴𑆢𑇀𑆪𑆠𑆼 𑆤 𑆖 𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑆶𑆰𑇀𑆟𑆁 𑆖 𑆱𑆶𑆰𑆷𑆪𑆠 𑆅𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆡𑆂 (𑇒); 𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑆠𑆴𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆢𑆵𑆤𑇀𑆪𑆨𑆴𑆨𑆷𑆪 𑆯𑆾𑆡𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆱 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆯𑆩𑆾 𑆨𑆮𑆠𑆴, 𑆥𑆳𑆟𑇀𑆝𑆶𑆯𑇀𑆮𑆼𑆠𑆳𑆮𑆨𑆳𑆱𑆾 𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆂 𑆱𑇀𑆡𑆴𑆫𑆂 𑆱𑇀𑆠𑇀𑆪𑆳𑆤𑆂 𑆯𑆶𑆑𑇀𑆬𑆳𑆓𑇀𑆫𑆫𑆾𑆩𑆳 𑆱𑇀𑆥𑆫𑇀𑆯𑆾𑆰𑇀𑆟𑆱𑆲𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆡𑆂 (𑇓); 𑆪𑆡𑆳𑆱𑇀𑆮𑆑𑆳𑆫𑆟𑆳𑆑𑆸𑆠𑆴𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆘𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂 𑆯𑆾𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆡𑆳𑆱𑇀𑆮𑆑𑆳𑆫𑆟𑆳𑆑𑆸𑆠𑆴𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆠𑇀 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑 𑆍𑆑𑆂; 𑆍𑆮𑆁 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆾 𑆨𑆼𑆢𑆂𑇆𑇗𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆴𑆱𑇀𑆠𑆳𑆨𑆴𑆱𑇀𑆠𑆳𑆨𑆴𑆫𑇀𑆨𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆾 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆾𑇁𑆰𑇀𑆛𑆮𑆴𑆣𑆯𑇀𑆖 𑆯𑆾𑆡 𑆇𑆥𑆬𑆨𑇀𑆪𑆠𑆼, 𑆥𑆶𑆤𑆯𑇀𑆖𑆽𑆑 𑆍𑆮𑆾𑆠𑇀𑆱𑆼𑆣𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆷𑆪𑆤𑇀𑆠𑆼 𑆪𑆱𑇀𑆪 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑇀𑆮𑆥𑆤𑇀𑆠𑆵𑆮 𑆫𑆶𑆘𑆤𑇀𑆠𑆴 𑆖𑇅 𑆥𑆵𑆝𑆴𑆠𑆳𑆤𑇀𑆪𑆶𑆤𑇀𑆤𑆩𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆮𑆳𑆠𑆯𑆾𑆡𑆁 𑆠𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇙𑇆
𑆪𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆳𑆨𑆂 𑆯𑆾𑆡𑆾 𑆤𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆟𑆯𑇀𑆪𑆠𑆴𑇅 𑆱𑇀𑆤𑆼𑆲𑆾𑆰𑇀𑆟𑆩𑆫𑇀𑆢𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆥𑇀𑆫𑆟𑆯𑇀𑆪𑆼𑆠𑇀 𑆱 𑆖 𑆮𑆳𑆠𑆴𑆑𑆂𑇆𑇑𑇐𑇆
𑆪𑆂 𑆥𑆴𑆥𑆳𑆱𑆳𑆘𑇀𑆮𑆫𑆳𑆫𑇀𑆠𑆱𑇀𑆪 𑆢𑆷𑆪𑆠𑆼𑇁𑆡 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼𑇅 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆴 𑆑𑇀𑆬𑆴𑆢𑇀𑆪𑆠𑆼 𑆓𑆤𑇀𑆣𑆵 𑆱 𑆥𑆽𑆠𑇀𑆠𑆂 𑆱𑇀𑆮𑆪𑆡𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇑𑇑𑇆
𑆪𑆂 𑆥𑆵𑆠𑆤𑆼𑆠𑇀𑆫𑆮𑆑𑇀𑆠𑇀𑆫𑆠𑇀𑆮𑆑𑇀 𑆥𑆷𑆫𑇀𑆮𑆁 𑆩𑆣𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆷𑆪𑆠𑆼𑇅 𑆠𑆤𑆶𑆠𑇀𑆮𑆑𑇀 𑆖𑆳𑆠𑆴𑆱𑆳𑆫𑆵 𑆖 𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆡𑆂 𑆱 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇆

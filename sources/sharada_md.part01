𑆩𑆾𑆲𑆁 𑆱𑆢𑆤𑆩𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑆮𑆴𑆥𑆳𑆑𑆁 𑆠𑆡𑆳𑇁𑆫𑆶𑆖𑆴𑆩𑇀 𑇅 𑆠𑆩𑆱𑆳 𑆖𑆳𑆨𑆴𑆨𑆷𑆠𑆱𑇀𑆠𑆶 𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆼𑆮𑆳𑆨𑆴𑆤𑆤𑇀𑆢𑆠𑆴 𑇆𑇒𑇙𑇆
𑆇𑆖𑇀𑆖𑆽𑆂 𑆱𑆩𑇀𑆨𑆳𑆰𑆟𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆂 𑆯𑆴𑆫𑆱𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆼𑆢𑇀𑆫𑆶𑆘𑆩𑇀 𑇅 𑆄𑆤𑇀𑆣𑇀𑆪𑆁 𑆘𑆳𑆝𑇀𑆪𑆩𑆘𑆴𑆔𑇀𑆫𑆠𑇀𑆮𑆁 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆩𑆷𑆑𑆠𑆳𑆁 𑆠𑆡𑆳 𑇆𑇓𑇐𑇆
𑆲𑆤𑆶𑆩𑆾𑆑𑇀𑆰𑆩𑆣𑆵𑆩𑆤𑇀𑆡𑆩𑆫𑇀𑆢𑆴𑆠𑆁 𑆖 𑆱𑆶𑆢𑆳𑆫𑆶𑆟𑆩𑇀 𑇅 𑆤𑆼𑆠𑇀𑆫𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆤𑆴𑆩𑆼𑆰𑆁 𑆮𑆳 𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆑𑆳𑆱𑆁 𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆩𑇀 𑇆𑇓𑇑𑇆
𑆬𑆨𑆠𑆼 𑆢𑆤𑇀𑆠𑆖𑆳𑆬𑆁 𑆖 𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑇅 𑆪𑆳𑆤𑆪𑆳𑆤𑆼𑆤 𑆬𑆨𑆠𑆼 𑆗𑆫𑇀𑆢𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆳𑆤𑇀 𑇆𑇓𑇒𑇆
𑆠𑆡𑆽𑆮𑆳𑆕𑇀𑆓𑆓𑇀𑆫𑆲𑆁 𑆔𑆾𑆫𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖 𑆮𑆴𑆨𑇀𑆫𑆩𑆩𑇀 𑇅 𑆖𑆴𑆫𑆳𑆱𑆤𑆳𑆠𑇀𑆠𑆡𑆳 𑆱𑇀𑆡𑆳𑆤𑆳𑆖𑇀𑆗𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆨𑆮𑆠𑆴 𑆮𑆼𑆢𑆤𑆳 𑇆𑇓𑇓𑇆
𑆃𑆠𑆴𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆘𑆕𑇀𑆔𑆪𑆾𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆫𑆶𑆘𑆂 𑇅 𑆱𑆑𑇀𑆡𑆴𑆥𑇀𑆫𑆯𑆾𑆰𑆁 𑆯𑆾𑆦𑆁 𑆮𑆳 𑆥𑆳𑆢𑆲𑆫𑇀𑆰𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇆𑇓𑇔𑇆
𑆯𑆵𑆠𑆱𑆩𑇀𑆨𑆾𑆓𑆠𑆾𑆪𑆳𑆤𑆳𑆁 𑆱𑆼𑆮𑆳 𑆩𑆳𑆫𑆶𑆠𑆮𑆸𑆢𑇀𑆣𑆪𑆼 𑇅 𑆠𑆠𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆯𑆷𑆬𑆳𑆣𑇀𑆩𑆳𑆤𑆥𑇀𑆫𑆮𑆼𑆥𑆑𑆳𑆂 𑇆𑇓𑇕𑇆
𑆮𑆳𑆠𑆳𑆠𑆥𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆘𑇀𑆮𑆫𑆁 𑆖𑆳𑆥𑆴 𑆱𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆤𑇀𑆩𑆸𑆠𑇀𑆪𑆶𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆮𑆳 𑆔𑆾𑆫𑆩𑆸𑆖𑇀𑆗𑆠𑆴 𑇆𑇓𑇖𑇆
𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆨𑆾𑆘𑆤𑆁 𑆲𑆤𑇀𑆪𑆳𑆢𑇀𑆧𑆬𑆮𑆫𑇀𑆟𑆩𑆱𑆁𑆯𑆪𑆩𑇀 𑇅 𑆃𑆤𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆂 𑆥𑆯𑆶𑆮𑆢𑇀𑆨𑆶𑆚𑇀𑆘𑆠𑆼 𑆪𑆼𑇁𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆂 𑇅 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆱𑇀𑆪 𑆠𑆼 𑆩𑆷𑆬𑆩𑆘𑆵𑆫𑇀𑆟𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇓𑇗𑇆
𑆮𑇀𑆪𑆳𑆥𑆢𑆳𑆁 𑆑𑆳𑆫𑆟𑆁 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑇀𑆮𑆼𑆠𑆳𑆱𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆥𑇀𑆫𑆪𑆠𑆼𑆠𑆳𑆠𑆶𑆫𑆳𑆫𑆾𑆓𑇀𑆪𑆼 𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳 𑇆𑇓𑇘𑇆
𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆮𑆳𑆤𑇀𑆠𑆽𑆫𑇀𑆲𑆫𑆴𑆟𑆽𑆟𑆬𑆳𑆮𑆑𑆳𑆂 𑆯𑆯𑆯𑇀𑆖 𑆱𑆼𑆮𑇀𑆪𑆂 𑆱𑆩𑆪𑆷𑆫𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆵𑆂 𑇅 𑆱𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆯𑇀𑆖𑆽𑆮 𑆥𑆶𑆫𑆳𑆟𑆯𑆳𑆬𑆪𑆱𑇀𑆠𑆡𑆽𑆮 𑆩𑆶𑆢𑇀𑆓𑆳 𑆬𑆔𑆶 𑆪𑆖𑇀𑆖 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇓𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆣𑆷𑆩𑆤𑆱𑇀𑆪𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆣𑆷𑆩𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆾 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆂, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆾, 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆂, 𑆑𑆳𑆱𑆔𑇀𑆤𑆾, 𑆮𑆳𑆩𑆤𑆵𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆽𑆬𑆳𑆢𑆴𑆤𑆳 𑆑𑆶𑆰𑇀𑆜𑆠𑆓𑆫𑆮𑆫𑇀𑆘𑇀𑆪𑆼𑆤 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆼𑆤 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆯𑆫𑆑𑆳𑆟𑇀𑆝𑆩𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆑𑇀𑆰𑆿𑆩𑆼𑆟𑆳𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆮𑆼𑆰𑇀𑆛𑆪𑆴𑆠𑇀𑆮𑆳 𑆬𑆼𑆥𑆪𑆼𑆢𑆼𑆰𑆳 𑆮𑆫𑇀𑆠𑆴𑆂 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆼 , 𑆱𑇀𑆤𑆼𑆲𑆦𑆬𑆱𑆳𑆫𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆱𑆫𑇀𑆘𑆫𑆱𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆩𑆴𑆯𑇀𑆫𑆽𑆂 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆼, 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆮𑆽𑆫𑆼𑆖𑆤𑆼, 𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆳𑆱𑆩𑆫𑇀𑆢𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆴𑆕𑇀𑆓𑆶𑆢𑆵𑆠𑇀𑆮𑆕𑇀𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆫𑆶𑆲𑆳𑆑𑆫𑇀𑆑𑆛𑆯𑆸𑆕𑇀𑆓𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆂 𑆑𑆳𑆱𑆲𑆫𑆽𑆯𑇀𑆖 𑆑𑆳𑆱𑆔𑇀𑆤𑆼, 𑆱𑇀𑆤𑆳𑆪𑆶𑆖𑆫𑇀𑆩𑆒𑆶𑆫𑆯𑆸𑆕𑇀𑆓𑆑𑆫𑇀𑆑𑆛𑆑𑆳𑆱𑇀𑆡𑆴𑆯𑆶𑆰𑇀𑆑𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆬𑇀𑆬𑆷𑆫𑆑𑆸𑆩𑆴𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆳𑆩𑆤𑆵𑆪𑆽𑆯𑇀𑆖 𑆮𑆳𑆩𑆤𑆵𑆪𑆼 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆧𑆱𑇀𑆠𑆴𑆤𑆼𑆠𑇀𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆣𑆷𑆩𑆤𑆼𑆠𑇀𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆣𑆷𑆩𑆤𑆼𑆠𑇀𑆫𑆁 𑆠𑆶 𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳𑆥𑆫𑆴𑆟𑆳𑆲𑆩𑆓𑇀𑆫𑆼 𑆑𑆬𑆳𑆪𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆾 𑆩𑆷𑆬𑆼𑇁𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆣𑆷𑆩𑆮𑆫𑇀𑆠𑆴𑆥𑇀𑆫𑆮𑆼𑆯𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆼, 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆤𑆼, 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆮𑆽𑆫𑆼𑆖𑆤𑆼, 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆑𑆳𑆱𑆔𑇀𑆤𑆼 𑆮𑆳𑆩𑆤𑆵𑆪𑆼 𑆖 𑇅 𑆍𑆠𑆼𑇁𑆥𑆴 𑆑𑆾𑆬𑆳𑆱𑇀𑆡𑆴𑆩𑆳𑆠𑇀𑆫𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼 𑆨𑆮𑆠𑆂 𑇅 𑆮𑇀𑆫𑆟𑆤𑆼𑆠𑇀𑆫𑆩𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆮𑇀𑆫𑆟𑆣𑆷𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆑𑆬𑆳𑆪𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆁 𑆑𑆶𑆬𑆠𑇀𑆡𑆮𑆳𑆲𑆴𑆱𑇀𑆫𑆾𑆠 𑆅𑆠𑆴 𑇆𑇕𑇆
𑆃𑆡 𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆂 𑆱𑆶𑆩𑆤𑆳 𑆉𑆘𑇀𑆮𑆣𑆾𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆑𑇀𑆠𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆫𑆳𑆁 𑆮𑆫𑇀𑆠𑆴𑆁 𑆤𑆼𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆱𑆴 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆪 𑆣𑆷𑆩𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇖𑇆
𑆩𑆶𑆒𑆼𑆤 𑆠𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆁 𑆤𑆳𑆱𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆠𑆠𑆂 𑆥𑆴𑆧𑆼𑆠𑇀 𑇅 𑆩𑆶𑆒𑆥𑆵𑆠𑆁 𑆩𑆶𑆒𑆼𑆤𑆽𑆮 𑆮𑆩𑆼𑆠𑇀 𑆥𑆵𑆠𑆁 𑆖 𑆤𑆳𑆱𑆪𑆳 𑇆𑇗𑇆
𑆩𑆶𑆒𑆼𑆤 𑆣𑆷𑆩𑆩𑆳𑆢𑆳𑆪 𑆤𑆳𑆱𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆤 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑇅 𑆠𑆼𑆤 𑆲𑆴 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆼𑆤 𑆢𑆸𑆰𑇀𑆛𑆴𑆱𑇀𑆠𑆠𑇀𑆫 𑆤𑆴𑆲𑆤𑇀𑆪𑆠𑆼 𑇆𑇘𑇆
𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆁 𑆔𑇀𑆫𑆳𑆟𑆼𑆤𑆳𑆢𑆢𑆵𑆠, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆁 𑆩𑆶𑆒𑆤𑆳𑆱𑆳𑆨𑇀𑆪𑆳𑆁, 𑆤𑆳𑆱𑆴𑆑𑆪𑆳 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆁, 𑆩𑆶𑆒𑆼𑆤𑆽𑆮𑆼𑆠𑆫𑆿 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆼 𑆮𑆫𑇀𑆠𑆴𑆁 𑆮𑇀𑆪𑆥𑆓𑆠𑆯𑆫𑆑𑆳𑆟𑇀𑆝𑆳𑆁 𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆯𑆶𑆰𑇀𑆑𑆳𑆩𑆕𑇀𑆓𑆳𑆫𑆼𑆰𑇀𑆮𑆮𑆢𑆵𑆥𑇀𑆪 𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆬𑆱𑇀𑆫𑆾𑆠𑆱𑆴 𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪 𑆣𑆷𑆩𑆩𑆳𑆲𑆫𑆼𑆠𑆴 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀; 𑆍𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑇅 𑆅𑆠𑆫𑆪𑆾𑆫𑇀𑆮𑇀𑆪𑆥𑆼𑆠𑆣𑆷𑆩𑆳𑆕𑇀𑆓𑆳𑆫𑆼 𑆱𑇀𑆡𑆴𑆫𑆼 𑆱𑆩𑆳𑆲𑆴𑆠𑆼 𑆯𑆫𑆳𑆮𑆼 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆮𑆫𑇀𑆠𑆴𑆁 𑆩𑆷𑆬𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆟𑆳𑆤𑇀𑆪𑆼𑆤 𑆯𑆫𑆳𑆮𑆼𑆟 𑆥𑆴𑆣𑆳𑆪 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆗𑆴𑆢𑇀𑆫𑆼 𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆬𑆁 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆣𑆷𑆩𑆩𑆳𑆱𑆼𑆮𑆼𑆠, 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆼 𑆣𑆷𑆩𑆼 𑆮𑆫𑇀𑆠𑆴𑆩𑆮𑆯𑆴𑆰𑇀𑆛𑆳𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆶𑆤𑆫𑆥𑆴 𑆣𑆷𑆩𑆁 𑆥𑆳𑆪𑆪𑆼𑆢𑆳𑆢𑆾𑆰𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆼𑆂; 𑆍𑆰 𑆣𑆷𑆩𑆥𑆳𑆤𑆾𑆥𑆳𑆪𑆮𑆴𑆣𑆴𑆂 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆯𑆾𑆑𑆯𑇀𑆫𑆩𑆨𑆪𑆳𑆩𑆫𑇀𑆰𑆿𑆰𑇀𑆟𑇀𑆪𑆮𑆴𑆰𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆯𑆴𑆫𑆾𑇁𑆨𑆴𑆔𑆳𑆠𑆾𑆢𑇀𑆓𑆳𑆫𑆳𑆥𑆠𑆫𑇀𑆥𑆴𑆠- 𑆠𑆴𑆩𑆴𑆫𑆥𑇀𑆫𑆩𑆼𑆲𑆾𑆢𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆮𑆳𑆠𑆳𑆫𑇀𑆠𑆳 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆢𑆶𑆫𑇀𑆧𑆬𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆡𑆳𑆥𑆴𑆠𑆘𑆳𑆓𑆫𑆴𑆠𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆫𑆷𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆟𑆑𑇀𑆰𑆠𑆾𑆫𑆱𑇀𑆑- 𑆩𑆣𑆶𑆔𑆸𑆠𑆢𑆣𑆴𑆢𑆶𑆓𑇀𑆣𑆩𑆠𑇀𑆱𑇀𑆪𑆩𑆢𑇀𑆪𑆪𑆮𑆳𑆓𑆷𑆥𑆵𑆠𑆳𑆬𑇀𑆥𑆑𑆦𑆳𑆯𑇀𑆖 𑆤 𑆣𑆷𑆩𑆩𑆳𑆱𑆼𑆮𑆼𑆫𑆤𑇀 𑇆𑇑𑇑𑇆
𑆃𑆑𑆳𑆬𑆥𑆵𑆠𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆨𑇀𑆫𑆩𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆩𑇀 𑇅 𑆔𑇀𑆫𑆳𑆟𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆳𑆩𑆶𑆥𑆔𑆳𑆠𑆁 𑆖 𑆢𑆳𑆫𑆶𑆟𑆩𑇀 𑇆𑇑𑇒𑇆
𑆄𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆠𑇀𑆫𑆪𑆾 𑆣𑆷𑆩𑆳 𑆢𑇀𑆮𑆳𑆢𑆯𑆱𑆶 𑆑𑆳𑆬𑆼𑆰𑆷𑆥𑆳𑆢𑆼𑆪𑆳𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑇀𑆰𑆶𑆠𑆢𑆤𑇀𑆠𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆤𑆱𑇀𑆪𑆱𑇀𑆤𑆳𑆤𑆨𑆾𑆘𑆤𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆽𑆡𑆶𑆤𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆲𑆱𑆴𑆠𑆫𑆶𑆰𑆴𑆠𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆼𑆰𑇀𑆮𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆮𑆴𑆨𑆳𑆓𑆾- 𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆑𑇀𑆰𑆮𑆡𑆶𑆲𑆱𑆴𑆠𑆫𑆶𑆰𑆴𑆠𑆩𑆽𑆡𑆶𑆤𑆳𑆤𑇀𑆠𑆼𑆰𑆶 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆂, 𑆱𑇀𑆤𑆳𑆤𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆤𑇀𑆠𑆼𑆰𑆶 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆂, 𑆢𑆤𑇀𑆠𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆱𑇀𑆪 𑆱𑇀𑆤𑆳𑆤𑆨𑆾𑆘𑆤𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆼𑆰𑆶 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑 𑆅𑆠𑆴 𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆾 𑆮𑆳𑆠𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆶𑆥𑆬𑆼𑆥𑆳𑆖𑇀𑆖; 𑆮𑆽𑆫𑆼𑆖𑆤𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑇀𑆪𑆳𑆥𑆑𑆫𑇀𑆰𑆠𑆴, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆢𑆿𑆰𑇀𑆟𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆖𑇀𑆖; 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆪𑆠𑇀𑆪𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆖𑆳𑆥𑆑𑆫𑇀𑆰𑆠𑆴 𑆯𑆩𑆪𑆠𑆴 𑆮𑆳𑆠𑆁 𑆱𑆳𑆣𑆳𑆫𑆟𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆩𑆴𑆠𑆴 𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆤𑆫𑆾 𑆣𑆷𑆩𑆾𑆥𑆪𑆾𑆓𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆳𑆕𑇀𑆩𑆤𑆳𑆂 𑇅 𑆢𑆸𑆞𑆑𑆼𑆯𑆢𑇀𑆮𑆴𑆘𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆂 𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆮𑆴𑆯𑆢𑆳𑆤𑆤𑆂 𑇆𑇑𑇕𑇆
𑆠𑆡𑆳 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑆾𑆖𑆑𑆳𑆱𑇀𑆪𑆾𑆥𑆬𑆼𑆥𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆩𑆶𑆒𑆳𑆱𑇀𑆫𑆳𑆮𑆑𑇀𑆰𑆮𑆡𑆶𑆮𑆩𑆡𑆶𑆑𑇀𑆫𑆡𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆤𑆴𑆢𑇀𑆫𑆳𑆲𑆤𑆶𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆂 𑆥𑆵𑆤𑆱𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆳 𑆮𑆳𑆠𑆑𑆦𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆩𑆶𑆒𑆫𑆾𑆓𑆳 𑆤 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇖𑇆
𑆠𑆱𑇀𑆪 𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆳𑆠𑆴𑆪𑆾𑆓𑆳 𑆮𑆴𑆘𑇀𑆚𑆳𑆠𑆮𑇀𑆪𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆪𑆾𑆓𑆾 𑆫𑆾𑆓𑆥𑇀𑆫𑆯𑆩𑆤𑆂, 𑆃𑆪𑆾𑆓𑆾 𑆫𑆾𑆓𑆳𑆥𑇀𑆫𑆯𑆩𑆤𑆂, 𑆠𑆳𑆬𑆶𑆓𑆬𑆯𑆾𑆰𑆥𑆫𑆴𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆩𑆢𑆑𑆫𑇀𑆟𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆢𑆸𑆰𑇀𑆛𑆴𑆤𑆳𑆱𑆳𑆫𑆾𑆓𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑇀𑆪𑆠𑆴𑆪𑆾𑆓𑆾 𑆘𑆤𑆪𑆠𑆴 𑇆𑇑𑇗𑇆
𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆁 𑆠𑇀𑆫𑆵𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆳𑆤𑆳𑆢𑆢𑆵𑆠 𑆩𑆶𑆒𑆤𑆳𑆱𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆥𑆫𑇀𑆪𑆳𑆪𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾 𑆮𑆼𑆠𑆴, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆁 𑆪𑆳𑆮𑆢𑆯𑇀𑆫𑆶𑆥𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆩𑆳𑆢𑆾𑆰𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀, 𑆠𑆴𑆬𑆠𑆟𑇀𑆝𑆶𑆬𑆪𑆮𑆳𑆓𑆷𑆥𑆵𑆠𑆼𑆤 𑆥𑆳𑆠𑆮𑇀𑆪𑆾 𑆮𑆳𑆩𑆤𑆵𑆪𑆂, 𑆓𑇀𑆫𑆳𑆱𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆑𑆳𑆱𑆔𑇀𑆤 𑆅𑆠𑆴 𑇆𑇑𑇘𑇆
𑆮𑇀𑆫𑆟𑆣𑆷𑆩𑆁 𑆯𑆫𑆳𑆮𑆱𑆩𑇀𑆥𑆶𑆛𑆾𑆥𑆤𑆵𑆠𑆼𑆤 𑆤𑆼𑆠𑇀𑆫𑆼𑆟 𑆮𑇀𑆫𑆟𑆩𑆳𑆤𑆪𑆼𑆠𑇀, 𑆣𑆷𑆩𑆥𑆳𑆤𑆳𑆢𑇀𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆩𑆾 𑆮𑇀𑆫𑆟𑆮𑆽𑆯𑆢𑇀𑆪𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆾𑆥𑆯𑆩𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇑𑇙𑇆
𑆮𑆴𑆣𑆴𑆫𑆼𑆰 𑆱𑆩𑆳𑆱𑆼𑆤 𑆣𑆷𑆩𑆱𑇀𑆪𑆳𑆨𑆴𑆲𑆴𑆠𑆾 𑆩𑆪𑆳 𑇅 𑆤𑆱𑇀𑆪𑆱𑇀𑆪𑆳𑆠𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆴𑆣𑆴𑆁 𑆤𑆴𑆫𑆮𑆯𑆼𑆰𑆠𑆂 𑇆𑇒𑇐𑇆
𑆐𑆰𑆣𑆩𑆿𑆰𑆣𑆱𑆴𑆢𑇀𑆣𑆾 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆾 𑆤𑆳𑆱𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑆵𑆪𑆠 𑆅𑆠𑆴 𑆤𑆱𑇀𑆪𑆩𑇀 𑇅 𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁, 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆖 𑇅 𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆥𑆴 𑆥𑆚𑇀𑆖𑆣𑆳 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆤𑆱𑇀𑆪𑆁, 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁, 𑆥𑇀𑆫𑆠𑆴𑆩𑆫𑇀𑆯𑆾, 𑆃𑆮𑆥𑆵𑆝𑆂, 𑆥𑇀𑆫𑆣𑆩𑆤𑆁 𑆖 𑇅 𑆠𑆼𑆰𑆶 𑆤𑆱𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖; 𑆤𑆱𑇀𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆂 𑆥𑇀𑆫𑆠𑆴𑆩𑆫𑇀𑆯𑆂, 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑆴𑆑𑆬𑇀𑆥𑆾𑇁𑆮𑆥𑆵𑆝𑆂 𑆥𑇀𑆫𑆣𑆩𑆤𑆁 𑆖; 𑆠𑆠𑆾 𑆤𑆱𑇀𑆪𑆯𑆧𑇀𑆢𑆂 𑆥𑆚𑇀𑆖𑆣𑆳 𑆤𑆴𑆪𑆩𑆴𑆠𑆂 𑇆𑇒𑇑𑇆
𑆠𑆠𑇀𑆫 𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆤𑆳𑆫𑇀𑆡𑆁 𑆯𑆷𑆤𑇀𑆪𑆯𑆴𑆫𑆱𑆳𑆁 𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆑𑆤𑇀𑆣𑆾𑆫𑆱𑆳𑆁 𑆖 𑆧𑆬𑆘𑆤𑆤𑆳𑆫𑇀𑆡𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆥𑇀𑆫𑆱𑆳𑆢𑆘𑆤𑆤𑆳𑆫𑇀𑆡𑆁 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆾 𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆾 𑆤𑆱𑇀𑆪𑆯𑆧𑇀𑆢𑆂 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆢𑆼𑆪𑆁 𑆮𑆳𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆯𑆴𑆫𑆱𑆴 𑆢𑆤𑇀𑆠𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆥𑇀𑆫𑆥𑆳𑆠𑆢𑆳𑆫𑆶𑆟𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆑𑆫𑇀𑆟𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆠𑆴𑆩𑆴𑆫𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠- 𑆤𑆳𑆱𑆳𑆫𑆾𑆓𑆳𑆱𑇀𑆪𑆯𑆾𑆰𑆳𑆮𑆧𑆳𑆲𑆶𑆑𑆳𑆑𑆳𑆬𑆘𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆢𑆳𑆫𑆶𑆟𑆥𑇀𑆫𑆧𑆾𑆣𑆼𑆰𑆶 𑆮𑆳𑆠𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑆰𑆶 𑆩𑆶𑆒𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑇀𑆤𑆼𑆲𑆼𑆤𑆼𑆠𑆴 𑇆𑇒𑇒𑇆
𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑇁𑆨𑆴𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆠𑆳𑆬𑆶𑆑𑆟𑇀𑆜𑆯𑆴𑆫𑆱𑆳𑆩𑆫𑆾𑆖𑆑𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆯𑆷𑆬𑆥𑆵𑆤𑆱𑆳𑆫𑇀𑆣𑆳𑆮𑆨𑆼𑆢𑆑- 𑆑𑆸𑆩𑆴𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆓𑆤𑇀𑆣𑆳𑆘𑇀𑆚𑆳𑆤𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆓𑆠𑆼𑆰𑆶 𑆑𑆦𑆘𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆱𑇀𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆼𑆤𑆼𑆠𑆴 𑇆𑇒𑇓𑇆
𑆠𑆠𑇀𑆫𑆽𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆥𑇀𑆪𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆾𑇁𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆫𑆾𑆓𑆴𑆟𑆳𑆁, 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆥𑆴𑆠𑇀𑆠𑆫𑆾𑆓𑆴𑆟𑆳𑆁, 𑆃𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆮𑆳𑆠𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀 𑇆𑇒𑇔𑇆
𑆱𑇀𑆤𑆼𑆲𑆼𑇁𑆮𑆱𑆴𑆖𑇀𑆪𑆩𑆳𑆤𑆼 𑆠𑆶 𑆯𑆴𑆫𑆾 𑆤𑆽𑆮 𑆥𑇀𑆫𑆑𑆩𑇀𑆥𑆪𑆼𑆠𑇀 𑇅 𑆤 𑆑𑆶𑆥𑇀𑆪𑆼𑆤𑇀𑆤 𑆥𑇀𑆫𑆨𑆳𑆰𑆼𑆖𑇀𑆖 𑆤 𑆑𑇀𑆰𑆶𑆪𑆳𑆤𑇀𑆤 𑆲𑆱𑆼𑆠𑇀𑆠𑆡𑆳 𑇆𑇒𑇖𑇆
𑆍𑆠𑆽𑆫𑇀𑆲𑆴 𑆮𑆴𑆲𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆾 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆠𑆂 𑆑𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆯𑆴𑆫𑆾𑇁𑆑𑇀𑆰𑆴𑆓𑆢𑆱𑆩𑇀𑆨𑆮𑆂 𑇆𑇒𑇗𑇆
𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆰𑇀𑆛𑆿 𑆧𑆴𑆤𑇀𑆢𑆮𑆂 𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆥𑆫𑇀𑆮𑆢𑇀𑆮𑆪𑆤𑆴𑆂𑆱𑆸𑆠𑆳𑆂 𑆥𑇀𑆫𑆡𑆩𑆳 𑆩𑆳𑆠𑇀𑆫𑆳, 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳 𑆯𑆶𑆑𑇀𑆠𑆴𑆂, 𑆠𑆸𑆠𑆵𑆪𑆳 𑆥𑆳𑆟𑆴𑆯𑆶𑆑𑇀𑆠𑆴𑆂, 𑆅𑆠𑇀𑆪𑆼𑆠𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆾 𑆩𑆳𑆠𑇀𑆫𑆳 𑆪𑆡𑆳𑆧𑆬𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆂 𑇆𑇒𑇘𑇆
𑆱𑇀𑆤𑆼𑆲𑆤𑆱𑇀𑆪𑆁 𑆤𑆾𑆥𑆓𑆴𑆬𑆼𑆠𑇀𑆑𑆡𑆚𑇀𑆖𑆴𑆢𑆥𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇒𑇙𑇆
𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆩𑆨𑆴𑆥𑇀𑆬𑆳𑆮𑇀𑆪 𑆤𑆴𑆫𑆼𑆠𑆴 𑆮𑆢𑆤𑆳𑆢𑇀𑆪𑆡𑆳 𑇅 𑆑𑆦𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆨𑆪𑆳𑆖𑇀𑆖𑆽𑆤𑆁 𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆼𑆢𑆮𑆴𑆣𑆳𑆫𑆪𑆤𑇀 𑇆𑇓𑇐𑇆
𑆢𑆠𑇀𑆠𑆼 𑆖 𑆥𑆶𑆤𑆫𑆥𑆴 𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑇀𑆪 𑆓𑆬𑆑𑆥𑆾𑆬𑆳𑆢𑆵𑆤𑇀 𑆣𑆷𑆩𑆩𑆳𑆱𑆼𑆮𑆼𑆠, 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆩𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪𑆳𑆖𑆳𑆫𑆴𑆑𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀; 𑆫𑆘𑆾𑆣𑆷𑆩𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑆥𑆩𑆢𑇀𑆪𑆢𑇀𑆫𑆮𑆥𑆳𑆤𑆯𑆴𑆫𑆂𑆱𑇀𑆤𑆳𑆤𑆳𑆠𑆴𑆪𑆳𑆤𑆑𑇀𑆫𑆾𑆣𑆳𑆢𑆵𑆤𑆴 𑆖 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇓𑇑𑇆
𑆠𑆱𑇀𑆪 𑆪𑆾𑆓𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆳𑆤𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴 𑇆𑇓𑇒𑇆
𑆬𑆳𑆔𑆮𑆁 𑆯𑆴𑆫𑆱𑆾 𑆪𑆾𑆓𑆼 𑆱𑆶𑆒𑆱𑇀𑆮𑆥𑇀𑆤𑆥𑇀𑆫𑆧𑆾𑆣𑆤𑆩𑇀 𑇅 𑆮𑆴𑆑𑆳𑆫𑆾𑆥𑆯𑆩𑆂 𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆩𑆤𑆂𑆱𑆶𑆒𑆩𑇀 𑇆𑇓𑇓𑇆
𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆂 𑆯𑆴𑆫𑆱𑆾 𑆓𑆶𑆫𑆶𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆨𑇀𑆫𑆩𑆂 𑇅 𑆬𑆑𑇀𑆰𑆟𑆁 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑇀𑆪𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼 𑆫𑆷𑆑𑇀𑆰𑆁 𑆠𑆠𑇀𑆫𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇓𑇔𑇆
𑆃𑆪𑆾𑆓𑆼 𑆮𑆳𑆠𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖 𑆫𑆷𑆑𑇀𑆰𑆠𑆳 𑇅 𑆫𑆾𑆓𑆳𑆯𑆳𑆤𑇀𑆠𑆴𑆯𑇀𑆖 𑆠𑆠𑇀𑆫𑆼𑆰𑇀𑆛𑆁 𑆨𑆷𑆪𑆾 𑆤𑆱𑇀𑆪𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇓𑇕𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆧𑆴𑆤𑇀𑆢𑆮𑆂 𑆰𑆝𑇀 𑆮𑆳 𑆠𑆡𑆳𑇁𑆰𑇀𑆛𑆿 𑆮𑆳 𑆪𑆡𑆳𑆧𑆬𑆩𑇀 𑇅 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆑𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇓𑇖𑇆
𑆤𑆱𑇀𑆪𑆼 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆾𑆓𑆠𑆂 𑇅 𑆯𑆶𑆢𑇀𑆣(𑆢𑇀𑆣𑆴)𑆲𑆵𑆤𑆳𑆠𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆖𑆴𑆤𑇀𑆠𑆑𑆽𑆂 𑇆𑇓𑇗𑇆
𑆬𑆳𑆔𑆮𑆁 𑆯𑆴𑆫𑆱𑆂 𑆯𑆶𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆫𑇀𑆘𑆪𑆂 𑇅 𑆖𑆴𑆠𑇀𑆠𑆾𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆱𑆳𑆢𑆯𑇀𑆖 𑆯𑆴𑆫𑆱𑆂 𑆯𑆶𑆢𑇀𑆣𑆴𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇓𑇘𑇆
𑆑𑆟𑇀𑆝𑆷𑆥𑆢𑆼𑆲𑆿 𑆓𑆶𑆫𑆶𑆠𑆳 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆑𑆦𑆱𑆁𑆱𑇀𑆫𑆮𑆂 𑇅 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆲𑆵𑆤𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆼 𑆠𑆶 𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇓𑇙𑇆
𑆩𑆱𑇀𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆓𑆩𑆾 𑆮𑆳𑆠𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆨𑇀𑆫𑆩𑆂 𑇅 𑆯𑆷𑆤𑇀𑆪𑆠𑆳 𑆯𑆴𑆫𑆱𑆯𑇀𑆖𑆳𑆥𑆴 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆓𑆳𑆞𑆮𑆴𑆫𑆼𑆖𑆴𑆠𑆼 𑇆𑇔𑇐𑇆
𑆲𑆵𑆤𑆳𑆠𑆴𑆯𑆶𑆢𑇀𑆣𑆼 𑆯𑆴𑆫𑆱𑆴 𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆼 𑆯𑆴𑆫𑆱𑆴 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆤𑆱𑇀𑆪𑆁 𑆤𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀 𑇆𑇔𑇑𑇆
(𑆍𑆑𑆳𑆤𑇀𑆠𑆫𑆁 𑆢𑇀𑆮𑇀𑆪𑆤𑇀𑆠𑆫𑆁 𑆮𑆳 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆮𑆳 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆂 𑇅 𑆍𑆑𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆪𑆳𑆮𑆢𑇀𑆮𑆳 𑆱𑆳𑆣𑆶 𑆩𑆤𑇀𑆪𑆠𑆼 𑇆𑇔𑇒𑇆
𑆩𑆳𑆫𑆶𑆠𑆼𑆤𑆳𑆨𑆴𑆨𑆷𑆠𑆱𑇀𑆪 𑆮𑆳𑇁𑆠𑇀𑆪𑆤𑇀𑆠𑆁 𑆪𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆢𑇀𑆮𑆴𑆑𑆳𑆬𑆁 𑆖𑆳𑆥𑆴 𑆢𑆳𑆠𑆮𑇀𑆪𑆁 𑆤𑆱𑇀𑆪𑆁 𑆠𑆱𑇀𑆪 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 ) 𑇆𑇔𑇓𑇆
𑆃𑆮𑆥𑆵𑆝𑆱𑇀𑆠𑆶 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑆢𑆨𑆴𑆰𑇀𑆪𑆟𑇀𑆟𑆱𑆫𑇀𑆥𑆢𑆰𑇀𑆛𑆮𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆼𑆨𑇀𑆪𑆾 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆮𑆥𑆴𑆰𑇀𑆪𑆳𑆮𑆥𑆵𑆝𑇀𑆪 𑆖, 𑆯𑆫𑇀𑆑𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆑𑇀𑆰𑆵𑆫𑆔𑆸𑆠𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆑𑇀𑆰𑆵𑆟𑆳𑆤𑆳𑆁 𑆯𑆾𑆟𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇔𑇔𑇆
𑆑𑆸𑆯𑆢𑆶𑆫𑇀𑆧𑆬𑆨𑆵𑆫𑆷𑆟𑆳𑆁 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆪𑆾𑆰𑆴𑆠𑆳𑆩𑇀 𑇅 𑆯𑆸𑆠𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆯𑆴𑆫𑆂𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆽 𑆑𑆬𑇀𑆑𑆱𑇀𑆠𑆼𑆨𑇀𑆪𑆾 𑆪𑆡𑆳 𑆲𑆴𑆠𑆂 𑇆𑇔𑇕𑇆
𑆖𑆼𑆠𑆾𑆮𑆴𑆑𑆳𑆫𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆳𑆨𑆴𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑇀𑆫𑆣𑆩𑆼𑆠𑇀 𑇆𑇔𑇖𑇆
𑆤𑆱𑇀𑆪𑆼𑆤 𑆥𑆫𑆴𑆲𑆫𑇀𑆠𑆮𑇀𑆪𑆾 𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑆥𑆠𑆫𑇀𑆥𑆴𑆠𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆠𑆫𑆶𑆟𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆵 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆥𑆵𑆠𑆱𑇀𑆤𑆼𑆲𑆾𑆢𑆑𑆩𑆢𑇀𑆪𑆢𑇀𑆫𑆮𑆾𑇁𑆘𑆵𑆫𑇀𑆟𑆵 𑆢𑆠𑇀𑆠𑆧𑆱𑇀𑆠𑆴𑆂 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆾 𑆓𑆫𑆳𑆫𑇀𑆠𑆱𑇀𑆠𑆸𑆰𑆴𑆠𑆂 𑆯𑆾𑆑𑆳𑆨𑆴𑆨𑆷𑆠𑆂 𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆾 𑆧𑆳𑆬𑆾 𑆮𑆸𑆢𑇀𑆣𑆾 𑆮𑆼𑆓𑆳𑆮𑆫𑆾𑆣𑆴𑆠𑆂 𑆯𑆴𑆫𑆂𑆱𑇀𑆤𑆳𑆠𑆶𑆑𑆳𑆩𑆯𑇀𑆖𑆼𑆠𑆴; 𑆃𑆤𑆳𑆫𑇀𑆠𑆮𑆼 𑆖𑆳𑆨𑇀𑆫𑆼 𑆤𑆱𑇀𑆪𑆣𑆷𑆩𑆿 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇔𑇗𑇆
𑆠𑆠𑇀𑆫 𑆲𑆵𑆤𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆳𑆠𑆴𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑆲𑆱𑆳𑆥𑇀𑆫𑆢𑆳𑆤𑆳𑆢𑆠𑆴𑆥𑇀𑆫𑆮𑆴𑆬𑆩𑇀𑆧𑆴𑆠𑆯𑆴𑆫𑆱 𑆇𑆖𑇀𑆗𑆴𑆕𑇀𑆔𑆠𑆾 𑆮𑆴𑆖𑆬𑆠𑆾𑇁𑆨𑇀𑆪𑆮𑆲𑆫𑆠𑆾 𑆮𑆳 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆥𑇀𑆫𑆢𑆳𑆤𑆳𑆖𑇀𑆖 𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆸𑆰𑇀𑆟𑆾𑆢𑇀𑆓𑆳𑆫𑆳𑆢𑆪𑆾 𑆢𑆾𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆑𑇀𑆰𑆪𑆘𑆳𑆯𑇀𑆖 𑇆𑇔𑇘𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆤𑆱𑇀𑆪𑆼 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆑𑆼 𑆖 𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇅 𑆢𑆾𑆰𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆳𑆠𑇀 𑆑𑇀𑆰𑆪𑆳𑆖𑇀𑆖𑆽𑆮 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆱𑇀𑆠𑆳 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇆𑇔𑇙𑇆
𑆢𑆾𑆰𑆾𑆑𑇀𑆬𑆼𑆯𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆘𑆪𑆼𑆖𑇀𑆗𑆩𑆤𑆯𑆾𑆣𑆤𑆽𑆂 𑇅 𑆃𑆡 𑆑𑇀𑆰𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆱𑆶 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆲𑆴𑆠𑆩𑇀 𑇆𑇕𑇐𑇆
𑆥𑇀𑆫𑆠𑆴𑆩𑆫𑇀𑆯𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆱𑆶 𑆑𑆳𑆬𑆼𑆰𑆷𑆥𑆳𑆢𑆼𑆪𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑆬𑇀𑆥𑆾𑆠𑇀𑆡𑆴𑆠𑆼𑆤, 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆢𑆤𑇀𑆠𑆼𑆤, 𑆓𑆸𑆲𑆳𑆤𑇀𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆠𑆳, 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆣𑇀𑆮𑆥𑆫𑆴𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑆤, 𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆑𑆮𑆬𑆳𑆚𑇀𑆘𑆤𑆳𑆤𑇀𑆠𑆼, 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆳, 𑆗𑆫𑇀𑆢𑆴𑆠𑆮𑆠𑆳, 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆾𑆠𑇀𑆡𑆴𑆠𑆼𑆤, 𑆱𑆳𑆪𑆁 𑆖𑆼𑆠𑆴 𑇆𑇕𑇑𑇆
𑆠𑆠𑇀𑆫 𑆠𑆬𑇀𑆥𑆾𑆠𑇀𑆡𑆴𑆠𑆼𑆤𑆳𑆱𑆼𑆮𑆴𑆠𑆂 𑆥𑇀𑆫𑆠𑆴𑆩𑆫𑇀𑆯𑆾 𑆫𑆳𑆠𑇀𑆫𑆳𑆮𑆶𑆥𑆖𑆴𑆠𑆁 𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆾𑆠𑆾𑆓𑆠𑆁 𑆩𑆬𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆴 𑆩𑆤𑆂𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴, 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆢𑆤𑇀𑆠𑆼𑆤𑆳𑆱𑆼𑆮𑆴𑆠𑆾 𑆢𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆸𑆞𑆠𑆳𑆁 𑆮𑆢𑆤𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆓𑆸𑆲𑆳𑆤𑇀𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆠𑆳 𑆱𑆼𑆮𑆴𑆠𑆾 𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆾𑆠𑆱𑆂 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆠𑆪𑆳 𑆫𑆘𑆾𑆣𑆷𑆩𑆾 𑆮𑆳 𑆤 𑆧𑆳𑆣𑆠𑆼, 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆩𑆽𑆡𑆶𑆤𑆳𑆣𑇀𑆮𑆥𑆫𑆴𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑆤𑆳𑆱𑆼𑆮𑆴𑆠𑆂 𑆯𑇀𑆫𑆩𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆴, 𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆳𑆤𑇀𑆠𑆼 𑆱𑆼𑆮𑆴𑆠𑆾 𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑇀𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆩𑆥𑆤𑆪𑆠𑆴, 𑆑𑆮𑆬𑆳𑆚𑇀𑆘𑆤𑆳𑆤𑇀𑆠𑆼 𑆱𑆼𑆮𑆴𑆠𑆾 𑆢𑆸𑆰𑇀𑆛𑆴𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆪𑆠𑆴, 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆳 𑆱𑆼𑆮𑆴𑆠𑆂 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆁 𑆬𑆔𑆶𑆠𑆳𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆮𑆳𑆤𑇀𑆠𑆼𑆤𑆳𑆱𑆼𑆮𑆴𑆠𑆂 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆬𑆓𑇀𑆤𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆥𑆾𑆲𑇀𑆪 𑆨𑆑𑇀𑆠𑆳𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆾𑆠𑇀𑆡𑆴𑆠𑆼𑆤𑆳𑆱𑆼𑆮𑆴𑆠𑆾 𑆤𑆴𑆢𑇀𑆫𑆳𑆯𑆼𑆰𑆁 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆩𑆬𑆁 𑆖𑆳𑆥𑆾𑆲𑇀𑆪 𑆖𑆴𑆠𑇀𑆠𑆽𑆑𑆳𑆓𑇀𑆫𑇀𑆪𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆱𑆳𑆪𑆁 𑆖𑆳𑆱𑆼𑆮𑆴𑆠𑆂 𑆱𑆶𑆒𑆤𑆴𑆢𑇀𑆫𑆳𑆥𑇀𑆫𑆧𑆾𑆣𑆁 𑆖𑆼𑆠𑆴 𑇆𑇕𑇒𑇆
𑆆𑆰𑆢𑆶𑆖𑇀𑆗𑆴𑆕𑇀𑆔𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆾 𑆪𑆳𑆮𑆢𑇀𑆮𑆑𑇀𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆤𑆱𑇀𑆪𑆼 𑆤𑆴𑆰𑆴𑆑𑇀𑆠𑆁 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆠𑆴𑆩𑆫𑇀𑆯𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆂 𑇆𑇕𑇓𑇆
𑆤𑆱𑇀𑆪𑆼𑆤 𑆫𑆾𑆓𑆳𑆂 𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆤𑆫𑆳𑆟𑆳𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆘𑆳𑆂 𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖 𑆮𑆽𑆩𑆬𑇀𑆪𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆳𑆱𑇀𑆪𑆁 𑆱𑆶𑆓𑆤𑇀𑆣𑆴 𑆖 𑇆𑇕𑇔𑇆
𑆲𑆤𑆶𑆢𑆤𑇀𑆠𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆳𑆠𑇀𑆫𑆴𑆑𑆧𑆳𑆲𑆷𑆫𑆱𑆳𑆁 𑆧𑆬𑆩𑇀 𑇅 𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆖𑆳𑆥𑇀𑆪𑆱𑆩𑇀𑆨𑆮𑆩𑇀 𑇆𑇕𑇕𑇆
𑆠𑆽𑆬𑆁 𑆑𑆦𑆼 𑆱𑆮𑆳𑆠𑆼 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆼𑆮𑆬𑆼 𑆥𑆮𑆤𑆼 𑆮𑆱𑆳𑆩𑇀 𑇅 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆢𑆳 𑆥𑆴𑆠𑇀𑆠𑆼 𑆩𑆘𑇀𑆘𑆳𑆤𑆁 𑆖 𑆱𑆩𑆳𑆫𑆶𑆠𑆼 𑇆𑇕𑇖𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆮𑆴𑆣𑆴𑆫𑆼𑆮𑆁 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑇀𑆡𑆳𑆤𑆳𑆮𑆴𑆫𑆾𑆣𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆼𑆰𑆶 𑆠𑆽𑆬𑆁 𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇕𑇗𑇆
𑆃𑆠𑆂 𑆥𑆫𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆟𑆼 𑆮𑆴𑆣𑆴𑆩𑇀 𑇅 𑆖𑆠𑆶𑆫𑇀𑆣𑆳 𑆑𑆮𑆬𑆂 𑆱𑇀𑆤𑆼𑆲𑆵 𑆥𑇀𑆫𑆱𑆳𑆢𑆵 𑆯𑆾𑆣𑆴𑆫𑆾𑆥𑆟𑆿 𑇆𑇕𑇘𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆽𑆂 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆾 𑆮𑆳𑆠𑆼, 𑆱𑇀𑆮𑆳𑆢𑆶𑆯𑆵𑆠𑆽𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆂 𑇅 𑆥𑆴𑆠𑇀𑆠𑆼, 𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆽 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆽𑆂 𑆯𑆾𑆣𑆤𑆂 𑆑𑆦𑆼 𑇆𑇕𑇙𑇆
𑆑𑆰𑆳𑆪𑆠𑆴𑆑𑇀𑆠𑆩𑆣𑆶𑆫𑆽𑆂 𑆑𑆛𑆷𑆰𑇀𑆟𑆽 𑆫𑆾𑆥𑆟𑆾 𑆮𑇀𑆫𑆟𑆼 𑇅 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆱𑇀𑆪 𑆖𑆽𑆮𑆳𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆾𑇁𑆪𑆁 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇖𑇐𑇆
𑆠𑆠𑇀𑆫 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆮𑆖𑆳𑆱𑆫𑇀𑆰𑆥𑆲𑆫𑆵𑆠𑆑𑆵𑆑𑆬𑇀𑆑𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆠𑆽𑆬𑆯𑆶𑆑𑇀𑆠𑆱𑆶𑆫𑆳𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆩𑆣𑆷𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆱𑆬𑆮𑆟𑆩𑆨𑆴𑆥𑇀𑆫𑆠𑆥𑇀𑆠𑆩𑆶𑆥𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆸𑆢𑆴𑆠𑆓𑆬𑆑𑆥𑆾𑆬𑆬𑆬𑆳𑆛𑆥𑇀𑆫𑆢𑆼𑆯𑆾 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇖𑇑𑇆
𑆱𑆶𑆒𑆁 𑆱𑆚𑇀𑆖𑆳𑆫𑇀𑆪𑆠𑆼 𑆪𑆳 𑆠𑆶 𑆩𑆳𑆠𑇀𑆫𑆳 𑆱 (𑆱𑆳) 𑆑𑆮𑆬𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆃𑆱𑆚𑇀𑆖𑆳𑆫𑇀𑆪𑆳 𑆠𑆶 𑆪𑆳 𑆩𑆳𑆠𑇀𑆫𑆳 𑆓𑆟𑇀𑆝𑆷𑆰𑆂 𑆱 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇖𑇒𑇆
𑆠𑆳𑆮𑆖𑇀𑆖 𑆣𑆳𑆫𑆪𑆴𑆠𑆮𑇀𑆪𑆾𑇁𑆤𑆤𑇀𑆪𑆩𑆤𑆱𑆾𑆤𑇀𑆤𑆠𑆢𑆼𑆲𑆼𑆤 𑆪𑆳𑆮𑆢𑇀𑆢𑆾𑆰𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆑𑆥𑆾𑆬𑆠𑇀𑆮𑆁 𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆾𑆠𑆾𑆤𑆪𑆤𑆥𑆫𑆴𑆥𑇀𑆬𑆳𑆮𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑆠𑆢𑆳 𑆮𑆴𑆩𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆂, 𑆥𑆶𑆤𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆾 𑆓𑇀𑆫𑆲𑆵𑆠𑆮𑇀𑆪 𑆅𑆠𑆴 𑇆𑇖𑇓𑇆
𑆍𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆪𑆂𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆫𑆱𑆩𑆷𑆠𑇀𑆫𑆳𑆩𑇀𑆬𑆱𑆩𑇀𑆨𑆸𑆠𑆳𑆂 𑇅 𑆑𑆰𑆳𑆪𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆑𑆮𑆬𑆳 𑆢𑆾𑆰𑆠𑆾 𑆲𑆴𑆠𑆳𑆂 𑇆𑇖𑇔𑇆
𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆥𑆖𑆪𑆱𑇀𑆠𑆶𑆰𑇀𑆛𑆴𑆫𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆁 𑆮𑆑𑇀𑆠𑇀𑆫𑆬𑆳𑆔𑆮𑆩𑇀 𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆯𑇀𑆖 𑆑𑆮𑆬𑆼 𑆯𑆶𑆢𑇀𑆣𑆴𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇖𑇕𑇆
𑆲𑆵𑆤𑆼 𑆘𑆳𑆝𑇀𑆪𑆑𑆦𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆳𑆮𑆫𑆱𑆘𑇀𑆚𑆳𑆤𑆩𑆼𑆮 𑆖 𑇅 𑆃𑆠𑆴𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆶𑆒𑆼 𑆥𑆳𑆑𑆂 𑆯𑆾𑆰𑆠𑆸𑆰𑇀𑆟𑆳𑆫𑆶𑆖𑆴𑆑𑇀𑆬𑆩𑆳𑆂 𑇆𑇖𑇖𑇆
𑆯𑆾𑆣𑆤𑆵𑆪𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆼𑆮 𑆤 𑆱𑆁𑆯𑆪𑆂 𑇅 𑆠𑆴𑆬𑆳 𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆯𑆫𑇀𑆑𑆫𑆳 𑆑𑇀𑆰𑆵𑆫𑆩𑆼𑆮 𑆖 𑇆𑇖𑇗𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆾 𑆢𑆓𑇀𑆣𑆮𑆑𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆓𑆟𑇀𑆝𑆷𑆰𑆾 𑆢𑆳𑆲𑆤𑆳𑆯𑆤𑆂 𑇅 𑆑𑆮𑆬𑆱𑇀𑆪 𑆮𑆴𑆣𑆴𑆫𑇀𑆲𑇀𑆪𑆼𑆰 𑆱𑆩𑆳𑆱𑆼𑆤 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇖𑇘𑇆
𑆮𑆴𑆨𑆘𑇀𑆪 𑆨𑆼𑆰𑆘𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆩𑇀 𑇅 𑆑𑆬𑇀𑆑𑆾 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑇀 𑇆𑇖𑇙𑇆
𑆃𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆓𑇀𑆫𑆥𑇀𑆫𑆟𑆵𑆠𑆁 𑆠𑆶 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆩𑆶𑆒𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆪𑆾𑆓𑆩𑆪𑆾𑆓𑆁 𑆖 𑆑𑆮𑆬𑆾𑆑𑇀𑆠𑆁 𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇗𑇐𑇆
𑆠𑆳𑆤𑆼𑆮 𑆯𑆩𑆪𑆼𑆢𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆑𑆮𑆬𑆾 𑆪𑆳𑆤𑆥𑆾𑆲𑆠𑆴 𑇅 𑆢𑆾𑆰𑆔𑇀𑆤𑆩𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖 𑆠𑆡𑆳 𑆤𑆫𑆩𑇀 𑇆𑇗𑇑𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆼𑆢𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆡 𑆒𑆬𑆶 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆩𑆫𑆮𑆫𑆩𑆸𑆰𑆴𑆓𑆟𑆥𑆫𑆴𑆮𑆸𑆠𑆩𑆳𑆯𑇀𑆫𑆩𑆱𑇀𑆡𑆁 𑆑𑆳𑆯𑆴𑆫𑆳𑆘𑆁 𑆢𑆴𑆮𑆾𑆢𑆳𑆱𑆁 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆩𑆿𑆥𑆣𑆼𑆤𑆮𑆮𑆽𑆠𑆫𑆟𑆿𑆫𑆨𑇀𑆫𑆥𑆿𑆰𑇀𑆑𑆬𑆳𑆮𑆠𑆑𑆫𑆮𑆵𑆫𑇀𑆪(𑆫)𑆓𑆾𑆥𑆶𑆫𑆫𑆑𑇀𑆰𑆴𑆠𑆱𑆶𑆯𑇀𑆫𑆶𑆠𑆥𑇀𑆫𑆨𑆸𑆠𑆪 𑆈𑆖𑆶𑆂 𑇆𑇓𑇆
𑆨𑆓𑆮𑆤𑇀! 𑆯𑆳𑆫𑆵𑆫𑆩𑆳𑆤𑆱𑆳𑆓𑆤𑇀𑆠𑆶𑆨𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆳𑆤𑇀 𑆱𑆤𑆳𑆡𑆳𑆤𑆥𑇀𑆪𑆤𑆳𑆡𑆮𑆢𑇀𑆮𑆴𑆖𑆼𑆰𑇀𑆛𑆩𑆳𑆤𑆳𑆤𑇀 𑆮𑆴𑆑𑇀𑆫𑆾𑆯𑆠𑆯𑇀𑆖 𑆩𑆳𑆤𑆮𑆳𑆤𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆩𑆤𑆱𑆴 𑆤𑆂 𑆥𑆵𑆝𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆼𑆰𑆳𑆁 𑆱𑆶𑆒𑆽𑆰𑆴𑆟𑆳𑆁 𑆫𑆾𑆓𑆾𑆥𑆯𑆩𑆳𑆫𑇀𑆡𑆩𑆳𑆠𑇀𑆩𑆤𑆯𑇀𑆖 𑆥𑇀𑆫𑆳𑆟𑆪𑆳𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆘𑆳𑆲𑆴𑆠𑆲𑆼𑆠𑆾𑆫𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆯𑇀𑆫𑆾𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆳𑆩 𑆅𑆲𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆩𑇀, 𑆃𑆠𑇀𑆫𑆳𑆪𑆠𑇀𑆠𑆩𑆽𑆲𑆴𑆑𑆩𑆳𑆩𑆶𑆰𑇀𑆩𑆴𑆑𑆁 𑆖 𑆯𑇀𑆫𑆼𑆪𑆂; 𑆠𑆢𑇀𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆥𑆤𑇀𑆤𑆳𑆂 𑆱𑇀𑆩𑆂 𑆯𑆴𑆰𑇀𑆪𑆠𑇀𑆮𑆼𑆤𑆼𑆠𑆴 𑇆𑇔𑇆
𑆠𑆳𑆤𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀- 𑆱𑇀𑆮𑆳𑆓𑆠𑆁 𑆮𑆂; 𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆩𑆵𑆩𑆳𑆁𑆱𑇀𑆪𑆳 𑆃𑆣𑇀𑆪𑆳𑆥𑇀𑆪𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆾 𑆮𑆠𑇀𑆱𑆳𑆂 𑇆𑇕𑇆
𑆅𑆲 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆤𑆳𑆩𑆾𑆥𑆳𑆕𑇀𑆓𑆩𑆡𑆫𑇀𑆮𑆮𑆼𑆢𑆱𑇀𑆪𑆳𑆤𑆶𑆠𑇀𑆥𑆳𑆢𑇀𑆪𑆽𑆮 𑆥𑇀𑆫𑆘𑆳𑆂 𑆯𑇀𑆬𑆾𑆑𑆯𑆠𑆱𑆲𑆱𑇀𑆫𑆩𑆣𑇀𑆪𑆳𑆪𑆱𑆲𑆱𑇀𑆫𑆁 𑆖 𑆑𑆸𑆠𑆮𑆳𑆤𑇀 𑆱𑇀𑆮𑆪𑆩𑇀𑆨𑆷𑆂, 𑆠𑆠𑆾𑇁𑆬𑇀𑆥𑆳𑆪𑆶𑆰𑇀𑆛𑇀𑆮𑆩𑆬𑇀𑆥𑆩𑆼𑆣𑆱𑇀𑆠𑇀𑆮𑆁 𑆖𑆳𑆬𑆾𑆑𑇀𑆪 𑆤𑆫𑆳𑆟𑆳𑆁 𑆨𑆷𑆪𑆾𑇁𑆰𑇀𑆛𑆣𑆳 𑆥𑇀𑆫𑆟𑆵𑆠𑆮𑆳𑆤𑇀 𑇆𑇖𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆬𑇀𑆪𑆁, 𑆯𑆳𑆬𑆳𑆑𑇀𑆪𑆁, 𑆑𑆳𑆪𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳, 𑆨𑆷𑆠𑆮𑆴𑆢𑇀𑆪𑆳, 𑆑𑆿𑆩𑆳𑆫𑆨𑆸𑆠𑇀𑆪𑆩𑇀, 𑆃𑆓𑆢𑆠𑆤𑇀𑆠𑇀𑆫𑆁, 𑆫𑆱𑆳𑆪𑆤𑆠𑆤𑇀𑆠𑇀𑆫𑆁, 𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆴𑆠𑆴 𑇆𑇗𑇆
𑆍𑆮𑆩𑆪𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆾𑇁𑆰𑇀𑆛𑆳𑆕𑇀𑆓 𑆇𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼; 𑆃𑆠𑇀𑆫 𑆑𑆱𑇀𑆩𑆽 𑆑𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆳𑆩𑆴𑆠𑆴 𑇆𑇙𑇆
𑆠 𑆈𑆖𑆶𑆂- 𑆃𑆱𑇀𑆩𑆳𑆑𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆯𑆬𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆁 𑆩𑆷𑆬𑆁 𑆑𑆸𑆠𑇀𑆮𑆾𑆥𑆢𑆴𑆯𑆠𑆶 𑆨𑆓𑆮𑆳𑆤𑆴𑆠𑆴 𑇆𑇑𑇐𑇆
𑆱 𑆇𑆮𑆳𑆖𑆽𑆮𑆩𑆱𑇀𑆠𑇀𑆮𑆴𑆠𑆴 𑇆𑇑𑇑𑇆
𑆠 𑆈𑆖𑆶𑆫𑇀𑆨𑆷𑆪𑆾𑇁𑆥𑆴 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑇀- 𑆃𑆱𑇀𑆩𑆳𑆑𑆩𑆼𑆑𑆩𑆠𑆵𑆤𑆳𑆁 𑆩𑆠𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆶𑆯𑇀𑆫𑆶𑆠𑆾 𑆨𑆓𑆮𑆤𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑇀𑆪𑆠𑆴, 𑆃𑆱𑇀𑆩𑆽 𑆖𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆮𑆪𑆩𑆥𑇀𑆪𑆶𑆣𑆳𑆫𑆪𑆴𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇒𑇆
𑆱 𑆇𑆮𑆳𑆖𑆽𑆮𑆩𑆱𑇀𑆠𑇀𑆮𑆴𑆠𑆴 𑇆𑇑𑇓𑇆
𑆮𑆠𑇀𑆱 𑆱𑆶𑆯𑇀𑆫𑆶𑆠! 𑆅𑆲 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁- 𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆴𑆩𑆾𑆑𑇀𑆰𑆂, 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪 𑆫𑆑𑇀𑆰𑆟𑆁 𑆖 𑇆𑇑𑇔𑇆
‘𑆄𑆪𑆶𑆫𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆴𑆢𑇀𑆪𑆠𑆼, 𑆃𑆤𑆼𑆤 𑆮𑆳𑇁𑇁𑆪𑆶𑆫𑇀𑆮𑆴𑆤𑇀𑆢𑆤𑇀𑆠𑆴’ 𑆅𑆠𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆂 𑇆𑇑𑇕𑇆
𑆠𑆱𑇀𑆪𑆳𑆕𑇀𑆓𑆮𑆫𑆩𑆳𑆢𑇀𑆪𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆓𑆩𑆳𑆤𑆶𑆩𑆳𑆤𑆾𑆥𑆩𑆳𑆤𑆽𑆫𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪 𑇆𑇑𑇖𑇆
𑆍𑆠𑆢𑇀𑆣𑇀𑆪𑆕𑇀𑆓𑆁 𑆥𑇀𑆫𑆡𑆩𑆁, 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆔𑆳𑆠𑆮𑇀𑆫𑆟𑆱𑆁𑆫𑆾𑆲𑆳𑆢𑇀𑆪𑆘𑇀𑆚𑆯𑆴𑆫𑆂𑆱𑆤𑇀𑆣𑆳𑆤𑆳𑆖𑇀𑆖 𑇅 𑆯𑇀𑆫𑆷𑆪𑆠𑆼 𑆲𑆴 𑆪𑆡𑆳- “𑆫𑆶𑆢𑇀𑆫𑆼𑆟 𑆪𑆘𑇀𑆚𑆱𑇀𑆪 𑆯𑆴𑆫𑆯𑇀𑆗𑆴𑆤𑇀𑆤𑆩𑆴𑆠𑆴, 𑆠𑆠𑆾 𑆢𑆼𑆮𑆳 𑆃𑆯𑇀𑆮𑆴𑆤𑆳𑆮𑆨𑆴𑆓𑆩𑇀𑆪𑆾𑆖𑆶𑆂- 𑆨𑆓𑆮𑆤𑇀𑆠𑆿 𑆤𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆠𑆩𑆿 𑆪𑆶𑆮𑆳𑆁 𑆨𑆮𑆴𑆰𑇀𑆪𑆡𑆂, 𑆨𑆮𑆢𑇀𑆨𑇀𑆪𑆳𑆁 𑆪𑆘𑇀𑆚𑆱𑇀𑆪 𑆯𑆴𑆫𑆂 𑆱𑆤𑇀𑆣𑆳𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑆴 𑇅 𑆠𑆳𑆮𑆷𑆖𑆠𑆶𑆫𑆼𑆮𑆩𑆱𑇀𑆠𑇀𑆮𑆴𑆠𑆴 𑇅 𑆃𑆡 𑆠𑆪𑆾𑆫𑆫𑇀𑆡𑆼 𑆢𑆼𑆮𑆳 𑆅𑆤𑇀𑆢𑇀𑆫𑆁 𑆪𑆘𑇀𑆚𑆨𑆳𑆓𑆼𑆤 𑆥𑇀𑆫𑆳𑆱𑆳𑆢𑆪𑆤𑇀 𑇅 𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆪𑆘𑇀𑆚𑆱𑇀𑆪 𑆯𑆴𑆫𑆂 𑆱𑆁𑆲𑆴𑆠𑆩𑇀” 𑆅𑆠𑆴 𑇆𑇑𑇗𑇆
𑆃𑆰𑇀𑆛𑆳𑆱𑇀𑆮𑆥𑆴 𑆖𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑇀𑆮𑆼𑆠𑆢𑆼𑆮𑆳𑆣𑆴𑆑𑆩𑆨𑆴𑆩𑆠𑆩𑇀, 𑆄𑆯𑆶𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆫𑆟𑆳𑆢𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆖𑇀𑆖 𑇆𑇑𑇘𑇆
𑆠𑆢𑆴𑆢𑆁 𑆯𑆳𑆯𑇀𑆮𑆠𑆁 𑆥𑆶𑆟𑇀𑆪𑆁 𑆱𑇀𑆮𑆫𑇀𑆓𑇀𑆪𑆁 𑆪𑆯𑆱𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆫𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇙𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆥𑇀𑆫𑆾𑆮𑆳𑆖 𑆠𑆠𑆂 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆫𑆣𑆴𑆘𑆓𑆼, 𑆠𑆱𑇀𑆩𑆳𑆢𑆯𑇀𑆮𑆴𑆤𑆿, 𑆃𑆯𑇀𑆮𑆴𑆨𑇀𑆪𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆂, 𑆅𑆤𑇀𑆢𑇀𑆫𑆳𑆢𑆲𑆁, 𑆩𑆪𑆳 𑆠𑇀𑆮𑆴𑆲 𑆥𑇀𑆫𑆢𑆼𑆪𑆩𑆫𑇀𑆡𑆴𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆘𑆳𑆲𑆴𑆠𑆲𑆼𑆠𑆾𑆂 𑇆𑇒𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆲𑆁 𑆲𑆴 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆫𑆳𑆢𑆴𑆢𑆼𑆮𑆾 𑆘𑆫𑆳𑆫𑆶𑆘𑆳𑆩𑆸𑆠𑇀𑆪𑆶𑆲𑆫𑆾𑇁𑆩𑆫𑆳𑆟𑆳𑆩𑇀 𑇅 𑆯𑆬𑇀𑆪𑆳𑆕𑇀𑆓𑆩𑆕𑇀𑆓𑆽𑆫𑆥𑆫𑆽𑆫𑆶𑆥𑆼𑆠𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆾𑇁𑆱𑇀𑆩𑆴 𑆓𑆳𑆁 𑆨𑆷𑆪 𑆅𑆲𑆾𑆥𑆢𑆼𑆰𑇀𑆛𑆶𑆩𑇀 𑇆𑇒𑇑𑇆
𑆃𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆯𑆫𑆵𑆫𑆴𑆱𑆩𑆮𑆳𑆪𑆂 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳, 𑆱𑆾𑇁𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁; 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆬𑆾𑆑𑆱𑇀𑆪 𑆢𑇀𑆮𑆽𑆮𑆴𑆣𑇀𑆪𑆳𑆠 ; 𑆬𑆾𑆑𑆾 𑆲𑆴 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂 𑆱𑇀𑆡𑆳𑆮𑆫𑆾 𑆘𑆕𑇀𑆓𑆩𑆯𑇀𑆖; 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆠𑇀𑆩𑆑 𑆍𑆮𑆳𑆓𑇀𑆤𑆼𑆪𑆂, 𑆱𑆿𑆩𑇀𑆪𑆯𑇀𑆖, 𑆠𑆢𑇀𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑇀; 𑆥𑆚𑇀𑆖𑆳𑆠𑇀𑆩𑆑𑆾 𑆮𑆳; 𑆠𑆠𑇀𑆫 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾 𑆨𑆷𑆠𑆓𑇀𑆫𑆳𑆩𑆂 𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑆘𑆘𑆫𑆳𑆪𑆶𑆘𑆳𑆟𑇀𑆝𑆘𑆾𑆢𑇀𑆨𑆴𑆘𑇀𑆘𑆱𑆚𑇀𑆘𑇀𑆚𑆂 ; 𑆠𑆠𑇀𑆫 𑆥𑆶𑆫𑆶𑆰𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆠𑆱𑇀𑆪𑆾𑆥𑆑𑆫𑆟𑆩𑆤𑇀𑆪𑆠𑇀; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆶𑆫𑆶𑆰𑆾𑇁𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑇀 𑇆𑇒𑇒𑇆
𑆠𑆢𑇀𑆢𑆶𑆂𑆒𑆱𑆁𑆪𑆾𑆓𑆳 𑆮𑇀𑆪𑆳𑆣𑆪 𑆇𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇒𑇓𑇆
𑆠𑆼 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆂- 𑆄𑆓𑆤𑇀𑆠𑆮𑆂, 𑆯𑆳𑆫𑆵𑆫𑆳𑆂, 𑆩𑆳𑆤𑆱𑆳𑆂, 𑆱𑇀𑆮𑆳𑆨𑆳𑆮𑆴𑆑𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇒𑇔𑇆
𑆠 𑆍𑆠𑆼 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆂 𑇆𑇒𑇖𑇆
𑆠𑆼𑆰𑆳𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆁𑆯𑆩𑆤𑆳𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆳𑆂 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳 𑆤𑆴𑆓𑇀𑆫𑆲𑆲𑆼𑆠𑆮𑆂 𑇆𑇒𑇗𑇆
𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆷𑆬𑆩𑆳𑆲𑆳𑆫𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆿𑆘𑆱𑆳𑆁 𑆖 𑇅 𑆱 𑆰𑆛𑇀𑆱𑆶 𑆫𑆱𑆼𑆰𑇀𑆮𑆳𑆪𑆠𑇀𑆠𑆂; 𑆫𑆱𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳𑆂; 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆥𑆶𑆤𑆫𑆾𑆰𑆣𑆪𑆂 𑇅 𑆠𑆳𑆱𑇀𑆠𑆶 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆂- 𑆱𑇀𑆡𑆳𑆮𑆫𑆳 𑆘𑆕𑇀𑆓𑆩𑆳𑆯𑇀𑆖 𑇆𑇒𑇘𑇆
𑆠𑆳𑆱𑆳𑆁 𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆂- 𑆮𑆤𑆱𑇀𑆥𑆠𑆪𑆾, 𑆮𑆸𑆑𑇀𑆰𑆳, 𑆮𑆵𑆫𑆶𑆣, 𑆏𑆰𑆣𑆪 𑆅𑆠𑆴 𑇅 𑆠𑆳𑆱𑆶, 𑆃𑆥𑆶𑆰𑇀𑆥𑆳𑆂 𑆦𑆬𑆮𑆤𑇀𑆠𑆾 𑆮𑆤𑆱𑇀𑆥𑆠𑆪𑆂, 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆮𑆤𑇀𑆠𑆾 𑆮𑆸𑆑𑇀𑆰𑆳𑆂, 𑆥𑇀𑆫𑆠𑆳𑆤𑆮𑆠𑇀𑆪𑆂 𑆱𑇀𑆠𑆩𑇀𑆧𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆮𑆵𑆫𑆶𑆣𑆂, 𑆦𑆬𑆥𑆳𑆑𑆤𑆴𑆰𑇀𑆜𑆳 𑆏𑆰𑆣𑆪 𑆅𑆠𑆴 𑇆𑇒𑇙𑇆
𑆘𑆕𑇀𑆓𑆩𑆳 𑆒𑆬𑇀𑆮𑆥𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆂- 𑆘𑆫𑆳𑆪𑆶𑆘𑆳𑆟𑇀𑆝𑆘𑆱𑇀𑆮𑆼𑆢𑆘𑆾𑆢𑇀𑆨𑆴𑆘𑇀𑆘𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆯𑆶𑆩𑆤𑆶𑆰𑇀𑆪𑆮𑇀𑆪𑆳𑆬𑆳𑆢𑆪𑆾 𑆘𑆫𑆳𑆪𑆶𑆘𑆳𑆂, 𑆒𑆓𑆱𑆫𑇀𑆥𑆱𑆫𑆵𑆱𑆸𑆥𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾𑇁𑆟𑇀𑆝𑆘𑆳𑆂, 𑆑𑆸𑆩𑆴𑆑𑆵𑆛𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂 𑆱𑇀𑆮𑆼𑆢𑆘𑆳𑆂, 𑆅𑆤𑇀𑆢𑇀𑆫𑆓𑆾𑆥𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆪 𑆇𑆢𑇀𑆨𑆴𑆘𑇀𑆘𑆳𑆂 𑇆𑇓𑇐𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆡𑆳𑆮𑆫𑆼𑆨𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆩𑆷𑆬𑆑𑆤𑇀𑆢𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆱𑇀𑆮𑆫𑆱𑆳𑆢𑆪𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆮𑆤𑇀𑆠𑆂; 𑆘𑆕𑇀𑆓𑆩𑆼𑆨𑇀𑆪𑆯𑇀𑆖𑆫𑇀𑆩𑆤𑆒𑆫𑆾𑆩𑆫𑆶𑆣𑆴𑆫𑆳𑆢𑆪𑆂 𑇆𑇓𑇑𑇆
𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆂 𑆱𑆶𑆮𑆫𑇀𑆟𑆫𑆘𑆠𑆩𑆟𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆩𑆸𑆠𑇀𑆑𑆥𑆳𑆬𑆳𑆢𑆪𑆂 𑇆𑇓𑇒𑇆
𑆑𑆳𑆬𑆑𑆸𑆠𑆳𑆂𑆥𑇀𑆫𑆮𑆳𑆠𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆖𑇀𑆗𑆳𑆪𑆳𑆘𑇀𑆪𑆾𑆠𑇀𑆱𑇀𑆤𑆳𑆠𑆩𑆂𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆳𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆥𑆑𑇀𑆰𑆩𑆳𑆱𑆫𑇀𑆠𑇀𑆮𑆪𑆤𑆳𑆢𑆪𑆂 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑇆𑇓𑇓𑇆
𑆠 𑆍𑆠𑆼 𑆱𑇀𑆮𑆨𑆳𑆮𑆠 𑆍𑆮 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆚𑇀𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆥𑇀𑆫𑆯𑆩𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆲𑆼𑆠𑆮𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆮𑆤𑇀𑆠𑆯𑇀𑆖 𑇆𑇓𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆯𑆳𑆫𑆵𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆼𑆰 𑆮𑆫𑇀𑆓𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑇅 𑆥𑇀𑆫𑆑𑆾𑆥𑆼 𑆥𑇀𑆫𑆯𑆩𑆼 𑆖𑆽𑆮 𑆲𑆼𑆠𑆶𑆫𑆶𑆑𑇀𑆠𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆽𑆂 𑇆𑇓𑇕𑇆
𑆄𑆓𑆤𑇀𑆠𑆮𑆱𑇀𑆠𑆶 𑆪𑆼 𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆼 𑆢𑇀𑆮𑆴𑆣𑆳 𑆤𑆴𑆥𑆠𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆩𑆤𑆱𑇀𑆪𑆤𑇀𑆪𑆼 𑆯𑆫𑆵𑆫𑆼𑇁𑆤𑇀𑆪𑆼 𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆑𑇀𑆫𑆴𑆪𑆳 𑇆𑇓𑇖𑇆
𑆯𑆫𑆵𑆫𑆥𑆠𑆴𑆠𑆳𑆤𑆳𑆁 𑆠𑆶 𑆯𑆳𑆫𑆵𑆫𑆮𑆢𑆶𑆥𑆑𑇀𑆫𑆩𑆂 𑇅 𑆩𑆳𑆤𑆱𑆳𑆤𑆳𑆁 𑆠𑆶 𑆯𑆧𑇀𑆢𑆳𑆢𑆴𑆫𑆴𑆰𑇀𑆛𑆾 𑆮𑆫𑇀𑆓𑆂 𑆱𑆶𑆒𑆳𑆮𑆲𑆂 𑇆𑇓𑇗𑇆
𑆍𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑆶𑆫𑆶𑆰𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆿𑆰𑆣𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆳𑆬 𑆅𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆁 𑆱𑆩𑆳𑆱𑆼𑆤 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆶𑆫𑆶𑆰𑆓𑇀𑆫𑆲𑆟𑆳𑆠𑇀 𑆠𑆠𑇀𑆱𑆩𑇀𑆨𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑆷𑆲𑆾 𑆨𑆷𑆠𑆳𑆢𑆴𑆫𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑆢𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆯𑇀𑆖 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆱𑇀𑆡𑆴𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂, 𑆮𑇀𑆪𑆳𑆣𑆴𑆓𑇀𑆫𑆲𑆟𑆳𑆢𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆮𑆽𑆰𑆩𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆮𑇀𑆪𑆳𑆣𑆪𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆐𑆰𑆣𑆓𑇀𑆫𑆲𑆟𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆳𑆩𑆳𑆢𑆼𑆯𑆂, 𑆑𑇀𑆫𑆴𑆪𑆳𑆓𑇀𑆫𑆲𑆟𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆵𑆤𑆴 𑆖𑇀𑆗𑆼𑆢𑇀𑆪𑆳𑆢𑆵𑆤𑆴 𑆖 𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴, 𑆑𑆳𑆬𑆓𑇀𑆫𑆲𑆟𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆳𑆬𑆳𑆤𑆳𑆩𑆳𑆢𑆼𑆯𑆂 𑇆𑇓𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆧𑆵𑆘𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆱𑇀𑆪𑆽𑆠𑆠𑇀𑆱𑆩𑆳𑆱𑆼𑆤 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆱𑆮𑆴𑆁𑆯𑆩𑆣𑇀𑆪𑆳𑆪𑆯𑆠𑆩𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆴 𑇆𑇓𑇙𑇆
𑆠𑆖𑇀𑆖 𑆱𑆮𑆴𑆁𑆯𑆩𑆣𑇀𑆪𑆳𑆪𑆯𑆠𑆁 𑆥𑆚𑇀𑆖𑆱𑆶 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆷𑆠𑇀𑆫𑆤𑆴𑆢𑆳𑆤𑆯𑆳𑆫𑆵𑆫𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆑𑆬𑇀𑆥𑆼𑆰𑇀𑆮𑆫𑇀𑆡𑆮𑆯𑆳𑆠𑇀 𑆱𑆁𑆮𑆴𑆨𑆘𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆼 𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆯𑆼𑆰𑆳𑆤𑆫𑇀𑆡𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇔𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆮𑆪𑆩𑇀𑆨𑆶𑆮𑆳 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆩𑆴𑆢𑆁 𑆱𑆤𑆳𑆠𑆤𑆁 𑆥𑆜𑆼𑆢𑇀𑆣𑆴 𑆪𑆂 𑆑𑆳𑆯𑆴𑆥𑆠𑆴𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀 𑇅 𑆱 𑆥𑆶𑆟𑇀𑆪𑆑𑆫𑇀𑆩𑆳 𑆨𑆶𑆮𑆴 𑆥𑆷𑆘𑆴𑆠𑆾 𑆤𑆸𑆥𑆽𑆫𑆱𑆶𑆑𑇀𑆰𑆪𑆼 𑆯𑆑𑇀𑆫𑆱𑆬𑆾𑆑𑆠𑆳𑆁 𑆮𑇀𑆫𑆘𑆼𑆠𑇀 𑇆𑇔𑇑𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆴𑆰𑇀𑆪𑆾𑆥𑆤𑆪𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆑𑇀𑆰𑆠𑇀𑆫𑆴𑆪𑆮𑆽𑆯𑇀𑆪𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆤𑇀𑆮𑆪𑆮𑆪𑆂𑆯𑆵𑆬𑆯𑆿𑆫𑇀𑆪𑆯𑆿𑆖𑆳𑆖𑆳𑆫𑆮𑆴𑆤𑆪𑆯𑆑𑇀𑆠𑆴𑆧𑆬𑆩𑆼𑆣𑆳𑆣𑆸𑆠𑆴𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆠𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆤𑆶𑆘𑆴𑆲𑇀𑆮𑆿𑆰𑇀𑆜𑆢𑆤𑇀𑆠𑆳𑆓𑇀𑆫𑆩𑆸𑆘𑆶𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆤𑆳𑆱𑆁 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆖𑆴𑆠𑇀𑆠𑆮𑆳𑆑𑇀𑆖𑆼𑆰𑇀𑆛𑆁 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆁 𑆖 𑆨𑆴𑆰𑆑𑇀 𑆯𑆴𑆰𑇀𑆪𑆩𑆶𑆥𑆤𑆪𑆼𑆠𑇀 𑇅 𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆁 𑆤𑆾𑆥𑆤𑆪𑆼𑆠𑇀 𑇆𑇓𑇆
𑆇𑆥𑆤𑆪𑆤𑆵𑆪𑆁 𑆠𑆶 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼𑆰𑆶 𑆠𑆴𑆡𑆴𑆑𑆫𑆟𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆰𑆶 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆪𑆳𑆁 𑆢𑆴𑆯𑆴 𑆯𑆶𑆖𑆿 𑆱𑆩𑆼 𑆢𑆼𑆯𑆼 𑆖𑆠𑆶𑆫𑇀𑆲𑆱𑇀𑆠𑆁 𑆖𑆠𑆶𑆫𑆱𑇀𑆫𑆁 𑆱𑇀𑆡𑆟𑇀𑆝𑆴𑆬𑆩𑆶𑆥𑆬𑆴𑆥𑇀𑆪 𑆓𑆾𑆩𑆪𑆼𑆤, 𑆢𑆫𑇀𑆨𑆽𑆂 𑆱𑆁𑆱𑇀𑆠𑆵𑆫𑇀𑆪 𑆫𑆠𑇀𑆤𑆥𑆶𑆰𑇀𑆥𑆬𑆳𑆘𑆨𑆑𑇀𑆠𑆽𑆫𑇀𑆢𑆼𑆮𑆠𑆳𑆂 𑆥𑆷𑆘𑆪𑆴𑆠𑇀𑆮𑆳 𑆮𑆴𑆥𑇀𑆫𑆳𑆤𑇀 𑆨𑆴𑆰𑆘𑆯𑇀𑆖, 𑆠𑆠𑇀𑆫𑆾𑆬𑇀𑆬𑆴𑆒𑇀𑆪𑆳𑆨𑇀𑆪𑆶𑆑𑇀𑆰𑇀𑆪 𑆖 𑆢𑆑𑇀𑆰𑆴𑆟𑆠𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆟𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆱𑆩𑆳𑆣𑆳𑆪, 𑆒𑆢𑆴𑆫𑆥𑆬𑆳𑆯𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆧𑆴𑆬𑇀𑆮𑆳𑆤𑆳𑆁 𑆱𑆩𑆴𑆢𑇀𑆨𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆴𑆮𑆸𑆑𑇀𑆰𑆳𑆟𑆳𑆁 (𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆩𑆣𑆷𑆑𑆳𑆤𑆳𑆁) 𑆢𑆣𑆴𑆩𑆣𑆶𑆔𑆸𑆠𑆳𑆑𑇀𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆳𑆫𑇀𑆮𑆵𑆲𑆿𑆩𑆴𑆑𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆥𑇀𑆫𑆟𑆮𑆳𑆨𑆴𑆫𑇀𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆲𑆸𑆠𑆴𑆨𑆴𑆂 𑆱𑇀𑆫𑆶𑆮𑆼𑆟𑆳𑆘𑇀𑆪𑆳𑆲𑆶𑆠𑆵𑆫𑇀𑆘𑆶𑆲𑆶𑆪𑆳𑆠𑇀, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆠𑆴𑆢𑆽𑆮𑆠𑆩𑆸𑆰𑆵𑆁𑆯𑇀𑆖 𑆱𑇀𑆮𑆳𑆲𑆳𑆑𑆳𑆫𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆯𑆴𑆰𑇀𑆪𑆩𑆥𑆴 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇔𑇆
𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆱𑇀𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆶𑆥𑆤𑆪𑆤𑆁 𑆑𑆫𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴, (𑆫𑆳𑆘𑆤𑇀𑆪𑆾 𑆢𑇀𑆮𑆪𑆱𑇀𑆪, 𑆮𑆽𑆯𑇀𑆪𑆾 𑆮𑆽𑆯𑇀𑆪𑆱𑇀𑆪𑆽𑆮𑆼𑆠𑆴;) 𑆯𑆷𑆢𑇀𑆫𑆩𑆥𑆴 𑆑𑆶𑆬𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆩𑆤𑇀𑆠𑇀𑆫𑆮𑆫𑇀𑆘𑆩𑆤𑆶𑆥𑆤𑆵𑆠𑆩𑆣𑇀𑆪𑆳𑆥𑆪𑆼𑆢𑆴𑆠𑇀𑆪𑆼𑆑𑆼 𑇆𑇕𑇆
𑆠𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆁 𑆠𑇀𑆫𑆴𑆂 𑆥𑆫𑆴𑆟𑆵𑆪𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆑𑇀𑆰𑆴𑆑𑆁 𑆯𑆴𑆰𑇀𑆪𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆩𑆾𑆲𑆩𑆳𑆤𑆳𑆲𑆕𑇀𑆑𑆳𑆫𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆥𑆽𑆯𑆶𑆤𑇀𑆪𑆳𑆤𑆸𑆠𑆳𑆬𑆱𑇀𑆪𑆳𑆪𑆯𑆱𑇀𑆪𑆳𑆤𑆴 𑆲𑆴𑆠𑇀𑆮𑆳, 𑆤𑆵𑆖𑆤𑆒𑆫𑆾𑆩𑇀𑆟𑆳𑆯𑆶𑆖𑆴𑆤𑆳 𑆑𑆰𑆳𑆪𑆮𑆳𑆱𑆱𑆳 𑆱𑆠𑇀𑆪𑆮𑇀𑆫𑆠𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆳𑆨𑆴𑆮𑆳𑆢𑆤𑆠𑆠𑇀𑆥𑆫𑆼𑆟𑆳𑆮𑆯𑇀𑆪𑆁 𑆨𑆮𑆴𑆠𑆮𑇀𑆪𑆁, 𑆩𑆢𑆤𑆶𑆩𑆠𑆱𑇀𑆡𑆳𑆤𑆓𑆩𑆤𑆯𑆪𑆤𑆳𑆱𑆤𑆨𑆾𑆘𑆤𑆳𑆣𑇀𑆪𑆪𑆤𑆥𑆫𑆼𑆟 𑆨𑆷𑆠𑇀𑆮𑆳 𑆩𑆠𑇀𑆥𑇀𑆫𑆴𑆪𑆲𑆴𑆠𑆼𑆰𑆶 𑆮𑆫𑇀𑆠𑆴𑆠𑆮𑇀𑆪𑆩𑇀; 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆠𑆼 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆱𑇀𑆪𑆳𑆣𑆫𑇀𑆩𑆾 𑆨𑆮𑆠𑆴, 𑆃𑆦𑆬𑆳 𑆖 𑆮𑆴𑆢𑇀𑆪𑆳, 𑆤 𑆖 𑆥𑇀𑆫𑆳𑆑𑆳𑆯𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑇆𑇖𑇆
𑆃𑆲𑆁 𑆮𑆳 𑆠𑇀𑆮𑆪𑆴 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆼 𑆪𑆢𑇀𑆪𑆤𑇀𑆪𑆡𑆳𑆢𑆫𑇀𑆯𑆵 𑆱𑇀𑆪𑆳𑆩𑆼𑆤𑆾𑆨𑆳𑆓𑇀𑆨𑆮𑆼𑆪𑆩𑆦𑆬𑆮𑆴𑆢𑇀𑆪𑆯𑇀𑆖 𑇆𑇗𑇆
𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆢𑆫𑆴𑆢𑇀𑆫𑆩𑆴𑆠𑇀𑆫𑆥𑇀𑆫𑆮𑇀𑆫𑆘𑆴𑆠𑆾𑆥𑆤𑆠𑆱𑆳𑆣𑇀𑆮𑆤𑆳𑆡𑆳𑆨𑇀𑆪𑆶𑆥𑆓𑆠𑆳𑆤𑆳𑆁 𑆖𑆳𑆠𑇀𑆩𑆧𑆳𑆤𑇀𑆣𑆮𑆳𑆤𑆳𑆩𑆴𑆮 𑆱𑇀𑆮𑆨𑆽𑆰𑆘𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑇀, 𑆍𑆮𑆁 𑆱𑆳𑆣𑆶 𑆨𑆮𑆠𑆴; 𑆮𑇀𑆪𑆳𑆣𑆯𑆳𑆑𑆶𑆤𑆴𑆑𑆥𑆠𑆴𑆠𑆥𑆳𑆥𑆑𑆳𑆫𑆴𑆟𑆳𑆁 𑆖 𑆤 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑇀; 𑆍𑆮𑆁 𑆮𑆴𑆢𑇀𑆪𑆳 𑆥𑇀𑆫𑆑𑆳𑆯𑆠𑆼 𑆩𑆴𑆠𑇀𑆫𑆪𑆯𑆾𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑇆𑇘𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆑𑆸𑆰𑇀𑆟𑆼𑇁𑆰𑇀𑆛𑆩𑆵 𑆠𑆤𑇀𑆤𑆴𑆣𑆤𑆼𑇁𑆲𑆤𑆵 𑆢𑇀𑆮𑆼 𑆯𑆶𑆑𑇀𑆬𑆼 𑆠𑆡𑆳𑇁𑆥𑇀𑆪𑆼𑆮𑆩𑆲𑆫𑇀𑆢𑇀𑆮𑆴𑆱𑆤𑇀𑆣𑇀𑆪𑆩𑇀 𑇅 𑆃𑆑𑆳𑆬𑆮𑆴𑆢𑇀𑆪𑆶𑆠𑇀𑆱𑇀𑆠𑆤𑆪𑆴𑆠𑇀𑆤𑆶𑆔𑆾𑆰𑆼 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆑𑇀𑆰𑆴𑆠𑆴𑆥𑆮𑇀𑆪𑆡𑆳𑆱𑆶 𑇆𑇙𑇆
𑆯𑇀𑆩𑆯𑆳𑆤𑆪𑆳𑆤𑆳𑆢𑇀𑆪𑆠𑆤𑆳𑆲𑆮𑆼𑆰𑆶 𑆩𑆲𑆾𑆠𑇀𑆱𑆮𑆿𑆠𑇀𑆥𑆳𑆠𑆴𑆑𑆢𑆫𑇀𑆯𑆤𑆼𑆰𑆶 𑇅 𑆤𑆳𑆣𑇀𑆪𑆼𑆪𑆩𑆤𑇀𑆪𑆼𑆰𑆶 𑆖 𑆪𑆼𑆰𑆶 𑆮𑆴𑆥𑇀𑆫𑆳 𑆤𑆳𑆣𑆵𑆪𑆠𑆼 𑆤𑆳𑆯𑆶𑆖𑆴𑆤𑆳 𑆖 𑆤𑆴𑆠𑇀𑆪𑆩𑇀 𑇆𑇑𑇐𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆣𑇀𑆪𑆪𑆤𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆁 𑆱𑆮𑆴𑆁𑆯𑆩𑆣𑇀𑆪𑆳𑆪𑆯𑆠𑆁 𑆥𑆚𑇀𑆖𑆱𑆶 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆷𑆠𑇀𑆫𑆱𑇀𑆡𑆳𑆤𑆩𑆣𑇀𑆪𑆳𑆪𑆳𑆂 𑆰𑆛𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀, 𑆰𑆾𑆝𑆯 𑆤𑆴𑆢𑆳𑆤𑆳𑆤𑆴, 𑆢𑆯 𑆯𑆳𑆫𑆵𑆫𑆳𑆟𑆴, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆤𑆴, 𑆃𑆰𑇀𑆛𑆿 𑆑𑆬𑇀𑆥𑆳𑆂, 𑆠𑆢𑆶𑆠𑇀𑆠𑆫𑆁 𑆰𑆛𑇀𑆰𑆰𑇀𑆛𑆴𑆂 𑇆𑇓𑇆
𑆮𑆼𑆢𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆯𑆴𑆰𑇀𑆪𑆤𑆪𑆱𑇀𑆠𑆡𑆳𑇁𑆣𑇀𑆪𑆪𑆤𑆢𑆳𑆤𑆴𑆑𑆂 𑇅 𑆥𑇀𑆫𑆨𑆳𑆰𑆟𑆳𑆓𑇀𑆫𑆲𑆫𑆟𑆳𑆮𑆸𑆠𑆶𑆖𑆫𑇀𑆪𑆳𑇁𑆡 𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆴𑆑𑆂 𑇆𑇔𑇆

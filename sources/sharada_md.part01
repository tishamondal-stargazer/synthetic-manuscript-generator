𑆯𑆶𑆰𑇀𑆪𑆠𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑆸𑆯𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆵𑆟𑆫𑆼𑆠𑆱𑆳𑆩𑇀𑇅 𑆧𑆬𑆮𑆫𑇀𑆟𑆳𑆫𑇀𑆡𑆴𑆤𑆳𑆁 𑆖𑆽𑆮 𑆫𑆱𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆳𑆩𑆸𑆠𑆩𑇀𑇆𑇓𑇑𑇓𑇆
𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆮𑆴𑆲𑆴𑆠𑆁 𑆫𑆱𑆩𑇀𑇅 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆧𑆬𑆑𑆫𑆁 𑆮𑆪𑆾𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆪𑆶𑆰𑆳𑆩𑇀𑇆𑇓𑇑𑇔𑇆
𑆑𑇀𑆫𑆴𑆩𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆲𑆠𑆁 𑆯𑆶𑆰𑇀𑆑𑆁 𑆘𑆵𑆫𑇀𑆟𑆩𑆤𑆳𑆫𑇀𑆠𑆮𑆩𑇀𑇅 𑆯𑆳𑆑𑆁 𑆤𑆴𑆂𑆱𑇀𑆤𑆼𑆲𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆮𑆫𑇀𑆘𑇀𑆪𑆁 𑆪𑆖𑇀𑆖𑆳𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆩𑇀𑇆𑇓𑇑𑇖𑇆
𑆥𑆶𑆫𑆳𑆟𑆩𑆳𑆩𑆁 𑆱𑆕𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆮𑇀𑆪𑆳𑆬𑆲𑆴𑆩𑆳𑆠𑆥𑆽𑆂𑇅 𑆃𑆢𑆼𑆯𑆑𑆳𑆬𑆘𑆁 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆁 𑆪𑆠𑇀𑆱𑇀𑆪𑆳𑆠𑇀𑆦𑆬𑆩𑆱𑆳𑆣𑆶 𑆠𑆠𑇀𑇆𑇓𑇑𑇗𑇆
𑆲𑆫𑆴𑆠𑆳𑆤𑆳𑆁 𑆪𑆡𑆳𑆯𑆳𑆑𑆁 𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆂 𑆱𑆳𑆣𑆤𑆳𑆢𑆸𑆠𑆼𑇅 𑆩𑆢𑇀𑆪𑆳𑆩𑇀𑆧𑆶𑆓𑆾𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑇀𑆮𑆼 𑆱𑇀𑆮𑆼 𑆮𑆫𑇀𑆓𑆼 𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇓𑇑𑇘𑇆
𑆪𑆢𑆳𑆲𑆳𑆫𑆓𑆶𑆟𑆽𑆂 𑆥𑆳𑆤𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆠𑆢𑆴𑆰𑇀𑆪𑆠𑆼𑇅 𑆃𑆤𑇀𑆤𑆳𑆤𑆶𑆥𑆳𑆤𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑆁 𑆪𑆤𑇀𑆤 𑆮𑆴𑆫𑆾𑆣𑆴 𑆖𑇆𑇓𑇑𑇙𑇆
𑆄𑆱𑆮𑆳𑆤𑆳𑆁 𑆱𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆩𑆯𑆵𑆠𑆴𑆁 𑆖𑆠𑆶𑆫𑆶𑆠𑇀𑆠𑆫𑆳𑆩𑇀𑇅 𑆘𑆬𑆁 𑆥𑆼𑆪𑆩𑆥𑆼𑆪𑆁 𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑆶𑆥𑆴𑆧𑆼𑆢𑇀𑆣𑆴𑆠𑆩𑇀𑇆𑇓𑇒𑇐𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆁 𑆩𑆳𑆫𑆶𑆠𑆼 𑆯𑆱𑇀𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆼 𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆑𑆦𑆼𑇁𑆤𑆶𑆥𑆳𑆤𑆁 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆁 𑆑𑇀𑆰𑆪𑆼 𑆩𑆳𑆁𑆱𑆫𑆱𑆂 𑆥𑆫𑆩𑇀𑇆𑇓𑇒𑇑𑇆
𑆇𑆥𑆮𑆳𑆱𑆳𑆣𑇀𑆮𑆨𑆳𑆰𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑆵𑆩𑆳𑆫𑆶𑆠𑆳𑆠𑆥𑆑𑆫𑇀𑆩𑆨𑆴𑆂𑇅 𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆥𑆪𑆂 𑆥𑆡𑇀𑆪𑆁 𑆪𑆡𑆳𑇁𑆩𑆸𑆠𑆩𑇀𑇆𑇓𑇒𑇒𑇆
𑆱𑆶𑆫𑆳 𑆑𑆸𑆯𑆳𑆤𑆳𑆁 𑆥𑆶𑆰𑇀𑆛𑇀𑆪𑆫𑇀𑆡𑆩𑆤𑆶𑆥𑆳𑆤𑆁 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆱𑇀𑆡𑆷𑆬𑆢𑆼𑆲𑆳𑆤𑆳𑆩𑆤𑆶 𑆯𑆱𑇀𑆠𑆁 𑆩𑆣𑆷𑆢𑆑𑆩𑇀𑇆𑇓𑇒𑇓𑇆
𑆃𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆵𑆤𑆳𑆩𑆤𑆴𑆢𑇀𑆫𑆳𑆟𑆳𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑆾𑆑𑆨𑆪𑆑𑇀𑆬𑆩𑆽𑆂𑇅 𑆩𑆢𑇀𑆪𑆩𑆳𑆁𑆱𑆾𑆖𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆩𑆢𑇀𑆪𑆩𑆼𑆮𑆳𑆤𑆶𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇓𑇒𑇔𑇆
𑆃𑆡𑆳𑆤𑆶𑆥𑆳𑆤𑆑𑆫𑇀𑆩𑆓𑆶𑆟𑆳𑆤𑇀 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆃𑆤𑆶𑆥𑆳𑆤𑆁 𑆠𑆫𑇀𑆥𑆪𑆠𑆴, 𑆥𑇀𑆫𑆵𑆟𑆪𑆠𑆴, 𑆈𑆫𑇀𑆘𑆪𑆠𑆴, 𑆧𑆸𑆁𑆲𑆪𑆠𑆴, 𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆴𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴, 𑆨𑆶𑆑𑇀𑆠𑆩𑆮𑆱𑆳𑆢𑆪𑆠𑆴, 𑆃𑆤𑇀𑆤𑆱𑆕𑇀𑆔𑆳𑆠𑆁 𑆨𑆴𑆤𑆠𑇀𑆠𑆴, 𑆩𑆳𑆫𑇀𑆢𑆮𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆑𑇀𑆬𑆼𑆢𑆪𑆠𑆴, 𑆘𑆫𑆪𑆠𑆴, 𑆱𑆶𑆒𑆥𑆫𑆴𑆟𑆳𑆩𑆴𑆠𑆳𑆩𑆳𑆯𑆶𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆠𑆳𑆁 𑆖𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆾𑆥𑆘𑆤𑆪𑆠𑆵𑆠𑆴𑇆𑇓𑇒𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆤𑆶𑆥𑆳𑆤𑆁 𑆲𑆴𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆫𑇀𑆥𑆪𑆠𑇀𑆪𑆳𑆯𑆶 𑆩𑆳𑆤𑆮𑆩𑇀𑇅 𑆱𑆶𑆒𑆁 𑆥𑆖𑆠𑆴 𑆖𑆳𑆲𑆳𑆫𑆩𑆳𑆪𑆶𑆰𑆼 𑆖 𑆧𑆬𑆳𑆪 𑆖𑇆𑇓𑇒𑇖𑇆
𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆳𑆕𑇀𑆓𑆩𑆳𑆫𑆶𑆠𑆳𑆮𑆴𑆰𑇀𑆛𑆳 𑆤 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆴𑆤𑆂𑇅 𑆤 𑆓𑆵𑆠𑆨𑆳𑆰𑇀𑆪𑆳𑆣𑇀𑆪𑆪𑆤𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳 𑆤𑆾𑆫𑆱𑆴 𑆑𑇀𑆰𑆠𑆳𑆂𑇆𑇓𑇒𑇗𑇆
𑆥𑆴𑆧𑆼𑆪𑆶𑆫𑆶𑆢𑆑𑆁 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆠𑆢𑇀𑆣𑆴 𑆑𑆟𑇀𑆜𑆾𑆫𑆱𑆴 𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆲𑆳𑆫𑆘𑆁 𑆲𑆠𑇀𑆮𑆳 𑆨𑆷𑆪𑆾 𑆢𑆾𑆰𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼𑇆𑇓𑇒𑇘𑇆
𑆃𑆤𑇀𑆤𑆥𑆳𑆤𑆽𑆑𑆢𑆼𑆯𑆾𑇁𑆪𑆩𑆶𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆳𑆪𑆾𑆥𑆪𑆾𑆓𑆴𑆑𑆂𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆤 𑆲𑆴 𑆤𑆴𑆫𑇀𑆢𑆼𑆰𑇀𑆛𑆶𑆁 𑆯𑆑𑇀𑆪𑆁 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆤𑆳𑆩𑆨𑆴𑆂𑇆𑇓𑇒𑇙𑇆

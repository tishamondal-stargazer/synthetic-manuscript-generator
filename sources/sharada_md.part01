𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆼 𑆑𑆦𑆾 𑆮𑆸𑆢𑇀𑆣𑆾 𑆲𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆩𑆫𑆶𑆖𑆴𑆁 𑆪𑆢𑆴𑇅 𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆁 𑆓𑆿𑆫𑆮𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆘𑆤𑆪𑆼𑆢𑆶𑆬𑇀𑆬𑆴𑆒𑆼𑆠𑇀𑆠𑆶 𑆠𑆩𑇀𑇆𑇒𑇙𑇆
𑆯𑆷𑆬𑆳𑆤𑆳𑆲𑆮𑆴𑆧𑆤𑇀𑆣𑆼𑆰𑆶 𑆓𑆶𑆬𑇀𑆩𑆼 𑆮𑆳𑆠𑆑𑆦𑆾𑆬𑇀𑆧𑆟𑆼𑇅 𑆮𑆫𑇀𑆠𑆪𑆾 𑆓𑆶𑆛𑆴𑆑𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆦𑆮𑆳𑆠𑆲𑆫𑆁 𑆲𑆴𑆠𑆩𑇀𑇆𑇓𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳 𑆪𑆢𑆴 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆁 𑆱𑆤𑇀𑆠𑆳𑆥𑆁 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆂𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆂 𑆱 𑆨𑆮𑆼𑆠𑇀 𑆱𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆳𑆤𑆶𑆬𑆾𑆩𑆴𑆑𑆽𑆂𑇆𑇓𑇑𑇆
𑆓𑆶𑆬𑇀𑆩𑆾 𑆪𑆢𑇀𑆪𑆤𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆸𑆠𑆼 𑆱𑆩𑇀𑆪𑆓𑇀𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆼𑇅 𑆤 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆱𑆾𑇁𑆮𑆱𑆼𑆑𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇓𑇒𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆼𑆤𑆾𑆢𑆴𑆠𑆼 𑆓𑆶𑆬𑇀𑆩𑆼 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆱𑇀𑆫𑆁𑆱𑆤𑆁 𑆲𑆴𑆠𑆩𑇀𑇅 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆼𑆤 𑆠𑆶 𑆱𑆩𑇀𑆨𑆷𑆠𑆼 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆥𑆫𑆩𑇀𑇆𑇓𑇓𑇆
𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳 𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆁 𑆮𑆳 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇅 𑆑𑆳𑆬𑆮𑆴𑆤𑇀𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑆱𑆢𑇀𑆪𑆂 𑆱𑆠𑆴𑆑𑇀𑆠𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂𑇆𑇓𑇔𑇆
𑆥𑆪𑆱𑆳 𑆮𑆳 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼𑆤 𑆱𑆠𑆴𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆨𑆴𑆰𑆓𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆵 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆠𑆽𑆬𑇀𑆮𑆑𑆼𑆤 𑆮𑆳𑇆𑇓𑇕𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆘𑇀𑆮𑆫𑆥𑆫𑆵𑆢𑆳𑆲𑆯𑆷𑆬𑆱𑇀𑆮𑆼𑆢𑆳𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑇀𑆢𑆮𑆼𑇅 𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆳𑆩𑆫𑆶𑆖𑆿 𑆖𑆳𑆥𑆴 𑆫𑆑𑇀𑆠𑆩𑆼𑆮𑆳𑆮𑆱𑆼𑆖𑆪𑆼𑆠𑇀𑇆𑇓𑇖𑇆
𑆗𑆴𑆤𑇀𑆤𑆩𑆷𑆬𑆳 𑆮𑆴𑆢𑆲𑇀𑆪𑆤𑇀𑆠𑆼 𑆤 𑆓𑆶𑆬𑇀𑆩𑆳 𑆪𑆳𑆤𑇀𑆠𑆴 𑆖 𑆑𑇀𑆰𑆪𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆁 𑆲𑆴 𑆮𑇀𑆪𑆩𑇀𑆬𑆠𑆳𑆁 𑆪𑆳𑆠𑆴, 𑆠𑆖𑇀𑆖 𑆤𑆳𑆱𑇀𑆠𑆴 𑆤 𑆖𑆳𑆱𑇀𑆠𑆴 𑆫𑆶𑆑𑇀𑇆𑇓𑇗𑇆
𑆲𑆸𑆠𑆢𑆾𑆰𑆁 𑆥𑆫𑆴𑆩𑇀𑆬𑆳𑆤𑆁 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆱𑇀𑆠𑆫𑇀𑆥𑆴𑆠𑆁 𑆫𑆱𑆽𑆂𑇅 𑆱𑆩𑆳𑆯𑇀𑆮𑆱𑇀𑆠𑆁 𑆱𑆯𑆼𑆰𑆳𑆫𑇀𑆠𑆴𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆨𑇀𑆪𑆳𑆱𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂𑇆𑇓𑇘𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑆤𑆶𑆥𑆬𑆨𑇀𑆪 𑆖𑇅 𑆪𑆢𑆴 𑆓𑆶𑆬𑇀𑆩𑆾 𑆮𑆴𑆢𑆲𑇀𑆪𑆼𑆠 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆠𑆠𑇀𑆫 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆩𑇀𑇆𑇓𑇙𑇆
𑆓𑆶𑆫𑆶𑆂 𑆑𑆜𑆴𑆤𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆾 𑆓𑆷𑆞𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆠𑆫𑆳𑆯𑇀𑆫𑆪𑆂𑇅 𑆃𑆮𑆴𑆮𑆫𑇀𑆟𑆂 𑆱𑇀𑆡𑆴𑆫𑆯𑇀𑆖𑆽𑆮 𑆲𑇀𑆪𑆥𑆑𑇀𑆮𑆾 𑆓𑆶𑆬𑇀𑆩 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇐𑇆
𑆢𑆳𑆲𑆯𑆷𑆬𑆳𑆫𑇀𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆱𑇀𑆮𑆥𑇀𑆤𑆤𑆳𑆯𑆳𑆫𑆠𑆴𑆘𑇀𑆮𑆫𑆽𑆂𑇅 𑆮𑆴𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆁 𑆠𑆩𑆶𑆥𑆤𑆳𑆲𑆪𑆼𑆠𑇀𑇆𑇔𑇑𑇆
𑆮𑆴𑆢𑆳𑆲𑆬𑆑𑇀𑆰𑆟𑆼 𑆓𑆶𑆬𑇀𑆩𑆼 𑆧𑆲𑆴𑆱𑇀𑆠𑆶𑆕𑇀𑆓𑆼 𑆱𑆩𑆶𑆤𑇀𑆤𑆠𑆼𑇅 𑆯𑇀𑆪𑆳𑆮𑆼 𑆱𑆫𑆑𑇀𑆠𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆼 𑆧𑆱𑇀𑆠𑆴𑆱𑆤𑇀𑆤𑆴𑆨𑆼𑇆𑇔𑇒𑇆
𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆾𑆤𑇀𑆤𑆠𑆼 𑆱𑇀𑆠𑆧𑇀𑆣𑆼 𑆱𑆶𑆥𑇀𑆠𑆼 𑆠𑆠𑇀𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆵𑆝𑆤𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫𑆽𑆮 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆼 𑆯𑆷𑆬𑆼 𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆁 𑆓𑆶𑆬𑇀𑆩𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇔𑇓𑇆
𑆠𑆠𑇀𑆫 𑆣𑆳𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆵𑆪𑆳𑆟𑆳𑆩𑆣𑆴𑆑𑆳𑆫𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆣𑆿𑇅 𑆮𑆽𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆑𑆸𑆠𑆪𑆾𑆓𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆣𑆯𑆾𑆣𑆤𑆫𑆾𑆥𑆟𑆼𑇆𑇔𑇔𑇆
𑆃𑆤𑇀𑆠𑆫𑇀𑆨𑆳𑆓𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆼𑆠𑆠𑇀 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆲𑆸𑆠𑇀𑆑𑇀𑆫𑆾𑆝𑆯𑆷𑆤𑆠𑆳𑇁𑆤𑇀𑆠𑆂𑆱𑇀𑆡𑆼 𑆧𑆲𑆴𑆂𑆱𑇀𑆡𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆤𑆴𑆫𑇀𑆓𑆠𑆴𑆂𑇆𑇔𑇕𑇆
𑆥𑆑𑇀𑆮𑆂 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆱𑆕𑇀𑆑𑇀𑆬𑆼𑆢𑇀𑆪 𑆮𑇀𑆫𑆘𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆾𑇁𑆥𑆴 𑆮𑆳𑇅 𑆱𑇀𑆮𑆪𑆩𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆁 𑆠𑆁 𑆢𑆾𑆰𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠 𑆲𑆴𑆠𑆳𑆯𑆤𑆽𑆂 𑇆𑇔𑇖𑇆
𑆢𑆯𑆳𑆲𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆁 𑆮𑆳 𑆫𑆑𑇀𑆰𑆤𑇀 𑆨𑆴𑆰𑆓𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑇅 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆲𑆴𑆠𑆁 𑆥𑆳𑆤𑆁 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆱𑆮𑆴𑆯𑆾𑆣𑆤𑆩𑇀𑇆𑇔𑇗𑇆
𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆠𑆴𑆑𑇀𑆠𑆁 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆼 𑆱𑆫𑇀𑆥𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼𑇅𑇔𑇘𑇅 𑆯𑆵𑆠𑆬𑆽𑆫𑇀𑆓𑆶𑆫𑆶𑆨𑆴𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑇀𑆓𑆶𑆬𑇀𑆩𑆼 𑆘𑆳𑆠𑆼 𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆼𑇆𑇔𑇘𑇆
𑆃𑆮𑆩𑇀𑆪𑆱𑇀𑆪𑆳𑆬𑇀𑆥𑆑𑆳𑆪𑆳𑆓𑇀𑆤𑆼𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆬𑇀𑆬𑆕𑇀𑆔𑆤𑆩𑆳𑆢𑆴𑆠𑆂𑇅 𑆩𑆤𑇀𑆢𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑇀𑆮𑆼𑆢𑆤𑆳 𑆩𑆤𑇀𑆢𑆳 𑆓𑆶𑆫𑆶𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆑𑆾𑆰𑇀𑆜𑆠𑆳𑇆𑇔𑇙𑇆
𑆱𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆳 𑆖𑆳𑆫𑆶𑆖𑆴𑆫𑇀𑆪𑆱𑇀𑆪 𑆱 𑆓𑆶𑆬𑇀𑆩𑆵 𑆮𑆩𑆤𑆾𑆥𑆓𑆂𑇅 𑆇𑆰𑇀𑆟𑆽𑆫𑆼𑆮𑆾𑆥𑆖𑆫𑇀𑆪𑆯𑇀𑆖 𑆑𑆸𑆠𑆼 𑆮𑆩𑆤𑆬𑆕𑇀𑆔𑆤𑆼𑇆𑇕𑇐𑇆

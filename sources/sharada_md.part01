𑆑𑆥𑆴𑆠𑇀𑆡𑆫𑆱𑆥𑆴𑆰𑇀𑆛𑆾𑇁𑆪𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆁𑆪𑆶𑆠𑆂 𑇅 𑆮𑆴𑆰𑆁 𑆲𑆤𑇀𑆠𑇀𑆪𑆓𑆢𑆂 𑆱𑆫𑇀𑆮𑆁 𑆩𑆷𑆰𑆴𑆑𑆳𑆟𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇘𑇓𑇆
𑆨𑆷𑆩𑆵 𑆑𑆶𑆫𑆧𑆑𑆯𑇀𑆖𑆽𑆮 𑆓𑆟 𑆍𑆑𑆱𑆫𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆍𑆑𑆯𑆾 𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆯𑆾 𑆮𑆳𑇁𑆥𑆴 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆾 𑆮𑆴𑆰𑆳𑆥𑆲𑆂 𑇆𑇘𑇖𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆣𑆮𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆯𑆴𑆫𑆵𑆰𑆠𑆴𑆤𑆴𑆯𑆥𑆬𑆳𑆯𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆥𑆳𑆛𑆬𑆴𑆥𑆳𑆫𑆴𑆨𑆢𑇀𑆫𑆑𑆳𑆩𑇀𑆫𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆑𑆫𑆲𑆳𑆛𑆑𑆳𑆫𑇀𑆘𑆶𑆤𑆑𑆑𑆶𑆨𑆱𑆫𑇀𑆘- 𑆑𑆥𑆵𑆠𑆤𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆑𑆳𑆕𑇀𑆑𑆾𑆜𑆳𑆩𑆬𑆑𑆥𑇀𑆫𑆓𑇀𑆫𑆲𑆑𑆶𑆛𑆘𑆯𑆩𑆵𑆑𑆥𑆴𑆠𑇀𑆡𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆳𑆫𑇀𑆑𑆖𑆴𑆫𑆧𑆴𑆬𑇀𑆮𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆳𑆫𑆶𑆰𑇀𑆑𑆫𑆳𑆫𑆬𑆶- 𑆩𑆣𑆶𑆑𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆯𑆳𑆑𑆓𑆾𑆘𑆵𑆩𑆷𑆫𑇀𑆮𑆳𑆨𑆷𑆫𑇀𑆘𑆠𑆴𑆬𑇀𑆮𑆑𑆼𑆑𑇀𑆰𑆶𑆫𑆑𑆓𑆾𑆥𑆔𑆾𑆟𑇀𑆛𑆳𑆫𑆴𑆩𑆼𑆢𑆳𑆤𑆳𑆁 𑆨𑆱𑇀𑆩𑆳𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑇀𑆪 𑆓𑆮𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆑𑇀𑆰𑆳𑆫𑆑𑆬𑇀𑆥𑆼𑆤 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆠𑇀𑆫 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆠𑆟𑇀𑆝𑆶𑆬𑆵𑆪𑆑𑆮𑆫𑆳𑆕𑇀𑆓𑆖𑆾𑆖𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆑𑆫𑆚𑇀𑆘𑆴𑆑𑆳𑆲𑆱𑇀𑆠𑆴𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆮𑆴𑆝𑆕𑇀𑆓𑆓𑆸𑆲𑆣𑆷𑆩𑆳𑆤𑆤𑇀𑆠𑆳- 𑆱𑆾𑆩𑆱𑆫𑆬𑆳𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆓𑆶𑆲𑆳𑆑𑆾𑆯𑆳𑆩𑇀𑆫𑆯𑇀𑆮𑆼𑆠𑆱𑆫𑇀𑆰𑆥𑆮𑆫𑆶𑆟𑆬𑆮𑆟𑆥𑇀𑆬𑆑𑇀𑆰𑆤𑆴𑆖𑆶𑆬𑆑𑆮𑆚𑇀𑆘𑆶𑆬𑆮𑆑𑇀𑆫𑆳𑆬𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆥𑆶𑆠𑇀𑆫𑆯𑇀𑆫𑆼𑆟𑆵- 𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆛𑆶𑆟𑇀𑆛𑆶𑆑𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆤𑆳𑆓𑆢𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆮𑆴𑆰𑆳𑆨𑆪𑆳𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆮𑆖𑆳𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆬𑆾𑆲𑆳𑆤𑆳𑆁 𑆖 𑆱𑆩𑆨𑆳𑆓𑆳𑆤𑆴, 𑆠𑆠𑆂 𑆑𑇀𑆰𑆳𑆫𑆮𑆢𑆳𑆓𑆠𑆥𑆳𑆑𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆬𑆾𑆲𑆑𑆶𑆩𑇀𑆨𑆼 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇓𑇆
𑆃𑆤𑆼𑆤 𑆢𑆶𑆤𑇀𑆢𑆶𑆨𑆴𑆁 𑆬𑆴𑆩𑇀𑆥𑆼𑆠𑇀 𑆥𑆠𑆳𑆑𑆳𑆁 𑆠𑆾𑆫𑆟𑆳𑆤𑆴 𑆖 𑇅 𑆯𑇀𑆫𑆮𑆟𑆳𑆢𑇀𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆠𑇀 𑆮𑆴𑆰𑆳𑆠𑇀 𑆱𑆩𑇀𑆥𑇀𑆫𑆠𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇔𑇆
𑆍𑆰 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑆢𑆾 𑆤𑆳𑆩 𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑇀𑆮𑆯𑇀𑆩𑆫𑆵𑆰𑆶 𑆖 𑇅 𑆃𑆫𑇀𑆯𑆂𑆱𑆶 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑆶 𑆑𑆳𑆱𑆯𑆷𑆬𑆾𑆢𑆫𑆼𑆰𑆶 𑆖 𑇆𑇕𑇆
𑆃𑆘𑆵𑆫𑇀𑆟𑆼 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆼 𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆼 𑆖 𑆢𑆳𑆫𑆶𑆟𑆼 𑇅 𑆯𑆾𑆦𑆼 𑆱𑆫𑇀𑆮𑆱𑆫𑆼 𑆖𑆳𑆥𑆴 𑆢𑆼𑆪𑆂 𑆯𑇀𑆮𑆳𑆱𑆼 𑆖 𑆢𑆳𑆫𑆶𑆟𑆼 𑇆𑇖𑇆
𑆱𑆢𑆳 𑆱𑆫𑇀𑆮𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆡𑆽𑆮𑆾𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑇅 𑆍𑆰 𑆠𑆑𑇀𑆰𑆑𑆩𑆶𑆒𑇀𑆪𑆳𑆤𑆳𑆩𑆥𑆴 𑆢𑆫𑇀𑆥𑆳𑆕𑇀𑆑𑆶𑆯𑆾𑇁𑆓𑆢𑆂 𑇆𑇗𑇆
𑆱𑆖𑆤𑇀𑆢𑆤𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆨𑆴𑆫𑆼𑆠𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇅 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆁 𑆲𑇀𑆪𑆼𑆠𑆢𑇀𑆓𑇀𑆫𑆲𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇑𑇐𑇆
𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆓𑆫𑆯𑇀𑆮𑆳𑆱𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆘𑇀𑆮𑆫𑆑𑆳𑆱𑆤𑆶𑆠𑇀 𑇅 𑆯𑆾𑆰𑆴𑆟𑆳𑆩𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆳𑆟𑆳𑆁 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆖 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇑𑇑𑇆
𑆃𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆱𑇀𑆪 𑆧𑆵𑆘𑆳𑆤𑆴 𑆯𑆴𑆫𑆵𑆰𑆱𑇀𑆪 𑆖 𑆩𑆳𑆰𑆑𑆳𑆤𑇀 𑇅 𑆯𑇀𑆮𑆼𑆠𑆼 𑆢𑇀𑆮𑆼 𑆑𑆳𑆑𑆩𑆳𑆖𑆵𑆁 𑆖 𑆓𑆮𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆼𑆰𑆪𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆱𑆫𑇀𑆥𑆴𑆫𑆼𑆠𑆽𑆱𑇀𑆠𑆶 𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆴𑆰𑆱𑆁𑆯𑆩𑆤𑆁 𑆥𑆫𑆩𑇀 𑇅 𑆃𑆩𑆸𑆠𑆁 𑆤𑆳𑆩 𑆮𑆴𑆒𑇀𑆪𑆳𑆠𑆩𑆥𑆴 𑆱𑆚𑇀𑆘𑆵𑆮𑆪𑆼𑆤𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆇𑆯𑆵𑆫𑆁 𑆮𑆫𑆶𑆟𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶 𑆤𑆒𑆁 𑆠𑆡𑆳 𑇅 𑆯𑇀𑆮𑆼𑆠𑆼 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆱𑇀𑆡𑆿𑆟𑆼𑆪𑆁 𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆖 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖 𑇆𑇑𑇙𑇆
𑆑𑆶𑆩𑆶𑆢𑆾𑆠𑇀𑆥𑆬𑆥𑆢𑇀𑆩𑆳𑆤𑆴 𑆥𑆶𑆰𑇀𑆥𑆁 𑆖𑆳𑆥𑆴 𑆠𑆡𑆳𑇁𑆫𑇀𑆑𑆘𑆩𑇀 𑇅 𑆖𑆩𑇀𑆥𑆑𑆳𑆯𑆾𑆑𑆱𑆶𑆩𑆤𑆱𑇀𑆠𑆴𑆬𑇀𑆮𑆑𑆥𑇀𑆫𑆱𑆮𑆳𑆤𑆴 𑆖 𑇆𑇒𑇐𑇆
𑆨𑆓𑇀𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆁 𑆮𑆴𑆮𑆸𑆠𑆳𑆑𑇀𑆰𑆁 𑆩𑆸𑆠𑇀𑆪𑆾𑆫𑇀𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆤𑇀𑆠𑆫𑆁 𑆓𑆠𑆩𑇀 𑇅 𑆃𑆤𑆼𑆤𑆳𑆓𑆢𑆩𑆶𑆒𑇀𑆪𑆼𑆤 𑆩𑆤𑆶𑆰𑇀𑆪𑆁 𑆥𑆶𑆤𑆫𑆳𑆲𑆫𑆼𑆠𑇀 𑇆𑇒𑇔𑇆
𑆍𑆰𑆾𑇁𑆓𑇀𑆤𑆴𑆑𑆬𑇀𑆥𑆁 𑆢𑆶𑆫𑇀𑆮𑆳𑆫𑆁 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆩𑆴𑆠𑆠𑆼𑆘𑆱𑆂 𑇅 𑆮𑆴𑆰𑆁 𑆤𑆳𑆓𑆥𑆠𑆼𑆫𑇀𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆨𑆁 𑆮𑆳𑆱𑆶𑆑𑆼𑆫𑆥𑆴 𑇆𑇒𑇕𑇆
𑆩𑆲𑆳𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆤𑆳𑆩𑆳𑇁𑆪𑆁 𑆥𑆚𑇀𑆖𑆳𑆯𑆵𑆠𑇀𑆪𑆕𑇀𑆓𑆱𑆁𑆪𑆶𑆠𑆂 𑇅 𑆫𑆳𑆘𑆳𑇁𑆓𑆢𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆫𑆳𑆘𑇀𑆚𑆾 𑆲𑆱𑇀𑆠𑆼 𑆨𑆮𑆼𑆠𑇀 𑆱𑆢𑆳 𑇆𑇒𑇖𑇆
𑆱𑇀𑆤𑆳𑆠𑆳𑆤𑆶𑆬𑆴𑆥𑇀𑆠𑆱𑇀𑆠𑆶 𑆤𑆸𑆥𑆾 𑆨𑆮𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆘𑆤𑆥𑇀𑆫𑆴𑆪𑆂 𑇅 𑆨𑇀𑆫𑆳𑆘𑆴𑆰𑇀𑆟𑆶𑆠𑆳𑆁 𑆖 𑆬𑆨𑆠𑆼 𑆯𑆠𑇀𑆫𑆶𑆩𑆣𑇀𑆪𑆓𑆠𑆾𑇁𑆥𑆴 𑆱𑆤𑇀 𑇆𑇒𑇗𑇆
𑆇𑆰𑇀𑆟𑆮𑆫𑇀𑆘𑇀𑆪𑆾 𑆮𑆴𑆣𑆴𑆂 𑆑𑆳𑆫𑇀𑆪𑆾 𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇅 𑆩𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆑𑆵𑆛𑆮𑆴𑆰𑆁 𑆠𑆢𑇀𑆣𑆴 𑆯𑆵𑆠𑆼𑆤𑆳𑆨𑆴𑆥𑇀𑆫𑆮𑆫𑇀𑆣𑆠𑆼 𑇆𑇒𑇘𑇆
𑆃𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆳𑆮𑆶𑆑𑇀𑆠𑆩𑆶𑆥𑆣𑆳𑆫𑇀𑆪 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆩𑇀 𑇅        𑆯𑆶𑆨𑆁 𑆢𑆼𑆪𑆁 𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆼𑆨𑇀𑆪𑆯𑇀𑆖 𑆮𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇙𑇆
𑆦𑆳𑆟𑆴𑆠𑆁 𑆯𑆴𑆓𑇀𑆫𑆶𑆱𑆿𑆮𑆵𑆫𑆩𑆘𑆵𑆫𑇀𑆟𑆳𑆣𑇀𑆪𑆯𑆤𑆁 𑆠𑆡𑆳 𑇅 𑆮𑆫𑇀𑆘𑆪𑆼𑆖𑇀𑆖 𑆱𑆩𑆳𑆱𑆼𑆤 𑆤𑆮𑆣𑆳𑆤𑇀𑆪𑆳𑆢𑆴𑆑𑆁 𑆓𑆟𑆩𑇀 𑇆𑇓𑇐𑇆
𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆁 𑆖 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆁 𑆑𑇀𑆫𑆾𑆣𑆩𑆳𑆠𑆥𑆩𑇀 𑇅 𑆱𑆶𑆫𑆳𑆠𑆴𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆁𑆯𑇀𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆢𑇀𑆣𑆴 𑆮𑆴𑆰𑆳𑆠𑆶𑆫𑆂 𑇆𑇓𑇑𑇆
𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆣𑆳𑆠𑆶𑆩𑆤𑇀𑆤𑆳𑆨𑆴𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆁 𑆱𑆩𑆱𑆷𑆠𑇀𑆫𑆘𑆴𑆲𑇀𑆮𑆩𑇀 𑇅 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆖𑆴𑆠𑇀𑆠𑆖𑆼𑆰𑇀𑆛𑆁 𑆮𑆽𑆢𑇀𑆪𑆾𑇁𑆮𑆓𑆖𑇀𑆗𑆼𑆢𑆮𑆴𑆰𑆁 𑆩𑆤𑆶𑆰𑇀𑆪𑆩𑇀 𑇆𑇓𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆷𑆰𑆴𑆑𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑆶𑆑𑇀𑆫𑆮𑆴𑆰𑆳 𑆇𑆑𑇀𑆠𑆳 𑆩𑆷𑆰𑆴𑆑𑆳 𑆪𑆼 𑆱𑆩𑆳𑆱𑆠𑆂 𑇅 𑆤𑆳𑆩𑆬𑆑𑇀𑆰𑆟𑆨𑆽𑆰𑆘𑇀𑆪𑆽𑆫𑆰𑇀𑆛𑆳𑆢𑆯 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇆𑇓𑇆
𑆬𑆳𑆬𑆤𑆂 𑆥𑆶𑆠𑇀𑆫𑆑𑆂 𑆑𑆸𑆰𑇀𑆟𑆾 𑆲𑆁𑆱𑆴𑆫𑆯𑇀𑆖𑆴𑆑𑇀𑆮𑆴(𑆑𑇀𑆑𑆴)𑆫𑆱𑇀𑆠𑆡𑆳 𑇅 𑆗𑆶𑆖𑇀𑆗𑆶𑆤𑇀𑆢𑆫𑆾𑇁𑆬𑆱𑆯𑇀𑆖𑆽𑆮 𑆑𑆰𑆳𑆪𑆢𑆯𑆤𑆾𑇁𑆥𑆴 𑆖 𑇆𑇔𑇆
𑆑𑆶𑆬𑆴𑆕𑇀𑆓𑆯𑇀𑆖𑆳𑆘𑆴𑆠𑆯𑇀𑆖𑆽𑆮 𑆖𑆥𑆬𑆂 𑆑𑆥𑆴𑆬𑆱𑇀𑆠𑆡𑆳 𑆑𑆾𑆑𑆴𑆬𑆾𑇁𑆫𑆶𑆟𑆱𑆚𑇀𑆘𑇀𑆚𑆯𑇀𑆖 𑆩𑆲𑆳𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆠𑆡𑆾𑆤𑇀𑆢𑆶𑆫𑆂 𑇆𑇕𑇆
𑆯𑇀𑆮𑆼𑆠𑆼𑆤 𑆩𑆲𑆠𑆳 𑆱𑆳𑆫𑇀𑆣𑆁 𑆑𑆥𑆴𑆬𑆼𑆤𑆳𑆒𑆶𑆤𑆳 𑆠𑆡𑆳 𑇅 𑆩𑆷𑆰𑆴𑆑𑆯𑇀𑆖 𑆑𑆥𑆾𑆠𑆳𑆨𑆱𑇀𑆠𑆡𑆽𑆮𑆳𑆰𑇀𑆛𑆳𑆢𑆯 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇖𑇆
𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑆠𑆠𑆴 𑆪𑆠𑇀𑆫𑆽𑆰𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑆽𑆂 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆴 𑆮𑆳 𑇅 𑆤𑆒𑆢𑆤𑇀𑆠𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆓𑆳𑆠𑇀𑆫𑆼 𑆫𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆪𑆠𑆴 𑇆𑇗𑇆
𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆓𑇀𑆫𑆤𑇀𑆡𑆪𑆂 𑆯𑆾𑆦𑆳𑆂 𑆑𑆫𑇀𑆟𑆴𑆑𑆳 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆖 𑇅 𑆥𑆵𑆝𑆑𑆾𑆥𑆖𑆪𑆯𑇀𑆖𑆾𑆓𑇀𑆫𑆾 𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆂 𑆑𑆴𑆛𑆴𑆨𑆳𑆤𑆴 𑆖 𑇆𑇘𑇆
𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆾 𑆫𑆶𑆘𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑇁𑆕𑇀𑆓𑆱𑆢𑆤𑆁 𑆘𑇀𑆮𑆫𑆂 𑇅 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆫𑆶𑆖𑆴𑆂 𑆯𑇀𑆮𑆳𑆱𑆾 𑆮𑆩𑆡𑆶𑆫𑇀𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆟𑆩𑇀 𑇆𑇙𑇆
𑆢𑆰𑇀𑆛𑆫𑆷𑆥𑆁 𑆱𑆩𑆳𑆱𑆾𑆑𑇀𑆠𑆩𑆼𑆠𑆢𑇀𑆮𑇀𑆪𑆳𑆱𑆩𑆠𑆂 𑆯𑆸𑆟𑆶 𑇅  𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆾 𑆬𑆳𑆬𑆤𑆼𑆤 𑆲𑆴𑆑𑇀𑆑𑆳 𑆗𑆫𑇀𑆢𑆴𑆯𑇀𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇐𑇆
𑆠𑆟𑇀𑆝𑆶𑆬𑆵𑆪𑆑𑆑𑆬𑇀𑆑𑆁 𑆠𑆶 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑇀 𑇅 𑆥𑆶𑆠𑇀𑆫𑆑𑆼𑆟𑆳𑆕𑇀𑆓𑆱𑆳𑆢𑆯𑇀𑆖 𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆫𑇀𑆟𑆯𑇀𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇑𑇆
𑆖𑆵𑆪𑆠𑆼 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆨𑆴𑆯𑇀𑆖𑆳𑆕𑇀𑆓𑆩𑆳𑆒𑆶𑆯𑆳𑆮𑆑𑆱𑆤𑇀𑆤𑆴𑆨𑆽𑆂 𑇅 𑆯𑆴𑆫𑆵𑆰𑆼𑆕𑇀𑆓𑆶𑆢𑆑𑆬𑇀𑆑𑆁 𑆠𑆶 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑇀 𑇆𑇑𑇒𑇆
𑆑𑆸𑆰𑇀𑆟𑆼𑆤 𑆢𑆁𑆯𑆼 𑆯𑆾𑆦𑆾𑇁𑆱𑆸𑆑𑇀𑆗𑆫𑇀𑆢𑆴𑆂 𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖 𑆢𑆶𑆫𑇀𑆢𑆴𑆤𑆼 𑇅 𑆯𑆴𑆫𑆵𑆰𑆦𑆬𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆶 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑆴𑆁𑆯𑆶𑆑𑆨𑆱𑇀𑆩𑆤𑆳 𑇆𑇑𑇓𑇆
𑆲𑆁𑆱𑆴𑆫𑆼𑆟𑆳𑆤𑇀𑆤𑆮𑆴𑆢𑇀𑆮𑆼𑆰𑆾 𑆘𑆸𑆩𑇀𑆨𑆳 𑆫𑆾𑆩𑇀𑆟𑆳𑆁 𑆖 𑆲𑆫𑇀𑆰𑆟𑆩𑇀 𑇅 𑆥𑆴𑆧𑆼𑆢𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆁 𑆠𑆶 𑆱𑆶𑆮𑆳𑆤𑇀𑆠𑆱𑇀𑆠𑆠𑇀𑆫 𑆩𑆳𑆤𑆮𑆂 𑇆𑇑𑇔𑇆
𑆖𑆴𑆑𑇀𑆮𑆴(𑆑𑇀𑆑𑆴)𑆫𑆼𑆟 𑆯𑆴𑆫𑆾𑆢𑆶𑆂𑆒𑆁 𑆯𑆾𑆦𑆾 𑆲𑆴𑆑𑇀𑆑𑆳 𑆮𑆩𑆴𑆱𑇀𑆠𑆡𑆳 𑇅 𑆘𑆳𑆬𑆴𑆤𑆵𑆩𑆢𑆤𑆳𑆕𑇀𑆑𑆾𑆜𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆮𑆳𑆩𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆩𑇀 𑇆𑇑𑇕𑇆
𑆪𑆮𑆤𑆳𑆬𑆫𑇀𑆰𑆨𑆵𑆑𑇀𑆰𑆳𑆫𑆁 𑆧𑆸𑆲𑆠𑇀𑆪𑆾𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆗𑆶𑆖𑇀𑆗𑆶𑆤𑇀𑆢𑆫𑆼𑆟 𑆠𑆸𑆛𑇀 𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆾 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆼𑆮 𑆖 𑇆𑇑𑇖𑇆
𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆂 𑆥𑆸𑆰𑇀𑆜𑆯𑆾𑆦𑆾 𑆓𑆤𑇀𑆣𑆳𑆘𑇀𑆚𑆳𑆤𑆁 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳 𑇅 𑆖𑆮𑇀𑆪𑆁 𑆲𑆫𑆵𑆠𑆑𑆵 𑆯𑆶𑆟𑇀𑆜𑆵 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆩𑆣𑆶 𑇆𑇑𑇗𑇆

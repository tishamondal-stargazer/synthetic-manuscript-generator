𑆃𑆮𑆳𑆕𑇀𑆩𑆶𑆒𑆱𑇀𑆠𑆷𑆤𑇀𑆩𑆶𑆒𑆾 𑆮𑆳 𑆑𑇀𑆰𑆵𑆟𑆩𑆳𑆁𑆱𑆧𑆬𑆾 𑆤𑆫𑆂 𑇅 𑆘𑆳𑆓𑆫𑆴𑆰𑇀𑆟𑆶𑆫𑆱𑆤𑇀𑆢𑆼𑆲𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆼𑆤 𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑆴 𑇆𑇒𑇕𑇆
𑆧𑆲𑆶𑆯𑆾𑇁𑆥𑆱𑇀𑆩𑆫𑆤𑇀𑆠𑆁 𑆠𑆶 𑆥𑇀𑆫𑆑𑇀𑆰𑆵𑆟𑆁 𑆖𑆬𑆴𑆠𑆨𑇀𑆫𑆶𑆮𑆩𑇀 𑇅 𑆤𑆼𑆠𑇀𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆮𑆴𑆑𑆶𑆫𑇀𑆮𑆳𑆟𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆾 𑆮𑆴𑆤𑆳𑆯𑆪𑆼𑆠𑇀 𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆪𑆶𑆑𑇀𑆠𑆱𑆼𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆸𑆥𑆠𑆼𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆱𑆼𑆤𑆱𑇀𑆪 𑆥𑆫𑆳𑆤𑆨𑆴𑆘𑆴𑆓𑆵𑆰𑆠𑆂 𑇅 𑆨𑆴𑆰𑆘𑆳 𑆫𑆑𑇀𑆰𑆟𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆪𑆡𑆳 𑆠𑆢𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆮𑆴𑆘𑆴𑆓𑆵𑆰𑆶𑆂 𑆱𑆲𑆳𑆩𑆳𑆠𑇀𑆪𑆽𑆫𑇀𑆪𑆳𑆠𑇀𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆠𑆂 𑇅 𑆫𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆮𑆴𑆰𑆳𑆢𑆼𑆮 𑆤𑆫𑆳𑆣𑆴𑆥𑆂 𑇆𑇔𑇆
𑆥𑆤𑇀𑆡𑆳𑆤𑆩𑆶𑆢𑆑𑆁 𑆗𑆳𑆪𑆳𑆁 𑆨𑆑𑇀𑆠𑆁 𑆪𑆮𑆱𑆩𑆴𑆤𑇀𑆣𑆤𑆩𑇀 𑇅 𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑇀𑆪𑆫𑆪𑆱𑇀𑆠𑆖𑇀𑆖 𑆘𑆳𑆤𑆵𑆪𑆳𑆖𑇀𑆗𑆾𑆣𑆪𑆼𑆠𑇀𑆠𑆡𑆳 𑇆𑇕𑇆
𑆄𑆘𑇀𑆚𑆳 𑆠𑇀𑆪𑆳𑆓𑆂 𑆑𑇀𑆰𑆩𑆳 𑆣𑆽𑆫𑇀𑆪𑆁 𑆮𑆴𑆑𑇀𑆫𑆩𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆩𑆳𑆤𑆶𑆰𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆼𑆮𑆩𑆴𑆮𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆳𑆕𑇀𑆩𑆤𑆂𑆑𑆫𑇀𑆩𑆨𑆴𑆂 𑆯𑆶𑆨𑆽𑆂 𑇆𑇑𑇑𑇆
𑆨𑆮𑆼𑆠𑇀𑆱𑆤𑇀𑆤𑆴𑆲𑆴𑆠𑆾 𑆮𑆽𑆢𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆾𑆥𑆑𑆫𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆂 𑇅 𑆠𑆠𑇀𑆫𑆱𑇀𑆡𑆩𑆼𑆤𑆁 𑆣𑇀𑆮𑆘𑆮𑆢𑇀𑆪𑆯𑆂𑆒𑇀𑆪𑆳𑆠𑆴𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆇𑆥𑆱𑆫𑇀𑆥𑆤𑇀𑆠𑇀𑆪𑆩𑆾𑆲𑆼𑆤 𑆮𑆴𑆰𑆯𑆬𑇀𑆪𑆳𑆩𑆪𑆳𑆫𑇀𑆢𑆴𑆠𑆳𑆂 𑇅 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆑𑆶𑆯𑆬𑆾𑇁𑆤𑇀𑆪𑆼𑆰𑆶 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆼𑆰𑇀𑆮𑆧𑆲𑆴𑆰𑇀𑆑𑆸𑆠𑆂 𑇆𑇑𑇔𑇆
𑆍𑆠𑆼 𑆥𑆳𑆢𑆳𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆪𑆳𑆂 𑆑𑆫𑇀𑆩𑆱𑆳𑆣𑆤𑆲𑆼𑆠𑆮𑆂 𑇅 𑆓𑆶𑆟𑆮𑆢𑇀𑆨𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆂 𑆥𑆳𑆢𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆾 𑆓𑆶𑆟𑆮𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇖𑇆
𑆬𑆔𑆶𑆲𑆱𑇀𑆠𑆂 𑆯𑆶𑆖𑆴𑆂 𑆯𑆷𑆫𑆂 𑆱𑆘𑇀𑆘𑆾𑆥𑆱𑇀𑆑𑆫𑆨𑆼𑆰𑆘𑆂 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆩𑆠𑆴𑆫𑇀𑆣𑆵𑆩𑆳𑆤𑇀 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆵 𑆮𑆴𑆯𑆳𑆫𑆢𑆂 𑇆𑇒𑇐𑇆
𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆁 𑆩𑆤𑆱𑇀𑆑𑆳𑆤𑇀𑆠𑆁 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇅 𑆢𑆾𑆰𑆔𑇀𑆤𑆩𑆓𑇀𑆬𑆳𑆤𑆴𑆑𑆫𑆩𑆮𑆴𑆑𑆳𑆫𑆴 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼 𑇅 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆠𑇀𑆠𑆁 𑆑𑆳𑆬𑆼 𑆖 𑆨𑆼𑆰𑆘𑆁 𑆥𑆳𑆢 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇓𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑇁𑆘𑆶𑆓𑆶𑆥𑇀𑆱𑆶𑆫𑇀𑆧𑆬𑆮𑆳𑆤𑇀 𑆪𑆶𑆑𑇀𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆑𑇀𑆰𑆟𑆼 𑇅 𑆮𑆽𑆢𑇀𑆪𑆮𑆳𑆑𑇀𑆪𑆑𑆸𑆢𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆂 𑆥𑆳𑆢𑆂 𑆥𑆫𑆴𑆖𑆫𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇒𑇔𑇆
𑆃𑆡𑆳𑆠 𑆄𑆠𑆶𑆫𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆄𑆠𑆶𑆫𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆩𑆳𑆟𑆼𑆤 𑆨𑆴𑆰𑆘𑆳𑇁𑇁𑆪𑆶𑆫𑆳𑆢𑆳𑆮𑆼𑆮 𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆁 ; 𑆱𑆠𑇀𑆪𑆳𑆪𑆶𑆰𑆴 𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆸𑆠𑇀𑆮𑆓𑇀𑆤𑆴𑆮𑆪𑆾𑆢𑆼𑆲𑆧𑆬𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆼𑆰𑆘𑆢𑆼𑆯𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆩𑆲𑆳𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆱𑇀𑆠𑆤𑆳𑆓𑇀𑆫𑆢𑆯𑆤𑆮𑆢𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆬𑆬𑆳𑆛𑆁 𑆢𑆵𑆫𑇀𑆔𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑇀𑆮𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆟𑆧𑆳𑆲𑆶𑆁, 𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆨𑇀𑆫𑆷𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆾𑆫𑆱𑇀𑆑𑆁 𑆲𑇀𑆫𑆱𑇀𑆮𑆘𑆕𑇀𑆔𑆳𑆩𑆼𑆞𑇀𑆫𑆓𑇀𑆫𑆵𑆮𑆁, 𑆓𑆩𑇀𑆨𑆵𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆮𑆫𑆤𑆳𑆨𑆴𑆩𑇀 , 𑆃𑆤𑆶𑆖𑇀𑆖𑆽𑆫𑇀𑆧𑆢𑇀𑆣𑆱𑇀𑆠𑆤𑆩𑇀, 𑆇𑆥𑆖𑆴𑆠𑆩𑆲𑆳𑆫𑆾𑆩𑆯𑆑𑆫𑇀𑆟𑆁, 𑆥𑆯𑇀𑆖𑆳𑆤𑇀𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑆁, 𑆱𑇀𑆤𑆳𑆠𑆳𑆤𑆶𑆬𑆴𑆥𑇀𑆠𑆁 𑆩𑆷𑆫𑇀𑆣𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳 𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆩𑆳𑆟𑆯𑆫𑆵𑆫𑆁 𑆥𑆯𑇀𑆖𑆳𑆖𑇀𑆖 𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆩𑆳𑆟𑆲𑆸𑆢𑆪𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆂 𑆒𑆬𑇀𑆮𑆪𑆩𑆴𑆠𑆴 𑇅 𑆠𑆩𑆼𑆑𑆳𑆤𑇀𑆠𑆼𑆤𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇅 𑆍𑆨𑆴𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆽𑆫𑆬𑇀𑆥𑆳𑆪𑆶𑆂; 𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑇀𑆩𑆣𑇀𑆪𑆩𑆳𑆪𑆶𑆫𑆴𑆠𑆴 𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑇅 𑆓𑆷𑆞𑆱𑆤𑇀𑆣𑆴𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆂 𑆱𑆁𑆲𑆠𑆳𑆕𑇀𑆓𑆂 𑆱𑇀𑆡𑆴𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂 𑇅 𑆇𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆱𑆶𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆾 𑆪𑆂 𑆱 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇕𑇆
𑆓𑆫𑇀𑆨𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑇀𑆪𑆫𑆾𑆓𑆾 𑆪𑆂 𑆯𑆤𑆽𑆂 𑆱𑆩𑆶𑆥𑆖𑆵𑆪𑆠𑆼 𑇅 𑆯𑆫𑆵𑆫𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆽𑆂 𑆱 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆂 𑆱𑆩𑆳𑆱𑆠𑆂 𑇆𑇖𑇆
𑆩𑆣𑇀𑆪𑆩𑆱𑇀𑆪𑆳𑆪𑆶𑆰𑆾 𑆘𑇀𑆚𑆳𑆤𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇅 𑆃𑆣𑆱𑇀𑆠𑆳𑆢𑆑𑇀𑆰𑆪𑆾𑆫𑇀𑆪𑆱𑇀𑆪 𑆬𑆼𑆒𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆩𑆳𑆪𑆠𑆳𑆂 𑇆𑇗𑇆
𑆢𑇀𑆮𑆼 𑆮𑆳 𑆠𑆴𑆱𑇀𑆫𑆾𑇁𑆣𑆴𑆑𑆳 𑆮𑆳𑇁𑆥𑆴 𑆥𑆳𑆢𑆿 𑆑𑆫𑇀𑆟𑆿 𑆖 𑆩𑆳𑆁𑆱𑆬𑆿 𑇅 𑆤𑆳𑆱𑆳𑆓𑇀𑆫𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆨𑆮𑆼𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆬𑆼𑆒𑆳𑆯𑇀𑆖 𑆥𑆸𑆰𑇀𑆜𑆠𑆂 𑇆𑇘𑇆
𑆲𑆱𑇀𑆮𑆳𑆤𑆴 𑆪𑆱𑇀𑆪 𑆥𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑆶𑆩𑆲𑆖𑇀𑆖𑆳𑆥𑆴 𑆩𑆼𑆲𑆤𑆩𑇀 𑇅 𑆠𑆡𑆾𑆫𑆱𑇀𑆪𑆮𑆬𑆵𑆞𑆳𑆤𑆴 𑆤 𑆖 𑆱𑇀𑆪𑆳𑆠𑇀𑆥𑆸𑆰𑇀𑆜𑆩𑆳𑆪𑆠𑆩𑇀 𑇆𑇑𑇐𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆯𑇀𑆫𑆮𑆟𑆿 𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑇀𑆤𑆳𑆱𑆳 𑆖𑆾𑆖𑇀𑆖𑆳 𑆯𑆫𑆵𑆫𑆴𑆟𑆂 𑇅 𑆲𑆱𑆠𑆾 𑆘𑆬𑇀𑆥𑆠𑆾 𑆮𑆳𑇁𑆥𑆴 𑆢𑆤𑇀𑆠𑆩𑆳𑆁𑆱𑆁 𑆥𑇀𑆫𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑇅 𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆠𑆼 𑆪𑆯𑇀𑆖 𑆮𑆴𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆁 𑆱 𑆘𑆵𑆮𑆼𑆠𑇀𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆩𑇀 𑇆𑇑𑇑𑇆
𑆃𑆡 𑆥𑆶𑆤𑆫𑆳𑆪𑆶𑆰𑆾 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆱𑆳𑆫𑆳𑆤𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫𑆳𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆣𑆴𑆱𑆑𑇀𑆡𑆴𑆧𑆳𑆲𑆶𑆯𑆴𑆫𑆳𑆁𑆱𑆴, 𑆠𑆢𑆮𑆪𑆮𑆳𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆵𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆱𑇀𑆮𑆽𑆫𑆕𑇀𑆓𑆶𑆬𑆽𑆂 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑇀𑆪𑆿 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆼 ; 𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆩𑆣𑇀𑆪𑆩𑆳𑆤𑆳𑆩𑆴𑆑𑆳𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆥𑆚𑇀𑆖𑆩𑆨𑆳𑆓𑆲𑆵𑆤𑆳𑆂; 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆼 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆸𑆠𑆼 𑆥𑇀𑆫𑆥𑆢𑆥𑆳𑆢𑆠𑆬𑆼; 𑆥𑆚𑇀𑆖𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆮𑆴𑆱𑇀𑆠𑆸𑆠𑆳 𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑆴𑆂; 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆂 𑆥𑆳𑆢𑆂; 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆳𑆤𑆴 𑆥𑆳𑆢𑆓𑆶𑆬𑇀𑆦𑆘𑆕𑇀𑆔𑆳𑆘𑆳𑆤𑆶𑆩𑆣𑇀𑆪𑆳𑆤𑆴; 𑆃𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳 𑆘𑆕𑇀𑆔𑆳, 𑆘𑆳𑆤𑆷𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆖𑇀𑆖 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆕𑇀𑆓𑆶𑆬𑆩𑇀, 𑆍𑆠𑆼 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀; 𑆘𑆕𑇀𑆔𑆳𑆪𑆳𑆩𑆱𑆩𑆳𑆮𑆷𑆫𑆷; 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑆴 𑆮𑆸𑆰𑆟𑆖𑆴𑆧𑆶𑆑𑆢𑆯𑆤𑆤𑆳𑆱𑆳𑆥𑆶𑆛𑆨𑆳𑆓𑆑𑆫𑇀𑆟𑆩𑆷𑆬𑆨𑇀𑆫𑆷𑆤𑆪𑆤𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴; 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑆴 𑆩𑆼𑆲𑆤𑆮𑆢𑆤𑆳𑆤𑇀𑆠𑆫𑆤𑆳𑆱𑆳𑆑𑆫𑇀𑆟𑆬𑆬𑆳𑆛𑆓𑇀𑆫𑆵𑆮𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆢𑆸𑆰𑇀𑆛𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆟𑆴; 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑆴 𑆨𑆓𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆩𑆼𑆲𑆤𑆤𑆳𑆨𑆴𑆲𑆸𑆢𑆪𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆩𑆶𑆒𑆳𑆪𑆳𑆩𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆥𑇀𑆫𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆳𑆤𑆴; 𑆅𑆤𑇀𑆢𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆥𑆫𑆴𑆟𑆳𑆲𑆳𑆁𑆱𑆥𑆵𑆜𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆤𑇀𑆠𑆫𑆳𑆪𑆳𑆩𑆂 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆂; 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆾 𑆲𑆱𑇀𑆠𑆂; 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆩𑆳𑆟𑆿 𑆨𑆶𑆘𑆿; 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀𑆥𑆫𑆴𑆟𑆳𑆲𑆳𑆮𑆷𑆫𑆷; 𑆩𑆟𑆴𑆧𑆤𑇀𑆣𑆑𑆷𑆫𑇀𑆥𑆫𑆳𑆤𑇀𑆠𑆫𑆁 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁; 𑆠𑆬𑆁 𑆰𑆛𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆳𑆩𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆩𑇀; 𑆃𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆩𑆷𑆬𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆯𑇀𑆫𑆮𑆟𑆳𑆥𑆳𑆕𑇀𑆓𑆳𑆤𑇀𑆠𑆫𑆩𑆣𑇀𑆪𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆿 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆼; 𑆃𑆫𑇀𑆣𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆼 𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑇀𑆪𑆤𑆳𑆩𑆴𑆑𑆼; 𑆱𑆳𑆫𑇀𑆣𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆿 𑆑𑆤𑆴𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆿; 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆩𑆶𑆒𑆓𑇀𑆫𑆵𑆮𑆁; 𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆳 𑆤𑆳𑆱𑆳𑆥𑆶𑆛𑆩𑆫𑇀𑆪𑆳𑆢𑆳; 𑆤𑆪𑆤𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆥𑆫𑆴𑆟𑆳𑆲𑆳 𑆠𑆳𑆫𑆑𑆳; 𑆤𑆮𑆩𑆱𑇀𑆠𑆳𑆫𑆑𑆳𑆁𑆯𑆾 𑆢𑆸𑆰𑇀𑆛𑆴𑆂; 𑆑𑆼𑆯𑆳𑆤𑇀𑆠𑆩𑆱𑇀𑆠𑆑𑆳𑆤𑇀𑆠𑆫𑆩𑆼𑆑𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁; 𑆩𑆱𑇀𑆠𑆑𑆳𑆢𑆮𑆛𑆶𑆑𑆼𑆯𑆳𑆤𑇀𑆠𑆾 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆂; 𑆑𑆫𑇀𑆟𑆳𑆮𑆛𑇀𑆮𑆤𑇀𑆠𑆫𑆁 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁; 𑆥𑆶𑆫𑆶𑆰𑆾𑆫𑆂𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆳 𑆱𑇀𑆠𑇀𑆫𑆵𑆯𑇀𑆫𑆾𑆟𑆴𑆂; 𑆃𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆩𑆶𑆫𑆂; 𑆠𑆠𑇀𑆥𑇀𑆫𑆩𑆳𑆟𑆳 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆑𑆛𑆵; 𑆱𑆮𑆴𑆁𑆯𑆩𑆕𑇀𑆓𑆶𑆬𑆯𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆳𑆪𑆳𑆩 𑆅𑆠𑆴 𑇆𑇑𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂 𑇅 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆼 𑆠𑆠𑆾 𑆮𑆫𑇀𑆰𑆼 𑆥𑆶𑆩𑆳𑆤𑇀 𑆤𑆳𑆫𑆵 𑆠𑆶 𑆰𑆾𑆝𑆯𑆼 𑇅 𑆱𑆩𑆠𑇀𑆮𑆳𑆓𑆠𑆮𑆵𑆫𑇀𑆪𑆿 𑆠𑆿 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇓𑇆
𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆮𑆴𑆠𑇀𑆠𑆁 𑆖 𑆩𑆲𑆢𑆸𑆖𑇀𑆗𑆠𑆴 𑇅 𑆩𑆣𑇀𑆪𑆩𑆁 𑆩𑆣𑇀𑆪𑆩𑆽𑆫𑆳𑆪𑆶𑆫𑇀𑆮𑆴𑆠𑇀𑆠𑆁 𑆲𑆵𑆤𑆽𑆱𑇀𑆠𑆡𑆳𑇁𑆮𑆫𑆩𑇀 𑇆𑇑𑇕𑇆
𑆃𑆡 𑆱𑆳𑆫𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆱𑇀𑆩𑆸𑆠𑆴𑆨𑆑𑇀𑆠𑆴𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆯𑆿𑆖𑆯𑆿𑆫𑇀𑆪𑆾𑆥𑆼𑆠𑆁 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆳𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑆁𑆲𑆠𑆯𑇀𑆮𑆼𑆠𑆳𑆱𑇀𑆡𑆴𑆢𑆤𑇀𑆠𑆤𑆒𑆁 𑆧𑆲𑆶𑆬𑆑𑆳𑆩𑆥𑇀𑆫𑆘𑆁 𑆯𑆶𑆑𑇀𑆫𑆼𑆟; 𑆃𑆑𑆸𑆯𑆩𑆶𑆠𑇀𑆠𑆩𑆧𑆬𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆩𑇀𑆨𑆵𑆫𑆱𑇀𑆮𑆫𑆁 𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆩𑆲𑆳𑆤𑆼𑆠𑇀𑆫𑆁 𑆖 𑆩𑆘𑇀𑆘𑇀𑆚𑆳; 𑆩𑆲𑆳𑆯𑆴𑆫𑆂𑆱𑇀𑆑𑆤𑇀𑆣𑆁 𑆢𑆸𑆞𑆢𑆤𑇀𑆠𑆲𑆤𑇀𑆮𑆱𑇀𑆡𑆴𑆤𑆒𑆩𑆱𑇀𑆡𑆴𑆨𑆴𑆂; 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆮𑆫𑆁 𑆧𑆸𑆲𑆖𑇀𑆗𑆫𑆵𑆫𑆩𑆳𑆪𑆳𑆱𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆁 𑆩𑆼𑆢𑆱𑆳; 𑆃𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆓𑆳𑆠𑇀𑆫𑆁 𑆓𑆷𑆞𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆁 𑆩𑆳𑆁𑆱𑆾𑆥𑆖𑆴𑆠𑆁 𑆖 𑆩𑆳𑆁𑆱𑆼𑆤; 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆠𑆳𑆩𑇀𑆫𑆤𑆒𑆤𑆪𑆤𑆠𑆳𑆬𑆶𑆘𑆴𑆲𑇀𑆮𑆿𑆰𑇀𑆜𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆁 𑆫𑆑𑇀𑆠𑆼𑆤; 𑆱𑆶𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆩𑆸𑆢𑆶𑆠𑇀𑆮𑆓𑇀𑆫𑆾𑆩𑆳𑆟𑆁 𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑇅 𑆍𑆰𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆳𑆪𑆶𑆂𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆪𑆾𑆫𑆴𑆠𑆴 𑇆𑇑𑇖𑇆
𑆮𑆴𑆯𑆼𑆰𑆠𑆾𑇁𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆢𑆡 𑆱𑆳𑆫𑆠𑆂 𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆪𑆶𑆂 𑆱𑆶𑆤𑆴𑆥𑆶𑆟𑆾 𑆨𑆴𑆰𑆑𑇀 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆑𑆫𑇀𑆩𑆱𑆶 𑇆𑇑𑇗𑇆
𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆳𑆂; 𑆱𑆫𑇀𑆮 𑆍𑆮𑆽𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑆂- 𑆱𑆳𑆣𑇀𑆪𑆳, 𑆪𑆳𑆥𑇀𑆪𑆳𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆳𑆯𑇀𑆖 𑇅 𑆠𑆠𑇀𑆫𑆽𑆠𑆳𑆤𑇀 𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆣𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠- 𑆑𑆴𑆩𑆪𑆩𑆿𑆥𑆱𑆫𑇀𑆓𑆴𑆑𑆂, 𑆥𑇀𑆫𑆳𑆑𑇀𑆑𑆼𑆮𑆬𑆂, 𑆃𑆤𑇀𑆪𑆬𑆑𑇀𑆰𑆟 𑆅𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆐𑆥𑆱𑆫𑇀𑆓𑆴𑆑𑆾 𑆤𑆳𑆩 𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆘𑆔𑆤𑇀𑆪𑆑𑆳𑆬𑆘𑆳𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆥𑆱𑆸𑆘𑆠𑆴, 𑆱 𑆠𑆤𑇀𑆩𑆷𑆬 𑆍𑆮𑆾𑆥𑆢𑇀𑆫𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆂; 𑆥𑇀𑆫𑆳𑆑𑇀𑆑𑆼𑆮𑆬𑆾 𑆤𑆳𑆩 𑆪𑆂 𑆥𑇀𑆫𑆳𑆓𑆼𑆮𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆾𑇁𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆯𑇀𑆖; 𑆃𑆤𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆾 𑆤𑆳𑆩 𑆪𑆾 𑆨𑆮𑆴𑆰𑇀𑆪𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆒𑇀𑆪𑆳𑆥𑆑𑆂, 𑆱 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆩𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆮𑆴𑆫𑆾𑆣𑆼𑆤𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠, 𑆧𑆬𑆮𑆤𑇀𑆠𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆁 𑆮𑆳; 𑆥𑇀𑆫𑆳𑆑𑇀𑆑𑆼𑆮𑆬𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆃𑆤𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆼 𑆠𑇀𑆮𑆳𑆢𑆴𑆮𑇀𑆪𑆳𑆣𑆿 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑇆𑇑𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑇅 𑆤𑆳𑆱𑇀𑆠𑆴 𑆫𑆾𑆓𑆾 𑆮𑆴𑆤𑆳 𑆢𑆾𑆰𑆽𑆫𑇀𑆪𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆃𑆤𑆶𑆑𑇀𑆠𑆩𑆥𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆳 𑆉𑆠𑆮𑆂 𑇆𑇒𑇐𑇆
𑆯𑆵𑆠𑆼 𑆯𑆵𑆠𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆩𑆶𑆰𑇀𑆟𑆼 𑆖𑆾𑆰𑇀𑆟𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇅 𑆑𑆸𑆠𑇀𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆳𑆬𑆁 𑆤 𑆲𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆃𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆮𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆳𑆬𑆼 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆮𑆳 𑆤 𑆑𑆸𑆠𑆳 𑆑𑇀𑆫𑆴𑆪𑆳 𑇅 𑆑𑇀𑆫𑆴𑆪𑆳 𑆲𑆵𑆤𑆳𑇁𑆠𑆴𑆫𑆴𑆑𑇀𑆠𑆳 𑆮𑆳 𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑇀𑆮𑆥𑆴 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑇆𑇒𑇒𑇆
𑆪𑆳 𑆲𑇀𑆪𑆶𑆢𑆵𑆫𑇀𑆟𑆁 𑆯𑆩𑆪𑆠𑆴 𑆤𑆳𑆤𑇀𑆪𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆑𑆫𑆾𑆠𑆴 𑆖 𑇅 𑆱𑆳 𑆑𑇀𑆫𑆴𑆪𑆳, 𑆤 𑆠𑆶 𑆪𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆲𑆫𑆠𑇀𑆪𑆤𑇀𑆪𑆩𑆶𑆢𑆵𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇓𑇆
𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑆤𑇀𑆤𑆱𑇀𑆪 𑆥𑆳𑆖𑆑𑆂 𑇅 𑆱 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾 𑆨𑆮𑆠𑆴- 𑆢𑆾𑆰𑆳𑆤𑆨𑆴𑆥𑆤𑇀𑆤 𑆍𑆑𑆂, 𑆮𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑆳𑆥𑆤𑇀𑆤𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾 𑆨𑆮𑆠𑆴- 𑆮𑆴𑆰𑆩𑆾 𑆮𑆳𑆠𑆼𑆤, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆥𑆴𑆠𑇀𑆠𑆼𑆤, 𑆩𑆤𑇀𑆢𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳, 𑆖𑆠𑆶𑆫𑇀𑆡𑆂 𑆱𑆩𑆂 𑆱𑆫𑇀𑆮𑆱𑆳𑆩𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆪𑆾 𑆪𑆡𑆳𑆑𑆳𑆬𑆩𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆤𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆖𑆠𑆴 𑆱 𑆱𑆩𑆂, 𑆱𑆩𑆽𑆫𑇀𑆢𑆾𑆰𑆽𑆂; 𑆪𑆂 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆖𑆠𑆴, 𑆑𑆢𑆳𑆖𑆴𑆢𑆳𑆣𑇀𑆩𑆳𑆤𑆯𑆷𑆬𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆠𑆴𑆱𑆳𑆫𑆘𑆜𑆫𑆓𑆿𑆫𑆮𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆳𑆤𑆴 𑆑𑆸𑆠𑇀𑆮𑆳, 𑆱 𑆮𑆴𑆰𑆩𑆂; 𑆪𑆂 𑆥𑇀𑆫𑆨𑆷𑆠𑆩𑆥𑇀𑆪𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆤𑆩𑆳𑆯𑆶 𑆥𑆖𑆠𑆴 𑆱 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂, 𑆱 𑆍𑆮𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆾𑇁𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑆴𑆠𑇀𑆪𑆳𑆨𑆳𑆰𑇀𑆪𑆠𑆼, 𑆱 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆥𑇀𑆫𑆨𑆷𑆠𑆩𑆥𑇀𑆪𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆤𑆩𑆳𑆯𑆶𑆠𑆫𑆁 𑆥𑆖𑆠𑆴, 𑆥𑆳𑆑𑆳𑆤𑇀𑆠𑆼 𑆖 𑆓𑆬𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆯𑆾𑆰𑆢𑆳𑆲𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴; 𑆪𑆱𑇀𑆠𑇀𑆮𑆬𑇀𑆥𑆩𑆥𑇀𑆪𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆶𑆢𑆫𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆱𑆼𑆑𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆓𑆳𑆠𑇀𑆫𑆱𑆢𑆤𑆳𑆤𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆩𑆲𑆠𑆳 𑆑𑆳𑆬𑆼𑆤 𑆥𑆖𑆠𑆴, 𑆱 𑆩𑆤𑇀𑆢𑆂 𑇆𑇒𑇔𑇆
𑆮𑆴𑆰𑆩𑆾 𑆮𑆳𑆠𑆘𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆁𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆳𑆤𑇀 𑇅 𑆑𑆫𑆾𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑇀𑆠𑆡𑆳 𑆩𑆤𑇀𑆢𑆾 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆑𑆦𑆱𑆩𑇀𑆨𑆮𑆳𑆤𑇀 𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫, 𑆱𑆩𑆼 𑆥𑆫𑆴𑆫𑆑𑇀𑆰𑆟𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆮𑆴𑆰𑆩𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆽𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆯𑆼𑆰𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆼 𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆑𑆽𑆯𑇀𑆖; 𑆍𑆮𑆩𑆼𑆮𑆳𑆠𑇀𑆪𑆓𑇀𑆤𑆿, 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆩𑆳𑆲𑆴𑆰𑆽𑆯𑇀𑆖 𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆂; 𑆩𑆤𑇀𑆢𑆼 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆮𑆩𑆤𑆽𑆯𑇀𑆖 𑇆𑇒𑇖𑇆
𑆘𑆳𑆜𑆫𑆾 𑆨𑆓𑆮𑆳𑆤𑆓𑇀𑆤𑆴𑆫𑆵𑆯𑇀𑆮𑆫𑆾𑇁𑆤𑇀𑆤𑆱𑇀𑆪 𑆥𑆳𑆖𑆑𑆂 𑇅 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆢𑇀𑆫𑆱𑆳𑆤𑆳𑆢𑆢𑆳𑆤𑆾 𑆮𑆴𑆮𑆼𑆑𑇀𑆠𑆶𑆁 𑆤𑆽𑆮 𑆯𑆑𑇀𑆪𑆠𑆼 𑇆𑇒𑇗𑇆
𑆥𑇀𑆫𑆳𑆟𑆳𑆥𑆳𑆤𑆱𑆩𑆳𑆤𑆽𑆱𑇀𑆠𑆶 𑆱𑆫𑇀𑆮𑆠𑆂 𑆥𑆮𑆤𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆂 𑇅 𑆣𑇀𑆩𑆳𑆪𑆠𑆼 𑆥𑆳𑆬𑇀𑆪𑆠𑆼 𑆖𑆳𑆥𑆴 𑆱𑇀𑆮𑆳𑆁 𑆱𑇀𑆮𑆳𑆁 𑆓𑆠𑆴𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆽𑆂 𑇆𑇒𑇘𑇆
𑆮𑆪𑆱𑇀𑆠𑆶 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁- 𑆧𑆳𑆬𑇀𑆪𑆁, 𑆩𑆣𑇀𑆪𑆁, 𑆮𑆸𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫𑆾𑆤𑆰𑆾𑆝𑆯𑆮𑆫𑇀𑆰𑆵𑆪𑆳 𑆧𑆳𑆬𑆳𑆂 𑇅 𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑆂- 𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆂, 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆳𑆢𑆳, 𑆃𑆤𑇀𑆤𑆳𑆢𑆳 𑆅𑆠𑆴 𑇅 𑆠𑆼𑆰𑆶 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆥𑆫𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆂, 𑆢𑇀𑆮𑆴𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆥𑆫𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆳𑆢𑆳𑆂, 𑆥𑆫𑆠𑆾𑇁𑆤𑇀𑆤𑆳𑆢𑆳 𑆅𑆠𑆴 𑇅 𑆰𑆾𑆝𑆯𑆱𑆥𑇀𑆠𑆠𑇀𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼 𑆩𑆣𑇀𑆪𑆁 𑆮𑆪𑆂 𑇅 𑆠𑆱𑇀𑆪 𑆮𑆴𑆑𑆬𑇀𑆥𑆾- 𑆮𑆸𑆢𑇀𑆣𑆴𑆂, 𑆪𑆿𑆮𑆤𑆁, 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆠𑆳, 𑆥𑆫𑆴𑆲𑆳𑆟𑆴𑆫𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆄𑆮𑆴𑆁𑆯𑆠𑆼𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆂, 𑆄𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑆾 𑆪𑆿𑆮𑆤𑆩𑇀, 𑆄𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑆂 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆠𑆳, 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆵𑆰𑆠𑇀𑆥𑆫𑆴𑆲𑆳𑆟𑆴𑆫𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆥𑇀𑆠𑆠𑆴𑆫𑆴𑆠𑆴 𑇅 𑆱𑆥𑇀𑆠𑆠𑆼𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆑𑇀𑆰𑆵𑆪𑆩𑆳𑆟𑆣𑆳𑆠𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆾𑆠𑇀𑆱𑆳𑆲𑆩𑆲𑆤𑇀𑆪𑆲𑆤𑆴 𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆘𑆶𑆰𑇀𑆛𑆁 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆫𑆨𑆴𑆨𑆷𑆪𑆩𑆳𑆤𑆁 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆮𑆱𑆩𑆫𑇀𑆡𑆁 𑆘𑆵𑆫𑇀𑆟𑆳𑆓𑆳𑆫𑆩𑆴𑆮𑆳𑆨𑆴𑆮𑆸𑆰𑇀𑆛𑆩𑆮𑆱𑆵𑆢𑆤𑇀𑆠𑆁 𑆮𑆸𑆢𑇀𑆣𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇒𑇙𑇆
𑆠𑆠𑇀𑆫𑆾𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆳𑆱𑆶 𑆮𑆪𑆾𑆮𑆱𑇀𑆡𑆳𑆱𑆷𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆳 𑆨𑆼𑆰𑆘𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆉𑆠𑆼 𑆖 𑆥𑆫𑆴𑆲𑆳𑆟𑆼𑆂; 𑆠𑆠𑇀𑆫𑆳𑆢𑇀𑆪𑆳𑆥𑆼𑆑𑇀𑆰𑆪𑆳 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇓𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆧𑆳𑆬𑆼 𑆮𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆩𑆣𑇀𑆪𑆩𑆼 𑆥𑆴𑆠𑇀𑆠𑆩𑆼𑆮 𑆠𑆶 𑇅 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆮𑆫𑇀𑆣𑆠𑆼 𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆼 𑆠𑆢𑇀𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇓𑇑𑇆
𑆃𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆮𑆴𑆫𑆼𑆑𑆽𑆱𑇀𑆠𑆶 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆿 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆩𑆸𑆢𑇀𑆮𑆵𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆯𑆤𑆽𑆂 𑇆𑇓𑇒𑇆
𑆢𑆼𑆲𑆂 𑆱𑇀𑆡𑆷𑆬𑆂, 𑆑𑆸𑆯𑆾, 𑆩𑆣𑇀𑆪, 𑆅𑆠𑆴 𑆥𑇀𑆫𑆳𑆓𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆂 𑇆𑇓𑇓𑇆
𑆑𑆫𑇀𑆯𑆪𑆼𑆢𑇀𑆧𑆸𑆁𑆲𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆱𑆢𑆳 𑆱𑇀𑆡𑆷𑆬𑆑𑆸𑆯𑆿 𑆤𑆫𑆿 𑇅 𑆫𑆑𑇀𑆰𑆟𑆁 𑆖𑆽𑆮 𑆩𑆣𑇀𑆪𑆱𑇀𑆪 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆱𑆠𑆠𑆁 𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇔𑇆
𑆧𑆬𑆩𑆨𑆴𑆲𑆴𑆠𑆓𑆶𑆟𑆁; 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆠𑆶 𑆱𑇀𑆮𑆨𑆳𑆮𑆢𑆾𑆰𑆘𑆫𑆳𑆢𑆴𑆨𑆴𑆫𑆮𑆼𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆩𑇀 𑇅 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆧𑆬𑆮𑆠𑆂 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆧𑆬𑆩𑆼𑆮 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆣𑆴𑆑𑆫𑆟𑆳𑆤𑆳𑆩𑇀 𑇆𑇓𑇕𑇆
𑆑𑆼𑆖𑆴𑆠𑇀 𑆑𑆸𑆯𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆮𑆤𑇀𑆠𑆂 𑆱𑇀𑆡𑆷𑆬𑆳𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆧𑆬𑆳 𑆤𑆫𑆳𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆽𑆫𑇀𑆧𑆬𑆁 𑆮𑆽𑆢𑇀𑆪𑆂 𑆥𑇀𑆫𑆠𑆫𑇀𑆑𑆪𑆼𑆠𑇀 𑇆𑇓𑇖𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆠𑆶 𑆮𑇀𑆪𑆱𑆤𑆳𑆨𑇀𑆪𑆶𑆢𑆪𑆑𑇀𑆫𑆴𑆪𑆳𑆢𑆴𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑇀𑆮𑆮𑆴𑆑𑇀𑆬𑆮𑆑𑆫𑆩𑇀 𑇆𑇓𑇗𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆳𑆤𑇀 𑆱𑆲𑆠𑆼 𑆱𑆫𑇀𑆮𑆁 𑆱𑆁𑆱𑇀𑆠𑆨𑇀𑆪𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆠𑇀𑆩𑆤𑆳 𑇅 𑆫𑆳𑆘𑆱𑆂 𑆱𑇀𑆠𑆨𑇀𑆪𑆩𑆳𑆤𑆾𑇁𑆤𑇀𑆪𑆽𑆂 𑆱𑆲𑆠𑆼 𑆤𑆽𑆮 𑆠𑆳𑆩𑆱𑆂 𑇆𑇓𑇘𑇆
𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆤𑆴 𑆠𑆶 𑆢𑆼𑆯𑆑𑆳𑆬𑆘𑆳𑆠𑇀𑆪𑆸𑆠𑆶𑆫𑆾𑆓𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑆢𑆑𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆫𑆱𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆥𑆴 𑆪𑆳𑆤𑇀𑆪𑆧𑆳𑆣𑆑𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇙𑇆
𑆪𑆾 𑆫𑆱𑆂 𑆑𑆬𑇀𑆥𑆠𑆼 𑆪𑆱𑇀𑆪 𑆱𑆶𑆒𑆳𑆪𑆽𑆮 𑆤𑆴𑆰𑆼𑆮𑆴𑆠𑆂 𑇅 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆘𑆳𑆠𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆠𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆴𑆠𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇔𑇐𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆨𑆼𑆰𑆘𑆁 𑆖𑆾𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆢𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇔𑇑𑇆
𑆢𑆼𑆯𑆱𑇀𑆠𑇀𑆮𑆳𑆤𑆷𑆥𑆾 𑆘𑆳𑆕𑇀𑆓𑆬𑆂 𑆱𑆳𑆣𑆳𑆫𑆟 𑆅𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆧𑆲𑆷𑆢𑆑𑆤𑆴𑆩𑇀𑆤𑆾𑆤𑇀𑆤𑆠𑆤𑆢𑆵𑆮𑆫𑇀𑆰𑆓𑆲𑆤𑆾 𑆩𑆸𑆢𑆶𑆯𑆵𑆠𑆳𑆤𑆴𑆬𑆾 𑆧𑆲𑆶𑆩𑆲𑆳𑆥𑆫𑇀𑆮𑆠𑆮𑆸𑆑𑇀𑆰𑆾 𑆩𑆸𑆢𑆶𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆾𑆥𑆖𑆴𑆠𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆰𑇀𑆪𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆦𑆮𑆳𑆠𑆫𑆾𑆓𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆯𑇀𑆖𑆳𑆤𑆷𑆥𑆂; 𑆄𑆑𑆳𑆯𑆱𑆩𑆂 𑆥𑇀𑆫𑆮𑆴𑆫𑆬𑆳𑆬𑇀𑆥𑆑𑆟𑇀𑆛𑆑𑆴𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆬𑇀𑆥𑆮𑆫𑇀𑆰𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆟𑆾𑆢𑆥𑆳𑆤𑆾𑆢𑆑𑆥𑇀𑆫𑆳𑆪 𑆇𑆰𑇀𑆟𑆢𑆳𑆫𑆶𑆟𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆫𑆬𑆳𑆬𑇀𑆥𑆯𑆽𑆬𑆂 𑆱𑇀𑆡𑆴𑆫𑆑𑆸𑆯𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆰𑇀𑆪𑆥𑇀𑆫𑆳𑆪𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆫𑆾𑆓𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆯𑇀𑆖 𑆘𑆳𑆕𑇀𑆓𑆬𑆂; 𑆇𑆨𑆪𑆢𑆼𑆯𑆬𑆑𑇀𑆰𑆟𑆂 𑆱𑆳𑆣𑆳𑆫𑆟 𑆅𑆠𑆴 𑇆𑇔𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆩𑆳𑆂 𑆱𑆳𑆣𑆳𑆫𑆟𑆼 𑆪𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆵𑆠𑆮𑆫𑇀𑆰𑆾𑆰𑇀𑆩𑆩𑆳𑆫𑆶𑆠𑆳𑆂 𑇅 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆩𑆠𑆳 𑆘𑆤𑇀𑆠𑆾𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆱𑆳𑆣𑆳𑆫𑆟𑆾 𑆩𑆠𑆂 𑇆𑇔𑇓𑇆
𑆤 𑆠𑆡𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆘𑆬𑆘𑆳 𑆮𑆳 𑆱𑇀𑆡𑆬𑆳𑆲𑆸𑆠𑆳𑆂 𑇅 𑆱𑇀𑆮𑆢𑆼𑆯𑆼 𑆤𑆴𑆖𑆴𑆠𑆳 𑆢𑆾𑆰𑆳 𑆃𑆤𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆾𑆥𑆩𑆳𑆓𑆠𑆳𑆂 𑇆𑇔𑇔𑇆
𑆇𑆖𑆴𑆠𑆼 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆱𑇀𑆪 𑆤𑆳𑆱𑇀𑆠𑆴 𑆢𑆼𑆯𑆑𑆸𑆠𑆁 𑆨𑆪𑆩𑇀 𑇅 𑆄𑆲𑆳𑆫𑆱𑇀𑆮𑆥𑇀𑆤𑆖𑆼𑆰𑇀𑆛𑆳𑆢𑆿 𑆠𑆢𑇀𑆢𑆼𑆯𑆱𑇀𑆪 𑆓𑆶𑆟𑆼 𑆱𑆠𑆴 𑇆𑇔𑇕𑇆
𑆢𑆼𑆯𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆫𑇀𑆠𑆶𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑇁𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆂 𑇅 𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆿 𑆨𑆴𑆰𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆧𑆬𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆪𑆶𑆰𑆳𑆁 𑆠𑆡𑆳 𑇆𑇔𑇖𑇆
𑆑𑆼𑆮𑆬𑆂 𑆱𑆩𑆢𑆼𑆲𑆳𑆓𑇀𑆤𑆼𑆂 𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆠𑆩𑆾 𑆓𑆢𑆂 𑇅 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆠𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾 𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆬𑆑𑇀𑆰𑆟𑆂 𑇆𑇔𑇗𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆳𑆱𑇀𑆠𑆶 𑆓𑆶𑆟𑆳𑆬𑆳𑆨𑆼 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑆤𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆥𑆷𑆫𑇀𑆮𑆱𑇀𑆪𑆳𑆁 𑆯𑆳𑆤𑇀𑆠𑆮𑆼𑆓𑆳𑆪𑆳𑆁 𑆤 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆕𑇀𑆑𑆫𑆾 𑆲𑆴𑆠𑆂 𑇆𑇔𑇘𑇆
𑆓𑆶𑆟𑆳𑆬𑆳𑆨𑆼𑇁𑆥𑆴 𑆱𑆥𑆢𑆴 𑆪𑆢𑆴 𑆱𑆽𑆮 𑆑𑇀𑆫𑆴𑆪𑆳 𑆲𑆴𑆠𑆳 𑇅 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆽𑆮 𑆠𑆢𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆠𑆩𑆾 𑆪𑆢𑆴 𑇆𑇔𑇙𑇆
𑆪 𑆍𑆮𑆩𑆼𑆤𑆁 𑆮𑆴𑆣𑆴𑆩𑆼𑆑𑆫𑆷𑆥𑆁 𑆧𑆴𑆨𑆫𑇀𑆠𑆴 𑆑𑆳𑆬𑆳𑆢𑆴𑆮𑆯𑆼𑆤 𑆣𑆵𑆩𑆳𑆤𑇀 𑇅 𑆱 𑆩𑆸𑆠𑇀𑆪𑆶𑆥𑆳𑆯𑆳𑆚𑇀𑆘𑆓𑆠𑆾 𑆓𑆢𑆿𑆔𑆳𑆚𑇀𑆗𑆴𑆤𑆠𑇀𑆠𑆴 𑆨𑆽𑆰𑆘𑇀𑆪𑆥𑆫𑆯𑇀𑆮𑆣𑆼𑆤 𑇆𑇕𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆨𑆷𑆩𑆴𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆯𑇀𑆮𑆨𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆩𑆮𑆴𑆰𑆩𑆮𑆬𑇀𑆩𑆵𑆑𑆯𑇀𑆩𑆯𑆳𑆤𑆳𑆔𑆳𑆠𑆤𑆢𑆼𑆮𑆠𑆳𑆪𑆠𑆤𑆱𑆴𑆑𑆠𑆳𑆨𑆴𑆫𑆤𑆶𑆥𑆲𑆠𑆳𑆩𑆤𑆷𑆰𑆫𑆳𑆩𑆨𑆕𑇀𑆓𑆶𑆫𑆳𑆩𑆢𑆷𑆫𑆾𑆢𑆑𑆳𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆁 𑆥𑇀𑆫𑆫𑆾𑆲𑆮𑆠𑆵𑆁 𑆩𑆸𑆢𑇀𑆮𑆵𑆁 𑆱𑇀𑆡𑆴𑆫𑆳𑆁 𑆱𑆩𑆳𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆁 𑆓𑆿𑆫𑆵𑆁 𑆬𑆾𑆲𑆴𑆠𑆳𑆁 𑆮𑆳 𑆨𑆷𑆩𑆴𑆩𑆿𑆰𑆣𑆓𑇀𑆫𑆲𑆟𑆳𑆪 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑇅 𑆠𑆱𑇀𑆪𑆳𑆁 𑆘𑆳𑆠𑆩𑆥𑆴 𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆠𑆥𑆥𑆮𑆤𑆢𑆲𑆤𑆠𑆾𑆪𑆱𑆩𑇀𑆧𑆳𑆣𑆩𑆳𑆫𑇀𑆓𑆽𑆫𑆤𑆶𑆥𑆲𑆠𑆩𑆼𑆑𑆫𑆱𑆁 𑆥𑆶𑆰𑇀𑆛𑆁 𑆥𑆸𑆡𑇀𑆮𑆮𑆓𑆳𑆞𑆩𑆷𑆬𑆩𑆶𑆢𑆵𑆖𑇀𑆪𑆳𑆁 𑆖𑆿𑆰𑆣𑆩𑆳𑆢𑆢𑆵𑆠𑆼𑆠𑇀𑆪𑆼𑆰 𑆨𑆷𑆩𑆴𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆮𑆴𑆯𑆼𑆰𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆂 𑇆𑇓𑇆
𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆠𑆠𑇀𑆫, 𑆃𑆯𑇀𑆩𑆮𑆠𑆵 𑆱𑇀𑆡𑆴𑆫𑆳 𑆓𑆶𑆫𑇀𑆮𑆵 𑆯𑇀𑆪𑆳𑆩𑆳 𑆑𑆸𑆰𑇀𑆟𑆳 𑆮𑆳 𑆱𑇀𑆡𑆷𑆬𑆮𑆸𑆑𑇀𑆰𑆯𑆱𑇀𑆪𑆥𑇀𑆫𑆳𑆪𑆳 𑆱𑇀𑆮𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳; 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆯𑆵𑆠𑆬𑆳𑇁𑇁𑆱𑆤𑇀𑆤𑆾𑆢𑆑𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆱𑇀𑆪𑆠𑆸𑆟𑆑𑆾𑆩𑆬𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆳𑆪𑆳 𑆯𑆶𑆑𑇀𑆬𑆳𑇁𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳; 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆳 𑆬𑆔𑇀𑆮𑆯𑇀𑆩𑆮𑆠𑆵 𑆥𑇀𑆫𑆮𑆴𑆫𑆬𑆳𑆬𑇀𑆥𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆫𑆾𑆲𑆳𑇁𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳; 𑆫𑆷𑆑𑇀𑆰𑆳 𑆨𑆱𑇀𑆩𑆫𑆳𑆱𑆨𑆮𑆫𑇀𑆟𑆳 𑆠𑆤𑆶𑆮𑆸𑆑𑇀𑆰𑆳𑆬𑇀𑆥𑆫𑆱𑆑𑆾𑆛𑆫𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆳𑆪𑆳𑇁𑆤𑆴𑆬𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳; 𑆩𑆸𑆢𑇀𑆮𑆵 𑆱𑆩𑆳 𑆯𑇀𑆮𑆨𑇀𑆫𑆮𑆠𑇀𑆪𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆘𑆬𑆳 𑆱𑆫𑇀𑆮𑆠𑆾𑇁𑆱𑆳𑆫𑆮𑆸𑆑𑇀𑆰𑆳 𑆩𑆲𑆳𑆥𑆫𑇀𑆮𑆠𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆳𑆪𑆳 𑆯𑇀𑆪𑆳𑆩𑆳 𑆖𑆳𑆑𑆳𑆯𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆨𑆷𑆩𑆿 𑆘𑆳𑆠𑆳𑆤𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆳𑆢𑆢𑆵𑆠 , 𑆃𑆓𑇀𑆤𑇀𑆪𑆳𑆑𑆳𑆯𑆩𑆳𑆫𑆶𑆠𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴, 𑆇𑆨𑆪𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆩𑆶𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆳𑆤𑆴, 𑆄𑆑𑆳𑆯𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆱𑆁𑆯𑆩𑆤𑆳𑆤𑆴, 𑆍𑆮𑆁 𑆧𑆬𑆮𑆠𑇀𑆠𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇖𑇆
𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮 𑆖𑆳𑆨𑆴𑆤𑆮𑆳𑆤𑆴, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫 𑆩𑆣𑆶𑆔𑆸𑆠𑆓𑆶𑆝𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆝𑆕𑇀𑆓𑆼𑆨𑇀𑆪𑆂 𑇆𑇗𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆮𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆯𑆼𑆰𑆩𑆤𑇀𑆪𑆠𑇀𑆮𑆨𑆴𑆤𑆮𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆮𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇆𑇘𑇆
(𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮 𑆱𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆴 𑆮𑆵𑆫𑇀𑆪𑆮𑆤𑇀𑆠𑆴;) 𑆠𑆼𑆰𑆳𑆩𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆳𑆮𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆟𑇀𑆪𑆳𑆢𑆢𑆵𑆠𑆼𑆠𑆴 𑇆𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆾𑆥𑆳𑆬𑆳𑆱𑇀𑆠𑆳𑆥𑆱𑆳 𑆮𑇀𑆪𑆳𑆣𑆳 𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼 𑆮𑆤𑆖𑆳𑆫𑆴𑆟𑆂 𑇅 𑆩𑆷𑆬𑆳𑆲𑆳𑆫𑆳𑆯𑇀𑆖 𑆪𑆼 𑆠𑆼𑆨𑇀𑆪𑆾 𑆨𑆼𑆰𑆘𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇑𑇐𑇆
𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆾𑆥𑆼𑆠𑆳 𑆰𑆝𑇀𑆮𑆴𑆣𑆳 𑆨𑆷𑆩𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆷𑆩𑆴𑆱𑇀𑆮𑆨𑆳𑆮𑆼𑆤 𑆧𑆵𑆘𑆴𑆤𑆂 𑆰𑆝𑇀𑆫𑆱𑆳𑆪𑆶𑆠𑆳𑆂 𑇆𑇑𑇒𑇆
𑆃𑆮𑇀𑆪𑆑𑇀𑆠𑆂 𑆑𑆴𑆬 𑆠𑆾𑆪𑆱𑇀𑆪 𑆫𑆱𑆾 𑆤𑆴𑆯𑇀𑆖𑆪𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆂 𑇅 𑆫𑆱𑆂 𑆱 𑆍𑆮 𑆖𑆳𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆨𑆷𑆩𑆴𑆫𑆱𑆳𑆢𑇀𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇓𑇆
𑆱𑆫𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆳 𑆨𑆷𑆩𑆴𑆂 𑆱𑆳𑆣𑆳𑆫𑆟𑆳 𑆱𑇀𑆩𑆸𑆠𑆳 𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆪𑆠𑇀𑆫 𑆠𑆠𑇀𑆫𑆽𑆮 𑆠𑆢𑇀𑆓𑆶𑆟𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇔𑇆
𑆮𑆴𑆓𑆤𑇀𑆣𑆼𑆤𑆳𑆥𑆫𑆳𑆩𑆸𑆰𑇀𑆛𑆩𑆮𑆴𑆥𑆤𑇀𑆤𑆁 𑆫𑆱𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆤𑆮𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑆶𑆫𑆳𑆟𑆁 𑆮𑆳 𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆩𑆼𑆮𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆘𑆕𑇀𑆓𑆩𑆳𑆤𑆳𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆫𑆑𑇀𑆠𑆫𑆾𑆩𑆤𑆒𑆳𑆢𑆴𑆑𑆩𑇀 𑇅 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆘𑆵𑆫𑇀𑆟𑆳𑆲𑆳𑆫𑆼𑆰𑆶 𑆱𑆁𑆲𑆫𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆥𑇀𑆬𑆾𑆠𑆩𑆸𑆢𑇀𑆨𑆳𑆟𑇀𑆝𑆦𑆬𑆑𑆯𑆕𑇀𑆑𑆶𑆮𑆴𑆤𑇀𑆪𑆱𑇀𑆠𑆨𑆼𑆰𑆘𑆩𑇀 𑇅 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆪𑆳𑆁 𑆢𑆴𑆯𑆴 𑆯𑆶𑆖𑆿 𑆨𑆼𑆰𑆘𑆳𑆓𑆳𑆫𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇑𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆴𑆯𑇀𑆫𑆑𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆿 𑆖 𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶 𑆩𑆲𑆿𑆰𑆣𑆩𑇀 𑇅 𑆃𑆲𑆴𑆁𑆱𑇀𑆫𑆳 𑆖𑆽𑆮 𑆫𑆳𑆱𑇀𑆤𑆳 𑆖 𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆮𑆳𑆠𑆯𑆾𑆦𑆘𑆴𑆠𑇀 𑇆𑇓𑇆
𑆢𑆷𑆫𑇀𑆮𑆳 𑆖 𑆤𑆬𑆩𑆷𑆬𑆁 𑆖 𑆩𑆣𑆶𑆑𑆁 𑆖𑆤𑇀𑆢𑆤𑆁 𑆠𑆡𑆳 𑇅 𑆯𑆵𑆠𑆬𑆳𑆯𑇀𑆖 𑆓𑆟𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆥𑇀𑆫𑆬𑆼𑆥𑆂 𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆦𑆲𑆸𑆠𑇀 𑇆𑇔𑇆
𑆄𑆓𑆤𑇀𑆠𑆶𑆘𑆼 𑆫𑆑𑇀𑆠𑆘𑆼 𑆖 𑆲𑇀𑆪𑆼𑆰 𑆍𑆮 𑆮𑆴𑆣𑆴𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆮𑆴𑆣𑆴𑆫𑇀𑆮𑆴𑆰𑆔𑇀𑆤𑆾 𑆮𑆴𑆰𑆘𑆼 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆾𑇁𑆥𑆴 𑆲𑆴𑆠𑆱𑇀𑆠𑆡𑆳 𑇆𑇕𑇆
𑆃𑆘𑆓𑆤𑇀𑆣𑆳𑇁𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳 𑆖 𑆑𑆳𑆬𑆳 𑆱𑆫𑆬𑆪𑆳 𑆱𑆲 𑇅 𑆍𑆑𑆽𑆰𑆴𑆑𑆳𑆘𑆯𑆸𑆕𑇀𑆓𑆵 𑆖 𑆥𑇀𑆫𑆬𑆼𑆥𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆦𑆲𑆸𑆠𑇀 𑇆𑇖𑇆
𑆍𑆠𑆼 𑆮𑆫𑇀𑆓𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆬𑆾𑆣𑇀𑆫𑆁 𑆥𑆡𑇀𑆪𑆳 𑆥𑆴𑆟𑇀𑆝𑆵𑆠𑆑𑆳𑆤𑆴 𑆖 𑇅 𑆃𑆤𑆤𑇀𑆠𑆳 𑆖𑆼𑆠𑆴 𑆬𑆼𑆥𑆾𑇁𑆪𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆯𑆾𑆦𑆲𑆸𑆠𑇀 𑇆𑇗𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆾 𑆮𑆳𑆠𑆼 𑆑𑆾𑆰𑇀𑆟𑆂, 𑆯𑆵𑆠𑆂 𑆥𑆪𑆾𑆪𑆶𑆠𑆂 𑇅 𑆥𑆴𑆠𑇀𑆠𑆼, 𑆖𑆾𑆰𑇀𑆟𑆂 𑆑𑆦𑆼 𑆑𑇀𑆰𑆳𑆫𑆩𑆷𑆠𑇀𑆫𑆳𑆞𑇀𑆪𑆱𑇀𑆠𑆠𑇀𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇘𑇆
𑆯𑆟𑆩𑆷𑆬𑆑𑆯𑆴𑆓𑇀𑆫𑆷𑆟𑆳𑆁 𑆦𑆬𑆳𑆤𑆴 𑆠𑆴𑆬𑆱𑆫𑇀𑆰𑆥𑆳𑆂 𑇅 𑆱𑆑𑇀𑆠𑆮𑆂 𑆑𑆴𑆟𑇀𑆮𑆩𑆠𑆱𑆵 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆤𑆴 𑆥𑆳𑆖𑆤𑆩𑇀 𑇆𑇙𑇆
𑆖𑆴𑆫𑆧𑆴𑆬𑇀𑆮𑆾𑇁𑆓𑇀𑆤𑆴𑆑𑆾 𑆢𑆤𑇀𑆠𑆵 𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆲𑆪𑆩𑆳𑆫𑆑𑆂 𑇅 𑆑𑆥𑆾𑆠𑆑𑆕𑇀𑆑𑆓𑆸𑆣𑇀𑆫𑆳𑆟𑆳𑆁 𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆖 𑆢𑆳𑆫𑆟𑆩𑇀 𑇅 𑆑𑇀𑆰𑆳𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆮𑆳 𑆪𑆳𑆤𑆴 𑆑𑇀𑆰𑆳𑆫𑆾 𑆮𑆳 𑆢𑆳𑆫𑆟𑆁 𑆥𑆫𑆩𑇀 𑇆𑇑𑇐𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆬𑆳𑆤𑆴 𑆥𑇀𑆫𑆥𑆵𑆝𑆤𑆩𑇀 𑇅 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆩𑆳𑆰𑆳𑆟𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆖 𑆱𑆩𑆳𑆱𑆠𑆂 𑇆𑇑𑇑𑇆
𑆯𑆳𑆕𑇀𑆒𑆴𑆤𑇀𑆪𑆕𑇀𑆑𑆾𑆜𑆱𑆶𑆩𑆤𑆂𑆑𑆫𑆮𑆵𑆫𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆂 𑇅 𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆑𑆰𑆳𑆪𑆳𑆟𑆴 𑆮𑆫𑇀𑆓𑆯𑇀𑆖𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆂 𑇆𑇑𑇒𑇆
𑆃𑆘𑆓𑆤𑇀𑆣𑆳𑇁𑆘𑆯𑆸𑆕𑇀𑆓𑆵 𑆖 𑆓𑆮𑆳𑆑𑇀𑆰𑆵 𑆬𑆳𑆕𑇀𑆓𑆬𑆳𑆲𑇀𑆮𑆪𑆳 𑇅 𑆥𑆷𑆠𑆵𑆑𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆂 𑆥𑆳𑆜𑆳 𑆮𑆴𑆝𑆕𑇀𑆓𑆽𑆬𑆳𑆲𑆫𑆼𑆟𑆮𑆂 𑇆𑇑𑇓𑇆
𑆑𑆛𑆶𑆠𑇀𑆫𑆴𑆑𑆁 𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆾 𑆬𑆮𑆟𑆳𑆤𑆴 𑆩𑆤𑆂𑆯𑆴𑆬𑆳 𑇅 𑆑𑆳𑆱𑆵𑆱𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳 𑆢𑆤𑇀𑆠𑆵 𑆲𑆫𑆴𑆠𑆳𑆬𑆁 𑆱𑆶𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆘𑆳 𑇆𑇑𑇔𑇆
𑆃𑆫𑇀𑆑𑆾𑆠𑇀𑆠𑆩𑆳𑆁 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆑𑇀𑆰𑆳𑆫𑆾𑆠𑇀𑆠𑆩𑆳𑆤𑆴 𑆖 𑇅 𑆘𑆳𑆠𑆵𑆩𑆷𑆬𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆢𑇀𑆮𑆼 𑆑𑆳𑆱𑆵𑆱𑆁 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆩𑇀 𑇆𑇑𑇖𑇆
𑆧𑆸𑆲𑆠𑆵 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆵 𑆖 𑆲𑆫𑆴𑆠𑆳𑆬𑆁 𑆩𑆤𑆂𑆯𑆴𑆬𑆳 𑇅 𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆖 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆠𑆽𑆬𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆯𑆾𑆣𑆤𑆼 𑇆𑇑𑇘𑇆
𑆑𑆳𑆱𑆵𑆱𑆼 𑆱𑆽𑆤𑇀𑆣𑆮𑆼 𑆑𑆴𑆟𑇀𑆮𑆼 𑆮𑆖𑆳𑆪𑆳𑆁 𑆫𑆘𑆤𑆵𑆢𑇀𑆮𑆪𑆼 𑇅 𑆯𑆾𑆣𑆤𑆳𑆕𑇀𑆓𑆼𑆰𑆶 𑆖𑆳𑆤𑇀𑆪𑆼𑆰𑆶 𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆯𑆾𑆣𑆤𑆩𑇀 𑇆𑇑𑇙𑇆
𑆱𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆱𑆳𑆫𑆼𑆰𑆶 𑆥𑆛𑆾𑆬𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆱𑆶 𑆖 𑇅 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳 𑆮𑆴𑆣𑆳𑆠𑆮𑇀𑆪𑆳 𑆯𑆾𑆣𑆤𑆵 𑆯𑆾𑆣𑆤𑆼𑆰𑆶 𑆖 𑇆𑇒𑇐𑇆
𑆯𑇀𑆫𑆵𑆮𑆼𑆰𑇀𑆛𑆑𑆼 𑆱𑆫𑇀𑆘𑆫𑆱𑆼 𑆱𑆫𑆬𑆼 𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆟𑆴 𑇅 𑆱𑆳𑆫𑆼𑆰𑇀𑆮𑆥𑆴 𑆖 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆮𑇀𑆫𑆟𑆣𑆷𑆥𑆤𑆩𑇀 𑇆𑇒𑇑𑇆
𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆩𑆤𑆶𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆮𑆸𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆠𑇀𑆮𑆑𑇀𑆰𑆶 𑆱𑆳𑆣𑆴𑆠𑆂 𑇅 𑆯𑆸𑆠𑆂 𑆯𑆵𑆠𑆑𑆰𑆳𑆪𑆾 𑆮𑆳 𑆫𑆾𑆥𑆟𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇒𑇒𑇆
𑆱𑆾𑆩𑆳𑆩𑆸𑆠𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆱𑆶 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆿 𑆓𑆟𑆼 𑆠𑆡𑆳 𑇅 𑆑𑇀𑆰𑆵𑆫𑆴𑆥𑇀𑆫𑆫𑆾𑆲𑆼𑆰𑇀𑆮𑆥𑆴 𑆖 𑆮𑆫𑇀𑆠𑆪𑆾 𑆫𑆾𑆥𑆟𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇒𑇓𑇆
𑆱𑆩𑆕𑇀𑆓𑆳 𑆱𑆾𑆩𑆱𑆫𑆬𑆳 𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆂 𑆱𑆖𑆤𑇀𑆢𑆤𑆂 𑇅 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆯𑇀𑆖 𑆑𑆬𑇀𑆑𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆾 𑆮𑇀𑆫𑆟𑆫𑆾𑆥𑆟𑆼 𑇆𑇒𑇔𑇆
𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳 𑆖 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆩𑆳𑆬𑆠𑆵 𑆱𑆴𑆠𑆳 𑇅 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆯𑇀𑆖 𑆪𑆾𑆘𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆘𑆳 𑆫𑆾𑆥𑆟𑆼 𑆔𑆸𑆠𑆼 𑇆𑇒𑇕𑇆
𑆑𑆳𑆬𑆳𑆤𑆶𑆱𑆳𑆫𑇀𑆪𑆳𑆓𑆶𑆫𑆶𑆟𑆵 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖 𑇅 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆮𑆯𑇀𑆖 𑆫𑆾𑆣𑇀𑆫𑆁 𑆖 𑆠𑆽𑆬𑆼 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆫𑆾𑆥𑆟𑆼 𑇆𑇒𑇖𑇆
𑆑𑆕𑇀𑆓𑆶𑆑𑆳 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆫𑆾𑆣𑇀𑆫𑆁 𑆑𑆳𑆱𑆵𑆱𑆁 𑆯𑇀𑆫𑆮𑆟𑆳𑆲𑇀𑆮𑆪𑆳 𑇅 𑆣𑆮𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆪𑆾𑆱𑇀𑆠𑇀𑆮𑆑𑇀 𑆖 𑆫𑆾𑆥𑆟𑆁 𑆖𑆷𑆫𑇀𑆟𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇒𑇗𑇆
𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆑𑆳 𑆱𑆫𑇀𑆘𑆫𑆱𑆂 𑆥𑆶𑆰𑇀𑆥𑆑𑆳𑆱𑆵𑆱𑆩𑆼𑆮 𑆖 𑇅 𑆠𑇀𑆮𑆑𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆣𑆮𑆘𑆁 𑆖𑆽𑆮 𑆫𑆾𑆥𑆟𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇒𑇘𑇆
𑆠𑇀𑆮𑆑𑇀𑆰𑆶 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆮𑆫𑇀𑆓𑆱𑇀𑆪 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆫𑆾𑆥𑆟𑆳𑆫𑇀𑆡𑆼 𑆮𑆴𑆢𑆣𑆵𑆠 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇆𑇒𑇙𑇆
𑆃𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆾𑇁𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳 𑆖 𑆠𑆳𑆬𑆥𑆠𑇀𑆫𑆵 𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳 𑇅 𑆇𑆠𑇀𑆱𑆳𑆢𑆤𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆯𑇀𑆖 𑆪𑆾 𑆓𑆟𑆂 𑇆𑇓𑇐𑇆
𑆑𑆳𑆱𑆵𑆱𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆑𑆴𑆟𑇀𑆮𑆁 𑆑𑆶𑆫𑆶𑆮𑆴𑆤𑇀𑆢𑆾 𑆩𑆤𑆂𑆯𑆴𑆬𑆳 𑇅 𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆳𑆟𑇀𑆝𑆑𑆥𑆳𑆬𑆳𑆤𑆴 𑆱𑆶𑆩𑆤𑆾𑆩𑆶𑆑𑆶𑆬𑆳𑆤𑆴 𑆖 𑇆𑇓𑇑𑇆
𑆦𑆬𑆼 𑆯𑆽𑆫𑆵𑆰𑆑𑆳𑆫𑆚𑇀𑆘𑆼 𑆣𑆳𑆠𑆶𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆪𑆳𑆤𑆴 𑆖 𑇅 𑆮𑇀𑆫𑆟𑆼𑆰𑆷𑆠𑇀𑆱𑆤𑇀𑆤𑆩𑆳𑆁𑆱𑆼𑆰𑆶 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆤𑇀𑆪𑆮𑆱𑆳𑆢𑆤𑆼 𑇆𑇓𑇒𑇆
𑆱𑆩𑆱𑇀𑆠𑆁 𑆮𑆫𑇀𑆓𑆩𑆫𑇀𑆣𑆁 𑆮𑆳 𑆪𑆡𑆳𑆬𑆳𑆨𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇅 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆨𑆴𑆰𑆑𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆼𑆰𑆶 𑆑𑆫𑇀𑆩𑆱𑆶 𑇆𑇓𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆩𑆳𑆱𑆼𑆤 𑆱𑆥𑇀𑆠𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳 𑆮𑆴𑆢𑆳𑆫𑆵 𑆮𑆴𑆯𑇀𑆮𑆢𑆼𑆮𑆳 𑆱𑆲𑆢𑆼𑆮𑆳 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑆵 𑆯𑆠𑆳𑆮𑆫𑆵 𑆱𑆳𑆫𑆴𑆮𑆳 𑆑𑆸𑆰𑇀𑆟𑆱𑆳𑆫𑆴𑆮𑆳 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆩𑆲𑆳𑆱𑆲𑆳 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆱𑆲𑆳 𑆧𑆸𑆲𑆠𑇀𑆪𑆿 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆽𑆫𑆟𑇀𑆝𑆾 𑆲𑆁𑆱𑆥𑆳𑆢𑆵 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆬𑇀𑆪𑆸𑆰𑆨𑆵 𑆖𑆼𑆠𑆴 𑇆𑇔𑇆
𑆮𑆴𑆢𑆳𑆫𑆵𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆫𑆪𑆁 𑆓𑆟𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇅 𑆯𑆾𑆰𑆓𑆶𑆬𑇀𑆩𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾𑆫𑇀𑆣𑇀𑆮𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇆𑇕𑇆
𑆄𑆫𑆓𑇀𑆮𑆣𑆩𑆢𑆤𑆓𑆾𑆥𑆔𑆾𑆟𑇀𑆛𑆳𑆑𑆟𑇀𑆛𑆑𑆵𑆑𑆶𑆛𑆘𑆥𑆳𑆜𑆳𑆥𑆳𑆛𑆬𑆳𑆩𑆷𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆤𑆴𑆩𑇀𑆧𑆑𑆶𑆫𑆶𑆟𑇀𑆛𑆑𑆢𑆳𑆱𑆵𑆑𑆶𑆫𑆶𑆟𑇀𑆛𑆑- 𑆓𑆶𑆝𑆷𑆖𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆳𑆫𑇀𑆕𑇀𑆓(𑆫𑇀𑆕𑇀𑆓𑆼)𑆰𑇀𑆛𑆳𑆑𑆫𑆚𑇀𑆘𑆢𑇀𑆮𑆪𑆥𑆛𑆾𑆬𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆤𑆴 𑆱𑆶𑆰𑆮𑆵 𑆖𑆼𑆠𑆴 𑇆𑇖𑇆
𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆫𑆴𑆠𑇀𑆪𑆼𑆰 𑆓𑆟𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆰𑆳𑆥𑆲𑆂 𑇅 𑆩𑆼𑆲𑆑𑆶𑆰𑇀𑆜𑆘𑇀𑆮𑆫𑆮𑆩𑆵𑆑𑆟𑇀𑆝𑆷𑆔𑇀𑆤𑆾 𑆮𑇀𑆫𑆟𑆯𑆾𑆣𑆤𑆂 𑇆𑇗𑇆
𑆱𑆳𑆬𑆱𑆳𑆫𑆳𑆘𑆑𑆫𑇀𑆟𑆒𑆢𑆴𑆫𑆑𑆢𑆫𑆑𑆳𑆬𑆱𑇀𑆑𑆤𑇀𑆣𑆑𑇀𑆫𑆩𑆶𑆑𑆨𑆷𑆫𑇀𑆘𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆠𑆴𑆤𑆴𑆯𑆖𑆤𑇀𑆢𑆤𑆑𑆶𑆖𑆤𑇀𑆢𑆤𑆯𑆴𑆁𑆯𑆥𑆳- 𑆯𑆴𑆫𑆵𑆰𑆳𑆱𑆤𑆣𑆮𑆳𑆫𑇀𑆘𑆶𑆤𑆠𑆳𑆬𑆯𑆳𑆑𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆥𑆷𑆠𑆵𑆑𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆳𑆓𑆶𑆫𑆷𑆟𑆴 𑆑𑆳𑆬𑆵𑆪𑆑𑆁 𑆖𑆼𑆠𑆴 𑇆𑇘𑇆
𑆱𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆫𑆴𑆠𑇀𑆪𑆼𑆰 𑆓𑆟𑆂 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇅 𑆩𑆼𑆲𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆲𑆫𑆂 𑆑𑆦𑆩𑆼𑆢𑆾𑆮𑆴𑆯𑆾𑆰𑆟𑆂 𑇆𑇙𑇆
𑆮𑆫𑆶𑆟𑆳𑆫𑇀𑆠𑆓𑆬𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆠𑆫𑇀𑆑𑆳𑆫𑆵𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵𑆥𑆷𑆠𑆵𑆑𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆩𑆾𑆫𑆛𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆱𑆽𑆫𑆼𑆪𑆑𑆢𑇀𑆮𑆪𑆧𑆴𑆩𑇀𑆧𑆵𑆮𑆱𑆶𑆑𑆮𑆱𑆴𑆫𑆖𑆴𑆠𑇀𑆫𑆑- 𑆯𑆠𑆳𑆮𑆫𑆵𑆧𑆴𑆬𑇀𑆮𑆳𑆘𑆯𑆸𑆕𑇀𑆓𑆵𑆢𑆫𑇀𑆨𑆳 𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇐𑇆
𑆮𑆫𑆶𑆟𑆳𑆢𑆴𑆫𑇀𑆓𑆟𑆾 𑆲𑇀𑆪𑆼𑆰 𑆑𑆦𑆩𑆼𑆢𑆾𑆤𑆴𑆮𑆳𑆫𑆟𑆂 𑇅 𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆯𑆴𑆫𑆂𑆯𑆷𑆬𑆓𑆶𑆬𑇀𑆩𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆮𑆴𑆢𑇀𑆫𑆣𑆵𑆤𑇀 𑇆𑇑𑇑𑇆
𑆮𑆵𑆫𑆠𑆫𑆶𑆱𑆲𑆖𑆫𑆢𑇀𑆮𑆪𑆢𑆫𑇀𑆨𑆮𑆸𑆑𑇀𑆰𑆳𑆢𑆤𑆵𑆓𑆶𑆤𑇀𑆢𑇀𑆫𑆳𑆤𑆬𑆑𑆶𑆯𑆑𑆳𑆯𑆳𑆯𑇀𑆩𑆨𑆼𑆢𑆑𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆩𑆾𑆫𑆛𑆳𑆮𑆱𑆶𑆑𑆮𑆱𑆴𑆫𑆨𑆬𑇀𑆬𑆷𑆑𑆑𑆶𑆫𑆟𑇀𑆛𑆴𑆑𑆼𑆤𑇀𑆢𑆵𑆮𑆫𑆑𑆥𑆾𑆠𑆮𑆕𑇀𑆑𑆳𑆂 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆖𑆼𑆠𑆴 𑇆𑇑𑇒𑇆
𑆮𑆵𑆫𑆠𑆫𑇀𑆮𑆳𑆢𑆴𑆫𑆴𑆠𑇀𑆪𑆼𑆰 𑆓𑆟𑆾 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀 𑇅 𑆃𑆯𑇀𑆩𑆫𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆔𑆳𑆠𑆫𑆶𑆘𑆳𑆥𑆲𑆂 𑇆𑇑𑇓𑇆
𑆬𑆾𑆣𑇀𑆫𑆱𑆳𑆮𑆫𑆬𑆾𑆣𑇀𑆫𑆥𑆬𑆳𑆯𑆑𑆶𑆛𑆤𑇀𑆤𑆛𑆳𑆯𑆾𑆑𑆦𑆚𑇀𑆘𑆵𑆑𑆛𑇀𑆦𑆬𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆯𑆬𑇀𑆬𑆑𑆵𑆘𑆴𑆕𑇀𑆓𑆴𑆤𑆵𑆑𑆢𑆩𑇀𑆧𑆱𑆳𑆬𑆳𑆂 𑆑𑆢𑆬𑆵 𑆖𑆼𑆠𑆴 𑇆𑇑𑇔𑇆
𑆍𑆰 𑆫𑆾𑆣𑇀𑆫𑆳𑆢𑆴𑆫𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆾 𑆩𑆼𑆢𑆂𑆑𑆦𑆲𑆫𑆾 𑆓𑆟𑆂 𑇅 𑆪𑆾𑆤𑆴𑆢𑆾𑆰𑆲𑆫𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆵 𑆮𑆫𑇀𑆟𑇀𑆪𑆾 𑆮𑆴𑆰𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇆𑇑𑇕𑇆

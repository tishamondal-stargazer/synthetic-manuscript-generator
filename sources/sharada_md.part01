𑆮𑆖𑆳𑆤𑆳𑆓𑆫𑆯𑆛𑇀𑆪𑆼𑆬𑆳 𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆼𑆤 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆳𑆂𑇅 𑆥𑆼𑆪𑆳𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆪𑆳 𑆮𑆳 𑆱𑇀𑆪𑆶𑆫𑆫𑆴𑆰𑇀𑆛𑆼𑆤𑆳𑆱𑆮𑆼𑆤 𑆮𑆳𑇆𑇑𑇘𑇆
𑆢𑆳𑆫𑆶 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆁 𑆥𑆡𑇀𑆪𑆳𑆁 𑆥𑆬𑆳𑆯𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆁 𑆯𑆛𑆵𑆩𑇀𑇅 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆢𑆵𑆥𑆤𑆳𑆤𑇀𑇆𑇑𑇙𑇆
𑆧𑆱𑇀𑆠𑆴𑆩𑆱𑇀𑆪 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆖 𑆱𑆩𑆷𑆠𑇀𑆫𑆁 𑆢𑆳𑆯𑆩𑆷𑆬𑆴𑆑𑆩𑇀𑇅 𑆱𑆩𑆷𑆠𑇀𑆫𑆩𑆡𑆮𑆳 𑆮𑇀𑆪𑆑𑇀𑆠𑆬𑆮𑆟𑆁 𑆩𑆳𑆣𑆶𑆠𑆽𑆬𑆴𑆑𑆩𑇀𑇆𑇒𑇐𑇆
𑆃𑆬𑇀𑆥𑆮𑆵𑆫𑇀𑆪𑆾 𑆩𑆲𑆳𑆢𑆾𑆰𑆼 𑆫𑆷𑆑𑇀𑆰𑆼 𑆑𑇀𑆫𑆷𑆫𑆳𑆯𑆪𑆼 𑆑𑆸𑆠𑆂𑇅 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆢𑆾𑆰𑆳𑆮𑆸𑆠𑆾 𑆫𑆶𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆾 𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆠𑇀 𑆱𑆩𑆵𑆫𑆟𑆩𑇀𑇆𑇒𑇑𑇆
𑆱 𑆮𑆴𑆩𑆳𑆫𑇀𑆓𑆾𑇁𑆤𑆴𑆬𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆩𑆫𑇀𑆩𑆥𑆵𑆝𑆤𑆩𑇀𑇅 𑆮𑆴𑆢𑆳𑆲𑆁 𑆓𑆶𑆫𑆶𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆩𑆶𑆰𑇀𑆑𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆮𑆼𑆢𑆤𑆳𑆩𑇀𑇆𑇒𑇒𑇆
𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆲𑆸𑆢𑆪𑆁 𑆯𑆷𑆬𑆽𑆫𑆴𑆠𑆯𑇀𑆖𑆼𑆠𑆯𑇀𑆖 𑆣𑆳𑆮𑆠𑆴𑇅 𑆯𑇀𑆪𑆳𑆩𑆳𑆦𑆬𑆳𑆢𑆴𑆨𑆴𑆂 𑆑𑆶𑆰𑇀𑆜𑆑𑆸𑆰𑇀𑆟𑆳𑆬𑆮𑆟𑆱𑆫𑇀𑆰𑆥𑆽𑆂𑇆𑇒𑇓𑇆
𑆣𑆷𑆩𑆩𑆳𑆰𑆮𑆖𑆳𑆑𑆴𑆟𑇀𑆮𑆑𑇀𑆰𑆳𑆫𑆖𑆷𑆫𑇀𑆟𑆓𑆶𑆝𑆽𑆂 𑆑𑆸𑆠𑆳𑆩𑇀𑇅 𑆑𑆫𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆤𑆴𑆨𑆳𑆁 𑆮𑆫𑇀𑆠𑆴𑆁 𑆪𑆮𑆩𑆣𑇀𑆪𑆳𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇒𑇔𑇆
𑆃𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆠𑆽𑆬𑆳𑆑𑇀𑆠𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆴𑆠𑆼 𑆓𑆶𑆢𑆼𑇅 𑆃𑆡𑆮𑆳 𑆬𑆮𑆟𑆳𑆓𑆳𑆫𑆣𑆷𑆩𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆽𑆂 𑆑𑆸𑆠𑆳𑆩𑇀𑇆𑇒𑇕𑇆
𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆤𑆳 𑆤𑆴𑆫𑆷𑆲𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆵𑆬𑆶𑆱𑆫𑇀𑆰𑆥𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆤𑇀𑇅 𑆱𑆫𑆬𑆳𑆩𑆫𑆢𑆳𑆫𑆶𑆨𑇀𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖𑆽𑆮𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇆𑇒𑇖𑇆
𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆼𑇁𑆧𑆬𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑇁𑆠𑆴𑆤𑆴𑆫𑇀𑆲𑆫𑆤𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆣𑆴𑆑𑇀𑆑𑆳𑆁, 𑆲𑆴𑆠𑆁 𑆠𑆱𑇀𑆩𑆽 𑆲𑆴𑆑𑇀𑆑𑆳𑆔𑇀𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆖 𑆪𑆠𑇀𑇆𑇒𑇗𑇆
𑆧𑆬𑆳𑆱𑇀𑆡𑆴𑆫𑆳𑆢𑆴𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆓𑆶𑆝𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂𑇅 𑆱𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆳𑆫𑆤𑆳𑆬𑆳𑆩𑇀𑆬𑆽𑆱𑇀𑆠𑆽𑆬𑆁 𑆥𑆑𑇀𑆠𑇀𑆮𑆳𑇁𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀𑇆𑇒𑇘𑇆
𑆑𑆸𑆰𑇀𑆟𑆳𑆬𑆮𑆟𑆪𑆾𑆫𑆑𑇀𑆰𑆁 𑆥𑆴𑆧𑆼𑆢𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆪𑆶𑆠𑆩𑇀 𑇅 𑆣𑆷𑆩𑆬𑆼𑆲𑆫𑆱𑆑𑇀𑆰𑆵𑆫𑆱𑇀𑆮𑆼𑆢𑆳𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆁 𑆖 𑆮𑆳𑆠𑆤𑆶𑆠𑇀𑇆𑇒𑇙𑇆
𑆃𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆱𑆮𑆳𑆠𑆾 𑆮𑆳 𑆤 𑆮𑆳 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆂𑇅 𑆔𑆛𑇀𑆛𑆪𑆼𑆢𑇀𑆣𑆸𑆢𑆪𑆁 𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆠𑆠𑇀𑆫 𑆑𑆳𑆯𑆑𑆶𑆯𑆼𑆠𑇀𑆑𑆛𑆽𑆂𑇆𑇓𑇐𑇆
𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆱𑇀𑆑𑆤𑇀𑆣𑆑𑆫𑆵𑆫𑆧𑆢𑆫𑆵𑆦𑆬𑆽𑆂𑇅 𑆯𑆸𑆠𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆲𑆴𑆠𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳𑆠𑆔𑇀𑆤𑆽𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇆𑇓𑇑𑇆
𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆳𑆁 𑆢𑆠𑇀𑆠𑆼 𑆮𑆼𑆓𑆳𑆤𑇀𑆤𑆴𑆓𑆸𑆲𑇀𑆟𑆠𑆂𑇅 𑆃𑆠𑆴 𑆮𑆳 𑆥𑆵𑆝𑆴𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆩𑆶𑆒𑆼𑆤𑆳𑆪𑆳𑆠𑆴 𑆮𑆼𑆓𑆮𑆳𑆤𑇀𑇆𑇓𑇒𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆮𑆴𑆑𑆳𑆫𑆁 𑆠𑆱𑇀𑆪𑆳𑆢𑆿 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆩𑆶𑆒𑆩𑇀𑇅 𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆁 𑆖𑆳𑆣𑆂 𑆥𑇀𑆫𑆩𑆸𑆘𑇀𑆪𑆳𑆢𑇀𑆮𑆵𑆘𑆪𑆼𑆖𑇀𑆖 𑆠𑆩𑇀𑇆𑇓𑇓𑇆
𑆑𑆼𑆯𑆼𑆰𑇀𑆮𑆳𑆬𑆩𑇀𑆧𑇀𑆪 𑆖𑆳𑆑𑆳𑆯𑆼 𑆣𑆶𑆤𑆶𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆳𑆱𑆪𑆼𑆖𑇀𑆖 𑆠𑆩𑇀𑇅 𑆓𑆾𑆒𑆫𑆳𑆯𑇀𑆮𑆓𑆘𑆽𑆂 𑆱𑆴𑆁𑆲𑆽 𑆫𑆳𑆘𑆥𑇀𑆫𑆼𑆰𑇀𑆪𑆽𑆱𑇀𑆠𑆡𑆾𑆫𑆓𑆽𑆂𑇆𑇓𑇔𑇆
𑆇𑆬𑇀𑆑𑆳𑆨𑆴𑆫𑆼𑆮𑆩𑆤𑇀𑆪𑆽𑆯𑇀𑆖 𑆨𑆵𑆠𑆱𑇀𑆪𑆳𑆣𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆮𑆱𑇀𑆠𑇀𑆫𑆥𑆳𑆟𑆴𑆓𑇀𑆫𑆲𑆽𑆂 𑆑𑆟𑇀𑆜𑆁 𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑇀𑆤 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆪𑆡𑆳𑇆𑇓𑇕𑇆
𑆥𑇀𑆫𑆳𑆟𑆾𑆢𑆳𑆤𑆤𑆴𑆫𑆾𑆣𑆳𑆢𑇀𑆣𑆴 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆠𑆫𑆩𑆳𑆫𑇀𑆓𑆮𑆳𑆤𑇀 𑇅 𑆃𑆥𑆳𑆤𑆂 𑆥𑆮𑆤𑆾 𑆧𑆱𑇀𑆠𑆴𑆁 𑆠𑆩𑆳𑆯𑇀𑆮𑆼𑆮𑆳𑆥𑆑𑆫𑇀𑆰𑆠𑆴𑇆𑇓𑇖𑇆
𑆠𑆠𑆂 𑆑𑇀𑆫𑆩𑆶𑆑𑆑𑆬𑇀𑆑𑆳𑆑𑇀𑆰𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑆳𑆩𑇀𑆬𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆐𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆧𑆱𑇀𑆠𑆴𑆁 𑆱𑆾𑇁𑆱𑇀𑆪𑆳𑆤𑆶𑆬𑆾𑆩𑆪𑆼𑆠𑇀𑇆𑇓𑇗𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆴𑆠𑆼 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆤𑆴𑆫𑆷𑆲𑆾 𑆢𑆳𑆯𑆩𑆷𑆬𑆴𑆑𑆂𑇅 𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆽𑆯𑇀𑆖 𑆮𑆴𑆣𑆼𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆱𑆳𑆣𑆴𑆠𑆂𑇆𑇓𑇘𑇆
𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆼𑆤 𑆱𑆴𑆢𑇀𑆣𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆫𑆂𑆱𑇀𑆡𑆴𑆠𑆼𑇅 𑆯𑆴𑆫𑆂𑆱𑇀𑆡𑆼 𑆤𑆳𑆮𑆤𑆁 𑆣𑆷𑆩𑆂 𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆢𑇀𑆪𑆁 𑆱𑆫𑇀𑆰𑆥𑆽𑆂 𑆯𑆴𑆫𑆂𑇆𑇓𑇙𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆩𑆲𑆳𑆢𑆾𑆰𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆩𑆸𑆢𑇀𑆮𑆬𑇀𑆥𑆨𑆼𑆰𑆘𑆂𑇅 𑆇𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪𑆳𑆬𑇀𑆥𑆁 𑆲𑆫𑆼𑆢𑇀𑆢𑆾𑆰𑆁 𑆘𑆤𑆪𑆼𑆖𑇀𑆖 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆩𑇀𑇆𑇔𑇐𑇆
𑆱 𑆧𑆱𑇀𑆠𑆴𑆥𑆳𑆪𑆶𑆯𑆾𑆦𑆼𑆤 𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆱𑆢𑆤𑆼𑆤 𑆮𑆳𑇅 𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆳𑆫𑆶𑆠𑆾 𑆘𑆤𑇀𑆠𑆶𑆫𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆳𑆲𑆠𑆼𑇆𑇔𑇑𑇆
𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑇀𑆤𑆴𑆫𑆷𑆲𑆳𑆁𑆯𑇀𑆖 𑆯𑆾𑆣𑆤𑆵𑆪𑆳𑆤𑆶𑆬𑆾𑆩𑆴𑆑𑆳𑆤𑇀𑇅 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆬𑇀𑆬𑆕𑇀𑆔𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆮𑆠𑇀𑇆𑇔𑇒𑇆
𑆢𑆶𑆫𑇀𑆧𑆬𑆼 𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆼 𑆖 𑆠𑆵𑆮𑇀𑆫𑆢𑆾𑆰𑆼 𑆠𑆤𑆶𑆫𑇀𑆩𑆸𑆢𑆶𑆂𑇅 𑆯𑆵𑆠𑆾𑇁𑆬𑇀𑆥𑆯𑇀𑆖𑆳𑆮𑆸𑆠𑆾 𑆢𑆾𑆰𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆲𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇔𑇓𑇆

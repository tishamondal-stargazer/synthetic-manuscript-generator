𑆢𑆸𑆯𑇀𑆪𑆠𑆼𑇁𑆘𑆓𑆫𑆵 𑆤𑆴𑆠𑇀𑆪𑆁 𑆓𑆾𑆤𑆱𑆵 𑆖𑆳𑆩𑇀𑆧𑆶𑆢𑆳𑆓𑆩𑆼 𑇅 𑆑𑆳𑆯𑇀𑆩𑆵𑆫𑆼𑆰𑆶 𑆱𑆫𑆾 𑆢𑆴𑆮𑇀𑆪𑆁 𑆤𑆳𑆩𑇀𑆤𑆳 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆩𑆳𑆤𑆱𑆩𑇀 𑇆𑇓𑇒𑇆
𑆑𑆫𑆼𑆟𑆶𑆱𑇀𑆠𑆠𑇀𑆫 𑆑𑆤𑇀𑆪𑆳 𑆖 𑆗𑆠𑇀𑆫𑆳𑆠𑆴𑆖𑇀𑆗𑆠𑇀𑆫𑆑𑆼 𑆠𑆡𑆳 𑇅 𑆓𑆾𑆬𑆾𑆩𑆵 𑆖𑆳𑆘𑆬𑆾𑆩𑆵 𑆖 𑆩𑆲𑆠𑆵 𑆯𑇀𑆫𑆳𑆮𑆟𑆵 𑆠𑆡𑆳 𑇆𑇓𑇓𑇆
𑆮𑆱𑆤𑇀𑆠𑆼 𑆑𑆸𑆰𑇀𑆟𑆱𑆫𑇀𑆥𑆳𑆒𑇀𑆪𑆳 𑆓𑆾𑆤𑆱𑆵 𑆖 𑆥𑇀𑆫𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑇅 𑆑𑆿𑆯𑆴𑆑𑆵𑆁 𑆱𑆫𑆴𑆠𑆁 𑆠𑆵𑆫𑇀𑆠𑇀𑆮𑆳 𑆱𑆚𑇀𑆘𑆪𑆤𑇀𑆠𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆠𑆂 𑇆𑇓𑇔𑇆
𑆑𑇀𑆰𑆴𑆠𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆾 𑆮𑆬𑇀𑆩𑆵𑆑𑆽𑆫𑆳𑆖𑆴𑆠𑆾 𑆪𑆾𑆘𑆤𑆠𑇀𑆫𑆪𑆩𑇀 𑇅 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆠𑆠𑇀𑆫 𑆑𑆳𑆥𑆾𑆠𑆵 𑆯𑇀𑆮𑆼𑆠𑆳 𑆮𑆬𑇀𑆩𑆵𑆑𑆩𑆷𑆫𑇀𑆣𑆱𑆶 𑇆𑇓𑇕𑇆
𑆩𑆬𑆪𑆼 𑆤𑆬𑆱𑆼𑆠𑆿 𑆖 𑆮𑆼𑆓𑆮𑆠𑇀𑆪𑆿𑆰𑆣𑆵 𑆣𑇀𑆫𑆶𑆮𑆳 𑇅 𑆑𑆳𑆫𑇀𑆠𑆴𑆑𑇀𑆪𑆳𑆁 𑆥𑆿𑆫𑇀𑆟𑆩𑆳𑆱𑇀𑆪𑆳𑆁 𑆖 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑆠𑆳𑆩𑆶𑆥𑆾𑆰𑆴𑆠𑆂 𑇆𑇓𑇖𑇆
𑆱𑆾𑆩𑆮𑆖𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆫𑇀𑆠𑆼𑆠 𑆦𑆬𑆁 𑆠𑆳𑆮𑆖𑇀𑆖 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆱𑆫𑇀𑆮𑆳 𑆮𑆴𑆖𑆼𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆾𑆰𑆣𑇀𑆪𑆂 𑆱𑆾𑆩𑆳𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆼 𑆓𑆴𑆫𑆿 𑇆𑇓𑇗𑇆
𑆱 𑆯𑆸𑆕𑇀𑆓𑆽𑆫𑇀𑆢𑆼𑆮𑆖𑆫𑆴𑆠𑆽𑆫𑆩𑇀𑆧𑆶𑆢𑆳𑆤𑆵𑆑𑆨𑆼𑆢𑆴𑆨𑆴𑆂 𑇅 𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆱𑇀𑆠𑆵𑆫𑇀𑆡𑆽𑆯𑇀𑆖 𑆮𑆴𑆒𑇀𑆪𑆳𑆠𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆫𑇀𑆰𑆴𑆱𑆶𑆫𑆱𑆼𑆮𑆴𑆠𑆽𑆂 𑇆𑇓𑇘𑇆
𑆓𑆶𑆲𑆳𑆨𑆴𑆫𑇀𑆨𑆵𑆩𑆫𑆷𑆥𑆳𑆨𑆴𑆂 𑆱𑆴𑆁𑆲𑆾𑆤𑇀𑆤𑆳𑆢𑆴𑆠𑆑𑆶𑆑𑇀𑆰𑆴𑆨𑆴𑆂 𑇅 𑆓𑆘𑆳𑆬𑆾𑆝𑆴𑆠𑆠𑆾𑆪𑆳𑆨𑆴𑆫𑆳𑆥𑆓𑆳𑆨𑆴𑆂 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑇅 𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑇀𑆣𑆳𑆠𑆶𑆨𑆴𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆽𑆂 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆽𑆮𑆾𑆥𑆯𑆾𑆨𑆴𑆠𑆂 𑇆𑇓𑇙𑇆
𑆤𑆢𑆵𑆰𑆶 𑆯𑆽𑆬𑆼𑆰𑆶 𑆱𑆫𑆂𑆱𑆶 𑆖𑆳𑆥𑆴 𑆥𑆶𑆟𑇀𑆪𑆼𑆰𑇀𑆮𑆫𑆟𑇀𑆪𑆼𑆰𑆶 𑆠𑆡𑆳𑇁𑇁𑆯𑇀𑆫𑆩𑆼𑆰𑆶 𑇅 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆳𑆂 𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆓𑆴𑆠𑆮𑇀𑆪𑆳𑆂 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆨𑆷𑆩𑆴𑆫𑇀𑆲𑆴 𑆮𑆱𑆷𑆤𑆴 𑆣𑆠𑇀𑆠𑆼 𑇆𑇔𑇐𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆪𑆿𑆓𑆴𑆑𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑆳𑆫𑆾𑇁𑆪𑆁 𑆥𑆶𑆫𑆶𑆰𑆂, 𑆥𑇀𑆫𑆳𑆟𑆳𑆯𑇀𑆖 𑆱𑇀𑆤𑆼𑆲𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑆳𑆣𑇀𑆪𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆱𑇀𑆤𑆼𑆲𑆾 𑆲𑆴 𑆥𑆳𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑆯𑆴𑆫𑆾𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆤𑆱𑇀𑆪𑆑𑆫𑇀𑆟𑆥𑆷𑆫𑆟𑆓𑆳𑆠𑇀𑆫𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆨𑆾𑆘𑆤𑆼𑆰𑆷𑆥𑆪𑆾𑆘𑇀𑆪𑆂 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆴𑆪𑆾𑆤𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆑𑆬𑇀𑆥𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆤𑆼𑆲𑆓𑆶𑆟𑆳𑆯𑇀𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆘𑆕𑇀𑆓𑆩𑆼𑆨𑇀𑆪𑆾 𑆓𑆮𑇀𑆪𑆁 𑆔𑆸𑆠𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆱𑇀𑆡𑆳𑆮𑆫𑆼𑆨𑇀𑆪𑆱𑇀𑆠𑆴𑆬𑆠𑆽𑆬𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆪𑆡𑆳𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁 𑆪𑆡𑆳𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆖 𑆱𑇀𑆡𑆳𑆮𑆫𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆠𑆴𑆬𑇀𑆮𑆑𑆽𑆫𑆟𑇀𑆝𑆑𑆾𑆯𑆳𑆩𑇀𑆫𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆥𑆬𑆳𑆯𑆮𑆴𑆰𑆳𑆟𑆴𑆑𑆳𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆯𑆩𑇀𑆥𑆳𑆑𑆤𑆵𑆬𑆴𑆤𑆵𑆱𑇀𑆤𑆼𑆲𑆳 𑆮𑆴𑆫𑆼𑆖𑆪𑆤𑇀𑆠𑆴, 𑆘𑆵𑆩𑆷𑆠𑆑𑆑𑆶𑆛𑆘𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆩𑆢𑆤𑆱𑇀𑆤𑆼𑆲𑆳 𑆮𑆳𑆩𑆪𑆤𑇀𑆠𑆴, 𑆮𑆴𑆝𑆕𑇀𑆓𑆒𑆫𑆩𑆚𑇀𑆘𑆫𑆵𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆱𑆷𑆫𑇀𑆪𑆮𑆬𑇀𑆬𑆵𑆥𑆵𑆬𑆶𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆯𑆴𑆫𑆾 𑆮𑆴𑆫𑆼𑆖𑆪𑆤𑇀𑆠𑆴, 𑆑𑆫𑆚𑇀𑆘𑆥𑆷𑆠𑆵𑆑𑆑𑆸𑆠𑆩𑆳𑆬𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆱𑇀𑆤𑆼𑆲𑆳 𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆼𑆰𑆷𑆥𑆪𑆶𑆘𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆶𑆮𑆫𑆑𑆑𑆥𑆴𑆠𑇀𑆡𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑆛𑆾𑆬𑆱𑇀𑆤𑆼𑆲𑆳 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶, 𑆠𑇀𑆫𑆥𑆶𑆱𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆑𑆫𑇀𑆑𑆳𑆫𑆶𑆑𑆠𑆶𑆩𑇀𑆧𑆵𑆑𑆷𑆰𑇀𑆩𑆳𑆟𑇀𑆝𑆱𑇀𑆤𑆼𑆲𑆳 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆼𑆰𑆶, 𑆑𑆥𑆾𑆠𑆮𑆕𑇀𑆑𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆲𑆫𑆵𑆠𑆑𑆵𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆰𑆶, 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆳𑆠𑆴𑆩𑆶𑆑𑇀𑆠𑆑𑆨𑆳𑆟𑇀𑆝𑆵𑆑𑆛𑆶𑆠𑆶𑆩𑇀𑆧𑆵𑆑𑆛𑆨𑆵𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆼𑆰𑆶, 𑆠𑆳𑆬𑆤𑆳𑆫𑆴𑆑𑆼𑆬𑆥𑆤𑆱𑆩𑆾𑆖𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆧𑆴𑆬𑇀𑆮𑆩𑆣𑆷𑆑𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆑𑆳𑆩𑇀𑆫𑆳𑆠𑆑𑆦𑆬𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼 𑆮𑆳𑆪𑆿, 𑆧𑆴𑆨𑆵𑆠𑆑𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑆴𑆟𑇀𑆝𑆵𑆠𑆑𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆵𑆑𑆫𑆟𑆼, 𑆯𑇀𑆫𑆮𑆟𑆑𑆕𑇀𑆓𑆶𑆑𑆛𑆶𑆟𑇀𑆛𑆶𑆑𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆥𑆳𑆟𑇀𑆝𑆷𑆑𑆫𑆟𑆼, 𑆱𑆫𑆬𑆥𑆵𑆠𑆢𑆳𑆫𑆶𑆯𑆴𑆁𑆯𑆥𑆳𑆓𑆶𑆫𑆶𑆱𑆳𑆫𑆱𑇀𑆤𑆼𑆲𑆳 𑆢𑆢𑇀𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆑𑆴𑆛𑆴𑆨𑆼𑆰𑆶, 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆱𑇀𑆤𑆼𑆲𑆳 𑆮𑆳𑆠𑆩𑆶𑆥𑆔𑇀𑆤𑆤𑇀𑆠𑆴, 𑆠𑆽𑆬𑆓𑆶𑆟𑆳𑆯𑇀𑆖 𑆱𑆩𑆳𑆱𑆼𑆤 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇕𑇆
𑆥𑆬𑆑𑆶𑆝𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑆠𑆾 𑆩𑆳𑆤𑆁 𑆠𑆶 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆳𑆢𑆯 𑆣𑆳𑆤𑇀𑆪𑆩𑆳𑆰𑆳 𑆩𑆣𑇀𑆪𑆩𑆳𑆂 𑆱𑆶𑆮𑆫𑇀𑆟𑆩𑆳𑆰𑆑𑆂, 𑆠𑆼 𑆰𑆾𑆝𑆯 𑆱𑆶𑆮𑆫𑇀𑆟𑆩𑇀; 𑆃𑆡𑆮𑆳 𑆩𑆣𑇀𑆪𑆩𑆤𑆴𑆰𑇀𑆥𑆳𑆮𑆳 𑆍𑆑𑆾𑆤𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆣𑆫𑆟𑆁, 𑆠𑆳𑆤𑇀𑆪𑆫𑇀𑆣𑆠𑆸𑆠𑆵𑆪𑆳𑆤𑆴 𑆑𑆫𑇀𑆰𑆂; 𑆠𑆠𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆤𑇀𑆠𑆂 𑆥𑆬𑆑𑆶𑆝𑆮𑆥𑇀𑆫𑆱𑇀𑆡𑆳𑆞𑆑𑆢𑇀𑆫𑆾𑆟𑆳 𑆅𑆠𑇀𑆪𑆨𑆴𑆤𑆴𑆰𑇀𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆶𑆬𑆳 𑆥𑆶𑆤𑆂 𑆥𑆬𑆯𑆠𑆁, 𑆠𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆨𑆳𑆫𑆂; 𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆳𑆩𑆴𑆢𑆁 𑆩𑆳𑆤𑆩𑇀, 𑆄𑆫𑇀𑆢𑇀𑆫𑆢𑇀𑆫𑆮𑆳𑆟𑆳𑆁 𑆖 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆩𑆴𑆠𑆴 𑇆𑇗𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆤𑆼𑆲𑆨𑆼𑆰𑆘𑆠𑆾𑆪𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆪𑆠𑇀𑆫 𑆤𑆼𑆫𑆴𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫𑆳𑆪𑆁 𑆮𑆴𑆣𑆴𑆫𑆳𑆱𑇀𑆡𑆼𑆪𑆾 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆼 𑆠𑆢𑇀𑆮𑆢𑆼𑆮 𑆠𑆶 𑇆𑇙𑇆
𑆃𑆤𑆶𑆑𑇀𑆠𑆼 𑆢𑇀𑆫𑆮𑆑𑆳𑆫𑇀𑆪𑆼 𑆠𑆶 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆱𑆬𑆴𑆬𑆁 𑆩𑆠𑆩𑇀 𑇅 𑆑𑆬𑇀𑆑𑆑𑇀𑆮𑆳𑆡𑆳𑆮𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆼 𑆓𑆟𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆑𑆑𑇀𑆫𑆩𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆱 𑆠𑆶 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆸𑆢𑆶𑆂, 𑆩𑆣𑇀𑆪𑆩𑆂, 𑆒𑆫 𑆅𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆼𑆲𑆿𑆰𑆣𑆴𑆮𑆴𑆮𑆼𑆑𑆩𑆳𑆠𑇀𑆫𑆁 𑆪𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆁 𑆱 𑆩𑆸𑆢𑆶𑆫𑆴𑆠𑆴, 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆩𑆴𑆮 𑆮𑆴𑆯𑆢𑆩𑆮𑆴𑆬𑆼𑆥𑆴 𑆪𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆁 𑆱 𑆩𑆣𑇀𑆪𑆩𑆂, 𑆑𑆸𑆰𑇀𑆟𑆩𑆮𑆱𑆤𑇀𑆤𑆩𑆵𑆰𑆢𑇀𑆮𑆴𑆯𑆢𑆁 𑆖𑆴𑆑𑇀𑆑𑆟𑆁 𑆖 𑆪𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆁 𑆱 𑆒𑆫 𑆅𑆠𑆴; 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆢𑆓𑇀𑆣𑆱𑇀𑆤𑆼𑆲𑆾 𑆨𑆮𑆠𑆴, 𑆠𑆁 𑆥𑆶𑆤𑆂 𑆱𑆳𑆣𑆶 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆪𑆾𑆫𑇀𑆩𑆸𑆢𑆶𑆂, 𑆤𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆩𑆂, 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆟𑆥𑆷𑆫𑆟𑆪𑆾𑆱𑇀𑆠𑆶 𑆒𑆫 𑆅𑆠𑆴 𑇆𑇑𑇑𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆯𑆧𑇀𑆢𑆱𑇀𑆪𑆾𑆥𑆫𑆩𑆼 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆦𑆼𑆤𑆱𑇀𑆪𑆾𑆥𑆯𑆩𑆼 𑆠𑆡𑆳 𑇅 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆿 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆔𑆸𑆠𑆱𑇀𑆪𑆽𑆮𑆁 𑆮𑆴𑆥𑆑𑇀𑆮𑆱𑇀𑆪 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆦𑆼𑆤𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆽𑆬𑆱𑇀𑆪 𑆯𑆼𑆰𑆁 𑆔𑆸𑆠𑆮𑆢𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇓𑇆

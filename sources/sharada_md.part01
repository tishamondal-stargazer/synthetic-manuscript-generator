𑆅𑆠𑆴 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆔𑆸𑆠𑆩𑇀𑇅 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆤𑆴𑆩𑇀𑆧𑆧𑆬𑆳𑆩𑆣𑆶𑆑𑆱𑆳𑆣𑆴𑆠𑆩𑇀𑇅 𑆱𑆑𑇀𑆰𑆵𑆫𑆁 𑆩𑆳𑆲𑆴𑆰𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑆳𑆩𑆬𑆳𑆲𑆫𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇕𑇓𑇆
𑆅𑆠𑆴 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆼 𑆢𑆳𑆫𑇀𑆮𑇀𑆪𑆳𑆂 𑆑𑆬𑇀𑆑𑆳𑆑𑇀𑆰𑆢𑇀𑆮𑆪𑆱𑆳𑆣𑆴𑆠𑆂𑇅 𑆢𑆳𑆫𑇀𑆮𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖𑆥𑆬𑆑𑇀𑆮𑆳𑆡𑆼 𑆑𑆬𑇀𑆑𑆼 𑆑𑆳𑆬𑆵𑆪𑆑𑆼 𑆥𑆫𑆂𑇆𑇕𑇔𑇆
𑆩𑆳𑆲𑆴𑆰𑆳𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆂 𑆥𑆷𑆫𑇀𑆮𑆂 𑆥𑆷𑆫𑇀𑆮𑆼 𑆥𑆫𑆼 𑆥𑆫𑆂𑇅𑇕𑇕𑇅 𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆼𑆨𑆴𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑇀𑆪 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆩𑆠𑇀𑆮𑆳 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑇆𑇕𑇕𑇆
𑆥𑆪𑆱𑆳 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆧𑆲𑆶𑆯𑆂 𑆑𑆼𑆮𑆬𑆼𑆤 𑆮𑆳𑇅 𑆢𑆤𑇀𑆠𑆵𑆦𑆬𑆫𑆱𑆼 𑆑𑆾𑆰𑇀𑆟𑆼 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆴𑆤𑆳 𑆯𑆸𑆠𑆩𑇀𑇆𑇕𑇖𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆚𑇀𑆘𑆬𑆴𑆁 𑆩𑆸𑆢𑆴𑆠𑇀𑆮𑆳 𑆮𑆳 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆳𑆥𑆲𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆯𑆫𑇀𑆑𑆫𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆬𑆳𑆫𑇀𑆣𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇕𑇗𑇆
𑆑𑆦𑆥𑆳𑆟𑇀𑆝𑆶𑆱𑇀𑆠𑆶 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆲𑆫𑆵𑆠𑆑𑆵𑆩𑇀𑇅 𑆄𑆫𑆓𑇀𑆮𑆣𑆁 𑆫𑆱𑆼𑆤𑆼𑆑𑇀𑆰𑆾𑆫𑇀𑆮𑆴𑆢𑆳𑆫𑇀𑆪𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆖𑇆𑇕𑇘𑇆
𑆱𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆁 𑆧𑆴𑆬𑇀𑆮𑆥𑆠𑇀𑆫𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆳 𑆑𑆳𑆩𑆬𑆳𑆥𑆲𑆩𑇀𑇅 𑆢𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆣𑆥𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆢𑇀𑆮𑆴𑆓𑆶𑆝𑆁 𑆯𑆵𑆠𑆮𑆳𑆫𑆴𑆟𑆳𑇆𑇕𑇙𑇆
𑆑𑆳𑆩𑆬𑆵 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆮𑆳𑇁𑆥𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳 𑆫𑆱𑆽𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆮𑆴𑆯𑆳𑆬𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆩𑆶𑆱𑇀𑆠𑆑𑆶𑆰𑇀𑆜𑆢𑆳𑆫𑆶𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆳𑆤𑇀𑇆𑇖𑇐𑇆
𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆳𑆤𑆫𑇀𑆣𑆑𑆫𑇀𑆰𑆳𑆁𑆯𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆠𑆴𑆮𑆴𑆰𑆳𑆁 𑆠𑆡𑆳𑇅 𑆑𑆫𑇀𑆰𑆿 𑆩𑆣𑆶𑆫𑆱𑆳𑆪𑆳 𑆢𑇀𑆮𑆿 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆠𑇀 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇆𑇖𑇑𑇆
𑆩𑆸𑆢𑆴𑆠𑆁 𑆠𑆁 𑆫𑆱𑆁 𑆥𑆷𑆠𑆁 𑆥𑆵𑆠𑇀𑆮𑆳 𑆬𑆴𑆲𑇀𑆪𑆳𑆖𑇀𑆖 𑆩𑆣𑇀𑆮𑆤𑆶𑇅 𑆑𑆳𑆱𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆘𑇀𑆮𑆫𑆁 𑆢𑆳𑆲𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆩𑆫𑆾𑆖𑆑𑆩𑇀𑇆𑇖𑇒𑇆
𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆳𑆲𑆳𑆩𑆮𑆳𑆠𑆳𑆁𑆯𑇀𑆖 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆳 𑆮𑆳 𑆢𑆳𑆫𑇀𑆮𑇀𑆪𑆳 𑆤𑆴𑆩𑇀𑆧𑆱𑇀𑆪 𑆮𑆳 𑆫𑆱𑆩𑇀𑇆𑇖𑇓𑇆
𑆯𑆵𑆠𑆁 𑆩𑆣𑆶𑆪𑆶𑆠𑆁 𑆥𑇀𑆫𑆳𑆠𑆂 𑆑𑆳𑆩𑆬𑆳𑆫𑇀𑆠𑆂 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂𑇅 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆑𑇀𑆰𑆁 𑆓𑆮𑇀𑆪𑆁 𑆩𑆳𑆲𑆴𑆰𑆩𑆼𑆮 𑆮𑆳𑇆𑇖𑇔𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑇀𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆩𑇀𑇅 𑆠𑆫𑆶𑆘𑆳𑆤𑇀 𑆘𑇀𑆮𑆬𑆴𑆠𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆼 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑇀𑆪𑆳𑆩𑆸𑆢𑇀𑆪 𑆖𑆳𑆕𑇀𑆑𑆶𑆫𑆳𑆤𑇀𑇆𑇖𑇕𑇆
𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆱𑇀𑆪 𑆠𑆠𑇀 𑆥𑆷𑆠𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆯𑆾𑆡𑆲𑆫𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆱𑇀𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆵 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆗𑇀𑆪𑆳𑆩𑆼 𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶 𑆱𑆤𑆳𑆓𑆫𑆩𑇀𑇆𑇖𑇖𑇆
𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆳𑆚𑇀𑆘𑆬𑆴𑆤𑆳 𑆥𑆴𑆰𑇀𑆛𑆁 𑆩𑆷𑆠𑇀𑆫𑆼 𑆮𑆳 𑆑𑇀𑆮𑆡𑆴𑆠𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆑𑇀𑆰𑆵𑆫𑆩𑆼𑆨𑆴𑆂 𑆯𑆸𑆠𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆴𑆧𑆼𑆢𑇀𑆢𑆾𑆰𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆩𑇀𑇆𑇖𑇗𑇆
𑆲𑆫𑆵𑆠𑆑𑆵𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑆟𑆳𑆡𑆮𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆫𑆱𑆼𑆤 𑆩𑆣𑆶𑆫𑆼𑆟 𑆮𑆳𑇆𑇖𑇘𑇆
𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆓𑆮𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆼 𑆨𑆳𑆮𑆴𑆠𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆪𑆾𑆫𑆘𑆂𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆪𑆱𑆳 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀𑇆𑇖𑇙𑇆
𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆩𑆶𑆱𑇀𑆠𑆮𑆴𑆝𑆕𑇀𑆓𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆂 𑆱𑆩𑆳𑆂𑇅 𑆤𑆮𑆳𑆪𑆾𑆫𑆘𑆱𑆾 𑆨𑆳𑆓𑆳𑆱𑇀𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇆𑇗𑇐𑇆
𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑆥𑆳𑆟𑇀𑆝𑆶𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆑𑆶𑆰𑇀𑆜𑆳𑆫𑇀𑆯𑆂𑆑𑆳𑆩𑆬𑆳𑆥𑆲𑆩𑇀𑇅 𑆤𑆮𑆳𑆪𑆱𑆩𑆴𑆢𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆨𑆳𑆰𑆴𑆠𑆩𑇀𑇆𑇗𑇑𑇆
𑆅𑆠𑆴 𑆤𑆮𑆳𑆪𑆱𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆓𑆶𑆝𑆤𑆳𑆓𑆫𑆩𑆟𑇀𑆝𑆷𑆫𑆠𑆴𑆬𑆳𑆁𑆯𑆳𑆤𑇀𑆩𑆳𑆤𑆠𑆂 𑆱𑆩𑆳𑆤𑇀𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆓𑆶𑆛𑆴𑆑𑆳𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆼𑇆𑇗𑇒𑇆
𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆩𑆶𑆱𑇀𑆠𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆿𑇅 𑆢𑆳𑆫𑇀𑆮𑆵𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆾 𑆣𑆳𑆠𑆶𑆫𑇀𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆑𑆁 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖𑇆𑇗𑇓𑇆
𑆍𑆠𑆳𑆤𑇀 𑆢𑇀𑆮𑆴𑆥𑆬𑆴𑆑𑆳𑆤𑇀𑆨𑆳𑆓𑆳𑆁𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀𑇅 𑆩𑆟𑇀𑆝𑆷𑆫𑆁 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆖𑇀𑆗𑆶𑆢𑇀𑆣𑆩𑆚𑇀𑆘𑆤𑆱𑆤𑇀𑆤𑆴𑆨𑆩𑇀𑇆𑇗𑇔𑇆
𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑇁𑆰𑇀𑆛𑆓𑆶𑆟𑆼 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀𑆠𑆠𑆂𑇅 𑆇𑆢𑆶𑆩𑇀𑆧𑆫𑆱𑆩𑆳𑆤𑇀𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆛𑆑𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆪𑆡𑆳𑆓𑇀𑆤𑆴 𑆤𑆳𑇆𑇗𑇕𑇆
𑆇𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆠𑆑𑇀𑆫𑆼𑆟 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆨𑆾𑆘𑆤𑆩𑇀𑇅 𑆩𑆟𑇀𑆝𑆷𑆫𑆮𑆛𑆑𑆳 𑆲𑇀𑆪𑆼𑆠𑆼 𑆥𑇀𑆫𑆳𑆟𑆢𑆳𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀𑇆𑇗𑇖𑇆
𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆑𑆁 𑆯𑆾𑆡𑆩𑆷𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆑𑆦𑆳𑆩𑆪𑆳𑆤𑇀𑇅 𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆑𑆳𑆩𑆬𑆳𑆁 𑆩𑆼𑆲𑆁 𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆁 𑆯𑆩𑆪𑆤𑇀𑆠𑆴 𑆖𑇆𑇗𑇗𑇆
𑆅𑆠𑆴 𑆩𑆟𑇀𑆝𑆷𑆫𑆮𑆛𑆑𑆳𑆂𑇅 𑆠𑆳𑆥𑇀𑆪𑆳𑆢𑇀𑆫𑆴𑆘𑆠𑆶𑆫𑆷𑆥𑇀𑆪𑆳𑆪𑆾𑆩𑆬𑆳𑆂 𑆥𑆚𑇀𑆖𑆥𑆬𑆳𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆖𑆴𑆠𑇀𑆫𑆑𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆝𑆕𑇀𑆓𑆽𑆂 𑆥𑆬𑆴𑆑𑆽𑆂 𑆱𑆲𑇆𑇗𑇘𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆰𑇀𑆛𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳 𑆩𑆣𑆶𑆤𑆳𑇁𑇁𑆥𑇀𑆬𑆶𑆠𑆳𑆂𑇅 𑆃𑆨𑇀𑆪𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳 𑆲𑆴 𑆘𑆵𑆫𑇀𑆟𑆼 𑆲𑆴𑆠𑆩𑆴𑆠𑆳𑆯𑆴𑆤𑆳𑇆𑇗𑇙𑇆
𑆨𑆳𑆓𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆱𑇀𑆪 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆠𑆡𑆽𑆮 𑆖𑇅 𑆥𑆚𑇀𑆖𑆳𑆯𑇀𑆩𑆘𑆠𑆶𑆤𑆾 𑆨𑆳𑆓𑆳𑆱𑇀𑆠𑆡𑆳 𑆫𑆷𑆥𑇀𑆪𑆩𑆬𑆱𑇀𑆪 𑆖𑇆𑇘𑇑𑇆
𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆱𑇀𑆪 𑆖 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆬𑆿𑆲𑆱𑇀𑆪 𑆫𑆘𑆱𑆱𑇀𑆠𑆡𑆳𑇅 𑆃𑆰𑇀𑆛𑆿 𑆨𑆳𑆓𑆳𑆂 𑆱𑆴𑆠𑆳𑆪𑆳𑆯𑇀𑆖 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑇀𑇆𑇘𑇒𑇆
𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆼𑆟𑆳𑆥𑇀𑆬𑆶𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆩𑆳𑆪𑆱𑆼 𑆨𑆳𑆘𑆤𑆼 𑆯𑆶𑆨𑆼𑇅 𑆇𑆢𑆶𑆩𑇀𑆧𑆫𑆱𑆩𑆳𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆠𑆠𑆂 𑆒𑆳𑆢𑆼𑆢𑇀𑆪𑆡𑆳𑆓𑇀𑆤𑆴 𑆤𑆳𑇆𑇘𑇓𑇆
𑆪𑆾𑆓𑆫𑆳𑆘 𑆅𑆠𑆴 𑆒𑇀𑆪𑆳𑆠𑆾 𑆪𑆾𑆓𑆾𑇁𑆪𑆩𑆩𑆸𑆠𑆾𑆥𑆩𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆩𑆴𑆢𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆲𑆫𑆁 𑆯𑆴𑆮𑆩𑇀𑇆𑇘𑇕𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆮𑆴𑆰𑆁 𑆑𑆳𑆱𑆁 𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆁 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆩𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆑𑆁 𑆩𑆼𑆲𑆁 𑆯𑆾𑆰𑆁 𑆯𑇀𑆮𑆳𑆱𑆩𑆫𑆾𑆖𑆑𑆩𑇀𑇆𑇘𑇖𑇆
𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆣𑆤𑇀𑆠𑇀𑆪𑆥𑆱𑇀𑆩𑆳𑆫𑆁 𑆑𑆳𑆩𑆬𑆳𑆁 𑆓𑆶𑆢𑆘𑆳𑆤𑆴 𑆖𑇅 𑆅𑆠𑆴 𑆪𑆾𑆓𑆫𑆳𑆘𑆂𑇅 𑆑𑆿𑆛𑆘𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆤𑆴𑆩𑇀𑆧𑆥𑆛𑆾𑆬𑆔𑆤𑆤𑆳𑆓𑆫𑆽𑆂𑇆𑇘𑇗𑇆
𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆴 𑆢𑆯𑆳𑆲𑆳𑆤𑆴 𑆫𑆱𑆽𑆫𑇀𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆳𑆤𑆴 𑆮𑆳𑇅 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆥𑆬𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆿 𑆠𑆳𑆮𑆠𑆵 𑆱𑆴𑆠𑆯𑆫𑇀𑆑𑆫𑆳𑇆𑇘𑇘𑇆
𑆠𑇀𑆮𑆑𑇀𑆑𑇀𑆰𑆵𑆫𑆵 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆣𑆳𑆠𑇀𑆫𑆵 𑆑𑆫𑇀𑆑𑆛𑆳𑆒𑇀𑆪𑆳 𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳𑇅 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑇀𑆪𑆳𑆂 𑆦𑆬𑆩𑆷𑆬𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆬𑆁 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆠𑇀𑆫𑆴𑆓𑆤𑇀𑆣𑆑𑆩𑇀𑇅 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆩𑆣𑆶𑆤𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆠𑇀𑆫𑆴𑆥𑆬𑆼𑆤𑆳𑆑𑇀𑆰𑆴𑆑𑆳𑆤𑇀 𑆓𑆶𑆝𑆳𑆤𑇀𑇅 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑇀𑆧𑆶𑆥𑆪𑆂𑆥𑆑𑇀𑆰𑆴𑆫𑆱𑆠𑆾𑆪𑆱𑆶𑆫𑆳𑆱𑆮𑆳𑆤𑇀𑇆𑇙𑇐𑇆
𑆠𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆤𑆶𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆴𑆫𑆤𑇀𑆤𑆾 𑆨𑆶𑆑𑇀𑆠 𑆍𑆮 𑆮𑆳𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆶𑆰𑇀𑆜𑆘𑇀𑆮𑆫𑆥𑇀𑆬𑆵𑆲𑆠𑆩𑆑𑆳𑆫𑇀𑆯𑆾𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆤𑇀𑇆𑇙𑇑𑇆
𑆥𑆷𑆠𑆴𑆲𑆸𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆢𑆾𑆰𑆯𑆾𑆰𑆓𑆫𑆾𑆢𑆫𑆳𑆤𑇀 𑇅 𑆑𑆳𑆱𑆳𑆱𑆸𑆓𑇀𑆢𑆫𑆥𑆴𑆠𑇀𑆠𑆳𑆱𑆸𑆑𑇀𑆯𑆾𑆡𑆓𑆶𑆬𑇀𑆩𑆓𑆬𑆳𑆩𑆪𑆳𑆤𑇀𑇆𑇙𑇒𑇆
𑆠𑆼 𑆖 𑆱𑆫𑇀𑆮𑆮𑇀𑆫𑆟𑆳𑆤𑇀 𑆲𑆤𑇀𑆪𑆶𑆂 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆲𑆫𑆳𑆂 𑆯𑆴𑆮𑆳𑆂𑇅 𑆅𑆠𑆴 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆮𑆛𑆑𑆳𑆂𑇅 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆢𑆳𑆫𑆶 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑇀𑇆𑇙𑇓𑇆
𑆑𑆶𑆰𑇀𑆜𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆢𑆤𑇀𑆠𑆵 𑆖𑆮𑇀𑆪𑆁 𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆳𑆂𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆖𑆼𑆠𑆴 𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆩𑇀𑇆𑇙𑇔𑇆
𑆩𑆟𑇀𑆝𑆷𑆫𑆁 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆢𑇀𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼 𑆢𑇀𑆮𑇀𑆪𑆳𑆞𑆑𑆼 𑆥𑆖𑆼𑆠𑇀𑇅 𑆑𑆾𑆬𑆮𑆢𑇀𑆓𑆶𑆛𑆴𑆑𑆳𑆂 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆑𑇀𑆫𑆼𑆟𑆳𑆬𑆾𑆝𑇀𑆪 𑆤𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇙𑇕𑇆
𑆠𑆳𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆩𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆩𑇀𑇅 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆁 𑆲𑆤𑇀𑆪𑆶𑆂 𑆑𑆶𑆰𑇀𑆜𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆁𑆱𑇀𑆠𑆡𑆳𑇆𑇙𑇖𑇆
𑆅𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆩𑆟𑇀𑆝𑆷𑆫𑆩𑇀𑇅 𑆢𑆳𑆫𑇀𑆮𑆵𑆠𑇀𑆮𑆑𑇀 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆮𑇀𑆪𑆾𑆰𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆪𑆱𑆾 𑆫𑆘𑆂𑇅 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆪𑆶𑆠𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆑𑆳𑆩𑆬𑆳𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆮𑆳𑆤𑇀𑇆𑇙𑇗𑇆
𑆠𑆶𑆬𑇀𑆪𑆳 𑆃𑆪𑆾𑆫𑆘𑆂𑆥𑆡𑇀𑆪𑆳𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆂 𑆑𑆳𑆩𑆬𑆵 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆓𑆶𑆝𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆮𑆳𑇁𑆨𑆪𑆳𑆂𑇆𑇙𑇘𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆢𑇀𑆮𑆼 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆖 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑇀𑆪𑆪𑆾𑆫𑆘𑆂𑇅 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆱 𑆬𑆼𑆲𑆂 𑆑𑆳𑆩𑆬𑆳𑆥𑆲𑆂𑇆𑇙𑇙𑇆
𑆢𑇀𑆮𑆴𑆥𑆬𑆳𑆁𑆯𑆳𑆁 𑆠𑆶𑆓𑆳𑆑𑇀𑆰𑆵𑆫𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆩𑆣𑆶𑆪𑆰𑇀𑆛𑆴𑆑𑆳𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑆵𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆯𑆶𑆨𑆳𑆩𑇀𑇆𑇑𑇐𑇐𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆫𑆱𑆢𑇀𑆫𑆾𑆟𑆼 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆬𑆼𑆲𑆮𑆠𑇀 𑆥𑆖𑆼𑆠𑇀𑇅 𑆯𑆵𑆠𑆁 𑆩𑆣𑆶𑆥𑇀𑆫𑆱𑇀𑆡𑆪𑆶𑆠𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆟𑆴𑆠𑆬𑆁 𑆠𑆠𑆂𑇆𑇑𑇐𑇑𑇆
𑆲𑆤𑇀𑆠𑇀𑆪𑆼𑆰 𑆑𑆳𑆩𑆬𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆁 𑆑𑆳𑆱𑆁 𑆲𑆬𑆵𑆩𑆑𑆩𑇀𑇅 𑆅𑆠𑆴 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆮𑆬𑆼𑆲𑆂𑇅 𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆖𑆮𑇀𑆪𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖𑇆𑇑𑇐𑇒𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆡 𑆩𑆶𑆱𑇀𑆠𑆁 𑆖 𑆮𑆠𑇀𑆱𑆑𑆁 𑆖𑆼𑆠𑆴 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇅 𑆩𑆟𑇀𑆝𑆷𑆫𑆠𑆶𑆬𑇀𑆪𑆁 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑇁𑆰𑇀𑆛𑆓𑆶𑆟𑆼 𑆥𑆖𑆼𑆠𑇀𑇆𑇑𑇐𑇓𑇆
𑆯𑆤𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆡𑆳 𑆯𑆵𑆠𑆳𑆂 𑆑𑆳𑆫𑇀𑆪𑆳𑆂 𑆑𑆫𑇀𑆰𑆱𑆩𑆳 𑆓𑆶𑆝𑆳𑆂𑇅 𑆪𑆡𑆳𑆓𑇀𑆤𑆴 𑆨𑆑𑇀𑆰𑆟𑆵𑆪𑆳𑆱𑇀𑆠𑆼 𑆥𑇀𑆬𑆵𑆲𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆳𑆥𑆲𑆳𑆂𑇆𑇑𑇐𑇔𑇆
𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆾𑆤𑆶𑆢𑆯𑇀𑆖𑆽𑆮 𑆠𑆑𑇀𑆫𑆮𑆳𑆛𑇀𑆪𑆳𑆯𑆴𑆤𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇅 𑆅𑆠𑆴 𑆩𑆟𑇀𑆝𑆷𑆫𑆮𑆛𑆑𑆳𑆂𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳 𑆫𑆘𑆤𑆵 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳 𑆧𑆬𑆳𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆪𑆾𑆫𑆘𑆂𑇆𑇑𑇐𑇕𑇆
𑆬𑆾𑆣𑇀𑆫𑆁 𑆖𑆽𑆠𑆼𑆰𑆶 𑆓𑆿𑆝𑆂 𑆱𑇀𑆪𑆳𑆢𑆫𑆴𑆰𑇀𑆛𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀𑇅 𑆅𑆠𑆴 𑆓𑆿𑆝𑆾𑇁𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆧𑆵𑆘𑆑𑆳𑆠𑇀𑆰𑆾𑆝𑆯𑆥𑆬𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳𑆯𑇀𑆖 𑆮𑆴𑆁𑆯𑆠𑆴𑆂𑇆𑇑𑇐𑇖𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆪𑆳𑆂 𑆥𑆚𑇀𑆖 𑆬𑆳𑆑𑇀𑆰𑆳𑆪𑆳𑆂 𑆱𑆥𑇀𑆠 𑆢𑇀𑆫𑆾𑆟𑆼 𑆘𑆬𑆱𑇀𑆪 𑆠𑆠𑇀𑇅 𑆱𑆳𑆣𑇀𑆪𑆁 𑆥𑆳𑆢𑆳𑆮𑆯𑆼𑆰𑆼 𑆠𑆶 𑆥𑆷𑆠𑆯𑆼𑆰𑆼 𑆱𑆩𑆳𑆮𑆥𑆼𑆠𑇀𑇆𑇑𑇐𑇗𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆳𑆱𑇀𑆠𑆶𑆬𑆳𑆁 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆱𑇀𑆪 𑆖 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆩𑇀𑇅 𑆮𑇀𑆪𑆾𑆰𑆁 𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆤𑆒𑆾𑆯𑆵𑆫𑆁 𑆑𑇀𑆫𑆩𑆶𑆑𑆁 𑆱𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆩𑇀𑇆𑇑𑇐𑇘𑇆
𑆩𑆣𑆶𑆑𑆁 𑆑𑆶𑆰𑇀𑆜𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆼𑇅 𑆪𑆮𑆼𑆰𑆶 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 𑆠𑆢𑇀𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆢𑇀𑆮𑆴𑆂 𑆯𑆴𑆯𑆴𑆫𑆼 𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇑𑇐𑇙𑇆
𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆢𑇀𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆫𑇀𑆯𑆂𑆯𑆾𑆡𑆓𑆶𑆬𑇀𑆩𑆤𑆶𑆠𑇀𑇅 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆩𑆼𑆲𑆑𑆳𑆩𑆬𑆳𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑆴𑆠𑇀𑇆𑇑𑇑𑇐𑇆
𑆧𑆵𑆘𑆑𑆳𑆫𑆴𑆰𑇀𑆛 𑆅𑆠𑇀𑆪𑆼𑆰 𑆄𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂𑇅 𑆅𑆠𑆴 𑆧𑆵𑆘𑆑𑆳𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆱𑆲𑆱𑇀𑆫𑆼 𑆢𑇀𑆮𑆼 𑆥𑆵𑆝𑆪𑆴𑆠𑇀𑆮𑆳 𑆫𑆱𑆁 𑆠𑆶 𑆠𑆩𑇀𑇆𑇑𑇑𑇑𑇆
𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆰𑇀𑆛𑆳𑆁𑆯𑆼𑆤 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆫𑇀𑆣𑆑𑆶𑆝𑆮𑆼𑆤 𑆖𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆣𑆠𑆶𑆬𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆁 𑆥𑆑𑇀𑆰𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆔𑆛𑆼 𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇑𑇑𑇒𑇆
𑆥𑇀𑆫𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆘𑆵𑆫𑇀𑆟𑆼 𑆲𑆴𑆠𑆩𑆴𑆠𑆳𑆯𑆤𑆂𑇅 𑆑𑆳𑆩𑆬𑆳𑆥𑆳𑆟𑇀𑆝𑆶𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆮𑆳𑆠𑆳𑆱𑆸𑆓𑇀𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑇆𑇑𑇑𑇓𑇆
𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆫𑆶𑆖𑆴𑆯𑇀𑆮𑆳𑆱𑆳𑆁𑆯𑇀𑆖𑆽𑆰𑆾𑇁𑆫𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆫𑆟𑆳𑆯𑆪𑆼𑆠𑇀𑇅 𑆅𑆠𑆴 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆱𑇀𑆡𑆴𑆫𑆳𑆢𑆴𑆨𑆴𑆂 𑆯𑆸𑆠𑆁 𑆠𑆾𑆪𑆁 𑆥𑆳𑆤𑆳𑆲𑆳𑆫𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇑𑇔𑇆
𑆥𑆳𑆟𑇀𑆝𑆷𑆤𑆳𑆁, 𑆑𑆳𑆩𑆬𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆩𑆬𑆑𑆵𑆫𑆱𑆂𑇅𑇑𑇑𑇕𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆁 𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇑𑇑𑇕𑇆
𑆮𑆴𑆑𑆬𑇀𑆥𑇀𑆪𑆩𑆼𑆠𑆢𑇀𑆨𑆴𑆰𑆘𑆳 𑆥𑆸𑆡𑆓𑇀𑆢𑆾𑆰𑆧𑆬𑆁 𑆥𑇀𑆫𑆠𑆴𑇅 𑆮𑆳𑆠𑆴𑆑𑆼 𑆱𑇀𑆤𑆼𑆲𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁, 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆠𑆴𑆑𑇀𑆠𑆯𑆵𑆠𑆬𑆩𑇀𑇆𑇑𑇑𑇖𑇆
𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆾𑆰𑇀𑆟𑆁 , 𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆼𑇅𑇑𑇑𑇗𑇅 𑆤𑆴𑆥𑆳𑆠𑆪𑆼𑆖𑇀𑆗𑆫𑆵𑆫𑆳𑆠𑇀𑆠𑆶 𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆳𑆁 𑆨𑆑𑇀𑆰𑆴𑆠𑆳𑆁 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇑𑇗𑇆
𑆪𑆶𑆑𑇀𑆠𑆴𑆘𑇀𑆚𑆂 𑆯𑆾𑆣𑆤𑆽𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇅 𑆯𑆶𑆢𑇀𑆣𑆑𑆳𑆪𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆧𑆬𑆳𑆣𑆳𑆤𑆳𑆤𑆴 𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇑𑇘𑇆
𑆮𑇀𑆪𑆾𑆰𑆁 𑆧𑆴𑆬𑇀𑆮𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆢𑇀𑆮𑆼 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆢𑇀𑆮𑆼 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆼𑇅 𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑇀𑆪𑆪𑆾𑆫𑆘𑆂 𑆥𑆳𑆜𑆳 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖𑇆𑇑𑇑𑇙𑇆
𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆬𑆵 𑆖 𑆨𑆳𑆫𑇀𑆓𑆵 𑆖 𑆱𑆑𑇀𑆰𑆵𑆫𑆽𑆱𑇀𑆠𑆽𑆂 𑆱𑆩𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆤𑆫𑆾 𑆩𑆸𑆢𑇀𑆢𑆾𑆰𑆥𑆵𑆝𑆴𑆠𑆂𑇆𑇑𑇒𑇐𑇆
𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑆼𑆯𑆫𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑇀𑆰𑆳𑆫𑆯𑆳𑆢𑇀𑆮𑆬𑆽𑆂𑇅 𑆩𑆸𑆢𑇀𑆨𑆑𑇀𑆰𑆟𑆳𑆢𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆬𑆿𑆬𑇀𑆪𑆳𑆢𑆮𑆴𑆤𑆴𑆮𑆫𑇀𑆠𑆴𑆤𑆂𑇆𑇑𑇒𑇑𑇆
𑆢𑇀𑆮𑆼𑆰𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆨𑆳𑆮𑆴𑆠𑆳𑆁 𑆑𑆳𑆩𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑇀𑆢𑆾𑆰𑆤𑆳𑆯𑆤𑆽𑆂𑇅 𑆮𑆴𑆕𑇀𑆓𑆽𑆬𑆳𑆠𑆴𑆮𑆴𑆰𑆪𑆳 𑆤𑆴𑆩𑇀𑆧𑆥𑆠𑇀𑆫𑆼𑆟 𑆥𑆳𑆜𑆪𑆳𑇆𑇑𑇒𑇒𑇆
𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆽𑆂 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑇀𑆪𑆳 𑆑𑆿𑆛𑆘𑆽𑆫𑇀𑆩𑆷𑆫𑇀𑆮𑆪𑆳𑇁𑆥𑆴 𑆮𑆳𑇅𑇑𑇒𑇓𑇅 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆨𑆽𑆰𑆘𑇀𑆪𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑇀𑇆𑇑𑇒𑇓𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆯𑆼𑆰 𑆍𑆰𑆾𑇁𑆱𑇀𑆪 𑆩𑆠𑆾 𑆲𑆼𑆠𑆶𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇅𑇑𑇒𑇔𑇅 𑆠𑆴𑆬𑆥𑆴𑆰𑇀𑆛𑆤𑆴𑆨𑆁 𑆪𑆱𑇀𑆠𑆶 𑆮𑆫𑇀𑆖𑆂 𑆱𑆸𑆘𑆠𑆴 𑆑𑆳𑆩𑆬𑆵𑇆𑇑𑇒𑇔𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆫𑆶𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆁 𑆠𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆦𑆲𑆫𑆽𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆓𑆶𑆫𑆶𑆱𑇀𑆮𑆳𑆢𑆶𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆽𑆫𑇀𑆮𑆼𑆓𑆤𑆴𑆓𑇀𑆫𑆲𑆽𑆂𑇆𑇑𑇒𑇕𑇆
𑆑𑆦𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑇀𑆰𑆴𑆥𑆼𑆢𑇀𑆧𑆬𑆵𑇅 𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆠𑇀𑆮𑆑𑇀 𑆯𑇀𑆮𑆼𑆠𑆮𑆫𑇀𑆖𑆳𑆱𑇀𑆠𑆢𑆳 𑆤𑆫𑆂𑇆𑇑𑇒𑇖𑇆
𑆨𑆮𑆼𑆠𑇀 𑆱𑆳𑆛𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆾 𑆓𑆶𑆫𑆶𑆟𑆳 𑆲𑆸𑆢𑆪𑆼𑆤 𑆖𑇅 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆫𑇀𑆠𑆴𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑆶𑆖𑆴𑆘𑇀𑆮𑆫𑆽𑆂𑇆𑇑𑇒𑇗𑇆
𑆯𑆶𑆰𑇀𑆑𑆩𑆷𑆬𑆑𑆑𑆿𑆬𑆠𑇀𑆡𑆽𑆫𑇀𑆪𑆷𑆰𑆽𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆳𑆤𑆴 𑆨𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆫𑆱𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇆𑇑𑇒𑇙𑇆
𑆱𑆤𑆳𑆓𑆫𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆡𑆳𑇁𑆱𑇀𑆪𑆽𑆠𑆴 𑆱𑇀𑆮𑆩𑆳𑆯𑆪𑆩𑇀𑇅𑇑𑇓𑇐𑇅 𑆑𑆛𑆶𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆬𑆮𑆟𑆽𑆫𑇀𑆨𑆸𑆯𑆳𑆩𑇀𑆬𑆽𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆑𑇀𑆫𑆩𑆂𑇆𑇑𑇓𑇐𑇆
𑆄𑆥𑆴𑆠𑇀𑆠𑆫𑆳𑆓𑆳𑆖𑇀𑆗𑆑𑆸𑆠𑆾 𑆮𑆳𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆯𑆩𑆳𑆢𑇀𑆨𑆮𑆼𑆠𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆩𑆳𑆓𑆠𑆼 𑆥𑆴𑆠𑇀𑆠𑆼 𑆥𑆶𑆫𑆵𑆰𑆼 𑆥𑆴𑆠𑇀𑆠𑆫𑆚𑇀𑆘𑆴𑆠𑆼𑇆𑇑𑇓𑇑𑇆
𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆱𑇀𑆪 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆂 𑆑𑆳𑆩𑆬𑆴𑆑𑆾 𑆮𑆴𑆣𑆴𑆂𑇅𑇑𑇓𑇒𑇅 𑆪𑆢𑆳 𑆠𑆶 𑆥𑆳𑆟𑇀𑆝𑆾𑆫𑇀𑆮𑆫𑇀𑆟𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆣𑆫𑆴𑆠𑆯𑇀𑆪𑆳𑆮𑆥𑆵𑆠𑆑𑆂𑇆𑇑𑇓𑇒𑇆
𑆧𑆬𑆾𑆠𑇀𑆱𑆳𑆲𑆑𑇀𑆰𑆪𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆩𑆤𑇀𑆢𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆠𑇀𑆮𑆁 𑆩𑆸𑆢𑆶𑆘𑇀𑆮𑆫𑆂𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑇀𑆮𑆲𑆫𑇀𑆰𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆯𑇀𑆖 𑆯𑇀𑆮𑆳𑆱𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑇁𑆫𑆶𑆖𑆴𑆫𑇀𑆨𑇀𑆫𑆩𑆂𑇆𑇑𑇓𑇓𑇆
𑆲𑆬𑆵𑆩𑆑𑆁 𑆠𑆢𑆳 𑆠𑆱𑇀𑆪 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆤𑆴𑆬𑆥𑆴𑆠𑇀𑆠𑆠𑆂𑇅𑇑𑇓𑇔𑇅 𑆓𑆶𑆝𑆷𑆖𑆵𑆱𑇀𑆮𑆫𑆱𑆑𑇀𑆰𑆵𑆫𑆱𑆳𑆣𑆴𑆠𑆁 𑆩𑆳𑆲𑆴𑆰𑆁 𑆔𑆸𑆠𑆩𑇀𑇆𑇑𑇓𑇔𑇆
𑆱 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆫𑆱𑆼𑆤𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆠𑆶𑇅 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆾 𑆩𑆣𑆶𑆫𑆥𑇀𑆫𑆳𑆪𑆁 𑆨𑆘𑆼𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆩𑇀𑇆𑇑𑇓𑇕𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆬𑆼𑆲𑆁 𑆖 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆁 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆩𑆣𑆶𑆫𑆳𑆟𑆴 𑆖𑇅 𑆪𑆳𑆥𑆤𑆳𑆤𑇀 𑆑𑇀𑆰𑆵𑆫𑆧𑆱𑇀𑆠𑆵𑆁𑆯𑇀𑆖 𑆯𑆵𑆬𑆪𑆼𑆠𑇀𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆤𑇀𑇆𑇑𑇓𑇖𑇆
𑆩𑆳𑆫𑇀𑆢𑇀𑆮𑆵𑆑𑆳𑆫𑆴𑆰𑇀𑆛𑆪𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳𑇁𑆓𑇀𑆤𑆴𑆮𑆸𑆢𑇀𑆣𑆪𑆼𑇅 𑆑𑆳𑆱𑆴𑆑𑆁 𑆖𑆳𑆨𑆪𑆳𑆬𑆼𑆲𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆩𑆣𑆶𑆑𑆁 𑆧𑆬𑆳𑆩𑇀𑇆𑇑𑇓𑇗𑇆
𑆥𑆪𑆱𑆳 𑆖 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇅𑇑𑇓𑇘𑇅 𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆥𑆳𑆟𑇀𑆝𑆾𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆁 𑆲𑆼𑆠𑆶𑆬𑆑𑇀𑆰𑆟𑆨𑆼𑆰𑆘𑆩𑇀𑇆𑇑𑇓𑇘𑇆

𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆬𑆳𑆥𑆁 𑆖 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆁 𑆓𑆳𑆠𑇀𑆫𑆓𑆿𑆫𑆮𑆩𑇀𑇅 𑆤𑆒𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑆥𑆵𑆠𑆠𑇀𑆮𑆁 𑆰𑇀𑆜𑆵𑆮𑆤𑆁 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆪𑆾𑆂𑇆𑇕𑇒𑇆
𑆲𑆵𑆤𑆮𑆳𑆠𑆱𑇀𑆪 𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆱𑆲𑆴𑆠𑆯𑇀𑆖𑆫𑆤𑇀𑇅 𑆑𑆫𑆾𑆠𑇀𑆪𑆫𑆾𑆖𑆑𑆳𑆥𑆳𑆑𑆿 𑆱𑆢𑆤𑆁 𑆓𑆿𑆫𑆮𑆁 𑆠𑆡𑆳𑇆𑇕𑇓𑇆
𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆩𑆳𑆱𑇀𑆪𑆱𑇀𑆫𑆮𑆟𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆁 𑆢𑆷𑆪𑆤𑆁 𑆩𑆢𑆩𑇀𑇅 𑆮𑆴𑆫𑆼𑆑𑆱𑇀𑆪 𑆖 𑆮𑆽𑆰𑆩𑇀𑆪𑆁 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑆤𑆬𑆱𑇀𑆪 𑆖𑇆𑇕𑇔𑇆
𑆲𑆵𑆤𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆩𑆳𑆫𑆶𑆠𑆼𑆤𑆾𑆥𑆱𑆁𑆲𑆴𑆠𑆂𑇅 𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆖 𑆠𑆾𑆢𑆁 𑆖 𑆘𑆤𑆪𑆠𑇀𑆪𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇕𑇕𑇆
𑆓𑆿𑆫𑆮𑆁 𑆩𑆸𑆢𑆶𑆠𑆳𑆩𑆓𑇀𑆤𑆼𑆫𑇀𑆨𑆑𑇀𑆠𑆳𑆯𑇀𑆫𑆢𑇀𑆣𑆳𑆁 𑆥𑇀𑆫𑆮𑆼𑆥𑆤𑆩𑇀𑇅 𑆤𑆒𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑆯𑆶𑆑𑇀𑆬𑆠𑇀𑆮𑆁 𑆓𑆳𑆠𑇀𑆫𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆩𑆼𑆮 𑆖𑇆𑇕𑇖𑇆
𑆩𑆳𑆫𑆶𑆠𑆱𑇀𑆠𑆶 𑆑𑆦𑆼 𑆲𑆵𑆤𑆼 𑆥𑆴𑆠𑇀𑆠𑆁 𑆖 𑆑𑆶𑆥𑆴𑆠𑆁 𑆢𑇀𑆮𑆪𑆩𑇀𑇅 𑆑𑆫𑆾𑆠𑆴 𑆪𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆯𑆸𑆟𑆶 𑆠𑆳𑆤𑆴 𑆱𑆩𑆳𑆱𑆠𑆂𑇆𑇕𑇗𑇆
𑆨𑇀𑆫𑆩𑆩𑆶𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆠𑆾𑆢𑆁 𑆢𑆳𑆲𑆁 𑆱𑇀𑆦𑆶𑆛𑆤𑆮𑆼𑆥𑆤𑆼𑇅 𑆃𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆁 𑆥𑆫𑆵𑆯𑆾𑆰𑆁 𑆢𑆷𑆪𑆤𑆁 𑆣𑆷𑆥𑆤𑆁 𑆠𑆡𑆳𑇆𑇕𑇘𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑇀𑆰𑆪𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆥𑆴𑆢𑆣𑆢𑇀𑆨𑆸𑆯𑆩𑇀𑇅 𑆖𑆼𑆰𑇀𑆛𑆳𑆥𑇀𑆫𑆟𑆳𑆯𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆖 𑆮𑆳𑆑𑇀𑆱𑆕𑇀𑆓𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴 𑆲𑆴𑇆𑇕𑇙𑇆
𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑇀𑆰𑆪𑆼 𑆥𑆴𑆠𑇀𑆠𑆁 𑆢𑆼𑆲𑆿𑆘𑆂 𑆱𑇀𑆫𑆁𑆱𑆪𑆖𑇀𑆖𑆫𑆼𑆠𑇀𑇅 𑆓𑇀𑆬𑆳𑆤𑆴𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆰𑆪𑆩𑇀𑇆𑇖𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑇀𑆰𑆪𑆼 𑆮𑆳𑆪𑆶𑆫𑇀𑆩𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆠𑆴𑆤𑆴𑆥𑆵𑆝𑆪𑆤𑇀𑇅 𑆥𑇀𑆫𑆟𑆳𑆯𑆪𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆖 𑆮𑆼𑆥𑆪𑆠𑇀𑆪𑆡𑆮𑆳 𑆤𑆫𑆩𑇀𑇆𑇖𑇑𑇆
𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆂 𑆱𑇀𑆮𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆢𑆫𑇀𑆯𑆪𑆤𑇀𑆠𑆴 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇅 𑆑𑇀𑆰𑆵𑆟𑆳 𑆘𑆲𑆠𑆴 𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑇀𑆮𑆁, 𑆱𑆩𑆳𑆂 𑆱𑇀𑆮𑆁 𑆑𑆫𑇀𑆩 𑆑𑆶𑆮𑆼𑆠𑆼𑇆𑇖𑇒𑇆
𑆮𑆳𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆩𑆬𑆳𑆤𑆳𑆩𑆾𑆘𑆱𑆱𑇀𑆠𑆡𑆳𑇅 𑆑𑇀𑆰𑆪𑆳𑆱𑇀𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆩𑆶𑆑𑇀𑆠𑆁 𑆱𑆕𑇀𑆑𑇀𑆰𑆵𑆟𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇖𑇓𑇆
𑆔𑆛𑇀𑆛𑆠𑆼 𑆱𑆲𑆠𑆼 𑆯𑆧𑇀𑆢𑆁 𑆤𑆾𑆖𑇀𑆖𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑆠𑆴 𑆯𑆷𑆬𑇀𑆪𑆠𑆼𑇅 𑆲𑆸𑆢𑆪𑆁 𑆠𑆳𑆩𑇀𑆪𑆠𑆴 𑆱𑇀𑆮𑆬𑇀𑆥𑆖𑆼𑆰𑇀𑆛𑆱𑇀𑆪𑆳𑆥𑆴 𑆫𑆱𑆑𑇀𑆰𑆪𑆼𑇆𑇖𑇔𑇆
𑆥𑆫𑆶𑆰𑆳 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆳 𑆩𑇀𑆬𑆳𑆤𑆳 𑆠𑇀𑆮𑆓𑇀𑆫𑆷𑆑𑇀𑆰𑆳 𑆫𑆑𑇀𑆠𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆼𑇅 𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆱𑇀𑆦𑆴𑆓𑇀𑆓𑇀𑆫𑆵𑆮𑆾𑆢𑆫𑆯𑆶𑆰𑇀𑆑𑆠𑆳𑇆𑇖𑇕𑇆
𑆱𑆤𑇀𑆣𑆵𑆤𑆳𑆁 𑆱𑇀𑆦𑆶𑆛𑆤𑆁 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑆳𑆪𑆳𑆱 𑆍𑆮 𑆖𑇅 𑆬𑆑𑇀𑆰𑆟𑆁 𑆩𑆼𑆢𑆱𑆴 𑆑𑇀𑆰𑆵𑆟𑆼 𑆠𑆤𑆶𑆠𑇀𑆮𑆁 𑆖𑆾𑆢𑆫𑆱𑇀𑆪 𑆖𑇆𑇖𑇖𑇆
𑆑𑆼𑆯𑆬𑆾𑆩𑆤𑆒𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆢𑇀𑆮𑆴𑆘𑆥𑇀𑆫𑆥𑆠𑆤𑆁 𑆯𑇀𑆫𑆩𑆂𑇅 𑆘𑇀𑆚𑆼𑆪𑆩𑆱𑇀𑆡𑆴𑆑𑇀𑆰𑆪𑆼 𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆤𑇀𑆣𑆴𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆩𑆼𑆮 𑆖𑇆𑇖𑇗𑇆
𑆯𑆵𑆫𑇀𑆪𑆤𑇀𑆠 𑆅𑆮 𑆖𑆳𑆱𑇀𑆡𑆵𑆤𑆴 𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆤𑆴 𑆬𑆔𑆷𑆤𑆴 𑆖𑇅 𑆥𑇀𑆫𑆠𑆠𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆵𑆟𑆴 𑆑𑇀𑆰𑆵𑆟𑆼 𑆩𑆘𑇀𑆘𑆤𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀𑇆𑇖𑇘𑇆
𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆩𑆶𑆒𑆯𑆾𑆰𑆯𑇀𑆖 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑇀𑆮𑆁 𑆱𑆢𑆤𑆁 𑆯𑇀𑆫𑆩𑆂𑇅 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆮𑆴𑆱𑆫𑇀𑆓𑆯𑇀𑆖 𑆑𑇀𑆰𑆵𑆟𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇖𑇙𑇆
𑆑𑇀𑆰𑆵𑆟𑆼 𑆯𑆑𑆸𑆠𑆴 𑆖𑆳𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑆵𑆝𑆪𑆤𑇀𑆤𑆴𑆮 𑆩𑆳𑆫𑆶𑆠𑆂𑇅 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪𑆾𑆤𑇀𑆤𑆩𑆪𑆤𑇀 𑆑𑆶𑆑𑇀𑆰𑆴𑆁 𑆠𑆴𑆫𑇀𑆪𑆓𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇗𑇐𑇆
𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆪𑆼 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆩𑆷𑆠𑇀𑆫𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆼𑆮 𑆖𑇅 𑆥𑆴𑆥𑆳𑆱𑆳 𑆧𑆳𑆣𑆠𑆼 𑆖𑆳𑆱𑇀𑆪 𑆩𑆶𑆒𑆁 𑆖 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆪𑆠𑆴𑇆𑇗𑇑𑇆
𑆩𑆬𑆳𑆪𑆤𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆯𑆷𑆤𑇀𑆪𑆳𑆤𑆴 𑆖 𑆬𑆔𑆷𑆤𑆴 𑆖𑇅 𑆮𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆴 𑆖 𑆬𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆩𑆬𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆼𑇆𑇗𑇒𑇆
𑆧𑆴𑆨𑆼𑆠𑆴 𑆢𑆶𑆫𑇀𑆧𑆬𑆾𑇁𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆣𑇀𑆪𑆳𑆪𑆠𑆴 𑆮𑇀𑆪𑆡𑆴𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇅 𑆢𑆶𑆯𑇀𑆗𑆳𑆪𑆾 𑆢𑆶𑆫𑇀𑆩𑆤𑆳 𑆫𑆷𑆑𑇀𑆰𑆂 𑆑𑇀𑆰𑆳𑆩𑆯𑇀𑆖𑆽𑆮𑆿𑆘𑆱𑆂 𑆑𑇀𑆰𑆪𑆼𑇆𑇗𑇓𑇆
𑆲𑆸𑆢𑆴 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆪𑆖𑇀𑆗𑆶𑆢𑇀𑆣𑆁 𑆫𑆑𑇀𑆠𑆩𑆵𑆰𑆠𑇀𑆱𑆥𑆵𑆠𑆑𑆩𑇀𑇅 𑆏𑆘𑆂 𑆯𑆫𑆵𑆫𑆼 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆁 𑆠𑆤𑇀𑆤𑆳𑆯𑆳𑆤𑇀𑆤𑆳 𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑆴𑇆𑇗𑇔𑇆
𑆥𑇀𑆫𑆡𑆩𑆁 𑆘𑆳𑆪𑆠𑆼 𑆲𑇀𑆪𑆾𑆘𑆂 𑆯𑆫𑆵𑆫𑆼𑇁𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆫𑇀𑆟𑆁 𑆩𑆣𑆶𑆫𑆱𑆁 𑆬𑆳𑆘𑆓𑆤𑇀𑆣𑆴 𑆥𑇀𑆫𑆘𑆳𑆪𑆠𑆼𑇆𑇗𑇕𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑇁𑆤𑆯𑆤𑆁 𑆖𑆴𑆤𑇀𑆠𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆬𑇀𑆥𑆥𑇀𑆫𑆩𑆴𑆠𑆳𑆯𑆤𑆩𑇀𑇅 𑆮𑆳𑆠𑆳𑆠𑆥𑆿 𑆨𑆪𑆁 𑆯𑆾𑆑𑆾 𑆫𑆷𑆑𑇀𑆰𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆂𑇆𑇗𑇖𑇆

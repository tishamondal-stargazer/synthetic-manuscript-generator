𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆠𑆳𑆩𑆥𑆴𑇅 𑆮𑆴𑆑𑆳𑆱𑆴𑆨𑆳𑆮𑆳𑆠𑇀𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆁 𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆠𑇀𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆠𑆳𑆁 𑆠𑆡𑆳𑇆𑇓𑇓𑇆
𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆤𑇀𑆩𑆢𑇀𑆪𑆁 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆼𑆮𑆩𑆾𑆘𑆱𑆂 𑆱𑇀𑆮𑆓𑆶𑆟𑆽𑆫𑇀𑆓𑆶𑆟𑆳𑆤𑇀𑇅 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆠𑆢𑆳𑆯𑇀𑆫𑆪𑆁 𑆖𑆳𑆯𑆶 𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑇀𑆪 𑆘𑆤𑆪𑆼𑆤𑇀𑆩𑆢𑆩𑇀𑇆𑇓𑇔𑇆
𑆫𑆱𑆮𑆳𑆠𑆳𑆢𑆴𑆩𑆳𑆫𑇀𑆓𑆳𑆟𑆳𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆠𑇀𑆩𑆤𑆳𑆩𑇀𑇅 𑆥𑇀𑆫𑆣𑆳𑆤𑆱𑇀𑆪𑆿𑆘𑆱𑆯𑇀𑆖𑆽𑆮 𑆲𑆸𑆢𑆪𑆁 𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇓𑇕𑇆
𑆃𑆠𑆴𑆥𑆵𑆠𑆼𑆤 𑆩𑆢𑇀𑆪𑆼𑆤 𑆮𑆴𑆲𑆠𑆼𑆤𑆿𑆘𑆱𑆳 𑆖 𑆠𑆠𑇀𑇅 𑆲𑆸𑆢𑆪𑆁 𑆪𑆳𑆠𑆴 𑆮𑆴𑆑𑆸𑆠𑆴𑆁 𑆠𑆠𑇀𑆫𑆱𑇀𑆡𑆳 𑆪𑆼 𑆖 𑆣𑆳𑆠𑆮𑆂𑇆𑇓𑇖𑇆
𑆏𑆘𑆱𑇀𑆪𑆮𑆴𑆲𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆾 𑆲𑆸𑆢𑆴 𑆖 𑆥𑇀𑆫𑆠𑆴𑆧𑆾𑆣𑆴𑆠𑆼𑇅 𑆩𑆣𑇀𑆪𑆩𑆾 𑆮𑆴𑆲𑆠𑆼𑇁𑆬𑇀𑆥𑆼 𑆖 𑆮𑆴𑆲𑆠𑆼 𑆠𑆷𑆠𑇀𑆠𑆩𑆾 𑆩𑆢𑆂𑇆𑇓𑇗𑇆
𑆤𑆽𑆮𑆁 𑆮𑆴𑆔𑆳𑆠𑆁 𑆘𑆤𑆪𑆼𑆤𑇀𑆩𑆢𑇀𑆪𑆁 𑆥𑆽𑆰𑇀𑆛𑆴𑆑𑆩𑆾𑆘𑆱𑆂𑇅 𑆮𑆴𑆑𑆳𑆯𑆴𑆫𑆷𑆑𑇀𑆰𑆮𑆴𑆯𑆢𑆳 𑆓𑆶𑆟𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆲𑆴 𑆤𑆾𑆬𑇀𑆧𑆟𑆳𑆂𑇆𑇓𑇘𑇆
𑆲𑆸𑆢𑆴 𑆩𑆢𑇀𑆪𑆓𑆶𑆟𑆳𑆮𑆴𑆰𑇀𑆛𑆼 𑆲𑆫𑇀𑆰𑆱𑇀𑆠𑆫𑇀𑆰𑆾 𑆫𑆠𑆴𑆂 𑆱𑆶𑆒𑆩𑇀𑇅 𑆮𑆴𑆑𑆳𑆫𑆳𑆯𑇀𑆖 𑆪𑆡𑆳𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆖𑆴𑆠𑇀𑆫𑆳 𑆫𑆳𑆘𑆱𑆠𑆳𑆩𑆱𑆳𑆂𑇆𑇓𑇙𑇆
𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆾𑆲𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑇀𑆠𑆳 𑆩𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆠𑆴𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀𑇅 𑆱 𑆩𑆢𑇀𑆪𑆮𑆴𑆨𑇀𑆫𑆩𑆾 𑆤𑆳𑆩𑇀𑆤𑆳 ‘𑆩𑆢’ 𑆅𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇆𑇔𑇐𑇆
𑆥𑆵𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆩𑆢𑇀𑆪𑆱𑇀𑆪 𑆮𑆴𑆘𑇀𑆚𑆳𑆠𑆮𑇀𑆪𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆩𑆢𑆳𑆂𑇅 𑆥𑇀𑆫𑆡𑆩𑆾 𑆩𑆣𑇀𑆪𑆩𑆾𑇁𑆤𑇀𑆠𑇀𑆪𑆯𑇀𑆖 𑆬𑆑𑇀𑆰𑆟𑆽𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼𑇆𑇔𑇑𑇆
𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆟𑆂 𑆥𑇀𑆫𑆵𑆠𑆴𑆑𑆫𑆂 𑆥𑆳𑆤𑆳𑆤𑇀𑆤𑆓𑆶𑆟𑆢𑆫𑇀𑆯𑆑𑆂𑇅 𑆮𑆳𑆢𑇀𑆪𑆓𑆵𑆠𑆥𑇀𑆫𑆲𑆳𑆱𑆳𑆤𑆳𑆁 𑆑𑆡𑆳𑆤𑆳𑆁 𑆖 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆑𑆂𑇆𑇔𑇒𑇆
𑆤 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆱𑇀𑆩𑆸𑆠𑆴𑆲𑆫𑆾 𑆮𑆴𑆰𑆪𑆼𑆰𑆶 𑆤 𑆖𑆳𑆑𑇀𑆰𑆩𑆂𑇅 𑆱𑆶𑆒𑆤𑆴𑆢𑇀𑆫𑆳𑆥𑇀𑆫𑆧𑆾𑆣𑆯𑇀𑆖 𑆥𑇀𑆫𑆡𑆩𑆂 𑆱𑆶𑆒𑆢𑆾 𑆩𑆢𑆂𑇆𑇔𑇓𑇆
𑆩𑆶𑆲𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆾𑆲𑆾(𑇁)𑆮𑇀𑆪𑆑𑇀𑆠𑆳 𑆱𑆘𑇀𑆘𑆠𑆴 𑆮𑆳𑆕𑇀𑆩𑆶𑆲𑆶𑆂𑇅 𑆪𑆶𑆑𑇀𑆠𑆳𑆪𑆶𑆑𑇀𑆠𑆥𑇀𑆫𑆬𑆳𑆥𑆯𑇀𑆖 𑆥𑇀𑆫𑆖𑆬𑆳𑆪𑆤𑆩𑆼𑆮 𑆖𑇆𑇔𑇔𑇆
𑆱𑇀𑆡𑆳𑆤𑆥𑆳𑆤𑆳𑆤𑇀𑆤𑆱𑆳𑆕𑇀𑆑𑆡𑇀𑆪𑆪𑆾𑆘𑆤𑆳 𑆱𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑇅 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑆳𑆮𑆴𑆰𑇀𑆛𑆼 𑆩𑆣𑇀𑆪𑆩𑆼 𑆩𑆢𑆼𑇆𑇔𑇕𑇆
𑆩𑆣𑇀𑆪𑆩𑆁 𑆩𑆢𑆩𑆶𑆠𑇀𑆑𑇀𑆫𑆩𑇀𑆪 𑆩𑆢𑆩𑆳𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆖𑆾𑆠𑇀𑆠𑆩𑆩𑇀𑇅 𑆤 𑆑𑆴𑆚𑇀𑆖𑆴𑆤𑇀𑆤𑆳𑆯𑆶𑆨𑆁 𑆑𑆶𑆫𑇀𑆪𑆶𑆫𑇀𑆤𑆫𑆳 𑆫𑆳𑆘𑆱𑆠𑆳𑆩𑆱𑆳𑆂𑇆𑇔𑇖𑇆
𑆑𑆾 𑆩𑆢𑆁 𑆠𑆳𑆢𑆸𑆯𑆁 𑆮𑆴𑆢𑇀𑆮𑆳𑆤𑆶𑆤𑇀𑆩𑆳𑆢𑆩𑆴𑆮 𑆢𑆳𑆫𑆶𑆟𑆩𑇀𑇅 𑆓𑆖𑇀𑆗𑆼𑆢𑆣𑇀𑆮𑆳𑆤𑆩𑆱𑇀𑆮𑆤𑇀𑆠𑆁 𑆧𑆲𑆶𑆢𑆾𑆰𑆩𑆴𑆮𑆳𑆣𑇀𑆮𑆓𑆂𑇆𑇔𑇗𑇆
𑆠𑆸𑆠𑆵𑆪𑆁 𑆠𑆶 𑆩𑆢𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆨𑆓𑇀𑆤𑆢𑆳𑆫𑇀𑆮𑆴𑆮 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆴𑆪𑆂𑇅 𑆩𑆢𑆩𑆾𑆲𑆳𑆮𑆸𑆠𑆩𑆤𑆳 𑆘𑆵𑆮𑆤𑇀𑆤𑆥𑆴 𑆩𑆸𑆠𑆽𑆂 𑆱𑆩𑆂𑇆𑇔𑇘𑇆
𑆫𑆩𑆟𑆵𑆪𑆳𑆤𑇀 𑆱 𑆮𑆴𑆰𑆪𑆳𑆤𑇀𑆤 𑆮𑆼𑆠𑇀𑆠𑆴 𑆤 𑆱𑆶𑆲𑆸𑆘𑇀𑆘𑆤𑆩𑇀𑇅 𑆪𑆢𑆫𑇀𑆡𑆁 𑆥𑆵𑆪𑆠𑆼 𑆩𑆢𑇀𑆪𑆁 𑆫𑆠𑆴𑆁 𑆠𑆳𑆁 𑆖 𑆤 𑆮𑆴𑆤𑇀𑆢𑆠𑆴𑇆𑇔𑇙𑇆
𑆑𑆳𑆫𑇀𑆪𑆳𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑆶𑆒𑆁 𑆢𑆶𑆂𑆒𑆁 𑆬𑆾𑆑𑆼 𑆪𑆖𑇀𑆖 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆩𑇀𑇅 𑆪𑆢𑆮𑆱𑇀𑆡𑆾 𑆤 𑆘𑆳𑆤𑆳𑆠𑆴 𑆑𑆾𑇁𑆮𑆱𑇀𑆡𑆳𑆁 𑆠𑆳𑆁 𑆮𑇀𑆫𑆘𑆼𑆢𑇀𑆧𑆶𑆣𑆂𑇆𑇕𑇐𑇆
𑆱 𑆢𑆷𑆰𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆤𑇀𑆢𑇀𑆪𑆯𑇀𑆖𑆳𑆓𑇀𑆫𑆳𑆲𑇀𑆪 𑆍𑆮 𑆖𑇅 𑆮𑇀𑆪𑆱𑆤𑆴𑆠𑇀𑆮𑆳𑆢𑆶𑆢𑆫𑇀𑆑𑆼 𑆖 𑆱 𑆢𑆶𑆂𑆒𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇕𑇑𑇆
𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆖𑆼𑆲 𑆖 𑆪𑆖𑇀𑆗𑇀𑆫𑆼𑆪𑆂 𑆯𑇀𑆫𑆼𑆪𑆾 𑆩𑆾𑆑𑇀𑆰𑆼 𑆖 𑆪𑆠𑇀 𑆥𑆫𑆩𑇀𑇅 𑆩𑆤𑆂𑆱𑆩𑆳𑆣𑆿 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆳𑆪𑆠𑇀𑆠𑆁 𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀𑇆𑇕𑇒𑇆
𑆩𑆢𑇀𑆪𑆼𑆤 𑆩𑆤𑆱𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆂 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆩𑆲𑆳𑆤𑇀𑇅 𑆩𑆲𑆳𑆩𑆳𑆫𑆶𑆠𑆮𑆼𑆓𑆼𑆤 𑆠𑆛𑆱𑇀𑆡𑆱𑇀𑆪𑆼𑆮 𑆯𑆳𑆒𑆴𑆤𑆂𑇆𑇕𑇓𑇆
𑆩𑆢𑇀𑆪𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆁 𑆠𑆁 𑆖𑆳𑆘𑇀𑆚𑆳 𑆩𑆲𑆳𑆢𑆾𑆰𑆁 𑆩𑆲𑆳𑆓𑆢𑆩𑇀𑇅 𑆱𑆶𑆒𑆩𑆴𑆠𑇀𑆪𑆣𑆴𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆫𑆘𑆾𑆩𑆾𑆲𑆥𑆫𑆳𑆘𑆴𑆠𑆳𑆂𑇆𑇕𑇔𑇆
𑆩𑆢𑇀𑆪𑆾𑆥𑆲𑆠𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳 𑆮𑆴𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆱𑆳𑆠𑇀𑆠𑇀𑆮𑆴𑆑𑆽𑆫𑇀𑆓𑆶𑆟𑆽𑆂𑇅 𑆯𑇀𑆫𑆼𑆪𑆾𑆨𑆴𑆫𑇀𑆮𑆴𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆩𑆢𑆳𑆤𑇀𑆣𑆳 𑆩𑆢𑆬𑆳𑆬𑆱𑆳𑆂𑇆𑇕𑇕𑇆
𑆩𑆢𑇀𑆪𑆼 𑆩𑆾𑆲𑆾 𑆨𑆪𑆁 𑆯𑆾𑆑𑆂 𑆑𑇀𑆫𑆾𑆣𑆾 𑆩𑆸𑆠𑇀𑆪𑆶𑆯𑇀𑆖 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆂𑇅 𑆱𑆾𑆤𑇀𑆩𑆳𑆢𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆳𑆂 𑆱𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆥𑆠𑆳𑆤𑆑𑆳𑆂𑇆𑇕𑇖𑇆
𑆪𑆠𑇀𑆫𑆽𑆑𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆱𑇀𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆩𑆱𑆳𑆣𑆶𑆮𑆠𑇀𑇅 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆩𑆢𑇀𑆪𑆢𑆾𑆰𑆘𑇀𑆚𑆳 𑆩𑆢𑇀𑆪𑆁 𑆓𑆫𑇀𑆲𑆤𑇀𑆠𑆴 𑆪𑆠𑇀𑆤𑆠𑆂𑇆𑇕𑇗𑇆

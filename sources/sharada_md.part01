𑆘𑆳𑆠𑇀𑆪𑆳𑆂 𑆥𑆶𑆰𑇀𑆥𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆧𑆵𑆘𑆁 𑆑𑆵𑆛𑆯𑆠𑇀𑆫𑆾𑆯𑇀𑆖 𑆱𑆳𑆫𑆩𑇀 𑇅 𑆍𑆠𑆠𑇀 𑆥𑆴𑆰𑇀𑆛𑆁 𑆤𑆼𑆠𑇀𑆫𑆥𑆳𑆑𑆼𑇁𑆚𑇀𑆘𑆤𑆳𑆫𑇀𑆡𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆾𑆥𑆼𑆠𑆁 𑆤𑆴𑆫𑇀𑆮𑆴𑆯𑆕𑇀𑆑𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆩𑇀 𑇆𑇔𑇔𑇆
𑆥𑆷𑆪𑆳𑆬𑆱𑆼 𑆯𑆾𑆟𑆴𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆁 𑆖 𑆲𑆴𑆠𑆁 𑆠𑆡𑆽𑆮𑆳𑆥𑇀𑆪𑆶𑆥𑆤𑆳𑆲𑆤𑆁 𑆖 𑇅 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆾 𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑆼𑆑𑇀𑆰𑆟𑆥𑆳𑆑𑆔𑆳𑆠𑆵 𑆪𑆡𑆳𑆮𑆴𑆣𑆳𑆤𑆁 𑆨𑆴𑆰𑆘𑆳 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆂 𑇆𑇔𑇕𑇆
𑆑𑆳𑆱𑆵𑆱𑆱𑆴𑆤𑇀𑆣𑆶𑆥𑇀𑆫𑆨𑆮𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆽𑆱𑇀𑆠𑆶 𑆲𑆴𑆠𑆁 𑆨𑆮𑆼𑆢𑆚𑇀𑆘𑆤𑆩𑆼𑆮 𑆖𑆳𑆠𑇀𑆫 𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆤𑇀𑆮𑆴𑆠𑆽𑆫𑆼𑆨𑆴𑆫𑆡𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆠𑆶 𑆠𑆳𑆩𑇀𑆫𑆳𑆪𑆱𑆖𑆷𑆫𑇀𑆟𑆪𑆶𑆑𑇀𑆠𑆽𑆂 𑇆𑇔𑇖𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆨𑆴𑆂 𑆱𑆩𑇀𑆪𑆓𑆥𑆳𑆱𑇀𑆪 𑆢𑆾𑆰𑆳𑆁𑆱𑇀𑆠𑆸𑆥𑇀𑆠𑆴𑆁 𑆮𑆴𑆣𑆳𑆪𑆳𑆡 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆼𑆮 𑇅 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆤𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑆱𑆼𑆑𑆳𑆚𑇀𑆘𑆤𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆤𑆱𑇀𑆪𑆣𑆷𑆩𑆽𑆂 𑇆𑇔𑇗𑇆
𑆥𑆠𑇀𑆫𑆁 𑆦𑆬𑆁 𑆖𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑆡𑆮𑆳𑇁𑆚𑇀𑆘𑆤𑆳𑆫𑇀𑆡𑆼 𑇅 𑆮𑆁𑆯𑆱𑇀𑆪 𑆩𑆷𑆬𑆼𑆤 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆮𑆳 𑆮𑆫𑇀𑆠𑆵𑆑𑆸𑆠𑆳𑆁 𑆠𑆳𑆩𑇀𑆫𑆑𑆥𑆳𑆬𑆥𑆑𑇀𑆮𑆳𑆩𑇀 𑇆𑇔𑇙𑇆
𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆮𑆳 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆳𑆁 𑆥𑆬𑆳𑆯𑆥𑆶𑆰𑇀𑆥𑆽𑆂 𑆒𑆫𑆩𑆚𑇀𑆘𑆫𑆼𑆫𑇀𑆮𑆳 𑇅 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆗𑆓𑆬𑇀𑆪𑆳𑆂 𑆥𑆪𑆱𑆳 𑆩𑆬𑆁 𑆮𑆳 𑆑𑆳𑆁𑆱𑆱𑇀𑆪 𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆱𑆲 𑆠𑆳𑆤𑇀𑆠𑆮𑆼𑆤 𑇆𑇕𑇐𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆚𑇀𑆘𑆤𑆁 𑆠𑆤𑇀𑆩𑆫𑆴𑆖𑆽𑆫𑆶𑆥𑆼𑆠𑆁 𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆠𑆳𑆩𑇀𑆫𑆱𑇀𑆪 𑆱𑆲𑆾𑆥𑆪𑆾𑆘𑇀𑆪𑆩𑇀 𑇅 𑆱𑆩𑆶𑆢𑇀𑆫𑆦𑆼𑆤𑆁 𑆬𑆮𑆟𑆾𑆠𑇀𑆠𑆩𑆁 𑆖 𑆯𑆕𑇀𑆒𑆾𑇁𑆡 𑆩𑆶𑆢𑇀𑆓𑆾 𑆩𑆫𑆴𑆖𑆁 𑆖 𑆯𑆶𑆑𑇀𑆬𑆩𑇀 𑇆𑇕𑇑𑇆
𑆖𑆷𑆫𑇀𑆟𑆳𑆚𑇀𑆘𑆤𑆁 𑆘𑆳𑆝𑇀𑆪𑆩𑆡𑆳𑆥𑆴 𑆑𑆟𑇀𑆝𑆷𑆩𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆤𑇀𑆪𑆶𑆥𑆲𑆤𑇀𑆠𑆴 𑆯𑆵𑆔𑇀𑆫𑆩𑇀 𑇅 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆠𑇀𑆩𑆤𑇀𑆪𑆥𑆴 𑆖𑆽𑆠 𑆍𑆮 𑆪𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆯𑇀𑆖 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆩𑇀 𑇆𑇕𑇒𑇆
𑆱𑆑𑆘𑇀𑆘𑆬𑆁 𑆠𑆳𑆩𑇀𑆫𑆔𑆛𑆼 𑆖 𑆔𑆸𑆰𑇀𑆜𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆪𑆶𑆠𑆁 𑆠𑆶𑆠𑇀𑆡𑆑𑆩𑆚𑇀𑆘𑆤𑆁 𑆖 𑇆𑇕𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆬𑆼𑆒𑇀𑆪𑆫𑆾𑆓𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆮 𑆪𑆼𑇁𑆨𑆴𑆲𑆴𑆠𑆳 𑆬𑆼𑆒𑇀𑆪𑆳𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆱𑇀𑆠𑆼𑆰𑇀𑆮𑆪𑆁 𑆮𑆴𑆣𑆴𑆂 𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆳𑆤𑇀𑆠𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆱𑇀𑆪 𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆱𑆢𑇀𑆩𑆤𑆴 𑇆𑇓𑇆
(𑆄𑆥𑇀𑆠𑆽𑆫𑇀𑆢𑆸𑆞𑆁 𑆓𑆸𑆲𑆵𑆠𑆱𑇀𑆪 𑆮𑆼𑆯𑇀𑆩𑆤𑇀𑆪𑆶𑆠𑇀𑆠𑆳𑆤𑆯𑆳𑆪𑆴𑆤𑆂) 𑇅 𑆱𑆶𑆒𑆾𑆢𑆑𑆥𑇀𑆫𑆠𑆥𑇀𑆠𑆼𑆤 𑆮𑆳𑆱𑆱𑆳 𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆂 𑇅 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆢𑇀𑆮𑆫𑇀𑆠𑇀𑆩 𑆤𑆴𑆫𑇀𑆨𑆶𑆘𑇀𑆪 𑆮𑆳𑆩𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆱𑇀𑆡𑆴𑆠𑆩𑇀 𑇆𑇔𑇆
𑆃𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆠𑆶 𑆤𑆴 𑆫𑇀𑆨𑆶𑆓𑇀𑆤𑆁 𑆮𑆫𑇀𑆠𑇀𑆩 𑆪𑆠𑇀𑆤𑆠𑆂 𑇅 𑆥𑇀𑆬𑆾𑆠𑆳𑆤𑇀𑆠𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆤 𑆪𑆡𑆳 𑆖𑆬𑆠𑆴 𑆱𑇀𑆫𑆁𑆱𑆠𑆼𑇁𑆥𑆴 𑆮𑆳 𑇆𑇕𑇆
𑆠𑆠𑆂 𑆥𑇀𑆫𑆩𑆸𑆘𑇀𑆪 𑆥𑇀𑆬𑆾𑆠𑆼𑆤 𑆮𑆫𑇀𑆠𑇀𑆩 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑆢𑆳𑆕𑇀𑆑𑆴𑆠𑆩𑇀 𑇅 𑆬𑆴𑆒𑆼𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳, 𑆠𑆠𑆾 𑆫𑆑𑇀𑆠𑆼 𑆱𑇀𑆡𑆴𑆠𑆼 𑆥𑆶𑆤𑆂 𑇆𑇖𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆩𑆤𑆾𑆲𑇀𑆮𑆳𑆑𑆳𑆱𑆵𑆱𑆮𑇀𑆪𑆾𑆰𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆚𑇀𑆘𑆤𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂 𑇅 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆱𑆩𑆳𑆑𑇀𑆰𑆵𑆑𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆾𑆰𑇀𑆟𑆮𑆳𑆫𑆴𑆟𑆳 𑇆𑇗𑇆
𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆲𑆮𑆴𑆰𑆳 𑆱𑆴𑆑𑇀𑆠𑆁 𑆮𑇀𑆫𑆟𑆮𑆠𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆱𑇀𑆮𑆼𑆢𑆳𑆮𑆥𑆵𑆝𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆁𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇘𑇆

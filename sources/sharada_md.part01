𑆖𑆠𑇀𑆮𑆳𑆫 𑆍𑆠𑆼 𑆪𑆾𑆓𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆶𑆨𑆪𑆾𑆫𑆚𑇀𑆘𑆤𑆼 𑆲𑆴𑆠𑆳𑆂 𑇅 𑆑𑆶𑆧𑇀𑆘𑆑𑆳𑆯𑆾𑆑𑆯𑆳𑆬𑆳𑆩𑇀𑆫𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆤𑆬𑆴𑆤𑆾𑆠𑇀𑆥𑆬𑆽𑆂 𑇆𑇘𑇆
𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑇀𑆲𑆫𑆼𑆟𑆶𑆑𑆸𑆰𑇀𑆟𑆳𑆲𑇀𑆮𑆳𑆥𑆡𑇀𑆪𑆳𑆩𑆬𑆑𑆱𑆁𑆪𑆶𑆠𑆽𑆂 𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆪𑆶𑆠𑆽𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑇀𑆮𑆼𑆟𑆶𑆤𑆳𑆝𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆽𑆂 𑇆𑇙𑇆
𑆃𑆚𑇀𑆘𑆪𑆼𑆢𑇀 𑆢𑇀𑆮𑆳𑆮𑆥𑆴 𑆨𑆴𑆰𑆑𑇀 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆨𑆳𑆮𑆴𑆠𑆿 𑇅 𑆄𑆩𑇀𑆫𑆘𑆩𑇀𑆧𑆷𑆢𑇀𑆨𑆮𑆁 𑆥𑆶𑆰𑇀𑆥𑆁 𑆠𑆢𑇀𑆫𑆱𑆼𑆤 𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑆩𑇀 𑇆𑇑𑇐𑇆
𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆘𑇀𑆪𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆩𑆡𑆮𑆳𑇁𑆚𑇀𑆘𑆤𑆩𑇀 𑇅 𑆤𑆬𑆴𑆤𑆾𑆠𑇀𑆥𑆬𑆑𑆴𑆚𑇀𑆘𑆬𑇀𑆑𑆓𑆽𑆫𑆴𑆑𑆽𑆫𑇀𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆽𑆂 𑇆𑇑𑇑𑇆
𑆓𑆶𑆝𑆴𑆑𑆳𑆚𑇀𑆘𑆤𑆩𑆼𑆠𑆢𑇀𑆮𑆳 𑆢𑆴𑆤𑆫𑆳𑆠𑇀𑆫𑇀𑆪𑆤𑇀𑆣𑆪𑆾𑆫𑇀𑆲𑆴𑆠𑆩𑇀 𑇅 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆫𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆠𑆳𑆬𑆵𑆯𑆱𑇀𑆮𑆫𑇀𑆟𑆓𑆽𑆫𑆴𑆑𑆩𑇀 𑇆𑇑𑇒𑇆
𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆲𑆠𑆢𑆸𑆰𑇀𑆛𑆪𑆼 𑇅 𑆯𑆵𑆠𑆁 𑆱𑆿𑆮𑆵𑆫𑆑𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆡 𑆫𑆱𑆨𑆳𑆮𑆴𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆑𑆷𑆫𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆳𑆮𑆪𑆼𑆢𑇀𑆫𑆿𑆲𑆴𑆠𑆼𑆤 𑆮𑆳 𑇅 𑆖𑆷𑆫𑇀𑆟𑆳𑆚𑇀𑆘𑆤𑆩𑆴𑆢𑆁 𑆤𑆴𑆠𑇀𑆪𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇑𑇔𑇆
𑆑𑆳𑆯𑆩𑆫𑆵𑆥𑆶𑆰𑇀𑆥𑆩𑆣𑆶𑆑𑆢𑆳𑆫𑇀𑆮𑆵𑆫𑆾𑆣𑇀𑆫𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆽𑆂 𑇅 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆚𑇀𑆘𑆤𑆁 𑆠𑆢𑇀𑆮𑆢𑇀𑆣𑆴𑆠𑆩𑆠𑇀𑆫𑆳𑆩𑆪𑆼 𑆱𑆢𑆳 𑇆𑇑𑇕𑇆
𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆁 𑆫𑆼𑆟𑆶𑆑𑆳𑆁 𑆖𑆳𑆥𑆴 𑆥𑆼𑆰𑆪𑆼𑆠𑇀 𑇅 𑆃𑆘𑆳𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆠𑆳 𑆮𑆫𑇀𑆠𑇀𑆪𑆂 𑆑𑇀𑆰𑆟𑆢𑆳𑆤𑇀𑆣𑇀𑆪𑆳𑆚𑇀𑆘𑆤𑆼 𑆲𑆴𑆠𑆳𑆂 𑇆𑇑𑇖𑇆
𑆑𑆳𑆬𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆮𑆳𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆁 𑆤𑆳𑆓𑆫𑆁 𑆩𑆣𑆶𑆑𑆁 𑆠𑆡𑆳 𑇅 𑆠𑆳𑆬𑆵𑆯𑆥𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆟𑆢𑆼 𑆓𑆳𑆕𑇀𑆓𑆼𑆪𑆁 𑆖 𑆪𑆑𑆸𑆢𑇀𑆫𑆱𑆼 𑇆𑇑𑇗𑇆
𑆑𑆸𑆠𑆳𑆱𑇀𑆠𑆳 𑆮𑆫𑇀𑆠𑆪𑆂 𑆥𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆗𑆳𑆪𑆳𑆯𑆶𑆰𑇀𑆑𑆳𑆂 𑆱𑆶𑆒𑆳𑆮𑆲𑆳𑆂 𑇅 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆨𑆪𑆳𑆮𑇀𑆪𑆾𑆰𑆧𑆬𑆳𑆑𑆳𑆬𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆮𑆳𑆂 𑇆𑇑𑇘𑇆
𑆱𑆦𑆼𑆤𑆳 𑆮𑆫𑇀𑆠𑆪𑆂 𑆥𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆗𑆳𑆓𑆑𑇀𑆰𑆵𑆫𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆳𑆂 𑇅 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆩𑆢𑆴𑆫𑆳𑆪𑆑𑆸𑆢𑇀𑆣𑆳𑆠𑇀𑆫𑆵𑆫𑆱𑆼 𑆥𑆖𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆚𑇀𑆘𑆤𑆁 𑆫𑆱𑆼𑆤𑆳𑆤𑇀𑆪𑆢𑇀𑆪𑆑𑆸𑆠𑆱𑇀𑆠𑇀𑆫𑆽𑆦𑆬𑆼𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆳𑆘𑇀𑆪𑆳𑆫𑇀𑆟𑆮𑆩𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆑𑆛𑇀𑆦𑆬𑆽𑆂 𑇆𑇒𑇐𑇆
𑆱𑆽𑆤𑇀𑆣𑆮𑆾𑆥𑆲𑆴𑆠𑆁 𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆲𑆴𑆠𑆁 𑆮𑆼𑆟𑆶𑆓𑆲𑇀𑆮𑆫𑆼 𑇅 𑆩𑆼𑆢𑆾 𑆪𑆑𑆸𑆢𑇀𑆣𑆸𑆠𑆁 𑆖𑆳𑆘𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆩𑆣𑆶 𑇆𑇒𑇑𑇆
𑆫𑆱𑆩𑆳𑆩𑆬𑆑𑆳𑆖𑇀𑆖𑆳𑆥𑆴 𑆥𑆑𑇀𑆮𑆁 𑆱𑆩𑇀𑆪𑆕𑇀𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆑𑆾𑆯𑆼 𑆒𑆢𑆴𑆫𑆤𑆴𑆫𑇀𑆩𑆳𑆟𑆼 𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆚𑇀𑆘𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇆𑇒𑇒𑇆
𑆥𑇀𑆬𑆵𑆲𑆳 𑆪𑆑𑆸𑆖𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆨𑆑𑇀𑆰𑆴𑆠𑆼 𑆇𑆨𑆼 𑆥𑇀𑆫𑆑𑆬𑇀𑆥𑇀𑆪 𑆯𑆷𑆬𑇀𑆪𑆼 𑆔𑆸𑆠𑆠𑆽𑆬𑆱𑆁𑆪𑆶𑆠𑆼 𑇅 𑆠𑆼 𑆱𑆳𑆫𑇀𑆰𑆥𑆱𑇀𑆤𑆼𑆲𑆱𑆩𑆳𑆪𑆶𑆠𑆼𑇁𑆚𑇀𑆘𑆤𑆁 𑆤𑆑𑇀𑆠𑆳𑆤𑇀𑆣𑇀𑆪𑆩𑆳𑆯𑇀𑆮𑆼𑆮 𑆲𑆠𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆼 𑇆𑇒𑇖𑇆
𑆤𑆢𑆵𑆘𑆯𑆴𑆩𑇀𑆧𑆵𑆠𑇀𑆫𑆴𑆑𑆛𑆷𑆤𑇀𑆪𑆡𑆳𑆚𑇀𑆘𑆤𑆁 𑆩𑆤𑆂𑆯𑆴𑆬𑆳 𑆢𑇀𑆮𑆼 𑆖 𑆤𑆴𑆯𑆼 𑆪(𑆯)𑆑𑆸𑆢𑇀𑆓𑆮𑆳𑆩𑇀 𑇅 𑆱𑆖𑆤𑇀𑆢𑆤𑆼𑆪𑆁 𑆓𑆶𑆛𑆴𑆑𑆳𑇁𑆡𑆮𑆳𑇁𑆚𑇀𑆘𑆤𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑆮𑆽 𑆢𑆴𑆮𑆱𑆼𑆰𑇀𑆮𑆥𑆯𑇀𑆪𑆠𑆳𑆩𑇀 𑇆𑇒𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆳𑆥𑇀𑆪𑆳𑆂 𑆒𑆬𑆶 𑆪𑆼 𑆰𑆝𑆳𑆩𑆪𑆳 𑆲𑆫𑆼𑆢𑆱𑆸𑆑𑇀𑆠𑆼𑆰𑆶 𑆱𑆴𑆫𑆳𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆟𑆽𑆂 𑇅 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆥𑆶𑆫𑆳𑆟𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆕𑇀𑆓𑆾𑆥𑆲𑆴𑆠𑆼𑆤 𑆱𑆫𑇀𑆮𑆢𑆳 𑇆𑇒𑇘𑇆
𑆥𑆪𑆾𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆁 𑆥𑆮𑆤𑆾𑆢𑇀𑆨𑆮𑆼 𑆲𑆴𑆠𑆁 𑆮𑆢𑆤𑇀𑆠𑆴 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆠𑆽𑆬𑆩𑆼𑆮 𑆠𑆶 𑇅 𑆨𑆮𑆼𑆢𑇀𑆣𑆸𑆠𑆁 𑆠𑇀𑆫𑆽𑆦𑆬𑆩𑆼𑆮 𑆯𑆾𑆣𑆤𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆯𑆾𑆟𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆫𑆾𑆓𑆪𑆾𑆂 𑇆𑇒𑇙𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆮𑆴𑆫𑆼𑆑𑆂 𑆑𑆦𑆘𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆼 𑆠𑆽𑆬𑆩𑆶𑆯𑆤𑇀𑆠𑆴 𑆠𑆠𑇀𑆑𑆸𑆠𑆩𑇀 𑇅 𑆥𑆶𑆫𑆳𑆟𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆴𑆩𑆴𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆯𑆾 𑆲𑆴𑆠𑆁 𑆨𑆮𑆼𑆢𑆳𑆪𑆱𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆴𑆠𑆩𑇀 𑇆𑇓𑇐𑇆
𑆲𑆴𑆠𑆁 𑆖 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆔𑆸𑆠𑆁 𑆱𑆢𑆳 𑆑𑆸𑆠𑆁 𑆖 𑆪𑆤𑇀𑆩𑆼𑆰𑆮𑆴𑆰𑆳𑆟𑆤𑆳𑆩𑆨𑆴𑆂 𑇅 𑆱𑆢𑆳𑇁𑆮𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆁 𑆱𑆶𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆁 𑆔𑆸𑆠𑆥𑇀𑆫𑆓𑆳𑆞𑆳𑆁 𑆠𑆴𑆩𑆴𑆫𑆼𑇁𑆡 𑆥𑆴𑆠𑇀𑆠𑆘𑆼 𑇆𑇓𑇑𑇆
𑆱𑆩𑆵𑆫𑆘𑆼 𑆠𑆽𑆬𑆪𑆶𑆠𑆳𑆁 𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆼 𑆩𑆣𑆶𑆥𑇀𑆫𑆓𑆳𑆞𑆳𑆁 𑆮𑆴𑆢𑆣𑆵𑆠 𑆪𑆶𑆑𑇀𑆠𑆴𑆠𑆂 𑇅 𑆓𑆮𑆳𑆁 𑆯𑆑𑆸𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆩𑆁 𑆲𑆴𑆠𑆁 𑆠𑆶 𑆠𑆽𑆬𑆁 𑆠𑆴𑆩𑆴𑆫𑆼𑆰𑆶 𑆤𑆳𑆮𑆤𑆩𑇀 𑇆𑇓𑇒𑇆
𑆠𑆤𑇀𑆩𑆳𑆬𑆠𑆵𑆑𑆾𑆫𑆑𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆪𑆶𑆠𑆁 𑆱𑆢𑆳𑇁𑆚𑇀𑆘𑆤𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆴𑆩𑆴𑆫𑆼𑇁𑆡 𑆫𑆳𑆓𑆴𑆟𑆴 𑇅 𑆱𑆶𑆨𑆳𑆮𑆴𑆠𑆁 𑆮𑆳 𑆥𑆪𑆱𑆳 𑆢𑆴𑆤𑆠𑇀𑆫𑆪𑆁 𑆑𑆳𑆖𑆳𑆥𑆲𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆢𑆂 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇓𑇗𑇆
𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆴𑆠𑆳𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆂 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆚𑇀𑆘𑆤𑆁 𑆠𑆤𑇀𑆩𑆣𑆶𑆑𑆼𑆤 𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇅 𑆱𑆩𑆳𑆚𑇀𑆘𑆤𑆁 𑆮𑆳 𑆑𑆤𑆑𑆳𑆫𑆾𑆢𑇀𑆨𑆮𑆁 𑆱𑆶𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆶𑆯𑆤𑇀𑆠𑆴 𑆠𑆢𑇀𑆮𑆴𑆢𑆂 𑇆𑇓𑇙𑇆
𑆨𑆴𑆬𑇀𑆬𑆾𑆛𑆓𑆤𑇀𑆣𑆾𑆢𑆑𑆱𑆼𑆑𑆱𑆼𑆖𑆴𑆠𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆚𑇀𑆘𑆤𑆼 𑆖𑆳𑆠𑇀𑆫 𑆲𑆴𑆠𑆁 𑆠𑆶 𑆠𑆶𑆠𑇀𑆡𑆑𑆩𑇀 𑇅 𑆱𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆳𑆚𑇀𑆘𑆤𑆨𑆳𑆓𑆱𑆩𑇀𑆩𑆴𑆠𑆁 𑆘𑆬𑆾𑆢𑇀𑆨𑆮𑆁 𑆑𑆳𑆖𑆩𑆬𑆁 𑆮𑇀𑆪𑆥𑆾𑆲𑆠𑆴 𑇆𑇔𑇐𑇆
𑆥𑆬𑆳𑆯𑆫𑆾𑆲𑆵𑆠𑆩𑆣𑆷𑆑𑆘𑆳 𑆫𑆱𑆳𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆪𑆶𑆑𑇀𑆠𑆳 𑆩𑆢𑆴𑆫𑆳𑆓𑇀𑆫𑆩𑆴𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑇅 𑆇𑆯𑆵𑆫𑆬𑆾𑆣𑇀𑆫𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆨𑆴𑆂 𑆥𑆖𑆼𑆠𑇀𑆠𑆶 𑆤𑆱𑇀𑆪𑆁 𑆑𑆦𑆫𑆾𑆓𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇔𑇑𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆳𑆜𑆳𑆑𑆴𑆟𑆴𑆲𑆵𑆕𑇀𑆓𑆶𑆢𑆵𑆠𑇀𑆮𑆖𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆢𑇀𑆣𑆷𑆩𑆩𑆶𑆯𑆵𑆫𑆱𑆁𑆪𑆶𑆠𑆳𑆂 𑇅 𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆑𑇀𑆮𑆳𑆡𑆮𑆴𑆥𑆳𑆖𑆴𑆠𑆁 𑆔𑆸𑆠𑆁 𑆲𑆴𑆠𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆤𑆬𑆢𑆼 𑆖 𑆠𑆫𑇀𑆥𑆟𑆩𑇀 𑇆𑇔𑇒𑇆
𑆲𑆴𑆠𑆼 𑆖 𑆑𑆳𑆱𑆵𑆱𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆼 𑆠𑆡𑆳 𑆮𑆢𑆤𑇀𑆠𑆴 𑆥𑆡𑇀𑆪𑆼 𑆓𑆶𑆝𑆤𑆳𑆓𑆫𑆽𑆫𑇀𑆪𑆶𑆠𑆼 𑇅 𑆪𑆢𑆚𑇀𑆘𑆤𑆁 𑆮𑆳 𑆧𑆲𑆶𑆯𑆾 𑆤𑆴𑆰𑆼𑆖𑆴𑆠𑆁 𑆱𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆓𑆼 𑆠𑇀𑆫𑆴𑆦𑆬𑆾𑆢𑆑𑆼 𑆯𑆸𑆠𑆼 𑇆𑇔𑇔𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆳𑆂, 𑆑𑇀𑆰𑆠𑆘𑆾𑆢𑇀𑆨𑆮𑆼 𑆲𑆴𑆠𑆂 𑆑𑇀𑆫𑆩𑆂 𑆥𑆫𑆴𑆩𑇀𑆬𑆳𑆪𑆴𑆤𑆴 𑆖𑆳𑆥𑆴 𑆥𑆴𑆠𑇀𑆠𑆲𑆸𑆠𑇀 𑇅 𑆑𑇀𑆫𑆩𑆾 𑆲𑆴𑆠𑆂 𑆱𑇀𑆪𑆤𑇀𑆢𑆲𑆫𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆂 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆼𑆰𑆶 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆼𑆮 𑆖 𑇆𑇔𑇖𑇆
𑆢𑆾𑆰𑆾𑆢𑆪𑆼 𑆤𑆽𑆮 𑆖 𑆮𑆴𑆥𑇀𑆬𑆠𑆴𑆕𑇀𑆓𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆤𑆱𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆪𑆾𑆘𑆪𑆼𑆢𑇀𑆧𑆶𑆣𑆂 𑇅 𑆥𑆶𑆤𑆯𑇀𑆖 𑆑𑆬𑇀𑆥𑆼𑇁𑆚𑇀𑆘𑆤𑆮𑆴𑆱𑇀𑆠𑆫𑆂 𑆯𑆶𑆨𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇁𑆤𑇀𑆪𑆱𑇀𑆠𑆩𑆥𑆵𑆲 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇔𑇗𑇆
𑆔𑆸𑆠𑆁 𑆥𑆶𑆫𑆳𑆟𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆁 𑆥𑆛𑆾𑆬𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆁 𑆪𑆮𑆳𑆤𑆥𑆴 𑇅 𑆤𑆴𑆰𑆼𑆮𑆩𑆳𑆟𑆱𑇀𑆪 𑆤𑆫𑆱𑇀𑆪 𑆪𑆠𑇀𑆤𑆠𑆾 𑆨𑆪𑆁 𑆱𑆶𑆔𑆾𑆫𑆳𑆠𑇀𑆠𑆴𑆩𑆴𑆫𑆳𑆤𑇀𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑇆𑇔𑇘𑇆
𑆯𑆠𑆳𑆮𑆫𑆵𑆥𑆳𑆪𑆱 𑆍𑆮 𑆑𑆼𑆮𑆬𑆱𑇀𑆠𑆡𑆳 𑆑𑆸𑆠𑆾 𑆮𑆳𑇁𑇁𑆩𑆬𑆑𑆼𑆰𑆶 𑆥𑆳𑆪𑆱𑆂 𑇅 𑆥𑇀𑆫𑆨𑆷𑆠𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆾𑆢𑆑𑆾𑆠𑇀𑆠𑆫𑆾 𑆪𑆮𑆿𑆢𑆤𑆾 𑆮𑆳 𑆠𑆴𑆩𑆴𑆫𑆁 𑆮𑇀𑆪𑆥𑆾𑆲𑆠𑆴 𑇆𑇔𑇙𑇆
𑆥𑆛𑆾𑆬𑆑𑆫𑇀𑆑𑆾𑆛𑆑𑆑𑆳𑆫𑆮𑆼𑆬𑇀𑆬𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆶𑆠𑆫𑇀𑆑𑆳𑆫𑆴𑆑𑆫𑆵𑆫𑆘𑆳𑆤𑆴 𑇅 𑆯𑆳𑆑𑆳𑆤𑆴 𑆯𑆴𑆓𑇀𑆫𑇀𑆮𑆳𑆫𑇀𑆠𑆓𑆬𑆳𑆤𑆴 𑆖𑆽𑆮 𑆲𑆴𑆠𑆳𑆤𑆵 𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑇀𑆔𑆸𑆠𑆱𑆳𑆣𑆴𑆠𑆳𑆤𑆴 𑇆𑇕𑇑𑇆
𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆁 𑆠𑆴𑆩𑆴𑆫𑆼 𑆫𑆳𑆓𑆩𑆳𑆓𑆠𑆼 𑇅 𑆪𑆤𑇀𑆠𑇀𑆫𑆼𑆟𑆾𑆠𑇀𑆥𑆵𑆝𑆴𑆠𑆾 𑆢𑆾𑆰𑆾 𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆢𑆳𑆯𑆶 𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇆𑇕𑇒𑇆
𑆃𑆫𑆳𑆓𑆴 𑆠𑆴𑆩𑆴𑆫𑆁 𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆢𑇀𑆪𑆁 𑆥𑆛𑆬𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀 𑇅 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆫𑆳𑆓𑆴 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆸𑆠𑆵𑆪𑆼 𑆪𑆳𑆥𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇕𑇓𑇆
𑆫𑆳𑆓𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼𑆰𑇀𑆮𑆥𑆴 𑆲𑆴𑆠𑆳𑆱𑇀𑆠𑆴𑆩𑆴𑆫𑆼𑆰𑆶 𑆠𑆡𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑇅 𑆪𑆳𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆱𑆼𑆮𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆘𑆬𑆿𑆑𑆱𑆂 𑇆𑇕𑇔𑇆
𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆬𑆴𑆕𑇀𑆓𑆤𑆳𑆯𑆼 𑆠𑆶 𑆑𑆫𑇀𑆩 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆴𑆢𑇀𑆣𑆪𑆼 𑇅 𑆤 𑆖𑆼𑆢𑆫𑇀𑆣𑆼𑆤𑇀𑆢𑆶𑆔𑆫𑇀𑆩𑆳𑆩𑇀𑆧𑆶𑆧𑆴𑆤𑇀𑆢𑆶𑆩𑆶𑆑𑇀𑆠𑆳𑆑𑆸𑆠𑆴𑆂 𑆱𑇀𑆡𑆴𑆫𑆂 𑇆𑇕𑇕𑇆
𑆮𑆴𑆰𑆩𑆾 𑆮𑆳 𑆠𑆤𑆶𑆫𑇀𑆩𑆣𑇀𑆪𑆼 𑆫𑆳𑆘𑆴𑆩𑆳𑆤𑇀 𑆮𑆳 𑆧𑆲𑆶𑆥𑇀𑆫𑆨𑆂 𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆱𑇀𑆡𑆾 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆢𑆾𑆰𑆂 𑆱𑆫𑆶𑆘𑆾 𑆮𑆳 𑆱𑆬𑆾𑆲𑆴𑆠𑆂 𑇆𑇕𑇖𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆠𑆱𑇀𑆪𑆳𑆡 𑆑𑆳𑆬𑆼 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆯𑆵𑆠𑆬𑆼 𑇅 𑆪𑆤𑇀𑆠𑇀𑆫𑆴𑆠𑆱𑇀𑆪𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑆱𑇀𑆮𑆳𑆁 𑆤𑆳𑆱𑆳𑆁 𑆥𑆯𑇀𑆪𑆠𑆂 𑆱𑆩𑆩𑇀 𑇆𑇕𑇗𑇆

𑆠𑇀𑆫𑇀𑆪𑆮𑆱𑇀𑆡𑆯𑇀𑆖 𑆩𑆢𑆾 𑆘𑇀𑆚𑆼𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆾 𑆩𑆣𑇀𑆪𑆾𑇁𑆡 𑆥𑆯𑇀𑆖𑆴𑆩𑆂 𑇅 𑆥𑆷𑆫𑇀𑆮𑆼 𑆮𑆵𑆫𑇀𑆪𑆫𑆠𑆴𑆥𑇀𑆫𑆵𑆠𑆴𑆲𑆫𑇀𑆰𑆨𑆳𑆰𑇀𑆪𑆳𑆢𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇑𑇑𑇆
𑆥𑇀𑆫𑆬𑆳𑆥𑆾 𑆩𑆣𑇀𑆪𑆩𑆼 𑆩𑆾𑆲𑆾 𑆪𑆶𑆑𑇀𑆠𑆳𑆪𑆶𑆑𑇀𑆠𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑇅 𑆮𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑆥𑆯𑇀𑆖𑆴𑆩𑆼 𑆯𑆼𑆠𑆼 𑆤𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆑𑇀𑆫𑆴𑆪𑆳𑆓𑆶𑆟𑆂 𑇆𑇑𑇒𑇆
𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆳𑆤𑆬𑇀𑆥𑆥𑆴𑆠𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆾𑆥𑆱𑆼𑆮𑆴𑆤𑆂 𑇅 𑆥𑆳𑆤𑆁 𑆤 𑆧𑆳𑆣𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆁𑆱𑇀𑆠𑆶 𑆧𑆳𑆣𑆠𑆼 𑇆𑇑𑇓𑇆
𑆤𑆴𑆫𑇀𑆨𑆑𑇀𑆠𑆩𑆼𑆑𑆳𑆤𑇀𑆠𑆠 𑆍𑆮 𑆩𑆢𑇀𑆪𑆁 𑆤𑆴𑆰𑆼𑆮𑇀𑆪𑆩𑆳𑆟𑆁 𑆩𑆤𑆶𑆘𑆼𑆤 𑆤𑆴𑆠𑇀𑆪𑆩𑇀 𑇅 𑆇𑆠𑇀𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑆑𑆰𑇀𑆛𑆠𑆩𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆳𑆥𑆳𑆢𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆯𑆫𑆵𑆫𑆩𑆼𑆢𑆩𑇀 𑇆𑇑𑇔𑇆
𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆼𑆤 𑆨𑆵𑆠𑆼𑆤 𑆥𑆴𑆥𑆳𑆱𑆴𑆠𑆼𑆤 𑆯𑆾𑆑𑆳𑆨𑆴𑆠𑆥𑇀𑆠𑆼𑆤 𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆼𑆤 𑇅 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆨𑆳𑆫𑆳𑆣𑇀𑆮𑆥𑆫𑆴𑆑𑇀𑆰𑆠𑆼𑆤 𑆮𑆼𑆓𑆳𑆮𑆫𑆾𑆣𑆳𑆨𑆴𑆲𑆠𑆼𑆤 𑆖𑆳𑆥𑆴 𑇆𑇑𑇕𑇆
𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆁 𑆥𑆫𑆩𑆢𑆁 𑆥𑆳𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇅 𑆥𑆳𑆤𑆮𑆴𑆨𑇀𑆫𑆩𑆩𑆶𑆓𑇀𑆫𑆁 𑆖 𑆠𑆼𑆰𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆩𑆴 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇑𑇗𑇆
𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆲𑆸𑆢𑆪𑆓𑇀𑆫𑆲𑆠𑆾𑆢𑆑𑆩𑇀𑆥𑆳𑆂 𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆼𑇁𑆤𑆴𑆬𑆑𑆸𑆠𑆼 𑆯𑆴𑆫𑆱𑆾 𑆫𑆶𑆘𑆯𑇀𑆖 𑇅 𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆬𑆳𑆥𑆩𑆶𑆒𑆯𑆾𑆰𑆟𑆢𑆳𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀𑆩𑆑𑆼 𑆮𑆢𑆤𑆬𑆾𑆖𑆤𑆥𑆵𑆠𑆠𑆳 𑆖 𑇆𑇑𑇘𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑇀𑆩𑆑𑆼 𑆮𑆩𑆡𑆶𑆯𑆵𑆠𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆼 𑆨𑆮𑆠𑆴 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑇀𑆥𑆠𑇀 𑇅 𑆈𑆰𑇀𑆩𑆳𑆟𑆩𑆕𑇀𑆓𑆓𑆶𑆫𑆶𑆠𑆳𑆁 𑆮𑆴𑆫𑆱𑆳𑆤𑆤𑆠𑇀𑆮𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆣𑆴𑆑𑆠𑇀𑆮𑆩𑆫𑆶𑆖𑆴𑆁 𑆩𑆬𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆩𑇀 𑇆𑇑𑇙𑇆
𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑆫𑆱𑇀𑆪 𑆠𑆶 𑆩𑆢𑆱𑇀𑆪 𑆮𑆢𑆤𑇀𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆫𑆶𑆘𑆳𑆁 𑆯𑆴𑆫𑆱𑆴 𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆖𑆳𑆥𑆴 𑆨𑆼𑆢𑆩𑇀 𑇅 𑆄𑆣𑇀𑆩𑆳𑆤𑆩𑆶𑆢𑇀𑆓𑆴𑆫𑆟𑆩𑆩𑇀𑆬𑆫𑆱𑆾 𑆮𑆴𑆢𑆳𑆲𑆾𑇁𑆘𑆵𑆫𑇀𑆟𑆱𑇀𑆪 𑆥𑆳𑆤𑆘𑆤𑆴𑆠𑆱𑇀𑆪 𑆮𑆢𑆤𑇀𑆠𑆴 𑆬𑆴𑆕𑇀𑆓𑆩𑇀 𑇆𑇒𑇐𑇆
𑆘𑇀𑆚𑆼𑆪𑆳𑆤𑆴 𑆠𑆠𑇀𑆫 𑆨𑆴𑆰𑆘𑆳 𑆱𑆶𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆳𑆤𑆴 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆘𑆤𑆴𑆠𑆳𑆤𑆴 𑆖 𑆑𑆳𑆫𑆟𑆳𑆤𑆴 𑇅 𑆲𑆸𑆢𑇀𑆓𑆳𑆠𑇀𑆫𑆠𑆾𑆢𑆮𑆩𑆡𑆶𑆘𑇀𑆮𑆫𑆑𑆟𑇀𑆜𑆣𑆷𑆩𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆑𑆦𑆱𑇀𑆫𑆮𑆟𑆩𑆷𑆫𑇀𑆣𑆫𑆶𑆘𑆾 𑆮𑆴𑆢𑆳𑆲𑆂 𑇆𑇒𑇑𑇆
𑆢𑇀𑆮𑆼𑆰𑆂 𑆱𑆶𑆫𑆳𑆤𑇀𑆤𑆮𑆴𑆑𑆸𑆠𑆼𑆰𑆶 𑆖 𑆠𑆼𑆰𑆶 𑆠𑆼𑆰𑆶 𑆠𑆁 𑆥𑆳𑆤𑆮𑆴𑆨𑇀𑆫𑆩𑆩𑆶𑆯𑆤𑇀𑆠𑇀𑆪𑆒𑆴𑆬𑆼𑆤 𑆣𑆵𑆫𑆳𑆂 𑇅 𑆲𑆵𑆤𑆾𑆠𑇀𑆠𑆫𑆿𑆰𑇀𑆜𑆩𑆠𑆴𑆯𑆵𑆠𑆩𑆩𑆤𑇀𑆢𑆢𑆳𑆲𑆁 𑆠𑆽𑆬𑆥𑇀𑆫𑆨𑆳𑆱𑇀𑆪𑆩𑆠𑆴(𑆥𑆴)𑆥𑆳𑆤𑆲𑆠𑆁 𑆮𑆴𑆘𑆲𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆘𑆴𑆲𑇀𑆮𑆿𑆰𑇀𑆜𑆢𑆤𑇀𑆠𑆩𑆱𑆴𑆠𑆁 𑆠𑇀𑆮𑆡𑆮𑆳𑇁𑆥𑆴 𑆤𑆵𑆬𑆁 𑆥𑆵𑆠𑆼 𑆖 𑆪𑆱𑇀𑆪 𑆤𑆪𑆤𑆼 𑆫𑆶𑆣𑆴𑆫𑆥𑇀𑆫𑆨𑆼 𑆖 𑇅 𑆲𑆴𑆑𑇀𑆑𑆳𑆘𑇀𑆮𑆫𑆿 𑆮𑆩𑆡𑆶𑆮𑆼𑆥𑆡𑆶𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆳𑆂 𑆑𑆳𑆱𑆨𑇀𑆫𑆩𑆳𑆮𑆥𑆴 𑆖 𑆥𑆳𑆤𑆲𑆠𑆁 𑆨𑆘𑆤𑇀𑆠𑆼 𑇆𑇒𑇓𑇆
𑆠𑆼𑆰𑆳𑆁 𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑆴𑆢𑆁 𑆲𑆴 𑆩𑆪𑆾𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆑𑇀𑆠𑆳𑆨𑆴𑆣𑆳𑆤𑆩𑆒𑆴𑆬𑆼𑆤 𑆮𑆴𑆣𑆴𑆁 𑆤𑆴𑆧𑆾𑆣 𑇅 𑆩𑆢𑇀𑆪𑆁 𑆠𑆶 𑆖𑆶𑆑𑇀𑆫𑆩𑆫𑆴𑆖𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆢𑆵𑆥𑇀𑆪𑆑𑆶𑆰𑇀𑆜𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆳𑆪𑆶𑆠𑆩𑆬𑆁 𑆥𑆮𑆤𑆱𑇀𑆪 𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆽 𑇆𑇒𑇔𑇆
𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆢𑆵𑆥𑇀𑆪𑆑𑆩𑆲𑆿𑆰𑆣𑆲𑆴𑆕𑇀𑆓𑆶𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆼𑆤 𑆖 𑆪𑆶𑆠𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀 𑆱𑆶𑆒𑆳𑆪 𑇅 𑆄𑆩𑇀𑆫𑆳𑆠𑆑𑆳𑆩𑇀𑆫𑆦𑆬𑆢𑆳𑆝𑆴𑆩𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆽𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆶𑆨𑆳𑆤𑇀𑆪𑆥𑆴 𑆖 𑆰𑆳𑆝𑆮𑆥𑆳𑆤𑆑𑆳𑆤𑆴 𑇆𑇒𑇕𑇆
𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆼 𑆑𑆦𑆑𑆸𑆠𑆼 𑆑𑆦𑆩𑆶𑆬𑇀𑆬𑆴𑆒𑆼𑆖𑇀𑆖 𑆩𑆢𑇀𑆪𑆼𑆤 𑆧𑆴𑆩𑇀𑆧𑆴𑆮𑆴𑆢𑆶𑆬𑆾𑆢𑆑𑆱𑆁𑆪𑆶𑆠𑆼𑆤 𑇅 𑆱𑆼𑆮𑆼𑆠 𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆳𑆁𑆯𑇀𑆖 𑆫𑆱𑆳𑆤𑆶𑆢𑆳𑆫𑆳𑆤𑇀 𑆪𑆷𑆰𑆳𑆁𑆯𑇀𑆖 𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑇀 𑆲𑆴𑆠𑆳𑆪 𑇆𑇒𑇘𑇆
𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆩𑆤𑇀𑆪𑆢𑆥𑆴 𑆪𑆖𑇀𑆖 𑆱𑆩𑆓𑇀𑆫𑆩𑆓𑇀𑆫𑇀𑆪𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆪𑆖𑇀𑆖 𑆩𑆤𑆱𑆾 𑆩𑆢𑆑𑆸𑆠𑇀 𑆱𑆶𑆒𑆁 𑆖 𑇅 𑆠𑇀𑆮𑆕𑇀𑆓𑆳𑆓𑆥𑆶𑆰𑇀𑆥𑆩𑆓𑆣𑆽𑆬𑆩𑆣𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆽𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑆘𑆳𑆘𑆴𑆩𑆫𑆴𑆖𑆽𑆯𑇀𑆖 𑆑𑆸𑆠𑆁 𑆱𑆩𑆳𑆁𑆯𑆽𑆂 𑇆𑇓𑇐𑇆
𑆥𑆳𑆤𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆫𑆱𑆮𑆳𑆫𑆴𑆥𑆫𑆷𑆰𑆑𑆳𑆞𑇀𑆪𑆁 𑆥𑆳𑆤𑆳𑆠𑇀𑆪𑆪𑆼𑆰𑆶 𑆮𑆴𑆣𑆴𑆮𑆠𑇀𑆱𑇀𑆫𑆶𑆠𑆩𑆩𑇀𑆧𑆫𑆳𑆤𑇀𑆠𑆼 𑇅 𑆲𑇀𑆫𑆵𑆮𑆼𑆫𑆥𑆢𑇀𑆩𑆥𑆫𑆴𑆥𑆼𑆬𑆮𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆂 𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑇀𑆮𑆴𑆬𑆴𑆥𑇀𑆪 𑆑𑆫𑆮𑆵𑆫𑆘𑆬𑆾𑆢𑇀𑆨𑆮𑆽𑆯𑇀𑆖 𑇆𑇓𑇑𑇆
𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆱𑆥𑆢𑇀𑆩𑆑𑆪𑆶𑆠𑆽𑆫𑆥𑆴 𑆱𑆳𑆫𑆴𑆮𑆳𑆢𑇀𑆪𑆽𑆂 𑆱𑆼𑆑𑆁 𑆘𑆬𑆽𑆯𑇀𑆖 𑆮𑆴𑆠𑆫𑆼𑆢𑆩𑆬𑆽𑆂 𑆱𑆶𑆯𑆵𑆠𑆽𑆂 𑇅 𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆖𑆾𑆖𑆩𑆫𑆴𑆖𑆽𑆬𑆨𑆶𑆘𑆕𑇀𑆓𑆥𑆶𑆰𑇀𑆥𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑆑𑆥𑇀𑆫𑆱𑆮𑆮𑆬𑇀𑆑𑆓𑆶𑆝𑆽𑆫𑆶𑆥𑆼𑆠𑆩𑇀 𑇆𑇓𑇒𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆪𑆶𑆠𑆁 𑆲𑆸𑆠𑆩𑆬𑆁 𑆩𑆢𑆴𑆫𑆳𑆩𑆪𑆳𑆫𑇀𑆠𑆽𑆱𑇀𑆠𑆠𑇀𑆥𑆳𑆤𑆑𑆁 𑆯𑆶𑆖𑆴 𑆱𑆶𑆓𑆤𑇀𑆣𑆴 𑆤𑆫𑆽𑆫𑇀𑆤𑆴𑆰𑆼𑆮𑇀𑆪𑆩𑇀 𑇅 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑆴𑆧𑆼𑆖𑇀𑆖 𑆩𑆣𑆶𑆑𑆁 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆁 𑆖 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆖 𑆩𑆷𑆬𑆩𑆱𑆑𑆸𑆠𑇀 𑆠𑇀𑆫𑆥𑆶𑆰𑆵𑆨𑆮𑆁 𑆪𑆠𑇀 𑇆𑇓𑇓𑇆
𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆴𑆤𑆵𑆩𑆡 𑆖 𑆤𑆳𑆓𑆧𑆬𑆳𑆁 𑆖 𑆠𑆶𑆬𑇀𑆪𑆳𑆁 𑆥𑆵𑆠𑇀𑆮𑆳 𑆱𑆶𑆒𑆵 𑆨𑆮𑆠𑆴 𑆱𑆳𑆣𑆶 𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆁 𑆖 𑇅𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆢𑆳𑆫𑆶𑆮𑆴𑆝𑆢𑆳𑆝𑆴𑆩𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆰𑆶 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆱𑆶 𑆑𑆸𑆠𑆩𑆩𑇀𑆧𑆶𑆤𑆴 𑆥𑆳𑆤𑆑𑆁 𑆪𑆠𑇀 𑇆𑇓𑇔𑇆
𑆠𑆢𑇀𑆧𑆵𑆘𑆥𑆷𑆫𑆑𑆫𑆱𑆳𑆪𑆶𑆠𑆩𑆳𑆯𑆶 𑆥𑆵𑆠𑆁 𑆯𑆳𑆤𑇀𑆠𑆴𑆁 𑆥𑆫𑆳𑆁 𑆥𑆫𑆩𑆢𑆼 𑆠𑇀𑆮𑆖𑆴𑆫𑆳𑆠𑇀 𑆑𑆫𑆾𑆠𑆴 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆱𑆴𑆠𑆳𑆩𑆣𑆶𑆑𑆘𑆵𑆫𑆑𑆣𑆳𑆤𑇀𑆪𑆑𑆸𑆰𑇀𑆟𑆳𑆱𑇀𑆮𑆼𑆮𑆁 𑆑𑆸𑆠𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆪𑆳 𑆖 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆡𑆽𑆮 𑇆𑇓𑇕𑇆

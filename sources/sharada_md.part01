𑆯𑆫𑇀𑆑𑆫𑆳𑆠𑆴𑆮𑆴𑆰𑆼 𑆢𑆼𑆪𑆼 𑆩𑆳𑆪𑆷𑆫𑆼 𑆱𑆩𑆲𑆿𑆰𑆣𑆼 𑇅 𑆥𑆳𑆫𑇀𑆰𑆠𑆼 𑆖𑆳𑆥𑆴 𑆢𑆼𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆱𑆩𑆲𑆿𑆰𑆣𑆳𑆂 𑇆𑇘𑇓𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆂 𑆱𑆔𑆸𑆠𑆯𑇀𑆖𑆽𑆮 𑆯𑆴𑆩𑇀𑆧𑆵𑆪𑆷𑆰𑆾 𑆲𑆴𑆠𑆂 𑆱𑆢𑆳 𑇅 𑆮𑆴𑆰𑆔𑇀𑆤𑆳𑆤𑆴 𑆖 𑆱𑆼𑆮𑆼𑆠 𑆨𑆑𑇀𑆰𑇀𑆪𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇘𑇔𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆣𑆶𑆑𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆳𑆩𑇀𑆧𑆶𑆨𑆴𑆂 𑇅 𑆗𑆫𑇀𑆢𑆪𑆼𑆢𑇀𑆓𑆶𑆥𑇀𑆠𑆲𑆸𑆢𑆪𑆾 𑆨𑆑𑇀𑆰𑆴𑆠𑆁 𑆪𑆢𑆴 𑆮𑆽 𑆮𑆴𑆰𑆩𑇀 𑇆𑇘𑇕𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆡𑆳𑆮𑆫𑆮𑆴𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑇀𑆡𑆳𑆮𑆫𑆁 𑆘𑆕𑇀𑆓𑆩𑆁 𑆖𑆽𑆮 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆮𑆴𑆰𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆢𑆯𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆳𑆢𑇀𑆪𑆁 𑆠𑆶 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆰𑆾𑆝𑆯𑆳𑆯𑇀𑆫𑆪𑆩𑇀 𑇆𑇓𑇆
𑆩𑆷𑆬𑆁 𑆥𑆠𑇀𑆫𑆁 𑆦𑆬𑆁 𑆥𑆶𑆰𑇀𑆥𑆁 𑆠𑇀𑆮𑆑𑇀 𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆳𑆫 𑆍𑆮 𑆖 𑇅 𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆾 𑆣𑆳𑆠𑆮𑆯𑇀𑆖𑆽𑆮 𑆑𑆤𑇀𑆢𑆯𑇀𑆖 𑆢𑆯𑆩𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫, 𑆑𑇀𑆬𑆵𑆠𑆑𑆳𑆯𑇀𑆮𑆩𑆳𑆫𑆓𑆶𑆚𑇀𑆘𑆳𑆱𑆶𑆓𑆤𑇀𑆣𑆓𑆫𑇀𑆓𑆫𑆑𑆑𑆫𑆔𑆳𑆛𑆮𑆴𑆢𑇀𑆪𑆶𑆖𑇀𑆗𑆴𑆒𑆳𑆮𑆴𑆘𑆪𑆳𑆤𑆵𑆠𑇀𑆪𑆰𑇀𑆛𑆿 𑆩𑆷𑆬𑆮𑆴𑆰𑆳𑆟𑆴; 𑆮𑆴𑆰𑆥𑆠𑇀𑆫𑆴𑆑𑆳𑆬𑆩𑇀𑆧𑆳𑆮𑆫𑆢𑆳𑆫𑆶𑆑𑆫𑆩𑇀𑆨𑆩𑆲𑆳𑆑𑆫𑆩𑇀𑆨𑆳𑆟𑆴 𑆥𑆚𑇀𑆖 𑆥𑆠𑇀𑆫𑆮𑆴𑆰𑆳𑆟𑆴; 𑆑𑆶𑆩𑆶𑆢𑇀𑆮𑆠𑆵𑆮𑆼𑆟𑆶𑆑𑆳𑆑𑆫𑆩𑇀𑆨𑆩𑆲𑆳𑆑𑆫𑆩𑇀𑆨𑆑𑆫𑇀𑆑𑆾𑆛𑆑𑆫𑆼𑆟𑆶𑆑𑆒𑆢𑇀𑆪𑆾𑆠𑆑𑆖𑆫𑇀𑆩𑆫𑆵𑆨𑆓𑆤𑇀𑆣𑆳𑆱𑆫𑇀𑆥𑆔𑆳𑆠𑆴𑆤𑆤𑇀𑆢𑆤𑆱𑆳𑆫𑆥𑆳𑆑𑆳𑆤𑆵𑆠𑆴 𑆢𑇀𑆮𑆳𑆢𑆯 𑆦𑆬𑆮𑆴𑆰𑆳𑆟𑆴; 𑆮𑆼𑆠𑇀𑆫𑆑𑆳𑆢𑆩𑇀𑆧𑆮𑆬𑇀𑆬𑆵𑆘𑆑𑆫𑆩𑇀𑆨𑆩𑆲𑆳𑆑𑆫𑆩𑇀𑆨𑆳𑆟𑆴 𑆥𑆚𑇀𑆖 𑆥𑆶𑆰𑇀𑆥𑆮𑆴𑆰𑆳𑆟𑆴; 𑆃𑆤𑇀𑆠𑇀𑆫𑆥𑆳𑆖𑆑𑆑𑆫𑇀𑆠𑆫𑆵𑆪𑆱𑆿𑆫𑆵𑆪𑆑𑆑𑆫𑆔𑆳𑆛𑆑𑆫𑆩𑇀𑆨𑆤𑆤𑇀𑆢𑆤𑆤𑆳𑆫𑆳𑆖𑆑𑆳𑆤𑆴 𑆱𑆥𑇀𑆠 𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆮𑆴𑆰𑆳𑆟𑆴; 𑆑𑆶𑆩𑆶𑆢𑆔𑇀𑆤𑆵𑆱𑇀𑆤𑆶𑆲𑆵𑆘𑆳𑆬𑆑𑇀𑆰𑆵𑆫𑆵𑆟𑆴 𑆠𑇀𑆫𑆵𑆟𑆴 𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆰𑆳𑆟𑆴; 𑆦𑆼𑆤𑆳𑆯𑇀𑆩(𑆨𑆱𑇀𑆩) 𑆲𑆫𑆴𑆠𑆳𑆬𑆁 𑆖 𑆢𑇀𑆮𑆼 𑆣𑆳𑆠𑆶𑆮𑆴𑆰𑆼; 𑆑𑆳𑆬𑆑𑆷𑆛𑆮𑆠𑇀𑆱𑆤𑆳𑆨𑆱𑆫𑇀𑆰𑆥𑆥𑆳𑆬𑆑𑆑𑆫𑇀𑆢𑆩𑆑𑆮𑆽𑆫𑆳𑆛𑆑𑆩𑆶𑆱𑇀𑆠𑆑𑆯𑆸𑆕𑇀𑆓𑆵𑆮𑆴𑆰𑆥𑇀𑆫𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆩𑆷𑆬𑆑𑆲𑆳𑆬𑆳𑆲𑆬𑆩𑆲𑆳𑆮𑆴𑆰𑆑𑆫𑇀𑆑𑆛𑆑𑆳𑆤𑆵𑆠𑆴 𑆠𑇀𑆫𑆪𑆾𑆢𑆯 𑆑𑆤𑇀𑆢𑆮𑆴𑆰𑆳𑆟𑆴; 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆥𑆚𑇀𑆖𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀 𑆱𑇀𑆡𑆳𑆮𑆫𑆮𑆴𑆰𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇕𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆮𑆠𑇀𑆱𑆤𑆳𑆨𑆳𑆤𑆴 𑆩𑆶𑆱𑇀𑆠𑆑𑆼 𑆢𑇀𑆮𑆼 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆼 𑇅 𑆰𑆛𑇀 𑆖𑆽𑆮 𑆱𑆫𑇀𑆰𑆥𑆳𑆟𑇀𑆪𑆳𑆲𑆶𑆂 𑆯𑆼𑆰𑆳𑆟𑇀𑆪𑆼𑆑𑆽𑆑𑆩𑆼𑆮 𑆠𑆶 𑇆𑇖𑇆
𑆇𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆩𑆷𑆬𑆮𑆴𑆰𑆽𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆾 𑆩𑆾𑆲 𑆍𑆮 𑆖 𑇅 𑆘𑆸𑆩𑇀𑆨𑆳𑆕𑇀𑆓𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆯𑇀𑆮𑆳𑆱𑆳 𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑆠𑇀𑆫𑆮𑆴𑆰𑆼𑆟 𑆠𑆶 𑇆𑇗𑇆
𑆩𑆶𑆰𑇀𑆑𑆯𑆾𑆦𑆂 𑆦𑆬𑆮𑆴𑆰𑆽𑆫𑇀𑆢𑆳𑆲𑆾𑇁𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰 𑆍𑆮 𑆖 𑇅 𑆨𑆮𑆼𑆠𑇀 𑆥𑆶𑆰𑇀𑆥𑆮𑆴𑆰𑆽𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆩𑆾𑆲 𑆍𑆮 𑆖 𑇆𑇘𑇆
𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆮𑆴𑆰𑆽𑆫𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆄𑆱𑇀𑆪𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆯𑆴𑆫𑆾𑆫𑆶𑆑𑇀𑆑𑆦𑆱𑆁𑆱𑇀𑆫𑆮𑆳𑆂 𑇆𑇙𑇆
𑆦𑆼𑆤𑆳𑆓𑆩𑆂 𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆰𑆽𑆫𑇀𑆮𑆴𑆝𑇀𑆨𑆼𑆢𑆾 𑆓𑆶𑆫𑆶𑆘𑆴𑆲𑇀𑆮𑆠𑆳 𑇅 𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆤𑆁 𑆣𑆳𑆠𑆶𑆮𑆴𑆰𑆽𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆢𑆳𑆲𑆯𑇀𑆖 𑆠𑆳𑆬𑆶𑆤𑆴 𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆑𑆳𑆬𑆔𑆳𑆠𑆵𑆤𑆴 𑆮𑆴𑆰𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇅𑇑𑇑𑇅 𑆑𑆤𑇀𑆢𑆘𑆳𑆤𑆴 𑆠𑆶 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆠𑆼𑆰𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆩𑇀 𑇆𑇑𑇑𑇆
𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆘𑇀𑆚𑆳𑆤𑆁 𑆑𑆳𑆬𑆑𑆷𑆛𑆼 𑆮𑆼𑆥𑆡𑆶𑆂 𑆱𑇀𑆠𑆩𑇀𑆨 𑆍𑆮 𑆖 𑇅 𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆾 𑆮𑆠𑇀𑆱𑆤𑆳𑆨𑆼 𑆥𑆵𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆠𑆳 𑇆𑇑𑇒𑇆
𑆱𑆫𑇀𑆰𑆥𑆼 𑆮𑆳𑆠𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆳𑆤𑆳𑆲𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆘𑆤𑇀𑆩 𑆖 𑇅 𑆓𑇀𑆫𑆵𑆮𑆳𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆮𑆳𑆑𑇀𑆱𑆕𑇀𑆓𑆿 𑆥𑆳𑆬𑆑𑆼𑇁𑆤𑆶𑆩𑆠𑆳𑆮𑆴𑆲 𑇆𑇑𑇓𑇆
𑆥𑇀𑆫𑆱𑆼𑆑𑆂 𑆑𑆫𑇀𑆢𑆩𑆳𑆒𑇀𑆪𑆼𑆤 𑆮𑆴𑆝𑇀𑆨𑆼𑆢𑆾 𑆤𑆼𑆠𑇀𑆫𑆥𑆵𑆠𑆠𑆳 𑇅 𑆮𑆽𑆫𑆳𑆛𑆑𑆼𑆤𑆳𑆕𑇀𑆓𑆢𑆶𑆂𑆒𑆁 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆯𑇀𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇔𑇆
𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆠𑆩𑇀𑆨𑆾 𑆮𑆼𑆥𑆡𑆶𑆯𑇀𑆖 𑆘𑆳𑆪𑆠𑆼 𑆩𑆶𑆱𑇀𑆠𑆑𑆼𑆤 𑆠𑆶 𑇅 𑆯𑆸𑆕𑇀𑆓𑆵𑆮𑆴𑆰𑆼𑆟𑆳𑆕𑇀𑆓𑆱𑆳𑆢𑆢𑆳𑆲𑆾𑆢𑆫𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆪𑆂 𑇆𑇑𑇕𑇆
𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆼𑆟 𑆫𑆑𑇀𑆠𑆠𑇀𑆮𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆱𑇀𑆠𑆡𑆾𑆢𑆫𑆼 𑇅 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆩𑆷𑆬𑆑𑆽𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑆾𑆦𑆥𑇀𑆫𑆩𑆷𑆞𑆠𑆳𑆂 𑇆𑇑𑇖𑇆
𑆖𑆴𑆫𑆼𑆟𑆾𑆖𑇀𑆗𑇀𑆮𑆱𑆴𑆠𑆴 𑆯𑇀𑆪𑆳𑆮𑆾 𑆤𑆫𑆾 𑆲𑆳𑆬𑆳𑆲𑆬𑆼𑆤 𑆮𑆽 𑇅 𑆩𑆲𑆳𑆮𑆴𑆰𑆼𑆟 𑆲𑆸𑆢𑆪𑆼 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆯𑆷𑆬𑆾𑆢𑇀𑆓𑆩𑆿 𑆨𑆸𑆯𑆩𑇀 𑇆𑇑𑇗𑇆
𑆑𑆫𑇀𑆑𑆛𑆼𑆤𑆾𑆠𑇀𑆥𑆠𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆲𑆱𑆤𑇀 𑆢𑆤𑇀𑆠𑆳𑆤𑇀 𑆢𑆯𑆠𑇀𑆪𑆥𑆴 𑇅𑇑𑇘𑇅 𑆑𑆤𑇀𑆢𑆘𑆳𑆤𑇀𑆪𑆶𑆓𑇀𑆫𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆠𑇀𑆫𑆪𑆾𑆢𑆯 𑇆𑇑𑇘𑇆
𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆑𑆶𑆯𑆬𑆽𑆫𑇀𑆘𑇀𑆚𑆼𑆪𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆢𑆯𑆨𑆴𑆫𑇀𑆓𑆶𑆟𑆽𑆂 𑇅𑇑𑇙𑇅 𑆫𑆷𑆑𑇀𑆰𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆡𑆳 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆩𑆳𑆯𑆶𑆮𑇀𑆪𑆮𑆳𑆪𑆴 𑆖 𑇆𑇑𑇙𑇆
𑆮𑆴𑆑𑆳𑆯𑆴 𑆮𑆴𑆯𑆢𑆁 𑆖𑆽𑆮 𑆬𑆔𑇀𑆮𑆥𑆳𑆑𑆴 𑆖 𑆠𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆠𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀 𑆑𑆾𑆥𑆪𑆼𑆢𑇀𑆮𑆳𑆪𑆶𑆩𑆿𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆯𑆾𑆟𑆴𑆠𑆩𑇀 𑇆𑇒𑇐𑇆
𑆩𑆠𑆴𑆁 𑆖 𑆩𑆾𑆲𑆪𑆼𑆠𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆤𑇀𑆩𑆫𑇀𑆩𑆧𑆤𑇀𑆣𑆳𑆤𑇀 𑆗𑆴𑆤𑆠𑇀𑆠𑆴 𑆖 𑇅 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆳𑆤𑇀 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆴𑆯𑆼𑆢𑇀𑆮𑆴𑆑𑆫𑆾𑆠𑆴 𑆖 𑇆𑇒𑇑𑇆
𑆄𑆯𑆶𑆠𑇀𑆮𑆳𑆢𑆳𑆯𑆶 𑆠𑆢𑇀𑆣𑆤𑇀𑆠𑆴 𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆨𑆘𑆼𑆠𑇀 𑇅 𑆑𑇀𑆰𑆥𑆪𑆼𑆖𑇀𑆖 𑆮𑆴𑆑𑆳𑆯𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆤𑇀𑆣𑆳𑆠𑆷𑆤𑇀𑆩𑆬𑆳𑆤𑆥𑆴 𑇆𑇒𑇒𑇆
𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆢𑆠𑆴𑆫𑆴𑆖𑇀𑆪𑆼𑆠 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆁 𑆖 𑆬𑆳𑆔𑆮𑆳𑆠𑇀 𑇅 𑆢𑆶𑆫𑇀𑆲𑆫𑆁 𑆖𑆳𑆮𑆴𑆥𑆳𑆑𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑇀𑆬𑆼𑆯𑆪𑆠𑆼 𑆖𑆴𑆫𑆩𑇀 𑇆𑇒𑇓𑇆
𑆱𑇀𑆡𑆳𑆮𑆫𑆁 𑆘𑆕𑇀𑆓𑆩𑆁 𑆪𑆖𑇀𑆖 𑆑𑆸𑆠𑇀𑆫𑆴𑆩𑆁 𑆖𑆳𑆥𑆴 𑆪𑆢𑇀𑆮𑆴𑆰𑆩𑇀 𑇅 𑆱𑆢𑇀𑆪𑆾 𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆼𑆠𑇀𑆠𑆠𑇀𑆠𑆶 𑆘𑇀𑆚𑆼𑆪𑆁 𑆢𑆯𑆓𑆶𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇆𑇒𑇔𑇆
𑆪𑆠𑇀 𑆱𑇀𑆡𑆳𑆮𑆫𑆁 𑆘𑆕𑇀𑆓𑆩𑆑𑆸𑆠𑇀𑆫𑆴𑆩𑆁 𑆮𑆳 𑆢𑆼𑆲𑆳𑆢𑆯𑆼𑆰𑆁 𑆪𑆢𑆤𑆴𑆫𑇀𑆓𑆠𑆁 𑆠𑆠𑇀 𑇅𑇒𑇕𑇅 𑆘𑆵𑆫𑇀𑆟𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆿𑆰𑆣𑆴𑆨𑆴𑆫𑇀𑆲𑆠𑆁 𑆮𑆳 𑆢𑆳𑆮𑆳𑆓𑇀𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆯𑆾𑆰𑆴𑆠𑆁 𑆮𑆳 𑇆𑇒𑇕𑇆
𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆾 𑆮𑆳 𑆓𑆶𑆟𑆮𑆴𑆥𑇀𑆫𑆲𑆵𑆤𑆁 𑆮𑆴𑆰𑆁 𑆲𑆴 𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴 𑇅 𑆮𑆵𑆫𑇀𑆪𑆳𑆬𑇀𑆥𑆨𑆳𑆮𑆳𑆤𑇀𑆤 𑆤𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀𑆠𑆠𑇀 𑆑𑆦𑆳𑆮𑆸𑆠𑆁 𑆮𑆫𑇀𑆰𑆓𑆟𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆴 𑇆𑇒𑇖𑇆
𑆠𑆼𑆤𑆳𑆫𑇀𑆢𑆴𑆠𑆾 𑆨𑆴𑆤𑇀𑆤𑆥𑆶𑆫𑆵𑆰𑆮𑆫𑇀𑆟𑆾 𑆮𑆴𑆓𑆤𑇀𑆣𑆮𑆽𑆫𑆱𑇀𑆪𑆩𑆶𑆒𑆂 𑆥𑆴𑆥𑆳𑆱𑆵 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑇀 𑆮𑆩𑆤𑇀 𑆓𑆢𑇀𑆓𑆢𑆮𑆳𑆓𑇀𑆮𑆴𑆰𑆟𑇀𑆟𑆾 𑆨𑆮𑆼𑆖𑇀𑆖 𑆢𑆶𑆰𑇀𑆪𑆾𑆢𑆫𑆬𑆴𑆕𑇀𑆓𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇒𑇗𑇆
𑆄𑆩𑆳𑆯𑆪𑆱𑇀𑆡𑆼 𑆑𑆦𑆮𑆳𑆠𑆫𑆾𑆓𑆵 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆼𑇁𑆤𑆴𑆬𑆥𑆴𑆠𑇀𑆠𑆫𑆾𑆓𑆵 𑇅 𑆨𑆮𑆼𑆤𑇀𑆤𑆫𑆾 𑆣𑇀𑆮𑆱𑇀𑆠𑆯𑆴𑆫𑆾𑆫𑆶𑆲𑆳𑆕𑇀𑆓𑆾 𑆮𑆴𑆬𑆷𑆤𑆥𑆑𑇀𑆰𑆱𑇀𑆠𑆶 𑆪𑆡𑆳 𑆮𑆴𑆲𑆕𑇀𑆓𑆂 𑇆𑇒𑇘𑇆
𑆱𑇀𑆡𑆴𑆠𑆁 𑆫𑆱𑆳𑆢𑆴𑆰𑇀𑆮𑆡𑆮𑆳 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑇀 𑆑𑆫𑆾𑆠𑆴 𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆨𑆮𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑇅 𑆑𑆾𑆥𑆁 𑆖 𑆯𑆵𑆠𑆳𑆤𑆴𑆬𑆢𑆶𑆫𑇀𑆢𑆴𑆤𑆼𑆰𑆶 𑆪𑆳𑆠𑇀𑆪𑆳𑆯𑆶,... 𑇅𑇓𑇐𑇅 ...𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑆸𑆟𑆶 𑆠𑆠𑇀𑆫 𑆫𑆷𑆥𑆩𑇀 𑇆𑇒𑇙𑇆
𑆤𑆴𑆢𑇀𑆫𑆳 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆖 𑆮𑆴𑆘𑆸𑆩𑇀𑆨𑆟𑆁 𑆖 𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆲𑆫𑇀𑆰𑆳𑆮𑆡𑆮𑆳𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆂 𑇅𑇓𑇐𑇅 𑆠𑆠𑆂 𑆑𑆫𑆾𑆠𑇀𑆪𑆤𑇀𑆤𑆩𑆢𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆮𑆫𑆾𑆖𑆑𑆁 𑆩𑆟𑇀𑆝𑆬𑆑𑆾𑆜𑆩𑆾𑆲𑆳𑆤𑇀 𑇆𑇓𑇐𑇆
𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆁 𑆥𑆳𑆢𑆑𑆫𑆳𑆱𑇀𑆪𑆯𑆾𑆦𑆁 𑆢𑆑𑆾𑆢𑆫𑆁 𑆗𑆫𑇀𑆢𑆴𑆩𑆡𑆳𑆠𑆴𑆱𑆳𑆫𑆩𑇀 𑇅 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆤𑇀 𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆥𑇀𑆫𑆧𑆬𑆳𑆁 𑆠𑆸𑆰𑆳𑆁 𑆮𑆳 𑇆𑇓𑇑𑇆
𑆇𑆤𑇀𑆩𑆳𑆢𑆩𑆤𑇀𑆪𑆘𑇀𑆘𑆤𑆪𑆼𑆠𑇀𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆢𑆳𑆤𑆳𑆲𑆩𑆤𑇀𑆪𑆠𑇀 𑆑𑇀𑆰𑆥𑆪𑆼𑆖𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆩𑇀 𑇅 𑆓𑆳𑆢𑇀𑆓𑆢𑇀𑆪𑆩𑆤𑇀𑆪𑆘𑇀𑆘𑆤𑆪𑆼𑆖𑇀𑆖 𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆯𑇀𑆖𑆁 𑆧𑆲𑆶𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑇀 𑇆𑇓𑇒𑇆
𑆢𑆷𑆰𑆴𑆠𑆁 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆤𑇀𑆤𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆽𑆫𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆯𑆂 𑇅 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆷𑆰𑆪𑆠𑆼 𑆣𑆳𑆠𑆷𑆤𑇀 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇓𑇓𑇆

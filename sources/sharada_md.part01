𑆖𑆠𑆶𑆰𑇀𑆥𑆬𑆁 𑆱𑆶𑆣𑆳𑆑𑆳𑆟𑇀𑆝𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆥𑆬𑆁 𑆬𑆮𑆟𑆠𑇀𑆫𑆪𑆳𑆠𑇀𑇅 𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆵𑆑𑆶𑆝𑆮𑆁 𑆖𑆳𑆫𑇀𑆑𑆳𑆢𑆰𑇀𑆛𑆿 𑆢𑇀𑆮𑆼 𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆠𑇀 𑆥𑆬𑆼𑇆𑇑𑇘𑇓𑇆
𑆢𑆓𑇀𑆣𑆳𑆤𑆴 𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆶𑆫𑆱𑆼 𑆓𑆶𑆛𑆴𑆑𑆳 𑆨𑆾𑆘𑆤𑆾𑆠𑇀𑆠𑆫𑆳𑆂𑇅 𑆨𑆶𑆑𑇀𑆠𑆁 𑆨𑆶𑆑𑇀𑆠𑆁 𑆥𑆖𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆲𑆴𑆠𑆳𑆂𑇆𑇑𑇘𑇔𑇆
𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆯𑆩𑆤𑆳𑆯𑇀𑆖 𑆠𑆳𑆂𑇅 𑆅𑆠𑇀𑆪𑆼𑆰𑆳 𑆑𑇀𑆰𑆳𑆫𑆓𑆶𑆛𑆴𑆑𑆳 𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑇆𑇑𑇘𑇕𑇆
𑆅𑆠𑆴 𑆑𑇀𑆰𑆳𑆫𑆓𑆶𑆝𑆴𑆑𑆳𑇅 𑆮𑆠𑇀𑆱𑆑𑆳𑆠𑆴𑆮𑆴𑆰𑆼 𑆥𑆳𑆜𑆳𑆁 𑆢𑆶𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆁 𑆲𑆴𑆕𑇀𑆓𑆶 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑇀𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑇀𑆪 𑆥𑆬𑆳𑆯𑆳𑆓𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆼 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆼 𑆥𑆖𑆼𑆠𑇀𑇆𑇑𑇘𑇖𑇆
𑆄𑆪𑆱𑆼 𑆨𑆳𑆘𑆤𑆼 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑆾𑆬𑆁 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇅 𑆩𑆢𑇀𑆪𑆽𑆫𑇀𑆮𑆳 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆯𑆾𑆡𑆳𑆫𑇀𑆯𑆂𑆥𑆳𑆟𑇀𑆝𑆶𑆩𑆳𑆤𑇀 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇘𑇗𑇆
𑆅𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆡𑆑𑇀𑆰𑆳𑆫𑆂𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆑𑆛𑆨𑆵𑆁 𑆖𑆮𑇀𑆪𑆁 𑆧𑆴𑆬𑇀𑆮𑆩𑆣𑇀𑆪𑆩𑆪𑆾𑆫𑆘𑆂𑇅 𑆫𑆾𑆲𑆴𑆟𑆵𑆁 𑆑𑆛𑆶𑆑𑆳𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑆳𑆜𑆳𑆁 𑆖 𑆲𑆴𑆕𑇀𑆓𑆶 𑆖𑇆𑇑𑇘𑇘𑇆
𑆩𑆣𑆶𑆑𑆁 𑆩𑆶𑆰𑇀𑆑𑆑𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆿 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆁 𑆮𑆖𑆳𑆩𑇀𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆁 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆁 𑆤𑆴𑆩𑇀𑆧𑆖𑆴𑆠𑇀𑆫𑆑𑆿𑇆𑇑𑇘𑇙𑇆
𑆨𑆳𑆓𑆳𑆤𑇀 𑆢𑆣𑇀𑆤𑆴 𑆠𑇀𑆫𑆴𑆑𑆶𑆝𑆮𑆼 𑆔𑆸𑆠𑆠𑆽𑆬𑆼𑆤 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆩𑇀𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆣𑆷𑆩𑆁 𑆯𑆤𑆽𑆫𑇀𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆳𑆟𑆴𑆠𑆬𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇙𑇑𑇆
𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆑𑆦𑆮𑆳𑆠𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆮𑆳𑆤𑇀𑇅 𑆥𑇀𑆬𑆵𑆲𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆯𑇀𑆮𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆑𑆳𑆱𑆑𑇀𑆫𑆴𑆩𑆴𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑇆𑇑𑇙𑇒𑇆
𑆯𑆾𑆰𑆳𑆠𑆴𑆱𑆳𑆫𑆿 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑆳𑆲𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆳𑆤𑇀𑇅 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆮𑆴𑆰𑆁 𑆖𑆽𑆮 𑆑𑇀𑆰𑆳𑆫𑆾𑇁𑆓𑇀𑆤𑆴𑆘𑆤𑆤𑆾 𑆮𑆫𑆂𑇆𑇑𑇙𑇓𑇆
𑆘𑆵𑆫𑇀𑆟𑆼 𑆫𑆱𑆽𑆫𑇀𑆮𑆳 𑆩𑆣𑆶𑆫𑆽𑆫𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆥𑆪𑆱𑆳𑇁𑆥𑆴 𑆮𑆳𑇅 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆩𑆑𑇀𑆰𑆳𑆫𑆂𑇅 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆼 𑆮𑆴𑆣𑆴𑆮𑆴𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆂 𑆥𑆚𑇀𑆖 𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇔𑇆
𑆔𑆸𑆠𑆑𑇀𑆰𑆳𑆫𑆳𑆱𑆮𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆓𑇀𑆤𑆴𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆤𑇀𑇅 𑆑𑇀𑆫𑆴𑆪𑆳 𑆪𑆳 𑆖𑆳𑆤𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆓𑇀𑆫𑆲𑆟𑆵𑆁 𑆥𑇀𑆫𑆠𑆴𑇆𑇑𑇙𑇕𑇆
𑆮𑇀𑆪𑆠𑇀𑆪𑆳𑆱𑆳𑆠𑇀𑆠𑆳𑆁 𑆱𑆩𑆱𑇀𑆠𑆳𑆁 𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆠𑇀𑇅𑇑𑇙𑇖𑇅 𑆱𑇀𑆤𑆼𑆲𑆤𑆁 𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆬𑆕𑇀𑆔𑆤𑆁 𑆢𑆵𑆥𑆤𑆁 𑆖 𑆪𑆠𑇀𑇆𑇑𑇙𑇖𑇆
𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆬𑆮𑆟𑆑𑇀𑆰𑆳𑆫𑆩𑆣𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆱𑆶𑆫𑆳𑆱𑆮𑆳𑆂𑇅 𑆮𑆴𑆮𑆴𑆣𑆳𑆱𑇀𑆠𑆑𑇀𑆫𑆪𑆾𑆓𑆳𑆯𑇀𑆖 𑆢𑆵𑆥𑆤𑆳𑆤𑆳𑆁 𑆖 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆩𑇀𑇆𑇑𑇙𑇗𑇆
𑆓𑇀𑆫𑆲𑆟𑆵𑆫𑆾𑆓𑆴𑆨𑆴𑆂 𑆱𑆼𑆮𑇀𑆪𑆳𑆂, ...𑇅𑇑𑇙𑇘𑇅 ... 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆑𑆵𑆁 𑆯𑆸𑆟𑆶𑇅 𑆰𑇀𑆜𑆵𑆮𑆤𑆁 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆫𑆷𑆑𑇀𑆰𑆁 𑆢𑆵𑆥𑆤𑆁 𑆠𑆴𑆑𑇀𑆠𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇑𑇙𑇘𑇆
𑆱𑆑𑆸𑆢𑇀𑆫𑆷𑆑𑇀𑆰𑆁 𑆱𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆑𑆸𑆯𑆼 𑆧𑆲𑆶𑆑𑆦𑆼 𑆲𑆴𑆠𑆩𑇀𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆢𑆵𑆥𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇑𑇙𑇙𑇆
𑆢𑆵𑆥𑆤𑆁 𑆧𑆲𑆶𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆠𑆴𑆑𑇀𑆠𑆁 𑆩𑆣𑆶𑆫𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆧𑆲𑆶𑆮𑆳𑆠𑆱𑇀𑆪 𑆠𑆶 𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆪𑆶𑆠𑆁 𑆲𑆴𑆠𑆩𑇀𑇆𑇒𑇐𑇐𑇆
𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆠𑆴 𑆠𑆡𑆳 𑆮𑆲𑇀𑆤𑆴𑆫𑆼𑆰𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑆴𑆤𑇀𑆣𑆤𑆽𑆂𑇅𑇒𑇐𑇑𑇅 𑆱𑇀𑆤𑆼𑆲𑆩𑆼𑆮 𑆥𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆤𑆬𑆢𑆵𑆥𑆤𑆩𑇀𑇆𑇒𑇐𑇑𑇆
𑆤𑆳𑆬𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆩𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆯𑆩𑆳𑆪𑆳𑆤𑇀𑆤𑆁 𑆱𑆶𑆓𑆶𑆫𑇀𑆮𑆥𑆴𑇅 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆫𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆠𑆶 𑆥𑆶𑆫𑆵𑆰𑆁 𑆪𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼𑇆𑇒𑇐𑇒𑇆
𑆢𑆵𑆥𑆤𑆵𑆪𑆿𑆰𑆣𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆔𑆸𑆠𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆶 𑆱𑆂𑇅 𑆠𑆪𑆳 𑆱𑆩𑆳𑆤𑆂 𑆥𑆮𑆤𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆾 𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆱𑇀𑆡𑆴𑆠𑆂𑇆𑇒𑇐𑇓𑇆
𑆃𑆓𑇀𑆤𑆼𑆂 𑆱𑆩𑆵𑆥𑆖𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆢𑆳𑆯𑆶 𑆥𑇀𑆫𑆑𑆶𑆫𑆶𑆠𑆼 𑆧𑆬𑆩𑇀𑇅 𑆑𑆳𑆜𑆴𑆤𑇀𑆪𑆳𑆢𑇀𑆪𑆂 𑆥𑆶𑆫𑆵𑆰𑆁 𑆠𑆶 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆤𑇀𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑆩𑆳𑆤𑆮𑆂𑇆𑇒𑇐𑇔𑇆
𑆱𑆔𑆸𑆠𑆁 𑆬𑆮𑆟𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆤𑆫𑆾𑇁𑆤𑇀𑆤𑆳𑆮𑆓𑇀𑆫𑆲𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆮𑆳 𑆢𑆵𑆥𑆤𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀𑇆𑇒𑇐𑇕𑇆
𑆃𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑇀𑆠𑆶 𑆩𑆤𑇀𑆢𑆼𑇁𑆓𑇀𑆤𑆿 𑆖𑆷𑆫𑇀𑆟𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆱𑆮𑆳 𑆲𑆴𑆠𑆳𑆂𑇅 𑆨𑆴𑆤𑇀𑆤𑆼 𑆓𑆶𑆢𑆾𑆥𑆬𑆼𑆥𑆳𑆠𑇀𑆠𑆶 𑆩𑆬𑆼 𑆠𑆽𑆬𑆱𑆶𑆫𑆳𑆱𑆮𑆳𑆂𑇆𑇒𑇐𑇖𑇆

𑆦𑆬𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆑𑆮𑆠𑇀𑆱𑆑𑆳𑆂 𑇅 𑆯𑇀𑆪𑆳𑆩𑆳 𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆖𑆽𑆮 𑆱𑇀𑆡𑆴𑆫𑆳 𑆢𑆤𑇀𑆠𑆵 𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪𑆥𑆴𑇆𑇒𑇕𑇆
𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆪𑆳 𑆖𑆾𑆢𑆑𑆵𑆫𑇀𑆪𑆳 𑆖 𑆤𑆵𑆬𑆴𑆤𑆵 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆵 𑆠𑆡𑆳𑇅 𑆱𑆥𑇀𑆠𑆬𑆳 𑆯𑆕𑇀𑆒𑆴𑆤𑆵 𑆬𑆾𑆣𑇀𑆫𑆁 𑆦𑆬𑆁 𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆱𑇀𑆪 𑆖𑇆𑇒𑇖𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆷𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆼 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆮𑆴𑆯𑆾𑆣𑆤𑆳𑆂𑇅 (𑆮𑇀𑆪𑆱𑇀𑆠𑆽𑆫𑆥𑆴 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆖𑆠𑆶𑆫𑇀𑆪𑆾𑆓𑆳 𑆇𑆢𑆳𑆲𑆸𑆠𑆳𑆂 )𑇆𑇒𑇗𑇆
𑆄𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆦𑆬𑆁 𑆩𑆳𑆰𑆳𑆂 𑆱𑆓𑆾𑆣𑆷𑆩𑆳 𑆪𑆮𑆳𑆱𑇀𑆠𑆡𑆳𑇅 𑆘𑆬𑆘𑆳𑆤𑆷𑆥𑆘𑆁 𑆩𑆳𑆁𑆱𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆼 𑆯𑆶𑆑𑇀𑆫𑆩𑆳𑆁𑆱𑆬𑆳𑆂 𑇆𑇒𑇙𑇆
𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆖𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆯𑇀𑆖 𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆮𑆠𑇀𑆱𑆑𑆿𑇅 𑆥𑇀𑆫𑆓𑇀𑆫𑆲𑆂 𑆒𑆢𑆴𑆫𑆂 𑆑𑆶𑆰𑇀𑆜𑆁 𑆯𑆩𑆵 𑆥𑆴𑆟𑇀𑆝𑆵𑆠𑆑𑆾 𑆪𑆮𑆳𑆂𑇆𑇓𑇐𑇆
𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆷 𑆫𑆑𑇀𑆠𑆩𑆷𑆬𑆵 𑆖 𑆠𑆫𑆶𑆟𑆵 𑆱𑇀𑆮𑆫𑇀𑆟𑆪𑆷𑆡𑆴𑆑𑆳𑇅 𑆮𑆛𑆳𑆢𑇀𑆪𑆳𑆂 𑆑𑆴𑆁𑆯𑆶𑆑𑆁 𑆬𑆾𑆣𑇀𑆫𑆩𑆴𑆠𑆴 𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆳 𑆩𑆠𑆳𑆂𑇆𑇓𑇑𑇆
𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆼 𑆯𑆸𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆱𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆩𑇀𑇅 𑆄𑆒𑆶𑆥𑆫𑇀𑆟𑆴𑆑𑆪𑆳 𑆮𑆳𑇁𑆥𑆴 𑆠𑆟𑇀𑆝𑆶𑆬𑆵𑆪𑆑𑆪𑆶𑆑𑇀𑆠𑆪𑆳𑇆𑇓𑇒𑇆
𑆑𑆳𑆬𑆕𑇀𑆑𑆠𑆑𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑆶𑆢𑆫𑇀𑆨𑆥𑆾𑆛𑆓𑆬𑆼𑆑𑇀𑆰𑆶𑆨𑆴𑆂 𑇅 𑆢𑆳𑆲𑆔𑇀𑆤𑆂 𑆱𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆾 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆯𑇀𑆖𑆾𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇓𑇓𑇆
𑆑𑆫𑇀𑆧𑆶𑆢𑆳𑆫𑆳𑆞𑆑𑆵𑆤𑆵𑆥𑆮𑆴𑆢𑆶𑆬𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆱𑆳𑆣𑆴𑆠𑆽𑆂𑇅 𑆧𑆱𑇀𑆠𑆴𑆂 𑆥𑇀𑆫𑆢𑆼𑆪𑆾 𑆨𑆴𑆰𑆘𑆳 𑆯𑆵𑆠𑆂 𑆱𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆂𑇆𑇓𑇔𑇆
𑆧𑆱𑇀𑆠𑆴𑆂 𑆯𑆳𑆬𑇀𑆩𑆬𑆴𑆮𑆸𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆱𑆴𑆢𑇀𑆣𑆾 𑆔𑆸𑆠𑆳𑆤𑇀𑆮𑆴𑆠𑆂𑇅 𑆲𑆴𑆠𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆼 𑆠𑆢𑇀𑆮𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆽𑆂 𑆯𑆳𑆬𑇀𑆩𑆬𑆴𑆑𑆱𑇀𑆪 𑆖𑇆𑇓𑇖𑇆
𑆃𑆯𑇀𑆮𑆳𑆮𑆫𑆾𑆲𑆴𑆑𑆳𑆑𑆳𑆑𑆤𑆳𑆱𑆳𑆫𑆳𑆘𑆑𑆯𑆼𑆫𑆶𑆑𑆽𑆂𑇅 𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆼𑇁𑆠𑆴𑆪𑆾𑆓𑆼 𑆱𑇀𑆪𑆶𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆚𑇀𑆘𑆤𑆔𑆸𑆠𑆽𑆫𑇀𑆪𑆶𑆠𑆳𑆂𑇆𑇓𑇗𑇆
𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑇀𑆪𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑆴𑆯𑇀𑆖 𑆠𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑆫𑆂𑇅𑇓𑇘𑇅 𑆧𑆸𑆲𑆠𑆵 𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵 𑆯𑆠𑆳𑆮𑆫𑆵𑇆𑇓𑇘𑇆
𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆧𑆢𑆫𑆵𑆢𑆷𑆫𑇀𑆮𑆳𑆱𑇀𑆠𑆡𑆾𑆯𑆵𑆫𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆮𑆂𑇅 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆼 𑆯𑆸𑆠𑆿 𑆑𑇀𑆰𑆵𑆫𑆼 𑆢𑇀𑆮𑆿 𑆔𑆸𑆠𑆳𑆚𑇀𑆘𑆤𑆱𑆁𑆪𑆶𑆠𑆿𑇆𑇓𑇙𑇆
𑆧𑆱𑇀𑆠𑆵 𑆥𑇀𑆫𑆢𑆼𑆪𑆿 𑆨𑆴𑆰𑆘𑆳 𑆯𑆵𑆠𑆿 𑆱𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆿𑇅 𑆓𑆾𑇁𑆮𑇀𑆪𑆘𑆳𑆩𑆲𑆴𑆰𑆵𑆑𑇀𑆰𑆵𑆫𑆽𑆫𑇀𑆘𑆵𑆮𑆤𑆵𑆪𑆪𑆶𑆠𑆽𑆱𑇀𑆠𑆡𑆳𑇆𑇔𑇐𑇆
𑆯𑆯𑆽𑆟𑆢𑆑𑇀𑆰𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆩𑆲𑆴𑆰𑆳𑆮𑇀𑆪𑆘𑆯𑆾𑆟𑆴𑆠𑆽𑆂𑇅 𑆱𑆢𑇀𑆪𑆱𑇀𑆑𑆽𑆫𑇀𑆩𑆸𑆢𑆴𑆠𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇔𑇑𑇆
𑆩𑆣𑆷𑆑𑆩𑆣𑆶𑆑𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆢𑆷𑆫𑇀𑆮𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆖𑆤𑇀𑆢𑆤𑆽𑆂𑇅 𑆠𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆴𑆤𑆳 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆢𑆼𑆪𑆂 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆂𑇆𑇔𑇒𑇆
𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆱𑆳𑆫𑆴𑆮𑆳𑆤𑆤𑇀𑆠𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆩𑆣𑆶𑆑𑆽𑆱𑇀𑆠𑆡𑆳𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆖𑆤𑇀𑆢𑆤𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑆣𑆶𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆾𑆠𑇀𑆥𑆬𑆽𑆂𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼, 𑆥𑇀𑆫𑆩𑆼𑆲𑆼 𑆠𑆶 𑆑𑆰𑆳𑆪𑆂 𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆘𑆂𑇆𑇔𑇓𑇆
𑆓𑆶𑆬𑇀𑆩𑆳𑆠𑆴𑆱𑆳𑆫𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆱𑇀𑆠𑆩𑇀𑆨𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆳𑆢𑆴𑆰𑆶𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆽𑆑𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆼𑆰𑆶 𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆼𑆮𑆁𑆮𑆴𑆣𑆼𑆰𑆶 𑆖𑇆𑇔𑇔𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆽𑆫𑆿𑆰𑆣𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆵𑆤𑇀 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇅 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆪𑆾𑆓𑆳𑆤𑇀 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆤𑇀𑇆𑇔𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆠𑇀𑆫𑆴𑆑𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆾𑇁𑆤𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆖𑆠𑆶𑆰𑇀𑆑𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼 𑆠𑇀𑆫𑆪𑆂𑇅 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆸𑆰𑇀𑆪𑆳𑆂 𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆳𑆱𑇀𑆠𑆡𑆳𑇆𑇔𑇖𑇆
𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆼 𑆠𑆡𑆳 𑆢𑆳𑆲𑆼 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆼𑇅 𑆱𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆩𑆠𑆿 𑆢𑇀𑆮𑆿 𑆢𑇀𑆮𑆿 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆼 𑆠𑆡𑆳 𑆠𑇀𑆫𑆪𑆂𑇆𑇔𑇗𑇆
𑆢𑇀𑆮𑆿 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆩𑆼𑆲𑆼 𑆖 𑆍𑆑𑆠𑇀𑆫𑆴𑆁𑆯𑆖𑇀𑆖 𑆱𑆥𑇀𑆠 𑆠𑆼𑇅 𑆱𑆶𑆬𑆨𑆳𑆬𑇀𑆥𑆿𑆰𑆣𑆑𑇀𑆬𑆼𑆯𑆳 𑆧𑆱𑇀𑆠𑆪𑆾 𑆓𑆶𑆟𑆮𑆠𑇀𑆠𑆩𑆳𑆂𑇆𑇔𑇘𑇆
𑆃𑆡𑆳𑆠𑆂 𑆦𑆬𑆩𑆳𑆠𑇀𑆫𑆳𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆶𑆢𑆳𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆣𑆵𑆯𑇀𑆫𑆶𑆠𑆴𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆱𑆩𑆸𑆢𑇀𑆣𑆩𑆠𑇀𑆫𑆴𑆘𑆩𑇀𑇅 𑆦𑆬𑆧𑆱𑇀𑆠𑆴𑆮𑆫𑆠𑇀𑆮𑆤𑆴𑆯𑇀𑆖𑆪𑆼 𑆱𑆮𑆴𑆮𑆳𑆢𑆳 𑆩𑆶𑆤𑆪𑆾𑇁𑆨𑇀𑆪𑆶𑆥𑆳𑆓𑆩𑆤𑇀𑇆𑇓𑇆
𑆨𑆸𑆓𑆶𑆑𑆿𑆯𑆴𑆑𑆑𑆳𑆥𑇀𑆪𑆯𑆿𑆤𑆑𑆳𑆂 𑆱𑆥𑆶𑆬𑆱𑇀𑆠𑇀𑆪𑆳𑆱𑆴𑆠𑆓𑆿𑆠𑆩𑆳𑆢𑆪𑆂𑇅 𑆑𑆠𑆩𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑆁 𑆦𑆬𑆳𑆢𑆴𑆰𑆶 𑆱𑇀𑆩𑆸𑆠𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆪𑆾𑆘𑆤𑆳𑆱𑇀𑆮𑆴𑆠𑆴𑇆𑇔𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆮𑆫𑆁 𑆦𑆬𑆼𑆰𑇀𑆮𑆡 𑆘𑆵𑆩𑆷𑆠𑆑𑆩𑆳𑆲 𑆯𑆿𑆤𑆑𑆂𑇅 𑆩𑆸𑆢𑆶𑆮𑆵𑆫𑇀𑆪𑆠𑆪𑆳𑇁𑆨𑆴𑆤𑆠𑇀𑆠𑆴 𑆠𑆖𑇀𑆗𑆑𑆸𑆢𑆴𑆠𑇀𑆪𑆳𑆲 𑆤𑆸𑆥𑆾𑇁𑆡 𑆮𑆳𑆩𑆑𑆂𑇆𑇕𑇆
𑆑𑆛𑆶𑆠𑆶𑆩𑇀𑆧𑆩𑆩𑆤𑇀𑆪𑆠𑆾𑆠𑇀𑆠𑆩𑆁 𑆮𑆩𑆤𑆼 𑆢𑆾𑆰𑆱𑆩𑆵𑆫𑆟𑆁 𑆖 𑆠𑆠𑇀𑇅 𑆠𑆢𑆮𑆸𑆰𑇀𑆪𑆩𑆯𑆽𑆠𑇀𑆪𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆳𑆑𑆛𑆶𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑆓𑆿𑆠𑆩𑆾𑇁𑆧𑇀𑆫𑆮𑆵𑆠𑇀 𑇆𑇖𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆁 𑆥𑆫𑆁 𑆱 𑆖 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆩𑆴𑆠𑇀𑆪𑆩𑆤𑇀𑆪𑆠 𑇅 𑆠𑆢𑆩𑆤𑇀𑆪𑆠 𑆮𑆳𑆠𑆬𑆁 𑆥𑆶𑆤𑆫𑇀𑆧𑆝𑆴𑆯𑆾 𑆓𑇀𑆬𑆳𑆤𑆴𑆑𑆫𑆁 𑆧𑆬𑆳𑆥𑆲𑆩𑇀𑇆𑇗𑇆
𑆑𑆶𑆛𑆘𑆁 𑆥𑇀𑆫𑆯𑆯𑆁𑆱 𑆖𑆾𑆠𑇀𑆠𑆩𑆁 𑆤 𑆧𑆬𑆔𑇀𑆤𑆁 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆳𑆫𑆴 𑆖𑇅 𑆃𑆠𑆴𑆮𑆴𑆘𑇀𑆘𑆬𑆩𑆿𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆴𑆑𑆁 𑆥𑆮𑆤𑆑𑇀𑆰𑆾𑆨𑆴 𑆖 𑆑𑆳𑆥𑇀𑆪 𑆄𑆲 𑆠𑆠𑇀𑇆𑇘𑇆
𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆩𑆳𑆲 𑆮𑆳𑆠𑆬𑆁 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆧𑆬𑆁 𑆲𑆫𑆼𑆢𑆴𑆠𑆴𑇅 𑆠𑆢𑆱𑆳𑆣𑇀𑆮𑆴𑆠𑆴 𑆨𑆢𑇀𑆫𑆯𑆿𑆤𑆑𑆂 𑆑𑆛𑆶𑆑𑆁 𑆖𑆳𑆠𑆴𑆧𑆬𑆔𑇀𑆤𑆩𑆴𑆠𑇀𑆪𑆥𑆴𑇆𑇙𑇆
𑆅𑆠𑆴 𑆠𑆢𑇀𑆮𑆖𑆤𑆳𑆤𑆴 𑆲𑆼𑆠𑆶𑆨𑆴𑆂 𑆱𑆶𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆳𑆟𑆴 𑆤𑆴𑆯𑆩𑇀𑆪 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆥𑇀𑆫𑆯𑆯𑆁𑆱 𑆦𑆬𑆼𑆰𑆶 𑆤𑆴𑆯𑇀𑆖𑆪𑆁 𑆥𑆫𑆩𑆁 𑆖𑆳𑆠𑇀𑆫𑆴𑆱𑆶𑆠𑆾𑇁𑆧𑇀𑆫𑆮𑆵𑆢𑆴𑆢𑆩𑇀𑇆𑇑𑇐𑇆
𑆦𑆬𑆢𑆾𑆰𑆓𑆶𑆟𑆳𑆤𑇀 𑆱𑆫𑆱𑇀𑆮𑆠𑆵 𑆥𑇀𑆫𑆠𑆴 𑆱𑆫𑇀𑆮𑆽𑆫𑆥𑆴 𑆱𑆩𑇀𑆪𑆓𑆵𑆫𑆴𑆠𑆳𑇅 𑆤 𑆠𑆶 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆢𑆾𑆰𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑆁 𑆓𑆶𑆟𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆮𑆩𑆠𑆾 𑆮𑆴𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇑𑇑𑇆
𑆅𑆲 𑆑𑆶𑆰𑇀𑆜𑆲𑆴𑆠𑆳 𑆓𑆫𑆳𑆓𑆫𑆵 𑆲𑆴𑆠𑆩𑆴𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶 𑆠𑆶 𑆩𑆼𑆲𑆴𑆤𑆼 𑆩𑆠𑆩𑇀𑇅 𑆑𑆶𑆛𑆘𑆱𑇀𑆪 𑆦𑆬𑆁 𑆲𑆸𑆢𑆳𑆩𑆪𑆼 𑆥𑇀𑆫𑆮𑆫𑆁 𑆑𑆾𑆜𑆦𑆬𑆁 𑆖 𑆥𑆳𑆟𑇀𑆝𑆶𑆰𑆶𑇆𑇑𑇒𑇆
𑆇𑆢𑆫𑆼 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆁 𑆲𑆴𑆠𑆁, 𑆩𑆢𑆤𑆁 𑆱𑆫𑇀𑆮𑆓𑆢𑆳𑆮𑆴𑆫𑆾𑆣𑆴 𑆠𑆶𑇅 𑆩𑆣𑆶𑆫𑆁 𑆱𑆑𑆰𑆳𑆪𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆠𑆢𑆫𑆷𑆑𑇀𑆰𑆁 𑆱𑆑𑆛𑆷𑆰𑇀𑆟𑆮𑆴𑆘𑇀𑆘𑆬𑆩𑇀𑇆𑇑𑇓𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆸𑆢𑆳𑆯𑆶𑆑𑆳𑆫𑆴 𑆖𑆳𑆥𑇀𑆪𑆤𑆥𑆳𑆪𑆁 𑆥𑆮𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑆴 𑆖𑇅 𑆦𑆬𑆤𑆳𑆩 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑇀𑆮𑆠𑆾 𑆬𑆨𑆠𑆼𑇁𑆤𑇀𑆪𑆼𑆰𑆶 𑆦𑆬𑆼𑆰𑆶 𑆱𑆠𑇀𑆱𑇀𑆮𑆥𑆴𑇆𑇑𑇔𑇆
𑆓𑆶𑆫𑆶𑆟𑆼𑆠𑆴 𑆮𑆖𑆱𑇀𑆪𑆶𑆢𑆳𑆲𑆸𑆠𑆼 𑆩𑆶𑆤𑆴𑆱𑆕𑇀𑆔𑆼𑆤 𑆖 𑆥𑆷𑆘𑆴𑆠𑆼 𑆠𑆠𑆂 𑇅 𑆥𑇀𑆫𑆟𑆴𑆥𑆠𑇀𑆪 𑆩𑆶𑆢𑆳 𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆂 𑆱𑆲𑆴𑆠𑆂 𑆯𑆴𑆰𑇀𑆪𑆓𑆟𑆾𑇁𑆤𑆶𑆥𑆸𑆰𑇀𑆛𑆮𑆳𑆤𑇀𑇆𑇑𑇕𑇆
𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆓𑆶𑆟𑆑𑆸𑆢𑇀𑆓𑆶𑆫𑆶𑆟𑆾𑆑𑇀𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆡 𑆤𑆽𑆠𑆴 𑆤𑆳𑆨𑆴𑆠𑆂𑇅 𑆤𑆳𑆨𑇀𑆪𑆣𑆾 𑆓𑆶𑆢𑆩𑆠𑆂 𑆱 𑆯𑆫𑆵𑆫𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑆂 𑆑𑆡𑆩𑆥𑆾𑆲𑆠𑆴 𑆢𑆾𑆰𑆳𑆤𑇀 𑇆𑇑𑇖𑇆
𑆠𑆢𑇀𑆓𑆶𑆫𑆶𑆫𑆧𑇀𑆫𑆮𑆵𑆢𑆴𑆢𑆁 𑆯𑆫𑆵𑆫𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆠𑆼𑇁𑆤𑆴𑆬𑆂 𑆱𑆕𑇀𑆓𑆮𑆴𑆔𑆳𑆠𑆳𑆠𑇀 𑇅 𑆑𑆼𑆮𑆬 𑆍𑆮 𑆢𑆾𑆰𑆱𑆲𑆴𑆠𑆾 𑆮𑆳 𑆱𑇀𑆮𑆳𑆯𑆪𑆓𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆶𑆥𑆪𑆳𑆠𑆴𑇆𑇑𑇗𑇆
𑆠𑆁 𑆥𑆮𑆤𑆁 𑆱𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆮𑆴𑆛𑇀𑆑𑆁 𑆯𑆶𑆢𑇀𑆣𑆴𑆑𑆫𑆾𑇁𑆤𑆶𑆬𑆾𑆩𑆪𑆠𑆴 𑆧𑆱𑇀𑆠𑆴𑆂𑇅 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆓𑆯𑇀𑆖 𑆓𑆢𑆱𑆕𑇀𑆔𑆱𑇀𑆠𑆠𑇀𑆥𑇀𑆫𑆯𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆶𑆥𑆪𑆳𑆠𑆴𑇆𑇑𑇘𑇆
𑆃𑆡𑆳𑆣𑆴𑆓𑆩𑇀𑆪𑆳𑆫𑇀𑆡𑆩𑆒𑆟𑇀𑆝𑆴𑆠𑆁 𑆣𑆴𑆪𑆳 𑆓𑆘𑆾𑆰𑇀𑆛𑇀𑆫𑆓𑆾𑆯𑇀𑆮𑆳𑆮𑇀𑆪𑆘𑆑𑆫𑇀𑆩 𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇅 𑆃𑆥𑆸𑆖𑇀𑆗𑆢𑆼𑆤𑆁 𑆱 𑆖 𑆧𑆱𑇀𑆠𑆴𑆩𑆧𑇀𑆫𑆮𑆵𑆢𑇀𑆮𑆴𑆣𑆴𑆁 𑆖 𑆠𑆱𑇀𑆪𑆳𑆲 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆖𑆾𑆢𑆴𑆠𑆂𑇆𑇑𑇙𑇆
𑆄𑆘𑆾𑆫𑆟𑆿 𑆱𑆿𑆩𑇀𑆪 𑆓𑆘𑆾𑆰𑇀𑆛𑇀𑆫𑆪𑆾𑆂 𑆑𑆸𑆠𑆼 𑆓𑆮𑆳𑆯𑇀𑆮𑆪𑆾𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆩𑆶𑆯𑆤𑇀𑆠𑆴 𑆩𑆳𑆲𑆴𑆰𑆩𑇀𑇅 𑆃𑆘𑆳𑆮𑆴𑆑𑆳𑆤𑆳𑆁 𑆠𑆶 𑆘𑆫𑆢𑇀𑆓𑆮𑆾𑆢𑇀𑆨𑆮𑆁 𑆮𑆢𑆤𑇀𑆠𑆴 𑆧𑆱𑇀𑆠𑆴𑆁 𑆠𑆢𑆶𑆥𑆳𑆪𑆖𑆴𑆤𑇀𑆠𑆑𑆳𑆂𑇆𑇒𑇐𑇆
𑆃𑆫𑆠𑇀𑆤𑆴𑆩𑆰𑇀𑆛𑆳𑆢𑆯𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆠𑆡𑆽𑆮 𑆤𑆼𑆠𑇀𑆫𑆁 𑆲𑆴 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆑𑇀𑆫𑆩𑆳𑆠𑇀𑇅 𑆓𑆘𑆾𑆰𑇀𑆛𑇀𑆫𑆓𑆾𑆯𑇀𑆮𑆳𑆮𑇀𑆪𑆘𑆧𑆱𑇀𑆠𑆴𑆱𑆤𑇀𑆣𑆿 𑆖𑆠𑆶𑆫𑇀𑆡𑆨𑆳𑆓𑆾𑆥𑆤𑆪𑆁 𑆲𑆴𑆠𑆁 𑆮𑆢𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆥𑇀𑆫𑆱𑇀𑆡𑆱𑇀𑆠𑇀𑆮𑆘𑆳𑆮𑇀𑆪𑆾𑆫𑇀𑆲𑆴 𑆤𑆴𑆫𑆷𑆲𑆩𑆳𑆠𑇀𑆫𑆳 𑆓𑆮𑆳𑆢𑆴𑆰𑆶 𑆢𑇀𑆮𑆴𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇅 𑆤𑆴𑆫𑆷𑆲𑆩𑆶𑆰𑇀𑆛𑇀𑆫𑆱𑇀𑆪 𑆠𑆡𑆳𑇁𑇁𑆞𑆑𑆢𑇀𑆮𑆪𑆁 𑆓𑆘𑆱𑇀𑆪 𑆮𑆸𑆢𑇀𑆣𑆴𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆮𑆳𑆱𑆤𑆼𑇁𑆰𑇀𑆛𑆩𑆂𑇆𑇒𑇒𑇆
𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆶𑆰𑇀𑆜𑆼 𑆩𑆣𑆶𑆑𑆁 𑆖 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆮𑆖𑆳 𑆯𑆠𑆳𑆲𑇀𑆮𑆳 𑆩𑆢𑆤𑆁 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇅 𑆲𑆴𑆠𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆓𑆶𑆝𑆂 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆾 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆖 𑆮𑆴𑆑𑆬𑇀𑆥𑆤𑆳 𑆠𑇀𑆮𑆴𑆪𑆩𑇀𑇆𑇒𑇓𑇆
𑆓𑆘𑆼𑇁𑆣𑆴𑆑𑆳𑇁𑆯𑇀𑆮𑆠𑇀𑆡𑆮𑆛𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆑𑆳𑆂 𑆱𑆒𑆳𑆢𑆴𑆫𑆥𑇀𑆫𑆓𑇀𑆫𑆲𑆯𑆳𑆬𑆠𑆳𑆬𑆘𑆳𑆂𑇅 𑆠𑆡𑆳 𑆖 𑆥𑆫𑇀𑆟𑇀𑆪𑆿 𑆣𑆮𑆯𑆴𑆓𑇀𑆫𑆶𑆥𑆳𑆛𑆬𑆵 𑆩𑆣𑆷𑆑𑆱𑆳𑆫𑆳𑆂 𑆱𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆂𑇆𑇒𑇔𑇆
𑆥𑆬𑆳𑆯𑆨𑆷𑆠𑆵𑆑𑆱𑆶𑆫𑆳𑆲𑇀𑆮𑆫𑆾𑆲𑆴𑆟𑆵𑆑𑆰𑆳𑆪 𑆇𑆑𑇀𑆠𑆱𑇀𑆠𑇀𑆮𑆣𑆴𑆑𑆾 𑆓𑆮𑆳𑆁 𑆲𑆴𑆠𑆂𑇅 𑆥𑆬𑆳𑆯𑆢𑆤𑇀𑆠𑆵𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆑𑆠𑇀𑆠𑆸𑆟𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪 𑆇𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆶𑆫𑆓𑆱𑇀𑆪 𑆖𑆳𑆣𑆴𑆑𑆳𑆂𑇆𑇒𑇕𑇆
𑆒𑆫𑆾𑆰𑇀𑆛𑇀𑆫𑆪𑆾𑆂 𑆥𑆵𑆬𑆶𑆑𑆫𑆵𑆫𑆒𑆳𑆢𑆴𑆫𑆳𑆂 𑆯𑆩𑇀𑆪𑆳𑆑𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆓𑆟𑆱𑇀𑆪 𑆖 𑆖𑇀𑆗𑆢𑆳𑆂𑇅 𑆃𑆘𑆳𑆮𑆴𑆑𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑆫𑆷𑆰𑆑𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶 𑆱𑆧𑆴𑆬𑇀𑆮𑆑𑆾𑆬𑆘𑆩𑇀𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆱𑆠𑆠𑆳𑆠𑆶𑆫𑆳𑆤𑇀 𑆤𑆫𑆳𑆤𑇀 𑆲𑆴𑆠𑆁 𑆖 𑆥𑆥𑇀𑆫𑆖𑇀𑆗 𑆓𑆶𑆫𑆶𑆱𑇀𑆠𑆢𑆳𑆲 𑆖𑇅 𑆱𑆢𑆳𑇁𑇁𑆠𑆶𑆫𑆳𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆴𑆪𑆫𑆳𑆘𑆱𑆼𑆮𑆑𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑆮𑆼𑆯𑇀𑆪𑆳 𑆱𑆲 𑆥𑆟𑇀𑆪𑆘𑆵𑆮𑆴𑆨𑆴𑆂𑇆𑇒𑇗𑇆
𑆢𑇀𑆮𑆴𑆘𑆾 𑆲𑆴 𑆮𑆼𑆢𑆳𑆣𑇀𑆪𑆪𑆤𑆮𑇀𑆫𑆠𑆳𑆲𑇀𑆤𑆴𑆑𑆑𑇀𑆫𑆴𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆢𑆼𑆲𑆲𑆴𑆠𑆁 𑆤 𑆖𑆼𑆰𑇀𑆛𑆠𑆼 𑇅 𑆤𑆸𑆥𑆾𑆥𑆱𑆼𑆮𑆵 𑆤𑆸𑆥𑆖𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆰𑆟𑆳𑆠𑇀 𑆥𑆫𑆳𑆤𑆶𑆫𑆾𑆣𑆳𑆢𑇀𑆧𑆲𑆶𑆖𑆴𑆤𑇀𑆠𑆤𑆳𑆢𑇀𑆨𑆪𑆳𑆠𑇀 𑇆𑇒𑇘𑇆
𑆤𑆸𑆖𑆴𑆠𑇀𑆠𑆮𑆫𑇀𑆠𑆴𑆤𑇀𑆪𑆶𑆥𑆖𑆳𑆫𑆠𑆠𑇀𑆥𑆫𑆳 𑆩𑆸𑆘𑆳𑆨𑆴(𑆮𑆴)𑆨𑆷𑆰𑆳𑆤𑆴𑆫𑆠𑆳 𑆥𑆟𑆳𑆕𑇀𑆓𑆤𑆳𑇅 𑆱𑆢𑆳𑆱𑆤𑆳𑆢𑆠𑇀𑆪𑆤𑆶𑆧𑆤𑇀𑆣𑆮𑆴𑆑𑇀𑆫𑆪𑆑𑇀𑆫𑆪𑆳𑆢𑆴𑆬𑆾𑆨𑆳𑆢𑆥𑆴 𑆥𑆟𑇀𑆪𑆘𑆵𑆮𑆴𑆤𑆂𑇆𑇒𑇙𑇆
𑆱𑆢𑆽𑆮 𑆠𑆼 𑆲𑇀𑆪𑆳𑆓𑆠𑆮𑆼𑆓𑆤𑆴𑆓𑇀𑆫𑆲𑆁 𑆱𑆩𑆳𑆖𑆫𑆤𑇀𑆠𑆼 𑆤 𑆖 𑆑𑆳𑆬𑆨𑆾𑆘𑆤𑆩𑇀𑇅 𑆃𑆑𑆳𑆬𑆤𑆴𑆫𑇀𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆱𑆼𑆮𑆴𑆤𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆼𑇁𑆤𑇀𑆪𑆼𑇁𑆥𑆴 𑆱𑆢𑆳𑇁𑇁𑆠𑆶𑆫𑆳𑆯𑇀𑆖 𑆠𑆼𑇆𑇓𑇐𑇆
𑆱𑆩𑆵𑆫𑆟𑆁 𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆟𑆾𑆢𑇀𑆣𑆠𑆁 𑆮𑆴𑆧𑆤𑇀𑆣𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆫𑆶𑆘𑆳𑆑𑆫𑆁 𑆨𑆴𑆰𑆑𑇀𑇅 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆠𑆼𑆰𑆳𑆁 𑆦𑆬𑆮𑆫𑇀𑆠𑆴𑆩𑆳𑆢𑆴𑆠𑆂 𑆱𑆶𑆑𑆬𑇀𑆥𑆴𑆠𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆮𑆠𑆵𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇓𑇑𑇆
𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆽𑆫𑆟𑇀𑆝𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆤𑇀 𑆱𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑆤𑇀𑇅 𑆩𑆲𑆳𑆤𑇀𑆠𑆴 𑆩𑆷𑆬𑆳𑆤𑆴 𑆖 𑆥𑆚𑇀𑆖 𑆪𑆳𑆤𑆴 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆼 𑆢𑆣𑆴𑆩𑆱𑇀𑆠𑆶𑆱𑆁𑆪𑆶𑆠𑆼𑇆𑇓𑇒𑇆
𑆱𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆬𑆮𑆟𑆽𑆯𑇀𑆖 𑆥𑆚𑇀𑆖𑆨𑆴𑆫𑇀𑆮𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆁 𑆧𑆱𑇀𑆠𑆴𑆩𑆡 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆤𑆴𑆫𑆷𑆲𑆴𑆠𑆁 𑆣𑆤𑇀𑆮𑆫𑆱𑆼𑆤 𑆨𑆾𑆘𑆴𑆠𑆁 𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆠𑆽𑆬𑆼𑆤 𑆠𑆠𑆾𑇁𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀𑇆𑇓𑇓𑇆
𑆧𑆬𑆳𑆁 𑆱𑆫𑆳𑆱𑇀𑆤𑆳𑆁 𑆦𑆬𑆧𑆴𑆬𑇀𑆮𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆤𑇀 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆑𑆸𑆠𑆩𑆳𑆬𑆑𑆳𑆠𑇀 𑆦𑆬𑆩𑇀𑇅 𑆪𑆮𑆳𑆤𑇀 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆁𑆯𑇀𑆖 𑆥𑆖𑆼𑆘𑇀𑆘𑆬𑆳𑆞𑆑𑆼 𑆫𑆱𑆂 𑆱 𑆥𑆼𑆰𑇀𑆪𑆽𑆱𑇀𑆠𑆶 𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇓𑇔𑇆
𑆱𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆓𑆶𑆝𑆱𑆽𑆤𑇀𑆣𑆮𑆾 𑆲𑆴𑆠𑆂 𑆱𑆢𑆳𑆠𑆶𑆫𑆳𑆟𑆳𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆮𑆫𑇀𑆣𑆤𑆂𑇅 𑆠𑆡𑆳𑇁𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆼 𑆩𑆣𑆶𑆑𑆼𑆤 𑆱𑆳𑆣𑆴𑆠𑆁 𑆦𑆬𑆼𑆤 𑆧𑆴𑆬𑇀𑆮𑆼𑆤 𑆯𑆠𑆳𑆲𑇀𑆮𑆪𑆳𑇁𑆥𑆴 𑆮𑆳𑇆𑇓𑇕𑇆
𑆱𑆘𑆵𑆮𑆤𑆵𑆪𑆱𑇀𑆠𑆶 𑆫𑆱𑆾𑇁𑆤𑆶𑆮𑆳𑆱𑆤𑆼 𑆤𑆴𑆫𑆷𑆲𑆟𑆼 𑆖𑆳𑆬𑆮𑆟𑆂 𑆯𑆴𑆯𑆾𑆫𑇀𑆲𑆴𑆠𑆂𑇅 𑆤 𑆖𑆳𑆤𑇀𑆪𑆢𑆳𑆯𑇀𑆮𑆕𑇀𑆓𑆧𑆬𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆤𑆁 𑆤𑆴𑆫𑆷𑆲𑆧𑆱𑇀𑆠𑆼𑆂 𑆯𑆴𑆯𑆶𑆮𑆸𑆢𑇀𑆣𑆪𑆾𑆂 𑆥𑆫𑆩𑇀𑇆𑇓𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆦𑆬𑆑𑆫𑇀𑆩 𑆧𑆱𑇀𑆠𑆴𑆮𑆫𑆠𑆳 𑆤𑆼𑆠𑇀𑆫𑆁 𑆪𑆢𑇀𑆧𑆱𑇀𑆠𑆪𑆾 𑆓𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑇀𑇅 𑆱𑆠𑆠𑆳𑆠𑆶𑆫𑆳𑆯𑇀𑆖 𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆦𑆬𑆩𑆳𑆠𑇀𑆫𑆳𑆪𑆳𑆁 𑆲𑆴𑆠𑆁 𑆖𑆽𑆰𑆳𑆩𑇀𑇆𑇓𑇗𑇆
𑆃𑆡𑆳𑆠 𑆇𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆡 𑆱𑇀𑆮𑆬𑇀𑆮𑆳𑆠𑆶𑆫𑆁 𑆮𑆽𑆢𑇀𑆪𑆂 𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆁 𑆮𑆩𑆤𑆳𑆢𑆴𑆨𑆴𑆂𑇅 𑆢𑆶𑆫𑇀𑆧𑆬𑆁 𑆑𑆸𑆯𑆩𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆴𑆁 𑆩𑆶𑆑𑇀𑆠𑆱𑆤𑇀𑆣𑆳𑆤𑆧𑆤𑇀𑆣𑆤𑆩𑇀𑇆𑇓𑇆
𑆤𑆴𑆫𑇀𑆲𑆸𑆠𑆳𑆤𑆴𑆬𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆸𑆯𑆳𑆯𑆪𑆩𑇀𑇅 𑆯𑆷𑆤𑇀𑆪𑆢𑆼𑆲𑆁 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆁 𑆥𑆫𑆴𑆥𑆳𑆬𑆪𑆼𑆠𑇀𑇆𑇔𑇆
𑆪𑆡𑆳𑇁𑆟𑇀𑆝𑆁 𑆠𑆫𑆶𑆟𑆁 𑆥𑆷𑆫𑇀𑆟𑆁 𑆠𑆽𑆬𑆥𑆳𑆠𑇀𑆫𑆁 𑆪𑆡𑆽𑆮 𑆖𑇅 𑆓𑆾𑆥𑆳𑆬 𑆅𑆮 𑆢𑆟𑇀𑆝𑆵 𑆓𑆳𑆂 𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆳𑆢𑆥𑆖𑆳𑆫𑆠𑆂𑇆𑇕𑇆

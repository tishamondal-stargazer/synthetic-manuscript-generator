𑆠𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆼𑆮𑆳𑆯𑆶 𑆯𑆸𑆠𑆁 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆠𑆽𑆬𑆁 𑆠𑆴𑆬𑆳𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆧𑆱𑇀𑆠𑆪𑆯𑇀𑆖 𑇅 𑆄𑆫𑇀𑆢𑇀𑆫𑆽𑆂 𑆑𑆶𑆯𑆽𑆂 𑆱𑆩𑇀𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆳𑆤𑆴 𑆮𑆸𑆤𑇀𑆠𑆳𑆤𑇀𑆪𑆡𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆟𑆴 𑆲𑆴 𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆤𑆳𑆩𑇀 𑇆𑇑𑇔𑇑𑇆
𑆥𑆑𑇀𑆮𑆳𑆤𑆴 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆶𑆛𑆥𑆳𑆑𑆪𑆾𑆓𑆼𑆤𑆳𑆥𑆾𑆡𑇀𑆪 𑆠𑆼𑆨𑇀𑆪𑆾 𑆫𑆱𑆩𑆳𑆢𑆢𑆵𑆠 𑇅 𑆑𑇀𑆰𑆵𑆫𑆁 𑆯𑆸𑆠𑆁 𑆠𑆽𑆬𑆲𑆮𑆴𑆫𑇀𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆁 𑆑𑆬𑇀𑆑𑆼𑆤 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑇀𑆪 𑆮𑆳𑇁𑆥𑆴 𑇆𑇑𑇔𑇒𑇆
𑆧𑆱𑇀𑆠𑆴𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑆕𑇀𑆓𑆼 𑇅 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆑𑇀𑆮𑆡𑆴𑆠𑆼𑆤 𑆯𑆷𑆬𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆩𑆳𑆟𑆱𑇀𑆪 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆼𑆟 𑇆𑇑𑇔𑇓𑇆
𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆖𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆓𑇀𑆫𑇀𑆪𑆩𑆶𑆑𑇀𑆠𑆁... 𑇅𑆠𑆽𑆬𑆼𑆤 𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆖 𑇅 𑆮𑆳𑆠𑆔𑇀𑆤𑆮𑆫𑇀𑆓𑆼 𑆬𑆮𑆟𑆼𑆰𑆶 𑆖𑆽𑆮 𑆠𑆽𑆬𑆁 𑆖 𑆱𑆴𑆢𑇀𑆣𑆁 𑆲𑆴𑆠𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆼 𑇆𑇑𑇔𑇔𑇆
𑆬𑆾𑆣𑇀𑆫𑆁 𑆮𑆴𑆝𑆁 𑆧𑆴𑆬𑇀𑆮𑆯𑆬𑆳𑆛𑆶 𑆖𑆽𑆮 𑆬𑆴𑆲𑇀𑆪𑆳𑆖𑇀𑆖 𑆠𑆽𑆬𑆼𑆤 𑆑𑆛𑆶𑆠𑇀𑆫𑆴𑆑𑆳𑆞𑇀𑆪𑆩𑇀 𑇅 𑆢𑆣𑇀𑆤𑆳 𑆱𑆱𑆳𑆫𑆼𑆟 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆼𑆟 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆤𑆴𑆯𑇀𑆖𑆳(𑆱𑇀𑆱𑆳)𑆫𑆑𑆥𑆵𑆝𑆴𑆠𑆱𑇀𑆠𑆶 𑇆𑇑𑇔𑇕𑇆
𑆱𑆶𑆠𑆥𑇀𑆠𑆑𑆶𑆥𑇀𑆪𑆑𑇀𑆮𑆡𑆴𑆠𑆼𑆤 𑆮𑆳𑇁𑆥𑆴 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆯𑆵𑆠𑆼𑆤 𑆩𑆣𑆶𑆥𑇀𑆬𑆶𑆠𑆼𑆤 𑇅 𑆯𑆷𑆬𑆳𑆫𑇀𑆢𑆴𑆠𑆾 𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆢𑆶𑆓𑇀𑆣𑆼𑆤 𑆲𑆴𑆠𑆳𑆪 𑆨𑆾𑆘𑇀𑆪𑆂 𑇆𑇑𑇔𑇖𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆢𑆵𑆥𑆤𑆵𑆪𑆽𑆂 𑆑𑆸𑆠𑆳𑆤𑇀 𑆰𑆝𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖 𑇅 𑆒𑆳𑆢𑆼𑆖𑇀𑆖 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑇀 𑆫𑆱𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆖𑇀𑆖 𑆮𑆳𑆠𑆔𑇀𑆤𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆔𑆸𑆠𑆁 𑆱𑆠𑆽𑆬𑆩𑇀 𑇆𑇑𑇔𑇗𑇆
𑆩𑆲𑆳𑆫𑆶𑆘𑆼 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆨𑆴𑆰𑆓𑇀 𑆧𑆱𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆥𑆪𑆾𑆩𑆣𑆶𑆔𑆸𑆠𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆁 𑆩𑆣𑆶𑆑𑆾𑆠𑇀𑆥𑆬𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇆𑇑𑇕𑇐𑇆
𑆱 𑆧𑆱𑇀𑆠𑆴𑆂 𑆯𑆩𑆪𑆼𑆠𑇀𑆠𑆱𑇀𑆪 𑆫𑆑𑇀𑆠𑆁 𑆢𑆳𑆲𑆩𑆡𑆾 𑆘𑇀𑆮𑆫𑆩𑇀 𑇅𑇑𑇕𑇑𑇅 𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆲𑆴𑆠𑆁 𑆠𑆱𑇀𑆪𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇑𑇕𑇑𑇆
𑆫𑆳𑆠𑇀𑆫𑆳𑆮𑆲𑆤𑆴 𑆮𑆳 𑆤𑆴𑆠𑇀𑆪𑆁 𑆫𑆶𑆘𑆳𑆫𑇀𑆠𑆾 𑆪𑆾 𑆨𑆮𑆼𑆤𑇀𑆤𑆫𑆂 𑇅𑇑𑇕𑇒𑇅 𑆪𑆡𑆳 𑆪𑆡𑆳 𑆱𑆠𑆽𑆬𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆯𑆳𑆤𑇀𑆠𑆴𑆱𑇀𑆠𑆡𑆳 𑆠𑆡𑆳 𑇆𑇑𑇕𑇒𑇆
𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆼 𑆩𑆳𑆫𑆶𑆠𑆼 𑆖𑆳𑆥𑆴 𑆯𑆳𑆤𑇀𑆠𑆴𑆁 𑆪𑆳𑆠𑆴 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆫𑆾𑆓𑆼 𑆩𑆳𑆫𑆶𑆠𑆁 𑆯𑆩𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇕𑇓𑇆
𑆥𑆳𑆜𑆳𑆘𑆩𑆾𑆢𑆳𑆑𑆶𑆛𑆘𑆾𑆠𑇀𑆥𑆬𑆁 𑆖 𑆯𑆶𑆟𑇀𑆜𑆵 𑆱𑆩𑆳 𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆯𑇀𑆖 𑆥𑆴𑆰𑇀𑆛𑆳𑆂 𑇅 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆥𑆵𑆠𑆳𑆂 𑆯𑆩𑆪𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆁... 𑇅𑇑𑇕𑇔𑇅 ... 𑆩𑆼𑆣𑇀𑆪𑆳𑆟𑇀𑆝𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆔𑆸𑆠𑆁 𑆥𑆪𑆾 𑆮𑆳 𑇆𑇑𑇕𑇔𑇆
𑆯𑆶𑆟𑇀𑆜𑆵𑆁 𑆔𑆸𑆠𑆁 𑆱𑆑𑇀𑆰𑆮𑆑𑆁 𑆱𑆠𑆽𑆬𑆁 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆬𑆵𑆞𑇀𑆮𑆳𑇁𑇁𑆩𑆪𑆩𑆳𑆯𑆶 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑇅𑇑𑇕𑇕𑇅 𑆓𑆘𑆳𑆯𑆤𑆳𑆑𑆶𑆩𑇀𑆨𑆴𑆑𑆢𑆳𑆝𑆴𑆩𑆳𑆤𑆳𑆁 𑆫𑆱𑆽𑆂 𑆑𑆸𑆠𑆳 𑆠𑆽𑆬𑆔𑆸𑆠𑆼 𑆱𑆢𑆣𑇀𑆤𑆴 𑇆𑇑𑇕𑇕𑇆
𑆧𑆴𑆬𑇀𑆮𑆳𑆤𑇀𑆮𑆴𑆠𑆳 𑆥𑆡𑇀𑆪𑆠𑆩𑆳 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆣𑆳𑆫𑆾𑆰𑇀𑆟𑆢𑆶𑆓𑇀𑆣𑆱𑇀𑆪 𑆠𑆡𑆳 𑆖 𑆥𑆳𑆤𑆩𑇀 𑇅𑇑𑇕𑇖𑇅 𑆬𑆔𑆷𑆤𑆴 𑆥𑆡𑇀𑆪𑆳𑆤𑇀𑆪𑆡 𑆢𑆵𑆥𑆤𑆳𑆤𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑇀𑆪𑆶𑆢𑆫𑆳𑆩𑆪𑆼𑆰𑆶 𑇆𑇑𑇕𑇖𑇆
𑆲𑆴𑆠𑆳𑆪 𑆤𑆴𑆠𑇀𑆪𑆁 𑆮𑆴𑆠𑆫𑆼𑆢𑇀𑆮𑆴𑆨𑆘𑇀𑆪 𑆪𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆨𑆴𑆰𑆓𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆂 𑇆𑇑𑇕𑇗𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆥𑆤𑆪𑆤𑆵 𑆬𑆔𑇀𑆮𑆵 𑆢𑆵𑆥𑆤𑆵 𑆧𑆱𑇀𑆠𑆴𑆯𑆾𑆣𑆤𑆵 𑇅 𑆘𑇀𑆮𑆫𑆼 𑆖𑆽𑆮𑆳𑆠𑆴𑆱𑆳𑆫𑆼 𑆖 𑆪𑆮𑆳𑆓𑆷𑆂 𑆱𑆫𑇀𑆮𑆢𑆳 𑆲𑆴𑆠𑆳 𑇆𑇑𑇕𑇘𑇆
𑆫𑆷𑆑𑇀𑆰𑆳𑆘𑇀𑆘𑆳𑆠𑆼 𑆑𑇀𑆫𑆴𑆪𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆱𑇀𑆤𑆼𑆲𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆼 𑇅 𑆨𑆪𑆘𑆼 𑆱𑆳𑆤𑇀𑆠𑇀𑆮𑆤𑆳𑆥𑆷𑆫𑇀𑆮𑆳 𑆯𑆾𑆑𑆘𑆼 𑆯𑆾𑆑𑆤𑆳𑆯𑆴𑆤𑆵 𑇆𑇑𑇕𑇙𑇆

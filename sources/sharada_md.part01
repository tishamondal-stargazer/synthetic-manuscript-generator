𑆠𑆳𑆤𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑇀 𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆂 𑆱𑆲𑆼𑆠𑆷𑆥𑆑𑇀𑆫𑆩𑆳𑆚𑇀𑆗𑆸𑆟𑆶𑇅 𑆑𑆼𑆮𑆬𑆁 𑆮𑆳𑆪𑆶𑆩𑆶𑆢𑇀𑆢𑆴𑆯𑇀𑆪 𑆱𑇀𑆡𑆳𑆤𑆨𑆼𑆢𑆳𑆠𑇀𑆠𑆡𑆳𑇁𑇁𑆮𑆸𑆠𑆩𑇀𑇆𑇑𑇔𑇆
𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆳𑆬𑇀𑆥𑆬𑆔𑇀𑆮𑆤𑇀𑆤𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆠𑆴𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆽𑆂𑇅 𑆮𑆴𑆰𑆩𑆳𑆢𑆶𑆥𑆖𑆳𑆫𑆳𑆖𑇀𑆖 𑆢𑆾𑆰𑆳𑆱𑆸𑆑𑇀𑆱𑇀𑆫𑆮𑆟𑆳𑆢𑆠𑆴𑇆𑇑𑇕𑇆
𑆬𑆕𑇀𑆔𑆤𑆥𑇀𑆬𑆮𑆤𑆳𑆠𑇀𑆪𑆣𑇀𑆮𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆠𑆴𑆮𑆴𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆽𑆂𑇅 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆳𑆖𑇀𑆖𑆴𑆤𑇀𑆠𑆳𑆯𑆾𑆑𑆫𑆾𑆓𑆳𑆠𑆴𑆑𑆫𑇀𑆰𑆟𑆳𑆠𑇀𑇆𑇑𑇖𑇆
𑆢𑆶𑆂𑆒𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆳𑆠𑇀 𑆑𑇀𑆫𑆾𑆣𑆳𑆢𑇀𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆢𑇀𑆨𑆪𑆳𑆢𑆥𑆴𑇅 𑆮𑆼𑆓𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆢𑆳𑆩𑆳𑆢𑆨𑆴𑆔𑆳𑆠𑆳𑆢𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇆𑇑𑇗𑇆
𑆩𑆫𑇀𑆩𑆳𑆔𑆳𑆠𑆳𑆢𑇀𑆓𑆘𑆾𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑇀𑆮𑆯𑆵𑆔𑇀𑆫𑆪𑆳𑆤𑆳𑆥𑆠𑆁𑆱𑆤𑆳𑆠𑇀𑇅 𑆢𑆼𑆲𑆼 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆫𑆴𑆑𑇀𑆠𑆳𑆤𑆴 𑆥𑆷𑆫𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆤𑆴𑆬𑆾 𑆧𑆬𑆵𑇆𑇑𑇘𑇆
𑆑𑆫𑆾𑆠𑆴 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆽𑆑𑆳𑆕𑇀𑆓𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑇀𑇅𑇑𑇙𑇅 𑆃𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆠𑆼𑆰𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆩𑆴𑆠𑆴 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇙𑇆
𑆄𑆠𑇀𑆩𑆫𑆷𑆥𑆁 𑆠𑆶 𑆠𑆢𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆩𑆥𑆳𑆪𑆾 𑆬𑆔𑆶𑆠𑆳 𑆥𑆶𑆤𑆂𑇅𑇒𑇐𑇅 𑆱𑆕𑇀𑆑𑆾𑆖𑆂 𑆥𑆫𑇀𑆮𑆟𑆳𑆁 𑆱𑇀𑆠𑆩𑇀𑆨𑆾 𑆨𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆥𑆫𑇀𑆮𑆟𑆳𑆩𑆥𑆴𑇆𑇒𑇐𑇆
𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆯𑇀𑆖 𑆥𑆳𑆟𑆴𑆥𑆸𑆰𑇀𑆜𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆲𑆂𑇅 𑆒𑆳𑆚𑇀𑆘𑇀𑆪𑆥𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆑𑆶𑆧𑇀𑆘𑆠𑇀𑆮𑆁 𑆯𑆾𑆰𑆾𑇁𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑆤𑆴𑆢𑇀𑆫𑆠𑆳𑇆𑇒𑇑𑇆
𑆓𑆫𑇀𑆨𑆯𑆶𑆑𑇀𑆫𑆫𑆘𑆾𑆤𑆳𑆯𑆂 𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆁 𑆓𑆳𑆠𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆠𑆳𑇅 𑆯𑆴𑆫𑆾𑆤𑆳𑆱𑆳𑆑𑇀𑆰𑆴𑆘𑆠𑇀𑆫𑆷𑆟𑆳𑆁 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆲𑆶𑆟𑇀𑆝𑆤𑆩𑇀𑇆𑇒𑇒𑇆
𑆨𑆼𑆢𑆱𑇀𑆠𑆾𑆢𑆳𑆫𑇀𑆠𑆴𑆫𑆳𑆑𑇀𑆰𑆼𑆥𑆾 𑆩𑆾𑆲𑆯𑇀𑆖𑆳𑆪𑆳𑆱 𑆍𑆮 𑆖𑇅 𑆍𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆴 𑆫𑆷𑆥𑆳𑆟𑆴 𑆑𑆫𑆾𑆠𑆴 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇒𑇓𑇆
𑆲𑆼𑆠𑆶𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖 𑆨𑆮𑆼𑆢𑇀𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆑𑆸𑆠𑇀𑇅𑇒𑇔𑇅 𑆠𑆠𑇀𑆫 𑆑𑆾𑆰𑇀𑆜𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑆢𑆶𑆰𑇀𑆛𑆼 𑆤𑆴𑆓𑇀𑆫𑆲𑆾 𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑆾𑆂𑇆𑇒𑇔𑇆
𑆧𑇀𑆫𑆣𑇀𑆤𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆁 𑆖 𑆩𑆳𑆫𑆶𑆠𑆼𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆑𑆶𑆥𑆴𑆠𑆼 𑆮𑆳𑆠𑆼 𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆦𑆶𑆫𑆟𑆨𑆚𑇀𑆘𑆤𑆼𑇆𑇒𑇕𑇆
𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆂 𑆥𑆫𑆵𑆠𑆯𑇀𑆖 𑆱𑇀𑆦𑆶𑆛𑆤𑇀𑆠𑆵𑆮𑆳𑆱𑇀𑆪 𑆱𑆤𑇀𑆣𑆪𑆂𑇅 𑆓𑇀𑆫𑆲𑆾 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆠𑆳𑆤𑆳𑆁 𑆯𑆷𑆬𑆳𑆣𑇀𑆩𑆳𑆤𑆳𑆯𑇀𑆩𑆯𑆫𑇀𑆑𑆫𑆳𑆂𑇆𑇒𑇖𑇆
𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆠𑇀𑆫𑆴𑆑𑆥𑆳𑆠𑇀𑆥𑆸𑆰𑇀𑆜𑆫𑆾𑆓𑆯𑆾𑆰𑆿 𑆓𑆶𑆢𑆱𑇀𑆡𑆴𑆠𑆼𑇅 𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆫𑆶𑆑𑇀𑆠𑆸𑆰𑇀𑆟𑆾𑆢𑇀𑆓𑆳𑆫𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆂𑇆𑇒𑇗𑇆
𑆑𑆳𑆱𑆂 𑆑𑆟𑇀𑆜𑆳𑆱𑇀𑆪𑆯𑆾𑆰𑆯𑇀𑆖 𑆯𑇀𑆮𑆳𑆱𑆯𑇀𑆖𑆳𑆩𑆳𑆯𑆪𑆱𑇀𑆡𑆴𑆠𑆼𑇅 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆾𑇁𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆁 𑆯𑆷𑆬𑆳𑆛𑆾𑆥𑆿 𑆑𑆫𑆾𑆠𑆴 𑆖𑇆𑇒𑇘𑇆
𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆠𑇀𑆮𑆩𑆳𑆤𑆳𑆲𑆁 𑆠𑇀𑆫𑆴𑆑𑆮𑆼𑆢𑆤𑆳𑆩𑇀𑇅 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆢𑆴𑆰𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆣𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆱𑆩𑆵𑆫𑆟𑆂𑇆𑇒𑇙𑇆
𑆠𑇀𑆮𑆓𑇀𑆫𑆷𑆑𑇀𑆰𑆳 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆳 𑆱𑆶𑆥𑇀𑆠𑆳 𑆑𑆸𑆯𑆳 𑆑𑆸𑆰𑇀𑆟𑆳 𑆖 𑆠𑆶𑆢𑇀𑆪𑆠𑆼𑇅 𑆄𑆠𑆤𑇀𑆪𑆠𑆼 𑆱𑆫𑆳𑆓𑆳 𑆖 𑆥𑆫𑇀𑆮𑆫𑆶𑆑𑇀 𑆠𑇀𑆮𑆑𑇀𑆱𑇀𑆡𑆴𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇆𑇓𑇐𑇆
𑆫𑆶𑆘𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆳𑆂 𑆱𑆱𑆤𑇀𑆠𑆳𑆥𑆳 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆑𑆸𑆯𑆠𑆳𑇁𑆫𑆶𑆖𑆴𑆂𑇅 𑆓𑆳𑆠𑇀𑆫𑆼 𑆖𑆳𑆫𑆷𑆁𑆰𑆴 𑆨𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖𑆳𑆱𑆸𑆓𑇀𑆓𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇆𑇓𑇑𑇆
𑆓𑆶𑆫𑇀𑆮𑆕𑇀𑆓𑆁 𑆠𑆶𑆢𑇀𑆪𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆟𑇀𑆝𑆩𑆶𑆰𑇀𑆛𑆴𑆲𑆠𑆁 𑆠𑆡𑆳𑇅 𑆱𑆫𑆶𑆑𑇀 𑆯𑇀𑆫𑆩𑆴𑆠𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑆓𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇆𑇓𑇒𑇆
𑆨𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑆴𑆥𑆫𑇀𑆮𑆟𑆳𑆁 𑆱𑆤𑇀𑆣𑆴𑆯𑆷𑆬𑆁 𑆩𑆳𑆁𑆱𑆧𑆬𑆑𑇀𑆰𑆪𑆂𑇅 𑆃𑆱𑇀𑆮𑆥𑇀𑆤𑆂 𑆱𑆤𑇀𑆠𑆠𑆳 𑆫𑆶𑆑𑇀 𑆖 𑆩𑆘𑇀𑆘𑆳𑆱𑇀𑆡𑆴𑆑𑆶𑆥𑆴𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇆𑇓𑇓𑇆
𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑆧𑆣𑇀𑆤𑆳𑆠𑆴 𑆯𑆶𑆑𑇀𑆫𑆁 𑆓𑆫𑇀𑆨𑆩𑆡𑆳𑆥𑆴 𑆮𑆳𑇅 𑆮𑆴𑆑𑆸𑆠𑆴𑆁 𑆘𑆤𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆡𑆂 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇓𑇔𑇆
𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆩𑆳𑆪𑆳𑆩𑆁 𑆒𑆬𑇀𑆬𑆴𑆁 𑆑𑆶𑆧𑇀𑆘𑆠𑇀𑆮𑆩𑆼𑆮 𑆖𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆽𑆑𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆳𑆪𑆶𑆓𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇓𑇕𑇆
𑆯𑆫𑆵𑆫𑆁 𑆩𑆤𑇀𑆢𑆫𑆶𑆑𑇀𑆯𑆾𑆦𑆁 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆠𑆡𑆳𑇅 𑆱𑆶𑆥𑇀𑆠𑆳𑆱𑇀𑆠𑆤𑇀𑆮𑇀𑆪𑆾 𑆩𑆲𑆠𑇀𑆪𑆾 𑆮𑆳 𑆱𑆴𑆫𑆳 𑆮𑆳𑆠𑆼 𑆱𑆴𑆫𑆳𑆓𑆠𑆼𑇆𑇓𑇖𑇆
𑆮𑆳𑆠𑆥𑆷𑆫𑇀𑆟𑆢𑆸𑆠𑆴𑆱𑇀𑆥𑆫𑇀𑆯𑆂 𑆯𑆾𑆡𑆂 𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇅 𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆪𑆾𑆂 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆱𑆮𑆼𑆢𑆤𑆳𑇆𑇓𑇗𑇆
(𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑇀𑆡𑆳𑆤𑆨𑆼𑆢𑆼𑆤 𑆮𑆳𑆪𑆾𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆩𑆼𑆮 𑆖)𑇅𑇓𑇘𑇅 𑆃𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆂 𑆯𑆫𑆵𑆫𑆳𑆫𑇀𑆣𑆩𑆼𑆑𑆁 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆪𑆢𑆳 𑆠𑆢𑆾𑆥𑆯𑆾𑆰𑇀𑆪𑆳𑆱𑆸𑆓𑇀𑆧𑆳𑆲𑆶𑆁 𑆥𑆳𑆢𑆁 𑆖 𑆘𑆳𑆤𑆶 𑆖𑇆𑇓𑇘𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆕𑇀𑆑𑆾𑆖𑆪𑆠𑇀𑆪𑆫𑇀𑆣𑆼 𑆩𑆶𑆒𑆁 𑆘𑆴𑆲𑇀𑆩𑆁 𑆑𑆫𑆾𑆠𑆴 𑆖𑇅 𑆮𑆑𑇀𑆫𑆵𑆑𑆫𑆾𑆠𑆴 𑆤𑆳𑆱𑆳𑆨𑇀𑆫𑆷𑆬𑆬𑆳𑆛𑆳𑆑𑇀𑆰𑆴𑆲𑆤𑆷𑆱𑇀𑆠𑆡𑆳𑇆𑇓𑇙𑇆
𑆠𑆠𑆾 𑆮𑆑𑇀𑆫𑆁 𑆮𑇀𑆫𑆘𑆠𑇀𑆪𑆳𑆱𑇀𑆪𑆼 𑆨𑆾𑆘𑆤𑆁 𑆮𑆑𑇀𑆫𑆤𑆳𑆱𑆴𑆑𑆩𑇀 𑇅 𑆱𑇀𑆠𑆧𑇀𑆣𑆁 𑆤𑆼𑆠𑇀𑆫𑆁 𑆑𑆡𑆪𑆠𑆂 𑆑𑇀𑆰𑆮𑆡𑆶𑆯𑇀𑆖 𑆤𑆴𑆓𑆸𑆲𑇀𑆪𑆠𑆼𑇆𑇔𑇐𑇆
𑆢𑆵𑆤𑆳 𑆘𑆴𑆲𑇀𑆩𑆳 𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆳 𑆑𑆬𑆳 𑆱𑆘𑇀𑆘𑆠𑆴 𑆖𑆳𑆱𑇀𑆪 𑆮𑆳𑆑𑇀𑇅 𑆢𑆤𑇀𑆠𑆳𑆯𑇀𑆖𑆬𑆤𑇀𑆠𑆴 𑆧𑆳𑆣𑇀𑆪𑆼𑆠𑆼 𑆯𑇀𑆫𑆮𑆟𑆿 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑆱𑇀𑆮𑆫𑆂𑇆𑇔𑇑𑇆
𑆥𑆳𑆢𑆲𑆱𑇀𑆠𑆳𑆑𑇀𑆰𑆴𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆯𑆕𑇀𑆒𑆯𑇀𑆫𑆮𑆟𑆓𑆟𑇀𑆝𑆫𑆶𑆑𑇀 𑇅 𑆃𑆫𑇀𑆣𑆼 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆼 𑆮𑆳 𑆑𑆼𑆮𑆬𑆼 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑆫𑇀𑆢𑆴𑆠𑆩𑇀𑇆𑇔𑇒𑇆
𑆩𑆤𑇀𑆪𑆼 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆮𑆳𑆠𑆾𑇁𑆤𑇀𑆠𑆫𑇀𑆪𑆢𑆳 𑆤𑆳𑆝𑆵𑆂 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆠𑆢𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆤𑇀𑆠𑆫𑆳𑆪𑆳𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆩𑇀𑇆𑇔𑇓𑇆
𑆃𑆤𑇀𑆠𑆫𑆳𑆪𑆩𑇀𑆪𑆠𑆼 𑆓𑇀𑆫𑆵𑆮𑆳 𑆩𑆤𑇀𑆪𑆳 𑆖 𑆱𑇀𑆠𑆨𑇀𑆪𑆠𑆼 𑆨𑆸𑆯𑆩𑇀𑇅 𑆢𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆁𑆯𑆤𑆁 𑆬𑆳𑆬𑆳 𑆥𑆸𑆰𑇀𑆜𑆳𑆪𑆳𑆩𑆂 𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆲𑆂𑇆𑇔𑇔𑇆
𑆘𑆸𑆩𑇀𑆨𑆳 𑆮𑆢𑆤𑆱𑆕𑇀𑆓𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆪𑆳𑆩𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 (𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆳𑆪𑆳𑆩𑆾 ...𑇅𑇔𑇕𑇅 ...𑆧𑆲𑆴𑆫𑆳𑆪𑆳𑆩 𑆇𑆖𑇀𑆪𑆠𑆼)𑇆𑇔𑇕𑇆
𑆥𑆸𑆰𑇀𑆜𑆩𑆤𑇀𑆪𑆳𑆯𑇀𑆫𑆴𑆠𑆳 𑆧𑆳𑆲𑇀𑆪𑆳𑆂 𑆯𑆾𑆰𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑆴𑆫𑆳 𑆧𑆬𑆵𑇅 𑆮𑆳𑆪𑆶𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆣𑆤𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆧𑆲𑆴𑆫𑆳𑆪𑆳𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑇀𑇆𑇔𑇖𑇆
𑆖𑆳𑆥𑆮𑆤𑇀𑆤𑆳𑆩𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆥𑆸𑆰𑇀𑆜𑆠𑆾 𑆤𑆵𑆪𑆠𑆼 𑆯𑆴𑆫𑆂𑇅 𑆇𑆫 𑆇𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆠𑆼 𑆩𑆤𑇀𑆪𑆳 𑆱𑇀𑆠𑆧𑇀𑆣𑆳 𑆓𑇀𑆫𑆵𑆮𑆳𑇁𑆮𑆩𑆸𑆢𑇀𑆪𑆠𑆼𑇆𑇔𑇗𑇆
𑆢𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆯𑆤𑆁 𑆘𑆸𑆩𑇀𑆨𑆳 𑆬𑆳𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖 𑆮𑆳𑆓𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆘𑆳𑆠𑆮𑆼𑆓𑆾 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆼𑆰 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆮𑆳 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆠𑆴𑇆𑇔𑇘𑇆
𑆲𑆤𑆶𑆩𑆷𑆬𑆼 𑆱𑇀𑆡𑆴𑆠𑆾 𑆧𑆤𑇀𑆣𑆳𑆠𑇀 𑆱𑆁𑆱𑇀𑆫𑆪𑆠𑇀𑆪𑆤𑆴𑆬𑆾 𑆲𑆤𑆷𑇅 𑆮𑆴𑆮𑆸𑆠𑆳𑆱𑇀𑆪𑆠𑇀𑆮𑆩𑆡𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆮𑆼𑆢𑆤𑆩𑇀𑇆𑇔𑇙𑇆
𑆲𑆤𑆶𑆓𑇀𑆫𑆲𑆁 𑆖 𑆱𑆁𑆱𑇀𑆠𑆨𑇀𑆪 𑆲𑆤𑆶𑆁(𑆤𑆷)𑆱𑆁𑆮𑆸𑆠𑆮𑆑𑇀𑆫𑆠𑆳𑆩𑇀𑇅𑇕𑇐𑇅 𑆩𑆶𑆲𑆶𑆫𑆳𑆑𑇀𑆰𑆴𑆥𑆠𑆴 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆾 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇕𑇐𑇆
𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆁 𑆖 𑆱𑆁𑆯𑆾𑆰𑇀𑆪 𑆱𑆴𑆫𑆳𑆂 𑆱𑆱𑇀𑆤𑆳𑆪𑆶𑆑𑆟𑇀𑆝𑆫𑆳𑆂𑇅𑇕𑇑𑇅 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆯𑆴𑆫𑆂𑆥𑆸𑆰𑇀𑆜𑆯𑇀𑆫𑆾𑆟𑆵𑆂 𑆱𑇀𑆠𑆨𑇀𑆤𑆳𑆠𑆴 𑆩𑆳𑆫𑆶𑆠𑆂𑇆𑇕𑇑𑇆
𑆢𑆟𑇀𑆝𑆮𑆠𑇀𑆱𑇀𑆠𑆧𑇀𑆣𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆢𑆟𑇀𑆝𑆑𑆂 𑆱𑆾𑇁𑆤𑆶𑆥𑆑𑇀𑆫𑆩𑆂𑇅𑇕𑇒𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆂 𑆱𑇀𑆪𑆳𑆢𑆫𑇀𑆢𑆴𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆩𑆶𑆲𑆶𑆫𑇀𑆮𑆼𑆓𑆼 𑆓𑆠𑆼𑇁𑆓𑆠𑆼𑇆𑇕𑇒𑇆
𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑆥𑆵𑆝𑆤𑆽𑆱𑇀𑆠𑆽𑆱𑇀𑆠𑆽𑆫𑇀𑆨𑆴𑆰𑆓𑆼𑆠𑆳𑆤𑇀 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅𑇕𑇓𑇅 𑆲𑆠𑇀𑆮𑆽𑆑𑆁 𑆩𑆳𑆫𑆶𑆠𑆂 𑆥𑆑𑇀𑆰𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆮𑆳𑆩𑆩𑆼𑆮 𑆮𑆳𑇆𑇕𑇓𑇆
𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆲𑆴 𑆫𑆶𑆘𑆁 𑆮𑆳𑆑𑇀𑆱𑇀𑆠𑆩𑇀𑆨𑆩𑆼𑆮 𑆖𑇅 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳𑇁𑆫𑇀𑆣𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆱𑆴𑆫𑆳𑆂 𑆱𑇀𑆤𑆳𑆪𑆷𑆫𑇀𑆮𑆴𑆯𑆾𑆰𑇀𑆪 𑆖𑇆𑇕𑇔𑇆
𑆥𑆳𑆢𑆁 𑆱𑆕𑇀𑆑𑆾𑆖𑆪𑆠𑇀𑆪𑆼𑆑𑆁 𑆲𑆱𑇀𑆠𑆁 𑆮𑆳 𑆠𑆾𑆢𑆯𑆷𑆬𑆑𑆸𑆠𑇀𑇅 𑆍𑆑𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆁 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆁 𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆘𑆩𑇀𑇆𑇕𑇕𑇆
𑆱𑇀𑆦𑆴𑆑𑇀𑆥𑆷𑆫𑇀𑆮𑆳 𑆑𑆛𑆴𑆥𑆸𑆰𑇀𑆜𑆾𑆫𑆶𑆘𑆳𑆤𑆶𑆘𑆕𑇀𑆔𑆳𑆥𑆢𑆁 𑆑𑇀𑆫𑆩𑆳𑆠𑇀𑇅 𑆓𑆸𑆣𑇀𑆫𑆱𑆵 𑆱𑇀𑆠𑆩𑇀𑆨𑆫𑆶𑆑𑇀𑆠𑆾𑆢𑆽𑆫𑇀𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆴 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆩𑆶𑆲𑆶𑆂𑇆𑇕𑇖𑇆
𑆮𑆳𑆠𑆳𑆢𑇀𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆓𑆿𑆫𑆮𑆳𑆫𑆾𑆖𑆑𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑇅 𑆒𑆬𑇀𑆬𑆵 𑆠𑆶 𑆥𑆳𑆢𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆑𑆫𑆩𑆷𑆬𑆳𑆮𑆩𑆾𑆛𑆤𑆵𑇆𑇕𑇗𑇆
𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆳𑆩𑆤𑆶𑆫𑆷𑆥𑆽𑆯𑇀𑆖 𑆬𑆴𑆕𑇀𑆓𑆽𑆂 𑆯𑆼𑆰𑆳𑆤𑇀 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀𑇅𑇕𑇘𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆱𑆁𑆱𑆫𑇀𑆓𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑇀𑆪𑆽𑆫𑆶𑆥𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇕𑇘𑇆
𑆮𑆳𑆪𑆾𑆫𑇀𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆳𑆠𑇀 𑆑𑆾𑆥𑆾 𑆩𑆳𑆫𑇀𑆓𑆱𑇀𑆪𑆳𑆮𑆫𑆟𑆼𑆤 𑆖 (𑆮𑆳)𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳 𑆢𑆼𑆲𑆼 𑆱𑆫𑇀𑆮𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆂𑇆𑇕𑇙𑇆
𑆮𑆳𑆪𑆶𑆫𑆼𑆮 𑆲𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆶𑆢𑆵𑆫𑆟𑆂 𑇅 𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆠𑆿 𑆱𑆩𑆶𑆢𑇀𑆣𑆷𑆪 𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫 𑆑𑇀𑆰𑆴𑆥𑆤𑇀 𑆓𑆢𑆳𑆤𑇀𑇆𑇖𑇐𑇆
𑆑𑆫𑆾𑆠𑇀𑆪𑆳𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆢𑇀𑆫𑆱𑆳𑆢𑆵𑆁𑆯𑇀𑆖𑆾𑆥𑆯𑆾𑆰𑆪𑆼𑆠𑇀𑇅𑇖𑇑𑇅 𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆮𑆸𑆠𑆼 𑆢𑆳𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆯𑆷𑆬𑆁 𑆨𑇀𑆫𑆩𑆱𑇀𑆠𑆩𑆂 𑇆𑇖𑇑𑇆
𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆾𑆰𑇀𑆟𑆽𑆯𑇀𑆖 𑆮𑆴𑆢𑆳𑆲𑆂 𑆯𑆵𑆠𑆑𑆳𑆩𑆴𑆠𑆳𑇅 𑆯𑆽𑆠𑇀𑆪𑆓𑆿𑆫𑆮𑆯𑆷𑆬𑆳𑆤𑆴 𑆑𑆛𑇀𑆮𑆳𑆢𑇀𑆪𑆶𑆥𑆯𑆪𑆾𑇁𑆣𑆴𑆑𑆩𑇀𑇆𑇖𑇒𑇆
𑆬𑆕𑇀𑆔𑆤𑆳𑆪𑆳𑆱𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆑𑆳𑆩𑆴𑆠𑆳 𑆖 𑆑𑆦𑆳𑆮𑆸𑆠𑆼𑇅 𑆫𑆑𑇀𑆠𑆳𑆮𑆸𑆠𑆼 𑆱𑆢𑆳𑆲𑆳𑆫𑇀𑆠𑆴𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆠𑆫𑆘𑆾 𑆨𑆸𑆯𑆩𑇀𑇆𑇖𑇓𑇆
𑆨𑆮𑆼𑆠𑇀 𑆱𑆫𑆳𑆓𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆖𑇅 𑆑𑆜𑆴𑆤𑆳𑆯𑇀𑆖 𑆮𑆴𑆮𑆫𑇀𑆟𑆳𑆯𑇀𑆖 𑆥𑆴𑆝𑆑𑆳𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆱𑇀𑆠𑆡𑆳𑇆𑇖𑇔𑇆
𑆲𑆫𑇀𑆰𑆂 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆤𑆳𑆁 𑆖 𑆱𑆚𑇀𑆖𑆳𑆫 𑆅𑆮 𑆩𑆳𑆁𑆱𑆓𑆼𑇅 𑆖𑆬𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆩𑆸𑆢𑆶𑆂 𑆯𑆵𑆠𑆂 𑆯𑆾𑆦𑆾𑇁𑆕𑇀𑆓𑆼𑆰𑇀𑆮𑆫𑆶𑆖𑆴𑆱𑇀𑆠𑆡𑆳𑇆𑇖𑇕𑇆
𑆄𑆞𑇀𑆪𑆮𑆳𑆠 𑆅𑆠𑆴 𑆘𑇀𑆚𑆼𑆪𑆂 𑆱 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾 𑆩𑆼𑆢𑆱𑆳𑇁𑇁𑆮𑆸𑆠𑆂𑇅 𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑆱𑇀𑆡𑇀𑆤𑆳𑇁𑇁𑆮𑆸𑆠𑆼 𑆠𑆷𑆰𑇀𑆟𑆁 𑆥𑆵𑆝𑆤𑆁 𑆖𑆳𑆨𑆴𑆤𑆤𑇀𑆢𑆠𑆴𑇆𑇖𑇖𑇆

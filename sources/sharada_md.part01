𑆃𑆩𑇀𑆬𑆁 𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆫𑆩𑆮𑆸𑆰𑇀𑆪𑆁 𑆑𑆦𑆮𑆳𑆠𑆤𑆶𑆠𑇀 𑇅 𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆤𑆁 𑆥𑇀𑆫𑆵𑆟𑆤𑆁 𑆖 𑆨𑆴𑆤𑆠𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆩𑆬𑆁 𑆖 𑆠𑆠𑇀 𑇅 𑆧𑆬𑆩𑆳𑆮𑆲𑆠𑆼 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆨𑆑𑇀𑆠𑆖𑇀𑆗𑆤𑇀𑆢𑆁 𑆑𑆫𑆾𑆠𑆴 𑆖 𑇆𑇘𑇒𑇆
𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆩𑆠𑇀𑆪𑆩𑇀𑆬𑆑𑆩𑆤𑇀𑆢𑆘𑆳𑆠𑆁 𑆠𑆡𑆳 𑆯𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆨𑆮𑆁 𑆱𑆫𑆯𑇀𑆖 𑇅 𑆃𑆱𑆳𑆫𑆩𑆼𑆮𑆁 𑆢𑆣𑆴 𑆱𑆥𑇀𑆠𑆣𑆳𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆫𑇀𑆓𑆼 𑆱𑇀𑆩𑆸𑆠𑆳 𑆩𑆱𑇀𑆠𑆶𑆓𑆶𑆟𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑇆𑇘𑇓𑇆
𑆅𑆠𑆴 𑆢𑆣𑆴𑆮𑆫𑇀𑆓𑆂 𑇅 𑆃𑆡 𑆠𑆑𑇀𑆫𑆮𑆫𑇀𑆓𑆂 𑇅 𑆠𑆑𑇀𑆫𑆁 𑆠𑆶 𑆩𑆣𑆶𑆫𑆩𑆩𑇀𑆬𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆩𑆶𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆁 𑆬𑆔𑆶𑆫𑆷𑆑𑇀𑆰𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆁 𑆓𑆫𑆯𑆾𑆦𑆳𑆠𑆴𑆱𑆳𑆫𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆫𑇀𑆯𑆂𑆥𑇀𑆬𑆵𑆲𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑆾𑆖𑆑𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆠𑆸𑆰𑇀𑆟𑆳𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆥𑇀𑆫𑆱𑆼𑆑𑆯𑆷𑆬𑆨𑆼𑆢𑆂𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆤𑆴𑆬𑆲𑆫𑆁 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑇀𑆤𑆼𑆲𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆮𑆸𑆰𑇀𑆪𑆁 𑆖 𑇆𑇘𑇔𑇆
𑆩𑆤𑇀𑆡𑆤𑆳𑆢𑆴𑆥𑆸𑆡𑆓𑇀𑆨𑆷𑆠𑆱𑇀𑆤𑆼𑆲𑆩𑆫𑇀𑆣𑆾𑆢𑆑𑆁 𑆖 𑆪𑆠𑇀 𑇅 𑆤𑆳𑆠𑆴𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆢𑇀𑆫𑆮𑆁 𑆠𑆑𑇀𑆫𑆁 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆁 𑆠𑆶𑆮𑆫𑆁 𑆫𑆱𑆼 𑇅 𑆪𑆠𑇀𑆠𑆶 𑆱𑆱𑇀𑆤𑆼𑆲𑆩𑆘𑆬𑆁 𑆩𑆡𑆴𑆠𑆁 𑆔𑆾𑆬𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇘𑇕𑇆
𑆤𑆽𑆮 𑆠𑆑𑇀𑆫𑆁 𑆑𑇀𑆰𑆠𑆼 𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆤𑆾𑆰𑇀𑆟𑆑𑆳𑆬𑆼 𑆤 𑆢𑆶𑆫𑇀𑆧𑆬𑆼 𑇅 𑆤 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆢𑆳𑆲𑆼𑆰𑆶 𑆤 𑆫𑆾𑆓𑆼 𑆫𑆑𑇀𑆠𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑇆𑇘𑇖𑇆
𑆯𑆵𑆠𑆑𑆳𑆬𑆼𑇁𑆓𑇀𑆤𑆴𑆩𑆳𑆤𑇀𑆢𑇀𑆪𑆼 𑆖 𑆑𑆦𑆾𑆠𑇀𑆡𑆼𑆰𑇀𑆮𑆳𑆩𑆪𑆼𑆰𑆶 𑆖 𑇅 𑆩𑆳𑆫𑇀𑆓𑆳𑆮𑆫𑆾𑆣𑆼 𑆢𑆶𑆰𑇀𑆛𑆼 𑆖 𑆮𑆳𑆪𑆿 𑆠𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇘𑇗𑇆
𑆠𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆩𑆣𑆶𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆖; 𑆃𑆩𑇀𑆬𑆁 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆁 𑆖 𑇆𑇘𑇘𑇆
𑆮𑆳𑆠𑆼𑇁𑆩𑇀𑆬𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆾𑆥𑆼𑆠𑆁, 𑆱𑇀𑆮𑆳𑆢𑆶 𑆥𑆴𑆠𑇀𑆠𑆼 𑆱𑆯𑆫𑇀𑆑𑆫𑆩𑇀 𑇅 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆑𑇀𑆫𑆁 𑆑𑆦𑆼 𑆖𑆳𑆥𑆴 𑆮𑇀𑆪𑆾𑆰𑆑𑇀𑆰𑆳𑆫𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇆𑇘𑇙𑇆
𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑆵 𑆮𑆳𑆠𑆬𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆢𑆶𑆫𑇀𑆘𑆫𑆳 𑆠𑆑𑇀𑆫𑆑𑆷𑆫𑇀𑆖𑆴𑆑𑆳 𑇅𑇙𑇐𑇅 𑆠𑆑𑇀𑆫𑆳𑆬𑇀𑆬𑆔𑆶𑆠𑆫𑆾 𑆩𑆟𑇀𑆝𑆂 𑆑𑆷𑆫𑇀𑆖𑆴𑆑𑆳𑆢𑆣𑆴𑆠𑆑𑇀𑆫𑆘𑆂 𑇆𑇙𑇐𑇆
𑆓𑆶𑆫𑆶𑆂 𑆑𑆴𑆬𑆳𑆛𑆾𑇁𑆤𑆴𑆬𑆲𑆳 𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆤𑆴𑆢𑇀𑆫𑆳𑆥𑇀𑆫𑆢𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅𑇙𑇑𑇅 𑆩𑆣𑆶𑆫𑆿 𑆧𑆸𑆁𑆲𑆟𑆿 𑆮𑆸𑆰𑇀𑆪𑆿 𑆠𑆢𑇀𑆮𑆠𑇀𑆥𑆵𑆪𑆷𑆰𑆩𑆾𑆫𑆛𑆿 𑇆𑇙𑇑𑇆
𑆤𑆮𑆤𑆵𑆠𑆁 𑆥𑆶𑆤𑆂 𑆱𑆢𑇀𑆪𑆱𑇀𑆑𑆁 𑆬𑆔𑆶 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆁 𑆩𑆣𑆶𑆫𑆁 𑆑𑆰𑆳𑆪𑆩𑆵𑆰𑆢𑆩𑇀𑆬𑆁 𑆯𑆵𑆠𑆬𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆢𑆵𑆥𑆤𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆲𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆩𑆮𑆴𑆢𑆳𑆲𑆴 𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆮𑇀𑆫𑆟𑆯𑆾𑆰𑆳𑆫𑇀𑆯𑆾𑇁𑆫𑇀𑆢𑆴𑆠𑆳𑆥𑆲𑆁, 𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆁 𑆓𑆶𑆫𑆶 𑆑𑆦𑆩𑆼𑆢𑆾𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆁 𑆧𑆬𑆑𑆫𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆯𑆾𑆰𑆔𑇀𑆤𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇙𑇒𑇆
𑆑𑇀𑆰𑆵𑆫𑆾𑆠𑇀𑆡𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆤𑆵𑆠𑆩𑆶𑆠𑇀𑆑𑆸𑆰𑇀𑆛𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆠𑆴𑆯𑆵𑆠𑆁 𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆑𑆫𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆼𑆠𑇀𑆫𑆫𑆾𑆓𑆲𑆫𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆁 𑆖 𑇆𑇙𑇓𑇆
𑆱𑆤𑇀𑆠𑆳𑆤𑆴𑆑𑆳 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆠𑆔𑇀𑆤𑆵 𑆠𑆫𑇀𑆥𑆟𑆵 𑆮𑆸𑆰𑇀𑆪𑆳 𑆧𑆬𑇀𑆪𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆫𑆶𑆖𑇀𑆪𑆳 𑆩𑆣𑆶𑆫𑆳 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆵 𑆓𑆶𑆫𑇀𑆮𑆵 𑆖 𑇆𑇙𑇔𑇆
𑆮𑆴𑆑𑆬𑇀𑆥 𑆍𑆰 𑆢𑆣𑇀𑆪𑆳𑆢𑆴𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆓𑆮𑇀𑆪𑆾𑇁𑆨𑆴𑆮𑆫𑇀𑆟𑆴𑆠𑆂 𑇅 𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆤𑆮𑆯𑆴𑆰𑇀𑆛𑆳𑆁𑆱𑇀𑆠𑆶 𑆑𑇀𑆰𑆵𑆫𑆮𑆵𑆫𑇀𑆪𑆳𑆠𑇀𑆱𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇙𑇕𑇆
𑆅𑆠𑆴 𑆠𑆑𑇀𑆫𑆮𑆫𑇀𑆓𑆂 𑇅 𑆃𑆡 𑆔𑆸𑆠𑆩𑇀 𑇅 𑆔𑆸𑆠𑆁 𑆠𑆶 𑆩𑆣𑆶𑆫𑆁 𑆱𑆿𑆩𑇀𑆪𑆁 𑆩𑆸𑆢𑆶 𑆯𑆵𑆠𑆮𑆵𑆫𑇀𑆪𑆩𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆱𑇀𑆤𑆼𑆲𑆤𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆯𑆷𑆬𑆘𑇀𑆮𑆫𑆳𑆤𑆳𑆲𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆠𑆴𑆩𑆼𑆣𑆳𑆑𑆳𑆤𑇀𑆠𑆴𑆱𑇀𑆮𑆫𑆬𑆳𑆮𑆟𑇀𑆪𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆿𑆘𑆱𑇀𑆠𑆼𑆘𑆾𑆧𑆬𑆑𑆫𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆓𑆶𑆫𑆶 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆤𑆁 𑆥𑆳𑆥𑇀𑆩𑆳𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆮𑆴𑆰𑆲𑆫𑆁 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆁 𑆖 𑇆𑇙𑇖𑇆
𑆮𑆴𑆥𑆳𑆑𑆼 𑆩𑆣𑆶𑆫𑆁 𑆯𑆵𑆠𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇅 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆩𑆓𑇀𑆫𑇀𑆪𑆁 𑆧𑆬𑇀𑆪𑆁 𑆖 𑆓𑆮𑇀𑆪𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆓𑆶𑆟𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇙𑇗𑇆
𑆄𑆘𑆁 𑆔𑆸𑆠𑆁 𑆢𑆵𑆥𑆤𑆵𑆪𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇅 𑆑𑆳𑆱𑆼 𑆯𑇀𑆮𑆳𑆱𑆼 𑆑𑇀𑆰𑆪𑆼 𑆖𑆳𑆥𑆴 𑆥𑆡𑇀𑆪𑆁 𑆥𑆳𑆑𑆼 𑆖 𑆠𑆬𑇀𑆬𑆔𑆶 𑇆𑇙𑇘𑇆
𑆩𑆣𑆶𑆫𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆁 𑆓𑆶𑆫𑆶 𑆥𑆳𑆑𑆼 𑆑𑆦𑆳𑆮𑆲𑆩𑇀 𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆱𑆶𑆯𑆵𑆠𑆁 𑆩𑆳𑆲𑆴𑆰𑆁 𑆔𑆸𑆠𑆩𑇀 𑇆𑇙𑇙𑇆
𑆐𑆰𑇀𑆛𑇀𑆫𑆁 𑆑𑆛𑆶 𑆔𑆸𑆠𑆁 𑆥𑆳𑆑𑆼 𑆯𑆾𑆦𑆑𑇀𑆫𑆴𑆩𑆴𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇅 𑆢𑆵𑆥𑆤𑆁 𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆑𑆶𑆰𑇀𑆜𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆥𑆲𑆩𑇀 𑇆𑇑𑇐𑇐𑇆
𑆥𑆳𑆑𑆼 𑆬𑆔𑇀𑆮𑆳𑆮𑆴𑆑𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆤 𑆖 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑇀 𑇅 𑆑𑆦𑆼𑇁𑆤𑆴𑆬𑆼 𑆪𑆾𑆤𑆴𑆢𑆾𑆰𑆼 𑆯𑆾𑆰𑆼 𑆑𑆩𑇀𑆥𑆼 𑆖 𑆠𑆢𑇀𑆣𑆴𑆠𑆩𑇀 𑇆𑇑𑇐𑇑𑇆
𑆥𑆳𑆑𑆼 𑆬𑆔𑆷𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆁 𑆖 𑆑𑆰𑆳𑆪𑆁 𑆑𑆦𑆤𑆳𑆯𑆤𑆩𑇀 𑇅 𑆢𑆵𑆥𑆤𑆁 𑆧𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆁 𑆖 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆽𑆑𑆯𑆦𑆁 𑆔𑆸𑆠𑆩𑇀 𑇆𑇑𑇐𑇒𑇆
𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆩𑆓𑇀𑆫𑇀𑆪𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆠𑆶 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑇀𑆪𑆳𑆢𑆩𑆸𑆠𑆾𑆥𑆩𑆩𑇀 𑇅 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆑𑆫𑆾𑆠𑆴 𑆢𑆼𑆲𑆳𑆓𑇀𑆤𑇀𑆪𑆾𑆫𑇀𑆬𑆔𑆶𑆥𑆳𑆑𑆁 𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇆𑇑𑇐𑇓𑇆
𑆑𑆰𑆳𑆪𑆁 𑆧𑆢𑇀𑆣𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆁 𑆠𑆴𑆑𑇀𑆠𑆩𑆓𑇀𑆤𑆴𑆑𑆫𑆁 𑆬𑆔𑆶 𑇅 𑆲𑆤𑇀𑆠𑆴 𑆑𑆳𑆫𑆼𑆟𑆮𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆑𑇀𑆫𑆴𑆩𑆵𑆤𑇀 𑇆𑇑𑇐𑇔𑇆
𑆑𑇀𑆰𑆵𑆫𑆔𑆸𑆠𑆁 𑆥𑆶𑆤𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆨𑇀𑆫𑆩𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆤𑆼𑆠𑇀𑆫𑆫𑆾𑆓𑆲𑆴𑆠𑆁 𑆖 𑇆𑇑𑇐𑇕𑇆
𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆟𑇀𑆝𑆱𑇀𑆠𑆶 𑆩𑆣𑆶𑆫𑆂 𑆱𑆫𑆾 𑆪𑆾𑆤𑆴𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆯𑆴𑆫𑆱𑆳𑆁 𑆯𑆷𑆬𑆔𑇀𑆤𑆾 𑆧𑆱𑇀𑆠𑆴𑆤𑆱𑇀𑆪𑆳𑆑𑇀𑆰𑆴𑆥𑆷𑆫𑆟𑆼𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇆𑇑𑇐𑇖𑇆
𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆶𑆫𑆳𑆟𑆁 𑆱𑆫𑆁 𑆑𑆛𑆶𑆮𑆴𑆥𑆳𑆑𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆳𑆥𑆲𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆩𑆢𑆾𑆤𑇀𑆩𑆳𑆢𑆾𑆢𑆫𑆘𑇀𑆮𑆫𑆓𑆫𑆯𑆾𑆰𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆪𑆾𑆤𑆴𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆯𑆴𑆫 𑆯𑆷𑆬𑆔𑇀𑆤𑆁 𑆢𑆵𑆥𑆤𑆁 𑆧𑆱𑇀𑆠𑆴𑆤𑆱𑇀𑆪𑆥𑆷𑆫𑆟𑆼𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇆𑇑𑇐𑇗𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆶𑆫𑆳𑆟𑆁 𑆠𑆴𑆩𑆴𑆫𑆯𑇀𑆮𑆳𑆱𑆥𑆵𑆤𑆱𑆘𑇀𑆮𑆫𑆑𑆳𑆱𑆤𑆶𑆠𑇀 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆾𑆤𑇀𑆩𑆳𑆢𑆓𑇀𑆫𑆲𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇑𑇐𑇘𑇆
(𑆍𑆑𑆳𑆢𑆯𑆯𑆠𑆁 𑆖𑆽𑆮 𑆮𑆠𑇀𑆱𑆫𑆳𑆤𑆶𑆰𑆴𑆠𑆁 𑆔𑆸𑆠𑆩𑇀 𑇅 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆁 𑆑𑆶𑆩𑇀𑆨𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆫𑆠𑆱𑇀𑆠𑆶 𑆩𑆲𑆳𑆔𑆸𑆠𑆩𑇀 𑇆𑇑𑇐𑇙𑇆
𑆥𑆼𑆪𑆁 𑆩𑆲𑆳𑆔𑆸𑆠𑆁 𑆨𑆷𑆠𑆽𑆂 𑆑𑆦𑆔𑇀𑆤𑆁 𑆥𑆮𑆤𑆳𑆣𑆴𑆑𑆽𑆂 𑇅 𑆧𑆬𑇀𑆪𑆁 𑆥𑆮𑆴𑆠𑇀𑆫𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆖 𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀𑆠𑆴𑆩𑆴𑆫𑆳𑆥𑆲𑆩𑇀 𑇆𑇑𑇑𑇐𑇆
𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆲𑆫𑆁 𑆖𑆽𑆮 𑆔𑆸𑆠𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼) 𑇆𑇑𑇑𑇑𑇆 𑆅𑆠𑆴 𑆔𑆸𑆠𑆮𑆫𑇀𑆓𑆂 𑇅
𑆃𑆡 𑆠𑆽𑆬𑆳𑆤𑆴 𑇅 𑆠𑆽𑆬𑆁 𑆠𑇀𑆮𑆳𑆓𑇀𑆤𑆼𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆩𑆣𑆶𑆫𑆁 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆥𑇀𑆫𑆵𑆟𑆤𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆮𑆴𑆯𑆢𑆁 𑆓𑆶𑆫𑆶 𑆱𑆫𑆁 𑆮𑆴𑆑𑆳𑆱𑆴 𑆮𑆸𑆰𑇀𑆪𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆁 𑆩𑆼𑆣𑆳𑆩𑆳𑆫𑇀𑆢𑆮𑆩𑆳𑆁𑆱𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆮𑆫𑇀𑆟𑆧𑆬𑆑𑆫𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆧𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆁 𑆬𑆼𑆒𑆤𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆥𑆳𑆖𑆤𑆩𑆤𑆴𑆬𑆧𑆬𑆳𑆱𑆑𑇀𑆰𑆪𑆑𑆫𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆩𑆯𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑆤𑆤𑆁 𑆪𑆾𑆤𑆴𑆯𑆴𑆫𑆂𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆯𑆾𑆣𑆤𑆁 𑆖, 𑆠𑆡𑆳 𑆗𑆴𑆤𑇀𑆤𑆨𑆴𑆤𑇀𑆤𑆮𑆴𑆢𑇀𑆣𑆾𑆠𑇀𑆥𑆴𑆰𑇀𑆛𑆖𑇀𑆪𑆶𑆠𑆩𑆡𑆴𑆠𑆑𑇀𑆰𑆠𑆥𑆴𑆖𑇀𑆖𑆴𑆠𑆨𑆓𑇀𑆤𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆮𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆢𑆳𑆫𑆴𑆠𑆳 𑆨𑆴𑆲𑆠𑆢𑆶𑆫𑇀𑆨𑆓𑇀𑆤𑆩𑆸𑆓𑆮𑇀𑆪𑆳𑆬𑆮𑆴𑆢𑆰𑇀𑆛𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆖 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆮𑆓𑆳𑆲𑆳𑆢𑆴𑆰𑆶 𑆠𑆴𑆬𑆠𑆽𑆬𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇑𑇑𑇒𑇆
𑆠𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆰𑆶 𑆖 𑆥𑆳𑆤𑆼𑆰𑆶 𑆤𑆱𑇀𑆪𑆼 𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆥𑆷𑆫𑆟𑆼 𑇅 𑆃𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆿 𑆖𑆳𑆥𑆴 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆮𑆳𑆠𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇑𑇑𑇓𑇆
𑆍𑆫𑆟𑇀𑆝𑆠𑆽𑆬𑆁 𑆩𑆣𑆶𑆫𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑆵𑆥𑆤𑆁 𑆑𑆛𑆶 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆯𑆾𑆣𑆤𑆁 𑆠𑇀𑆮𑆖𑇀𑆪𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆪𑆾𑆤𑆴𑆯𑆶𑆑𑇀𑆫𑆮𑆴𑆯𑆾𑆣𑆤𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆼𑆣𑆳𑆑𑆳𑆤𑇀𑆠𑆴𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆬𑆑𑆫𑆁 𑆮𑆳𑆠𑆑𑆦𑆲𑆫𑆩𑆣𑆾𑆨𑆳𑆓𑆢𑆾𑆰𑆲𑆫𑆁 𑆖 𑇆𑇑𑇑𑇔𑇆
𑆤𑆴𑆩𑇀𑆧𑆳𑆠𑆱𑆵𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆩𑆷𑆬𑆑𑆘𑆵𑆩𑆷𑆠𑆑𑆮𑆸𑆑𑇀𑆰𑆑𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆳𑆫𑇀𑆑𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆲𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆟𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆥𑆵𑆬𑆶- 𑆑𑆫𑆚𑇀𑆘𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆯𑆴𑆓𑇀𑆫𑆶𑆱𑆫𑇀𑆰𑆥𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆦𑆬𑆠𑆽𑆬𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆬𑆔𑆷𑆤𑇀𑆪𑆶𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆑𑆛𑆷𑆤𑆴 𑆑𑆛𑆶𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆴 𑆱𑆫𑆳𑆟𑇀𑆪𑆤𑆴𑆬𑆑𑆦𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆥𑇀𑆫𑆩𑆼𑆲𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆥𑆲𑆫𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇆𑇑𑇑𑇕𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆩𑆣𑆶𑆫𑆁 𑆠𑆼𑆰𑆶 𑆑𑇀𑆰𑆿𑆩𑆁 𑆠𑆽𑆬𑆁 𑆧𑆬𑆳𑆥𑆲𑆩𑇀 𑇅 𑆑𑆛𑆶𑆥𑆳𑆑𑆩𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆁 𑆓𑆶𑆫𑆶𑆥𑆴𑆠𑇀𑆠𑆬𑆩𑇀 𑇆𑇑𑇑𑇖𑇆
𑆑𑆸𑆩𑆴𑆔𑇀𑆤𑆁 𑆱𑆳𑆫𑇀𑆰𑆥𑆁 𑆠𑆽𑆬𑆁 𑆑𑆟𑇀𑆝𑆷𑆑𑆶𑆰𑇀𑆜𑆳𑆥𑆲𑆁 𑆬𑆔𑆶 𑇅 𑆑𑆦𑆩𑆼𑆢𑆾𑆤𑆴𑆬𑆲𑆫𑆁 𑆬𑆼𑆒𑆤𑆁 𑆑𑆛𑆶 𑆢𑆵𑆥𑆤𑆩𑇀 𑇆𑇑𑇑𑇗𑇆
𑆑𑆸𑆩𑆴𑆔𑇀𑆤𑆩𑆴𑆕𑇀𑆓𑆶𑆢𑆵𑆠𑆽𑆬𑆩𑆵𑆰𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆁 𑆠𑆡𑆳 𑆬𑆔𑆶 𑇅 𑆑𑆶𑆰𑇀𑆜𑆳𑆩𑆪𑆑𑆸𑆩𑆴𑆲𑆫𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆯𑆶𑆑𑇀𑆫𑆧𑆬𑆳𑆥𑆲𑆩𑇀 𑇆𑇑𑇑𑇘𑇆
𑆮𑆴𑆥𑆳𑆑𑆼 𑆑𑆛𑆶𑆑𑆁 𑆠𑆽𑆬𑆁 𑆑𑆿𑆱𑆶𑆩𑇀𑆨𑆁 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆑𑆸𑆠𑇀 𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆮𑆴𑆢𑆳𑆲𑆴 𑆖 𑇆𑇑𑇑𑇙𑇆
𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆠𑆴𑆩𑆶𑆑𑇀𑆠𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆤𑆳𑆬𑆴𑆑𑆼𑆫𑆑𑆾𑆬𑆳𑆑𑇀𑆰𑆾𑆝𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆑𑆫𑇀𑆧𑆶𑆢𑆳𑆫- 𑆱𑆷𑆫𑇀𑆪𑆮𑆬𑇀𑆬𑆵𑆠𑇀𑆫𑆥𑆶𑆱𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆑𑆫𑇀𑆑𑆳𑆫𑆶𑆑𑆷𑆰𑇀𑆩𑆳𑆟𑇀𑆝𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆳𑆁 𑆠𑆽𑆬𑆳𑆤𑆴 𑆩𑆣𑆶𑆫𑆳𑆟𑆴 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆯𑆵𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆵𑆤𑆴 𑆱𑆸𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆤𑆳𑆤𑆴 𑆖𑆼𑆠𑆴 𑇆𑇑𑇒𑇐𑇆
𑆩𑆣𑆷𑆑𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆥𑆬𑆳𑆯𑆠𑆽𑆬𑆳𑆤𑆴 𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆳𑆟𑆴 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑇆𑇑𑇒𑇑𑇆
𑆠𑆶𑆮𑆫𑆑𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆼 𑆇𑆰𑇀𑆟𑆼 𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆼 𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆶𑆫𑆱𑆼 𑆮𑆳𑆠𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆢𑆾𑆩𑆼𑆲𑆑𑆸𑆩𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆼 𑆇𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆢𑆾𑆰𑆲𑆫𑆼 𑆖 𑇆𑇑𑇒𑇒𑇆
𑆱𑆫𑆬𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆯𑆴𑆁𑆯𑆥𑆳𑆓𑆶𑆫𑆶𑆓𑆟𑇀𑆝𑆵𑆫𑆱𑆳𑆫𑆱𑇀𑆤𑆼𑆲𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆳 𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆯𑆾𑆣𑆤𑆳𑆂 𑆑𑆸𑆩𑆴𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴𑆬𑆲𑆫𑆳𑆯𑇀𑆖 𑇆𑇑𑇒𑇓𑇆
𑆠𑆶𑆩𑇀𑆧𑆵𑆑𑆾𑆯𑆳𑆩𑇀𑆫𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆯𑇀𑆪𑆳𑆩𑆳𑆱𑆥𑇀𑆠𑆬𑆳𑆤𑆵𑆬𑆴𑆑𑆳𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆱𑇀𑆤𑆼𑆲𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆰𑆳𑆪𑆳 𑆃𑆣𑆾𑆨𑆳𑆓𑆢𑆾𑆰𑆲𑆫𑆳𑆂 𑆑𑆸𑆩𑆴𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴𑆬𑆲𑆫𑆳 𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆯𑆾𑆣𑆤𑆳𑆯𑇀𑆖 𑇆𑇑𑇒𑇔𑇆
𑆪𑆮𑆠𑆴𑆑𑇀𑆠𑆳𑆠𑆽𑆬𑆁 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆵𑆰𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆁 𑆬𑆼𑆒𑆤𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆥𑆡𑇀𑆪𑆁 𑆖 𑇆𑇑𑇒𑇕𑇆
𑆍𑆑𑆽𑆰𑆴𑆑𑆳𑆠𑆽𑆬𑆁 𑆩𑆣𑆶𑆫𑆩𑆠𑆴𑆯𑆵𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆩𑆤𑆴𑆬𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆤𑆁 𑆖 𑇆𑇑𑇒𑇖𑇆
𑆱𑆲𑆑𑆳𑆫𑆠𑆽𑆬𑆩𑆵𑆰𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆩𑆠𑆴𑆱𑆶𑆓𑆤𑇀𑆣𑆴 𑆮𑆳𑆠𑆑𑆦𑆲𑆫𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆩𑆣𑆶𑆫𑆑𑆰𑆳𑆪𑆁 𑆫𑆱𑆮𑆤𑇀𑆤𑆳𑆠𑆴𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆁 𑆖 𑇆𑇑𑇒𑇗𑇆
𑆦𑆬𑆾𑆢𑇀𑆨𑆮𑆳𑆤𑆴 𑆠𑆽𑆬𑆳𑆤𑆴 𑆪𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆵𑆲 𑆑𑆳𑆤𑆴𑆖𑆴𑆠𑇀 𑇅 𑆓𑆶𑆟𑆳𑆤𑇀 𑆑𑆫𑇀𑆩 𑆖 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆦𑆬𑆳𑆤𑆵𑆮 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇒𑇘𑇆
𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆱𑆩𑆳𑆱𑆳𑆠𑇀𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆱𑆫𑇀𑆮𑆼 𑆠𑆽𑆬𑆓𑆶𑆟𑆳 𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆖𑆳𑆤𑆴𑆬𑆤𑆳𑆯𑆤𑆳𑆂 𑇆𑇑𑇒𑇙𑇆
𑆱𑆫𑇀𑆮𑆼𑆨𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆴𑆲 𑆠𑆽𑆬𑆼𑆨𑇀𑆪𑆱𑇀𑆠𑆴𑆬𑆠𑆽𑆬𑆁 𑆮𑆴𑆯𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆤𑆴𑆰𑇀𑆥𑆠𑇀𑆠𑆼𑆱𑇀𑆠𑆢𑇀𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆠𑆽𑆬𑆠𑇀𑆮𑆩𑆴𑆠𑆫𑆼𑆰𑇀𑆮𑆥𑆴 𑇆𑇑𑇓𑇐𑇆
𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆳𑆤𑆳𑆁 𑆖 𑆮𑆱𑆳𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆳𑆤𑆾 𑆓𑆶𑆫𑆷𑆰𑇀𑆟𑆩𑆣𑆶𑆫𑆳 𑆮𑆳𑆠𑆔𑇀𑆤𑆳𑆂, 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆑𑆯𑆦𑆑𑇀𑆫𑆮𑇀𑆪𑆳𑆢𑆳𑆢𑆵𑆤𑆳𑆁 𑆬𑆔𑆶𑆯𑆵𑆠𑆑𑆰𑆳𑆪𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆂, 𑆥𑇀𑆫𑆠𑆶𑆢𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆳𑆟𑆳𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆔𑆸𑆠𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆳𑆤𑆾 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆓𑆶𑆫𑆶𑆮𑆴𑆥𑆳𑆑𑆳 𑆮𑆳𑆠𑆲𑆫𑆳𑆯𑇀𑆖 𑇆𑇑𑇓𑇑𑇆 𑆅𑆠𑆴 𑆠𑆽𑆬𑆮𑆫𑇀𑆓𑆂 𑇅
𑆃𑆡 𑆩𑆣𑆶𑆮𑆫𑇀𑆓𑆂 𑇅 𑆩𑆣𑆶 𑆠𑆶 𑆩𑆣𑆶𑆫𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆯𑆵𑆠𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆁 𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆬𑆔𑆶 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆁 𑆬𑆼𑆒𑆤𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆁 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆯𑆾𑆣𑆤𑆁 𑆫𑆾𑆥𑆟𑆁(𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 ) 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑆶𑆱𑆳𑆫𑆴 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆼𑆢𑆾𑆩𑆼𑆲𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆠𑆴𑆱𑆳𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆠𑆸𑆰𑇀𑆟𑆳𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆲𑇀𑆬𑆳𑆢𑆴 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆖; 𑆠𑆠𑇀𑆠𑆶 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑆦𑆔𑇀𑆤𑆁, 𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪𑆨𑆳𑆮𑆳𑆖𑇀𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆩𑇀 𑇆𑇑𑇓𑇒𑇆
𑆥𑆿𑆠𑇀𑆠𑆴𑆑𑆁 𑆨𑇀𑆫𑆳𑆩𑆫𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆁 𑆗𑆳𑆠𑇀𑆫𑆩𑆼𑆮 𑆖 𑇅 𑆄𑆫𑇀𑆔𑇀𑆪𑆩𑆿𑆢𑇀𑆢𑆳𑆬𑆑𑆁 𑆢𑆳𑆬𑆩𑆴𑆠𑇀𑆪𑆰𑇀𑆛𑆿 𑆩𑆣𑆶𑆘𑆳𑆠𑆪𑆂 𑇆𑇑𑇓𑇓𑇆
𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀𑆥𑆿𑆠𑇀𑆠𑆴𑆑𑆁 𑆠𑆼𑆰𑆶 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆁 𑆱𑆮𑆴𑆰𑆳𑆤𑇀𑆮𑆪𑆳𑆠𑇀 𑇅 𑆮𑆳𑆠𑆳𑆱𑆸𑆑𑇀𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆖𑇀𑆗𑆼𑆢𑆴 𑆮𑆴𑆢𑆳𑆲𑆴 𑆩𑆢𑆑𑆸𑆤𑇀𑆩𑆣𑆶 𑇆𑇑𑇓𑇔𑇆
𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆳𑆢𑆶𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆮𑆳𑆢𑇀𑆨𑇀𑆫𑆳𑆩𑆫𑆁 𑆓𑆶𑆫𑆶𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆩𑇀 𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆾 𑆘𑇀𑆚𑆼𑆪𑆁 𑆯𑆵𑆠𑆬𑆁 𑆬𑆔𑆶 𑆬𑆼𑆒𑆤𑆩𑇀 𑇆𑇑𑇓𑇕𑇆
𑆠𑆱𑇀𑆩𑆳𑆬𑇀𑆬𑆔𑆶𑆠𑆫𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆁 𑆥𑇀𑆫𑆮𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆯𑇀𑆮𑆳𑆱𑆳𑆢𑆴𑆰𑆶 𑆖 𑆫𑆾𑆓𑆼𑆰𑆶 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆠𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇓𑇖𑇆
𑆱𑇀𑆮𑆳𑆢𑆶𑆥𑆳𑆑𑆁 𑆓𑆶𑆫𑆶 𑆲𑆴𑆩𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑆴𑆠𑇀 𑇅 𑆯𑇀𑆮𑆴𑆠𑇀𑆫𑆩𑆼𑆲𑆑𑆸𑆩𑆴𑆔𑇀𑆤𑆁 𑆖 𑆮𑆴𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆠𑇀𑆫𑆁 𑆓𑆶𑆟𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇑𑇓𑇗𑇆
𑆄𑆫𑇀𑆔𑇀𑆪𑆁 𑆩𑆣𑇀𑆮𑆠𑆴𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆥𑆫𑆩𑇀 𑇅 𑆑𑆰𑆳𑆪𑆁 𑆑𑆛𑆶 𑆥𑆳𑆑𑆼 𑆖 𑆧𑆬𑇀𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆩𑆮𑆳𑆠𑆑𑆸𑆠𑇀 𑇆𑇑𑇓𑇘𑇆
𑆐𑆢𑇀𑆢𑆳𑆬𑆑𑆁 𑆫𑆶𑆖𑆴𑆑𑆫𑆁 𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆳𑆥𑆲𑆩𑇀 𑇅 𑆑𑆰𑆳𑆪𑆩𑆩𑇀𑆬𑆩𑆶𑆰𑇀𑆟𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑇀 𑆑𑆛𑆶𑆥𑆳𑆑𑆴 𑆖 𑇆𑇑𑇓𑇙𑇆
𑆠𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑇀𑆪𑆾𑆓𑆽𑆫𑇀𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆢𑆳𑆩𑆪𑆳𑆤𑇀 𑆧𑆲𑆷𑆤𑇀 𑇅 𑆤𑆳𑆤𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆠𑇀𑆩𑆑𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆪𑆾𑆓𑆮𑆳𑆲𑆴 𑆥𑆫𑆁 𑆩𑆣𑆶 𑇆𑇑𑇔𑇒𑇆
𑆠𑆠𑇀𑆠𑆶 𑆤𑆳𑆤𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆥𑆶𑆰𑇀𑆥𑆫𑆱𑆳𑆤𑆳𑆁 𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆱𑆩𑇀𑆨𑆮𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆳𑆤𑆶𑆰𑇀𑆟𑆾𑆥𑆖𑆳𑆫𑆩𑇀 𑇆𑇑𑇔𑇓𑇆
𑆇𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆴𑆫𑆶𑆣𑇀𑆪𑆠𑆼 𑆱𑆫𑇀𑆮𑆁 𑆮𑆴𑆰𑆳𑆤𑇀𑆮𑆪𑆠𑆪𑆳 𑆩𑆣𑆶 𑇅 𑆇𑆰𑇀𑆟𑆳𑆫𑇀𑆠𑆩𑆶𑆰𑇀𑆟𑆽𑆫𑆶𑆰𑇀𑆟𑆼 𑆮𑆳 𑆠𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆪𑆡𑆳 𑆮𑆴𑆰𑆩𑇀 𑇆𑇑𑇔𑇔𑇆
𑆠𑆠𑇀𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆳𑆖𑇀𑆖 𑆠𑆡𑆽𑆮 𑆯𑆽𑆠𑇀𑆪𑆳𑆤𑇀𑆤𑆳𑆤𑆿𑆰𑆣𑆵𑆤𑆳𑆁 𑆫𑆱𑆱𑆩𑇀𑆨𑆮𑆳𑆖𑇀𑆖 𑇅 𑆇𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆴𑆫𑆶𑆣𑇀𑆪𑆼𑆠 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖 𑆠𑆡𑆳𑇁𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆼𑆟 𑆘𑆬𑆼𑆤 𑆖𑆳𑆥𑆴 𑇆𑇑𑇔𑇕𑇆
𑆇𑆰𑇀𑆟𑆼𑆤 𑆩𑆣𑆶 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆩𑆤𑆼𑆰𑇀𑆮𑆮𑆖𑆳𑆫𑆴𑆠𑆩𑇀 𑇅 𑆃𑆥𑆳𑆑𑆳𑆢𑆤𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑇀𑆤 𑆮𑆴𑆫𑆶𑆣𑇀𑆪𑆼𑆠 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇆𑇑𑇔𑇖𑇆
𑆩𑆣𑇀𑆮𑆳𑆩𑆳𑆠𑇀𑆥𑆫𑆠𑆱𑇀𑆠𑇀𑆮𑆤𑇀𑆪𑆢𑆳𑆩𑆁 𑆑𑆰𑇀𑆛𑆁 𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆲𑆤𑇀𑆠𑆴 𑆪𑆡𑆳 𑆮𑆴𑆰𑆩𑇀 𑇆𑇑𑇔𑇗𑇆 𑆅𑆠𑆴 𑆩𑆣𑆶𑆮𑆫𑇀𑆓𑆂 𑇅
𑆃𑆡𑆼𑆑𑇀𑆰𑆶𑆮𑆫𑇀𑆓𑆂 𑇅 𑆅𑆑𑇀𑆰𑆮𑆾 𑆩𑆣𑆶𑆫𑆳 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆳 𑆓𑆶𑆫𑆮𑆂 𑆯𑆵𑆠𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆧𑆬𑇀𑆪𑆳 𑆮𑆸𑆰𑇀𑆪𑆳 𑆩𑆷𑆠𑇀𑆫𑆬𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆂 𑆑𑆸𑆩𑆴𑆑𑆦𑆑𑆫𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑇅 𑆠𑆼 𑆖𑆳𑆤𑆼𑆑𑆮𑆴𑆣𑆳𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑇆𑇑𑇔𑇘𑇆
𑆥𑆿𑆟𑇀𑆝𑇀𑆫𑆑𑆾 𑆨𑆵𑆫𑆶𑆑𑆯𑇀𑆖𑆽𑆮 𑆮𑆁𑆯𑆑𑆂 𑆯𑇀𑆮𑆼𑆠𑆥𑆾𑆫𑆑𑆂 𑇅 𑆑𑆳𑆤𑇀𑆠𑆳𑆫𑆱𑇀𑆠𑆳𑆥𑆱𑆼𑆑𑇀𑆰𑆶𑆯𑇀𑆖 𑆑𑆳𑆰𑇀𑆜𑆼𑆑𑇀𑆰𑆶𑆂 𑆱𑆷𑆖𑆴𑆥𑆠𑇀𑆫𑆑𑆂 𑇆𑇑𑇔𑇙𑇆

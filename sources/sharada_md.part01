𑆩𑆷𑆫𑇀𑆣𑆳𑆨𑆴𑆔𑆳𑆠𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑆩𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑆽𑆂 𑇅 𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆠𑆴 𑆑𑆾𑆥𑆳𑆖𑇀𑆖 𑆮𑆴𑆢𑇀𑆣𑆾𑇁𑆠𑆴𑆠𑆫𑆶𑆟𑆯𑇀𑆖 𑆪𑆂 𑇆𑇘𑇑𑇆
𑆯𑆬𑆳𑆑𑆳 𑆑𑆫𑇀𑆑𑆯𑆳 𑆯𑆷𑆬𑆁, 𑆒𑆫𑆳 𑆢𑆾𑆰𑆥𑆫𑆴𑆥𑇀𑆬𑆶𑆠𑆴𑆩𑇀 𑇅 𑆮𑇀𑆫𑆟𑆁 𑆮𑆴𑆯𑆳𑆬𑆁 𑆱𑇀𑆡𑆷𑆬𑆳𑆓𑇀𑆫𑆳, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳 𑆲𑆴𑆁𑆱𑇀𑆪𑆳𑆢𑆤𑆼𑆑𑆣𑆳 𑇆𑇘𑇒𑇆
𑆘𑆬𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆠𑆶 𑆮𑆴𑆰𑆩𑆳, 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆕𑇀𑆓𑆩𑆡𑆳𑆱𑇀𑆡𑆴𑆫𑆳 𑇅 𑆑𑆫𑆾𑆠𑆴 ... 𑇅𑇘𑇓𑇅 ... 𑆮𑆫𑇀𑆘𑆴𑆠𑆳 𑆢𑆾𑆰𑆽𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆨𑆴𑆫𑇀𑆲𑆴𑆠𑆳 𑆨𑆮𑆼𑆠𑇀 𑇆𑇘𑇓𑇆
𑆃𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆳 𑆩𑆣𑇀𑆪𑆼 𑆱𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆳 𑇅 𑆃𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆥𑆫𑇀𑆮𑆱𑆩𑆴𑆠𑆳 𑆮𑆑𑇀𑆠𑇀𑆫𑆪𑆾𑆫𑇀𑆩𑆶𑆑𑆶𑆬𑆳𑆑𑆸𑆠𑆴𑆂 𑇆𑇘𑇔𑇆
𑆠𑆳𑆩𑇀𑆫𑆳𑆪𑆱𑆵 𑆯𑆳𑆠𑆑𑆶𑆩𑇀𑆨𑆵 𑆯𑆬𑆳𑆑𑆳 𑆱𑇀𑆪𑆳𑆢𑆤𑆴𑆤𑇀𑆢𑆴𑆠𑆳 𑇅𑇘𑇕𑇅 𑆫𑆳𑆓𑆂 𑆯𑆾𑆦𑆾𑇁𑆫𑇀𑆧𑆶𑆢𑆁 𑆖𑆾𑆰𑆾 𑆧𑆶𑆢𑇀𑆧𑆶𑆢𑆁 𑆯𑆷𑆑𑆫𑆳𑆑𑇀𑆰𑆴𑆠𑆳 𑇆𑇘𑇕𑇆
𑆃𑆣𑆴𑆩𑆤𑇀𑆡𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆼 𑆫𑆾𑆓𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆮𑇀𑆪𑆣𑆢𑆾𑆰𑆘𑆳𑆂 𑇅 𑆃𑆲𑆴𑆠𑆳𑆖𑆳𑆫𑆠𑆾 𑆮𑆳𑇁𑆥𑆴 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆠𑆳𑆤𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇘𑇖𑇆
𑆫𑆶𑆘𑆳𑆪𑆳𑆩𑆑𑇀𑆰𑆴𑆫𑆳𑆓𑆼 𑆮𑆳 𑆪𑆾𑆓𑆳𑆤𑇀 𑆨𑆷𑆪𑆾 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇅 𑆓𑆽𑆫𑆴𑆑𑆁 𑆱𑆳𑆫𑆴𑆮𑆳 𑆢𑆷𑆫𑇀𑆮𑆳 𑆪𑆮𑆥𑆴𑆰𑇀𑆛𑆁 𑆔𑆸𑆠𑆁 𑆥𑆪𑆂 𑇆𑇘𑇗𑇆
𑆱𑆶𑆒𑆳𑆬𑆼𑆥𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆾𑇁𑆪𑆁 𑆮𑆼𑆢𑆤𑆳𑆫𑆳𑆓𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇅 𑆩𑆸𑆢𑆶𑆨𑆸𑆰𑇀𑆛𑆽𑆱𑇀𑆠𑆴𑆬𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆱𑆩𑆳𑆪𑆶𑆠𑆽𑆂 𑇆𑇘𑇘𑇆
𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆫𑆱𑆾𑆥𑆼𑆠𑆽𑆂 𑆱𑆶𑆒𑆳𑆬𑆼𑆥𑆱𑇀𑆠𑆢𑆫𑇀𑆡𑆑𑆸𑆠𑇀 𑇅 𑆥𑆪𑆱𑇀𑆪𑆳𑆱𑆳𑆫𑆴𑆮𑆳𑆥𑆠𑇀𑆫𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆣𑆶𑆑𑆽𑆫𑆥𑆴 𑇆𑇘𑇙𑇆
𑆃𑆘𑆳𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆮𑆴𑆠𑆽𑆫𑇀𑆬𑆼𑆥𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆂 𑆥𑆡𑇀𑆪 𑆇𑆖𑇀𑆪𑆠𑆼 𑇅 𑆢𑆳𑆫𑆶𑆥𑆢𑇀𑆩𑆑𑆯𑆶𑆟𑇀𑆜𑆵𑆨𑆴𑆫𑆼𑆮𑆩𑆼𑆮 𑆑𑆸𑆠𑆾𑇁𑆥𑆴 𑆮𑆳 𑇆𑇙𑇐𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑆣𑆶𑆑𑆑𑆶𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆳 𑆠𑆢𑇀𑆮𑆠𑇀 𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆁𑆪𑆶𑆠𑆽𑆂 𑇅 𑆫𑆾𑆣𑇀𑆫𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆩𑆣𑆶𑆑𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆘𑆳𑆥𑆪𑆂 𑇆𑇙𑇑𑇆
𑆯𑆸𑆠𑆁 𑆱𑆼𑆑𑆼 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆫𑆶𑆘𑆳𑆫𑆳𑆓𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇅 𑆩𑆣𑆶𑆑𑆾𑆠𑇀𑆥𑆬𑆑𑆶𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆳 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆬𑆳𑆑𑇀𑆰𑆳𑆱𑆴𑆠𑆳𑆪𑆶𑆠𑆽𑆂 𑇅 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂 𑆯𑆸𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆫𑆶𑆘𑆳𑆫𑆳𑆓𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆩𑇀 𑇆𑇙𑇒𑇆
𑆯𑆠𑆳𑆮𑆫𑆵𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑆵𑆩𑆶𑆱𑇀𑆠𑆳𑆩𑆬𑆑𑆥𑆢𑇀𑆩𑆑𑆽𑆂 𑇅 𑆱𑆳𑆘𑆑𑇀𑆰𑆵𑆫𑆽𑆂 𑆯𑆸𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑆳𑆲𑆯𑆷𑆬𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆩𑇀 𑇆𑇙𑇓𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆱𑆴𑆢𑇀𑆣𑆼 𑆥𑆪𑆱𑆴 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼 𑇅 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆠𑆢𑇀𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆱𑆶 𑇆𑇙𑇔𑇆
𑆯𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆼𑆮𑆁 𑆤 𑆖𑆼𑆖𑇀𑆗𑆷𑆬𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑆂 𑆱𑆴𑆫𑆳𑆁 𑆢𑆲𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆁 𑆪𑆡𑆳 𑇆𑇙𑇕𑇆
𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑆠𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆫𑇀𑆡𑆩𑆚𑇀𑆘𑆤𑆼 𑆯𑆸𑆟𑆶 𑆩𑆼 𑆯𑆶𑆨𑆼 𑇅 𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆱𑇀𑆪 𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆯𑆴𑆫𑆵𑆰𑆣𑆮𑆪𑆾𑆫𑆥𑆴 𑇆𑇙𑇖𑇆
𑆱𑆶𑆩𑆤𑆳𑆪𑆳𑆯𑇀𑆖 𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆩𑆶𑆑𑇀𑆠𑆳 𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆩𑆼𑆮 𑆖 𑇅 𑆃𑆘𑆳𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆱𑆩𑇀𑆥𑆴𑆰𑇀𑆪 𑆠𑆳𑆩𑇀𑆫𑆼 𑆱𑆥𑇀𑆠𑆳𑆲𑆩𑆳𑆮𑆥𑆼𑆠𑇀 𑇆𑇙𑇗𑇆
𑆥𑇀𑆫𑆮𑆴𑆣𑆳𑆪 𑆖 𑆠𑆢𑇀𑆮𑆫𑇀𑆠𑆵𑆫𑇀𑆪𑆾𑆘𑆪𑆼𑆖𑇀𑆖𑆳𑆚𑇀𑆘𑆤𑆼 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆁 𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆁 𑆦𑆼𑆤𑆁 𑆱𑆳𑆓𑆫𑆱𑇀𑆪 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆩𑇀 𑇆𑇙𑇘𑇆
𑆩𑆫𑆴𑆖𑆳𑆤𑆴 𑆖 𑆠𑆢𑇀𑆮𑆫𑇀𑆠𑆵𑆂 𑆑𑆳𑆫𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆳𑆫𑇀𑆡𑆩𑆼𑆠𑆠𑇀𑆠𑆶 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑆚𑇀𑆘𑆤𑆼 𑆲𑆴𑆠𑆩𑇀 𑇆𑇙𑇙𑇆
𑆨𑆷𑆪𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆩𑆶𑆒𑇀𑆪𑆳𑆤𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆳𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆖 𑇅 𑆑𑆬𑇀𑆥𑆼 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆴 𑆠𑆳𑆤𑇀𑆪𑆥𑆵𑆲 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇐𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆫𑇀𑆮𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆠𑆠𑇀𑆠𑇀𑆮𑆘𑇀𑆚𑆱𑇀𑆠𑆥𑆾𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑆶𑆢𑆳𑆫𑆣𑆵𑆂 𑇅 𑆮𑆽𑆯𑇀𑆮𑆳𑆩𑆴𑆠𑇀𑆫𑆁 𑆯𑆯𑆳𑆱𑆳𑆡 𑆯𑆴𑆰𑇀𑆪𑆁 𑆑𑆳𑆯𑆴𑆥𑆠𑆴𑆫𑇀𑆩𑆶𑆤𑆴𑆂 𑇆𑇓𑇆
𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆯𑆴𑆫𑆱𑆾 𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆤𑆱𑇀𑆪 𑆯𑆶𑆨𑆼 𑆢𑆴𑆤𑆼 𑇅 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆮𑆳𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆮𑆳 𑆑𑆳𑆫𑇀𑆪𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆱𑇀𑆠𑆶 𑆠𑆫𑇀𑆥𑆟𑆩𑇀 𑇆𑇕𑇆
𑆮𑆳𑆠𑆳𑆠𑆥𑆫𑆘𑆾𑆲𑆵𑆤𑆼 𑆮𑆼𑆯𑇀𑆩𑆤𑇀𑆪𑆶𑆠𑇀𑆠𑆳𑆤𑆯𑆳𑆪𑆴𑆤𑆂 𑇅 𑆄𑆣𑆳𑆫𑆿 𑆩𑆳𑆰𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆼𑆤 𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆿 𑇆𑇖𑇆
𑆱𑆩𑆿 𑆢𑆸𑆞𑆳𑆮𑆱𑆩𑇀𑆧𑆳𑆣𑆿 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆿 𑆤𑆼𑆠𑇀𑆫𑆑𑆾𑆯𑆪𑆾𑆂 𑇅 𑆥𑆷𑆫𑆪𑆼𑆢𑇀𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆱𑇀𑆪 𑆮𑆴𑆬𑆵𑆤𑆱𑇀𑆪 𑆱𑆶𑆒𑆾𑆢𑆑𑆼 𑇆𑇗𑇆
𑆄𑆥𑆑𑇀𑆰𑇀𑆩𑆳𑆓𑇀𑆫𑆳𑆠𑇀𑆠𑆠𑆂 𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆁 𑆥𑆚𑇀𑆖 𑆠𑆢𑇀𑆮𑆳𑆑𑇀𑆯𑆠𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆼, 𑆑𑆦𑆼 𑆰𑆛𑇀, 𑆥𑆴𑆠𑇀𑆠𑆼𑇁𑆰𑇀𑆛𑆿, 𑆢𑆯 𑆮𑆳𑆠𑆼 𑆠𑆢𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇘𑇆
𑆫𑆾𑆓𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆑𑆼𑆖𑆴𑆠𑇀 𑆑𑆳𑆬𑆁 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇅 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆼𑆰𑆶 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆼𑆑𑆁 𑆥𑆚𑇀𑆖 𑆱𑆥𑇀𑆠 𑆖 𑇆𑇙𑇆
𑆢𑆯 𑆢𑆸𑆰𑇀𑆛𑇀𑆪𑆳𑆩𑆡𑆳𑆰𑇀𑆛𑆿 𑆖 𑆮𑆳𑆑𑇀𑆯𑆠𑆳𑆤𑆴 𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇅 𑆠𑆠𑆯𑇀𑆖𑆳𑆥𑆳𑆕𑇀𑆓𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆁 𑆱𑇀𑆫𑆳𑆮𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆑𑇀𑆰𑆴 𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼𑆤 𑆪𑆮𑆥𑆴𑆰𑇀𑆛𑆼𑆤, 𑆱𑇀𑆤𑆼𑆲𑆮𑆵𑆫𑇀𑆪𑆼𑆫𑆴𑆠𑆁 𑆠𑆠𑆂 𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆣𑆷𑆩𑆥𑆳𑆤𑆼𑆤 𑆑𑆦𑆩𑆱𑇀𑆪 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆍𑆑𑆳𑆲𑆁 𑆮𑆳 𑆠𑇀𑆫𑇀𑆪𑆲𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆚𑇀𑆖𑆳𑆲𑆁 𑆖𑆼𑆰𑇀𑆪𑆠𑆼 𑆥𑆫𑆩𑇀 𑇅𑇑𑇒𑇅 𑆠𑆫𑇀𑆥𑆟𑆼 𑆠𑆸𑆥𑇀𑆠𑆴𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆤𑆼𑆠𑇀𑆫𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆱𑆶𑆒𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆮𑆧𑆾𑆣𑆠𑇀𑆮𑆁 𑆮𑆽𑆯𑆢𑇀𑆪𑆁 𑆮𑆫𑇀𑆟𑆥𑆳𑆛𑆮𑆩𑇀 𑇅 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆣𑇀𑆮𑆁𑆱𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆬𑆳𑆔𑆮𑆩𑆼𑆮 𑆖 𑇆𑇑𑇓𑇆
𑆓𑆶𑆫𑇀𑆮𑆳𑆮𑆴𑆬𑆩𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆯𑇀𑆫𑆶𑆑𑆟𑇀𑆝𑆷𑆥𑆢𑆼𑆲𑆮𑆠𑇀 𑇅 𑆘𑇀𑆚𑆼𑆪𑆁 𑆢𑆾𑆰𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆤𑆼𑆠𑇀𑆫𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆠𑆫𑇀𑆥𑆴𑆠𑆩𑇀 𑇆𑇑𑇔𑇆
𑆫𑆷𑆑𑇀𑆰𑆩𑆳𑆮𑆴𑆬𑆩𑆱𑇀𑆫𑆳𑆞𑇀𑆪𑆩𑆱𑆲𑆁 𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆼 𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆠𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆁 𑆲𑆵𑆤𑆠𑆫𑇀𑆥𑆴𑆠𑆩𑆑𑇀𑆰𑆴 𑆖 𑇆𑇑𑇕𑇆
𑆃𑆤𑆪𑆾𑆫𑇀𑆢𑆾𑆰𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑇅 𑆣𑆷𑆩𑆤𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆤𑆽𑆂 𑆱𑆼𑆑𑆽 𑆫𑆷𑆑𑇀𑆰𑆽𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆯𑇀𑆖 𑆪𑆾𑆓𑆮𑆴𑆠𑇀 𑇆𑇑𑇖𑇆
𑆠𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆠𑆴𑆮𑆴𑆯𑆶𑆰𑇀𑆑𑆁 𑆪𑆢𑇀𑆫𑆷𑆑𑇀𑆰𑆁 𑆪𑆖𑇀𑆖𑆳𑆠𑆴𑆢𑆳𑆫𑆶𑆟𑆩𑇀 𑇅 𑆯𑆵𑆫𑇀𑆟𑆥𑆑𑇀𑆰𑇀𑆩𑆳𑆮𑆴𑆬𑆁 𑆘𑆴𑆲𑇀𑆩𑆁 𑆫𑆾𑆓𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆖 𑆪𑆢𑇀𑆨𑆸𑆯𑆩𑇀 𑇆𑇑𑇗𑇆
𑆠𑆢𑆑𑇀𑆰𑆴 𑆠𑆫𑇀𑆥𑆟𑆳𑆢𑆼𑆮 𑆬𑆨𑆼𑆠𑆾𑆫𑇀𑆘𑆳𑆩𑆱𑆁𑆯𑆪𑆩𑇀 𑇅 𑆢𑆶𑆫𑇀𑆢𑆴𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆯𑆵𑆠𑆼𑆰𑆶 𑆖𑆴𑆤𑇀𑆠𑆳𑆪𑆳𑆱𑆨𑇀𑆫𑆩𑆼𑆰𑆶 𑆖 𑇆𑇑𑇘𑇆
𑆃𑆯𑆳𑆤𑇀𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆼 𑆖𑆳𑆑𑇀𑆰𑇀𑆟𑆴 𑆠𑆫𑇀𑆥𑆟𑆁 𑆤 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇅𑇑𑇙𑇅 𑆥𑆶𑆛𑆥𑆳𑆑𑆱𑇀𑆠𑆡𑆽𑆠𑆼𑆰𑆶, 𑆤𑆱𑇀𑆪𑆁 𑆪𑆼𑆰𑆶 𑆖 𑆓𑆫𑇀𑆲𑆴𑆠𑆩𑇀 𑇆𑇑𑇙𑇆
𑆠𑆫𑇀𑆥𑆟𑆳𑆫𑇀𑆲𑆳 𑆤 𑆪𑆼 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆳𑆑𑇀𑆰𑆩𑆳𑆯𑇀𑆖 𑆪𑆼 𑇅𑇒𑇐𑇅 𑆠𑆠𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆢𑆾𑆰𑆼𑆰𑆶 𑆥𑆶𑆛𑆥𑆳𑆑𑆑𑇀𑆰𑆩𑆼𑆰𑆶 𑆖 𑇆𑇒𑇐𑇆
𑆥𑆶𑆛𑆥𑆳𑆑𑆂 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆾 𑆤𑆼𑆠𑇀𑆫𑆼𑆰𑆶 𑆨𑆴𑆰𑆘𑆳 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆱𑇀𑆤𑆼𑆲𑆤𑆾 𑆬𑆼𑆒𑆤𑆵𑆪𑆯𑇀𑆖 𑆫𑆾𑆥𑆟𑆵𑆪𑆯𑇀𑆖 𑆱 𑆠𑇀𑆫𑆴𑆣𑆳 𑇆𑇒𑇑𑇆
𑆲𑆴𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑇁𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪𑆳𑆥𑆴 𑆖 𑆬𑆼𑆒𑆤𑆂 𑇅 𑆢𑆸𑆰𑇀𑆛𑆼𑆫𑇀𑆧𑆬𑆳𑆫𑇀𑆡𑆩𑆥𑆫𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆱𑆸𑆓𑇀𑆮𑇀𑆫𑆟𑆮𑆳𑆠𑆤𑆶𑆠𑇀 𑇆𑇒𑇒𑇆
𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆁𑆱𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆩𑆼𑆢𑆂𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆿𑆰𑆣𑆽𑆂 𑆑𑆸𑆠𑆂 𑇅 𑆱𑇀𑆤𑆼𑆲𑆤𑆂 𑆥𑆶𑆛𑆥𑆳𑆑𑆱𑇀𑆠𑆶 𑆣𑆳𑆫𑇀𑆪𑆾 𑆢𑇀𑆮𑆼 𑆮𑆳𑆑𑇀𑆯𑆠𑆼 𑆠𑆶 𑆱𑆂 𑇆𑇒𑇓𑇆
𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆳𑆁 𑆪𑆑𑆸𑆤𑇀𑆩𑆳𑆁𑆱𑆽𑆫𑇀𑆬𑆼𑆒𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑇀𑆨𑆸𑆠𑆽𑆂 𑇅 𑆑𑆸𑆰𑇀𑆟𑆬𑆾𑆲𑆫𑆘𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆯𑆕𑇀𑆒𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆱𑆴𑆤𑇀𑆣𑆶𑆘𑆽𑆂 𑇆𑇒𑇔𑇆
𑆱𑆩𑆶𑆢𑇀𑆫𑆦𑆼𑆤𑆑𑆳𑆱𑆵𑆱𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆢𑆣𑆴𑆩𑆱𑇀𑆠𑆶𑆨𑆴𑆂 𑇅 𑆬𑆼𑆒𑆤𑆾 𑆮𑆳𑆑𑇀𑆯𑆠𑆁 𑆠𑆱𑇀𑆪 𑆥𑆫𑆁 𑆣𑆳𑆫𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇕𑇆
𑆱𑇀𑆠𑆤𑇀𑆪𑆘𑆳𑆕𑇀𑆓𑆬𑆩𑆣𑇀𑆮𑆳𑆘𑇀𑆪𑆠𑆴𑆑𑇀𑆠𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆥𑆳𑆖𑆴𑆠𑆂 𑇅 𑆬𑆼𑆒𑆤𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆁 𑆣𑆳𑆫𑇀𑆪𑆂 𑆥𑆶𑆛𑆥𑆳𑆑𑆱𑇀𑆠𑆶 𑆫𑆾𑆥𑆟𑆂 𑇆𑇒𑇖𑇆
𑆮𑆴𑆠𑆫𑆼𑆠𑇀𑆠𑆫𑇀𑆥𑆟𑆾𑆑𑇀𑆠𑆁 𑆠𑆶 𑆣𑆷𑆩𑆁 𑆲𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆫𑆾𑆥𑆟𑆩𑇀 𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆢𑇀𑆮𑆪𑆾𑆂 𑆑𑆳𑆫𑇀𑆪𑆿, 𑆑𑆳𑆫𑇀𑆪𑆾 𑆤𑆽𑆮 𑆖 𑆫𑆾𑆥𑆟𑆼 𑇆𑇒𑇗𑇆
𑆍𑆑𑆳𑆲𑆁 𑆮𑆳 𑆢𑇀𑆮𑇀𑆪𑆲𑆁 𑆮𑆳𑇁𑆥𑆴 𑆠𑇀𑆫𑇀𑆪𑆲𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆮𑆖𑆳𑆫𑆟𑆩𑇀 𑇅𑇒𑇘𑇅 𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆳 𑆠𑆶 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆳𑆬𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆑𑆳𑆬𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇒𑇘𑇆
𑆠𑆼𑆘𑆳𑆁𑆱𑇀𑆪𑆤𑆴𑆬𑆩𑆳𑆑𑆳𑆯𑆩𑆳𑆢𑆫𑇀𑆯𑆁 𑆨𑆳𑆱𑇀𑆮𑆫𑆳𑆟𑆴 𑆖 𑇅 𑆤𑆼𑆑𑇀𑆰𑆼𑆠 𑆠𑆫𑇀𑆥𑆴𑆠𑆼 𑆤𑆼𑆠𑇀𑆫𑆼 𑆥𑆶𑆛𑆥𑆳𑆑𑆑𑆸𑆠𑆼 𑆠𑆡𑆳 𑇆𑇒𑇙𑇆
𑆩𑆴𑆡𑇀𑆪𑆾𑆥𑆖𑆳𑆫𑆳𑆢𑆤𑆪𑆾𑆫𑇀𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼 𑇅 𑆃𑆚𑇀𑆘𑆤𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆱𑇀𑆮𑆼𑆢𑆽𑆫𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆠𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇓𑇐𑇆
𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆮𑆫𑇀𑆟𑆁 𑆮𑆴𑆯𑆢𑆁 𑆮𑆳𑆠𑆳𑆠𑆥𑆱𑆲𑆁 𑆬𑆔𑆶 𑇅 𑆱𑆶𑆒𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆮𑆧𑆾𑆣𑇀𑆪𑆑𑇀𑆰𑆴 𑆥𑆶𑆛𑆥𑆳𑆑𑆓𑆶𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇆𑇓𑇑𑇆
𑆃𑆠𑆴𑆪𑆾𑆓𑆳𑆢𑇀𑆫𑆶𑆘𑆂 𑆯𑆾𑆦𑆂 𑆥𑆴𑆝𑆑𑆳𑆱𑇀𑆠𑆴𑆩𑆴𑆫𑆾𑆢𑇀𑆓𑆩𑆂 𑇅𑇓𑇒𑇅 𑆥𑆳𑆑𑆾𑇁𑆯𑇀𑆫𑆶 𑆲𑆫𑇀𑆰𑆟𑆁 𑆖𑆳𑆥𑆴 𑆲𑆵𑆤𑆼 𑆢𑆾𑆰𑆾𑆢𑇀𑆓𑆩𑆱𑇀𑆠𑆡𑆳 𑇆𑇓𑇒𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆥𑆶𑆛𑆥𑆳𑆑𑆥𑇀𑆫𑆱𑆳𑆣𑆤𑆩𑇀 𑇅 𑆢𑇀𑆮𑆿 𑆧𑆴𑆬𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆿 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆱𑇀𑆪 𑆥𑆴𑆟𑇀𑆝𑆿 𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆥𑆼𑆰𑆴𑆠𑆿 𑇆𑇓𑇓𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆧𑆴𑆬𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆶 𑆢𑇀𑆫𑆮𑆳𑆟𑆳𑆁 𑆑𑆶𑆝𑆮𑆾 𑆩𑆠𑆂 𑇅 𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆱𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆥𑆠𑇀𑆫𑆽𑆂 𑆱𑆶𑆥𑆫𑆴𑆮𑆼𑆰𑇀𑆛𑆴𑆠𑆩𑇀 𑇆𑇓𑇔𑇆
(𑆑𑆳𑆯𑇀𑆩𑆫𑆵𑆑𑆶𑆩𑆶𑆢𑆽𑆫𑆟𑇀𑆝𑆥𑆢𑇀𑆩𑆴𑆤𑆵𑆑𑆢𑆬𑆵𑆨𑆮𑆽𑆂 ) 𑇅 𑆩𑆸𑆢𑆳𑆮𑆬𑆴𑆥𑇀𑆠𑆩𑆕𑇀𑆓𑆳𑆫𑆽𑆂 𑆒𑆳𑆢𑆴𑆫𑆽𑆫𑆮𑆑𑆷𑆬𑆪𑆼𑆠𑇀 𑇆𑇓𑇕𑇆
𑆑𑆠𑆑𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆽𑆫𑆟𑇀𑆝𑆥𑆳𑆛𑆬𑆳𑆮𑆸𑆰𑆧𑆳𑆢𑆫𑆽𑆂 𑇅 𑆱𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆫𑆶𑆩𑆑𑆳𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆳 𑆓𑆾𑆩𑆪𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆪𑆶𑆑𑇀𑆠𑆴𑆠𑆂 𑇆𑇓𑇖𑇆
𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆤𑆴𑆰𑇀𑆥𑆵𑆝𑇀𑆪 𑆫𑆱𑆩𑆳𑆢𑆳𑆪 𑆠𑆁 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆠𑆫𑇀𑆥𑆟𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆪𑆡𑆳𑆮𑆢𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇓𑇗𑇆
𑆑𑆤𑆵𑆤𑆑𑆼 𑆤𑆴𑆰𑆼𑆖𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆯𑆳𑆪𑆴𑆤𑆂 𑇅 𑆫𑆑𑇀𑆠𑆼 𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆠𑆿 𑆯𑆵𑆠𑆿 𑆑𑆾𑆰𑇀𑆟𑆿 𑆮𑆳𑆠𑆑𑆦𑆳𑆥𑆲𑆿 𑇆𑇓𑇘𑇆
𑆃𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆿 𑆱𑆠𑆠𑆁 𑆢𑆳𑆲𑆥𑆳𑆑𑆑𑆫𑆿 𑆱𑇀𑆩𑆸𑆠𑆿 𑇅 𑆃𑆥𑇀𑆬𑆶𑆠𑆿 𑆯𑆵𑆠𑆬𑆿 𑆖𑆳𑆯𑇀𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆫𑆶𑆓𑇀𑆔𑆫𑇀𑆰𑆑𑆳𑆫𑆑𑆿 𑇆𑇓𑇙𑇆
𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆿 𑆑𑆰𑆳𑆪𑆠𑇀𑆮𑆱𑆕𑇀𑆑𑆾𑆖𑆱𑇀𑆦𑆶𑆫𑆟𑆳𑆮𑆲𑆿 𑇅 𑆲𑆵𑆤𑆥𑇀𑆫𑆩𑆳𑆟𑆿 𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆘𑆤𑆤𑆿 𑆨𑆸𑆯𑆩𑇀 𑇆𑇔𑇐𑇆
𑆪𑆶𑆑𑇀𑆠𑆿 𑆑𑆸𑆠𑆿 𑆢𑆳𑆲𑆯𑆾𑆦𑆫𑆶𑆓𑇀𑆣𑆫𑇀𑆰𑆱𑇀𑆫𑆳𑆮𑆤𑆳𑆯𑆤𑆿 𑇅 𑆑𑆟𑇀𑆝𑆷𑆥𑆢𑆼𑆲𑆢𑆷𑆰𑆵𑆑𑆳𑆫𑆑𑇀𑆠𑆫𑆳𑆘𑆴𑆮𑆴𑆤𑆳𑆯𑆤𑆿 𑇆𑇔𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆫𑆴𑆲𑆫𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑇀 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀𑆠𑆿 𑆱𑆶𑆒𑆳𑆮𑆲𑆿 𑇅𑇔𑇒𑇅 𑆮𑇀𑆪𑆳𑆥𑆢𑆯𑇀𑆖 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆤𑆱𑇀𑆪𑆣𑆷𑆩𑆳𑆚𑇀𑆘𑆤𑆽𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇔𑇒𑇆
𑆄𑆢𑇀𑆪𑆤𑇀𑆠𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆪𑆾𑆂 𑆱𑇀𑆮𑆼𑆢 𑆇𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆖𑆽𑆬𑆴𑆑𑆂 𑇅 𑆠𑆡𑆳 𑆲𑆴𑆠𑆾𑇁𑆮𑆱𑆳𑆤𑆼 𑆖 𑆣𑆷𑆩𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆿 𑇆𑇔𑇓𑇆
𑆪𑆡𑆳𑆢𑆾𑆰𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆶 𑆤𑆳𑆠𑆴𑆥𑇀𑆫𑆧𑆬𑆩𑆾𑆘𑆱𑆳 𑇅 𑆫𑆾𑆓𑆩𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆁 𑆲𑆤𑇀𑆠𑆴 𑆱𑆼𑆑𑆱𑇀𑆠𑆶 𑆧𑆬𑆮𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇔𑇔𑇆
𑆠𑆿 𑆠𑇀𑆫𑆴𑆣𑆽𑆮𑆾𑆥𑆪𑆶𑆘𑇀𑆪𑆼𑆠𑆼 𑆫𑆾𑆓𑆼𑆰𑆶 𑆥𑆶𑆛𑆥𑆳𑆑𑆮𑆠𑇀 𑇅𑇔𑇕𑇅 𑆬𑆼𑆒𑆤𑆼 𑆱𑆥𑇀𑆠 𑆖𑆳𑆰𑇀𑆛𑆿 𑆮𑆳 𑆧𑆴𑆤𑇀𑆢𑆮𑆂 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆼 𑆢𑆯 𑇆𑇔𑇕𑇆
𑆄𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆼 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳 𑆢𑇀𑆮𑆳𑆢𑆯𑆽𑆮 𑆠𑆶 𑆫𑆾𑆥𑆟𑆼 𑇅𑇔𑇖𑇅 𑆱𑆼𑆑𑆱𑇀𑆪 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆂 𑆑𑆳𑆬𑆂 𑆥𑆶𑆛𑆥𑆳𑆑𑆳𑆠𑇀 𑆥𑆫𑆾 𑆩𑆠𑆂 𑇆𑇔𑇖𑇆
𑆃𑆡𑆮𑆳 𑆑𑆳𑆫𑇀𑆪𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑆫𑆶𑆥𑆪𑆾𑆓𑆾 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆥𑆷𑆫𑇀𑆮𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆫𑆶𑆘𑆳𑆑𑆳𑆬𑆼𑆰𑆶 𑆖𑆾𑆨𑆪𑆾𑆂 𑇆𑇔𑇗𑇆
𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆱𑆼𑆑𑆼 𑆠𑆫𑇀𑆥𑆟𑆾𑆑𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇅 𑆫𑆾𑆓𑆳𑆚𑇀𑆗𑆴𑆫𑆱𑆴 𑆱𑆩𑇀𑆨𑆷𑆠𑆳𑆤𑇀 𑆲𑆠𑇀𑆮𑆳𑇁𑆠𑆴𑆥𑇀𑆫𑆧𑆬𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑇀 𑇆𑇔𑇘𑇆
𑆑𑆫𑆾𑆠𑆴 𑆯𑆴𑆫𑆱𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆑𑇀𑆠𑆳 𑆪𑆼 𑆩𑆷𑆫𑇀𑆣𑆠𑆽𑆬𑆴𑆑𑆳𑆂 𑇅 𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆱𑇀𑆪 𑆱𑆳𑆪𑆳𑆲𑇀𑆤𑆼 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆯𑆴𑆠𑆱𑇀𑆪 𑆠𑆶 𑇆𑇔𑇙𑇆
𑆉𑆘𑇀𑆮𑆳𑆱𑆵𑆤𑆱𑇀𑆪 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆢𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆾𑆯𑆁 𑆠𑆠𑆾 𑆢𑆸𑆞𑆩𑇀 𑇅 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆯𑆸𑆠𑆱𑇀𑆤𑆼𑆲𑆥𑆷𑆫𑇀𑆟𑆁 𑆱𑆁𑆪𑆩𑇀𑆪 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇕𑇐𑇆

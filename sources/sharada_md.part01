𑆃𑆡𑆳𑆠𑆾𑇁𑆰𑇀𑆛𑆾𑆢𑆫𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑇀𑆮𑆰𑇀𑆛𑆳𑆮𑆶𑆢𑆫𑆳𑆟𑆴, 𑆃𑆰𑇀𑆛𑆿 𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆳𑆂, 𑆃𑆰𑇀𑆛𑆿 𑆑𑇀𑆰𑆵𑆫𑆢𑆾𑆰𑆳𑆂, 𑆃𑆰𑇀𑆛𑆿 𑆫𑆼𑆠𑆾𑆢𑆾𑆰𑆳𑆂; 𑆱𑆥𑇀𑆠 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴, 𑆱𑆥𑇀𑆠 𑆥𑆴𑆝𑆑𑆳𑆂, 𑆱𑆥𑇀𑆠 𑆮𑆵𑆱𑆫𑇀𑆥𑆳𑆂; 𑆰𑆝𑆠𑆵𑆱𑆳𑆫𑆳𑆂, 𑆰𑆝𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆂; 𑆥𑆚𑇀𑆖 𑆓𑆶𑆬𑇀𑆩𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆥𑇀𑆬𑆵𑆲𑆢𑆾𑆰𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆑𑆳𑆱𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆯𑇀𑆮𑆳𑆱𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆲𑆴𑆑𑇀𑆑𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆠𑆸𑆰𑇀𑆟𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆗𑆫𑇀𑆢𑆪𑆂, 𑆥𑆚𑇀𑆖 𑆨𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆯𑆤𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴, 𑆥𑆚𑇀𑆖 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆂, 𑆥𑆚𑇀𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆑𑇀𑆰𑆴𑆫𑆾𑆓𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆑𑆫𑇀𑆟𑆫𑆾𑆓𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆢𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆯𑆾𑆰𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆳𑆤𑆴; 𑆠𑇀𑆫𑆪𑆂 𑆯𑆾𑆦𑆳𑆂, 𑆠𑇀𑆫𑆵𑆟𑆴 𑆑𑆴𑆬𑆳𑆱𑆳𑆤𑆴, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆁; 𑆢𑇀𑆮𑆿 𑆘𑇀𑆮𑆫𑆿, 𑆢𑇀𑆮𑆿 𑆮𑇀𑆫𑆟𑆿, 𑆢𑇀𑆮𑆳𑆮𑆳𑆪𑆳𑆩𑆿, 𑆢𑇀𑆮𑆼 𑆓𑆸𑆣𑇀𑆫𑆱𑇀𑆪𑆿, 𑆢𑇀𑆮𑆼 𑆑𑆳𑆩𑆬𑆼, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆩𑆁, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆁, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴; 𑆍𑆑 𑆈𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆂, 𑆍𑆑𑆂 𑆱𑆤𑇀𑆤𑇀𑆪𑆳𑆱𑆂, 𑆍𑆑𑆾 𑆩𑆲𑆳𑆓𑆢𑆂; 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆑𑇀𑆫𑆴𑆩𑆴𑆘𑆳𑆠𑆪𑆂, 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂, 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆢𑆂; 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑇀𑆫𑆾𑆓𑆳𑆣𑆴𑆑𑆫𑆟𑆳𑆤𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼 𑆱𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴𑇆𑇓𑇆
𑆍𑆠𑆳𑆤𑆴 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆃𑆰𑇀𑆛𑆳𑆮𑆶𑆢𑆫𑆳𑆟𑆵𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆥𑇀𑆬𑆵𑆲𑆧𑆢𑇀𑆣𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆢𑆑𑆾𑆢𑆫𑆳𑆟𑆴, 𑆃𑆰𑇀𑆛𑆿 𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆯𑇀𑆩𑆫𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆂, 𑆃𑆰𑇀𑆛𑆿 𑆑𑇀𑆰𑆵𑆫𑆢𑆾𑆰𑆳 𑆅𑆠𑆴 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆮𑆽𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆮𑆽𑆫𑆱𑇀𑆪𑆁 𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆁 𑆦𑆼𑆤𑆱𑆕𑇀𑆔𑆳𑆠𑆾 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆓𑆿𑆫𑆮𑆩𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆯𑇀𑆖, 𑆃𑆰𑇀𑆛𑆿 𑆫𑆼𑆠𑆾𑆢𑆾𑆰𑆳 𑆅𑆠𑆴 𑆠𑆤𑆶 𑆯𑆶𑆰𑇀𑆑𑆁 𑆦𑆼𑆤𑆴𑆬𑆩𑆯𑇀𑆮𑆼𑆠𑆁 𑆥𑆷𑆠𑇀𑆪𑆠𑆴𑆥𑆴𑆖𑇀𑆗𑆬𑆩𑆤𑇀𑆪𑆣𑆳𑆠𑆷𑆥𑆲𑆴𑆠𑆩𑆮𑆱𑆳𑆢𑆴 𑆖 (𑇑); 𑆱𑆥𑇀𑆠 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆵𑆠𑆴 𑆑𑆥𑆳𑆬𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆩𑆟𑇀𑆝𑆬𑆫𑇀𑆰𑇀𑆪𑆘𑆴𑆲𑇀𑆮𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆱𑆴𑆣𑇀𑆩𑆑𑆳𑆑𑆟𑆳𑆤𑆴, 𑆱𑆥𑇀𑆠 𑆥𑆴𑆝𑆑𑆳 𑆅𑆠𑆴 𑆯𑆫𑆳𑆮𑆴𑆑𑆳 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳 𑆘𑆳𑆬𑆴𑆤𑆵 𑆱𑆫𑇀𑆰𑆥𑇀𑆪𑆬𑆘𑆵 𑆮𑆴𑆤𑆠𑆳 𑆮𑆴𑆢𑇀𑆫𑆣𑆵 𑆖, 𑆱𑆥𑇀𑆠 𑆮𑆴𑆱𑆫𑇀𑆥𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆢𑆩𑆑𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆒𑇀𑆪𑆳𑆂 (𑇒); 𑆰𑆝𑆠𑆵𑆱𑆳𑆫𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆨𑆪𑆯𑆾𑆑𑆘𑆳𑆂, 𑆰𑆝𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑆶𑆑𑇀𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆑𑇀𑆰𑆮𑆡𑆶𑆘𑆳𑆂 (𑇓); 𑆥𑆚𑇀𑆖 𑆓𑆶𑆬𑇀𑆩𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆥𑇀𑆬𑆵𑆲𑆢𑆾𑆰𑆳 𑆅𑆠𑆴 𑆓𑆶𑆬𑇀𑆩𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆑𑆳𑆱𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆪𑆘𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆯𑇀𑆮𑆳𑆱𑆳 𑆅𑆠𑆴 𑆩𑆲𑆾𑆫𑇀𑆣𑇀𑆮𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆠𑆩𑆑𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆲𑆴𑆑𑇀𑆑𑆳 𑆅𑆠𑆴 𑆩𑆲𑆠𑆵 𑆓𑆩𑇀𑆨𑆵𑆫𑆳 𑆮𑇀𑆪𑆥𑆼𑆠𑆳 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑇁𑆤𑇀𑆤𑆘𑆳 𑆖, 𑆥𑆚𑇀𑆖 𑆠𑆸𑆰𑇀𑆟𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆩𑆑𑇀𑆰𑆪𑆾𑆥𑆱𑆫𑇀𑆓𑆳𑆠𑇀𑆩𑆴𑆑𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆗𑆫𑇀𑆢𑆪 𑆅𑆠𑆴 𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆘𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆾𑆢𑇀𑆫𑆼𑆑𑆾𑆠𑇀𑆡𑆳𑆯𑇀𑆖 , 𑆥𑆚𑇀𑆖 𑆨𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆯𑆤𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆵𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆢𑇀𑆮𑆼𑆰𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳 𑆅𑆠𑆴 𑆥𑆷𑆫𑇀𑆮𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆱𑆩𑆱𑇀𑆪 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆑𑇀𑆫𑆴𑆩𑆴𑆘𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆳 𑆅𑆠𑆴 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆩𑆸𑆢𑇀𑆨𑆑𑇀𑆰𑆟𑆘𑆳𑆂, 𑆥𑆚𑇀𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 (𑇔); 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆥𑆱𑇀𑆩𑆳𑆫𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆑𑇀𑆰𑆴𑆫𑆾𑆓𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆑𑆫𑇀𑆟𑆫𑆾𑆓𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆢𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆳 𑆅𑆠𑇀𑆪𑆥𑆱𑇀𑆩𑆳𑆫𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆯𑆾𑆰𑆳 𑆅𑆠𑆴 𑆱𑆳𑆲𑆱𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆑𑇀𑆰𑆪𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆘𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆳𑆤𑆵𑆠𑆴 𑆧𑆵𑆘𑆾𑆥𑆔𑆳𑆠𑆳𑆢𑇀𑆣𑇀𑆮𑆘𑆨𑆕𑇀𑆓𑆳𑆘𑇀𑆘𑆫𑆳𑆪𑆳𑆂 𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆳𑆖𑇀𑆖 (𑇕); 𑆠𑇀𑆫𑆪𑆂 𑆯𑆾𑆡𑆳 𑆅𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆠𑇀𑆫𑆵𑆟𑆴 𑆑𑆴𑆬𑆳𑆱𑆳𑆤𑆵𑆠𑆴 𑆫𑆑𑇀𑆠𑆠𑆳𑆩𑇀𑆫𑆯𑆶𑆑𑇀𑆬𑆳𑆤𑆴, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑆴 𑆈𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆩𑆣𑆾𑆨𑆳𑆓𑆩𑆶𑆨𑆪𑆨𑆳𑆓𑆁 𑆖 (𑇖); 𑆢𑇀𑆮𑆿 𑆘𑇀𑆮𑆫𑆳𑆮𑆴𑆠𑆴 𑆇𑆰𑇀𑆟𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆂 𑆯𑆵𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆯𑇀𑆖 𑆯𑆵𑆠𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆾𑆰𑇀𑆟𑆱𑆩𑆶𑆠𑇀𑆡𑆂, 𑆢𑇀𑆮𑆿 𑆮𑇀𑆫𑆟𑆳𑆮𑆴𑆠𑆴 𑆤𑆴𑆘𑆯𑇀𑆖𑆳𑆓𑆤𑇀𑆠𑆶𑆘𑆯𑇀𑆖, 𑆢𑇀𑆮𑆳𑆮𑆳𑆪𑆳𑆩𑆳𑆮𑆴𑆠𑆴 𑆧𑆳𑆲𑇀𑆪𑆯𑇀𑆖𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆯𑇀𑆖, 𑆢𑇀𑆮𑆼 𑆓𑆸𑆣𑇀𑆫𑆱𑇀𑆪𑆳𑆮𑆴𑆠𑆴 𑆮𑆳𑆠𑆳𑆢𑇀𑆮𑆳𑆠𑆑𑆦𑆳𑆖𑇀𑆖, 𑆢𑇀𑆮𑆼 𑆑𑆳𑆩𑆬𑆼 𑆅𑆠𑆴 𑆑𑆾𑆰𑇀𑆜𑆳𑆯𑇀𑆫𑆪𑆳 𑆯𑆳𑆒𑆳𑆯𑇀𑆫𑆪𑆳 𑆖, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆩𑆩𑆴𑆠𑆴 𑆃𑆬𑆱𑆑𑆾 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳 𑆖, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆩𑆴𑆠𑆴 𑆓𑆩𑇀𑆨𑆵𑆫𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆁 𑆖, 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑆴 𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑇀𑆪𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆟𑆴 𑆖 (𑇗); 𑆍𑆑 𑆈𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨 𑆅𑆠𑇀𑆪𑆳𑆩𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆱𑆩𑆶𑆠𑇀𑆡𑆂, 𑆍𑆑𑆂 𑆱𑆤𑇀𑆤𑇀𑆪𑆳𑆱 𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆳𑆠𑇀𑆩𑆑𑆾 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆂, 𑆍𑆑𑆾 𑆩𑆲𑆳𑆓𑆢 𑆅𑆠𑆴 𑆃𑆠𑆠𑇀𑆠𑇀𑆮𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆂 (𑇘); 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆑𑇀𑆫𑆴𑆩𑆴𑆘𑆳𑆠𑆪 𑆅𑆠𑆴 𑆪𑆷𑆑𑆳 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆧𑆲𑆴𑆫𑇀𑆩𑆬𑆘𑆳𑆂, 𑆑𑆼𑆯𑆳𑆢𑆳 𑆬𑆾𑆩𑆳𑆢𑆳 𑆬𑆾𑆩𑆢𑇀𑆮𑆵𑆥𑆳𑆂 𑆱𑆿𑆫𑆱𑆳 𑆐𑆢𑆶𑆩𑇀𑆧𑆫𑆳 𑆘𑆤𑇀𑆠𑆶𑆩𑆳𑆠𑆫𑆯𑇀𑆖𑆼𑆠𑆴 𑆰𑆛𑇀 𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆂, 𑆃𑆤𑇀𑆠𑇀𑆫𑆳𑆢𑆳 𑆇𑆢𑆫𑆳𑆮𑆼𑆰𑇀𑆛𑆳 𑆲𑆸𑆢𑆪𑆳𑆢𑆳𑆯𑇀𑆖𑆶𑆫𑆮𑆾 𑆢𑆫𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆳𑆂 𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆳 𑆩𑆲𑆳𑆓𑆶𑆢𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆥𑇀𑆠 𑆑𑆦𑆘𑆳𑆂, 𑆑𑆑𑆼𑆫𑆶𑆑𑆳 𑆩𑆑𑆼𑆫𑆶𑆑𑆳 𑆬𑆼𑆬𑆴𑆲𑆳𑆂 𑆱𑆯𑆷𑆬𑆑𑆳𑆂 𑆱𑆿𑆱𑆶𑆫𑆳𑆢𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑆚𑇀𑆖 𑆥𑆶𑆫𑆵𑆰𑆘𑆳𑆂; 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆅𑆠𑇀𑆪𑆶𑆢𑆑𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆑𑇀𑆰𑆶𑆧𑆳𑆬𑆴𑆑𑆳𑆫𑆱𑆩𑆼𑆲𑆯𑇀𑆖 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆱𑆳𑆢𑆩𑆼𑆲𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆬𑆩𑆼𑆲𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖 𑆯𑆵𑆠𑆩𑆼𑆲𑆯𑇀𑆖 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆯𑇀𑆖 𑆱𑆴𑆑𑆠𑆳𑆩𑆼𑆲𑆯𑇀𑆖 𑆬𑆳𑆬𑆳𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴 𑆢𑆯 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆑𑇀𑆰𑆳𑆫𑆩𑆼𑆲𑆯𑇀𑆖 𑆑𑆳𑆬𑆩𑆼𑆲𑆯𑇀𑆖 𑆤𑆵𑆬𑆩𑆼𑆲𑆯𑇀𑆖 𑆬𑆾𑆲𑆴𑆠𑆩𑆼𑆲𑆯𑇀𑆖 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆼𑆲𑆯𑇀𑆖 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴 𑆰𑆛𑇀 𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆮𑆱𑆳𑆩𑆼𑆲𑆯𑇀𑆖 𑆩𑆘𑇀𑆘𑆳𑆩𑆼𑆲𑆯𑇀𑆖 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆯𑇀𑆖 𑆩𑆣𑆶𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆮𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆅𑆠𑆴 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂; 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆢 𑆅𑆠𑆴 𑆮𑆳𑆠𑆴𑆑𑆵 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆵 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆴𑆑𑆵 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆵 𑆖𑆼𑆠𑆴 𑆖𑆠𑆱𑇀𑆫𑆾 𑆢𑆾𑆰𑆘𑆳𑆂, 𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆱𑆁𑆱𑆫𑇀𑆓𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆽𑆫𑆮𑆯𑆴𑆰𑇀𑆛𑆳𑆂 𑆰𑆾𑆝𑆯 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆫𑆑𑇀𑆠𑆪𑆾𑆤𑆴𑆯𑇀𑆖𑆳𑆫𑆘𑆱𑇀𑆑𑆳 𑆖𑆳𑆖𑆫𑆟𑆳 𑆖𑆳𑆠𑆴𑆖𑆫𑆟𑆳 𑆖 𑆥𑇀𑆫𑆳𑆑𑇀𑆖𑆫𑆟𑆳 𑆖𑆾𑆥𑆥𑇀𑆬𑆶𑆠𑆳 𑆖 𑆥𑆫𑆴𑆥𑇀𑆬𑆶𑆠𑆳 𑆖𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆴𑆤𑆵 𑆖 𑆑𑆫𑇀𑆟𑆴𑆤𑆵 𑆖 𑆥𑆶𑆠𑇀𑆫𑆔𑇀𑆤𑆵 𑆖𑆳𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆵 𑆖 𑆱𑆷𑆖𑆵𑆩𑆶𑆒𑆵 𑆖 𑆯𑆶𑆰𑇀𑆑𑆳 𑆖 𑆮𑆳𑆩𑆴𑆤𑆵 𑆖 𑆰𑆟𑇀𑆞𑆪𑆾𑆤𑆴𑆯𑇀𑆖 𑆩𑆲𑆳𑆪𑆾𑆤𑆴𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 (𑇙); 𑆑𑆼𑆮𑆬𑆯𑇀𑆖𑆳𑆪𑆩𑆶𑆢𑇀𑆢𑆼𑆯𑆾 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴𑇆𑇔𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮 𑆤𑆴𑆘𑆳 𑆮𑆴𑆑𑆳𑆫𑆳 𑆤𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆼𑆨𑇀𑆪𑆾 𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳𑆲𑆴- 𑆯𑆑𑆶𑆤𑆴𑆂 𑆱𑆫𑇀𑆮𑆁 𑆢𑆴𑆮𑆱𑆩𑆥𑆴 𑆥𑆫𑆴𑆥𑆠𑆤𑇀 𑆱𑇀𑆮𑆳𑆁 𑆗𑆳𑆪𑆳𑆁 𑆤𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼, 𑆠𑆡𑆳 𑆱𑇀𑆮𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆮𑆴𑆑𑆳𑆫𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑇀𑆤𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆁 𑆥𑆶𑆤𑆂 𑆱𑇀𑆡𑆳𑆤𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆠𑆢𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑆥𑆴 𑆖 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆳𑆁 𑆱𑇀𑆠𑆳𑆤𑆼𑆮𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆤𑇀𑆠𑆂𑇆𑇕𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆮𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆳 𑆪𑆼 𑆮𑆴𑆑𑆳𑆫𑆱𑆕𑇀𑆔𑆳 𑆧𑆲𑆮𑆂 𑆯𑆫𑆵𑆫𑆼𑇅 𑆤 𑆠𑆼 𑆥𑆸𑆡𑆑𑇀 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑆴𑆬𑆼𑆨𑇀𑆪 𑆄𑆓𑆤𑇀𑆠𑆮𑆱𑇀𑆠𑇀𑆮𑆼𑆮 𑆠𑆠𑆾 𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆳𑆂𑇆𑇖𑇆
𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑆤𑇀𑆮𑆼𑆠𑆴 𑆤𑆴𑆘𑆁 𑆮𑆴𑆑𑆳𑆫𑆁 𑆤𑆴𑆘𑆱𑇀𑆠𑆡𑆳𑇁𑇁𑆓𑆤𑇀𑆠𑆶𑆩𑆥𑆴 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆂𑇅 𑆠𑆠𑇀𑆫𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆖 𑆱𑆩𑇀𑆪𑆓𑇀 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆠𑆠𑆂 𑆑𑆫𑇀𑆩 𑆱𑆩𑆳𑆫𑆨𑆼𑆠𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆮𑆴𑆁𑆯𑆑𑆳𑆯𑇀𑆖𑆽𑆑𑆑𑆳𑆯𑇀𑆖𑆽𑆮 𑆠𑇀𑆫𑆴𑆑𑆳𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇅 𑆢𑇀𑆮𑆴𑆑𑆳𑆯𑇀𑆖𑆳𑆰𑇀𑆛𑆿, 𑆖𑆠𑆶𑆰𑇀𑆑𑆳𑆯𑇀𑆖 𑆢𑆯, 𑆢𑇀𑆮𑆳𑆢𑆯 𑆥𑆚𑇀𑆖𑆑𑆳𑆂𑇆𑇘𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆯𑇀𑆖𑆳𑆰𑇀𑆛𑆑𑆳 𑆮𑆫𑇀𑆓𑆳𑆂, 𑆰𑆛𑇀𑆑𑆿 𑆢𑇀𑆮𑆿, 𑆱𑆥𑇀𑆠𑆑𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇅 𑆃𑆰𑇀𑆛𑆾𑆢𑆫𑆵𑆪𑆼 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆫𑆾𑆓𑆳𑆣𑇀𑆪𑆳𑆪𑆼 𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆳𑆂𑇆𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆲𑆳𑆫𑆾𑆓𑆳𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆫𑆾𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑆴- 𑆄𑆓𑆤𑇀𑆠𑆶𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆩𑆥𑆴 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆫𑆾𑆓𑆠𑇀𑆮𑆩𑆼𑆑𑆮𑆴𑆣𑆁 𑆨𑆮𑆠𑆴, 𑆫𑆶𑆑𑇀𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀; 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆼𑆰𑆳𑆩𑇀, 𑆄𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆘𑆮𑆴𑆨𑆳𑆓𑆳𑆠𑇀; 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆖𑆽𑆰𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁, 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀 ; 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑆶𑆤𑆫𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆂, 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆳𑆪𑆠𑆤𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆯𑆼𑆰𑆳𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀 𑇆𑇓𑇆
𑆩𑆶𑆒𑆳𑆤𑆴 𑆠𑆶 𑆒𑆬𑇀𑆮𑆳𑆓𑆤𑇀𑆠𑆾𑆫𑇀𑆤𑆒𑆢𑆯𑆤𑆥𑆠𑆤𑆳𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆨𑆴𑆔𑆳𑆠𑆮𑇀𑆪𑆣- 𑆧𑆤𑇀𑆣𑆤𑆮𑆼𑆰𑇀𑆛𑆤𑆥𑆵𑆝𑆤𑆫𑆘𑇀𑆘𑆶𑆢𑆲𑆤𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆯𑆤𑆴𑆨𑆷𑆠𑆾𑆥𑆱𑆫𑇀𑆓𑆳𑆢𑆵𑆤𑆴, 𑆤𑆴𑆘𑆱𑇀𑆪 𑆠𑆶 𑆩𑆶𑆒𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆁 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑇀𑇆𑇔𑇆
𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑆶 𑆒𑆬𑇀𑆮𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆘𑆪𑆾𑆂 𑆥𑇀𑆫𑆼𑆫𑆟𑆩𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆂, 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆂, 𑆥𑆫𑆴𑆟𑆳𑆩𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇕𑇆
𑆱𑆫𑇀𑆮𑆼𑇁𑆥𑆴 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑇁𑆨𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆫𑆾𑆓𑆳𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆩𑆤𑆶𑆧𑆣𑇀𑆤𑆤𑇀𑆠𑆴, 𑆤 𑆖𑆳𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆼𑆤 𑆱𑆲 𑆱𑆤𑇀𑆢𑆼𑆲𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇖𑇆
𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑇀𑆲𑆴 𑆮𑇀𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆾 𑆘𑆔𑆤𑇀𑆪𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆁 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴; 𑆤𑆴𑆘𑆼 𑆠𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆘𑆔𑆤𑇀𑆪𑆁 𑆮𑇀𑆪𑆡𑆳𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴𑇆𑇗𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆥𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆯𑆫𑆵𑆫𑆼 𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆨𑆳𑆓 𑆇𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆧𑆱𑇀𑆠𑆴𑆂 𑆥𑆶𑆫𑆵𑆰𑆳𑆣𑆳𑆤𑆁 𑆑𑆛𑆴𑆂 𑆱𑆑𑇀𑆡𑆴𑆤𑆵 𑆥𑆳𑆢𑆳𑆮𑆱𑇀𑆡𑆵𑆤𑆴 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆯𑇀𑆖 𑆮𑆳𑆠𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆮𑆳𑆠𑆱𑇀𑆡𑆳𑆤𑆁; 𑆱𑇀𑆮𑆼𑆢𑆾 𑆫𑆱𑆾 𑆬𑆱𑆵𑆑𑆳 𑆫𑆶𑆣𑆴𑆫𑆩𑆳𑆩𑆳𑆯𑆪𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴, 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆡𑆳𑆤𑆩𑇀; 𑆇𑆫𑆂 𑆯𑆴𑆫𑆾 𑆓𑇀𑆫𑆵𑆮𑆳 𑆥𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆾 𑆩𑆼𑆢𑆯𑇀𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴, 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆶𑆫𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑇀𑆡𑆳𑆤𑆩𑇀𑇆𑇘𑇆
𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆖𑆫𑆳𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆫𑆵𑆫𑆼 𑆑𑆶𑆥𑆴𑆠𑆳𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆳𑆤𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴- 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆳𑆂 𑆯𑆶𑆨𑆳𑆤𑇀𑆪𑆶𑆥𑆖𑆪𑆧𑆬𑆮𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆢𑆵𑆤𑆴, 𑆃𑆯𑆶𑆨𑆳𑆤𑆴 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆤𑇀𑆤𑆳 𑆮𑆴𑆑𑆳𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆳𑆤𑆴𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆘𑆳, 𑆤𑆳𑆤𑆳𑆠𑇀𑆩𑆘𑆳𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆘𑆳𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆰𑇀𑆛𑆾𑆢𑆫𑆵𑆪𑆼 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂, 𑆤𑆳𑆤𑆳𑆠𑇀𑆩𑆘𑆳𑆁𑆱𑇀𑆠𑇀𑆮𑆴𑆲𑆳𑆣𑇀𑆪𑆳𑆪𑆼𑇁𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆯𑆵𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆂, 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆂𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆿 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆤𑆒𑆨𑆼𑆢𑆯𑇀𑆖, 𑆮𑆴𑆥𑆳𑆢𑆴𑆑𑆳 𑆖, 𑆥𑆳𑆢𑆯𑆷𑆬𑆁 𑆖, 𑆥𑆳𑆢𑆨𑇀𑆫𑆁𑆯𑆯𑇀𑆖, 𑆥𑆳𑆢𑆱𑆶𑆥𑇀𑆠𑆠𑆳 𑆖, 𑆮𑆳𑆠𑆒𑆶𑆝𑇀𑆝𑆠𑆳 𑆖, 𑆓𑆶𑆬𑇀𑆦𑆓𑇀𑆫𑆲𑆯𑇀𑆖, 𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆖, 𑆓𑆸𑆣𑇀𑆫𑆱𑆵 𑆖, 𑆘𑆳𑆤𑆶𑆨𑆼𑆢𑆯𑇀𑆖, 𑆘𑆳𑆤𑆶𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆯𑇀𑆖, 𑆈𑆫𑆶𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖, 𑆈𑆫𑆶𑆱𑆳𑆢𑆯𑇀𑆖, 𑆥𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆁 𑆖, 𑆓𑆶𑆢𑆨𑇀𑆫𑆁𑆯𑆯𑇀𑆖, 𑆓𑆶𑆢𑆳𑆫𑇀𑆠𑆴𑆯𑇀𑆖, 𑆮𑆸𑆰𑆟𑆳𑆑𑇀𑆰𑆼𑆥𑆯𑇀𑆖 , 𑆯𑆼𑆦𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖, 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆳𑆤𑆳𑆲𑆯𑇀𑆖, 𑆯𑇀𑆫𑆾𑆟𑆴𑆨𑆼𑆢𑆯𑇀𑆖, 𑆮𑆴𑆝𑇀𑆨𑆼𑆢𑆯𑇀𑆖, 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆯𑇀𑆖, 𑆒𑆚𑇀𑆘𑆠𑇀𑆮𑆁 𑆖, 𑆑𑆶𑆧𑇀𑆘𑆠𑇀𑆮𑆁 𑆖, 𑆮𑆳𑆩𑆤𑆠𑇀𑆮𑆁 𑆖, 𑆠𑇀𑆫𑆴𑆑𑆓𑇀𑆫𑆲𑆯𑇀𑆖, 𑆥𑆸𑆰𑇀𑆜𑆓𑇀𑆫𑆲𑆯𑇀𑆖, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆮𑆩𑆫𑇀𑆢𑆯𑇀𑆖, 𑆇𑆢𑆫𑆳𑆮𑆼𑆰𑇀𑆛𑆯𑇀𑆖, 𑆲𑆸𑆤𑇀𑆩𑆾𑆲𑆯𑇀𑆖 , 𑆲𑆸𑆢𑇀𑆢𑇀𑆫𑆮𑆯𑇀𑆖, 𑆮𑆑𑇀𑆰𑆿𑆢𑇀𑆔𑆫𑇀𑆰𑆯𑇀𑆖 , 𑆮𑆑𑇀𑆰𑆿𑆥𑆫𑆾𑆣𑆯𑇀𑆖, 𑆮𑆑𑇀𑆰𑆱𑇀𑆠𑆾𑆢𑆯𑇀𑆖, 𑆧𑆳𑆲𑆶𑆯𑆾𑆰𑆯𑇀𑆖, 𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖, 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖, 𑆑𑆟𑇀𑆜𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆯𑇀𑆖, 𑆲𑆤𑆶𑆨𑆼𑆢𑆯𑇀𑆖 , 𑆏𑆰𑇀𑆜𑆨𑆼𑆢𑆯𑇀𑆖, 𑆃𑆑𑇀𑆰𑆴𑆨𑆼𑆢𑆯𑇀𑆖 , 𑆢𑆤𑇀𑆠𑆨𑆼𑆢𑆯𑇀𑆖, 𑆢𑆤𑇀𑆠𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 𑆖, 𑆩𑆷𑆑𑆠𑇀𑆮𑆁 𑆖 , 𑆮𑆳𑆑𑇀𑆱𑆕𑇀𑆓𑆯𑇀𑆖, 𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆪𑆠𑆳 𑆖, 𑆩𑆶𑆒𑆯𑆾𑆰𑆯𑇀𑆖, 𑆃𑆫𑆱𑆘𑇀𑆚𑆠𑆳 𑆖, 𑆔𑇀𑆫𑆳𑆟𑆤𑆳𑆯𑆯𑇀𑆖, 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆁 𑆖, 𑆃𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆁 𑆖, 𑆇𑆖𑇀𑆖𑆽𑆂𑆯𑇀𑆫𑆶𑆠𑆴𑆯𑇀𑆖 , 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆖, 𑆮𑆫𑇀𑆠𑇀𑆩𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑇀𑆖, 𑆮𑆫𑇀𑆠𑇀𑆩𑆱𑆕𑇀𑆑𑆾𑆖𑆯𑇀𑆖, 𑆠𑆴𑆩𑆴𑆫𑆁 𑆖, 𑆃𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆁 𑆖, 𑆃𑆑𑇀𑆰𑆴𑆮𑇀𑆪𑆶𑆢𑆳𑆱𑆯𑇀𑆖, 𑆨𑇀𑆫𑆷𑆮𑇀𑆪𑆶𑆢𑆳𑆱𑆯𑇀𑆖, 𑆯𑆕𑇀𑆒𑆨𑆼𑆢𑆯𑇀𑆖, 𑆬𑆬𑆳𑆛𑆨𑆼𑆢𑆯𑇀𑆖, 𑆯𑆴𑆫𑆾𑆫𑆶𑆑𑇀 𑆖, 𑆑𑆼𑆯𑆨𑆷𑆩𑆴𑆱𑇀𑆦𑆶𑆛𑆤𑆁 𑆖, 𑆃𑆫𑇀𑆢𑆴𑆠𑆁 𑆖, 𑆍𑆑𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆯𑇀𑆖, 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆯𑇀𑆖, 𑆥𑆑𑇀𑆰𑆮𑆣𑆯𑇀𑆖 , 𑆄𑆑𑇀𑆰𑆼𑆥𑆑𑆯𑇀𑆖, 𑆢𑆟𑇀𑆝𑆑𑆯𑇀𑆖, 𑆠𑆩𑆯𑇀𑆖 , 𑆨𑇀𑆫𑆩𑆯𑇀𑆖, 𑆮𑆼𑆥𑆡𑆶𑆯𑇀𑆖, 𑆘𑆸𑆩𑇀𑆨𑆳 𑆖, 𑆲𑆴𑆑𑇀𑆑𑆳 𑆖, 𑆮𑆴𑆰𑆳𑆢𑆯𑇀𑆖, 𑆃𑆠𑆴𑆥𑇀𑆫𑆬𑆳𑆥𑆯𑇀𑆖, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆖, 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆁 𑆖, 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆳𑆮𑆨𑆳𑆱𑆠𑆳 𑆖, 𑆃𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑇀𑆖, 𑆃𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆖𑆴𑆠𑇀𑆠𑆠𑇀𑆮𑆁 𑆖; 𑆅𑆠𑇀𑆪𑆯𑆵𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑆳𑆩𑆳𑆮𑆴𑆰𑇀𑆑𑆸𑆠𑆠𑆩𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇑𑇑𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆥𑆴 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆷𑆑𑇀𑆠𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆮𑆳𑆪𑆾𑆫𑆴𑆢𑆩𑆳𑆠𑇀𑆩𑆫𑆷𑆥𑆩𑆥𑆫𑆴𑆟𑆳𑆩𑆴 𑆑𑆫𑇀𑆩𑆟𑆯𑇀𑆖 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆁, 𑆪𑆢𑆶𑆥𑆬𑆨𑇀𑆪 𑆠𑆢𑆮𑆪𑆮𑆁 𑆮𑆳 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆱𑆤𑇀𑆢𑆼𑆲𑆳 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆬𑆳𑆔𑆮𑆁 𑆮𑆽𑆯𑆢𑇀𑆪𑆁 𑆓𑆠𑆴𑆫𑆩𑆷𑆫𑇀𑆠𑆠𑇀𑆮𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑆮𑆳𑆪𑆾𑆫𑆳𑆠𑇀𑆩𑆫𑆷𑆥𑆳𑆟𑆴; 𑆍𑆮𑆁𑆮𑆴𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆮𑆳𑆪𑆾𑆂 𑆑𑆫𑇀𑆩𑆟𑆂 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑆴𑆢𑆩𑆱𑇀𑆪 𑆨𑆮𑆠𑆴 𑆠𑆁 𑆠𑆁 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆩𑆳𑆮𑆴𑆯𑆠𑆂 ; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑇀𑆫𑆁𑆱𑆨𑇀𑆫𑆁𑆱𑆮𑇀𑆪𑆳𑆱𑆱𑆕𑇀𑆓𑆨𑆼𑆢𑆱𑆳𑆢𑆲𑆫𑇀𑆰𑆠𑆫𑇀𑆰𑆑𑆩𑇀𑆥𑆮𑆫𑇀𑆠𑆖𑆳𑆬𑆠𑆾𑆢𑆮𑇀𑆪𑆡𑆳𑆖𑆼𑆰𑇀𑆛𑆳𑆢𑆵𑆤𑆴 , 𑆠𑆡𑆳 𑆒𑆫𑆥𑆫𑆶𑆰𑆮𑆴𑆯𑆢𑆱𑆶𑆰𑆴𑆫𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆑𑆰𑆳𑆪𑆮𑆴𑆫𑆱𑆩𑆶𑆒𑆠𑇀𑆮𑆯𑆾𑆰𑆯𑆷𑆬𑆱𑆶𑆥𑇀𑆠𑆴𑆱𑆕𑇀𑆑𑆾𑆖𑆤𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆒𑆚𑇀𑆘𑆠𑆳𑆢𑆵𑆤𑆴 𑆖 𑆮𑆳𑆪𑆾𑆂 𑆑𑆫𑇀𑆩𑆳𑆟𑆴; 𑆠𑆽𑆫𑆤𑇀𑆮𑆴𑆠𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇑𑇒𑇆
𑆠𑆁 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠, 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆤𑆱𑇀𑆠𑆂𑆑𑆫𑇀𑆩𑆨𑆾𑆘𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳𑆠𑆲𑆫𑆽𑆫𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆳𑆬𑆁 𑆖 𑆥𑇀𑆫𑆩𑆳𑆟𑆵𑆑𑆸𑆠𑇀𑆪; 𑆠𑆠𑇀𑆫𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆨𑇀𑆪𑆾 𑆮𑆳𑆠𑆼 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆁 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑆨𑆴𑆰𑆘𑆂, 𑆠𑆢𑇀𑆣𑇀𑆪𑆳𑆢𑆴𑆠 𑆍𑆮 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆑𑆼𑆮𑆬𑆁 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆁 𑆮𑆳𑆠𑆩𑆷𑆬𑆁 𑆗𑆴𑆤𑆠𑇀𑆠𑆴; 𑆠𑆠𑇀𑆫𑆳𑆮𑆘𑆴𑆠𑆼𑇁𑆥𑆴 𑆮𑆳𑆠𑆼 𑆯𑆫𑆵𑆫𑆳𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆳 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳 𑆮𑆤𑆱𑇀𑆥𑆠𑆼𑆫𑇀𑆩𑆷𑆬𑆼 𑆗𑆴𑆤𑇀𑆤𑆼 𑆱𑇀𑆑𑆤𑇀𑆣𑆯𑆳𑆒𑆳𑆥𑇀𑆫𑆫𑆾𑆲𑆑𑆶𑆱𑆶𑆩𑆦𑆬𑆥𑆬𑆳𑆯𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆴𑆪𑆠𑆾 𑆮𑆴𑆤𑆳𑆯𑆱𑇀𑆠𑆢𑇀𑆮𑆠𑇀𑇆𑇑𑇓𑇆
𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆏𑆰𑆯𑇀𑆖, 𑆥𑇀𑆬𑆾𑆰𑆯𑇀𑆖, 𑆢𑆳𑆲𑆯𑇀𑆖, 𑆢𑆮𑆡𑆶𑆯𑇀𑆖, 𑆣𑆷𑆩𑆑𑆯𑇀𑆖, 𑆃𑆩𑇀𑆬𑆑𑆯𑇀𑆖, 𑆮𑆴𑆢𑆳𑆲𑆯𑇀𑆖, 𑆃𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆯𑇀𑆖, 𑆃𑆁𑆱𑆢𑆳𑆲𑆯𑇀𑆖 , 𑆈𑆰𑇀𑆩𑆳𑆣𑆴𑆑𑇀𑆪𑆁 𑆖, 𑆃𑆠𑆴𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆖 (𑆃𑆕𑇀𑆓𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆖), 𑆃𑆕𑇀𑆓𑆓𑆤𑇀𑆣𑆯𑇀𑆖, 𑆃𑆕𑇀𑆓𑆳𑆮𑆢𑆫𑆟𑆁 𑆖, 𑆯𑆾𑆟𑆴𑆠𑆑𑇀𑆬𑆼𑆢𑆯𑇀𑆖, 𑆩𑆳𑆁𑆱𑆑𑇀𑆬𑆼𑆢𑆯𑇀𑆖, 𑆠𑇀𑆮𑆓𑇀𑆢𑆳𑆲𑆯𑇀𑆖, (𑆩𑆳𑆁𑆱𑆢𑆳𑆲𑆯𑇀𑆖 ), 𑆠𑇀𑆮𑆓𑆮𑆢𑆫𑆟𑆁 𑆖, 𑆖𑆫𑇀𑆩𑆢𑆬𑆤𑆁 𑆖, 𑆫𑆑𑇀𑆠𑆑𑆾𑆜𑆯𑇀𑆖, 𑆫𑆑𑇀𑆠𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆯𑇀𑆖, 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆖, 𑆫𑆑𑇀𑆠𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆖, 𑆲𑆫𑆴𑆠𑆠𑇀𑆮𑆁 𑆖, 𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆠𑇀𑆮𑆁 𑆖, 𑆤𑆵𑆬𑆴𑆑𑆳 𑆖, 𑆑𑆑𑇀𑆰𑆳(𑆑𑇀𑆰𑇀𑆪𑆳)𑆖, 𑆑𑆳𑆩𑆬𑆳 𑆖, 𑆠𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆪𑆠𑆳 𑆖, 𑆬𑆾𑆲𑆴𑆠𑆓𑆤𑇀𑆣𑆳𑆱𑇀𑆪𑆠𑆳 𑆖, 𑆥𑆷𑆠𑆴𑆩𑆶𑆒𑆠𑆳 𑆖, 𑆠𑆸𑆰𑇀𑆟𑆳𑆣𑆴𑆑𑇀𑆪𑆁 𑆖, 𑆃𑆠𑆸𑆥𑇀𑆠𑆴𑆯𑇀𑆖, 𑆄𑆱𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆯𑇀𑆖, 𑆓𑆬𑆥𑆳𑆑𑆯𑇀𑆖, 𑆃𑆑𑇀𑆰𑆴𑆥𑆳𑆑𑆯𑇀𑆖, 𑆓𑆶𑆢𑆥𑆳𑆑𑆯𑇀𑆖, 𑆩𑆼𑆞𑇀𑆫𑆥𑆳𑆑𑆯𑇀𑆖, 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆁 𑆖 , 𑆠𑆩𑆂𑆥𑇀𑆫𑆮𑆼𑆯𑆯𑇀𑆖, 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆖; 𑆅𑆠𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑆳𑆩𑆳𑆮𑆴𑆰𑇀𑆑𑆸𑆠𑆠𑆩𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇑𑇔𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆥𑆴 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆷𑆑𑇀𑆠𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪𑆼𑆢𑆩𑆳𑆠𑇀𑆩𑆫𑆷𑆥𑆩𑆥𑆫𑆴𑆟𑆳𑆩𑆴 𑆑𑆫𑇀𑆩𑆟𑆯𑇀𑆖 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆁, 𑆪𑆢𑆶𑆥𑆬𑆨𑇀𑆪 𑆠𑆢𑆮𑆪𑆮𑆁 𑆮𑆳 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆱𑆤𑇀𑆢𑆼𑆲𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆐𑆰𑇀𑆟𑇀𑆪𑆁 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆢𑇀𑆫𑆮𑆠𑇀𑆮𑆩𑆤𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆾 𑆮𑆫𑇀𑆟𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆬𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆘𑆾 𑆓𑆤𑇀𑆣𑆯𑇀𑆖 𑆮𑆴𑆱𑇀𑆫𑆾 𑆫𑆱𑆿 𑆖 𑆑𑆛𑆶𑆑𑆳𑆩𑇀𑆬𑆿 𑆱𑆫𑆠𑇀𑆮𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆠𑇀𑆩𑆫𑆷𑆥𑆳𑆟𑆴; 𑆍𑆮𑆁𑆮𑆴𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆂 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑆴𑆢𑆩𑆱𑇀𑆪 𑆨𑆮𑆠𑆴 𑆠𑆁 𑆠𑆁 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆩𑆳𑆮𑆴𑆯𑆠𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆳𑆲𑆿𑆰𑇀𑆟𑇀𑆪𑆥𑆳𑆑𑆱𑇀𑆮𑆼𑆢𑆑𑇀𑆬𑆼𑆢𑆑𑆾𑆡𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆫𑆳𑆮𑆫𑆳𑆓𑆳 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆖 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆳𑆟𑆴; 𑆠𑆽𑆫𑆤𑇀𑆮𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇑𑇕𑇆
𑆠𑆁 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆯𑆵𑆠𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆑𑆥𑇀𑆫𑆢𑆼𑆲𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆽𑆫𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆳𑆬𑆁 𑆖 𑆥𑇀𑆫𑆩𑆳𑆟𑆵𑆑𑆸𑆠𑇀𑆪; 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆠𑆶 𑆱𑆫𑇀𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆨𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆼 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆁 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑆨𑆴𑆰𑆘𑆂; 𑆠𑆢𑇀𑆣𑇀𑆪𑆳𑆢𑆴𑆠 𑆍𑆮𑆳𑆩𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆑𑆼𑆮𑆬𑆁 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆁 𑆥𑆴𑆠𑇀𑆠𑆩𑆷𑆬𑆩𑆥𑆑𑆫𑇀𑆰𑆠𑆴, 𑆠𑆠𑇀𑆫𑆳𑆮𑆘𑆴𑆠𑆼 𑆥𑆴𑆠𑇀𑆠𑆼𑇁𑆥𑆴 𑆯𑆫𑆵𑆫𑆳𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳𑇁𑆓𑇀𑆤𑆿 𑆮𑇀𑆪𑆥𑆾𑆞𑆼 𑆑𑆼𑆮𑆬𑆩𑆓𑇀𑆤𑆴𑆓𑆸𑆲𑆁 𑆯𑆵𑆠𑆵𑆨𑆮𑆠𑆴 𑆠𑆢𑇀𑆮𑆠𑇀𑇆𑇑𑇖𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆁𑆯𑆠𑆴𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑆸𑆥𑇀𑆠𑆴𑆯𑇀𑆖, 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆖, 𑆤𑆴𑆢𑇀𑆫𑆳𑆣𑆴𑆑𑇀𑆪𑆁 𑆖, 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆁 𑆖, 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳 𑆖, 𑆄𑆬𑆱𑇀𑆪𑆁 𑆖, 𑆩𑆶𑆒𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁 𑆖, 𑆩𑆶𑆒𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆢𑇀𑆓𑆴𑆫𑆟𑆁 𑆖, 𑆩𑆬𑆱𑇀𑆪𑆳𑆣𑆴𑆑𑇀𑆪𑆁 𑆖, 𑆧𑆬𑆳𑆱𑆑𑆯𑇀𑆖 , 𑆃𑆥𑆑𑇀𑆠𑆴𑆯𑇀𑆖, 𑆲𑆸𑆢𑆪𑆾𑆥𑆬𑆼𑆥𑆯𑇀𑆖, 𑆑𑆟𑇀𑆜𑆾𑆥𑆬𑆼𑆥𑆯𑇀𑆖, 𑆣𑆩𑆤𑆵𑆥𑇀𑆫𑆠𑆴(𑆮𑆴)𑆖𑆪𑆯𑇀𑆖, 𑆓𑆬𑆓𑆟𑇀𑆝𑆯𑇀𑆖, 𑆃𑆠𑆴𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆁 𑆖, 𑆯𑆵𑆠𑆳𑆓𑇀𑆤𑆴𑆠𑆳 𑆖, 𑆇𑆢𑆫𑇀𑆢𑆯𑇀𑆖, 𑆯𑇀𑆮𑆼𑆠𑆳𑆮𑆨𑆳𑆱𑆠𑆳 𑆖, 𑆯𑇀𑆮𑆼𑆠𑆩𑆷𑆠𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆖; 𑆅𑆠𑆴 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑆳𑆩𑆳𑆮𑆴𑆰𑇀𑆑𑆸𑆠𑆠𑆩𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇗𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆥𑆴 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆷𑆑𑇀𑆠𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟 𑆅𑆢𑆩𑆳𑆠𑇀𑆩𑆫𑆷𑆥𑆩𑆥𑆫𑆴𑆟𑆳𑆩𑆴 𑆑𑆫𑇀𑆩𑆟𑆯𑇀𑆖 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆁 𑆪𑆢𑆶𑆥𑆬𑆨𑇀𑆪 𑆠𑆢𑆮𑆪𑆮𑆁 𑆮𑆳 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆱𑆤𑇀𑆢𑆼𑆲𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑇀𑆤𑆼𑆲𑆯𑆽𑆠𑇀𑆪𑆯𑆿𑆑𑇀𑆬𑇀𑆪𑆓𑆿𑆫𑆮𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆩𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆳𑆤𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟 𑆄𑆠𑇀𑆩𑆫𑆷𑆥𑆳𑆟𑆴; 𑆍𑆮𑆁𑆮𑆴𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆂 𑆑𑆫𑇀𑆩𑆟𑆂 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑆴𑆢𑆩𑆱𑇀𑆪 𑆨𑆮𑆠𑆴 𑆠𑆁 𑆠𑆁 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆩𑆳𑆮𑆴𑆯𑆠𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆯𑆽𑆠𑇀𑆪𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆓𑆿𑆫𑆮𑆱𑇀𑆤𑆼𑆲𑆱𑆶𑆥𑇀𑆠𑆴𑆑𑇀𑆬𑆼𑆢𑆾𑆥𑆢𑆼𑆲𑆧𑆤𑇀𑆣𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆖𑆴𑆫𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆤𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆂 𑆑𑆫𑇀𑆩𑆳𑆟𑆴; 𑆠𑆽𑆫𑆤𑇀𑆮𑆴𑆠𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆩𑆼𑆮𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇑𑇘𑇆
𑆠𑆁 𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆫𑆷𑆑𑇀𑆰𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑆱𑇀𑆮𑆼𑆢𑆮𑆩𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆴𑆨𑆴𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆲𑆫𑆽𑆫𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆳𑆬𑆁 𑆖 𑆥𑇀𑆫𑆩𑆳𑆟𑆵𑆑𑆸𑆠𑇀𑆪; 𑆮𑆩𑆤𑆁 𑆠𑆶 𑆱𑆫𑇀𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆨𑇀𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆁 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑆨𑆴𑆰𑆘𑆂, 𑆠𑆢𑇀𑆣𑇀𑆪𑆳𑆢𑆴𑆠 𑆍𑆮𑆳𑆩𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆾𑆫𑆾𑆓𑆠𑆁 𑆑𑆼𑆮𑆬𑆁 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆷𑆬𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑆠𑆴, 𑆠𑆠𑇀𑆫𑆳𑆮𑆘𑆴𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑇀𑆪𑆥𑆴 𑆯𑆫𑆵𑆫𑆳𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳 𑆨𑆴𑆤𑇀𑆤𑆼 𑆑𑆼𑆢𑆳𑆫𑆱𑆼𑆠𑆿 𑆯𑆳𑆬𑆴𑆪𑆮𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆢𑆵𑆤𑇀𑆪𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑇀𑆪𑆩𑇀𑆨𑆱𑆳 𑆥𑇀𑆫𑆯𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆢𑇀𑆮𑆢𑆴𑆠𑆴𑇆𑇑𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆫𑆾𑆓𑆩𑆳𑆢𑆿 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆠𑆠𑆂 𑆑𑆫𑇀𑆩 𑆨𑆴𑆰𑆑𑇀 𑆥𑆯𑇀𑆖𑆳𑆘𑇀𑆘𑇀𑆚𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑆩𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇒𑇐𑇆
𑆪𑆱𑇀𑆠𑆶 𑆫𑆾𑆓𑆩𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆑𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆳𑆫𑆨𑆠𑆼 𑆨𑆴𑆰𑆑𑇀𑇅 𑆃𑆥𑇀𑆪𑆿𑆰𑆣𑆮𑆴𑆣𑆳𑆤𑆘𑇀𑆚𑆱𑇀𑆠𑆱𑇀𑆪 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆳𑇆𑇒𑇑𑇆
𑆪𑆱𑇀𑆠𑆶 𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆂 𑆱𑆫𑇀𑆮𑆨𑆽𑆰𑆘𑇀𑆪𑆑𑆾𑆮𑆴𑆢𑆂𑇅 𑆢𑆼𑆯𑆑𑆳𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆱𑇀𑆠𑆱𑇀𑆪 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆱𑆁𑆯𑆪𑆩𑇀𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆢𑆼𑆯𑆾 𑆮𑆴𑆑𑆳𑆫𑆩𑆶𑆒𑆩𑆵𑆫𑆟𑆩𑇀 𑇅 𑆃𑆱𑆤𑇀𑆢𑆼𑆲𑆾𑇁𑆤𑆶𑆧𑆤𑇀𑆣𑆯𑇀𑆖 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆂𑇆𑇒𑇓𑇆
𑆢𑆾𑆰𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆓𑆟𑆳 𑆤𑆳𑆤𑆳𑆠𑇀𑆩𑆘𑆳𑆯𑇀𑆖 𑆪𑆼𑇅 𑆫𑆷𑆥𑆁 𑆥𑆸𑆡𑆑𑇀 𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆑𑆫𑇀𑆩 𑆖𑆳𑆥𑆫𑆴𑆟𑆳𑆩𑆴 𑆪𑆠𑇀𑇆𑇒𑇔𑇆
𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤 𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆱𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆳𑆂𑇅 𑆱𑆩𑇀𑆪𑆕𑇀𑆩𑆲𑆠𑆴 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆣𑇀𑆪𑆳𑆪𑆼 𑆠𑆠𑇀𑆠𑇀𑆮𑆢𑆫𑇀𑆯𑆴𑆤𑆳𑇆𑇒𑇕𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆰𑇀𑆛𑆿𑆤𑆴𑆤𑇀𑆢𑆴𑆠𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆯𑆫𑆵𑆫𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪𑆳𑆰𑇀𑆛𑆿 𑆥𑆶𑆫𑆶𑆰𑆳 𑆤𑆴𑆤𑇀𑆢𑆴𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆯𑇀𑆖, 𑆃𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆯𑇀𑆖, 𑆃𑆠𑆴𑆬𑆾𑆩𑆳 𑆖, 𑆃𑆬𑆾𑆩𑆳 𑆖 , 𑆃𑆠𑆴𑆑𑆸𑆰𑇀𑆟𑆯𑇀𑆖, 𑆃𑆠𑆴𑆓𑆿𑆫𑆯𑇀𑆖, 𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆯𑇀𑆖, 𑆃𑆠𑆴𑆑𑆸𑆯𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆑𑆸𑆯𑆪𑆾𑆫𑇀𑆨𑆷𑆪 𑆍𑆮𑆳𑆥𑆫𑆼 𑆤𑆴𑆤𑇀𑆢𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆱𑇀𑆪 𑆠𑆳𑆮𑆢𑆳𑆪𑆶𑆰𑆾 𑆲𑇀𑆫𑆳𑆱𑆾 𑆘𑆮𑆾𑆥𑆫𑆾𑆣𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆮𑇀𑆪𑆮𑆳𑆪𑆠𑆳 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆱𑇀𑆮𑆼𑆢𑆳𑆧𑆳𑆣𑆂 𑆑𑇀𑆰𑆶𑆢𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑆴𑆥𑆳𑆱𑆳𑆠𑆴𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆰𑇀𑆛𑆿 𑆢𑆾𑆰𑆳𑆂𑇅 𑆠𑆢𑆠𑆴𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆩𑆠𑆴𑆱𑆩𑇀𑆥𑆷𑆫𑆟𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆢𑇀𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆢𑇀𑆣𑆫𑇀𑆰𑆤𑆴𑆠𑇀𑆪𑆠𑇀𑆮𑆳𑆢- 𑆖𑆴𑆤𑇀𑆠𑆤𑆳𑆢𑇀𑆧𑆵𑆘𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆖𑇀𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆠𑆱𑇀𑆪 𑆲𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆢𑆱𑇀𑆮𑆴𑆤𑆾 𑆩𑆼𑆢 𑆍𑆮𑆾𑆥𑆖𑆵𑆪𑆠𑆼 𑆤 𑆠𑆡𑆼𑆠𑆫𑆼 𑆣𑆳𑆠𑆮𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆱𑇀𑆪𑆳𑆪𑆶𑆰𑆾 𑆲𑇀𑆫𑆳𑆱𑆂; 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆳𑆠𑇀 𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆩𑆼𑆢𑆱𑆾 𑆘𑆮𑆾𑆥𑆫𑆾𑆣𑆂 , 𑆯𑆶𑆑𑇀𑆫𑆳𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆳𑇁𑇁𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆮𑇀𑆪𑆮𑆳𑆪𑆠𑆳, 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆱𑆩𑆠𑇀𑆮𑆳𑆢𑇀𑆣𑆳𑆠𑆷𑆤𑆳𑆁, 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆩𑆼𑆢𑆾𑆢𑆾𑆰𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆤𑆠𑇀𑆮𑆳𑆖𑇀𑆖, 𑆩𑆼𑆢𑆱𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆱𑆲𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆱𑇀𑆮𑆼𑆢𑆳𑆧𑆳𑆣𑆂, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆷𑆠𑆑𑆾𑆰𑇀𑆜𑆮𑆳𑆪𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆑𑇀𑆰𑆶𑆢𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑆴𑆥𑆳𑆱𑆳𑆠𑆴𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆼𑆢𑆱𑆳𑇁𑇁𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆂 𑆑𑆾𑆰𑇀𑆜𑆼 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇅 𑆖𑆫𑆤𑇀 𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆪𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆳𑆲𑆳𑆫𑆁 𑆯𑆾𑆰𑆪𑆠𑇀𑆪𑆥𑆴𑇆𑇕𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱 𑆯𑆵𑆔𑇀𑆫𑆁 𑆘𑆫𑆪𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆁 𑆖𑆳𑆠𑆴𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆠𑆴𑇅 𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖𑆳𑆯𑇀𑆤𑆶𑆠𑆼 𑆔𑆾𑆫𑆳𑆤𑇀 𑆑𑆳𑆁𑆯𑇀𑆖𑆴𑆠𑇀𑆑𑆳𑆬𑆮𑇀𑆪𑆠𑆴𑆑𑇀𑆫𑆩𑆳𑆠𑇀𑇆𑇖𑇆
𑆍𑆠𑆳𑆮𑆶𑆥𑆢𑇀𑆫𑆮𑆑𑆫𑆿 𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑆶𑆠𑆿𑇅 𑆍𑆠𑆿 𑆲𑆴 𑆢𑆲𑆠𑆂 𑆱𑇀𑆡𑆷𑆬𑆁 𑆮𑆤𑆢𑆳𑆮𑆾 𑆮𑆤𑆁 𑆪𑆡𑆳𑇆𑇗𑇆
𑆩𑆼𑆢𑆱𑇀𑆪𑆠𑆵𑆮 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆼 𑆱𑆲𑆱𑆽𑆮𑆳𑆤𑆴𑆬𑆳𑆢𑆪𑆂𑇅 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆢𑆳𑆫𑆶𑆟𑆳𑆤𑇀 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤𑆳𑆯𑆪𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆘𑆵𑆮𑆴𑆠𑆩𑇀𑇆𑇘𑇆
𑆩𑆼𑆢𑆾𑆩𑆳𑆁𑆱𑆳𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆬𑆱𑇀𑆦𑆴𑆓𑆶𑆢𑆫𑆱𑇀𑆠𑆤𑆂𑇅 𑆃𑆪𑆡𑆾𑆥𑆖𑆪𑆾𑆠𑇀𑆱𑆳𑆲𑆾 𑆤𑆫𑆾𑇁𑆠𑆴𑆱𑇀𑆡𑆷𑆬 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇙𑇆
𑆅𑆠𑆴 𑆩𑆼𑆢𑆱𑇀𑆮𑆴𑆤𑆾 𑆢𑆾𑆰𑆳 𑆲𑆼𑆠𑆮𑆾 𑆫𑆷𑆥𑆩𑆼𑆮 𑆖𑇅 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁, ....𑇅𑇑𑇐𑇅 ... 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆮𑆳𑆖𑇀𑆪𑆩𑆠𑆴𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆼 𑆠𑇀𑆮𑆠𑆂 𑆥𑆫𑆩𑇀𑇆𑇑𑇐𑇆
𑆱𑆼𑆮𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆳𑆤𑆳𑆁 𑆬𑆕𑇀𑆔𑆤𑆁 𑆥𑇀𑆫𑆩𑆴𑆠𑆳𑆯𑆤𑆩𑇀𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆠𑆴𑆪𑆾𑆓𑆂 𑆯𑆾𑆑𑆯𑇀𑆖 𑆮𑆼𑆓𑆤𑆴𑆢𑇀𑆫𑆳𑆮𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆂𑇆𑇑𑇑𑇆
𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪𑆾𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆁 𑆱𑇀𑆤𑆳𑆤𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆱𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆘𑆫𑆳𑇅 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆶𑆯𑆪𑆂 𑆑𑇀𑆫𑆾𑆣𑆂 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆑𑆸𑆯𑆁 𑆤𑆫𑆩𑇀𑇆𑇑𑇒𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆩𑆠𑆴𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆪𑆿𑆰𑆣𑆩𑇀 𑇅 𑆑𑆸𑆯𑆾 𑆤 𑆱𑆲𑆠𑆼 𑆠𑆢𑇀𑆮𑆢𑆠𑆴𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆩𑆽𑆡𑆶𑆤𑆩𑇀𑇆𑇑𑇓𑇆
𑆥𑇀𑆬𑆵𑆲𑆳 𑆑𑆳𑆱𑆂 𑆑𑇀𑆰𑆪𑆂 𑆯𑇀𑆮𑆳𑆱𑆾 𑆓𑆶𑆬𑇀𑆩𑆾𑇁𑆫𑇀𑆯𑆳𑆁𑆱𑇀𑆪𑆶𑆢𑆫𑆳𑆟𑆴 𑆖𑇅 𑆑𑆸𑆯𑆁 𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆨𑆴𑆣𑆳𑆮𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆯𑇀𑆖 𑆓𑇀𑆫𑆲𑆟𑆵𑆓𑆠𑆳𑆂𑇆𑇑𑇔𑇆
𑆯𑆶𑆰𑇀𑆑𑆱𑇀𑆦𑆴𑆓𑆶𑆢𑆫𑆓𑇀𑆫𑆵𑆮𑆾 𑆣𑆩𑆤𑆵𑆘𑆳𑆬𑆱𑆤𑇀𑆠𑆠𑆂𑇅 𑆠𑇀𑆮𑆓𑆱𑇀𑆡𑆴𑆯𑆼𑆰𑆾𑇁𑆠𑆴𑆑𑆸𑆯𑆂 𑆱𑇀𑆡𑆷𑆬𑆥𑆫𑇀𑆮𑆳 𑆤𑆫𑆾 𑆩𑆠𑆂𑇆𑇑𑇕𑇆

𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑆴𑆠𑆥𑆵𑆠𑆵𑆪𑆼 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆫𑆱𑆳𑆢𑆴𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆩𑇀𑇆𑇒𑇗𑇆
𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆛𑇀𑆱𑇀𑆮𑆼𑆢𑆮𑆳𑆲𑆳𑆤𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆩𑆿𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆴𑆑𑆵𑇅 𑆠𑆡𑆳𑇁𑆠𑆴𑆱𑆳𑆫𑆴𑆑𑆵 𑆑𑆳𑆫𑇀𑆪𑆳 𑆠𑆡𑆳 𑆘𑇀𑆮𑆫𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆑𑆵𑇆𑇒𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆠𑇀𑆫𑆪𑆾𑆢𑆯𑆳𑆤𑆳𑆁 𑆩𑆷𑆬𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆢𑆶𑆰𑇀𑆛𑆴𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆤𑆳𑆩𑆥𑆫𑇀𑆪𑆳𑆪𑆳𑆂 𑆑𑆾𑆥𑆤𑆳𑆤𑆴 𑆥𑆫𑆱𑇀𑆥𑆫𑆩𑇀𑇆𑇒𑇙𑇆
𑆢𑆾𑆰𑆲𑆼𑆠𑆶𑆂 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤 𑆨𑆼𑆰𑆘𑆾𑆢𑇀𑆢𑆼𑆯 𑆍𑆮 𑆖𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆩𑆳𑆤𑆼 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆱𑇀𑆠𑆡𑆳 𑆖𑆳𑆢𑆿 𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇓𑇐𑇆
𑆑𑆼𑆮𑆬𑆁 𑆮𑆴𑆢𑆴𑆠𑆁 𑆪𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆁 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆠𑆂𑇅 𑆯𑆳𑆫𑆵𑆫𑆳𑆂 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆳𑆯𑇀𑆖 𑆱 𑆑𑆫𑇀𑆩𑆱𑆶 𑆤 𑆩𑆶𑆲𑇀𑆪𑆠𑆴𑇆𑇓𑇑𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆢𑇀𑆮𑆼 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆨𑆮𑆠𑆂 𑆥𑇀𑆫𑆨𑆳𑆮𑆨𑆼𑆢𑆼𑆤- 𑆱𑆳𑆣𑇀𑆪𑆩𑇀, 𑆃𑆱𑆳𑆣𑇀𑆪𑆁 𑆖; 𑆢𑇀𑆮𑆼 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆧𑆬𑆨𑆼𑆢𑆼𑆤- 𑆩𑆸𑆢𑆶, 𑆢𑆳𑆫𑆶𑆟𑆁 𑆖; 𑆢𑇀𑆮𑆼 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆃𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆼𑆢𑆼𑆤- 𑆩𑆤𑆾𑇁𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁, 𑆯𑆫𑆵𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆖; 𑆢𑇀𑆮𑆼 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆨𑆼𑆢𑆼𑆤- 𑆱𑇀𑆮𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑇀, 𑆄𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆖; 𑆢𑇀𑆮𑆼 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆄𑆯𑆪𑆨𑆼𑆢𑆼𑆤- 𑆄𑆩𑆳𑆯𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆁, 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆁 𑆖𑆼𑆠𑆴𑇅 𑆍𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆨𑆳𑆮𑆧𑆬𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆯𑆪𑆨𑆼𑆢𑆳𑆢𑇀𑆢𑇀𑆮𑆽𑆣𑆁 𑆱𑆢𑇀𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆨𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆩𑆡𑆮𑆳𑇁𑆥𑆴 𑆱𑆤𑇀𑆣𑆵𑆪𑆩𑆳𑆤𑆁 𑆱𑇀𑆪𑆳𑆢𑆼𑆑𑆠𑇀𑆮𑆁 𑆧𑆲𑆶𑆠𑇀𑆮𑆁 𑆮𑆳𑇅 𑆍𑆑𑆠𑇀𑆮𑆁 𑆠𑆳𑆮𑆢𑆼𑆑𑆩𑆼𑆮 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆁, 𑆢𑆶𑆂𑆒𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀 ; 𑆧𑆲𑆶𑆠𑇀𑆮𑆁 𑆠𑆶 𑆢𑆯 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆳𑆤𑆴 𑆥𑇀𑆫𑆨𑆳𑆮𑆨𑆼𑆢𑆳𑆢𑆴𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆧𑆲𑆶𑆠𑇀𑆮𑆩𑆥𑆴 𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆮𑆳𑇅 𑆠𑆠𑇀𑆫 𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆠𑆳𑆮𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑆰𑇀𑆛𑆾𑆢𑆫𑆵𑆪𑆼, 𑆃𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆥𑆶𑆤𑆫𑇀𑆪𑆡𑆳- 𑆩𑆲𑆳𑆫𑆾𑆓𑆳𑆣𑇀𑆪𑆳𑆪𑆼 𑆫𑆶𑆓𑇀𑆮𑆫𑇀𑆟𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆢𑆵𑆤𑆳𑆩𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇓𑇆
𑆤 𑆖 𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆓𑇀𑆫𑆼𑆰𑆶 𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆵𑆪𑆼𑆰𑆶 𑆮𑆴𑆓𑆵𑆠𑆴𑆫𑆴𑆠𑇀𑆪𑆠𑆾 𑆢𑆾𑆰𑆮𑆠𑆵 𑆱𑇀𑆪𑆳𑆢𑆠𑇀𑆫 𑆑𑆳𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳, 𑆤 𑆖𑆳𑆮𑆴𑆓𑆵𑆠𑆴𑆫𑆴𑆠𑇀𑆪𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑆢𑆾𑆰𑆮𑆠𑆵𑇅 𑆨𑆼𑆠𑇀𑆠𑆳 𑆲𑆴 𑆨𑆼𑆢𑇀𑆪𑆩𑆤𑇀𑆪𑆡𑆳𑆨𑆴𑆤𑆠𑇀𑆠𑆴, 𑆃𑆤𑇀𑆪𑆡𑆳 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆢𑇀𑆨𑆴𑆤𑇀𑆤𑆁 𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆨𑆴𑆤𑇀𑆢𑆤𑇀 𑆨𑆼𑆢𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆮𑆴𑆯𑆼𑆰𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑇀𑆪𑆤𑆼𑆑𑆣𑆳, 𑆤 𑆖 𑆥𑆷𑆫𑇀𑆮𑆁 𑆨𑆼𑆢𑆳𑆓𑇀𑆫𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆴𑇅 𑆱𑆩𑆳𑆤𑆳𑆪𑆳𑆩𑆥𑆴 𑆒𑆬𑆶 𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑆿 𑆥𑇀𑆫𑆑𑆸𑆠𑆳𑆤𑆶𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆤𑇀𑆠𑆫𑆩𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆩𑇀 𑇅 𑆱𑆤𑇀𑆠𑆴 𑆲𑇀𑆪𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆱𑆩𑆳𑆤𑆯𑆧𑇀𑆢𑆳𑆨𑆴𑆲𑆴𑆠𑆳𑆤𑆴, 𑆱𑆤𑇀𑆠𑆴 𑆖𑆳𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆥𑆫𑇀𑆪𑆳𑆪𑆯𑆧𑇀𑆢𑆳𑆨𑆴𑆲𑆴𑆠𑆳𑆤𑆴𑇅 𑆱𑆩𑆳𑆤𑆾 𑆲𑆴 𑆫𑆾𑆓𑆯𑆧𑇀𑆢𑆾 𑆢𑆾𑆰𑆼𑆰𑆶 𑆖 𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆖; 𑆢𑆾𑆰𑆳 𑆲𑇀𑆪𑆥𑆴 𑆫𑆾𑆓𑆯𑆧𑇀𑆢𑆩𑆳𑆠𑆕𑇀𑆑𑆯𑆧𑇀𑆢𑆁 𑆪𑆑𑇀𑆰𑇀𑆩𑆯𑆧𑇀𑆢𑆁 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑆧𑇀𑆢𑆁 𑆮𑆴𑆑𑆳𑆫𑆯𑆧𑇀𑆢𑆁 𑆖 𑆬𑆨𑆤𑇀𑆠𑆼, 𑆮𑇀𑆪𑆳𑆣𑆪𑆯𑇀𑆖 𑆫𑆾𑆓𑆯𑆧𑇀𑆢𑆩𑆳𑆠𑆕𑇀𑆑𑆯𑆧𑇀𑆢𑆁 𑆪𑆑𑇀𑆰𑇀𑆩𑆯𑆧𑇀𑆢𑆁 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑆧𑇀𑆢𑆁 𑆮𑆴𑆑𑆳𑆫𑆯𑆧𑇀𑆢𑆁 𑆖 𑆬𑆨𑆤𑇀𑆠𑆼𑇅 𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆼𑆰𑆶 𑆖𑆽𑆮 𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆖 𑆫𑆾𑆓𑆯𑆧𑇀𑆢𑆂 𑆱𑆩𑆳𑆤𑆂, 𑆯𑆼𑆰𑆼𑆰𑆶 𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆮𑆳𑆤𑇀𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑇀𑆪𑆳𑆣𑆪𑆾𑇁𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆃𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆢𑆾𑆰𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆃𑆤𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆡𑆳𑆖𑆴𑆠𑇀𑆫𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆶𑆢𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑇀, 𑆃𑆤𑆮𑆯𑆼𑆰𑆼𑆟 𑆖 𑆢𑆾𑆰𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆫𑆘𑆱𑇀𑆠𑆩𑆯𑇀𑆖 𑆩𑆳𑆤𑆱𑆿 𑆢𑆾𑆰𑆿𑇅 𑆠𑆪𑆾𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆩𑆾𑆲𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆩𑆳𑆤𑆩𑆢𑆯𑆾𑆑𑆖𑆴𑆠𑇀𑆠𑆾(𑆤𑇀𑆠𑆾)𑆢𑇀𑆮𑆼𑆓𑆨𑆪𑆲𑆫𑇀𑆰𑆳𑆢𑆪𑆂𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆯𑆳𑆫𑆵𑆫𑆳 𑆢𑆾𑆰𑆳𑆂𑇅 𑆠𑆼𑆰𑆳𑆩𑆥𑆴 𑆖 𑆮𑆴𑆑𑆳𑆫𑆳 𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆯𑆾𑆦𑆯𑆾𑆰𑆯𑇀𑆮𑆳𑆱𑆩𑆼𑆲𑆑𑆶𑆰𑇀𑆜𑆳𑆢𑆪𑆂𑇅 𑆅𑆠𑆴 𑆢𑆾𑆰𑆳𑆂 𑆑𑆼𑆮𑆬𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆮𑆴𑆑𑆳𑆫𑆽𑆑𑆢𑆼𑆯𑆯𑇀𑆖𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆁 𑆢𑇀𑆮𑆪𑆳𑆤𑆳𑆩𑆥𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆁; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆂, 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆂, 𑆥𑆫𑆴𑆟𑆳𑆩𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇖𑇆
𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆠𑆼 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆢𑆷𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖 𑆮𑆴𑆑𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑇀𑆪𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑇀𑇆𑇗𑇆
𑆠𑆼 𑆖 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆳𑆂 𑆑𑆢𑆳𑆖𑆴𑆢𑆤𑆶𑆧𑆣𑇀𑆤𑆤𑇀𑆠𑆴 𑆑𑆳𑆩𑆳𑆢𑆪𑆾 𑆘𑇀𑆮𑆫𑆳𑆢𑆪𑆯𑇀𑆖𑇆𑇘𑇆
𑆤𑆴𑆪𑆠𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆧𑆤𑇀𑆣𑆾 𑆫𑆘𑆱𑇀𑆠𑆩𑆱𑆾𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆁, 𑆤 𑆲𑇀𑆪𑆫𑆘𑆱𑇀𑆑𑆁 𑆠𑆩𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇙𑇆
(𑆥𑇀𑆫𑆳𑆪𑆂) 𑆯𑆳𑆫𑆵𑆫𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆼𑆑𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆵𑆪𑆳𑆤𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆂 𑆱𑆁𑆱𑆫𑇀𑆓𑆾 𑆮𑆳 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆠𑇀; 𑆢𑆾𑆰𑆳 𑆲𑆴 𑆢𑆷𑆰𑆟𑆽𑆂 𑆱𑆩𑆳𑆤𑆳𑆂𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆑𑆸𑆠𑆾 𑆮𑆴𑆯𑆼𑆰𑆂- 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆾 𑆮𑇀𑆪𑆑𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆾 𑆪𑆡𑆾𑆑𑇀𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆯𑆩𑆾 𑆨𑆮𑆠𑇀𑆪𑆤𑆶𑆧𑆤𑇀𑆣𑇀𑆪𑆂, 𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆧𑆤𑇀𑆣𑆂𑇅 𑆃𑆤𑆶𑆧𑆤𑇀𑆣𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆪𑆢𑆴 𑆢𑆾𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆑𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼, 𑆢𑇀𑆮𑆪𑆁 𑆮𑆳 𑆱𑆁𑆱𑆫𑇀𑆓𑆩𑇀𑇅 𑆃𑆤𑆶𑆧𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆮𑆴𑆯𑆼𑆰𑆑𑆸𑆠𑆱𑇀𑆠𑆶 𑆧𑆲𑆶𑆮𑆴𑆣𑆾 𑆢𑆾𑆰𑆨𑆼𑆢𑆂𑇅 𑆍𑆮𑆩𑆼𑆰 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆾 𑆨𑆴𑆰𑆘𑆳𑆁 𑆢𑆾𑆰𑆼𑆰𑆶 𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆖 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆮𑇀𑆪𑆷𑆲𑆂 𑇆𑇑𑇑𑇆
𑆃𑆓𑇀𑆤𑆴𑆰𑆶 𑆠𑆶 𑆯𑆳𑆫𑆵𑆫𑆼𑆰𑆶 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾 𑆮𑆴𑆯𑆼𑆰𑆾 𑆧𑆬𑆨𑆼𑆢𑆼𑆤 𑆨𑆮𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾, 𑆩𑆤𑇀𑆢𑆂, 𑆱𑆩𑆾, 𑆮𑆴𑆰𑆩𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑇁𑆓𑇀𑆤𑆴𑆂 𑆱𑆫𑇀𑆮𑆳𑆥𑆖𑆳𑆫𑆱𑆲𑆂, 𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆠𑆶 𑆩𑆤𑇀𑆢𑆂, 𑆱𑆩𑆱𑇀𑆠𑆶 𑆒𑆬𑇀𑆮𑆥𑆖𑆳𑆫𑆠𑆾 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇁𑆤𑆥𑆖𑆳𑆫𑆠𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆑𑆸𑆠𑆳𑆮𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼, 𑆱𑆩𑆬𑆑𑇀𑆰𑆟𑆮𑆴𑆥𑆫𑆵𑆠𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆠𑆶 𑆮𑆴𑆰𑆩 𑆅𑆠𑆴𑇅 𑆍𑆠𑆼 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆤𑆳𑆩𑆼𑆮 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆱𑆩𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆱𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆂, 𑆮𑆳𑆠𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆮𑆳𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆼𑇁𑆓𑇀𑆤𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼 𑆮𑆴𑆰𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆂, 𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆲𑇀𑆪𑆓𑇀𑆤𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆨𑆴𑆨𑆷𑆠𑆼𑇁𑆓𑇀𑆤𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼 𑆩𑆤𑇀𑆢𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆪𑆂𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂- 𑆤 𑆱𑆩𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾 𑆘𑆤𑇀𑆠𑆮𑆂 𑆱𑆤𑇀𑆠𑆴, 𑆮𑆴𑆰𑆩𑆳𑆲𑆳𑆫𑆾𑆥𑆪𑆾𑆓𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁; 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆖 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆑𑆼𑆖𑆴𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂, 𑆑𑆼𑆖𑆴𑆠𑇀 𑆥𑆶𑆤𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆵𑆠𑆴𑇅 𑆠𑆖𑇀𑆖𑆳𑆤𑆶𑆥𑆥𑆤𑇀𑆤𑆁, 𑆑𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑆳𑆫𑆟𑆳𑆠𑇀? 𑆱𑆩𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆲𑇀𑆪𑆫𑆾𑆓𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆂, 𑆪𑆠𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑇀𑆖𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑇀, 𑆄𑆫𑆾𑆓𑇀𑆪𑆳𑆫𑇀𑆡𑆳 𑆖 𑆨𑆼𑆰𑆘𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆱𑆳 𑆖𑆼𑆰𑇀𑆛𑆫𑆷𑆥𑆳, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆤𑇀𑆠𑆴 𑆱𑆩𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂; 𑆤 𑆒𑆬𑆶 𑆱𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆾 𑆮𑆳𑇅 𑆠𑆱𑇀𑆪 𑆠𑆱𑇀𑆪 𑆑𑆴𑆬 𑆢𑆾𑆰𑆱𑇀𑆪𑆳𑆣𑆴𑆑𑇀𑆪𑆳𑆠𑇀 𑆱𑆳 𑆱𑆳 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁, 𑆤 𑆖 𑆮𑆴𑆑𑆸𑆠𑆼𑆰𑆶 𑆢𑆾𑆰𑆼𑆰𑆶 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆠𑇀𑆮𑆩𑆶𑆥𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆽𑆠𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆱𑆤𑇀𑆠𑆴; 𑆱𑆤𑇀𑆠𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆮𑆳𑆠𑆬𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆯𑇀𑆖, 𑆃𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆳𑆱𑇀𑆠𑆶 𑆠𑆼 𑆘𑇀𑆚𑆼𑆪𑆳𑆂𑇆𑇑𑇓𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆁 𑆖𑆠𑇀𑆮𑆳𑆫𑇀𑆪𑆤𑆶𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆤𑆴 𑆯𑇀𑆫𑆼𑆪𑆱𑇀𑆑𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆱𑆩𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆳𑆑𑆳𑆫𑆱𑆩𑆩𑇀, 𑆃𑆣𑆴𑆑𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑆶 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆢𑆾𑆰𑆳𑆣𑆴𑆑𑇀𑆪𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆥𑇀𑆫𑆠𑆴𑆑𑆷𑆬𑆪𑆾𑆓𑆵𑆤𑆴 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆤𑆶(𑆤𑇀𑆤)𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆤𑆴 𑆯𑇀𑆫𑆼𑆪𑆱𑇀𑆑𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆳𑆮𑆢𑆓𑇀𑆤𑆼𑆂 𑆱𑆩𑆵𑆨𑆳𑆮𑆳𑆠𑇀, 𑆱𑆩𑆼 𑆠𑆶 𑆱𑆩𑆩𑆼𑆮 𑆑𑆳𑆫𑇀𑆪𑆩𑇀; 𑆍𑆮𑆁 𑆖𑆼𑆰𑇀𑆛𑆳 𑆨𑆼𑆰𑆘𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼𑇅 𑆠𑆳𑆤𑇀 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇔𑇆
𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑆶 𑆥𑆶𑆫𑆶𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆠𑆶𑆫𑆳𑆂, 𑆠𑆼 𑆠𑇀𑆮𑆤𑆳𑆠𑆶𑆫𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑆫𑆵𑆪𑆳𑆟𑆳𑆁 𑆨𑆴𑆰𑆘𑆳𑆩𑇀𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆠𑆬𑆂, 𑆥𑆴𑆠𑇀𑆠𑆬𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁- 𑆮𑆳𑆠𑆬𑆱𑇀𑆪 𑆮𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆥𑆴𑆠𑇀𑆠𑆬𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆱𑇀𑆪 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆧𑆬𑆮𑆤𑇀𑆠𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆬𑆱𑇀𑆪 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆤 𑆠𑆡𑆼𑆠𑆫𑆿 𑆢𑆾𑆰𑆿; 𑆱 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆤𑇀𑆤𑆾 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆠𑆥𑆠𑆴 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆶𑆒𑆳𑆪𑆶𑆰𑆳𑆩𑆶𑆥𑆔𑆳𑆠𑆳𑆪𑇅 𑆠𑆱𑇀𑆪𑆳𑆮𑆘𑆪𑆤𑆁- 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆮𑆴𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆿, 𑆩𑆸𑆢𑆷𑆤𑆴 𑆖 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆤𑆴 𑆱𑇀𑆤𑆼𑆲𑆾𑆰𑇀𑆟𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴, 𑆠𑆢𑇀𑆮𑆢𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆳𑆟𑆴, 𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆥𑆤𑆳𑆲𑆤𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆾𑆤𑇀𑆩𑆫𑇀𑆢𑆤𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆤𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆮𑆥𑆵𑆝𑆤𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆥𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆫𑆟𑆳𑆤𑆴, 𑆱𑆶𑆫𑆳𑆱𑆮𑆮𑆴𑆣𑆳𑆤𑆁, 𑆱𑇀𑆤𑆼𑆲𑆳𑆯𑇀𑆖𑆳𑆤𑆼𑆑𑆪𑆾𑆤𑆪𑆾 𑆢𑆵𑆥𑆤𑆵𑆪𑆥𑆳𑆖𑆤𑆵𑆪𑆮𑆳𑆠𑆲𑆫𑆮𑆴𑆫𑆼𑆖𑆤𑆵𑆪𑆾𑆥𑆲𑆴𑆠𑆳𑆱𑇀𑆠𑆡𑆳 𑆯𑆠𑆥𑆳𑆑𑆳𑆂 𑆱𑆲𑆱𑇀𑆫𑆥𑆳𑆑𑆳𑆂 𑆱𑆫𑇀𑆮𑆯𑆯𑇀𑆖 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆫𑇀𑆡𑆳𑆂, 𑆧𑆱𑇀𑆠𑆪𑆂, 𑆧𑆱𑇀𑆠𑆴𑆤𑆴𑆪𑆩𑆂 𑆱𑆶𑆒𑆯𑆵𑆬𑆠𑆳 𑆖𑆼𑆠𑆴𑇆𑇑𑇖𑇆
𑆥𑆴𑆠𑇀𑆠𑆬𑆱𑇀𑆪𑆳𑆥𑆴 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆤 𑆠𑆡𑆼𑆠𑆫𑆿 𑆢𑆾𑆰𑆿; 𑆠𑆢𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆤𑇀𑆤𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆠𑆥𑆠𑆴 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆶𑆒𑆳𑆪𑆶𑆰𑆳𑆩𑆶𑆥𑆔𑆳𑆠𑆳𑆪𑇅 𑆠𑆱𑇀𑆪𑆳𑆮𑆘𑆪𑆤𑆁- 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆥𑆳𑆤𑆁, 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆖 𑆱𑇀𑆤𑆼𑆲𑆤𑆩𑇀, 𑆃𑆣𑆯𑇀𑆖 𑆢𑆾𑆰𑆲𑆫𑆟𑆁, 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆯𑆵𑆠𑆳𑆤𑆳𑆁 𑆖𑆿𑆰𑆣𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂, 𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆱𑆶𑆫𑆨𑆴𑆯𑆵𑆠𑆲𑆸𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆓𑆤𑇀𑆣𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆱𑆼𑆮𑆳, 𑆩𑆶𑆑𑇀𑆠𑆳𑆩𑆟𑆴𑆲𑆳𑆫𑆳𑆮𑆬𑆵𑆤𑆳𑆁 𑆖 𑆥𑆫𑆩𑆯𑆴𑆯𑆴𑆫𑆮𑆳𑆫𑆴𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆳𑆁 𑆣𑆳𑆫𑆟𑆩𑆶𑆫𑆱𑆳, 𑆑𑇀𑆰𑆟𑆼 𑆑𑇀𑆰𑆟𑆼𑇁𑆓𑇀𑆫𑇀𑆪𑆖𑆤𑇀𑆢𑆤𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆑𑆳𑆬𑆵𑆪𑆩𑆸𑆟𑆳𑆬𑆯𑆵𑆠𑆮𑆳𑆠𑆮𑆳𑆫𑆴𑆨𑆴𑆫𑆶𑆠𑇀𑆥𑆬𑆑𑆶𑆩𑆶𑆢𑆑𑆾𑆑𑆤𑆢𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆥𑆢𑇀𑆩𑆳𑆤𑆶𑆓𑆠𑆽𑆯𑇀𑆖 𑆮𑆳𑆫𑆴𑆨𑆴𑆫𑆨𑆴𑆥𑇀𑆫𑆾𑆑𑇀𑆰𑆟𑆁, 𑆯𑇀𑆫𑆶𑆠𑆴𑆱𑆶𑆒𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆩𑆤𑆾𑇁𑆤𑆶𑆓𑆳𑆤𑆳𑆁 𑆖 𑆓𑆵𑆠𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆯𑇀𑆫𑆮𑆟𑆁, 𑆯𑇀𑆫𑆮𑆟𑆁 𑆖𑆳𑆨𑇀𑆪𑆶𑆢𑆪𑆳𑆤𑆳𑆁, 𑆱𑆶𑆲𑆸𑆢𑇀𑆨𑆴𑆂 𑆱𑆁𑆪𑆾𑆓𑆂, 𑆱𑆁𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆨𑆴𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆨𑆴𑆂 𑆯𑆵𑆠𑆾𑆥𑆲𑆴𑆠𑆳𑆁𑆯𑆶𑆑𑆱𑇀𑆫𑆓𑇀𑆣𑆳𑆫𑆴𑆟𑆵𑆨𑆴𑆂, 𑆤𑆴𑆯𑆳𑆑𑆫𑆳𑆁𑆯𑆶𑆯𑆵𑆠𑆬𑆥𑇀𑆫𑆮𑆳𑆠𑆲𑆫𑇀𑆩𑇀𑆪𑆮𑆳𑆱𑆂, 𑆯𑆽𑆬𑆳𑆤𑇀𑆠𑆫𑆥𑆶𑆬𑆴𑆤𑆯𑆴𑆯𑆴𑆫𑆱𑆢𑆤𑆮𑆱𑆤𑆮𑇀𑆪𑆘𑆤𑆥𑆮𑆤𑆱𑆼𑆮𑆤𑆁, 𑆫𑆩𑇀𑆪𑆳𑆟𑆳𑆁 𑆖𑆾𑆥𑆮𑆤𑆳𑆤𑆳𑆁 𑆱𑆶𑆒𑆯𑆴𑆯𑆴𑆫𑆱𑆶𑆫𑆨𑆴𑆩𑆳𑆫𑆶𑆠𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑆳𑆩𑆶𑆥𑆱𑆼𑆮𑆤𑆁, 𑆱𑆼𑆮𑆤𑆁 𑆖 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆤𑆬𑆴𑆤𑆑𑆶𑆩𑆶𑆢𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆯𑆠𑆥𑆠𑇀𑆫𑆲𑆱𑇀𑆠𑆳𑆤𑆳𑆁 , 𑆱𑆿𑆩𑇀𑆪𑆳𑆤𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆴𑆠𑆴𑇆𑇑𑇗𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆱𑇀𑆪𑆳𑆥𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆤 𑆠𑆡𑆼𑆠𑆫𑆿 𑆢𑆾𑆰𑆿; 𑆱 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆤𑇀𑆤𑆾 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆠𑆥𑆠𑆴 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆶𑆒𑆳𑆪𑆶𑆰𑆳𑆩𑆶𑆥𑆔𑆳𑆠𑆳𑆪𑇅 𑆠𑆱𑇀𑆪𑆳𑆮𑆘𑆪𑆤𑆁- 𑆮𑆴𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆳𑆤𑆴 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆤𑆴, 𑆫𑆷𑆑𑇀𑆰𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑆴 𑆖𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆳𑆟𑆴 𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑆴, 𑆠𑆡𑆽𑆮 𑆣𑆳𑆮𑆤𑆬𑆕𑇀𑆔𑆤𑆥𑇀𑆬𑆮𑆤𑆥𑆫𑆴𑆱𑆫𑆟𑆘𑆳𑆓𑆫𑆟𑆤𑆴𑆪𑆶𑆢𑇀𑆣𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑆤𑇀𑆩𑆫𑇀𑆢𑆤𑆱𑇀𑆤𑆳𑆤𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆤𑆴, 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆑𑆳𑆬𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆩𑆢𑇀𑆪𑆳𑆤𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂, 𑆱𑆣𑆷𑆩𑆥𑆳𑆤𑆂 𑆱𑆫𑇀𑆮𑆯𑆯𑇀𑆖𑆾𑆥𑆮𑆳𑆱𑆂, 𑆠𑆡𑆾𑆰𑇀𑆟𑆁 𑆮𑆳𑆱𑆂, 𑆱𑆶𑆒𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆯𑇀𑆖 𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆩𑆼𑆮𑆼𑆠𑆴𑇆𑇑𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆂 𑆱𑆫𑇀𑆮𑆑𑆳𑆫𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆠𑇀𑇅 𑆱𑆫𑇀𑆮𑆨𑆼𑆰𑆘𑆠𑆠𑇀𑆠𑇀𑆮𑆘𑇀𑆚𑆾 𑆫𑆳𑆘𑇀𑆚𑆂 𑆥𑇀𑆫𑆳𑆟𑆥𑆠𑆴𑆫𑇀𑆨𑆮𑆼𑆢𑆴𑆠𑆴𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆨𑆼𑆢𑆼𑆤 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆮𑆴𑆑𑆬𑇀𑆥𑆤𑆩𑇀𑇅 𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆮𑆴𑆫𑆾𑆣𑆯𑇀𑆖 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆫𑆾𑆓𑆢𑆾𑆰𑆪𑆾𑆂𑇆𑇒𑇐𑇆
𑆢𑆾𑆰𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑇀𑇅 𑆘𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑆴 𑆖𑆴𑆤𑇀𑆠𑆳 𑆖 𑆑𑆳𑆪𑆳𑆓𑇀𑆤𑆼𑆫𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆖𑇆𑇒𑇑𑇆
𑆤𑆫𑆳𑆟𑆳𑆁 𑆮𑆳𑆠𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆖𑇅 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆼 𑆮𑆴𑆩𑆳𑆤𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑇀𑆪𑆳𑆲𑆸𑆠𑆳𑆤𑆴 𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆵𑆪𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆢𑇀𑆮𑆿 𑆥𑆶𑆫𑆶𑆰𑆿 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆿 𑆨𑆮𑆠𑆂- 𑆓𑆶𑆫𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆂, 𑆬𑆔𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫- 𑆓𑆶𑆫𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠 𑆍𑆑𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆬𑆯𑆫𑆵𑆫𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆠𑇀𑆮𑆳𑆬𑇀𑆬𑆔𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠 𑆅𑆮 𑆢𑆸𑆯𑇀𑆪𑆠𑆼, 𑆬𑆔𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆾𑇁𑆥𑆫𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑆣𑆩𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠 𑆅𑆮 𑆢𑆸𑆯𑇀𑆪𑆠𑆼𑇅 𑆠𑆪𑆾𑆫𑆑𑆶𑆯𑆬𑆳𑆂 𑆑𑆼𑆮𑆬𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑆽𑆮 𑆫𑆷𑆥𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆼 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇓𑇆
𑆤𑆲𑆴 𑆘𑇀𑆚𑆳𑆤𑆳𑆮𑆪𑆮𑆼𑆤 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆼 𑆘𑇀𑆚𑆼𑆪𑆼 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆫𑆾𑆓𑆘𑇀𑆚𑆳𑆤𑆼 𑆇𑆥𑆑𑇀𑆫𑆩𑆪𑆶𑆑𑇀𑆠𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆖𑆳𑆥𑆴 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼𑇅 𑆠𑆼 𑆪𑆢𑆳 𑆓𑆶𑆫𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆁 𑆬𑆔𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆩𑆳𑆱𑆳𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆢𑆳 𑆠𑆩𑆬𑇀𑆥𑆢𑆾𑆰𑆁 𑆩𑆠𑇀𑆮𑆳 𑆱𑆁𑆯𑆾𑆣𑆤𑆑𑆳𑆬𑆼𑇁𑆱𑇀𑆩𑆽 𑆩𑆸𑆢𑆶 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑆾 𑆨𑆷𑆪 𑆍𑆮𑆳𑆱𑇀𑆪 𑆢𑆾𑆰𑆳𑆤𑆶𑆢𑆵𑆫𑆪𑆤𑇀𑆠𑆴𑇅 𑆪𑆢𑆳 𑆠𑆶 𑆬𑆔𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆁 𑆓𑆶𑆫𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆩𑆳𑆱𑆳𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆢𑆳 𑆠𑆁 𑆩𑆲𑆳𑆢𑆾𑆰𑆁 𑆩𑆠𑇀𑆮𑆳 𑆱𑆁𑆯𑆾𑆣𑆤𑆑𑆳𑆬𑆼𑇁𑆱𑇀𑆩𑆽 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑆾 𑆢𑆾𑆰𑆳𑆤𑆠𑆴𑆤𑆴𑆫𑇀𑆲𑆸𑆠𑇀𑆪 𑆯𑆫𑆵𑆫𑆩𑆱𑇀𑆪 𑆑𑇀𑆰𑆴𑆟𑇀𑆮𑆤𑇀𑆠𑆴𑇅 𑆍𑆮𑆩𑆮𑆪𑆮𑆼𑆤 𑆘𑇀𑆚𑆳𑆤𑆱𑇀𑆪 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆼 𑆘𑇀𑆚𑆼𑆪𑆼 𑆘𑇀𑆚𑆳𑆤𑆩𑆨𑆴𑆩𑆤𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆥𑆫𑆴𑆱𑇀𑆒𑆬𑆤𑇀𑆠𑆴𑇅 𑆮𑆴𑆢𑆴𑆠𑆮𑆼𑆢𑆴𑆠𑆮𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆨𑆴𑆰𑆘𑆂 𑆱𑆫𑇀𑆮𑆁 𑆱𑆫𑇀𑆮𑆡𑆳 𑆪𑆡𑆳𑆱𑆩𑇀𑆨𑆮𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆾 𑆤 𑆑𑇀𑆮𑆖𑆴𑆢𑆥𑆴 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆡𑆼𑆰𑇀𑆛𑆩𑆫𑇀𑆡𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴 𑆖𑆼𑆠𑆴𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆴𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆷𑆥𑆩𑆡𑆳𑆠𑆶𑆫𑆼 𑇅 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆧𑆳𑆬𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆬𑆳𑆧𑆬𑆼𑇆𑇕𑇆
𑆠𑆼 𑆨𑆼𑆰𑆘𑆩𑆪𑆾𑆓𑆼𑆤 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆩𑆾𑆲𑆴𑆠𑆳𑆂𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆤𑆳𑆯𑆳𑆪 𑆑𑇀𑆬𑆼𑆯𑆳𑆪 𑆩𑆲𑆠𑆼𑇁𑆥𑆴 𑆮𑆳𑇆𑇖𑇆
𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆳𑆱𑇀𑆠𑆶 𑆱𑆫𑇀𑆮𑆩𑆳𑆘𑇀𑆚𑆳𑆪 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆩𑆴𑆲 𑆱𑆫𑇀𑆮𑆡𑆳𑇅 𑆤 𑆱𑇀𑆒𑆬𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆰𑆶 𑆨𑆼𑆰𑆘𑆳𑆤𑆳𑆁 𑆑𑆢𑆳𑆖𑆤𑇆𑇗𑇆
𑆅𑆠𑆴 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆳𑆣𑆴𑆑𑆳𑆫𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆓𑇀𑆫𑆱𑆩𑇀𑆨𑆮𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆲𑆼𑆠𑆶𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆿 𑆑𑆳𑆫𑆟𑆁 𑆱𑆳𑆥𑆮𑆳𑆢𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆑𑆳𑆫𑆟𑆁 𑆖𑆳𑆤𑆥𑆮𑆳𑆢𑆁 𑆤𑆴𑆯𑆩𑇀𑆪, 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆾𑇁𑆠𑆂 𑆥𑆫𑆁 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆥𑆶𑆫𑆵𑆰𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆱𑇀𑆡𑆳𑆤𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆮𑆫𑇀𑆟𑆤𑆳𑆩𑆥𑇀𑆫𑆨𑆳𑆮𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆥𑆥𑇀𑆫𑆖𑇀𑆗𑆾𑆥𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪 𑆥𑆳𑆢𑆿𑇆𑇘𑇆
𑆃𑆡𑆳𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆅𑆲 𑆒𑆬𑇀𑆮𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆮𑆴𑆁𑆯𑆠𑆴𑆮𑆴𑆣𑆳𑆂 𑆑𑇀𑆫𑆴𑆩𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆼𑆤 𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆼𑆤𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆱𑆲𑆘𑆼𑆨𑇀𑆪𑆂; 𑆠𑆼 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆨𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆶𑆫𑆵𑆰𑆘𑆳𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑆳𑆂, 𑆯𑆾𑆟𑆴𑆠𑆘𑆳, 𑆩𑆬𑆘𑆳𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇙𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆁- 𑆲𑆱𑇀𑆠𑆼𑆤𑆳𑆨𑆴𑆓𑆸𑆲𑇀𑆪 𑆮𑆴𑆩𑆸𑆯𑇀𑆪𑆾𑆥𑆑𑆫𑆟𑆮𑆠𑆳𑇁𑆥𑆤𑆪𑆤𑆩𑆤𑆶𑆥𑆑𑆫𑆟𑆼𑆤 𑆮𑆳; 𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆳𑆤𑆳𑆁 𑆠𑆶 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆨𑆼𑆰𑆘𑆼𑆤𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆁 𑆤𑇀𑆪𑆳𑆪𑆠𑆂, 𑆠𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁, 𑆮𑆩𑆤𑆁, 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀, 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆖; 𑆅𑆠𑇀𑆪𑆥𑆑𑆫𑇀𑆰𑆟𑆮𑆴𑆣𑆴𑆂𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆔𑆳𑆠𑆱𑇀𑆠𑇀𑆮𑆼𑆰𑆳𑆁 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑇀𑆰𑆳𑆫𑆾𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂, 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆶𑆫𑆵𑆰𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆨𑆷𑆠𑆁 𑆠𑆠𑇀 𑆱𑇀𑆪𑆳𑆠𑇀; 𑆲𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆔𑆳𑆠𑆂𑇅 𑆃𑆤𑆤𑇀𑆠𑆫𑆁 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆱𑆼𑆮𑆤𑆁- 𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆤𑆴𑆢𑆳𑆤𑆮𑆴𑆣𑆿 𑆠𑆱𑇀𑆪 𑆮𑆴𑆮𑆫𑇀𑆘𑆤𑆁 𑆠𑆡𑆳𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑆳𑆁 𑆖𑆳𑆥𑆫𑆼𑆰𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆅𑆠𑆴 𑆬𑆑𑇀𑆰𑆟𑆠𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑇀𑇅 𑆍𑆠𑆢𑆼𑆮 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇑𑇕𑇆
𑆃𑆡𑆽𑆤𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆑𑆾𑆰𑇀𑆜𑆩𑆳𑆠𑆶𑆫𑆩𑆓𑇀𑆫𑆼 𑆰𑆝𑇀𑆫𑆳𑆠𑇀𑆫𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆥𑆳𑆢𑇀𑆪 𑆯𑇀𑆮𑆾𑆨𑆷𑆠𑆼 𑆍𑆤𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑆳𑆪𑆪𑆴𑆠𑆳𑇁𑆱𑇀𑆩𑆵𑆠𑆴 𑆑𑇀𑆰𑆵𑆫𑆓𑆶𑆝𑆢𑆣𑆴𑆠𑆴𑆬𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆷𑆥𑆩𑆳𑆁𑆱𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆥𑆫𑆩𑆳𑆤𑇀𑆤𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆱𑇀𑆤𑆼𑆲𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆨𑆾𑆘𑇀𑆪𑆽𑆂 𑆱𑆳𑆪𑆁 𑆥𑇀𑆫𑆳𑆠𑆯𑇀𑆖𑆾𑆥𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑆱𑆩𑆶𑆢𑆵𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆑𑆾𑆰𑇀𑆜𑆳𑆨𑆴𑆱𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆖 𑆨𑆴𑆰𑆑𑇀𑇅 𑆃𑆡 𑆮𑇀𑆪𑆶𑆰𑇀𑆛𑆳𑆪𑆳𑆁 𑆫𑆳𑆠𑇀𑆫𑇀𑆪𑆳𑆁 𑆱𑆶𑆒𑆾𑆰𑆴𑆠𑆁 𑆱𑆶𑆥𑇀𑆫𑆘𑆵𑆫𑇀𑆟𑆨𑆑𑇀𑆠𑆁 𑆖 𑆮𑆴𑆘𑇀𑆚𑆳𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆱𑇀𑆠𑆢𑆲𑆫𑆼𑆮𑆾𑆥𑆥𑆳𑆢𑆪𑆼𑆢𑆶𑆥𑆥𑆳𑆢𑆤𑆵𑆪𑆯𑇀𑆖𑆼𑆠𑇀 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆩𑇀𑆪𑆑𑇀𑇆𑇑𑇖𑇆
𑆃𑆡𑆳𑆲𑆫𑆼𑆠𑆴 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆩𑆷𑆬𑆑𑆱𑆫𑇀𑆰𑆥𑆬𑆯𑆶𑆤𑆑𑆫𑆚𑇀𑆘𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆒𑆫𑆥𑆶𑆰𑇀𑆥𑆳𑆨𑆷𑆱𑇀𑆠𑆸𑆟𑆱𑆶𑆩𑆶𑆒𑆱𑆶𑆫𑆱𑆑𑆶𑆜𑆼𑆫𑆑𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆳𑆬𑆩𑆳𑆬𑆑𑆥𑆫𑇀𑆟𑆳𑆱𑆑𑇀𑆰𑆮𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆡𑆮𑆳 𑆪𑆡𑆳𑆬𑆳𑆨𑆁; 𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑆳𑆤𑇀𑆪𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆒𑆟𑇀𑆝𑆯𑆯𑇀𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆥𑆳𑆤𑆵𑆪𑆼𑆤 𑆱𑆶𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆳𑆪𑆳𑆁 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆁 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑆟𑆳𑆫𑇀𑆣𑆾𑆢𑆑𑆼𑆤𑆳𑆨𑆴𑆰𑆴𑆖𑇀𑆪 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑆱𑆠𑆠𑆩𑆮𑆔𑆛𑇀𑆛𑆪𑆤𑇀 𑆢𑆫𑇀𑆮𑇀𑆪𑆳, 𑆠𑆩𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆼𑇁𑆩𑇀𑆨𑆱𑆴 𑆓𑆠𑆫𑆱𑆼𑆰𑇀𑆮𑆿𑆰𑆣𑆼𑆰𑆶 𑆱𑇀𑆡𑆳𑆬𑆵𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆱𑆶𑆥𑆫𑆴𑆥𑆷𑆠𑆁 𑆑𑆰𑆳𑆪𑆁 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆩𑆢𑆤𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆬𑇀𑆑𑆠𑆽𑆬𑆾𑆥𑆲𑆴𑆠𑆁 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆬𑆮𑆟𑆴𑆠𑆩𑆨𑇀𑆪𑆳𑆱𑆴𑆖𑇀𑆪 𑆧𑆱𑇀𑆠𑆿 𑆮𑆴𑆣𑆴𑆮𑆢𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆼𑆤𑆁; 𑆠𑆡𑆳𑇁𑆫𑇀𑆑𑆳𑆬𑆫𑇀𑆑𑆑𑆶𑆛𑆘𑆳𑆞𑆑𑆵𑆑𑆶𑆰𑇀𑆜𑆑𑆽𑆝𑆫𑇀𑆪𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆳, 𑆠𑆡𑆳 𑆯𑆴𑆓𑇀𑆫𑆶𑆥𑆵𑆬𑆶𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆑𑆛𑆶𑆑𑆳𑆱𑆫𑇀𑆰𑆥𑆑𑆰𑆳𑆪𑆼𑆟, 𑆠𑆡𑆳𑇁𑇁𑆩𑆬𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆑𑆰𑆳𑆪𑆼𑆟 𑆩𑆢𑆤𑆦𑆬𑆳𑆢𑆴𑆱𑆁𑆪𑆾𑆓𑆱𑆩𑇀𑆥𑆳𑆢𑆴𑆠𑆼𑆤, 𑆠𑇀𑆫𑆴𑆮𑆳𑆫𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳𑇁𑇁𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇗𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆠𑆼 𑆖 𑆥𑆯𑇀𑆖𑆴𑆩𑆼 𑆧𑆱𑇀𑆠𑆿 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆯𑇀𑆮𑆱𑇀𑆠𑆁 𑆠𑆢𑆲𑆫𑆼𑆮𑆾𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆲𑆫𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳; 𑆠𑆱𑇀𑆪 𑆮𑆴𑆣𑆴𑆫𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼- 𑆩𑆢𑆤𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆰𑆳𑆪𑆱𑇀𑆪𑆳𑆫𑇀𑆣𑆳𑆚𑇀𑆘𑆬𑆴𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆑𑆬𑇀𑆑𑆳𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆥𑆳𑆠𑆶𑆩𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆠𑆢𑆱𑇀𑆪 𑆢𑆾𑆰𑆩𑆶𑆨𑆪𑆠𑆾 𑆤𑆴𑆫𑇀𑆲𑆫𑆠𑆴 𑆱𑆳𑆣𑆶; 𑆍𑆮𑆩𑆼𑆮 𑆑𑆬𑇀𑆥𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆥𑆳𑆪𑆪𑆼𑆢𑆼𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆱𑆫𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆮𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆾 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇘𑇆
𑆃𑆡𑆽𑆤𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆪𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆯𑆽𑆒𑆫𑆴𑆑𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼𑆤 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆠𑆼𑆤𑆽𑆮 𑆖 𑆑𑆰𑆳𑆪𑆼𑆟 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆤𑇀 𑆱𑆫𑇀𑆮𑆾𑆢𑆑𑆳𑆫𑇀𑆡𑆳𑆤𑇀 𑆑𑆳𑆫𑆪𑆼𑆖𑇀𑆗𑆯𑇀𑆮𑆠𑇀; 𑆠𑆢𑆨𑆳𑆮𑆼 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆩𑆿𑆰𑆣𑆳𑆤𑆳𑆁 𑆑𑇀𑆮𑆳𑆡𑆽𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆽𑆫𑇀𑆮𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆁 𑆖𑆽𑆤𑆁 𑆤𑆴𑆮𑆳𑆠𑆩𑆳𑆓𑆳𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆪𑆮𑆳𑆓𑇀𑆮𑆳𑆢𑆴𑆤𑆳 𑆑𑇀𑆫𑆩𑆼𑆟𑆾𑆥𑆳𑆖𑆫𑆼𑆠𑇀, 𑆮𑆴𑆬𑆼𑆥𑆵𑆑𑇀𑆫𑆩𑆳𑆓𑆠𑆁 𑆖𑆽𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆢𑇀𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆽𑆬𑆼𑆤𑆽𑆑𑆳𑆤𑇀𑆠𑆫𑆁 𑆢𑇀𑆮𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆫𑇀𑆮𑆳𑇆𑇑𑇙𑇆
𑆪𑆢𑆴 𑆥𑆶𑆤𑆫𑆱𑇀𑆪𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆚𑇀𑆗𑆵𑆫𑇀𑆰𑆳𑆢𑆳𑆤𑇀 𑆑𑇀𑆫𑆴𑆩𑆵𑆤𑇀 𑆩𑆤𑇀𑆪𑆼𑆠 𑆯𑆴𑆫𑆱𑇀𑆪𑆽𑆮𑆳𑆨𑆴𑆱𑆫𑇀𑆥𑆠𑆂 𑆑𑆢𑆳𑆖𑆴𑆠𑇀, 𑆠𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆩𑆱𑇀𑆪 𑆯𑆴𑆫 𑆇𑆥𑆥𑆳𑆢𑇀𑆪 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆢𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆢𑆴𑆤𑆳 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑆤𑇆𑇒𑇐𑇆
𑆪𑆱𑇀𑆠𑇀𑆮𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆮𑆴𑆣𑆴𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆔𑆳𑆠𑆳𑆪𑆾𑆑𑇀𑆠𑆂 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆩𑆡 𑆠𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆩𑆷𑆬𑆑𑆥𑆫𑇀𑆟𑆵𑆁 𑆱𑆩𑆷𑆬𑆳𑆓𑇀𑆫𑆥𑇀𑆫𑆠𑆳𑆤𑆳𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆒𑆟𑇀𑆝𑆯𑆯𑇀𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆾𑆬𑆷(𑆢𑆷)𑆒𑆬𑆼 𑆑𑇀𑆰𑆾𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆳𑆟𑆴𑆨𑇀𑆪𑆳𑆁 𑆥𑆵𑆝𑆪𑆴𑆠𑇀𑆮𑆳 𑆫𑆱𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀, 𑆠𑆼𑆤 𑆫𑆱𑆼𑆤 𑆬𑆾𑆲𑆴𑆠𑆯𑆳𑆬𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆥𑆴𑆰𑇀𑆛𑆁 𑆱𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆥𑆷𑆥𑆬𑆴𑆑𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆴𑆣𑆷𑆩𑆼𑆰𑇀𑆮𑆕𑇀𑆓𑆳𑆫𑆼𑆰𑆷𑆥𑆑𑆶𑆝𑇀𑆪 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆽𑆬𑆬𑆮𑆟𑆾𑆥𑆲𑆴𑆠𑆳𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆑𑆾𑆰𑇀𑆜𑆳𑆪 𑆨𑆑𑇀𑆰𑆪𑆴𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆃𑆤𑆤𑇀𑆠𑆫𑆁 𑆖𑆳𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆩𑆶𑆢𑆯𑇀𑆮𑆴𑆢𑇀𑆮𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑆚𑇀𑆖𑆮𑆫𑇀𑆓𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆱𑆬𑆮𑆟𑆩𑆤𑆶𑆥𑆳𑆪𑆪𑆼𑆠𑇀𑇅 𑆃𑆤𑆼𑆤 𑆑𑆬𑇀𑆥𑆼𑆤 𑆩𑆳𑆫𑇀𑆑𑆮𑆳𑆫𑇀𑆑𑆱𑆲𑆖𑆫𑆤𑆵𑆥𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑇀𑆝𑆵𑆱𑆶𑆩𑆶𑆒𑆱𑆶𑆫𑆱𑆑𑆶𑆜𑆼𑆫𑆑𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆳𑆬𑆩𑆳𑆬𑆑𑆥𑆫𑇀𑆟𑆳𑆱𑆑𑇀𑆰𑆮𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑- 𑆧𑆑𑆶𑆬𑆑𑆶𑆛𑆘𑆱𑆶𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆵𑆱𑇀𑆮𑆫𑆱𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆥𑆷𑆥𑆬𑆴𑆑𑆳𑆂; 𑆠𑆡𑆳 𑆑𑆴𑆟𑆴𑆲𑆵𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆱𑆶𑆮𑆲𑆳𑆩𑆬𑆑𑆲𑆫𑆵𑆠𑆑𑆵𑆧𑆴𑆨𑆵𑆠𑆑𑆱𑇀𑆮𑆫𑆱𑆼𑆰𑆶 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆥𑆷𑆥𑆬𑆴𑆑𑆳𑆂; 𑆱𑇀𑆮𑆫𑆱𑆳𑆁𑆯𑇀𑆖𑆽𑆠𑆼𑆰𑆳𑆩𑆼𑆑𑆽𑆑𑆯𑆾 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆯𑆂 𑆱𑆫𑇀𑆮𑆯𑆾 𑆮𑆳 𑆩𑆣𑆶𑆮𑆴𑆬𑆶𑆬𑆴𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆳𑆠𑆫𑆤𑆤𑇀𑆤𑆳𑆪 𑆥𑆳𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀𑇆𑇒𑇑𑇆
𑆃𑆡𑆳𑆯𑇀𑆮𑆯𑆑𑆸𑆢𑆳𑆲𑆸𑆠𑇀𑆪 𑆩𑆲𑆠𑆴 𑆑𑆴𑆬𑆴𑆚𑇀𑆘𑆑𑆼 𑆥𑇀𑆫𑆱𑇀𑆠𑆵𑆫𑇀𑆪𑆳𑆠𑆥𑆼 𑆯𑆾𑆰𑆪𑆴𑆠𑇀𑆮𑆾𑆢𑆷𑆒𑆬𑆼 𑆑𑇀𑆰𑆾𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆢𑆸𑆰𑆢𑆴 𑆥𑆶𑆤𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆼𑆟 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆳𑇁𑆰𑇀𑆛𑆑𑆸𑆠𑇀𑆮𑆾 𑆢𑆯𑆑𑆸𑆠𑇀𑆮𑆾 𑆮𑆳𑇁𑇁𑆠𑆥𑆼 𑆱𑆶𑆥𑆫𑆴𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆴 𑆨𑆳𑆮𑆪𑆴𑆠𑇀𑆮𑆳 𑆢𑆸𑆰𑆢𑆴 𑆥𑆶𑆤𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆤𑆮𑆼 𑆑𑆬𑆯𑆼 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆥𑆳𑆟𑆴𑆠𑆬𑆁 𑆪𑆳𑆮𑆢𑇀𑆮𑆳 𑆱𑆳𑆣𑆶 𑆩𑆤𑇀𑆪𑆼𑆠 𑆠𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆑𑇀𑆫𑆴𑆩𑆴𑆑𑆾𑆰𑇀𑆜𑆴𑆤𑆼 𑆬𑆼𑆞𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀𑇆𑇒𑇒𑇆
𑆠𑆡𑆳 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆱𑇀𑆡𑆵𑆤𑇀𑆪𑆳𑆲𑆸𑆠𑇀𑆪 𑆑𑆬𑆯𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆖𑆳𑆥𑆾𑆡𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆴𑆠𑆼 𑆢𑆸𑆞𑆼 𑆑𑆬𑆯𑆼 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆤𑆼𑆑𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆧𑇀𑆫𑆣𑇀𑆤𑆼 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆮𑆼𑆰𑇀𑆛𑇀𑆪 𑆩𑆸𑆢𑆳𑆮𑆬𑆴𑆥𑇀𑆠𑆼 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪𑆾𑆝𑆶𑆥𑆼𑆤 𑆥𑆴𑆣𑆳𑆪 𑆨𑆷𑆩𑆳𑆮𑆳𑆑𑆟𑇀𑆜𑆁 𑆤𑆴𑆒𑆳𑆠𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆴𑆠𑆱𑇀𑆪𑆽𑆮𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆢𑆸𑆞𑆱𑇀𑆪 𑆑𑆶𑆩𑇀𑆨𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆱𑆩𑆳𑆫𑆾𑆥𑇀𑆪 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀𑆓𑆾𑆩𑆪𑆽𑆫𑆶𑆥𑆖𑆴𑆠𑇀𑆪 𑆢𑆳𑆲𑆪𑆼𑆠𑇀, 𑆱 𑆪𑆢𑆳 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆳𑆣𑆶 𑆢𑆓𑇀𑆣𑆳𑆤𑆴 𑆓𑆾𑆩𑆪𑆳𑆤𑆴 𑆮𑆴𑆓𑆠𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆴 𑆖 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆱𑇀𑆡𑆵𑆤𑆵𑆠𑆴 𑆠𑆠𑆱𑇀𑆠𑆁 𑆑𑆶𑆩𑇀𑆨𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀𑇅 𑆃𑆡 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳𑆠𑇀 𑆑𑆶𑆩𑇀𑆨𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆢𑆳𑆪 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆳𑆠𑆥𑆼 𑆱𑆫𑇀𑆮𑆩𑆲𑆂 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆠𑆾𑇁𑆱𑇀𑆩𑆽 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀 𑆥𑆳𑆤𑆳𑆪; 𑆠𑆼𑆤 𑆱𑆳𑆣𑆶 𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼, 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆵 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑇅 𑆍𑆮𑆩𑆼𑆮 𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆱𑆫𑆬𑆑𑆳𑆰𑇀𑆜𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆶𑆥𑆑𑆬𑇀𑆥𑇀𑆪 𑆥𑆳𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀𑇆𑇒𑇓𑇆
𑆃𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆑𑆳𑆬𑆼 𑇆𑇒𑇔𑇆
𑆃𑆡𑆳𑆲𑆫𑆼𑆠𑆴 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆯𑆳𑆫𑆢𑆳𑆤𑇀𑆤𑆮𑆳𑆁𑆱𑇀𑆠𑆴𑆬𑆳𑆤𑇀 𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆳𑆤𑇀; 𑆠𑆳𑆤𑆳𑆲𑆸𑆠𑇀𑆪 𑆱𑆶𑆤𑆴𑆰𑇀𑆥𑆷𑆠𑆳𑆤𑇀𑆤𑆴𑆰𑇀𑆥𑆷𑆪, 𑆱𑆶𑆯𑆶𑆢𑇀𑆣𑆳𑆤𑇀 𑆯𑆾𑆣𑆪𑆴𑆠𑇀𑆮𑆳 , 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆼 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆪𑆼𑆢𑆳𑆢𑆾𑆰𑆓𑆩𑆤𑆳𑆠𑇀, 𑆓𑆠𑆢𑆾𑆰𑆳𑆤𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪, 𑆱𑆶𑆥𑇀𑆫𑆬𑆷𑆤𑆳𑆤𑇀 𑆥𑇀𑆫𑆬𑆶𑆚𑇀𑆖𑇀𑆪, 𑆥𑆶𑆤𑆫𑆼𑆮 𑆱𑆶𑆤𑆴𑆰𑇀𑆥𑆷𑆠𑆳𑆤𑇀 𑆤𑆴𑆰𑇀𑆥𑆷𑆪, 𑆱𑆶𑆯𑆶𑆢𑇀𑆣𑆳𑆤𑇀 𑆯𑆾𑆣𑆪𑆴𑆠𑇀𑆮𑆳, 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆼𑆟 𑆠𑇀𑆫𑆴𑆂𑆱𑆥𑇀𑆠𑆑𑆸𑆠𑇀𑆮𑆂 𑆱𑆶𑆥𑆫𑆴𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑇀 𑆨𑆳𑆮𑆪𑆴𑆠𑇀𑆮𑆳, 𑆄𑆠𑆥𑆼 𑆯𑆾𑆰𑆪𑆴𑆠𑇀𑆮𑆳, 𑆇𑆬𑆷(𑆢𑆷)𑆒𑆬𑆼 𑆱𑆕𑇀𑆑𑇀𑆰𑆶𑆢𑇀𑆪, 𑆢𑆸𑆰𑆢𑆴 𑆥𑆶𑆤𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳, 𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆮𑆣𑆳𑆪, 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆼𑆟 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑆮𑆱𑆴𑆚𑇀𑆖𑆤𑇀 𑆥𑆳𑆟𑆴𑆩𑆫𑇀𑆢𑆩𑆼𑆮 𑆩𑆫𑇀𑆢𑆪𑆼𑆠𑇀; 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆼 𑆪𑆠𑇀𑆠𑆽𑆬𑆩𑆶𑆢𑆴𑆪𑆳𑆠𑇀𑆠𑆠𑇀 𑆥𑆳𑆟𑆴𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑇀𑆪𑆳𑆢𑆳𑆪, 𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑆑𑆬𑆯𑆼 𑆤𑇀𑆪𑆱𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇒𑇕𑇆
𑆃𑆡𑆳𑆲𑆫𑆼𑆠𑆴 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆠𑆴𑆬𑇀𑆮𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆿 𑆧𑆴𑆬𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆿 𑆥𑆴𑆟𑇀𑆝𑆿 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆿 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆼𑆟, 𑆠𑆢𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆿 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆪𑆾𑆂, 𑆃𑆠𑆾𑇁𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆿 𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪𑆾𑆂, 𑆃𑆠𑆾𑇁𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆿 𑆖 𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆪𑆾𑆫𑆴𑆠𑆴𑇅 𑆍𑆠𑆁 𑆱𑆩𑇀𑆨𑆳𑆫𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆰𑆳𑆪𑆱𑇀𑆪𑆳𑆫𑇀𑆣𑆳𑆞𑆑𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪, 𑆠𑆠𑇀𑆠𑆽𑆬𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪, 𑆱𑆫𑇀𑆮𑆩𑆳𑆬𑆾𑆝𑇀𑆪, 𑆩𑆲𑆠𑆴 𑆥𑆫𑇀𑆪𑆾𑆓𑆼 𑆱𑆩𑆳𑆱𑆴𑆖𑇀𑆪𑆳𑆓𑇀𑆤𑆳𑆮𑆣𑆴𑆯𑇀𑆫𑆴𑆠𑇀𑆪𑆳𑆱𑆤𑆼 𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆂 𑆱𑆫𑇀𑆮𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆩𑆮𑆬𑆾𑆑𑆪𑆤𑇀𑆤𑆘𑆱𑇀𑆫𑆁 𑆩𑆸𑆢𑇀𑆮𑆓𑇀𑆤𑆴𑆤𑆳 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆢𑆫𑇀𑆮𑇀𑆪𑆳 𑆱𑆠𑆠𑆩𑆮𑆔𑆛𑇀𑆛𑆪𑆤𑇀𑇅 𑆱 𑆪𑆢𑆳 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆩𑆠𑆴 𑆯𑆧𑇀𑆢𑆂, 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑆖 𑆦𑆼𑆤𑆂, 𑆥𑇀𑆫𑆱𑆳𑆢𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆂, 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆖 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂, 𑆱𑆁𑆮𑆫𑇀𑆠𑆠𑆼 𑆖 𑆨𑆽𑆰𑆘𑇀𑆪𑆩𑆕𑇀𑆓𑆶𑆬𑆴𑆨𑇀𑆪𑆳𑆁 𑆩𑆸𑆢𑇀𑆪𑆩𑆳𑆤𑆩𑆤𑆠𑆴𑆩𑆸𑆢𑇀𑆮𑆤𑆠𑆴𑆢𑆳𑆫𑆶𑆟𑆩𑆤𑆕𑇀𑆓𑆶𑆬𑆴𑆓𑇀𑆫𑆳𑆲𑆴 𑆖𑆼𑆠𑆴, 𑆱 𑆑𑆳𑆬𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆮𑆠𑆳𑆫𑆟𑆳𑆪𑇅 𑆠𑆠𑆱𑇀𑆠𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆩𑆲𑆠𑆼𑆤 𑆮𑆳𑆱𑆱𑆳 𑆥𑆫𑆴𑆥𑆷𑆪, 𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑆑𑆬𑆯𑆼 𑆱𑆩𑆳𑆱𑆴𑆖𑇀𑆪, 𑆥𑆴𑆣𑆳𑆤𑆼𑆤 𑆥𑆴𑆣𑆳𑆪, 𑆯𑆶𑆑𑇀𑆬𑆼𑆤 𑆮𑆱𑇀𑆠𑇀𑆫𑆥𑆛𑇀𑆛𑆼𑆤𑆳𑆮𑆖𑇀𑆗𑆳𑆢𑇀𑆪, 𑆱𑆷𑆠𑇀𑆫𑆼𑆟 𑆱𑆶𑆧𑆢𑇀𑆣𑆁 𑆱𑆶𑆤𑆴𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆠𑆠𑆾𑇁𑆱𑇀𑆩𑆽 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀 𑆥𑆳𑆤𑆳𑆪, 𑆠𑆼𑆤 𑆱𑆳𑆣𑆶 𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼; 𑆱𑆩𑇀𑆪𑆓𑆥𑆲𑆸𑆠𑆢𑆾𑆰𑆱𑇀𑆪 𑆖𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆵 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑇅 𑆠𑆠𑆯𑇀𑆖𑆽𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆢𑆤𑆶𑆮𑆳𑆱𑆤𑆑𑆳𑆬𑆼𑇅 𑆍𑆠𑆼𑆤𑆽𑆮 𑆖 𑆥𑆳𑆑𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆑𑆫𑆚𑇀𑆘𑆑𑆾𑆰𑆳𑆠𑆑𑆵𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆶𑆥𑆑𑆬𑇀𑆥𑇀𑆪 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆮𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆂𑇅 𑆠𑆼𑆤𑆳𑆓𑆢𑆾 𑆨𑆮𑆠𑆴𑇆𑇒𑇖𑇆
𑆍𑆮𑆁 𑆢𑇀𑆮𑆪𑆳𑆤𑆳𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆶𑆫𑆵𑆰𑆱𑆩𑇀𑆨𑆮𑆳𑆤𑆳𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆮𑆫𑇀𑆟𑆤𑆳𑆩𑆥𑇀𑆫𑆨𑆳𑆮𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆂𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆱𑇀𑆮𑆬𑇀𑆥𑆩𑆳𑆠𑇀𑆫𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑆲𑆫𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆠𑆼𑆰𑇀𑆮𑆼𑆮𑆿𑆰𑆣𑆼𑆰𑆶 𑆥𑆶𑆫𑆵𑆰𑆘𑆳𑆤𑆳𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁, 𑆩𑆳𑆠𑇀𑆫𑆳𑆣𑆴𑆑𑆁 𑆥𑆶𑆤𑆂 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑆩𑆤𑆾𑆥𑆯𑆩𑆤𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆠𑆼𑆰𑇀𑆮𑆼𑆮𑆿𑆰𑆣𑆼𑆰𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑆳𑆤𑆳𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆑𑆳𑆫𑇀𑆪𑆩𑇀; 𑆅𑆠𑇀𑆪𑆼𑆰 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆾 𑆨𑆼𑆰𑆘𑆮𑆴𑆣𑆴𑆫𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆾 𑆨𑆮𑆠𑆴𑇅 𑆠𑆩𑆤𑆶𑆠𑆴𑆰𑇀𑆜𑆠𑆳 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆲𑆼𑆠𑆶𑆮𑆫𑇀𑆘𑆤𑆼 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆩𑇀𑇅 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆼𑆮𑆩𑆴𑆢𑆁 𑆑𑇀𑆫𑆴𑆩𑆴𑆑𑆾𑆰𑇀𑆜𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆪𑆡𑆳𑆮𑆢𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆨𑆮𑆠𑆴𑇆𑇒𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆥𑆑𑆫𑇀𑆰𑆟𑆩𑆼𑆮𑆳𑆢𑆿 𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆳𑆁 𑆨𑆼𑆰𑆘𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇅 𑆠𑆠𑆾 𑆮𑆴𑆔𑆳𑆠𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆼𑆫𑇀𑆤𑆴𑆢𑆳𑆤𑆱𑇀𑆪 𑆖 𑆮𑆫𑇀𑆘𑆤𑆩𑇀𑇆𑇒𑇘𑇆
𑆃𑆪𑆩𑆼𑆮 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆥𑆴 𑆤𑆴𑆓𑇀𑆫𑆲𑆼𑇅 𑆮𑆴𑆣𑆴𑆫𑇀𑆢𑆸𑆰𑇀𑆛𑆱𑇀𑆠𑇀𑆫𑆴𑆣𑆳 𑆪𑆾𑇁𑆪𑆁 𑆑𑇀𑆫𑆴𑆩𑆵𑆤𑆶𑆢𑇀𑆢𑆴𑆯𑇀𑆪 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂𑇆𑇒𑇙𑇆
𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆱𑆁𑆯𑆩𑆤𑆁 𑆤𑆴𑆢𑆳𑆤𑆱𑇀𑆪 𑆖 𑆮𑆫𑇀𑆘𑆤𑆩𑇀𑇅 𑆍𑆠𑆳𑆮𑆢𑇀𑆨𑆴𑆰𑆘𑆳 𑆑𑆳𑆫𑇀𑆪𑆁 𑆫𑆾𑆓𑆼 𑆫𑆾𑆓𑆼 𑆪𑆡𑆳𑆮𑆴𑆣𑆴𑇆𑇓𑇐𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆿 𑆥𑆶𑆫𑆶𑆰𑆿 𑆘𑇀𑆚𑆳𑆘𑇀𑆚𑆿 𑆨𑆴𑆰𑆘𑆿 𑆱𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆿𑇅 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆑𑇀𑆫𑆴𑆩𑆪𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆲𑆼𑆠𑇀𑆮𑆳𑆢𑆴𑆂 𑆱𑆥𑇀𑆠𑆑𑆾 𑆓𑆟𑆂𑇆𑇓𑇑𑇆
𑆇𑆑𑇀𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆫𑆷𑆥𑆵𑆪𑆼 𑆮𑆴𑆩𑆳𑆤𑆼 𑆥𑆫𑆩𑆫𑇀𑆰𑆴𑆟𑆳𑇅 𑆯𑆴𑆰𑇀𑆪𑆱𑆩𑇀𑆧𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆳𑆪 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪 𑆖𑇆𑇓𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆾𑆓𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆵𑆪𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑆳𑆠𑇀𑆩𑆤𑆂 𑆑𑆳𑆫𑇀𑆪𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆁 𑆑𑆫𑇀𑆩𑆦𑆬𑆩𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆢𑆼𑆯𑆑𑆳𑆬𑆿 𑆖 𑆮𑆴𑆢𑆴𑆠𑇀𑆮𑆳 𑆪𑆶𑆑𑇀𑆠𑆴𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆧𑆶𑆨𑆷𑆰𑆶𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆼𑆮𑆳𑆢𑆴𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠𑇅 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑆴 𑆲𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆨𑆴𑆰𑆘𑆳𑆁 𑆥𑇀𑆫𑆖𑆫𑆤𑇀𑆠𑆴 𑆬𑆾𑆑𑆼; 𑆠𑆠𑇀𑆫 𑆪𑆤𑇀𑆩𑆤𑇀𑆪𑆼𑆠 𑆱𑆶𑆩𑆲𑆢𑇀𑆪𑆯𑆱𑇀𑆮𑆴𑆣𑆵𑆫𑆥𑆶𑆫𑆶𑆰𑆳𑆱𑆼𑆮𑆴𑆠𑆩𑆫𑇀𑆡𑆧𑆲𑆶𑆬𑆩𑆳𑆥𑇀𑆠𑆘𑆤𑆥𑆷𑆘𑆴𑆠𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆯𑆴𑆰𑇀𑆪𑆧𑆶𑆢𑇀𑆣𑆴𑆲𑆴𑆠𑆩𑆥𑆓𑆠𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆢𑆾𑆰𑆩𑆳𑆫𑇀𑆰𑆁 𑆱𑆶𑆥𑇀𑆫𑆟𑆵𑆠𑆱𑆷𑆠𑇀𑆫𑆨𑆳𑆰𑇀𑆪𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆑𑇀𑆫𑆩𑆁 𑆱𑇀𑆮𑆳𑆣𑆳𑆫𑆩𑆤𑆮𑆥𑆠𑆴𑆠𑆯𑆧𑇀𑆢𑆩𑆑𑆰𑇀𑆛𑆯𑆧𑇀𑆢𑆁 𑆥𑆶𑆰𑇀𑆑𑆬𑆳𑆨𑆴𑆣𑆳𑆤𑆁 𑆑𑇀𑆫𑆩𑆳𑆓𑆠𑆳𑆫𑇀𑆡𑆩𑆫𑇀𑆡𑆠𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆱𑆕𑇀𑆓𑆠𑆳𑆫𑇀𑆡𑆩𑆱𑆕𑇀𑆑𑆶𑆬𑆥𑇀𑆫𑆑𑆫𑆟𑆩𑆳𑆯𑆶𑆥𑇀𑆫𑆧𑆾𑆣𑆑𑆁 𑆬𑆑𑇀𑆰𑆟𑆮𑆖𑇀𑆖𑆾𑆢𑆳𑆲𑆫𑆟𑆮𑆖𑇀𑆖, 𑆠𑆢𑆨𑆴𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆼𑆠 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑇀𑇅 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆁 𑆲𑇀𑆪𑆼𑆮𑆁𑆮𑆴𑆣𑆩𑆩𑆬 𑆅𑆮𑆳𑆢𑆴𑆠𑇀𑆪𑆱𑇀𑆠𑆩𑆾 𑆮𑆴𑆣𑆷𑆪 𑆥𑇀𑆫𑆑𑆳𑆯𑆪𑆠𑆴 𑆱𑆫𑇀𑆮𑆩𑇀𑇆𑇓𑇆
𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆳𑆖𑆳𑆫𑇀𑆪𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆫𑇀𑆪𑆮𑆢𑆳𑆠𑆯𑇀𑆫𑆶𑆠𑆁 𑆥𑆫𑆴𑆢𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆳𑆟𑆁 𑆢𑆑𑇀𑆰𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆯𑆶𑆖𑆴𑆁 𑆘𑆴𑆠𑆲𑆱𑇀𑆠𑆩𑆶𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆁 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆘𑇀𑆚𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆘𑇀𑆚𑆩𑆤𑆶𑆥𑆱𑇀𑆑𑆸𑆠𑆮𑆴𑆢𑇀𑆪𑆩𑆤𑆲𑆕𑇀𑆑𑆸𑆠𑆩𑆤𑆱𑆷𑆪𑆑𑆩𑆑𑆾𑆥𑆤𑆁 𑆑𑇀𑆬𑆼𑆯𑆑𑇀𑆰𑆩𑆁 𑆯𑆴𑆰𑇀𑆪𑆮𑆠𑇀𑆱𑆬𑆩𑆣𑇀𑆪𑆳𑆥𑆑𑆁 𑆘𑇀𑆚𑆳𑆥𑆤𑆱𑆩𑆫𑇀𑆡𑆁 𑆖𑆼𑆠𑆴𑇅 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾 𑆲𑇀𑆪𑆳𑆖𑆳𑆫𑇀𑆪𑆂 𑆱𑆶𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆠𑆮𑆾 𑆩𑆼𑆔 𑆅𑆮 𑆯𑆱𑇀𑆪𑆓𑆶𑆟𑆽𑆂 𑆱𑆶𑆯𑆴𑆰𑇀𑆪𑆩𑆳𑆯𑆶 𑆮𑆽𑆢𑇀𑆪𑆓𑆶𑆟𑆽𑆂 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆠𑆴𑇆𑇔𑇆
𑆠𑆩𑆶𑆥𑆱𑆸𑆠𑇀𑆪𑆳𑆫𑆴𑆫𑆳𑆣𑆪𑆴𑆰𑆶𑆫𑆶𑆥𑆖𑆫𑆼𑆢𑆓𑇀𑆤𑆴𑆮𑆖𑇀𑆖 𑆢𑆼𑆮𑆮𑆖𑇀𑆖 𑆫𑆳𑆘𑆮𑆖𑇀𑆖 𑆥𑆴𑆠𑆸𑆮𑆖𑇀𑆖 𑆨𑆫𑇀𑆠𑆸𑆮𑆖𑇀𑆖𑆳𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆂𑇅 𑆠𑆠𑆱𑇀𑆠𑆠𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆠𑇀 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆣𑆴𑆓𑆩𑇀𑆪 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆢𑆸𑆞𑆠𑆳𑆪𑆳𑆩𑆨𑆴𑆣𑆳𑆤𑆱𑇀𑆪 𑆱𑆿𑆰𑇀𑆜𑆮𑆼𑇁𑆫𑇀𑆡𑆱𑇀𑆪 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆿 𑆖 𑆨𑆷𑆪𑆾 𑆨𑆷𑆪𑆂 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑆱𑆩𑇀𑆪𑆑𑇀𑇆𑇕𑇆
𑆠𑆠𑇀𑆫𑆾𑆥𑆳𑆪𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆃𑆣𑇀𑆪𑆪𑆤𑆩𑇀, 𑆃𑆣𑇀𑆪𑆳𑆥𑆤𑆁, 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆱𑆩𑇀𑆨𑆳𑆰𑆳 𑆖𑆼𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆂𑇆𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆪𑆩𑆣𑇀𑆪𑆪𑆤𑆮𑆴𑆣𑆴𑆂- 𑆑𑆬𑇀𑆪𑆂 𑆑𑆸𑆠𑆑𑇀𑆰𑆟𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆠𑇀𑆡𑆳𑆪𑆾𑆥𑆮𑇀𑆪𑆷𑆰𑆁 𑆮𑆳 𑆑𑆸𑆠𑇀𑆮𑆳𑇁𑇁𑆮𑆯𑇀𑆪𑆑𑆩𑆶𑆥𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆾𑆢𑆑𑆁 𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆓𑆾𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆖𑆳𑆫𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆤𑆩𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆱𑆩𑆼 𑆯𑆶𑆖𑆿 𑆢𑆼𑆯𑆼 𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆾 𑆩𑆤𑆂𑆥𑆶𑆫𑆂𑆱𑆫𑆳𑆨𑆴𑆫𑇀𑆮𑆳𑆓𑇀𑆨𑆴𑆂𑆱𑆷𑆠𑇀𑆫𑆩𑆤𑆶𑆑𑇀𑆫𑆳𑆩𑆤𑇀 𑆥𑆶𑆤𑆂 𑆥𑆶𑆤𑆫𑆳𑆮𑆫𑇀𑆠𑆪𑆼𑆢𑇀 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑆩𑇀𑆪𑆓𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆫𑇀𑆡𑆠𑆠𑇀𑆠𑇀𑆮𑆁 𑆱𑇀𑆮𑆢𑆾𑆰𑆥𑆫𑆴𑆲𑆳𑆫𑆳𑆫𑇀𑆡𑆁 𑆥𑆫𑆢𑆾𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆫𑇀𑆡𑆁 𑆖; 𑆍𑆮𑆁 𑆩𑆣𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆼𑇁𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆫𑆳𑆠𑇀𑆫𑆿 𑆖 𑆯𑆯𑇀𑆮𑆢𑆥𑆫𑆴𑆲𑆳𑆥𑆪𑆤𑇀𑆤𑆣𑇀𑆪𑆪𑆤𑆩𑆨𑇀𑆪𑆱𑇀𑆪𑆼𑆠𑇀𑇅 𑆅𑆠𑇀𑆪𑆣𑇀𑆪𑆪𑆤𑆮𑆴𑆣𑆴𑆂𑇆𑇗𑇆
𑆃𑆡𑆳𑆣𑇀𑆪𑆳𑆥𑆤𑆮𑆴𑆣𑆴𑆂- 𑆃𑆣𑇀𑆪𑆳𑆥𑆤𑆼 𑆑𑆸𑆠𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆳𑆖𑆳𑆫𑇀𑆪𑆂 𑆯𑆴𑆰𑇀𑆪𑆩𑆼𑆮𑆳𑆢𑆴𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆩𑆳𑆫𑇀𑆪𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆑𑆩𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆟𑆩𑆸𑆘𑆶𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆩𑆶𑆒𑆤𑆳𑆱𑆳𑆮𑆁𑆯𑆁 𑆠𑆤𑆶𑆫𑆑𑇀𑆠𑆮𑆴𑆯𑆢𑆘𑆴𑆲𑇀𑆮𑆩𑆮𑆴𑆑𑆸𑆠𑆢𑆤𑇀𑆠𑆿𑆰𑇀𑆜𑆩𑆩𑆴𑆤𑇀𑆩𑆴𑆤𑆁 𑆣𑆸𑆠𑆴𑆩𑆤𑇀𑆠𑆩𑆤𑆲𑆕𑇀𑆑𑆸𑆠𑆁 𑆩𑆼𑆣𑆳𑆮𑆴𑆤𑆁 𑆮𑆴𑆠𑆫𑇀𑆑𑆱𑇀𑆩𑆸𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆶𑆢𑆳𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆑𑆶𑆬𑆘𑆩𑆡𑆮𑆳 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆮𑆸𑆠𑇀𑆠𑆁 𑆠𑆠𑇀𑆠𑇀𑆮𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆴𑆤𑆩𑆮𑇀𑆪𑆕𑇀𑆓𑆩𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆤𑆴𑆨𑆸𑆠𑆩𑆤𑆶𑆢𑇀𑆣𑆠𑆩𑆫𑇀𑆡𑆠𑆠𑇀𑆠𑇀𑆮𑆨𑆳𑆮𑆑𑆩𑆑𑆾𑆥𑆤𑆩𑆮𑇀𑆪𑆱𑆤𑆴𑆤𑆁 𑆯𑆵𑆬𑆯𑆿𑆖𑆳𑆖𑆳𑆫𑆳𑆤𑆶𑆫𑆳𑆓𑆢𑆳𑆑𑇀𑆰𑇀𑆪𑆥𑇀𑆫𑆳𑆢𑆑𑇀𑆰𑆴𑆟𑇀𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆩𑆣𑇀𑆪𑆪𑆤𑆳𑆨𑆴𑆑𑆳𑆩𑆩𑆫𑇀𑆡𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆑𑆫𑇀𑆩𑆢𑆫𑇀𑆯𑆤𑆼 𑆖𑆳𑆤𑆤𑇀𑆪𑆑𑆳𑆫𑇀𑆪𑆩𑆬𑆶𑆧𑇀𑆣𑆩𑆤𑆬𑆱𑆁 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆲𑆴𑆠𑆽𑆰𑆴𑆟𑆩𑆳𑆖𑆳𑆫𑇀𑆪𑆱𑆫𑇀𑆮𑆳𑆤𑆶𑆯𑆴𑆰𑇀𑆛𑆴𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑆩𑆤𑆶𑆫𑆑𑇀𑆠𑆁 𑆖, 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆱𑆩𑆶𑆢𑆴𑆠𑆩𑆣𑇀𑆪𑆳𑆥𑇀𑆪𑆩𑆳𑆲𑆶𑆂𑇆𑇘𑇆
𑆍𑆮𑆁𑆮𑆴𑆣𑆩𑆣𑇀𑆪𑆪𑆤𑆳𑆫𑇀𑆡𑆴𑆤𑆩𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆩𑆳𑆫𑆴𑆫𑆳𑆣𑆪𑆴𑆰𑆶𑆩𑆳𑆖𑆳𑆫𑇀𑆪𑆾𑇁𑆤𑆶𑆨𑆳𑆰𑆼𑆠 - 𑆇𑆢𑆓𑆪𑆤𑆼 𑆯𑆶𑆑𑇀𑆬𑆥𑆑𑇀𑆰𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼𑇁𑆲𑆤𑆴 𑆠𑆴𑆰𑇀𑆪𑆲𑆱𑇀𑆠𑆯𑇀𑆫𑆮𑆟𑆳𑆯𑇀𑆮𑆪𑆶𑆘𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆟 𑆪𑆾𑆓𑆩𑆶𑆥𑆓𑆠𑆼 𑆨𑆓𑆮𑆠𑆴 𑆯𑆯𑆴𑆤𑆴 𑆑𑆬𑇀𑆪𑆳𑆟𑆼 𑆑𑆬𑇀𑆪𑆳𑆟𑆼 𑆖 𑆑𑆫𑆟𑆼 𑆩𑆽𑆠𑇀𑆫𑆼 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆼 𑆩𑆶𑆟𑇀𑆝𑆂 𑆑𑆸𑆠𑆾𑆥𑆮𑆳𑆱𑆂 𑆱𑇀𑆤𑆳𑆠𑆂 𑆑𑆳𑆰𑆳𑆪𑆮𑆱𑇀𑆠𑇀𑆫𑆱𑆁𑆮𑆵𑆠𑆂 𑆱𑆓𑆤𑇀𑆣𑆲𑆱𑇀𑆠𑆂 𑆱𑆩𑆴𑆣𑆾𑇁𑆓𑇀𑆤𑆴𑆩𑆳𑆘𑇀𑆪𑆩𑆶𑆥𑆬𑆼𑆥𑆤𑆩𑆶𑆢𑆑𑆶𑆩𑇀𑆨𑆳𑆤𑇀 𑆩𑆳𑆬𑇀𑆪𑆢𑆳𑆩𑆢𑆵𑆥𑆲𑆴𑆫𑆟𑇀𑆪𑆲𑆼𑆩𑆫𑆘𑆠𑆩𑆟𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆑𑇀𑆰𑆿𑆩𑆥𑆫𑆴𑆣𑆵𑆤𑇀 𑆑𑆶𑆯𑆬𑆳𑆘𑆱𑆫𑇀𑆰𑆥𑆳𑆑𑇀𑆰𑆠𑆳𑆁𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆬𑆳𑆤𑆴 𑆱𑆶𑆩𑆤𑆳𑆁𑆱𑆴 𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆤𑆴 𑆩𑆼𑆣𑇀𑆪𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀 𑆓𑆤𑇀𑆣𑆳𑆁𑆯𑇀𑆖 𑆔𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆢𑆳𑆪𑆾𑆥𑆠𑆴𑆰𑇀𑆜𑆱𑇀𑆮𑆼𑆠𑆴𑇆𑇙𑇆
𑆱 𑆠𑆡𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇐𑇆
𑆠𑆩𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆩𑆳𑆘𑇀𑆚𑆳𑆪 𑆱𑆩𑆼 𑆯𑆶𑆖𑆿 𑆢𑆼𑆯𑆼 𑆥𑇀𑆫𑆳𑆑𑇀𑆥𑇀𑆫𑆮𑆟𑆼 𑆇𑆢𑆑𑇀𑆥𑇀𑆫𑆮𑆟𑆼 𑆮𑆳 𑆖𑆠𑆶𑆰𑇀𑆑𑆴𑆰𑇀𑆑𑆶𑆩𑆳𑆠𑇀𑆫𑆁 𑆖𑆠𑆶𑆫𑆱𑇀𑆫𑆁 𑆱𑇀𑆡𑆟𑇀𑆝𑆴𑆬𑆁 𑆓𑆾𑆩𑆪𑆾𑆢𑆑𑆼𑆤𑆾𑆥𑆬𑆴𑆥𑇀𑆠𑆁 𑆑𑆶𑆯𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆁 𑆱𑆶𑆥𑆫𑆴𑆲𑆴𑆠𑆁 𑆥𑆫𑆴𑆣𑆴𑆨𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆢𑆴𑆯𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆖𑆤𑇀𑆢𑆤𑆾𑆢𑆑𑆶𑆩𑇀𑆨𑆑𑇀𑆰𑆿𑆩𑆲𑆼𑆩𑆲𑆴𑆫𑆟𑇀𑆪𑆫𑆘𑆠𑆩𑆟𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆳𑆬𑆕𑇀𑆑𑆸𑆠𑆁 𑆩𑆼𑆣𑇀𑆪𑆨𑆑𑇀𑆰𑇀𑆪𑆓𑆤𑇀𑆣𑆯𑆶𑆑𑇀𑆬𑆥𑆶𑆰𑇀𑆥𑆬𑆳𑆘𑆱𑆫𑇀𑆰𑆥𑆳𑆑𑇀𑆰𑆠𑆾𑆥𑆯𑆾𑆨𑆴𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳, 𑆠𑆠𑇀𑆫 𑆥𑆳𑆬𑆳𑆯𑆵𑆨𑆴𑆫𑆽𑆕𑇀𑆓𑆶𑆢𑆵𑆨𑆴𑆫𑆿𑆢𑆶𑆩𑇀𑆧𑆫𑆵𑆨𑆴𑆫𑇀𑆩𑆳𑆣𑆶𑆑𑆵𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆩𑆴𑆢𑇀𑆨𑆴𑆫𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆱𑆩𑆳𑆣𑆳𑆪 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆶𑆒𑆂 𑆯𑆶𑆖𑆴𑆫𑆣𑇀𑆪𑆪𑆤𑆮𑆴𑆣𑆴𑆩𑆤𑆶𑆮𑆴𑆣𑆳𑆪 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆠𑇀𑆫𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆫𑇀𑆘𑆶𑆲𑆶𑆪𑆳𑆢𑆓𑇀𑆤𑆴𑆩𑆳𑆯𑆵𑆂𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆫𑇀𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆟𑆩𑆓𑇀𑆤𑆴𑆁 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆁 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆩𑆯𑇀𑆮𑆴𑆤𑆳𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆩𑆸𑆰𑆵𑆁𑆯𑇀𑆖 𑆱𑆷𑆠𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑆨𑆴𑆩𑆤𑇀𑆠𑇀𑆫𑆪𑆩𑆳𑆟𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆮𑆳𑆲𑆼𑆠𑆴𑇆𑇑𑇑𑇆
𑆯𑆴𑆰𑇀𑆪𑆯𑇀𑆖𑆽𑆤𑆩𑆤𑇀𑆮𑆳𑆬𑆨𑆼𑆠𑇅 𑆲𑆶𑆠𑇀𑆮𑆳 𑆖 𑆥𑇀𑆫𑆢𑆑𑇀𑆰𑆴𑆟𑆩𑆓𑇀𑆤𑆴𑆩𑆤𑆶𑆥𑆫𑆴𑆑𑇀𑆫𑆳𑆩𑆼𑆠𑇀𑇅 𑆥𑆫𑆴𑆑𑇀𑆫𑆩𑇀𑆪 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆤𑇀 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆮𑆳𑆖𑆪𑆼𑆠𑇀; 𑆨𑆴𑆰𑆘𑆯𑇀𑆖𑆳𑆨𑆴𑆥𑆷𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇒𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆴𑆠𑆫𑆼𑆟 𑆱𑆲 𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆱𑆩𑇀𑆨𑆳𑆰𑆳𑆪𑆳𑆁 𑆘𑆬𑇀𑆥𑆼𑆖𑇀𑆗𑇀𑆫𑆼𑆪𑆱𑆳 𑆪𑆾𑆓𑆩𑆳𑆠𑇀𑆩𑆤𑆂 𑆥𑆯𑇀𑆪𑆤𑇀𑇅 𑆥𑇀𑆫𑆳𑆓𑆼𑆮 𑆖 𑆘𑆬𑇀𑆥𑆳𑆘𑇀𑆘𑆬𑇀𑆥𑆳𑆤𑇀𑆠𑆫𑆁 𑆥𑆫𑆳𑆮𑆫𑆳𑆤𑇀𑆠𑆫𑆁 𑆥𑆫𑆴𑆰𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆳𑆁𑆯𑇀𑆖 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠𑇅 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆲𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆁 𑆑𑆳𑆫𑇀𑆪𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆳𑆬𑆿 𑆯𑆁𑆱𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆩𑆨𑆴𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑆩𑆳𑆟𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑆫𑆳𑆮𑆫𑆳𑆤𑇀𑆠𑆫𑆩𑆴𑆩𑆳𑆤𑇀 𑆘𑆬𑇀𑆥𑆑𑆓𑆶𑆟𑆳𑆚𑇀 𑆯𑇀𑆫𑆼𑆪𑆱𑇀𑆑𑆫𑆳𑆤𑇀𑆢𑆾𑆰𑆮𑆠𑆯𑇀𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆱𑆩𑇀𑆪𑆑𑇀; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆫𑆶𑆠𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆣𑆳𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑆴𑆨𑆳𑆤𑆁 𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆴𑆫𑆴𑆠𑆴, 𑆍𑆠𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑇀 𑆯𑇀𑆫𑆼𑆪𑆱𑇀𑆑𑆫𑆳𑆤𑆳𑆲𑆶𑆂; 𑆅𑆩𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆢𑆾𑆰𑆮𑆠𑆂, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆾𑆥𑆤𑆠𑇀𑆮𑆩𑆮𑆽𑆯𑆳𑆫𑆢𑇀𑆪𑆁 𑆨𑆵𑆫𑆶𑆠𑇀𑆮𑆩𑆣𑆳𑆫𑆟𑆠𑇀𑆮𑆩𑆤𑆮𑆲𑆴𑆠𑆠𑇀𑆮𑆩𑆴𑆠𑆴𑇅 𑆍𑆠𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑇀 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆠𑆂 𑆥𑆫𑆱𑇀𑆪 𑆖𑆽𑆮𑆳𑆠𑇀𑆩𑆤𑆯𑇀𑆖 𑆠𑆶𑆬𑆪𑆼𑆠𑇀𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂 𑆥𑆫𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼- 𑆥𑇀𑆫𑆮𑆫𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆫𑆂, 𑆱𑆩𑆾 𑆮𑆳, 𑆓𑆶𑆟𑆮𑆴𑆤𑆴𑆑𑇀𑆰𑆼𑆥𑆠𑆂; 𑆤𑆠𑇀𑆮𑆼𑆮 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤𑇆𑇑𑇙𑇆
𑆥𑆫𑆴𑆰𑆠𑇀𑆠𑆶 𑆒𑆬𑆶 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳- 𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆵, 𑆩𑆷𑆞𑆥𑆫𑆴𑆰𑆖𑇀𑆖𑇅 𑆱𑆽𑆮 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆱𑆠𑆵 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆥𑆶𑆤𑆫𑆤𑆼𑆤 𑆑𑆳𑆫𑆟𑆮𑆴𑆨𑆳𑆓𑆼𑆤- 𑆱𑆶𑆲𑆸𑆠𑇀𑆥𑆫𑆴𑆰𑆠𑇀, 𑆇𑆢𑆳𑆱𑆵𑆤𑆥𑆫𑆴𑆰𑆠𑇀, 𑆥𑇀𑆫𑆠𑆴𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆥𑆫𑆴𑆰𑆖𑇀𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆠𑆴𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆳𑆪𑆳𑆁 𑆥𑆫𑆴𑆰𑆢𑆴 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆖𑆤𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆩𑆷𑆞𑆳𑆪𑆳𑆁 𑆮𑆳 𑆤 𑆑𑆡𑆁 𑆖𑆴𑆠𑇀 𑆑𑆼𑆤𑆖𑆴𑆠𑇀 𑆱𑆲 𑆘𑆬𑇀𑆥𑆾 𑆮𑆴𑆣𑆵𑆪𑆠𑆼; 𑆩𑆷𑆞𑆳𑆪𑆳𑆁 𑆠𑆶 𑆱𑆶𑆲𑆸𑆠𑇀𑆥𑆫𑆴𑆰𑆢𑇀𑆪𑆶𑆢𑆳𑆱𑆵𑆤𑆳𑆪𑆳𑆁 𑆮𑆳 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆖𑆤𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆵𑆫𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆥𑇀𑆪𑆢𑆵𑆥𑇀𑆠𑆪𑆯𑆱𑆳 𑆩𑆲𑆳𑆘𑆤𑆮𑆴𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆼𑆤𑆳𑆥𑆴 𑆱𑆲 𑆘𑆬𑇀𑆥𑆾 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆠𑆢𑇀𑆮𑆴𑆣𑆼𑆤 𑆖 𑆱𑆲 𑆑𑆡𑆪𑆠𑆳 𑆄𑆮𑆴𑆢𑇀𑆣𑆢𑆵𑆫𑇀𑆔𑆱𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆑𑆶𑆬𑆽𑆫𑇀𑆮𑆳𑆑𑇀𑆪𑆢𑆟𑇀𑆝𑆑𑆽𑆂 𑆑𑆡𑆪𑆴𑆠𑆮𑇀𑆪𑆩𑇀, 𑆃𑆠𑆴𑆲𑆸𑆰𑇀𑆛𑆁 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑆶𑆥𑆲𑆱𑆠𑆳 𑆥𑆫𑆁 𑆤𑆴𑆫𑆷𑆥𑆪𑆠𑆳 𑆖 𑆥𑆫𑇀𑆰𑆢𑆩𑆳𑆑𑆳𑆫𑆽𑆫𑇀𑆧𑇀𑆫𑆶𑆮𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆳𑆑𑇀𑆪𑆳𑆮𑆑𑆳𑆯𑆾 𑆤 𑆢𑆼𑆪𑆂; 𑆑𑆰𑇀𑆛𑆯𑆧𑇀𑆢𑆁 𑆖 𑆧𑇀𑆫𑆶𑆮𑆠𑆳 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆾 𑆤𑆾𑆖𑇀𑆪𑆠𑆼, 𑆃𑆡𑆮𑆳 𑆥𑆶𑆤𑆫𑇀𑆲𑆵𑆤𑆳 𑆠𑆼 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳, 𑆅𑆠𑆴𑇅 𑆥𑆶𑆤𑆯𑇀𑆖𑆳𑆲𑆷(𑆲𑇀𑆮)𑆪𑆩𑆳𑆤𑆂 𑆥𑇀𑆫𑆠𑆴𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆂- 𑆥𑆫𑆴𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆾 𑆨𑆮𑆳𑆤𑇀 𑆯𑆴𑆑𑇀𑆰𑆱𑇀𑆮 𑆠𑆳𑆮𑆠𑇀; 𑆤 𑆠𑇀𑆮𑆪𑆳 𑆓𑆶𑆫𑆶𑆫𑆶𑆥𑆳𑆱𑆴𑆠𑆾 𑆤𑆷𑆤𑆩𑇀, 𑆃𑆡𑆮𑆳 𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆩𑆼𑆠𑆳𑆮𑆠𑇀𑆠𑆼; 𑆱𑆑𑆸𑆢𑆥𑆴 𑆲𑆴 𑆥𑆫𑆴𑆑𑇀𑆰𑆼𑆥𑆴𑆑𑆁 𑆤𑆴𑆲𑆠𑆁 𑆤𑆴𑆲𑆠𑆩𑆳𑆲𑆶𑆫𑆴𑆠𑆴 𑆤𑆳𑆱𑇀𑆪 𑆪𑆾𑆓𑆂 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆂 𑆑𑆡𑆚𑇀𑆖𑆴𑆠𑇀𑇅 𑆃𑆥𑇀𑆪𑆼𑆮𑆁 𑆯𑇀𑆫𑆼𑆪𑆱𑆳 𑆱𑆲 𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆼𑆑𑆼; 𑆤𑆠𑇀𑆮𑆼𑆮𑆁 𑆘𑇀𑆪𑆳𑆪𑆱𑆳 𑆱𑆲 𑆮𑆴𑆓𑇀𑆫𑆲𑆁 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇆𑇒𑇐𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆫𑆼𑆟 𑆠𑆶 𑆱𑆲 𑆱𑆩𑆳𑆤𑆳𑆨𑆴𑆩𑆠𑆼𑆤 𑆮𑆳 𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆘𑆬𑇀𑆥𑆠𑆳 𑆱𑆶𑆲𑆸𑆠𑇀𑆥𑆫𑆴𑆰𑆢𑆴 𑆑𑆡𑆪𑆴𑆠𑆮𑇀𑆪𑆩𑇀, 𑆃𑆡𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆢𑆳𑆱𑆵𑆤𑆥𑆫𑆴𑆰𑆢𑇀𑆪𑆮𑆣𑆳𑆤𑆯𑇀𑆫𑆮𑆟𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆾𑆥𑆣𑆳𑆫𑆟𑆮𑆖𑆤𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆑𑆡𑆪𑆠𑆳 𑆖𑆳𑆮𑆲𑆴𑆠𑆼𑆤 𑆥𑆫𑆱𑇀𑆪 𑆱𑆳𑆢𑇀𑆓𑆶𑆟𑇀𑆪𑆢𑆾𑆰𑆧𑆬𑆩𑆮𑆼𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆁, 𑆱𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆖 𑆪𑆠𑇀𑆫𑆽𑆤𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆩𑆤𑇀𑆪𑆼𑆠 𑆤𑆳𑆱𑇀𑆪 𑆠𑆠𑇀𑆫 𑆘𑆬𑇀𑆥𑆁 𑆪𑆾𑆘𑆪𑆼𑆢𑆤𑆳𑆮𑆴𑆰𑇀𑆑𑆸𑆠𑆩𑆪𑆾𑆓𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀; 𑆪𑆠𑇀𑆫 𑆠𑇀𑆮𑆼𑆤𑆩𑆮𑆫𑆁 𑆩𑆤𑇀𑆪𑆼𑆠 𑆠𑆠𑇀𑆫𑆽𑆮𑆽𑆤𑆩𑆳𑆯𑆶 𑆤𑆴𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫 𑆒𑆬𑇀𑆮𑆴𑆩𑆼 𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆫𑆳𑆟𑆳𑆩𑆳𑆯𑆶 𑆤𑆴𑆓𑇀𑆫𑆲𑆼 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆫𑆶𑆠𑆲𑆵𑆤𑆁 𑆩𑆲𑆠𑆳 𑆱𑆷𑆠𑇀𑆫𑆥𑆳𑆜𑆼𑆤𑆳𑆨𑆴𑆨𑆮𑆼𑆠𑇀, 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆵𑆤𑆁 𑆥𑆶𑆤𑆂 𑆑𑆰𑇀𑆛𑆯𑆧𑇀𑆢𑆼𑆤 𑆮𑆳𑆑𑇀𑆪𑆼𑆤, 𑆮𑆳𑆑𑇀𑆪𑆣𑆳𑆫𑆟𑆳𑆲𑆵𑆤𑆩𑆳𑆮𑆴𑆢𑇀𑆣𑆢𑆵𑆫𑇀𑆔𑆱𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆑𑆶𑆬𑆽𑆫𑇀𑆮𑆳𑆑𑇀𑆪𑆢𑆟𑇀𑆝𑆑𑆽𑆂, 𑆥𑇀𑆫𑆠𑆴𑆨𑆳𑆲𑆵𑆤𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆖𑆤𑆼𑆤𑆽𑆑𑆮𑆴𑆣𑆼𑆤𑆳𑆤𑆼𑆑𑆳𑆫𑇀𑆡𑆮𑆳𑆖𑆴𑆤𑆳 , 𑆮𑆖𑆤𑆯𑆑𑇀𑆠𑆴𑆲𑆵𑆤𑆩𑆫𑇀𑆣𑆾𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆳𑆑𑇀𑆪𑆱𑇀𑆪𑆳𑆑𑇀𑆰𑆼𑆥𑆼𑆟 , 𑆃𑆮𑆴𑆯𑆳𑆫𑆢𑆩𑆥𑆠𑇀𑆫𑆥𑆟𑆼𑆤, 𑆑𑆾𑆥𑆤𑆩𑆳𑆪𑆳𑆱𑆤𑆼𑆤, 𑆨𑆵𑆫𑆶𑆁 𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆼𑆤, 𑆃𑆤𑆮𑆲𑆴𑆠𑆁 𑆤𑆴𑆪𑆩𑆤𑆼𑆤𑆼𑆠𑆴𑇅 𑆍𑆮𑆩𑆼𑆠𑆽𑆫𑆶𑆥𑆳𑆪𑆽𑆂 𑆥𑆫𑆩𑆮𑆫𑆩𑆨𑆴𑆨𑆮𑆼𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆩𑇀𑇆𑇒𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆑𑆡𑆪𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆪𑆶𑆑𑇀𑆠𑆁 𑆖 𑆤 𑆤𑆴𑆮𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆮𑆴𑆓𑆸𑆲𑇀𑆪𑆨𑆳𑆰𑆳 𑆠𑆵𑆮𑇀𑆫𑆁 𑆲𑆴 𑆑𑆼𑆰𑆳𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆫𑆾𑆲𑆩𑆳𑆮𑆲𑆼𑆠𑇀𑇆𑇒𑇒𑇆
𑆤𑆳𑆑𑆳𑆫𑇀𑆪𑆩𑆱𑇀𑆠𑆴 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆤𑆳𑆮𑆳𑆖𑇀𑆪𑆩𑆥𑆴 𑆮𑆴𑆢𑇀𑆪𑆠𑆼𑇅 𑆑𑆶𑆯𑆬𑆳 𑆤𑆳𑆨𑆴𑆤𑆤𑇀𑆢𑆤𑇀𑆠𑆴 𑆑𑆬𑆲𑆁 𑆱𑆩𑆴𑆠𑆿 𑆱𑆠𑆳𑆩𑇀𑇆𑇒𑇓𑇆
𑆍𑆮𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆼 𑆮𑆳𑆢𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇔𑇆
𑆥𑇀𑆫𑆳𑆓𑆼𑆮 𑆠𑆳𑆮𑆢𑆴𑆢𑆁 𑆑𑆫𑇀𑆠𑆶𑆁 𑆪𑆠𑆼𑆠- 𑆱𑆤𑇀𑆣𑆳𑆪 𑆥𑆫𑇀𑆰𑆢𑆳𑇁𑆪𑆤𑆨𑆷𑆠𑆩𑆳𑆠𑇀𑆩𑆤𑆂 𑆥𑇀𑆫𑆑𑆫𑆟𑆩𑆳𑆢𑆼𑆯𑆪𑆴𑆠𑆮𑇀𑆪𑆁, 𑆪𑆢𑇀𑆮𑆳 𑆥𑆫𑆱𑇀𑆪 𑆨𑆸𑆯𑆢𑆶𑆫𑇀𑆓𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆥𑆑𑇀𑆰𑆩𑆡𑆮𑆳 𑆥𑆫𑆱𑇀𑆪 𑆨𑆸𑆯𑆁 𑆮𑆴𑆩𑆶𑆒𑆩𑆳𑆤𑆪𑆼𑆠𑇀; 𑆥𑆫𑆴𑆰𑆢𑆴 𑆖𑆾𑆥𑆱𑆁𑆲𑆴𑆠𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆪𑆩𑆱𑇀𑆩𑆳𑆨𑆴𑆫𑇀𑆮𑆑𑇀𑆠𑆶𑆩𑇀, 𑆍𑆰𑆽𑆮 𑆠𑆼 𑆥𑆫𑆴𑆰𑆢𑇀𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆪𑆡𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆁 𑆮𑆳𑆢𑆁 𑆮𑆳𑆢𑆩𑆫𑇀𑆪𑆳𑆢𑆳𑆁 𑆖 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆠𑆷𑆰𑇀𑆟𑆵𑆩𑆳𑆱𑆵𑆠𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫𑆼𑆢𑆁 𑆮𑆳𑆢𑆩𑆫𑇀𑆪𑆳𑆢𑆳𑆬𑆑𑇀𑆰𑆟𑆁 𑆨𑆮𑆠𑆴- 𑆅𑆢𑆁 𑆮𑆳𑆖𑇀𑆪𑆩𑇀, 𑆅𑆢𑆩𑆮𑆳𑆖𑇀𑆪𑆩𑇀, 𑆍𑆮𑆁 𑆥𑆫𑆳𑆘𑆴𑆠𑆾 𑆨𑆮𑆠𑆵𑆠𑆴𑇆𑇒𑇖𑇆
𑆅𑆩𑆳𑆤𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆥𑆢𑆳𑆤𑆴 𑆨𑆴𑆰𑆓𑇀𑆮𑆳𑆢𑆩𑆳𑆫𑇀𑆓𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆣𑆴𑆓𑆩𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆢𑆂, 𑆢𑇀𑆫𑆮𑇀𑆪𑆁, 𑆓𑆶𑆟𑆳𑆂, 𑆑𑆫𑇀𑆩, 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁, 𑆮𑆴𑆯𑆼𑆰𑆂, 𑆱𑆩𑆮𑆳𑆪𑆂, 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳, 𑆱𑇀𑆡𑆳𑆥𑆤𑆳, 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆥𑆤𑆳, 𑆲𑆼𑆠𑆶𑆂, 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆂, 𑆇𑆥𑆤𑆪𑆂, 𑆤𑆴𑆓𑆩𑆤𑆩𑇀, 𑆇𑆠𑇀𑆠𑆫𑆁, 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂, 𑆯𑆧𑇀𑆢𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆩𑇀, 𑆎𑆠𑆴𑆲𑇀𑆪𑆩𑇀, 𑆐𑆥𑆩𑇀𑆪𑆁, 𑆱𑆁𑆯𑆪𑆂, 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁, 𑆱𑆮𑇀𑆪𑆨𑆴𑆖𑆳𑆫𑆁, 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳, 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆂, 𑆃𑆫𑇀𑆡𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂, 𑆱𑆩𑇀𑆨𑆮𑆂, 𑆃𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆩𑇀, 𑆃𑆤𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆩𑇀, 𑆃𑆤𑆶𑆪𑆾𑆓𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆶𑆪𑆾𑆓𑆂, 𑆮𑆳𑆑𑇀𑆪𑆢𑆾𑆰𑆂, 𑆮𑆳𑆑𑇀𑆪𑆥𑇀𑆫𑆯𑆁𑆱𑆳, 𑆗𑆬𑆩𑇀, 𑆃𑆲𑆼𑆠𑆶𑆂, 𑆃𑆠𑆵𑆠𑆑𑆳𑆬𑆩𑇀, 𑆇𑆥𑆳𑆬𑆩𑇀𑆨𑆂, 𑆥𑆫𑆴𑆲𑆳𑆫𑆂, 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆲𑆳𑆤𑆴𑆂, 𑆃𑆨𑇀𑆪𑆤𑆶𑆘𑇀𑆚𑆳, 𑆲𑆼𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆩𑇀, 𑆃𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆁, 𑆤𑆴𑆓𑇀𑆫𑆲𑆱𑇀𑆡𑆳𑆤𑆩𑆴𑆠𑆴𑇆𑇒𑇗𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆢𑆾 𑆤𑆳𑆩 𑆱 𑆪𑆠𑇀 𑆥𑆫𑆼𑆟 𑆱𑆲 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆥𑆷𑆫𑇀𑆮𑆑𑆁 𑆮𑆴𑆓𑆸𑆲𑇀𑆪 𑆑𑆡𑆪𑆠𑆴𑇅 𑆱 𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟- 𑆘𑆬𑇀𑆥𑆂, 𑆮𑆴𑆠𑆟𑇀𑆝𑆳 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆥𑆑𑇀𑆰𑆳𑆯𑇀𑆫𑆴𑆠𑆪𑆾𑆫𑇀𑆮𑆖𑆤𑆁 𑆘𑆬𑇀𑆥𑆂, 𑆘𑆬𑇀𑆥𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆾 𑆮𑆴𑆠𑆟𑇀𑆝𑆳𑇅 𑆪𑆡𑆳- 𑆍𑆑𑆱𑇀𑆪 𑆥𑆑𑇀𑆰𑆂 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆾𑇁𑆱𑇀𑆠𑆵𑆠𑆴, 𑆤𑆳𑆱𑇀𑆠𑆵𑆠𑇀𑆪𑆥𑆫𑆱𑇀𑆪; 𑆠𑆿 𑆖 𑆱𑇀𑆮𑆱𑇀𑆮𑆥𑆑𑇀𑆰𑆲𑆼𑆠𑆶𑆨𑆴𑆂 𑆱𑇀𑆮𑆱𑇀𑆮𑆥𑆑𑇀𑆰𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆠𑆂, 𑆥𑆫𑆥𑆑𑇀𑆰𑆩𑆶𑆢𑇀𑆨𑆳𑆮𑆪𑆠𑆂, 𑆍𑆰 𑆘𑆬𑇀𑆥𑆂𑇅 𑆘𑆬𑇀𑆥𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆾 𑆮𑆴𑆠𑆟𑇀𑆝𑆳𑇅 𑆮𑆴𑆠𑆟𑇀𑆝𑆳 𑆤𑆳𑆩 𑆥𑆫𑆥𑆑𑇀𑆰𑆼 𑆢𑆾𑆰𑆮𑆖𑆤𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆮𑇆𑇒𑇘𑇆
𑆢𑇀𑆫𑆮𑇀𑆪-𑆓𑆶𑆟-𑆑𑆫𑇀𑆩-𑆱𑆳𑆩𑆳𑆤𑇀𑆪-𑆮𑆴𑆯𑆼𑆰-𑆱𑆩𑆮𑆳𑆪𑆳𑆂 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆽𑆂 𑆯𑇀𑆬𑆾𑆑𑆱𑇀𑆡𑆳𑆤𑆼 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆳𑆂𑇆𑇒𑇙𑇆
𑆃𑆡 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳- 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳 𑆤𑆳𑆩 𑆱𑆳𑆣𑇀𑆪𑆮𑆖𑆤𑆁; 𑆪𑆡𑆳- 𑆤𑆴𑆠𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑆴𑇆𑇓𑇐𑇆
𑆃𑆡 𑆱𑇀𑆡𑆳𑆥𑆤𑆳- 𑆱𑇀𑆡𑆳𑆥𑆤𑆳 𑆤𑆳𑆩 𑆠𑆱𑇀𑆪𑆳 𑆍𑆮 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆪𑆳 𑆲𑆼𑆠𑆶𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆾𑆥𑆤𑆪𑆤𑆴𑆓𑆩𑆤𑆽𑆂 𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑇅 𑆥𑆷𑆫𑇀𑆮𑆁 𑆲𑆴 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳, 𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆱𑇀𑆡𑆳𑆥𑆤𑆳, 𑆑𑆴𑆁 𑆲𑇀𑆪𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆰𑇀𑆪𑆠𑆴; 𑆪𑆡𑆳- 𑆤𑆴𑆠𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑆴 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳; 𑆲𑆼𑆠𑆶𑆂- 𑆃𑆑𑆸𑆠𑆑𑆠𑇀𑆮𑆳𑆢𑆴𑆠𑆴; 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆂 - 𑆪𑆡𑆳𑇁𑇁𑆑𑆳𑆯𑆩𑆴𑆠𑆴; 𑆇𑆥𑆤𑆪𑆂- 𑆪𑆡𑆳 𑆖𑆳𑆑𑆸𑆠𑆑𑆩𑆳𑆑𑆳𑆯𑆁, 𑆠𑆖𑇀𑆖 𑆤𑆴𑆠𑇀𑆪𑆁, 𑆠𑆡𑆳 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑆴; 𑆤𑆴𑆓𑆩𑆤𑆁- 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆠𑇀𑆪 𑆅𑆠𑆴𑇆𑇓𑇑𑇆
𑆃𑆡 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆥𑆤𑆳- 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆥𑆤𑆳 𑆤𑆳𑆩 𑆪𑆳 𑆠𑆱𑇀𑆪𑆳 𑆍𑆮 𑆥𑆫𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆪𑆳 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆫𑇀𑆡𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑇅 𑆪𑆡𑆳- 𑆃𑆤𑆴𑆠𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑆴 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳 ; 𑆲𑆼𑆠𑆶𑆂- 𑆎𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆑𑆠𑇀𑆮𑆳𑆢𑆴𑆠𑆴; 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆂- 𑆪𑆡𑆳 𑆔𑆛 𑆅𑆠𑆴, 𑆇𑆥𑆤𑆪𑆾- 𑆪𑆡𑆳 𑆔𑆛 𑆎𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆑𑆂 𑆱 𑆖𑆳𑆤𑆴𑆠𑇀𑆪𑆂, 𑆠𑆡𑆳 𑆖𑆳𑆪𑆩𑆴𑆠𑆴; 𑆤𑆴𑆓𑆩𑆤𑆁- 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑆴𑆠𑇀𑆪 𑆅𑆠𑆴𑇆𑇓𑇒𑇆
𑆃𑆡 𑆲𑆼𑆠𑆶𑆂- 𑆲𑆼𑆠𑆶𑆫𑇀𑆤𑆳𑆩𑆾𑆥𑆬𑆧𑇀𑆣𑆴𑆑𑆳𑆫𑆟𑆁; 𑆠𑆠𑇀 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆩𑇀, 𑆎𑆠𑆴𑆲𑇀𑆪𑆩𑇀, 𑆐𑆥𑆩𑇀𑆪𑆩𑆴𑆠𑆴; 𑆍𑆨𑆴𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆪𑆢𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼 𑆠𑆠𑇀 𑆠𑆠𑇀𑆠𑇀𑆮𑆩𑇀𑇆𑇓𑇓𑇆
𑆃𑆡 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆂- 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆪𑆠𑇀𑆫 𑆩𑆷𑆫𑇀𑆒𑆮𑆴𑆢𑆶𑆰𑆳𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆱𑆳𑆩𑇀𑆪𑆁, 𑆪𑆾 𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆮𑆫𑇀𑆟𑆪𑆠𑆴 𑇅 𑆪𑆡𑆳- 𑆃𑆓𑇀𑆤𑆴𑆫𑆶𑆰𑇀𑆟𑆂, 𑆢𑇀𑆫𑆮𑆩𑆶𑆢𑆑𑆁, 𑆱𑇀𑆡𑆴𑆫𑆳 𑆥𑆸𑆡𑆴𑆮𑆵, 𑆄𑆢𑆴𑆠𑇀𑆪𑆂 𑆥𑇀𑆫𑆑𑆳𑆯𑆑 𑆅𑆠𑆴; 𑆪𑆡𑆳 𑆄𑆢𑆴𑆠𑇀𑆪𑆂 𑆥𑇀𑆫𑆑𑆳𑆯𑆑𑆱𑇀𑆠𑆡𑆳 𑆱𑆳𑆕𑇀𑆒𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆁 𑆥𑇀𑆫𑆑𑆳𑆯𑆑𑆩𑆴𑆠𑆴𑇆𑇓𑇔𑇆
𑆇𑆥𑆤𑆪𑆾 𑆤𑆴𑆓𑆩𑆤𑆁 𑆖𑆾𑆑𑇀𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆥𑆤𑆳𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆳𑆩𑇀𑇆𑇓𑇕𑇆
𑆃𑆡𑆾𑆠𑇀𑆠𑆫𑆩𑇀- 𑆇𑆠𑇀𑆠𑆫𑆁 𑆤𑆳𑆩 𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆼 𑆲𑆼𑆠𑆿 𑆮𑆽𑆣𑆫𑇀𑆩𑇀𑆪𑆮𑆖𑆤𑆁, 𑆮𑆽𑆣𑆫𑇀𑆩𑇀𑆪𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆼 𑆮𑆳 𑆲𑆼𑆠𑆿 𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆮𑆖𑆤𑆩𑇀𑇅 𑆪𑆡𑆳- ‘𑆲𑆼𑆠𑆶𑆱𑆣𑆫𑇀𑆩𑆳𑆟𑆾 𑆮𑆴𑆑𑆳𑆫𑆳𑆂, 𑆯𑆵𑆠𑆑𑆱𑇀𑆪 𑆲𑆴 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆂 𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆁 𑆲𑆴𑆩𑆯𑆴𑆯𑆴𑆫𑆮𑆳𑆠𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆂’, 𑆅𑆠𑆴 𑆧𑇀𑆫𑆶𑆮𑆠𑆂 𑆥𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆲𑆼𑆠𑆶𑆮𑆴𑆣𑆫𑇀𑆩𑆳𑆟𑆾 𑆮𑆴𑆑𑆳𑆫𑆳𑆂, 𑆪𑆡𑆳 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆢𑆳𑆲𑆿𑆰𑇀𑆟𑇀𑆪𑆑𑆾𑆡𑆥𑇀𑆫𑆥𑆖𑆤𑆼 𑆲𑆼𑆠𑆶𑆮𑆽𑆣𑆫𑇀𑆩𑇀𑆪𑆁 𑆲𑆴𑆩𑆯𑆴𑆯𑆴𑆫𑆮𑆳𑆠𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳 𑆅𑆠𑆴𑇅 𑆍𑆠𑆠𑇀 𑆱𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆩𑆶𑆠𑇀𑆠𑆫𑆩𑇀𑇆𑇓𑇖𑇆
𑆃𑆡 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂- 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆱 𑆪𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆑𑆽𑆫𑇀𑆧𑆲𑆶𑆮𑆴𑆣𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆲𑆼𑆠𑆶𑆨𑆴𑆯𑇀𑆖 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆠𑆼 𑆤𑆴𑆫𑇀𑆟𑆪𑆂𑇅 𑆱 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂- 𑆱𑆫𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂, 𑆥𑇀𑆫𑆠𑆴𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂, 𑆃𑆣𑆴𑆑𑆫𑆟𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂, 𑆃𑆨𑇀𑆪𑆶𑆥𑆓𑆩𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆠𑆠𑇀𑆠𑆠𑇀 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆁; 𑆪𑆡𑆳 𑆱𑆤𑇀𑆠𑆴 𑆤𑆴𑆢𑆳𑆤𑆳𑆤𑆴, 𑆱𑆤𑇀𑆠𑆴 𑆮𑇀𑆪𑆳𑆣𑆪𑆂, 𑆱𑆤𑇀𑆠𑆴 𑆱𑆴𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆩𑆴𑆠𑆴𑇅 𑆥𑇀𑆫𑆠𑆴𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆑𑆽𑆑𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆠𑆠𑇀𑆠𑆠𑇀 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆁; 𑆪𑆡𑆳- 𑆃𑆤𑇀𑆪𑆠𑇀𑆫𑆳𑆰𑇀𑆛𑆿 𑆫𑆱𑆳𑆂 𑆰𑆝𑆠𑇀𑆫, 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆠𑇀𑆫 𑆰𑆝𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆤𑇀𑆪𑆠𑇀𑆫 𑆠𑆤𑇀𑆠𑇀𑆫𑆼, 𑆮𑆳𑆠𑆳𑆢𑆴𑆑𑆸𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆮𑆴𑆑𑆳𑆫𑆳 𑆪𑆡𑆳𑇁𑆤𑇀𑆪𑆠𑇀𑆫, 𑆃𑆠𑇀𑆫 𑆮𑆳𑆠𑆳𑆢𑆴𑆑𑆸𑆠𑆳 𑆨𑆷𑆠𑆑𑆸𑆠𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆂𑇅 𑆃𑆣𑆴𑆑𑆫𑆟𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆱 𑆪𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆣𑆴𑆑𑆫𑆟𑆼 𑆥𑇀𑆫𑆱𑇀𑆠𑆷𑆪𑆩𑆳𑆤𑆼 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆥𑇀𑆪𑆣𑆴𑆑𑆫𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆪𑆡𑆳- ‘𑆤 𑆩𑆶𑆑𑇀𑆠𑆂 𑆑𑆫𑇀𑆩𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆴𑆑𑆁 𑆑𑆶𑆫𑆶𑆠𑆼, 𑆤𑆴𑆱𑇀𑆥𑆸𑆲𑆠𑇀𑆮𑆳𑆠𑇀 𑆅𑆠𑆴 𑆥𑇀𑆫𑆱𑇀𑆠𑆶𑆠𑆼 𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆑𑆫𑇀𑆩𑆦𑆬-𑆩𑆾𑆑𑇀𑆰-𑆥𑆶𑆫𑆶𑆰-𑆥𑇀𑆫𑆼𑆠𑇀𑆪𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆃𑆨𑇀𑆪𑆶𑆥𑆓𑆩𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆾 𑆤𑆳𑆩 𑆱 𑆪𑆩𑆫𑇀𑆡𑆩𑆱𑆴𑆢𑇀𑆣𑆩𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆩𑆤𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆩𑆲𑆼𑆠𑆶𑆑𑆁 𑆮𑆳 𑆮𑆳𑆢𑆑𑆳𑆬𑆼𑇁𑆨𑇀𑆪𑆶𑆥𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆓𑆶𑆟𑆳𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆮𑆵𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆅𑆠𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆴𑆂𑇅 𑆅𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆂𑇆𑇓𑇗𑇆
𑆃𑆡 𑆯𑆧𑇀𑆢𑆂- 𑆯𑆧𑇀𑆢𑆾 𑆤𑆳𑆩 𑆮𑆫𑇀𑆟𑆱𑆩𑆳𑆩𑇀𑆤𑆳𑆪𑆂; 𑆱 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂- 𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆯𑇀𑆖, 𑆃𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆯𑇀𑆖, 𑆱𑆠𑇀𑆪𑆯𑇀𑆖, 𑆃𑆤𑆸𑆠𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆾 𑆤𑆳𑆩- 𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴, 𑆰𑆝𑇀𑆨𑆴𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴, 𑆱𑆠𑆴 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆢𑆴𑆱𑆢𑇀𑆨𑆳𑆮𑆼 𑆯𑆧𑇀𑆢𑆳𑆢𑆴𑆓𑇀𑆫𑆲𑆟𑆩𑆴𑆠𑆴𑇅 𑆃𑆢𑆸𑆰𑇀𑆛𑆳𑆫𑇀𑆡𑆂 𑆥𑆶𑆤𑆂- 𑆃𑆱𑇀𑆠𑆴 𑆥𑇀𑆫𑆼𑆠𑇀𑆪𑆨𑆳𑆮𑆂, 𑆃𑆱𑇀𑆠𑆴 𑆩𑆾𑆑𑇀𑆰 𑆅𑆠𑆴𑇅 𑆱𑆠𑇀𑆪𑆾 𑆤𑆳𑆩- 𑆪𑆡𑆳𑆫𑇀𑆡𑆨𑆷𑆠𑆂; 𑆱𑆤𑇀𑆠𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆾𑆥𑆢𑆼𑆯𑆳𑆂, 𑆱𑆤𑇀𑆠𑆴 𑆱𑆴𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁, 𑆱𑆤𑇀𑆠𑇀𑆪𑆳𑆫𑆩𑇀𑆨𑆦𑆬𑆳𑆤𑆵𑆠𑆴𑇅 𑆱𑆠𑇀𑆪𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆯𑇀𑆖𑆳𑆤𑆸𑆠𑆂𑇆𑇓𑇘𑇆
𑆃𑆡 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁- 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁 𑆤𑆳𑆩 𑆠𑆢𑇀𑆪𑆢𑆳𑆠𑇀𑆩𑆤𑆳 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆽𑆯𑇀𑆖 𑆱𑇀𑆮𑆪𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼; 𑆠𑆠𑇀𑆫𑆳𑆠𑇀𑆩𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆼𑆖𑇀𑆗𑆳𑆢𑇀𑆮𑆼𑆰𑆳𑆢𑆪𑆂, 𑆯𑆧𑇀𑆢𑆳𑆢𑆪𑆱𑇀𑆠𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆂𑇆𑇓𑇙𑇆
𑆃𑆡𑆳𑆤𑆶𑆩𑆳𑆤𑆩𑇀- 𑆃𑆤𑆶𑆩𑆳𑆤𑆁 𑆤𑆳𑆩 𑆠𑆫𑇀𑆑𑆾 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆥𑆼𑆑𑇀𑆰𑆂; 𑆪𑆡𑆳- 𑆃𑆓𑇀𑆤𑆴𑆁 𑆘𑆫𑆟𑆯𑆑𑇀𑆠𑇀𑆪𑆳, 𑆧𑆬𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆠𑇀𑆪𑆳, 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑆴 𑆯𑆧𑇀𑆢𑆳𑆢𑆴𑆓𑇀𑆫𑆲𑆟𑆼𑆤𑆼𑆠𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆴𑇆𑇔𑇐𑇆
𑆃𑆡𑆽𑆠𑆴𑆲𑇀𑆪𑆩𑇀- 𑆎𑆠𑆴𑆲𑇀𑆪𑆁 𑆤𑆳𑆩𑆳𑆥𑇀𑆠𑆾𑆥𑆢𑆼𑆯𑆾 𑆮𑆼𑆢𑆳𑆢𑆴𑆂𑇆𑇔𑇑𑇆
𑆃𑆡𑆿𑆥𑆩𑇀𑆪𑆩𑇀- 𑆐𑆥𑆩𑇀𑆪𑆁 𑆤𑆳𑆩 𑆪𑆢𑆤𑇀𑆪𑆼𑆤𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑆳𑆢𑆸𑆯𑇀𑆪𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆥𑇀𑆫𑆑𑆳𑆯𑆤𑆁; 𑆪𑆡𑆳- 𑆢𑆟𑇀𑆝𑆼𑆤 𑆢𑆟𑇀𑆝𑆑𑆱𑇀𑆪, 𑆣𑆤𑆶𑆰𑆳 𑆣𑆤𑆶𑆂𑆱𑇀𑆠𑆩𑇀𑆨𑆱𑇀𑆪, 𑆅𑆰𑇀𑆮𑆳𑆱𑆼𑆤𑆳𑇁𑇁𑆫𑆾𑆓𑇀𑆪𑆢𑆱𑇀𑆪𑆼𑆠𑆴𑇆𑇔𑇒𑇆
𑆃𑆡 𑆱𑆁𑆯𑆪𑆂- 𑆱𑆁𑆯𑆪𑆾 𑆤𑆳𑆩 𑆱𑆤𑇀𑆢𑆼𑆲𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆶𑆱𑆤𑇀𑆢𑆴𑆓𑇀𑆣𑆼𑆰𑇀𑆮𑆫𑇀𑆡𑆼𑆰𑇀𑆮𑆤𑆴𑆯𑇀𑆖𑆪𑆂 ; 𑆪𑆡𑆳- 𑆢𑆸𑆰𑇀𑆛𑆳 𑆲𑇀𑆪𑆳𑆪𑆶𑆰𑇀𑆩𑆬𑇀𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑆶𑆥𑆼𑆠𑆳𑆯𑇀𑆖𑆳𑆤𑆶𑆥𑆼𑆠𑆳𑆯𑇀𑆖 𑆠𑆡𑆳 𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖𑆳𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆳𑆂 𑆯𑆵𑆔𑇀𑆫𑆨𑆕𑇀𑆓𑆳𑆯𑇀𑆖𑆴𑆫𑆘𑆵𑆮𑆴𑆤𑆯𑇀𑆖, 𑆍𑆠𑆢𑆶𑆨𑆪𑆢𑆸𑆰𑇀𑆛𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆁𑆯𑆪𑆂- 𑆑𑆴𑆩𑆱𑇀𑆠𑆴 𑆒𑆬𑇀𑆮𑆑𑆳𑆬𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆶𑆠 𑆤𑆳𑆱𑇀𑆠𑆵𑆠𑆴𑇆𑇔𑇓𑇆
𑆃𑆡 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁- 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁 𑆤𑆳𑆩 𑆪𑆢𑆫𑇀𑆡𑆩𑆳𑆫𑆨𑇀𑆪𑆤𑇀𑆠 𑆄𑆫𑆩𑇀𑆨𑆳𑆂; 𑆪𑆡𑆳- 𑆪𑆢𑇀𑆪𑆑𑆳𑆬𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆱𑇀𑆠𑆴 𑆠𑆠𑆾𑇁𑆲𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆽𑆫𑆶𑆥𑆖𑆫𑆴𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆤𑆳𑆪𑆶𑆰𑇀𑆪𑆳𑆟𑆴 𑆖 𑆥𑆫𑆴𑆲𑆫𑆴𑆰𑇀𑆪𑆳𑆩𑆴, 𑆑𑆡𑆁 𑆩𑆳𑆩𑆑𑆳𑆬𑆩𑆸𑆠𑇀𑆪𑆶𑆂 𑆥𑇀𑆫𑆱𑆲𑆼𑆠𑆼𑆠𑆴𑇆𑇔𑇔𑇆
𑆃𑆡 𑆱𑆮𑇀𑆪𑆨𑆴𑆖𑆳𑆫𑆁- 𑆱𑆮𑇀𑆪𑆨𑆴𑆖𑆳𑆫𑆁 𑆤𑆳𑆩 𑆪𑆢𑇀𑆮𑇀𑆪𑆨𑆴𑆖𑆫𑆟𑆁; 𑆪𑆡𑆳- 𑆨𑆮𑆼𑆢𑆴𑆢𑆩𑆿𑆰𑆣𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆿 𑆪𑆿𑆓𑆴𑆑𑆩𑆡𑆮𑆳 𑆤𑆼𑆠𑆴𑇆𑇔𑇕𑇆
𑆃𑆡 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳- 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳 𑆤𑆳𑆩 𑆥𑆫𑆵𑆑𑇀𑆰𑆳; 𑆪𑆡𑆳 𑆨𑆼𑆰𑆘𑆥𑆫𑆵𑆑𑇀𑆰𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇔𑇖𑇆
𑆃𑆡 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆂- 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆾 𑆤𑆳𑆩 𑆤𑆴𑆯𑇀𑆖𑆪𑆂; 𑆪𑆡𑆳- 𑆮𑆳𑆠𑆴𑆑 𑆍𑆮𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆂, 𑆅𑆢𑆩𑆼𑆮𑆳𑆱𑇀𑆪 𑆨𑆼𑆰𑆘𑆁 𑆖𑆼𑆠𑆴𑇆𑇔𑇗𑇆
𑆃𑆡𑆳𑆫𑇀𑆡𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂- 𑆃𑆫𑇀𑆡𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆫𑇀𑆤𑆳𑆩 𑆪𑆠𑇀𑆫𑆽𑆑𑆼𑆤𑆳𑆫𑇀𑆡𑆼𑆤𑆾𑆑𑇀𑆠𑆼𑆤𑆳𑆥𑆫𑆱𑇀𑆪𑆳𑆫𑇀𑆡𑆱𑇀𑆪𑆳𑆤𑆶𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆱𑆴𑆢𑇀𑆣𑆴𑆂; 𑆪𑆡𑆳- 𑆤𑆳𑆪𑆁 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆱𑆳𑆣𑇀𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆨𑆮𑆠𑇀𑆪𑆫𑇀𑆡𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂- 𑆃𑆥𑆠𑆫𑇀𑆥𑆟𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆪𑆩𑆴𑆠𑆴, 𑆤𑆳𑆤𑆼𑆤 𑆢𑆴𑆮𑆳 𑆨𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆨𑆮𑆠𑇀𑆪𑆫𑇀𑆡𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂- 𑆤𑆴𑆯𑆴 𑆨𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑆴𑇆𑇔𑇘𑇆
𑆃𑆡 𑆱𑆩𑇀𑆨𑆮𑆂- 𑆪𑆾 𑆪𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆴 𑆱 𑆠𑆱𑇀𑆪 𑆱𑆩𑇀𑆨𑆮𑆂; 𑆪𑆡𑆳- 𑆰𑆝𑇀𑆣𑆳𑆠𑆮𑆾 𑆓𑆫𑇀𑆨𑆱𑇀𑆪, 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆲𑆴𑆠𑆁, 𑆲𑆴𑆠𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆱𑇀𑆪𑆼𑆠𑆴𑇆𑇔𑇙𑇆
𑆃𑆡𑆳𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆩𑇀- 𑆃𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆁 𑆤𑆳𑆩 𑆪𑆢𑇀𑆮𑆳𑆑𑇀𑆪𑆁 𑆮𑆳𑆑𑇀𑆪𑆢𑆾𑆰𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆠𑇀𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆾 𑆮𑇀𑆪𑆳𑆲𑆸𑆠𑆼𑆰𑇀𑆮𑆫𑇀𑆡𑆼𑆰𑆶 𑆮𑆳 𑆮𑆴𑆯𑆼𑆰𑆓𑇀𑆫𑆲𑆟𑆳𑆫𑇀𑆡𑆁 𑆪𑆢𑇀𑆮𑆳𑆑𑇀𑆪𑆁 𑆠𑆢𑆥𑇀𑆪𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆁; 𑆪𑆡𑆳- ‘𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆪𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆂’ 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼 ‘𑆑𑆴𑆁 𑆮𑆩𑆤𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆪𑆁, 𑆑𑆴𑆁𑆮𑆳 𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑆳𑆣𑇀𑆪𑆂’ 𑆅𑆠𑇀𑆪𑆤𑆶𑆪𑆶𑆘𑇀𑆪𑆠𑆼𑇆𑇕𑇐𑇆
𑆃𑆡𑆳𑆤𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆩𑇀- 𑆃𑆤𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆁 𑆤𑆳𑆩𑆳𑆠𑆾 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟; 𑆪𑆡𑆳- 𑆃𑆪𑆩𑆱𑆳𑆣𑇀𑆪𑆂𑇆𑇕𑇑𑇆
𑆃𑆡𑆳𑆤𑆶𑆪𑆾𑆓𑆂- 𑆃𑆤𑆶𑆪𑆾𑆓𑆾 𑆤𑆳𑆩 𑆱 𑆪𑆠𑇀 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆽𑆫𑆼𑆮 𑆱𑆳𑆫𑇀𑆣𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆠𑆤𑇀𑆠𑇀𑆫𑆽𑆑𑆢𑆼𑆯𑆼 𑆮𑆳 𑆥𑇀𑆫𑆯𑇀𑆤𑆂𑆥𑇀𑆫𑆯𑇀𑆤𑆽𑆑𑆢𑆼𑆯𑆾 𑆮𑆳 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆖𑆤𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆫𑇀𑆡𑆩𑆳𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇅 𑆪𑆡𑆳- ‘𑆤𑆴𑆠𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰𑆂’ 𑆅𑆠𑆴 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆠𑆼 𑆪𑆠𑇀 𑆥𑆫𑆂 ‘𑆑𑆾 𑆲𑆼𑆠𑆶𑆂’ 𑆅𑆠𑇀𑆪𑆳𑆲, 𑆱𑆾𑇁𑆤𑆶𑆪𑆾𑆓𑆂𑇆𑇕𑇒𑇆
𑆃𑆡 𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆶𑆪𑆾𑆓𑆂- 𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆶𑆪𑆾𑆓𑆾 𑆤𑆳𑆩𑆳𑆤𑆶𑆪𑆾𑆓𑆱𑇀𑆪𑆳𑆤𑆶𑆪𑆾𑆓𑆂; 𑆪𑆡𑆳- 𑆃𑆱𑇀𑆪𑆳𑆤𑆶𑆪𑆾𑆓𑆱𑇀𑆪 𑆥𑆶𑆤𑆂 𑆑𑆾 𑆲𑆼𑆠𑆶𑆫𑆴𑆠𑆴𑇆𑇕𑇓𑇆
𑆃𑆡 𑆮𑆳𑆑𑇀𑆪𑆢𑆾𑆰𑆂- 𑆮𑆳𑆑𑇀𑆪𑆢𑆾𑆰𑆾 𑆤𑆳𑆩 𑆪𑆡𑆳 𑆒𑆬𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆫𑇀𑆡𑆼 𑆤𑇀𑆪𑆷𑆤𑆩𑇀, 𑆃𑆣𑆴𑆑𑆩𑇀, 𑆃𑆤𑆫𑇀𑆡𑆑𑆩𑇀, 𑆃𑆥𑆳𑆫𑇀𑆡𑆑𑆁, 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆖𑆼𑆠𑆴; 𑆍𑆠𑆳𑆤𑆴 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆤 𑆥𑇀𑆫𑆑𑆸𑆠𑆾𑇁𑆫𑇀𑆡𑆂 𑆥𑇀𑆫𑆟𑆯𑆪𑆼𑆠𑇀𑇅 𑆠𑆠𑇀𑆫 𑆤𑇀𑆪𑆷𑆤𑆁- 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆲𑆼𑆠𑆷𑆢𑆳𑆲𑆫𑆟𑆾𑆥𑆤𑆪𑆤𑆴𑆓𑆩𑆤𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤𑆳𑆥𑆴 𑆤𑇀𑆪𑆷𑆤𑆁 𑆤𑇀𑆪𑆷𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆪𑆢𑇀𑆮𑆳 𑆧𑆲𑆷𑆥𑆢𑆴𑆰𑇀𑆛𑆲𑆼𑆠𑆶𑆑𑆩𑆼𑆑𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆠𑆖𑇀𑆖 𑆤𑇀𑆪𑆷𑆤𑆩𑇀𑇅 𑆃𑆡𑆳𑆣𑆴𑆑𑆩𑇀- 𑆃𑆣𑆴𑆑𑆁 𑆤𑆳𑆩 𑆪𑆤𑇀𑆤𑇀𑆪𑆷𑆤𑆮𑆴𑆥𑆫𑆵𑆠𑆁, 𑆪𑆢𑇀𑆮𑆳𑇁𑇁𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆼 𑆨𑆳𑆰𑇀𑆪𑆩𑆳𑆟𑆼 𑆧𑆳𑆫𑇀𑆲𑆱𑇀𑆥𑆠𑇀𑆪𑆩𑆿𑆯𑆤𑆱𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆪𑆠𑇀𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆥𑇀𑆫𑆠𑆴𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆩𑆶𑆖𑇀𑆪𑆠𑆼, 𑆪𑆢𑇀𑆮𑆳 𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆩𑆥𑆴 𑆢𑇀𑆮𑆴𑆫𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑆠𑆠𑇀 𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆢𑆾𑆰𑆠𑇀𑆮𑆳𑆢𑆣𑆴𑆑𑆁; 𑆠𑆖𑇀𑆖 𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑇀- 𑆃𑆫𑇀𑆡𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁, 𑆯𑆧𑇀𑆢𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁 𑆖; 𑆠𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁 𑆪𑆡𑆳- 𑆨𑆼𑆰𑆘𑆩𑆿𑆰𑆣𑆁 𑆱𑆳𑆣𑆤𑆩𑆴𑆠𑆴, 𑆯𑆧𑇀𑆢𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁 𑆥𑆶𑆤𑆫𑇀𑆨𑆼𑆰𑆘𑆁 𑆨𑆼𑆰𑆘𑆩𑆴𑆠𑆴𑇅 𑆃𑆡𑆳𑆤𑆫𑇀𑆡𑆑𑆩𑇀- 𑆃𑆤𑆫𑇀𑆡𑆑𑆁 𑆤𑆳𑆩 𑆪𑆢𑇀𑆮𑆖𑆤𑆩𑆑𑇀𑆰𑆫𑆓𑇀𑆫𑆳𑆩𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆮 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆚𑇀𑆖𑆮𑆫𑇀𑆓𑆮𑆤𑇀𑆤 𑆖𑆳𑆫𑇀𑆡𑆠𑆾 𑆓𑆸𑆲𑇀𑆪𑆠𑆼𑇅 𑆃𑆡𑆳𑆥𑆳𑆫𑇀𑆡𑆑𑆩𑇀- 𑆃𑆥𑆳𑆫𑇀𑆡𑆑𑆁 𑆤𑆳𑆩 𑆪𑆢𑆫𑇀𑆡𑆮𑆖𑇀𑆖 𑆥𑆫𑆱𑇀𑆥𑆫𑆼𑆟𑆳𑆱𑆁𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆫𑇀𑆡𑆑𑆁; 𑆪𑆡𑆳- 𑆖𑆑𑇀𑆫-𑆤(𑆠)𑆑𑇀𑆫-𑆮𑆁𑆯-𑆮𑆘𑇀𑆫-𑆤𑆴𑆯𑆳𑆑𑆫𑆳 𑆅𑆠𑆴𑇅 𑆃𑆡 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁- 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆤𑆳𑆩 𑆪𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆱𑆩𑆪𑆽𑆫𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁; 𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆳𑆮𑆶𑆑𑇀𑆠𑆿𑆂 𑆱𑆩𑆪𑆂 𑆥𑆶𑆤𑆱𑇀𑆠𑇀𑆫𑆴𑆣𑆳 𑆨𑆮𑆠𑆴; 𑆪𑆡𑆳- 𑆄𑆪𑆶𑆫𑇀𑆮𑆽𑆢𑆴𑆑𑆱𑆩𑆪𑆂, 𑆪𑆳𑆘𑇀𑆚𑆴𑆑𑆱𑆩𑆪𑆂, 𑆩𑆾𑆑𑇀𑆰𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆱𑆩𑆪𑆯𑇀𑆖𑆼𑆠𑆴; 𑆠𑆠𑇀𑆫𑆳𑆪𑆶𑆫𑇀𑆮𑆽𑆢𑆴𑆑𑆱𑆩𑆪𑆂- 𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆁 𑆨𑆼𑆰𑆘𑆩𑆴𑆠𑆴, 𑆪𑆳𑆘𑇀𑆚𑆴𑆑𑆱𑆩𑆪𑆂- 𑆄𑆬𑆨𑇀𑆪𑆳 𑆪𑆘𑆩𑆳𑆤𑆽𑆂 𑆥𑆯𑆮 𑆅𑆠𑆴, 𑆩𑆾𑆑𑇀𑆰𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆱𑆩𑆪𑆂- 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆼𑆰𑇀𑆮𑆲𑆴𑆁𑆱𑆼𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆱𑆩𑆪𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆨𑆮𑆠𑆴𑇅 𑆅𑆠𑆴 𑆮𑆳𑆑𑇀𑆪𑆢𑆾𑆰𑆳𑆂𑇆𑇕𑇔𑇆
𑆃𑆡 𑆮𑆳𑆑𑇀𑆪𑆥𑇀𑆫𑆯𑆁𑆱𑆳- 𑆮𑆳𑆑𑇀𑆪𑆥𑇀𑆫𑆯𑆁𑆱𑆳 𑆤𑆳𑆩 𑆪𑆡𑆳 𑆒𑆬𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆫𑇀𑆡𑆼 𑆠𑇀𑆮𑆤𑇀𑆪𑆷𑆤𑆩𑇀, 𑆃𑆤𑆣𑆴𑆑𑆩𑇀, 𑆃𑆫𑇀𑆡𑆮𑆠𑇀, 𑆃𑆤𑆥𑆳𑆫𑇀𑆡𑆑𑆩𑇀, 𑆃𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑇀, 𑆃𑆣𑆴𑆓𑆠𑆥𑆢𑆳𑆫𑇀𑆡𑆁 𑆖𑆼𑆠𑆴 𑆪𑆠𑇀𑆠𑆢𑇀𑆮𑆳𑆑𑇀𑆪𑆩𑆤𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇕𑇕𑇆
𑆃𑆡 𑆖𑇀𑆗𑆬𑆁- 𑆗𑆬𑆁 𑆤𑆳𑆩 𑆥𑆫𑆴𑆯𑆜𑆩𑆫𑇀𑆡𑆳𑆨𑆳𑆱𑆩𑆤𑆫𑇀𑆡𑆑𑆁 𑆮𑆳𑆓𑇀𑆮𑆱𑇀𑆠𑆶𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆮𑇅 𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁- 𑆮𑆳𑆑𑇀𑆗𑆬𑆁, 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆖𑇀𑆗𑆬𑆁 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆮𑆳𑆑𑇀𑆗𑆬𑆁 𑆤𑆳𑆩 𑆪𑆡𑆳- 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆤𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆾𑇁𑆪𑆁 𑆨𑆴𑆰𑆓𑆴𑆠𑆴, 𑆃𑆡 𑆨𑆴𑆰𑆓𑇀 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆤𑆳𑆲𑆁 𑆤𑆮𑆠𑆤𑇀𑆠𑇀𑆫 𑆍𑆑𑆠𑆤𑇀𑆠𑇀𑆫𑆾𑇁𑆲𑆩𑆴𑆠𑆴; 𑆥𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆤𑆳𑆲𑆁 𑆧𑇀𑆫𑆮𑆵𑆩𑆴 𑆤𑆮 𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆠𑆮𑆼𑆠𑆴, 𑆃𑆥𑆴 𑆠𑆶 𑆤𑆮𑆳𑆨𑇀𑆪𑆱𑇀𑆠𑆁 𑆠𑆼 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆴𑆠𑆴; 𑆨𑆴𑆰𑆑𑇀 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆤 𑆩𑆪𑆳 𑆤𑆮𑆳𑆨𑇀𑆪𑆱𑇀𑆠𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑇀, 𑆃𑆤𑆼𑆑𑆣𑆳𑇁𑆨𑇀𑆪𑆱𑇀𑆠𑆁 𑆩𑆪𑆳 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆴𑆠𑆴; 𑆍𑆠𑆢𑇀𑆮𑆳𑆑𑇀𑆗𑆬𑆩𑇀𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆖𑇀𑆗𑆬𑆁 𑆤𑆳𑆩 𑆪𑆡𑆳- 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪𑆿𑆰𑆣𑆩𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆼, 𑆥𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆱𑆠𑇀 𑆱𑆠𑇀𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪𑆼𑆠𑆴 𑆑𑆴𑆁 𑆤𑆶 𑆨𑆮𑆳𑆤𑆳𑆲; 𑆱𑆤𑇀 𑆲𑆴 𑆫𑆾𑆓𑆂, 𑆱𑆢𑆿𑆰𑆣𑆁; 𑆪𑆢𑆴 𑆖 𑆱𑆠𑇀 𑆱𑆠𑇀𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪 𑆨𑆮𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆱𑆠𑇀 𑆑𑆳𑆱𑆂, 𑆱𑆠𑇀 𑆑𑇀𑆰𑆪𑆂, 𑆱𑆠𑇀𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀 𑆑𑆳𑆱𑆱𑇀𑆠𑆼 𑆑𑇀𑆰𑆪𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴𑇅 𑆍𑆠𑆠𑇀 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆖𑇀𑆗𑆬𑆩𑇀𑇆𑇕𑇖𑇆
𑆃𑆡𑆳𑆲𑆼𑆠𑆶𑆂- 𑆃𑆲𑆼𑆠𑆶𑆫𑇀𑆤𑆳𑆩𑆥𑇀𑆫𑆑𑆫𑆟𑆱𑆩𑆂, 𑆱𑆁𑆯𑆪𑆱𑆩𑆂, 𑆮𑆫𑇀𑆟𑇀𑆪𑆱𑆩𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆫𑆟𑆱𑆩𑆾 𑆤𑆳𑆩𑆳𑆲𑆼𑆠𑆶𑆫𑇀𑆪𑆡𑆳- 𑆃𑆤𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆳𑆢𑆳𑆠𑇀𑆩𑆳 𑆤𑆴𑆠𑇀𑆪 𑆅𑆠𑆴; 𑆥𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆪𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆳𑆢𑆳𑆠𑇀𑆩𑆳, 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆂; 𑆯𑆫𑆵𑆫𑆁 𑆲𑇀𑆪𑆤𑆴𑆠𑇀𑆪𑆩𑆠𑆾 𑆮𑆴𑆣𑆫𑇀𑆩𑆴𑆟𑆳 𑆖𑆳𑆠𑇀𑆩𑆤𑆳 𑆨𑆮𑆴𑆠𑆮𑇀𑆪𑆩𑆴𑆠𑇀𑆪𑆼𑆰 𑆖𑆳𑆲𑆼𑆠𑆶𑆂; 𑆤𑆲𑆴 𑆪 𑆍𑆮 𑆥𑆑𑇀𑆰𑆂 𑆱 𑆍𑆮 𑆲𑆼𑆠𑆶𑆫𑆴𑆠𑆴𑇅 𑆱𑆁𑆯𑆪𑆱𑆩𑆾 𑆤𑆳𑆩𑆳𑆲𑆼𑆠𑆶𑆫𑇀𑆪 𑆍𑆮 𑆱𑆁𑆯𑆪𑆲𑆼𑆠𑆶𑆂 𑆱 𑆍𑆮 𑆱𑆁𑆯𑆪𑆖𑇀𑆗𑆼𑆢𑆲𑆼𑆠𑆶𑆂; 𑆪𑆡𑆳- 𑆃𑆪𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆽𑆑𑆢𑆼𑆯𑆩𑆳𑆲, 𑆑𑆴𑆤𑇀𑆤𑇀𑆮𑆪𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆤 𑆮𑆼𑆠𑆴 𑆱𑆁𑆯𑆪𑆼 𑆥𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆪𑆱𑇀𑆩𑆳𑆢𑆪𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆽𑆑𑆢𑆼𑆯𑆩𑆳𑆲 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆾𑇁𑆪𑆩𑆴𑆠𑆴, 𑆤 𑆖 𑆱𑆁𑆯𑆪𑆖𑇀𑆗𑆼𑆢𑆲𑆼𑆠𑆶𑆁 𑆮𑆴𑆯𑆼𑆰𑆪𑆠𑆴, 𑆍𑆰 𑆖𑆳𑆲𑆼𑆠𑆶𑆂; 𑆤 𑆲𑆴 𑆪 𑆍𑆮 𑆱𑆁𑆯𑆪𑆲𑆼𑆠𑆶𑆂, 𑆱 𑆍𑆮 𑆱𑆁𑆯𑆪𑆖𑇀𑆗𑆼𑆢𑆲𑆼𑆠𑆶𑆫𑇀𑆨𑆮𑆠𑆴𑇅 𑆮𑆫𑇀𑆟𑇀𑆪𑆱𑆩𑆾 𑆤𑆳𑆩𑆳𑆲𑆼𑆠𑆶𑆂- 𑆪𑆾 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑇀𑆪𑆳𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆂; 𑆪𑆡𑆳- 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆧𑆷𑆪𑆳𑆠𑇀- 𑆃𑆱𑇀𑆥𑆫𑇀𑆯𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆤𑆴𑆠𑇀𑆪𑆳 𑆯𑆧𑇀𑆢𑆮𑆢𑆴𑆠𑆴; 𑆃𑆠𑇀𑆫 𑆮𑆫𑇀𑆟𑇀𑆪𑆂 𑆯𑆧𑇀𑆢𑆾 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆥𑆴 𑆮𑆫𑇀𑆟𑇀𑆪𑆳, 𑆠𑆢𑆶𑆨𑆪𑆮𑆫𑇀𑆟𑇀𑆪𑆳𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆫𑇀𑆟𑇀𑆪𑆱𑆩𑆾𑇁𑆥𑇀𑆪𑆲𑆼𑆠𑆶𑆂𑇆𑇕𑇗𑇆
𑆃𑆡𑆳𑆠𑆵𑆠𑆑𑆳𑆬𑆩𑇀- 𑆃𑆠𑆵𑆠𑆑𑆳𑆬𑆁 𑆤𑆳𑆩 𑆪𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆳𑆖𑇀𑆪𑆁 𑆠𑆠𑇀 𑆥𑆯𑇀𑆖𑆳𑆢𑆶𑆖𑇀𑆪𑆠𑆼, 𑆠𑆠𑇀 𑆑𑆳𑆬𑆳𑆠𑆵𑆠𑆠𑇀𑆮𑆳𑆢𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆁 𑆨𑆮𑆠𑆵𑆠𑆴; 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆳 𑆤𑆴𑆓𑇀𑆫𑆲𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆤𑆴𑆓𑆸𑆲𑇀𑆪 𑆥𑆫𑆴𑆓𑆸𑆲𑇀𑆪 𑆥𑆑𑇀𑆰𑆳𑆤𑇀𑆠𑆫𑆴𑆠𑆁 𑆥𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆴𑆓𑆸𑆲𑆵𑆠𑆼, 𑆠𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆠𑆵𑆠𑆑𑆳𑆬𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆴𑆓𑇀𑆫𑆲𑆮𑆖𑆤𑆩𑆱𑆩𑆫𑇀𑆡𑆁 𑆨𑆮𑆠𑆵𑆠𑆴𑇆𑇕𑇘𑇆
𑆃𑆡𑆾𑆥𑆳𑆬𑆩𑇀𑆨𑆂- 𑆇𑆥𑆳𑆬𑆩𑇀𑆨𑆾 𑆤𑆳𑆩 𑆲𑆼𑆠𑆾𑆫𑇀𑆢𑆾𑆰𑆮𑆖𑆤𑆁; 𑆪𑆡𑆳- 𑆥𑆷𑆫𑇀𑆮𑆩𑆲𑆼𑆠𑆮𑆾 𑆲𑆼𑆠𑇀𑆮𑆳𑆨𑆳𑆱𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇕𑇙𑇆
𑆃𑆡 𑆥𑆫𑆴𑆲𑆳𑆫𑆂- 𑆥𑆫𑆴𑆲𑆳𑆫𑆾 𑆤𑆳𑆩 𑆠𑆱𑇀𑆪𑆽𑆮 𑆢𑆾𑆰𑆮𑆖𑆤𑆱𑇀𑆪 𑆥𑆫𑆴𑆲𑆫𑆟𑆁; 𑆪𑆡𑆳- 𑆤𑆴𑆠𑇀𑆪𑆩𑆳𑆠𑇀𑆩𑆤𑆴 𑆯𑆫𑆵𑆫𑆱𑇀𑆡𑆼 𑆘𑆵𑆮𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆶𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆱𑇀𑆪 𑆖𑆳𑆥𑆓𑆩𑆳𑆤𑇀𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆳𑆢𑆳𑆠𑇀𑆩𑆳 𑆤𑆴𑆠𑇀𑆪𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇖𑇐𑇆
𑆃𑆡 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆲𑆳𑆤𑆴𑆂- 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆲𑆳𑆤𑆴𑆫𑇀𑆤𑆳𑆩 𑆱𑆳 𑆥𑆷𑆫𑇀𑆮𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆁 𑆥𑆫𑇀𑆪𑆤𑆶𑆪𑆶𑆑𑇀𑆠𑆾 𑆪𑆠𑇀 𑆥𑆫𑆴𑆠𑇀𑆪𑆘𑆠𑆴, 𑆪𑆡𑆳 𑆥𑇀𑆫𑆳𑆑𑇀 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤𑆴𑆠𑇀𑆪𑆂 𑆥𑆶𑆫𑆶𑆰 𑆅𑆠𑆴, 𑆥𑆫𑇀𑆪𑆤𑆶𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑇀𑆮𑆳𑆲- 𑆃𑆤𑆴𑆠𑇀𑆪 𑆅𑆠𑆴𑇆𑇖𑇑𑇆
𑆃𑆡𑆳𑆨𑇀𑆪𑆤𑆶𑆘𑇀𑆚𑆳- 𑆃𑆨𑇀𑆪𑆤𑆶𑆘𑇀𑆚𑆳 𑆤𑆳𑆩 𑆱𑆳 𑆪 𑆅𑆰𑇀𑆛𑆳𑆤𑆴𑆰𑇀𑆛𑆳𑆨𑇀𑆪𑆶𑆥𑆓𑆩𑆂𑇆𑇖𑇒𑇆
𑆃𑆡 𑆲𑆼𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆁- 𑆲𑆼𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆁 𑆤𑆳𑆩 𑆥𑇀𑆫𑆑𑆸𑆠𑆲𑆼𑆠𑆿 𑆮𑆳𑆖𑇀𑆪𑆼 𑆪𑆢𑇀𑆮𑆴𑆑𑆸𑆠𑆲𑆼𑆠𑆶𑆩𑆳𑆲𑇆𑇖𑇓𑇆
𑆃𑆡𑆳𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆩𑇀- 𑆃𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆁 𑆤𑆳𑆩𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆼𑇁𑆥𑆫𑆁 𑆪𑆢𑆳𑆲𑇅 𑆪𑆡𑆳- 𑆘𑇀𑆮𑆫𑆬𑆑𑇀𑆰𑆟𑆼 𑆮𑆳𑆖𑇀𑆪𑆼 𑆥𑇀𑆫𑆩𑆼𑆲𑆬𑆑𑇀𑆰𑆟𑆩𑆳𑆲𑇆𑇖𑇔𑇆
𑆃𑆡 𑆤𑆴𑆓𑇀𑆫𑆲𑆱𑇀𑆡𑆳𑆤𑆁- 𑆤𑆴𑆓𑇀𑆫𑆲𑆱𑇀𑆡𑆳𑆤𑆁 𑆤𑆳𑆩 𑆥𑆫𑆳𑆘𑆪𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂; 𑆠𑆖𑇀𑆖 𑆠𑇀𑆫𑆴𑆫𑆨𑆴𑆲𑆴𑆠𑆱𑇀𑆪 𑆮𑆳𑆑𑇀𑆪𑆱𑇀𑆪𑆳𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆥𑆫𑆴𑆰𑆢𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑇀𑆪𑆳𑆁, 𑆪𑆢𑇀𑆮𑆳 𑆃𑆤𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆱𑇀𑆪𑆳𑆤𑆶𑆪𑆾𑆓𑆾𑇁𑆤𑆶𑆪𑆾𑆘𑇀𑆪𑆱𑇀𑆪 𑆖𑆳𑆤𑆤𑆶𑆪𑆾𑆓𑆂𑇅 𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆲𑆳𑆤𑆴𑆂, 𑆃𑆨𑇀𑆪𑆤𑆶𑆘𑇀𑆚𑆳, 𑆑𑆳𑆬𑆳𑆠𑆵𑆠𑆮𑆖𑆤𑆩𑇀, 𑆃𑆲𑆼𑆠𑆶𑆂, 𑆤𑇀𑆪𑆷𑆤𑆩𑇀, 𑆃𑆣𑆴𑆑𑆁, 𑆮𑇀𑆪𑆫𑇀𑆡𑆩𑇀, 𑆃𑆤𑆫𑇀𑆡𑆑𑆁, 𑆥𑆶𑆤𑆫𑆶𑆑𑇀𑆠𑆁, 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁, 𑆲𑆼𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆩𑇀, 𑆃𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆁 𑆖 𑆤𑆴𑆓𑇀𑆫𑆲𑆱𑇀𑆡𑆳𑆤𑆩𑇀𑇆𑇖𑇕𑇆
𑆅𑆠𑆴 𑆮𑆳𑆢𑆩𑆳𑆫𑇀𑆓𑆥𑆢𑆳𑆤𑆴 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇖𑇖𑇆
𑆮𑆳𑆢𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆨𑆴𑆰𑆘𑆳𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆾 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆼𑆠𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢 𑆍𑆮, 𑆤𑆳𑆤𑇀𑆪𑆠𑇀𑆫𑇅 𑆃𑆠𑇀𑆫 𑆲𑆴 𑆮𑆳𑆑𑇀𑆪𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆑𑇀𑆪𑆮𑆴𑆱𑇀𑆠𑆫𑆳𑆂 𑆑𑆼𑆮𑆬𑆳𑆯𑇀𑆖𑆾𑆥𑆥𑆠𑇀𑆠𑆪𑆂 𑆱𑆫𑇀𑆮𑆳𑆣𑆴𑆑𑆫𑆟𑆼𑆰𑆶𑇅 𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆂 𑆱𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆱𑆫𑇀𑆮𑆁 𑆮𑆳𑆑𑇀𑆪𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀, 𑆤𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆑𑆩𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆩𑆱𑆳𑆣𑆑𑆩𑆳𑆑𑆶𑆬𑆩𑆮𑇀𑆪𑆳𑆥𑆑𑆁 𑆮𑆳𑇅 𑆱𑆫𑇀𑆮𑆁 𑆖 𑆲𑆼𑆠𑆶𑆩𑆢𑇀𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀𑇅 𑆲𑆼𑆠𑆶𑆩𑆤𑇀𑆠𑆾 𑆲𑇀𑆪𑆑𑆬𑆶𑆰𑆳𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆮𑆳𑆢𑆮𑆴𑆓𑇀𑆫𑆲𑆳𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆑𑆳𑆫𑆟𑆨𑆷𑆠𑆳𑆂, 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆫𑇀𑆣𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱𑆫𑇀𑆮𑆳𑆫𑆩𑇀𑆨𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆲𑇀𑆪𑆳𑆮𑆲𑆠𑇀𑆪𑆤𑆶𑆥𑆲𑆠𑆳 𑆧𑆶𑆢𑇀𑆣𑆴𑆂𑇆𑇖𑇗𑇆
𑆅𑆩𑆳𑆤𑆴 𑆒𑆬𑆶 𑆠𑆳𑆮𑆢𑆴𑆲 𑆑𑆳𑆤𑆴𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆑𑆫𑆟𑆳𑆤𑆴 𑆨𑆴𑆰𑆘𑆳𑆁 𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆘𑇀𑆚𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆑𑆁 𑆲𑆴 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆁 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆲𑆴 𑆑𑆳𑆫𑆟-𑆑𑆫𑆟-𑆑𑆳𑆫𑇀𑆪𑆪𑆾𑆤𑆴-𑆑𑆳𑆫𑇀𑆪-𑆑𑆳𑆫𑇀𑆪𑆦𑆬𑆳𑆤𑆶𑆧𑆤𑇀𑆣-𑆢𑆼𑆯-𑆑𑆳𑆬-𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆤𑇀 𑆱𑆩𑇀𑆪𑆓𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆂 𑆑𑆳𑆫𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆳𑆮𑆴𑆰𑇀𑆛𑆦𑆬𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆑𑆳𑆫𑇀𑆪𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑇀𑆪𑆤𑆠𑆴𑆩𑆲𑆠𑆳 𑆪𑆠𑇀𑆤𑆼𑆤 𑆑𑆫𑇀𑆠𑆳𑇆𑇖𑇘𑇆
𑆠𑆠𑇀𑆫 𑆑𑆳𑆫𑆟𑆁 𑆤𑆳𑆩 𑆠𑆢𑇀 𑆪𑆠𑇀 𑆑𑆫𑆾𑆠𑆴, 𑆱 𑆍𑆮 𑆲𑆼𑆠𑆶𑆂, 𑆱 𑆑𑆫𑇀𑆠𑆳𑇆𑇖𑇙𑇆
𑆑𑆫𑆟𑆁 𑆥𑆶𑆤𑆱𑇀𑆠𑆢𑇀 𑆪𑆢𑆶𑆥𑆑𑆫𑆟𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆠𑆼 𑆑𑆫𑇀𑆠𑆶𑆂 𑆑𑆳𑆫𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆿 𑆥𑇀𑆫𑆪𑆠𑆩𑆳𑆤𑆱𑇀𑆪𑇆𑇗𑇐𑇆
𑆑𑆳𑆫𑇀𑆪𑆪𑆾𑆤𑆴𑆱𑇀𑆠𑆶 𑆱𑆳 𑆪𑆳 𑆮𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳 𑆑𑆳𑆫𑇀𑆪𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇗𑇑𑇆
𑆑𑆳𑆫𑇀𑆪𑆁 𑆠𑆶 𑆠𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆩𑆨𑆴𑆱𑆤𑇀𑆣𑆳𑆪 𑆑𑆫𑇀𑆠𑆳 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇗𑇒𑇆
𑆑𑆳𑆫𑇀𑆪𑆦𑆬𑆁 𑆥𑆶𑆤𑆱𑇀𑆠𑆢𑇀 𑆪𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆳 𑆑𑆳𑆫𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇗𑇓𑇆
𑆃𑆤𑆶𑆧𑆤𑇀𑆣𑆂 𑆒𑆬𑆶 𑆱 𑆪𑆂 𑆑𑆫𑇀𑆠𑆳𑆫𑆩𑆮𑆯𑇀𑆪𑆩𑆤𑆶𑆧𑆣𑇀𑆤𑆳𑆠𑆴 𑆑𑆳𑆫𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆑𑆳𑆫𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑆯𑆶𑆨𑆾 𑆮𑆳𑇁𑆥𑇀𑆪𑆯𑆶𑆨𑆾 𑆨𑆳𑆮𑆂𑇆𑇗𑇔𑇆
𑆢𑆼𑆯𑆱𑇀𑆠𑇀𑆮𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑇀𑇆𑇗𑇕𑇆
𑆑𑆳𑆬𑆂 𑆥𑆶𑆤𑆂 𑆥𑆫𑆴𑆟𑆳𑆩𑆂𑇆𑇗𑇖𑇆
𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆖𑆼𑆰𑇀𑆛𑆳 𑆑𑆳𑆫𑇀𑆪𑆳𑆫𑇀𑆡𑆳; 𑆱𑆽𑆮 𑆑𑇀𑆫𑆴𑆪𑆳, 𑆑𑆫𑇀𑆩, 𑆪𑆠𑇀𑆤𑆂, 𑆑𑆳𑆫𑇀𑆪𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆯𑇀𑆖𑇆𑇗𑇗𑇆
𑆇𑆥𑆳𑆪𑆂 𑆥𑆶𑆤𑆱𑇀𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆑𑆳𑆫𑆟𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆿𑆰𑇀𑆜𑆮𑆩𑆨𑆴𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆱𑆩𑇀𑆪𑆑𑇀 𑆑𑆳𑆫𑇀𑆪𑆑𑆳𑆫𑇀𑆪𑆦𑆬𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆤𑆳𑆁, 𑆑𑆳𑆫𑇀𑆪𑆳𑆟𑆳𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆑 𑆅𑆠𑇀𑆪𑆠𑆱𑇀𑆠𑆷𑆥𑆳𑆪𑆂 ; 𑆑𑆸𑆠𑆼 𑆤𑆾𑆥𑆳𑆪𑆳𑆫𑇀𑆡𑆾𑇁𑆱𑇀𑆠𑆴, 𑆤 𑆖 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑆠𑆢𑆳𑆠𑇀𑆮𑆼, 𑆑𑆸𑆠𑆳𑆖𑇀𑆖𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆦𑆬𑆁, 𑆦𑆬𑆳𑆖𑇀𑆖𑆳𑆤𑆶𑆧𑆤𑇀𑆣 𑆅𑆠𑆴𑇆𑇗𑇘𑇆
𑆍𑆠𑆢𑇀𑆢𑆯𑆮𑆴𑆣𑆩𑆓𑇀𑆫𑆼 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁, 𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆁 𑆑𑆳𑆫𑇀𑆪𑆳𑆫𑇀𑆡𑆳 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆛𑆳𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆑𑆳𑆫𑇀𑆪𑆁 𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆶𑆂 𑆥𑇀𑆫𑆳𑆑𑇀 𑆑𑆳𑆫𑇀𑆪𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆳𑆠𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆪𑆳 𑆑𑆼𑆮𑆬𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆑𑆫𑇀𑆩 𑆱𑆩𑆳𑆫𑆨𑆼𑆠 𑆑𑆫𑇀𑆠𑆶𑆩𑇀𑇆𑇗𑇙𑇆
𑆠𑆠𑇀𑆫 𑆖𑆼𑆢𑇀𑆨𑆴𑆰𑆓𑆨𑆴𑆰𑆓𑇀𑆮𑆳 𑆨𑆴𑆰𑆘𑆁 𑆑𑆯𑇀𑆖𑆴𑆢𑆼𑆮𑆁 𑆒𑆬𑆶 𑆥𑆸𑆖𑇀𑆗𑆼𑆢𑇀- 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆶𑆑𑆳𑆩𑆼𑆤 𑆨𑆴𑆰𑆘𑆳 𑆑𑆠𑆴𑆮𑆴𑆣𑆪𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆪𑆳 𑆑𑆠𑆴𑆮𑆴𑆣𑆩𑆼𑆮 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁, 𑆑𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆂, 𑆑𑆡𑆁 𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆂, 𑆑𑆴𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆳 𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆳, 𑆑𑇀𑆮 𑆖 𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆑𑇀𑆮 𑆖 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆪𑆾𑆓𑆼 𑆖 𑆑𑆴𑆁 𑆤𑆽𑆰𑇀𑆜𑆴𑆑𑆁, 𑆑𑆳𑆤𑆴 𑆖 𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆨𑆼𑆰𑆘𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆁 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆵𑆠𑆴𑇆𑇘𑇐𑇆
𑆱 𑆍𑆮𑆁 𑆥𑆸𑆰𑇀𑆛𑆾 𑆪𑆢𑆴 𑆩𑆾𑆲𑆪𑆴𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆼𑆠𑇀, 𑆧𑇀𑆫𑆷𑆪𑆳𑆢𑆼𑆤𑆁- 𑆧𑆲𑆶𑆮𑆴𑆣𑆳 𑆲𑆴 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆠𑆡𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆂, 𑆑𑆠𑆩𑆼𑆤 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆨𑆴𑆤𑇀𑆤𑆪𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆪𑆳 𑆑𑆼𑆤 𑆮𑆳 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆱𑇀𑆪 𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆨𑆼𑆢𑆳𑆓𑇀𑆫𑆁 𑆨𑆮𑆳𑆤𑇀 𑆥𑆸𑆖𑇀𑆗𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆩𑆳𑆤𑆁 ; 𑆤𑆼𑆢𑆳𑆤𑆵𑆁 𑆨𑆮𑆠𑆾𑇁𑆤𑇀𑆪𑆼𑆤 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆨𑆴𑆤𑇀𑆤𑆪𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆪𑆳𑇁𑆤𑇀𑆪𑆼𑆤 𑆮𑆳 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆱𑇀𑆪 𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆨𑆴𑆬𑆰𑆴𑆠𑆩𑆫𑇀𑆡𑆁 𑆯𑇀𑆫𑆾𑆠𑆶𑆩𑆲𑆩𑆤𑇀𑆪𑆼𑆤 𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆼𑆤𑆳𑆤𑇀𑆪𑆼𑆤 𑆮𑆳 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆨𑆴𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑆤𑇀𑆪𑆡𑆳𑇁𑇁𑆖𑆑𑇀𑆰𑆳𑆟 𑆅𑆖𑇀𑆗𑆳𑆁 𑆥𑆷𑆫𑆪𑆼𑆪𑆩𑆴𑆠𑆴𑇆𑇘𑇑𑇆
𑆱 𑆪𑆢𑆶𑆠𑇀𑆠𑆫𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀𑆠𑆠𑇀 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆁 𑆮𑆳𑆖𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆖 𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆮𑆴𑆣𑆴𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪; 𑆱𑆩𑇀𑆪𑆑𑇀 𑆪𑆢𑆴 𑆠𑆶 𑆧𑇀𑆫𑆷𑆪𑆳𑆤𑇀𑆤 𑆖𑆽𑆤𑆁 𑆩𑆾𑆲𑆪𑆴𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆼𑆠𑇀, 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆠𑆶 𑆮𑆖𑆤𑆑𑆳𑆬𑆁 𑆩𑆤𑇀𑆪𑆼𑆠, 𑆑𑆳𑆩𑆩𑆱𑇀𑆩𑆽 𑆧𑇀𑆫𑆷𑆪𑆳𑆢𑆳𑆥𑇀𑆠𑆩𑆼𑆮 𑆤𑆴𑆒𑆴𑆬𑆼𑆤𑇆𑇘𑇒𑇆
𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆠𑆶 𑆒𑆬𑆶 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆳𑆁- 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆁 𑆖𑇅 𑆍𑆠𑆢𑇀𑆣𑆴 𑆢𑇀𑆮𑆪𑆩𑆶𑆥𑆢𑆼𑆯𑆯𑇀𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆍𑆮𑆩𑆼𑆰𑆳 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆳, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆮𑆳 𑆱𑆲𑆾𑆥𑆢𑆼𑆯𑆼𑆤𑇆𑇘𑇓𑇆
𑆢𑆯𑆮𑆴𑆣𑆁 𑆠𑆶 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆑𑆳𑆫𑆟𑆳𑆢𑆴 𑆪𑆢𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆫𑆼, 𑆠𑆢𑆴𑆲 𑆨𑆴𑆰𑆓𑆳𑆢𑆴𑆰𑆶 𑆱𑆁𑆱𑆳𑆫𑇀𑆪 𑆱𑆤𑇀𑆢𑆫𑇀𑆯𑆪𑆴𑆰𑇀𑆪𑆳𑆩𑆂- 𑆅𑆲 𑆑𑆳𑆫𑇀𑆪𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆿 𑆑𑆳𑆫𑆟𑆁 𑆨𑆴𑆰𑆑𑇀, 𑆑𑆫𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆨𑆼𑆰𑆘𑆁, 𑆑𑆳𑆫𑇀𑆪𑆪𑆾𑆤𑆴𑆫𑇀𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆁, 𑆑𑆳𑆫𑇀𑆪𑆁 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁, 𑆑𑆳𑆫𑇀𑆪𑆦𑆬𑆁 𑆱𑆶𑆒𑆳𑆮𑆳𑆥𑇀𑆠𑆴𑆂, 𑆃𑆤𑆶𑆧𑆤𑇀𑆣𑆂 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆂, 𑆢𑆼𑆯𑆾 𑆨𑆷𑆩𑆴𑆫𑆳𑆠𑆶𑆫𑆯𑇀𑆖, 𑆑𑆳𑆬𑆂 𑆥𑆶𑆤𑆂 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆯𑇀𑆖𑆳𑆠𑆶𑆫𑆳𑆮𑆱𑇀𑆡𑆳 𑆖, 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆂, 𑆇𑆥𑆳𑆪𑆱𑇀𑆠𑆶 𑆨𑆴𑆰𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆿𑆰𑇀𑆜𑆮𑆩𑆨𑆴𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆱𑆩𑇀𑆪𑆑𑇀𑇅 𑆅𑆲𑆳𑆥𑇀𑆪𑆱𑇀𑆪𑆾𑆥𑆳𑆪𑆱𑇀𑆪 𑆮𑆴𑆰𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑆽𑆮𑆾𑆥𑆳𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂𑇅 𑆅𑆠𑆴 𑆑𑆳𑆫𑆟𑆳𑆢𑆵𑆤𑆴 𑆢𑆯 𑆢𑆯𑆱𑆶 𑆨𑆴𑆰𑆓𑆳𑆢𑆴𑆰𑆶 𑆱𑆁𑆱𑆳𑆫𑇀𑆪 𑆱𑆤𑇀𑆢𑆫𑇀𑆯𑆴𑆠𑆳𑆤𑆴, 𑆠𑆡𑆽𑆮𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆽𑆠𑆢𑇀𑆢𑆯𑆮𑆴𑆣𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆩𑆶𑆑𑇀𑆠𑆁 𑆖𑇆𑇘𑇔𑇆
𑆠𑆱𑇀𑆪 𑆪𑆾 𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆾 𑆪𑆡𑆳 𑆪𑆡𑆳 𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆂, 𑆱 𑆠𑆡𑆳 𑆠𑆡𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆠𑆼𑇆𑇘𑇕𑇆
𑆑𑆳𑆫𑆟𑆁 𑆨𑆴𑆰𑆓𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆫𑆼, 𑆠𑆱𑇀𑆪 𑆥𑆫𑆵𑆑𑇀𑆰𑆳- 𑆨𑆴𑆰𑆕𑇀𑆤𑆳𑆩 𑆪𑆾 𑆨𑆴𑆰𑆘𑇀𑆪𑆠𑆴, 𑆪𑆂 𑆱𑆷𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆥𑇀𑆫𑆪𑆾𑆓𑆑𑆶𑆯𑆬𑆂, 𑆪𑆱𑇀𑆪 𑆖𑆳𑆪𑆶𑆂 𑆱𑆫𑇀𑆮𑆡𑆳 𑆮𑆴𑆢𑆴𑆠𑆁 𑆪𑆡𑆳𑆮𑆠𑇀𑇅 𑆱 𑆖 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁 𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆤𑇀𑆤𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆼𑆮𑆳𑆢𑆴𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆓𑆶𑆟𑆴𑆰𑆶 𑆓𑆶𑆟𑆠𑆂 𑆑𑆳𑆫𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆥𑆯𑇀𑆪𑆤𑇀, 𑆑𑆖𑇀𑆖𑆴𑆢𑆲𑆩𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆱𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑆼 𑆱𑆩𑆫𑇀𑆡𑆾 𑆤 𑆮𑆼𑆠𑆴; 𑆠𑆠𑇀𑆫𑆼𑆩𑆼 𑆨𑆴𑆰𑆓𑇀𑆓𑆶𑆟𑆳 𑆪𑆽𑆫𑆶𑆥𑆥𑆤𑇀𑆤𑆾 𑆨𑆴𑆰𑆓𑇀𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑆼 𑆱𑆩𑆫𑇀𑆡𑆾 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆫𑇀𑆪𑆮𑆢𑆳𑆠𑆯𑇀𑆫𑆶𑆠𑆠𑆳, 𑆥𑆫𑆴𑆢𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆠𑆳, 𑆢𑆳𑆑𑇀𑆰𑇀𑆪𑆁, 𑆯𑆿𑆖𑆁, 𑆘𑆴𑆠𑆲𑆱𑇀𑆠𑆠𑆳, 𑆇𑆥𑆑𑆫𑆟𑆮𑆠𑇀𑆠𑆳, 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆠𑆳, 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆘𑇀𑆚𑆠𑆳, 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆘𑇀𑆚𑆳𑆠𑆳 𑆖𑆼𑆠𑆴𑇆𑇘𑇖𑇆
𑆑𑆫𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆨𑆼𑆰𑆘𑆁 𑆤𑆳𑆩 𑆠𑆢𑇀𑆪𑆢𑆶𑆥𑆑𑆫𑆟𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆠𑆼 𑆨𑆴𑆰𑆘𑆾 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆿 𑆥𑇀𑆫𑆪𑆠𑆩𑆳𑆤𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆾𑆥𑆳𑆪𑆳𑆤𑇀𑆠𑆼𑆨𑇀𑆪𑆂𑇅 𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆨𑆼𑆢𑆳𑆠𑇀- 𑆢𑆽𑆮𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁, 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁 𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆢𑆽𑆮𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁- 𑆩𑆤𑇀𑆠𑇀𑆫𑆿𑆰𑆣𑆴𑆩𑆟𑆴𑆩𑆕𑇀𑆓𑆬𑆧𑆬𑇀𑆪𑆶𑆥𑆲𑆳𑆫𑆲𑆾𑆩𑆤𑆴𑆪𑆩𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆾𑆥𑆮𑆳𑆱𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆪𑆤𑆥𑇀𑆫𑆟𑆴𑆥𑆳𑆠𑆓𑆩𑆤𑆳𑆢𑆴, 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁- 𑆱𑆁𑆯𑆾𑆣𑆤𑆾𑆥𑆯𑆩𑆤𑆼 𑆖𑆼𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆢𑆸𑆰𑇀𑆛𑆦𑆬𑆳𑆂𑇅 𑆍𑆠𑆖𑇀𑆖𑆽𑆮 𑆨𑆼𑆰𑆘𑆩𑆕𑇀𑆓𑆨𑆼𑆢𑆳𑆢𑆥𑆴 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁- 𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆷𑆠𑆩𑆂, 𑆃𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆷𑆠𑆁 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆪𑆢𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆷𑆠𑆁 𑆠𑆢𑆶𑆥𑆳𑆪𑆳𑆨𑆴𑆥𑇀𑆬𑆶𑆠𑆩𑇀𑇅 𑆇𑆥𑆳𑆪𑆾 𑆤𑆳𑆩 𑆨𑆪𑆢𑆫𑇀𑆯𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆥𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆫𑆟𑆑𑇀𑆰𑆾𑆨𑆟𑆲𑆫𑇀𑆰𑆟𑆨𑆫𑇀𑆠𑇀𑆱𑆤𑆮𑆣𑆧𑆤𑇀𑆣𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆢𑆴𑆫𑆩𑆷𑆫𑇀𑆠𑆾 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆾 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆂 𑆱𑆴𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆯𑇀𑆖𑆾𑆥𑆳𑆪𑆳𑆨𑆴𑆥𑇀𑆬𑆶𑆠𑆳 𑆅𑆠𑆴𑇅 𑆪𑆠𑇀𑆠𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆷𑆠𑆁 𑆠𑆢𑇀𑆮𑆩𑆤𑆳𑆢𑆴𑆰𑆶 𑆪𑆾𑆓𑆩𑆶𑆥𑆽𑆠𑆴𑇅 𑆠𑆱𑇀𑆪𑆳𑆥𑆵𑆪𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆳- 𑆅𑆢𑆩𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆽𑆮𑆕𑇀𑆓𑆶𑆟𑆩𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆨𑆳𑆮𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆢𑆼𑆯𑆼 𑆘𑆳𑆠𑆩𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆸𑆠𑆳𑆮𑆼𑆮𑆁 𑆓𑆸𑆲𑆵𑆠𑆩𑆼𑆮𑆁 𑆤𑆴𑆲𑆴𑆠𑆩𑆼𑆮𑆩𑆶𑆥𑆱𑇀𑆑𑆸𑆠𑆩𑆤𑆪𑆳 𑆖 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆪𑆶𑆑𑇀𑆠𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆳𑆮𑆼𑆮𑆁𑆮𑆴𑆣𑆱𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆽𑆮𑆠𑆳𑆮𑆤𑇀𑆠𑆁 𑆢𑆾𑆰𑆩𑆥𑆑𑆫𑇀𑆰𑆠𑇀𑆪𑆶𑆥𑆯𑆩𑆪𑆠𑆴 𑆮𑆳, 𑆪𑆢𑆤𑇀𑆪𑆢𑆥𑆴 𑆖𑆽𑆮𑆁𑆮𑆴𑆣𑆁 𑆨𑆼𑆰𑆘𑆁 𑆨𑆮𑆼𑆠𑇀𑆠𑆖𑇀𑆖𑆳𑆤𑆼𑆤 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆪𑆶𑆑𑇀𑆠𑆩𑆴𑆠𑆴𑇆𑇘𑇗𑇆
𑆑𑆳𑆫𑇀𑆪𑆪𑆾𑆤𑆴𑆫𑇀𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆁, 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆓𑆩𑆂𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆠𑇀𑆮𑆱𑇀𑆪 𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆑𑆸𑆠𑆼𑆯𑇀𑆖𑆽𑆮𑆾𑆤𑆳𑆠𑆴𑆫𑆴𑆑𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆁 𑆮𑆴𑆑𑆳𑆫𑆱𑇀𑆪 𑆖 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆩𑆸𑆢𑆶𑆢𑆳𑆫𑆶𑆟𑆬𑆴𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑆴𑆠𑆴𑇆𑇘𑇘𑇆
𑆑𑆳𑆫𑇀𑆪𑆁 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁, 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆴𑆑𑆳𑆫𑆾𑆥𑆯𑆩𑆂𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆠𑇀𑆮𑆱𑇀𑆪- 𑆫𑆶𑆓𑆶𑆥𑆯𑆩𑆤𑆁, 𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆪𑆾𑆓𑆂, 𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆂, 𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆴𑆂, 𑆃𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆫𑆶𑆖𑆴𑆫𑆳𑆲𑆳𑆫𑆑𑆳𑆬𑆼, 𑆃𑆨𑇀𑆪𑆮𑆲𑆸𑆠𑆱𑇀𑆪 𑆖𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆑𑆳𑆬𑆼 𑆱𑆩𑇀𑆪𑆓𑇀𑆘𑆫𑆟𑆁, 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆳𑆨𑆾 𑆪𑆡𑆳𑆑𑆳𑆬𑆁, 𑆮𑆽𑆑𑆳𑆫𑆴𑆟𑆳𑆁 𑆖 𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆤𑆳𑆩𑆢𑆫𑇀𑆯𑆤𑆁, 𑆱𑆶𑆒𑆼𑆤 𑆖 𑆥𑇀𑆫𑆠𑆴𑆧𑆾𑆣𑆤𑆁, 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆱𑆳𑆁 𑆩𑆶𑆑𑇀𑆠𑆴𑆂, 𑆱𑆫𑇀𑆮𑆳𑆑𑆳𑆫𑆽𑆫𑇀𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖𑆳𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆴𑆫𑆴𑆠𑆴𑇆𑇘𑇙𑇆
𑆑𑆳𑆫𑇀𑆪𑆦𑆬𑆁 𑆱𑆶𑆒𑆳𑆮𑆳𑆥𑇀𑆠𑆴𑆂, 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁- 𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆯𑆫𑆵𑆫𑆠𑆶𑆰𑇀𑆛𑆴𑆂𑇆𑇙𑇐𑇆
𑆃𑆤𑆶𑆧𑆤𑇀𑆣𑆱𑇀𑆠𑆶 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆂, 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁- 𑆥𑇀𑆫𑆳𑆟𑆽𑆂 𑆱𑆲 𑆱𑆁𑆪𑆾𑆓𑆂𑇆𑇙𑇑𑇆
𑆢𑆼𑆯𑆱𑇀𑆠𑆶 𑆨𑆷𑆩𑆴𑆫𑆳𑆠𑆶𑆫𑆯𑇀𑆖𑇆𑇙𑇒𑇆
𑆠𑆠𑇀𑆫 𑆨𑆷𑆩𑆴𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆄𑆠𑆶𑆫𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆫𑇀𑆮𑆳 𑆱𑇀𑆪𑆳𑆢𑆿𑆰𑆣𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆫𑇀𑆮𑆳𑇅 𑆠𑆠𑇀𑆫 𑆠𑆳𑆮𑆢𑆴𑆪𑆩𑆳𑆠𑆶𑆫𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆪𑆁 𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆨𑆷𑆩𑆴𑆢𑆼𑆯𑆼 𑆘𑆳𑆠𑆂 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆾 𑆮𑆳; 𑆠𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆨𑆷𑆩𑆴𑆢𑆼𑆯𑆼 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆩𑆴𑆢𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆩𑇀, 𑆅𑆢𑆁 𑆮𑆴𑆲𑆳𑆫𑆘𑆳𑆠𑆩𑇀, 𑆅𑆢𑆩𑆳𑆖𑆳𑆫𑆘𑆳𑆠𑆩𑇀, 𑆍𑆠𑆳𑆮𑆖𑇀𑆖 𑆧𑆬𑆩𑇀, 𑆍𑆮𑆁𑆮𑆴𑆣𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑇀, 𑆍𑆮𑆁𑆮𑆴𑆣𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑇀, 𑆍𑆮𑆁𑆮𑆴𑆣𑆾 𑆢𑆾𑆰𑆂, 𑆨𑆑𑇀𑆠𑆴𑆫𑆴𑆪𑆩𑇀, 𑆅𑆩𑆼 𑆮𑇀𑆪𑆳𑆣𑆪𑆂, 𑆲𑆴𑆠𑆩𑆴𑆢𑆩𑇀, 𑆃𑆲𑆴𑆠𑆩𑆴𑆢𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑇀𑆫𑆲𑆟𑆼𑆤 𑇅 𑆐𑆰𑆣𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆱𑇀𑆠𑆶 𑆑𑆬𑇀𑆥𑆼𑆰𑆶 𑆨𑆷𑆩𑆴𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇙𑇓𑇆
𑆄𑆠𑆶𑆫𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆑𑆳𑆫𑇀𑆪𑆢𑆼𑆯𑆂𑇅 𑆠𑆱𑇀𑆪 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆄𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆫𑇀𑆮𑆳 𑆱𑇀𑆪𑆳𑆢𑇀, 𑆧𑆬𑆢𑆾𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆫𑇀𑆮𑆳𑇅 𑆠𑆠𑇀𑆫 𑆠𑆳𑆮𑆢𑆴𑆪𑆁 𑆧𑆬𑆢𑆾𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆂; 𑆢𑆾𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑆶𑆫𑆷𑆥𑆾 𑆲𑆴 𑆨𑆼𑆰𑆘𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆧𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆯𑆼𑆰𑆳𑆥𑆼𑆑𑇀𑆰𑆾 𑆨𑆮𑆠𑆴𑇅 𑆱𑆲𑆱𑆳 𑆲𑇀𑆪𑆠𑆴𑆧𑆬𑆩𑆿𑆰𑆣𑆩𑆥𑆫𑆵𑆑𑇀𑆰𑆑𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆩𑆬𑇀𑆥𑆧𑆬𑆩𑆳𑆠𑆶𑆫𑆩𑆠𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀; 𑆤 𑆲𑇀𑆪𑆠𑆴𑆧𑆬𑆳𑆤𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆮𑆳𑆪𑆮𑆵𑆪𑆳𑆤𑇀𑆪𑆿𑆰𑆣𑆳𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑆳 𑆯𑆑𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆬𑇀𑆥𑆧𑆬𑆽𑆂 𑆱𑆾𑆞𑆶𑆩𑇀; 𑆃𑆱𑆲𑇀𑆪𑆳𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆮𑆼𑆓𑆠𑇀𑆮𑆳𑆢𑇀𑆣𑆴𑆠𑆳𑆤𑆴 𑆱𑆢𑇀𑆪𑆂𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆱𑇀𑆪𑆶𑆂𑇅 𑆍𑆠𑆖𑇀𑆖𑆽𑆮 𑆑𑆳𑆫𑆟𑆩𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆳 𑆲𑆵𑆤𑆧𑆬𑆩𑆳𑆠𑆶𑆫𑆩𑆮𑆴𑆰𑆳𑆢𑆑𑆫𑆽𑆫𑇀𑆩𑆸𑆢𑆶𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆥𑇀𑆫𑆳𑆪𑆽𑆫𑆶𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆓𑆶𑆫𑆶𑆨𑆴𑆫𑆮𑆴𑆨𑇀𑆫𑆩𑆽𑆫𑆤𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆽𑆯𑇀𑆖𑆾𑆥𑆖𑆫𑆤𑇀𑆠𑇀𑆪𑆿𑆰𑆣𑆽𑆂; 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖 𑆤𑆳𑆫𑆵𑆂, 𑆠𑆳 𑆲𑇀𑆪𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆸𑆢𑆶𑆮𑆴𑆮𑆸𑆠𑆮𑆴𑆑𑇀𑆬𑆮𑆲𑆸𑆢𑆪𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆂 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆾𑇁𑆧𑆬𑆳𑆂 𑆥𑆫𑆱𑆁𑆱𑇀𑆠𑆨𑇀𑆪𑆳𑆯𑇀𑆖𑇅 𑆠𑆡𑆳 𑆧𑆬𑆮𑆠𑆴 𑆧𑆬𑆮𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆴𑆓𑆠𑆼 𑆱𑇀𑆮𑆬𑇀𑆥𑆧𑆬𑆩𑆿𑆰𑆣𑆩𑆥𑆫𑆵𑆑𑇀𑆰𑆑𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆩𑆱𑆳𑆣𑆑𑆩𑆼𑆮 𑆨𑆮𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆠𑆶𑆫𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆠𑆯𑇀𑆖, 𑆮𑆴𑆑𑆸𑆠𑆴𑆠𑆯𑇀𑆖, 𑆱𑆳𑆫𑆠𑆯𑇀𑆖, 𑆱𑆁𑆲𑆤𑆤𑆠𑆯𑇀𑆖, 𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆯𑇀𑆖, 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆯𑇀𑆖, 𑆱𑆠𑇀𑆠𑇀𑆮𑆠𑆯𑇀𑆖, 𑆄𑆲𑆳𑆫𑆯𑆑𑇀𑆠𑆴𑆠𑆯𑇀𑆖, 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆠𑆴𑆠𑆯𑇀𑆖, 𑆮𑆪𑆱𑇀𑆠𑆯𑇀𑆖𑆼𑆠𑆴, 𑆧𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆯𑆼𑆰𑆓𑇀𑆫𑆲𑆟𑆲𑆼𑆠𑆾𑆂𑇆𑇙𑇔𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑆵𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁, 𑆑𑆳𑆬𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁, 𑆄𑆠𑆶𑆫𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁, 𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆖 𑆓𑆫𑇀𑆨𑆯𑆫𑆵𑆫𑆩𑆥𑆼𑆑𑇀𑆰𑆠𑆼𑇅 𑆍𑆠𑆳𑆤𑆴 𑆲𑆴 𑆪𑆼𑆤 𑆪𑆼𑆤 𑆢𑆾𑆰𑆼𑆟𑆳𑆣𑆴𑆑𑆼𑆤𑆽𑆑𑆼𑆤𑆳𑆤𑆼𑆑𑆼𑆤 𑆮𑆳 𑆱𑆩𑆤𑆶𑆧𑆣𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆼𑆤 𑆠𑆼𑆤 𑆢𑆾𑆰𑆼𑆟 𑆓𑆫𑇀𑆨𑆾𑇁𑆤𑆶𑆧𑆣𑇀𑆪𑆠𑆼; 𑆠𑆠𑆂 𑆱𑆳 𑆱𑆳 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆫𑇀𑆨𑆳𑆢𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆳𑇅 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆂 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆮𑆳𑆠𑆬𑆳𑆂 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆂 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆱𑆩𑆣𑆳𑆠𑆮𑆂 𑆑𑆼𑆖𑆴𑆢𑇀𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆁 𑆲𑆴 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇙𑇕𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆲𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆱𑆳𑆫𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆤𑇀𑆢𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆓𑆶𑆫𑆶𑆯𑆵𑆠𑆮𑆴𑆘𑇀𑆘𑆬𑆳𑆖𑇀𑆗𑆂𑇅 𑆠𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆕𑇀𑆓𑆳𑆂, 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆕𑇀𑆓𑆳𑆂, 𑆩𑆸𑆢𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑆴𑆱𑆶𑆒𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆮𑆢𑆳𑆠𑆓𑆳𑆠𑇀𑆫𑆳𑆂, 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆷𑆠𑆯𑆶𑆑𑇀𑆫𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆥𑆠𑇀𑆪𑆳𑆂, 𑆱𑆳𑆫𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆳𑆫𑆱𑆁𑆲𑆠𑆱𑇀𑆡𑆴𑆫𑆯𑆫𑆵𑆫𑆳𑆂, 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆠𑇀𑆮𑆳𑆢𑆶𑆥𑆖𑆴𑆠𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆳𑆂, 𑆩𑆤𑇀𑆢𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆖𑆼𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆮𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆂, 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆳𑆢𑆯𑆵𑆔𑇀𑆫𑆳𑆫𑆩𑇀𑆨𑆑𑇀𑆰𑆾𑆨𑆮𑆴𑆑𑆳𑆫𑆳𑆂, 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆳𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆴𑆠𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆓𑆠𑆪𑆂, 𑆯𑆽𑆠𑇀𑆪𑆳𑆢𑆬𑇀𑆥𑆑𑇀𑆰𑆶𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆱𑆤𑇀𑆠𑆳𑆥𑆱𑇀𑆮𑆼𑆢𑆢𑆾𑆰𑆳𑆂, 𑆮𑆴𑆘𑇀𑆘𑆬𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆶𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆱𑆳𑆫𑆱𑆤𑇀𑆣𑆴𑆧𑆤𑇀𑆣𑆤𑆳𑆂, 𑆠𑆡𑆳𑇁𑆖𑇀𑆗𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆢𑆫𑇀𑆯𑆤𑆳𑆤𑆤𑆳𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆪𑆾𑆓𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆮𑆱𑆶𑆩𑆤𑇀𑆠𑆾 𑆮𑆴𑆢𑇀𑆪𑆳𑆮𑆤𑇀𑆠 𑆏𑆘𑆱𑇀𑆮𑆴𑆤𑆂 𑆯𑆳𑆤𑇀𑆠𑆳 𑆄𑆪𑆶𑆰𑇀𑆩𑆤𑇀𑆠𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇙𑇖𑇆
𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑇀𑆫𑆮𑆁 𑆮𑆴𑆱𑇀𑆫𑆩𑆩𑇀𑆬𑆁 𑆑𑆛𑆶𑆑𑆚𑇀𑆖𑇅 𑆠𑆱𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆬𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆱𑆲𑆳, 𑆇𑆰𑇀𑆟𑆩𑆶𑆒𑆳𑆂, 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆮𑆢𑆳𑆠𑆓𑆳𑆠𑇀𑆫𑆳𑆂 , 𑆥𑇀𑆫𑆨𑆷𑆠𑆮𑆴𑆥𑇀𑆬𑆶𑆮𑇀𑆪𑆕𑇀𑆓𑆠𑆴𑆬𑆥𑆴𑆝𑆑𑆳𑆂, 𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆳𑆮𑆤𑇀𑆠𑆂, 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆢𑆾𑆰𑆳𑆂, 𑆥𑇀𑆫𑆳𑆪𑆾𑆩𑆸𑆢𑇀𑆮𑆬𑇀𑆥𑆑𑆥𑆴𑆬𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆬𑆾𑆩𑆑𑆼𑆯𑆳𑆯𑇀𑆖; 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆳𑆂, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑆪𑆂, 𑆥𑇀𑆫𑆨𑆷𑆠𑆳𑆯𑆤𑆥𑆳𑆤𑆳𑆂, 𑆑𑇀𑆬𑆼𑆯𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆮𑆾, 𑆢𑆤𑇀𑆢𑆯𑆷𑆑𑆳𑆂; 𑆢𑇀𑆫𑆮𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆴𑆡𑆴𑆬𑆩𑆸𑆢𑆶𑆱𑆤𑇀𑆣𑆴𑆩𑆳𑆁𑆱𑆳𑆂, 𑆥𑇀𑆫𑆨𑆷𑆠𑆱𑆸𑆰𑇀𑆛𑆱𑇀𑆮𑆼𑆢𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆯𑇀𑆖; 𑆮𑆴𑆱𑇀𑆫𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆷𑆠𑆥𑆷𑆠𑆴𑆑𑆑𑇀𑆰𑆳𑆱𑇀𑆪𑆯𑆴𑆫𑆂𑆯𑆫𑆵𑆫𑆓𑆤𑇀𑆣𑆳𑆂; 𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆠𑇀𑆮𑆳𑆢𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆥𑆠𑇀𑆪𑆳𑆂; 𑆠 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆪𑆾𑆓𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆬𑆳 𑆩𑆣𑇀𑆪𑆧𑆬𑆳 𑆩𑆣𑇀𑆪𑆳𑆪𑆶𑆰𑆾 𑆩𑆣𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆠𑇀𑆠𑆾𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇙𑇗𑇆
𑆮𑆳𑆠𑆱𑇀𑆠𑆶 𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆖𑆬𑆧𑆲𑆶𑆯𑆵𑆔𑇀𑆫𑆯𑆵𑆠𑆥𑆫𑆶𑆰𑆮𑆴𑆯𑆢𑆂𑇅 𑆠𑆱𑇀𑆪 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆬𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆥𑆖𑆴𑆠𑆳𑆬𑇀𑆥𑆯𑆫𑆵𑆫𑆳𑆂 𑆥𑇀𑆫𑆠𑆠𑆫𑆷𑆑𑇀𑆰𑆑𑇀𑆰𑆳𑆩𑆱𑆤𑇀𑆤𑆱𑆑𑇀𑆠𑆘𑆫𑇀𑆘𑆫𑆱𑇀𑆮𑆫𑆳 𑆘𑆳𑆓𑆫𑆷𑆑𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆬𑇀𑆬𑆔𑆶𑆖𑆥𑆬𑆓𑆠𑆴𑆖𑆼𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆮𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆂, 𑆖𑆬𑆠𑇀𑆮𑆳𑆢𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆱𑆤𑇀𑆣𑇀𑆪𑆑𑇀𑆰𑆴𑆨𑇀𑆫𑆷𑆲𑆤𑇀𑆮𑆾𑆰𑇀𑆜𑆘𑆴𑆲𑇀𑆮𑆳𑆯𑆴𑆫𑆂𑆱𑇀𑆑𑆤𑇀𑆣𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆳𑆂, 𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆲𑆶𑆥𑇀𑆫𑆬𑆳𑆥𑆑𑆟𑇀𑆝𑆫𑆳𑆱𑆴𑆫𑆳𑆥𑇀𑆫𑆠𑆳𑆤𑆳𑆂, 𑆯𑆵𑆔𑇀𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑇀𑆫𑆵𑆔𑇀𑆫𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆑𑇀𑆰𑆾𑆨𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆯𑆵𑆔𑇀𑆫𑆠𑇀𑆫𑆳𑆱𑆫𑆳𑆓𑆮𑆴𑆫𑆳𑆓𑆳𑆂 𑆯𑇀𑆫𑆶𑆠𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑆾𑇁𑆬𑇀𑆥𑆱𑇀𑆩𑆸𑆠𑆪𑆯𑇀𑆖, 𑆯𑆽𑆠𑇀𑆪𑆳𑆖𑇀𑆗𑆵𑆠𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆮𑆂 𑆥𑇀𑆫𑆠𑆠𑆯𑆵𑆠𑆑𑆾𑆢𑇀𑆮𑆼𑆥𑆑𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆂, 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆳𑆠𑇀 𑆥𑆫𑆶𑆰𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆫𑆾𑆩𑆤𑆒𑆢𑆯𑆤𑆮𑆢𑆤𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆳𑆂, 𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆂 𑆱𑆠𑆠𑆱𑆤𑇀𑆣𑆴𑆯𑆧𑇀𑆢𑆓𑆳𑆩𑆴𑆤𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆳𑆠𑆬𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆳𑆬𑇀𑆥𑆧𑆬𑆳𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆳𑆪𑆶𑆰𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆳𑆥𑆠𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆱𑆳𑆣𑆤𑆳𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆣𑆤𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇙𑇘𑇆
𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆳𑆂𑇆𑇙𑇙𑇆
𑆱𑆫𑇀𑆮𑆓𑆶𑆟𑆱𑆩𑆶𑆢𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆱𑆩𑆣𑆳𑆠𑆮𑆂𑇅 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠𑇆𑇑𑇐𑇐𑇆
𑆮𑆴𑆑𑆸𑆠𑆴𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑆮𑆴𑆑𑆳𑆫𑆂𑇅 𑆠𑆠𑇀𑆫 𑆮𑆴𑆑𑆳𑆫𑆁 𑆲𑆼𑆠𑆶-𑆢𑆾𑆰-𑆢𑆷𑆰𑇀𑆪-𑆥𑇀𑆫𑆑𑆸𑆠𑆴-𑆢𑆼𑆯-𑆑𑆳𑆬-𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆠𑆯𑇀𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠, 𑆤 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆲𑆼𑆠𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆾𑆥𑆬𑆧𑇀𑆣𑆴𑆂𑇅 𑆪𑆱𑇀𑆪 𑆲𑆴 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆢𑆾𑆰-𑆢𑆷𑆰𑇀𑆪-𑆥𑇀𑆫𑆑𑆸𑆠𑆴-𑆢𑆼𑆯-𑆑𑆳𑆬-𑆧𑆬𑆱𑆳𑆩𑇀𑆪𑆁 𑆨𑆮𑆠𑆴, 𑆩𑆲𑆖𑇀𑆖 𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆧𑆬𑆁, 𑆱 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑇀𑆧𑆬𑆮𑆳𑆤𑇀 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆖𑇀𑆖𑆳𑆬𑇀𑆥𑆧𑆬𑆂; 𑆩𑆣𑇀𑆪𑆧𑆬𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆢𑇀𑆣𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆩𑆣𑇀𑆪𑆧𑆬𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇑𑇆
𑆱𑆳𑆫𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆳𑆫𑆳𑆟𑇀𑆪𑆰𑇀𑆛𑆿 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆁 𑆧𑆬𑆩𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑇀𑆮𑆓𑇀𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆯𑆶𑆑𑇀𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆵𑆠𑆴𑇆𑇑𑇐𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆩𑆸𑆢𑆶𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆬𑇀𑆥𑆓𑆩𑇀𑆨𑆵𑆫𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆬𑆾𑆩𑆳 𑆱𑆥𑇀𑆫𑆨𑆼𑆮 𑆖 𑆠𑇀𑆮𑆑𑇀 𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇅 𑆱𑆳 𑆱𑆳𑆫𑆠𑆳 𑆱𑆶𑆒𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆾𑆥𑆨𑆾𑆓𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆴𑆢𑇀𑆪𑆳𑆫𑆾𑆓𑇀𑆪𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆳𑆪𑆶𑆰𑇀𑆪𑆠𑇀𑆮𑆁 𑆖𑆳𑆖𑆰𑇀𑆛𑆼𑇆𑇑𑇐𑇓𑇆
𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆩𑆶𑆒𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆳𑆱𑆿𑆰𑇀𑆜𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆤𑆒𑆬𑆬𑆳𑆛𑆩𑆼𑆲𑆤𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆑𑇀𑆠𑆮𑆫𑇀𑆟𑆁 𑆯𑇀𑆫𑆵𑆩𑆢𑇀𑆨𑇀𑆫𑆳𑆘𑆴𑆰𑇀𑆟𑆶 𑆫𑆑𑇀𑆠𑆱𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇅 𑆱𑆳 𑆱𑆳𑆫𑆠𑆳 𑆱𑆶𑆒𑆩𑆶𑆢𑇀𑆣𑆠𑆳𑆁 𑆩𑆼𑆣𑆳𑆁 𑆩𑆤𑆱𑇀𑆮𑆴𑆠𑇀𑆮𑆁 𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆩𑆤𑆠𑆴𑆧𑆬𑆩𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆩𑆶𑆰𑇀𑆟𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆁 𑆖𑆳𑆖𑆰𑇀𑆛𑆼𑇆𑇑𑇐𑇔𑇆
𑆯𑆕𑇀𑆒𑆬𑆬𑆳𑆛𑆑𑆸𑆑𑆳𑆛𑆴𑆑𑆳𑆑𑇀𑆰𑆴𑆓𑆟𑇀𑆝𑆲𑆤𑆶𑆓𑇀𑆫𑆵𑆮𑆳𑆱𑇀𑆑𑆤𑇀𑆣𑆾𑆢𑆫𑆑𑆑𑇀𑆰𑆮𑆑𑇀𑆰𑆂𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆱𑆤𑇀𑆣𑆪𑆂 𑆱𑇀𑆡𑆴𑆫𑆓𑆶𑆫𑆶𑆯𑆶𑆨𑆩𑆳𑆁𑆱𑆾𑆥𑆖𑆴𑆠𑆳 𑆩𑆳𑆁𑆱𑆱𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇅 𑆱𑆳 𑆱𑆳𑆫𑆠𑆳 𑆑𑇀𑆰𑆩𑆳𑆁 𑆣𑆸𑆠𑆴𑆩𑆬𑆿𑆬𑇀𑆪𑆁 𑆮𑆴𑆠𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆁 𑆱𑆶𑆒𑆩𑆳𑆫𑇀𑆘𑆮𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆧𑆬𑆩𑆳𑆪𑆶𑆯𑇀𑆖 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆖𑆰𑇀𑆛𑆼𑇆𑇑𑇐𑇕𑇆
𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆤𑆼𑆠𑇀𑆫𑆑𑆼𑆯𑆬𑆾𑆩𑆤𑆒𑆢𑆤𑇀𑆠𑆿𑆰𑇀𑆜𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆼𑆰𑆶 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆾 𑆩𑆼𑆢𑆂𑆱𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇅 𑆱𑆳 𑆱𑆳𑆫𑆠𑆳 𑆮𑆴𑆠𑇀𑆠𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆱𑆶𑆒𑆾𑆥𑆨𑆾𑆓𑆥𑇀𑆫𑆢𑆳𑆤𑆳𑆤𑇀𑆪𑆳𑆫𑇀𑆘𑆮𑆁 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆠𑆳𑆁 𑆖𑆳 𑆖𑆰𑇀𑆛𑆼𑇆𑇑𑇐𑇖𑇆
𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑆴𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑇀𑆮𑆫𑆠𑇀𑆤𑆴𑆘𑆠𑇀𑆫𑆶𑆖𑆴𑆧𑆶𑆑𑆯𑆴𑆫𑆂𑆥𑆫𑇀𑆮𑆱𑇀𑆡𑆷𑆬𑆳𑆂 𑆱𑇀𑆡𑆷𑆬𑆳𑆱𑇀𑆡𑆴𑆤𑆒𑆢𑆤𑇀𑆠𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆡𑆴𑆱𑆳𑆫𑆳𑆂𑇅 𑆠𑆼 𑆩𑆲𑆾𑆠𑇀𑆱𑆳𑆲𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳𑆂 𑆱𑆳𑆫𑆱𑇀𑆡𑆴𑆫𑆯𑆫𑆵𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆪𑆶𑆰𑇀𑆩𑆤𑇀𑆠𑆯𑇀𑆖𑇆𑇑𑇐𑇗𑇆
𑆩𑆸𑆢𑇀𑆮𑆕𑇀𑆓𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆂 𑆱𑇀𑆡𑆷𑆬𑆢𑆵𑆫𑇀𑆔𑆮𑆸𑆠𑇀𑆠𑆱𑆤𑇀𑆣𑆪𑆯𑇀𑆖 𑆩𑆘𑇀𑆘𑆱𑆳𑆫𑆳𑆂𑇅 𑆠𑆼 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆰𑆾 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑆯𑇀𑆫𑆶𑆠𑆮𑆴𑆠𑇀𑆠𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆥𑆠𑇀𑆪𑆱𑆩𑇀𑆩𑆳𑆤𑆨𑆳𑆘𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇐𑇘𑇆
𑆱𑆿𑆩𑇀𑆪𑆳𑆂 𑆱𑆿𑆩𑇀𑆪𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆴𑆟𑆂 𑆑𑇀𑆰𑆵𑆫𑆥𑆷𑆫𑇀𑆟𑆬𑆾𑆖𑆤𑆳 𑆅𑆮 𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆧𑆲𑆶𑆬𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆸𑆠𑇀𑆠𑆱𑆳𑆫𑆱𑆩𑆱𑆁𑆲𑆠𑆯𑆴𑆒𑆫𑆢𑆯𑆤𑆳𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳 𑆨𑇀𑆫𑆳𑆘𑆴𑆰𑇀𑆟𑆮𑆾 𑆩𑆲𑆳𑆱𑇀𑆦𑆴𑆖𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆱𑆳𑆫𑆳𑆂𑇅 𑆠𑆼 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑇀𑆫𑆴𑆪𑆾𑆥𑆨𑆾𑆓𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑆱𑆶𑆒𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆳𑆫𑆾𑆓𑇀𑆪𑆮𑆴𑆠𑇀𑆠𑆱𑆩𑇀𑆩𑆳𑆤𑆳𑆥𑆠𑇀𑆪𑆨𑆳𑆘𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇐𑇙𑇆
𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆤𑇀𑆠𑆾 𑆨𑆑𑇀𑆠𑆴𑆩𑆤𑇀𑆠𑆂 𑆑𑆸𑆠𑆘𑇀𑆚𑆳𑆂 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆳𑆂 𑆯𑆶𑆖𑆪𑆾 𑆩𑆲𑆾𑆠𑇀𑆱𑆳𑆲𑆳 𑆢𑆑𑇀𑆰𑆳 𑆣𑆵𑆫𑆳𑆂 𑆱𑆩𑆫𑆮𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆪𑆾𑆣𑆴𑆤𑆱𑇀𑆠𑇀𑆪𑆑𑇀𑆠𑆮𑆴𑆰𑆳𑆢𑆳𑆂 𑆱𑆶𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆓𑆠𑆴𑆓𑆩𑇀𑆨𑆵𑆫𑆧𑆶𑆢𑇀𑆣𑆴𑆖𑆼𑆰𑇀𑆛𑆳𑆂 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆴𑆤𑆯𑇀𑆖 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆳𑆫𑆳𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑆼𑆮 𑆓𑆶𑆟𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇑𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆽𑆂 𑆱𑆳𑆫𑆽𑆫𑆶𑆥𑆼𑆠𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆧𑆬𑆳𑆂 𑆥𑆫𑆩𑆱𑆶𑆒𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆫𑆩𑇀𑆨𑆼𑆰𑇀𑆮𑆳𑆠𑇀𑆩𑆤𑆴 𑆘𑆳𑆠𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆳𑆂 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆴𑆤𑆂 𑆱𑇀𑆡𑆴𑆫𑆱𑆩𑆳𑆲𑆴𑆠𑆯𑆫𑆵𑆫𑆳𑆂 𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆓𑆠𑆪𑆂 𑆱𑆳𑆤𑆶𑆤𑆳𑆢𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆩𑇀𑆨𑆵𑆫𑆩𑆲𑆳𑆱𑇀𑆮𑆫𑆳𑆂 𑆱𑆶𑆒𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆮𑆴𑆠𑇀𑆠𑆾𑆥𑆨𑆾𑆓𑆱𑆩𑇀𑆩𑆳𑆤𑆨𑆳𑆘𑆾 𑆩𑆤𑇀𑆢𑆘𑆫𑆱𑆾 𑆩𑆤𑇀𑆢𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆳𑆥𑆠𑇀𑆪𑆳𑆯𑇀𑆖𑆴𑆫𑆘𑆵𑆮𑆴𑆤𑆯𑇀𑆖𑇆𑇑𑇑𑇑𑇆
𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆱𑆳𑆫𑆳𑆂𑇆𑇑𑇑𑇒𑇆
𑆩𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆩𑆣𑇀𑆪𑆽𑆂𑆱𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆓𑆶𑆟𑆮𑆴𑆯𑆼𑆰𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇑𑇓𑇆
𑆅𑆠𑆴 𑆱𑆳𑆫𑆳𑆟𑇀𑆪𑆰𑇀𑆛𑆿 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆁 𑆧𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇑𑇔𑇆
𑆑𑆡𑆁 𑆤𑆶 𑆯𑆫𑆵𑆫𑆩𑆳𑆠𑇀𑆫𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑆼𑆮 𑆨𑆴𑆰𑆕𑇀𑆩𑆶𑆲𑇀𑆪𑆼𑆢𑆪𑆩𑆶𑆥𑆖𑆴𑆠𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆬𑆮𑆳𑆤𑇀, 𑆃𑆪𑆩𑆬𑇀𑆥𑆧𑆬𑆂 𑆑𑆸𑆯𑆠𑇀𑆮𑆳𑆠𑇀, 𑆩𑆲𑆳𑆧𑆬𑆾𑇁𑆪𑆁 𑆩𑆲𑆳𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆠𑇀, 𑆃𑆪𑆩𑆬𑇀𑆥𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆢𑆬𑇀𑆥𑆧𑆬 𑆅𑆠𑆴; 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆲𑇀𑆪𑆬𑇀𑆥𑆯𑆫𑆵𑆫𑆳𑆂 𑆑𑆸𑆯𑆳𑆯𑇀𑆖𑆽𑆑𑆼 𑆧𑆬𑆮𑆤𑇀𑆠𑆂; 𑆠𑆠𑇀𑆫 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆨𑆳𑆫𑆲𑆫𑆟𑆮𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆴𑆂𑇅 𑆃𑆠𑆯𑇀𑆖 𑆱𑆳𑆫𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠𑆼𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇑𑇑𑇕𑇆
𑆱𑆁𑆲𑆤𑆤𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆁𑆲𑆤𑆤𑆁, 𑆱𑆁𑆲𑆠𑆴𑆂 , 𑆱𑆁𑆪𑆾𑆘𑆤𑆩𑆴𑆠𑇀𑆪𑆼𑆑𑆾𑇁𑆫𑇀𑆡𑆂𑇅 𑆠𑆠𑇀𑆫 𑆱𑆩𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆳𑆱𑇀𑆡𑆴, 𑆱𑆶𑆧𑆢𑇀𑆣𑆱𑆤𑇀𑆣𑆴, 𑆱𑆶𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆁, 𑆱𑆶𑆱𑆁𑆲𑆠𑆁 𑆯𑆫𑆵𑆫𑆩𑆴𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆠𑆠𑇀𑆫 𑆱𑆶𑆱𑆁𑆲𑆠𑆯𑆫𑆵𑆫𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆂, 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟𑆳𑆬𑇀𑆥𑆧𑆬𑆳𑆂, 𑆩𑆣𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆁𑆲𑆤𑆤𑆱𑇀𑆪 𑆩𑆣𑇀𑆪𑆧𑆬𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇑𑇖𑇆
𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆼𑆤𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆇𑆠𑇀𑆱𑆼𑆣𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆳𑆪𑆳𑆩𑆽𑆫𑇀𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆥𑆳𑆢𑆿 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆰𑆛𑇀 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑆴, 𑆘𑆕𑇀𑆔𑆼 𑆠𑇀𑆮𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆼 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆑𑇀𑆰𑆼𑆥𑆼 𑆖, 𑆘𑆳𑆤𑆶𑆤𑆵 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆑𑇀𑆰𑆼𑆥𑆼, 𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆑𑇀𑆰𑆼𑆥𑆳𑆮𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆮𑆷𑆫𑆶, 𑆰𑆝𑆕𑇀𑆓𑆶𑆬𑆢𑆵𑆫𑇀𑆔𑆿 𑆮𑆸𑆰𑆟𑆳𑆮𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆿, 𑆯𑆼𑆦𑆂 𑆰𑆝𑆕𑇀𑆓𑆶𑆬𑆢𑆵𑆫𑇀𑆔𑆁 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆁, 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑆴𑆟𑆳𑆲𑆾 𑆨𑆓𑆂, 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆳 𑆑𑆛𑆵, 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆂, 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑆶𑆢𑆫𑆁, 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆼 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆳𑆩𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼, 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆁, 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆁 𑆱𑇀𑆠𑆤𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆁, 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆯𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆮𑆴𑆯𑆳𑆬𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆩𑆶𑆫𑆂, 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆁 𑆲𑆸𑆢𑆪𑆩𑇀, 𑆃𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆿 𑆱𑇀𑆑𑆤𑇀𑆣𑆿, 𑆰𑆝𑆕𑇀𑆓𑆶𑆬𑆳𑆮𑆁𑆱𑆿, 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆿 𑆥𑇀𑆫𑆧𑆳𑆲𑆷, 𑆥𑆚𑇀𑆖𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆿 𑆥𑇀𑆫𑆥𑆳𑆟𑆵, 𑆲𑆱𑇀𑆠𑆿 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆿 , 𑆑𑆑𑇀𑆰𑆳𑆮𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆿, 𑆠𑇀𑆫𑆴𑆑𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆩𑇀, 𑆃𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆁 𑆥𑆸𑆰𑇀𑆜𑆁, 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆳 𑆢𑇀𑆮𑆳𑆮𑆴𑆁𑆯𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆳 𑆯𑆴𑆫𑆾𑆣𑆫𑆳, 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆩𑆳𑆤𑆤𑆁, 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑆳𑆱𑇀𑆪𑆁, 𑆖𑆴𑆧𑆶𑆑𑆿𑆰𑇀𑆜𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆩𑆣𑇀𑆪𑆤𑆳𑆱𑆴𑆑𑆳𑆬𑆬𑆳𑆛𑆁 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆁, 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆁 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆕𑇀𑆓𑆶𑆬𑆥𑆫𑆴𑆟𑆳𑆲𑆁 𑆯𑆴𑆫𑆂; 𑆅𑆠𑆴 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆩𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆩𑇀𑇅 𑆑𑆼𑆮𑆬𑆁 𑆥𑆶𑆤𑆂𑆯𑆫𑆵𑆫𑆩𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑇀𑆮𑆳𑆟𑆴 𑆖𑆠𑆶𑆫𑆯𑆵𑆠𑆴𑆂𑇅 𑆠𑆢𑆳𑆪𑆳𑆩𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆱𑆩𑆁 𑆱𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆠𑆠𑇀𑆫𑆳𑆪𑆶𑆫𑇀𑆧𑆬𑆩𑆾𑆘𑆂 𑆱𑆶𑆒𑆩𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆁 𑆮𑆴𑆠𑇀𑆠𑆩𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆪𑆠𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆠𑆴 𑆯𑆫𑆵𑆫𑆼; 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆱𑇀𑆠𑇀𑆮𑆠𑆾 𑆲𑆵𑆤𑆼𑇁𑆣𑆴𑆑𑆼 𑆮𑆳𑇆𑇑𑇑𑇗𑇆
𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆤𑆳𑆩 𑆠𑆢𑇀𑆪𑆠𑇀 𑆱𑆳𑆠𑆠𑇀𑆪𑆼𑆤𑆾𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆯𑆼𑆠𑆼𑇅 𑆠𑆠𑇀𑆫 𑆪𑆼 𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆠𑆽𑆬𑆩𑆳𑆁𑆱𑆫𑆱𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆂 𑆱𑆫𑇀𑆮𑆫𑆱𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆯𑇀𑆖 𑆠𑆼 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳𑆯𑇀𑆖𑆴𑆫𑆘𑆵𑆮𑆴𑆤𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆫𑆷𑆑𑇀𑆰𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑆼𑆑𑆫𑆱𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆼 𑆠𑆼 𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆳𑆬𑇀𑆥𑆧𑆬𑆳 𑆃𑆬𑇀𑆥𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳 𑆃𑆬𑇀𑆥𑆳𑆪𑆶𑆰𑆾𑇁𑆬𑇀𑆥𑆱𑆳𑆣𑆤𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆪𑆼 𑆠𑆼 𑆩𑆣𑇀𑆪𑆧𑆬𑆳𑆂 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆠𑆾 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇑𑇘𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆩𑆤𑆂𑇅 𑆠𑆖𑇀𑆗𑆫𑆵𑆫𑆱𑇀𑆪 𑆠𑆤𑇀𑆠𑇀𑆫𑆑𑆩𑆳𑆠𑇀𑆩𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀𑇅 𑆠𑆠𑇀 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆧𑆬𑆨𑆼𑆢𑆼𑆤- 𑆥𑇀𑆫𑆮𑆫𑆁, 𑆩𑆣𑇀𑆪𑆩𑇀, 𑆃𑆮𑆫𑆁 𑆖𑆼𑆠𑆴; 𑆃𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆮𑆫𑆩𑆣𑇀𑆪𑆳𑆮𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆮𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆳𑆫𑆳𑆱𑇀𑆠𑆼 𑆱𑆳𑆫𑆼𑆰𑆷𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆂, 𑆱𑇀𑆮𑆬𑇀𑆥𑆯𑆫𑆵𑆫𑆳 𑆲𑇀𑆪𑆥𑆴 𑆠𑆼 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆱𑆶 𑆩𑆲𑆠𑆵𑆰𑇀𑆮𑆥𑆴 𑆥𑆵𑆝𑆳𑆱𑇀𑆮𑆮𑇀𑆪𑆡𑆳 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆠𑇀𑆠𑇀𑆮𑆓𑆶𑆟𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆳𑆠𑇀; 𑆩𑆣𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆱𑇀𑆠𑇀𑆮𑆥𑆫𑆳𑆤𑆳𑆠𑇀𑆩𑆤𑇀𑆪𑆶𑆥𑆤𑆴𑆣𑆳𑆪 𑆱𑆁𑆱𑇀𑆠𑆩𑇀𑆨𑆪𑆤𑇀𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆁 𑆥𑆫𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆱𑆁𑆱𑇀𑆠𑆨𑇀𑆪𑆤𑇀𑆠𑆼; 𑆲𑆵𑆤𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆱𑇀𑆠𑆶 𑆤𑆳𑆠𑇀𑆩𑆤𑆳 𑆤𑆳𑆥𑆴 𑆥𑆫𑆽𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆬𑆁 𑆥𑇀𑆫𑆠𑆴 𑆯𑆑𑇀𑆪𑆤𑇀𑆠𑆼 𑆇𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆪𑆴𑆠𑆶𑆁, 𑆩𑆲𑆳𑆯𑆫𑆵𑆫𑆳 𑆲𑇀𑆪𑆥𑆴 𑆠𑆼 𑆱𑇀𑆮𑆬𑇀𑆥𑆳𑆤𑆳𑆩𑆥𑆴 𑆮𑆼𑆢𑆤𑆳𑆤𑆳𑆩𑆱𑆲𑆳 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼, 𑆱𑆤𑇀𑆤𑆴𑆲𑆴𑆠𑆨𑆪𑆯𑆾𑆑𑆬𑆾𑆨𑆩𑆾𑆲𑆩𑆳𑆤𑆳 𑆫𑆿𑆢𑇀𑆫𑆨𑆽𑆫𑆮𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆧𑆵𑆨𑆠𑇀𑆱𑆮𑆴𑆑𑆸𑆠𑆱𑆕𑇀𑆑𑆡𑆳𑆱𑇀𑆮𑆥𑆴 𑆖 𑆥𑆯𑆶𑆥𑆶𑆫𑆶𑆰𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆤𑆴 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆮𑆴𑆰𑆳𑆢𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆾𑆤𑇀𑆩𑆳𑆢𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆥𑆠𑆤𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆳𑆥𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑇀𑆪𑆡𑆮𑆳 𑆩𑆫𑆟𑆩𑆴𑆠𑆴𑇆𑇑𑇑𑇙𑇆
𑆄𑆲𑆳𑆫𑆯𑆑𑇀𑆠𑆴𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆄𑆲𑆳𑆫𑆯𑆑𑇀𑆠𑆴𑆫𑆨𑇀𑆪𑆮𑆲𑆫𑆟𑆯𑆑𑇀𑆠𑇀𑆪𑆳 𑆘𑆫𑆟𑆯𑆑𑇀𑆠𑆪𑆳 𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳; 𑆧𑆬𑆳𑆪𑆶𑆰𑆵 𑆲𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆪𑆠𑇀𑆠𑆼𑇆𑇑𑇒𑇐𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆠𑆴𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆠𑆴𑆫𑆥𑆴 𑆑𑆫𑇀𑆩𑆯𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑇅 𑆑𑆫𑇀𑆩𑆯𑆑𑇀𑆠𑇀𑆪𑆳 𑆲𑇀𑆪𑆤𑆶𑆩𑆵𑆪𑆠𑆼 𑆧𑆬𑆠𑇀𑆫𑆽𑆮𑆴𑆣𑇀𑆪𑆩𑇀 𑇆𑇑𑇒𑇑𑇆
𑆮𑆪𑆱𑇀𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆑𑆳𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆯𑆼𑆰𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆵 𑆲𑆴 𑆯𑆫𑆵𑆫𑆳𑆮𑆱𑇀𑆡𑆳 𑆮𑆪𑆾𑇁𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆠𑆢𑇀𑆮𑆪𑆾 𑆪𑆡𑆳𑆱𑇀𑆡𑆷𑆬𑆨𑆼𑆢𑆼𑆤 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁- 𑆧𑆳𑆬𑆁, 𑆩𑆣𑇀𑆪𑆁, 𑆘𑆵𑆫𑇀𑆟𑆩𑆴𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆧𑆳𑆬𑆩𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆣𑆳𑆠𑆶𑆩𑆘𑆳𑆠𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆁 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆩𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆩𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆧𑆬𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆩𑆳𑆰𑆾𑆝𑆯𑆮𑆫𑇀𑆰𑆁, 𑆮𑆴𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆁 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆳𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆮𑆫𑇀𑆰𑆩𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁; 𑆩𑆣𑇀𑆪𑆁 𑆥𑆶𑆤𑆂 𑆱𑆩𑆠𑇀𑆮𑆳𑆓𑆠𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆥𑆿𑆫𑆶𑆰𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆓𑇀𑆫𑆲𑆟𑆣𑆳𑆫𑆟𑆱𑇀𑆩𑆫𑆟𑆮𑆖𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆁 𑆧𑆬𑆱𑇀𑆡𑆴𑆠𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆩𑆳𑆟𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆩𑆳𑆰𑆰𑇀𑆛𑆴𑆮𑆫𑇀𑆰𑆩𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆩𑇀; 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆲𑆵𑆪𑆩𑆳𑆤𑆣𑆳𑆠𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆥𑆿𑆫𑆶𑆰𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆓𑇀𑆫𑆲𑆟𑆣𑆳𑆫𑆟𑆱𑇀𑆩𑆫𑆟𑆮𑆖𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑇀𑆫𑆯𑇀𑆪𑆩𑆳𑆤𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆁 𑆮𑆳𑆪𑆶𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆁 𑆑𑇀𑆫𑆩𑆼𑆟 𑆘𑆵𑆫𑇀𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆄𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑇀𑇅 𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼; 𑆱𑆤𑇀𑆠𑆴 𑆖 𑆥𑆶𑆤𑆫𑆣𑆴𑆑𑆾𑆤𑆮𑆫𑇀𑆰𑆯𑆠𑆘𑆵𑆮𑆴𑆤𑆾𑇁𑆥𑆴 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆘𑇀𑆪𑆽𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑆴𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑆳𑆪𑆶𑆰𑆾 𑆬𑆑𑇀𑆰𑆟𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆶𑆥𑆬𑆨𑇀𑆪 𑆮𑆪𑆱𑆱𑇀𑆠𑇀𑆫𑆴𑆠𑇀𑆮𑆁 𑆮𑆴𑆨𑆘𑆼𑆠𑇀𑇆𑇑𑇒𑇒𑇆
𑆍𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆫𑆩𑆣𑇀𑆪𑆳𑆮𑆫𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆁 𑆮𑆴𑆨𑆘𑆼𑆠𑇀𑇅 𑆮𑆴𑆑𑆸𑆠𑆴𑆧𑆬𑆠𑇀𑆫𑆽𑆮𑆴𑆣𑇀𑆪𑆼𑆤 𑆠𑆶 𑆢𑆾𑆰𑆧𑆬𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆤𑆶𑆩𑆵𑆪𑆠𑆼𑇅 𑆠𑆠𑆾 𑆨𑆽𑆰𑆘𑇀𑆪𑆱𑇀𑆪 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆸𑆢𑆶𑆩𑆣𑇀𑆪𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆠𑇀𑆫𑆽𑆮𑆴𑆣𑇀𑆪𑆁 𑆮𑆴𑆨𑆘𑇀𑆪 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆨𑆽𑆰𑆘𑇀𑆪𑆩𑆮𑆖𑆳𑆫𑆪𑆼𑆢𑆴𑆠𑆴𑇆𑇑𑇒𑇓𑇆
𑆄𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆂 𑆥𑆶𑆤𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆰𑆶 𑆘𑆳𑆠𑆴𑆱𑆷𑆠𑇀𑆫𑆵𑆪𑆼 𑆖 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇑𑇒𑇔𑇆
𑆑𑆳𑆬𑆂 𑆥𑆶𑆤𑆂 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆯𑇀𑆖𑆳𑆠𑆶𑆫𑆳𑆮𑆱𑇀𑆡𑆳 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆾 𑆢𑇀𑆮𑆴𑆣𑆳 𑆠𑇀𑆫𑆴𑆣𑆳 𑆰𑆾𑆞𑆳 𑆢𑇀𑆮𑆳𑆢𑆯𑆣𑆳 𑆨𑆷𑆪𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪𑆠𑆼 𑆠𑆠𑇀𑆠𑆠𑇀𑆑𑆳𑆫𑇀𑆪𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑇅 𑆃𑆠𑇀𑆫 𑆒𑆬𑆶 𑆠𑆳𑆮𑆠𑇀 𑆰𑆾𑆞𑆳 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼- 𑆲𑆼𑆩𑆤𑇀𑆠𑆾 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆾 𑆮𑆫𑇀𑆰𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆬𑆑𑇀𑆰𑆟𑆳𑆱𑇀𑆠𑇀𑆫𑆪 𑆉𑆠𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆼𑆰𑆳𑆩𑆤𑇀𑆠𑆫𑆼𑆰𑇀𑆮𑆴𑆠𑆫𑆼 𑆱𑆳𑆣𑆳𑆫𑆟𑆬𑆑𑇀𑆰𑆟𑆳𑆱𑇀𑆠𑇀𑆫𑆪 𑆉𑆠𑆮𑆂- 𑆥𑇀𑆫𑆳𑆮𑆸𑆛𑇀𑆯𑆫𑆢𑇀𑆮𑆱𑆤𑇀𑆠𑆳 𑆅𑆠𑆴𑇅 𑆥𑇀𑆫𑆳𑆮𑆸𑆝𑆴𑆠𑆴 𑆥𑇀𑆫𑆡𑆩𑆂 𑆥𑇀𑆫𑆮𑆸𑆰𑇀𑆛𑆂 𑆑𑆳𑆬𑆂, 𑆠𑆱𑇀𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆾 𑆲𑆴 𑆮𑆫𑇀𑆰𑆳𑆂𑇅 𑆍𑆮𑆩𑆼𑆠𑆼 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆰𑆛𑇀 𑆮𑆴𑆨𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆉𑆠𑆮𑆂𑇆𑇑𑇒𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑆳𑆣𑆳𑆫𑆟𑆬𑆑𑇀𑆰𑆟𑆼𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶 𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆮𑆴𑆣𑆵𑆪𑆠𑆼, 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆠𑆫𑆼𑆰𑆶𑇅 𑆱𑆳𑆣𑆳𑆫𑆟𑆬𑆑𑇀𑆰𑆟𑆳 𑆲𑆴 𑆩𑆤𑇀𑆢𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆶𑆒𑆠𑆩𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆑𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆿𑆰𑆣𑆳𑆤𑆳𑆩𑇀, 𑆅𑆠𑆫𑆼 𑆥𑆶𑆤𑆫𑆠𑇀𑆪𑆫𑇀𑆡𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑆶𑆂𑆒𑆠𑆩𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆑𑆬𑇀𑆥𑆑𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆿𑆰𑆣𑆳𑆤𑆳𑆩𑇀𑇆𑇑𑇒𑇖𑇆
𑆠𑆠𑇀𑆫 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆲𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆯𑆵𑆠𑆾𑆥𑆲𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆩𑆱𑆶𑆒𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆨𑆮𑆠𑇀𑆪𑆠𑆴𑆯𑆵𑆠𑆮𑆳𑆠𑆳𑆣𑇀𑆩𑆳𑆠𑆩𑆠𑆴𑆢𑆳𑆫𑆶𑆟𑆵𑆨𑆷𑆠𑆩𑆮𑆧𑆢𑇀𑆣𑆢𑆾𑆰𑆁 𑆖, 𑆨𑆼𑆰𑆘𑆁 𑆥𑆶𑆤𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆰𑇀𑆟𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆠𑆴𑆯𑆵𑆠𑆾𑆥𑆲𑆠𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆪𑆾𑆂 𑆱𑆁𑆪𑆾𑆓𑆼 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆪𑆾𑆓𑆳𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼 𑆯𑆫𑆵𑆫𑆩𑆥𑆴 𑆖 𑆮𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆪𑇅 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆥𑆶𑆤𑆫𑇀𑆨𑆸𑆯𑆾𑆰𑇀𑆟𑆾𑆥𑆲𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆩𑆱𑆶𑆒𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆨𑆮𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆮𑆳𑆠𑆳𑆠𑆥𑆳𑆣𑇀𑆩𑆳𑆠𑆩𑆠𑆴𑆯𑆴𑆡𑆴𑆬𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆥𑇀𑆫𑆮𑆴𑆬𑆵𑆤𑆢𑆾𑆰𑆁, 𑆨𑆼𑆰𑆘𑆁 𑆥𑆶𑆤𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆰𑇀𑆟𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆶𑆰𑇀𑆟𑆳𑆤𑆶𑆓𑆩𑆤𑆳𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆫𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆪𑆾𑆂 𑆱𑆁𑆪𑆾𑆓𑆼 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆠𑆴𑆪𑆾𑆓𑆳𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼 𑆯𑆫𑆵𑆫𑆩𑆥𑆴 𑆥𑆴𑆥𑆳𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆪𑇅 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆠𑆶 𑆩𑆼𑆔𑆘𑆬𑆳𑆮𑆠𑆠𑆼 𑆓𑆷𑆞𑆳𑆫𑇀𑆑𑆖𑆤𑇀𑆢𑇀𑆫𑆠𑆳𑆫𑆼 𑆣𑆳𑆫𑆳𑆑𑆶𑆬𑆼 𑆮𑆴𑆪𑆠𑆴 𑆨𑆷𑆩𑆿 𑆥𑆕𑇀𑆑𑆘𑆬𑆥𑆛𑆬𑆱𑆁𑆮𑆸𑆠𑆳𑆪𑆳𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆾𑆥𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆯𑆫𑆵𑆫𑆼𑆰𑆶 𑆨𑆷𑆠𑆼𑆰𑆶 𑆮𑆴𑆲𑆠𑆱𑇀𑆮𑆨𑆳𑆮𑆼𑆰𑆶 𑆖 𑆑𑆼𑆮𑆬𑆼𑆰𑇀𑆮𑆿𑆰𑆣𑆓𑇀𑆫𑆳𑆩𑆼𑆰𑆶 𑆠𑆾𑆪𑆠𑆾𑆪𑆢𑆳𑆤𑆶𑆓𑆠𑆩𑆳𑆫𑆶𑆠𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀 𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆵𑆤𑆴 𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆓𑆶𑆫𑆶𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆖 𑆯𑆫𑆵𑆫𑆳𑆟𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑆮𑆫𑇀𑆰𑆳𑆤𑇀𑆠𑆼𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶 , 𑆤 𑆖𑆼𑆢𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆁 𑆑𑆫𑇀𑆩𑇅 𑆄𑆠𑇀𑆪𑆪𑆴𑆑𑆼 𑆥𑆶𑆤𑆂 𑆑𑆫𑇀𑆩𑆟𑆴 𑆑𑆳𑆩𑆩𑆸𑆠𑆶𑆁 𑆮𑆴𑆑𑆬𑇀𑆥𑇀𑆪 𑆑𑆸𑆠𑇀𑆫𑆴𑆩𑆓𑆶𑆟𑆾𑆥𑆣𑆳𑆤𑆼𑆤 𑆪𑆡𑆫𑇀𑆠𑆶𑆓𑆶𑆟𑆮𑆴𑆥𑆫𑆵𑆠𑆼𑆤 𑆨𑆼𑆰𑆘𑆁 𑆱𑆁𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆑𑆬𑇀𑆥𑆼𑆤𑆾𑆥𑆥𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆵𑆫𑇀𑆪𑆱𑆩𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆠𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆢𑆶𑆠𑇀𑆠𑆩𑆼𑆤 𑆪𑆠𑇀𑆤𑆼𑆤𑆳𑆮𑆲𑆴𑆠𑆂𑇆𑇑𑇒𑇗𑇆
𑆄𑆠𑆶𑆫𑆳𑆮𑆱𑇀𑆡𑆳𑆱𑇀𑆮𑆥𑆴 𑆠𑆶 𑆑𑆳𑆫𑇀𑆪𑆳𑆑𑆳𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆠𑆴 𑆑𑆳𑆬𑆳𑆑𑆳𑆬𑆱𑆚𑇀𑆘𑇀𑆚𑆳; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆩𑆱𑇀𑆪 𑆨𑆼𑆰𑆘𑆱𑇀𑆪𑆳𑆑𑆳𑆬𑆂 , 𑆑𑆳𑆬𑆂 𑆥𑆶𑆤𑆫𑆤𑇀𑆪𑆱𑇀𑆪𑆼𑆠𑆴; 𑆍𑆠𑆢𑆥𑆴 𑆲𑆴 𑆨𑆮𑆠𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆮𑆴𑆯𑆼𑆰𑆼𑆟; 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆠𑆶𑆫𑆳𑆮𑆱𑇀𑆡𑆳𑆱𑇀𑆮𑆥𑆴 𑆲𑆴 𑆑𑆳𑆬𑆳𑆑𑆳𑆬𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑇅 𑆠𑆱𑇀𑆪 𑆥𑆫𑆵𑆑𑇀𑆰𑆳- 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆳𑆮𑆱𑇀𑆡𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆁 𑆪𑆡𑆳𑆮𑆢𑇀𑆨𑆼𑆰𑆘𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆫𑇀𑆡𑆩𑇀𑇅 𑆤 𑆲𑇀𑆪𑆠𑆴𑆥𑆠𑆴𑆠𑆑𑆳𑆬𑆩𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆬𑆁 𑆮𑆳 𑆨𑆼𑆰𑆘𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆁 𑆪𑆿𑆓𑆴𑆑𑆁 𑆨𑆮𑆠𑆴; 𑆑𑆳𑆬𑆾 𑆲𑆴 𑆨𑆽𑆰𑆘𑇀𑆪𑆥𑇀𑆫𑆪𑆾𑆓𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆴𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇑𑇒𑇘𑇆
𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆂𑇅 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁 𑆨𑆴𑆰𑆓𑆿𑆰𑆣𑆳𑆠𑆶𑆫𑆥𑆫𑆴𑆖𑆳𑆫𑆑𑆳𑆟𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆩𑆳𑆪𑆾𑆓𑆂𑇆𑇑𑇒𑇙𑇆
𑆇𑆥𑆳𑆪𑆂 𑆥𑆶𑆤𑆫𑇀𑆨𑆴𑆰𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆿𑆰𑇀𑆜𑆮𑆩𑆨𑆴𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆱𑆩𑇀𑆪𑆑𑇀𑇅 𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁- 𑆨𑆴𑆰𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆠𑇀 𑆢𑆼𑆯𑆑𑆳𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆑𑇀𑆫𑆴𑆪𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖 𑆱𑆴𑆢𑇀𑆣𑆴𑆑𑆳𑆫𑆟𑆽𑆂 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆥𑆳𑆢𑆴𑆠𑆱𑇀𑆪𑆿𑆰𑆣𑆱𑇀𑆪𑆳𑆮𑆖𑆳𑆫𑆟𑆩𑆴𑆠𑆴𑇆𑇑𑇓𑇐𑇆
𑆍𑆮𑆩𑆼𑆠𑆼 𑆢𑆯 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆮𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇓𑇑𑇆
𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑇀𑇅 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆤𑆳𑆩 𑆪𑆾 𑆮𑆴𑆑𑆳𑆫𑆾 𑆪𑆡𑆳 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆮𑇀𑆪𑆱𑇀𑆠𑆱𑇀𑆪 𑆠𑆡𑆳𑇁𑆤𑆶𑆰𑇀𑆜𑆳𑆤𑆘𑇀𑆚𑆳𑆤𑆩𑇀𑇆𑇑𑇓𑇒𑇆
𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆪𑆾𑆓𑆼 𑆠𑆶 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆣𑆳𑆫𑇀𑆪 𑆱𑆩𑇀𑆪𑆓𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑆤𑇀𑆪𑆠𑆫𑆤𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆩𑇀𑇅 𑆱𑆤𑇀𑆠𑆴 𑆲𑆴 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼𑆰𑆷𑆠𑇀𑆱𑆫𑇀𑆓𑆳𑆥𑆮𑆳𑆢𑆽𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆁 𑆥𑇀𑆫𑆠𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆣𑆳𑆫𑇀𑆪 𑆱𑆩𑇀𑆪𑆓𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇑𑇓𑇔𑇆
𑆪𑆳𑆤𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆮𑆩𑆤𑆳𑆢𑆴𑆰𑆶 𑆨𑆼𑆰𑆘𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆁 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆦𑆬𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆑𑆶𑆛𑆘𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆦𑆬𑆳𑆤𑆴, 𑆦𑆬𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆥𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆄𑆫𑆓𑇀𑆮𑆣𑆮𑆸𑆑𑇀𑆰𑆑𑆩𑆢𑆤𑆱𑇀𑆮𑆳𑆢𑆶𑆑𑆟𑇀𑆛𑆑𑆥𑆳𑆜𑆳𑆥𑆳𑆛𑆬𑆳𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆼𑆰𑇀𑆛𑆳𑆩𑆷𑆫𑇀𑆮𑆳𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆥𑆛𑆾𑆬𑆱𑆶𑆰𑆮𑆵𑆓𑆶𑆝𑆷𑆖𑆵- 𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆯𑆠𑆳𑆮𑆫𑆵𑆢𑇀𑆮𑆵𑆥𑆵𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆷𑆬𑆑𑆰𑆳𑆪𑆽𑆂, 𑆩𑆣𑆶𑆑𑆩𑆣𑆷𑆑𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆑𑆫𑇀𑆮𑆶𑆢𑆳𑆫𑆤𑆵𑆥𑆮𑆴𑆢𑆶𑆬𑆧𑆴𑆩𑇀𑆧𑆵𑆯𑆟𑆥𑆶𑆰𑇀𑆥𑆵𑆱𑆢𑆳𑆥𑆶𑆰𑇀𑆥𑆳𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆳𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆍𑆬𑆳𑆲𑆫𑆼𑆟𑆶𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆠𑆓𑆫𑆤𑆬𑆢𑆲𑇀𑆫𑆵𑆮𑆼𑆫𑆠𑆳𑆬𑆵𑆯𑆾𑆯𑆵𑆫𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖 , 𑆅𑆑𑇀𑆰𑆶𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑇀𑆮𑆴𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆢𑆫𑇀𑆨𑆥𑆾𑆛𑆓𑆬𑆑𑆳𑆬𑆕𑇀𑆑𑆸(𑆕𑇀𑆑)𑆠𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆱𑆶𑆩𑆤𑆳𑆱𑆿𑆩𑆤𑆱𑇀𑆪𑆳𑆪𑆤𑆵𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆩𑆲𑆳𑆱𑆲𑆳𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆱𑆲𑆳𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆯𑆳𑆬𑇀𑆩𑆬𑆴𑆯𑆳𑆬𑇀𑆩𑆬𑆴𑆑𑆨𑆢𑇀𑆫𑆥𑆫𑇀𑆟𑇀𑆪𑆼𑆬𑆳𑆥𑆫𑇀𑆟𑇀𑆪𑆶𑆥𑆾𑆢𑆴𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆣𑆤𑇀𑆮𑆤𑆫𑆳𑆘𑆳𑆢𑆤𑆾𑆥𑆖𑆴𑆠𑇀𑆫𑆳𑆓𑆾𑆥𑆵𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆴𑆑𑆳𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆱𑆫𑇀𑆰𑆥𑆦𑆳𑆟𑆴𑆠𑆑𑇀𑆰𑆵𑆫𑆑𑇀𑆰𑆳𑆫𑆬𑆮𑆟𑆾𑆢𑆑𑆽𑆯𑇀𑆖, 𑆪𑆡𑆳𑆬𑆳𑆨𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆖𑆷𑆫𑇀𑆟𑆳𑆮𑆬𑆼𑆲𑆱𑇀𑆤𑆼𑆲𑆑𑆰𑆳𑆪𑆩𑆳𑆁𑆱𑆫𑆱𑆪𑆮𑆳𑆓𑆷𑆪𑆷𑆰𑆑𑆳𑆩𑇀𑆧𑆬𑆴𑆑𑆑𑇀𑆰𑆵𑆫𑆾𑆥𑆣𑆼𑆪𑆳𑆤𑇀𑆩𑆾𑆢𑆑𑆳𑆤𑆤𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑆤𑆶𑆮𑆴𑆣𑆳𑆪 𑆪𑆡𑆳𑆫𑇀𑆲𑆁 𑆮𑆩𑆤𑆳𑆫𑇀𑆲𑆳𑆪 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆮𑆩𑆤𑆩𑇀𑇅 𑆅𑆠𑆴 𑆑𑆬𑇀𑆥𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆾 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆑𑆬𑇀𑆥𑆩𑆼𑆰𑆳𑆁 𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆼𑆟𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇓𑇕𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆠𑆶 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆠𑆴𑆬𑇀𑆮𑆑𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆤𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆳𑆤𑆴 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆠𑆽𑆱𑇀𑆠𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆽𑆫𑇀𑆮𑆴𑆑𑇀𑆬𑆴𑆥𑇀𑆠𑆳𑆮𑆴𑆑𑇀𑆬𑆴𑆥𑇀𑆠𑆽𑆂 , 𑆃𑆘𑆓𑆤𑇀𑆣𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆘𑆯𑆸𑆕𑇀𑆓𑆵𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆵𑆤𑆵𑆬𑆴𑆤𑆵𑆑𑇀𑆬𑆵𑆠𑆑𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆪𑆾𑆢𑆑𑆵𑆫𑇀𑆪𑆳𑆩𑆱𑆷𑆫𑆮𑆴𑆢𑆬𑆳𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆥𑆵𑆬𑆶𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆥𑆫𑆷𑆰𑆑𑆧𑆢𑆫𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆲𑆫𑆵𑆠𑆑𑆵𑆧𑆴𑆨𑆵𑆠𑆑𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖, 𑆱𑆵𑆣𑆶𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆠𑆶𑆰𑆾𑆢𑆑𑆩𑆽𑆫𑆼𑆪𑆩𑆼𑆢𑆑𑆩𑆢𑆴𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆷𑆬𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆒𑆫𑇀𑆘𑆷𑆫𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆨𑆴𑆯𑇀𑆖, 𑆢𑆣𑆴𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆾𑆢𑆯𑇀𑆮𑆴𑆢𑇀𑆨𑆴𑆯𑇀𑆖, 𑆓𑆾𑆩𑆲𑆴𑆰𑇀𑆪𑆘𑆳𑆮𑆵𑆤𑆳𑆁 𑆖 𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆽𑆫𑇀𑆪𑆡𑆳𑆬𑆳𑆨𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆖𑆷𑆫𑇀𑆟𑆳𑆱𑆮𑆬𑆼𑆲𑆱𑇀𑆤𑆼𑆲𑆑𑆰𑆳𑆪𑆩𑆳𑆁𑆱𑆫𑆱𑆪𑆷𑆰𑆑𑆳𑆩𑇀𑆧𑆬𑆴𑆑𑆪𑆮𑆳𑆓𑆷𑆑𑇀𑆰𑆵𑆫𑆾𑆥𑆣𑆼𑆪𑆳𑆤𑇀 𑆩𑆾𑆢𑆑𑆳𑆤𑆤𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆥𑇀𑆫(𑆮𑆴)𑆑𑆳𑆫𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆣𑆳𑆁𑆯𑇀𑆖 𑆪𑆾𑆓𑆳𑆤𑆤𑆶𑆮𑆴𑆣𑆳𑆪 𑆪𑆡𑆳𑆫𑇀𑆲𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆫𑇀𑆲𑆳𑆪 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆅𑆠𑆴 𑆑𑆬𑇀𑆥𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆑𑆬𑇀𑆥𑆩𑆼𑆰𑆳𑆁 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆪𑆡𑆳𑆮𑆢𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇓𑇖𑇆
𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆼𑆰𑆶 𑆠𑆶 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆑𑆬𑇀𑆥𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆪𑆳𑆤𑆴 𑆪𑆾𑆓𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑆠𑆼𑆰𑆶 𑆠𑆼𑆰𑇀𑆮𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑇀𑆮𑆳𑆠𑆶𑆫𑆳𑆟𑆳𑆁, 𑆠𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆤𑆳𑆩𑆠𑆾 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑇀𑆪𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆫𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆠𑇀; 𑆅𑆰𑇀𑆛𑆯𑇀𑆖𑆳𑆤𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆮𑆴𑆱𑇀𑆠𑆫𑆾𑆥𑆢𑆼𑆯𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆼, 𑆅𑆰𑇀𑆛𑆁 𑆖 𑆑𑆼𑆮𑆬𑆁 𑆘𑇀𑆚𑆳𑆤𑆁, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆱𑆠 𑆍𑆮 𑆠𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆫𑆱𑆱𑆁𑆱𑆫𑇀𑆓𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆱𑇀𑆠𑆫𑆾 𑆲𑇀𑆪𑆼𑆰𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆂, 𑆱𑆩𑆮𑆼𑆠𑆳𑆤𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆩𑆁𑆯𑆳𑆁𑆯𑆧𑆬𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆖𑆽𑆑𑆢𑆼𑆯𑆩𑆶𑆢𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆁 𑆫𑆱𑆼𑆰𑇀𑆮𑆤𑆶𑆮𑆴𑆨𑆘𑇀𑆪 𑆫𑆱𑆽𑆑𑆽𑆑𑆯𑇀𑆪𑆼𑆤 𑆖 𑆤𑆳𑆩𑆬𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁 𑆰𑆝𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆳 𑆫𑆱𑆠𑆾𑇁𑆤𑆶𑆮𑆴𑆨𑆘𑇀𑆪 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑆼𑇆𑇑𑇓𑇗𑇆
𑆪𑆠𑇀𑆠𑆶 𑆰𑆝𑇀𑆮𑆴𑆣𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆼𑆑𑆫𑆱𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆨𑆴𑆰𑆘𑆂, 𑆠𑆢𑇀𑆢𑆶𑆫𑇀𑆬𑆨𑆠𑆩𑆁 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆫𑆱𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆣𑆶𑆫𑆳𑆟𑆴 𑆩𑆣𑆶𑆫𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑆴 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆴 𑆩𑆣𑆶𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆟𑆴 𑆖 𑆩𑆣𑆶𑆫𑆱𑇀𑆑𑆤𑇀𑆣𑆼 𑆩𑆣𑆶𑆫𑆳𑆟𑇀𑆪𑆼𑆮 𑆑𑆸𑆠𑇀𑆮𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆡𑆼𑆠𑆫𑆳𑆟𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆥𑆴𑇆𑇑𑇓𑇘𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆮𑆵𑆫𑆳 𑆠𑆳𑆩𑆬𑆑𑆵 𑆑𑆳𑆑𑆾𑆬𑆵 𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵 𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑆵 𑆩𑆳𑆰𑆥𑆫𑇀𑆟𑆵 𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑇀𑆪𑆱𑆤𑆥𑆫𑇀𑆟𑆵 𑆩𑆣𑆶𑆥𑆫𑇀𑆟𑆵 𑆩𑆼𑆢𑆳 𑆩𑆲𑆳𑆩𑆼𑆢𑆳 𑆑𑆫𑇀𑆑𑆛𑆯𑆸𑆕𑇀𑆓𑆵 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆴𑆑𑆳 𑆗𑆴𑆤𑇀𑆤𑆫𑆶𑆲𑆳 𑆖𑇀𑆗𑆠𑇀𑆫𑆳𑇁𑆠𑆴𑆖𑇀𑆗𑆠𑇀𑆫𑆳 𑆯𑇀𑆫𑆳𑆮𑆟𑆵 𑆩𑆲𑆳𑆯𑇀𑆫𑆳𑆮𑆟𑆵 𑆱𑆲𑆢𑆼𑆮𑆳 𑆮𑆴𑆯𑇀𑆮𑆢𑆼𑆮𑆳 𑆯𑆶𑆑𑇀𑆬𑆳 𑆑𑇀𑆰𑆵𑆫𑆯𑆶𑆑𑇀𑆬𑆳 𑆧𑆬𑆳𑇁𑆠𑆴𑆧𑆬𑆳 𑆮𑆴𑆢𑆳𑆫𑆵 𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆢𑆳𑆫𑆵 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆱𑆲𑆳 𑆩𑆲𑆳𑆱𑆲𑆳 𑆉𑆰𑇀𑆪𑆓𑆤𑇀𑆣𑆳𑇁𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳 𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆂 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳 𑆧𑆸𑆲𑆠𑆵 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆾𑆫𑆶𑆧𑆷𑆑𑆾 𑆩𑆾𑆫𑆛𑆂 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆱𑆁𑆲𑆫𑇀𑆰𑆳 𑆯𑆠𑆳𑆮𑆫𑆵 𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳 𑆩𑆣𑆷𑆑𑆥𑆶𑆰𑇀𑆥𑆵 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶 𑆩𑆣𑆷𑆬𑆴𑆑𑆳 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳 𑆒𑆫𑇀𑆘𑆷𑆫𑆁 𑆥𑆫𑆷𑆰𑆑𑆩𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳 𑆥𑆶𑆰𑇀𑆑𑆫𑆧𑆵𑆘𑆁 𑆑𑆯𑆼𑆫𑆶𑆑𑆁 𑆫𑆳𑆘𑆑𑆯𑆼𑆫𑆶𑆑𑆁 𑆫𑆳𑆘𑆳𑆢𑆤𑆁 𑆑𑆠𑆑𑆁 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆁 𑆯𑆵𑆠𑆥𑆳𑆑𑇀𑆪𑆾𑆢𑆤𑆥𑆳𑆑𑆵 𑆠𑆳𑆬𑆒𑆫𑇀𑆘𑆷𑆫𑆩𑆱𑇀𑆠𑆑𑆩𑆴𑆑𑇀𑆰𑆶𑆫𑆴𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳 𑆢𑆫𑇀𑆨𑆂 𑆑𑆶𑆯𑆂 𑆑𑆳𑆯𑆂 𑆯𑆳𑆬𑆴𑆫𑇀𑆓𑆶𑆤𑇀𑆢𑇀𑆫𑆼𑆠𑇀𑆑𑆛𑆑𑆂 𑆯𑆫𑆩𑆷𑆬𑆁 𑆫𑆳𑆘𑆑𑇀𑆰𑆮𑆑𑆂 𑆉𑆰𑇀𑆪𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆢𑇀𑆮𑆳𑆫𑆢𑆳 𑆨𑆳𑆫𑆢𑇀𑆮𑆳𑆘𑆵 𑆮𑆤𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆪𑆨𑆵𑆫𑆶𑆥𑆠𑇀𑆫𑆵 𑆲𑆁𑆱𑆥𑆳𑆢𑆵 𑆑𑆳𑆑𑆤𑆳𑆱𑆴𑆑𑆳 𑆑𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆑𑇀𑆰𑆵 𑆑𑇀𑆰𑆵𑆫𑆮𑆬𑇀𑆬𑆵 𑆑𑆥𑆾𑆬𑆮𑆬𑇀𑆬𑆵 𑆑𑆥𑆾𑆠𑆮𑆬𑇀𑆬𑆵 𑆱𑆾𑆩𑆮𑆬𑇀𑆬𑆵 𑆓𑆾𑆥𑆮𑆬𑇀𑆬𑆵 𑆩𑆣𑆶𑆮𑆬𑇀𑆬𑆵 𑆖𑆼𑆠𑆴; 𑆍𑆰𑆳𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆖 𑆩𑆣𑆶𑆫𑆮𑆫𑇀𑆓𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆗𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆒𑆟𑇀𑆝𑆯𑆯𑇀𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆖𑆳𑆟𑆶𑆯𑆾 𑆨𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆥𑆳𑆤𑆵𑆪𑆼𑆤 𑆱𑆶𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆳𑆪𑆳𑆁 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆁 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆥𑆪𑆱𑆳𑇁𑆫𑇀𑆣𑆾𑆢𑆑𑆼𑆤𑆳𑆨𑇀𑆪𑆳𑆱𑆴𑆖𑇀𑆪 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆢𑆫𑇀𑆮𑇀𑆪𑆳 𑆱𑆠𑆠𑆩𑆮𑆔𑆛𑇀𑆛𑆪𑆤𑇀; 𑆠𑆢𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆼𑇁𑆩𑇀𑆨𑆱𑆴 𑆓𑆠𑆫𑆱𑆼𑆰𑇀𑆮𑆿𑆰𑆣𑆼𑆰𑆶 𑆥𑆪𑆱𑆴 𑆖𑆳𑆤𑆶𑆥𑆢𑆓𑇀𑆣𑆼 𑆱𑇀𑆡𑆳𑆬𑆵𑆩𑆶𑆥𑆲𑆸𑆠𑇀𑆪 𑆱𑆶𑆥𑆫𑆴𑆥𑆷𑆠𑆁 𑆥𑆪𑆂 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆔𑆸𑆠𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆬𑆮𑆟𑆦𑆳𑆟𑆴𑆠𑆾𑆥𑆲𑆴𑆠𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆼 𑆮𑆴𑆣𑆴𑆘𑇀𑆚𑆾 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀; 𑆯𑆵𑆠𑆁 𑆠𑆶 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆼 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆩𑆣𑆶𑆫𑆱𑇀𑆑𑆤𑇀𑆣𑆂𑇆𑇑𑇓𑇙𑇆
𑆄𑆩𑇀𑆫𑆳𑆩𑇀𑆫𑆳𑆠𑆑𑆬𑆑𑆶𑆖𑆑𑆫𑆩𑆫𑇀𑆢𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆢𑆳𑆝𑆴𑆩𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆓𑆟𑇀𑆝𑆵𑆫𑆳𑆩𑆬𑆑𑆤𑆤𑇀𑆢𑆵𑆠𑆑𑆯𑆵𑆠𑆑- 𑆠𑆴𑆤𑇀𑆠𑆴𑆟𑇀𑆝𑆵𑆑𑆢𑆤𑇀𑆠𑆯𑆜𑆽𑆫𑆳𑆮𑆠𑆑𑆑𑆾𑆯𑆳𑆩𑇀𑆫𑆣𑆤𑇀𑆮𑆤𑆳𑆤𑆳𑆁 𑆦𑆬𑆳𑆤𑆴, 𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆖𑆳𑆩𑇀𑆫𑆳𑆠𑆑𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆖𑆳𑆕𑇀𑆓𑆼𑆫𑆵𑆟𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆖𑆳𑆩𑇀𑆬𑆴𑆑𑆳𑆤𑆳𑆁 𑆢𑇀𑆮𑆪𑆾𑆯𑇀𑆖 𑆑𑆾𑆬𑆪𑆾𑆯𑇀𑆖𑆳𑆩𑆯𑆶𑆰𑇀𑆑𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆯𑇀𑆖𑆽𑆮 𑆯𑆶𑆰𑇀𑆑𑆳𑆩𑇀𑆬𑆴𑆑𑆪𑆾𑆫𑇀𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆫𑆟𑇀𑆪𑆪𑆾𑆂, 𑆄𑆱𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆖 𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆠𑆶𑆰𑆾𑆢𑆑𑆩𑆽𑆫𑆼𑆪𑆩𑆼𑆢𑆑𑆩𑆢𑆴𑆫𑆳𑆩𑆣𑆶𑆯𑆶𑆑𑇀𑆠𑆯𑆵𑆣𑆶𑆢𑆣𑆴𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆾𑆢𑆯𑇀𑆮𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆳𑆢𑆵𑆤𑆴 𑆖, 𑆍𑆰𑆳𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆖𑆳𑆩𑇀𑆬𑆮𑆫𑇀𑆓𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆗𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆒𑆟𑇀𑆝𑆯𑆯𑇀𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆖𑆳𑆟𑆶𑆯𑆾 𑆨𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆢𑇀𑆫𑆮𑆽𑆂 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆳𑆱𑆴𑆖𑇀𑆪 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆾𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆪𑆡𑆳𑆮𑆠𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆬𑆮𑆟𑆦𑆳𑆟𑆴𑆠𑆾𑆥𑆲𑆴𑆠𑆁 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆼 𑆮𑆴𑆣𑆴𑆘𑇀𑆚𑆾 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑇀𑆪𑆩𑇀𑆬𑆱𑇀𑆑𑆤𑇀𑆣𑆂𑇆𑇑𑇔𑇐𑇆
𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆑𑆳𑆬𑆮𑆴𑆝𑆥𑆳𑆑𑇀𑆪𑆳𑆤𑆷𑆥𑆑𑆷𑆥𑇀𑆪𑆮𑆳𑆬𑆶𑆑𑆽𑆬𑆩𑆿𑆬𑆑𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆫𑆾𑆩𑆑𑆿𑆢𑇀𑆨𑆴𑆢𑆿𑆰𑆫𑆥𑆳𑆛𑆼𑆪𑆑𑆥𑆳𑆁𑆯𑆶𑆘𑆳𑆤𑇀𑆪𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆬𑆮𑆟𑆮𑆫𑇀𑆓𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴, 𑆍𑆠𑆳𑆤𑇀𑆪𑆩𑇀𑆬𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑆴 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆮𑆤𑇀𑆠𑆴 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆼 𑆮𑆴𑆣𑆴𑆘𑇀𑆚𑆾 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆬𑆮𑆟𑆱𑇀𑆑𑆤𑇀𑆣𑆂𑇆𑇑𑇔𑇑𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆲𑆱𑇀𑆠𑆴𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆩𑆫𑆴𑆖𑆳𑆘𑆩𑆾𑆢𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆥𑆵𑆬𑆶𑆠𑆼𑆘𑆾𑆮𑆠𑇀𑆪𑆼𑆬𑆳𑆑𑆶𑆰𑇀𑆜- 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆱𑇀𑆡𑆴𑆲𑆴𑆕𑇀𑆓𑆶𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆑𑆴𑆬𑆴𑆩𑆩𑆷𑆬𑆑𑆱𑆫𑇀𑆰𑆥𑆬𑆯𑆶𑆤𑆑𑆫𑆚𑇀𑆘𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆒𑆫𑆥𑆶𑆰𑇀𑆥𑆨𑆷𑆱𑇀𑆠𑆸𑆟𑆱𑆶𑆩𑆶𑆒𑆱𑆶𑆫𑆱𑆑𑆶𑆜𑆼𑆫𑆑𑆳𑆫𑇀𑆘𑆑- 𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆳𑆬𑆩𑆳𑆬𑆑𑆥𑆫𑇀𑆟𑆳𑆱𑆑𑇀𑆰𑆮𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑𑆑𑇀𑆰𑆳𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆵𑆠𑆴; 𑆍𑆰𑆳𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆖𑆳𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆑𑆛𑆶𑆑𑆮𑆫𑇀𑆓𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆗𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆒𑆟𑇀𑆝𑆯𑆯𑇀𑆗𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆼𑆢𑇀𑆪𑆳𑆤𑆴 𑆖𑆳𑆟𑆶𑆯𑆾 𑆨𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆱𑆲 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆾𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆪𑆡𑆳𑆮𑆤𑇀𑆩𑆣𑆶𑆠𑆽𑆬𑆬𑆮𑆟𑆾𑆥𑆲𑆴𑆠𑆁 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆼 𑆮𑆴𑆣𑆴𑆘𑇀𑆚𑆾 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆑𑆛𑆶𑆑𑆱𑇀𑆑𑆤𑇀𑆣𑆂𑇆𑇑𑇔𑇒𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆰𑆝𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆱𑇀𑆑𑆤𑇀𑆣𑆳 𑆫𑆱𑆠𑆾𑇁𑆤𑆶𑆮𑆴𑆨𑆘𑇀𑆪 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇑𑇔𑇘𑇆
𑆠𑆼𑆨𑇀𑆪𑆾 𑆨𑆴𑆰𑆓𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆩𑆥𑆴 𑆪𑆢𑇀𑆪𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆪𑆿𑆓𑆴𑆑𑆁 𑆩𑆤𑇀𑆪𑆼𑆠, 𑆠𑆠𑇀𑆠𑆢𑆥𑆑𑆫𑇀𑆰𑆪𑆼𑆠𑇀; 𑆪𑆢𑇀𑆪𑆖𑇀𑆖𑆳𑆤𑆶𑆑𑇀𑆠𑆩𑆥𑆴 𑆪𑆿𑆓𑆴𑆑𑆁 𑆩𑆤𑇀𑆪𑆼𑆠, 𑆠𑆠𑇀𑆠𑆢𑇀𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀; 𑆮𑆫𑇀𑆓𑆩𑆥𑆴 𑆮𑆫𑇀𑆓𑆼𑆟𑆾𑆥𑆱𑆁𑆱𑆸𑆘𑆼𑆢𑆼𑆑𑆩𑆼𑆑𑆼𑆤𑆳𑆤𑆼𑆑𑆼𑆤 𑆮𑆳 𑆪𑆶𑆑𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆵𑆑𑆸𑆠𑇀𑆪𑇅 𑆥𑇀𑆫𑆖𑆫𑆟𑆩𑆴𑆮 𑆨𑆴𑆑𑇀𑆰𑆶𑆑𑆱𑇀𑆪 𑆧𑆵𑆘𑆩𑆴𑆮 𑆑𑆫𑇀𑆰𑆑𑆱𑇀𑆪 𑆱𑆷𑆠𑇀𑆫𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆩𑆬𑇀𑆥𑆩𑆥𑇀𑆪𑆤𑆬𑇀𑆥𑆘𑇀𑆚𑆳𑆤𑆳𑆪 𑆨𑆮𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆩𑆷𑆲𑆳𑆥𑆾𑆲𑆮𑆴𑆠𑆫𑇀𑆑𑆳𑆂, 𑆩𑆤𑇀𑆢𑆧𑆶𑆢𑇀𑆣𑆼𑆱𑇀𑆠𑆶 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆶𑆓𑆩𑆤𑆩𑆼𑆮 𑆯𑇀𑆫𑆼𑆪𑆂𑇅 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆲𑆴 𑆩𑆳𑆫𑇀𑆓𑆩𑆤𑆶𑆓𑆖𑇀𑆗𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑆱𑆁𑆱𑆳𑆣𑆪𑆠𑆴 𑆑𑆳𑆫𑇀𑆪𑆩𑆤𑆠𑆴𑆩𑆲𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳 𑆮𑆴𑆤𑆴𑆥𑆳𑆠𑆪𑆠𑇀𑆪𑆤𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆠𑇀𑆮𑆳𑆢𑆶𑆢𑆳𑆲𑆫𑆟𑆱𑇀𑆪𑆼𑆠𑆴𑇆𑇑𑇔𑇙𑇆
𑆃𑆠𑆂 𑆥𑆫𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆃𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆠𑆶 𑆱𑇀𑆤𑆼𑆲 𑆍𑆮𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑆶 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂- 𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆠𑇀𑆩𑆑𑆂, 𑆘𑆕𑇀𑆓𑆩𑆳𑆠𑇀𑆩𑆑𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆠𑇀𑆩𑆑𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑆽𑆬𑆩𑆠𑆽𑆬𑆁 𑆖𑇅 𑆠𑆢𑇀𑆢𑇀𑆮𑆪𑆁 𑆠𑆽𑆬𑆩𑆼𑆮 𑆑𑆸𑆠𑇀𑆮𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆱𑆫𑇀𑆮𑆠𑆱𑇀𑆠𑆽𑆬𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆳𑆠𑇀𑇅 𑆘𑆕𑇀𑆓𑆩𑆳𑆠𑇀𑆩𑆑𑆱𑇀𑆠𑆶 𑆮𑆱𑆳, 𑆩𑆘𑇀𑆘𑆳, 𑆱𑆫𑇀𑆥𑆴𑆫𑆴𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆁 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆤𑆶𑆮𑆳𑆱𑆤𑆵𑆪𑆼𑆰𑆶, 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶, 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆮𑆳 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆥𑆴 𑆪𑆾𑆓𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑆴𑆠𑆴𑇆𑇑𑇕𑇐𑇆
𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆥𑆶𑆤𑆫𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑆴𑆓𑇀𑆫𑆶𑆯𑆴𑆫𑆵𑆰𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆥𑆴𑆬𑇀𑆮𑆘𑆳𑆘𑇀𑆪𑆩𑆾𑆢𑆳𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆵𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆽𑆬𑆳𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑆦𑆬𑆳𑆤𑆴 𑆖, 𑆱𑆶𑆩𑆶𑆒𑆱𑆶𑆫𑆱𑆑𑆶𑆜𑆼𑆫𑆑𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆳𑆬𑆩𑆳𑆬𑆑𑆥𑆫𑇀𑆟𑆳𑆱𑆑𑇀𑆰𑆮𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆩𑆷𑆬𑆑𑆬𑆯𑆶𑆤𑆠𑆫𑇀𑆑𑆳𑆫𑆵𑆱𑆫𑇀𑆰𑆥𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆖, 𑆃𑆫𑇀𑆑𑆳𑆬𑆫𑇀𑆑𑆑𑆶𑆰𑇀𑆜𑆤𑆳𑆓𑆢𑆤𑇀𑆠𑆵𑆮𑆖𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆯𑇀𑆮𑆼𑆠𑆳𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆓𑆟𑇀𑆝𑆵𑆫𑆥𑆶𑆰𑇀𑆥𑇀𑆪𑆮𑆳𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆵𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆬𑆵𑆮𑆪𑆱𑇀𑆡𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆩𑆷𑆬𑆳𑆤𑆴 𑆖, 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆩𑆷𑆬𑆑𑆬𑆯𑆶𑆤𑆑𑆤𑇀𑆢𑆳𑆯𑇀𑆖, 𑆬𑆾𑆣𑇀𑆫𑆩𑆢𑆤𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆤𑆴𑆩𑇀𑆧𑆳𑆫𑇀𑆑𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆖, 𑆢𑆼𑆮𑆢𑆳𑆫𑇀𑆮𑆓𑆶𑆫𑆶𑆱𑆫𑆬𑆯𑆬𑇀𑆬𑆑𑆵𑆘𑆴𑆕𑇀𑆓𑆴𑆤𑇀𑆪𑆱𑆤𑆲𑆴𑆕𑇀𑆓𑆶𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆳𑆯𑇀𑆖, 𑆠𑆼𑆘𑆾𑆮𑆠𑆵𑆮𑆫𑆳𑆕𑇀𑆓𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆯𑆾𑆨𑆳𑆚𑇀𑆘𑆤𑆑𑆧𑆸𑆲𑆠𑆵𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆠𑇀𑆮𑆖𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆁, 𑆦𑆬-𑆥𑆠𑇀𑆫-𑆩𑆷𑆬-𑆑𑆤𑇀𑆢-𑆥𑆶𑆰𑇀𑆥-𑆤𑆴𑆫𑇀𑆪𑆳𑆱-𑆠𑇀𑆮𑆓𑆳𑆯𑇀𑆫𑆪𑆨𑆼𑆢𑆳𑆠𑇀𑇅 𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆟𑆴 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆯𑆪𑆳𑆤𑆴 𑆠𑆡𑆳𑇁𑆥𑆫𑆳𑆟𑇀𑆪𑆤𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆥𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆪𑆡𑆳𑆪𑆾𑆓𑆮𑆴𑆲𑆴𑆠𑆳𑆤𑆴 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠 𑆅𑆠𑆴𑇆𑇑𑇕𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆬𑆑𑇀𑆰𑆟𑆳𑆖𑆳𑆫𑇀𑆪𑆯𑆴𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆑𑆳𑆫𑆟𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆃𑆣𑇀𑆪𑆼𑆪𑆳𑆣𑇀𑆪𑆳𑆥𑆤𑆮𑆴𑆣𑆵 𑆱𑆩𑇀𑆨𑆳𑆰𑆳𑆮𑆴𑆣𑆴𑆫𑆼𑆮 𑆖𑇆𑇑𑇕𑇒𑇆
𑆰𑆝𑇀𑆨𑆴𑆫𑆷𑆤𑆳𑆤𑆴 𑆥𑆚𑇀𑆖𑆳𑆯𑆢𑇀𑆮𑆳𑆢𑆩𑆳𑆫𑇀𑆓𑆥𑆢𑆳𑆤𑆴 𑆖𑇅 𑆥𑆢𑆳𑆤𑆴 𑆢𑆯 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆑𑆳𑆫𑆟𑆳𑆢𑆵𑆤𑆴 𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆂𑇆𑇑𑇕𑇓𑇆
𑆱𑆩𑇀𑆥𑇀𑆫𑆯𑇀𑆤𑆯𑇀𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆢𑆼𑆫𑇀𑆤𑆮𑆑𑆾 𑆮𑆩𑆤𑆳𑆢𑆴𑆰𑆶𑇅 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆵𑆪𑆼 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆮𑆴𑆩𑆳𑆤𑆼 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆂𑇆𑇑𑇕𑇔𑇆
𑆧𑆲𑆶𑆮𑆴𑆣𑆩𑆴𑆢𑆩𑆶𑆑𑇀𑆠𑆩𑆫𑇀𑆡𑆘𑆳𑆠𑆁 𑆧𑆲𑆶𑆮𑆴𑆣𑆮𑆳𑆑𑇀𑆪𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆩𑆫𑇀𑆡𑆑𑆳𑆤𑇀𑆠𑆩𑇀𑇅 𑆧𑆲𑆶𑆮𑆴𑆣𑆯𑆶𑆨𑆯𑆧𑇀𑆢𑆱𑆤𑇀𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆁 𑆧𑆲𑆶𑆮𑆴𑆣𑆮𑆳𑆢𑆤𑆴𑆱𑆷𑆢𑆤𑆁 𑆥𑆫𑆼𑆰𑆳𑆩𑇀𑇆𑇑𑇕𑇕𑇆
𑆅𑆩𑆳𑆁 𑆩𑆠𑆴𑆁 𑆧𑆲𑆶𑆮𑆴𑆣𑆲𑆼𑆠𑆶𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆁 𑆮𑆴𑆘𑆘𑇀𑆚𑆴𑆮𑆳𑆤𑇀 𑆥𑆫𑆩𑆠𑆮𑆳𑆢𑆱𑆷𑆢𑆤𑆵𑆩𑇀𑇅 𑆤 𑆱𑆘𑇀𑆘𑆠𑆼 𑆥𑆫𑆮𑆖𑆤𑆳𑆮𑆩𑆫𑇀𑆢𑆤𑆽𑆫𑇀𑆤 𑆯𑆑𑇀𑆪𑆠𑆼 𑆥𑆫𑆮𑆖𑆤𑆽𑆯𑇀𑆖 𑆩𑆫𑇀𑆢𑆴𑆠𑆶𑆩𑇀𑇆𑇑𑇕𑇖𑇆
𑆢𑆾𑆰𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑆶 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆲𑆼𑆠𑆶𑆩𑆠𑇀𑇅 𑆩𑆳𑆤𑆳𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆩𑆳𑆤𑆳𑆤𑆴 𑆤𑆴𑆫𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆴𑆨𑆳𑆓𑆯𑆂𑇆𑇑𑇕𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑆵𑆫𑇀𑆔𑆚𑇀𑆘𑆵𑆮𑆴𑆠𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆢𑆵𑆫𑇀𑆔𑆁 𑆘𑆵𑆮𑆴𑆠𑆩𑆤𑇀𑆮𑆴𑆖𑇀𑆗𑆤𑇀𑆨𑆫𑆢𑇀𑆮𑆳𑆘 𑆇𑆥𑆳𑆓𑆩𑆠𑇀𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆩𑆶𑆓𑇀𑆫𑆠𑆥𑆳 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆯𑆫𑆟𑇀𑆪𑆩𑆩𑆫𑆼𑆯𑇀𑆮𑆫𑆩𑇀𑇆𑇓𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆟𑆳 𑆲𑆴 𑆪𑆡𑆳𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆂𑇅 𑆘𑆓𑇀𑆫𑆳𑆲 𑆤𑆴𑆒𑆴𑆬𑆼𑆤𑆳𑆢𑆳𑆮𑆯𑇀𑆮𑆴𑆤𑆿 𑆠𑆶 𑆥𑆶𑆤𑆱𑇀𑆠𑆠𑆂𑇆𑇔𑇆
𑆃𑆯𑇀𑆮𑆴𑆨𑇀𑆪𑆳𑆁 𑆨𑆓𑆮𑆳𑆚𑇀𑆗𑆑𑇀𑆫𑆂 𑆥𑇀𑆫𑆠𑆴𑆥𑆼𑆢𑆼 𑆲 𑆑𑆼𑆮𑆬𑆩𑇀𑇅 𑆉𑆰𑆴𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆑𑇀𑆫𑆩𑆶𑆥𑆳𑆓𑆩𑆠𑇀𑇆𑇕𑇆
𑆮𑆴𑆔𑇀𑆤𑆨𑆷𑆠𑆳 𑆪𑆢𑆳 𑆫𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆷𑆠𑆳𑆂 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀𑇅 𑆠𑆥𑆾𑆥𑆮𑆳𑆱𑆳𑆣𑇀𑆪𑆪𑆤𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆮𑇀𑆫𑆠𑆳𑆪𑆶𑆰𑆳𑆩𑇀 𑇆𑇖𑇆
𑆠𑆢𑆳 𑆨𑆷𑆠𑆼𑆰𑇀𑆮𑆤𑆶𑆑𑇀𑆫𑆾𑆯𑆁 𑆥𑆶𑆫𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆩𑆲𑆫𑇀𑆰𑆪𑆂𑇅 𑆱𑆩𑆼𑆠𑆳𑆂 𑆥𑆶𑆟𑇀𑆪𑆑𑆫𑇀𑆩𑆳𑆟𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆲𑆴𑆩𑆮𑆠𑆂 𑆯𑆶𑆨𑆼𑇆𑇗𑇆
𑆃𑆕𑇀𑆓𑆴𑆫𑆳 𑆘𑆩𑆢𑆓𑇀𑆤𑆴𑆯𑇀𑆖 𑆮𑆱𑆴𑆰𑇀𑆜𑆂 𑆑𑆯𑇀𑆪𑆥𑆾 𑆨𑆸𑆓𑆶𑆂𑇅 𑆄𑆠𑇀𑆫𑆼𑆪𑆾 𑆓𑆿𑆠𑆩𑆂 𑆱𑆳𑆕𑇀𑆒𑇀𑆪𑆂 𑆥𑆶𑆬𑆱𑇀𑆠𑇀𑆪𑆾 𑆤𑆳𑆫𑆢𑆾𑇁𑆱𑆴𑆠𑆂𑇆𑇘𑇆
𑆃𑆓𑆱𑇀𑆠𑇀𑆪𑆾 𑆮𑆳𑆩𑆢𑆼𑆮𑆯𑇀𑆖 𑆩𑆳𑆫𑇀𑆑𑆟𑇀𑆝𑆼𑆪𑆳𑆯𑇀𑆮𑆬𑆳𑆪𑆤𑆿𑇅 𑆥𑆳𑆫𑆴𑆑𑇀𑆰𑆴𑆫𑇀𑆨𑆴𑆑𑇀𑆰𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆾 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆂 𑆑𑆥𑆴𑆚𑇀𑆘(𑆰𑇀𑆜)𑆬𑆂𑇆𑇙𑇆
𑆮𑆴𑆯𑇀𑆮𑆳𑆩𑆴𑆠𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆡𑇀𑆪𑆿 𑆖 𑆨𑆳𑆫𑇀𑆓𑆮𑆯𑇀𑆖𑇀𑆪𑆮𑆤𑆾𑇁𑆨𑆴𑆘𑆴𑆠𑇀𑇅 𑆓𑆳𑆫𑇀𑆓𑇀𑆪𑆂 𑆯𑆳𑆟𑇀𑆝𑆴𑆬𑇀𑆪𑆑𑆿𑆟𑇀𑆝𑆴𑆬𑇀𑆪𑆿(𑆤𑇀𑆪𑆿)𑆮𑆳𑆫𑇀𑆑𑇀𑆰𑆴𑆫𑇀𑆢𑆼𑆮𑆬𑆓𑆳𑆬𑆮𑆿𑇆𑇑𑇐𑇆
𑆱𑆳𑆕𑇀𑆑𑆸𑆠𑇀𑆪𑆾 𑆧𑆽𑆘𑆮𑆳𑆥𑆴𑆯𑇀𑆖 𑆑𑆶𑆯𑆴𑆑𑆾 𑆧𑆳𑆢𑆫𑆳𑆪𑆟𑆂𑇅 𑆧𑆝𑆴𑆯𑆂 𑆯𑆫𑆬𑆾𑆩𑆳 𑆖 𑆑𑆳𑆥𑇀𑆪𑆑𑆳𑆠𑇀𑆪𑆳𑆪𑆤𑆳𑆮𑆶𑆨𑆿𑇆𑇑𑇑𑇆
𑆑𑆳𑆕𑇀𑆑𑆳𑆪𑆤𑆂 𑆑𑆽𑆑𑆯𑆼𑆪𑆾 𑆣𑆿𑆩𑇀𑆪𑆾 𑆩𑆳𑆫𑆵𑆖𑆑𑆳𑆯𑇀𑆪𑆥𑆿𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆾 𑆲𑆴𑆫𑆟𑇀𑆪𑆳𑆑𑇀𑆰𑆾 𑆬𑆾𑆑𑆳𑆑𑇀𑆰𑆂 𑆥𑆽𑆕𑇀𑆓𑆴𑆫𑆼𑆮 𑆖𑇆𑇑𑇒𑇆
𑆯𑆿𑆤𑆑𑆂 𑆯𑆳𑆑𑆶𑆤𑆼𑆪𑆯𑇀𑆖 𑆩𑆽𑆠𑇀𑆫𑆼𑆪𑆾 𑆩𑆽𑆩𑆠𑆳𑆪𑆤𑆴𑆂𑇅 𑆮𑆽𑆒𑆳𑆤𑆱𑆳 𑆮𑆳𑆬𑆒𑆴𑆬𑇀𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑆖𑆳𑆤𑇀𑆪𑆼 𑆩𑆲𑆫𑇀𑆰𑆪𑆂𑇆𑇑𑇓𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆘𑇀𑆚𑆳𑆤𑆱𑇀𑆪 𑆤𑆴𑆣𑆪𑆾 𑆢(𑆪)𑆩𑆱𑇀𑆪 𑆤𑆴𑆪𑆩𑆱𑇀𑆪 𑆖𑇅 𑆠𑆥𑆱𑆱𑇀𑆠𑆼𑆘𑆱𑆳 𑆢𑆵𑆥𑇀𑆠𑆳 𑆲𑆷𑆪𑆩𑆳𑆤𑆳 𑆅𑆮𑆳𑆓𑇀𑆤𑆪𑆂𑇆𑇑𑇔𑇆
𑆱𑆶𑆒𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆼 𑆠𑆠𑇀𑆫 𑆥𑆶𑆟𑇀𑆪𑆳𑆁 𑆖𑆑𑇀𑆫𑆶𑆂 𑆑𑆡𑆳𑆩𑆴𑆩𑆳𑆩𑇀𑇅𑇑𑇕𑇅 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆩𑆾𑆑𑇀𑆰𑆳𑆟𑆳𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁 𑆩𑆷𑆬𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇑𑇕𑇆
𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑆲𑆫𑇀𑆠𑆳𑆫𑆂 𑆯𑇀𑆫𑆼𑆪𑆱𑆾 𑆘𑆵𑆮𑆴𑆠𑆱𑇀𑆪 𑆖𑇅 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆷𑆠𑆾 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆩𑆤𑇀𑆠𑆫𑆳𑆪𑆾 𑆩𑆲𑆳𑆤𑆪𑆩𑇀𑇆𑇑𑇖𑇆
𑆑𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆼𑆰𑆳𑆁 𑆯𑆩𑆾𑆥𑆳𑆪 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆣𑇀𑆪𑆳𑆤𑆩𑆳𑆱𑇀𑆡𑆴𑆠𑆳𑆂𑇅 𑆃𑆡 𑆠𑆼 𑆯𑆫𑆟𑆁 𑆯𑆑𑇀𑆫𑆁 𑆢𑆢𑆸𑆯𑆶𑆫𑇀𑆣𑇀𑆪𑆳𑆤𑆖𑆑𑇀𑆰𑆶𑆰𑆳𑇆𑇑𑇗𑇆
𑆃𑆲𑆩𑆫𑇀𑆡𑆼 𑆤𑆴𑆪𑆶𑆘𑇀𑆪𑆼𑆪𑆩𑆠𑇀𑆫𑆼𑆠𑆴 𑆥𑇀𑆫𑆡𑆩𑆁 𑆮𑆖𑆂𑇅 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆾𑇁𑆧𑇀𑆫𑆮𑆵𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆸𑆰𑆴𑆨𑆴𑆂 𑆱 𑆤𑆴𑆪𑆾𑆘𑆴𑆠𑆂𑇆𑇑𑇙𑇆
𑆱 𑆯𑆑𑇀𑆫𑆨𑆮𑆤𑆁 𑆓𑆠𑇀𑆮𑆳 𑆱𑆶𑆫𑆫𑇀𑆰𑆴𑆓𑆟𑆩𑆣𑇀𑆪𑆓𑆩𑇀 𑇅 𑆢𑆢𑆫𑇀𑆯 𑆧𑆬𑆲𑆤𑇀𑆠𑆳𑆫𑆁 𑆢𑆵𑆥𑇀𑆪𑆩𑆳𑆤𑆩𑆴𑆮𑆳𑆤𑆬𑆩𑇀𑇆𑇒𑇐𑇆
𑆱𑆾𑇁𑆨𑆴𑆓𑆩𑇀𑆪 𑆘𑆪𑆳𑆯𑆵𑆫𑇀𑆨𑆴𑆫𑆨𑆴𑆤𑆤𑇀𑆢𑇀𑆪 𑆱𑆶𑆫𑆼𑆯𑇀𑆮𑆫𑆩𑇀𑇅 𑆥𑇀𑆫𑆾𑆮𑆳𑆖 𑆮𑆴𑆤𑆪𑆳𑆢𑇀𑆣𑆵𑆩𑆳𑆤𑆸𑆰𑆵𑆟𑆳𑆁 𑆮𑆳𑆑𑇀𑆪𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇒𑇑𑇆
𑆮𑇀𑆪𑆳𑆣𑆪𑆾 𑆲𑆴 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆳𑆂 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆨𑆪𑆕𑇀𑆑𑆫𑆳𑆂𑇅 𑆠𑆢𑇀𑆧𑇀𑆫𑆷𑆲𑆴 𑆩𑆼 𑆯𑆩𑆾𑆥𑆳𑆪𑆁 𑆪𑆡𑆳𑆮𑆢𑆩𑆫𑆥𑇀𑆫𑆨𑆾𑇆𑇒𑇒𑇆
𑆠𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆯𑆠𑆑𑇀𑆫𑆠𑆶𑆂𑇅 𑆥𑆢𑆽𑆫𑆬𑇀𑆥𑆽𑆫𑇀𑆩𑆠𑆴𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆮𑆴𑆥𑆶𑆬𑆳𑆁 𑆥𑆫𑆩𑆫𑇀𑆰𑆪𑆼𑇆𑇒𑇓𑇆
𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆿𑆰𑆣𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆠𑆶𑆫𑆥𑆫𑆳𑆪𑆟𑆩𑇀𑇅 𑆠𑇀𑆫𑆴𑆱𑆷𑆠𑇀𑆫𑆁 𑆯𑆳𑆯𑇀𑆮𑆠𑆁 𑆥𑆶𑆟𑇀𑆪𑆁 𑆧𑆶𑆧𑆶𑆣𑆼 𑆪𑆁 𑆥𑆴𑆠𑆳𑆩𑆲𑆂𑇆𑇒𑇔𑇆
𑆱𑆾𑇁𑆤𑆤𑇀𑆠𑆥𑆳𑆫𑆁 𑆠𑇀𑆫𑆴𑆱𑇀𑆑𑆤𑇀𑆣𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆩𑆲𑆳𑆩𑆠𑆴𑆂𑇅 𑆪𑆡𑆳𑆮𑆢𑆖𑆴𑆫𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆧𑆶𑆧𑆶𑆣𑆼 𑆠𑆤𑇀𑆩𑆤𑆳 𑆩𑆶𑆤𑆴𑆂𑇆𑇒𑇕𑇆
𑆠𑆼𑆤𑆳𑆪𑆶𑆫𑆩𑆴𑆠𑆁 𑆬𑆼𑆨𑆼 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆂 𑆱𑆶𑆒𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇅 𑆉𑆰𑆴𑆨𑇀𑆪𑆾𑇁𑆤𑆣𑆴𑆑𑆁 𑆠𑆖𑇀𑆖 𑆯𑆯𑆁𑆱𑆳𑆤𑆮𑆯𑆼𑆰𑆪𑆤𑇀𑇆𑇒𑇖𑇆
𑆉𑆰𑆪𑆯𑇀𑆖 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆳𑆘𑇀𑆘𑆓𑆸𑆲𑆶𑆱𑇀𑆠𑆁 𑆥𑇀𑆫𑆘𑆳𑆲𑆴𑆠𑆩𑇀𑇅 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆯𑇀𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆤𑇀𑆠𑆾 𑆮𑆼𑆢𑆁 𑆮𑆫𑇀𑆣𑆤𑆩𑆳𑆪𑆶𑆰𑆂𑇆𑇒𑇗𑇆
𑆩𑆲𑆫𑇀𑆰𑆪𑆱𑇀𑆠𑆼 𑆢𑆢𑆸𑆯𑆶𑆫𑇀𑆪𑆡𑆳𑆮𑆘𑇀𑆘𑇀𑆚𑆳𑆤𑆖𑆑𑇀𑆰𑆶𑆰𑆳𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆖 𑆮𑆴𑆯𑆼𑆰𑆁 𑆖 𑆓𑆶𑆟𑆳𑆤𑇀 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆑𑆫𑇀𑆩 𑆖𑇆𑇒𑇘𑇆
𑆃𑆡 𑆩𑆽𑆠𑇀𑆫𑆵𑆥𑆫𑆂 𑆥𑆶𑆟𑇀𑆪𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂𑇅 𑆯𑆴𑆰𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆢𑆠𑇀𑆠𑆮𑆳𑆤𑇀 𑆰𑆝𑇀𑆨𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆶𑆑𑆩𑇀𑆥𑆪𑆳𑇆𑇓𑇐𑇆
𑆃𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆯𑇀𑆖 𑆨𑆼𑆬(𑆝)𑆯𑇀𑆖 𑆘𑆠𑆷𑆑𑆫𑇀𑆟𑆂 𑆥𑆫𑆳𑆯𑆫𑆂𑇅 𑆲𑆳𑆫𑆵𑆠𑆂 𑆑𑇀𑆰𑆳𑆫𑆥𑆳𑆟𑆴𑆯𑇀𑆖 𑆘𑆓𑆸𑆲𑆶𑆱𑇀𑆠𑆤𑇀𑆩𑆶𑆤𑆼𑆫𑇀𑆮𑆖𑆂𑇆𑇓𑇑𑇆
𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆠𑇀𑆫𑆳𑆱𑆵𑆤𑇀𑆤𑆾𑆥𑆢𑆼𑆯𑆳𑆤𑇀𑆠𑆫𑆁 𑆩𑆶𑆤𑆼𑆂𑇅 𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆑𑆫𑇀𑆠𑆳 𑆥𑇀𑆫𑆡𑆩𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆾 𑆪𑆠𑆾𑇁𑆨𑆮𑆠𑇀𑇆𑇓𑇒𑇆
𑆃𑆡 𑆨𑆼𑆬𑆳𑆢𑆪𑆯𑇀𑆖𑆑𑇀𑆫𑆶𑆂 𑆱𑇀𑆮𑆁 𑆱𑇀𑆮𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆁 𑆑𑆸𑆠𑆳𑆤𑆴 𑆖𑇅 𑆯𑇀𑆫𑆳𑆮𑆪𑆳𑆩𑆳𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆁 𑆱𑆫𑇀𑆰𑆴𑆱𑆕𑇀𑆔𑆁 𑆱𑆶𑆩𑆼𑆣𑆱𑆂𑇆𑇓𑇓𑇆
𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆱𑆷𑆠𑇀𑆫𑆟𑆩𑆫𑇀𑆡𑆳𑆤𑆳𑆩𑆸𑆰𑆪𑆂 𑆥𑆶𑆟𑇀𑆪𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀𑇅 𑆪𑆡𑆳𑆮𑆠𑇀𑆱𑆷𑆠𑇀𑆫𑆴𑆠𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆲𑆸𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆼𑇁𑆤𑆶𑆩𑆼𑆤𑆴𑆫𑆼𑇆𑇓𑇔𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆱𑇀𑆠𑆶𑆮𑆁𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆲𑆴𑆠𑆽𑆰𑆴𑆟𑆂𑇅 𑆱𑆳𑆣𑆶 𑆨𑆷𑆠𑆼𑆰𑇀𑆮𑆤𑆶𑆑𑇀𑆫𑆾𑆯 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆖𑆽𑆫𑆧𑇀𑆫𑆶𑆮𑆤𑇀 𑆱𑆩𑆩𑇀𑇆𑇓𑇕𑇆
𑆠𑆁 𑆥𑆶𑆟𑇀𑆪𑆁 𑆯𑆶𑆯𑇀𑆫𑆶𑆮𑆶𑆂 𑆯𑆧𑇀𑆢𑆁 𑆢𑆴𑆮𑆴 𑆢𑆼𑆮𑆫𑇀𑆰𑆪𑆂 𑆱𑇀𑆡𑆴𑆠𑆳𑆂𑇅 𑆱𑆳𑆩𑆫𑆳𑆂 𑆥𑆫𑆩𑆫𑇀𑆰𑆵𑆟𑆳𑆁 𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆩𑆶𑆩𑆶𑆢𑆴𑆫𑆼 𑆥𑆫𑆩𑇀𑇆𑇓𑇖𑇆
𑆃𑆲𑆾 𑆱𑆳𑆣𑇀𑆮𑆴𑆠𑆴 𑆤𑆴𑆫𑇀𑆔𑆾𑆰𑆾 𑆬𑆾𑆑𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑆤𑇀𑆮𑆮𑆳(𑆤𑆳)𑆢𑆪𑆠𑇀𑇅 𑆤𑆨𑆱𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆩𑇀𑆨𑆵𑆫𑆾 𑆲𑆫𑇀𑆰𑆳𑆢𑇀𑆨𑆷𑆠𑆽𑆫𑆶𑆢𑆵𑆫𑆴𑆠𑆂𑇆𑇓𑇗𑇆
𑆯𑆴𑆮𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆮𑆿 𑆱𑆫𑇀𑆮𑆳 𑆨𑆳𑆨𑆴𑆫𑆶𑆤𑇀𑆩𑆵𑆬𑆴𑆠𑆳 𑆢𑆴𑆯𑆂𑇅 𑆤𑆴𑆥𑆼𑆠𑆶𑆂 𑆱𑆘𑆬𑆳𑆯𑇀𑆖𑆽𑆮 𑆢𑆴𑆮𑇀𑆪𑆳𑆂 𑆑𑆶𑆱𑆶𑆩𑆮𑆸𑆰𑇀𑆛𑆪𑆂𑇆𑇓𑇘𑇆
𑆃𑆡𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆥𑇀𑆫𑆩𑆶𑆒𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆯𑆶𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆢𑆼𑆮𑆠𑆳𑆂𑇅 𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆱𑆴𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆩𑆼𑆣𑆳 𑆣𑆸𑆠𑆴𑆂 𑆑𑆵𑆫𑇀𑆠𑆴𑆂 𑆑𑇀𑆰𑆩𑆳 𑆢𑆪𑆳𑇆𑇓𑇙𑇆
𑆠𑆳𑆤𑆴 𑆖𑆳𑆤𑆶𑆩𑆠𑆳𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑆫𑆩𑆫𑇀𑆰𑆴𑆨𑆴𑆂𑇅 𑆨(𑆨𑆳)𑆮𑆳𑆪 𑆨𑆷𑆠𑆱𑆕𑇀𑆔𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆁 𑆨𑆶𑆮𑆴 𑆬𑆼𑆨𑆴𑆫𑆼𑇆𑇔𑇐𑇆
𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆁 𑆱𑆶𑆒𑆁 𑆢𑆶𑆂𑆒𑆩𑆳𑆪𑆶𑆱𑇀𑆠𑆱𑇀𑆪 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆩𑇀𑇅 𑆩𑆳𑆤𑆁 𑆖 𑆠𑆖𑇀𑆖 𑆪𑆠𑇀𑆫𑆾𑆑𑇀𑆠𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆂 𑆱 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇑𑇆
𑆯𑆫𑆵𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆱𑆁𑆪𑆾𑆓𑆾 𑆣𑆳𑆫𑆴 𑆘𑆵𑆮𑆴𑆠𑆩𑇀𑇅 𑆤𑆴𑆠𑇀𑆪𑆓𑆯𑇀𑆖𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆯𑇀𑆖 𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆫𑆳𑆪𑆶𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇒𑇆
𑆠𑆱𑇀𑆪𑆳𑆪𑆶𑆰𑆂 𑆥𑆶𑆟𑇀𑆪𑆠𑆩𑆾 𑆮𑆼𑆢𑆾 𑆮𑆼𑆢𑆮𑆴𑆢𑆳𑆁 𑆩𑆠𑆂𑇅 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆪𑆤𑇀𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆬𑆾𑆑𑆪𑆾𑆫𑆶𑆨𑆪𑆾𑆫𑇀𑆲𑆴𑆠𑆩𑇀 𑇆𑇔𑇓𑇆
𑆱𑆫𑇀𑆮𑆢𑆳 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆲𑇀𑆫𑆳𑆱𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆯𑇀𑆖, 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆶𑆨𑆪𑆱𑇀𑆪 𑆠𑆶𑇆𑇔𑇔𑇆
𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆩𑆼𑆑𑆠𑇀𑆮𑆑𑆫𑆁, 𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆶 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆑𑆸𑆠𑇀𑇅 𑆠𑆶𑆬𑇀𑆪𑆳𑆫𑇀𑆡𑆠𑆳 𑆲𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁, 𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆶 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆂𑇆𑇔𑇕𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆳𑆠𑇀𑆩𑆳 𑆯𑆫𑆵𑆫𑆁 𑆖 𑆠𑇀𑆫𑆪𑆩𑆼𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆢𑆟𑇀𑆝𑆮𑆠𑇀𑇅 𑆬𑆾𑆑𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆩𑇀𑇆𑇔𑇖𑇆
𑆱 𑆥𑆶𑆩𑆳𑆁𑆯𑇀𑆖𑆼𑆠𑆤𑆁 𑆠𑆖𑇀𑆖 𑆠𑆖𑇀𑆖𑆳𑆣𑆴𑆑𑆫𑆟𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇅 𑆮𑆼𑆢𑆱𑇀𑆪𑆳𑆱𑇀𑆪, 𑆠𑆢𑆫𑇀𑆡𑆁 𑆲𑆴 𑆮𑆼𑆢𑆾𑇁𑆪𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆂𑇆𑇔𑇗𑇆
𑆒𑆳𑆢𑆵𑆤𑇀𑆪𑆳𑆠𑇀𑆩𑆳 𑆩𑆤𑆂 𑆑𑆳𑆬𑆾 𑆢𑆴𑆯𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆱𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆖𑆼𑆠𑆤𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆁, 𑆤𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆖𑆼𑆠𑆤𑆩𑇀𑇆𑇔𑇘𑇆
𑆱𑆳𑆫𑇀𑆡𑆳 𑆓𑆶𑆫𑇀𑆮𑆳𑆢𑆪𑆾 𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆳𑆤𑇀𑆠𑆳𑆂 𑆥𑆫𑆳𑆢𑆪𑆂𑇅 𑆓𑆶𑆟𑆳𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆂 ...𑇅𑇔𑇙𑇅 ...𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆳𑆢𑆴 𑆑𑆫𑇀𑆩 𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇙𑇆
𑆱𑆩𑆮𑆳𑆪𑆾𑇁𑆥𑆸𑆡𑆓𑇀𑆨𑆳𑆮𑆾 𑆨𑆷𑆩𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆓𑆶𑆟𑆽𑆫𑇀𑆩𑆠𑆂𑇅 𑆱 𑆤𑆴𑆠𑇀𑆪𑆾 𑆪𑆠𑇀𑆫 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆤 𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆪𑆠𑆾 𑆓𑆶𑆟𑆂𑇆𑇕𑇐𑇆
𑆱𑆁𑆪𑆾𑆓𑆼 𑆖 𑆮𑆴𑆨𑆳𑆓𑆼 𑆖 𑆑𑆳𑆫𑆟𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇅 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆱𑇀𑆪 𑆑𑇀𑆫𑆴𑆪𑆳 𑆑𑆫𑇀𑆩 𑆑𑆫𑇀𑆩 𑆤𑆳𑆤𑇀𑆪𑆢𑆥𑆼𑆑𑇀𑆰𑆠𑆼𑇆𑇕𑇒𑇆
𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆑𑆳𑆫𑆟𑆁...𑇅𑇕𑇓𑇅 ... 𑆑𑆳𑆫𑇀𑆪𑆁 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆩𑆴𑆲𑆾𑆖𑇀𑆪𑆠𑆼𑇅 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆑𑇀𑆫𑆴𑆪𑆳 𑆖𑆾𑆑𑇀𑆠𑆳 𑆠𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆩𑇀𑇆𑇕𑇓𑇆
𑆑𑆳𑆬𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆤𑆳𑆁 𑆪𑆾𑆓𑆾 𑆩𑆴𑆡𑇀𑆪𑆳 𑆤 𑆖𑆳𑆠𑆴 𑆖𑇅 𑆢𑇀𑆮𑆪𑆳𑆯𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾 𑆲𑆼𑆠𑆶𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇆𑇕𑇔𑇆
𑆯𑆫𑆵𑆫𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆁 𑆖 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆳𑆯𑇀𑆫𑆪𑆾 𑆩𑆠𑆂𑇅 𑆠𑆡𑆳 𑆱𑆶𑆒𑆳𑆤𑆳𑆁, 𑆪𑆾𑆓𑆱𑇀𑆠𑆶 𑆱𑆶𑆒𑆳𑆤𑆳𑆁 𑆑𑆳𑆫𑆟𑆁 𑆱𑆩𑆂𑇆𑇕𑇕𑇆
𑆤𑆴𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆂 𑆥𑆫𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆳 𑆱𑆠𑇀𑆠𑇀𑆮𑆨𑆷𑆠𑆓𑆶𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆽𑆂𑇅 𑆖𑆽𑆠𑆤𑇀𑆪𑆼 𑆑𑆳𑆫𑆟𑆁 𑆤𑆴𑆠𑇀𑆪𑆾 𑆢𑇀𑆫𑆰𑇀𑆛𑆳 𑆥𑆯𑇀𑆪𑆠𑆴 𑆲𑆴 𑆑𑇀𑆫𑆴𑆪𑆳𑆂𑇆𑇕𑇖𑇆
𑆮𑆳𑆪𑆶𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆦𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆂 𑆯𑆳𑆫𑆵𑆫𑆾 𑆢𑆾𑆰𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆩𑆳𑆤𑆱𑆂 𑆥𑆶𑆤𑆫𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆾 𑆫𑆘𑆯𑇀𑆖 𑆠𑆩 𑆍𑆮 𑆖𑇆𑇕𑇗𑇆
𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆿𑆰𑆣𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆾 𑆢𑆽𑆮𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆽𑆂𑇅 𑆩𑆳𑆤𑆱𑆾 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆣𑆽𑆫𑇀𑆪𑆱𑇀𑆩𑆸𑆠𑆴𑆱𑆩𑆳𑆣𑆴𑆨𑆴𑆂𑇆𑇕𑇘𑇆
𑆫𑆷𑆑𑇀𑆰𑆂 𑆯𑆵𑆠𑆾 𑆬𑆔𑆶𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆯𑇀𑆖𑆬𑆾𑇁𑆡 𑆮𑆴𑆯𑆢𑆂 𑆒𑆫𑆂𑇅 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆩𑆳𑆫𑆶𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇕𑇙𑇆
𑆱𑆱𑇀𑆤𑆼𑆲𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆖 𑆢𑇀𑆫𑆮𑆩𑆩𑇀𑆬𑆁 𑆱𑆫𑆁 𑆑𑆛𑆶𑇅 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆽𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑆳𑆯𑆶 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇖𑇐𑇆
𑆓𑆶𑆫𑆶𑆯𑆵𑆠𑆩𑆸𑆢𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆣𑆶𑆫𑆱𑇀𑆡𑆴𑆫𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆂𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆂 𑆥𑇀𑆫𑆯𑆩𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆽𑆫𑇀𑆓𑆶𑆟𑆳𑆂𑇆𑇖𑇑𑇆
𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆽𑆫𑇀𑆢𑆼𑆯𑆩𑆳𑆠𑇀𑆫𑆳𑆑𑆳𑆬𑆾𑆥𑆥𑆳𑆢𑆴𑆠𑆽𑆂𑇅 𑆨𑆼𑆰𑆘𑆽𑆫𑇀𑆮𑆴𑆤𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆱𑆩𑇀𑆩𑆠𑆳𑆂𑇆𑇖𑇒𑇆
𑆱𑆳𑆣𑆤𑆁 𑆤 𑆠𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇅𑇖𑇓𑇅 𑆨𑆷𑆪𑆯𑇀𑆖𑆳𑆠𑆾 𑆪𑆡𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇖𑇓𑇆
𑆫𑆱𑆤𑆳𑆫𑇀𑆡𑆾 𑆫𑆱𑆱𑇀𑆠𑆱𑇀𑆪 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆳𑆥𑆂 𑆑𑇀𑆰𑆴𑆠𑆴𑆱𑇀𑆠𑆡𑆳𑇅 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆿 𑆖 𑆮𑆴𑆯𑆼𑆰𑆼 𑆖 𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆳𑆂 𑆒𑆳𑆢𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇆𑇖𑇔𑇆
𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑆩𑇀𑆬𑆾𑇁𑆡 𑆬𑆮𑆟𑆂 𑆑𑆛𑆶𑆑𑆱𑇀𑆠𑆴𑆑𑇀𑆠 𑆍𑆮 𑆖𑇅 𑆑𑆰𑆳𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆰𑆛𑇀𑆑𑆾𑇁𑆪𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇖𑇕𑇆
𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆳 𑆮𑆳𑆪𑆶𑆁, 𑆑𑆰𑆳𑆪𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆂𑇅 𑆘𑆪𑆤𑇀𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆂𑇆𑇖𑇖𑇆
𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑆾𑆰𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆩𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆿 𑆩𑆠𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇖𑇗𑇆
𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆱𑆩𑆬𑆳𑆂 𑆥𑆚𑇀𑆖 𑆬𑆾𑆲𑆳𑆂 𑆱𑆱𑆴𑆑𑆠𑆳𑆂 𑆱𑆶𑆣𑆳𑇅 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆬𑆼 𑆩𑆟𑆪𑆾 𑆬𑆮𑆟𑆁 𑆓𑆽𑆫𑆴𑆑𑆳𑆚𑇀𑆘𑆤𑆼𑇆𑇗𑇐𑇆
𑆨𑆿𑆩𑆩𑆿𑆰𑆣𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆩𑆿𑆢𑇀𑆨𑆴𑆢𑆁 𑆠𑆶 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑇀𑇅 𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆱𑇀𑆠𑆡𑆳 𑆮𑆵𑆫𑆶𑆢𑇀𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆱𑇀𑆠𑆡𑆿𑆰𑆣𑆴𑆂𑇆𑇗𑇑𑇆
𑆦𑆬𑆽𑆫𑇀𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆂 𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑇀𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆂 𑆦𑆬𑆽𑆫𑆥𑆴𑇅 𑆏𑆰𑆣𑇀𑆪𑆂 𑆦𑆬𑆥𑆳𑆑𑆳𑆤𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆠𑆳𑆤𑆽𑆫𑇀𑆮𑆵𑆫𑆶𑆣𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇗𑇒𑇆
𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆤𑆳𑆬(𑆝)𑆱𑇀𑆮𑆫𑆱𑆥𑆬𑇀𑆬𑆮𑆳𑆂𑇅 𑆑𑇀𑆰𑆳𑆫𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆦𑆬𑆁 𑆥𑆶𑆰𑇀𑆥𑆁 𑆨𑆱𑇀𑆩 𑆠𑆽𑆬𑆳𑆤𑆴 𑆑𑆟𑇀𑆛𑆑𑆳𑆂𑇆𑇗𑇓𑇆
𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆯𑆶𑆕𑇀𑆓𑆳𑆂 𑆑𑆤𑇀𑆢𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆫𑆾𑆲𑆳𑆯𑇀𑆖𑆿𑆢𑇀𑆨𑆴𑆢𑆾 𑆓𑆟𑆂𑇅𑇗𑇔𑇅 𑆩𑆷𑆬𑆴𑆤𑇀𑆪𑆂 𑆰𑆾𑆝𑆯𑆽𑆑𑆾𑆤𑆳 𑆦𑆬𑆴𑆤𑇀𑆪𑆾 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇗𑇔𑇆
𑆩𑆲𑆳𑆱𑇀𑆤𑆼𑆲𑆳𑆯𑇀𑆖 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑆚𑇀𑆖𑆽𑆮 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇅 𑆃𑆰𑇀𑆛𑆿 𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆳𑆮𑆼𑆮 𑆥𑆪𑆳𑆁𑆱𑆴 𑆖𑇆𑇗𑇕𑇆
𑆯𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆳𑆯𑇀𑆖 𑆰𑆝𑇀 𑆮𑆸𑆑𑇀𑆰𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆤𑆴𑆢𑆫𑇀𑆯𑆴𑆠𑆳𑆂𑇅 𑆪 𑆍𑆠𑆳𑆤𑇀 𑆮𑆼𑆠𑇀𑆠𑆴 𑆱𑆁𑆪𑆾𑆑𑇀𑆠𑆶𑆁 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆱 𑆮𑆼𑆢𑆮𑆴𑆠𑇀𑇆𑇗𑇖𑇆
𑆲𑆱𑇀𑆠𑆴𑆢𑆤𑇀𑆠𑆵 𑆲𑆽𑆩𑆮𑆠𑆵 𑆯𑇀𑆪𑆳𑆩𑆳 𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑆣𑆾𑆓𑆶𑆝𑆳𑇅 𑆱𑆥𑇀𑆠𑆬𑆳 𑆯𑇀𑆮𑆼𑆠𑆤𑆳𑆩𑆳 𑆖 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆯𑇀𑆫𑆼𑆟𑆵 𑆓𑆮𑆳𑆑𑇀𑆰𑇀𑆪𑆥𑆴𑇆𑇗𑇗𑇆
𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵 𑆖 𑆧𑆴𑆩𑇀𑆧𑆵 𑆖 𑆯𑆟𑆥𑆶𑆰𑇀𑆥𑆵 𑆮𑆴𑆰𑆳𑆟𑆴𑆑𑆳𑇅 𑆃𑆘𑆓𑆤𑇀𑆣𑆳 𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵 𑆖 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆵 𑆖𑆳𑆠𑇀𑆫 𑆰𑆾𑆝𑆯𑆵𑇆𑇗𑇘𑇆
𑆯𑆟𑆥𑆶𑆰𑇀𑆥𑆵 𑆖 𑆧𑆴𑆩𑇀𑆧𑆵 𑆖 𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆼 𑆲𑆽𑆩𑆮𑆠𑇀𑆪𑆥𑆴𑇅 𑆯𑇀𑆮𑆼𑆠𑆳 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵 𑆖𑆽𑆮 𑆪𑆾𑆘𑇀𑆪𑆳 𑆯𑆵𑆫𑇀𑆰𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇆𑇗𑇙𑇆
𑆍𑆑𑆳𑆢𑆯𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆳 𑆪𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆱𑇀𑆠𑆳 𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇅 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳 𑆤𑆳𑆩𑆑𑆫𑇀𑆩𑆨𑇀𑆪𑆳𑆁 𑆩𑆷𑆬𑆴𑆤𑇀𑆪𑆂...𑇅𑇘𑇐𑇅 ...𑆦𑆬𑆴𑆤𑆵𑆂 𑆯𑆸𑆟𑆶𑇆𑇘𑇐𑇆
𑆯𑆕𑇀𑆒𑆴𑆤𑇀𑆪𑆡 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆴 𑆠𑇀𑆫𑆥𑆶𑆰𑆁 𑆩𑆢𑆤𑆳𑆤𑆴 𑆖𑇅 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆩𑆡𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶 𑆘𑆵𑆩𑆷𑆠𑆁 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆩𑇀𑇅 𑆄𑆤𑆷𑆥𑆁 𑆱𑇀𑆡𑆬𑆘𑆁 𑆖𑆽𑆮 𑆑𑇀𑆬𑆵𑆠𑆑𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇘𑇑𑇆
𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆳𑆫𑆓𑇀𑆮𑆣𑆪𑆾𑆂 𑆦𑆬𑆁 𑆪𑆠𑇀 𑆑𑆶𑆛𑆘𑆱𑇀𑆪 𑆖𑇅 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆩𑆡𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶 𑆘𑆵𑆩𑆷𑆠𑆁 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆩𑇀𑇆𑇘𑇓𑇆
𑆩𑆢𑆤𑆁 𑆑𑆶𑆛𑆘𑆁 𑆖𑆽𑆮 𑆠𑇀𑆫𑆥𑆶𑆰𑆁 𑆲𑆱𑇀𑆠𑆴𑆥𑆫𑇀𑆟𑆴𑆤𑆵𑇅 𑆍𑆠𑆳𑆤𑆴 𑆮𑆩𑆤𑆼 𑆖𑆽𑆮 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆼𑆰𑆶 𑆖𑇆𑇘𑇔𑇆
𑆤𑆱𑇀𑆠𑆂 𑆥𑇀𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆼 𑆖𑆽𑆮 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆳 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆢𑆯 𑆪𑆳𑆤𑇀𑆪𑆮𑆯𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆠𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇆𑇘𑇕𑇆
𑆤𑆳𑆩𑆑𑆫𑇀𑆩𑆨𑆴𑆫𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆦𑆬𑆳𑆤𑇀𑆪𑆼𑆑𑆾𑆤𑆮𑆴𑆁𑆯𑆠𑆴𑆂𑇅𑇘𑇖𑇅 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆮𑆱𑆳 𑆩𑆘𑇀𑆘𑆳 𑆱𑇀𑆤𑆼𑆲𑆾 𑆢𑆴𑆰𑇀𑆛𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑇆𑇘𑇖𑇆
𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆧𑆱𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆤𑆱𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆖𑆽𑆮 𑆪𑆾𑆓𑆠𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆤𑆳 𑆘𑆵𑆮𑆤𑆳 𑆮𑆫𑇀𑆟𑇀𑆪𑆳 𑆧𑆬𑆾𑆥𑆖𑆪𑆮𑆫𑇀𑆣𑆤𑆳𑆂𑇆𑇘𑇗𑇆
𑆱𑇀𑆤𑆼𑆲𑆳 𑆲𑇀𑆪𑆼𑆠𑆼 𑆖 𑆮𑆴𑆲𑆴𑆠𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆥𑆲𑆳𑆂𑇅𑇘𑇘𑇅 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆖 𑆮𑆴𑆝𑆩𑆿𑆢𑇀𑆨𑆴𑆢𑆩𑆼𑆮 𑆖𑇆𑇘𑇘𑇆
𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆼𑆟 𑆱𑆲𑆽𑆠𑆳𑆤𑆴 𑆥𑆚𑇀𑆖 𑆱𑇀𑆪𑆶𑆫𑇀𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆢𑆵𑆥𑆤𑆵𑆪𑆠𑆩𑆳𑆤𑆴 𑆖𑇆𑇘𑇙𑇆
𑆄𑆬𑆼𑆥𑆤𑆳𑆫𑇀𑆡𑆼 𑆪𑆶𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆮𑆴𑆣𑆿 𑆠𑆡𑆳𑇅 𑆃𑆣𑆾𑆨𑆳𑆓𑆾𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆼𑆰𑆶 𑆤𑆴𑆫𑆷𑆲𑆼𑆰𑇀𑆮𑆤𑆶𑆮𑆳𑆱𑆤𑆼𑇆𑇙𑇐𑇆
𑆃𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆼 𑆨𑆾𑆘𑆤𑆳𑆫𑇀𑆡𑆼 𑆯𑆴𑆫𑆱𑆯𑇀𑆖 𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇅 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆟𑆴 𑆮𑆫𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆚𑇀𑆘𑆤𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆼𑆰𑆶 𑆖𑇆𑇙𑇑𑇆
𑆃𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑆳𑆲𑆪𑆾𑆫𑇀𑆮𑆳𑆠𑆼 𑆓𑆶𑆬𑇀𑆩𑆼 𑆯𑆷𑆬𑆼 𑆠𑆡𑆾𑆢𑆫𑆼𑇅 𑆇𑆑𑇀𑆠𑆳𑆤𑆴 𑆬𑆮𑆟𑆳(𑆤𑆴)...𑇅𑇙𑇒𑇅 ... 𑆤𑇀𑆪𑆷(𑆈)𑆫𑇀𑆣𑇀𑆮𑆁 𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆰𑇀𑆛𑆿 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼𑇆𑇙𑇒𑇆
𑆩𑆶𑆒𑇀𑆪𑆳𑆤𑆴 𑆪𑆳𑆤𑆴 𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆳𑆠𑇀𑆫𑆼𑆪𑆯𑆳𑆱𑆤𑆼𑇅 𑆃𑆮𑆴𑆩𑆷𑆠𑇀𑆫𑆩𑆘𑆳𑆩𑆷𑆠𑇀𑆫𑆁 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆁 𑆩𑆳𑆲𑆴𑆰𑆁 𑆖 𑆪𑆠𑇀 𑇆𑇙𑇓𑇆
𑆲𑆱𑇀𑆠𑆴𑆩𑆷𑆠𑇀𑆫𑆩𑆡𑆾𑆰𑇀𑆛𑇀𑆫𑆱𑇀𑆪 𑆲𑆪𑆱𑇀𑆪 𑆖 𑆒𑆫𑆱𑇀𑆪 𑆖𑇅 𑆇𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆡𑆾𑇁𑆫𑆷𑆑𑇀𑆰𑆁 𑆑𑆛𑆶𑆑𑆁 𑆬𑆮𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇆𑇙𑇔𑇆
𑆩𑆷𑆠𑇀𑆫𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆼 𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆬𑆼𑆥𑆤𑆼𑆰𑆶 𑆖𑇅 𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆼 𑆩𑆷𑆠𑇀𑆫𑆁 𑆪𑆶𑆑𑇀𑆠𑆁 𑆖𑆳𑆥𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇆𑇙𑇕𑇆
𑆱𑇀𑆮𑆼𑆢𑆼𑆰𑇀𑆮𑆥𑆴 𑆖 𑆠𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆤𑆳𑆲𑆼𑆰𑇀𑆮𑆓𑆢𑆼𑆰𑆶 𑆖𑇅 𑆇𑆢𑆫𑆼𑆰𑇀𑆮𑆡 𑆖𑆳𑆫𑇀𑆯𑆂𑆱𑆶 𑆓𑆶𑆬𑇀𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆴𑆑𑆴𑆬𑆳𑆱𑆴𑆰𑆶 𑇆𑇙𑇖𑇆
𑆠𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆶𑆥𑆤𑆳𑆲𑆼𑆰𑆶 𑆥𑆫𑆴𑆰𑆼𑆑𑆼 𑆠𑆡𑆽𑆮 𑆖𑇅 𑆢𑆵𑆥𑆤𑆵𑆪𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆁 𑆖 𑆑𑇀𑆫𑆴𑆩𑆴𑆔𑇀𑆤𑆁 𑆖𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇙𑇗𑇆

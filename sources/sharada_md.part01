𑆢𑆴𑆤𑆼𑆰𑆶 𑆠𑆼𑆰𑆶 𑆢𑆼𑆪𑆳𑆤𑆴 𑆠𑆢𑇀𑆨𑆷𑆠𑆮𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆪𑆼 𑇅 𑆢𑆼𑆮𑆓𑇀𑆫𑆲𑆼 𑆢𑆼𑆮𑆓𑆸𑆲𑆼 𑆲𑆶𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆤𑆴𑆁 𑆥𑇀𑆫𑆳(𑆢𑆳) 𑆥𑆪𑆼𑆢𑇀𑆮𑆬𑆴𑆩𑇀 𑇆𑇓𑇒𑇆
𑆑𑆶𑆯𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆥𑆷𑆥𑆳𑆘𑇀𑆪𑆖𑇀𑆗𑆠𑇀𑆫𑆥𑆳𑆪𑆱𑆱𑆩𑇀𑆨𑆸𑆠𑆩𑇀 𑇅 𑆃𑆱𑆶𑆫𑆳𑆪 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆖𑆠𑇀𑆮𑆫𑆳𑆢𑆴𑆰𑆶 𑇆𑇓𑇓𑇆
𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆱𑇀𑆪 𑆓𑆮𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆩𑆢𑇀𑆪𑆩𑆳𑆁𑆱𑆳𑆩𑇀𑆧𑆶𑆘𑆳𑆕𑇀𑆓𑆬𑆩𑇀 𑇅 𑆲𑆸𑆢𑇀𑆪𑆼 𑆮𑆼𑆯𑇀𑆩𑆤𑆴 𑆪𑆑𑇀𑆰𑆱𑇀𑆪 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆱𑆸𑆑𑇀𑆱𑆶𑆫𑆳𑆢𑆴𑆨𑆴𑆂 𑇆𑇓𑇔𑇆
𑆃𑆠𑆴𑆩𑆶𑆑𑇀𑆠𑆑𑆑𑆶𑆤𑇀𑆢𑆳𑆧𑇀𑆘𑆽𑆂 𑆥𑆶𑆰𑇀𑆥𑆽𑆯𑇀𑆖 𑆮𑆴𑆠𑆫𑆼𑆢𑇀𑆮𑆬𑆴𑆩𑇀 𑇅 𑆤𑆢𑇀𑆪𑆳𑆁 𑆥𑆴𑆠𑆸𑆓𑇀𑆫𑆲𑆳𑆪𑆼𑆰𑇀𑆛𑆁 𑆑𑆶𑆯𑆳𑆱𑇀𑆠𑆫𑆟𑆨𑆷𑆰𑆴𑆠𑆩𑇀 𑇆𑇓𑇕𑇆
𑆠𑆠𑇀𑆫𑆽𑆮𑆾𑆥𑆲𑆫𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆤𑆳𑆓𑆳𑆪 𑆮𑆴𑆮𑆴𑆣𑆁 𑆧𑆬𑆴𑆩𑇀 𑇅 𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆼 𑆫𑆳𑆑𑇀𑆰𑆱𑆱𑇀𑆪 𑆨𑆵𑆩𑆼𑆰𑆶 𑆓𑆲𑆤𑆼𑆰𑆶 𑆮𑆳 𑇆𑇓𑇖𑇆
𑆯𑆷𑆤𑇀𑆪𑆳𑆓𑆳𑆫𑆼 𑆥𑆴𑆯𑆳𑆖𑆱𑇀𑆪 𑆠𑆵𑆮𑇀𑆫𑆁 𑆧𑆬𑆴𑆩𑆶𑆥𑆳𑆲𑆫𑆼𑆠𑇀 𑇅 𑆥𑆷𑆫𑇀𑆮𑆩𑆳𑆖𑆫𑆴𑆠𑆽𑆫𑇀𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆫𑇀𑆨𑆷𑆠𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑆴𑆢𑆫𑇀𑆯𑆴𑆠𑆽𑆂 𑇆𑇓𑇗𑇆
𑆤 𑆯𑆑𑇀𑆪𑆳 𑆧𑆬𑆴𑆨𑆴𑆫𑇀𑆘𑆼𑆠𑆶𑆁 𑆪𑆾𑆓𑆽𑆱𑇀𑆠𑆳𑆤𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆃𑆘𑆫𑇀𑆑𑇀𑆰𑆖𑆫𑇀𑆩𑆫𑆾𑆩𑆳𑆟𑆴 𑆯𑆬𑇀𑆪𑆑𑆾𑆬𑆷𑆑𑆪𑆾𑆱𑇀𑆠𑆡𑆳 𑇆𑇓𑇘𑇆
𑆲𑆴𑆕𑇀𑆓𑆶 𑆩𑆷𑆠𑇀𑆫𑆁 𑆖 𑆧𑆱𑇀𑆠𑆱𑇀𑆪 𑆣𑆷𑆩𑆩𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆍𑆠𑆼𑆤 𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆧𑆬𑆮𑆳𑆤𑆥𑆴 𑆪𑆾 𑆓𑇀𑆫𑆲𑆂 𑇆𑇓𑇙𑇆
𑆓𑆘𑆳𑆲𑇀𑆮𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆮𑇀𑆪𑆾𑆰𑆳𑆩𑆬𑆑𑆱𑆫𑇀𑆰𑆥𑆳𑆤𑇀 𑇅 𑆓𑆾𑆣𑆳𑆤𑆑𑆶𑆬𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆉𑆰𑇀𑆪𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆥𑆼𑆰𑆴𑆠𑆳𑆤𑇀 𑇆𑇔𑇐𑇆
𑆤𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆱𑆼𑆑𑆼𑆰𑆶 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆪𑆾𑆓𑆠𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆠𑇀 𑇅𑇔𑇑𑇅 𑆒𑆫𑆳𑆯𑇀𑆮𑆳𑆯𑇀𑆮𑆠𑆫𑆾𑆬𑆷𑆑𑆑𑆫𑆨𑆯𑇀𑆮𑆯𑆸𑆓𑆳𑆬𑆘𑆩𑇀 𑇆𑇔𑇑𑇆
𑆥𑆶𑆫𑆵𑆰𑆁 𑆓𑆸𑆣𑇀𑆫𑆑𑆳𑆑𑆳𑆤𑆳𑆁 𑆮𑆫𑆳𑆲𑆱𑇀𑆪 𑆖 𑆥𑆼𑆰𑆪𑆼𑆠𑇀 𑇅 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆣𑆴𑆠𑆩𑇀 𑇆𑇔𑇒𑇆
𑆯𑆴𑆫𑆵𑆰𑆧𑆵𑆘𑆁 𑆬𑆯𑆶𑆤𑆁 𑆯𑆶𑆟𑇀𑆜𑆵𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆁 𑆮𑆖𑆳𑆩𑇀 𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆁 𑆫𑆘𑆤𑆵𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆁 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆼𑆰𑆪𑆼𑆠𑇀 𑇆𑇔𑇓𑇆
𑆮𑆫𑇀𑆠𑇀𑆪𑆯𑇀𑆗𑆳𑆪𑆳𑆮𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆱𑇀𑆠𑆳𑆂 𑆱𑆥𑆴𑆠𑇀𑆠𑆳 𑆤𑆪𑆤𑆳𑆚𑇀𑆘𑆤𑆩𑇀 𑇅 𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆦𑆬𑆁 𑆮𑇀𑆪𑆾𑆰𑆁 𑆩𑆷𑆬𑆁 𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆧𑆴𑆬𑇀𑆮𑆪𑆾𑆂 𑇆𑇔𑇔𑇆
𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆖 𑆑𑆸𑆠𑆳 𑆮𑆫𑇀𑆠𑇀𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆤𑇀𑆤𑆪𑆤𑆳𑆚𑆘𑆤𑆩𑇀 𑇅 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆑𑆛𑆶𑆑𑆳𑆁 𑆲𑆴𑆕𑇀𑆓𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆁 𑆖 𑆮𑆖𑆳𑆩𑆥𑆴 𑇅 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆱𑆩𑇀𑆥𑆴𑆰𑇀𑆛𑆁 𑆩𑆠𑇀𑆱𑇀𑆪𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇆𑇔𑇕𑇆
𑆪𑆼 𑆪𑆼 𑆓𑇀𑆫𑆲𑆳 𑆤 𑆱𑆴𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆤𑆪𑆤𑆳𑆚𑇀𑆘𑆤𑆩𑇀 𑇅 𑆥𑆶𑆫𑆳𑆟𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆬𑆯𑆶𑆤𑆁 𑆲𑆴𑆕𑇀𑆓 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆁 𑆮𑆖𑆳 𑇆𑇔𑇖𑇆
𑆓𑆾𑆬𑆾𑆩𑆵 𑆖𑆳𑆘𑆬𑆾𑆩𑆵 𑆖 𑆨𑆷𑆠𑆑𑆼𑆯𑆵 𑆘𑆛𑆳 𑆠𑆡𑆳 𑇅 𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆳 𑆱𑆫𑇀𑆥𑆓𑆤𑇀𑆣𑆳 𑆖 𑆠𑆡𑆳 𑆑𑆳𑆟𑆮𑆴𑆑𑆳𑆟𑆴𑆑𑆼 𑇆𑇔𑇗𑇆
𑆮𑆘𑇀𑆫𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆮𑆪𑆂𑆱𑇀𑆡𑆳 𑆖 𑆯𑆸𑆕𑇀𑆓𑆵 𑆩𑆾𑆲𑆤𑆮𑆬𑇀𑆬𑆴𑆑𑆳 𑇅 𑆃𑆫𑇀𑆑𑆩𑆷𑆬𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆁 𑆬𑆠𑆳 𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆩𑆚𑇀𑆘𑆤𑆩𑇀 𑇆𑇔𑇘𑇆
𑆤𑆽𑆥𑆳𑆬𑆵 𑆲𑆫𑆴𑆠𑆳𑆬𑆁 𑆖 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆳 𑆪𑆼 𑆖 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆱𑆴𑆁𑆲𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆫𑇀𑆑𑇀𑆰𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆢𑇀𑆮𑆵𑆥𑆴𑆮𑆳𑆘𑆴𑆓𑆮𑆳𑆁 𑆠𑆡𑆳 𑇆𑇔𑇙𑇆
𑆯𑇀𑆮𑆳𑆮𑆴𑆖𑇀𑆗𑆬𑇀𑆪𑆑𑆓𑆾𑆣𑆳𑆤𑆳𑆩𑆶𑆰𑇀𑆛𑇀𑆫𑆱𑇀𑆪 𑆤𑆑𑆶𑆬𑆱𑇀𑆪 𑆖 𑇅 𑆮𑆴𑆛𑇀𑆠𑇀𑆮𑆓𑇀𑆫𑆾𑆩𑆮𑆱𑆳𑆩𑆷𑆠𑇀𑆫𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆒𑆳𑆢𑆪𑆂 𑇆𑇕𑇐𑇆
𑆃𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆫𑇀𑆓𑆼 𑆨𑆴𑆰𑆑𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆽𑆬𑆳𑆤𑆴 𑆖 𑆔𑆸𑆠𑆳𑆤𑆴 𑆖 𑇅 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆤𑆱𑇀𑆪𑆼𑆰𑆶 𑆠𑆳𑆤𑆴 𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆘𑆳𑆤𑆠𑆳 𑇆𑇕𑇑𑇆
𑆃𑆮𑆥𑆵𑆝𑆼𑇁𑆚𑇀𑆘𑆤𑆼 𑆖𑆽𑆮 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆓𑆶𑆛𑆴𑆑𑆵𑆑𑆸𑆠𑆩𑇀 𑇅 𑆮𑆴𑆢𑆣𑆵𑆠 𑆥𑆫𑆵𑆰𑆼𑆑𑆼 𑆑𑇀𑆮𑆡𑆴𑆠𑆁, 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆠𑆡𑆳 𑇆𑇕𑇒𑇆
𑆇𑆢𑇀𑆣𑆷𑆬𑆤𑆼, 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆁 𑆥𑇀𑆫𑆢𑆼𑆲𑆼 𑆖𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆍𑆰 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆱𑇀𑆠𑆶 𑆩𑆳𑆤𑆱𑆳𑆤𑆥𑆫𑆳𑆘𑆴𑆠𑆂 𑇆𑇕𑇓𑇆
𑆲𑆤𑇀𑆪𑆳𑆢𑆬𑇀𑆥𑆼𑆤 𑆑𑆳𑆬𑆼𑆤 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆫𑆥𑆴 𑆖 𑆑𑇀𑆫𑆩𑆂 𑇅 𑆤 𑆖𑆳𑆖𑆿𑆑𑇀𑆰𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆥𑇀𑆫𑆪𑆾𑆓𑆁 𑆢𑆼𑆮𑆠𑆳𑆓𑇀𑆫𑆲𑆼 𑇆𑇕𑇔𑇆

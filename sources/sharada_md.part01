𑆥𑆳𑆩𑆳𑆯𑇀𑆮𑆼𑆠𑆳𑆫𑆶𑆟𑆯𑇀𑆪𑆳𑆮𑆳𑆂 𑆑𑆟𑇀𑆝𑆷𑆬𑆳𑆂 𑆥𑆴𑆝𑆑𑆳 𑆨𑆸𑆯𑆩𑇀𑇅 𑆱𑇀𑆦𑆾𑆛𑆳𑆂 𑆯𑇀𑆮𑆼𑆠𑆳𑆫𑆶𑆟𑆳𑆨𑆳𑆱𑆾 𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆳𑆂 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆤𑆶𑆠𑇀𑆮𑆖𑆂𑇆𑇒𑇕𑇆
𑆫𑆑𑇀𑆠𑆁 𑆯𑇀𑆪𑆳𑆮𑆁 𑆱𑆢𑆳𑆲𑆳𑆫𑇀𑆠𑆴 𑆯𑆠𑆳𑆫𑆶𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆧𑆲𑆶𑆮𑇀𑆫𑆟𑆩𑇀𑇅 𑆱𑆑𑆟𑇀𑆝𑆷𑆂 𑆥𑆴𑆝𑆑𑆳 𑆯𑇀𑆪𑆳𑆮𑆳 𑆧𑆲𑆶𑆱𑇀𑆫𑆳𑆮𑆳 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳𑇆𑇒𑇖𑇆
𑆅𑆠𑇀𑆪𑆼𑆑𑆳𑆢𑆯 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴𑇅 𑆮𑆳𑆠𑆼𑇁𑆣𑆴𑆑𑆠𑆫𑆼 𑆑𑆶𑆰𑇀𑆜𑆁 𑆑𑆳𑆥𑆳𑆬𑆁 𑆩𑆟𑇀𑆝𑆬𑆁 𑆑𑆦𑆼𑇅 𑆥𑆴𑆠𑇀𑆠𑆼 𑆠𑇀𑆮𑆿𑆢𑆶𑆩𑇀𑆧𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆳𑆑𑆟𑆁 𑆠𑆶 𑆠𑇀𑆫𑆢𑆾𑆰𑆘𑆩𑇀𑇆𑇒𑇗𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆖𑆳𑆣𑆴𑆑𑆼𑇅 𑆉𑆰𑇀𑆪𑆘𑆴𑆲𑇀𑆮𑆁 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆱𑆴𑆣𑇀𑆩𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆘𑆳𑆪𑆠𑆼𑇆𑇒𑇘𑇆
𑆖𑆫𑇀𑆩𑆳𑆒𑇀𑆪𑆩𑆼𑆑𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆑𑆴𑆛𑆴𑆩𑆁 𑆱𑆮𑆴𑆥𑆳𑆢𑆴𑆑𑆩𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆁 𑆖𑆳𑆬𑆱𑆑𑆁 𑆘𑇀𑆚𑆼𑆪𑆁 𑆥𑇀𑆫𑆳𑆪𑆾 𑆮𑆳𑆠𑆑𑆦𑆳𑆣𑆴𑆑𑆩𑇀𑇆𑇒𑇙𑇆
𑆥𑆳𑆩𑆳 𑆯𑆠𑆳𑆫𑆶𑆫𑇀𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆁 𑆢𑆢𑇀𑆫𑆶𑆯𑇀𑆖𑆫𑇀𑆩𑆢𑆬𑆁 𑆠𑆡𑆳𑇅 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆣𑆴𑆑𑆁 𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆦𑆥𑇀𑆫𑆳𑆪𑆳 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳𑇆𑇓𑇐𑇆
𑆱𑆫𑇀𑆮𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑆶 𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆽𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑇀𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆑𑇀𑆫𑆴𑆪𑆳𑇆𑇓𑇑𑇆
𑆢𑆾𑆰𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆥𑆯𑇀𑆪𑆼𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆮𑆴𑆯𑆼𑆰𑆬𑆴𑆕𑇀𑆓𑆩𑆢𑇀𑆫𑆴𑆑𑇀𑆠𑆩𑇀𑇅 𑆠𑆱𑇀𑆪𑆽𑆮 𑆯𑆩𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑆂 𑆥𑆫𑆁 𑆖𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆱𑇀𑆪𑇆𑇓𑇒𑇆
𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆢𑆾𑆰𑆳 𑆢𑆾𑆰𑆮𑆴𑆯𑆼𑆰𑆽𑆂 𑆥𑆶𑆤𑆯𑇀𑆖 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴𑇅 𑆘𑇀𑆚𑆳𑆪𑆤𑇀𑆠𑆼 𑆠𑆽𑆫𑇀𑆲𑆼𑆠𑆶𑆫𑇀𑆲𑆼𑆠𑆶𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆳𑆯𑆪𑆠𑆴𑇆𑇓𑇓𑇆
𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆯𑆾𑆰𑆱𑇀𑆠𑆾𑆢𑆂 𑆯𑆷𑆬𑆁 𑆱𑆕𑇀𑆑𑆾𑆖𑆤𑆁 𑆠𑆡𑆳𑇁𑇁𑆪𑆳𑆩𑆂𑇅 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆁 𑆒𑆫𑆨𑆳𑆮𑆾 𑆲𑆫𑇀𑆰𑆂 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆠𑇀𑆮𑆁 𑆖𑇆𑇓𑇔𑇆
𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆮𑆳𑆠𑆬𑆴𑆕𑇀𑆓𑆁, 𑆢𑆳𑆲𑆾 𑆫𑆳𑆓𑆂 𑆥𑆫𑆴𑆱𑇀𑆫𑆮𑆂 𑆥𑆳𑆑𑆂𑇅 𑆮𑆴𑆱𑇀𑆫𑆾 𑆓𑆤𑇀𑆣𑆂 𑆑𑇀𑆬𑆼𑆢𑆱𑇀𑆠𑆡𑆳𑇁𑆕𑇀𑆓𑆥𑆠𑆤𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑆩𑇀𑇆𑇓𑇕𑇆
𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆑𑆟𑇀𑆝𑆷𑆂 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆖𑆾𑆠𑇀𑆱𑆼𑆣𑆓𑆿𑆫𑆮𑆱𑇀𑆤𑆼𑆲𑆳𑆂𑇅 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆠𑆶 𑆑𑆦𑆬𑆴𑆕𑇀𑆓𑆁 𑆘𑆤𑇀𑆠𑆶𑆨𑆴𑆫𑆨𑆴𑆨𑆑𑇀𑆰𑆟𑆁 𑆑𑇀𑆬𑆼𑆢𑆂𑇆𑇓𑇖𑇆
𑆱𑆫𑇀𑆮𑆽𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆢𑆧𑆬𑆩𑇀𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆳𑆲𑆥𑆫𑆵𑆠𑆁 𑆯𑆳𑆤𑇀𑆠𑆳𑆓𑇀𑆤𑆴𑆁 𑆘𑆤𑇀𑆠𑆶𑆨𑆴𑆫𑇀𑆘𑆓𑇀𑆣𑆩𑇀𑇆𑇓𑇗𑇆
𑆮𑆳𑆠𑆑𑆦𑆥𑇀𑆫𑆧𑆬𑆁 𑆪𑆢𑇀𑆪𑆢𑆼𑆑𑆢𑆾𑆰𑆾𑆬𑇀𑆧𑆟𑆁 𑆤 𑆠𑆠𑇀 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆩𑇀𑇅 𑆑𑆦𑆥𑆴𑆠𑇀𑆠-𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆧𑆬𑆳𑆤𑆴 𑆠𑆶 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴𑇆𑇓𑇘𑇆
𑆮𑆳𑆠𑆾𑆠𑇀𑆠𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆩𑆤𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆠𑇀𑆠𑆫𑆼𑆰𑆶 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶𑇅 𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆼𑆰𑆶 𑆩𑆾𑆑𑇀𑆰𑆾 𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖𑆳𑆓𑇀𑆫𑆼𑇆𑇓𑇙𑇆
𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆪𑆾𑆓𑆳𑆂 𑆑𑆬𑇀𑆥𑆾𑆑𑇀𑆠𑆳𑆂 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳𑆂𑇅 𑆥𑇀𑆫𑆖𑇀𑆗𑆤𑆩𑆬𑇀𑆥𑆼 𑆑𑆶𑆰𑇀𑆜𑆼 𑆩𑆲𑆠𑆴 𑆖 𑆯𑆱𑇀𑆠𑆁 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆤𑆩𑇀𑇆𑇔𑇐𑇆
𑆧𑆲𑆶𑆢𑆾𑆰𑆂 𑆱𑆁𑆯𑆾𑆣𑇀𑆪𑆂 𑆑𑆶𑆰𑇀𑆜𑆵 𑆧𑆲𑆶𑆯𑆾𑇁𑆤𑆶𑆫𑆑𑇀𑆰𑆠𑆳 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀𑇅 𑆢𑆾𑆰𑆼 𑆲𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆲𑆸𑆠𑆼 𑆮𑆳𑆪𑆶𑆫𑇀𑆲𑆤𑇀𑆪𑆳𑆢𑆧𑆬𑆩𑆳𑆯𑆶𑇆𑇔𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆥𑆳𑆤𑆩𑆴𑆰𑇀𑆛𑆁 𑆯𑆶𑆢𑇀𑆣𑆼 𑆑𑆾𑆰𑇀𑆜𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆠𑆼 𑆫𑆑𑇀𑆠𑆼𑇅 𑆮𑆳𑆪𑆶𑆫𑇀𑆲𑆴 𑆯𑆶𑆢𑇀𑆣𑆑𑆾𑆰𑇀𑆜𑆁 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆩𑆧𑆬𑆁 𑆮𑆴𑆯𑆠𑆴 𑆯𑆵𑆔𑇀𑆫𑆩𑇀𑇆𑇔𑇒𑇆
𑆢𑆾𑆰𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆼 𑆲𑆸𑆢𑆪𑆼 𑆮𑆳𑆩𑇀𑆪𑆂 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆼𑆰𑆶𑇅 𑆑𑆶𑆛𑆘𑆦𑆬𑆩𑆢𑆤𑆩𑆣𑆶𑆑𑆽𑆂 𑆱𑆥𑆛𑆾𑆬𑆽𑆫𑇀𑆤𑆴𑆩𑇀𑆧𑆫𑆱𑆪𑆶𑆑𑇀𑆠𑆽𑆂𑇆𑇔𑇓𑇆
𑆯𑆵𑆠𑆫𑆱𑆂 𑆥𑆑𑇀𑆮𑆫𑆱𑆾 𑆩𑆣𑆷𑆤𑆴 𑆩𑆣𑆶𑆑𑆁 𑆖 𑆮𑆩𑆤𑆳𑆤𑆴𑇅 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳 𑆢𑆤𑇀𑆠𑆵 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆖 𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆯𑆱𑇀𑆠𑆳𑇆𑇔𑇔𑇆
𑆱𑆿𑆮𑆵𑆫𑆑𑆁 𑆠𑆶𑆰𑆾𑆢𑆑𑆩𑆳𑆬𑆾𑆝𑆤𑆩𑆳𑆱𑆮𑆳𑆯𑇀𑆖 𑆱𑆵𑆣𑆷𑆤𑆴𑇅 𑆯𑆁𑆱𑆤𑇀𑆠𑇀𑆪𑆣𑆾𑆲𑆫𑆳𑆟𑆳𑆁 𑆪𑆡𑆳𑆮𑆴𑆫𑆼𑆑𑆁 𑆑𑇀𑆫𑆩𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆂𑇆𑇔𑇕𑇆
𑆢𑆳𑆫𑇀𑆮𑆵𑆧𑆸𑆲𑆠𑆵𑆱𑆼𑆮𑇀𑆪𑆽𑆂 𑆥𑆛𑆾𑆬𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆩𑆢𑆤𑆑𑆸𑆠𑆩𑆳𑆬𑆽𑆂𑇅 𑆱𑆱𑇀𑆤𑆼𑆲𑆽𑆫𑆳𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆂 𑆑𑆶𑆰𑇀𑆜𑆵 𑆱𑆑𑆬𑆴𑆕𑇀𑆓𑆪𑆮𑆩𑆶𑆱𑇀𑆠𑆽𑆂𑇆𑇔𑇖𑇆
𑆮𑆳𑆠𑆾𑆬𑇀𑆧𑆟𑆁 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆤𑆴𑆫𑆷𑆞𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆫𑇀𑆲𑆩𑆳𑆬𑆑𑇀𑆰𑇀𑆪𑇅 𑆦𑆬𑆩𑆣𑆶𑆑𑆤𑆴𑆩𑇀𑆧𑆑𑆶𑆛𑆘𑆽𑆂 𑆱𑆥𑆛𑆾𑆬𑆽𑆂 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑆱𑇀𑆤𑆼𑆲𑆩𑇀𑇆𑇔𑇗𑇆

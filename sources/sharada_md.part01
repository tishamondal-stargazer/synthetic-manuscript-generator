𑆮𑆳𑆪𑆶𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑇀𑆮𑆖𑆴 𑆱𑇀𑆮𑆳𑆥𑆱𑇀𑆠𑆾𑆢𑆾 𑆩𑆤𑇀𑆪𑆳𑆲𑆤𑆶𑆓𑇀𑆫𑆲𑆂 𑇅 𑆠𑆩𑆫𑇀𑆢𑆴𑆠𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆳𑆲𑆶𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆯𑆳𑆫𑆢𑆳𑆂 𑇆𑇗𑇒𑇆
𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪𑆳𑆤𑆴𑆩𑆴𑆰𑆳𑆑𑇀𑆰𑆱𑇀𑆪 𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆁 𑆱𑆑𑇀𑆠𑆨𑆳𑆰𑆴𑆟𑆂 𑇅 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑇀𑆪𑆫𑇀𑆢𑆴𑆠𑆁 𑆧𑆳𑆞𑆁 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆰𑆁 𑆮𑆼𑆥𑆤𑆱𑇀𑆪 𑆖 𑇆𑇗𑇓𑇆
𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑆴𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆵𑆤𑆳𑆁 𑆠𑆶 𑆑𑆟𑇀𑆝𑆫𑆳 𑆪𑆳𑇁𑆤𑆴𑆬𑆳𑆫𑇀𑆢𑆴𑆠𑆳 𑇅 𑆱𑆑𑇀𑆡𑇀𑆤𑆂 𑆑𑇀𑆰𑆼𑆥𑆁 𑆤𑆴𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆢𑇀𑆓𑆸𑆣𑇀𑆫𑆱𑆵𑆠𑆴 𑆲𑆴 𑆱𑆳 𑆱𑇀𑆩𑆸𑆠𑆳 𑇆𑇗𑇔𑇆
𑆠𑆬𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆵𑆤𑆳𑆁 𑆠𑆶 𑆑𑆟𑇀𑆝𑆫𑆳 𑆧𑆳𑆲𑆶𑆥𑆸𑆰𑇀𑆜𑆠𑆂 𑇅 𑆧𑆳𑆲𑇀𑆮𑆾𑆂 𑆑𑆫𑇀𑆩𑆑𑇀𑆰𑆪𑆑𑆫𑆵 𑆮𑆴𑆯𑇀𑆮𑆳𑆖𑆵𑆠𑆴 𑆲𑆴 𑆱𑆳 𑆱𑇀𑆩𑆸𑆠𑆳 𑇆𑇗𑇕𑇆
𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆘𑆂 𑆯𑆾𑆦𑆾 𑆘𑆳𑆤𑆶𑆩𑆣𑇀𑆪𑆼 𑆩𑆲𑆳𑆫𑆶𑆘𑆂 𑇅 𑆯𑆴𑆫𑆂 𑆑𑇀𑆫𑆾𑆰𑇀𑆛𑆶𑆑𑆥𑆷𑆫𑇀𑆮𑆁 𑆠𑆶 𑆱𑇀𑆡𑆷𑆬𑆂 𑆑𑇀𑆫𑆾𑆰𑇀𑆛𑆶𑆑𑆩𑆷𑆫𑇀𑆣𑆮𑆠𑇀 𑇆𑇗𑇖𑇆
𑆮𑆳𑆪𑆶𑆂 𑆑𑆛𑇀𑆪𑆳𑆁 𑆱𑇀𑆡𑆴𑆠𑆂 𑆱𑆑𑇀𑆡𑇀𑆤𑆂 𑆑𑆟𑇀𑆝𑆫𑆳𑆩𑆳𑆑𑇀𑆰𑆴𑆥𑆼𑆢𑇀𑆪𑆢𑆳 𑇅 𑆒𑆚𑇀𑆘𑆱𑇀𑆠𑆢𑆳 𑆨𑆮𑆼𑆘𑇀𑆘𑆤𑇀𑆠𑆶𑆂, 𑆥𑆕𑇀𑆓𑆶𑆂 𑆱𑆑𑇀𑆡𑇀𑆤𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆮𑆣𑆳𑆠𑇀 𑇆𑇗𑇗𑇆
𑆥𑇀𑆫𑆑𑇀𑆫𑆳𑆩𑆤𑇀 𑆮𑆼𑆥𑆠𑆼 𑆪𑆱𑇀𑆠𑆶 𑆒𑆚𑇀𑆘𑆤𑇀𑆤𑆴𑆮 𑆖 𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆑𑆬𑆳𑆪𑆒𑆚𑇀𑆘𑆁 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆶𑆑𑇀𑆠𑆱𑆤𑇀𑆣𑆴𑆥𑇀𑆫𑆧𑆤𑇀𑆣𑆤𑆩𑇀 𑇆𑇗𑇘𑇆
𑆤𑇀𑆪𑆱𑇀𑆠𑆼 𑆠𑆶 𑆮𑆴𑆰𑆩𑆁(𑆩𑆼) 𑆥𑆳𑆢𑆼 𑆫𑆶𑆘𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑆩𑆵𑆫𑆟𑆂 𑇅 𑆮𑆳𑆠𑆑𑆟𑇀𑆛𑆑 𑆅𑆠𑇀𑆪𑆼𑆰 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆒𑆝𑆶(𑆬)𑆑𑆳𑆯𑇀𑆫𑆴𑆠𑆂 𑇆𑇗𑇙𑇆
𑆥𑆳𑆢𑆪𑆾𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆢𑆳𑆲𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆱𑆸𑆑𑇀𑆱𑆲𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆳𑆠𑇀 𑆥𑆳𑆢𑆢𑆳𑆲𑆁 𑆠𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇘𑇐𑇆
𑆲𑆸𑆰𑇀𑆪𑆠𑆯𑇀𑆖𑆫𑆟𑆿 𑆪𑆱𑇀𑆪 𑆨𑆮𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆮𑆠𑇀 𑇅 𑆥𑆳𑆢𑆲𑆫𑇀𑆰𑆂 𑆱 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆑𑆦𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆘𑆂 𑇆𑇘𑇑𑇆
𑆃𑆁𑆱𑆢𑆼𑆯𑆱𑇀𑆡𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆯𑆾𑆰𑆪𑆴𑆠𑇀𑆮𑆳𑆁𑇁𑆱𑆧𑆤𑇀𑆣𑆤𑆩𑇀 𑇅 𑆱𑆴𑆫𑆳𑆯𑇀𑆖𑆳𑆑𑆶𑆚𑇀𑆖𑇀𑆪 𑆠𑆠𑇀𑆫𑆱𑇀𑆡𑆾 𑆘𑆤𑆪𑆠𑇀𑆪𑆮𑆧𑆳𑆲𑆶𑆑𑆩𑇀 𑇆𑇘𑇒𑇆
𑆪𑆢𑆳 𑆯𑆧𑇀𑆢𑆮𑆲𑆁 𑆱𑇀𑆫𑆾𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑆳𑆮𑆸𑆠𑇀𑆪 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇅 𑆯𑆶𑆢𑇀𑆣𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆤𑇀𑆮𑆴𑆠𑆾 𑆮𑆳𑇁𑆥𑆴 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆠𑆼𑆤 𑆘𑆳𑆪𑆠𑆼 𑇆𑇘𑇓𑇆
𑆲𑆤𑆶𑆯𑆕𑇀𑆒𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆁 𑆪𑆱𑇀𑆪 𑆨𑆴𑆤𑇀𑆢𑆤𑇀𑆤𑆴𑆮𑆳𑆤𑆴𑆬𑆂 𑇅 𑆑𑆫𑇀𑆟𑆪𑆾𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆯𑆷𑆬𑆁 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆁 𑆠𑆢𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇘𑇔𑇆
𑆄𑆮𑆸𑆠𑇀𑆪 𑆱𑆑𑆦𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆣𑆩𑆤𑆵𑆂 𑆯𑆧𑇀𑆢𑆮𑆳𑆲𑆴𑆤𑆵𑆂 𑇅 𑆤𑆫𑆳𑆤𑇀 𑆑𑆫𑆾𑆠𑇀𑆪𑆑𑇀𑆫𑆴𑆪𑆑𑆳𑆤𑇀𑆩𑆷𑆑𑆩𑆴𑆤𑇀𑆩𑆴𑆟𑆓𑆢𑇀𑆓𑆢𑆳𑆤𑇀 𑇆𑇘𑇕𑇆
𑆃𑆣𑆾 𑆪𑆳 𑆮𑆼𑆢𑆤𑆳 𑆪𑆳𑆠𑆴 𑆮𑆫𑇀𑆖𑆾𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆾𑆠𑇀𑆡𑆴𑆠𑆳 𑇅 𑆨𑆴𑆤𑇀𑆢𑆠𑆵𑆮 𑆓𑆶𑆢𑆾𑆥𑆱𑇀𑆡𑆁 𑆱𑆳 𑆠𑆷𑆤𑆵𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇘𑇖𑇆
𑆓𑆶𑆢𑆾𑆥𑆱𑇀𑆡𑆾𑆠𑇀𑆡𑆴𑆠𑆳 𑆱𑆽𑆮 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆮𑆴𑆱𑆫𑇀𑆥𑆴𑆟𑆵 𑇅 𑆮𑆼𑆓𑆽𑆂 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆁 𑆪𑆳𑆠𑆴 𑆥𑇀𑆫𑆠𑆴𑆠𑆷𑆤𑆵𑆠𑆴 𑆱𑆳 𑆱𑇀𑆩𑆸𑆠𑆳 𑇆𑇘𑇗𑇆
𑆱𑆳𑆛𑆾𑆥𑆩𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆫𑆶𑆘𑆩𑆳𑆣𑇀𑆩𑆳𑆠𑆩𑆶𑆢𑆫𑆁 𑆨𑆸𑆯𑆩𑇀 𑇅 𑆄𑆣𑇀𑆩𑆳𑆤𑆩𑆴𑆠𑆴 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆔𑆾𑆫𑆁 𑆮𑆳𑆠𑆤𑆴𑆫𑆾𑆣𑆘𑆩𑇀 𑇆𑇘𑇘𑇆
𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆲𑆸𑆢𑆪𑆁 𑆠𑆢𑆼𑆮𑆳𑆩𑆳𑆯𑆪𑆾𑆠𑇀𑆡𑆴𑆠𑆩𑇀 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆑𑆦𑆮𑇀𑆪𑆳𑆑𑆶𑆬𑆴𑆠𑆳𑆤𑆴𑆬𑆩𑇀 𑇆𑇘𑇙𑇆
𑆃𑆰𑇀𑆜𑆵𑆬𑆳𑆮𑆢𑇀𑆔𑆤𑆁 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆪𑆠𑆩𑆶𑆤𑇀𑆤𑆠𑆩𑇀 𑇅 𑆮𑆳𑆠𑆳𑆰𑇀𑆜𑆵𑆬𑆳𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆧𑆲𑆴𑆫𑇀𑆩𑆳𑆫𑇀𑆓𑆳𑆮𑆫𑆾𑆣𑆴𑆤𑆵𑆩𑇀 𑇆𑇙𑇐𑇆
𑆍𑆤𑆳𑆩𑆼𑆮 𑆫𑆶𑆘𑆳𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆮𑆳𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆫𑆾𑆣𑆴𑆤𑆵𑆩𑇀 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆰𑇀𑆜𑆵𑆬𑆳𑆩𑆴𑆠𑆴 𑆮𑆢𑆼𑆘𑇀𑆘𑆜𑆫𑆼 𑆠𑆴𑆫𑇀𑆪𑆓𑆶𑆠𑇀𑆡𑆴𑆠𑆳𑆩𑇀 𑇆𑇙𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆰𑆝𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆽𑆂 𑆱𑆲𑆘𑆳𑆤𑆴 𑆖𑆼𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑆳𑆠𑇀𑆩𑆮𑆠𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆽𑆫𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆾𑆠𑇀𑆑𑆛𑆶𑆑𑆳𑆱𑆤𑆥𑆸𑆰𑇀𑆜𑆪𑆳𑆤𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆟𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆢𑆾𑆰𑆳 𑆍𑆑𑆯𑆾 𑆢𑇀𑆮𑆴𑆯𑆂 𑆱𑆩𑆱𑇀𑆠𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆱𑆲𑆴𑆠𑆳 𑆮𑆳 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆣𑆩𑆤𑆵𑆫𑆤𑆶𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆳𑆣𑆾 𑆓𑆠𑇀𑆮𑆳 𑆓𑆶𑆢𑆩𑆳𑆓𑆩𑇀𑆪 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆓𑆶𑆢𑆮𑆬𑆵𑆫𑇀𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆫𑆾𑆲𑆳𑆚𑇀𑆘𑆤𑆪𑆤𑇀𑆠𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆾 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆼𑆂, 𑆠𑆡𑆳 𑆠𑆸𑆟𑆑𑆳𑆰𑇀𑆜𑆾𑆥𑆬𑆬𑆾𑆰𑇀𑆜𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆢𑆴𑆨𑆴𑆂 𑆯𑆵𑆠𑆾𑆢𑆑𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆳𑆢𑇀𑆮𑆳 𑆑𑆤𑇀𑆢𑆳𑆂 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆳𑆱𑆳𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆧𑆢𑇀𑆣𑆩𑆫𑇀𑆣𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆓𑆶𑆢𑆩𑆳𑆲𑆶𑆂, 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆬𑆪𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆾𑇁𑆣𑇀𑆪𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑇀𑆠𑆫𑆱𑆩𑇀𑆨𑆷𑆠𑆳𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆵 𑆮𑆴𑆱𑆫𑇀𑆘𑆤𑆵 𑆱𑆁𑆮𑆫𑆟𑆵 𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆳𑆪𑆠𑆳𑆂 ; 𑆱𑆫𑇀𑆮𑆳𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑆼𑆑𑆳𑆕𑇀𑆓𑆬𑆾𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆳𑆂 𑇆𑇕𑇆
𑆯𑆕𑇀𑆒𑆳𑆮𑆫𑇀𑆠𑆤𑆴𑆨𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆇𑆥𑆫𑇀𑆪𑆶𑆥𑆫𑆴 𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆳𑆂 𑇅 𑆓𑆘𑆠𑆳𑆬𑆶𑆤𑆴𑆨𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆮𑆫𑇀𑆟𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆫𑆾𑆩𑆳𑆤𑇀𑆠𑆼𑆨𑇀𑆪𑆾 𑆪𑆮𑆳𑆣𑇀𑆪𑆫𑇀𑆣𑆾 𑆓𑆶𑆢𑆿𑆰𑇀𑆜𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇖𑇆
𑆥𑇀𑆫𑆡𑆩𑆳 𑆠𑆶 𑆓𑆶𑆢𑆿𑆰𑇀𑆜𑆳𑆢𑆕𑇀𑆓𑆶𑆬𑆩𑆳𑆠𑇀𑆫𑆼 𑇆𑇗𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆃𑆤𑇀𑆤𑆼𑇁𑆯𑇀𑆫𑆢𑇀𑆣𑆳 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆠𑇀 𑆥𑆑𑇀𑆠𑆴𑆫𑆩𑇀𑆬𑆵𑆑𑆳 𑆥𑆫𑆴𑆢𑆳𑆲𑆾 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆱𑆑𑇀𑆡𑆴𑆱𑆢𑆤𑆩𑆳𑆛𑆾𑆥𑆂 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆩𑆶𑆢𑇀𑆓𑆳𑆫𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆁 𑆓𑆶𑆢𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆤𑆩𑆳𑆯𑆕𑇀𑆑𑆳 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆯𑆾𑆰𑆳𑆟𑆳𑆁 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆿 𑆧𑆬𑆲𑆳𑆤𑆴𑆫𑇀𑆨𑇀𑆫𑆩𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆤𑆴𑆢𑇀𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆖 𑇆𑇘𑇆
𑆘𑆳𑆠𑆼𑆰𑇀𑆮𑆼𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆥𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆩𑆳𑆫𑆶𑆠𑆳𑆠𑇀 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆫𑆶𑆟𑆮𑆴𑆮𑆫𑇀𑆟𑆳𑆤𑆴 𑆮𑆴𑆰𑆩𑆩𑆣𑇀𑆪𑆳𑆤𑆴 𑆑𑆢𑆩𑇀𑆧𑆥𑆶𑆰𑇀𑆥𑆠𑆶𑆟𑇀𑆝𑆴𑆑𑆼𑆫𑆵𑆤𑆳𑆝𑆵𑆩𑆶𑆑𑆶𑆬𑆱𑆷𑆖𑆵𑆩𑆶𑆒𑆳𑆑𑆸𑆠𑆵𑆤𑆴 𑆖 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆱𑆯𑆷𑆬𑆁 𑆱𑆁𑆲𑆠𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪𑆠𑆼 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆩𑆼𑆞𑇀𑆫𑆓𑆶𑆢𑆤𑆳𑆨𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆼𑆰𑆶 𑆖𑆳𑆱𑇀𑆪 𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆓𑆶𑆬𑇀𑆩𑆳𑆰𑇀𑆜𑆵𑆬𑆳𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆳𑆟𑆴 𑆖𑆳𑆱𑇀𑆪 𑆠𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆑𑆸𑆰𑇀𑆟𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆢𑆯𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆤𑆵𑆬𑆳𑆓𑇀𑆫𑆳𑆟𑆴 𑆠𑆤𑆷𑆤𑆴 𑆮𑆴𑆱𑆫𑇀𑆥𑆵𑆟𑆴 𑆥𑆵𑆠𑆳𑆮𑆨𑆳𑆱𑆳𑆤𑆴 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆤𑆴 𑆯𑆶𑆑𑆘𑆴𑆲𑇀𑆮𑆳𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆪𑆮𑆩𑆣𑇀𑆪𑆳𑆤𑆴 𑆘𑆬𑆿𑆑𑆾𑆮𑆑𑇀𑆫𑆱𑆢𑆸𑆯𑆳𑆤𑆴 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆤𑆴 𑆖 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆱𑆢𑆳𑆲𑆁 𑆱𑆫𑆶𑆣𑆴𑆫𑆩𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼, 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆥𑆵𑆠𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆢𑆯𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇑𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑆳𑆤𑆴 𑆯𑇀𑆮𑆼𑆠𑆳𑆤𑆴 𑆩𑆲𑆳𑆩𑆷𑆬𑆳𑆤𑆴 𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆴 𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆥𑆳𑆟𑇀𑆝𑆷𑆤𑆴 𑆑𑆫𑆵𑆫𑆥𑆤𑆱𑆳𑆱𑇀𑆡𑆴𑆓𑆾𑆱𑇀𑆠𑆤𑆳𑆑𑆳𑆫𑆳𑆟𑆴, 𑆤 𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆤 𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑆴 𑆑𑆟𑇀𑆝𑆷𑆧𑆲𑆶𑆬𑆳𑆤𑆴 𑆖 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆱𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆤𑆬𑇀𑆥𑆁 𑆩𑆳𑆁𑆱𑆣𑆳𑆮𑆤𑆥𑇀𑆫𑆑𑆳𑆯𑆩𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼, 𑆯𑆾𑆦𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆳𑆟𑆴 𑆖𑆳𑆱𑇀𑆪 𑆠𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆯𑆶𑆑𑇀𑆬𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆢𑆯𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇒𑇆
𑆫𑆑𑇀𑆠𑆘𑆳𑆤𑆴 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆥𑇀𑆫𑆫𑆾𑆲𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆑𑆳𑆑𑆟𑆤𑇀𑆠𑆴𑆑𑆳𑆦𑆬𑆱𑆢𑆸𑆯𑆳𑆤𑆴 𑆥𑆴𑆠𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆖, 𑆪𑆢𑆳𑇁𑆮𑆓𑆳𑆞𑆥𑆶𑆫𑆵𑆰𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆢𑆳𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆶𑆰𑇀𑆛𑆩𑆤𑆬𑇀𑆥𑆩𑆱𑆸𑆑𑇀 𑆱𑆲𑆱𑆳 𑆮𑆴𑆱𑆸𑆘𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆖𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆿 𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆪𑆾𑆓𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇓𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆘𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆬𑆑𑇀𑆰𑆟𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑇆𑇑𑇔𑇆
𑆱𑆲𑆘𑆳𑆤𑆴 𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆯𑆶𑆑𑇀𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆴, 𑆠𑆼𑆰𑆳𑆁 𑆢𑆾𑆰𑆠 𑆍𑆮 𑆥𑇀𑆫𑆱𑆳𑆣𑆤𑆁 𑆑𑆫𑇀𑆠𑇀𑆠𑆮𑇀𑆪𑆩𑇀, 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆽𑆠𑆳𑆤𑆴 𑆢𑆶𑆫𑇀𑆢𑆫𑇀𑆯𑆤𑆳𑆤𑆴 𑆥𑆫𑆶𑆰𑆳𑆟𑆴 𑆥𑆳𑆁𑆱𑆷𑆤𑆴 𑆢𑆳𑆫𑆶𑆟𑆳𑆤𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆳𑆤𑆴; 𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆑𑆸𑆯𑆾𑇁𑆬𑇀𑆥𑆨𑆶𑆑𑇀 𑆱𑆴𑆫𑆳𑆱𑆤𑇀𑆠𑆠𑆓𑆳𑆠𑇀𑆫𑆾𑇁𑆬𑇀𑆥𑆥𑇀𑆫𑆘𑆂 𑆑𑇀𑆰𑆵𑆟𑆫𑆼𑆠𑆳𑆂 𑆑𑇀𑆰𑆳𑆩𑆱𑇀𑆮𑆫𑆂 𑆑𑇀𑆫𑆾𑆣𑆤𑆾𑇁𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆳𑆟𑆂 𑆥𑆫𑆩𑆬𑆱𑆯𑇀𑆖, 𑆠𑆡𑆳 𑆔𑇀𑆫𑆳𑆟𑆯𑆴𑆫𑆾𑇁𑆑𑇀𑆰𑆴𑆤𑆳𑆱𑆳𑆯𑇀𑆫𑆮𑆟𑆫𑆾𑆓𑆵, 𑆱𑆠𑆠𑆩𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆳𑆛𑆾𑆥𑆲𑆸𑆢𑆪𑆾𑆥𑆬𑆼𑆥𑆳𑆫𑆾𑆖𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆂 𑆥𑆵𑆝𑇀𑆪𑆠𑆼 𑇆𑇑𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆧𑆳𑆲𑇀𑆪𑆩𑆣𑇀𑆪𑆮𑆬𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆮𑆫𑆂 𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆮𑆬𑆴𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆳𑆖𑆫𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇆𑇑𑇖𑇆
𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆳 𑆩𑆼𑆞𑇀𑆫𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆼 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆑𑆟𑇀𑆝𑆷𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆠𑆠𑆂 𑆑𑆟𑇀𑆝𑆷𑆪𑆤𑆳𑆠𑇀 𑆑𑇀𑆰𑆠𑆁 𑆱𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆑𑇀𑆰𑆠𑆼 𑆢𑆶𑆰𑇀𑆛𑆩𑆳𑆁𑆱𑆘𑆳𑆂 𑆥𑇀𑆫𑆫𑆾𑆲𑆳𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑆾 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆑𑆷𑆫𑇀𑆖𑆑𑆴𑆤𑆾𑇁𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆩𑆶𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆢𑇀𑆮𑆳, 𑆠𑆼 𑆠𑆶 𑆯𑆼𑆦𑆾 𑆮𑆴𑆤𑆳𑆯𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆖 𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆁; 𑆪𑆾𑆤𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆂 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆤𑇀 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆳𑆤𑇀 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑆯𑇀𑆗𑆠𑇀𑆫𑆳𑆑𑆳𑆫𑆳𑆤𑇀 𑆑𑆫𑆵𑆫𑆳𑆚𑇀𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆠𑆼 𑆠𑆶 𑆪𑆾𑆤𑆴𑆩𑆶𑆥𑆔𑇀𑆤𑆤𑇀𑆠𑇀𑆪𑆳𑆫𑇀𑆠𑆮𑆁 𑆖; 𑆤𑆳𑆨𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆂 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆤𑇀 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆳𑆤𑇀 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆤𑇀 𑆓𑆟𑇀𑆝𑆷𑆥𑆢𑆩𑆶𑆒𑆱𑆢𑆸𑆯𑆳𑆤𑇀 𑆑𑆫𑆵𑆫𑆳𑆚𑇀𑆘𑆤𑆪𑆤𑇀𑆠𑆴; 𑆠 𑆍𑆮𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆳𑆓𑆠𑆳𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆔𑇀𑆫𑆳𑆟𑆮𑆢𑆤𑆼𑆰𑇀𑆮𑆫𑇀𑆯𑆳𑆁𑆱𑇀𑆪𑆶𑆥𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆑𑆫𑇀𑆟𑆘𑆼𑆰𑆶 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆯𑆷𑆬𑆁 𑆥𑆷𑆠𑆴𑆑𑆫𑇀𑆟𑆠𑆳 𑆖, 𑆤𑆼𑆠𑇀𑆫𑆘𑆼𑆰𑆶 𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆮𑆫𑆾𑆣𑆾 𑆮𑆼𑆢𑆤𑆳 𑆱𑇀𑆫𑆳𑆮𑆾 𑆢𑆫𑇀𑆯𑆤𑆤𑆳𑆯𑆯𑇀𑆖, 𑆔𑇀𑆫𑆳𑆟𑆘𑆼𑆰𑆶 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆮𑆡𑆶𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆠𑆳 𑆥𑆷𑆠𑆴𑆤𑆱𑇀𑆪𑆁 𑆱𑆳𑆤𑆶𑆤𑆳𑆱𑆴𑆑𑆮𑆳𑆑𑇀𑆪𑆠𑇀𑆮𑆁 𑆯𑆴𑆫𑆾𑆢𑆶𑆂𑆒𑆁 𑆖; 𑆮𑆑𑇀𑆫𑆘𑆼𑆰𑆶 𑆑𑆟𑇀𑆜𑆿𑆰𑇀𑆜𑆠𑆳𑆬𑆷𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆽𑆫𑇀𑆓𑆢𑇀𑆓𑆢𑆮𑆳𑆑𑇀𑆪𑆠𑆳 𑆫𑆱𑆳𑆘𑇀𑆚𑆳𑆤𑆁 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇗𑇆
𑆮𑇀𑆪𑆳𑆤𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆥𑆫𑆴𑆓𑆸𑆲𑇀𑆪 𑆧𑆲𑆴𑆂𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆴 𑆑𑆵𑆬𑆮𑆢𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴, 𑆠𑆳𑆤𑆴 𑆖𑆫𑇀𑆩𑆑𑆵𑆬𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆵𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇑𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆼𑆰𑆶 𑆑𑆵𑆬𑆼𑆰𑆶 𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆾 𑆩𑆳𑆫𑆶𑆠𑆼𑆤𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆠𑆶 𑆱𑆮𑆫𑇀𑆟𑆠𑇀𑆮𑆁 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆠𑇀𑆮𑆁 𑆖 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆟𑆴𑆠𑆘𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆑𑆸𑆰𑇀𑆟𑆠𑇀𑆮𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆠𑆳 𑆠𑆡𑆳 𑇅 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆒𑆫𑆠𑇀𑆮𑆁 𑆖𑆫𑇀𑆩𑆑𑆵𑆬𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇒𑇐𑇆
𑆃𑆫𑇀𑆯𑆱𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑇀𑆪𑆳𑆱𑆳𑆢𑆶𑆑𑇀𑆠𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆱𑇀𑆠𑆶 𑆪𑆠𑇀 𑇅 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆠𑇀𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆘𑆳𑆁 𑆮𑆫𑆂 𑇆𑇒𑇑𑇆
𑆃𑆫𑇀𑆯𑆂𑆱𑆶 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑆫𑆷𑆥𑆁 𑆪𑆢𑆳 𑆢𑆾𑆰𑆢𑇀𑆮𑆪𑆱𑇀𑆪 𑆠𑆶 𑇅 𑆱𑆁𑆱𑆫𑇀𑆓𑆁 𑆠𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆁𑆱𑆫𑇀𑆓𑆂 𑆱 𑆖 𑆰𑆝𑇀𑆮𑆴𑆣𑆂 𑇆𑇒𑇒𑇆
𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆳𑆟𑇀𑆪𑆬𑇀𑆥𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆪𑆳𑆥𑇀𑆪𑆳𑆤𑆴 𑆠𑆶 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆳𑆤𑆴 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳𑆪𑆳𑆁 𑆮𑆬𑆿 𑆪𑆳𑆤𑇀𑆪𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆤𑆴 𑆖 𑇆𑇒𑇓𑇆
𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴 𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆂 𑆥𑆫𑆴𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆟𑆴 𑆖 𑇅 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆴 𑆱𑆲𑆘𑆳𑆤𑆴 𑆠𑆶 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇔𑇆
𑆱𑆫𑇀𑆮𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆮𑆬𑆪𑆾 𑆪𑆼𑆰𑆳𑆁 𑆢𑆶𑆫𑇀𑆤𑆳𑆩𑆨𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆳𑆂 𑇅 𑆠𑆽𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑆥𑆳𑆤𑆂 𑆱𑆤𑇀𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇒𑇕𑇆
𑆠𑆠𑆾 𑆮𑇀𑆪𑆳𑆤𑆼𑆤 𑆱𑆕𑇀𑆓𑆩𑇀𑆪 𑆘𑇀𑆪𑆾𑆠𑆴𑆫𑇀𑆩𑆸𑆢𑇀𑆤𑆳𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆯𑇀𑆩𑆫𑆵𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆖𑆠𑆱𑇀𑆫𑆾𑇁𑆯𑇀𑆩𑆫𑇀𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳, 𑆮𑆳𑆠𑆼𑆤, 𑆥𑆴𑆠𑇀𑆠𑆼𑆤, 𑆯𑆶𑆑𑇀𑆫𑆼𑆟 𑆖𑆼𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆱𑆁𑆯𑆾𑆣𑆤𑆯𑆵𑆬𑆱𑇀𑆪𑆳𑆥𑆡𑇀𑆪𑆑𑆳𑆫𑆴𑆟𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆩𑆷𑆠𑇀𑆫𑆱𑆩𑇀𑆥𑆸𑆑𑇀𑆠𑆾𑇁𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆧𑆱𑇀𑆠𑆴𑆩𑆯𑇀𑆩𑆫𑆵𑆁 𑆘𑆤𑆪𑆠𑆴 𑇆𑇔𑇆
𑆠𑆳𑆱𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆘𑇀𑆮𑆫𑆾 𑆧𑆱𑇀𑆠𑆴𑆥𑆵𑆝𑆳𑆫𑆾𑆖𑆑𑆿 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆾𑆩𑆶𑆰𑇀𑆑𑆯𑆼𑆦𑆱𑆳𑆁 𑆮𑆼𑆢𑆤𑆳 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆮𑆱𑆳𑆢𑆾 𑆧𑆱𑇀𑆠𑆓𑆤𑇀𑆣𑆴𑆠𑇀𑆮𑆁 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆪𑆼𑆠𑆴 𑇆𑇕𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆮𑆼𑆢𑆤𑆳𑆮𑆫𑇀𑆟𑆁 𑆢𑆶𑆰𑇀𑆛𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆡𑆳𑆮𑆴𑆬𑆩𑇀 𑇅 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆼𑇁𑆯𑇀𑆩𑆤𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆸𑆘𑆠𑆴 𑆩𑆳𑆤𑆮𑆂 𑇆𑇖𑇆
𑆃𑆡 𑆘𑆳𑆠𑆳𑆱𑆶 𑆤𑆳𑆨𑆴𑆧𑆱𑇀𑆠𑆴𑆱𑆼𑆮𑆤𑆵𑆩𑆼𑆲𑆤𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆩𑆼𑆲𑆠𑆾 𑆮𑆼𑆢𑆤𑆳 𑆩𑆷𑆠𑇀𑆫𑆣𑆳𑆫𑆳𑆱𑆕𑇀𑆓𑆂 𑆱𑆫𑆶𑆣𑆴𑆫𑆩𑆷𑆠𑇀𑆫𑆠𑆳 𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆑𑆴𑆫𑆟𑆁 𑆓𑆾𑆩𑆼𑆢𑆑𑆥𑇀𑆫𑆑𑆳𑆯𑆩𑆠𑇀𑆪𑆳𑆮𑆴𑆬𑆁 𑆱𑆱𑆴𑆑𑆠𑆁 𑆮𑆴𑆱𑆸𑆘𑆠𑆴; 𑆣𑆳𑆮𑆤𑆬𑆕𑇀𑆔𑆤𑆥𑇀𑆬𑆮𑆤𑆥𑆸𑆰𑇀𑆜𑆪𑆳𑆤𑆾𑆰𑇀𑆟𑆳𑆣𑇀𑆮𑆓𑆩𑆤𑆽𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆯𑇀𑆩𑆫𑆵 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆩𑆤𑇀𑆤𑆩𑆨𑇀𑆪𑆮𑆲𑆫𑆠𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆬𑆴𑆥𑇀𑆪𑆳𑆣𑆂 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆧𑆱𑇀𑆠𑆴𑆩𑆶𑆒𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆱𑇀𑆫𑆾𑆠𑆾 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴, 𑆠𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆔𑆳𑆠𑆳𑆢𑇀𑆢𑆳𑆬𑇀𑆪𑆠𑆼 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑆤𑆴𑆱𑇀𑆠𑆶𑆢𑇀𑆪𑆠 𑆅𑆮 𑆖 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆓𑆶𑆫𑆶𑆂 𑆯𑆵𑆠𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆃𑆯𑇀𑆩𑆫𑆵 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆮𑆼𑆠𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆩𑆲𑆠𑆵 𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆳𑆟𑇀𑆝𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆯𑆳 𑆩𑆣𑆷𑆑𑆥𑆶𑆰𑇀𑆥𑆮𑆫𑇀𑆟𑆳 𑆮𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆳𑆁 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆵𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇆𑇘𑇆
𑆥𑆴𑆠𑇀𑆠𑆪𑆶𑆠𑆱𑇀𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑆕𑇀𑆔𑆳𑆠𑆩𑆶𑆥𑆓𑆩𑇀𑆪 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆁 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆧𑆱𑇀𑆠𑆴𑆩𑆶𑆒𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆱𑇀𑆫𑆾𑆠𑆾 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴, 𑆠𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆵𑆔𑆳𑆠𑆳𑆢𑆷𑆰𑇀𑆪𑆠𑆼 𑆖𑆷𑆰𑇀𑆪𑆠𑆼 𑆢𑆲𑇀𑆪𑆠𑆼 𑆥𑆖𑇀𑆪𑆠 𑆅𑆮 𑆧𑆱𑇀𑆠𑆴𑆫𑆶𑆰𑇀𑆟𑆮𑆳𑆠𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆃𑆯𑇀𑆩𑆫𑆵 𑆖𑆳𑆠𑇀𑆫 𑆱𑆫𑆑𑇀𑆠𑆳 𑆥𑆵𑆠𑆳𑆮𑆨𑆳𑆱𑆳 𑆑𑆸𑆰𑇀𑆟𑆳 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆱𑇀𑆡𑆴𑆥𑇀𑆫𑆠𑆴𑆩𑆳 𑆩𑆣𑆶𑆮𑆫𑇀𑆟𑆳 𑆮𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆳𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆵𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇆𑇙𑇆
𑆮𑆳𑆠𑆪𑆶𑆠𑆱𑇀𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑆕𑇀𑆔𑆳𑆠𑆩𑆶𑆥𑆓𑆩𑇀𑆪 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆁 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆧𑆱𑇀𑆠𑆴𑆩𑆶𑆒𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆱𑇀𑆫𑆾𑆠𑆾 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴, 𑆠𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆵𑆔𑆳𑆠𑆳𑆠𑇀𑆠𑆵𑆮𑇀𑆫𑆳 𑆮𑆼𑆢𑆤𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆢𑆳𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆾 𑆢𑆤𑇀𑆠𑆳𑆤𑇀 𑆒𑆳𑆢𑆠𑆴, 𑆤𑆳𑆨𑆴𑆁 𑆥𑆵𑆝𑆪𑆠𑆴, 𑆩𑆼𑆞𑇀𑆫𑆁 𑆥𑇀𑆫𑆩𑆸𑆢𑇀𑆤𑆳𑆠𑆴, 𑆥𑆳𑆪𑆶𑆁 𑆱𑇀𑆥𑆸𑆯𑆠𑆴, 𑆮𑆴𑆯𑆫𑇀𑆣𑆠𑆼, 𑆮𑆴𑆢𑆲𑆠𑆴, 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟 𑆖𑆳𑆱𑇀𑆪 𑆩𑆼𑆲𑆠𑆾 𑆤𑆴𑆂𑆱𑆫𑆤𑇀𑆠𑆴; 𑆃𑆯𑇀𑆩𑆫𑆵 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆪𑆳𑆮𑆳 𑆥𑆫𑆶𑆰𑆳 𑆮𑆴𑆰𑆩𑆳 𑆒𑆫𑆳 𑆑𑆢𑆩𑇀𑆧𑆥𑆶𑆰𑇀𑆥𑆮𑆠𑇀𑆑𑆟𑇀𑆛𑆑𑆳𑆖𑆴𑆠𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆳𑆁 𑆮𑆳𑆠𑆴𑆑𑆵𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆽𑆠𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆾𑇁𑆯𑇀𑆩𑆫𑇀𑆪𑆾 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆩𑆯𑆤𑆳𑆣𑇀𑆪𑆯𑆤𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆳𑆲𑆳𑆫𑆥𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆼𑆰𑆳𑆩𑆼𑆮𑆳𑆬𑇀𑆥𑆧𑆱𑇀𑆠𑆴𑆑𑆳𑆪𑆠𑇀𑆮𑆳𑆢𑆤𑆶𑆥𑆖𑆴𑆠𑆩𑆳𑆁𑆱𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆧𑆱𑇀𑆠𑆼𑆂 𑆱𑆶𑆒𑆓𑇀𑆫𑆲𑆟𑆳𑆲𑆫𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆩𑆲𑆠𑆳𑆁 𑆠𑆶 𑆯𑆶𑆑𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆵 𑆯𑆶𑆑𑇀𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆨𑆮𑆠𑆴 𑇆𑇑𑇑𑇆
𑆩𑆽𑆡𑆶𑆤𑆮𑆴𑆔𑆳𑆠𑆳𑆢𑆠𑆴𑆩𑆽𑆡𑆶𑆤𑆳𑆢𑇀𑆮𑆳 𑆯𑆶𑆑𑇀𑆫𑆁 𑆖𑆬𑆴𑆠𑆩𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆢𑇀𑆮𑆴𑆩𑆳𑆫𑇀𑆓𑆓𑆩𑆤𑆳𑆢𑆤𑆴𑆬𑆾𑇁𑆨𑆴𑆠𑆂 𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪 𑆩𑆼𑆞𑇀𑆫𑆮𑆸𑆰𑆟𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆼 𑆱𑆁𑆲𑆫𑆠𑆴, 𑆱𑆁𑆲𑆸𑆠𑇀𑆪 𑆖𑆾𑆥𑆯𑆾𑆰𑆪𑆠𑆴; 𑆱𑆳 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆮𑆸𑆟𑆾𑆠𑆴 , 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆧𑆱𑇀𑆠𑆴𑆮𑆼𑆢𑆤𑆳𑆁 𑆮𑆸𑆰𑆟𑆪𑆾𑆯𑇀𑆖 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆥𑆵𑆝𑆴𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆖 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮 𑆥𑇀𑆫𑆢𑆼𑆯𑆼 𑆥𑇀𑆫𑆮𑆴𑆬𑆪𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼; 𑆠𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆫𑇀𑆑𑆫𑆳 𑆱𑆴𑆑𑆠𑆳 𑆩𑆼𑆲𑆾 𑆨𑆱𑇀𑆩𑆳𑆒𑇀𑆪𑆾𑇁𑆯𑇀𑆩𑆫𑆴𑆮𑆽𑆑𑆸𑆠𑆩𑇀 𑇅𑇑𑇓𑇅 𑆃𑆯𑇀𑆩𑆫𑇀𑆪𑆳 𑆯𑆫𑇀𑆑𑆫𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆠𑆶𑆬𑇀𑆪𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆮𑆼𑆢𑆤𑆳 𑇆𑇑𑇓𑇆
𑆥𑆮𑆤𑆼𑇁𑆤𑆶𑆓𑆶𑆟𑆼 𑆱𑆳 𑆠𑆶 𑆤𑆴𑆫𑆼𑆠𑇀𑆪𑆬𑇀𑆥𑆳 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇅 𑆱𑆳 𑆨𑆴𑆤𑇀𑆤𑆩𑆷𑆫𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆼𑆤 𑆯𑆫𑇀𑆑𑆫𑆼𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇑𑇔𑇆
𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆳 𑆱𑆑𑇀𑆡𑆴𑆱𑆢𑆤𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆯𑆷𑆬𑆁 𑆖 𑆮𑆼𑆥𑆡𑆶𑆂 𑇅 𑆠𑆸𑆰𑇀𑆟𑆾𑆫𑇀𑆣𑇀𑆮𑆓𑆾𑇁𑆤𑆴𑆬𑆂 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳 𑇆𑇑𑇕𑇆
𑆃𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆿 𑆠𑆶 𑆯𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆠𑆼 𑆨𑆮𑆤𑇀𑆠𑆴 𑆖 𑇅𑇑𑇖𑇅 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆳 𑆱𑆳 𑆱𑆑𑇀𑆠𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑇆𑇑𑇖𑇆
𑆤𑆳𑆨𑆴𑆥𑆸𑆰𑇀𑆜𑆑𑆛𑆵𑆩𑆶𑆰𑇀𑆑𑆓𑆶𑆢𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆯𑆼𑆦𑆱𑆳𑆩𑇀 𑇅 𑆍𑆑𑆢𑇀𑆮𑆳𑆫𑆱𑇀𑆠𑆤𑆶𑆠𑇀𑆮𑆑𑇀𑆑𑆾 𑆩𑆣𑇀𑆪𑆼 𑆧𑆱𑇀𑆠𑆴𑆫𑆣𑆾𑆩𑆶𑆒𑆂 𑇆𑇑𑇘𑇆
𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆯𑇀𑆖𑆽𑆮 𑆥𑆿𑆫𑆶𑆰𑆁 𑆮𑆸𑆰𑆟𑆿 𑆓𑆶𑆢𑆂 𑇅 𑆍𑆑𑆱𑆩𑇀𑆧𑆤𑇀𑆣𑆴𑆤𑆾 𑆲𑇀𑆪𑆼𑆠𑆼 𑆓𑆶𑆢𑆳𑆱𑇀𑆡𑆴𑆮𑆴𑆮𑆫𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑇆𑇑𑇙𑇆
𑆃𑆬𑆳𑆧𑇀𑆮𑆳 𑆅𑆮 𑆫𑆷𑆥𑆼𑆟 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆂 𑇅 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆾 𑆩𑆬𑆳𑆣𑆳𑆫𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆪𑆠𑆤𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇒𑇐𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆓𑆠𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆤𑆳𑆝𑇀𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆳𑆱𑇀𑆠𑆶 𑆪𑆳𑆂 𑇅 𑆠𑆫𑇀𑆥𑆪𑆤𑇀𑆠𑆴 𑆱𑆢𑆳 𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆫𑆴𑆠𑆂 𑆱𑆳𑆓𑆫𑆁 𑆪𑆡𑆳 𑇆𑇒𑇑𑇆
𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼 𑆩𑆶𑆒𑆳𑆤𑇀𑆪𑆳𑆱𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆯𑆂 𑇅 𑆤𑆳𑆝𑆵𑆨𑆴𑆫𑆶𑆥𑆤𑆵𑆠𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆳𑆤𑇀𑆠𑆫𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆘𑆳𑆓𑇀𑆫𑆠𑆂 𑆱𑇀𑆮𑆥𑆠𑆯𑇀𑆖𑆽𑆮 𑆱 𑆤𑆴𑆂𑆱𑇀𑆪𑆤𑇀𑆢𑆼𑆤 𑆥𑆷𑆫𑇀𑆪𑆠𑆼 𑇅 𑆄𑆩𑆶𑆒𑆳𑆠𑇀𑆱𑆬𑆴𑆬𑆼 𑆤𑇀𑆪𑆱𑇀𑆠𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼𑆨𑇀𑆪𑆂 𑆥𑆷𑆫𑇀𑆪𑆠𑆼 𑆤𑆮𑆂 𑇆𑇒𑇓𑇆
𑆔𑆛𑆾 𑆪𑆡𑆳 𑆠𑆡𑆳 𑆮𑆴𑆢𑇀𑆣𑆴 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆥𑆷𑆫𑇀𑆪𑆠𑆼 𑇅𑇒𑇔𑇅 𑆍𑆮𑆩𑆼𑆮 𑆥𑇀𑆫𑆮𑆼𑆯𑆼𑆤 𑆮𑆳𑆠𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆦𑆾𑇁𑆥𑆴 𑆮𑆳 𑇆𑇒𑇔𑇆
𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆩𑆶𑆥𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆑𑆶𑆫𑆶𑆠𑆼𑇁𑆯𑇀𑆩𑆫𑆵𑆩𑇀 𑇅𑇒𑇕𑇅 𑆃𑆥𑇀𑆱𑆶 𑆱𑇀𑆮𑆖𑇀𑆗𑆳(𑆱𑇀𑆡𑆳)𑆱𑇀𑆮𑆥𑆴 𑆪𑆡𑆳 𑆤𑆴𑆰𑆴𑆑𑇀𑆠𑆳𑆱𑆶 𑆤𑆮𑆼 𑆔𑆛𑆼 𑇆𑇒𑇕𑇆
𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆕𑇀𑆑𑆂 𑆱𑇀𑆪𑆳𑆢𑆯𑇀𑆩𑆫𑆵𑆱𑆩𑇀𑆨𑆮𑆱𑇀𑆠𑆡𑆳 𑇅 𑆱𑆁𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆥𑆾 𑆪𑆡𑆳 𑆢𑆴𑆮𑇀𑆪𑆳 𑆩𑆳𑆫𑆶𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆯𑇀𑆖 𑆮𑆽𑆢𑇀𑆪𑆶𑆠𑆂 𑇆𑇒𑇖𑇆
𑆠𑆢𑇀𑆮𑆢𑇀𑆧𑆬𑆳𑆱𑆁 𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆡𑆩𑆷𑆰𑇀𑆩𑆳 𑆱𑆁𑆲𑆤𑇀𑆠𑆴 𑆱𑆳𑆤𑆴𑆬𑆂 𑇅𑇒𑇗𑇅 𑆩𑆳𑆫𑆶𑆠𑆼 𑆥𑇀𑆫𑆓𑆶𑆟𑆼 𑆧𑆱𑇀𑆠𑆿 𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆮𑆴𑆑𑆳𑆫𑆳 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆼 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇒𑇗𑇆
𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆩𑆷𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆯𑇀𑆖 𑆪𑆼 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆱𑇀𑆠𑆳𑆮𑆼𑆮 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇒𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆯𑆠𑆥𑆾𑆤𑆑𑆾𑆰𑇀𑆛𑇀𑆫𑆓𑇀𑆫𑆵𑆮𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆯𑆩𑇀𑆧𑆷𑆑𑆳𑆮𑆫𑇀𑆠𑆾𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆴𑆟𑆾 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆁 𑆥𑆚𑇀𑆖 𑆨𑆓𑆤𑇀𑆢𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆼 𑆠𑆶 𑆨𑆓𑆓𑆶𑆢𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆢𑆳𑆫𑆟𑆳𑆖𑇀𑆖 ‘𑆨𑆓𑆤𑇀𑆢𑆫𑆳’ 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑇅 𑆃𑆨𑆴𑆤𑇀𑆤𑆳𑆂 𑆥𑆴𑆝𑆑𑆳𑆂, 𑆨𑆴𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆶 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆂 𑇆𑇓𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆑𑆛𑆵𑆑𑆥𑆳𑆬𑆮𑆼𑆢𑆤𑆳 𑆑𑆟𑇀𑆝𑆷𑆫𑇀𑆢𑆳𑆲𑆂 𑆯𑆾𑆦𑆯𑇀𑆖 𑆓𑆶𑆢𑆱𑇀𑆪 𑆨𑆮𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑆡𑇀𑆪𑆱𑆼𑆮𑆴𑆤𑆳𑆁 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆱𑆤𑇀𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆂 𑆱𑇀𑆡𑆴𑆫𑆵𑆨𑆷𑆠𑆾 𑆓𑆶𑆢𑆩𑆨𑆴𑆠𑆾𑇁𑆕𑇀𑆓𑆶𑆬𑆼 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼 𑆮𑆳 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆼 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆳𑆁 𑆥𑆴𑆝𑆑𑆳𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆱𑆳𑇁𑆱𑇀𑆪 𑆠𑆾𑆢𑆳𑆢𑆵𑆤𑇀 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳 𑆖 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴, 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆳𑆨𑇀𑆪𑆳𑆱𑆓𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆮𑇀𑆫𑆟𑆂 𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆂 𑆯𑆠𑆥𑆾𑆤𑆑𑆮𑆢𑆟𑆶𑆩𑆶𑆒𑆽𑆯𑇀𑆗𑆴𑆢𑇀𑆫𑆽𑆫𑆳𑆥𑆷𑆫𑇀𑆪𑆠𑆼, 𑆠𑆳𑆤𑆴 𑆖 𑆗𑆴𑆢𑇀𑆫𑆳𑆟𑇀𑆪𑆘𑆱𑇀𑆫𑆩𑆖𑇀𑆗𑆁 𑆦𑆼𑆤𑆳𑆤𑆶𑆮𑆴𑆢𑇀𑆣𑆩𑆣𑆴𑆑𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑆴 , 𑆮𑇀𑆫𑆟𑆯𑇀𑆖 𑆠𑆳𑆝𑇀𑆪𑆠𑆼 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑆗𑆴𑆢𑇀𑆪𑆠𑆼 𑆱𑆷𑆖𑆵𑆨𑆴𑆫𑆴𑆮 𑆤𑆴𑆱𑇀𑆠𑆶𑆢𑇀𑆪𑆠𑆼, 𑆓𑆶𑆢𑆁 𑆖𑆳𑆮𑆢𑆵𑆫𑇀𑆪𑆠𑆼, 𑆇𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆼 𑆖 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆱𑆳𑆩𑆥𑇀𑆪𑆳𑆓𑆩𑆯𑇀𑆖 𑆠𑆽𑆫𑆼𑆮 𑆗𑆴𑆢𑇀𑆫𑆽𑆫𑇀𑆨𑆮𑆠𑆴; 𑆠𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆁 𑆯𑆠𑆥𑆾𑆤𑆑𑆩𑆴𑆠𑇀𑆪𑆳𑆮𑆑𑇀𑆰𑆠𑆼 𑇆𑇕𑇆
𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆶 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆩𑆤𑆴𑆬𑆼𑆤𑆳𑆣𑆂 𑆥𑇀𑆫𑆼𑆫𑆴𑆠𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆮𑆱𑇀𑆡𑆴𑆠𑆁 𑆫𑆑𑇀𑆠𑆳𑆁 𑆠𑆤𑇀𑆮𑆵𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆳𑆩𑆶𑆰𑇀𑆛𑇀𑆫𑆓𑇀𑆫𑆵𑆮𑆳𑆑𑆳𑆫𑆳𑆁 𑆥𑆴𑆝𑆑𑆳𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆱𑆳𑇁𑆱𑇀𑆪 𑆖𑆾𑆰𑆳𑆢𑆵𑆤𑇀 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴; 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳 𑆖 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴; 𑆮𑇀𑆫𑆟𑆯𑇀𑆖𑆳𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆩𑆴𑆮 𑆢𑆲𑇀𑆪𑆠𑆼, 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆩𑆶𑆰𑇀𑆟𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆱𑇀𑆫𑆮𑆠𑆴, 𑆇𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆯𑇀𑆖 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆳𑆁𑆱𑆴 𑆮𑆴𑆱𑆸𑆘𑆠𑆴; 𑆠𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑆶𑆰𑇀𑆛𑇀𑆫𑆓𑇀𑆫𑆵𑆮𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇖𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑆶 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆱𑆩𑆵𑆫𑆟𑆼𑆤𑆳𑆣𑆂 𑆥𑇀𑆫𑆼𑆫𑆴𑆠𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆮𑆱𑇀𑆡𑆴𑆠𑆂 𑆯𑆶𑆑𑇀𑆬𑆳𑆮𑆨𑆳𑆱𑆳𑆁 𑆱𑇀𑆡𑆴𑆫𑆳𑆁 𑆑𑆟𑇀𑆝𑆷𑆩𑆠𑆵𑆁 𑆥𑆴𑆝𑆑𑆳𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆱𑆳𑇁𑆱𑇀𑆪 𑆑𑆟𑇀𑆝𑇀𑆮𑆳𑆢𑆵𑆤𑇀 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳𑆁 𑆖 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴, 𑆮𑇀𑆫𑆟𑆯𑇀𑆖 𑆑𑆜𑆴𑆤𑆂 𑆱𑆁𑆫𑆩𑇀𑆨𑆵 𑆑𑆟𑇀𑆝𑆷𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑆘𑆱𑇀𑆫𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆱𑇀𑆫𑆮𑆠𑆴, 𑆇𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆯𑇀𑆖 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆳𑆁𑆱𑆴 𑆮𑆴𑆱𑆸𑆘𑆠𑆴; 𑆠𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆁 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇗𑇆
𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆿 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆿 𑆥𑆫𑆴𑆓𑆸𑆲𑇀𑆪𑆳𑆣𑆾 𑆓𑆠𑇀𑆮𑆳 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆮𑆱𑇀𑆡𑆴𑆠𑆂 𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆓𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆁 𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆳𑆁 𑆥𑆴𑆝𑆑𑆳𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆱𑆳𑇁𑆱𑇀𑆪 𑆠𑆾𑆢𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑇀𑆮𑆳𑆢𑆵𑆤𑇀 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳 𑆖 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴, 𑆮𑇀𑆫𑆟𑆯𑇀𑆖 𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆮𑆫𑇀𑆟𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆱𑇀𑆫𑆮𑆠𑆴, 𑆥𑆷𑆫𑇀𑆟𑆤𑆢𑆵𑆯𑆩𑇀𑆧𑆷𑆑𑆳𑆮𑆫𑇀𑆠𑆮𑆖𑇀𑆖𑆳𑆠𑇀𑆫 𑆱𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆂; 𑆠𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆁 𑆯𑆩𑇀𑆧𑆷𑆑𑆳𑆮𑆫𑇀𑆠𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇘𑇆
𑆩𑆷𑆞𑆼𑆤 𑆩𑆳𑆁𑆱𑆬𑆶𑆧𑇀𑆣𑆼𑆤 𑆪𑆢𑆱𑇀𑆡𑆴𑆯𑆬𑇀𑆪𑆩𑆤𑇀𑆤𑆼𑆤 𑆱𑆲𑆳𑆨𑇀𑆪𑆮𑆲𑆸𑆠𑆁 𑆪𑆢𑆳𑇁𑆮𑆓𑆳𑆞𑆥𑆶𑆫𑆵𑆰𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆩𑆥𑆳𑆤𑆼𑆤𑆳𑆣𑆂𑆥𑇀𑆫𑆼𑆫𑆴𑆠𑆩𑆱𑆩𑇀𑆪𑆓𑆳𑆓𑆠𑆁 𑆓𑆶𑆢𑆩𑆥𑆑𑇀𑆰𑆴𑆟𑆾𑆠𑆴 𑆠𑆢𑆳 𑆑𑇀𑆰𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑆑𑆾𑆡 𑆇𑆥𑆘𑆳𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆑𑇀𑆰𑆠𑆼 𑆥𑆷𑆪𑆫𑆶𑆣𑆴𑆫𑆳𑆮𑆑𑆵𑆫𑇀𑆟𑆩𑆳𑆁𑆱𑆑𑆾𑆡𑆼 𑆨𑆷𑆩𑆳𑆮𑆴𑆮 𑆘𑆬𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆑𑇀𑆫𑆴𑆩𑆪𑆂 𑆱𑆚𑇀𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆠𑆼 𑆨𑆑𑇀𑆰𑆪𑆤𑇀𑆠𑆾 𑆓𑆶𑆢𑆩𑆤𑆼𑆑𑆣𑆳 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆠𑆾 𑆢𑆳𑆫𑆪𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆠𑆽𑆫𑇀𑆩𑆳𑆫𑇀𑆓𑆽𑆂 𑆑𑆸𑆩𑆴𑆑𑆸𑆠𑆽𑆫𑇀𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆳𑆁𑆱𑇀𑆪𑆨𑆴𑆤𑆴𑆂𑆱𑆫𑆤𑇀𑆠𑆴; 𑆠𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆴𑆟𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆇𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇁𑆬𑇀𑆥𑆫𑆶𑆑𑇀 𑆯𑆾𑆦𑆳𑆠𑇀 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑇅 𑆥𑆳𑆪𑇀𑆮𑆤𑇀𑆠𑆢𑆼𑆯𑆼 𑆥𑆴𑆝𑆑𑆳 𑆱𑆳 𑆘𑇀𑆚𑆼𑆪𑆳𑇁𑆤𑇀𑆪𑆳 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆥𑆳𑆪𑆾𑆂 𑆱𑇀𑆪𑆳𑆢𑇀 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆼 𑆢𑆼𑆯𑆼 𑆓𑆷𑆞𑆩𑆷𑆬𑆳 𑆱𑆫𑆶𑆓𑇀𑆘𑇀𑆮𑆫𑆳 𑇅 𑆨𑆳𑆓𑆤𑇀𑆢𑆫𑆵𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆥𑆴𑆝𑆑𑆳𑇁𑆠𑆾 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀 𑇆𑇑𑇑𑇆
𑆪𑆳𑆤𑆪𑆳𑆤𑆳𑆤𑇀𑆩𑆬𑆾𑆠𑇀𑆱𑆫𑇀𑆓𑆳𑆠𑇀 𑆑𑆟𑇀𑆝𑆷𑆫𑆶𑆓𑇀𑆢𑆳𑆲𑆯𑆾𑆦𑆮𑆳𑆤𑇀 𑇅 𑆥𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆼𑆢𑇀𑆫𑆶𑆘𑆂 𑆑𑆛𑇀𑆪𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆼 𑇆𑇑𑇒𑇆
𑆔𑆾𑆫𑆳𑆂 𑆱𑆳𑆣𑆪𑆴𑆠𑆶𑆁 𑆢𑆶𑆂𑆒𑆳𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆂 𑇅 𑆠𑆼𑆰𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆾𑆠𑇀𑆡𑆂 𑆑𑇀𑆰𑆠𑆘𑆯𑇀𑆖 𑆨𑆓𑆤𑇀𑆢𑆫𑆂 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆶𑆰𑇀𑆜𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆲𑆴𑆠𑆳𑆯𑆴𑆤𑆂 𑆱𑇀𑆤𑆼𑆲𑆥𑆵𑆠𑆱𑇀𑆪 𑆮𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆮𑆳 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆣𑆫𑇀𑆩𑆱𑆼𑆮𑆴𑆤𑆾 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆮𑆳 𑆥𑆪𑆱𑆳𑇁𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆯𑇀𑆤𑆠𑆾 𑆪𑆾 𑆮𑆳 𑆩𑆘𑇀𑆘𑆠𑇀𑆪𑆥𑇀𑆱𑆷𑆰𑇀𑆩𑆳𑆨𑆴𑆠𑆥𑇀𑆠𑆂 𑆱𑆲𑆱𑆳 𑆗𑆫𑇀𑆢𑆴𑆁 𑆮𑆳 𑆥𑇀𑆫𑆠𑆴𑆲𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆿 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆿 𑆥𑆫𑆴𑆓𑆸𑆲𑇀𑆪𑆳𑆤𑆴𑆬𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆳𑆂 𑆱𑆴𑆫𑆳𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆥𑆢𑇀𑆪 𑆱𑆩𑆶𑆢𑇀𑆣𑆷𑆪 𑆧𑆳𑆲𑇀𑆪𑆁 𑆩𑆳𑆫𑇀𑆓𑆁 𑆥𑇀𑆫𑆠𑆴 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑆠𑆴, 𑆪𑆠𑇀𑆫 𑆪𑆠𑇀𑆫 𑆖 𑆢𑆾𑆰𑆾 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆾 𑆤𑆴𑆯𑇀𑆖𑆫𑆠𑆴 𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆍𑆮𑆁 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆱𑇀𑆠𑇀𑆮𑆖𑆴 𑆢𑆾𑆰𑆱𑇀𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫 𑆖 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆾𑇁𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑆣𑆳𑆠𑆷𑆤𑆨𑆴𑆢𑆷𑆰𑆪𑆤𑇀 𑇆𑇓𑇆
𑆠𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆠𑇀𑆮𑆑𑇀𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆩𑆑𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆂 𑆑𑆟𑇀𑆝𑆷𑆂 𑆱𑇀𑆮𑆼𑆢𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆩𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆮𑆳𑇁𑆕𑇀𑆓𑆥𑇀𑆫𑆢𑆼𑆯𑆳𑆤𑆳𑆁 𑆱𑇀𑆮𑆳𑆥𑆂 𑆑𑇀𑆰𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆟𑆩𑆱𑆸𑆘𑆂 𑆑𑆸𑆰𑇀𑆟𑆠𑆳 𑆖𑆼𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆱𑆥𑇀𑆠 𑆩𑆲𑆳𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴, 𑆍𑆑𑆳𑆢𑆯 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴, 𑆍𑆮𑆩𑆰𑇀𑆛𑆳𑆢𑆯 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆩𑆲𑆳𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆫𑆶𑆟𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆫𑇀𑆰𑇀𑆪(𑆫𑇀𑆑𑇀𑆰)𑆘𑆴𑆲𑇀𑆮𑆑𑆥𑆳𑆬𑆑𑆳𑆑𑆟𑆑𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆢𑆢𑇀𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆵𑆠𑆴 𑇅 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆥𑆴 𑆱𑇀𑆡𑆷𑆬𑆳𑆫𑆶𑆰𑇀𑆑𑆁 𑆩𑆲𑆳𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆑𑆑𑆶𑆰𑇀𑆜𑆁 𑆖𑆫𑇀𑆩𑆢𑆬𑆁 𑆮𑆴𑆱𑆫𑇀𑆥𑆂 𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆂 𑆱𑆴𑆣𑇀𑆩𑆁 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳 𑆑𑆴𑆛𑆴𑆨𑆁 (𑆩𑆁) 𑆥𑆳𑆩𑆳 𑆫𑆑𑆱𑆳 𑆖𑆼𑆠𑆴 𑇆𑇕𑇆
𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆱𑆮𑆳𑆠𑆳𑆤𑆴 𑆱𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴 𑆱𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆴 𑆱𑆑𑇀𑆫𑆴𑆩𑆵𑆟𑆴 𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆇𑆠𑇀𑆱𑆤𑇀𑆤𑆠𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆓𑇀𑆫𑆲𑆟𑆩𑆨𑆴𑆨𑆮𑆳𑆠𑇀 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆼𑆤𑆳𑆫𑆶𑆟𑆁, 𑆥𑆴𑆠𑇀𑆠𑆼𑆤𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆫𑇀𑆰𑇀𑆪(𑆫𑇀𑆑𑇀𑆰)𑆘𑆴𑆲𑇀𑆮𑆑𑆥𑆳𑆬𑆑𑆳𑆑𑆟𑆑𑆳𑆤𑆴, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆢𑆢𑇀𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆩𑆲𑆠𑇀𑆠𑇀𑆮𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆁 𑆣𑆳𑆠𑇀𑆮𑆤𑆶𑆥𑇀𑆫𑆮𑆼𑆯𑆳𑆢𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆼𑆤𑆳𑆫𑆶𑆟𑆳𑆨𑆳𑆤𑆴 𑆠𑆤𑆷𑆤𑆴 𑆮𑆴𑆱𑆫𑇀𑆥𑆵𑆟𑆴 𑆠𑆾𑆢𑆨𑆼𑆢𑆱𑇀𑆮𑆳𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆫𑆶𑆟𑆳𑆤𑆴 𑇅 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆥𑆑𑇀𑆮𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆦𑆬𑆳𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆿𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆟𑆴 , 𑆉𑆰𑇀𑆪(𑆑𑇀𑆰)𑆘𑆴𑆲𑇀𑆮𑆳𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆤𑆴 𑆒𑆫𑆳𑆟𑆴 𑆉𑆰𑇀𑆪(𑆑𑇀𑆰)𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆴, 𑆑𑆸𑆰𑇀𑆟𑆑𑆥𑆳𑆬𑆴𑆑𑆳𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆤𑆴 𑆑𑆥𑆳𑆬𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴, 𑆑𑆳𑆑𑆟𑆤𑇀𑆠𑆴𑆑𑆳𑆦𑆬𑆱𑆢𑆸𑆯𑆳𑆤𑇀𑆪𑆠𑆵𑆮 𑆫𑆑𑇀𑆠𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆑𑆟𑆑𑆳𑆤𑆴 ; 𑆠𑆼𑆰𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆩𑆥𑇀𑆪𑆾𑆰𑆖𑆾𑆰𑆥𑆫𑆴𑆢𑆳𑆲𑆣𑆷𑆩𑆳𑆪𑆤𑆳𑆤𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆥𑆳𑆑𑆨𑆼𑆢𑆴𑆠𑇀𑆮𑆳𑆤𑆴 𑆑𑇀𑆫𑆴𑆩𑆴𑆘𑆤𑇀𑆩 𑆖 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆥𑆠𑇀𑆫𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆤𑆴 𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆳𑆟𑆴, 𑆃𑆠𑆱𑆵𑆥𑆶𑆰𑇀𑆥𑆮𑆫𑇀𑆟𑆳𑆤𑆴 𑆠𑆳𑆩𑇀𑆫𑆳𑆟𑆴 𑆮𑆳 𑆮𑆴𑆱𑆫𑇀𑆥𑆵𑆟𑆴 𑆥𑆴𑆝𑆑𑆳𑆮𑆤𑇀𑆠𑆴 𑆖 𑆢𑆢𑇀𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴; 𑆠𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆫𑆥𑇀𑆪𑆶𑆠𑇀𑆱𑆤𑇀𑆤𑆠𑆳 𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆠𑆳 𑆑𑆟𑇀𑆝𑆷𑆯𑇀𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆫𑆷𑆥𑆳𑆟𑆴 𑇆𑇘𑇆
𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑆴 𑆱𑆤𑇀𑆣𑆴𑆰𑇀𑆮𑆠𑆴𑆢𑆳𑆫𑆶𑆟𑆳𑆤𑆴 𑆱𑇀𑆡𑆷𑆬𑆳𑆫𑆶𑆰𑆴 𑆱𑇀𑆪𑆶𑆂 𑆑𑆜𑆴𑆤𑆳𑆤𑇀𑆪𑆫𑆷𑆁𑆰𑆴 𑇅𑇙𑇅 𑆠𑇀𑆮𑆑𑇀𑆑𑆾𑆖𑆨𑆼𑆢𑆱𑇀𑆮𑆥𑆤𑆳𑆕𑇀𑆓𑆱𑆳𑆢𑆳𑆂 𑆑𑆶𑆰𑇀𑆜𑆼 𑆩𑆲𑆠𑇀𑆥𑆷𑆫𑇀𑆮𑆪𑆶𑆠𑆼 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇙𑇆
𑆑𑆸𑆰𑇀𑆟𑆳𑆫𑆶𑆟𑆁 𑆪𑆼𑆤 𑆨𑆮𑆼𑆖𑇀𑆗𑆫𑆵𑆫𑆁 𑆠𑆢𑆼𑆑𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆑𑆶𑆰𑇀𑆜𑆩𑇀 𑇅𑇑𑇐𑇅 𑆱𑇀𑆪𑆶𑆫𑇀𑆪𑆼𑆤 𑆑𑆟𑇀𑆝𑆷𑆮𑇀𑆪𑆡𑆤𑆿𑆰𑆖𑆾𑆰𑆳𑆱𑇀𑆠𑆬𑆼𑆰𑆶 𑆠𑆖𑇀𑆖𑆫𑇀𑆩𑆢𑆬𑆁 𑆮𑆢𑆤𑇀𑆠𑆴 𑇆𑇑𑇐𑇆
𑆮𑆴𑆱𑆫𑇀𑆥𑆮𑆠𑇀 𑆱𑆫𑇀𑆥𑆠𑆴 𑆱𑆫𑇀𑆮𑆠𑆾 𑆪𑆱𑇀𑆠𑇀𑆮𑆓𑇀𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆪𑆨𑆴𑆨𑆷𑆪 𑆯𑆵𑆔𑇀𑆫𑆩𑇀 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆮𑆴𑆢𑆳𑆲𑆳𑆫𑆠𑆴𑆠𑆾𑆢𑆥𑆳𑆑𑆳𑆤𑇀 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆴𑆱𑆫𑇀𑆥𑆂 𑆱 𑆨𑆮𑆼𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆂 𑇆𑇑𑇑𑇆
𑆯𑆤𑆽𑆂 𑆯𑆫𑆵𑆫𑆼 𑆥𑆴𑆝𑆑𑆳𑆂 𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑇀𑆪𑆂 𑆱𑆫𑇀𑆥𑆤𑇀𑆠𑆴 𑆪𑆳𑆱𑇀𑆠𑆁 𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆩𑆳𑆲𑆶𑆂 𑇅𑇑𑇒𑇅 𑆑𑆟𑇀𑆝𑇀𑆮𑆤𑇀𑆮𑆴𑆠𑆁 𑆯𑇀𑆮𑆼𑆠𑆩𑆥𑆳𑆪𑆴 𑆱𑆴𑆣𑇀𑆩 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆤𑆶 𑆥𑇀𑆫𑆳𑆪𑆯 𑆈𑆫𑇀𑆣𑇀𑆮𑆑𑆳𑆪𑆼 𑇆𑇑𑇒𑇆
𑆫𑆳𑆘𑇀𑆪𑆾𑇁𑆠𑆴𑆑𑆟𑇀𑆝𑇀𑆮𑆫𑇀𑆠𑆴𑆫𑆶𑆘𑆂 𑆱𑆫𑆷𑆑𑇀𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆓𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳𑆪𑆳𑆩𑇀 𑇅 𑆑𑆟𑇀𑆝𑆷𑆩𑆠𑆵 𑆢𑆳𑆲𑆫𑆶𑆘𑆾𑆥𑆥𑆤𑇀𑆤𑆳 𑆮𑆴𑆥𑆳𑆢𑆴𑆑𑆳 𑆥𑆳𑆢𑆓𑆠𑆼𑆪𑆩𑆼𑆮 𑇆𑇑𑇓𑇆
𑆪𑆠𑇀 𑆱𑇀𑆫𑆳𑆮𑆴 𑆮𑆸𑆠𑇀𑆠𑆁 𑆔𑆤𑆩𑆶𑆓𑇀𑆫𑆑𑆟𑇀𑆝𑆶 𑆠𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆑𑆸𑆰𑇀𑆟𑆁 𑆑𑆴𑆛𑆴𑆨𑆁(𑆩𑆁) 𑆮𑆢𑆤𑇀𑆠𑆴 𑇅𑇑𑇔𑇅 𑆱𑆳𑆱𑇀𑆫𑆳𑆮𑆑𑆟𑇀𑆝𑆷𑆥𑆫𑆴𑆢𑆳𑆲𑆑𑆳𑆨𑆴𑆂 𑆥𑆳𑆩𑆳𑇁𑆟𑆶𑆑𑆳𑆨𑆴𑆂 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆫𑆷𑆲𑇀𑆪𑆳 𑇆𑇑𑇔𑇆
𑆱𑇀𑆦𑆾𑆛𑆽𑆂 𑆱𑆢𑆳𑆲𑆽𑆫𑆠𑆴 𑆱𑆽𑆮 𑆑𑆖𑇀𑆗𑆷𑆂 𑆱𑇀𑆦𑆴𑆑𑇀𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆥𑇀𑆫𑆨𑆮𑆽𑆫𑇀𑆤𑆴𑆫𑆷𑆥𑇀𑆪𑆳 𑇅𑇑𑇕𑇅 𑆑𑆟𑇀𑆝𑇀𑆮𑆤𑇀𑆮𑆴𑆠𑆳 𑆪𑆳 𑆥𑆴𑆝𑆑𑆳 𑆯𑆫𑆵𑆫𑆼 𑆱𑆁𑆱𑇀𑆫𑆳𑆮𑆲𑆵𑆤𑆳 𑆫𑆑𑆱𑆾𑆖𑇀𑆪𑆠𑆼 𑆱𑆳 𑇆𑇑𑇕𑇆
𑆃𑆫𑆶𑆂 𑆱𑆱𑆴𑆣𑇀𑆩𑆁 𑆫𑆑𑆱𑆳 𑆩𑆲𑆖𑇀𑆖 𑆪𑆖𑇀𑆖𑆽𑆑𑆑𑆶𑆰𑇀𑆜𑆁 𑆑𑆦𑆘𑆳𑆤𑇀𑆪𑆩𑆷𑆤𑆴 𑇅 𑆮𑆳𑆪𑆾𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆠𑇀 𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆩𑆼𑆑𑆁 𑆯𑆼𑆰𑆳𑆟𑆴 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆨𑆮𑆳𑆟𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇖𑇆
𑆑𑆴𑆬𑆳𑆱𑆩𑆥𑆴 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆑𑆬𑇀𑆥 𑆍𑆮; 𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁- 𑆮𑆳𑆠𑆼𑆤, 𑆥𑆴𑆠𑇀𑆠𑆼𑆤, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆖𑆼𑆠𑆴 𑇅 𑆑𑆶𑆰𑇀𑆜𑆑𑆴𑆬𑆳𑆱𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆁- 𑆠𑇀𑆮𑆓𑇀𑆓𑆠𑆩𑆼𑆮 𑆑𑆴𑆬𑆳𑆱𑆩𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴 𑆖 𑇅 𑆠𑆢𑇀𑆮𑆳𑆠𑆼𑆤 𑆩𑆟𑇀𑆝𑆬𑆩𑆫𑆶𑆟𑆁 𑆥𑆫𑆶𑆰𑆁 𑆥𑆫𑆴𑆣𑇀𑆮𑆁𑆱𑆴 𑆖, 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆥𑆢𑇀𑆩𑆥𑆠𑇀𑆫𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆯𑆁 𑆱𑆥𑆫𑆴𑆢𑆳𑆲𑆁 𑆖, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆯𑇀𑆮𑆼𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆧𑆲𑆬𑆁 𑆑𑆟𑇀𑆝𑆷𑆩𑆖𑇀𑆖 𑇅 𑆠𑆼𑆰𑆶 𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆩𑆟𑇀𑆝𑆬𑆩𑆤𑇀𑆠𑆼𑆘𑆳𑆠𑆁 𑆫𑆑𑇀𑆠𑆫𑆾𑆩 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆁 𑆖 𑇆𑇑𑇗𑇆
𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆠𑆶 𑆠𑇀𑆮𑆑𑇀𑆱𑆕𑇀𑆑𑆾𑆖𑆱𑇀𑆮𑆳𑆥𑆱𑇀𑆮𑆼𑆢𑆯𑆾𑆦𑆨𑆼𑆢𑆑𑆿𑆟𑇀𑆪𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠𑆳 𑆮𑆳𑆠𑆼𑆤, 𑆥𑆳𑆑𑆳𑆮𑆢𑆫𑆟𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆠𑆤𑆑𑆫𑇀𑆟𑆤𑆳𑆱𑆳𑆨𑆕𑇀𑆓𑆳𑆑𑇀𑆰𑆴𑆫𑆳𑆓𑆱𑆠𑇀𑆠𑇀𑆮𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆼𑆤, 𑆑𑆟𑇀𑆝𑆷𑆮𑆫𑇀𑆟𑆨𑆼𑆢𑆯𑆾𑆦𑆳𑆱𑇀𑆫𑆳𑆮𑆓𑆿𑆫𑆮𑆳𑆟𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆧𑆬𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆁 𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆑𑆳𑆑𑆟𑆁 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆩𑇀 𑇆𑇑𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳 𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆫𑇀𑆘𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆟𑆩𑇀 𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆨𑆷𑆩𑆴𑆁 𑆮𑆴𑆓𑆳𑆲𑆼𑆠 𑆩𑆷𑆬𑆽𑆫𑇀𑆮𑆸𑆰𑇀𑆛𑆴𑆮𑆴𑆮𑆫𑇀𑆣𑆴𑆠𑆽𑆂 𑇆𑇒𑇐𑇆
𑆍𑆮𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆁 𑆠𑇀𑆮𑆖𑆴 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆠𑆂 𑇅 𑆑𑇀𑆫𑆩𑆼𑆟 𑆣𑆳𑆠𑆷𑆤𑇀 𑆮𑇀𑆪𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆤𑆫𑆱𑇀𑆪𑆳𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆴𑆟𑆂 𑇆𑇒𑇑𑇆
𑆱𑇀𑆥𑆫𑇀𑆯𑆲𑆳𑆤𑆴𑆂 𑆱𑇀𑆮𑆼𑆢𑆤𑆠𑇀𑆮𑆩𑆵𑆰𑆠𑇀𑆑𑆟𑇀𑆝𑆷𑆯𑇀𑆖 𑆘𑆳𑆪𑆠𑆼 𑇅 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆫𑆷𑆑𑇀𑆰𑆨𑆳𑆮𑆯𑇀𑆖 𑆑𑆶𑆰𑇀𑆜𑆼 𑆠𑇀𑆮𑆖𑆴 𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑇆𑇒𑇒𑇆
𑆠𑇀𑆮𑆑𑇀𑆱𑇀𑆮𑆳𑆥𑆾 𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆯𑇀𑆖 𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆪𑆳𑆨𑆴𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆩𑇀 𑇅 𑆑𑆟𑇀𑆝𑆷𑆫𑇀𑆮𑆴𑆥𑆷𑆪𑆑𑆯𑇀𑆖𑆽𑆮 𑆑𑆶𑆰𑇀𑆜𑆼 𑆯𑆾𑆟𑆴𑆠𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆼 𑇆𑇒𑇓𑇆
𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆁 𑆮𑆑𑇀𑆫𑆯𑆾𑆰𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆑𑆯𑇀𑆪𑆁 𑆥𑆴𑆝𑆑𑆾𑆢𑇀𑆓𑆩𑆂 𑇅 𑆠𑆾𑆢𑆂 𑆱𑇀𑆦𑆾𑆛𑆂 𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆁 𑆖 𑆑𑆶𑆰𑇀𑆜𑆼 𑆩𑆳𑆁𑆱𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑇆𑇒𑇔𑇆
𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆩𑆶𑆥𑆢𑆼𑆲𑆯𑇀𑆖 𑆥𑆷𑆪𑆾𑇁𑆡 𑆑𑇀𑆫𑆴𑆩𑆪𑆱𑇀𑆠𑆡𑆳 𑇅 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆨𑆼𑆢𑆤𑆁 𑆖𑆳𑆥𑆴 𑆑𑆶𑆰𑇀𑆜𑆼 𑆩𑆼𑆢𑆂𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑇆𑇒𑇕𑇆
𑆤𑆳𑆱𑆳𑆨𑆕𑇀𑆓𑆾𑇁𑆑𑇀𑆰𑆴𑆫𑆳𑆓𑆯𑇀𑆖 𑆑𑇀𑆰𑆠𑆼 𑆖 𑆑𑇀𑆫𑆴𑆩𑆴𑆱𑆩𑇀𑆨𑆮𑆂 𑇅 𑆨𑆮𑆼𑆠𑇀 𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠𑆯𑇀𑆖 𑆲𑇀𑆪𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆼 𑇆𑇒𑇖𑇆
𑆑𑆿𑆟𑇀𑆪𑆁 𑆓𑆠𑆴𑆑𑇀𑆰𑆪𑆾𑇁𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆱𑆩𑇀𑆨𑆼𑆢𑆂 𑆑𑇀𑆰𑆠𑆱𑆫𑇀𑆥𑆟𑆩𑇀 𑇅 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼 𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆠𑆡𑆽𑆮 𑆖 𑇆𑇒𑇗𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆪𑆾𑆂 𑆑𑆶𑆰𑇀𑆜𑆢𑆾𑆰𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆯𑆶𑆑𑇀𑆫𑆪𑆾𑆂 𑇅 𑆪𑆢𑆥𑆠𑇀𑆪𑆁 𑆠𑆪𑆾𑆫𑇀𑆘𑆳𑆠𑆁 𑆘𑇀𑆚𑆼𑆪𑆁 𑆠𑆢𑆥𑆴 𑆑𑆶𑆰𑇀𑆜𑆴𑆠𑆩𑇀 𑇆𑇒𑇘𑇆
𑆑𑆶𑆰𑇀𑆜𑆩𑆳𑆠𑇀𑆩𑆮𑆠𑆂 𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑇀𑆮𑆓𑇀𑆫𑆑𑇀𑆠𑆥𑆴𑆯𑆴𑆠𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀 𑇅 𑆩𑆼𑆢𑆾𑆓𑆠𑆁 𑆨𑆮𑆼𑆢𑇀𑆪𑆳𑆥𑇀𑆪𑆩𑆱𑆳𑆣𑇀𑆪𑆩𑆠 𑆇𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇒𑇙𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑇀𑆠𑇀𑆫𑆵𑆱𑆘𑇀𑆘𑆤𑆮𑆣𑆥𑆫𑆱𑇀𑆮𑆲𑆫𑆟𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆑𑆫𑇀𑆩𑆨𑆴𑆂 𑆥𑆳𑆥𑆫𑆾𑆓𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆲𑆶𑆂 𑆑𑆶𑆰𑇀𑆜𑆱𑇀𑆪 𑆱𑆩𑇀𑆨𑆮𑆩𑇀 𑇆𑇓𑇐𑇆
𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆪𑆢𑆴 𑆑𑆶𑆰𑇀𑆜𑆼𑆤 𑆥𑆶𑆤𑆫𑇀𑆘𑆳𑆠𑆼𑇁𑆥𑆴 𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆤𑆳𑆠𑆂 𑆑𑆰𑇀𑆛𑆠𑆫𑆾 𑆫𑆾𑆓𑆾 𑆪𑆡𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇓𑇑𑇆
𑆄𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆪𑆾𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆩𑆳𑆱𑇀𑆡𑆳𑆪 𑆩𑆲𑆠𑆵𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇅 𑆐𑆰𑆣𑆵𑆤𑆳𑆁 𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆥𑆱𑆯𑇀𑆖 𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀 𑇅 𑆪𑆱𑇀𑆠𑆼𑆤 𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆘𑆤𑇀𑆠𑆶𑆂 𑆱 𑆥𑆶𑆟𑇀𑆪𑆳𑆁 𑆓𑆠𑆴𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇆𑇓𑇒𑇆
𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆢𑇀𑆓𑆳𑆠𑇀𑆫𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆤𑇀𑆤𑆴𑆯𑇀𑆮𑆳𑆱𑆳𑆠𑇀 𑆱𑆲𑆨𑆾𑆘𑆤𑆳𑆠𑇀 𑇅 𑆱𑆲𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆳𑆖𑇀𑆖𑆳𑆥𑆴 𑆮𑆱𑇀𑆠𑇀𑆫𑆩𑆳𑆬𑇀𑆪𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆳𑆠𑇀 𑇆𑇓𑇓𑇆
𑆑𑆶𑆰𑇀𑆜𑆁 𑆘𑇀𑆮𑆫𑆯𑇀𑆖 𑆯𑆾𑆰𑆯𑇀𑆖 𑆤𑆼𑆠𑇀𑆫𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢 𑆍𑆮 𑆖 𑇅 𑆐𑆥𑆱𑆫𑇀𑆓𑆴𑆑𑆫𑆾𑆓𑆳𑆯𑇀𑆖 𑆱𑆕𑇀𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆠𑆴 𑆤𑆫𑆳𑆤𑇀𑆤𑆫𑆩𑇀 𑇆𑇓𑇔𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆬𑆱𑇀𑆪𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆁 𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆣𑆶𑆫𑆩𑆼𑆢𑇀𑆪𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆱𑆼𑆮𑆴𑆤𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆘𑆳𑆤𑆴𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴 𑇆𑇓𑇆
𑆠𑆱𑇀𑆪 𑆖𑆽𑆮𑆩𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆳 𑆍𑆮 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾 𑆪𑆢𑆳 𑆩𑆼𑆢𑆱𑆳 𑆱𑆲𑆽𑆑𑆠𑇀𑆮𑆩𑆶𑆥𑆼𑆠𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆲𑆴𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆤𑆶𑆱𑆸𑆠𑇀𑆪𑆳𑆣𑆾 𑆓𑆠𑇀𑆮𑆳 𑆧𑆱𑇀𑆠𑆼𑆫𑇀𑆩𑆶𑆒𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆤𑆴𑆫𑇀𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆢𑆳 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆚𑇀𑆘𑆤𑆪𑆤𑇀𑆠𑆴 𑇆𑇔𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆠𑆬𑆢𑆳𑆲𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆓𑆶𑆫𑆶𑆠𑆳 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆩𑆣𑆶𑆫𑆯𑆶𑆑𑇀𑆬𑆩𑆷𑆠𑇀𑆫𑆠𑆳 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆱𑆳𑆢𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆯𑇀𑆖 𑆯𑇀𑆮𑆳𑆱𑆱𑇀𑆠𑆳𑆬𑆶𑆓𑆬𑆘𑆴𑆲𑇀𑆮𑆳𑆢𑆤𑇀𑆠𑆼𑆰𑆶 𑆩𑆬𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆘𑆛𑆴𑆬𑆵𑆨𑆳𑆮𑆂 𑆑𑆼𑆯𑆳𑆤𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆤𑆒𑆳𑆤𑆳𑆩𑇀 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫𑆳𑆮𑆴𑆬𑆥𑇀𑆫𑆨𑆷𑆠𑆩𑆷𑆠𑇀𑆫𑆬𑆑𑇀𑆰𑆟𑆳𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇖𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆂 𑆱𑆲 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆂 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫, 𑆑𑆦𑆳𑆢𑆶𑆢𑆑𑆼𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆱𑆶𑆫𑆳𑆱𑆴𑆑𑆠𑆳𑆯𑆤𑆽𑆫𑇀𑆬𑆮𑆟𑆥𑆴𑆰𑇀𑆛𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆯𑆶𑆑𑇀𑆫𑆦𑆼𑆤𑆩𑆼𑆲𑆳 𑆢𑆯 𑆱𑆳𑆣𑇀𑆪𑆳𑆂, 𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑆩𑆑𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆤𑆵𑆬𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑇀𑆬𑆑𑇀𑆰𑆳𑆫𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆲𑆳𑆂 𑆰𑆝𑇀 𑆪𑆳𑆥𑇀𑆪𑆳𑆂, 𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆮𑆴𑆰𑆩𑆑𑇀𑆠𑆴𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆮𑆳𑆠𑆳𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆱𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆠𑆩𑆳𑆂, 𑆩𑆲𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆠𑇀𑆮𑆳𑆠𑇀 𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆼𑆢𑆾𑆨𑆴𑆫𑆤𑇀𑆮𑆴𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆮𑆳𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆢𑆾𑆨𑆴𑆫𑆤𑇀𑆮𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀, 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆩𑆼𑆢𑆾𑆨𑆴𑆫𑆤𑇀𑆮𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆳𑆠𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫, 𑆯𑇀𑆮𑆼𑆠𑆩𑆮𑆼𑆢𑆤𑆩𑆶𑆢𑆑𑆱𑆢𑆸𑆯𑆩𑆶𑆢𑆑𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴; 𑆅𑆑𑇀𑆰𑆶𑆫𑆱𑆠𑆶𑆬𑇀𑆪𑆩𑆴𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆩𑆼𑆲𑆵; 𑆱𑆶𑆫𑆳𑆠𑆶𑆬𑇀𑆪𑆁 𑆱𑆶𑆫𑆳𑆩𑆼𑆲𑆵; 𑆱𑆫𑆶𑆘𑆁 𑆱𑆴𑆑𑆠𑆳𑆤𑆶𑆮𑆴𑆢𑇀𑆣𑆁 𑆱𑆴𑆑𑆠𑆳𑆩𑆼𑆲𑆵; 𑆯𑆤𑆽𑆂 𑆱𑆑𑆦𑆁 𑆩𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆵; 𑆮𑆴𑆯𑆢𑆁 𑆬𑆮𑆟𑆠𑆶𑆬𑇀𑆪𑆁 𑆬𑆮𑆟𑆩𑆼𑆲𑆵; 𑆲𑆸𑆰𑇀𑆛𑆫𑆾𑆩𑆳 𑆥𑆴𑆰𑇀𑆛𑆫𑆱𑆠𑆶𑆬𑇀𑆪𑆁 𑆥𑆴𑆰𑇀𑆛𑆩𑆼𑆲𑆵; 𑆄𑆮𑆴𑆬𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆼𑆲𑆵; 𑆯𑆶𑆑𑇀𑆫𑆠𑆶𑆬𑇀𑆪𑆁 𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆲𑆵; 𑆱𑇀𑆠𑆾𑆑𑆁 𑆱𑇀𑆠𑆾𑆑𑆁 𑆱𑆦𑆼𑆤𑆩𑆖𑇀𑆗𑆁 𑆦𑆼𑆤𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴 𑇆𑇑𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆱𑆦𑆼𑆤𑆩𑆖𑇀𑆗𑆁 𑆤𑆵𑆬𑆁 𑆤𑆵𑆬𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴; 𑆱𑆢𑆳𑆲𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆨𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆼𑆲𑆵; 𑆃𑆩𑇀𑆬𑆫𑆱𑆓𑆤𑇀𑆣𑆩𑆩𑇀𑆬𑆩𑆼𑆲𑆵; 𑆱𑇀𑆫𑆶𑆠𑆑𑇀𑆰𑆳𑆫𑆥𑇀𑆫𑆠𑆴𑆩𑆁 𑆑𑇀𑆰𑆳𑆫𑆩𑆼𑆲𑆵; 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆾𑆢𑆑𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆼𑆲𑆵; 𑆯𑆾𑆟𑆴𑆠𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴 𑇆𑇑𑇑𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆱𑆫𑇀𑆥𑆴𑆂𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴; 𑆮𑆱𑆳𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆮𑆱𑆳𑆩𑆼𑆲𑆵; 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆫𑆱𑆮𑆫𑇀𑆟𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆼𑆲𑆵; 𑆩𑆠𑇀𑆠𑆩𑆳𑆠𑆕𑇀𑆓𑆮𑆢𑆤𑆶𑆥𑇀𑆫𑆧𑆤𑇀𑆣𑆁 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆵 𑆩𑆼𑆲𑆠𑆴 𑇆𑇑𑇒𑇆
𑆩𑆑𑇀𑆰𑆴𑆑𑆾𑆥𑆱𑆫𑇀𑆥𑆟𑆩𑆳𑆬𑆱𑇀𑆪𑆁 𑆩𑆳𑆁𑆱𑆾𑆥𑆖𑆪𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆂 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆂 𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑆳𑆤𑆳𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂; 𑆮𑆸𑆰𑆟𑆪𑆾𑆫𑆮𑆢𑆫𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆨𑆼𑆢𑆾 𑆩𑆼𑆞𑇀𑆫𑆠𑆾𑆢𑆾 𑆲𑆸𑆢𑆴 𑆯𑆷𑆬𑆩𑆩𑇀𑆬𑆵𑆑𑆳𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆳𑆫𑆾𑆖𑆑𑆳 𑆮𑆩𑆡𑆶𑆂 𑆥𑆫𑆴𑆣𑆷𑆥𑆤𑆁 𑆢𑆳𑆲𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑆴𑆥𑆳𑆱𑆳 𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆂 𑆥𑆵𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆳𑆤𑆳𑆁; 𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆾 𑆬𑆿𑆬𑇀𑆪𑆩𑆤𑆴𑆢𑇀𑆫𑆳 𑆱𑇀𑆠𑆩𑇀𑆨𑆂 𑆑𑆩𑇀𑆥𑆂 𑆯𑆷𑆬𑆁 𑆧𑆢𑇀𑆣𑆥𑆶𑆫𑆵𑆰𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆘𑆳𑆤𑆳𑆩𑇀 𑇅 𑆍𑆮𑆩𑆼𑆠𑆼 𑆮𑆴𑆁𑆯𑆠𑆴 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫 𑆮𑆱𑆳𑆩𑆼𑆢𑆾𑆨𑇀𑆪𑆳𑆩𑆨𑆴𑆥𑆤𑇀𑆤𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆽𑆯𑇀𑆖𑆳𑆤𑆶𑆓𑆠𑆣𑆳𑆠𑆾𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆾 𑆢𑆯 𑆥𑆴𑆝𑆑𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆫𑆳𑆮𑆴𑆑𑆳, 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆳, 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳, 𑆘𑆳𑆬𑆴𑆤𑆵, 𑆮𑆴𑆤𑆠𑆳, 𑆥𑆶𑆠𑇀𑆫𑆴𑆟𑆵, 𑆩𑆱𑆷𑆫𑆴𑆑𑆳, 𑆃𑆬𑆘𑆵, 𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳, 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆑𑆳 𑆖𑆼𑆠𑆴 𑇆𑇑𑇔𑇆
𑆯𑆫𑆳𑆮𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑆢𑇀𑆫𑆷𑆥𑆳 𑆤𑆴𑆩𑇀𑆤𑆩𑆣𑇀𑆪𑆳 𑆯𑆫𑆳𑆮𑆴𑆑𑆳 𑇅 𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳 𑆠𑆠𑇀𑆥𑇀𑆫𑆩𑆳𑆟𑆳 𑆖 𑆱𑆳𑆫𑇀𑆰𑆥𑆵 𑇆𑇑𑇕𑇆
𑆱𑆢𑆳𑆲𑆳 𑆑𑆷𑆫𑇀𑆩𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳 𑆧𑆶𑆣𑆽𑆂 𑇅 𑆘𑆳𑆬𑆴𑆤𑆵 𑆠𑆵𑆮𑇀𑆫𑆢𑆳𑆲𑆳 𑆠𑆶 𑆩𑆳𑆁𑆱𑆘𑆳𑆬𑆱𑆩𑆳𑆮𑆸𑆠𑆳 𑇆𑇑𑇖𑇆
𑆩𑆲𑆠𑆵 𑆥𑆴𑆝𑆑𑆳 𑆤𑆵𑆬𑆳 𑆥𑆴𑆝𑆑𑆳 𑆮𑆴𑆤𑆠𑆳 𑆱𑇀𑆩𑆸𑆠𑆳 𑇅 𑆩𑆲𑆠𑇀𑆪𑆬𑇀𑆥𑆳𑆖𑆴𑆠𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆥𑆴𑆝𑆑𑆳 𑆱𑆳 𑆠𑆶 𑆥𑆶𑆠𑇀𑆫𑆴𑆟𑆵 𑇆𑇑𑇗𑇆
𑆩𑆱𑆷𑆫𑆱𑆩𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆱𑆳 𑆠𑆶 𑆩𑆱𑆷𑆫𑆴𑆑𑆳 𑇅                   𑆫𑆑𑇀𑆠𑆳 𑆱𑆴𑆠𑆳 𑆱𑇀𑆦𑆾𑆛𑆮𑆠𑆵 𑆢𑆳𑆫𑆶𑆟𑆳 𑆠𑇀𑆮𑆬𑆘𑆵 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇘𑇆
𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑆤𑇀𑆢𑆮𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆳 𑆑𑆜𑆴𑆤𑆳 𑆖 𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳 𑇅 𑆮𑆴𑆢𑇀𑆫𑆣𑆼𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆑𑆳 𑆧𑆶𑆣𑆽𑆂 𑇆𑇑𑇙𑇆
𑆪𑆼 𑆪𑆤𑇀𑆩𑆪𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳 𑆩𑆼𑆲𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆩𑆼𑆠𑆳𑆱𑇀𑆠𑆶 𑆠𑆠𑇀𑆑𑆸𑆠𑆳𑆂 𑇅             𑆓𑆶𑆢𑆼 𑆲𑆸𑆢𑆴 𑆯𑆴𑆫𑆱𑇀𑆪𑆁𑆱𑆼 𑆥𑆸𑆰𑇀𑆜𑆼 𑆩𑆫𑇀𑆩𑆟𑆴 𑆖𑆾𑆠𑇀𑆡𑆴𑆠𑆳𑆂 𑇅              𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑆼𑆂 𑆥𑆴𑆝𑆑𑆳𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆫𑆵𑆫𑆁 𑆤𑆴𑆰𑇀𑆥𑆵𑆝𑇀𑆪 𑆩𑆼𑆢𑆾𑆩𑆘𑇀𑆘𑆮𑆱𑆳𑆪𑆶𑆠𑆂 𑇅                 𑆃𑆣𑆂 𑆥𑇀𑆫𑆑𑇀𑆫𑆩𑆠𑆼 𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆼𑆤𑆳𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆮𑆳𑆠𑆘𑆳𑆂 𑇆𑇒𑇑𑇆
𑆥𑇀𑆫𑆩𑆼𑆲𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆳𑆩𑆳𑆑𑆸𑆠𑆴𑆫𑇀𑆪𑆠𑇀𑆫 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑇅          𑆑𑆴𑆚𑇀𑆖𑆴𑆖𑇀𑆖𑆳𑆥𑇀𑆪𑆣𑆴𑆑𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆠𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇒𑇆
𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆳𑆤𑇀𑆪𑆫𑇀𑆣𑆳𑆤𑆴 𑆮𑆳 𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆩𑆳𑆤𑆮𑆼 𑇅 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆠𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆩𑆳𑆢𑆴𑆫𑆾𑆠𑇀 𑇆𑇒𑇓𑇆
𑆥𑆴𑆝𑆑𑆳𑆥𑆵𑆝𑆴𑆠𑆁 𑆓𑆳𑆞𑆩𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆂 𑇅             𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆖𑆰𑇀𑆛𑆼 𑆱 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇒𑇔𑇆
𑆱 𑆖𑆳𑆥𑆴 𑆓𑆩𑆤𑆳𑆠𑇀 𑆱𑇀𑆡𑆳𑆤𑆁 𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆳𑆱𑆤𑆩𑆴𑆖𑇀𑆗𑆠𑆴 𑇅 𑆄𑆱𑆤𑆳𑆢𑆸𑆟𑆶𑆠𑆼 𑆯𑆪𑇀𑆪𑆳𑆁 𑆯𑆪𑆤𑆳𑆠𑇀 𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆴𑆖𑇀𑆗𑆠𑆴 𑇆𑇒𑇕𑇆
𑆪𑆡𑆳 𑆲𑆴 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑆶𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆥𑆑𑆫𑇀𑆰𑆑𑆸𑆠𑆼𑆤 𑆱𑆁𑆪𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆯𑆧𑆬𑆧𑆨𑇀𑆫𑆶𑆑𑆥𑆴𑆬𑆑𑆥𑆾𑆠𑆩𑆼𑆖𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆤𑆼𑆑𑆼𑆰𑆳𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆠𑆴, 𑆍𑆮𑆩𑆼𑆮 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆲𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆥𑆑𑆫𑇀𑆰𑆑𑆸𑆠𑆼𑆤 𑆱𑆁𑆪𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆟𑆳𑆁 𑆤𑆳𑆤𑆳𑆑𑆫𑆟𑆁 𑆨𑆮𑆠𑆴 𑇆𑇒𑇖𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆱𑇀𑆠𑆶 𑆑𑆳𑆬𑆼𑆤𑆳𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆠𑆂 𑇅 𑆩𑆣𑆶𑆩𑆼𑆲𑆠𑇀𑆮𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆠𑆢𑆳𑇁𑆱𑆳𑆣𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇒𑇗𑇆
𑆃𑆡𑆳𑆠 𑆇𑆢𑆫𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆫𑇀𑆣𑆫𑇀𑆩𑆨𑆸𑆠𑆳𑆁 𑆮𑆫𑆴𑆰𑇀𑆜𑆾 𑆫𑆳𑆘𑆫𑇀𑆰𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆠𑆴𑆩𑆾𑇁𑆨𑆮𑆢𑇀𑆪𑆂 𑇅 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑇀𑆰𑆴𑆥𑆶𑆠𑇀𑆫𑆁 𑆮𑆴𑆤𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆯𑆴𑆰𑇀𑆪𑆁 𑆯𑆶𑆨𑆁 𑆱𑆶𑆯𑇀𑆫𑆶𑆠𑆩𑆤𑇀𑆮𑆯𑆳𑆠𑇀 𑆱𑆂 𑇆𑇓𑇆
𑆥𑆸𑆡𑆑𑇀 𑆱𑆩𑆱𑇀𑆠𑆽𑆫𑆥𑆴 𑆖𑆼𑆲 𑆢𑆾𑆰𑆽𑆂 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆁 𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆁 𑆠𑆡𑆽𑆮 𑇅 𑆄𑆓𑆤𑇀𑆠𑆶𑆑𑆁 𑆱𑆥𑇀𑆠𑆩𑆩𑆰𑇀𑆛𑆩𑆁 𑆖 𑆢𑆑𑆾𑆢𑆫𑆁 𑆖𑆼𑆠𑆴 𑆮𑆢𑆤𑇀𑆠𑆴 𑆠𑆳𑆤𑆴 𑇆𑇔𑇆
𑆱𑆶𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑆼𑆫𑆲𑆴𑆠𑆳𑆯𑆤𑆱𑇀𑆪 𑆱𑆁𑆯𑆶𑆰𑇀𑆑𑆥𑆷𑆠𑇀𑆪𑆤𑇀𑆤𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆢𑇀𑆮𑆳 𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆩𑆴𑆡𑇀𑆪𑆳𑆖𑆫𑆟𑆳𑆖𑇀𑆖 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆓𑆠𑆳𑆂 𑆑𑆾𑆰𑇀𑆜𑆩𑆨𑆴𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆂 𑇆𑇕𑇆
𑆓𑆶𑆬𑇀𑆩𑆳𑆑𑆸𑆠𑆴𑆮𑇀𑆪𑆚𑇀𑆘𑆴𑆠𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆔𑆾𑆫𑆳𑆟𑇀𑆪𑆶𑆢𑆫𑆳𑆟𑆴 𑆢𑆾𑆰𑆳𑆂𑇅 𑆑𑆾𑆰𑇀𑆜𑆳𑆢𑆶𑆥𑆱𑇀𑆤𑆼𑆲𑆮𑆢𑆤𑇀𑆤𑆱𑆳𑆫𑆾 𑆤𑆴𑆂𑆱𑆸𑆠𑇀𑆪 𑆢𑆶𑆰𑇀𑆛𑆾𑇁𑆤𑆴𑆬𑆮𑆼𑆓𑆤𑆶𑆤𑇀𑆤𑆂 𑇆𑇖𑇆
𑆠𑇀𑆮𑆖𑆂 𑆱𑆩𑆶𑆤𑇀𑆤𑆩𑇀𑆪 𑆯𑆤𑆽𑆂 𑆱𑆩𑆤𑇀𑆠𑆳𑆢𑇀𑆮𑆴𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆾 𑆘𑆜𑆫𑆁 𑆑𑆫𑆾𑆠𑆴 𑇅 𑆠𑆠𑇀𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆮𑆬𑆵𑆮𑆴𑆤𑆳𑆯𑆾 𑆘𑆜𑆫𑆼 𑆲𑆴 𑆫𑆳𑆘𑇀𑆪𑆂 𑇆𑇗𑇆
𑆘𑆵𑆫𑇀𑆟𑆳𑆥𑆫𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆢𑆳𑆲𑆮𑆠𑇀𑆪𑆾 𑆧𑆱𑇀𑆠𑆿 𑆫𑆶𑆘𑆂 𑆥𑆳𑆢𑆓𑆠𑆯𑇀𑆖 𑆯𑆾𑆦𑆂 𑇅 𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆥𑆸𑆰𑇀𑆜𑆤𑆳𑆨𑆵𑆫𑇀𑆪𑆢𑇀𑆮𑆫𑇀𑆣𑆠𑆼 𑆑𑆸𑆰𑇀𑆟𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆩𑇀 𑇆𑇘𑇆
𑆱𑆯𑆷𑆬𑆩𑆳𑆤𑆳𑆲𑆮𑆢𑆶𑆓𑇀𑆫𑆯𑆧𑇀𑆢𑆁 𑆱𑆠𑆾𑆢𑆨𑆼𑆢𑆁 𑆥𑆮𑆤𑆳𑆠𑇀𑆩𑆑𑆁 𑆠𑆠𑇀 𑇅 𑆪𑆖𑇀𑆖𑆾𑆰𑆠𑆸𑆰𑇀𑆟𑆳𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆵𑆠𑆁 𑆱𑆴𑆫𑆳 𑆨𑆳𑆤𑇀𑆠𑆴 𑆖 𑆪𑆠𑇀𑆫 𑆥𑆵𑆠𑆳𑆂 𑇆𑇙𑇆
𑆥𑆵𑆠𑆳𑆑𑇀𑆰𑆴𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆒𑆳𑆤𑆤𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆾𑆢𑆫𑆁 𑆠𑆠𑇀𑆠𑇀𑆮𑆖𑆴𑆫𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴 𑇅 𑆪𑆖𑇀𑆗𑆵𑆠𑆬𑆁 𑆯𑆶𑆑𑇀𑆬𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆁 𑆓𑆶𑆫𑆶 𑆱𑇀𑆡𑆴𑆫𑆁 𑆯𑆶𑆑𑇀𑆬𑆤𑆒𑆳𑆤𑆤𑆱𑇀𑆪 𑇆𑇑𑇐𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆩𑆲𑆖𑇀𑆗𑆾𑆦𑆪𑆶𑆠𑆁 𑆱𑆱𑆳𑆢𑆁 𑆑𑆦𑆾𑆢𑆫𑆁 𑆠𑆠𑇀𑆠𑆶 𑆖𑆴𑆫𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴 𑇅 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆾𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆤𑆒𑆫𑆾𑆩𑆩𑆷𑆠𑇀𑆫𑆮𑆴𑆝𑆳𑆫𑇀𑆠𑆮𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆱𑆳𑆣𑆶𑆮𑆸𑆠𑇀𑆠𑆳𑆂 𑇆𑇑𑇑𑇆
𑆪𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑇀𑆪𑆫𑆪𑆾 𑆓𑆫𑆳𑆁𑆯𑇀𑆖 𑆢𑆶𑆰𑇀𑆛𑆳𑆩𑇀𑆧𑆶𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆱𑆼𑆮𑆤𑆳𑆢𑇀𑆮𑆳 𑇅 𑆠𑆼𑆤𑆳𑆯𑆶 𑆫𑆑𑇀𑆠𑆁 𑆑𑆶𑆥𑆴𑆠𑆳𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆂 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆔𑆾𑆫𑆁 𑆘𑆜𑆫𑆁 𑆠𑇀𑆫𑆴𑆬𑆴𑆕𑇀𑆓𑆩𑇀 𑇆𑇑𑇒𑇆
𑆠𑆖𑇀𑆗𑆵𑆠𑆮𑆳𑆠𑆳𑆨𑇀𑆫𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆼𑆰𑆶 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆑𑆶𑆥𑇀𑆪𑆠𑆴 𑆢𑆲𑇀𑆪𑆠𑆼 𑆖 𑆱 𑆖𑆳𑆠𑆶𑆫𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆠𑆴 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆂 𑆑𑆸𑆯𑆂 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆠𑆸𑆰𑇀𑆟𑆪𑆳 𑆖 𑇆𑇑𑇓𑇆
𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆁 𑆢𑆷𑆰𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆶 𑆔𑆾𑆫𑆁 ...... 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆁 𑆑𑆵𑆫𑇀𑆠𑆪𑆠𑆾 𑆤𑆴𑆧𑆾𑆣 𑇅 𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆫𑆠𑆱𑇀𑆪 𑆘𑆤𑇀𑆠𑆾𑆂 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆱𑆸𑆑𑇀 𑆑𑆦𑆯𑇀𑆖 𑇆𑇑𑇔𑇆
𑆥𑇀𑆬𑆵𑆲𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆱𑆠𑆠𑆁 𑆑𑆫𑆾𑆠𑆴 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆁 𑆠𑆠𑇀 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆂 𑇅 𑆮𑆳𑆩𑆼 𑆖 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆼𑆠𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆱𑆵𑆢𑆠𑆴 𑆖𑆳𑆠𑆶𑆫𑆾𑇁𑆠𑇀𑆫 𑇆𑇑𑇕𑇆
𑆩𑆤𑇀𑆢𑆘𑇀𑆮𑆫𑆳𑆓𑇀𑆤𑆴𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆾𑇁𑆠𑆴𑆥𑆳𑆟𑇀𑆝𑆶𑆂𑇅 𑆱𑆮𑇀𑆪𑆼𑆠𑆫𑆱𑇀𑆩𑆴𑆤𑇀 𑆪𑆑𑆸𑆠𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆼 𑆘𑇀𑆚𑆼𑆪𑆁 𑆪𑆑𑆸𑆢𑇀𑆢𑆳𑆬𑇀𑆪𑆶𑆢𑆫𑆁 𑆠𑆢𑆼𑆮 𑇆𑇑𑇖𑇆
𑆪𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑇀𑆫𑆩𑆤𑇀𑆤𑆽𑆫𑆶𑆥𑆬𑆼𑆥𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆧𑆳𑆬𑆳𑆯𑇀𑆩𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆲𑆴𑆠𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆮𑆳 𑇅 𑆱𑆚𑇀𑆖𑆵𑆪𑆠𑆼 𑆠𑆠𑇀𑆫 𑆩𑆬𑆂 𑆱𑆢𑆾𑆰𑆂 𑆑𑇀𑆫𑆩𑆼𑆟 𑆤𑆳𑆝𑇀𑆪𑆳𑆩𑆴𑆮 𑆱𑆕𑇀𑆑𑆫𑆾 𑆲𑆴 𑇆𑇑𑇗𑇆
𑆤𑆴𑆫𑆶𑆣𑇀𑆪𑆠𑆼 𑆖𑆳𑆱𑇀𑆪 𑆓𑆶𑆢𑆼 𑆥𑆶𑆫𑆵𑆰𑆁 𑆤𑆴𑆫𑆼𑆠𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆢𑆥𑆴 𑆖𑆳𑆬𑇀𑆥𑆩𑆬𑇀𑆥𑆩𑇀 𑇅 𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆩𑆣𑇀𑆪𑆼 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆼𑆠𑆴 𑆠(𑆪)𑆖𑇀𑆖𑆾𑆢𑆫𑆁 𑆮𑆴𑆛𑇀𑆱𑆩𑆓𑆤𑇀𑆣𑆴𑆑𑆁 𑆖 𑇆𑇑𑇘𑇆
𑆥𑇀𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆪𑆤𑇀 𑆧𑆢𑇀𑆣𑆓𑆶𑆢𑆵 𑆮𑆴𑆨𑆳𑆮𑇀𑆪𑆂, ......𑆠𑆠𑆂 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆶𑆢𑆫𑆁 𑆤𑆴𑆧𑆾𑆣 𑇅 𑆯𑆬𑇀𑆪𑆁 𑆪𑆢𑆤𑇀𑆤𑆾𑆥𑆲𑆴𑆠𑆁 𑆠𑆢𑆤𑇀𑆠𑇀𑆫𑆁 𑆨𑆴𑆤𑆠𑇀𑆠𑆴 𑆪𑆱𑇀𑆪𑆳𑆓𑆠𑆩𑆤𑇀𑆪𑆡𑆳 𑆮𑆳 𑇆𑇑𑇙𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆫𑆶𑆠𑆾𑇁𑆤𑇀𑆠𑇀𑆫𑆳𑆠𑇀 𑆱𑆬𑆴𑆬𑆥𑇀𑆫𑆑𑆳𑆯𑆂 𑆱𑇀𑆫𑆳𑆮𑆂 𑆱𑇀𑆫𑆮𑆼𑆢𑇀𑆮𑆽 𑆓𑆶𑆢𑆠𑆱𑇀𑆠𑆶 𑆨𑆷𑆪𑆂 𑇅 𑆤𑆳𑆨𑆼𑆫𑆣𑆯𑇀𑆖𑆾𑆢𑆫𑆩𑆼𑆠𑆴 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆤𑆴𑆱𑇀𑆠𑆶𑆢𑇀𑆪𑆠𑆼𑇁𑆠𑆵𑆮 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑆖 𑇆𑇒𑇐𑇆
𑆍𑆠𑆠𑇀 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆶𑆢𑆫𑆁 𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆁...... 𑆢𑆑𑆾𑆢𑆫𑆁 𑆑𑆵𑆫𑇀𑆠𑆪𑆠𑆾 𑆤𑆴𑆧𑆾𑆣 𑇅 𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆥𑆵𑆠𑆾𑇁𑆥𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆴𑆠𑆾 𑆮𑆳 𑆮𑆳𑆤𑇀𑆠𑆾 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆾𑇁𑆥𑇀𑆪𑆡𑆮𑆳 𑆤𑆴𑆫𑆷𑆞𑆂 𑇆𑇒𑇑𑇆
𑆥𑆴𑆧𑆼𑆘𑇀𑆘𑆬𑆁 𑆯𑆵𑆠𑆬𑆩𑆳𑆯𑆶 𑆠𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆢𑆶𑆰𑇀𑆪𑆤𑇀𑆠𑆴 𑆲𑆴 𑆠𑆢𑇀𑆮𑆲𑆳𑆤𑆴 𑇅 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆬𑆴𑆥𑇀𑆠𑆼𑆰𑇀𑆮𑆡𑆮𑆳𑇁𑆥𑆴 𑆠𑆼𑆰𑆶 𑆢𑆑𑆾𑆢𑆫𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆨𑇀𑆪𑆶𑆥𑆽𑆠𑆴 𑇆𑇒𑇒𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆩𑆲𑆠𑇀 𑆱𑆩𑇀𑆥𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑆤𑆳𑆨𑆴 𑆨𑆸𑆯𑆾𑆤𑇀𑆤𑆠𑆁 𑆥𑆷𑆫𑇀𑆟𑆩𑆴𑆮𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆖 𑇅 𑆪𑆡𑆳 𑆢𑆸𑆠𑆴𑆂 𑆑𑇀𑆰𑆶𑆨𑇀𑆪𑆠𑆴 𑆑𑆩𑇀𑆥𑆠𑆼 𑆖 𑆯𑆧𑇀𑆢𑆳𑆪𑆠𑆼 𑆖𑆳𑆥𑆴 𑆢𑆑𑆾𑆢𑆫𑆁 𑆠𑆠𑇀 𑇆𑇒𑇓𑇆
𑆄𑆣𑇀𑆩𑆳𑆤𑆁 𑆓𑆩𑆤𑆼𑇁𑆯𑆑𑇀𑆠𑆴𑆫𑇀𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑆴𑆠𑆳 𑇅 𑆯𑆾𑆦𑆂 𑆱𑆢𑆤𑆩𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆱𑆕𑇀𑆓𑆾 𑆮𑆳𑆠𑆥𑆶𑆫𑆵𑆰𑆪𑆾𑆂 𑇅 𑆢𑆳𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆖 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆘𑆜𑆫𑆼𑆰𑆶 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇒𑇔𑇆
𑆃𑆤𑇀𑆠𑆼 𑆱𑆬𑆴𑆬𑆨𑆳𑆮𑆁 𑆲𑆴 𑆨𑆘𑆤𑇀𑆠𑆼 𑆘𑆜𑆫𑆳𑆟𑆴 𑆠𑆶 𑇅 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮 𑆥𑆫𑆵𑆥𑆳𑆑𑆳𑆠𑇀𑆠𑆢𑆳 𑆠𑆳𑆤𑆴 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇕𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆣𑆫𑇀𑆩𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆳𑆣𑇀𑆮𑆓𑆩𑆤𑆥𑇀𑆫𑆱𑇀𑆒𑆬𑆤𑆥𑇀𑆫𑆥𑆠𑆤𑆥𑇀𑆫𑆥𑆵𑆝𑆤𑆣𑆳𑆮𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆰𑆩𑆯𑆪𑆤𑆳𑆱𑆤𑆾𑆥𑆮𑆳𑆱𑆮𑆼𑆓𑆳𑆨𑆴𑆔𑆳𑆠𑆳𑆠𑆴𑆫𑆷𑆑𑇀𑆰- 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆨𑆾𑆘𑆤𑆯𑆾𑆑𑆳𑆠𑆴𑆑𑇀𑆰𑆳𑆫𑆱𑆼𑆮𑆤𑆳𑆠𑆴𑆱𑆳𑆫𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆥𑇀𑆫𑆼𑆕𑇀𑆒𑆾𑆬𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆓𑆫𑇀𑆨𑆯𑆳𑆠𑆤𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆧𑆤𑇀𑆣𑆤𑆳𑆤𑇀𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆓𑆫𑇀𑆨𑆂, 𑆦𑆬𑆩𑆴𑆮 𑆮𑆸𑆤𑇀𑆠𑆧𑆤𑇀𑆣𑆤𑆳𑆢𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆯𑆼𑆰𑆽𑆂; 𑆱 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆧𑆤𑇀𑆣𑆤𑆾 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆩𑆠𑆴𑆑𑇀𑆫𑆩𑇀𑆪 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑇀𑆠𑇀𑆫𑆮𑆴𑆮𑆫𑆽𑆫𑆮𑆱𑇀𑆫𑆁𑆱𑆩𑆳𑆤𑆂 𑆑𑆾𑆰𑇀𑆜𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆠𑆱𑇀𑆪𑆳 𑆘𑆜𑆫𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑆥𑆳𑆤𑆾 𑆩𑆷𑆞𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆧𑆱𑇀𑆠𑆴𑆯𑆵𑆫𑇀𑆰𑆾𑆢𑆫𑆪𑆾𑆤𑆴𑆯𑆷𑆬𑆳𑆤𑆳𑆲𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆳𑆥𑆢𑇀𑆪 𑆓𑆫𑇀𑆨𑆁 𑆖𑇀𑆪𑆳𑆮𑆪𑆠𑆴 𑆠𑆫𑆶𑆟𑆁 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆫𑆳𑆮𑆼𑆟; 𑆠𑆩𑆼𑆮 𑆑𑆢𑆳𑆖𑆴𑆢𑇀𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆩𑆱𑆩𑇀𑆪𑆓𑆳𑆓𑆠𑆩𑆥𑆠𑇀𑆪𑆥𑆡𑆩𑆤𑆶𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆩𑆤𑆴𑆫𑆱𑇀𑆪𑆩𑆳𑆤𑆁 𑆮𑆴𑆓𑆶𑆟𑆳𑆥𑆳𑆤𑆱𑆩𑇀𑆩𑆾𑆲𑆴𑆠𑆁 𑆓𑆫𑇀𑆨𑆁 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇓𑇆
𑆠𑆠𑆂 𑆑𑆵𑆬𑆂 𑆥𑇀𑆫𑆠𑆴𑆒𑆶𑆫𑆾 𑆧𑆵𑆘𑆑𑆂 𑆥𑆫𑆴𑆔 𑆅𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆈𑆫𑇀𑆣𑇀𑆮𑆧𑆳𑆲𑆶𑆯𑆴𑆫𑆂𑆥𑆳𑆢𑆾 𑆪𑆾 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆑𑆵𑆬 𑆅𑆮 𑆱 𑆑𑆵𑆬𑆂; 𑆤𑆴𑆂𑆱𑆸𑆠𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆯𑆴𑆫𑆳𑆂 𑆑𑆳𑆪𑆱𑆕𑇀𑆓𑆵 𑆥𑇀𑆫𑆠𑆴𑆒𑆶𑆫𑆂; 𑆪𑆾 𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆠𑇀𑆪𑆼𑆑𑆯𑆴𑆫𑆾𑆨𑆶𑆘𑆂 𑆱 𑆧𑆵𑆘𑆑𑆂; 𑆪𑆱𑇀𑆠𑆶 𑆥𑆫𑆴𑆔 𑆅𑆮 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆩𑆳𑆮𑆸𑆠𑇀𑆪 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆱 𑆥𑆫𑆴𑆔𑆂; 𑆅𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾 𑆨𑆮𑆠𑆵𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀; 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆱 𑆪𑆢𑆳 𑆮𑆴𑆓𑆶𑆟𑆳𑆤𑆴𑆬𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆾𑇁𑆥𑆠𑇀𑆪𑆥𑆡𑆩𑆤𑆼𑆑𑆣𑆳 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼 𑆠𑆢𑆳 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆲𑆵𑆪𑆠𑆼 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫, 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆑𑇀𑆡𑆴𑆨𑇀𑆪𑆳𑆁 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼; 𑆑𑆯𑇀𑆖𑆴𑆢𑆳𑆨𑆶𑆓𑇀𑆤𑆽𑆑𑆱𑆑𑇀𑆡𑆴𑆫𑆼𑆑𑆼𑆤; 𑆑𑆯𑇀𑆖𑆴𑆢𑆳𑆨𑆶𑆓𑇀𑆤𑆱𑆑𑇀𑆡𑆴𑆯𑆫𑆵𑆫𑆂 𑆱𑇀𑆦𑆴𑆓𑇀𑆢𑆼𑆯𑆼𑆤 𑆠𑆴𑆫𑇀𑆪𑆓𑆳𑆓𑆠𑆂; 𑆑𑆯𑇀𑆖𑆴𑆢𑆶𑆫𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆪𑆾𑆤𑆴𑆢𑇀𑆮𑆳𑆫𑆁 𑆥𑆴𑆣𑆳𑆪𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼; 𑆃𑆤𑇀𑆠𑆂𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆥𑆮𑆸𑆠𑇀𑆠𑆯𑆴𑆫𑆳𑆂 𑆑𑆯𑇀𑆖𑆴𑆢𑆼𑆑𑆼𑆤 𑆧𑆳𑆲𑆶𑆤𑆳; 𑆑𑆯𑇀𑆖𑆴𑆢𑆳𑆨𑆶𑆓𑇀𑆤𑆯𑆴𑆫𑆳 𑆧𑆳𑆲𑆶𑆢𑇀𑆮𑆪𑆼𑆤; 𑆑𑆯𑇀𑆖𑆴𑆢𑆳𑆨𑆶𑆓𑇀𑆤𑆩𑆣𑇀𑆪𑆾 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆯𑆴𑆫𑆾𑆨𑆴𑆂; 𑆑𑆯𑇀𑆖𑆴𑆢𑆼𑆑𑆼𑆤 𑆱𑆑𑇀𑆡𑇀𑆤𑆳 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼𑇁𑆥𑆫𑆼𑆟 𑆥𑆳𑆪𑆶𑆩𑇀; 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆮𑆴𑆣𑆳 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆓𑆠𑆴𑆫𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆱𑆩𑆳𑆱𑆼𑆤 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆮𑆱𑆳𑆣𑇀𑆪𑆿 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆿, 𑆯𑆼𑆰𑆳𑆤𑆥𑆴 𑆮𑆴𑆥𑆫𑆵𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆪𑆾𑆤𑆴𑆨𑇀𑆫𑆁𑆯𑆱𑆁𑆮𑆫𑆟𑆩𑆑𑇀𑆑𑆬𑇀𑆬𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆨𑇀𑆫𑆩𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆳𑆤𑇀 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑆳𑆬𑆱𑇀𑆪 𑆥𑆫𑆴𑆟𑆳𑆩𑆼𑆤 𑆩𑆶𑆑𑇀𑆠𑆁 𑆮𑆸𑆤𑇀𑆠𑆳𑆢𑇀𑆪𑆡𑆳 𑆦𑆬𑆩𑇀 𑇅 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑇀𑆮𑆨𑆳𑆮𑆼𑆤 𑆤𑆳𑆤𑇀𑆪𑆡𑆳 𑆥𑆠𑆴𑆠𑆶𑆁 𑆣𑇀𑆫𑆶𑆮𑆩𑇀 𑇆𑇗𑇆
𑆍𑆮𑆁 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆼𑆟 𑆩𑆶𑆑𑇀𑆠𑆾 𑆤𑆳𑆝𑆵𑆤𑆴𑆧𑆤𑇀𑆣𑆤𑆳𑆠𑇀 𑇅 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆱𑇀𑆡𑆾 𑆪𑆾 𑆓𑆫𑇀𑆨𑆾 𑆘𑆤𑆤𑆳𑆪 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼 𑇆𑇘𑇆
𑆑𑆸𑆩𑆴𑆮𑆳𑆠𑆳𑆨𑆴𑆔𑆳𑆠𑆽𑆱𑇀𑆠𑆶 𑆠𑆢𑆼𑆮𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆦𑆬𑆩𑇀 𑇅 𑆥𑆠𑆠𑇀𑆪𑆑𑆳𑆬𑆼𑇁𑆥𑆴 𑆪𑆡𑆳 𑆠𑆡𑆳 𑆱𑇀𑆪𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆮𑆴𑆖𑇀𑆪𑆶𑆠𑆴𑆂 𑇆𑇙𑇆
𑆄𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆠𑇀𑆠𑆠𑆾 𑆩𑆳𑆱𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆼𑆢𑇀𑆓𑆫𑇀𑆨𑆮𑆴𑆖𑇀𑆪𑆶𑆠𑆴𑆂 𑇅 𑆠𑆠𑆂 𑆱𑇀𑆡𑆴𑆫𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆥𑆳𑆠𑆂 𑆥𑆚𑇀𑆖𑆩𑆰𑆰𑇀𑆜𑆪𑆾𑆂 𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆮𑆴𑆣𑇀𑆪𑆠𑆴 𑆯𑆴𑆫𑆾 𑆪𑆳 𑆠𑆶 𑆯𑆵𑆠𑆳𑆕𑇀𑆓𑆵 𑆤𑆴𑆫𑆥𑆠𑇀𑆫𑆥𑆳 𑇅 𑆤𑆵𑆬𑆾𑆢𑇀𑆣𑆠𑆱𑆴𑆫𑆳 𑆲𑆤𑇀𑆠𑆴 𑆱𑆳 𑆓𑆫𑇀𑆨𑆁 𑆱 𑆖 𑆠𑆳𑆁 𑆠𑆡𑆳 𑇆𑇑𑇑𑇆
𑆓𑆫𑇀𑆨𑆳𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆩𑆳𑆮𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆟𑆳𑆯𑆂 𑆯𑇀𑆪𑆳𑆮𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳 𑇅 𑆨𑆮𑆠𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆥𑆷𑆠𑆴𑆠𑇀𑆮𑆁 𑆯𑆷𑆬𑆁 𑆖𑆳𑆤𑇀𑆠𑆫𑇀𑆩𑆸𑆠𑆼 𑆯𑆴𑆯𑆿 𑇆𑇑𑇒𑇆
𑆩𑆳𑆤𑆱𑆳𑆓𑆤𑇀𑆠𑆶𑆨𑆴𑆫𑇀𑆩𑆳𑆠𑆶𑆫𑆶𑆥𑆠𑆳𑆥𑆽𑆂 𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆂 𑇅 𑆓𑆫𑇀𑆨𑆾 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆑𑆶𑆑𑇀𑆰𑆿 𑆮𑇀𑆪𑆳𑆣𑆴𑆨𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆂 𑇆𑇑𑇓𑇆
𑆧𑆱𑇀𑆠𑆩𑆳𑆫𑆮𑆴𑆥𑆤𑇀𑆤𑆳𑆪𑆳𑆂 𑆑𑆶𑆑𑇀𑆰𑆴𑆂 𑆥𑇀𑆫𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆪𑆢𑆴 𑇅 𑆠𑆠𑇀𑆑𑇀𑆰𑆟𑆳𑆘𑇀𑆘𑆤𑇀𑆩𑆑𑆳𑆬𑆼 𑆠𑆁 𑆥𑆳𑆛𑆪𑆴𑆠𑇀𑆮𑆾𑆢𑇀𑆣𑆫𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇔𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆴𑆢𑇀𑆫𑆣𑆵𑆤𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆫𑇀𑆮𑆳𑆩𑆫𑆓𑆶𑆫𑆶𑆂 𑆯𑇀𑆫𑆵𑆩𑆳𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆠𑆫𑆨𑆷𑆩𑆴𑆥𑆂 𑇅 𑆯𑆴𑆰𑇀𑆪𑆳𑆪𑆾𑆮𑆳𑆖 𑆤𑆴𑆒𑆴𑆬𑆩𑆴𑆢𑆁 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇓𑇆
𑆠𑇀𑆮𑆓𑇀𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪𑆳𑆱𑇀𑆡𑆴𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑇅 𑆢𑆾𑆰𑆳𑆂 𑆯𑆾𑆦𑆁 𑆯𑆤𑆽𑆫𑇀𑆔𑆾𑆫𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆳 𑆨𑆸𑆯𑆩𑇀 𑇆𑇔𑇆
𑆩𑆲𑆳𑆩𑆷𑆬𑆁 𑆫𑆶𑆘𑆳𑆮𑆤𑇀𑆠𑆁 𑆮𑆸𑆠𑇀𑆠𑆁 𑆖𑆳(𑆮𑆳𑇁)𑆥𑇀𑆪𑆡𑆮𑆳𑇁𑇁𑆪𑆠𑆩𑇀 𑇅 𑆠𑆩𑆳𑆲𑆶𑆫𑇀𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆁 𑆣𑆵𑆫𑆳, 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆱 𑆖 𑆰𑆝𑇀𑆮𑆴𑆣𑆂 𑇆𑇕𑇆
𑆥𑆸𑆡𑆓𑇀𑆢𑆾𑆰𑆽𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆑𑇀𑆰𑆠𑆼𑆤𑆳𑆥𑇀𑆪𑆱𑆸𑆘𑆳 𑆠𑆡𑆳 𑇅 𑆰𑆟𑇀𑆟𑆳𑆩𑆥𑆴 𑆲𑆴 𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇖𑇆
𑆑𑆸𑆰𑇀𑆟𑆾𑇁𑆫𑆶𑆟𑆾 𑆮𑆳 𑆥𑆫𑆶𑆰𑆾 𑆨𑆸𑆯𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆮𑆼𑆢𑆤𑆂 𑇅 𑆖𑆴𑆠𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆥𑆳𑆑𑆯𑇀𑆖 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆫𑇀𑆮𑆳𑆠𑆱𑆩𑇀𑆨𑆮𑆂 𑇆𑇗𑇆
𑆥𑆑𑇀𑆮𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆱𑆕𑇀𑆑𑆳𑆯𑆂 𑆯𑇀𑆪𑆳𑆮𑆾 𑆮𑆳 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆮𑆳𑆤𑇀 𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆥𑆳𑆑𑆯𑇀𑆖 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆱𑆩𑇀𑆨𑆮𑆂 𑇆𑇘𑇆

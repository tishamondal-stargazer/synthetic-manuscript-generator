𑆑𑆰𑆳𑆪 𑆍𑆰𑆳𑆁 𑆥𑆼𑆰𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆁 𑆤𑆳𑆓𑆫𑆁 𑆱𑆶𑆫𑆢𑆳𑆫𑆶 𑆖𑇆𑇒𑇓𑇕𑇆
𑆑𑆬𑆴𑆕𑇀𑆓𑆳𑆂 𑆯𑆳𑆬𑇀𑆩𑆬𑆁 𑆥𑆶𑆰𑇀𑆥𑆁 𑆮𑆵𑆫𑆳 𑆖𑆤𑇀𑆢𑆤𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀 𑇅 𑆑𑆛𑇀𑆦𑆬𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆩𑆶𑆱𑇀𑆠𑆁 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆠𑆴𑆮𑆴𑆰𑆳𑆱𑇀𑆡𑆴𑆫𑆳𑆂𑇆𑇒𑇓𑇖𑇆
𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆳𑆤𑆳𑆁 𑆑𑆴𑆚𑇀𑆘𑆬𑇀𑆑𑆂 𑆱𑆩𑆕𑇀𑆓𑆳 𑆱𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑇅 𑆧𑆴𑆬𑇀𑆮𑆁 𑆩𑆾𑆖𑆫𑆱𑆂 𑆥𑆳𑆜𑆳 𑆨𑆳𑆓𑆳𑆂 𑆑𑆫𑇀𑆰𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆳𑆂𑇆𑇒𑇓𑇗𑇆
𑆖𑆠𑆶𑆰𑇀𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆯𑆸𑆠𑆁 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆑𑆰𑆳𑆪𑆩𑆮𑆠𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀𑆥𑆬𑆳𑆤𑆴 𑆥𑇀𑆫𑆱𑇀𑆡𑆾𑇁𑆠𑇀𑆫 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆢𑇀𑆮𑆴𑆥𑆬𑆳𑆣𑆴𑆑𑆂𑇆𑇒𑇓𑇘𑇆
𑆱𑆶𑆤𑆴𑆰𑆟𑇀𑆟𑆑𑆖𑆳𑆕𑇀𑆓𑆼𑆫𑇀𑆪𑆾𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆿 𑆢𑇀𑆮𑆿 𑆱𑇀𑆮𑆫𑆱𑆱𑇀𑆪 𑆖𑇅 𑆱𑆫𑇀𑆮𑆽𑆫𑆼𑆠𑆽𑆫𑇀𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇆𑇒𑇓𑇙𑇆
𑆍𑆠𑆢𑆫𑇀𑆯𑆂𑆱𑇀𑆮𑆠𑆵𑆱𑆳𑆫𑆼 𑆫𑆑𑇀𑆠𑆱𑇀𑆫𑆳𑆮𑆼 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆼𑇅 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆼 𑆓𑆶𑆢𑆨𑇀𑆫𑆁𑆯𑆼 𑆥𑆴𑆖𑇀𑆗𑆳𑆱𑆶 𑆮𑆴𑆮𑆴𑆣𑆳𑆱𑆶 𑆖𑇆𑇒𑇔𑇐𑇆
𑆇𑆠𑇀𑆡𑆳𑆤𑆼 𑆖𑆳𑆠𑆴𑆧𑆲𑆶𑆯𑆂 𑆯𑆾𑆡𑆯𑆷𑆬𑆼 𑆓𑆶𑆢𑆳𑆯𑇀𑆫𑆪𑆼𑇅 𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆼 𑆩𑆷𑆞𑆮𑆳𑆠𑆼 𑆩𑆤𑇀𑆢𑆼𑇁𑆓𑇀𑆤𑆳𑆮𑆫𑆶𑆖𑆳𑆮𑆥𑆴𑇆𑇒𑇔𑇑𑇆
𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆮𑆴𑆣𑆴𑆮𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆧𑆬𑆮𑆫𑇀𑆟𑆳𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇅 𑆮𑆴𑆮𑆴𑆣𑆼𑆰𑇀𑆮𑆤𑇀𑆤𑆥𑆳𑆤𑆼𑆰𑆶 𑆑𑆼𑆮𑆬𑆁 𑆮𑆳 𑆤𑆴𑆫𑆠𑇀𑆪𑆪𑆩𑇀𑇆𑇒𑇔𑇒𑇆
𑆅𑆠𑆴 𑆱𑆶𑆤𑆴𑆰𑆟𑇀𑆟𑆑𑆖𑆳𑆕𑇀𑆓𑆼𑆫𑆵𑆔𑆸𑆠𑆩𑇀𑇅 𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑇀𑆪𑆠𑇀𑆪𑆳𑆱𑆳𑆤𑇀𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆳𑆤𑆴 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆳𑆤𑆴 𑆖 𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆤𑆴𑆠𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆵 𑆘𑆪𑆠𑇀𑆪𑆫𑇀𑆯𑆂𑆑𑆸𑆠𑆳𑆤𑇀 𑆓𑆢𑆳𑆤𑇀𑇆𑇒𑇔𑇓𑇆
𑆠𑇀𑆫𑆪𑆾 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆪𑆼 𑆥𑆫𑆱𑇀𑆥𑆫𑆲𑆼𑆠𑆮𑆂𑇅 𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆖𑆳𑆠𑆴𑆱𑆳𑆫𑆯𑇀𑆖 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰 𑆍𑆮 𑆖𑇆𑇒𑇔𑇔𑇆
𑆍𑆰𑆳𑆩𑆓𑇀𑆤𑆴𑆧𑆬𑆼 𑆲𑆵𑆤𑆼 𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆼 𑆥𑆫𑆴𑆑𑇀𑆰𑆪𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆓𑇀𑆤𑆴𑆧𑆬𑆁 𑆫𑆑𑇀𑆰𑇀𑆪𑆩𑆼𑆰𑆶 𑆠𑇀𑆫𑆴𑆰𑆶 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇆𑇒𑇔𑇕𑇆
𑆨𑆸𑆰𑇀𑆛𑆽𑆂 𑆯𑆳𑆑𑆽𑆫𑇀𑆪𑆮𑆳𑆓𑆷𑆨𑆴𑆫𑇀𑆪𑆷𑆰𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆫𑆱𑆽𑆂 𑆒𑆝𑆽𑆂𑇅 𑆑𑇀𑆰𑆵𑆫𑆠𑆑𑇀𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆯𑇀𑆖 𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑇀𑆓𑆶𑆢𑆘𑆳𑆚𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇒𑇔𑇖𑇆
𑆪𑆢𑇀𑆮𑆳𑆪𑆾𑆫𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪𑆳𑆪 𑆪𑆢𑆓𑇀𑆤𑆴𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆪𑆼𑇅 𑆃𑆤𑇀𑆤𑆥𑆳𑆤𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆠𑆠𑇀 𑆱𑆼𑆮𑇀𑆪𑆁 𑆤𑆴𑆠𑇀𑆪𑆩𑆫𑇀𑆯𑆱𑆽𑆂𑇆𑇒𑇔𑇗𑇆
𑆪𑆢𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆢𑆳𑆤𑆼 𑆪𑆖𑇀𑆖 𑆢𑆫𑇀𑆯𑆴𑆠𑆩𑇀𑇅 𑆓𑆶𑆢𑆘𑆳𑆨𑆴𑆥𑆫𑆵𑆠𑆼𑆤 𑆠𑆠𑇀 𑆱𑆼𑆮𑇀𑆪𑆁 𑆤 𑆑𑆢𑆳𑆖𑆤𑇆𑇒𑇔𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆃𑆫𑇀𑆯𑆱𑆳𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆘𑆤𑇀𑆩 𑆥𑆸𑆡𑆓𑆳𑆪𑆠𑆤𑆳𑆤𑆴 𑆖𑇅 𑆱𑇀𑆡𑆳𑆤𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇒𑇔𑇙𑇆
𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆂 𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆣𑆷𑆩𑆳𑆂 𑆱𑆳𑆮𑆓𑆳𑆲𑆳𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆤𑆳𑆂𑇅 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪𑆳𑆮𑆱𑆼𑆑𑆯𑇀𑆖 𑆪𑆾𑆓𑆳 𑆢𑆵𑆥𑆤𑆥𑆳𑆖𑆤𑆳𑆂𑇆𑇒𑇕𑇐𑇆
𑆥𑆳𑆤𑆳𑆤𑇀𑆤𑆮𑆴𑆣𑆴𑆫𑆓𑇀𑆫𑇀𑆪𑆯𑇀𑆖 𑆮𑆳𑆠𑆮𑆫𑇀𑆖𑆾𑇁𑆤𑆶𑆬𑆾𑆩𑆤𑆂𑇅 𑆪𑆾𑆓𑆳𑆂 𑆱𑆁𑆯𑆩𑆤𑆵𑆪𑆳𑆯𑇀𑆖 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑆴 𑆖𑇆𑇒𑇕𑇑𑇆
𑆧𑆱𑇀𑆠𑆪𑆱𑇀𑆠𑆑𑇀𑆫𑆪𑆾𑆓𑆳𑆯𑇀𑆖 𑆮𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆳𑆂𑇅 𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆳𑆩𑆫𑇀𑆯𑆱𑆳𑆁 𑆯𑆱𑇀𑆠𑆳𑆂 𑆱𑇀𑆫𑆳𑆮𑆴𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆖𑇆𑇒𑇕𑇒𑇆
𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆱𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆳𑆤𑆳𑆁 𑆠𑆼𑆰𑆳𑆁 𑆖𑆼𑆰𑇀𑆛𑆁 𑆪𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆳𑆂 𑆑𑇀𑆮𑆳𑆡𑆳𑆂 𑆥𑆼𑆰𑇀𑆪𑆳𑆯𑇀𑆖 𑆮𑆴𑆮𑆴𑆣𑆳𑆠𑇀𑆩𑆑𑆳𑆂𑇆𑇒𑇕𑇓𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑆳𑆓𑇀𑆫𑇀𑆪𑆾 𑆪𑆾𑆓𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆳𑆂𑇅 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆳𑆮𑆓𑆳𑆲𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆂 𑆱𑆼𑆖𑆤𑆳𑆤𑆴 𑆖𑇆𑇒𑇕𑇔𑇆
𑆃𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆱𑇀𑆪 𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆣𑆳𑆠𑆮𑇀𑆪𑆁 𑆪𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆩𑆴𑆲 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆓𑆶𑆢𑆘𑆳𑆤𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑇆𑇒𑇕𑇕𑇆
𑆃𑆡𑆳𑆠𑆾 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆄𑆪𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑆾 𑆧𑆬𑆁 𑆱𑇀𑆮𑆳𑆱𑇀𑆡𑇀𑆪𑆩𑆶𑆠𑇀𑆱𑆳𑆲𑆾𑆥𑆖𑆪𑆿 𑆥𑇀𑆫𑆨𑆳𑇅 𑆏𑆘𑆱𑇀𑆠𑆼𑆘𑆾𑇁𑆓𑇀𑆤𑆪𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆢𑆼𑆲𑆳𑆓𑇀𑆤𑆴𑆲𑆼𑆠𑆶𑆑𑆳𑆂𑇆𑇓𑇆
𑆯𑆳𑆤𑇀𑆠𑆼𑇁𑆓𑇀𑆤𑆿 𑆩𑇀𑆫𑆴𑆪𑆠𑆼, 𑆪𑆶𑆑𑇀𑆠𑆼 𑆖𑆴𑆫𑆁 𑆘𑆵𑆮𑆠𑇀𑆪𑆤𑆳𑆩𑆪𑆂𑇅 𑆫𑆾𑆓𑆵 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆑𑆸𑆠𑆼, 𑆩𑆷𑆬𑆩𑆓𑇀𑆤𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇆
𑆪𑆢𑆤𑇀𑆤𑆁 𑆢𑆼𑆲𑆣𑆳𑆠𑇀𑆮𑆾𑆘𑆾𑆧𑆬𑆮𑆫𑇀𑆟𑆳𑆢𑆴𑆥𑆾𑆰𑆑𑆩𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆫𑇀𑆲𑆼𑆠𑆶𑆫𑆳𑆲𑆳𑆫𑆳𑆤𑇀𑆤 𑆲𑇀𑆪𑆥𑆑𑇀𑆮𑆳𑆢𑇀𑆫𑆱𑆳𑆢𑆪𑆂𑇆𑇕𑇆
𑆃𑆤𑇀𑆤𑆩𑆳𑆢𑆳𑆤𑆑𑆫𑇀𑆩𑆳 𑆠𑆶 𑆥𑇀𑆫𑆳𑆟𑆂 𑆑𑆾𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆠𑆴𑇅 𑆠𑆢𑇀𑆢𑇀𑆫𑆮𑆽𑆫𑇀𑆨𑆴𑆤𑇀𑆤𑆱𑆕𑇀𑆔𑆳𑆠𑆁 𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆩𑆸𑆢𑆶𑆠𑆳𑆁 𑆓𑆠𑆩𑇀𑇆𑇖𑇆
𑆱𑆩𑆳𑆤𑆼𑆤𑆳𑆮𑆣𑆷𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑆶𑆢𑆫𑇀𑆪𑆂 𑆥𑆮𑆤𑆾𑆢𑇀𑆮𑆲𑆂𑇅 𑆑𑆳𑆬𑆼 𑆨𑆶𑆑𑇀𑆠𑆁 𑆱𑆩𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆖𑆠𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆪𑆼𑇆𑇗𑇆
𑆍𑆮𑆁 𑆫𑆱𑆩𑆬𑆳𑆪𑆳𑆤𑇀𑆤𑆩𑆳𑆯𑆪𑆱𑇀𑆡𑆩𑆣𑆂 𑆱𑇀𑆡𑆴𑆠𑆂𑇅 𑆥𑆖𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑇀𑆪𑆡𑆳 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆩𑆾𑆢𑆤𑆳𑆪𑆳𑆩𑇀𑆧𑆶𑆠𑆟𑇀𑆝𑆶𑆬𑆩𑇀𑇆𑇘𑇆
𑆃𑆤𑇀𑆤𑆱𑇀𑆪 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆰𑆝𑇀𑆫𑆱𑆱𑇀𑆪 𑆥𑇀𑆫𑆥𑆳𑆑𑆠𑆂𑇅 𑆩𑆣𑆶𑆫𑆳𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆦𑆾 𑆨𑆳𑆮𑆳𑆠𑇀 𑆦𑆼𑆤𑆨𑆷𑆠 𑆇𑆢𑆵𑆫𑇀𑆪𑆠𑆼𑇆𑇙𑇆
𑆥𑆫𑆁 𑆠𑆶 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆮𑆴𑆢𑆓𑇀𑆣𑆱𑇀𑆪𑆳𑆩𑇀𑆬𑆨𑆳𑆮𑆠𑆂𑇅 𑆄𑆯𑆪𑆳𑆖𑇀𑆖𑇀𑆪𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆩𑆖𑇀𑆗𑆩𑆶𑆢𑆵𑆫𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆁 𑆠𑆶 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆱𑇀𑆪 𑆯𑆾𑆰𑇀𑆪𑆩𑆳𑆟𑆱𑇀𑆪 𑆮𑆲𑇀𑆤𑆴𑆤𑆳𑇅 𑆥𑆫𑆴𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆥𑆑𑇀𑆮𑆱𑇀𑆪 𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆛𑆶𑆨𑆳𑆮𑆠𑆂𑇆𑇑𑇑𑇆
𑆃𑆤𑇀𑆤𑆩𑆴𑆰𑇀𑆛𑆁 𑆲𑇀𑆪𑆶𑆥𑆲𑆴𑆠𑆩𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆢𑆼𑆲𑆼 𑆥𑇀𑆫𑆵𑆟𑆳𑆠𑆴 𑆓𑆤𑇀𑆣𑆳𑆢𑆵𑆤𑇀 𑆔𑇀𑆫𑆳𑆟𑆳𑆢𑆵𑆤𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆖𑇆𑇑𑇒𑇆
𑆨𑆿𑆩𑆳𑆥𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆂 𑆥𑆚𑇀𑆖𑆾𑆰𑇀𑆩𑆳𑆟𑆂 𑆱𑆤𑆳𑆨𑆱𑆳𑆂𑇅 𑆥𑆚𑇀𑆖𑆳𑆲𑆳𑆫𑆓𑆶𑆟𑆳𑆤𑇀𑆱𑇀𑆮𑆳𑆤𑇀𑆱𑇀𑆮𑆳𑆤𑇀𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆢𑆵𑆤𑇀𑆥𑆖𑆤𑇀𑆠𑆴 𑆲𑆴𑇆𑇑𑇓𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆱𑇀𑆮𑆁 𑆖 𑆥𑆶𑆰𑇀𑆟𑆤𑇀𑆠𑆴 𑆢𑆼𑆲𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆟𑆳𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆂 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆤𑆼𑆮 𑆯𑆼𑆰𑆳𑆂 𑆯𑆼𑆰𑆳𑆁𑆯𑇀𑆖 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆯𑆂𑇆𑇑𑇔𑇆
𑆱𑆥𑇀𑆠𑆨𑆴𑆫𑇀𑆢𑆼𑆲𑆣𑆳𑆠𑆳𑆫𑆾 𑆣𑆳𑆠𑆮𑆾 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆥𑆶𑆤𑆂𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆓𑇀𑆤𑆴𑆨𑆴𑆂 𑆥𑆳𑆑𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆑𑆴𑆛𑇀𑆛𑆥𑇀𑆫𑆱𑆳𑆢𑆮𑆠𑇀 𑇆𑇑𑇕𑇆
𑆫𑆱𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆠𑆠𑆾 𑆩𑆳𑆁𑆱𑆁 𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑇀𑆠𑆠𑆾𑇁𑆱𑇀𑆡𑆴 𑆖𑇅 𑆃𑆱𑇀𑆡𑇀𑆤𑆾 𑆩𑆘𑇀𑆘𑆳 𑆠𑆠𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆘𑆂𑇆𑇑𑇖𑇆
𑆫𑆱𑆳𑆠𑇀 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆠𑆠𑆾 𑆫𑆑𑇀𑆠𑆩𑆱𑆸𑆘𑆂 𑆑𑆟𑇀𑆝𑆫𑆳𑆂 𑆱𑆴𑆫𑆳𑆂𑇅 𑆩𑆳𑆁𑆱𑆳𑆢𑇀𑆮𑆱𑆳 𑆠𑇀𑆮𑆖𑆂 𑆰𑆛𑇀 𑆖 𑆩𑆼𑆢𑆱𑆂 𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆩𑇀𑆨𑆮𑆂 𑇆𑇑𑇗𑇆
𑆑𑆴𑆛𑇀𑆛𑆩𑆤𑇀𑆤𑆱𑇀𑆪 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆁, 𑆫𑆱𑆱𑇀𑆪 𑆠𑆶 𑆑𑆦𑆾𑇁𑆱𑆸𑆘𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆁, 𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆒𑆩𑆬𑆳, 𑆩𑆬𑆂 𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆶 𑆩𑆼𑆢𑆱𑆂𑇆𑇑𑇘𑇆
𑆱𑇀𑆪𑆳𑆠𑇀𑆑𑆴𑆛𑇀𑆛𑆁 𑆑𑆼𑆯𑆬𑆾𑆩𑆳𑆱𑇀𑆡𑇀𑆤𑆾, 𑆩𑆘𑇀𑆘𑇀𑆚𑆂 𑆱𑇀𑆤𑆼𑆲𑆾𑇁𑆑𑇀𑆰𑆴𑆮𑆴𑆛𑇀𑆠𑇀𑆮𑆖𑆳𑆩𑇀𑇅 𑆥𑇀𑆫𑆱𑆳𑆢𑆑𑆴𑆛𑇀𑆛𑆼 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆥𑆳𑆑𑆳𑆢𑆼𑆮𑆁𑆮𑆴𑆣𑆫𑇀𑆖𑇀𑆗𑆠𑆂 𑇆𑇑𑇙𑇆
𑆥𑆫𑆱𑇀𑆥𑆫𑆾𑆥𑆱𑆁𑆱𑇀𑆠𑆧𑇀𑆣𑆳 𑆣𑆳𑆠𑆶𑆱𑇀𑆤𑆼𑆲𑆥𑆫𑆩𑇀𑆥𑆫𑆳 𑇅𑇒𑇐𑇅 𑆮𑆸𑆰𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆠𑆶 𑆥𑆶𑆰𑇀𑆟𑆳𑆠𑆴 𑆧𑆬𑆩𑆳𑆯𑆶 𑆲𑆴𑇆𑇒𑇐𑇆
𑆰𑆝𑇀𑆨𑆴𑆂 𑆑𑆼𑆖𑆴𑆢𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆽𑆫𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇅 𑆱𑆤𑇀𑆠𑆠𑇀𑆪𑆳 𑆨𑆾𑆘𑇀𑆪𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆥𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆶 𑆖𑆑𑇀𑆫𑆮𑆠𑇀𑇆𑇒𑇑𑇆
(𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆩𑆳𑆖𑆳𑆫𑇀𑆪𑆁 𑆯𑆴𑆰𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆴𑆢𑆩𑆖𑆾𑆢𑆪𑆠𑇀𑇅 𑆫𑆱𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆮𑆴𑆱𑆢𑆸𑆯𑆳𑆠𑇀 𑆑𑆡𑆁 𑆢𑆼𑆲𑆼𑇁𑆨𑆴𑆘𑆳𑆪𑆠𑆼𑇆𑇒𑇒𑇆
𑆫𑆱𑆱𑇀𑆪 𑆖 𑆤 𑆫𑆳𑆓𑆾𑇁𑆱𑇀𑆠𑆴 𑆱 𑆑𑆡𑆁 𑆪𑆳𑆠𑆴 𑆫𑆑𑇀𑆠𑆠𑆳𑆩𑇀𑇅 𑆢𑇀𑆫𑆮𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆳𑆠𑇀𑆱𑇀𑆡𑆴𑆫𑆁 𑆩𑆳𑆁𑆱𑆁 𑆑𑆡𑆁 𑆠𑆘𑇀𑆘𑆳𑆪𑆠𑆼 𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇒𑇓𑇆
𑆢𑇀𑆫𑆮𑆣𑆳𑆠𑆾𑆂 𑆱𑇀𑆡𑆴𑆫𑆳𑆤𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆂 𑆱𑆩𑇀𑆨𑆮𑆂 𑆑𑆡𑆩𑇀𑇅 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑆨𑇀𑆪𑆳𑆁 𑆒𑆫𑆠𑇀𑆮𑆁 𑆑𑆡𑆩𑆱𑇀𑆡𑆴𑆰𑆶𑇆𑇒𑇔𑇆
𑆒𑆫𑆼𑆰𑇀𑆮𑆱𑇀𑆡𑆴𑆰𑆶 𑆩𑆘𑇀𑆘𑆳 𑆖 𑆑𑆼𑆤 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆩𑆸𑆢𑆶𑆱𑇀𑆠𑆡𑆳𑇅 𑆩𑆘𑇀𑆘𑇀𑆚𑆯𑇀𑆖 𑆥𑆫𑆴𑆟𑆳𑆩𑆼𑆤 𑆪𑆢𑆴 𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇒𑇕𑇆
𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆓𑆠𑆁 𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆩𑆤𑆵𑆰𑆴𑆟𑆂𑇅 𑆠𑆡𑆳𑇁𑆱𑇀𑆡𑆴𑆩𑆣𑇀𑆪𑆩𑆘𑇀𑆘𑇀𑆚𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆁 𑆨𑆮𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀𑇆𑇒𑇖𑇆
𑆗𑆴𑆢𑇀𑆫𑆁 𑆤 𑆢𑆸𑆯𑇀𑆪𑆠𑆼𑇁𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆖 𑆠𑆤𑇀𑆤𑆴𑆂𑆱𑆫𑆠𑆴 𑆮𑆳 𑆑𑆡𑆩𑇀𑇅 𑆍𑆮𑆩𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑆶 𑆯𑆴𑆰𑇀𑆪𑆼𑆟 𑆓𑆶𑆫𑆶𑆂 𑆥𑇀𑆫𑆳𑆲𑆼𑆢𑆩𑆶𑆠𑇀𑆠𑆫𑆩𑇀𑇆𑇒𑇗𑇆
𑆠𑆼𑆘𑆾 𑆫𑆱𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆩𑆤𑆶𑆘𑆳𑆤𑆳𑆁 𑆪𑆢𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆥𑆴𑆠𑇀𑆠𑆾𑆰𑇀𑆩𑆟𑆂 𑆱 𑆫𑆳𑆓𑆼𑆟 𑆫𑆱𑆾 𑆫𑆑𑇀𑆠𑆠𑇀𑆮𑆩𑆸𑆖𑇀𑆗𑆠𑆴𑇆𑇒𑇘𑇆
𑆮𑆳𑆪𑇀𑆮𑆩𑇀𑆧𑆶𑆠𑆼𑆘𑆱𑆳 𑆫𑆑𑇀𑆠𑆩𑆷𑆰𑇀𑆩𑆟𑆳 𑆖𑆳𑆨𑆴𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆱𑇀𑆡𑆴𑆫𑆠𑆳𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆩𑆳𑆁𑆱𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆾𑆰𑇀𑆩𑆟𑆳 𑆥𑆑𑇀𑆮𑆩𑆼𑆮 𑆠𑆠𑇀 𑇆𑇒𑇙𑇆
𑆱𑇀𑆮𑆠𑆼𑆘𑆾𑇁𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆢𑇀𑆫𑆴𑆑𑇀𑆠𑆁 𑆩𑆼𑆢𑆾𑇁𑆨𑆴𑆘𑆳𑆪𑆠𑆼𑇅 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆓𑇀𑆤𑇀𑆪𑆤𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆕𑇀𑆔𑆳𑆠𑆂 𑆱𑇀𑆮𑆾𑆰𑇀𑆩𑆟𑆳 𑆑𑆸𑆠𑆂𑇆𑇓𑇐𑇆
𑆒𑆫𑆠𑇀𑆮𑆁 𑆥𑇀𑆫𑆑𑆫𑆾𑆠𑇀𑆪𑆱𑇀𑆪 𑆘𑆳𑆪𑆠𑆼𑇁𑆱𑇀𑆡𑆴 𑆠𑆠𑆾 𑆤𑆸𑆟𑆳𑆩𑇀𑇅 𑆑𑆫𑆾𑆠𑆴 𑆠𑆠𑇀𑆫 𑆱𑆿𑆰𑆴𑆫𑇀𑆪𑆩𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆱𑆩𑆵𑆫𑆟𑆂𑇆𑇓𑇑𑇆
𑆩𑆼𑆢𑆱𑆱𑇀𑆠𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆾 𑆩𑆘𑇀𑆘𑆳 𑆠𑆠𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆘𑇀𑆘𑇀𑆚𑆱𑇀𑆠𑆶 𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼 𑆠𑆠𑆂𑇆𑇓𑇒𑇆
𑆮𑆳𑆪𑇀𑆮𑆳𑆑𑆳𑆯𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆨𑆳𑆮𑆽𑆂 𑆱𑆿𑆰𑆴𑆫𑇀𑆪𑆁 𑆘𑆳𑆪𑆠𑆼𑇁𑆱𑇀𑆡𑆴𑆰𑆶𑇅 𑆠𑆼𑆤 𑆱𑇀𑆫𑆮𑆠𑆴 𑆠𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆁 𑆤𑆮𑆳𑆠𑇀 𑆑𑆶𑆩𑇀𑆨𑆳𑆢𑆴𑆮𑆾𑆢𑆑𑆩𑇀𑇆𑇓𑇓𑇆
𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑆴𑆂 𑆱𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆢𑆼𑆲𑆳𑆠𑇀 𑆱𑆩𑆤𑇀𑆠𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆮𑆳𑆲𑆴𑆨𑆴𑆂 𑇅 𑆲𑆫𑇀𑆰𑆼𑆟𑆾𑆢𑆵𑆫𑆴𑆠𑆁 𑆮𑆼𑆓𑆳𑆠𑇀 𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆳𑆖𑇀𑆖 𑆩𑆤𑆾𑆨𑆮𑆳𑆠𑇀𑇆𑇓𑇔𑇆
𑆮𑆴𑆬𑆵𑆤𑆁 𑆔𑆸𑆠𑆮𑆢𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑆰𑇀𑆩𑆟𑆳 𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆖𑇀𑆪𑆶𑆠𑆩𑇀𑇅 𑆧𑆱𑇀𑆠𑆿 𑆱𑆩𑇀𑆨𑆸𑆠𑇀𑆪 𑆤𑆴𑆫𑇀𑆪𑆳𑆠𑆴 𑆱𑇀𑆡𑆬𑆳𑆤𑇀𑆤𑆴𑆩𑇀𑆤𑆳𑆢𑆴𑆮𑆾𑆢𑆑𑆩𑇀)𑇆𑇓𑇕𑇆
𑆮𑇀𑆪𑆳𑆤𑆼𑆤 𑆫𑆱𑆣𑆳𑆠𑆶𑆫𑇀𑆲𑆴 𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆾𑆖𑆴𑆠𑆑𑆫𑇀𑆩𑆟𑆳𑇅 𑆪𑆶𑆓𑆥𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑆾𑇁𑆘𑆱𑇀𑆫𑆁 𑆢𑆼𑆲𑆼 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆠𑆼 𑆱𑆢𑆳𑇆𑇓𑇖𑇆
𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆩𑆳𑆟𑆂 𑆒𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆳𑆢𑇀𑆫𑆱𑆂 𑆱𑆘𑇀𑆘𑆠𑆴 𑆪𑆠𑇀𑆫 𑆱𑆂𑇅 𑆑𑆫𑆾𑆠𑆴 𑆮𑆴𑆑𑆸𑆠𑆴𑆁 𑆠𑆠𑇀𑆫 𑆒𑆼 𑆮𑆫𑇀𑆰𑆩𑆴𑆮 𑆠𑆾𑆪𑆢𑆂𑇆𑇓𑇗𑇆
𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆥𑆴 𑆖𑆽𑆮𑆁 𑆱𑇀𑆪𑆳𑆢𑆼𑆑𑆢𑆼𑆯𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑇀 𑇅𑇓𑇘𑇅 𑆅𑆠𑆴 𑆨𑆿𑆠𑆴𑆑𑆣𑆳𑆠𑇀𑆮𑆤𑇀𑆤𑆥𑆑𑇀𑆠𑆹𑆟𑆳𑆁 𑆑𑆫𑇀𑆩 𑆨𑆳𑆰𑆴𑆠𑆩𑇀𑇆𑇓𑇘𑇆
𑆃𑆤𑇀𑆤𑆱𑇀𑆪 𑆥𑆑𑇀𑆠𑆳 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆥𑆑𑇀𑆠𑆹𑆟𑆳𑆩𑆣𑆴𑆥𑆾 𑆩𑆠𑆂𑇅 𑆠𑆤𑇀𑆩𑆷𑆬𑆳𑆱𑇀𑆠𑆼 𑆲𑆴 𑆠𑆢𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑆩𑆑𑆳𑆂𑇆𑇓𑇙𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆤𑇀𑆤𑆥𑆳𑆤𑆼𑆤𑇀𑆣𑆤𑆽𑆫𑇀𑆲𑆴𑆠𑆽𑆂𑇅 𑆥𑆳𑆬𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆪𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆱𑇀𑆡𑆴𑆠𑆿 𑆲𑇀𑆪𑆪𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆡𑆴𑆠𑆴𑆂𑇆𑇔𑇐𑇆
𑆪𑆾 𑆲𑆴 𑆨𑆶𑆕𑇀𑆑𑇀𑆠𑆼 𑆮𑆴𑆣𑆴𑆁 𑆠𑇀𑆪𑆳𑆑𑇀𑆠𑇀𑆮𑆳 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆘𑆳𑆤𑇀 𑆓𑆢𑆳𑆤𑇀𑇅 𑆱 𑆬𑆿𑆬𑇀𑆪𑆳𑆬𑇀𑆬𑆨𑆠𑆼 𑆯𑆵𑆔𑇀𑆫𑆁, 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆠𑆂 𑆥𑆫𑆁 𑆠𑆶 𑆠𑆼𑇆𑇔𑇑𑇆
𑆃𑆨𑆾𑆘𑆤𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆳𑆠𑆴𑆨𑆾𑆘𑆤𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆳𑆠𑇀𑇅 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆓𑆶𑆫𑆶𑆯𑆵𑆠𑆳𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆱𑆤𑇀𑆢𑆶𑆰𑇀𑆛𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇆𑇔𑇒𑇆
𑆮𑆴𑆫𑆼𑆑𑆮𑆩𑆤𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆨𑇀𑆫𑆩𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆑𑆫𑇀𑆰𑆟𑆳𑆠𑇀𑇅 𑆢𑆼𑆯𑆑𑆳𑆬𑆫𑇀𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆳𑆢𑇀𑆮𑆼𑆓𑆳𑆤𑆳𑆁 𑆖 𑆮𑆴𑆣𑆳𑆫𑆟𑆳𑆠𑇀𑇆𑇔𑇓𑇆
𑆢𑆶𑆰𑇀𑆪𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆂, 𑆱 𑆢𑆶𑆰𑇀𑆛𑆾𑇁𑆤𑇀𑆤𑆁 𑆤 𑆠𑆠𑇀 𑆥𑆖𑆠𑆴 𑆬𑆔𑇀𑆮𑆥𑆴𑇅 𑆃𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆯𑆶𑆑𑇀𑆠𑆠𑇀𑆮𑆁 𑆪𑆳𑆠𑇀𑆪𑆤𑇀𑆤𑆁 𑆮𑆴𑆰𑆫𑆷𑆥𑆠𑆳𑆩𑇀 𑇆𑇔𑇔𑇆
𑆠𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆩𑆘𑆵𑆫𑇀𑆟𑆱𑇀𑆪 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆂 𑆱𑆢𑆤𑆁 𑆠𑆡𑆳𑇅 𑆯𑆴𑆫𑆱𑆾 𑆫𑆶𑆑𑇀 𑆖 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖 𑆨𑇀𑆫𑆩𑆂 𑆥𑆸𑆰𑇀𑆜𑆑𑆛𑆴𑆓𑇀𑆫𑆲𑆂𑇆𑇔𑇕𑇆
𑆘𑆸𑆩𑇀𑆨𑆳𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆖 𑆘𑇀𑆮𑆫𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆩𑇀𑇅 𑆃𑆫𑆾𑆖𑆑𑆾𑇁𑆮𑆴𑆥𑆳𑆑𑆯𑇀𑆖, 𑆔𑆾𑆫𑆩𑆤𑇀𑆤𑆮𑆴𑆰𑆁 𑆖 𑆠𑆠𑇀𑇆𑇔𑇖𑇆
𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆩𑆳𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆢𑆳𑆲𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆩𑆶𑆒𑆳𑆩𑆪𑆳𑆤𑇀𑇅 𑆘𑆤𑆪𑆠𑇀𑆪𑆩𑇀𑆬𑆥𑆴𑆠𑇀𑆠𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆘𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑇀 𑆓𑆢𑆳𑆤𑇀𑇆𑇔𑇗𑇆
𑆪𑆑𑇀𑆰𑇀𑆩𑆥𑆵𑆤𑆱𑆩𑆼𑆲𑆳𑆢𑆵𑆤𑇀 𑆑𑆦𑆘𑆳𑆤𑇀 𑆑𑆦𑆱𑆕𑇀𑆓𑆠𑆩𑇀𑇅 𑆑𑆫𑆾𑆠𑆴 𑆮𑆳𑆠𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆮𑆳𑆠𑆘𑆳𑆁𑆯𑇀𑆖 𑆓𑆢𑆳𑆤𑇀 𑆧𑆲𑆷𑆤𑇀𑇆𑇔𑇘𑇆

𑆯𑇀𑆮𑆯𑆸𑆓𑆳𑆬𑆠𑆫𑆑𑇀𑆰𑇀𑆮𑆸𑆑𑇀𑆰𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆢𑆳𑇁𑆤𑆴𑆬𑆂 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆾 𑆩𑆶𑆰𑇀𑆟𑆳𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆮𑆲𑆳𑆯𑇀𑆫𑆴𑆠𑆂 𑇆𑇔𑇓𑇆
𑆠𑆢𑆳 𑆥𑇀𑆫𑆱𑇀𑆫𑆱𑇀𑆠𑆬𑆳𑆕𑇀𑆓𑆷𑆬𑆲𑆤𑆶𑆱𑇀𑆑𑆤𑇀𑆣𑆾𑇁𑆠𑆴𑆬𑆳𑆬𑆮𑆳𑆤𑇀 𑇅 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆧𑆣𑆴𑆫𑆾𑇁𑆤𑇀𑆣𑆯𑇀𑆖 𑆱𑆾𑇁𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆩𑆨𑆴𑆣𑆳𑆮𑆠𑆴 𑇆𑇔𑇔𑇆
𑆠𑆼𑆤𑆾𑆤𑇀𑆩𑆠𑇀𑆠𑆼𑆤 𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆴𑆟𑆳 𑆱𑆮𑆴𑆰𑆼𑆟 𑆠𑆶 𑇅 𑆱𑆶𑆥𑇀𑆠𑆠𑆳 𑆘𑆳𑆪𑆠𑆼 𑆢𑆁𑆯𑆼 𑆑𑆸𑆰𑇀𑆟𑆁 𑆖𑆳𑆠𑆴𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆱𑆸𑆑𑇀 𑇆𑇔𑇕𑇆
𑆢𑆴𑆓𑇀𑆣𑆮𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆼𑆤 𑆥𑇀𑆫𑆳𑆪𑆯𑆯𑇀𑆖𑆾𑆥𑆬𑆑𑇀𑆰𑆴𑆠𑆂 𑇅 𑆪𑆼𑆤 𑆖𑆳𑆥𑆴 𑆨𑆮𑆼𑆢𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆠𑆱𑇀𑆪 𑆖𑆼𑆰𑇀𑆛𑆳𑆁 𑆫𑆶𑆠𑆁 𑆤𑆫𑆂 𑇆𑇔𑇖𑇆
𑆧𑆲𑆶𑆯𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆳𑆟𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆲𑆵𑆤𑆾 𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑆴 𑇅 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆴𑆟𑆳 𑆪𑆼𑆤 𑆢𑆰𑇀𑆛𑆯𑇀𑆖 𑆠𑆢𑇀𑆫𑆷𑆥𑆁 𑆪𑆱𑇀𑆠𑆶 𑆥𑆯𑇀𑆪𑆠𑆴 𑇆𑇔𑇗𑇆
𑆃𑆥𑇀𑆱𑆶 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳𑇁𑇁𑆢𑆫𑇀𑆯𑆼𑇁𑆫𑆴𑆰𑇀𑆛𑆁 𑆠𑆱𑇀𑆪 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆠𑇀𑆫𑆱𑇀𑆪𑆠𑇀𑆪𑆑𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆾𑇁𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆥𑆴 𑆮𑆳 𑆘𑆬𑆩𑇀 𑇆𑇔𑇘𑇆
𑆘𑆬𑆠𑇀𑆫𑆳𑆱𑆁 𑆠𑆶 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆁 𑆫𑆴𑆰𑇀𑆛𑆁 𑆠𑆢𑆥𑆴 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆃𑆢𑆰𑇀𑆛𑆾 𑆮𑆳 𑆘𑆬𑆠𑇀𑆫𑆳𑆱𑆵 𑆤 𑆑𑆡𑆚𑇀𑆖𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑇆𑇔𑇙𑇆
𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆾𑇁𑆡𑆾𑆠𑇀𑆡𑆴𑆠𑆾 𑆮𑆳𑇁𑆥𑆴 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆠𑇀𑆫𑆱𑇀𑆠𑆾 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑇅 𑆢𑆁𑆯𑆁 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆠𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆥𑆫𑆴𑆢𑆳𑆲𑆴𑆠𑆩𑇀 𑇆𑇕𑇐𑇆
𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪𑆳𑆢𑆓𑆢𑆽𑆂, 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆶𑆫𑆳𑆟𑆁 𑆥𑆳𑆪𑆪𑆼𑆠 𑆖 𑇅 𑆃𑆫𑇀𑆑𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆠𑆁 𑆲𑇀𑆪𑆱𑇀𑆪 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆥𑆴 𑆮𑆴𑆯𑆾𑆣𑆤𑆩𑇀 𑇆𑇕𑇑𑇆
𑆯𑇀𑆮𑆼𑆠𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆁 𑆖𑆳𑆱𑇀𑆪 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆣𑆠𑇀𑆠𑆷𑆫𑆑𑆳𑆪𑆶𑆠𑆳𑆩𑇀 𑇅 𑆥𑆬𑆬𑆁 𑆠𑆴𑆬𑆠𑆽𑆬𑆁 𑆖 𑆫𑆷𑆥𑆴𑆑𑆳𑆪𑆳𑆂 𑆥𑆪𑆾 𑆓𑆶𑆝𑆂 𑇆𑇕𑇒𑇆
𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆮𑆴𑆰𑆩𑆳𑆬𑆫𑇀𑆑𑆁 𑆩𑆼𑆔𑆮𑆸𑆤𑇀𑆢𑆩𑆴𑆮𑆳𑆤𑆴𑆬𑆂 𑇅 𑆩𑆷𑆬𑆱𑇀𑆪 𑆯𑆫𑆥𑆶𑆕𑇀𑆒𑆳𑆪𑆳𑆂 𑆑𑆫𑇀𑆰𑆁 𑆣𑆠𑇀𑆠𑆷𑆫𑆑𑆳𑆫𑇀𑆣𑆴𑆑𑆩𑇀 𑇆𑇕𑇓𑇆
𑆠𑆟𑇀𑆝𑆶𑆬𑆾𑆢𑆑𑆩𑆳𑆢𑆳𑆪 𑆥𑆼𑆰𑆪𑆼𑆠𑇀𑆠𑆟𑇀𑆝𑆶𑆬𑆽𑆂 𑆱𑆲 𑇅 𑆇𑆤𑇀𑆩𑆠𑇀𑆠𑆑𑆱𑇀𑆪 𑆥𑆠𑇀𑆫𑆽𑆱𑇀𑆠𑆶 𑆱𑆁𑆮𑆼𑆰𑇀𑆛𑇀𑆪𑆳𑆥𑆷𑆥𑆑𑆁 𑆥𑆖𑆼𑆠𑇀 𑇆𑇕𑇔𑇆
𑆒𑆳𑆢𑆼𑆢𑆿𑆰𑆣𑆑𑆳𑆬𑆼 𑆠𑆩𑆬𑆫𑇀𑆑𑆮𑆴𑆰𑆢𑆷𑆰𑆴𑆠𑆂 𑇅 𑆑𑆫𑆾𑆠𑆴 𑆯𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆱𑇀𑆠𑆶 𑆠𑆱𑇀𑆩𑆴𑆚𑇀𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑆖𑆿𑆰𑆣𑆼 𑇆𑇕𑇕𑇆
𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆯𑆴𑆯𑆴𑆫𑆼 𑆪𑆳𑆥𑇀𑆪𑆳 𑆓𑆸𑆲𑆼 𑆮𑆳𑆫𑆴𑆮𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆼 𑇅 𑆠𑆠𑆂 𑆯𑆳𑆤𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆱𑇀𑆠𑆶 𑆱𑇀𑆤𑆳𑆠𑇀𑆮𑆳 𑆖𑆽𑆮𑆳𑆥𑆫𑆼𑇁𑆲𑆤𑆴 𑇆𑇕𑇖𑇆
𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆾𑆫𑇀𑆨𑆑𑇀𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆾𑆰𑇀𑆟𑆼𑆤 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆢𑆴𑆤𑆠𑇀𑆫𑆪𑆼 𑆥𑆚𑇀𑆖𑆩𑆼 𑆮𑆳 𑆮𑆴𑆣𑆴𑆫𑆼𑆰𑆾𑇁𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑇆𑇕𑇗𑇆
𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆾 𑆨𑆴𑆰𑆘𑆳𑇁𑆮𑆯𑇀𑆪𑆩𑆬𑆫𑇀𑆑𑆮𑆴𑆰𑆤𑆳𑆯𑆤𑆂 𑇅 𑆑𑆶𑆥𑇀𑆪𑆼𑆠𑇀 𑆱𑇀𑆮𑆪𑆁 𑆮𑆴𑆰𑆁 𑆪𑆱𑇀𑆪 𑆤 𑆱 𑆘𑆵𑆮𑆠𑆴 𑆩𑆳𑆤𑆮𑆂 𑇆𑇕𑇘𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆼𑆢𑆳𑆯𑆶 𑆱𑇀𑆮𑆪𑆁 𑆪𑆳𑆮𑆠𑇀 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆴 𑇅 𑆧𑆵𑆘𑆫𑆠𑇀𑆤𑆿𑆰𑆣𑆵𑆓𑆫𑇀𑆨𑆽𑆂 𑆑𑆶𑆩𑇀𑆨𑆽𑆂 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆥𑆷𑆫𑆴𑆠𑆽𑆂 𑇆𑇕𑇙𑇆
𑆱𑇀𑆤𑆳𑆥𑆪𑆼𑆠𑇀𑆠𑆁 𑆤𑆢𑆵𑆠𑆵𑆫𑆼 𑆱𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆼 𑇅 𑆧𑆬𑆴𑆁 𑆤𑆴𑆮𑆼𑆢𑇀𑆪 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆁 𑆥𑆬𑆬𑆁 𑆢𑆣𑆴 𑇆𑇖𑇐𑇆
𑆃𑆬𑆫𑇀𑆑𑆘𑆶𑆰𑇀𑆛𑆩𑆼𑆠𑆤𑇀𑆩𑆼 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆁 𑆑𑆶𑆫𑆶 𑆩𑆳𑆖𑆴𑆫𑆳𑆠𑇀 𑇅 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆼𑆮𑆁 𑆱𑇀𑆤𑆳𑆠𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇆𑇖𑇒𑇆
𑆃𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑆶𑆫𑆷𑆞𑆼𑇁𑆥𑆴 𑆮𑇀𑆫𑆟𑆼 𑆑𑆶𑆥𑇀𑆪𑆠𑆴 𑆠𑆢𑇀𑆮𑆴𑆰𑆩𑇀 𑇅 𑆯𑇀𑆮𑆳𑆢𑆪𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆳 𑆮𑇀𑆪𑆳𑆬𑆳 𑆪𑆼𑇁𑆠𑇀𑆫 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆴𑆰𑆳 𑆩𑆪𑆳 𑇆𑇖𑇓𑇆
𑆃𑆠𑆂 𑆑𑆫𑆾𑆠𑆴 𑆢𑆰𑇀𑆛𑆱𑇀𑆠𑆶 𑆠𑆼𑆰𑆳𑆁 𑆖𑆼𑆰𑇀𑆛𑆳𑆁 𑆫𑆶𑆠𑆁 𑆤𑆫𑆂 𑇅 𑆧𑆲𑆶𑆯𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆳𑆟𑆾 𑆤 𑆖𑆴𑆫𑆳𑆤𑇀𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆖 𑆱𑆂 𑇆𑇖𑇔𑇆
𑆤𑆒𑆢𑆤𑇀𑆠𑆑𑇀𑆰𑆠𑆁 𑆮𑇀𑆪𑆳𑆬𑆽𑆫𑇀𑆪𑆠𑇀𑆑𑆸𑆠𑆁 𑆠𑆢𑇀𑆮𑆴𑆩𑆫𑇀𑆢𑆪𑆼𑆠𑇀 𑇅 𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀𑆠𑆽𑆬𑆼𑆤 𑆑𑆾𑆰𑇀𑆟𑆼𑆤 𑆠𑆼 𑆲𑆴 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆑𑆳𑆂 𑇆𑇖𑇕𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆵𑆛𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆

𑆥𑇀𑆬𑆵𑆲𑆯𑆾𑆰𑆳𑆮𑆥𑆱𑇀𑆩𑆳𑆫𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆁 𑆖 𑆥𑇀𑆫𑆟𑆳𑆯𑆪𑆼𑆠𑇀𑇅 𑆧𑆬𑆳𑆠𑆽𑆬𑆩𑆴𑆢𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇑𑇕𑇖𑇆
(𑆃𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆳𑆪 𑆓𑆶𑆫𑆶𑆟𑆳 𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆨𑆳𑆰𑆴𑆠𑆩𑇀)𑇅 𑆅𑆠𑆴 𑆧𑆬𑆳𑆠𑆽𑆬𑆩𑇀𑇅 𑆃𑆩𑆸𑆠𑆳𑆪𑆳𑆱𑇀𑆠𑆶𑆬𑆳𑆂 𑆥𑆚𑇀𑆖 𑆢𑇀𑆫𑆾𑆟𑆼𑆰𑇀𑆮𑆰𑇀𑆛𑆱𑇀𑆮𑆥𑆳𑆁 𑆥𑆖𑆼𑆠𑇀𑇆𑇑𑇕𑇗𑇆
𑆥𑆳𑆢𑆯𑆼𑆰𑆼 𑆱𑆩𑆑𑇀𑆰𑆵𑆫𑆁 𑆠𑆽𑆬𑆱𑇀𑆪 𑆢𑇀𑆮𑇀𑆪𑆳𑆞𑆑𑆁 𑆥𑆖𑆼𑆠𑇀𑇅 𑆍𑆬𑆳𑆩𑆳𑆁𑆱𑆵𑆤𑆠𑆾𑆯𑆵𑆫𑆱𑆳𑆫𑆴𑆮𑆳𑆑𑆶𑆰𑇀𑆜𑆖𑆤𑇀𑆢𑆤𑆽𑆂𑇆𑇑𑇕𑇘𑇆
𑆧𑆬𑆳𑆠𑆳𑆩𑆬𑆑𑆵𑆩𑆼𑆢𑆳𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆫𑇀𑆣𑆴𑆘𑆵𑆮𑆑𑆽𑆂 𑇅 𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆯𑇀𑆫𑆳𑆮𑆟𑇀𑆪𑆠𑆴𑆧𑆬𑆳𑆤𑆒𑆽𑆂𑇆𑇑𑇕𑇙𑇆
𑆩𑆲𑆳𑆯𑇀𑆫𑆳𑆮𑆟𑆴𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑆥𑆴𑆑𑆖𑇀𑆗𑆶𑆨𑆴𑆂𑇅 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑆲𑆳𑆩𑆼𑆢𑆳𑆑𑆫𑇀𑆑𑆛𑆳𑆒𑇀𑆪𑆳𑆲𑆫𑆼𑆟𑆶𑆨𑆴𑆂𑇆𑇑𑇖𑇐𑇆
𑆮𑆖𑆳𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆽𑆫𑆟𑇀𑆝𑆫𑆳𑆱𑇀𑆤𑆳𑆑𑆳𑆬𑆳𑆱𑆲𑆳𑆖𑆫𑆽𑆂𑇅 𑆮𑆵𑆫𑆳𑆯𑆬𑇀𑆬𑆑𑆴𑆩𑆶𑆱𑇀𑆠𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆫𑇀𑆰𑆨𑆑𑆧𑆳𑆬𑆑𑆽𑆂𑇆𑇑𑇖𑇑𑇆
𑆱𑆲𑆽𑆬𑆳𑆑𑆶𑆕𑇀𑆑𑆶𑆩𑆱𑇀𑆥𑆸𑆑𑇀𑆑𑆳𑆠𑇀𑆫𑆴𑆢𑆯𑆳𑆲𑇀𑆮𑆽𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆽𑆂𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆫𑇀𑆰𑆼𑆟 𑆩𑆣𑆶𑆑𑆳𑆰𑇀𑆛𑆥𑆬𑆼𑆤 𑆖𑇆𑇑𑇖𑇒𑇆
𑆑𑆬𑇀𑆑𑆽𑆱𑇀𑆠𑆠𑇀 𑆑𑇀𑆰𑆵𑆟𑆮𑆵𑆫𑇀𑆪𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆱𑆩𑇀𑆩𑆷𑆞𑆖𑆼𑆠𑆱𑆂𑇅 𑆇𑆤𑇀𑆩𑆳𑆢𑆳𑆫𑆠𑇀𑆪𑆥𑆱𑇀𑆩𑆳𑆫𑆽𑆫𑆳𑆫𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆤𑆪𑆼𑆠𑇀𑇆𑇑𑇖𑇓𑇆
𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆲𑆫𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆠𑆽𑆬𑆳𑆓𑇀𑆫𑇀𑆪𑆩𑆩𑆸𑆠𑆳𑆲𑇀𑆮𑆪𑆩𑇀𑇅 (𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆓𑆶𑆫𑆶𑆟𑆳 𑆨𑆳𑆰𑆴𑆠𑆁 𑆮𑆽𑆢𑇀𑆪𑆥𑆷𑆘𑆴𑆠𑆩𑇀)𑇆𑇑𑇖𑇔𑇆
𑆅𑆠𑇀𑆪𑆩𑆸𑆠𑆳𑆢𑇀𑆪𑆁 𑆠𑆽𑆬𑆩𑇀𑇅 𑆫𑆳𑆱𑇀𑆤𑆳𑆱𑆲𑆱𑇀𑆫𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆠𑆽𑆬𑆢𑇀𑆫𑆾𑆟𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇅 𑆓𑆤𑇀𑆣𑆽𑆫𑇀𑆲𑆽𑆩𑆮𑆠𑆽𑆂 𑆥𑆴𑆰𑇀𑆛𑆽𑆫𑆼𑆬𑆳𑆢𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆤𑆴𑆬𑆳𑆫𑇀𑆠𑆴𑆤𑆶𑆠𑇀𑇆𑇑𑇖𑇕𑇆
𑆑𑆬𑇀𑆥𑆾𑇁𑆪𑆩𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆪𑆳𑆁 𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑇀𑆪𑆳𑆁 𑆧𑆬𑆳𑆢𑇀𑆮𑆪𑆼𑇅 𑆑𑇀𑆮𑆳𑆡𑆑𑆬𑇀𑆑𑆥𑆪𑆾𑆨𑆴𑆫𑇀𑆮𑆳 𑆧𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆖𑆼𑆠𑇀 𑆥𑆸𑆡𑆑𑇀𑇆𑇑𑇖𑇖𑇆
𑆅𑆠𑆴 𑆫𑆳𑆱𑇀𑆤𑆳𑆠𑆽𑆬𑆩𑇀𑇅 𑆩𑆷𑆬𑆑𑆱𑇀𑆮𑆫𑆱𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆠𑆽𑆬𑆁 𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆩𑇀𑇅 𑆠𑆶𑆬𑇀𑆪𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀 𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆧𑆬𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂𑇆𑇑𑇖𑇗𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆠𑆴𑆮𑆴𑆰𑆳𑆫𑆳𑆱𑇀𑆤𑆳𑆖𑆮𑆴𑆑𑆳𑆓𑆶𑆫𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆽𑆂𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆖𑆳𑆑𑆶𑆰𑇀𑆜𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆴𑆯𑇀𑆮𑆨𑆼𑆰𑆘𑆽𑆂𑇆𑇑𑇖𑇘𑇆
𑆥𑆶𑆰𑇀𑆑𑆫𑆳𑆲𑇀𑆮𑆯𑆛𑆵𑆧𑆴𑆬𑇀𑆮𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆤𑆠𑆢𑆳𑆫𑆶𑆨𑆴𑆂𑇅 𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆵𑆠𑆩𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆳𑆤𑇀 𑆲𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑇀 𑆓𑆢𑆳𑆤𑇀𑇆𑇑𑇖𑇙𑇆
𑆅𑆠𑆴 𑆩𑆷𑆬𑆑𑆳𑆢𑇀𑆪𑆁 𑆠𑆽𑆬𑆩𑇀𑇅 𑆮𑆸𑆰𑆩𑆷𑆬𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆾𑆯𑇀𑆖 𑆢𑇀𑆮𑆴𑆯𑆠𑆱𑇀𑆪 𑆯𑆠𑆱𑇀𑆪 𑆖𑇅 𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆠𑇀 𑆱𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆖𑇀𑆖 𑆑𑇀𑆮𑆳𑆡𑆼 𑆠𑆽𑆬𑆳𑆞𑆑𑆁 𑆥𑆖𑆼𑆠𑇀𑇆𑇑𑇗𑇐𑇆
𑆱𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆳𑆪𑆶𑆤𑆳 𑆨𑆓𑇀𑆤𑆼 𑆢𑆢𑇀𑆪𑆳𑆘𑇀𑆘𑆫𑇀𑆘𑆫𑆴𑆠𑆼 𑆠𑆡𑆳𑇅 𑆥𑇀𑆫𑆳𑆑𑇀𑆠𑆽𑆬𑆳𑆮𑆳𑆥𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆨𑆮𑆼𑆢𑆼𑆠𑆢𑇀𑆓𑆶𑆟𑆾𑆠𑇀𑆠𑆫𑆩𑇀𑇆𑇑𑇗𑇑𑇆
𑆅𑆠𑆴 𑆮𑆸𑆰𑆩𑆷𑆬𑆳𑆢𑆴𑆠𑆽𑆬𑆩𑇀𑇅 𑆫𑆳𑆱𑇀𑆤𑆳𑆯𑆴𑆫𑆵𑆰𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆯𑆶𑆟𑇀𑆜𑆵𑆱𑆲𑆖𑆫𑆳𑆩𑆸𑆠𑆳𑆂𑇆𑇑𑇗𑇒𑇆
𑆱𑇀𑆪𑆾𑆤𑆳𑆑𑆢𑆳𑆫𑆶𑆯𑆩𑇀𑆥𑆳𑆑𑆲𑆪𑆓𑆤𑇀𑆣𑆳𑆠𑇀𑆫𑆴𑆑𑆟𑇀𑆛𑆑𑆳𑆂𑇅 𑆍𑆰𑆳𑆁 𑆢𑆯𑆥𑆬𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆤𑇀 𑆑𑆰𑆳𑆪𑆩𑆶𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇗𑇓𑇆
𑆠𑆠𑆱𑇀𑆠𑆼𑆤 𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆽𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆽𑆂𑇅 𑆢𑆣𑇀𑆪𑆳𑆫𑆤𑆳𑆬𑆩𑆳𑆰𑆳𑆩𑇀𑆧𑆶𑆩𑆷𑆬𑆑𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆽𑆂 𑆯𑆶𑆨𑆽𑆂𑇆𑇑𑇗𑇔𑇆
𑆥𑆸𑆡𑆑𑇀 𑆥𑇀𑆫𑆱𑇀𑆡𑆾𑆤𑇀𑆩𑆴𑆠𑆽𑆂 𑆱𑆳𑆫𑇀𑆣𑆁 𑆠𑆽𑆬𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇅 𑆥𑇀𑆬𑆵𑆲𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆩𑆳𑆫𑆶𑆠𑆫𑆾𑆓𑆤𑆶𑆠𑇀 𑇆𑇑𑇗𑇕𑇆
𑆍𑆠𑆤𑇀𑆩𑆷𑆬𑆑𑆠𑆽𑆬𑆳𑆒𑇀𑆪𑆁 𑆮𑆫𑇀𑆟𑆳𑆪𑆶𑆫𑇀𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇅 𑆅𑆠𑆴 𑆩𑆷𑆬𑆑𑆠𑆽𑆬𑆩𑇀𑇅 𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆁 𑆯𑆴𑆓𑇀𑆫𑆶𑆧𑆴𑆬𑇀𑆮𑆪𑆾𑆂𑇅 𑆫𑆱𑆼𑆤 𑆩𑆷𑆬𑆑𑆳𑆤𑆳𑆁 𑆖 𑆠𑆽𑆬𑆁 𑆢𑆣𑆴𑆥𑆪𑆾𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇆𑇑𑇗𑇖𑇆
𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆴𑆰𑆓𑇀𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆮𑆳𑆠𑆳𑆩𑆪𑆳𑆥𑆲𑆩𑇀𑇅 𑆬𑆯𑆶𑆤𑆱𑇀𑆮𑆫𑆱𑆼 𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆩𑆼𑆨𑆴𑆯𑇀𑆖 𑆮𑆳𑆠𑆤𑆶𑆠𑇀𑇆𑇑𑇗𑇗𑇆

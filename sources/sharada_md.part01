𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆮𑆑𑇀𑆠𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆩𑆬𑆳𑆥𑆲𑆩𑇀 𑇅 𑆑𑆰𑆳𑆪𑆩𑆵𑆰𑆤𑇀𑆩𑆣𑆶𑆫𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆥𑆷𑆓𑆦𑆬𑆁 𑆱𑆫𑆩𑇀 𑇆𑇒𑇐𑇑𑇆
𑆘𑆳𑆠𑆵𑆑𑆾𑆯𑆾𑇁𑆡 𑆑𑆫𑇀𑆥𑆷𑆫𑆁 𑆘𑆳𑆠𑆵𑆑𑆛𑆶𑆑𑆪𑆾𑆂 𑆦𑆬𑆩𑇀 𑇅 𑆑𑆑𑇀𑆑𑆾(𑆕𑇀𑆑𑆾)𑆬𑆑𑆁 𑆬𑆮𑆕𑇀𑆓𑆁 𑆖 𑆠𑆴𑆑𑇀𑆠𑆁 𑆑𑆛𑆶 𑆑𑆦𑆳𑆥𑆲𑆩𑇀 𑇆𑇒𑇐𑇒𑇆
𑆬𑆔𑆶 𑆠𑆸𑆰𑇀𑆟𑆳𑆥𑆲𑆁 𑆮𑆑𑇀𑆠𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆤𑆳𑆯𑆤𑆩𑇀 𑇅 𑆱𑆠𑆴𑆑𑇀𑆠𑆂 𑆱𑆶𑆫𑆨𑆴𑆂 𑆯𑆵𑆠𑆂 𑆑𑆫𑇀𑆥𑆷𑆫𑆾 𑆬𑆔𑆶 𑆬𑆼𑆒𑆤𑆂 𑇆𑇒𑇐𑇓𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆪𑆳𑆁 𑆩𑆶𑆒𑆯𑆾𑆰𑆼 𑆖 𑆮𑆽𑆫𑆱𑇀𑆪𑆼 𑆖𑆳𑆥𑆴 𑆥𑆷𑆘𑆴𑆠𑆂 𑇅 𑆬𑆠𑆳𑆑𑆱𑇀𑆠𑆷𑆫𑆴𑆑𑆳 𑆠𑆢𑇀𑆮𑆖𑇀𑆗𑆵𑆠𑆳 𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆯𑆾𑆣𑆤𑆵 𑇆𑇒𑇐𑇔𑇆
𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆩𑆘𑇀𑆘𑆳 𑆩𑆣𑆶𑆫𑆾 𑆮𑆸𑆰𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇅 𑆧𑆽𑆨𑆵𑆠𑆑𑆾 𑆩𑆢𑆑𑆫𑆂 𑆑𑆦𑆩𑆳𑆫𑆶𑆠𑆤𑆳𑆯𑆤𑆂 𑇆𑇒𑇐𑇕𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆾 𑆩𑆘𑇀𑆘𑆳 𑆑𑆾𑆬𑆳𑆤𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆤𑆂 𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆤𑆴𑆬𑆔𑇀𑆤𑆯𑇀𑆖 𑆠𑆢𑇀𑆮𑆢𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆖 𑇆𑇒𑇐𑇖𑇆
𑆧𑆵𑆘𑆥𑆷𑆫𑆑𑆯𑆩𑇀𑆪𑆳𑆑𑆩𑆘𑇀𑆘𑆳 𑆑𑆾𑆯𑆳𑆩𑇀𑆫𑆱𑆩𑇀𑆨𑆮𑆂 𑇅 𑆱𑇀𑆮𑆳𑆢𑆶𑆥𑆳𑆑𑆾𑇁𑆓𑇀𑆤𑆴𑆧𑆬𑆢𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇆𑇒𑇐𑇗𑇆
𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆦𑆬𑆱𑇀𑆪𑆼𑆲 𑆮𑆵𑆫𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 𑆪𑆳𑆢𑆸𑆯𑆩𑇀 𑇅 𑆠𑆱𑇀𑆪 𑆠𑆱𑇀𑆪𑆽𑆮 𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆩𑆘𑇀𑆘𑆳𑆤𑆩𑆥𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇐𑇘𑇆
𑆦𑆬𑆼𑆰𑆶 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆁 𑆪𑆢𑇀𑆓𑆶𑆟𑆮𑆠𑇀𑆠𑆢𑆶𑆢𑆳𑆲𑆸𑆠𑆩𑇀 𑇅 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆩𑆳𑆩𑆁 𑆠𑆢𑇀𑆣𑆴 𑆓𑆶𑆟𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇅 𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆢𑆵𑆥𑆤𑆁 𑆠𑆢𑇀𑆣𑆴 𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆩𑇀 𑇆𑇒𑇐𑇙𑇆
𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆁 𑆑𑆸𑆩𑆴𑆘𑆶𑆰𑇀𑆛𑆁 𑆖 𑆥𑆳𑆑𑆳𑆠𑆵𑆠𑆩𑆑𑆳𑆬𑆘𑆩𑇀 𑇅 𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆁 𑆦𑆬𑆁 𑆱𑆫𑇀𑆮𑆩𑆥𑆫𑇀𑆪𑆳𑆓𑆠𑆩𑆼𑆮 𑆖 𑇆𑇒𑇑𑇐𑇆
𑆅𑆠𑆴 𑆦𑆬𑆮𑆫𑇀𑆓𑆂 𑇅 𑆃𑆡 𑆯𑆳𑆑𑆮𑆫𑇀𑆓𑆂 𑇅 𑆯𑆳𑆑𑆳𑆤𑇀𑆪𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆳𑆬𑆳𑆧𑆶𑆑𑆳𑆬𑆴𑆤𑇀𑆢𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑇆𑇒𑇑𑇑𑇆
𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆤𑇀𑆪𑆤𑆴𑆬𑆁 𑆑𑆶𑆫𑇀𑆪𑆶𑆱𑇀𑆠𑆡𑆳 𑆩𑆤𑇀𑆢𑆑𑆦𑆳𑆤𑆴 𑆖 𑇅 𑆱𑆸𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆱𑇀𑆮𑆳𑆢𑆶𑆥𑆳𑆑𑆫𑆱𑆳𑆤𑆴 𑆖 𑇆𑇒𑇑𑇒𑇆
𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆁 𑆠𑆼𑆰𑆶 𑆑𑆷𑆰𑇀𑆩𑆳𑆟𑇀𑆝𑆁 𑆧𑆳𑆬𑆁 𑆩𑆣𑇀𑆪𑆁 𑆑𑆦𑆳𑆮𑆲𑆩𑇀 𑇅 𑆯𑆶𑆑𑇀𑆬𑆁 𑆬𑆔𑆷𑆰𑇀𑆟𑆁 𑆱𑆑𑇀𑆰𑆳𑆫𑆁 𑆢𑆵𑆥𑆤𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑆾𑆣𑆤𑆩𑇀 𑇆𑇒𑇑𑇓𑇆
𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆲𑆫𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆥𑆡𑇀𑆪𑆁 𑆖𑆼𑆠𑆾𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆑𑆫𑆁 𑆑𑆳𑆬𑆴𑆤𑇀𑆢𑆁 𑆑𑆦𑆮𑆳𑆠𑆑𑆸𑆠𑇀 𑇆𑇒𑇑𑇔𑇆
𑆃𑆬𑆳𑆧𑆶𑆫𑇀𑆨𑆴𑆤𑇀𑆤𑆮𑆴𑆛𑇀𑆑𑆳 𑆠𑆶 𑆫𑆷𑆑𑇀𑆰𑆳 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆠𑆴𑆯𑆵𑆠𑆬𑆳 𑇅 𑆠𑆴𑆑𑇀𑆠𑆳𑆬𑆳𑆧𑆶𑆫𑆲𑆸𑆢𑇀𑆪𑆳 𑆠𑆶 𑆮𑆳𑆩𑆴𑆤𑆵 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑆴𑆠𑇀 𑇆𑇒𑇑𑇕𑇆
𑆠𑇀𑆫𑆥𑆶𑆱𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆫𑇀𑆑𑆳𑆫𑆶𑆑𑆯𑆵𑆫𑇀𑆟𑆮𑆸𑆤𑇀𑆠𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑇆𑇒𑇑𑇖𑇆
𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆫𑆱𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆂 𑆑𑆦𑆮𑆳𑆠𑆑𑆫𑆳𑆟𑆴 𑆖 𑇅 𑆱𑆸𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆳𑆟𑆴 𑆖 𑇆𑇒𑇑𑇗𑇆
𑆧𑆳𑆬𑆁 𑆱𑆤𑆵𑆬𑆁 𑆠𑇀𑆫𑆥𑆶𑆱𑆁 𑆠𑆼𑆰𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶 𑆑𑆦𑆑𑆸𑆘𑇀𑆘𑆵𑆫𑇀𑆟𑆩𑆩𑇀𑆬𑆁 𑆮𑆳𑆠𑆑𑆦𑆳𑆥𑆲𑆩𑇀 𑇆𑇒𑇑𑇘𑇆
𑆍𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆁 𑆱𑆑𑆫𑇀𑆑𑆳𑆫𑆶 𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆁 𑆑𑆦𑆮𑆳𑆠𑆑𑆸𑆠𑇀 𑇅 𑆱𑆑𑇀𑆰𑆳𑆫𑆁 𑆩𑆣𑆶𑆫𑆁 𑆫𑆶𑆖𑇀𑆪𑆁 𑆢𑆵𑆥𑆤𑆁 𑆤𑆳𑆠𑆴𑆥𑆴𑆠𑇀𑆠𑆬𑆩𑇀 𑇆𑇒𑇑𑇙𑇆
𑆱𑆑𑇀𑆰𑆳𑆫𑆁 𑆩𑆣𑆶𑆫𑆁 𑆖𑆽𑆮 𑆯𑆵𑆫𑇀𑆟𑆮𑆸𑆤𑇀𑆠𑆁 𑆑𑆦𑆳𑆥𑆲𑆩𑇀 𑇅 𑆨𑆼𑆢𑆤𑆁 𑆢𑆵𑆥𑆤𑆁 𑆲𑆸𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆲𑆳𑆰𑇀𑆜𑆵𑆬𑆤𑆶𑆬𑇀𑆬𑆔𑆶 𑇆𑇒𑇒𑇐𑇆

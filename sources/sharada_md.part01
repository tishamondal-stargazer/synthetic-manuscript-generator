𑆘𑆴𑆲𑇀𑆮𑆳𑆯𑆾𑆦𑆾 𑆨𑆾𑆘𑆤𑆱𑇀𑆪𑆳𑆮𑆫𑆾𑆣𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖𑆾𑆓𑇀𑆫𑆳 𑆩𑆣𑇀𑆪𑆮𑆵𑆫𑇀𑆪𑆳𑆨𑆴𑆢𑆰𑇀𑆛𑆼 𑇅𑇖𑇓𑇅 𑆯𑇀𑆮𑆼𑆠𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆂 𑆯𑇀𑆪𑆳𑆩𑆬𑆾 𑆬𑆾𑆲𑆴𑆠𑆳𑆨𑆾 𑆫𑆑𑇀𑆠𑆂 𑆯𑇀𑆮𑆼𑆠𑆾 𑆫𑆑𑇀𑆠𑆤𑆵𑆬𑆾𑆢𑆫𑆿 𑆖 𑇆𑇖𑇓𑇆
𑆥𑆵𑆠𑆾𑇁𑆫𑆑𑇀𑆠𑆾 𑆤𑆵𑆬𑆥𑆵𑆠𑆾𑇁𑆥𑆫𑆱𑇀𑆠𑆶 𑆫𑆑𑇀𑆠𑆾 𑆤𑆵𑆬𑆾 𑆤𑆵𑆬𑆯𑆶𑆑𑇀𑆬𑆱𑇀𑆠𑆡𑆳 𑆖 𑇅 𑆫𑆑𑇀𑆠𑆾 𑆧𑆨𑇀𑆫𑆶𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆖𑇀𑆖𑆽𑆑𑆥𑆫𑇀𑆮𑆳 𑆪𑆯𑇀𑆖𑆳𑆥𑆫𑇀𑆮𑆳 𑆥𑆫𑇀𑆮𑆟𑆵 𑆢𑇀𑆮𑆼 𑆖 𑆪𑆱𑇀𑆪 𑇆𑇖𑇔𑇆
𑆤𑆳𑆤𑆳𑆫𑆷𑆥𑆳 𑆮𑆫𑇀𑆟𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆔𑆾𑆫𑆳 𑆘𑇀𑆚𑆼𑆪𑆳𑆯𑇀𑆖𑆽𑆠𑆼 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆖𑆿𑆫𑆳𑆂 𑇅 𑆘𑆤𑇀𑆩𑆽𑆠𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆥𑆑𑆾𑆡𑆳𑆠𑇀 𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆁 𑆢𑆼𑆲𑆼𑆨𑇀𑆪𑆾 𑆮𑆳 𑆔𑆳𑆠𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆰𑆼𑆟 𑇆𑇖𑇕𑇆
𑆍𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆱𑆫𑇀𑆥𑆮𑆼𑆓𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆦𑆾𑆛𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆢𑆳𑆲𑆿 𑆘𑇀𑆮𑆫𑆯𑇀𑆖 𑇅 𑆒𑆼𑆨𑇀𑆪𑆂 𑆑𑆸𑆰𑇀𑆟𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆪𑆳𑆠𑆴 𑆠𑆵𑆮𑇀𑆫𑆁 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆟𑆽𑆱𑇀𑆠𑇀𑆪𑆘𑇀𑆪𑆠𑆼 𑆯𑆵𑆔𑇀𑆫𑆩𑆼𑆮 𑇆𑇖𑇖𑇆
𑆇𑆓𑇀𑆫𑆩𑆣𑇀𑆪𑆮𑆴𑆰𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠𑇀 𑆱𑆫𑇀𑆥𑆢𑆰𑇀𑆛𑆮𑆠𑇀 𑇅 𑆄𑆢𑆁𑆯𑆁 𑆱𑇀𑆮𑆼𑆢𑆴𑆠𑆁 𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆖𑇀𑆗𑆴𑆠𑆁 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇖𑇗𑇆
𑆫𑆘𑆤𑆵𑆱𑆽𑆤𑇀𑆣𑆮𑆮𑇀𑆪𑆾𑆰𑆯𑆴𑆫𑆵𑆰𑆦𑆬𑆥𑆶𑆰𑇀𑆥𑆘𑆽𑆂 𑇅𑇖𑇘𑇅 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆩𑇀𑆬𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆰𑇀𑆛𑆁 𑆖 𑆱𑆶𑆫𑆱𑆳𑆓𑇀𑆫𑆘𑆩𑇀 𑇆𑇖𑇘𑇆
𑆬𑆼𑆥𑆼, 𑆱𑇀𑆮𑆼𑆢𑆼 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆖 𑆓𑆾𑆩𑆪𑆁 𑆲𑆴𑆠𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆥𑆳𑆤𑆼 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆳 𑆧𑆲𑆶𑆯𑆫𑇀𑆑𑆫𑆩𑇀 𑇆𑇖𑇙𑇆
𑆢𑆁𑆯𑆁 𑆩𑆤𑇀𑆢𑆮𑆴𑆰𑆳𑆟𑆳𑆁 𑆠𑆶 𑆖𑆑𑇀𑆫𑆠𑆽𑆬𑆼𑆤 𑆱𑆼𑆖𑆪𑆼𑆠𑇀 𑇅 𑆮𑆴𑆢𑆳𑆫𑆵𑆓𑆟𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼𑆤𑆳𑆡𑆮𑆳 𑆥𑆶𑆤𑆂 𑇆𑇗𑇐𑇆
𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆱𑇀𑆮𑆼𑆢𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆽𑆫𑆶𑆥𑆤𑆳𑆲𑆪𑆼𑆠𑇀 𑇅 𑆓𑆶𑆝𑆾𑆢𑆑𑆁 𑆮𑆳 𑆱𑆶𑆲𑆴𑆩𑆁 𑆖𑆳𑆠𑆶𑆫𑇀𑆘𑆳𑆠𑆑𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇆𑇗𑇑𑇆
𑆥𑆳𑆤𑆩𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆢𑆳𑆠𑆮𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆳 𑆱𑆓𑆶𑆝𑆁 𑆲𑆴𑆩𑆩𑇀 𑇅 𑆯𑆴𑆒𑆴𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆧𑆫𑇀𑆲𑆳𑆟𑆴 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆰𑆵 𑇆𑇗𑇒𑇆
𑆣𑆷𑆩𑆾 𑆲𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑆶 𑆯𑆵𑆔𑇀𑆫𑆁 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆘𑆁 𑆮𑆴𑆰𑆩𑇀 𑇅 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆥𑆶𑆰𑇀𑆥𑆁 𑆫𑆘𑆤𑆵 𑆤𑆴𑆯𑆳 𑆮𑆳 𑆑𑆾𑆢𑇀𑆫𑆮𑆁 𑆠𑆸𑆟𑆩𑇀 𑇆𑇗𑇓𑇆
𑆍𑆨𑆴𑆫𑇀𑆔𑆸𑆠𑆳𑆑𑇀𑆠𑆽𑆫𑇀𑆣𑆷𑆥𑆱𑇀𑆠𑆶 𑆥𑆳𑆪𑆶𑆢𑆼𑆯𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆂 𑇅 𑆤𑆳𑆯𑆪𑆼𑆢𑆳𑆯𑆶 𑆑𑆵𑆛𑆾𑆠𑇀𑆡𑆁 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆱𑇀𑆪 𑆖 𑆪𑆢𑇀𑆮𑆴𑆰𑆩𑇀 𑇆𑇗𑇔𑇆
𑆬𑆷𑆠𑆳𑆮𑆴𑆰𑆁 𑆔𑆾𑆫𑆠𑆩𑆁 𑆢𑆶𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆠𑆩𑆁 𑆖 𑆠𑆠𑇀 𑇅 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆠𑆩𑆁 𑆖𑆳𑆥𑆴 𑆨𑆴𑆰𑆓𑇀𑆨𑆴𑆫𑇀𑆩𑆤𑇀𑆢𑆧𑆶𑆢𑇀𑆣𑆴𑆨𑆴𑆂 𑇆𑇗𑇕𑇆
𑆱𑆮𑆴𑆰𑆁 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆁 𑆖𑆽𑆠𑆢𑆴𑆠𑇀𑆪𑆼𑆮𑆁 𑆥𑆫𑆴𑆯𑆕𑇀𑆑𑆴𑆠𑆼 𑇅 𑆮𑆴𑆰𑆔𑇀𑆤𑆩𑆼𑆮 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑆮𑆴𑆫𑆾𑆣𑆴 𑆪𑆢𑆿𑆰𑆣𑆩𑇀 𑇆𑇗𑇖𑇆
𑆃𑆓𑆢𑆳𑆤𑆳𑆁 𑆲𑆴 𑆱𑆁𑆪𑆾𑆓𑆾 𑆮𑆴𑆰𑆘𑆶𑆰𑇀𑆛𑆱𑇀𑆪 𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑇅 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆼 𑆩𑆳𑆤𑆮𑆼 𑆪𑆶𑆑𑇀𑆠𑆾𑇁𑆓𑆢𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇁𑆱𑆶𑆒𑆩𑇀 𑇆𑇗𑇗𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆼𑆤 𑆘𑇀𑆚𑆳𑆠𑆮𑇀𑆪𑆾 𑆮𑆴𑆰𑆤𑆴𑆯𑇀𑆖𑆪𑆂 𑇅 𑆃𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆮𑆴𑆰𑆱𑆢𑇀𑆨𑆳𑆮𑆁 𑆨𑆴𑆰𑆓𑇀𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆼𑆤𑇀𑆤𑆫𑆩𑇀 𑇆𑇗𑇘𑇆
𑆥𑇀𑆫𑆾𑆢𑇀𑆨𑆴𑆢𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆠𑆶 𑆪𑆡𑆳𑇁𑆕𑇀𑆑𑆶𑆫𑆼𑆟 𑆤 𑆮𑇀𑆪𑆑𑇀𑆠𑆘𑆳𑆠𑆴𑆂 𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆠𑆴 𑆮𑆸𑆑𑇀𑆰𑆂 𑇅 𑆠𑆢𑇀𑆮𑆢𑇀𑆢𑆶𑆫𑆳𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆩𑆁 𑆲𑆴 𑆠𑆳𑆱𑆳𑆁 𑆮𑆴𑆰𑆁 𑆯𑆫𑆵𑆫𑆼 𑆥𑇀𑆫𑆮𑆴𑆑𑆵𑆫𑇀𑆟𑆩𑆳𑆠𑇀𑆫𑆩𑇀 𑇆𑇗𑇙𑇆

𑆠𑆥𑇀𑆠𑆳𑆤𑆴 𑆤𑆮𑆑𑆥𑆳𑆬𑆳𑆤𑇀𑆪𑆡𑆮𑆳 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑇀𑆪 𑆥𑆳𑆪𑆪𑆼𑆠𑆳𑆖𑇀𑆗𑆩𑇀𑇅 𑆄𑆥𑆳𑆑𑆯𑆫𑇀𑆑𑆫𑆁 𑆮𑆳𑇁𑆩𑆸𑆠𑆮𑆬𑇀𑆬𑇀𑆪𑆶𑆢𑆑𑆁 𑆠𑆸𑆰𑆳𑆁 𑆲𑆤𑇀𑆠𑆴𑇆𑇔𑇕𑇆
𑆑𑇀𑆰𑆵𑆫𑆮𑆠𑆳𑆁 𑆩𑆣𑆶𑆫𑆳𑆟𑆳𑆁 𑆯𑆵𑆠𑆳𑆤𑆳𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆳𑆂𑇅 𑆯𑆵𑆠𑆑𑆰𑆳𑆪𑆳 𑆩𑆸𑆢𑇀𑆨𑆸𑆰𑇀𑆛𑆱𑆁𑆪𑆶𑆠𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆔𑇀𑆤𑆳𑆂𑇆𑇔𑇖𑇆
𑆮𑇀𑆪𑆾𑆰𑆮𑆖𑆳𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑇁𑆩𑆠𑆸𑆰𑇀𑆟𑆳𑆔𑇀𑆤𑆳𑆂𑇅 𑆪𑆖𑇀𑆖𑆾𑆑𑇀𑆠𑆁 𑆑𑆦𑆘𑆳𑆪𑆳𑆁 𑆮𑆩𑇀𑆪𑆳𑆁 𑆠𑆖𑇀𑆖𑆽𑆮 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇗𑇆
𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆫𑆶𑆖𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆳𑆬𑆱𑇀𑆪𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆰𑆶 𑆑𑆦𑆳𑆤𑆶𑆓𑆳𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑇀𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆢𑆣𑆴𑆩𑆣𑆶𑆠𑆫𑇀𑆥𑆟𑆬𑆮𑆟𑆾𑆰𑇀𑆟𑆘𑆬𑆽𑆫𑇀𑆮𑆩𑆤𑆩𑆴𑆰𑇀𑆛𑆩𑇀𑇆𑇔𑇘𑇆
𑆢𑆳𑆝𑆴𑆩𑆩𑆩𑇀𑆬𑆦𑆬𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆤𑇀𑆪𑆠𑇀 𑆱𑆑𑆰𑆳𑆪𑆩𑆡 𑆬𑆼𑆲𑆩𑇀𑇅 𑆥𑆼𑆪𑆩𑆡𑆮𑆳 𑆥𑇀𑆫𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆫𑆘𑆤𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇔𑇙𑇆
𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆼𑆤 𑆠𑆶 𑆠𑆶𑆬𑇀𑆪𑆳 𑆑𑇀𑆰𑆪𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆳 𑆓𑆫𑆵𑆪𑆱𑆵 𑆤𑆹𑆟𑆳𑆩𑇀𑇅 𑆑𑇀𑆰𑆵𑆟𑆑𑇀𑆰𑆠𑆯𑆾𑆰𑆲𑆴𑆠𑆽𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆳𑆁 𑆨𑆼𑆰𑆘𑆽𑆂 𑆯𑆩𑆪𑆼𑆠𑇀𑇆𑇕𑇐𑇆
𑆥𑆳𑆤𑆠𑆸𑆰𑆳𑆫𑇀𑆠𑆂 𑆥𑆳𑆤𑆁 𑆠𑇀𑆮𑆫𑇀𑆣𑆾𑆢𑆑𑆩𑆩𑇀𑆬𑆬𑆮𑆟𑆓𑆤𑇀𑆣𑆳𑆞𑇀𑆪𑆩𑇀𑇅 𑆯𑆴𑆯𑆴𑆫𑆱𑇀𑆤𑆳𑆠𑆂 𑆥𑆳𑆤𑆁 𑆩𑆢𑇀𑆪𑆳𑆩𑇀𑆧𑆶 𑆓𑆶𑆝𑆳𑆩𑇀𑆧𑆶 𑆮𑆳 𑆠𑆸𑆰𑆴𑆠𑆂𑇆𑇕𑇑𑇆
𑆨𑆑𑇀𑆠𑆾𑆥𑆫𑆾𑆣𑆠𑆸𑆰𑆴𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆠𑆸𑆰𑆳𑆫𑇀𑆠𑆾𑇁𑆡𑆮𑆳 𑆠𑆤𑆶𑆪𑆮𑆳𑆓𑆷𑆩𑇀𑇅 𑆥𑇀𑆫𑆥𑆴𑆧𑆼𑆢𑇀𑆓𑆶𑆫𑆶𑆟𑆳 𑆠𑆸𑆰𑆴𑆠𑆾 𑆨𑆶𑆑𑇀𑆠𑆼𑆤 𑆠𑆢𑆶𑆢𑇀𑆣𑆫𑆼𑆢𑇀𑆨𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇕𑇒𑇆
𑆩𑆢𑇀𑆪𑆳𑆩𑇀𑆧𑆶 𑆮𑆳𑇁𑆩𑇀𑆧𑆶 𑆑𑆾𑆰𑇀𑆟𑆁 𑆧𑆬𑆮𑆳𑆁𑆱𑇀𑆠𑆸𑆰𑆴𑆠𑆂 𑆱𑆩𑆶𑆬𑇀𑆬𑆴𑆒𑆼𑆠𑇀 𑆥𑆵𑆠𑇀𑆮𑆳𑇅 𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆮𑆴𑆯𑆢𑆩𑆶𑆒𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆁 𑆮𑆳 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆤𑇀𑆡𑆩𑇀𑇆𑇕𑇓𑇆
𑆧𑆬𑆮𑆳𑆁𑆱𑇀𑆠𑆶 𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆼 𑆥𑆴𑆧𑆼𑆢𑇀𑆣𑆸𑆠𑆁 𑆠𑆸𑆰𑇀𑆪𑆩𑆢𑇀𑆪𑆳𑆖𑇀𑆖𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆸𑆰𑇀𑆛𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆁𑆯𑇀𑆖𑆳𑆧𑆬𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀𑇆𑇕𑇔𑇆
𑆃𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆤𑆳𑆁 𑆠𑆫𑇀𑆰𑆁 𑆯𑆩𑆪𑆼𑆤𑇀𑆤𑆸𑆟𑆳𑆩𑆴𑆲𑆳𑆯𑆶 𑆥𑆪𑆂𑇅 𑆗𑆳𑆓𑆾 𑆮𑆳 𑆔𑆸𑆠𑆨𑆸𑆰𑇀𑆛𑆂 𑆯𑆵𑆠𑆾 𑆩𑆣𑆶𑆫𑆾 𑆫𑆱𑆾 𑆲𑆸𑆢𑇀𑆪𑆂𑇆𑇕𑇕𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼𑇁𑆤𑇀𑆤𑆼 𑆨𑆶𑆑𑇀𑆠𑆼 𑆪𑆳 𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆁 𑆓𑆶𑆝𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆯𑆩𑆪𑆼𑆠𑇀𑇅 𑆠𑆫𑇀𑆰𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑆴𑆲𑆠𑆱𑇀𑆪 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆥𑆲𑆽𑆫𑇀𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑇆𑇕𑇖𑇆
𑆠𑆸𑆛𑇀𑆢𑆳𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆩𑆢𑆳𑆠𑇀𑆪𑆪𑆳𑆱𑇀𑆫𑆮𑆴𑆰𑆥𑆴𑆠𑇀𑆠𑆼 𑇅 𑆯𑆱𑇀𑆠𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆯𑆵𑆠𑆁, 𑆯𑆸𑆠𑆯𑆵𑆠𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑇁𑆩𑇀𑆨𑆂𑇆𑇕𑇗𑇆
𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆤𑆮𑆘𑇀𑆮𑆫𑆥𑆵𑆤𑆱𑆔𑆸𑆠𑆥𑆵𑆠𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆓𑆬𑆫𑆾𑆓𑆼𑇅 𑆑𑆦𑆮𑆳𑆠𑆑𑆸𑆠𑆼 𑆱𑇀𑆠𑇀𑆪𑆳𑆤𑆼 𑆱𑆢𑇀𑆪𑆂𑆯𑆶𑆢𑇀𑆣𑆼 𑆖 𑆲𑆴𑆠𑆩𑆶𑆰𑇀𑆟𑆩𑇀𑇆𑇕𑇘𑇆
𑆥𑆳𑆟𑇀𑆝𑆷𑆢𑆫𑆥𑆵𑆤𑆱𑆩𑆼𑆲𑆓𑆶𑆬𑇀𑆩𑆩𑆤𑇀𑆢𑆳𑆤𑆬𑆳𑆠𑆴𑆱𑆳𑆫𑆼𑆰𑆶𑇅 𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆴 𑆖 𑆠𑆾𑆪𑆁 𑆤 𑆲𑆴𑆠𑆁 𑆑𑆳𑆩𑆩𑆱𑆲𑇀𑆪𑆼 𑆥𑆴𑆧𑆼𑆢𑆬𑇀𑆥𑆩𑇀𑇆𑇕𑇙𑇆
𑆥𑆷𑆫𑇀𑆮𑆳𑆩𑆪𑆳𑆠𑆶𑆫𑆂 𑆱𑆤𑇀 𑆢𑆵𑆤𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆫𑇀𑆢𑆴𑆠𑆾 𑆘𑆬𑆁 𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆤𑇀𑇅 𑆤 𑆬𑆨𑆼𑆠 𑆱 𑆖𑆼𑆤𑇀𑆩𑆫𑆟𑆩𑆳𑆯𑇀𑆮𑆼𑆮𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆢𑇀𑆢𑆵𑆫𑇀𑆔𑆫𑆾𑆓𑆁 𑆮𑆳𑇆𑇖𑇐𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆧𑆶 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆸𑆰𑇀𑆪𑆤𑇀 𑆫𑆾𑆓𑆵 𑆱𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑇀𑇅 𑆪𑆢𑇀𑆮𑆳 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆪𑆠𑇀𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆫𑆾𑆓𑆱𑇀𑆪 𑆠𑆖𑇀𑆖𑆼𑆰𑇀𑆛𑆩𑇀𑇆𑇖𑇑𑇆
𑆠𑆱𑇀𑆪𑆳𑆁 𑆮𑆴𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆳𑆪𑆳𑆁 𑆠𑆘𑇀𑆘𑆤𑇀𑆪 𑆇𑆥𑆢𑇀𑆫𑆮𑆂 𑆱𑆶𑆒𑆁 𑆘𑆼𑆠𑆶𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆘𑆪𑆼𑆢𑇀𑆧𑆲𑆶𑆨𑇀𑆪𑆾𑇁𑆥𑆴 𑆫𑆾𑆓𑆼𑆨𑇀𑆪𑆂𑇆𑇖𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆲𑆼𑆠𑆷 𑆪𑆡𑆳𑇁𑆓𑇀𑆤𑆴𑆥𑆮𑆤𑆿 𑆑𑆶𑆫𑆶𑆠𑆂 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆁 𑆖 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑇀𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆥𑆸𑆡𑆓𑆳𑆑𑆸𑆠𑆴𑆫𑆱𑆳𑆣𑇀𑆪𑆠𑆳 𑆱𑆳𑆣𑆤𑆁 𑆖𑆾𑆑𑇀𑆠𑆩𑇀𑇆𑇖𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆴𑆰𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑇀𑆫𑆳𑆓𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆁 𑆓𑆶𑆟𑆳𑆤𑇀 𑆪𑆾𑆤𑆴𑆁 𑆮𑆼𑆓𑆳𑆀𑆬𑇀𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆶𑆥𑆑𑇀𑆫𑆩𑆳𑆤𑇀𑇅 𑆮𑆴𑆰𑆱𑇀𑆪 𑆧𑇀𑆫𑆶𑆮𑆠𑆂 𑆱𑆩𑇀𑆪𑆓𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼𑇆𑇓𑇆
𑆃𑆩𑆸𑆠𑆳𑆫𑇀𑆡𑆁 𑆱𑆩𑆶𑆢𑇀𑆫𑆼 𑆠𑆶 𑆩𑆡𑇀𑆪𑆩𑆳𑆤𑆼 𑆱𑆶𑆫𑆳𑆱𑆶𑆫𑆽𑆂𑇅 𑆘𑆘𑇀𑆚𑆼 𑆥𑇀𑆫𑆳𑆓𑆩𑆸𑆠𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆼𑆂 𑆥𑆶𑆫𑆶𑆰𑆾 𑆔𑆾𑆫𑆢𑆫𑇀𑆯𑆤𑆂𑇆𑇔𑇆
𑆢𑆵𑆥𑇀𑆠𑆠𑆼𑆘𑆳𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆾 𑆲𑆫𑆴𑆑𑆼𑆯𑆾𑇁𑆤𑆬𑆼𑆑𑇀𑆰𑆟𑆂𑇅 𑆘𑆓𑆢𑇀𑆮𑆴𑆰𑆟𑇀𑆟𑆁 𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆠𑆼𑆤𑆳𑆱𑆿 𑆮𑆴𑆰𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂𑇆𑇕𑇆
𑆘𑆕𑇀𑆓𑆩𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆪𑆳𑆁 𑆠𑆢𑇀𑆪𑆾𑆤𑆿 𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆤𑇀𑆪𑆪𑆾𑆘𑆪𑆠𑇀𑇅 𑆠𑆢𑆩𑇀𑆧𑆶𑆱𑆩𑇀𑆨𑆮𑆁 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆥𑆳𑆮𑆑𑆾𑆥𑆩𑆩𑇀𑇆𑇖𑇆
𑆃𑆰𑇀𑆛𑆮𑆼𑆓𑆁 𑆢𑆯𑆓𑆶𑆟𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑇀𑆪𑆶𑆥𑆑𑇀𑆫𑆩𑆩𑇀𑇅𑇗𑇅 𑆠𑆢𑇀𑆮𑆫𑇀𑆰𑆳𑆱𑇀𑆮𑆩𑇀𑆧𑆶𑆪𑆾𑆤𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆕𑇀𑆑𑇀𑆬𑆼𑆢𑆁 𑆓𑆶𑆝𑆮𑆢𑇀𑆓𑆠𑆩𑇀𑇆𑇗𑇆
𑆱𑆫𑇀𑆥𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆣𑆫𑆳𑆥𑆳𑆪𑆼 𑆠𑆢𑆓𑆱𑇀𑆠𑇀𑆪𑆾 𑆲𑆴𑆤𑆱𑇀𑆠𑆴 𑆖𑇅 𑆥𑇀𑆫𑆪𑆳𑆠𑆴 𑆩𑆤𑇀𑆢𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆁 𑆮𑆴𑆰𑆁 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆤𑆳𑆠𑇀𑆪𑆪𑆼𑇆𑇘𑇆
𑆱𑆫𑇀𑆥𑆳𑆂 𑆑𑆵𑆛𑆾𑆤𑇀𑆢𑆶𑆫𑆳 𑆬𑆷𑆠𑆳 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳 𑆓𑆸𑆲𑆓𑆾𑆣𑆴𑆑𑆳𑆂𑇅 𑆘𑆬𑆿𑆑𑆳𑆩𑆠𑇀𑆱𑇀𑆪𑆩𑆟𑇀𑆝𑆷𑆑𑆳𑆂 𑆑𑆟𑆨𑆳𑆂 𑆱𑆑𑆸𑆑𑆟𑇀𑆛𑆑𑆳𑆂𑇆𑇙𑇆
𑆯𑇀𑆮𑆱𑆴𑆁𑆲𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆓𑆾𑆩𑆳𑆪𑆶𑆠𑆫𑆑𑇀𑆰𑆶𑆤𑆑𑆶𑆬𑆳𑆢𑆪𑆂𑇅 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆴𑆟𑆾 𑆪𑆼 𑆮𑆴𑆰𑆁 𑆠𑆼𑆰𑆳𑆁 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆾𑆠𑇀𑆡𑆁 𑆘𑆕𑇀𑆓𑆩𑆁 𑆩𑆠𑆩𑇀𑇆𑇑𑇐𑇆
𑆩𑆶𑆱𑇀𑆠𑆑𑆁 𑆥𑆿𑆰𑇀𑆑𑆫𑆁 𑆑𑇀𑆫𑆿𑆚𑇀𑆖𑆁 𑆮𑆠𑇀𑆱𑆤𑆳𑆨𑆁 𑆧𑆬𑆳𑆲𑆑𑆩𑇀𑇅 𑆑𑆫𑇀𑆑𑆛𑆁 𑆑𑆳𑆬𑆑𑆷𑆛𑆁 𑆖 𑆑𑆫𑆮𑆵𑆫𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑇀𑇆𑇑𑇑𑇆
𑆥𑆳𑆬𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆣𑆁 𑆠𑆽𑆬𑆁 𑆩𑆼𑆔𑆑𑆁 𑆑𑆶𑆯𑆥𑆶𑆰𑇀𑆥𑆑𑆩𑇀𑇅 𑆫𑆾𑆲𑆴𑆰𑆁 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆖 𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆨𑆑𑆩𑇀𑇆𑇑𑇒𑇆
𑆱𑆕𑇀𑆑𑆾𑆖𑆁 𑆩𑆫𑇀𑆑𑆛𑆁 𑆯𑆸𑆕𑇀𑆓𑆵𑆮𑆴𑆰𑆁 𑆲𑆳𑆬𑆳𑆲𑆬𑆁 𑆠𑆡𑆳𑇅 𑆍𑆮𑆩𑆳𑆢𑆵𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆩𑆷𑆬𑆘𑆳𑆤𑆴 𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆴 𑆖𑇆𑇑𑇓𑇆
𑆓𑆫𑆱𑆁𑆪𑆾𑆓𑆘𑆁 𑆖𑆳𑆤𑇀𑆪𑆢𑇀𑆓𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆁 𑆓𑆢𑆥𑇀𑆫𑆢𑆩𑇀𑇅 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆮𑆴𑆥𑆳𑆑𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆠𑆢𑆳𑆯𑆶 𑆲𑆫𑆠𑇀𑆪𑆱𑆷𑆤𑇀𑇆𑇑𑇔𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆑𑇀𑆬𑆩𑆁 𑆢𑆳𑆲𑆁 𑆱𑆥𑆳𑆑𑆁 𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆟𑆩𑇀𑇅 𑆯𑆾𑆦𑆁 𑆖𑆽𑆮𑆳𑆠𑆴𑆱𑆳𑆫𑆁 𑆖 𑆘𑆤𑆪𑆼𑆘𑇀𑆘𑆕𑇀𑆓𑆩𑆁 𑆮𑆴𑆰𑆩𑇀𑇆𑇑𑇕𑇆
𑆱𑇀𑆡𑆳𑆮𑆫𑆁 𑆠𑆶 𑆘𑇀𑆮𑆫𑆁 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆁 𑆓𑆬𑆓𑇀𑆫𑆲𑆩𑇀𑇅 𑆦𑆼𑆤𑆮𑆩𑇀𑆪𑆫𑆶𑆖𑆴𑆯𑇀𑆮𑆳𑆱𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆯𑇀𑆖 𑆘𑆤𑆪𑆼𑆢𑇀𑆮𑆴𑆰𑆩𑇀 𑇆𑇑𑇖𑇆
𑆘𑆕𑇀𑆓𑆩𑆁 𑆱𑇀𑆪𑆳𑆢𑆣𑆾𑆨𑆳𑆓𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆁 𑆠𑆶 𑆩𑆷𑆬𑆘𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆮𑆴𑆰𑆁 𑆩𑆿𑆬𑆁 𑆲𑆤𑇀𑆠𑆴 𑆩𑆿𑆬𑆁 𑆖 𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆘𑆩𑇀 𑇆𑇑𑇗𑇆
𑆠𑆸𑆟𑇀𑆩𑆾𑆲𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆥𑇀𑆫𑆱𑆼𑆑𑆮𑆩𑆡𑆑𑇀𑆬𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆢𑇀𑆪𑆼𑇅 𑆮𑆼𑆓𑆼 𑆫𑆱𑆥𑇀𑆫𑆢𑆾𑆰𑆳𑆢𑆱𑆸𑆑𑇀𑆥𑇀𑆫𑆢𑆾𑆰𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆠𑆶𑇆𑇑𑇘𑇆
𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆨𑇀𑆫𑆩𑆮𑆼𑆥𑆡𑆶𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆘𑆸𑆩𑇀𑆨𑆳𑆕𑇀𑆓𑆖𑆴𑆩𑆴𑆖𑆴𑆩𑆳𑆠𑆩𑆑𑆳𑆂 𑇅 𑆢𑆶𑆰𑇀𑆛𑆥𑆴𑆯𑆴𑆠𑆳𑆠𑇀𑆠𑆸𑆠𑆵𑆪𑆼 𑆩𑆟𑇀𑆝𑆬𑆑𑆟𑇀𑆝𑆷𑆯𑇀𑆮𑆪𑆡𑆶𑆑𑆾𑆜𑆳𑆂𑇆𑇑𑇙𑇆
𑆮𑆳𑆠𑆳𑆢𑆴𑆘𑆳𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆢𑆳𑆲𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆕𑇀𑆓𑆯𑆷𑆬𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑇀𑆪𑆳𑆂𑇅 𑆤𑆵𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑆩𑆱𑆯𑇀𑆖 𑆢𑆫𑇀𑆯𑆤𑆁 𑆥𑆚𑇀𑆖𑆩𑆼 𑆮𑆼𑆓𑆼𑇆𑇒𑇐𑇆
𑆰𑆰𑇀𑆜𑆼 𑆲𑆴𑆑𑇀𑆑𑆳, 𑆨𑆕𑇀𑆓𑆂 𑆱𑇀𑆑𑆤𑇀𑆣𑆱𑇀𑆪 𑆠𑆶 𑆱𑆥𑇀𑆠𑆩𑆼𑇁𑆰𑇀𑆛𑆩𑆼 𑆩𑆫𑆟𑆩𑇀𑇅 𑆤𑆹𑆟𑆳𑆁, 𑆖𑆠𑆶𑆰𑇀𑆥𑆢𑆳𑆁 𑆱𑇀𑆪𑆳𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂, 𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂𑇆𑇒𑇑𑇆
𑆱𑆵𑆢𑆠𑇀𑆪𑆳𑆢𑇀𑆪𑆼 𑆨𑇀𑆫𑆩𑆠𑆴 𑆖, 𑆖𑆠𑆶𑆰𑇀𑆥𑆢𑆾 𑆮𑆼𑆥𑆠𑆼, 𑆠𑆠𑆂 𑆯𑆷𑆤𑇀𑆪𑆂 𑇅 𑆩𑆤𑇀𑆢𑆳𑆲𑆳𑆫𑆾 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆯𑇀𑆮𑆳𑆱𑆼𑆤 𑆲𑆴 𑆖𑆠𑆶𑆫𑇀𑆡𑆮𑆼𑆓𑆼 𑆠𑆶𑇆𑇒𑇒𑇆
𑆣𑇀𑆪𑆳𑆪𑆠𑆴 𑆮𑆴𑆲𑆓𑆂 𑆥𑇀𑆫𑆡𑆩𑆼 𑆮𑆼𑆓𑆼, 𑆥𑇀𑆫𑆨𑇀𑆫𑆳𑆩𑇀𑆪𑆠𑆴 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆠𑆶𑇅 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆯𑇀𑆖 𑆠𑆸𑆠𑆵𑆪𑆼 𑆮𑆴𑆰𑆮𑆼𑆓𑆼 𑆪𑆳𑆠𑆴 𑆥𑆚𑇀𑆖𑆠𑇀𑆮𑆩𑇀𑇆𑇒𑇓𑇆
𑆬𑆔𑆶 𑆫𑆷𑆑𑇀𑆰𑆩𑆳𑆯𑆶 𑆮𑆴𑆯𑆢𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆴𑆑𑆳𑆱𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆖𑇅 𑆇𑆰𑇀𑆟𑆩𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑇀𑆪𑆫𑆱𑆁 𑆢𑆯𑆓𑆶𑆟𑆩𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆰𑆁 𑆠𑆘𑇀𑆘𑇀𑆚𑆽𑆂𑇆𑇒𑇔𑇆
𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆩𑆯𑆽𑆠𑇀𑆪𑆳𑆠𑇀𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆢𑆱𑆸𑆑𑇀 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆠𑆴𑇅 𑆑𑆦𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆠𑇀𑆮𑆳𑆢𑆤𑇀𑆤𑆫𑆱𑆳𑆁𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼 𑆯𑆵𑆔𑇀𑆫𑆩𑇀𑇆𑇒𑇕𑇆
𑆯𑆵𑆔𑇀𑆫𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆨𑆳𑆮𑆳𑆢𑆳𑆯𑆶 𑆮𑇀𑆪𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆑𑆼𑆮𑆬𑆁 𑆢𑆼𑆲𑆩𑇀𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆫𑇀𑆩𑆔𑇀𑆤𑆁 𑆥𑇀𑆫𑆳𑆟𑆔𑇀𑆤𑆁 𑆠𑆢𑇀𑆮𑆴𑆑𑆳𑆱𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇒𑇖𑇆
𑆢𑆶𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆁 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆪𑆳𑆢𑆱𑆑𑇀𑆠𑆓𑆠𑆴𑆢𑆾𑆰𑆩𑇀𑇅 𑆢𑆾𑆰𑆱𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆤𑇀𑆪𑆠𑆩𑆁 𑆲𑇀𑆪𑆶𑆢𑆵𑆫𑆪𑆠𑆴𑇆𑇒𑇗𑇆

𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆴𑆧𑆼𑆢𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆮𑆳𑇁𑆥𑆴 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆥𑆑𑇀𑆮𑆁 𑆱𑆔𑆸𑆠𑆁 𑆲𑆴𑆠𑆳𑆯𑆵 𑇅𑇓𑇖𑇅 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆓𑆾𑆣𑆷𑆩𑆪𑆮𑆾𑆢𑇀𑆨𑆮𑆳𑆤𑆴 𑆑𑆳𑆑𑆾𑆬𑆴𑆮𑆫𑇀𑆓𑆯𑇀𑆖 𑆑𑆸𑆠𑆂 𑆱𑆶𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆂 𑇆𑇓𑇖𑇆
𑆑𑆳𑆱𑆼𑆰𑆶 𑆥𑆼𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆰𑆶 𑆑𑆳𑆱𑆮𑆢𑇀𑆨𑆴𑆂 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆔𑆸𑆠𑆼𑆤 𑆮𑆳𑇁𑆥𑆴 𑇅𑇓𑇗𑇅 𑆓𑆶𑆝𑆾𑆢𑆑𑆁 𑆮𑆳 𑆑𑇀𑆮𑆡𑆴𑆠𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆣𑆴 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆯𑆵𑆠𑆁 𑆩𑆫𑆴𑆖𑆾𑆥𑆢𑆁𑆯𑆩𑇀 𑇆𑇓𑇗𑇆
𑆥𑇀𑆫𑆱𑇀𑆡𑆠𑇀𑆫𑆪𑆼𑆟𑆳𑆩𑆬𑆑𑆵𑆫𑆱𑆱𑇀𑆪 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆢𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆓𑆶𑆝𑆱𑇀𑆪 𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆽𑆫𑇀𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆑𑆖𑆮𑇀𑆪𑆘𑆵𑆫𑆮𑇀𑆪𑆾𑆰𑆼𑆨𑆑𑆸𑆰𑇀𑆟𑆳𑆲𑆥𑆶𑆰𑆳𑆘𑆩𑆾𑆢𑆽𑆂 𑇆𑇓𑇘𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆴𑆤𑇀𑆣𑆶𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆮𑆳𑆤𑆵𑆥𑆳𑆜𑆳𑆓𑇀𑆤𑆴𑆣𑆳𑆤𑇀𑆪𑆽𑆯𑇀𑆖 𑆥𑆴𑆖𑆶𑆥𑇀𑆫𑆩𑆳𑆟𑆽𑆂 𑇅 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆥𑆬𑆳𑆤𑆴 𑆖𑆳𑆰𑇀𑆛𑆳𑆮𑆰𑇀𑆛𑆿 𑆖 𑆠𑆽𑆬𑆱𑇀𑆪 𑆥𑆖𑆼𑆢𑇀𑆪𑆡𑆳𑆮𑆠𑇀 𑇆𑇓𑇙𑇆
𑆠𑆁 𑆨𑆑𑇀𑆰𑆪𑆼𑆢𑆑𑇀𑆰𑆦𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆖𑆼𑆰𑇀𑆛𑆱𑇀𑆠𑇀𑆫𑆴𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆩𑇀 𑇅 𑆃𑆤𑆼𑆤 𑆱𑆫𑇀𑆮𑆼 𑆓𑇀𑆫𑆲𑆟𑆵𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆯𑆾𑆡𑆳𑆂 𑇆𑇔𑇐𑇆
𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆖𑆳𑆪𑆁 𑆖𑆴𑆫𑆩𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆼𑆫𑇀𑆲𑆠𑆱𑇀𑆪 𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆖 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑆼𑆠𑆶𑆂 𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆖 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆩𑆪𑆤𑆳𑆯𑆤𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆾 𑆤𑆳𑆩 𑆓𑆶𑆝𑆂 𑆥𑇀𑆫𑆠𑆵𑆠𑆂 𑇆𑇔𑇑𑇆
𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆼𑆨𑆑𑆟𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆨𑆳𑆫𑇀𑆓𑆵𑆯𑆛𑆵𑆥𑆶𑆰𑇀𑆑𑆫𑆩𑆷𑆬𑆮𑆴𑆯𑇀𑆮𑆳𑆤𑇀 𑇅 𑆥𑆳𑆜𑆳𑆩𑆸𑆠𑆳𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆑𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵𑆫𑆳𑆱𑇀𑆤𑆳𑆓𑇀𑆤𑇀𑆪𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆧𑆬𑆳𑆪𑆮𑆳𑆱𑆳𑆤𑇀 𑇆𑇔𑇒𑇆
𑆢𑇀𑆮𑆴𑆥𑆳𑆬𑆴𑆑𑆳𑆤𑇀 𑆤𑇀𑆪𑆱𑇀𑆪 𑆪𑆮𑆳𑆞𑆑𑆁 𑆖 𑆲𑆫𑆵𑆠𑆑𑆵𑆤𑆳𑆁 𑆖 𑆯𑆠𑆁 𑆓𑆶𑆫𑆷𑆟𑆳𑆩𑇀 𑇅 𑆢𑇀𑆫𑆾𑆟𑆼 𑆘𑆬𑆱𑇀𑆪𑆳𑆞𑆑𑆱𑆁𑆪𑆶𑆠𑆼 𑆖 𑆑𑇀𑆮𑆳𑆡𑆼 𑆑𑆸𑆠𑆼 𑆥𑆷𑆠𑆖𑆠𑆶𑆫𑇀𑆡𑆨𑆳𑆓𑆼 𑇆𑇔𑇓𑇆
𑆥𑆖𑆼𑆠𑇀𑆠𑆶𑆬𑆳𑆁 𑆯𑆶𑆢𑇀𑆣𑆓𑆶𑆝𑆱𑇀𑆪 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆥𑆸𑆡𑆑𑇀 𑆖 𑆠𑆽𑆬𑆳𑆠𑇀 𑆑𑆶𑆝𑆮𑆁 𑆔𑆸𑆠𑆳𑆖𑇀𑆖 𑇅 𑆖𑆷𑆫𑇀𑆟𑆁 𑆖 𑆠𑆳𑆮𑆤𑇀𑆩𑆓𑆣𑆾𑆢𑇀𑆨𑆮𑆳𑆪𑆳 𑆢𑆼𑆪𑆁 𑆖 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆩𑆣𑆶 𑆱𑆴𑆢𑇀𑆣𑆯𑆵𑆠𑆼 𑇆𑇔𑇔𑇆
𑆫𑆱𑆳𑆪𑆤𑆳𑆠𑇀 𑆑𑆫𑇀𑆰𑆩𑆠𑆾 𑆮𑆴𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆼 𑆖𑆳𑆨𑆪𑆼 𑆤𑆴𑆠𑇀𑆪𑆩𑆡𑆳𑆯𑆶 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆢𑇀𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑇀𑆫𑆢𑆾𑆰𑆯𑆾𑆦𑆳𑆓𑇀𑆤𑆴𑆩𑆳𑆤𑇀𑆢𑇀𑆪𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆑𑆳𑆱𑆳𑆤𑇀 𑇆𑇔𑇕𑇆
𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆯𑇀𑆮𑆳𑆱𑆯𑆴𑆫𑆾𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆲𑆴𑆑𑇀𑆑𑆳𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆁𑆯𑇀𑆖 𑇅 𑆩𑆼𑆣𑆳𑆧𑆬𑆾𑆠𑇀𑆱𑆳𑆲𑆩𑆠𑆴𑆥𑇀𑆫𑆢𑆁 𑆖 𑆖𑆑𑆳𑆫 𑆖𑆽𑆠𑆢𑇀𑆨𑆓𑆮𑆳𑆤𑆓𑆱𑇀𑆠𑇀𑆪𑆂 𑇆𑇔𑇖𑇆
𑆯𑆠𑆳𑆮𑆫𑆵𑆤𑆳𑆓𑆧𑆬𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆔𑆸𑆠𑆁 𑆮𑆴𑆣𑆼𑆪𑆁 𑆖 𑆲𑆴𑆠𑆳𑆪 𑆑𑆳𑆱𑆴𑆤𑆳𑆩𑇀 𑇆𑇔𑇘𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆠𑇀𑆪𑆶𑆖𑇀𑆖𑆨𑆳𑆰𑆟𑆮𑆴𑆰𑆳𑆣𑇀𑆪𑆪𑆤𑆳𑆠𑆴𑆓𑆵𑆠𑆯𑆵𑆠𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆥𑆮𑆤𑆳𑆢𑆪𑆱𑇀𑆠𑆶 𑇅 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑆶 𑆠𑆼 𑆱𑇀𑆮𑆫𑆮𑆲𑆼𑆰𑆶 𑆓𑆠𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆁 𑆲𑆤𑇀𑆪𑆶𑆂 𑆱𑇀𑆮𑆫𑆁 𑆨𑆮𑆠𑆴 𑆖𑆳𑆥𑆴 𑆲𑆴 𑆰𑆝𑇀𑆮𑆴𑆣𑆂 𑆱𑆂 𑇆𑇓𑇆
𑆮𑆳𑆠𑆼𑆤 𑆑𑆸𑆰𑇀𑆟𑆤𑆪𑆤𑆳𑆤𑆤𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆳 𑆨𑆴𑆤𑇀𑆤𑆁 𑆯𑆤𑆽𑆫𑇀𑆮𑆢𑆠𑆴 𑆓𑆢𑇀𑆓𑆢𑆮𑆠𑇀 𑆱𑇀𑆮𑆫𑆁 𑆖 𑇅𑇔𑇅 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆥𑆵𑆠𑆮𑆢𑆤𑆳𑆑𑇀𑆰𑆴𑆥𑆶𑆫𑆵𑆰𑆩𑆷𑆠𑇀𑆫𑆾 𑆧𑇀𑆫𑆷𑆪𑆳𑆢𑇀𑆓𑆬𑆼𑆤 𑆥𑆫𑆴𑆢𑆳𑆲𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆼𑆤 𑇆𑇔𑇆
𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆠𑇀 𑆑𑆦𑆼𑆤 𑆱𑆠𑆠𑆁 𑆑𑆦𑆫𑆶𑆢𑇀𑆣𑆑𑆟𑇀𑆜𑆾 𑆩𑆤𑇀𑆢𑆁 𑆯𑆤𑆽𑆫𑇀𑆮𑆢𑆠𑆴 𑆖𑆳𑆥𑆴 𑆢𑆴𑆮𑆳 𑆮𑆴𑆯𑆼𑆰𑆂 𑇅𑇕𑇅 𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆼 𑆨𑆮𑆠𑆴 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑇀𑆥𑆢𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆳 𑆖 𑆮𑆖𑆱𑆱𑇀𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆲𑆶𑆂 𑇆𑇕𑇆
𑆣𑆷𑆥𑇀𑆪𑆼𑆠 𑆮𑆳𑆑𑇀 𑆑𑇀𑆰𑆪𑆑𑆸𑆠𑆼 𑆑𑇀𑆰𑆪𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆖𑇀𑆖 𑆮𑆳𑆓𑆼𑆰 𑆖𑆳(𑆮𑆳)𑆥𑆴 𑆲𑆠𑆮𑆳𑆑𑇀 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆂 𑇅𑇖𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆓𑆬𑆁 𑆱𑇀𑆮𑆫𑆩𑆬𑆑𑇀𑆰𑇀𑆪𑆥𑆢𑆁 𑆖𑆴𑆫𑆼𑆟 𑆩𑆼𑆢𑆯𑇀𑆖𑆪𑆳𑆢𑇀𑆮𑆢𑆠𑆴 𑆢𑆴𑆓𑇀𑆣𑆓𑆬𑆿𑆰𑇀𑆜𑆠𑆳𑆬𑆶𑆂 𑇆𑇖𑇆
𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆪 𑆑𑆸𑆯𑆱𑇀𑆪 𑆖𑆳𑆥𑆴 𑆖𑆴𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆾 𑆪𑆯𑇀𑆖 𑆱𑆲𑆾𑆥𑆘𑆳𑆠𑆂 𑇅 𑆩𑆼𑆢𑆱𑇀𑆮𑆴𑆤𑆂 𑆱𑆫𑇀𑆮𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆯𑇀𑆖 𑆱𑇀𑆮𑆫𑆳𑆩𑆪𑆾 𑆪𑆾 𑆤 𑆱 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆼𑆠𑆴 𑇆𑇗𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀 𑆱𑇀𑆮𑆫𑆳𑆠𑆶𑆫𑆤𑆫𑆳𑆤𑆥𑆑𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆳𑆤𑇀 𑆤𑇀𑆪𑆳𑆪𑆼𑆤 𑆠𑆳𑆤𑇀 𑆮𑆩𑆤𑆫𑆼𑆖𑆤𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆯𑇀𑆖 𑇅 𑆤𑆱𑇀𑆪𑆳𑆮𑆥𑆵𑆝𑆩𑆶𑆒𑆣𑆳𑆮𑆤𑆣𑆷𑆩𑆬𑆼𑆲𑆽𑆂 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆼𑆖𑇀𑆖 𑆮𑆴𑆮𑆴𑆣𑆽𑆂 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆽𑆯𑇀𑆖 𑇆𑇘𑇆

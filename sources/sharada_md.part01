𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆪𑆳𑆁 𑆑𑆛𑆶𑆥𑇀𑆫𑆳𑆪𑆳𑆂 𑆱𑆩𑆷𑆠𑇀𑆫𑆳 𑆧𑆱𑇀𑆠𑆪𑆾 𑆲𑆴𑆠𑆳𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆼 𑆱𑆩𑆣𑆶𑆫𑆑𑇀𑆰𑆵𑆫𑆳 𑆮𑆳𑆠𑆼 𑆠𑆽𑆬𑆳𑆩𑇀𑆬𑆱𑆁𑆪𑆶𑆠𑆳𑆂𑇆𑇘𑇕𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆪𑆳𑆂 𑆑𑆫𑇀𑆩 𑆱𑆳𑆣𑆳𑆫𑆟𑆁 𑆲𑆴𑆠𑆩𑇀𑇅𑇘𑇖𑇅 𑆫𑆑𑇀𑆠𑆪𑆾𑆤𑇀𑆪𑆳𑆩𑆱𑆸𑆓𑇀𑆮𑆫𑇀𑆟𑆽𑆫𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆖𑇆𑇘𑇖𑇆
𑆠𑆠𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆫𑆑𑇀𑆠𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆠𑆴𑆬𑆖𑆷𑆫𑇀𑆟𑆁 𑆢𑆣𑆴 𑆔𑆸𑆠𑆁 𑆦𑆳𑆟𑆴𑆠𑆁 𑆯𑆿𑆑𑆫𑆵 𑆮𑆱𑆳𑇆𑇘𑇗𑇆
𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆱𑆁𑆪𑆶𑆠𑆁 𑆥𑆼𑆪𑆁 𑆮𑆳𑆠𑆳𑆱𑆸𑆓𑇀𑆢𑆫𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆮𑆫𑆳𑆲𑆱𑇀𑆪 𑆫𑆱𑆾 𑆩𑆼𑆢𑇀𑆪𑆂 𑆱𑆑𑆿𑆬𑆠𑇀𑆡𑆾𑇁𑆤𑆴𑆬𑆳𑆣𑆴𑆑𑆼𑇆𑇘𑇘𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆤𑆳𑆓𑆫𑆽𑆫𑇀𑆮𑆳 𑆪𑆶𑆠𑆁 𑆢𑆣𑆴𑇅 𑆥𑆪𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆬𑆯𑆳𑆬𑆷𑆑𑆧𑆴𑆱𑆑𑆳𑆬𑆵𑆪𑆑𑆳𑆩𑇀𑆧𑆶𑆢𑆩𑇀𑇆𑇘𑇙𑇆
𑆱𑆥𑆪𑆂𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑇁𑆱𑆸𑆓𑇀𑆢𑆫𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑇅𑇙𑇐𑇅 𑆥𑆳𑆜𑆳 𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆪𑆾𑆫𑇀𑆩𑆣𑇀𑆪𑆁 𑆯𑆴𑆬𑆾𑆢𑇀𑆨𑆼𑆢𑆁 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇆𑇙𑇐𑇆
𑆃𑆩𑇀𑆧𑆰𑇀𑆜𑆳 𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆯𑇀𑆬𑆼𑆰𑆁 𑆱𑆩𑆕𑇀𑆓𑆳𑆁 𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆮𑆖𑆩𑇀𑇅 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆳𑆠𑆴𑆮𑆴𑆰𑆼 𑆧𑆴𑆬𑇀𑆮𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆬𑆾𑆣𑇀𑆫𑆁 𑆱𑆓𑆽𑆫𑆴𑆑𑆩𑇀𑇆𑇙𑇑𑇆
𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆁 𑆩𑆫𑆴𑆖𑆁 𑆯𑆶𑆟𑇀𑆜𑆵𑆁 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆁 𑆫𑆑𑇀𑆠𑆖𑆤𑇀𑆢𑆤𑆩𑇀𑇅 𑆑𑆛𑇀𑆦𑆬𑆁 𑆮𑆠𑇀𑆱𑆑𑆳𑆤𑆤𑇀𑆠𑆳𑆣𑆳𑆠𑆑𑆵𑆩𑆣𑆶𑆑𑆳𑆫𑇀𑆘𑆶𑆤𑆩𑇀𑇆𑇙𑇒𑇆
𑆥𑆶𑆰𑇀𑆪𑆼𑆟𑆾𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆠𑆶𑆬𑇀𑆪𑆳𑆤𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆠𑆳𑆤𑆴 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆟𑇀𑆝𑆶𑆬𑆮𑆳𑆫𑆴𑆟𑆳𑇆𑇙𑇓𑇆
𑆃𑆫𑇀𑆯𑆂𑆱𑆶 𑆖𑆳𑆠𑆴𑆱𑆳𑆫𑆼𑆰𑆶 𑆫𑆑𑇀𑆠𑆁 𑆪𑆖𑇀𑆖𑆾𑆥𑆮𑆼𑆯𑇀𑆪𑆠𑆼𑇅 𑆢𑆾𑆰𑆳𑆓𑆤𑇀𑆠𑆶𑆑𑆸𑆠𑆳 𑆪𑆼 𑆖 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆠𑆳𑆁𑆯𑇀𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀𑇆𑇙𑇔𑇆
𑆪𑆾𑆤𑆴𑆢𑆾𑆰𑆁 𑆫𑆘𑆾𑆢𑆾𑆰𑆁 𑆯𑇀𑆮𑆼𑆠𑆁 𑆤𑆵𑆬𑆁 𑆱𑆥𑆵𑆠𑆑𑆩𑇀𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆁 𑆪𑆖𑇀𑆖 𑆥𑇀𑆫𑆱𑆲𑇀𑆪 𑆮𑆴𑆤𑆴𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀𑇆𑇙𑇕𑇆
𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆶𑆰𑇀𑆪𑆳𑆤𑆶𑆓𑆁 𑆤𑆳𑆩 𑆲𑆴𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆥𑆷𑆘𑆴𑆠𑆩𑇀𑇅𑇙𑇖𑇅 𑆅𑆠𑆴 𑆥𑆶𑆰𑇀𑆪𑆳𑆤𑆶𑆓𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆠𑆟𑇀𑆝𑆶𑆬𑆵𑆪𑆑𑆩𑆷𑆬𑆁 𑆠𑆶 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇆𑇙𑇖𑇆
𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆁 𑆖 𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆖 𑆗𑆳𑆓𑆼𑆤 𑆥𑆪𑆱𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆥𑆠𑇀𑆫𑆑𑆬𑇀𑆑𑆿 𑆔𑆸𑆠𑆼 𑆨𑆸𑆰𑇀𑆛𑆿 𑆫𑆳𑆘𑆳𑆢𑆤𑆑𑆥𑆴𑆠𑇀𑆡𑆪𑆾𑆂𑇆𑇙𑇗𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆲𑆫𑆿, 𑆥𑆽𑆠𑇀𑆠𑆼 𑆱𑆫𑇀𑆮𑆡𑆽𑆮𑆳𑆱𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆘𑆴𑆠𑇀𑇅 𑆩𑆣𑆶𑆑𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆬𑆾𑆣𑇀𑆫𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆱𑆿𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆴𑆑𑆳𑆁 𑆩𑆣𑆶𑇆𑇙𑇘𑇆
𑆩𑆢𑇀𑆪𑆽𑆫𑇀𑆤𑆴𑆩𑇀𑆧𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆿 𑆮𑆳 𑆑𑆦𑆘𑆼𑇁𑆱𑆸𑆓𑇀𑆢𑆫𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆩𑆲𑆳𑆠𑆴𑆑𑇀𑆠𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑇁𑆱𑆸𑆓𑇀𑆢𑆫𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇙𑇙𑇆
𑆲𑆴𑆠𑆁 𑆓𑆫𑇀𑆨𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆼 𑆪𑆖𑇀𑆖𑆾𑆑𑇀𑆠𑆁 𑆠𑆖𑇀𑆖 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇅𑇑𑇐𑇐𑇅 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆑𑆶𑆛𑆘𑆑𑇀𑆮𑆳𑆡𑆱𑆴𑆢𑇀𑆣𑆩𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆤𑆳𑇆𑇑𑇐𑇐𑇆
𑆫𑆑𑇀𑆠𑆪𑆾𑆤𑇀𑆪𑆫𑆘𑆱𑇀𑆑𑆳𑆤𑆳𑆁 𑆥𑆶𑆠𑇀𑆫𑆔𑇀𑆤𑇀𑆪𑆳𑆯𑇀𑆖 𑆲𑆴𑆠𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆩𑆸𑆓𑆳𑆘𑆳𑆮𑆴𑆮𑆫𑆳𑆲𑆳𑆱𑆸𑆓𑇀𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆦𑆬𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑇆𑇑𑇐𑇑𑇆
𑆑𑆦𑆮𑆳𑆠𑆼 𑆖 𑆢𑆳𑆠𑆮𑇀𑆪𑆁 𑆠𑆽𑆬𑆩𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆤𑆳𑇅 𑆓𑆾𑆥𑆴𑆠𑇀𑆠𑆼 𑆩𑆠𑇀𑆱𑇀𑆪𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆳 𑆑𑇀𑆰𑆿𑆩𑆁 𑆠𑇀𑆫𑆴𑆂𑆱𑆥𑇀𑆠𑆨𑆳𑆮𑆴𑆠𑆩𑇀𑇆𑇑𑇐𑇓𑇆
𑆩𑆣𑆶𑆤𑆳 𑆑𑆴𑆟𑇀𑆮𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆢𑆢𑇀𑆪𑆳𑆢𑆖𑆫𑆟𑆳𑆥𑆲𑆩𑇀𑇅 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆯𑆾𑆣𑆤𑆁 𑆑𑆟𑇀𑆝𑆷𑆑𑇀𑆬𑆼𑆢𑆯𑆾𑆦𑆲𑆫𑆁 𑆖 𑆠𑆠𑇀𑇆𑇑𑇐𑇔𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆽𑆂 𑆯𑆠𑆥𑆳𑆑𑆽𑆯𑇀𑆖 𑆠𑆽𑆬𑆽𑆂 𑆥𑇀𑆫𑆳𑆓𑆠𑆴𑆖𑆳𑆫𑆴𑆟𑆵𑇅 𑆄𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆳 𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆳 𑆖 𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳 𑆖𑆳𑆤𑆴𑆬𑆱𑆷𑆢𑆤𑆽𑆂𑇆𑇑𑇐𑇕𑇆

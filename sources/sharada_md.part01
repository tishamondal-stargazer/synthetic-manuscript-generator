𑆪𑆱𑇀𑆪 𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆮𑆴𑆫𑆼𑆑𑆾 𑆮𑆳 𑆢𑆯𑆤𑆳𑆂 𑆥𑇀𑆫𑆥𑆠𑆤𑇀𑆠𑆴 𑆮𑆳 𑇅 𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆁 𑆑𑆴𑆁𑆯𑆶𑆑𑆁 𑆪𑆷𑆥𑆁 𑆮𑆬𑇀𑆩𑆵𑆑𑆁 𑆥𑆳𑆫𑆴𑆨𑆢𑇀𑆫𑆑𑆩𑇀 𑇆𑇖𑇔𑇆
𑆥𑆶𑆰𑇀𑆥𑆳𑆞𑇀𑆪𑆁 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆁 𑆮𑆳 𑆖𑆴𑆠𑆳𑆁 𑆮𑆳 𑆪𑆾𑇁𑆣𑆴𑆫𑆾𑆲𑆠𑆴 𑇅 𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆠𑆽𑆬𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆬𑆾𑆲𑆳𑆤𑆴 𑆬𑆮𑆟𑆁 𑆠𑆴𑆬𑆳𑆤𑇀 𑇆𑇖𑇕𑇆
𑆬𑆨𑆼𑆠𑆳𑆯𑇀𑆤𑆵𑆠 𑆮𑆳 𑆥𑆑𑇀𑆮𑆩𑆤𑇀𑆤𑆁 𑆪𑆯𑇀𑆖 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆶𑆫𑆳𑆩𑇀 𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆂 𑆱 𑆬𑆨𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆾 𑆩𑆸𑆠𑇀𑆪𑆶𑆩𑆸𑆖𑇀𑆗𑆠𑆴 𑇆𑇖𑇖𑇆
𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆮𑆥𑇀𑆤𑆾 𑆮𑆴𑆱𑇀𑆩𑆸𑆠𑆾 𑆮𑆴𑆲𑆠𑆱𑇀𑆠𑆡𑆳 𑇅 𑆖𑆴𑆤𑇀𑆠𑆳𑆑𑆸𑆠𑆾 𑆢𑆴𑆮𑆳 𑆢𑆸𑆰𑇀𑆛𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆦𑆬𑆢𑆳𑆱𑇀𑆠𑆶 𑆠𑆼 𑇆𑇖𑇗𑇆
𑆘𑇀𑆮𑆫𑆴𑆠𑆳𑆤𑆳𑆁 𑆯𑆶𑆤𑆳 𑆱𑆒𑇀𑆪𑆁 𑆑𑆥𑆴𑆱𑆒𑇀𑆪𑆁 𑆠𑆶 𑆯𑆾𑆰𑆴𑆟𑆳𑆩𑇀 𑇅 𑆇𑆤𑇀𑆩𑆳𑆢𑆼 𑆫𑆳𑆑𑇀𑆰𑆱𑆽𑆂 𑆥𑇀𑆫𑆼𑆠𑆽𑆫𑆥𑆱𑇀𑆩𑆳𑆫𑆼 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆩𑇀 𑇆𑇖𑇘𑇆
𑆩𑆼𑆲𑆳𑆠𑆴𑆱𑆳𑆫𑆴𑆟𑆳𑆁 𑆠𑆾𑆪𑆥𑆳𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆩𑇀 𑇅 𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑆶 𑆱𑇀𑆡𑆳𑆮𑆫𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆑𑆾𑆰𑇀𑆜𑆼, 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆴 𑇆𑇖𑇙𑇆
𑆯𑆰𑇀𑆑𑆶𑆬𑆵𑆨𑆑𑇀𑆰𑆟𑆁 𑆗𑆫𑇀𑆢𑇀𑆪𑆳𑆩𑆣𑇀𑆮𑆳 𑆯𑇀𑆮𑆳𑆱𑆥𑆴𑆥𑆳𑆱𑆪𑆾𑆂 𑇅 𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆁 𑆨𑆾𑆘𑆤𑆁 𑆮𑆳𑇁𑆥𑆴 𑆪𑆱𑇀𑆪 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆂 𑇆𑇗𑇐𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆵 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆱𑇀𑆠𑆶 𑆯𑆾𑆟𑆴𑆠𑆁 𑆱 𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑆴 𑇅𑇗𑇑𑇅 𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆤𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑇀 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆠𑇀𑆡𑆳𑆪 𑆪𑆠𑇀𑆤𑆮𑆳𑆤𑇀 𑇆𑇗𑇑𑇆
𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆰𑆳𑆁𑆱𑇀𑆠𑆴𑆬𑆳𑆁𑆬𑇀𑆬𑆾𑆲𑆁 𑆮𑆴𑆥𑇀𑆫𑆼𑆨𑇀𑆪𑆂 𑆑𑆳𑆚𑇀𑆖𑆤𑆁 𑆠𑆡𑆳 𑇅 𑆘𑆥𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆯𑆶𑆨𑆳𑆤𑇀 𑆩𑆤𑇀𑆠𑇀𑆫𑆳𑆤𑇀 𑆓𑆳𑆪𑆠𑇀𑆫𑆵𑆁 𑆠𑇀𑆫𑆴𑆥𑆢𑆳𑆁 𑆠𑆡𑆳 𑇆𑇗𑇒𑇆
𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆠𑆶 𑆥𑇀𑆫𑆡𑆩𑆼 𑆪𑆳𑆩𑆼 𑆱𑇀𑆮𑆥𑇀𑆪𑆳𑆢𑇀 𑆣𑇀𑆪𑆳𑆠𑇀𑆮𑆳 𑆥𑆶𑆤𑆂 𑆯𑆶𑆨𑆩𑇀 𑇅 𑆘𑆥𑆼𑆢𑇀𑆮𑆳𑇁𑆤𑇀𑆪𑆠𑆩𑆁 𑆮𑆼𑆢𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆵 𑆱𑆩𑆳𑆲𑆴𑆠𑆂 𑇆𑇗𑇓𑇆
𑆤 𑆖𑆳𑆖𑆑𑇀𑆰𑆵𑆠 𑆑𑆱𑇀𑆩𑆽𑆖𑆴𑆢𑇀𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆯𑆾𑆨𑆤𑆩𑇀 𑇅 𑆢𑆼𑆮𑆠𑆳𑆪𑆠𑆤𑆼 𑆖𑆽𑆮 𑆮𑆱𑆼𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆴𑆠𑇀𑆫𑆪𑆁 𑆠𑆡𑆳 𑇅 𑆮𑆴𑆥𑇀𑆫𑆳𑆁𑆯𑇀𑆖 𑆥𑆷𑆘𑆪𑆼𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆁 𑆢𑆶𑆂𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇗𑇔𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇅 𑆢𑆼𑆮𑆳𑆤𑇀 𑆢𑇀𑆮𑆴𑆘𑆳𑆤𑇀𑆓𑆾𑆮𑆸𑆰𑆨𑆳𑆤𑇀 𑆘𑆵𑆮𑆠𑆂 𑆱𑆶𑆲𑆸𑆢𑆾 𑆤𑆸𑆥𑆳𑆤𑇀 𑇆𑇗𑇕𑇆
𑆱𑆩𑆴𑆢𑇀𑆣𑆩𑆓𑇀𑆤𑆴𑆁 𑆱𑆳𑆣𑆷𑆁𑆯𑇀𑆖 𑆤𑆴𑆫𑇀𑆩𑆬𑆳𑆤𑆴 𑆘𑆬𑆳𑆤𑆴 𑆖 𑇅 𑆥𑆯𑇀𑆪𑆼𑆠𑇀 𑆑𑆬𑇀𑆪𑆳𑆟𑆬𑆳𑆨𑆳𑆪 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆥𑆓𑆩𑆳𑆪 𑆖 𑇆𑇗𑇖𑇆

𑆠𑆢𑆼𑆮𑆳𑆮𑆤𑆴𑆥𑆠𑆴𑆠𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆫𑆱𑆩𑆶𑆥𑆬𑆨𑆠𑆼 𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀𑆤𑆢𑆵𑆤𑆢𑆱𑆫𑆱𑇀𑆠𑆝𑆳𑆓𑆮𑆳𑆥𑆵𑆑𑆷𑆥𑆖𑆶𑆟𑇀𑆛𑆵𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆟𑆾𑆢𑇀𑆨𑆴𑆢𑆮𑆴𑆑𑆴𑆫𑆑𑆼𑆢𑆳𑆫𑆥𑆬𑇀𑆮𑆬𑆳𑆢𑆴 𑆰𑆶 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑇀𑆮𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫, ‘𑆬𑆾𑆲𑆴𑆠𑆑𑆥𑆴𑆬𑆥𑆳𑆟𑇀𑆝𑆶𑆤𑆵𑆬𑆥𑆵𑆠𑆯𑆶𑆑𑇀𑆬𑆼𑆰𑇀𑆮𑆮𑆤𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆼𑆰𑆶 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆟𑆴 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆩𑆶𑆢𑆑𑆳𑆤𑆴 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴’ 𑆅𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼 𑇆𑇕𑇆
𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀; 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆤𑆶𑆥𑇀𑆫𑆮𑆼𑆯𑆑𑆸𑆠𑆂 𑆱𑆬𑆴𑆬𑆫𑆱𑆾 𑆨𑆮𑆠𑇀𑆪𑆶𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆥𑆑𑆫𑇀𑆰𑆼𑆟 𑇅 𑆠𑆠𑇀𑆫, 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆨𑆷𑆩𑆳𑆮𑆩𑇀𑆬𑆁 𑆬𑆮𑆟𑆁 𑆖; 𑆃𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆩𑆣𑆶𑆫𑆁; 𑆠𑆼𑆘𑆾𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆑𑆛𑆶𑆑𑆁 𑆠𑆴𑆑𑇀𑆠𑆁 𑆖; 𑆮𑆳𑆪𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆁 𑆑𑆰𑆳𑆪𑆩𑇀; 𑆄𑆑𑆳𑆯𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆩𑇀, 𑆃𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆲𑇀𑆪𑆳𑆑𑆳𑆯𑆩𑆴𑆠𑇀𑆪𑆠𑆂; 𑆠𑆠𑇀 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆠𑇀𑆮𑆳𑆠𑇀, 𑆠𑆠𑇀𑆥𑆼𑆪𑆩𑆳𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆳𑆬𑆳𑆨𑆼 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑇀 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆣𑆳𑆫𑆁, 𑆑𑆳𑆫𑆁, 𑆠𑆿𑆰𑆳𑆫𑆁, 𑆲𑆽𑆩𑆩𑆴𑆠𑆴 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆣𑆳𑆫𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁- 𑆓𑆳𑆕𑇀𑆓𑆁, 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆓𑆳𑆕𑇀𑆓𑆩𑆳𑆯𑇀𑆮𑆪𑆶𑆘𑆼 𑆩𑆳𑆱𑆴 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆮𑆫𑇀𑆰𑆠𑆴 𑇅 𑆠𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆫𑆥𑆴 𑆥𑆫𑆵𑆑𑇀𑆰𑆟𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠- 𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆥𑆴𑆟𑇀𑆝𑆩𑆑𑆶𑆡𑆴𑆠𑆩𑆮𑆴𑆢𑆓𑇀𑆣𑆁 𑆫𑆘𑆠𑆨𑆳𑆘𑆤𑆾𑆥𑆲𑆴𑆠𑆁 𑆮𑆫𑇀𑆰𑆠𑆴 𑆢𑆼𑆮𑆼 𑆧𑆲𑆴𑆰𑇀𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆱 𑆪𑆢𑆴 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆁 𑆱𑇀𑆡𑆴𑆠𑆱𑇀𑆠𑆳𑆢𑆸𑆯 𑆍𑆮 𑆨𑆮𑆠𑆴 𑆠𑆢𑆳 𑆓𑆳𑆕𑇀𑆓𑆁 𑆥𑆠𑆠𑆵𑆠𑇀𑆪𑆮𑆓𑆤𑇀𑆠𑆮𑇀𑆪𑆁; 𑆮𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆠𑇀𑆮𑆼 𑆱𑆴𑆑𑇀𑆡𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆼 𑆖 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆠𑆤𑇀𑆤𑆾𑆥𑆳𑆢𑆼𑆪𑆩𑇀 𑇅 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆩𑆥𑇀𑆪𑆳𑆯𑇀𑆮𑆪𑆶𑆘𑆼 𑆩𑆳𑆱𑆴 𑆓𑆸𑆲𑆵𑆠𑆁 𑆓𑆳𑆕𑇀𑆓𑆮𑆢𑇀𑆨𑆮𑆠𑆴 𑇅 𑆓𑆳𑆕𑇀𑆓𑆁 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆠𑆢𑆶𑆥𑆳𑆢𑆢𑆵𑆠𑆳𑆯𑇀𑆮𑆪𑆶𑆘𑆼 𑆩𑆳𑆱𑆴 𑇅 𑆯𑆶𑆖𑆴𑆯𑆶𑆑𑇀𑆬𑆮𑆴𑆠𑆠𑆥𑆛𑆽𑆑𑆢𑆼𑆯𑆖𑇀𑆪𑆶𑆠𑆩𑆡𑆮𑆳 𑆲𑆫𑇀𑆩𑇀𑆪𑆠𑆬𑆥𑆫𑆴𑆨𑇀𑆫𑆰𑇀𑆛𑆩𑆤𑇀𑆪𑆽𑆫𑇀𑆮𑆳 𑆯𑆶𑆖𑆴𑆨𑆴𑆫𑇀𑆨𑆳𑆘𑆤𑆽𑆫𑇀𑆓𑆸𑆲𑆵𑆠𑆁 𑆱𑆿𑆮𑆫𑇀𑆟𑆼 𑆫𑆳𑆘𑆠𑆼 𑆩𑆸𑆤𑇀𑆩𑆪𑆼 𑆮𑆳 𑆥𑆳𑆠𑇀𑆫𑆼 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆠𑆱𑇀𑆪𑆳𑆬𑆳𑆨𑆼 𑆨𑆿𑆩𑆩𑇀 𑇅 𑆠𑆖𑇀𑆖𑆳𑆑𑆳𑆯𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆩𑇀 𑇅 𑆠𑆠𑇀 𑆥𑆶𑆤𑆂 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆩𑇀 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆿𑆥𑆁, 𑆤𑆳𑆢𑆼𑆪𑆁, 𑆱𑆳𑆫𑆱𑆁, 𑆠𑆳𑆝𑆳𑆓𑆁, 𑆥𑇀𑆫𑆳𑆱𑇀𑆫𑆮𑆟𑆩𑇀, 𑆐𑆢𑇀𑆨𑆴𑆢𑆁, 𑆖𑆿𑆟𑇀𑆛𑇀𑆪𑆩𑆴𑆠𑆴 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆮𑆫𑇀𑆰𑆳𑆱𑇀𑆮𑆳𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆩𑆿𑆢𑇀𑆨𑆴𑆢𑆁 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆩𑆲𑆳𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆠𑇀; 𑆯𑆫𑆢𑆴 𑆱𑆫𑇀𑆮𑆁, 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆠𑇀𑆮𑆳𑆠𑇀; 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆱𑆳𑆫𑆱𑆁 𑆠𑆳𑆝𑆳𑆓𑆁 𑆮𑆳; 𑆮𑆱𑆤𑇀𑆠𑆼 𑆑𑆿𑆥𑆁 𑆥𑇀𑆫𑆳𑆱𑇀𑆫𑆮𑆟𑆁 𑆮𑆳; 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁; 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆴 𑆖𑆿𑆟𑇀𑆛𑇀𑆪𑆩𑆤𑆨𑆴𑆮𑆸𑆰𑇀𑆛𑆁 𑆱𑆫𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑇆𑇘𑇆
𑆑𑆵𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑇀𑆝𑆯𑆮𑆑𑆾𑆡𑆥𑇀𑆫𑆢𑆷𑆰𑆴𑆠𑆩𑇀 𑇅 𑆠𑆸𑆟𑆥𑆫𑇀𑆟𑆾𑆠𑇀𑆑𑆫𑆪𑆶𑆠𑆁 𑆑𑆬𑆶𑆰𑆁 𑆮𑆴𑆰𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇆𑇙𑇆
𑆪𑆾𑇁𑆮𑆓𑆳𑆲𑆼𑆠 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆤𑆮𑆁 𑆘𑆬𑆩𑇀 𑇅 𑆱 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆼𑆮 𑆠𑆶 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆪𑆠𑇀 𑆥𑆕𑇀𑆑𑆯𑆽𑆮𑆬𑆲𑆜𑆠𑆸𑆟𑆥𑆢𑇀𑆩𑆥𑆠𑇀𑆫𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑆮𑆖𑇀𑆗𑆤𑇀𑆤𑆁 𑆫𑆮𑆴𑆯𑆯𑆴𑆑𑆴𑆫𑆟𑆳𑆤𑆴𑆬𑆽𑆫𑇀𑆤𑆳𑆨𑆴𑆘𑆶𑆰𑇀𑆛𑆁 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆁 𑆠𑆢𑇀𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆱𑇀𑆪 𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆢𑆾𑆰𑆳𑆂 𑆰𑆛𑇀 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆒𑆫𑆠𑆳 𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆩𑆿𑆰𑇀𑆟𑇀𑆪𑆁 𑆢𑆤𑇀𑆠𑆓𑇀𑆫𑆳𑆲𑆴𑆠𑆳 𑆖 𑆱𑇀𑆥𑆫𑇀𑆯𑆢𑆾𑆰𑆂, 𑆥𑆕𑇀𑆑𑆱𑆴𑆑𑆠𑆳𑆯𑆽𑆮𑆳𑆬𑆧𑆲𑆶𑆮𑆫𑇀𑆟𑆠𑆳 𑆫𑆷𑆥𑆢𑆾𑆰𑆂; 𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆠𑆳 𑆫𑆱𑆢𑆾𑆰𑆂; 𑆃𑆤𑆴𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆠𑆳 𑆓𑆤𑇀𑆣𑆢𑆾𑆰𑆂; 𑆪𑆢𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆓𑆿𑆫𑆮𑆯𑆷𑆬𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆤𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑆱 𑆮𑆴𑆫𑇀𑆪𑆢𑆾𑆰𑆂; 𑆪𑆢𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆁 𑆖𑆴𑆫𑆳𑆢𑇀𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆪𑆠𑆴 𑆮𑆳 𑆱 𑆮𑆴𑆥𑆳𑆑𑆢𑆾𑆰 𑆅𑆠𑆴 𑇅 𑆠 𑆍𑆠𑆼 𑆄𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆼 𑆤 𑆱𑆤𑇀𑆠𑆴 𑇆𑇑𑇑𑇆
𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆱𑇀𑆪 𑆖𑆳𑆓𑇀𑆤𑆴𑆑𑇀𑆮𑆡𑆤𑆁 𑆱𑆷𑆫𑇀𑆪𑆳𑆠𑆥𑆥𑇀𑆫𑆠𑆳𑆥𑆤𑆁 𑆠𑆥𑇀𑆠𑆳𑆪𑆂𑆥𑆴𑆟𑇀𑆝𑆱𑆴𑆑𑆠𑆳𑆬𑆾𑆰𑇀𑆛𑇀𑆫𑆳𑆟𑆳𑆁 𑆮𑆳 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆟𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆁 𑆖 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆁, 𑆤𑆳𑆓𑆖𑆩𑇀𑆥𑆑𑆾𑆠𑇀𑆥𑆬𑆥𑆳𑆛𑆬𑆳𑆥𑆶𑆰𑇀𑆥𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆯𑇀𑆖𑆳𑆣𑆴𑆮𑆳𑆱𑆤𑆩𑆴𑆠𑆴 𑇆𑇑𑇒𑇆
𑆱𑆿𑆮𑆫𑇀𑆟𑆼 𑆫𑆳𑆘𑆠𑆼 𑆠𑆳𑆩𑇀𑆫𑆼 𑆑𑆳𑆁𑆱𑇀𑆪𑆼 𑆩𑆟𑆴𑆩𑆪𑆼𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆥𑆶𑆰𑇀𑆥𑆳𑆮𑆠𑆁𑆱𑆁 𑆨𑆿𑆩𑆼 𑆮𑆳 𑆱𑆶𑆓𑆤𑇀𑆣𑆴 𑆱𑆬𑆴𑆬𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇑𑇓𑇆
𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆁 𑆮𑆫𑇀𑆘𑆪𑆼𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆁 𑆠𑆾𑆪𑆁 𑆪𑆖𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆳𑆫𑇀𑆠𑆮𑆩𑇀 𑇅 𑆢𑆾𑆰𑆱𑆚𑇀𑆘𑆤𑆤𑆁 𑆲𑇀𑆪𑆼𑆠𑆤𑇀𑆤𑆳𑆢𑆢𑆵𑆠𑆳𑆲𑆴𑆠𑆁 𑆠𑆶 𑆠𑆠𑇀 𑇆𑇑𑇔𑇆
𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆩𑆶𑆢𑆑𑆁 𑆪𑆱𑇀𑆠𑆶 𑆥𑆴𑆧𑆠𑆵𑆲𑆳𑆥𑇀𑆫𑆱𑆳𑆢𑆴𑆠𑆩𑇀 𑇅 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆖 𑆠𑇀𑆮𑆓𑇀𑆢𑆾𑆰𑆩𑆮𑆴𑆥𑆳𑆑𑆠𑆳𑆩𑇀 𑇆𑇑𑇕𑇆
𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆯𑆷𑆬𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆟𑆴 𑆖 𑇅 𑆃𑆤𑇀𑆪𑆳𑆤𑇀𑆮𑆳 𑆮𑆴𑆰𑆩𑆳𑆤𑇀𑆫𑆾𑆓𑆳𑆤𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆢𑆖𑆴𑆫𑆼𑆟 𑆱𑆂 𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫 𑆱𑆥𑇀𑆠 𑆑𑆬𑆶𑆰𑆱𑇀𑆪 𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆠𑆑𑆓𑆾𑆩𑆼𑆢𑆑𑆧𑆴𑆱𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆯𑆽𑆮𑆳𑆬𑆩𑆷𑆬𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆩𑆶𑆑𑇀𑆠𑆳𑆩𑆟𑆴𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇗𑇆
𑆥𑆚𑇀𑆖 𑆤𑆴𑆑𑇀𑆰𑆼𑆥𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆦𑆬𑆑𑆁, 𑆠𑇀𑆫𑇀𑆪𑆰𑇀𑆛𑆑𑆁, 𑆩𑆶𑆚𑇀𑆘𑆮𑆬𑆪, 𑆇𑆢𑆑𑆩𑆚𑇀𑆖𑆴𑆑𑆳, 𑆯𑆴𑆑𑇀𑆪𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇘𑇆
𑆱𑆥𑇀𑆠 𑆯𑆵𑆠𑆵𑆑𑆫𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆮𑆳𑆠𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑇀, 𑆇𑆢𑆑𑆥𑇀𑆫𑆑𑇀𑆰𑆼𑆥𑆟𑆁, 𑆪𑆰𑇀𑆛𑆴𑆑𑆳𑆨𑇀𑆫𑆳𑆩𑆟𑆁, 𑆮𑇀𑆪𑆘𑆤𑆁, 𑆮𑆱𑇀𑆠𑇀𑆫𑆾𑆢𑇀𑆣𑆫𑆟𑆁, 𑆮𑆳𑆬𑆶𑆑𑆳𑆥𑇀𑆫𑆑𑇀𑆰𑆼𑆥𑆟𑆁, 𑆯𑆴𑆑𑇀𑆪𑆳𑆮𑆬𑆩𑇀𑆧𑆤𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇙𑇆
𑆤𑆴𑆫𑇀𑆓𑆤𑇀𑆣𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆔𑇀𑆤𑆁 𑆯𑆶𑆖𑆴 𑆯𑆵𑆠𑆬𑆩𑇀 𑇅 𑆃𑆖𑇀𑆗𑆁 𑆬𑆔𑆶 𑆖 𑆲𑆸𑆢𑇀𑆪𑆁 𑆖 𑆠𑆾𑆪𑆁 𑆓𑆶𑆟𑆮𑆢𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇐𑇆
𑆠𑆠𑇀𑆫 𑆤𑆢𑇀𑆪𑆂 𑆥𑆯𑇀𑆖𑆴𑆩𑆳𑆨𑆴𑆩𑆶𑆒𑆳𑆂 𑆥𑆡𑇀𑆪𑆳𑆂, 𑆬𑆔𑆷𑆢𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆥𑆷𑆫𑇀𑆮𑆳𑆨𑆴𑆩𑆶𑆒𑆳𑆱𑇀𑆠𑆶 𑆤 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼, 𑆓𑆶𑆫𑆷𑆢𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆨𑆴𑆩𑆶𑆒𑆳 𑆤𑆳𑆠𑆴𑆢𑆾𑆰𑆬𑆳𑆂, 𑆱𑆳𑆣𑆳𑆫𑆟𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆲𑇀𑆪𑆥𑇀𑆫𑆨𑆮𑆳𑆂𑆑𑆶𑆰𑇀𑆜𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆮𑆴𑆤𑇀𑆣𑇀𑆪𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆖, 𑆩𑆬𑆪𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆑𑆸𑆩𑆵𑆤𑇀, 𑆩𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆯𑇀𑆬𑆵𑆥𑆢𑆾𑆢𑆫𑆳𑆟𑆴, 𑆲𑆴𑆩𑆮𑆠𑇀𑆥𑇀𑆫𑆨𑆮𑆳 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆯𑇀𑆮𑆪𑆡𑆶𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆯𑇀𑆬𑆵𑆥𑆢𑆓𑆬𑆓𑆟𑇀𑆝𑆳𑆤𑇀, 𑆥𑇀𑆫𑆳𑆖𑇀𑆪𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆳 𑆃𑆥𑆫𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆫𑇀𑆯𑆳𑆁𑆱𑇀𑆪𑆶𑆥𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆥𑆳𑆫𑆴𑆪𑆳𑆠𑇀𑆫𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆥𑆡𑇀𑆪𑆳 𑆧𑆬𑆳𑆫𑆾𑆓𑇀𑆪𑆑𑆫𑇀𑆪 𑆅𑆠𑆴 𑇆𑇒𑇑𑇆
𑆤𑆢𑇀𑆪𑆂 𑆯𑆵𑆔𑇀𑆫𑆮𑆲𑆳 𑆬𑆔𑇀𑆮𑇀𑆪𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆪𑆳𑆯𑇀𑆖𑆳𑆩𑆬𑆾𑆢𑆑𑆳𑆂 𑇅 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆂 𑆯𑆽𑆮𑆳𑆬𑆱𑆚𑇀𑆗𑆤𑇀𑆤𑆳𑆂 𑆑𑆬𑆶𑆰𑆳 𑆩𑆤𑇀𑆢𑆓𑆳𑆯𑇀𑆖 𑆪𑆳𑆂 𑇆𑇒𑇒𑇆
𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆤𑆢𑇀𑆪𑆾 𑆩𑆫𑆶𑆰𑆶 𑆱𑆠𑆴𑆑𑇀𑆠𑆳 𑆬𑆮𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆂 𑇅 𑆬𑆔𑇀𑆮𑇀𑆪𑆂 𑆱𑆩𑆣𑆶𑆫𑆳𑆯𑇀𑆖𑆽𑆮 𑆥𑆿𑆫𑆶𑆰𑆼𑆪𑆳 𑆧𑆬𑆼 𑆲𑆴𑆠𑆳𑆂 𑇆𑇒𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆨𑆿𑆩𑆳𑆤𑆳𑆁 𑆓𑇀𑆫𑆲𑆟𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆰𑆱𑆴, 𑆠𑆠𑇀𑆫 𑆲𑇀𑆪𑆩𑆬𑆠𑇀𑆮𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆖𑆳𑆣𑆴𑆑𑆁 𑆨𑆮𑆠𑆴, 𑆱 𑆍𑆮 𑆖𑆳𑆥𑆳𑆁 𑆥𑆫𑆾 𑆓𑆶𑆟 𑆅𑆠𑆴 𑇆𑇒𑇔𑇆

𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆮𑆼𑆢𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆧𑆸𑆁𑆲𑆟𑆁 𑆓𑆶𑆝𑆴𑆑𑆳𑆂𑇅 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆑𑆿 𑆩𑆾𑆑𑇀𑆰𑆂 𑆑𑇀𑆰𑆠𑆘𑆱𑇀𑆪 𑆖 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆮𑆠𑆳𑆩𑇀𑇆𑇑𑇘𑇓𑇆
𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆠𑆴𑆑𑇀𑆠𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑇀𑆫𑆱𑇀𑆫𑆁𑆱𑆤𑆁 𑆤𑆴𑆫𑆷𑆲𑆳𑆯𑇀𑆖𑇅 𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆮𑆱𑆼𑆖𑆤𑆩𑆳𑆯𑇀𑆮𑆳𑆱𑆤𑆱𑆁𑆯𑆩𑆤𑆪𑆾𑆓𑆳𑆂𑇆𑇑𑇘𑇔𑇆
𑆇𑆥𑆤𑆳𑆲𑆤𑆁 𑆱𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆑𑇀𑆮𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆥𑇀𑆫𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑇅 𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆁𑆯𑆩𑆤𑆼 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆨𑆮𑆱𑇀𑆪 𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆪𑇆𑇑𑇘𑇕𑇆
𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆮𑆼𑆢𑆾 𑆨𑆼𑆢𑆾 𑆬𑆕𑇀𑆔𑆤𑆩𑆶𑆬𑇀𑆬𑆼𑆒𑆤𑆁 𑆮𑆴𑆫𑆼𑆑𑆯𑇀𑆖𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆓𑆶𑆛𑆴𑆑𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆩𑆫𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆱𑆑𑇀𑆰𑆳𑆫𑆳𑆂𑇆𑇑𑇘𑇖𑇆
𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆼 𑆢𑆳𑆲𑆂 𑆑𑆦𑆘𑆱𑇀𑆪𑆳𑆓𑇀𑆫𑆼𑇁𑆥𑆤𑆵𑆠𑆫𑆑𑇀𑆠𑆱𑇀𑆪𑇅 𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆪 𑆫𑆿𑆣𑆴𑆫𑆱𑇀𑆪 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆫𑆩𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆨𑆮𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆂𑇆𑇑𑇘𑇗𑇆
𑆥𑆡𑇀𑆪𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆱𑆼𑆮𑆳 𑆲𑆼𑆠𑆷𑆤𑆳𑆁 𑆮𑆫𑇀𑆘𑆤𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆖𑇅 𑆤𑆴𑆠𑇀𑆪𑆁 𑆖𑆳𑆓𑇀𑆤𑆴𑆱𑆩𑆳𑆣𑆴𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆖 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆳𑆟𑆴𑇆𑇑𑇘𑇘𑇆
𑆲𑆼𑆠𑆶𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆫𑆩𑆂 𑆱𑆳𑆣𑇀𑆪𑆠𑆳 𑆤 𑆪𑆾𑆓𑆳𑆯𑇀𑆖𑇅 𑆓𑆶𑆬𑇀𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆱𑆕𑇀𑆓𑇀𑆫𑆲 𑆍𑆠𑆳𑆮𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆲𑆸𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆱𑇀𑆪𑇆𑇑𑇘𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆤𑆴𑆫𑇀𑆩𑆾𑆲𑆩𑆳𑆤𑆳𑆤𑆶𑆯𑆪𑆾 𑆤𑆴𑆫𑆳𑆯𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆠𑆥𑆾𑆮𑆴𑆯𑆳𑆬𑆂𑇅 𑆑𑆳𑆬𑆼𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆳𑆪 𑆱𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆶𑆮𑆳𑆖 𑆩𑆼𑆲𑆳𑆚𑇀𑆯𑆩𑆤𑆁 𑆖 𑆠𑆼𑆰𑆳𑆩𑇀𑇆𑇓𑇆
𑆄𑆱𑇀𑆪𑆳𑆱𑆶𑆒𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆶𑆒𑆁 𑆢𑆣𑆵𑆤𑆴 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆿𑆢𑆑𑆳𑆤𑆷𑆥𑆫𑆱𑆳𑆂 𑆥𑆪𑆳𑆁𑆱𑆴𑇅 𑆤𑆮𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆓𑆶𑆝𑆮𑆽𑆑𑆸𑆠𑆁 𑆖 𑆥𑇀𑆫𑆩𑆼𑆲𑆲𑆼𑆠𑆶𑆂 𑆑𑆦𑆑𑆸𑆖𑇀𑆖 𑆱𑆫𑇀𑆮𑆩𑇀𑇆𑇔𑇆
𑆩𑆼𑆢𑆯𑇀𑆖 𑆩𑆳𑆁𑆱𑆁 𑆖 𑆯𑆫𑆵𑆫𑆘𑆁 𑆖 𑆑𑇀𑆬𑆼𑆢𑆁 𑆑𑆦𑆾 𑆧𑆱𑇀𑆠𑆴𑆓𑆠𑆁 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪𑇅 𑆑𑆫𑆾𑆠𑆴 𑆩𑆼𑆲𑆳𑆤𑇀 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆽𑆱𑇀𑆠𑆳𑆤𑆼𑆮 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑆫𑆴𑆢𑆷𑆰𑇀𑆪 𑆖𑆳𑆥𑆴𑇆𑇕𑇆
𑆑𑇀𑆰𑆵𑆟𑆼𑆰𑆶 𑆢𑆾𑆰𑆼𑆰𑇀𑆮𑆮𑆑𑆸𑆰𑇀𑆪 𑆧𑆱𑇀𑆠𑆿 𑆣𑆳𑆠𑆷𑆤𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑆤𑆴𑆬𑆂 𑆑𑆫𑆾𑆠𑆴𑇅 𑆢𑆾𑆰𑆾 𑆲𑆴 𑆧𑆱𑇀𑆠𑆴𑆁 𑆱𑆩𑆶𑆥𑆼𑆠𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆤𑇀𑆢𑆷𑆰𑇀𑆪 𑆩𑆼𑆲𑆳𑆚𑇀𑆘𑆤𑆪𑆼𑆢𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑇀𑇆𑇖𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆂 𑆑𑆦𑆾𑆠𑇀𑆡𑆳 𑆢𑆯, 𑆥𑆴𑆠𑇀𑆠𑆘𑆳𑆂 𑆰𑆛𑇀 𑆪𑆳𑆥𑇀𑆪𑆳, 𑆤 𑆱𑆳𑆣𑇀𑆪𑆂 𑆥𑆮𑆤𑆳𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆑𑆂𑇅 𑆱𑆩𑆑𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆑𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆲𑆳𑆠𑇀𑆪𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆁 𑆠𑆼𑇆𑇗𑇆
𑆑𑆦𑆂 𑆱𑆥𑆴𑆠𑇀𑆠𑆂 𑆥𑆮𑆤𑆯𑇀𑆖 𑆢𑆾𑆰𑆳 𑆩𑆼𑆢𑆾𑇁𑆱𑇀𑆫𑆯𑆶𑆑𑇀𑆫𑆳𑆩𑇀𑆧𑆶𑆮𑆱𑆳𑆬𑆱𑆵𑆑𑆳𑆂𑇅 𑆩𑆘𑇀𑆘𑆳 𑆫𑆱𑆿𑆘𑆂 𑆥𑆴𑆯𑆴𑆠𑆁 𑆖 𑆢𑆷𑆰𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆳𑆁, 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆼𑆮 𑆩𑆼𑆲𑆳𑆂𑇆𑇘𑇆
𑆘𑆬𑆾𑆥𑆩𑆁 𑆖𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆾𑆥𑆩𑆁 𑆮𑆳 𑆔𑆤𑆁 𑆔𑆤𑆁 𑆖𑆾𑆥𑆫𑆴 𑆮𑆴𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆩𑇀𑇅 𑆯𑆶𑆑𑇀𑆬𑆁 𑆱𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆴𑆯𑆴𑆫𑆁 𑆯𑆤𑆽𑆫𑇀𑆮𑆳 𑆬𑆳𑆬𑆼𑆮 𑆮𑆳 𑆮𑆳𑆬𑆶𑆑𑆪𑆳 𑆪𑆶𑆠𑆁 𑆮𑆳𑇆𑇙𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀 𑆑𑆦𑆘𑆳𑆤𑇀 𑆢𑆯𑆽𑆠𑆳𑆤𑇀 𑆑𑇀𑆰𑆳𑆫𑆾𑆥𑆩𑆁 𑆑𑆳𑆬𑆩𑆡𑆳𑆥𑆴 𑆤𑆵𑆬𑆩𑇀𑇅 𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆩𑆳𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆩𑆡𑆳𑆥𑆴 𑆫𑆑𑇀𑆠𑆩𑆼𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀 𑆰𑆝𑆶𑆯𑆤𑇀𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀𑇆𑇑𑇐𑇆
𑆩𑆘𑇀𑆘𑆿𑆘𑆱𑆳 𑆮𑆳 𑆮𑆱𑆪𑆳𑇁𑆤𑇀𑆮𑆴𑆠𑆁 𑆮𑆳 𑆬𑆱𑆵𑆑𑆪𑆳 𑆮𑆳 𑆱𑆠𑆠𑆁 𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑇀𑇅 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆩𑆷𑆠𑇀𑆫𑆪𑆠𑆵𑆲 𑆮𑆳𑆠𑆳𑆖𑇀𑆗𑆼𑆰𑆼𑆰𑆶 𑆣𑆳𑆠𑆶𑆰𑇀𑆮𑆥𑆑𑆫𑇀𑆰𑆴𑆠𑆼𑆰𑆶𑇆𑇑𑇑𑇆
𑆮𑆫𑇀𑆟𑆁 𑆫𑆱𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑆡𑆳𑆥𑆴 𑆓𑆤𑇀𑆣𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆢𑆾𑆰𑆁 𑆨𑆘𑆠𑆼 𑆥𑇀𑆫𑆩𑆼𑆲𑆂𑇅 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆾 𑆮𑆳𑆠𑆑𑆸𑆠𑆂 𑆱𑆯𑆷𑆬𑆾 𑆩𑆘𑇀𑆘𑆳𑆢𑆴𑆱𑆳𑆢𑇀𑆓𑆶𑆟𑇀𑆪𑆩𑆶𑆥𑆽𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆂𑇆𑇑𑇒𑇆
𑆱𑇀𑆮𑆼𑆢𑆾𑇁𑆕𑇀𑆓𑆓𑆤𑇀𑆣𑆂 𑆯𑆴𑆡𑆴𑆬𑆳𑆕𑇀𑆓𑆠𑆳 𑆖 𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆶𑆒𑆼 𑆫𑆠𑆴𑆯𑇀𑆖𑇅 𑆲𑆸𑆤𑇀𑆤𑆼𑆠𑇀𑆫𑆘𑆴𑆲𑇀𑆮𑆳𑆯𑇀𑆫𑆮𑆟𑆾𑆥𑆢𑆼𑆲𑆾 𑆔𑆤𑆳𑆕𑇀𑆓𑆠𑆳 𑆑𑆼𑆯𑆤𑆒𑆳𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆂𑇆𑇑𑇓𑇆
𑆯𑆵𑆠𑆥𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆁 𑆓𑆬𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆾 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆳𑆱𑇀𑆪𑆼 𑆑𑆫𑆥𑆳𑆢𑆢𑆳𑆲𑆂𑇅 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆾 𑆩𑆼𑆲𑆓𑆢𑆱𑇀𑆪 𑆫𑆷𑆥𑆁 𑆩𑆷𑆠𑇀𑆫𑆼𑇁𑆨𑆴𑆣𑆳𑆮𑆤𑇀𑆠𑆴 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆯𑇀𑆖𑇆𑇑𑇔𑇆
𑆱𑇀𑆡𑆷𑆬𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆧𑆬𑆮𑆳𑆤𑆴𑆲𑆽𑆑𑆂 𑆑𑆸𑆯𑆱𑇀𑆠𑆡𑆽𑆑𑆂 𑆥𑆫𑆴𑆢𑆶𑆫𑇀𑆧𑆬𑆯𑇀𑆖𑇅 𑆱𑆩𑇀𑆧𑆸𑆁𑆲𑆟𑆁 𑆠𑆠𑇀𑆫 𑆑𑆸𑆯𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆢𑆾𑆰𑆧𑆬𑆳𑆣𑆴𑆑𑆱𑇀𑆪𑇆𑇑𑇕𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆪𑆾𑆓𑆳 𑆮𑆴𑆮𑆴𑆣𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆂 𑆑𑆬𑇀𑆥𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆳 𑆩𑆬𑆯𑆾𑆣𑆤𑆳𑆪 𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑆡𑆳𑇁𑆣𑆯𑇀𑆖 𑆩𑆬𑆼𑇁𑆥𑆤𑆵𑆠𑆼 𑆩𑆼𑆲𑆼𑆰𑆶 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆩𑆼𑆮 𑆑𑆳𑆫𑇀𑆪𑆩𑇀𑇆𑇑𑇖𑇆
𑆓𑆶𑆬𑇀𑆩𑆂 𑆑𑇀𑆰𑆪𑆾 𑆩𑆼𑆲𑆤𑆧𑆱𑇀𑆠𑆴𑆯𑆷𑆬𑆁 𑆩𑆷𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆥𑆠𑆫𑇀𑆥𑆟𑆼𑆤𑇅 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆴𑆠𑆫𑇀𑆥𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑇀𑆪𑆳𑆟𑆴 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆮𑆲𑇀𑆤𑆴𑆩𑇀𑇆𑇑𑇗𑇆
𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆤𑆳𑆫𑇀𑆲𑆠𑆴 𑆪𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆠𑆱𑇀𑆪 𑆑𑇀𑆫𑆴𑆪𑆳 𑆱𑆁𑆯𑆩𑆤𑆵 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑇅 𑆩𑆤𑇀𑆡𑆳𑆂 𑆑𑆰𑆳𑆪𑆳 𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆬𑆼𑆲𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆽 𑆬𑆔𑆮𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆂𑇆𑇑𑇘𑇆
𑆪𑆼 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆳 𑆪𑆼 𑆥𑇀𑆫𑆠𑆶𑆢𑆳 𑆮𑆴𑆲𑆕𑇀𑆓𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆫𑆱𑆽𑆫𑇀𑆘𑆳𑆕𑇀𑆓𑆬𑆘𑆽𑆫𑇀𑆩𑆤𑆾𑆘𑇀𑆚𑆽𑆂𑇅 𑆪𑆮𑆿𑆢𑆤𑆁 𑆫𑆷𑆑𑇀𑆰𑆩𑆡𑆳𑆥𑆴 𑆮𑆳𑆛𑇀𑆪𑆩𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆱𑆑𑇀𑆠𑆷𑆤𑆥𑆴 𑆖𑆳𑆥𑇀𑆪𑆥𑆷𑆥𑆳𑆤𑇀𑇆𑇑𑇙𑇆
𑆩𑆶𑆢𑇀𑆓𑆳𑆢𑆴𑆪𑆷𑆰𑆽𑆫𑆡 𑆠𑆴𑆑𑇀𑆠𑆯𑆳𑆑𑆽𑆂 𑆥𑆶𑆫𑆳𑆟𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆩𑆳𑆢𑆢𑆵𑆠𑇅 𑆢𑆤𑇀𑆠𑆵𑆕𑇀𑆓𑆶𑆢𑆵𑆠𑆽𑆬𑆪𑆶𑆠𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆠𑆡𑆳𑇁𑆠𑆱𑆵𑆱𑆫𑇀𑆰𑆥𑆠𑆽𑆬𑆪𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇒𑇐𑇆
𑆱𑆰𑆰𑇀𑆛𑆴𑆑𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆸𑆟𑆣𑆳𑆤𑇀𑆪𑆩𑆤𑇀𑆤𑆁 𑆪𑆮𑆥𑇀𑆫𑆣𑆳𑆤𑆱𑇀𑆠𑆶 𑆨𑆮𑆼𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆵𑇅 𑆪𑆮𑆱𑇀𑆪 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆣𑆳𑆁𑆱𑇀𑆠𑆡𑆳𑇁𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆦𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆩𑆣𑆶𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑇆𑇒𑇑𑇆
𑆤𑆴𑆯𑆴𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆰𑆳𑆪𑆼 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆳𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆠𑆳 𑆪𑆮𑆳𑆤𑆳𑆩𑇀𑇅 𑆠𑆳𑆤𑇀 𑆱𑆵𑆣𑆶𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆳𑆤𑇀𑆩𑆼𑆲𑆮𑆣𑆳𑆫𑇀𑆡𑆩𑆼𑆮𑇆𑇒𑇒𑇆
𑆪𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆼𑆲𑆼 𑆮𑆴𑆲𑆴𑆠𑆳𑆂 𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑆽𑆫𑇀𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆥𑆸𑆡𑆓𑇀𑆪𑆮𑆳𑆤𑆳𑆩𑇀𑇅 𑆱𑆑𑇀𑆠𑆷𑆤𑆥𑆷𑆥𑆳𑆤𑇀 𑆱𑆓𑆶𑆝𑆳𑆤𑇀 𑆱𑆣𑆳𑆤𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆁𑆱𑇀𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆳𑆤𑇀 𑆮𑆴𑆮𑆴𑆣𑆳𑆁𑆯𑇀𑆖 𑆒𑆳𑆢𑆼𑆠𑇀𑇆𑇒𑇓𑇆
𑆒𑆫𑆳𑆯𑇀𑆮𑆓𑆾𑆲𑆁𑆱𑆥𑆸𑆰𑆢𑇀𑆨𑆸𑆠𑆳𑆤𑆳𑆁 𑆠𑆡𑆳 𑆪𑆮𑆳𑆤𑆳𑆁 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆂𑇅 𑆢𑆼𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑆮𑆼𑆟𑆶𑆪𑆮𑆳 𑆪𑆮𑆳𑆤𑆳𑆁 𑆑𑆬𑇀𑆥𑆼𑆤 𑆓𑆾𑆣𑆷𑆩𑆩𑆪𑆳𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆂𑇆𑇒𑇔𑇆
𑆱𑆁𑆯𑆾𑆣𑆤𑆾𑆬𑇀𑆬𑆼𑆒𑆤𑆬𑆕𑇀𑆔𑆤𑆳𑆤𑆴 𑆑𑆳𑆬𑆼 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆑𑆦𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀𑇅 𑆘𑆪𑆤𑇀𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆨𑆮𑆳𑆤𑇀 𑆮𑆴𑆫𑆼𑆑𑆂 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆂 𑆱𑆁𑆯𑆩𑆤𑆾 𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑇆𑇒𑇕𑇆
𑆢𑆳𑆫𑇀𑆮𑆵𑆁 𑆱𑆶𑆫𑆳𑆲𑇀𑆮𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆱𑆩𑆶𑆱𑇀𑆠𑆳𑆁 𑆑𑆰𑆳𑆪𑆩𑆶𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆵𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆪𑆶𑆑𑇀𑆠𑆳𑆩𑆡𑆮𑆳 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆫𑆱𑆼𑆤𑆳𑆩𑆬𑆑𑆵𑆦𑆬𑆳𑆤𑆳𑆩𑇀𑇆𑇒𑇖𑇆
𑆲𑆫𑆵𑆠𑆑𑆵𑆑𑆛𑇀𑆦𑆬𑆩𑆶𑆱𑇀𑆠𑆬𑆾𑆣𑇀𑆫𑆁 𑆥𑆳𑆜𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆫𑇀𑆘𑆶𑆤𑆣𑆤𑇀𑆮𑆤𑆳𑆯𑇀𑆖𑇅 𑆇𑆨𑆼 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆠𑆓𑆫𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆑𑆢𑆩𑇀𑆧𑆯𑆳𑆬𑆳𑆫𑇀𑆘𑆶𑆤𑆢𑆵𑆥𑇀𑆪𑆑𑆳𑆯𑇀𑆖𑇆𑇒𑇗𑇆
𑆢𑆳𑆫𑇀𑆮𑆵 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆒𑆢𑆴𑆫𑆾 𑆣𑆮𑆯𑇀𑆖 𑆱𑆶𑆫𑆳𑆲𑇀𑆮𑆑𑆶𑆰𑇀𑆜𑆳𑆓𑆶𑆫𑆶𑆖𑆤𑇀𑆢𑆤𑆳𑆤𑆴𑇅 𑆢𑆳𑆫𑇀𑆮𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆿 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆱𑆥𑆳𑆜𑆳 𑆥𑆳𑆜𑆳 𑆖 𑆩𑆷𑆫𑇀𑆮𑆳 𑆖 𑆠𑆡𑆳 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑇆𑇒𑇘𑇆
𑆪𑆮𑆳𑆤𑇀𑆪𑆶𑆯𑆵𑆫𑆳𑆟𑇀𑆪𑆨𑆪𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆖𑆮𑇀𑆪𑆳𑆨𑆪𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆂𑇅 𑆥𑆳𑆢𑆽𑆂 𑆑𑆰𑆳𑆪𑆳𑆂 𑆑𑆦𑆩𑆼𑆲𑆴𑆤𑆳𑆁 𑆠𑆼 𑆢𑆯𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆳 𑆩𑆣𑆶𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆂𑇆𑇒𑇙𑇆

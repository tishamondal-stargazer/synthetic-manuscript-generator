𑆃𑆡𑆮𑆳𑇁𑆥𑆴 𑆥𑆫𑆵𑆥𑆳𑆑𑆁 𑆣𑆳𑆠𑆶𑆰𑇀𑆮𑆼𑆮 𑆑𑇀𑆫𑆩𑆳𑆤𑇀𑆩𑆬𑆳𑆂𑇅 𑆪𑆳𑆤𑇀𑆠𑆴 𑆘𑇀𑆮𑆫𑆩𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆱𑇀𑆠𑆼 𑆠𑆡𑆳𑇁𑆥𑇀𑆪𑆥𑆑𑆶𑆫𑇀𑆮𑆠𑆼𑇆𑇓𑇓𑇖𑇆
𑆢𑆵𑆤𑆠𑆳𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆓𑇀𑆬𑆳𑆤𑆴𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆁 𑆤𑆳𑆤𑇀𑆤𑆑𑆳𑆩𑆠𑆳𑆩𑇀𑇅 𑆑𑆟𑇀𑆝𑆷𑆫𑆶𑆑𑇀𑆠𑆾𑆜𑆥𑆴𑆝𑆑𑆳𑆂 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆁 𑆖 𑆠𑆼 𑆩𑆸𑆢𑆶𑆩𑇀𑇆𑇓𑇓𑇗𑇆
𑆍𑆮𑆩𑆤𑇀𑆪𑆼𑇁𑆥𑆴 𑆖 𑆓𑆢𑆳 𑆮𑇀𑆪𑆳𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆥𑆶𑆤𑆫𑇀𑆓𑆠𑆳𑆂𑇅 𑆃𑆤𑆴𑆫𑇀𑆔𑆳𑆠𑆼𑆤 𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆬𑇀𑆥𑆽𑆫𑆥𑇀𑆪𑆲𑆴𑆠𑆽𑆫𑇀𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇓𑇓𑇘𑇆
𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑇁𑆥𑆴 𑆘𑇀𑆮𑆫𑆼 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆡𑆳𑆮𑆱𑇀𑆡𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇅 𑆪𑆡𑆳𑆥𑇀𑆫𑆳𑆟𑆁 𑆲𑆫𑆼𑆢𑇀𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆫𑇀𑆮𑆳 𑆯𑆩𑆁 𑆤𑆪𑆼𑆠𑇀𑇆𑇓𑇓𑇙𑇆
𑆩𑆸𑆢𑆶𑆨𑆴𑆂 𑆯𑆾𑆣𑆤𑆽𑆂 𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆪𑆳𑆥𑆤𑆳 𑆧𑆱𑇀𑆠𑆪𑆾 𑆲𑆴𑆠𑆳𑆂𑇅 𑆲𑆴𑆠𑆳𑆯𑇀𑆖 𑆬𑆔𑆮𑆾 𑆪𑆷𑆰𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆩𑆴𑆰𑆘𑆳 𑆫𑆱𑆳𑆂𑇆𑇓𑇔𑇐𑇆
𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆱𑇀𑆤𑆳𑆤𑆣𑆷𑆥𑆤𑆳𑆤𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆖𑇅 𑆲𑆴𑆠𑆳𑆤𑆴 𑆥𑆶𑆤𑆫𑆳𑆮𑆸𑆠𑇀𑆠𑆼 𑆘𑇀𑆮𑆫𑆼 𑆠𑆴𑆑𑇀𑆠𑆔𑆸𑆠𑆳𑆤𑆴 𑆖𑇆𑇓𑇔𑇑𑇆
𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑇀𑆪𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆤𑆳𑆁 𑆨𑆾𑆘𑆤𑆳𑆠𑇀 𑆥𑆶𑆤𑆫𑆳𑆓𑆠𑆼𑇅 𑆬𑆕𑇀𑆔𑆤𑆾𑆰𑇀𑆟𑆾𑆥𑆖𑆳𑆫𑆳𑆢𑆴𑆂 𑆑𑇀𑆫𑆩𑆂 𑆑𑆳𑆫𑇀𑆪𑆯𑇀𑆖 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀𑇆𑇓𑇔𑇒𑇆
𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆠𑆴𑆑𑇀𑆠𑆳 𑆩𑆶𑆱𑇀𑆠𑆁 𑆥𑆫𑇀𑆥𑆛𑆑𑆾𑇁𑆩𑆸𑆠𑆳𑇅 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆥𑆵𑆠𑆳𑆤𑆴 𑆖𑆳𑆨𑇀𑆪𑆳𑆱𑆳𑆠𑇀 𑆥𑆶𑆤𑆫𑆳𑆮𑆫𑇀𑆠𑆑𑆁 𑆘𑇀𑆮𑆫𑆩𑇀𑇆𑇓𑇔𑇓𑇆
𑆠𑆱𑇀𑆪𑆳𑆁 𑆠𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆁 𑆘𑇀𑆮𑆫𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇅 𑆘𑇀𑆮𑆫𑆳𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆫𑆩𑆳𑆥𑆼𑆑𑇀𑆰𑆵 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆠𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇆𑇓𑇔𑇔𑇆
𑆫𑆾𑆓𑆫𑆳𑆛𑇀 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆤𑇀𑆠𑆑𑆸𑆢𑇀𑆢𑆳𑆫𑆶𑆟𑆾 𑆘𑇀𑆮𑆫𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆪𑆠𑆼𑆠 𑆥𑇀𑆫𑆯𑆩𑆼 𑆨𑆴𑆰𑆑𑇀𑇆𑇓𑇔𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆁 𑆪𑆡𑆳𑆥𑇀𑆫𑆯𑇀𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆘𑇀𑆮𑆫𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆄𑆠𑇀𑆫𑆼𑆪𑆼𑆟𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆳𑆪 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆲𑆴𑆠𑆑𑆳𑆩𑇀𑆪𑆪𑆳𑇆𑇓𑇔𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆮𑆴𑆲𑆫𑆤𑇀𑆠𑆁 𑆘𑆴𑆠𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆥𑆚𑇀𑆖𑆓𑆕𑇀𑆓𑆼 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑇀𑇅 𑆥𑇀𑆫𑆟𑆩𑇀𑆪𑆾𑆮𑆳𑆖 𑆤𑆴𑆫𑇀𑆩𑆾𑆲𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆖𑆱𑆩𑇀𑇆𑇓𑇆
𑆨𑆓𑆮𑆤𑇀 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆲𑆼𑆠𑆶𑆫𑆶𑆑𑇀𑆠𑆂 𑆱𑆬𑆑𑇀𑆰𑆟𑆂𑇅 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆪𑆠𑇀 𑆥𑆫𑆁 𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆱𑆴 𑆠𑆢𑇀𑆓𑆶𑆫𑆾𑇆𑇔𑇆
𑆓𑆶𑆫𑆶𑆫𑆶𑆮𑆳𑆖- 𑆩𑆲𑆳𑆓𑆢𑆁 𑆩𑆲𑆳𑆮𑆼𑆓𑆩𑆓𑇀𑆤𑆴𑆮𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆑𑆳𑆫𑆴 𑆖𑇅 𑆲𑆼𑆠𑆶𑆬𑆑𑇀𑆰𑆟𑆮𑆴𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇕𑇆
𑆠𑆱𑇀𑆪𑆾𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆩𑇀𑆬𑆁 𑆖 𑆑𑆛𑆷𑆤𑆴 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇅 𑆔𑆫𑇀𑆩𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆮𑆴𑆢𑆳𑆲𑆯𑇀𑆖 𑆲𑆼𑆠𑆶𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆤𑆴𑆢𑆫𑇀𑆯𑆴𑆠𑆂𑇆𑇖𑇆
𑆠𑆽𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆂 𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆠𑆢𑇀𑆪𑆾𑆤𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆁 𑆖 𑆮𑆫𑇀𑆣𑆠𑆼 𑆠𑆠𑇀 𑆥𑇀𑆫𑆢𑆷𑆰𑆪𑆠𑇀𑇆𑇗𑇆
𑆠𑆱𑇀𑆪𑆾𑆰𑇀𑆩𑆟𑆳 𑆢𑇀𑆫𑆮𑆾 𑆣𑆳𑆠𑆶𑆫𑇀𑆣𑆳𑆠𑆾𑆫𑇀𑆣𑆳𑆠𑆾𑆂 𑆥𑇀𑆫𑆱𑆴𑆖𑇀𑆪𑆠𑆼𑇅 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆱𑇀𑆠𑆼𑆤 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆨𑆷𑆪𑆱𑇀𑆠𑆢𑆣𑆴𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇘𑇆
𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆢𑆷𑆰𑆟𑆳𑆠𑇀𑆠𑆠𑇀𑆠𑆶 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆢𑇀𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆪𑆾𑆂𑇅 𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆩𑆤𑆵𑆰𑆴𑆨𑆴𑆂𑇆𑇙𑇆
𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆁 𑆖 𑆪𑆑𑆸𑆖𑇀𑆖𑆽𑆮 𑆠𑆢𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆫𑆑𑇀𑆠𑆮𑆳𑆲𑆵𑆤𑆴 𑆠𑆤𑇀𑆩𑆷𑆬𑆳𑆤𑆴 𑆲𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀𑇆𑇑𑇐𑇆
𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆁 𑆱𑆥𑆳𑆟𑇀𑆝𑆶 𑆱𑆱𑇀𑆤𑆼𑆲𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆖 𑆑𑆦𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇅 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆁 𑆱𑆦𑆼𑆤𑆁 𑆖 𑆠𑆤𑆶 𑆫𑆷𑆑𑇀𑆰𑆁 𑆖 𑆮𑆳𑆠𑆴𑆑𑆩𑇀𑇆𑇑𑇑𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆰𑆳𑆪𑆳𑆨𑆁 𑆑𑆸𑆰𑇀𑆟𑆁 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆤𑇀𑆤𑆴𑆨𑆩𑇀𑇅 𑆩𑆼𑆖𑆑𑆳𑆓𑆳𑆫𑆣𑆷𑆩𑆳𑆨𑆩𑆚𑇀𑆘𑆤𑆳𑆨𑆁 𑆖 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆩𑇀𑇆𑇑𑇒𑇆
𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆩𑇀𑇅𑇑𑇓𑇅 𑆍𑆑𑆢𑆾𑆰𑆳𑆤𑆶𑆓𑆁 𑆱𑆳𑆣𑇀𑆪𑆁 𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆁 𑆪𑆳𑆥𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇆
𑆪𑆠𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆤𑇀𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆼𑆫𑆠𑆴𑆮𑆼𑆓𑆮𑆠𑇀𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆨𑆴𑆂 𑆑𑇀𑆰𑆵𑆟𑆢𑆼𑆲𑆱𑇀𑆪 𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆪𑆳𑆤𑆯𑇀𑆤𑆠𑆯𑇀𑆖 𑆪𑆠𑇀𑇆𑇑𑇔𑇆
𑆓𑆠𑆴𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆯𑇀𑆖𑆽𑆮 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆢𑆫𑇀𑆯𑆴𑆠𑆳𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆳 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆢𑇀𑆮𑆳𑆫𑆳 𑆢𑇀𑆮𑆴𑆢𑇀𑆮𑆳𑆫𑆳 𑆠𑇀𑆮𑆣𑆫𑆳 𑆓𑆠𑆴𑆂𑇆𑇑𑇕𑇆
𑆱𑆥𑇀𑆠 𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆳𑆟𑆴 𑆯𑆴𑆫𑆱𑆴 𑆢𑇀𑆮𑆼 𑆖𑆳𑆣𑆂, 𑆱𑆳𑆣𑇀𑆪𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆩𑇀𑇅 𑆪𑆳𑆥𑇀𑆪𑆁 𑆠𑇀𑆮𑆣𑆾𑆓𑆁, 𑆩𑆳𑆫𑇀𑆓𑆿 𑆠𑆶 𑆢𑇀𑆮𑆳𑆮𑆱𑆳𑆣𑇀𑆪𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇆
𑆪𑆢𑆳 𑆠𑆶 𑆱𑆫𑇀𑆮𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆨𑇀𑆪𑆾 𑆫𑆾𑆩𑆑𑆷𑆥𑆼𑆨𑇀𑆪 𑆍𑆮 𑆖𑇅 𑆮𑆫𑇀𑆠𑆠𑆼 𑆠𑆳𑆩𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆁 𑆓𑆠𑆴𑆁 𑆠𑆱𑇀𑆪𑆳𑆲𑆶𑆫𑆳𑆤𑇀𑆠𑆴𑆑𑆵𑆩𑇀𑇆𑇑𑇗𑇆
𑆪𑆖𑇀𑆖𑆾𑆨𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆳𑆫𑇀𑆓𑆳𑆨𑇀𑆪𑆳𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆠𑆶𑆬𑇀𑆪𑆁 𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑆼𑆤 𑆫𑆑𑇀𑆠𑆁 𑆑𑆸𑆰𑇀𑆟𑆩𑆠𑆵𑆮 𑆖𑇆𑇑𑇘𑇆
𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆑𑆦𑆮𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆑𑆟𑇀𑆜𑆼 𑆱𑆘𑇀𑆘𑆠𑆴 𑆖𑆳𑆥𑆴 𑆪𑆠𑇀𑇅 𑆪𑆖𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆂 𑆱𑆫𑇀𑆮𑆽𑆫𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆂 𑆱𑆩𑆨𑆴𑆢𑇀𑆫𑆶𑆠𑆩𑇀𑇆𑇑𑇙𑇆
𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆤𑆵𑆬𑆲𑆫𑆴𑆠𑆠𑆳𑆩𑇀𑆫𑆽𑆫𑇀𑆮𑆫𑇀𑆟𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑇀𑇅 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆑𑆳𑆱𑆩𑆳𑆤𑆱𑇀𑆪 𑆪𑆖𑇀𑆖 𑆠𑆖𑇀𑆖 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴𑇆𑇒𑇐𑇆
𑆪𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆳𑆤𑆶𑆓𑆁 𑆪𑆢𑇀𑆮𑆳 𑆯𑆳𑆤𑇀𑆠𑆁 𑆯𑆳𑆤𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆴𑇅 𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆁 𑆖𑆫𑆼𑆢𑇀𑆪𑆢𑇀𑆮𑆳 𑆪𑆳𑆥𑇀𑆪𑆁 𑆥𑆴𑆠𑇀𑆠𑆩𑆱𑆸𑆑𑇀 𑆖 𑆠𑆠𑇀𑇆𑇒𑇑𑇆
𑆍𑆑𑆩𑆳𑆫𑇀𑆓𑆁 𑆧𑆬𑆮𑆠𑆾 𑆤𑆳𑆠𑆴𑆮𑆼𑆓𑆁 𑆤𑆮𑆾𑆠𑇀𑆡𑆴𑆠𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆶𑆒𑆼 𑆑𑆳𑆬𑆼 𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆩𑇀𑇆𑇒𑇒𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆫𑆷𑆑𑇀𑆰𑆁 𑆖 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆃𑆣𑆾𑆓𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆳𑆪𑆂, 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆪𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆱𑇀𑆪 𑆠𑆶𑇆𑇒𑇓𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆓𑆁 𑆑𑆦𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆩𑆣𑆾𑆓𑆁 𑆩𑆳𑆫𑆶𑆠𑆳𑆤𑆶𑆓𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆩𑆳𑆫𑇀𑆓𑆁 𑆑𑆦𑆮𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆨𑆳𑆨𑇀𑆪𑆳𑆩𑆤𑆶𑆧𑆣𑇀𑆪𑆠𑆼𑇆𑇒𑇔𑇆
𑆃𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆪𑆢𑆯𑇀𑆤𑆠𑆂𑇅 𑆠𑆢𑇀𑆢𑆾𑆰𑆢𑆶𑆰𑇀𑆛𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆤𑆳𑆢𑆿 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆩𑆫𑇀𑆲𑆠𑆴𑇆𑇒𑇕𑇆
𑆓𑆬𑆓𑇀𑆫𑆲𑆁 𑆥𑆷𑆠𑆴𑆤𑆱𑇀𑆪𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆩𑆫𑆶𑆖𑆴𑆁 𑆘𑇀𑆮𑆫𑆩𑇀𑇅 𑆓𑆶𑆬𑇀𑆩𑆁 𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆩𑆳𑆤𑆳𑆲𑆁 𑆑𑆴𑆬𑆳𑆱𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆠𑆳𑆩𑇀𑇆𑇒𑇖𑇆
𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆮𑆵𑆱𑆫𑇀𑆥𑆁 𑆮𑆫𑇀𑆟𑆤𑆳𑆯𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑇀𑇅 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆫𑆾𑆣𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆠𑆩𑇀𑆨𑆴𑆠𑆩𑆳𑆢𑆴𑆠𑆂𑇆𑇒𑇗𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆁 𑆧𑆬𑆴𑆤𑆾 𑆧𑆬𑆢𑆾𑆰𑆮𑆴𑆖𑆳𑆫𑆴𑆟𑆳 𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆡𑆩𑆠𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆴𑆖𑇀𑆗𑆠𑆳𑇆𑇒𑇘𑇆
𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆲𑆴 𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆩𑆳𑆩𑆢𑆾𑆰𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀𑇅 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆪𑆳𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆳𑆱𑆸𑆑𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆬𑇀𑆬𑆕𑇀𑆔𑇀𑆪𑆩𑆳𑆢𑆴𑆠𑆂𑇆𑇒𑇙𑇆
𑆩𑆳𑆫𑇀𑆓𑆿 𑆢𑆾𑆰𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆖 𑆤𑆴𑆢𑆳𑆤𑆁 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆖𑇅 𑆬𑆕𑇀𑆔𑆤𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆿 𑆠𑆫𑇀𑆥𑆟𑆁 𑆮𑆳 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇓𑇐𑇆
𑆲𑇀𑆫𑆵𑆧𑆼𑆫𑆖𑆤𑇀𑆢𑆤𑆾𑆯𑆵𑆫𑆩𑆶𑆱𑇀𑆠𑆥𑆫𑇀𑆥𑆛𑆑𑆽𑆂 𑆯𑆸𑆠𑆩𑇀𑇅 𑆑𑆼𑆮𑆬𑆁 𑆯𑆸𑆠𑆯𑆵𑆠𑆁 𑆮𑆳 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆾𑆪𑆁 𑆥𑆴𑆥𑆳𑆱𑆮𑆼𑇆𑇓𑇑𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆓𑆼 𑆠𑆫𑇀𑆥𑆟𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑆼𑆪𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆩𑆣𑆾𑆓𑆠𑆼𑇅 𑆑𑆳𑆬𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆘𑇀𑆚𑆾 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆠𑇀𑇆𑇓𑇒𑇆
𑆘𑆬𑆁 𑆒𑆫𑇀𑆘𑆷𑆫𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆩𑆣𑆷𑆑𑆽𑆂 𑆱𑆥𑆫𑆷𑆰𑆑𑆽𑆂𑇅 𑆯𑆸𑆠𑆯𑆵𑆠𑆁 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆠𑆫𑇀𑆥𑆟𑆳𑆫𑇀𑆡𑆼 𑆱𑆯𑆫𑇀𑆑𑆫𑆩𑇀𑇆𑇓𑇓𑇆
𑆠𑆫𑇀𑆥𑆟𑆁 𑆱𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆬𑆳𑆘𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆓𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆠𑇀 𑆥𑆵𑆠𑆁 𑆑𑆳𑆬𑆼 𑆮𑇀𑆪𑆥𑆾𑆲𑆠𑆴𑇆𑇓𑇔𑇆
𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆼𑆫𑆩𑇀𑆬𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆪 𑆠𑆠𑇀 𑆱𑆳𑆩𑇀𑆬𑆩𑆥𑆴 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇅 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆽𑆫𑇀𑆮𑆴𑆢𑇀𑆮𑆳𑆤𑆩𑇀𑆬𑆳𑆫𑇀𑆡𑆁 𑆖𑆳𑆤𑆶𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇓𑇕𑇆
𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆤𑆵𑆮𑆳𑆫𑆑𑆾𑆫𑆢𑆷𑆰𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆴𑆑𑆳𑆂𑇅 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆯𑇀𑆖 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆯𑇀𑆖 𑆨𑆾𑆘𑆤𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆳𑆩𑇀𑇆𑇓𑇖𑇆
𑆩𑆶𑆢𑇀𑆓𑆳 𑆩𑆱𑆷𑆫𑆳𑆯𑇀𑆖𑆟𑆑𑆳𑆂 𑆱𑆩𑆑𑆶𑆰𑇀𑆜𑆳𑆞𑆑𑆵𑆦𑆬𑆳𑆂𑇅 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆂 𑆱𑆷𑆥𑆪𑆷𑆰𑆳𑆫𑇀𑆡𑆼 𑆑𑆬𑇀𑆥𑆴𑆠𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆳𑆩𑇀𑇆𑇓𑇗𑇆
𑆥𑆛𑆾𑆬𑆤𑆴𑆩𑇀𑆧𑆮𑆼𑆠𑇀𑆫𑆳𑆓𑇀𑆫𑆥𑇀𑆬𑆑𑇀𑆰𑆮𑆼𑆠𑆱𑆥𑆬𑇀𑆬𑆮𑆳𑆂𑇅 𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆯𑆳𑆑𑆁 𑆓𑆟𑇀𑆝𑆵𑆫𑆂 𑆱𑆑𑆜𑆴𑆬𑇀𑆬𑆑𑆂𑇆𑇓𑇘𑇆

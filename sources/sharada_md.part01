𑆯𑆫𑇀𑆑𑆫𑆳𑆁 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆿 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆩𑆣𑆶𑇅 𑆯𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑆶𑆥𑆳𑆤𑆁 𑆮𑆳 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆰𑆵𑆟𑆂 𑆑𑇀𑆰𑆠𑆵 𑆑𑆸𑆯𑆂𑇆𑇒𑇙𑇆
𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆥𑇀𑆬𑆑𑇀𑆰𑆯𑆳𑆬𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆨𑆴𑆂𑇅 𑆠𑆳𑆬𑆩𑆱𑇀𑆠𑆑𑆘𑆩𑇀𑆧𑆷𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆽𑆯𑇀𑆖 𑆱𑆥𑆢𑇀𑆩𑆑𑆽𑆂𑇆𑇓𑇑𑇆
𑆱𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆽𑆂 𑆯𑆸𑆠𑆳𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆳𑆢𑆢𑇀𑆪𑆳𑆘𑇀𑆘𑆳𑆠𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆯𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆁 𑆑𑇀𑆰𑆠𑆾𑆫𑆱𑇀𑆑𑆂 𑆑𑇀𑆰𑆵𑆟𑆯𑆶𑆑𑇀𑆫𑆯𑇀𑆖 𑆩𑆳𑆤𑆮𑆂𑇆𑇓𑇒𑇆
𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆤𑆳𑆓𑆧𑆬𑆪𑆾𑆂 𑆑𑇀𑆮𑆳𑆡𑆼 𑆑𑇀𑆰𑆵𑆫𑆱𑆩𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆥𑆪𑆱𑇀𑆪𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆳𑆁𑆯𑆵𑆑𑆬𑇀𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑇀𑆰𑆠𑆼 𑆯𑆶𑆨𑆩𑇀𑇆𑇓𑇓𑇆
𑆑𑆾𑆬𑆬𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆼 𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆳𑆰𑇀𑆛𑆓𑆶𑆟𑆱𑆳𑆣𑆴𑆠𑆩𑇀𑇅 𑆑𑆬𑇀𑆑𑆽𑆂 𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆢𑆳𑆫𑇀𑆮𑆵𑆠𑇀𑆮𑆓𑇀𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆮𑆑𑇀𑆦𑆬𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀𑇆𑇓𑇔𑇆
𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆮𑆵𑆫𑆳𑆁 𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆯𑆛𑆵𑆩𑇀𑇅 𑆖𑆠𑆱𑇀𑆫𑆂 𑆥𑆫𑇀𑆟𑆴𑆤𑆵𑆫𑇀𑆩𑆼𑆢𑆼 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆿 𑆢𑇀𑆮𑆼 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆼𑇆𑇓𑇕𑇆
𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆼 𑆢𑇀𑆮𑆼 𑆩𑆣𑆶𑆑𑆩𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑇀𑇅 𑆉𑆢𑇀𑆣𑆴𑆁 𑆥𑆫𑆷𑆰𑆑𑆁 𑆨𑆳𑆫𑇀𑆓𑆵𑆁 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆁 𑆧𑆸𑆲𑆠𑆵𑆁 𑆠𑆡𑆳𑇆𑇓𑇖𑇆
𑆦𑆬𑆳𑆤𑆴 𑆖𑆽𑆮𑆩𑆳𑆢𑆵𑆤𑆴 𑆑𑆬𑇀𑆑𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆳𑆤𑇀𑇅 𑆣𑆳𑆠𑇀𑆫𑆵𑆫𑆱𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑇀𑆰𑆶𑆖𑇀𑆗𑆳𑆓𑆩𑆳𑆁𑆱𑆫𑆱𑆁 𑆥𑆪𑆂𑇆𑇓𑇘𑇆
𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆱𑇀𑆡𑆾𑆤𑇀𑆩𑆴𑆠𑆁 𑆠𑆼𑆤 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇅 𑆥𑇀𑆫𑆱𑇀𑆡𑆳𑆫𑇀𑆣𑆁 𑆩𑆣𑆶𑆤𑆂 𑆯𑆵𑆠𑆼 𑆯𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆠𑆡𑆳𑇆𑇓𑇙𑇆
𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆳𑆟𑆴 𑆥𑆠𑇀𑆫𑆽𑆬𑆳𑆲𑆼𑆩𑆠𑇀𑆮𑆕𑇀𑆩𑆫𑆴𑆖𑆳𑆤𑆴 𑆖𑇅 𑆮𑆴𑆤𑆵𑆪 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆠𑆱𑇀𑆩𑆳𑆬𑇀𑆬𑆴𑆲𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆱𑆢𑆳 𑆤𑆫𑆂𑇆𑇔𑇐𑇆
𑆃𑆩𑆸𑆠𑆥𑇀𑆫𑆳𑆯𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆤𑇀𑆤𑆫𑆳𑆟𑆳𑆩𑆩𑆸𑆠𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆱𑆶𑆣𑆳𑆩𑆸𑆠𑆫𑆱𑆁 𑆥𑇀𑆫𑆳𑆯𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆯𑆴𑆤𑆳𑇆𑇔𑇑𑇆
𑆤𑆰𑇀𑆛𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆢𑆶𑆫𑇀𑆧𑆬𑆮𑇀𑆪𑆳𑆣𑆴𑆑𑆫𑇀𑆯𑆴𑆠𑆳𑆤𑇀𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳𑆤𑇀 𑆑𑆸𑆯𑆳𑆤𑇀 𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆲𑆵𑆤𑆳𑆁𑆯𑇀𑆖 𑆧𑆸𑆁𑆲𑆪𑆼𑆠𑇀𑇆𑇔𑇒𑇆
𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆢𑆳𑆲𑆠𑆸𑆰𑇀𑆟𑆳𑆱𑇀𑆫𑆥𑆴𑆠𑇀𑆠𑆤𑆶𑆠𑇀𑇅 𑆥𑆶𑆠𑇀𑆫𑆢𑆁 𑆮𑆩𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆲𑆸𑆢𑇀𑆪𑆾𑆤𑆴𑆩𑆷𑆠𑇀𑆫𑆳𑆩𑆪𑆳𑆥𑆲𑆩𑇀𑇆𑇔𑇓𑇆
𑆅𑆠𑇀𑆪𑆩𑆸𑆠𑆥𑇀𑆫𑆳𑆯𑆔𑆸𑆠𑆩𑇀𑇅 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆾𑆯𑆵𑆫𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆧𑆬𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆑𑆠𑇀𑆠𑆸𑆟𑆩𑇀𑇅 𑆢𑆫𑇀𑆨𑆩𑆷𑆬𑆁 𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑆵𑆁 𑆥𑆬𑆳𑆯𑆫𑇀𑆰𑆨𑆑𑆿 𑆱𑇀𑆡𑆴𑆫𑆳𑆩𑇀𑇆𑇔𑇔𑇆
𑆥𑆬𑆴𑆑𑆁 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑆠𑆼𑆰𑆳𑆁 𑆫𑆱𑆼 𑆑𑇀𑆰𑆵𑆫𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑇅 𑆑𑆬𑇀𑆑𑆂 𑆱𑇀𑆮𑆓𑆶𑆥𑇀𑆠𑆳𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆩𑆼𑆢𑆫𑇀𑆰𑆨𑆑𑆘𑆵𑆮𑆑𑆽𑆂𑇆𑇔𑇕𑇆
𑆯𑆠𑆳𑆮𑆫𑇀𑆪𑆸𑆢𑇀𑆣𑆴𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆫𑆳𑆮𑆟𑆵𑆧𑆴𑆱𑆽𑆂𑇅 𑆥𑇀𑆫𑆱𑇀𑆡𑆂 𑆱𑆴𑆢𑇀𑆣𑆾 𑆔𑆸𑆠𑆳𑆢𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆸𑆢𑇀𑆢𑇀𑆫(𑆢𑇀𑆨)𑆮𑆯𑆷𑆬𑆤𑆶𑆠𑇀𑇆𑇔𑇖𑇆
𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆫𑇀𑆯𑆂𑆑𑆳𑆱𑆯𑆾𑆰𑆑𑇀𑆰𑆪𑆳𑆥𑆲𑆂𑇅 𑆣𑆤𑆶𑆂𑆱𑇀𑆠𑇀𑆫𑆵𑆩𑆢𑇀𑆪𑆨𑆳𑆫𑆳𑆣𑇀𑆮𑆒𑆴𑆤𑇀𑆤𑆳𑆤𑆳𑆁 𑆧𑆬𑆩𑆳𑆁𑆱𑆢𑆂𑇆𑇔𑇗𑇆
𑆅𑆠𑆴 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆩𑆣𑆶𑆑𑆳𑆰𑇀𑆛𑆥𑆬𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆥𑇀𑆫𑆱𑇀𑆡𑆑𑇀𑆮𑆳𑆡𑆼 𑆔𑆸𑆠𑆁 𑆥𑆖𑆼𑆠𑇀𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆰𑇀𑆛𑆥𑆬𑆼 𑆑𑆬𑇀𑆑𑆼 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆱𑆴𑆢𑇀𑆣𑆼 𑆖 𑆯𑆵𑆠𑆬𑆼𑇆𑇔𑇘𑇆
𑆥𑆸𑆡𑆓𑆰𑇀𑆛𑆥𑆬𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆪𑆼𑆠𑇀𑇅 𑆱𑆩𑆱𑆑𑇀𑆠𑆶 𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆼 𑆫𑆑𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆼 𑆖 𑆠𑆢𑇀𑆣𑆴𑆠𑆩𑇀𑇆𑇔𑇙𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆮𑆴𑆢𑆳𑆫𑆵𑆑𑇀𑆰𑆶𑆘𑆵𑆮𑆤𑆵𑆪𑆫𑆱𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆃𑆘𑆳𑆓𑆾𑆥𑆪𑆱𑆾𑆯𑇀𑆖𑆽𑆮 𑆱𑆥𑇀𑆠 𑆥𑇀𑆫𑆱𑇀𑆡𑆳𑆤𑇀 𑆥𑆖𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀𑇆𑇕𑇐𑇆
𑆱𑆴𑆢𑇀𑆣𑆯𑆵𑆠𑆼 𑆱𑆴𑆠𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆢𑇀𑆮𑆴𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆤𑆪𑆼𑆖𑇀𑆖 𑆠𑆠𑇀𑇅 𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆥𑆴𑆠𑇀𑆠𑆳𑆱𑆸𑆑𑇀𑆑𑆳𑆱𑆩𑆼𑆲𑆑𑇀𑆰𑆪𑆳𑆥𑆲𑆩𑇀𑇆𑇕𑇑𑇆
𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆩𑆳𑆁𑆱𑆯𑆶𑆑𑇀𑆫𑆧𑆬𑆥𑇀𑆫𑆢𑆩𑇀𑇅 𑆔𑆸𑆠𑆁 𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆼𑇁𑆨𑇀𑆪𑆣𑆴𑆑𑆼 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆼𑇁𑆣𑆴𑆑𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇕𑇒𑇆
𑆬𑆵𑆞𑆁 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆪𑆼𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆩𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆢𑇀𑆣𑆤𑇀𑆠𑆴 𑆤𑆳𑆤𑆬𑆩𑇀𑇅 𑆄𑆑𑇀𑆫𑆳𑆩𑆠𑇀𑆪𑆤𑆴𑆬𑆁 𑆥𑆵𑆠𑆩𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆖𑇆𑇕𑇓𑇆
𑆑𑇀𑆰𑆳𑆩𑆑𑇀𑆰𑆵𑆟𑆑𑆸𑆯𑆳𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑆼𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆔𑆸𑆠𑆳𑆤𑆴 𑆠𑆶𑇅 𑆠𑇀𑆮𑆑𑇀𑆑𑇀𑆰𑆵𑆫𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆬𑆳𑆘𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆱𑇀𑆠𑇀𑆪𑆳𑆤𑆳𑆤𑆴 𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇕𑇔𑇆
𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆓𑆶𑆝𑆳𑆤𑇀 𑆱𑆩𑆣𑇀𑆮𑆁𑆯𑆳𑆚𑇀𑆘𑆓𑇀𑆣𑇀𑆮𑆳 𑆖𑆳𑆤𑆶 𑆥𑆪𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆫𑆼𑆠𑆾 𑆮𑆵𑆫𑇀𑆪𑆁 𑆧𑆬𑆁 𑆥𑆶𑆰𑇀𑆛𑆴𑆁 𑆠𑆽𑆫𑆳𑆯𑆶𑆠𑆫𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑇆𑇕𑇕𑇆

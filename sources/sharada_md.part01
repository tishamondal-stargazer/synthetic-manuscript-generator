𑆮𑆴𑆮𑆫𑆳𑆤𑆶𑆖𑆫𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑆥𑇀𑆱𑆶 𑆧𑆶𑆢𑇀𑆧𑆶𑆢𑆑𑆾 𑆪𑆡𑆳 𑇅 𑆍𑆮𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆫𑆾 𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆠𑆶 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆳𑆑𑆁 𑆤 𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇓𑇑𑇆
𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆑𑆁 𑆓𑆖𑇀𑆗𑆠𑆴 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆂 𑇅 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆲𑆵𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆂 𑆥𑆳𑆑𑆁 𑆤 𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇓𑇒𑇆
𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆢𑆾𑆰𑆼 𑆱𑇀𑆮𑆼 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆫𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆼 𑇅 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆂 𑆥𑆖𑇀𑆪𑆠𑆼 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆯𑇀𑆖𑆳𑆥𑆴 𑆤 𑆥𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇓𑇆
𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆧𑆱𑇀𑆠𑆴𑆘𑆂 𑆥𑆑𑇀𑆮𑆾 𑆮𑆫𑇀𑆘𑇀𑆪𑆾 𑆪𑆯𑇀𑆖 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆂 𑇅𑇓𑇔𑇅 𑆃𑆡 𑆩𑆘𑇀𑆘𑆥𑆫𑆵𑆥𑆳𑆑𑆾 𑆔𑆾𑆫𑆂 𑆱𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼 𑇆𑇓𑇔𑇆
𑆱𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆳𑆁𑆱𑆤𑆴𑆫𑆾𑆣𑆼𑆤 𑆢𑇀𑆮𑆳𑆫𑆁 𑆤 𑆬𑆨𑆠𑆼 𑆪𑆢𑆳 𑇅 𑆠𑆠𑆂 𑆱 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆳 𑆠𑆼𑆤 𑆘𑇀𑆮𑆬𑆤𑆼𑆤𑆼𑆮 𑆢𑆲𑇀𑆪𑆠𑆼 𑇆𑇓𑇕𑇆
𑆃𑆱𑇀𑆡𑆴(𑆡) 𑆩𑆘𑇀𑆘𑆾𑆰𑇀𑆩𑆟𑆳 𑆠𑆼𑆤 𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆮𑆠𑇀 𑇅 𑆮𑆴𑆑𑆳𑆫𑆂 𑆯𑆬𑇀𑆪𑆨𑆷𑆠𑆾𑇁𑆪𑆁 𑆑𑇀𑆬𑆼𑆯𑆪𑆼𑆢𑆳𑆠𑆶𑆫𑆁 𑆖𑆴𑆫𑆩𑇀 𑇆𑇓𑇖𑇆
𑆃𑆡𑆳𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑇀𑆢𑇀𑆮𑆳𑆫𑆁 𑆠𑆶 𑆬𑆨𑆠𑆼 𑆪𑆢𑆳 𑇅 𑆠𑆠𑆾 𑆩𑆼𑆢𑆂𑆥𑇀𑆫𑆨𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆯𑆶𑆑𑇀𑆬𑆁 𑆯𑆵𑆠𑆩𑆡𑆾 𑆓𑆶𑆫𑆶 𑇆𑇓𑇗𑇆
𑆨𑆴𑆤𑇀𑆤𑆼𑇁𑆱𑇀𑆡𑇀𑆤𑆴 𑆤𑆴𑆂𑆱𑇀𑆫𑆮𑆼𑆠𑇀 𑆥𑆷𑆪𑆩𑆼𑆠𑆢𑆱𑇀𑆡𑆴𑆓𑆠𑆁 𑆮𑆴𑆢𑆶𑆂 𑇅 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆑𑆶𑆯𑆬𑆳𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆫𑆶𑆘𑆳𑆮𑆲𑆩𑇀 𑇆𑇓𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆴𑆱𑆫𑇀𑆥𑆤𑆳𑆝𑆵𑆱𑇀𑆠𑆤𑆫𑆾𑆓𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆓𑆠𑆳𑆂 𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆱𑆳𑆫𑆴𑆟𑆩𑆴𑆲𑆳𑆱𑇀𑆡𑆴𑆠𑆩𑆳𑆠𑇀𑆩𑆬𑆴𑆕𑇀𑆓𑆩𑇀 𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆱𑇀𑆠𑆸𑆠𑆩𑆤𑆶𑆤𑇀𑆤𑆠𑆩𑆳𑆯𑆶 𑆯𑆾𑆦𑆁 𑆠𑆁 𑆱𑆫𑇀𑆮𑆠𑆾 𑆮𑆴𑆱𑆫𑆟𑆳𑆖𑇀𑆖 𑆮𑆴𑆱𑆫𑇀𑆥𑆩𑆳𑆲𑆶𑆂 𑇆𑇓𑇆
𑆮𑆳𑆠𑆳𑆠𑇀𑆩𑆑𑆾𑇁𑆱𑆴𑆠𑆩𑆸𑆢𑆶𑆂 𑆥𑆫𑆶𑆰𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆱𑆩𑇀𑆨𑆼𑆢𑆠𑆾𑆢𑆥𑆮𑆤𑆘𑇀𑆮𑆫𑆬𑆴𑆕𑇀𑆓𑆪𑆶𑆑𑇀𑆠𑆂 𑇅 𑆓𑆟𑇀𑆝𑆽𑆫𑇀𑆪𑆢𑆳 𑆠𑆶 𑆮𑆴𑆰𑆩𑆽𑆫𑆠𑆴𑆢𑆷𑆰𑆴𑆠𑆠𑇀𑆮𑆳𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆂 𑆱 𑆍𑆮 𑆑𑆡𑆴𑆠𑆂 𑆒𑆬𑆶 𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆂 𑇆𑇔𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀𑆩𑆑𑆾 𑆢𑇀𑆫𑆶𑆠𑆓𑆠𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑆳𑆑𑆱𑇀𑆦𑆾𑆛𑆥𑇀𑆫𑆨𑆼𑆢𑆧𑆲𑆶𑆬𑆂 𑆑𑇀𑆰𑆠𑆘𑆥𑇀𑆫𑆑𑆳𑆯𑆂 𑇅 𑆢𑆾𑆰𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑆠𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆾 𑆪𑆢𑆳 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆾𑆘𑆑𑆫𑇀𑆢𑆩𑆤𑆴𑆨𑆾 𑆤 𑆠𑆢𑆳 𑆱 𑆱𑆴𑆣𑇀𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆠𑇀𑆩𑆑𑆂 𑆱𑆫𑆠𑆴 𑆩𑆤𑇀𑆢𑆩𑆯𑆵𑆔𑇀𑆫𑆥𑆳𑆑𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆱𑆴𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆬𑇀𑆥𑆫𑆶𑆓𑆶𑆓𑇀𑆫𑆑𑆟𑇀𑆝𑆶𑆂 𑇅𑇖𑇅 𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆮𑆫𑇀𑆟𑆫𑆶𑆘𑆾𑇁𑆮𑆓𑆳𑆞𑆂 𑆥𑆑𑇀𑆮𑆾 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆖 𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆥𑇀𑆫𑆯𑆳𑆠𑆳𑆠𑇀 𑇆𑇖𑇆
𑆱𑆢𑇀𑆪𑆂𑆑𑇀𑆰𑆠𑆮𑇀𑆫𑆟𑆩𑆶𑆥𑆼𑆠𑇀𑆪 𑆤𑆫𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆖 𑆢𑆾𑆰𑆧𑆲𑆶𑆬𑆱𑇀𑆪 𑆑𑆫𑆾𑆠𑆴 𑆯𑆾𑆦𑆩𑇀 𑇅 𑆯𑇀𑆪𑆳𑆮𑆁 𑆱𑆬𑆾𑆲𑆴𑆠𑆩𑆠𑆴𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑆳𑆑𑆁 𑆱𑇀𑆦𑆾𑆛𑆽𑆂 𑆑𑆶𑆬𑆠𑇀𑆡𑆱𑆢𑆸𑆯𑆽𑆫𑆱𑆴𑆠𑆽𑆯𑇀𑆖 𑆑𑆵𑆫𑇀𑆟𑆩𑇀 𑇆𑇗𑇆
𑆱𑆴𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑆳 𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆂 𑆑𑇀𑆰𑆠𑆑𑆸𑆠𑆯𑇀𑆖 𑆤 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆼𑆠𑆴 𑇅 𑆥𑆽𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆮𑆥𑆴 𑆖 𑆢𑆫𑇀𑆯𑆴𑆠𑆥𑆷𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆿 𑆱𑆫𑇀𑆮𑆼 𑆖 𑆩𑆫𑇀𑆩𑆱𑆶 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆂 𑇆𑇘𑇆
𑆯𑆾𑆦𑆁 𑆤 𑆥𑆑𑇀𑆮𑆩𑆴𑆠𑆴 𑆥𑆑𑇀𑆮𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆠𑆼 𑆪𑆾 𑆪𑆾 𑆮𑆳 𑆮𑇀𑆫𑆟𑆁 𑆥𑇀𑆫𑆖𑆶𑆫𑆥𑆷𑆪𑆩𑆱𑆳𑆣𑆶𑆮𑆸𑆠𑇀𑆠𑆂 𑇅 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆥𑇀𑆫𑆮𑆴𑆢𑆳𑆫𑇀𑆪 𑆠𑆱𑇀𑆪 𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆮𑆴𑆲𑆴𑆠𑆳𑆤𑆴 𑆠𑆠𑆂 𑆱 𑆥𑆷𑆪𑆂 𑇆𑇙𑇆
𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆓𑆩𑆤𑆳𑆢𑇀𑆓𑆠𑆴𑆫𑆴𑆠𑇀𑆪𑆠𑆯𑇀𑆖 𑆤𑆳𑆝𑆵𑆮 𑆪𑆢𑇀𑆮𑆲𑆠𑆴 𑆠𑆼𑆤 𑆩𑆠𑆳 𑆠𑆶 𑆤𑆳𑆝𑆵 𑇅 𑆢𑆾𑆰𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑆱𑆳 𑆥𑆸𑆡𑆓𑆼𑆑𑆯𑆯𑇀𑆖 𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆽𑆫𑆥𑆴 𑆖 𑆯𑆬𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆳 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆳𑆠𑇀 𑆥𑆫𑆶𑆰𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆩𑆶𑆒𑆵 𑆱𑆯𑆷𑆬𑆳 𑆦𑆼𑆤𑆳𑆤𑆶𑆮𑆴𑆢𑇀𑆣𑆩𑆣𑆴𑆑𑆁 𑆱𑇀𑆫𑆮𑆠𑆴 𑆑𑇀𑆰𑆥𑆳𑆪𑆳𑆩𑇀 𑇅 𑆠𑆸𑆛𑇀𑆠𑆳𑆥𑆠𑆾𑆢𑆱𑆢𑆤𑆘𑇀𑆮𑆫𑆨𑆼𑆢𑆲𑆼𑆠𑆶𑆂 𑆥𑆵𑆠𑆁 𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆣𑆴𑆑𑆩𑆶𑆰𑇀𑆟𑆩𑆲𑆂𑆱𑆶 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀 𑇆𑇑𑇑𑇆

𑆠𑆼𑆰𑆳𑆁 𑆠𑆢𑇀𑆮𑆖𑆤𑆁 𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆧𑇀𑆫𑆮𑆵𑆢𑇀𑆨𑆴𑆰𑆘𑆳𑆁𑆮𑆫𑆂 𑇅 𑆘𑇀𑆮𑆫𑆩𑆳𑆢𑆿 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱 𑆫𑆾𑆓𑆳𑆤𑆵𑆑𑆫𑆳𑆛𑇀 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇘𑇆
𑆫𑆶𑆢𑇀𑆫𑆑𑆾𑆥𑆳𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆨𑆷𑆠𑆂 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆥𑇀𑆫𑆠𑆳𑆥𑆤𑆂 𑇅 𑆠𑆽𑆱𑇀𑆠𑆽𑆫𑇀𑆤𑆳𑆩𑆨𑆴𑆫𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆳𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇙𑇆
𑆘𑆤𑇀𑆩𑆳𑆢𑆿 𑆤𑆴𑆣𑆤𑆼 𑆖𑆽𑆮 𑆥𑇀𑆫𑆳𑆪𑆾 𑆮𑆴𑆯𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆩𑇀 𑇅 𑆃𑆠𑆂 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆫𑆳𑆟𑆳𑆩𑆪𑆁 𑆫𑆳𑆘𑆳 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇑𑇐𑇆
𑆉𑆠𑆼 𑆢𑆼𑆮𑆩𑆤𑆶𑆰𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆤𑆳𑆤𑇀𑆪𑆾 𑆮𑆴𑆰𑆲𑆠𑆼 𑆠𑆶 𑆠𑆩𑇀 𑇅 𑆑𑆫𑇀𑆩𑆟𑆳 𑆬𑆨𑆠𑆼 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆼𑆮𑆠𑇀𑆮𑆁 𑆩𑆳𑆤𑆶𑆰𑆳𑆢𑆥𑆴 𑇆𑇑𑇑𑇆
𑆥𑆶𑆤𑆯𑇀𑆖𑆽𑆮 𑆖𑇀𑆪𑆶𑆠𑆂 𑆱𑇀𑆮𑆫𑇀𑆓𑆳𑆤𑇀𑆩𑆳𑆤𑆶𑆰𑇀𑆪𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆼 𑆢𑆼𑆮𑆨𑆳𑆮𑆼𑆤 𑆱𑆲𑆤𑇀𑆠𑆼 𑆩𑆳𑆤𑆶𑆰𑆳 𑆘𑇀𑆮𑆫𑆩𑇀 𑇆𑇑𑇒𑇆
𑆯𑆼𑆰𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆮𑆴𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆽𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆳 𑆘𑇀𑆮𑆫𑆳𑆫𑇀𑆢𑆴𑆠𑆳𑆂 𑇅 𑆱𑇀𑆮𑆼𑆢𑆳𑆮𑆫𑆾𑆣𑆂 𑆱𑆤𑇀𑆠𑆳𑆥𑆂 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆓𑇀𑆫𑆲𑆟𑆁 𑆠𑆡𑆳 𑇆𑇑𑇓𑇆
𑆮𑆴𑆑𑆳𑆫𑆳 𑆪𑆶𑆓𑆥𑆢𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆘𑇀𑆮𑆫𑆂 𑆱 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇅 𑆢𑆾𑆰𑆽𑆂 𑆥𑆸𑆡𑆑𑇀 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆽𑆫𑆳𑆓𑆤𑇀𑆠𑆶𑆫𑆼𑆮 𑆖 𑇆𑇑𑇔𑇆
𑆃𑆤𑆼𑆑𑆑𑆳𑆫𑆟𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆂 𑆱𑇀𑆩𑆸𑆠𑆱𑇀𑆠𑇀𑆮𑆰𑇀𑆛𑆮𑆴𑆣𑆾 𑆘𑇀𑆮𑆫𑆂 𑇅 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆱𑇀𑆮𑆼𑆰𑆶 𑆑𑆳𑆬𑆼𑆰𑆶 𑆱𑇀𑆮𑆽𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆽𑆂 𑇆𑇑𑇕𑇆
𑆮𑇀𑆪𑆳𑆥𑇀𑆪 𑆢𑆼𑆲𑆩𑆯𑆼𑆰𑆼𑆟 𑆘𑇀𑆮𑆫𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆢𑆶𑆰𑇀𑆛𑆳𑆂 𑆱𑇀𑆮𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆩𑆷𑆰𑇀𑆩𑆟𑆳 𑇆𑇑𑇖𑇆
𑆱𑆲𑆴𑆠𑆳 𑆫𑆱𑆩𑆳𑆓𑆠𑇀𑆪 𑆫𑆱𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆟𑆳𑆩𑇀 𑇅 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆮𑆸𑆠𑇀𑆪 𑆩𑆤𑇀𑆢𑆵𑆑𑆸𑆠𑇀𑆪 𑆲𑆶𑆠𑆳𑆯𑆤𑆩𑇀 𑇆𑇑𑇗𑇆
𑆤𑆴𑆫𑆱𑇀𑆪 𑆧𑆲𑆴𑆫𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆥𑆑𑇀𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆖𑇀𑆖 𑆑𑆼𑆮𑆬𑆩𑇀 𑇅 𑆯𑆫𑆵𑆫𑆁 𑆱𑆩𑆨𑆴𑆮𑇀𑆪𑆳𑆥𑇀𑆪 𑆱𑇀𑆮𑆑𑆳𑆬𑆼𑆰𑆶 𑆘𑇀𑆮𑆫𑆳𑆓𑆩𑆩𑇀 𑇆𑇑𑇘𑇆
𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆡 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆮𑆳 𑆱𑇀𑆮𑆮𑆫𑇀𑆟𑆁 𑆖 𑆠𑇀𑆮𑆓𑆳𑆢𑆴𑆰𑆶 𑇅 𑆩𑆴𑆡𑇀𑆪𑆳𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆥𑆴 𑆖 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑇀𑆪𑆽𑆂 𑆑𑆫𑇀𑆩𑆨𑆴𑆫𑇀𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇑𑇙𑇆
𑆮𑆴𑆮𑆴𑆣𑆳𑆢𑆨𑆴𑆔𑆳𑆠𑆳𑆖𑇀𑆖 𑆫𑆾𑆓𑆾𑆠𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆥𑆳𑆑𑆠𑆂 𑇅 𑆯𑇀𑆫𑆩𑆳𑆠𑇀 𑆑𑇀𑆰𑆪𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆳𑆖𑇀𑆖 𑆮𑆴𑆰𑆳𑆠𑇀𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆫𑇀𑆠𑆶𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀 𑇆𑇒𑇐𑇆
𑆏𑆰𑆣𑆵𑆥𑆶𑆰𑇀𑆥𑆓𑆤𑇀𑆣𑆳𑆖𑇀𑆖 𑆯𑆾𑆑𑆳𑆤𑇀𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆥𑆵𑆝𑆪𑆳 𑇅 𑆃𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆤𑆾𑆨𑆷𑆠𑆳𑆨𑆴𑆯𑆕𑇀𑆑𑆪𑆳 𑇆𑇒𑇑𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆩𑆥𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆠𑆡𑆳𑇁𑆲𑆴𑆠𑆽𑆂 𑇅 𑆱𑇀𑆠𑆤𑇀𑆪𑆳𑆮𑆠𑆫𑆟𑆼 𑆖𑆽𑆮 𑆘𑇀𑆮𑆫𑆾 𑆢𑆾𑆰𑆽𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇒𑇒𑇆
𑆠𑆽𑆫𑇀𑆮𑆼𑆓𑆮𑆢𑇀𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆣𑆳 𑆱𑆩𑆶𑆢𑇀𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆩𑆳𑆫𑇀𑆓𑆓𑆽𑆂 𑇅 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆩𑆳𑆟𑆾𑇁𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆫𑇀𑆨𑆮𑆠𑇀𑆪𑆳𑆯𑆶 𑆧𑆲𑆴𑆯𑇀𑆖𑆫𑆂 𑇆𑇒𑇓𑇆
𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆖𑆳𑆥𑇀𑆪𑆥𑆳𑆤𑇀𑆣𑆳𑆠𑆶𑆁 𑆪𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆳𑆠𑆶𑆫𑆂 𑇅 𑆨𑆮𑆠𑇀𑆪𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆓𑆳𑆠𑇀𑆫𑆯𑇀𑆖 𑆘𑇀𑆮𑆫𑆴𑆠𑆱𑇀𑆠𑆼𑆤 𑆖𑆾𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇔𑇆
𑆯𑇀𑆫𑆩𑆾𑇁𑆫𑆠𑆴𑆫𑇀𑆮𑆴𑆮𑆫𑇀𑆟𑆠𑇀𑆮𑆁 𑆮𑆽𑆫𑆱𑇀𑆪𑆁 𑆤𑆪𑆤𑆥𑇀𑆬𑆮𑆂 𑇅 𑆅𑆖𑇀𑆗𑆳𑆢𑇀𑆮𑆼𑆰𑆿 𑆩𑆶𑆲𑆶𑆯𑇀𑆖𑆳𑆥𑆴 𑆯𑆵𑆠𑆮𑆳𑆠𑆳𑆠𑆥𑆳𑆢𑆴𑆰𑆶 𑇆𑇒𑇕𑇆
𑆘𑆸𑆩𑇀𑆨𑆳𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾 𑆓𑆶𑆫𑆶𑆠𑆳 𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆾𑇁𑆫𑆶𑆖𑆴𑆱𑇀𑆠𑆩𑆂 𑇅 𑆃𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆯𑇀𑆖 𑆯𑆵𑆠𑆁 𑆖 𑆨𑆮𑆠𑇀𑆪𑆶𑆠𑇀𑆥𑆠𑇀𑆱𑇀𑆪𑆠𑆴 𑆘𑇀𑆮𑆫𑆼 𑇆𑇒𑇖𑇆
𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆾, 𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀𑆠𑆶 𑆘𑆸𑆩𑇀𑆨𑆳𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑆩𑆵𑆫𑆟𑆳𑆠𑇀 𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑇀𑆤𑆪𑆤𑆪𑆾𑆫𑇀𑆢𑆳𑆲𑆂, 𑆑𑆦𑆳𑆤𑇀𑆤𑆳𑆤𑇀𑆤𑆳𑆨𑆴𑆤𑆤𑇀𑆢𑆤𑆩𑇀 𑇆𑇒𑇗𑇆
𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆱𑆩𑆮𑆳𑆪𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆘𑆼 𑇅 𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑆶 𑆫𑆷𑆥𑆼𑆟 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆁 𑆮𑆴𑆢𑆶𑆂 𑇆𑇒𑇘𑇆
𑆮𑆼𑆥𑆡𑆶𑆫𑇀𑆮𑆴𑆰𑆩𑆾 𑆮𑆼𑆓𑆂 𑆑𑆟𑇀𑆜𑆿𑆰𑇀𑆜𑆥𑆫𑆴𑆯𑆾𑆰𑆟𑆩𑇀 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆂 𑆑𑇀𑆰𑆶𑆠𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆾 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆩𑆼𑆮 𑆖 𑇆𑇒𑇙𑇆

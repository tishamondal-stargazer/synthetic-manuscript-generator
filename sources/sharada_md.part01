𑆃𑆡𑆳𑆠𑆂 𑆯𑆾𑆰𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆤𑆼𑆑𑆫𑆾𑆓𑆳𑆤𑆶𑆓𑆠𑆾 𑆧𑆲𑆶𑆫𑆾𑆓𑆥𑆶𑆫𑆾𑆓𑆩𑆂 𑇅 𑆢𑆶𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆢𑆶𑆫𑇀𑆤𑆴𑆮𑆳𑆫𑆂 𑆯𑆾𑆰𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑇀𑆩𑆲𑆳𑆧𑆬𑆂 𑇆𑇓𑇆
𑆫𑆳𑆘𑇀𑆚𑆯𑇀𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆱𑆾 𑆪𑆱𑇀𑆩𑆳𑆢𑆨𑆷𑆢𑆼𑆰 𑆑𑆴𑆬𑆳𑆩𑆪𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆁 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆼𑆠𑆴 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂 𑆥𑆶𑆤𑆫𑇀𑆘𑆤𑆳𑆂 𑇆𑇕𑇆
𑆱 𑆮𑇀𑆪𑆱𑇀𑆠𑆽𑆫𑇀𑆘𑆳𑆪𑆠𑆼 𑆢𑆾𑆰𑆽𑆫𑆴𑆠𑆴 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆢𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅𑇖𑇅 𑆍𑆑𑆳𑆢𑆯𑆳𑆤𑆳𑆩𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆳𑆤𑇀𑆤𑆴𑆣𑇀𑆪𑆳𑆠𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆴𑆠𑆂 𑇆𑇖𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆥𑇀𑆫𑆳𑆓𑆼𑆑𑆾𑆠𑇀𑆥𑆳𑆢𑆤𑆼𑆤 𑆖 𑇅 𑆍𑆑 𑆍𑆮 𑆩𑆠𑆂 𑆯𑆾𑆰𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆠𑇀𑆩𑆑𑆾 𑆲𑇀𑆪𑆠𑆂 𑇆𑇗𑇆
𑆇𑆢𑇀𑆫𑆼𑆑𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆤𑆴𑆥𑆠𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆮𑆼𑆓𑆥𑇀𑆫𑆠𑆵𑆔𑆳𑆠𑆳𑆢𑆳𑆔𑆳𑆠𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆳𑆠𑇀 𑇆𑇘𑇆
𑆃𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆤𑆾 𑆮𑆳𑇁𑆥𑆴 𑆑𑇀𑆰𑆵𑆟𑆼 𑆫𑆼𑆠𑆱𑇀𑆪𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇅 𑆑𑇀𑆰𑆵𑆪𑆤𑇀𑆠𑆼 𑆣𑆳𑆠𑆮𑆂 𑆱𑆫𑇀𑆮𑆼 𑆠𑆠𑆂 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆩𑆳𑆤𑆮𑆂 𑇆𑇑𑇐𑇆
𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆾 𑆘𑇀𑆮𑆫𑆂 𑆯𑇀𑆮𑆳𑆱𑆂 𑆑𑆳𑆱𑆂 𑆯𑆾𑆟𑆴𑆠𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇅 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆯𑇀𑆖 𑆘𑆳𑆪𑆼𑆠 𑆰𑆝𑇀𑆫𑆷𑆥𑆼 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆟𑆴 𑇆𑇑𑇑𑇆
𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆾𑇁𑆤𑆴𑆬𑆳𑆚𑇀𑆗𑆷𑆬𑆁 𑆱𑆁𑆬𑆾𑆖𑆯𑇀𑆖𑆳𑆁𑆱𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆂 𑇅 𑆘𑇀𑆮𑆫𑆾 𑆢𑆳𑆲𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆓𑆩𑆂 𑇆𑇑𑇒𑇆
𑆯𑆴𑆫𑆱𑆂 𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆠𑇀𑆮𑆩𑆨𑆑𑇀𑆠𑆖𑇀𑆗𑆤𑇀𑆢 𑆍𑆮 𑆖 𑇅 𑆑𑆳𑆱𑆂 𑆑𑆟𑇀𑆜𑆱𑇀𑆪 𑆖𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆾 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆑𑆦𑆑𑆾𑆥𑆠𑆂 𑇆𑇑𑇓𑇆
𑆍𑆑𑆳𑆢𑆯𑆨𑆴𑆫𑆼𑆨𑆴𑆫𑇀𑆮𑆳 𑆰𑆝𑇀𑆨𑆴𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇅 (𑆑𑆳𑆱𑆳𑆠𑆵𑆱𑆳𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆫𑇀𑆠𑆴𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆳𑆫𑆶𑆖𑆴𑆘𑇀𑆮𑆫𑆽𑆂 𑇆𑇑𑇔𑇆
𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆥𑆵𑆝𑆴𑆠𑆁 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆘𑇀𑆮𑆫𑆑𑆳𑆱𑆳𑆱𑆸𑆓𑆳𑆩𑆪𑆽𑆂) 𑇅 𑆘𑆲𑇀𑆪𑆳𑆖𑇀𑆗𑆾𑆰𑆳𑆫𑇀𑆢𑆴𑆠𑆁 𑆘𑆤𑇀𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆤𑇀 𑆱𑆶𑆮𑆴𑆥𑆶𑆬𑆁 𑆪𑆯𑆂 𑇆𑇑𑇕𑇆
𑆮𑇀𑆪𑆮𑆳𑆪𑆯𑆾𑆑𑆱𑇀𑆡𑆳𑆮𑆴𑆫𑇀𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆣𑇀𑆮𑆾𑆥𑆮𑆳𑆱𑆠𑆂 𑇅 𑆮𑇀𑆫𑆟𑆾𑆫𑆂𑆑𑇀𑆰𑆠𑆥𑆵𑆝𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆾𑆰𑆤𑆤𑇀𑆪𑆼 𑆮𑆢𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇑𑇖𑇆
𑆮𑇀𑆪𑆮𑆳𑆪𑆯𑆾𑆰𑆵 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆑𑇀𑆰𑆪𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆢𑆼𑆲𑆾 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆑𑇀𑆰𑆵𑆪𑆤𑇀𑆠𑆼 𑆖𑆳𑆱𑇀𑆪 𑆣𑆳𑆠𑆮𑆂 𑇆𑇑𑇗𑇆
𑆥𑇀𑆫𑆣𑇀𑆪𑆳𑆤𑆯𑆵𑆬𑆂 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆂 𑆯𑆾𑆑𑆯𑆾𑆰𑇀𑆪𑆥𑆴 𑆠𑆳𑆢𑆸𑆯𑆂 𑇅 𑆮𑆴𑆤𑆳 𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆑𑆸𑆠𑆽𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆫𑆨𑆴𑆬𑆑𑇀𑆰𑆴𑆠𑆂 𑇆𑇑𑇘𑇆
𑆘𑆫𑆳𑆯𑆾𑆰𑆵 𑆑𑆸𑆯𑆾 𑆩𑆤𑇀𑆢𑆮𑆵𑆫𑇀𑆪𑆧𑆶𑆢𑇀𑆣𑆴𑆧𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂 𑇅 𑆑𑆩𑇀𑆥𑆤𑆾𑇁𑆫𑆶𑆖𑆴𑆩𑆳𑆤𑇀 𑆨𑆴𑆤𑇀𑆤𑆑𑆳𑆁𑆱𑇀𑆪𑆥𑆳𑆠𑇀𑆫𑆲𑆠𑆱𑇀𑆮𑆫𑆂(𑆤𑆂) 𑇆𑇑𑇙𑇆
𑆰𑇀𑆜𑆵𑆮𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆲𑆵𑆤𑆁 𑆓𑆿𑆫𑆮𑆳𑆫𑆶𑆖𑆴𑆥𑆵𑆝𑆴𑆠𑆂 𑇅 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆳𑆱𑇀𑆪𑆤𑆳𑆱𑆳𑆑𑇀𑆰𑆂 𑆱𑆶𑆥𑇀𑆠𑆫𑆷𑆑𑇀𑆰𑆩𑆬𑆖𑇀𑆗𑆮𑆴𑆂 𑇆𑇒𑇐𑇆
𑆃𑆣𑇀𑆮𑆥𑇀𑆫𑆯𑆾𑆰𑆵 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆂 𑆱𑆩𑇀𑆨𑆸𑆰𑇀𑆛𑆥𑆫𑆶𑆰𑆖𑇀𑆗𑆮𑆴𑆂 𑇅 𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆳𑆮𑆪𑆮𑆂 𑆯𑆶𑆰𑇀𑆑𑆑𑇀𑆬𑆾𑆩𑆓𑆬𑆳𑆤𑆤𑆂 𑇆𑇒𑇑𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆾𑆰𑆵 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆼𑆨𑆴𑆫𑆼𑆮 𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆂 𑇅 𑆇𑆫𑆂𑆑𑇀𑆰𑆠𑆑𑆸𑆠𑆽𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆽𑆂 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆯𑇀𑆖 𑆑𑇀𑆰𑆠𑆳𑆢𑇀𑆮𑆴𑆤𑆳 𑇆𑇒𑇒𑇆
𑆫𑆑𑇀𑆠𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆱𑇀𑆠𑆡𑆽𑆮𑆳𑆲𑆳𑆫𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆳𑆠𑇀 𑇅 𑆮𑇀𑆫𑆟𑆴𑆠𑆱𑇀𑆪 𑆨𑆮𑆼𑆖𑇀𑆗𑆾𑆰𑆂 𑆱 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆠𑆩𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇒𑇓𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆨𑆳𑆫𑆳𑆣𑇀𑆪𑆪𑆤𑆽𑆫𑆨𑆴𑆔𑆳𑆠𑆳𑆠𑆴𑆩𑆽𑆡𑆶𑆤𑆽𑆂 𑇅 𑆑𑆫𑇀𑆩𑆟𑆳 𑆖𑆳𑆥𑇀𑆪𑆶𑆫𑆱𑇀𑆪𑆼𑆤 𑆮𑆑𑇀𑆰𑆾 𑆪𑆱𑇀𑆪 𑆮𑆴𑆢𑆳𑆫𑆴𑆠𑆩𑇀 𑇅 𑆠𑆱𑇀𑆪𑆾𑆫𑆱𑆴 𑆑𑇀𑆰𑆠𑆼 𑆫𑆑𑇀𑆠𑆁 𑆥𑆷𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆖 𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇒𑇔𑇆
𑆑𑆳𑆱𑆩𑆳𑆤𑆯𑇀𑆗𑆫𑇀𑆢𑆪𑆼𑆖𑇀𑆖 𑆥𑆵𑆠𑆫𑆑𑇀𑆠𑆳𑆱𑆴𑆠𑆳𑆫𑆶𑆟𑆩𑇀 𑇅 𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆮𑆑𑇀𑆰𑆳𑆂 𑆱𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆷𑆪𑆤𑆳𑆠𑇀𑆥𑆫𑆴𑆠𑆳𑆩𑇀𑆪𑆠𑆴 𑇆𑇒𑇕𑇆
𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆮𑆢𑆤𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆾 𑆨𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆾 𑆤𑆫𑆂 𑇅𑇒𑇖𑇅 𑆑𑆼𑆰𑆳𑆚𑇀𑆖𑆴𑆢𑆼𑆮𑆁 𑆯𑆾𑆰𑆾 𑆲𑆴 𑆑𑆳𑆫𑆟𑆽𑆫𑇀𑆨𑆼𑆢𑆩𑆳𑆓𑆠𑆂 𑇆𑇒𑇖𑇆
𑆤 𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆥𑆳𑆠𑆤𑆩𑇀 𑇅 𑆑𑇀𑆰𑆪𑆳 𑆍𑆮 𑆲𑆴 𑆠𑆼 𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆁 𑆣𑆳𑆠𑆶𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑆂 𑇆𑇒𑇗𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆠𑆶 𑆠𑆼𑆰𑆳𑆁 𑆲𑆴 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆁 𑆣𑆳𑆠𑆶𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆼 𑇆𑇒𑇘𑇆
𑆯𑇀𑆮𑆳𑆱𑆳𑆕𑇀𑆓𑆱𑆳𑆢𑆑𑆦𑆱𑆁𑆱𑇀𑆫𑆮𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆩𑆢𑆥𑆵𑆤𑆱𑆥𑆳𑆟𑇀𑆝𑆶𑆤𑆴𑆢𑇀𑆫𑆳𑆂 𑇅 𑆯𑆾𑆰𑆼 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆱 𑆖𑆳𑆥𑆴 𑆘𑆤𑇀𑆠𑆶𑆂 𑆯𑆶𑆑𑇀𑆬𑆼𑆑𑇀𑆰𑆟𑆾 𑆨𑆮𑆠𑆴 𑆩𑆳𑆁𑆱𑆥𑆫𑆾 𑆫𑆴𑆫𑆁𑆱𑆶𑆂 𑇆𑇒𑇙𑇆
𑆱𑇀𑆮𑆥𑇀𑆤𑆼𑆰𑆶 𑆑𑆳𑆑𑆯𑆶𑆑𑆯𑆬𑇀𑆬𑆑𑆴𑆤𑆵𑆬𑆑𑆟𑇀𑆜𑆓𑆸𑆣𑇀𑆫𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑆑𑆥𑆪𑆂 𑆑𑆸𑆑𑆬𑆳𑆱𑆑𑆳𑆯𑇀𑆖 𑇅 𑆠𑆁 𑆮𑆳𑆲𑆪𑆤𑇀𑆠𑆴 𑆱 𑆤𑆢𑆵𑆫𑇀𑆮𑆴𑆘𑆬𑆳𑆯𑇀𑆖 𑆥𑆯𑇀𑆪𑆼𑆖𑇀𑆗𑆶𑆰𑇀𑆑𑆳𑆁𑆱𑇀𑆠𑆫𑆷𑆤𑇀 𑆥𑆮𑆤𑆣𑆷𑆩𑆢𑆮𑆳𑆫𑇀𑆢𑆴𑆠𑆳𑆁𑆯𑇀𑆖 𑇆𑇓𑇐𑇆
𑆇𑆥𑆳𑆖𑆫𑆼𑆢𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆁 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆴𑆩𑆑𑆸𑆯𑆁 𑆤𑆮𑆩𑇀 𑇅𑇓𑇒𑇅 𑆱𑇀𑆡𑆴𑆫𑆳𑆢𑆴𑆮𑆫𑇀𑆓𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆔𑆸𑆠𑆼𑆤𑆳𑆘𑆳𑆮𑆴𑆑𑆼𑆤 𑆖 𑇆𑇓𑇒𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆩𑆸𑆢𑆶 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆳𑆣𑆯𑇀𑆖 𑆯𑆾𑆣𑆤𑆩𑇀 𑇅 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆠𑆡𑆳 𑆑𑆳𑆫𑇀𑆪𑆁 𑆯𑆴𑆫𑆱𑆯𑇀𑆖 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇆𑇓𑇓𑇆
𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆯𑆳𑆬𑆵𑆁𑆯𑇀𑆖 𑆫𑆱𑆽𑆫𑇀𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆯𑆾𑆣𑆴𑆠𑆂 𑇅𑇓𑇔𑇅 𑆢𑆸𑆞𑆼𑇁𑆓𑇀𑆤𑆿 𑆧𑆸𑆁𑆲𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆤𑆫𑆩𑇀 𑇆𑇓𑇔𑇆
𑆮𑇀𑆪𑆮𑆳𑆪𑆯𑆾𑆰𑆴𑆟𑆁 𑆥𑇀𑆫𑆳𑆪𑆾 𑆨𑆘𑆤𑇀𑆠𑆼 𑆮𑆳𑆠𑆘𑆳 𑆓𑆢𑆳𑆂 𑇅 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆾 𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆽 𑆲𑆴𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑇁𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇆𑇓𑇕𑇆
𑆩𑆳𑆁𑆱𑆾𑆥𑆢𑆁𑆯𑆳𑆁𑆯𑇀𑆖 𑆥𑆴𑆧𑆼𑆢𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆩𑆳𑆫𑇀𑆢𑇀𑆮𑆵𑆑𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀 𑆩𑆢𑆴𑆫𑆳𑆯𑇀𑆖 𑆱𑆼𑆮𑇀𑆪𑆳𑆂 𑇅 𑆃𑆫𑇀𑆑𑆳𑆩𑆸𑆠𑆳𑆑𑇀𑆰𑆳𑆫𑆘𑆬𑆾𑆰𑆴𑆠𑆼𑆨𑇀𑆪𑆂 𑆑𑆸𑆠𑇀𑆮𑆳 𑆪𑆮𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆮𑆴𑆣𑆳𑆁𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀 𑇆𑇓𑇘𑇆
𑆒𑆳𑆢𑆼𑆠𑇀, 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆫𑆘𑆳𑆮𑆴𑆑𑆁 𑆮𑆳 𑆑𑆸𑆯𑆾 𑆪𑆮𑆳𑆓𑇀𑆮𑆳 𑆱𑆲 𑆨𑆑𑇀𑆠𑆑𑆳𑆬𑆼 𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆨𑇀𑆪𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶 𑆥𑇀𑆫𑆬𑆴𑆲𑇀𑆪𑆳𑆖𑇀𑆖𑆮𑇀𑆪𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆾𑆥𑆲𑆴𑆠𑆁 𑆑𑇀𑆰𑆪𑆳𑆫𑇀𑆠𑆂 𑇆𑇓𑇙𑇆
𑆩𑆳𑆁𑆱𑆳𑆢𑆩𑆳𑆁𑆱𑆼𑆰𑆶 𑆔𑆸𑆠𑆁 𑆖 𑆱𑆴𑆢𑇀𑆣𑆁 𑆯𑆾𑆰𑆳𑆥𑆲𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆑𑆟𑆳𑆱𑆩𑆼𑆠𑆩𑇀 𑇅𑇔𑇐𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆱𑆴𑆠𑆳𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆮𑆬𑆼𑆲𑆂 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆠𑆽𑆬𑆂 𑆑𑇀𑆰𑆪𑆫𑆾𑆓𑆔𑆳𑆠𑆵 𑇆𑇔𑇐𑇆
𑆔𑆸𑆠𑆼𑆤 𑆖𑆳𑆘𑆼𑆤 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆼𑆟 𑆠𑆶𑆫𑆕𑇀𑆓𑆓𑆤𑇀𑆣𑆳𑆠𑆴𑆬𑆩𑆳𑆰𑆖𑆷𑆫𑇀𑆟𑆩𑇀 𑇅𑇔𑇑𑇅 𑆱𑆴𑆠𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆩𑆓𑆣𑆾𑆢𑇀𑆨𑆮𑆳𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆠𑆁 𑆥𑇀𑆫𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑇆𑇔𑇑𑇆
𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆡 𑆮𑆳𑆘𑆴𑆓𑆤𑇀𑆣𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑆼𑆮𑆁 𑆬𑆨𑆠𑆼𑇁𑆕𑇀𑆓𑆥𑆶𑆰𑇀𑆛𑆴𑆩𑇀 𑇅𑇔𑇒𑇅 𑆠𑆢𑆶𑆠𑇀𑆡𑆴𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆔𑆸𑆠𑆁 𑆱𑆴𑆠𑆳𑆞𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆥𑆪𑆾𑆤𑆶𑆥𑆳𑆤𑆩𑇀 𑇆𑇔𑇒𑇆
𑆇𑆠𑇀𑆱𑆳𑆢𑆤𑆼 𑆖𑆳𑆥𑆴 𑆠𑆶𑆫𑆕𑇀𑆓𑆓𑆤𑇀𑆣𑆳 𑆪𑆾𑆘𑇀𑆪𑆳 𑆪𑆮𑆳𑆯𑇀𑆖𑆽𑆮 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆼 𑆖 𑇅 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆼 𑆮𑆸𑆰𑆼 𑆠𑆠𑇀𑆑𑆶𑆱𑆶𑆩𑆽𑆯𑇀𑆖 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆠𑆁 𑆲𑆴𑆠𑆳𑆯𑆵 𑇆𑇔𑇓𑇆
𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆧𑆬𑆁 𑆖 𑆑𑆳𑆱𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆖 𑆲𑆤𑇀𑆪𑆳𑆢𑆥𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆁 𑆖 𑇅𑇔𑇔𑇅 𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆳 𑆓𑆾𑆯𑇀𑆮𑆓𑆘𑆳𑆮𑇀𑆪𑆘𑆳𑆤𑆳𑆁 𑆑𑇀𑆮𑆳𑆡𑆳 𑆩𑆴𑆠𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆠𑆡𑆽𑆮 𑆨𑆳𑆓𑆽𑆂 𑇆𑇔𑇔𑇆
𑆩𑆷𑆫𑇀𑆮𑆳𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆒𑆢𑆴𑆫𑆢𑇀𑆫𑆶𑆩𑆳𑆟𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆱𑇀𑆪 𑆨𑆳𑆓𑆱𑇀𑆠𑇀𑆮𑆥𑆫𑆾 𑆔𑆸𑆠𑆱𑇀𑆪 𑇅 𑆨𑆳𑆓𑆳𑆤𑇀 𑆢𑆯𑆽𑆠𑆳𑆤𑇀 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆘𑇀𑆚𑆾 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆓𑆁 𑆩𑆣𑆶𑆫𑆁 𑆖 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆩𑇀 𑇆𑇔𑇕𑇆
𑆑𑆛𑆶𑆠𑇀𑆫𑆴𑆑𑆁 𑆖𑆽𑆮 𑆱𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶 𑆔𑆸𑆠𑆾𑆠𑇀𑆠𑆩𑆁 𑆪𑆑𑇀𑆰𑇀𑆩𑆤𑆴𑆮𑆳𑆫𑆟𑆳𑆪 𑇅𑇔𑇖𑇅 𑆢𑇀𑆮𑆼 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆮𑆫𑆶𑆟𑆁 𑆑𑆫𑆚𑇀𑆘𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆁 𑆧𑆴𑆬𑇀𑆮𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆼 𑆖 𑇆𑇔𑇖𑇆
𑆪𑆮𑆳𑆤𑇀 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑇀 𑆧𑆢𑆫𑆳𑆟𑆴 𑆨𑆳𑆫𑇀𑆓𑆵𑆁 𑆥𑆳𑆜𑆳𑆁 𑆲𑆶𑆠𑆳𑆯𑆁 𑆱𑆩𑆲𑆵𑆑𑆢𑆩𑇀𑆧𑆩𑇀 𑇅 𑆑𑆸𑆠𑇀𑆮𑆳 𑆑𑆰𑆳𑆪𑆁 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆣𑆴 𑆠𑆱𑇀𑆪 𑆰𑆝𑇀𑆨𑆴𑆫𑇀𑆲𑆴 𑆥𑆳𑆠𑇀𑆫𑆽𑆫𑇀𑆔𑆸𑆠𑆥𑆳𑆠𑇀𑆫𑆩𑆼𑆑𑆩𑇀 𑇆𑇔𑇗𑇆
𑆮𑇀𑆪𑆾𑆰𑆁 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆥𑆪𑆾𑇁𑆨𑆪𑆳𑆁 𑆖 𑆖𑆮𑇀𑆪𑆁 𑆱𑆶𑆫𑆳𑆒𑇀𑆪𑆁 𑆬𑆮𑆟𑆾𑆠𑇀𑆠𑆩𑆁 𑆖 𑇅 𑆍𑆠𑆢𑇀𑆣𑆴 𑆯𑆾𑆰𑆁 𑆘𑆜𑆫𑆳𑆟𑆴 𑆖𑆽𑆮 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆱𑆲𑆳𑆤𑆴𑆬𑆼𑆤 𑇆𑇔𑇘𑇆
𑆓𑆾𑆯𑇀𑆮𑆳𑆮𑇀𑆪𑆘𑆼𑆨𑆽𑆟𑆒𑆫𑆾𑆰𑇀𑆛𑇀𑆫𑆘𑆳𑆠𑆽𑆂 𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆑𑇀𑆰𑆵𑆫𑆫𑆱𑆑𑇀𑆰𑆠𑆾𑆠𑇀𑆡𑆽𑆂 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆩𑆓𑆣𑆳𑆱𑆴𑆠𑆳𑆨𑆴𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆔𑆸𑆠𑆁 𑆪𑆑𑇀𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆲𑆳𑆫𑆴 𑇆𑇔𑇙𑇆

𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆩𑆼𑆲𑆼𑆰𑆶 𑆑𑆦𑆳𑆩𑆪𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆯𑆾𑆦𑆼𑆰𑆶 𑆖 𑆢𑆳𑆫𑆶𑆟𑆼𑆰𑆶 𑇅 𑆑𑆸𑆯𑆠𑇀𑆮𑆩𑆴𑆖𑇀𑆗𑆠𑇀𑆱𑆶 𑆖 𑆩𑆼𑆢𑆶𑆫𑆼𑆰𑆶 𑆪𑆾𑆓𑆳𑆤𑆴𑆩𑆳𑆤𑆓𑇀𑆫𑇀𑆪𑆩𑆠𑆴𑆫𑇀𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇓𑇆
𑆑𑇀𑆰𑆶𑆟𑇀𑆟𑆳𑆤𑇀 𑆪𑆮𑆳𑆤𑇀𑆤𑆴𑆰𑇀𑆥𑆷𑆠𑆳𑆤𑇀 𑆫𑆳𑆠𑇀𑆫𑆿 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆳𑆤𑇀 𑆩𑆲𑆠𑆴 𑆑𑆴𑆬𑆴𑆚𑇀𑆘𑆼 𑆯𑆾𑆰𑆪𑆼𑆠𑇀, 𑆍𑆮𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆨𑆳𑆮𑆪𑆼𑆖𑇀𑆗𑆾𑆰𑆪𑆼𑆖𑇀𑆖, 𑆠𑆠𑆱𑇀𑆠𑆳𑆤𑇀 𑆑𑆥𑆳𑆬𑆨𑆸𑆰𑇀𑆛𑆳𑆤𑇀 𑆯𑆑𑇀𑆠𑆷𑆤𑇀 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳, 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆼𑆮 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆁 𑆮𑆳 𑆱𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆑𑆟𑇀𑆛𑆑𑆴𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑇀𑆫𑆥𑆶𑆤𑇀𑆤𑆳𑆝𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆳𑆫𑇀𑆑𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆶𑆱𑇀𑆠𑆖𑆷𑆫𑇀𑆟𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀; 𑆍𑆮𑆩𑆼𑆮 𑆱𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑆳𑆩𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆓𑆮𑆳𑆯𑇀𑆮𑆳𑆯𑆑𑆸𑆢𑇀𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆪𑆮𑆳𑆤𑆳𑆁 𑆯𑆑𑇀𑆠𑆷𑆤𑇀 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆪 𑆒𑆢𑆴𑆫𑆳𑆯𑆤𑆤𑆴𑆩𑇀𑆧𑆫𑆳𑆘𑆮𑆸𑆑𑇀𑆰𑆫𑆾𑆲𑆵𑆠𑆑𑆓𑆶𑆝𑆷𑆖𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆼𑆟 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆮𑆼𑆠𑆱𑆳𑆩𑇀𑆬𑆼𑆤 𑆱𑆽𑆤𑇀𑆣𑆮𑆬𑆮𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆼𑆤 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆍𑆰 𑆱𑆫𑇀𑆮𑆩𑆤𑇀𑆡𑆑𑆬𑇀𑆥𑆂 𑇆𑇔𑇆
𑆪𑆳𑆮𑆑𑆳𑆁𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑇀 𑆣𑆳𑆤𑆾𑆬𑆶𑆩𑇀𑆧𑆑𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆳𑆥𑆷𑆥𑆥𑆷𑆫𑇀𑆟𑆑𑆾𑆯𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆯𑆰𑇀𑆑𑆶𑆬𑆴𑆑𑆳𑆑𑆶𑆟𑆳𑆮𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑇀 𑆱𑆼𑆮𑆼𑆠; 𑆪𑆮𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆓𑆾𑆣𑆷𑆩𑆮𑆼𑆟𑆶𑆪𑆮𑆳𑆤𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇆𑇕𑇆
𑆃𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑆠𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆥𑆷𑆠𑆵𑆑𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆱𑆳𑆫𑆴𑆮𑆳𑆢𑆤𑇀𑆠𑆵𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆑𑆁 𑆰𑆛𑇀𑆥𑆬𑆴𑆑𑆳 𑆨𑆳𑆓𑆳 𑆧𑆢𑆫𑆑𑆶𑆝𑆮𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆶𑆝𑆮 𑆅𑆠𑇀𑆪𑆼𑆠𑆼𑆰𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴, 𑆠𑆠𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆣𑆶𑆔𑆸𑆠𑆽𑆫𑆤𑇀𑆠𑆂𑆥𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆼 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆼 𑆥𑇀𑆫𑆳𑆑𑇀𑆑𑆸𑆠𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆼 𑆱𑆥𑇀𑆠𑆾𑆢𑆑𑆑𑆶𑆝𑆮𑆳𑆤𑆪𑆾𑆫𑆘𑆾𑇁𑆫𑇀𑆣𑆑𑆶𑆝𑆮𑆩𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆖 𑆓𑆶𑆝𑆱𑇀𑆪𑆳𑆨𑆴𑆲𑆴𑆠𑆳𑆤𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆪 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆪𑆮𑆥𑆬𑇀𑆬𑆼 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳𑆱𑆪𑆼𑆠𑇀, 𑆠𑆠𑆾 𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆍𑆰𑆾𑇁𑆫𑆴𑆰𑇀𑆛𑆂 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆩𑆼𑆢𑆂𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆯𑇀𑆮𑆪𑆡𑆷𑆤𑆥𑆲𑆤𑇀𑆠𑆴 𑇅 𑆍𑆮𑆁 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆿 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆳𑆮𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆿 𑆖𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇖𑇆
𑆄𑆱𑆮𑆳𑆤𑆠𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆥𑆬𑆳𑆯𑆨𑆱𑇀𑆩𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆱𑇀𑆪𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆱𑇀𑆪 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆱𑇀𑆪 𑆠𑇀𑆫𑆪𑆾 𑆨𑆳𑆓𑆳 𑆢𑇀𑆮𑆿 𑆦𑆳𑆟𑆴𑆠𑆱𑇀𑆪𑆽𑆑𑆣𑇀𑆪𑆩𑆫𑆴𑆰𑇀𑆛𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆍𑆮𑆁 𑆠𑆴𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑇀𑆰𑆳𑆫𑆼𑆰𑆶; 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆿 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆳𑆮𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆿 𑆩𑆷𑆠𑇀𑆫𑆼𑆰𑆶 𑆖𑆳𑆱𑆮𑆳𑆤𑇀 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇗𑇆
𑆃𑆡 𑆱𑆶𑆫𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆯𑆴𑆁𑆯𑆥𑆳𑆒𑆢𑆵𑆫𑆪𑆾𑆂 𑆱𑆳𑆫𑆩𑆳𑆢𑆳𑆪𑆾𑆠𑇀𑆥𑆳𑆛𑇀𑆪 𑆖𑆾𑆠𑇀𑆠𑆩𑆳𑆫𑆟𑆵𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆑𑆾𑆯𑆮𑆠𑆵𑆱𑇀𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆩𑆼𑆑𑆠𑆂 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆴𑆥𑆳𑆖𑇀𑆪𑆾𑆢𑆑𑆩𑆳𑆢𑆢𑆵𑆠 𑆩𑆟𑇀𑆝𑆾𑆢𑆑𑆳𑆫𑇀𑆡𑆁, 𑆑𑆴𑆟𑇀𑆮𑆥𑆴𑆰𑇀𑆛𑆩𑆨𑆴𑆰𑆶𑆟𑆶𑆪𑆳𑆖𑇀𑆖 𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑇀 𑇅 𑆍𑆮𑆁 𑆱𑆶𑆫𑆳𑆂 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆿 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆳𑆮𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆿 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇘𑇆
𑆃𑆠𑆾𑇁𑆮𑆬𑆼𑆲𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆒𑆢𑆴𑆫𑆳𑆱𑆤𑆤𑆴𑆩𑇀𑆧𑆫𑆳𑆘𑆮𑆸𑆑𑇀𑆰𑆯𑆳𑆬𑆱𑆳𑆫𑆑𑇀𑆮𑆳𑆡𑆼 𑆠𑆠𑇀𑆱𑆳𑆫𑆥𑆴𑆟𑇀𑆝𑆳𑆚𑇀𑆗𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆠𑆠𑆾 𑆤𑆳𑆠𑆴𑆢𑇀𑆫𑆮𑆁 𑆤𑆳𑆠𑆴𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆠𑆱𑇀𑆪 𑆥𑆳𑆟𑆴𑆠𑆬𑆁 𑆥𑆷𑆫𑇀𑆟𑆩𑆥𑇀𑆫𑆳𑆠𑆫𑆳𑆯𑆾 𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀; 𑆍𑆮𑆁 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆿 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆳𑆮𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆿 𑆖 𑆬𑆼𑆲𑆳𑆤𑇀 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆃𑆠𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆳𑆫𑆖𑆷𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆳𑆲𑆸𑆠𑇀𑆪𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆥𑆵𑆠𑆩𑆤𑆼𑆑𑆯𑆂 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟𑆽𑆮 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆍𑆮𑆁 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆵𑆤𑆳𑆁 𑆦𑆬𑆼𑆰𑆶, 𑆥𑆶𑆰𑇀𑆥𑆼𑆰𑇀𑆮𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆵𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆪𑆱𑇀𑆑𑆸𑆠𑆵𑆫𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆬𑆾𑆲𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆠𑆤𑆷𑆤𑆴 𑆬𑆮𑆟𑆮𑆫𑇀𑆓𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆳𑆤𑆴 𑆓𑆾𑆩𑆪𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆠𑆥𑇀𑆠𑆳𑆤𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆪𑆼𑆠𑇀 𑆰𑆾𑆝𑆯𑆮𑆳𑆫𑆳𑆤𑇀, 𑆠𑆠𑆂 𑆒𑆢𑆴𑆫𑆳𑆕𑇀𑆓𑆳𑆫𑆠𑆥𑇀𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆯𑆳𑆤𑇀𑆠𑆠𑆳𑆥𑆳𑆤𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑆪𑆼𑆢𑇀𑆣𑆤𑆠𑆳𑆤𑇀𑆠𑆮𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆠𑆳𑆤𑆴 , 𑆠𑆠𑆾 𑆪𑆡𑆳𑆧𑆬𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆤𑆩𑇀𑆬𑆩𑆬𑆮𑆟𑆩𑆳𑆲𑆳𑆫𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆍𑆮𑆁 𑆠𑆶𑆬𑆳𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆩𑆼𑆢𑆂𑆯𑇀𑆮𑆪𑆡𑆶𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆤𑆥𑆲𑆠𑇀𑆪 𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆘𑆵𑆮𑆠𑆴, 𑆠𑆶𑆬𑆳𑆪𑆳𑆁 𑆠𑆶𑆬𑆳𑆪𑆳𑆁 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆶𑆠𑇀𑆑𑆫𑇀𑆰𑆂, 𑆍𑆠𑆼𑆤 𑆱𑆫𑇀𑆮𑆬𑆿𑆲𑆼𑆰𑇀𑆮𑆪𑆱𑇀𑆑𑆸𑆠𑆪𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇑𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆗𑆪𑆳𑆩𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆱𑆥𑇀𑆠𑆬𑆳𑆑𑆼𑆮𑆶𑆑𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆠𑆴𑆬𑇀𑆮𑆑𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑆬𑆳𑆯𑆯𑆴𑆁𑆯𑆥𑆳𑆤𑆳𑆁 𑆱𑇀𑆮𑆫𑆱𑆩𑆳𑆢𑆳𑆪 𑆥𑆳𑆬𑆳𑆯𑇀𑆪𑆳𑆁 𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆳𑆱𑆴𑆖𑇀𑆪 𑆒𑆢𑆴𑆫𑆳𑆕𑇀𑆓𑆳𑆫𑆠𑆥𑇀𑆠𑆩𑆪𑆂𑆥𑆴𑆟𑇀𑆝𑆁 𑆠𑇀𑆫𑆴𑆱𑆥𑇀𑆠𑆑𑆸𑆠𑇀𑆮𑆾 𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑇀𑆪 𑆠𑆩𑆳𑆢𑆳𑆪 𑆥𑆶𑆤𑆫𑆳𑆱𑆴𑆖𑇀𑆪 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆁 𑆓𑆾𑆩𑆪𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆠𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆨𑆳𑆓𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆨𑆷𑆪𑆾𑇁𑆓𑇀𑆤𑆴𑆠𑆥𑇀𑆠𑆳𑆤𑇀𑆪𑆪𑆂𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀, 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆖𑆳𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆨𑆳𑆓𑆁 𑆢𑇀𑆮𑆿 𑆩𑆣𑆶𑆤𑆱𑇀𑆠𑆳𑆮𑆢𑇀𑆣𑆸𑆠𑆱𑇀𑆪𑆼𑆠𑆴 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆩𑆳𑆪𑆱𑆼 𑆥𑆳𑆠𑇀𑆫𑆼 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆾 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆯𑆶𑆑𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆑𑆶𑆚𑇀𑆖𑆁 𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆳𑆲𑆳𑆫𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑇅 𑆍𑆰𑆿𑆰𑆣𑆳𑆪𑆱𑇀𑆑𑆸𑆠𑆴𑆫𑆱𑆳𑆣𑇀𑆪𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆁 𑆮𑆳 𑆱𑆳𑆣𑆪𑆠𑆴, 𑆱𑇀𑆡𑆷𑆬𑆩𑆥𑆑𑆫𑇀𑆰𑆠𑆴, 𑆯𑆾𑆦𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆴, 𑆱𑆤𑇀𑆤𑆩𑆓𑇀𑆤𑆴𑆩𑆶𑆢𑇀𑆣𑆫𑆠𑆴, 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆖𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆴𑆟𑆳𑆁, 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆯𑇀𑆖𑆳𑆤𑆪𑆳 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑇀𑆮𑆳𑆡𑆩𑆳𑆱𑆴𑆖𑇀𑆪 𑆥𑆳𑆬𑆳𑆯𑇀𑆪𑆳𑆁 𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆩𑆪𑆾𑆔𑆤𑆳𑆁𑆱𑇀𑆠𑆥𑇀𑆠𑆳𑆤𑇀𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑇀𑆪 𑆑𑆸𑆠𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆼 𑆑𑆬𑆯𑆼𑇁𑆨𑇀𑆪𑆳𑆱𑆴𑆖𑇀𑆪 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆖𑆷𑆫𑇀𑆟𑆨𑆳𑆓𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆓𑆶𑆝𑆩𑆴𑆠𑆴 𑆖 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆍𑆠𑆳𑆁 𑆩𑆲𑆿𑆰𑆣𑆳𑆪𑆱𑇀𑆑𑆸𑆠𑆴𑆁 𑆩𑆳𑆱𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆮𑆳 𑆱𑇀𑆡𑆴𑆠𑆳𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇅 𑆍𑆮𑆁 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆳𑆮𑆳𑆫𑆼𑆮𑆠𑆳𑆢𑆴𑆰𑆶 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇒𑇆
𑆃𑆠𑆂 𑆒𑆢𑆴𑆫𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆢𑆼𑆯𑆘𑆳𑆠𑆩𑆤𑆶𑆥𑆲𑆠𑆁 𑆩𑆣𑇀𑆪𑆩𑆮𑆪𑆱𑆁 𑆒𑆢𑆴𑆫𑆁 𑆥𑆫𑆴𑆠𑆂 𑆒𑆳𑆤𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆱𑇀𑆪 𑆩𑆣𑇀𑆪𑆩𑆁 𑆩𑆷𑆬𑆁 𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑆪𑆾𑆩𑆪𑆁 𑆑𑆶𑆩𑇀𑆨𑆁 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆤𑇀𑆠𑆫𑆼 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆳 𑆫𑆱𑆓𑇀𑆫𑆲𑆟𑆱𑆩𑆫𑇀𑆡𑆾 𑆨𑆮𑆠𑆴, 𑆠𑆠𑆱𑇀𑆠𑆁 𑆓𑆾𑆩𑆪𑆩𑆸𑆢𑆳𑇁𑆮𑆬𑆴𑆥𑇀𑆠𑆩𑆮𑆑𑆵𑆫𑇀𑆪𑆼𑆤𑇀𑆣𑆤𑆽𑆫𑇀𑆓𑆾𑆩𑆪𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑆳𑆢𑆵𑆥𑆪𑆼𑆢𑇀𑆪𑆡𑆳𑇁𑆱𑇀𑆪 𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆫𑆱𑆂 𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆣𑆱𑇀𑆠𑆳𑆠𑇀, 𑆠𑆢𑇀𑆪𑆢𑆳 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆥𑆷𑆫𑇀𑆟𑆁 𑆨𑆳𑆘𑆤𑆩𑆴𑆠𑆴, 𑆃𑆡𑆽𑆤𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆫𑆱𑆩𑆤𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆳𑆠𑇀𑆫𑆼 𑆤𑆴𑆣𑆳𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆾 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆩𑆳𑆩𑆬𑆑𑆫𑆱𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆂 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆳𑆤𑆮𑆢𑆳𑆲𑆳𑆫𑆂 𑆥𑆫𑆴𑆲𑆳𑆫𑆯𑇀𑆖, 𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆖𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆼 𑆯𑆠𑆁 𑆮𑆫𑇀𑆰𑆳𑆟𑆳𑆩𑆳𑆪𑆶𑆰𑆾𑇁𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇅 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆠𑆶𑆬𑆳𑆩𑆶𑆢𑆑𑆢𑇀𑆫𑆾𑆟𑆼 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆰𑆾𑆝𑆯𑆳𑆁𑆯𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆩𑆮𑆠𑆳𑆫𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆩𑆳𑆩𑆬𑆑𑆫𑆱𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆂 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇅 𑆍𑆰 𑆍𑆮 𑆱𑆫𑇀𑆮𑆮𑆸𑆑𑇀𑆰𑆱𑆳𑆫𑆼𑆰𑆶 𑆑𑆬𑇀𑆥𑆂 𑇅 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆖𑆷𑆫𑇀𑆟𑆠𑆶𑆬𑆳𑆁 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆑𑇀𑆮𑆳𑆡𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆥𑆱𑆼𑆮𑆼𑆠, 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆑𑇀𑆮𑆳𑆡𑆱𑆴𑆢𑇀𑆣𑆩𑆳𑆮𑆴𑆑𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂 𑇆𑇑𑇓𑇆
𑆃𑆩𑆸𑆠𑆮𑆬𑇀𑆬𑆵𑆱𑇀𑆮𑆫𑆱𑆁 𑆑𑇀𑆮𑆳𑆡𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆥𑆱𑆼𑆮𑆼𑆠, 𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆂, 𑆃𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆩𑆾𑆢𑆤𑆩𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟 𑆨𑆶𑆚𑇀𑆘𑆵𑆠; 𑆍𑆮𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆱𑆫𑇀𑆮𑆑𑆶𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆠 𑆅𑆠𑆴 𑇆𑇑𑇔𑇆
𑆑𑆸𑆰𑇀𑆟𑆠𑆴𑆬𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆳𑆩𑆬𑆑𑆫𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆁 𑆢𑇀𑆫𑆾𑆟𑆁 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆱𑇀𑆪 𑆖, 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆥𑆫𑆷𑆰𑆦𑆬𑆩𑆘𑇀𑆘𑆮𑆴𑆝𑆕𑇀𑆓𑆦𑆬𑆱𑆳𑆫𑆖𑆴𑆠𑇀𑆫𑆳𑆫𑇀𑆑𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑇀𑆮𑆪𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆷𑆟𑆳𑆁 𑆥𑆳𑆬𑆴𑆑𑆳 𑆨𑆳𑆓𑆳𑆱𑇀𑆠𑆳𑆤𑆽𑆑𑆣𑇀𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆑𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆥𑆖𑆼𑆠𑇀, 𑆠𑆠𑇀 𑆱𑆳𑆣𑆶𑆱𑆴𑆢𑇀𑆣𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠 𑆇𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆯𑆫𑆵𑆫𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆠𑇀𑆡𑆳𑆪 𑆥𑆳𑆟𑆴𑆯𑆶𑆑𑇀𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟𑆳𑆬𑆮𑆟𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆩𑆤𑇀𑆠𑆁 𑆒𑆢𑆴𑆫𑆾𑆢𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆩𑆸𑆢𑇀𑆮𑆾𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆒𑆢𑆴𑆫𑆾𑆢𑆑𑆱𑆼𑆮𑆵, 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆢𑇀𑆫𑆾𑆟𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆱𑆫𑇀𑆮𑆑𑆶𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆂 𑆯𑆶𑆢𑇀𑆣𑆠𑆤𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆤𑇀 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑆫𑆾𑆓𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆶𑆫𑆳𑆩𑆤𑇀𑆡𑆳𑆱𑆮𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆁𑆬𑇀𑆬𑆼𑆲𑆳𑆁𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆪𑆱𑇀𑆑𑆸𑆠𑆵𑆂 𑇅 𑆱𑆲𑆱𑇀𑆫𑆯𑆾𑇁𑆥𑆴 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆧𑆵𑆘𑆼𑆤𑆳𑆤𑆼𑆤 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇑𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑇀𑆮𑆿 𑆥𑇀𑆫𑆩𑆼𑆲𑆿 𑆨𑆮𑆠𑆂- 𑆱𑆲𑆘𑆾𑇁𑆥𑆡𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆯𑇀𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆱𑆲𑆘𑆾 𑆩𑆳𑆠𑆸𑆥𑆴𑆠𑆸𑆧𑆵𑆘𑆢𑆾𑆰𑆑𑆸𑆠𑆂, 𑆃𑆲𑆴𑆠𑆳𑆲𑆳𑆫𑆘𑆾𑇁𑆥𑆡𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑇅 𑆠𑆪𑆾𑆂 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆑𑆸𑆯𑆾 𑆫𑆷𑆑𑇀𑆰𑆾𑇁𑆬𑇀𑆥𑆳𑆯𑆵 𑆥𑆴𑆥𑆳𑆱𑆶𑆫𑇀𑆨𑆸𑆯𑆁 𑆥𑆫𑆴𑆱𑆫𑆟𑆯𑆵𑆬𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆇𑆠𑇀𑆠𑆫𑆼𑆟 𑆱𑇀𑆡𑆷𑆬𑆾 𑆧𑆲𑇀𑆮𑆳𑆯𑆵 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑆵𑆬𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆼𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆑𑆸𑆯𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆨𑆴𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆴𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠, 𑆱𑇀𑆡𑆷𑆬𑆩𑆥𑆠𑆫𑇀𑆥𑆟𑆪𑆶𑆑𑇀𑆠𑆳𑆨𑆴𑆂 𑇆𑇔𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮 𑆖 𑆥𑆫𑆴𑆲𑆫𑆼𑆪𑆶𑆂 𑆱𑆿𑆮𑆵𑆫𑆑𑆠𑆶𑆰𑆾𑆢𑆑𑆯𑆶𑆑𑇀𑆠𑆩𑆽𑆫𑆼𑆪𑆱𑆶𑆫𑆳𑆱𑆮𑆠𑆾𑆪𑆥𑆪𑆱𑇀𑆠𑆽𑆬𑆔𑆸𑆠𑆼𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆳𑆫𑆢𑆣𑆴𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆳𑆩𑇀𑆬𑆪𑆮𑆳𑆓𑆷𑆥𑆳𑆤𑆑𑆳𑆤𑆴 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆖𑆼𑆠𑆴 𑇆𑇕𑇆
𑆠𑆠𑆂 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆑𑆾𑆢𑇀𑆫𑆮𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆳𑆤𑆤𑆮𑆳𑆤𑇀 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆖𑆟𑆑𑆳𑆞𑆑𑆵𑆑𑆶𑆬𑆠𑇀𑆡𑆩𑆶𑆢𑇀𑆓𑆮𑆴𑆑𑆬𑇀𑆥𑆼𑆤, 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆯𑆳𑆑𑆓𑆟𑆳𑆨𑇀𑆪𑆳𑆁 𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆠𑆽𑆬𑆱𑆴𑆢𑇀𑆣𑆳𑆨𑇀𑆪𑆳𑆁, 𑆧𑆢𑇀𑆣𑆩𑆷𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆫𑇀𑆩𑆳𑆁𑆱𑆽𑆫𑆥𑆲𑆸𑆠𑆩𑆼𑆢𑆾𑆨𑆴𑆫𑆤𑆩𑇀𑆬𑆽𑆫𑆔𑆸𑆠𑆽𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆠 𑆍𑆮 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆠𑆽𑆬𑆼𑆤 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆮𑆳 𑆔𑆸𑆠𑆼𑆤 𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆓𑆳𑆞𑆁 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆖𑇀𑆖, 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆢𑆤𑆤𑇀𑆠𑆫𑆁 𑆱𑆶𑆫𑆱𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆤𑇀𑆩𑆲𑆿𑆰𑆣𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆩𑆶𑆱𑇀𑆠𑆳𑆮𑆳𑆥𑆼𑆤 𑆩𑆣𑆶𑆱𑆽𑆤𑇀𑆣𑆮𑆪𑆶𑆑𑇀𑆠𑆼𑆤, 𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆁 𑆖 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆤𑆴𑆱𑇀𑆠𑆽𑆬𑆼𑆤 𑇆𑇗𑇆
𑆠𑆠𑆂 𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆩𑆳𑆩𑆬𑆑𑆫𑆱𑆼𑆤 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆁 𑆩𑆣𑆶𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑆴𑆯𑆳𑆬𑆳𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆩𑆶𑆱𑇀𑆠𑆑𑆰𑆳𑆪𑆁 𑆮𑆳, 𑆯𑆳𑆬𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆩𑆶𑆰𑇀𑆑𑆑𑆑𑆬𑇀𑆑𑆩𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆩𑆳𑆩𑆬𑆑𑆫𑆱𑆼𑆤 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆪𑆶𑆠𑆁, 𑆑𑆶𑆛𑆘𑆑𑆥𑆴𑆠𑇀𑆡𑆫𑆾𑆲𑆵𑆠𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆥𑆶𑆰𑇀𑆥𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆤𑆴𑆩𑇀𑆧𑆳𑆫𑆓𑇀𑆮𑆣𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆩𑆷𑆫𑇀𑆮𑆳𑆑𑆶𑆛𑆘𑆱𑆾𑆩𑆮𑆸𑆑𑇀𑆰𑆥𑆬𑆳𑆯𑆳𑆤𑆳𑆁 𑆮𑆳 𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆩𑆷𑆬𑆦𑆬𑆥𑆶𑆰𑇀𑆥𑆑𑆰𑆳𑆪𑆳𑆟𑆴, 𑆍𑆠𑆼 𑆥𑆚𑇀𑆖 𑆪𑆾𑆓𑆳𑆂 𑆱𑆫𑇀𑆮𑆩𑆼𑆲𑆳𑆤𑆳𑆩𑆥𑆲𑆤𑇀𑆠𑆳𑆫𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇘𑇆
𑆮𑆴𑆯𑆼𑆰𑆯𑇀𑆖𑆳𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁- 𑆠𑆠𑇀𑆫𑆾𑆢𑆑𑆩𑆼𑆲𑆴𑆤𑆁 𑆥𑆳𑆫𑆴𑆘𑆳𑆠𑆑𑆰𑆳𑆪𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆅𑆑𑇀𑆰𑆶𑆩𑆼𑆲𑆴𑆤𑆁 𑆮𑆽𑆘𑆪𑆤𑇀𑆠𑆵𑆑𑆰𑆳𑆪𑆁, 𑆱𑆶𑆫𑆳𑆩𑆼𑆲𑆴𑆤𑆁 𑆤𑆴𑆩𑇀𑆧𑆑𑆰𑆳𑆪𑆁, 𑆱𑆴𑆑𑆠𑆳𑆩𑆼𑆲𑆴𑆤𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆰𑆳𑆪𑆁, 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆴𑆤𑆁 𑆒𑆢𑆴𑆫𑆑𑆰𑆳𑆪𑆁, 𑆬𑆮𑆟𑆩𑆼𑆲𑆴𑆤𑆁 𑆥𑆳𑆜𑆳𑇁𑆓𑆶𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆰𑆳𑆪𑆁 , 𑆥𑆴𑆰𑇀𑆛𑆩𑆼𑆲𑆴𑆤𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆢𑆳𑆫𑆶𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆰𑆳𑆪𑆁, 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆁 𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆑𑆰𑆳𑆪𑆁, 𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆁 𑆢𑆷𑆫𑇀𑆮𑆳𑆯𑆽𑆮𑆬𑆥𑇀𑆬𑆮𑆲𑆜𑆑𑆫𑆚𑇀𑆘𑆑𑆱𑆼𑆫𑆶𑆑𑆑𑆰𑆳𑆪𑆁 𑆑𑆑𑆶𑆨𑆖𑆤𑇀𑆢𑆤𑆑𑆰𑆳𑆪𑆁 𑆮𑆳, 𑆦𑆼𑆤𑆩𑆼𑆲𑆴𑆤𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆓𑇀𑆮𑆣𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆑𑆰𑆳𑆪𑆁, 𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆩𑆴𑆠𑆴; 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑆰𑆶 𑆤𑆵𑆬𑆩𑆼𑆲𑆴𑆤𑆁 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆩𑆯𑇀𑆮𑆠𑇀𑆡𑆑𑆰𑆳𑆪𑆁 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆼𑆲𑆴𑆤𑆁 𑆫𑆳𑆘𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆁, 𑆃𑆩𑇀𑆬𑆩𑆼𑆲𑆴𑆤𑆁 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆁, 𑆑𑇀𑆰𑆳𑆫𑆩𑆼𑆲𑆴𑆤𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆰𑆳𑆪𑆁, 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆼𑆲𑆴𑆤𑆁 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆖𑆤𑇀𑆢𑆤𑆑𑆰𑆳𑆪𑆁, 𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆲𑆴𑆤𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆳𑆱𑇀𑆡𑆴𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆒𑆫𑇀𑆘𑆷𑆫𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆁; 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑇀𑆮𑆥𑆴 𑆪𑆾𑆓𑆳𑆤𑇀 𑆪𑆳𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆼𑆲𑆴𑆤𑆁 𑆑𑆶𑆰𑇀𑆜𑆑𑆶𑆛𑆘𑆥𑆳𑆜𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆑𑆬𑇀𑆑𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆰𑆳𑆪𑆼𑆟 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆮𑆱𑆳𑆩𑆼𑆲𑆴𑆤𑆩𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆑𑆰𑆳𑆪𑆁 𑆯𑆴𑆁𑆯𑆥𑆳𑆑𑆰𑆳𑆪𑆁 𑆮𑆳, 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆁 𑆑𑆢𑆫𑆑𑇀𑆫𑆩𑆶𑆑𑆑𑆰𑆳𑆪𑆁 , 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆴𑆤𑆁 𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆑𑆥𑆴𑆠𑇀𑆡𑆯𑆴𑆫𑆵𑆰𑆥𑆬𑆳𑆯𑆥𑆳𑆜𑆳𑆩𑆷𑆫𑇀𑆮𑆳𑆢𑆶𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆩𑆣𑆶𑆫𑆁 𑆲𑆱𑇀𑆠𑇀𑆪𑆯𑇀𑆮𑆯𑆷𑆑𑆫𑆒𑆫𑆾𑆰𑇀𑆛𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑇀𑆰𑆳𑆫𑆁 𑆖𑆼𑆠𑆴; 𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆩𑆿𑆢𑆑𑆑𑆤𑇀𑆢𑆑𑇀𑆮𑆳𑆡𑆱𑆴𑆢𑇀𑆣𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆣𑆶𑆫𑆳𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆠𑆠𑆂 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆤𑆤𑇀𑆠𑆳𑆪𑆷𑆡𑆴𑆑𑆳𑆥𑆢𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆪𑆤𑇀𑆠𑆴𑆑𑆳𑆬𑆾𑆲𑆴𑆠𑆴𑆑𑆳𑆩𑇀𑆧𑆰𑇀𑆜𑆳𑆢𑆳𑆝𑆴𑆩𑆠𑇀𑆮𑆑𑇀𑆯𑆳𑆬𑆥𑆫𑇀𑆟𑆵𑆥𑆢𑇀𑆩𑆠𑆶𑆕𑇀𑆓𑆑𑆼𑆯𑆫- 𑆣𑆳𑆠𑆑𑆵𑆧𑆑𑆶𑆬𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆯𑇀𑆫𑆵𑆮𑆼𑆰𑇀𑆛𑆑𑆩𑆾𑆖𑆫𑆱𑆼𑆰𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑆪𑆱𑇀𑆑𑆸𑆠𑆵𑆫𑇀𑆬𑆼𑆲𑆳𑆤𑆳𑆱𑆮𑆳𑆁𑆯𑇀𑆖 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆓𑆴𑆬𑆾𑆝𑇀𑆪𑆧𑆴𑆱𑆩𑆸𑆟𑆳𑆬𑆑𑆳𑆯𑆑𑆱𑆼𑆫𑆶𑆑𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆫𑆘𑆩𑇀𑆧𑇀𑆮𑆱𑆤𑆠𑆴𑆤𑆴𑆯𑆑𑆑𑆶𑆨𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆫𑆾𑆣𑇀𑆫𑆨𑆬𑇀𑆬𑆳𑆠𑆑- 𑆥𑆬𑆳𑆯𑆖𑆫𑇀𑆩𑆮𑆸𑆑𑇀𑆰𑆓𑆴𑆫𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆯𑆵𑆠𑆯𑆴𑆮𑆤𑆴𑆖𑆶𑆬𑆢𑆳𑆝𑆴𑆩𑆳𑆘𑆑𑆫𑇀𑆟𑆲𑆫𑆴𑆮𑆸𑆑𑇀𑆰𑆫𑆳𑆘𑆳𑆢𑆤𑆓𑆾𑆥𑆔𑆾𑆟𑇀𑆛𑆳𑆮𑆴𑆑𑆕𑇀𑆑𑆠𑆼𑆰𑆶 𑆮𑆳; 𑆪𑆮𑆳𑆤𑇀𑆤𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆱𑆼𑆮𑆼𑆠; 𑆪𑆡𑆾𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆑𑆰𑆳𑆪𑆳𑆟𑆴 𑆮𑆳 𑆥𑆳𑆠𑆶𑆩𑇀 𑇆𑇑𑇐𑇆
𑆩𑆲𑆳𑆣𑆤𑆩𑆲𑆴𑆠𑆳𑆲𑆳𑆫𑆩𑆿𑆰𑆣𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆩𑆵𑆯𑇀𑆮𑆫𑆁 𑆮𑆳 𑆥𑆳𑆜𑆳𑆨𑆪𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆥𑇀𑆫𑆓𑆳𑆞𑆩𑆤𑆬𑇀𑆥𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆳𑆱𑆮𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆃𑆕𑇀𑆓𑆳𑆫𑆯𑆷𑆬𑇀𑆪𑆾𑆥𑆢𑆁𑆯𑆁 𑆮𑆳 𑆩𑆳𑆣𑇀𑆮𑆵𑆑𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁, 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆑𑆥𑆴𑆠𑇀𑆡𑆩𑆫𑆴𑆖𑆳𑆤𑆶𑆮𑆴𑆢𑇀𑆣𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆩𑆽 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆳𑆤𑇀𑆪𑆶𑆥𑆲𑆫𑆼𑆠𑇀, 𑆇𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑇀𑆮𑆠𑆫𑆒𑆫𑆥𑆶𑆫𑆵𑆰𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆩𑆽 𑆢𑆢𑇀𑆪𑆳𑆢𑆯𑆤𑆼𑆰𑆶; 𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆽𑆤𑇀𑆣𑆮𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆪𑆷𑆰𑆽𑆂 𑆱𑆳𑆫𑇀𑆰𑆥𑆽𑆯𑇀𑆖 𑆫𑆳𑆓𑆽𑆫𑇀𑆨𑆾𑆘𑆪𑆼𑆠𑇀; 𑆃𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆩𑆽 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆳𑆤𑇀𑆪𑆶𑆥𑆲𑆫𑆼𑆢𑇀𑆫𑆱𑆓𑆤𑇀𑆣𑆮𑆤𑇀𑆠𑆴 𑆖; 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆩𑆼𑆲𑆳𑆱𑇀𑆠𑆶 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆤𑆴𑆪𑆶𑆢𑇀𑆣𑆑𑇀𑆫𑆵𑆝𑆳𑆓𑆘𑆠𑆶𑆫𑆓𑆫𑆡𑆥𑆢𑆳𑆠𑆴𑆖𑆫𑇀𑆪𑆳𑆥𑆫𑆴𑆑𑇀𑆫𑆩𑆟𑆳𑆤𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑆾𑆥𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆮𑆳 𑆱𑆼𑆮𑆼𑆫𑆤𑇀 𑇆𑇑𑇑𑇆
𑆃𑆣𑆤𑆱𑇀𑆠𑇀𑆮𑆧𑆳𑆤𑇀𑆣𑆮𑆾 𑆮𑆳 𑆥𑆳𑆢𑆠𑇀𑆫𑆳𑆟𑆳𑆠𑆥𑆠𑇀𑆫𑆮𑆴𑆫𑆲𑆴𑆠𑆾 𑆨𑆽𑆑𑇀𑆰𑇀𑆪𑆳𑆯𑆵 𑆓𑇀𑆫𑆳𑆩𑆽𑆑𑆫𑆳𑆠𑇀𑆫𑆮𑆳𑆱𑆵 𑆩𑆶𑆤𑆴𑆫𑆴𑆮 𑆱𑆁𑆪𑆠𑆳𑆠𑇀𑆩𑆳 𑆪𑆾𑆘𑆤𑆯𑆠𑆩𑆣𑆴𑆑𑆁 𑆮𑆳 𑆓𑆖𑇀𑆗𑆼𑆠𑇀, 𑆩𑆲𑆳𑆣𑆤𑆾 𑆮𑆳 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆤𑆵𑆮𑆳𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆳𑆩𑆬𑆑𑆑𑆥𑆴𑆠𑇀𑆡𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆳𑆯𑇀𑆩𑆤𑇀𑆠𑆑𑆦𑆬𑆳𑆲𑆳𑆫𑆾 𑆩𑆸𑆓𑆽𑆂 𑆱𑆲 𑆮𑆱𑆼𑆠𑇀, 𑆠𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆯𑆑𑆸𑆢𑇀𑆨𑆑𑇀𑆰𑆂 𑆱𑆠𑆠𑆩𑆤𑆶𑆮𑇀𑆫𑆘𑆼𑆢𑇀𑆓𑆳𑆂, 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆾 𑆮𑆳 𑆯𑆴𑆬𑆾𑆚𑇀𑆗𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆷𑆠𑇀𑆮𑆳 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑆡𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀, 𑆑𑆸𑆰𑆼𑆠𑇀 𑆱𑆠𑆠𑆩𑆴𑆠𑆫𑆂 𑆒𑆤𑆼𑆢𑇀𑆮𑆳 𑆑𑆷𑆥𑆁, 𑆑𑆸𑆯𑆁 𑆠𑆶 𑆱𑆠𑆠𑆁 𑆫𑆑𑇀𑆰𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆣𑆤𑆾 𑆮𑆽𑆢𑇀𑆪𑆱𑆤𑇀𑆢𑆼𑆯𑆳𑆢𑆼𑆮𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆂 𑇅 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆢𑆤𑇀𑆠𑆫𑆳𑆢𑇀𑆮𑆳 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆠𑇀 𑆥𑇀𑆫𑆠𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆥𑆴𑆝𑆑𑆳𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆯𑆫𑆳𑆮𑆴𑆑𑆳𑆢𑇀𑆪𑆳 𑆤𑆮 𑆥𑆴𑆝𑆑𑆳𑆂 𑆥𑇀𑆫𑆳𑆓𑆶𑆑𑇀𑆠𑆳𑆂; 𑆠𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆮𑆠𑆾𑇁𑆬𑇀𑆥𑆳𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳 𑆩𑆸𑆢𑇀𑆮𑇀𑆪𑆾𑇁𑆬𑇀𑆥𑆫𑆶𑆘𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆥𑆳𑆑𑆨𑆼𑆢𑆴𑆤𑇀𑆪𑆯𑇀𑆖 𑆱𑆳𑆣𑇀𑆪𑆳𑆂 𑇆𑇓𑇆
𑆠𑆳𑆨𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆩𑆶𑆥𑆖𑆫𑆼𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆼𑆰𑇀𑆮𑆥𑆠𑆫𑇀𑆥𑆟𑆁 𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆑𑆰𑆳𑆪𑆁 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆁 𑆖𑆾𑆥𑆢𑆴𑆯𑆼𑆠𑇀; 𑆍𑆮𑆩𑆑𑆶𑆫𑇀𑆮𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆩𑆣𑆶𑆫𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑇀𑆮𑆼𑆢𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆖 𑆩𑆣𑆶𑆫𑆵𑆨𑆮𑆠𑆴 𑆥𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖𑆳𑆨𑆴𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆨𑆮𑆠𑆴, 𑆠𑆠𑇀𑆫𑆾𑆨𑆪𑆠𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆳𑆱𑆼𑆮𑆼𑆠; 𑆍𑆮𑆩𑆑𑆶𑆫𑇀𑆮𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆼 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆯𑆾𑆦𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑆮𑆳 𑆑𑆳𑆁𑆯𑇀𑆖𑆴𑆠𑇀, 𑆠𑆠𑇀𑆫𑆾𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆯𑇀𑆖; 𑆍𑆮𑆩𑆑𑆶𑆫𑇀𑆮𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆯𑆾𑆦𑆾 𑆮𑆸𑆢𑇀𑆣𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆫𑆶𑆘𑆾 𑆮𑆴𑆢𑆳𑆲𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆠𑇀𑆫 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆮𑇀𑆫𑆟𑆑𑇀𑆫𑆴𑆪𑆾𑆥𑆱𑆼𑆮𑆳 𑆖; 𑆍𑆮𑆩𑆑𑆶𑆫𑇀𑆮𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆥𑆷𑆪𑆾𑇁𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆩𑆮𑆢𑆳𑆫𑇀𑆪𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆁 𑆩𑆲𑆳𑆤𑇀𑆠𑆩𑆮𑆑𑆳𑆯𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆾 𑆨𑆮𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆂; 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆢𑆴𑆠 𑆍𑆮 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇆𑇔𑇆
𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆧𑆴𑆬𑇀𑆮𑆳𑆩𑇀𑆧𑆶𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆾𑆢𑆑𑆵𑆫𑇀𑆪𑆳𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆛𑆵𑆱𑇀𑆤𑆶𑆲𑆵𑆮𑆫𑆶𑆟𑆑𑆥𑆶𑆰𑇀𑆑𑆫𑆢𑆤𑇀𑆠𑆵𑆥𑆡𑇀𑆪𑆳 𑆢𑆯𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳 𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑆳𑆤𑇀 𑆱𑆬𑆴𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆼𑇁𑆮𑆠𑆳𑆫𑇀𑆪 𑆮𑆖𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆨𑆳𑆫𑇀𑆕𑇀𑆓𑆵𑆤𑆴𑆖𑆶𑆬𑆯𑆶𑆟𑇀𑆜𑆵𑆓𑆘𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆝𑆕𑇀𑆓𑆫𑆾𑆣𑇀𑆫𑆯𑆴𑆫𑆵𑆰𑆳𑆟𑆳𑆁 𑆨𑆳𑆓𑆽𑆫𑆫𑇀𑆣𑆥𑆬𑆴𑆑𑆽𑆫𑇀𑆣𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆤𑇀𑆩𑆼𑆲𑆯𑇀𑆮𑆪𑆡𑆶𑆑𑆶𑆰𑇀𑆜𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆂𑆥𑇀𑆬𑆵𑆲𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆥𑆴𑆝𑆑𑆳𑆤𑆳𑆁 𑆤𑆳𑆯𑆤𑆁 𑆤𑆳𑆩𑇀𑆤𑆳 𑆣𑆳𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆩𑇀 𑇆𑇕𑇆
𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆳 𑆲𑆴 𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆤𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆩𑆼𑆢𑆾𑇁𑆨𑆴𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆠𑇀, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆼𑆠𑆼𑆰𑆳𑆁 𑆯𑆾𑆣𑆤𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇅 𑆥𑆴𑆝𑆑𑆳𑆥𑆵𑆝𑆴𑆠𑆳𑆂 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆩𑆷𑆠𑇀𑆫𑆳𑆢𑆴𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆼 𑆩𑆣𑆶𑆓𑆤𑇀𑆣𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆫𑆴𑆨𑆳𑆰𑆴𑆑𑆵𑆁 𑆩𑆣𑆶𑆩𑆼𑆲𑆳𑆒𑇀𑆪𑆳𑆁 𑆬𑆨𑆤𑇀𑆠𑆼 𑇆𑇖𑇆
𑆤 𑆖𑆽𑆠𑆳𑆤𑇀 𑆑𑆡𑆚𑇀𑆖𑆴𑆢𑆥𑆴 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆩𑆼𑆢𑆾𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑆼𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑆢𑆼𑆲𑆂 𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑇆𑇗𑇆
𑆫𑆱𑆳𑆪𑆤𑆵𑆤𑆳𑆁 𑆖 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑇀𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆳𑆁 𑆢𑆾𑆰𑆳𑆂, 𑆠𑆠𑆾 𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆤𑆳𑆩𑆣𑆂𑆑𑆳𑆪𑆼 𑆥𑆴𑆝𑆑𑆳𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇘𑇆
𑆃𑆥𑆑𑇀𑆮𑆳𑆤𑆳𑆁 𑆠𑆶 𑆥𑆴𑆝𑆑𑆳𑆤𑆳𑆁 𑆯𑆾𑆦𑆮𑆠𑇀 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂, 𑆥𑆑𑇀𑆮𑆳𑆤𑆳𑆁 𑆮𑇀𑆫𑆟𑆮𑆢𑆴𑆠𑆴; 𑆠𑆽𑆬𑆁 𑆠𑆶 𑆮𑇀𑆫𑆟𑆫𑆾𑆥𑆟𑆩𑆼𑆮𑆳𑆢𑆿 𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆫𑇀𑆡𑆼, 𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆁 𑆥𑆫𑆴𑆰𑆼𑆖𑆤𑆼, 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆁 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆼𑆰𑆶, 𑆥𑆳𑆜𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆼𑆰𑇀𑆛𑆳𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆧𑆸𑆲𑆠𑆵𑆱𑆳𑆫𑆴𑆮𑆳𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆫𑆓𑇀𑆮𑆣𑆑𑆶𑆛𑆘𑆩𑆷𑆬𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆳𑆟𑆴 𑆥𑇀𑆫𑆳𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇙𑇆
𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆮𑆫𑇀𑆓𑆑𑆰𑆳𑆪𑆁 𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆥𑆶𑆤𑆫𑆶𑆥𑆤𑆵𑆪 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆖𑆳𑆩𑆬𑆑𑆫𑆾𑆣𑇀𑆫𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆤𑇀𑆢𑆤𑇀𑆠𑆵𑆑𑆸𑆰𑇀𑆟𑆳𑆪𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆳𑆮𑆥𑆼𑆠𑇀, 𑆍𑆠𑆢𑆤𑆶𑆥𑆢𑆓𑇀𑆣𑆁 𑆬𑆼𑆲𑆵𑆨𑆷𑆠𑆩𑆮𑆠𑆳𑆫𑇀𑆪𑆳𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆾 𑆪𑆡𑆳𑆪𑆾𑆓𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆍𑆰 𑆬𑆼𑆲𑆂 𑆱𑆫𑇀𑆮𑆩𑆼𑆲𑆳𑆤𑆳𑆁 𑆲𑆤𑇀𑆠𑆳 𑇆𑇑𑇐𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆤𑆮 𑆨𑆳𑆓𑆳𑆱𑇀𑆠𑆳𑆮𑆤𑇀𑆠 𑆍𑆮 𑆑𑆸𑆰𑇀𑆟𑆳𑆪𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆪, 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆩𑆽𑆑𑆣𑇀𑆪𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆍𑆠𑆤𑇀𑆤𑆮𑆳𑆪𑆱𑆩𑇀; 𑆍𑆠𑆼𑆤 𑆘𑆳𑆜𑆫𑇀𑆪𑆁 𑆤 𑆨𑆮𑆠𑆴, 𑆱𑆤𑇀𑆤𑆾𑇁𑆓𑇀𑆤𑆴𑆫𑆳𑆥𑇀𑆪𑆳𑆪𑆠𑆼, 𑆢𑆶𑆫𑇀𑆤𑆳𑆩𑆯𑆾𑆦𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆶𑆰𑇀𑆜𑆫𑆾𑆓𑆳𑆮𑆴𑆥𑆳𑆑𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆯𑇀𑆖 𑆤 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇑𑇆
𑆯𑆳𑆬𑆱𑆳𑆫𑆳𑆢𑆴𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆁𑆯𑆳𑆮𑆯𑆼𑆰𑆴𑆠𑆼 𑇅 𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆼 𑆠𑆠𑆂 𑆯𑆵𑆠𑆼 𑆩𑆣𑆶 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑆳𑆮𑆥𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆦𑆳𑆟𑆴𑆠𑆵𑆨𑆳𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆁 𑆓𑆶𑆝𑆁 𑆯𑆾𑆣𑆴𑆠𑆩𑆼𑆮 𑆖 𑇅 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆓𑆟𑆱𑇀𑆪 𑆖 𑇆𑇑𑇓𑇆
𑆎𑆑𑆣𑇀𑆪𑆩𑆳𑆮𑆥𑆼𑆠𑇀 𑆑𑆶𑆩𑇀𑆨𑆼 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆼 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼 𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆷𑆫𑇀𑆟𑆩𑆣𑆶𑆨𑆴𑆂 𑆥𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆼𑇁𑆤𑇀𑆠𑆂𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑇆𑇑𑇔𑇆
𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆬𑆾𑆲𑆱𑇀𑆪 𑆠𑆠𑇀𑆫 𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆒𑆢𑆴𑆫𑆳𑆕𑇀𑆓𑆳𑆫𑆠𑆥𑇀𑆠𑆳𑆤𑆴 𑆧𑆲𑆶𑆯𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆱𑆶𑆥𑆴𑆣𑆳𑆤𑆁 𑆠𑆶 𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆪𑆮𑆥𑆬𑇀𑆬𑆼 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆩𑆳𑆱𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾𑆮𑆳𑇁𑆥𑆴 𑆪𑆳𑆮𑆢𑆳𑆬𑆾𑆲𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆳𑆠𑇀 𑇆𑇑𑇖𑇆
𑆠𑆠𑆾 𑆘𑆳𑆠𑆫𑆱𑆁 𑆠𑆁 𑆠𑆶 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆪𑆡𑆳𑆧𑆬𑆩𑇀 𑇅 𑆤𑆴𑆰𑆼𑆮𑆼𑆠 𑆪𑆡𑆳𑆪𑆾𑆓𑆩𑆳𑆲𑆳𑆫𑆁 𑆖𑆳𑆱𑇀𑆪 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆑𑆸𑆢𑇀𑆧𑆬𑆴𑆤𑆳𑆩𑆼𑆰 𑆱𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆂 𑆥𑇀𑆫𑆱𑆳𑆣𑆑𑆂 𑇅 𑆯𑆾𑆦𑆤𑆶𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆲𑆸𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆳𑆥𑆲𑆂 𑇆𑇑𑇘𑇆
𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆲𑆫𑆂 𑆯𑆵𑆔𑇀𑆫𑆁 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆤𑆳𑆯𑆤𑆂 𑇅 𑆃𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆳𑆥𑆲𑆫𑆟𑆾 𑆬𑆾𑆲𑆳𑆫𑆴𑆰𑇀𑆛𑆾 𑆩𑆲𑆳𑆓𑆶𑆟𑆂 𑇆𑇑𑇙𑇆
𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆾 𑆪𑆢𑆳 𑆩𑆷𑆠𑇀𑆫𑆩𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑆤𑆳𑆮𑆴𑆬𑆩𑇀 𑇅 𑆮𑆴𑆯𑆢𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆁 𑆠𑆢𑆳𑇁𑇁𑆫𑆾𑆓𑇀𑆪𑆁 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇒𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆣𑆶𑆩𑆼𑆲𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆠𑇀𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆁 𑆨𑆴𑆰𑆓𑇀𑆨𑆴𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇅 𑆪𑆾𑆓𑆼𑆤𑆳𑆤𑆼𑆤 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇓𑇆
𑆩𑆳𑆱𑆼 𑆯𑆶𑆑𑇀𑆫𑆼 𑆯𑆶𑆖𑆿 𑆖𑆽𑆮 𑆯𑆽𑆬𑆳𑆂 𑆱𑆷𑆫𑇀𑆪𑆳𑆁𑆯𑆶𑆠𑆳𑆥𑆴𑆠𑆳𑆂 𑇅 𑆘𑆠𑆶𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆱𑇀𑆮𑆫𑆱𑆁 𑆯𑆴𑆬𑆳𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇔𑇆
𑆘𑇀𑆚𑆼𑆪𑆁 𑆱𑇀𑆮𑆓𑆤𑇀𑆣𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆰𑆝𑇀𑆪𑆾𑆤𑆴 𑆥𑇀𑆫𑆡𑆴𑆠𑆁 𑆑𑇀𑆰𑆴𑆠𑆿 𑇅𑇖𑇅 𑆬𑆾𑆲𑆳𑆢𑇀𑆨𑆮𑆠𑆴 𑆠𑆢𑇀𑆪𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆴𑆬𑆳𑆘𑆠𑆶 𑆘𑆠𑆶𑆥𑇀𑆫𑆨𑆩𑇀 𑇆𑇖𑇆
𑆠𑆱𑇀𑆪 𑆬𑆾𑆲𑆱𑇀𑆪 𑆠𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁 𑆫𑆱𑆁 𑆖𑆳𑆥𑆴 𑆧𑆴𑆨𑆫𑇀𑆠𑆴 𑆠𑆠𑇀 𑇅𑇗𑇅 𑆠𑇀𑆫𑆥𑆶𑆱𑆵𑆱𑆳𑆪𑆱𑆳𑆢𑆵𑆤𑆴 𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆤𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇗𑇆
𑆪𑆡𑆳 𑆠𑆡𑆳 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑇁𑆥𑆴 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆓𑆶𑆟𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇅𑇘𑇅 𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆛𑆶𑆑𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆱𑆫𑆩𑇀 𑇆𑇘𑇆
𑆑𑆛𑆶𑆥𑆳𑆑𑇀𑆪𑆶𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆁 𑆖 𑆯𑆾𑆰𑆟𑆁 𑆗𑆼𑆢𑆤𑆁 𑆠𑆡𑆳 𑇅𑇙𑇅 𑆠𑆼𑆰𑆶 𑆪𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆩𑆬𑆔𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆤𑆴𑆂𑆯𑆫𑇀𑆑𑆫𑆁 𑆖 𑆪𑆠𑇀 𑇆𑇙𑇆

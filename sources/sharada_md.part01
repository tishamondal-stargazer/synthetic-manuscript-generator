𑆓𑆵𑆠𑆳𑆣𑇀𑆪𑆪𑆤𑆩𑆢𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑇀𑆩𑆨𑆳𑆫𑆳𑆣𑇀𑆮𑆑𑆫𑇀𑆯𑆴𑆠𑆳𑆂𑇅 𑆃𑆘𑆵𑆫𑇀𑆟𑆴𑆤𑆂 𑆑𑇀𑆰𑆠𑆳𑆂 𑆑𑇀𑆰𑆵𑆟𑆳 𑆮𑆸𑆢𑇀𑆣𑆳 𑆧𑆳𑆬𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆧𑆬𑆳𑆂𑇆𑇓𑇙𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆠𑆵𑆱𑆳𑆫𑆯𑆷𑆬𑆳𑆫𑇀𑆠𑆳𑆂 𑆯𑇀𑆮𑆳𑆱𑆴𑆤𑆾 𑆲𑆴𑆑𑇀𑆑𑆴𑆤𑆂 𑆑𑆸𑆯𑆳𑆂𑇅 𑆥𑆠𑆴𑆠𑆳𑆨𑆴𑆲𑆠𑆾𑆤𑇀𑆩𑆠𑇀𑆠𑆳𑆂 𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆳 𑆪𑆳𑆤𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆽𑆂𑇆𑇔𑇐𑇆
𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆨𑆪𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆳 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆾𑆖𑆴𑆠𑆳𑆯𑇀𑆖 𑆪𑆼𑇅 𑆱𑆫𑇀𑆮 𑆍𑆠𑆼 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆱𑆼𑆮𑆼𑆫𑆤𑇀 𑆱𑆳𑆫𑇀𑆮𑆑𑆳𑆬𑆴𑆑𑆩𑇀𑇆𑇔𑇑𑇆
𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁 𑆠𑆡𑆳 𑆲𑇀𑆪𑆼𑆰𑆳𑆁 𑆧𑆬𑆁 𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑆶𑆰𑇀𑆟𑆳𑆠𑆴 𑆖𑆳𑆕𑇀𑆓𑆳𑆤𑆴 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 𑆖𑆳𑆪𑆶𑆰𑆂𑇆𑇔𑇒𑇆
𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆠𑇀𑆮𑆳𑆢𑆳𑆤𑆫𑆷𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆼 𑆖 𑆩𑆳𑆫𑆶𑆠𑆼𑇅 𑆫𑆳𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆖𑆳𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆳𑆢𑇀𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇔𑇓𑇆
𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆫𑇀𑆘𑇀𑆪𑆼𑆰𑆶 𑆑𑆳𑆬𑆼𑆰𑆶 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆂𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆼 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆼𑆰𑆶 𑆤 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇔𑇔𑇆
𑆩𑆼𑆢𑆱𑇀𑆮𑆴𑆤𑆂 𑆱𑇀𑆤𑆼𑆲𑆤𑆴𑆠𑇀𑆪𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆫𑆾𑆓𑆴𑆟𑆂𑇅 𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆳𑆯𑇀𑆖 𑆢𑆴𑆮𑆳 𑆤 𑆯𑆪𑆵𑆫𑆤𑇀 𑆑𑆢𑆳𑆖𑆤𑇆𑇔𑇕𑇆
𑆲𑆬𑆵𑆩𑆑𑆂 𑆯𑆴𑆫𑆂𑆯𑆷𑆬𑆁 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆁 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳𑇅 𑆃𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑆯𑆯𑇀𑆖 𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆲𑆸𑆢𑆪𑆱𑇀𑆪 𑆖𑇆𑇔𑇖𑇆
𑆯𑆾𑆦𑆳𑆫𑆾𑆖𑆑𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆥𑆵𑆤𑆱𑆳𑆫𑇀𑆣𑆳𑆮𑆨𑆼𑆢𑆑𑆳𑆂𑇅 𑆑𑆾𑆜𑆳𑆫𑆶𑆂𑆥𑆴𑆝𑆑𑆳𑆂 𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆑𑆳𑆱𑆾 𑆓𑆬𑆳𑆩𑆪𑆳𑆂𑇆𑇔𑇗𑇆
𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆶𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆩𑆾𑆲𑆯𑇀𑆖 𑆱𑆁𑆫𑆾𑆣𑆂 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆘𑇀𑆮𑆫𑆂𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆁 𑆮𑆴𑆰𑆮𑆼𑆓𑆥𑇀𑆫𑆮𑆫𑇀𑆠(𑆫𑇀𑆣)𑆤𑆩𑇀𑇆𑇔𑇘𑇆
𑆨𑆮𑆼𑆤𑇀𑆤𑆸𑆟𑆳𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑇀𑆪𑆳𑆲𑆴𑆠𑆱𑇀𑆪 𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆴𑆠𑆳𑆲𑆴𑆠𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑇀𑆮𑆥𑇀𑆪𑆳𑆠𑇀 𑆱𑆶𑆒𑆁 𑆧𑆶𑆣𑆂𑇆𑇔𑇙𑇆
𑆫𑆳𑆠𑇀𑆫𑆿 𑆘𑆳𑆓𑆫𑆟𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆥𑇀𑆫𑆱𑇀𑆮𑆥𑆤𑆁 𑆢𑆴𑆮𑆳𑇅 𑆃𑆫𑆷𑆑𑇀𑆰𑆩𑆤𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆠𑇀𑆮𑆳𑆱𑆵𑆤𑆥𑇀𑆫𑆖𑆬𑆳𑆪𑆴𑆠𑆩𑇀𑇆𑇕𑇐𑇆
𑆢𑆼𑆲𑆮𑆸𑆠𑇀𑆠𑆿 𑆪𑆡𑆳𑇁𑇁𑆲𑆳𑆫𑆱𑇀𑆠𑆡𑆳 𑆱𑇀𑆮𑆥𑇀𑆤𑆂 𑆱𑆶𑆒𑆾 𑆩𑆠𑆂𑇅 𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆲𑆳𑆫𑆱𑆩𑆶𑆠𑇀𑆡𑆼 𑆖 𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆼 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇆𑇕𑇑𑇆
𑆩𑆤𑆱𑆾𑇁𑆤𑆶𑆓𑆶𑆟𑆳 𑆓𑆤𑇀𑆣𑆳𑆂 𑆯𑆧𑇀𑆢𑆳𑆂 𑆱𑆁𑆮𑆳𑆲𑆤𑆳𑆤𑆴 𑆖𑇅 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆁 𑆬𑆼𑆥𑆂 𑆯𑆴𑆫𑆱𑆾 𑆮𑆢𑆤𑆱𑇀𑆪 𑆖𑇆𑇕𑇓𑇆
𑆱𑇀𑆮𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆁 𑆯𑆪𑆤𑆁 𑆮𑆼𑆯𑇀𑆩 𑆱𑆶𑆒𑆁 𑆑𑆳𑆬𑆱𑇀𑆠𑆡𑆾𑆖𑆴𑆠𑆂𑇅 𑆄𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆖𑆴𑆫𑆳𑆤𑇀𑆤𑆴𑆢𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆤𑆰𑇀𑆛𑆳 𑆪𑆳 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆠𑆂𑇆𑇕𑇔𑇆
𑆑𑆳𑆪𑆱𑇀𑆪 𑆯𑆴𑆫𑆱𑆯𑇀𑆖𑆽𑆮 𑆮𑆴𑆫𑆼𑆑𑆯𑇀𑆗𑆫𑇀𑆢𑆤𑆁 𑆨𑆪𑆩𑇀𑇅 𑆖𑆴𑆤𑇀𑆠𑆳 𑆑𑇀𑆫𑆾𑆣𑆱𑇀𑆠𑆡𑆳 𑆣𑆷𑆩𑆾 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾 𑆫𑆑𑇀𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇕𑇕𑇆
𑆇𑆥𑆮𑆳𑆱𑆾𑇁𑆱𑆶𑆒𑆳 𑆯𑆪𑇀𑆪𑆳 𑆱𑆠𑇀𑆠𑇀𑆮𑆿𑆢𑆳𑆫𑇀𑆪𑆁 𑆠𑆩𑆾𑆘𑆪𑆂𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆩𑆲𑆴𑆠𑆁 𑆮𑆳𑆫𑆪𑆤𑇀𑆠𑆴 𑆱𑆩𑆶𑆠𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇕𑇖𑇆
𑆍𑆠 𑆍𑆮 𑆖 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆱𑇀𑆪 𑆲𑆼𑆠𑆮𑆂𑇅 𑆑𑆳𑆫𑇀𑆪𑆁 𑆑𑆳𑆬𑆾 𑆮𑆴𑆑𑆳𑆫𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆮𑆳𑆪𑆶𑆫𑆼𑆮 𑆖𑇆𑇕𑇗𑇆
𑆠𑆩𑆾𑆨𑆮𑆳 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆳 𑆖 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆯𑇀𑆫𑆩𑆱𑆩𑇀𑆨𑆮𑆳 𑆖𑇅 𑆄𑆓𑆤𑇀𑆠𑆶𑆑𑆵 𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆤𑆶𑆮𑆫𑇀𑆠𑆴𑆤𑆵 𑆖 𑆫𑆳𑆠𑇀𑆫𑆴𑆱𑇀𑆮𑆨𑆳𑆮𑆥𑇀𑆫𑆨𑆮𑆳 𑆖 𑆤𑆴𑆢𑇀𑆫𑆳𑇆𑇕𑇘𑇆
𑆫𑆳𑆠𑇀𑆫𑆴𑆱𑇀𑆮𑆨𑆳𑆮𑆥𑇀𑆫𑆨𑆮𑆳 𑆩𑆠𑆳 𑆪𑆳 𑆠𑆳𑆁 𑆨𑆷𑆠𑆣𑆳𑆠𑇀𑆫𑆵𑆁 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆂𑇅 𑆠𑆩𑆾𑆨𑆮𑆳𑆩𑆳𑆲𑆶𑆫𑆔𑆱𑇀𑆪 𑆩𑆷𑆬𑆁 𑆯𑆼𑆰𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆤𑇀𑆠𑆴𑇆𑇕𑇙𑇆

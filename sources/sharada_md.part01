𑆃𑆮𑇀𑆪𑆕𑇀𑆓𑆥𑆴𑆝𑆑𑆁 𑆑𑆳𑆤𑇀𑆠𑆁 𑆨𑆮𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆘𑆱𑆤𑇀𑆤𑆴𑆨𑆩𑇀 𑇅𑇖𑇖𑇅 𑆥𑆑𑇀𑆰𑇀𑆩𑆬𑆁 𑆮𑆴𑆯𑆢𑆁 𑆑𑆳𑆤𑇀𑆠𑆩𑆩𑆬𑆾𑆘𑇀𑆘𑇀𑆮𑆬𑆩𑆟𑇀𑆝𑆬𑆩𑇀 𑇆𑇖𑇖𑇆
𑆤𑆼𑆠𑇀𑆫𑆩𑆚𑇀𑆘𑆤𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆨𑆮𑆼𑆖𑇀𑆖𑆳𑆩𑆬𑆠𑆳𑆫𑆑𑆩𑇀 𑇅 𑆪𑆯𑆱𑇀𑆪𑆁 𑆱𑇀𑆮𑆫𑇀𑆓𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆣𑆤𑆣𑆳𑆤𑇀𑆪𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇖𑇗𑇆
𑆢𑆼𑆮𑆠𑆳𑆠𑆴𑆡𑆴𑆮𑆴𑆥𑇀𑆫𑆳𑆟𑆳𑆁 𑆥𑆷𑆘𑆤𑆁 𑆓𑆾𑆠𑇀𑆫𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇅𑇖𑇘𑇅 𑆄𑆲𑆳𑆫𑆂 𑆥𑇀𑆫𑆵𑆟𑆤𑆂 𑆱𑆢𑇀𑆪𑆾 𑆧𑆬𑆑𑆸𑆢𑇀𑆢𑆼𑆲𑆣𑆳𑆫𑆑𑆂 𑇆𑇖𑇘𑇆
𑆖𑆑𑇀𑆰𑆶𑆂𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆁 𑆥𑇀𑆫𑆵𑆠𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇅𑇗𑇐𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑆫𑆾 𑆢𑆼𑆲𑆱𑆶𑆒𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆂 𑆯𑇀𑆫𑆩𑆱𑆶𑆥𑇀𑆠𑆴𑆤𑆶𑆠𑇀 𑇆𑇗𑇐𑇆
𑆥𑆳𑆢𑆠𑇀𑆮𑆕𑇀𑆩𑆸𑆢𑆶𑆑𑆳𑆫𑆵 𑆖 𑆥𑆳𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆂 𑆱𑆢𑆳 𑆲𑆴𑆠𑆂 𑇅𑇗𑇑𑇅 𑆥𑆳𑆢𑆫𑆾𑆓𑆲𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆁 𑆥𑇀𑆫𑆵𑆠𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇗𑇑𑇆
𑆱𑆶𑆒𑆥𑇀𑆫𑆖𑆳𑆫𑆩𑆾𑆘𑆱𑇀𑆪𑆁 𑆱𑆢𑆳 𑆥𑆳𑆢𑆠𑇀𑆫𑆣𑆳𑆫𑆟𑆩𑇀 𑇅 𑆃𑆤𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆤𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑆶𑆥𑆔𑆳𑆠𑆑𑆸𑆠𑇀 𑇆𑇗𑇒𑇆
𑆥𑆳𑆢𑆳𑆨𑇀𑆪𑆳𑆩𑆤𑆶𑆥𑆳𑆤𑆢𑇀𑆨𑇀𑆪𑆳𑆁 𑆱𑆢𑆳 𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆁 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆥𑆳𑆥𑇀𑆩𑆾𑆥𑆯𑆩𑆤𑆁 𑆑𑆼𑆯𑆤𑆒𑆫𑆾𑆩𑆳𑆥𑆩𑆳𑆫𑇀𑆘𑆤𑆩𑇀 𑇆𑇗𑇓𑇆
𑆲𑆫𑇀𑆰𑆬𑆳𑆔𑆮𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆑𑆫𑆩𑆶𑆠𑇀𑆱𑆳𑆲𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇅 𑆧𑆳𑆟𑆮𑆳𑆫𑆁 𑆩𑆸𑆘𑆳𑆮𑆫𑇀𑆟𑆠𑆼𑆘𑆾𑆧𑆬𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇗𑇔𑇆
𑆥𑆮𑆴𑆠𑇀𑆫𑆁 𑆑𑆼𑆯𑇀𑆪𑆩𑆶𑆰𑇀𑆟𑆵𑆰𑆁 𑆮𑆳𑆠𑆳𑆠𑆥𑆫𑆘𑆾𑆥𑆲𑆩𑇀 𑇅𑇗𑇕𑇅 𑆮𑆫𑇀𑆰𑆳𑆤𑆴𑆬𑆫𑆘𑆾𑆔𑆫𑇀𑆩𑆲𑆴𑆩𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇆𑇗𑇕𑇆
𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆩𑆿𑆘𑆱𑇀𑆪𑆁 𑆯𑆕𑇀𑆑𑆫𑆁 𑆗𑆠𑇀𑆫𑆣𑆳𑆫𑆟𑆩𑇀 𑇅𑇗𑇖𑇅 𑆯𑆶𑆤𑆂 𑆱𑆫𑆵𑆱𑆸𑆥𑆮𑇀𑆪𑆳𑆬𑆮𑆴𑆰𑆳𑆟𑆴𑆨𑇀𑆪𑆾 𑆨𑆪𑆳𑆥𑆲𑆩𑇀 𑇆𑇗𑇖𑇆
𑆯𑇀𑆫𑆩𑆱𑇀𑆒𑆬𑆤𑆢𑆾𑆰𑆔𑇀𑆤𑆁 𑆱𑇀𑆡𑆮𑆴𑆫𑆼 𑆖 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇅 𑆱𑆠𑇀𑆠𑇀𑆮𑆾𑆠𑇀𑆱𑆳𑆲𑆧𑆬𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆣𑆽𑆫𑇀𑆪𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇗𑇗𑇆
𑆃𑆮𑆰𑇀𑆛𑆩𑇀𑆨𑆑𑆫𑆁 𑆖𑆳𑆥𑆴 𑆨𑆪𑆔𑇀𑆤𑆁 𑆢𑆟𑇀𑆝𑆣𑆳𑆫𑆟𑆩𑇀 𑇅𑇗𑇘𑇅 𑆄𑆱𑇀𑆪𑆳 𑆮𑆫𑇀𑆟𑆑𑆦𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆑𑆫𑆵 𑆱𑆶𑆒𑆳 𑇆𑇗𑇘𑇆
𑆃𑆣𑇀𑆮𑆳 𑆮𑆫𑇀𑆟𑆑𑆦𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇅 𑆃𑆠𑇀𑆪𑆣𑇀𑆮𑆳 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑇁𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑆫𑆳𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆑𑆸𑆖𑇀𑆖 𑆱𑆂 𑇆𑇗𑇙𑇆
𑆪𑆠𑇀𑆠𑆶 𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆁 𑆤𑆳𑆠𑆴𑆢𑆼𑆲𑆥𑆵𑆝𑆳𑆑𑆫𑆁 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆠𑆢𑆳𑆪𑆶𑆫𑇀𑆧𑆬𑆩𑆼𑆣𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆢𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆾𑆣𑆤𑆩𑇀 𑇆𑇘𑇐𑇆
𑆯𑇀𑆫𑆩𑆳𑆤𑆴𑆬𑆲𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆥𑆶𑆰𑇀𑆛𑆴𑆤𑆴𑆢𑇀𑆫𑆳𑆣𑆸𑆠𑆴𑆥𑇀𑆫𑆢𑆩𑇀 𑇅 𑆱𑆶𑆒𑆁 𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆁, 𑆢𑆶𑆂𑆒𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆁 𑆩𑆠𑆩𑇀 𑇆𑇘𑇑𑇆
𑆧𑆳𑆬𑆮𑇀𑆪𑆘𑆤𑆩𑆿𑆘𑆱𑇀𑆪𑆁 𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆢𑆵𑆤𑆥𑆾𑆲𑆠𑆴 𑇅 𑆯𑆾𑆰𑆢𑆳𑆲𑆯𑇀𑆫𑆩𑆱𑇀𑆮𑆼𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆔𑇀𑆤𑆾 𑆮𑇀𑆪𑆘𑆤𑆳𑆤𑆴𑆬𑆂 𑇆𑇘𑇒𑇆
𑆥𑇀𑆫𑆵𑆠𑆴𑆤𑆴𑆢𑇀𑆫𑆳𑆑𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆑𑆦𑆮𑆳𑆠𑆯𑇀𑆫𑆩𑆳𑆥𑆲𑆩𑇀 𑇅 𑆱𑆁𑆮𑆳𑆲𑆤𑆁 𑆩𑆳𑆁𑆱𑆫𑆑𑇀𑆠𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆑𑆫𑆁 𑆱𑆶𑆒𑆩𑇀 𑇆𑇘𑇓𑇆
𑆥𑇀𑆫𑆮𑆳𑆠𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆱𑇀𑆠𑆩𑇀𑆨𑆑𑆸𑆢𑇀𑆢𑆳𑆲𑆥𑆑𑇀𑆠𑆴𑆤𑆶𑆠𑇀 𑇅 𑆱𑇀𑆮𑆼𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆥𑆴𑆥𑆳𑆱𑆳𑆔𑇀𑆤𑆩𑆥𑇀𑆫𑆮𑆳𑆠𑆩𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑇆𑇘𑇔𑇆
𑆱𑆶𑆒𑆁 𑆮𑆳𑆠𑆁 𑆥𑇀𑆫𑆱𑆼𑆮𑆼𑆠 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆯𑆫𑆢𑆴 𑆩𑆳𑆤𑆮𑆂 𑇅 𑆤𑆴𑆮𑆳𑆠𑆁 𑆲𑇀𑆪𑆳𑆪𑆶𑆰𑆼 𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆳𑆪 𑆖 𑆱𑆫𑇀𑆮𑆢𑆳 𑇆𑇘𑇕𑇆
𑆄𑆠𑆥𑆂 𑆥𑆴𑆠𑇀𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑆴𑆱𑇀𑆮𑆼𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆳𑆱𑇀𑆫𑆑𑆸𑆠𑇀 𑇅 𑆢𑆳𑆲𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆑𑆳𑆫𑆵 𑆖 𑆗𑆳𑆪𑆳 𑆖𑆽𑆠𑆳𑆤𑆥𑆾𑆲𑆠𑆴 𑇆𑇘𑇖𑇆
𑆃𑆓𑇀𑆤𑆴𑆫𑇀𑆮𑆳𑆠𑆑𑆦𑆱𑇀𑆠𑆩𑇀𑆨𑆯𑆵𑆠𑆮𑆼𑆥𑆡𑆶𑆤𑆳𑆯𑆤𑆂 𑇅 𑆄𑆩𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆘𑆫𑆟𑆾 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆂 𑇆𑇘𑇗𑇆
𑆥𑆶𑆰𑇀𑆛𑆴𑆮𑆫𑇀𑆟𑆧𑆬𑆾𑆠𑇀𑆱𑆳𑆲𑆩𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑇀𑆠𑆴𑆩𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆳𑆩𑇀 𑇅 𑆑𑆫𑆾𑆠𑆴 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆁 𑆖 𑆤𑆴𑆢𑇀𑆫𑆳 𑆑𑆳𑆬𑆼 𑆤𑆴𑆰𑆼𑆮𑆴𑆠𑆳 𑇆𑇘𑇘𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆠 𑆍𑆮 𑆤𑆵𑆖𑆤𑆒𑆫𑆾𑆩𑇀𑆟𑆳 𑆯𑆶𑆖𑆴𑆤𑆳 𑆯𑆶𑆑𑇀𑆬𑆮𑆳𑆱𑆱𑆳 𑆬𑆔𑆷𑆰𑇀𑆟𑆵𑆰𑆖𑇀𑆗𑆠𑇀𑆫𑆾𑆥𑆳𑆤𑆠𑇀𑆑𑆼𑆤 𑆢𑆟𑇀𑆝𑆥𑆳𑆟𑆴𑆤𑆳 𑆑𑆳𑆬𑆼 𑆲𑆴𑆠𑆩𑆴𑆠𑆩𑆣𑆶𑆫𑆥𑆷𑆫𑇀𑆮𑆳𑆨𑆴𑆨𑆳𑆰𑆴𑆟𑆳 𑆧𑆤𑇀𑆣𑆶𑆨𑆷𑆠𑆼𑆤 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆶𑆩𑆠𑆼𑆤 𑆱𑆶𑆱𑆲𑆳𑆪𑆼𑆤𑆳𑆤𑆤𑇀𑆪𑆩𑆤𑆱𑆳 𑆒𑆬𑆷𑆥𑆖𑆫𑆴𑆠𑆮𑇀𑆪𑆁, 𑆠𑆢𑆥𑆴 𑆤 𑆫𑆳𑆠𑇀𑆫𑆿, 𑆤 𑆑𑆼𑆯𑆳𑆱𑇀𑆡𑆴𑆑𑆟𑇀𑆛𑆑𑆳𑆯𑇀𑆩𑆠𑆶𑆰𑆨𑆱𑇀𑆩𑆾𑆠𑇀𑆑𑆫𑆑𑆥𑆳𑆬𑆳𑆕𑇀𑆓𑆳𑆫𑆳𑆩𑆼𑆣𑇀𑆪𑆱𑇀𑆤𑆳𑆤𑆧𑆬𑆴𑆨𑆷𑆩𑆴𑆰𑆶, 𑆤 𑆮𑆴𑆰𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆑𑆵𑆬𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆯𑇀𑆮𑆨𑇀𑆫𑆳𑆟𑆳𑆩𑆶𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆠𑇀 𑇆𑇘𑇙𑇆
𑆤 𑆫𑆳𑆘𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆥𑆫𑆶𑆰𑆥𑆽𑆯𑆶𑆤𑇀𑆪𑆳𑆤𑆸𑆠𑆳𑆤𑆴 𑆮𑆢𑆼𑆠𑇀, 𑆤 𑆢𑆼𑆮𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆥𑆴𑆠𑆸𑆥𑆫𑆴𑆮𑆳𑆢𑆳𑆁𑆯𑇀𑆖; 𑆤 𑆤𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆾𑆤𑇀𑆩𑆠𑇀𑆠𑆥𑆠𑆴𑆠𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆤𑆵𑆖𑆳𑆤𑆶𑆥𑆳𑆱𑆵𑆠 𑇆𑇙𑇐𑇆
𑆮𑆸𑆑𑇀𑆰𑆥𑆫𑇀𑆮𑆠𑆥𑇀𑆫𑆥𑆳𑆠𑆮𑆴𑆰𑆩𑆮𑆬𑇀𑆩𑆵𑆑𑆢𑆶𑆰𑇀𑆛𑆮𑆳𑆘𑆴𑆑𑆶𑆚𑇀𑆘𑆫𑆳𑆢𑇀𑆪𑆣𑆴𑆫𑆾𑆲𑆟𑆳𑆤𑆴 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆥𑆷𑆫𑇀𑆟𑆤𑆢𑆵𑆱𑆩𑆶𑆢𑇀𑆫𑆳𑆮𑆴𑆢𑆴𑆠𑆥𑆬𑇀𑆮𑆬𑆯𑇀𑆮𑆨𑇀𑆫𑆑𑆷𑆥𑆳𑆮𑆠𑆫𑆟𑆳𑆤𑆴, 𑆨𑆴𑆤𑇀𑆤𑆯𑆷𑆤𑇀𑆪𑆳𑆓𑆳𑆫𑆯𑇀𑆩𑆯𑆳𑆤𑆮𑆴𑆘𑆤𑆳𑆫𑆟𑇀𑆪𑆮𑆳𑆱𑆳𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆨𑇀𑆫𑆩𑆮𑇀𑆪𑆳𑆬𑆨𑆶𑆘𑆕𑇀𑆓𑆑𑆵𑆛𑆱𑆼𑆮𑆳𑆯𑇀𑆖, 𑆓𑇀𑆫𑆳𑆩𑆳𑆔𑆳𑆠𑆑𑆬𑆲𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆮𑇀𑆪𑆳𑆬𑆱𑆫𑆵𑆱𑆸𑆥𑆯𑆸𑆕𑇀𑆓𑆴𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆳𑆁𑆯𑇀𑆖 𑇆𑇙𑇑𑇆
𑆤𑆳𑆓𑇀𑆤𑆴𑆓𑆾𑆓𑆶𑆫𑆶𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆥𑇀𑆫𑆼𑆕𑇀𑆒𑆳𑆢𑆩𑇀𑆥𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆪𑆳𑆪𑆳𑆠𑇀 𑇅 𑆤 𑆯𑆮𑆩𑆤𑆶𑆪𑆳𑆪𑆳𑆠𑇀 𑇅 𑆢𑆼𑆮𑆓𑆾𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆖𑆽𑆠𑇀𑆪𑆣𑇀𑆮𑆘𑆫𑆾𑆓𑆴𑆥𑆠𑆴𑆠𑆥𑆳𑆥𑆑𑆳𑆫𑆴𑆟𑆳𑆁 𑆖 𑆗𑆳𑆪𑆳𑆁 𑆤𑆳𑆑𑇀𑆫𑆩𑆼𑆠 𑇅 𑆤𑆳𑆱𑇀𑆠𑆁 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆩𑆶𑆢𑇀𑆪𑆤𑇀𑆠𑆁 𑆮𑆳𑇁𑇁𑆢𑆴𑆠𑇀𑆪𑆁 𑆮𑆵𑆑𑇀𑆰𑆼𑆠 𑇅 𑆓𑆳𑆁 𑆣𑆳𑆥𑆪𑆤𑇀𑆠𑆵𑆁 𑆣𑆪𑆤𑇀𑆠𑆵𑆁 𑆥𑆫𑆯𑆱𑇀𑆪𑆁 𑆮𑆳 𑆖𑆫𑆤𑇀𑆠𑆵𑆁 𑆤 𑆑𑆱𑇀𑆩𑆽𑆖𑆴𑆢𑆳𑆖𑆑𑇀𑆰𑆵𑆠, 𑆤 𑆖𑆾𑆬𑇀𑆑𑆳𑆥𑆳𑆠𑆾𑆠𑇀𑆥𑆳𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆣𑆤𑆷𑆁𑆰𑆴 𑇅 𑆤𑆳𑆓𑇀𑆤𑆴𑆁 𑆩𑆶𑆒𑆼𑆤𑆾𑆥𑆣𑆩𑆼𑆠𑇀 𑇅 𑆤𑆳𑆥𑆾 𑆨𑆷𑆩𑆴𑆁 𑆮𑆳 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆼𑆤𑆳𑆨𑆴𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑇆𑇙𑇒𑇆
𑆤 𑆮𑆼𑆓𑆳𑆤𑇀 𑆣𑆳𑆫𑆪𑆼𑆢𑇀 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆢𑆵𑆤𑆳𑆩𑇀 𑇅 𑆤 𑆧𑆲𑆴𑆫𑇀𑆮𑆼𑆓𑆳𑆤𑇀 𑆓𑇀𑆫𑆳𑆩𑆤𑆓𑆫𑆢𑆼𑆮𑆠𑆳𑆪𑆠𑆤𑆯𑇀𑆩𑆯𑆳𑆤𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆱𑆬𑆴𑆬𑆳𑆯𑆪𑆥𑆡𑆴 𑆱𑆤𑇀𑆤𑆴𑆑𑆸𑆰𑇀𑆛𑆳𑆤𑆶𑆠𑇀𑆱𑆸𑆘𑆼𑆤𑇀𑆤 𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆤 𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆱𑆬𑆴𑆬𑆱𑆾𑆩𑆳𑆫𑇀𑆑𑆓𑆾𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆠𑆴𑆩𑆶𑆒𑆩𑇀 𑇆𑇙𑇓𑇆
𑆤 𑆨𑆷𑆩𑆴𑆁 𑆮𑆴𑆬𑆴𑆒𑆼𑆠𑇀, 𑆤𑆳𑆱𑆁𑆮𑆸𑆠𑆩𑆶𑆒𑆂 𑆱𑆢𑆱𑆴 𑆘𑆸𑆩𑇀𑆨𑆾𑆢𑇀𑆓𑆳𑆫𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆑𑇀𑆰𑆮𑆡𑆷𑆤𑆶𑆠𑇀𑆱𑆸𑆘𑆼𑆠𑇀, 𑆤 𑆥𑆫𑇀𑆪𑆕𑇀𑆑𑆴𑆑𑆳𑆮𑆰𑇀𑆛𑆩𑇀𑆨𑆥𑆳𑆢𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑆳𑆤𑆴 𑆓𑆶𑆫𑆶𑆱𑆤𑇀𑆤𑆴𑆣𑆿 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇙𑇔𑇆
𑆤 𑆧𑆳𑆬𑆑𑆫𑇀𑆟𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆾𑆠𑆾𑆢𑆯𑆤𑆳𑆑𑇀𑆰𑆴𑆮𑆴𑆮𑆫𑆳𑆟𑇀𑆪𑆨𑆴𑆑𑆶𑆰𑇀𑆟𑆵𑆪𑆳𑆠𑇀 , 𑆤 𑆮𑆵𑆘𑆪𑆼𑆠𑇀 𑆑𑆼𑆯𑆩𑆶𑆒𑆤𑆒𑆮𑆱𑇀𑆠𑇀𑆫𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆴, 𑆤 𑆓𑆳𑆠𑇀𑆫𑆤𑆒𑆮𑆑𑇀𑆠𑇀𑆫𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆑𑆳𑆰𑇀𑆜𑆬𑆾𑆰𑇀𑆛𑆠𑆸𑆟𑆳𑆢𑆵𑆤𑆨𑆴𑆲𑆤𑇀𑆪𑆳𑆖𑇀𑆗𑆴𑆤𑇀𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆤𑇀𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑇆𑇙𑇕𑇆
𑆤 𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆁 𑆱𑆼𑆮𑆼𑆠, 𑆤 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆾𑇁𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆳𑆱𑆵𑆠, 𑆤𑆾𑆠𑇀𑆑𑆛𑆑𑆳𑆬𑇀𑆥𑆑𑆳𑆰𑇀𑆜𑆳𑆱𑆤𑆩𑆣𑇀𑆪𑆳𑆱𑆵𑆠, 𑆤 𑆓𑇀𑆫𑆵𑆮𑆳𑆁 𑆮𑆴𑆰𑆩𑆁 𑆣𑆳𑆫𑆪𑆼𑆠𑇀, 𑆤 𑆮𑆴𑆰𑆩𑆑𑆳𑆪𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆨𑆘𑆼𑆠 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆮𑆳, 𑆤 𑆥𑇀𑆫𑆠𑆠𑆩𑆵𑆑𑇀𑆰𑆼𑆠 𑆮𑆴𑆯𑆼𑆰𑆳𑆘𑇀𑆘𑇀𑆪𑆾𑆠𑆴𑆫𑇀𑆨𑆳𑆱𑇀𑆑𑆫𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆬𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆤𑆴, 𑆤 𑆨𑆳𑆫𑆁 𑆯𑆴𑆫𑆱𑆳 𑆮𑆲𑆼𑆠𑇀, 𑆤 𑆱𑇀𑆮𑆥𑇀𑆤𑆘𑆳𑆓𑆫𑆟𑆯𑆪𑆤𑆳𑆱𑆤𑆱𑇀𑆡𑆳𑆤𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆥𑇀𑆫𑆣𑆳𑆮𑆤𑆬𑆕𑇀𑆔𑆤𑆥𑇀𑆬𑆮𑆤𑆥𑇀𑆫𑆠𑆫𑆟𑆲𑆳𑆱𑇀𑆪𑆨𑆳𑆰𑇀𑆪𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆢𑆵𑆤𑆶𑆖𑆴𑆠𑆳𑆤𑆥𑇀𑆪𑆠𑆴𑆱𑆼𑆮𑆼𑆠 𑇆𑇙𑇖𑇆
𑆇𑆖𑆴𑆠𑆳𑆢𑆥𑇀𑆪𑆲𑆴𑆠𑆳𑆠𑇀 𑆑𑇀𑆫𑆩𑆯𑆾 𑆮𑆴𑆫𑆩𑆼𑆠𑇀, 𑆲𑆴𑆠𑆩𑆤𑆶𑆖𑆴𑆠𑆩𑆥𑇀𑆪𑆳𑆱𑆼𑆮𑆼𑆠 𑆑𑇀𑆫𑆩𑆯𑆂, 𑆤 𑆖𑆽𑆑𑆳𑆤𑇀𑆠𑆠𑆂 𑆥𑆳𑆢𑆲𑆵𑆤𑆳𑆠𑇀 𑇆𑇙𑇗𑇆
𑆤𑆳𑆮𑆳𑆑𑇀𑆯𑆴𑆫𑆳𑆂 𑆯𑆪𑆵𑆠, 𑆤 𑆨𑆴𑆤𑇀𑆤𑆥𑆳𑆠𑇀𑆫𑆼 𑆨𑆶𑆚𑇀𑆘𑆵𑆠, 𑆤 𑆮𑆴𑆤𑆳 𑆥𑆳𑆠𑇀𑆫𑆼𑆟, 𑆤𑆳𑆚𑇀𑆘𑆬𑆴𑆥𑆶𑆛𑆼𑆤𑆳𑆥𑆂 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆑𑆳𑆬𑆼 𑆲𑆴𑆠𑆩𑆴𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆣𑆶𑆫𑆥𑇀𑆫𑆳𑆪𑆩𑆳𑆲𑆳𑆫𑆁 𑆮𑆽𑆢𑇀𑆪𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆼𑆑𑇀𑆰𑆴𑆠𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆓𑇀𑆫𑆳𑆩𑆓𑆟𑆓𑆟𑆴𑆑𑆳𑆥𑆟𑆴𑆑𑆯𑆠𑇀𑆫𑆶𑆱𑆠𑇀𑆫𑆯𑆜𑆥𑆠𑆴𑆠𑆨𑆾𑆘𑆤𑆳𑆤𑆴 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀, 𑆯𑆼𑆰𑆳𑆟𑇀𑆪𑆥𑆴 𑆖𑆳𑆤𑆴𑆰𑇀𑆛𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆱𑇀𑆥𑆫𑇀𑆯𑆯𑆧𑇀𑆢𑆩𑆳𑆤𑆱𑆳𑆤𑆴, 𑆃𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆼𑆮𑆕𑇀𑆓𑆶𑆟𑆳𑆤𑇀𑆪𑆥𑆴 𑆱𑆩𑇀𑆨𑇀𑆫𑆩𑆢𑆠𑇀𑆠𑆳𑆤𑆴, (𑆠𑆳𑆤𑇀𑆪𑆥𑆴) 𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆧𑆳𑆬𑆾𑆥𑆲𑆠𑆳𑆤𑆴 , 𑆤𑆳𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆥𑆳𑆢𑆾 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆤 𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆥𑆵𑆝𑆴𑆠𑆾 𑆤 𑆱𑆤𑇀𑆣𑇀𑆪𑆪𑆾𑆫𑇀𑆤𑆳𑆤𑆶𑆥𑆳𑆯𑇀𑆫𑆴𑆠𑆾 𑆤𑆳𑆠𑆵𑆠𑆑𑆳𑆬𑆁 𑆲𑆵𑆤𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 (𑆤𑆾𑆢𑇀𑆣𑆸𑆠𑆱𑇀𑆤𑆼𑆲𑆁) 𑆖𑆼𑆠𑆴 𑇆𑇙𑇘𑇆
𑆤 𑆨𑆶𑆚𑇀𑆘𑆵𑆠𑆾𑆢𑇀𑆣𑆸𑆠𑆱𑇀𑆤𑆼𑆲𑆁 𑆤𑆰𑇀𑆛𑆁 𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆁 𑆥𑆪𑆂 𑇅 𑆤 𑆤𑆑𑇀𑆠𑆁 𑆢𑆣𑆴 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆤 𑆖𑆳𑆥𑇀𑆪𑆔𑆸𑆠𑆯𑆫𑇀𑆑𑆫𑆩𑇀 𑇆𑇙𑇙𑇆
𑆤𑆳𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆁 𑆤𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆤𑆾𑆰𑇀𑆟𑆁 𑆤𑆳𑆩𑆬𑆑𑆽𑆫𑇀𑆮𑆴𑆤𑆳 𑇅 𑆃𑆤𑇀𑆪𑆡𑆳 𑆘𑆤𑆪𑆼𑆠𑇀 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆢𑆵𑆤𑇀 𑆓𑆢𑆳𑆤𑇀 𑆧𑆲𑆷𑆤𑇀 𑇅 𑆤𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆶𑆢𑆑𑆼 𑆥𑆯𑇀𑆪𑆼𑆤𑇀𑆤 𑆤𑆓𑇀𑆤𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆼𑆘𑇀𑆘𑆬𑆩𑇀 𑇆𑇑𑇐𑇐𑇆
𑆢𑇀𑆪𑆷𑆠𑆩𑆢𑇀𑆪𑆳𑆠𑆴𑆱𑆼𑆮𑆳𑆥𑇀𑆫𑆠𑆴𑆨𑆷𑆠𑇀𑆮𑆱𑆳𑆑𑇀𑆰𑆴𑆠𑇀𑆮𑆱𑆩𑆳𑆲𑇀𑆮𑆳𑆤𑆓𑆾𑆰𑇀𑆜𑆵𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆳𑆟𑆴 𑆤 𑆱𑆼𑆮𑆼𑆠, 𑆱𑇀𑆫𑆘𑆁 𑆗𑆠𑇀𑆫𑆾𑆥𑆳𑆤𑆲𑆿 𑆑𑆤𑆑𑆩𑆠𑆵𑆠𑆮𑆳𑆱𑆳𑆁𑆱𑆴 𑆤 𑆖𑆳𑆤𑇀𑆪𑆽𑆫𑇀𑆣𑆸𑆠𑆳𑆤𑆴 𑆣𑆳𑆫𑆪𑆼𑆠𑇀, 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆩𑆓𑇀𑆤𑆴𑆁 𑆓𑆳𑆁 𑆖 𑆤𑆾𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆂 𑆱𑇀𑆥𑆸𑆯𑆼𑆠𑇀 𑇆𑇑𑇐𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆪𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆸𑆠𑆿 𑆪𑆼 𑆪𑆼 𑆢𑆾𑆰𑆳𑆂 𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆠𑆼𑆰𑆶 𑆠𑆼𑆰𑆶 𑆥𑇀𑆫𑆢𑆳𑆠𑆮𑇀𑆪𑆳 𑆫𑆱𑆳𑆱𑇀𑆠𑆼 𑆠𑆼 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇆𑇑𑇐𑇒𑇆
𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆤 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆾𑆪𑆁 𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑆫𑆢𑆴 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑇅 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆖𑆠𑆶𑆫𑆾 𑆩𑆳𑆱𑆳𑆤𑇀 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑆶𑆢𑆑𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇑𑇐𑇓𑇆
𑆇𑆰𑇀𑆟𑆁 𑆲𑆽𑆩𑆼 𑆮𑆱𑆤𑇀𑆠𑆼 𑆖 𑆑𑆳𑆩𑆁 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆠𑆶 𑆯𑆵𑆠𑆬𑆩𑇀 𑇅 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆖 𑆮𑆱𑆤𑇀𑆠𑆼 𑆖 𑆱𑆵𑆣𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆿 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂 𑇆𑇑𑇐𑇔𑇆
𑆯𑆸𑆠𑆯𑆵𑆠𑆁 𑆥𑆪𑆾 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆥𑇀𑆫𑆳𑆮𑆸𑆛𑇀𑆑𑆳𑆬𑆼 𑆫𑆱𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑇅 𑆪𑆷𑆰𑆁 𑆮𑆫𑇀𑆰𑆠𑆴, 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆥𑆴𑆧𑆼𑆖𑇀𑆗𑆵𑆠𑆬𑆁 𑆘𑆬𑆩𑇀 𑇆𑇑𑇐𑇕𑇆
𑆱𑇀𑆮𑆱𑇀𑆡 𑆍𑆮𑆩𑆠𑆾𑇁𑆤𑇀𑆪𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆳𑆲𑆳𑆫𑆓𑆠𑆳𑆤𑆶𑆓𑆂 𑇅 𑆱𑇀𑆤𑆼𑆲𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆨𑆴𑆯𑇀𑆖 𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇆𑇑𑇐𑇖𑇆
𑆥𑆴𑆧𑆼𑆢𑆓𑇀𑆤𑆴𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆤 𑆖 𑆮𑆼𑆓𑆳𑆤𑇀 𑆮𑆴𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇅𑇑𑇐𑇗𑇅 𑆃𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑇀𑆠𑆴𑆑𑆫𑆁 𑆤𑆹𑆟𑆳𑆁 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆯𑆩𑆤𑆁 𑆥𑇀𑆫𑆠𑆴 𑇆𑇑𑇐𑇗𑇆
𑆥𑇀𑆫𑆳𑆮𑆸𑆛𑇀𑆯𑆫𑆢𑇀𑆮𑆱𑆤𑇀𑆠𑆼𑆰𑆶 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆑𑆦𑆼 𑆥𑇀𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆴𑆫𑆼𑆑𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆵𑆫𑆟𑆼 𑇆𑇑𑇐𑇘𑇆
𑆯𑆱𑇀𑆪𑆠𑆼 𑆠𑇀𑆫𑆴𑆰𑇀𑆮𑆥𑆴 𑆱𑆢𑆳 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾 𑆢𑆾𑆰𑆤𑆳𑆯𑆤𑆂 𑇅 𑆨𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆥𑇀𑆪𑆤𑇀𑆤𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆤𑇀𑆤 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆪𑆠𑆴 𑇆𑇑𑇐𑇙𑇆
𑆇𑆠𑇀𑆱𑆫𑇀𑆓𑆩𑆽𑆡𑆶𑆤𑆳𑆲𑆳𑆫𑆯𑆾𑆣𑆤𑆼 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆶 𑆠𑆤𑇀𑆩𑆤𑆳𑆂 𑇅 𑆤𑆼𑆖𑇀𑆗𑆼𑆢𑇀𑆢𑆾𑆰𑆖𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆂 𑆥𑆵𑆝𑆳𑆁 𑆮𑆳 𑆑𑆳𑆪𑆩𑆳𑆤𑆱𑆵𑆩𑇀 𑇆𑇑𑇑𑇐𑇆
𑆃𑆠𑆴𑆱𑇀𑆠𑇀𑆫𑆵𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆖𑇀𑆖 𑆫𑆑𑇀𑆰𑆼𑆢𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆠𑇀𑆩𑆮𑆳𑆤𑇀 𑇅 𑆯𑆷𑆬𑆑𑆳𑆱𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆑𑇀𑆰𑆪𑆳𑆂 𑇆𑇑𑇑𑇑𑇆
𑆃𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆘𑇀𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆫𑆾𑆓𑆳𑆯𑇀𑆖𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆳𑆢𑆪𑆂 𑇅 𑆄𑆪𑆶𑆰𑇀𑆩𑆤𑇀𑆠𑆾 𑆩𑆤𑇀𑆢𑆘𑆫𑆳 𑆮𑆥𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑆧𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆂 𑇆𑇑𑇑𑇒𑇆
𑆱𑇀𑆡𑆴𑆫𑆾𑆥𑆖𑆴𑆠𑆩𑆳𑆁𑆱𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆱𑆁𑆪𑆠𑆳𑆂 𑇅 𑆠𑇀𑆫𑆴𑆨𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑆲𑆾𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆩𑆵𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆢𑆳𑆁 𑆤𑆫𑆂 𑇆𑇑𑇑𑇓𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶, 𑆔𑆫𑇀𑆩𑆼𑆰𑆶 𑆥𑆑𑇀𑆰𑆳𑆠𑇀 𑆥𑆑𑇀𑆰𑆳𑆢𑇀𑆮𑇀𑆫𑆘𑆼𑆢𑇀𑆧𑆶𑆣𑆂 𑇅 𑆫𑆘𑆱𑇀𑆮𑆬𑆳𑆩𑆑𑆳𑆩𑆳𑆁 𑆖 𑆩𑆬𑆴𑆤𑆳𑆩𑆥𑇀𑆫𑆴𑆪𑆳𑆁 𑆠𑆡𑆳 𑇆𑇑𑇑𑇔𑇆
𑆮𑆫𑇀𑆟𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆮𑆪𑆾𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆠𑆡𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆳𑆩𑇀 𑇅 𑆲𑆵𑆤𑆳𑆕𑇀𑆓𑆵𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆁 𑆢𑇀𑆮𑆼𑆰𑇀𑆪𑆳𑆁 𑆪𑆾𑆤𑆴𑆢𑆾𑆰𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆳𑆩𑇀 𑇆𑇑𑇑𑇕𑇆
𑆱𑆓𑆾𑆠𑇀𑆫𑆳𑆁 𑆓𑆶𑆫𑆶𑆥𑆠𑇀𑆤𑆵𑆁 𑆖 𑆠𑆡𑆳 𑆥𑇀𑆫𑆮𑇀𑆫𑆘𑆴𑆠𑆳𑆩𑆥𑆴 𑇅 𑆱𑆤𑇀𑆣𑇀𑆪𑆳𑆥𑆫𑇀𑆮𑆱𑇀𑆮𑆓𑆩𑇀𑆪𑆳𑆁 𑆖 𑆤𑆾𑆥𑆼𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆢𑆳𑆁 𑆤𑆫𑆂 𑇆𑇑𑇑𑇖𑇆
𑆓𑆾𑆱𑆫𑇀𑆓𑆼 𑆖𑆳𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆼 𑆖 𑆠𑆡𑆳 𑆩𑆣𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆼𑆰𑆶 𑆖 𑇅 𑆬𑆘𑇀𑆘𑆳𑆱𑆩𑆳𑆮𑆲𑆼 𑆢𑆼𑆯𑆼 𑆮𑆴𑆮𑆸𑆠𑆼𑇁𑆯𑆶𑆢𑇀𑆣 𑆍𑆮 𑆖 𑇆𑇑𑇑𑇗𑇆
𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆯𑇀𑆖𑆽𑆮 𑆑𑇀𑆰𑆶𑆧𑇀𑆣𑆖𑆴𑆠𑇀𑆠𑆯𑇀𑆖 𑆩𑆳𑆤𑆮𑆂 𑇅 𑆮𑆳𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆼𑆓𑆵 𑆖 𑆥𑆴𑆥𑆳𑆱𑆶𑆫𑆠𑆴𑆢𑆶𑆫𑇀𑆧𑆬𑆂 𑇆𑇑𑇑𑇘𑇆
𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆳𑆮𑆪𑆾𑆤𑆿 𑆖 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆯𑆶𑆑𑇀𑆫𑆮𑆴𑆣𑆳𑆫𑆟𑆩𑇀 𑇅 𑆢𑆶𑆰𑇀𑆛𑆪𑆾𑆤𑆿 𑆮𑆴𑆱𑆫𑇀𑆓𑆁 𑆠𑆶 𑆧𑆬𑆮𑆳𑆤𑆥𑆴 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇙𑇆
𑆫𑆼𑆠𑆱𑆯𑇀𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆶 𑆩𑆷𑆫𑇀𑆣𑆳𑆮𑆫𑆟𑆩𑆼𑆮 𑆖 𑇅 𑆱𑇀𑆡𑆴𑆠𑆳𑆮𑆶𑆠𑇀𑆠𑆳𑆤𑆯𑆪𑆤𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆽𑆮 𑆓𑆫𑇀𑆲𑆴𑆠𑆩𑇀 𑇆𑇑𑇒𑇐𑇆
𑆑𑇀𑆫𑆵𑆝𑆳𑆪𑆳𑆩𑆥𑆴 𑆩𑆼𑆣𑆳𑆮𑆵 𑆲𑆴𑆠𑆳𑆫𑇀𑆡𑆵 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆫𑆘𑆱𑇀𑆮𑆬𑆳𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆮𑆠𑆾 𑆤𑆫𑆱𑇀𑆪𑆳𑆤𑆴𑆪𑆠𑆳𑆠𑇀𑆩𑆤𑆂 𑇆𑇑𑇒𑇑𑇆
𑆢𑆸𑆰𑇀𑆛𑇀𑆪𑆳𑆪𑆶𑆱𑇀𑆠𑆼𑆘𑆱𑆳𑆁 𑆲𑆳𑆤𑆴𑆫𑆣𑆫𑇀𑆩𑆯𑇀𑆖 𑆠𑆠𑆾 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆬𑆴𑆕𑇀𑆓𑆴𑆤𑆵𑆁 𑆓𑆶𑆫𑆶𑆥𑆠𑇀𑆤𑆵𑆁 𑆖 𑆱𑆓𑆾𑆠𑇀𑆫𑆳𑆩𑆡 𑆥𑆫𑇀𑆮𑆱𑆶 𑇆𑇑𑇒𑇒𑇆
𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆖 𑆱𑆤𑇀𑆣𑇀𑆪𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑆴 𑆓𑆖𑇀𑆗𑆠𑆾 𑆘𑆵𑆮𑆴𑆠𑆑𑇀𑆰𑆪𑆂 𑇅 𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆥𑆵𑆝𑆳 𑆱𑇀𑆪𑆳𑆢𑇀 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆳𑆪𑆳𑆁 𑆧𑆬𑆑𑇀𑆰𑆪𑆂 𑇆𑇑𑇒𑇓𑇆
𑆲𑆵𑆤𑆳𑆕𑇀𑆓𑆵𑆁 𑆩𑆬𑆴𑆤𑆳𑆁 𑆢𑇀𑆮𑆼𑆰𑇀𑆪𑆳𑆁 𑆑𑆳𑆩𑆁 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆩𑆱𑆁𑆮𑆸𑆠𑆼 𑇅 𑆢𑆼𑆯𑆼𑇁𑆯𑆶𑆢𑇀𑆣𑆼 𑆖 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆩𑆤𑆱𑆯𑇀𑆖 𑆑𑇀𑆰𑆪𑆾 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇒𑇔𑇆
𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆂 𑆑𑇀𑆰𑆶𑆧𑇀𑆣𑆖𑆴𑆠𑇀𑆠𑆯𑇀𑆖 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆠𑆸𑆰𑆴𑆠𑆾𑇁𑆧𑆬𑆂 𑇅 𑆱𑇀𑆡𑆴𑆠𑆯𑇀𑆖 𑆲𑆳𑆤𑆴𑆁 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆮𑆳𑆪𑆾𑆂 𑆑𑆾𑆥𑆁 𑆖 𑆮𑆴𑆤𑇀𑆢𑆠𑆴 𑇆𑇑𑇒𑇕𑇆
𑆃𑆠𑆴𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆢𑇀𑆨𑆮𑆠𑆴 𑆯𑆾𑆰𑆂 𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆳𑆮𑆲𑆂 𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆱𑇀𑆪 𑆫𑆶𑆘𑆳 𑆥𑇀𑆬𑆵𑆲𑇀𑆤𑆴 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇒𑇖𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆷𑆰𑆱𑇀𑆪𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆼 𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆂 𑇅 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆳𑆮𑆪𑆾𑆤𑆿 𑆖 𑆢𑆶𑆰𑇀𑆛𑆪𑆾𑆤𑆿 𑆠𑆡𑆽𑆮 𑆖 𑇆𑇑𑇒𑇗𑇆
𑆇𑆠𑇀𑆠𑆳𑆤𑆼 𑆖 𑆨𑆮𑆼𑆖𑇀𑆗𑆵𑆣𑇀𑆫𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆱𑆩𑇀𑆨𑆮𑆂 𑇅 𑆱𑆫𑇀𑆮𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆬𑇀𑆬𑆾𑆑𑆢𑇀𑆮𑆪𑆼𑇁𑆲𑆴𑆠𑆩𑇀 𑇆𑇑𑇒𑇙𑇆
𑆯𑆶𑆑𑇀𑆫𑆁 𑆖𑆾𑆥𑆱𑇀𑆡𑆴𑆠𑆁 𑆩𑆾𑆲𑆳𑆤𑇀𑆤 𑆱𑆤𑇀𑆣𑆳𑆫𑇀𑆪𑆁 𑆑𑆡𑆚𑇀𑆖𑆤 𑇅𑇑𑇓𑇐𑇅 𑆮𑆪𑆾𑆫𑆷𑆥𑆓𑆶𑆟𑆾𑆥𑆼𑆠𑆳𑆁 𑆠𑆶𑆬𑇀𑆪𑆯𑆵𑆬𑆳𑆁 𑆑𑆶𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆩𑇀 𑇆𑇑𑇓𑇐𑇆

𑆃𑆤𑇀𑆤𑆱𑇀𑆪 𑆫𑆑𑇀𑆰𑆳 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑇀𑆡𑆳𑆮𑆫𑆱𑇀𑆪𑆼𑆠𑆫𑆱𑇀𑆪 𑆖 𑇅 𑆱𑆫𑇀𑆥𑆢𑆰𑇀𑆛𑆮𑆴𑆰𑆘𑇀𑆚𑆳𑆤𑆁 𑆠𑆱𑇀𑆪𑆽𑆮 𑆖 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇆𑇒𑇗𑇆
𑆢𑆶𑆤𑇀𑆢𑆶𑆨𑆼𑆫𑇀𑆩𑆷𑆰𑆴𑆑𑆳𑆟𑆳𑆁 𑆖 𑆑𑆵𑆛𑆳𑆤𑆳𑆁 𑆑𑆬𑇀𑆥 𑆍𑆮 𑆖 𑇅 𑆃𑆰𑇀𑆛𑆿 𑆑𑆬𑇀𑆥𑆳𑆂 𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆮𑆴𑆰𑆨𑆼𑆰𑆘𑆑𑆬𑇀𑆥𑆤𑆳𑆠𑇀 𑇆𑇒𑇘𑇆
𑆃𑆣𑇀𑆪𑆳𑆪𑆳𑆤𑆳𑆁 𑆯𑆠𑆁 𑆮𑆴𑆁𑆯𑆩𑆼𑆮𑆩𑆼𑆠𑆢𑆶𑆢𑆵𑆫𑆴𑆠𑆩𑇀 𑇅 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆱𑇀𑆮𑆤𑆳𑆩𑇀𑆤𑆽𑆮 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆶𑆠𑇀𑆠𑆫𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇙𑇆
𑆃𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆑𑆸𑆠𑆁 𑆪𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆼𑆠𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑇅 𑆐𑆥𑆢𑇀𑆫𑆮𑆴𑆑 𑆅𑆠𑇀𑆪𑆼𑆰 𑆠𑆱𑇀𑆪𑆳𑆓𑇀𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇐𑇆
𑆱𑆤𑇀𑆣𑆿 𑆮𑆫𑇀𑆠𑇀𑆩𑆤𑆴 𑆯𑆶𑆑𑇀𑆬𑆼 𑆖 𑆑𑆸𑆰𑇀𑆟𑆼 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆢𑆸𑆰𑇀𑆛𑆴𑆰𑆶 𑇅 𑆱𑆁𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆣𑇀𑆪𑆳𑆪𑆳 𑆓𑆢𑆳𑆤𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆠𑆴 𑆥𑇀𑆫𑆠𑆴 𑇆𑇓𑇑𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆵𑆪𑆾 𑆮𑆳𑆠𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆮𑆳𑆫𑆟𑆂 𑇅 𑆥𑆽𑆠𑇀𑆠𑆱𑇀𑆪 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆱𑇀𑆪𑆳𑆥𑆴 𑆫𑆿𑆣𑆴𑆫𑆱𑇀𑆪 𑆠𑆡𑆽𑆮 𑆖 𑇆𑇓𑇒𑇆
𑆬𑆼𑆒𑇀𑆪𑆨𑆼𑆢𑇀𑆪𑆤𑆴𑆰𑆼𑆣𑆿 𑆖 𑆗𑆼𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑆫𑇀𑆠𑇀𑆩𑆢𑆸𑆰𑇀𑆛𑆴𑆰𑆶 𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑆬𑇀𑆥𑆾𑇁𑆨𑆴𑆔𑆳𑆠𑆯𑇀𑆖 𑆑𑆫𑇀𑆟𑆾𑆠𑇀𑆡𑆳𑆱𑇀𑆠𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇆𑇓𑇓𑇆
𑆔𑇀𑆫𑆳𑆟𑆾𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆖 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆠𑆢𑇀𑆓𑆢𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆤𑆩𑇀 𑇅 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆤𑆴𑆰𑆼𑆣𑆯𑇀𑆖 𑆯𑆴𑆫𑆾𑆓𑆢𑆮𑆴𑆮𑆼𑆖𑆤𑆩𑇀 𑇆𑇓𑇔𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆠𑆢𑇀𑆓𑆢𑆳𑆤𑆳𑆁 𑆖 𑆯𑆳𑆬𑆳𑆑𑇀𑆪𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆤𑆮𑆓𑇀𑆫𑆲𑆳𑆑𑆸𑆠𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑇀𑆑𑆤𑇀𑆢𑆱𑇀𑆪 𑆖 𑆤𑆴𑆰𑆼𑆣𑆤𑆩𑇀 𑇆𑇓𑇕𑇆
𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆯𑆑𑆶𑆤𑇀𑆪𑆾𑆯𑇀𑆖 𑆫𑆼𑆮𑆠𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑆶𑆤𑆂 𑆥𑆸𑆡𑆑𑇀 𑇅 𑆥𑆷𑆠𑆤𑆳𑆪𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆤𑇀𑆣𑆳𑆪𑆳𑆂 𑆯𑆵𑆠𑆥𑆷𑆠𑆤𑆩𑆟𑇀𑆝𑆴𑆑𑆳 𑇆𑇓𑇖𑇆
𑆤𑆽𑆓𑆩𑆼𑆰𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆖 𑆓𑇀𑆫𑆲𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆱𑆪𑆾𑆤𑆴𑆘𑆳 𑇅 𑆑𑆶𑆩𑆳𑆫𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆖𑇀𑆗𑆳𑆫𑆵𑆫𑆼𑆰𑆶 𑆖 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇓𑇗𑇆
𑆘𑇀𑆮𑆫𑆳𑆠𑆴𑆱𑆳𑆫𑆯𑆾𑆰𑆳𑆟𑆳𑆁 𑆓𑆶𑆬𑇀𑆩𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆴𑆟𑆳𑆩𑆥𑆴 𑇅 𑆥𑆳𑆟𑇀𑆝𑆷𑆤𑆳𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆳𑆂 𑆥𑆳𑆤𑆘𑆳𑆯𑇀𑆖 𑆪𑆼 𑇆𑇓𑇘𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆪𑆳𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆲𑆴𑆑𑇀𑆑𑆳𑆤𑆳𑆁 𑆤𑆴𑆰𑆼𑆣𑆂 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆪𑆾𑆂 𑇅 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆖 𑆑𑆸𑆩𑇀𑆪𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆴𑆤𑆾𑆂 𑆥𑆸𑆡𑆑𑇀 𑇆𑇓𑇙𑇆
𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆫𑆾𑆖𑆑𑆪𑆾𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆮𑆴𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆪𑆾𑆂 𑇅 𑆅𑆠𑆴 𑆑𑆳𑆪𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆪𑆳𑆂 𑆯𑆼𑆰𑆩𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇆𑇔𑇐𑇆
𑆃𑆩𑆳𑆤𑆶𑆰𑆤𑆴𑆰𑆼𑆣𑆯𑇀𑆖 𑆠𑆡𑆳𑇁𑇁𑆥𑆱𑇀𑆩𑆳𑆫𑆴𑆑𑆾𑇁𑆥𑆫𑆂 𑇅 𑆇𑆤𑇀𑆩𑆳𑆢𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆯𑇀𑆖 𑆨𑆷𑆠𑆮𑆴𑆢𑇀𑆪𑆳 𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇔𑇑𑇆
𑆫𑆱𑆨𑆼𑆢𑆳𑆂 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆪𑆱𑇀𑆠𑆳𑆤𑇀𑆠𑇀𑆫𑆴𑆑𑆳𑆯𑇀𑆖 𑆪𑆳𑆂 𑇅 𑆢𑆾𑆰𑆨𑆼𑆢𑆳 𑆅𑆠𑆴 𑆘𑇀𑆚𑆼𑆪𑆳 𑆃𑆣𑇀𑆪𑆳𑆪𑆳𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆨𑆷𑆰𑆟𑆳𑆂 𑇆𑇔𑇒𑇆
𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆠𑇀𑆮𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆁 𑆲𑇀𑆪𑆼𑆠𑆠𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆳𑆲𑆶𑆫𑇀𑆩𑆲𑆫𑇀𑆰𑆪𑆂 𑇅 𑆧𑆲𑇀𑆮𑆫𑇀𑆡𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆳𑆖𑇀𑆗𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆶𑆠𑇀𑆠𑆫𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆯𑇀𑆖𑆴𑆩𑆩𑇀 𑇆𑇔𑇓𑇆
𑆯𑆳𑆬𑆳𑆑𑇀𑆪𑆠𑆤𑇀𑆠𑇀𑆫𑆁 𑆑𑆿𑆩𑆳𑆫𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆑𑆳𑆪𑆴𑆑𑆵 𑆖 𑆪𑆳 𑇅 𑆨𑆷𑆠𑆮𑆴𑆢𑇀𑆪𑆼𑆠𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆠𑆤𑇀𑆠𑇀𑆫𑆼 𑆠𑆷𑆠𑇀𑆠𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆼 𑇆𑇔𑇔𑇆
𑆮𑆳𑆘𑆵𑆑𑆫𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆱𑆶 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆡𑆳 𑇅 𑆮𑆴𑆰𑆠𑆤𑇀𑆠𑇀𑆫𑆁 𑆥𑆶𑆤𑆂 𑆑𑆬𑇀𑆥𑆳𑆂 𑆯𑆬𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑇆𑇔𑇕𑇆
𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆩𑆴𑆢𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆩𑆳𑆢𑆴𑆢𑆼𑆮𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀 𑇅 𑆮𑆴𑆣𑆴𑆤𑆳𑇁𑆣𑆵𑆠𑇀𑆪 𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆳𑆟𑆢𑆳 𑆨𑆶𑆮𑆴 𑇆𑇔𑇖𑇆
𑆍𑆠𑆢𑇀𑆣𑇀𑆪𑆮𑆯𑇀𑆪𑆩𑆣𑇀𑆪𑆼𑆪𑆩𑇀, 𑆃𑆣𑆵𑆠𑇀𑆪 𑆖 𑆑𑆫𑇀𑆩𑆳𑆥𑇀𑆪𑆮𑆯𑇀𑆪𑆩𑆶𑆥𑆳𑆱𑆴𑆠𑆮𑇀𑆪𑆩𑇀, 𑆇𑆨𑆪𑆘𑇀𑆚𑆾 𑆲𑆴 𑆨𑆴𑆰𑆓𑇀 𑆫𑆳𑆘𑆳𑆫𑇀𑆲𑆾 𑆨𑆮𑆠𑆴 𑇆𑇔𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆱𑇀𑆠𑆶 𑆑𑆼𑆮𑆬𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆘𑇀𑆚𑆂 𑆑𑆫𑇀𑆩𑆱𑇀𑆮𑆥𑆫𑆴𑆤𑆴𑆰𑇀𑆜𑆴𑆠𑆂 𑇅 𑆱 𑆩𑆶𑆲𑇀𑆪𑆠𑇀𑆪𑆳𑆠𑆶𑆫𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆨𑆵𑆫𑆶𑆫𑆴𑆮𑆳𑆲𑆮𑆩𑇀 𑇆𑇔𑇘𑇆
𑆪𑆱𑇀𑆠𑆶 𑆑𑆫𑇀𑆩𑆱𑆶 𑆤𑆴𑆰𑇀𑆟𑆳𑆠𑆾 𑆣𑆳𑆫𑇀𑆰𑇀𑆛𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆧𑆲𑆴𑆰𑇀𑆑𑆸𑆠𑆂 𑇅 𑆱 𑆱𑆠𑇀𑆱𑆶 𑆥𑆷𑆘𑆳𑆁 𑆤𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆮𑆣𑆁 𑆖𑆫𑇀𑆖𑇀𑆗𑆠𑆴 𑆫𑆳𑆘𑆠𑆂 𑇆𑇔𑇙𑇆
𑆇𑆨𑆳𑆮𑆼𑆠𑆳𑆮𑆤𑆴𑆥𑆶𑆟𑆳𑆮𑆱𑆩𑆫𑇀𑆡𑆿 𑆱𑇀𑆮𑆑𑆫𑇀𑆩𑆟𑆴 𑇅 𑆃𑆫𑇀𑆣𑆮𑆼𑆢𑆣𑆫𑆳𑆮𑆼𑆠𑆳𑆮𑆼𑆑𑆥𑆑𑇀𑆰𑆳𑆮𑆴𑆮 𑆢𑇀𑆮𑆴𑆘𑆿 𑇆𑇕𑇐𑇆
𑆏𑆰𑆣𑇀𑆪𑆾𑇁𑆩𑆸𑆠𑆑𑆬𑇀𑆥𑆳𑆱𑇀𑆠𑆶 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆯𑆤𑆴𑆮𑆴𑆰𑆾𑆥𑆩𑆳𑆂 𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆘𑇀𑆚𑆽𑆫𑆶𑆥𑆲𑆸𑆠𑆳𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆳𑆤𑇀 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇕𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆰𑇀𑆮𑆤𑆨𑆴𑆘𑇀𑆚𑆾 𑆪𑆯𑇀𑆗𑆼𑆢𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆖 𑆑𑆫𑇀𑆩𑆱𑆶 𑇅 𑆱 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆘𑆤𑆁 𑆬𑆾𑆨𑆳𑆠𑇀 𑆑𑆶𑆮𑆽𑆢𑇀𑆪𑆾 𑆤𑆸𑆥𑆢𑆾𑆰𑆠𑆂 𑇆𑇕𑇒𑇆
𑆪𑆱𑇀𑆠𑆷𑆨𑆪𑆘𑇀𑆚𑆾 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆱 𑆱𑆩𑆫𑇀𑆡𑆾𑇁𑆫𑇀𑆡𑆱𑆳𑆣𑆤𑆼 𑇅 𑆄𑆲𑆮𑆼 𑆑𑆫𑇀𑆩 𑆤𑆴𑆫𑇀𑆮𑆾𑆞𑆶𑆁 𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆫𑆂 𑆱𑇀𑆪𑆤𑇀𑆢𑆤𑆾 𑆪𑆡𑆳 𑇆𑇕𑇓𑇆
𑆃𑆡 𑆮𑆠𑇀𑆱! 𑆠𑆢𑆼𑆠𑆢𑆣𑇀𑆪𑆼𑆪𑆁 𑆪𑆡𑆳 𑆠𑆡𑆾𑆥𑆣𑆳𑆫𑆪 𑆩𑆪𑆳 𑆥𑇀𑆫𑆾𑆖𑇀𑆪𑆩𑆳𑆤𑆁- 𑆃𑆡 𑆯𑆶𑆖𑆪𑆼 𑆑𑆸𑆠𑆾𑆠𑇀𑆠𑆫𑆳𑆱𑆕𑇀𑆓𑆳𑆪𑆳𑆮𑇀𑆪𑆳𑆑𑆶𑆬𑆳𑆪𑆾𑆥𑆱𑇀𑆡𑆴𑆠𑆳𑆪𑆳𑆣𑇀𑆪𑆪𑆤𑆑𑆳𑆬𑆼 𑆯𑆴𑆰𑇀𑆪𑆳𑆪 𑆪𑆡𑆳𑆯𑆑𑇀𑆠𑆴 𑆓𑆶𑆫𑆶𑆫𑆶𑆥𑆢𑆴𑆯𑆼𑆠𑇀 𑆥𑆢𑆁 𑆥𑆳𑆢𑆁 𑆯𑇀𑆬𑆾𑆑𑆁 𑆮𑆳; 𑆠𑆼 𑆖 𑆥𑆢𑆥𑆳𑆢𑆯𑇀𑆬𑆾𑆑𑆳 𑆨𑆷𑆪𑆂 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆤𑆶𑆱𑆤𑇀𑆣𑆼𑆪𑆳𑆂, 𑆍𑆮𑆩𑆼𑆑𑆽𑆑𑆯𑆾 𑆔𑆛𑆪𑆼𑆢𑆳𑆠𑇀𑆩𑆤𑆳 𑆖𑆳𑆤𑆶𑆥𑆜𑆼𑆠𑇀; 𑆃𑆢𑇀𑆫𑆶𑆠𑆩𑆮𑆴𑆬𑆩𑇀𑆧𑆴𑆠𑆩𑆮𑆴𑆯𑆕𑇀𑆑𑆴𑆠𑆩𑆤𑆤𑆶𑆤𑆳𑆱𑆴𑆑𑆁 𑆱𑆶𑆮𑇀𑆪𑆑𑇀𑆠𑆳𑆑𑇀𑆰𑆫𑆩𑆥𑆵𑆝𑆴𑆠𑆮𑆫𑇀𑆟𑆩𑆑𑇀𑆰𑆴𑆨𑇀𑆫𑆶𑆮𑆿𑆰𑇀𑆜𑆲𑆱𑇀𑆠𑆽𑆫𑆤𑆨𑆴𑆤𑆵𑆠𑆁 𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆁 𑆤𑆳𑆠𑇀𑆪𑆶𑆖𑇀𑆖𑆽𑆫𑇀𑆤𑆳𑆠𑆴𑆤𑆵𑆖𑆽𑆯𑇀𑆖 𑆱𑇀𑆮𑆫𑆽𑆂 𑆥𑆜𑆼𑆠𑇀 𑇅 𑆤 𑆖𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆮𑇀𑆫𑆘𑆼𑆠𑇀 𑆠𑆪𑆾𑆫𑆣𑆵𑆪𑆳𑆤𑆪𑆾𑆂 𑇆𑇕𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑇅 𑆯𑆶𑆖𑆴𑆫𑇀𑆓𑆶𑆫𑆶𑆥𑆫𑆾 𑆢𑆑𑇀𑆰𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆤𑆴𑆢𑇀𑆫𑆳𑆮𑆴𑆮𑆫𑇀𑆘𑆴𑆠𑆂 𑇅 𑆥𑆜𑆤𑇀𑆤𑆼𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆯𑆴𑆰𑇀𑆪𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑆩𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀 𑇆𑇕𑇕𑇆
𑆮𑆳𑆑𑇀𑆱𑆿𑆰𑇀𑆜𑆮𑆼𑇁𑆫𑇀𑆡𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆥𑇀𑆫𑆳𑆓𑆬𑇀𑆨𑇀𑆪𑆼 𑆑𑆫𑇀𑆩𑆤𑆽𑆥𑆶𑆟𑆼 𑇅 𑆠𑆢𑆨𑇀𑆪𑆳𑆱𑆼 𑆖 𑆱𑆴𑆢𑇀𑆣𑆿 𑆖 𑆪𑆠𑆼𑆠𑆳𑆣𑇀𑆪𑆪𑆤𑆳𑆤𑇀𑆠𑆓𑆂 𑇆𑇕𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆨𑆳𑆰𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆣𑆴𑆓𑆠𑆩𑆥𑇀𑆪𑆣𑇀𑆪𑆪𑆤𑆩𑆥𑇀𑆫𑆨𑆳𑆰𑆴𑆠𑆩𑆫𑇀𑆡𑆠𑆂 𑆒𑆫𑆱𑇀𑆪 𑆖𑆤𑇀𑆢𑆤𑆨𑆳𑆫 𑆅𑆮 𑆑𑆼𑆮𑆬𑆁 𑆥𑆫𑆴𑆯𑇀𑆫𑆩𑆑𑆫𑆁 𑆨𑆮𑆠𑆴 𑇆𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳 𑆒𑆫𑆯𑇀𑆖𑆤𑇀𑆢𑆤𑆨𑆳𑆫𑆮𑆳𑆲𑆵 𑆨𑆳𑆫𑆱𑇀𑆪 𑆮𑆼𑆠𑇀𑆠𑆳 𑆤 𑆠𑆶 𑆖𑆤𑇀𑆢𑆤𑆱𑇀𑆪 𑇅 𑆍𑆮𑆁 𑆲𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆧𑆲𑆷𑆤𑇀𑆪𑆣𑆵𑆠𑇀𑆪 𑆖𑆳𑆫𑇀𑆡𑆼𑆰𑆶 𑆩𑆷𑆞𑆳𑆂 𑆒𑆫𑆮𑆢𑇀𑆮𑆲𑆤𑇀𑆠𑆴 𑇆𑇔𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆮𑆴𑆁𑆯𑆩𑆣𑇀𑆪𑆳𑆪𑆯𑆠𑆩𑆤𑆶𑆥𑆢𑆥𑆳𑆢𑆯𑇀𑆬𑆾𑆑𑆩𑆤𑆶𑆮𑆫𑇀𑆟𑆪𑆴𑆠𑆮𑇀𑆪𑆩𑆤𑆶𑆯𑇀𑆫𑆾𑆠𑆮𑇀𑆪𑆁 𑆖; 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆯𑆪𑆩𑆫𑇀𑆩𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆓𑆫𑇀𑆨𑆱𑆩𑇀𑆨𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑆷𑆲𑆮𑆴𑆨𑆳𑆓𑆳𑆱𑇀𑆠𑆡𑆳 𑆥𑇀𑆫𑆤𑆰𑇀𑆛𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆮𑇀𑆫𑆟𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆨𑆓𑇀𑆤𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆪𑆳𑆥𑇀𑆪𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆠𑆳 𑆖 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆼𑆮𑆩𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆼 𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆱𑆲𑆱𑇀𑆫𑆯𑆾 𑆪𑆼 𑆮𑆴𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆩𑆳𑆤𑆳 𑆮𑆴𑆩𑆬𑆮𑆴𑆥𑆶𑆬𑆧𑆶𑆢𑇀𑆣𑆼𑆫𑆥𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆑𑆶𑆬𑆵𑆑𑆶𑆫𑇀𑆪𑆶𑆂 𑆑𑆴𑆁 𑆥𑆶𑆤𑆫𑆬𑇀𑆥𑆧𑆶𑆢𑇀𑆣𑆼𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆮𑆯𑇀𑆪𑆩𑆤𑆶𑆥𑆢𑆥𑆳𑆢𑆯𑇀𑆬𑆾𑆑𑆩𑆤𑆶𑆮𑆫𑇀𑆟𑆪𑆴𑆠𑆮𑇀𑆪𑆩𑆤𑆶𑆯𑇀𑆫𑆾𑆠𑆮𑇀𑆪𑆁 𑆖 𑇆𑇕𑇆
𑆃𑆤𑇀𑆪𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆾𑆥𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆁 𑆖𑆳𑆫𑇀𑆡𑆳𑆤𑆳𑆩𑆴𑆲𑆾𑆥𑆤𑆵𑆠𑆳𑆤𑆳𑆩𑆫𑇀𑆡𑆮𑆯𑆳𑆠𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆼𑆨𑇀𑆪 𑆍𑆮 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆤𑆩𑆤𑆶𑆯𑇀𑆫𑆾𑆠𑆮𑇀𑆪𑆁, 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆤 𑆲𑇀𑆪𑆼𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆯𑆑𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆮𑆫𑆾𑆣𑆂 𑆑𑆫𑇀𑆠𑆶𑆩𑇀 𑇆𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆍𑆑𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆣𑆵𑆪𑆳𑆤𑆾 𑆤 𑆮𑆴𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆤𑆴𑆯𑇀𑆖𑆪𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆧𑆲𑆶𑆯𑇀𑆫𑆶𑆠𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆁 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆂 𑇆𑇗𑇆
𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆁 𑆓𑆶𑆫𑆶𑆩𑆶𑆒𑆾𑆢𑇀𑆓𑆵𑆫𑇀𑆟𑆩𑆳𑆢𑆳𑆪𑆾𑆥𑆳𑆱𑇀𑆪 𑆖𑆳𑆱𑆑𑆸𑆠𑇀 𑇅 𑆪𑆂 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑆶𑆠𑆼 𑆮𑆽𑆢𑇀𑆪𑆂 𑆱 𑆮𑆽𑆢𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆼 𑆠𑆶 𑆠𑆱𑇀𑆑𑆫𑆳𑆂 𑇆𑇘𑇆
𑆐𑆥𑆣𑆼𑆤𑆮𑆩𑆿𑆫𑆨𑇀𑆫𑆁 𑆱𑆿𑆯𑇀𑆫𑆶𑆠𑆁 𑆥𑆿𑆰𑇀𑆑𑆬𑆳𑆮𑆠𑆩𑇀 𑇅 𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆯𑆬𑇀𑆪𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇙𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆓𑇀𑆫𑆾𑆥𑆲𑆫𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩- 𑆥𑆷𑆫𑇀𑆮𑆑𑆫𑇀𑆩, 𑆥𑇀𑆫𑆣𑆳𑆤𑆑𑆫𑇀𑆩, 𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆑𑆫𑇀𑆩𑆼𑆠𑆴; 𑆠𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇓𑇆
𑆃𑆱𑇀𑆪 𑆠𑆶 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆳𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆽𑆮 𑆠𑆳𑆮𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆱𑇀𑆠𑆠𑇀𑆱𑆩𑇀𑆨𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑇆𑇔𑇆
𑆠𑆖𑇀𑆖 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑇁𑆰𑇀𑆛𑆮𑆴𑆣𑆁; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆗𑆼𑆢𑇀𑆪𑆁, 𑆨𑆼𑆢𑇀𑆪𑆁, 𑆬𑆼𑆒𑇀𑆪𑆁, 𑆮𑆼𑆣𑇀𑆪𑆩𑇀, 𑆍𑆰𑇀𑆪𑆩𑇀, 𑆄𑆲𑆳𑆫𑇀𑆪𑆁, 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁, 𑆱𑆵𑆮𑇀𑆪𑆩𑆴𑆠𑆴 𑇆𑇕𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆁 𑆑𑆫𑇀𑆩 𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆠𑆳 𑆮𑆽𑆢𑇀𑆪𑆼𑆤 𑆥𑆷𑆫𑇀𑆮𑆩𑆼𑆮𑆾𑆥𑆑𑆬𑇀𑆥𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆪𑆤𑇀𑆠𑇀𑆫𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆯𑆬𑆳𑆑𑆳𑆯𑆸𑆕𑇀𑆓𑆘𑆬𑆿𑆑𑆳𑆬𑆳𑆧𑆷𑆘𑆳𑆩𑇀𑆧𑆮𑆿𑆰𑇀𑆜𑆥𑆴𑆖𑆶𑆥𑇀𑆫𑆾𑆠𑆱𑆷𑆠𑇀𑆫𑆥𑆠𑇀𑆫𑆥𑆛𑇀𑆛𑆩𑆣𑆶𑆔𑆸𑆠𑆮𑆱𑆳𑆥𑆪𑆱𑇀𑆠𑆽𑆬- 𑆠𑆫𑇀𑆥𑆟𑆑𑆰𑆳𑆪𑆳𑆬𑆼𑆥𑆤𑆑𑆬𑇀𑆑𑆮𑇀𑆪𑆘𑆤𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆑𑆛𑆳𑆲𑆳𑆢𑆵𑆤𑆴, 𑆥𑆫𑆴𑆑𑆫𑇀𑆩𑆴𑆟𑆯𑇀𑆖 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆂 𑆱𑇀𑆡𑆴𑆫𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆂 𑇆𑇖𑇆
𑆠𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼𑆰𑆶 𑆠𑆴𑆡𑆴𑆑𑆫𑆟𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆰𑆶 𑆢𑆣𑇀𑆪𑆑𑇀𑆰𑆠𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆫𑆠𑇀𑆤𑆽𑆫𑆓𑇀𑆤𑆴𑆁 𑆮𑆴𑆥𑇀𑆫𑆳𑆤𑇀 𑆨𑆴𑆰𑆘𑆯𑇀𑆖𑆳𑆫𑇀𑆖𑆪𑆴𑆠𑇀𑆮𑆳, 𑆑𑆸𑆠𑆧𑆬𑆴𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆁 𑆬𑆔𑆶𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆁 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆶𑆒𑆩𑆳𑆠𑆶𑆫𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 , 𑆪𑆤𑇀𑆠𑇀𑆫𑆪𑆴𑆠𑇀𑆮𑆳 , 𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆩𑆶𑆒𑆾 𑆮𑆽𑆢𑇀𑆪𑆾 𑆩𑆫𑇀𑆩𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆣𑆩𑆤𑆵𑆂 𑆥𑆫𑆴𑆲𑆫𑆤𑇀, 𑆃𑆤𑆶𑆬𑆾𑆩𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑆳𑆥𑆷𑆪𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀 , 𑆱𑆑𑆸𑆢𑆼𑆮𑆳𑆥𑆲𑆫𑆼𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆩𑆳𑆯𑆶 𑆖; 𑆩𑆲𑆠𑇀𑆱𑇀𑆮𑆥𑆴 𑆖 𑆥𑆳𑆑𑆼𑆰𑆶 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑇀𑆠𑆫𑆁 𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑇀𑆠𑆫𑆁 𑆮𑆳 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑆢𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫𑆳𑆪𑆠𑆾 𑆮𑆴𑆯𑆳𑆬𑆂 𑆱𑆩𑆂 𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆾 𑆤𑆴𑆫𑆳𑆯𑇀𑆫𑆪 𑆅𑆠𑆴 𑆮𑇀𑆫𑆟𑆓𑆶𑆟𑆳𑆂 𑇆𑇘𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆄𑆪𑆠𑆯𑇀𑆖 𑆮𑆴𑆯𑆳𑆬𑆯𑇀𑆖 𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆾 𑆤𑆴𑆫𑆳𑆯𑇀𑆫𑆪𑆂 𑇅 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆬𑆑𑆸𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆮𑇀𑆫𑆟𑆂 𑆑𑆫𑇀𑆩𑆟𑆴 𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇙𑇆
𑆯𑆿𑆫𑇀𑆪𑆩𑆳𑆯𑆶𑆑𑇀𑆫𑆴𑆪𑆳 𑆯𑆱𑇀𑆠𑇀𑆫𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆩𑆱𑇀𑆮𑆼𑆢𑆮𑆼𑆥𑆡𑆶 𑇅 𑆃𑆱𑆩𑇀𑆩𑆾𑆲𑆯𑇀𑆖 𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆪 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆟𑆴 𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇑𑇐𑇆
𑆍𑆑𑆼𑆤 𑆮𑆳 𑆮𑇀𑆫𑆟𑆼𑆤𑆳𑆯𑆶𑆣𑇀𑆪𑆩𑆳𑆤𑆼 𑆤𑆳𑇁𑆤𑇀𑆠𑆫𑆳 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳𑇁𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆥𑆫𑆳𑆤𑇀 𑆮𑇀𑆫𑆟𑆳𑆤𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇑𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆠𑆾 𑆪𑆠𑆾 𑆓𑆠𑆴𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆱𑆕𑇀𑆓𑆾 𑆪𑆠𑇀𑆫 𑆪𑆠𑇀𑆫 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫 𑆮𑇀𑆫𑆟𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆳 𑆢𑆾𑆰𑆾 𑆤 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆨𑇀𑆫𑆷𑆓𑆟𑇀𑆝𑆯𑆕𑇀𑆒𑆬𑆬𑆳𑆛𑆳𑆑𑇀𑆰𑆴𑆥𑆶𑆛𑆿𑆰𑇀𑆜𑆢𑆤𑇀𑆠𑆮𑆼𑆰𑇀𑆛𑆑𑆑𑇀𑆰𑆳𑆑𑆶𑆑𑇀𑆰𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼𑆰𑆶 𑆠𑆴𑆫𑇀𑆪𑆑𑇀 𑆗𑆼𑆢 𑆇𑆑𑇀𑆠𑆂 𑇆𑇑𑇓𑇆
(𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆟𑇀𑆝𑆬𑆮𑆖𑇀𑆗𑆼𑆢𑆳𑆤𑇀 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆼𑆰𑆶 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆃𑆫𑇀𑆣𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆑𑆸𑆠𑆵𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆓𑆶𑆢𑆼 𑆩𑆼𑆞𑇀𑆫𑆼 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀) 𑇆𑇑𑇔𑇆
𑆃𑆤𑇀𑆪𑆡𑆳 𑆠𑆶 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆖𑇀𑆗𑆼𑆢𑆤𑆩𑇀, 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑆼𑆢𑆤𑆳, 𑆖𑆴𑆫𑆳𑆢𑇀𑆮𑇀𑆫𑆟𑆱𑆁𑆫𑆾𑆲𑆾, 𑆩𑆳𑆁𑆱𑆑𑆤𑇀𑆢𑆵𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇕𑇆
𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆾𑇁𑆯𑇀𑆩𑆫𑆵𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑆶𑆒𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆂 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇑𑇖𑇆
𑆠𑆠𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆮𑆖𑆳𑆫𑇀𑆪,𑆯𑆵𑆠𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆫𑆳𑆠𑆶𑆫𑆩𑆳𑆯𑇀𑆮𑆳𑆱𑇀𑆪, 𑆱𑆩𑆤𑇀𑆠𑆳𑆠𑇀 𑆥𑆫𑆴𑆥𑆵𑆝𑇀𑆪𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳, 𑆮𑇀𑆫𑆟𑆩𑆨𑆴𑆩𑆸𑆢𑇀𑆪(𑆘𑇀𑆪), 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆥𑇀𑆫𑆾𑆠𑆼𑆤𑆾𑆢𑆑𑆩𑆳𑆢𑆳𑆪 , 𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆂𑆥𑇀𑆫𑆓𑆳𑆞𑆳𑆩𑆿𑆰𑆣𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆤𑆳𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆁 𑆤𑆳𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆳𑆁 𑆮𑆫𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆟𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀; 𑆠𑆠𑆂 𑆑𑆬𑇀𑆑𑆼𑆤𑆳𑆖𑇀𑆗𑆳𑆢𑇀𑆪, 𑆔𑆤𑆳𑆁 𑆑𑆮𑆬𑆴𑆑𑆳𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳, 𑆮𑆱𑇀𑆠𑇀𑆫𑆥𑆛𑇀𑆛𑆼𑆤 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀; 𑆮𑆼𑆢𑆤𑆳𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆽𑆫𑇀𑆣𑆷𑆥𑆽𑆫𑇀𑆣𑆷𑆥𑆪𑆼𑆠𑇀, 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆽𑆯𑇀𑆖 𑆩𑆤𑇀𑆠𑇀𑆫𑆽 𑆫𑆑𑇀𑆰𑆳𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇑𑇗𑇆
𑆠𑆠𑆾 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑇀𑆮𑆓𑆶𑆫𑆶𑆱𑆫𑇀𑆘𑆫𑆱𑆮𑆖𑆳𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑇀𑆬𑆮𑆟𑆤𑆴𑆩𑇀𑆧𑆥𑆠𑇀𑆫𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑆳𑆘𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆣𑆷𑆥𑆪𑆼𑆠𑇀 𑇅 𑆄𑆘𑇀𑆪𑆯𑆼𑆰𑆼𑆟 𑆖𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀 𑆱𑆩𑆳𑆬𑆨𑆼𑆠 𑇆𑇑𑇘𑇆
𑆇𑆢𑆑𑆶𑆩𑇀𑆨𑆳𑆖𑇀𑆖𑆳𑆥𑆾 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆾𑆑𑇀𑆰𑆪𑆤𑇀 𑆫𑆑𑇀𑆰𑆳𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀; 𑆠𑆢𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑇆𑇑𑇙𑇆
𑆑𑆸𑆠𑇀𑆪𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆔𑆳𑆠𑆳𑆫𑇀𑆡𑆁 𑆠𑆡𑆳 𑆫𑆑𑇀𑆰𑆾𑆨𑆪𑆱𑇀𑆪 𑆖 𑇅 𑆫𑆑𑇀𑆰𑆳𑆑𑆫𑇀𑆩 𑆑𑆫𑆴𑆰𑇀𑆪𑆳𑆩𑆴 𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆠𑆢𑆤𑆶𑆩𑆤𑇀𑆪𑆠𑆳𑆩𑇀 𑇆𑇒𑇐𑇆
𑆤𑆳𑆓𑆳𑆂 𑆥𑆴𑆯𑆳𑆖𑆳 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆳𑆂 𑆥𑆴𑆠𑆫𑆾 𑆪𑆑𑇀𑆰𑆫𑆳𑆑𑇀𑆰𑆱𑆳𑆂 𑇅 𑆃𑆨𑆴𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆴 𑆪𑆼 𑆪𑆼 𑆠𑇀𑆮𑆳𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆢𑇀𑆪𑆳 𑆔𑇀𑆤𑆤𑇀𑆠𑆶 𑆠𑆳𑆤𑇀 𑆱𑆢𑆳 𑇆𑇒𑇑𑇆
𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆩𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆼 𑆖 𑆪𑆼 𑆖𑆫𑆤𑇀𑆠𑆴 𑆤𑆴𑆯𑆳𑆖𑆫𑆳𑆂 𑇅 𑆢𑆴𑆑𑇀𑆰𑆶 𑆮𑆳𑆱𑇀𑆠𑆶𑆤𑆴𑆮𑆳𑆱𑆳𑆯𑇀𑆖 𑆥𑆳𑆤𑇀𑆠𑆶 𑆠𑇀𑆮𑆳𑆁 𑆠𑆼 𑆤𑆩𑆱𑇀𑆑𑆸𑆠𑆳𑆂 𑇆𑇒𑇒𑇆
𑆥𑆳𑆤𑇀𑆠𑆶 𑆠𑇀𑆮𑆳𑆁 𑆩𑆶𑆤𑆪𑆾 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆪𑆳 𑆢𑆴𑆮𑇀𑆪𑆳 𑆫𑆳𑆘𑆫𑇀𑆰𑆪𑆱𑇀𑆠𑆡𑆳 𑇅 𑆥𑆫𑇀𑆮𑆠𑆳𑆯𑇀𑆖𑆽𑆮 𑆤𑆢𑇀𑆪𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆖 𑆱𑆳𑆓𑆫𑆳𑆂 𑇆𑇒𑇓𑇆
𑆃𑆓𑇀𑆤𑆵 𑆫𑆑𑇀𑆰𑆠𑆶 𑆠𑆼 𑆘𑆴𑆲𑇀𑆮𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀 𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆱𑆾𑆩𑆾 𑆮𑇀𑆪𑆳𑆤𑆩𑆥𑆳𑆤𑆁 𑆠𑆼 𑆥𑆫𑇀𑆘𑆤𑇀𑆪𑆂 𑆥𑆫𑆴𑆫𑆑𑇀𑆰𑆠𑆶 𑇆𑇒𑇔𑇆
𑆇𑆢𑆳𑆤𑆁 𑆮𑆴𑆢𑇀𑆪𑆶𑆠𑆂 𑆥𑆳𑆤𑇀𑆠𑆶 𑆱𑆩𑆳𑆤𑆁 𑆱𑇀𑆠𑆤𑆪𑆴𑆠𑇀𑆤𑆮𑆂 𑇅 𑆧𑆬𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆾 𑆧𑆬𑆥𑆠𑆴𑆫𑇀𑆩𑆤𑆶𑆫𑇀𑆩𑆤𑇀𑆪𑆼 𑆩𑆠𑆴𑆁 𑆠𑆡𑆳 𑇆𑇒𑇕𑇆
𑆑𑆳𑆩𑆳𑆁𑆱𑇀𑆠𑆼 𑆥𑆳𑆤𑇀𑆠𑆶 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆳𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆾𑇁𑆨𑆴𑆫𑆑𑇀𑆰𑆠𑆶 𑇅 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆁 𑆠𑆼 𑆮𑆫𑆶𑆟𑆾 𑆫𑆳𑆘𑆳 𑆱𑆩𑆶𑆢𑇀𑆫𑆾 𑆤𑆳𑆨𑆴𑆩𑆟𑇀𑆝𑆬𑆩𑇀 𑇆𑇒𑇖𑇆
𑆖𑆑𑇀𑆰𑆶𑆂 𑆱𑆷𑆫𑇀𑆪𑆾 𑆢𑆴𑆯𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆼 𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆳𑆂 𑆥𑆳𑆠𑆶 𑆠𑆼 𑆩𑆤𑆂 𑇅 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆢𑆳 𑆫𑆷𑆥𑆁 𑆗𑆳𑆪𑆳𑆁 𑆥𑆳𑆤𑇀𑆠𑆶 𑆤𑆴𑆯𑆳𑆱𑇀𑆠𑆮 𑇆𑇒𑇗𑇆
𑆫𑆼𑆠𑆱𑇀𑆠𑇀𑆮𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆤𑇀𑆠𑇀𑆮𑆳𑆥𑆾 𑆫𑆾𑆩𑆳𑆟𑇀𑆪𑆾𑆰𑆣𑆪𑆱𑇀𑆠𑆡𑆳 𑇅 𑆄𑆑𑆳𑆯𑆁 𑆒𑆳𑆤𑆴 𑆠𑆼 𑆥𑆳𑆤𑇀𑆠𑆶 𑆢𑆼𑆲𑆁 𑆠𑆮 𑆮𑆱𑆶𑆤𑇀𑆣𑆫𑆳 𑇆𑇒𑇘𑇆
𑆮𑆽𑆯𑇀𑆮𑆳𑆤𑆫𑆂 𑆯𑆴𑆫𑆂 𑆥𑆳𑆠𑆶 𑆮𑆴𑆰𑇀𑆟𑆶𑆱𑇀𑆠𑆮 𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆥𑆿𑆫𑆶𑆰𑆁 𑆥𑆶𑆫𑆶𑆰𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆁 𑆣𑇀𑆫𑆶𑆮𑆾 𑆨𑇀𑆫𑆶𑆮𑆿 𑇆𑇒𑇙𑇆
𑆍𑆠𑆳 𑆢𑆼𑆲𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆠𑆮 𑆤𑆴𑆠𑇀𑆪𑆳 𑆲𑆴 𑆢𑆼𑆮𑆠𑆳𑆂 𑇅 𑆍𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆳𑆁 𑆱𑆠𑆠𑆁 𑆥𑆳𑆤𑇀𑆠𑆶 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆶𑆲𑆴 𑇆𑇓𑇐𑇆
𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆠𑆼 𑆨𑆓𑆮𑆳𑆤𑇀 𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆢𑆼𑆮𑆳𑆯𑇀𑆖 𑆑𑆶𑆫𑇀𑆮𑆠𑆳𑆩𑇀 𑇅 (𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆠𑆼 𑆖𑆤𑇀𑆢𑇀𑆫𑆱𑆷𑆫𑇀𑆪𑆿 𑆖 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆤𑆳𑆫𑆢𑆥𑆫𑇀𑆮𑆠𑆿) 𑇅 𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆯𑇀𑆖𑆿𑆮 𑆮𑆳𑆪𑆶𑆯𑇀𑆖 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆢𑆼𑆮𑆳𑆂 𑆱𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆓𑆳𑆂 𑇆𑇓𑇑𑇆
𑆥𑆴𑆠𑆳𑆩𑆲𑆑𑆸𑆠𑆳 𑆫𑆑𑇀𑆰𑆳 𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆳𑆪𑆶𑆫𑇀𑆮𑆫𑇀𑆣𑆠𑆳𑆁 𑆠𑆮 𑇅 𑆆𑆠𑆪𑆱𑇀𑆠𑆼 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆶 𑆱𑆢𑆳 𑆨𑆮 𑆓𑆠𑆮𑇀𑆪𑆡𑆂 𑇆𑇓𑇒𑇆
𑆅𑆠𑆴 𑆱𑇀𑆮𑆳𑆲𑆳 𑇅 𑆍𑆠𑆽𑆫𑇀𑆮𑆼𑆢𑆳𑆠𑇀𑆩𑆑𑆽𑆫𑇀𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆂 𑆑𑆸𑆠𑇀𑆪𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆤𑆳𑆯𑆤𑆽𑆂 𑇅 𑆩𑆪𑆽𑆮𑆁 𑆑𑆸𑆠𑆫𑆑𑇀𑆰𑆱𑇀𑆠𑇀𑆮𑆁 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆶𑆲𑆴 𑇆𑇓𑇓𑇆
𑆠𑆠𑆂 𑆑𑆸𑆠𑆫𑆑𑇀𑆰𑆩𑆳𑆠𑆶𑆫𑆩𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑇀𑆪, 𑆄𑆖𑆳𑆫𑆴𑆑𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇓𑇔𑇆
𑆠𑆠𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆼𑇁𑆲𑆤𑆴 𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆽𑆮𑆩𑆼𑆮 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆢𑇀𑆮𑆱𑇀𑆠𑇀𑆫𑆥𑆛𑇀𑆛𑆼𑆤; 𑆤 𑆖𑆽𑆤𑆁 𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆾𑇁𑆥𑆫𑆼𑆢𑇀𑆪𑆶𑆫𑇀𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇆𑇓𑇕𑇆
𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆢𑆴𑆮𑆱𑆥𑆫𑆴𑆩𑆾𑆑𑇀𑆰𑆟𑆳𑆢𑇀𑆮𑆴𑆓𑇀𑆫𑆡𑆴𑆠𑆾 𑆮𑇀𑆫𑆟𑆯𑇀𑆖𑆴𑆫𑆳𑆢𑆶𑆥𑆱𑆁𑆫𑆾𑆲𑆠𑆴, 𑆠𑆵𑆮𑇀𑆫𑆫𑆶𑆘𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇓𑇖𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆢𑆾𑆰𑆑𑆳𑆬𑆧𑆬𑆳𑆢𑆵𑆤𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆑𑆰𑆳𑆪𑆳𑆬𑆼𑆥𑆤𑆧𑆤𑇀𑆣𑆳𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆳𑆤𑇀 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇓𑇗𑇆
𑆤 𑆖𑆽𑆤𑆁 𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆂 𑆱𑆳𑆤𑇀𑆠𑆫𑇀𑆢𑆾𑆰𑆁 𑆫𑆾𑆥𑆪𑆼𑆠𑇀; 𑆱 𑆲𑇀𑆪𑆬𑇀𑆥𑆼𑆤𑆳𑆥𑇀𑆪𑆥𑆖𑆳𑆫𑆼𑆟𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆩𑆶𑆠𑇀𑆱𑆕𑇀𑆓𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆨𑆷𑆪𑆾𑇁𑆥𑆴 𑆮𑆴𑆑𑆫𑆾𑆠𑆴 𑇆𑇓𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆠𑆫𑇀𑆧𑆲𑆴𑆯𑇀𑆖𑆽𑆮 𑆱𑆶𑆯𑆶𑆢𑇀𑆣𑆁 𑆫𑆾𑆥𑆪𑆼𑆢𑇀𑆮𑇀𑆫𑆟𑆩𑇀 𑇅 𑆫𑆷𑆞𑆼𑇁𑆥𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆢𑆵𑆤𑇀 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆲𑆫𑇀𑆰𑆁 𑆑𑇀𑆫𑆾𑆣𑆁 𑆨𑆪𑆁 𑆖𑆳𑆥𑆴 𑆪𑆳𑆮𑆠𑇀 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆾𑆥𑆱𑆩𑇀𑆨𑆮𑆳𑆠𑇀 𑇆𑇓𑇙𑇆
𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆯𑆴𑆯𑆴𑆫𑆼 𑆖𑆽𑆮 𑆮𑆱𑆤𑇀𑆠𑆼 𑆖𑆳𑆥𑆴 𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆢𑇀𑆢𑇀𑆮𑇀𑆪𑆲𑆳𑆖𑇀𑆗𑆫𑆢𑇀𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆫𑇀𑆰𑆳𑆱𑇀𑆮𑆥𑆴 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇔𑇐𑇆
𑆃𑆠𑆴𑆥𑆳𑆠𑆴𑆰𑆶 𑆫𑆾𑆓𑆼𑆰𑆶 𑆤𑆼𑆖𑇀𑆗𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆩𑆴𑆩𑆁 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆥𑇀𑆫𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑆳𑆫𑆮𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆁 𑆠𑆠𑇀𑆫 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇆𑇔𑇑𑇆
𑆪𑆳 𑆮𑆼𑆢𑆤𑆳 𑆯𑆱𑇀𑆠𑇀𑆫𑆤𑆴𑆥𑆳𑆠𑆘𑆳𑆠𑆳 𑆠𑆵𑆮𑇀𑆫𑆳 𑆯𑆫𑆵𑆫𑆁 𑆥𑇀𑆫𑆢𑆶𑆤𑆾𑆠𑆴 𑆘𑆤𑇀𑆠𑆾𑆂 𑇅 𑆣𑆸𑆠𑆼𑆤 𑆱𑆳 𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆶𑆥𑆽𑆠𑆴 𑆱𑆴𑆑𑇀𑆠𑆳 𑆑𑆾𑆰𑇀𑆟𑆼𑆤 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆳𑆤𑇀𑆮𑆴𑆠𑆼𑆤𑆳 𑇆𑇔𑇒𑇆
𑆃𑆡𑆳𑆠 𑆉𑆠𑆶𑆖𑆫𑇀𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆑𑆳𑆬𑆾 𑆲𑆴 𑆤𑆳𑆩 (𑆨𑆓𑆮𑆳𑆤𑇀 ) 𑆱𑇀𑆮𑆪𑆩𑇀𑆨𑆶𑆫𑆤𑆳𑆢𑆴𑆩𑆣𑇀𑆪𑆤𑆴𑆣𑆤𑆂 𑇅 𑆃𑆠𑇀𑆫 𑆫𑆱𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆵 𑆘𑆵𑆮𑆴𑆠𑆩𑆫𑆟𑆼 𑆖 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆩𑆳𑆪𑆠𑇀𑆠𑆼 𑇅 𑆱 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆩𑆥𑆴 𑆑𑆬𑆳𑆁 𑆤 𑆬𑆵𑆪𑆠 𑆅𑆠𑆴 𑆑𑆳𑆬𑆂, 𑆱𑆕𑇀𑆑𑆬𑆪𑆠𑆴 𑆑𑆳𑆬𑆪𑆠𑆴 𑆮𑆳 𑆨𑆷𑆠𑆳𑆤𑆵𑆠𑆴 𑆑𑆳𑆬𑆂 𑇆𑇓𑇆
𑆠𑆱𑇀𑆪 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆠𑇀𑆩𑆤𑆾 𑆨𑆓𑆮𑆳𑆤𑆳𑆢𑆴𑆠𑇀𑆪𑆾 𑆓𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆳𑆑𑇀𑆰𑆴𑆤𑆴𑆩𑆼𑆰𑆑𑆳𑆰𑇀𑆜𑆳𑆑𑆬𑆳𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆳𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆥𑆑𑇀𑆰𑆩𑆳𑆱𑆫𑇀𑆠𑇀𑆮𑆪𑆤𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆪𑆶𑆓𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆁 𑆑𑆫𑆾𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆬𑆔𑇀𑆮𑆑𑇀𑆰𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆟𑆩𑆳𑆠𑇀𑆫𑆾𑇁𑆑𑇀𑆰𑆴𑆤𑆴𑆩𑆼𑆰𑆂, 𑆥𑆚𑇀𑆖𑆢𑆯𑆳𑇁𑆑𑇀𑆰𑆴𑆤𑆴𑆩𑆼𑆰𑆳𑆂 𑆑𑆳𑆰𑇀𑆜𑆳, 𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀𑆑𑆳𑆰𑇀𑆜𑆳𑆂 𑆑𑆬𑆳, 𑆮𑆴𑆁𑆯𑆠𑆴𑆑𑆬𑆾 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆂 𑆑𑆬𑆳𑆢𑆯𑆨𑆳𑆓𑆯𑇀𑆖, 𑆠𑇀𑆫𑆴𑆁𑆯𑆤𑇀𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆩𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆁, 𑆥𑆚𑇀𑆖𑆢𑆯𑆳𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆥𑆑𑇀𑆰𑆂, 𑆱 𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂- 𑆯𑆶𑆑𑇀𑆬𑆂 𑆑𑆸𑆰𑇀𑆟𑆯𑇀𑆖, 𑆠𑆿 𑆩𑆳𑆱𑆂 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆩𑆳𑆔𑆳𑆢𑆪𑆾 𑆢𑇀𑆮𑆳𑆢𑆯 𑆩𑆳𑆱𑆳𑆂, 𑆢𑇀𑆮𑆴𑆩𑆳𑆱𑆴𑆑𑆩𑆸𑆠𑆶𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆰𑆝𑆸𑆠𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆼 𑆯𑆴𑆯𑆴𑆫𑆮𑆱𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆫𑇀𑆰𑆳𑆯𑆫𑆢𑇀𑆣𑆼𑆩𑆤𑇀𑆠𑆳𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆥𑆱𑇀𑆠𑆥𑆱𑇀𑆪𑆿 𑆯𑆴𑆯𑆴𑆫𑆂, 𑆩𑆣𑆶𑆩𑆳𑆣𑆮𑆿 𑆮𑆱𑆤𑇀𑆠𑆂, 𑆯𑆶𑆖𑆴𑆯𑆶𑆑𑇀𑆫𑆿 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆂, 𑆤𑆨𑆾𑆤𑆨𑆱𑇀𑆪𑆿 𑆮𑆫𑇀𑆰𑆳𑆂, 𑆅𑆰𑆾𑆫𑇀𑆘𑆿 𑆯𑆫𑆠𑇀, 𑆱𑆲𑆂𑆱𑆲𑆱𑇀𑆪𑆿 𑆲𑆼𑆩𑆤𑇀𑆠 𑆅𑆠𑆴 𑇆𑇖𑇆
𑆠 𑆍𑆠𑆼 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆬𑆑𑇀𑆰𑆟𑆳𑆯𑇀𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆢𑆴𑆠𑇀𑆪𑆪𑆾𑆂 𑆑𑆳𑆬𑆮𑆴𑆨𑆳𑆓𑆑𑆫𑆠𑇀𑆮𑆳𑆢𑆪𑆤𑆼 𑆢𑇀𑆮𑆼 𑆨𑆮𑆠𑆾 𑆢𑆑𑇀𑆰𑆴𑆟𑆩𑆶𑆠𑇀𑆠𑆫𑆁 𑆖 𑇅 𑆠𑆪𑆾𑆫𑇀𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆮𑆫𑇀𑆰𑆳𑆯𑆫𑆢𑇀𑆣𑆼𑆩𑆤𑇀𑆠𑆳𑆂; 𑆠𑆼𑆰𑆶 𑆨𑆓𑆮𑆳𑆤𑆳𑆥𑇀𑆪𑆳𑆪𑆠𑆼 𑆱𑆾𑆩𑆂, 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆩𑆣𑆶𑆫𑆳𑆯𑇀𑆖 𑆫𑆱𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆇𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆁 𑆖 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆧𑆬𑆩𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑇅 𑆇𑆠𑇀𑆠𑆫𑆁 𑆖 𑆯𑆴𑆯𑆴𑆫𑆮𑆱𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆳𑆂, 𑆠𑆼𑆰𑆶 𑆨𑆓𑆮𑆳𑆤𑆳𑆥𑇀𑆪𑆳𑆪𑆠𑆼𑇁𑆫𑇀𑆑𑆂, 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆑𑆳𑆯𑇀𑆖 𑆫𑆱𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆇𑆠𑇀𑆠𑆫𑆾𑆠𑇀𑆠𑆫𑆁 𑆖 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆧𑆬𑆩𑆶𑆥𑆲𑆵𑆪𑆠𑆼 𑇆𑇗𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆵𑆠𑆳𑆁𑆯𑆶𑆂 𑆑𑇀𑆬𑆼𑆢𑆪𑆠𑇀𑆪𑆶𑆫𑇀𑆮𑆵𑆁 𑆮𑆴𑆮𑆱𑇀𑆮𑆳𑆤𑇀 𑆯𑆾𑆰𑆪𑆠𑇀𑆪𑆥𑆴 𑇅 𑆠𑆳𑆮𑆶𑆨𑆳𑆮𑆥𑆴 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆮𑆳𑆪𑆶𑆂 𑆥𑆳𑆬𑆪𑆠𑆴 𑆥𑇀𑆫𑆘𑆳𑆂 𑇆𑇘𑇆
𑆃𑆡 𑆒𑆬𑇀𑆮𑆪𑆤𑆼 𑆢𑇀𑆮𑆼 𑆪𑆶𑆓𑆥𑆠𑇀 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆠𑆼 𑆠𑆶 𑆥𑆚𑇀𑆖 𑆪𑆶𑆓𑆩𑆴𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆤𑇀𑆠𑆼 𑇅 𑆱 𑆍𑆰 𑆤𑆴𑆩𑆼𑆰𑆳𑆢𑆴𑆫𑇀𑆪𑆶𑆓𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆂 𑆑𑆳𑆬𑆯𑇀𑆖𑆑𑇀𑆫𑆮𑆠𑇀 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆂 𑆑𑆳𑆬𑆖𑆑𑇀𑆫𑆩𑆴𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠 𑆅𑆠𑇀𑆪𑆼𑆑𑆼 𑇆𑇙𑇆
𑆅𑆲 𑆠𑆶 𑆮𑆫𑇀𑆰𑆳𑆯𑆫𑆢𑇀𑆣𑆼𑆩𑆤𑇀𑆠𑆮𑆱𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆂 𑆰𑆝𑆸𑆠𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆢𑆾𑆰𑆾𑆥𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆾𑆥𑆯𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁; 𑆠𑆼 𑆠𑆶 𑆨𑆳𑆢𑇀𑆫𑆥𑆢𑆳𑆢𑇀𑆪𑆼𑆤 𑆢𑇀𑆮𑆴𑆩𑆳𑆱𑆴𑆑𑆼𑆤 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆨𑆳𑆢𑇀𑆫𑆥𑆢𑆳𑆯𑇀𑆮𑆪𑆶𑆘𑆿 𑆮𑆫𑇀𑆰𑆳𑆂, 𑆑𑆳𑆫𑇀𑆠𑆴𑆑𑆩𑆳𑆫𑇀𑆓𑆯𑆵𑆫𑇀𑆰𑆿 𑆯𑆫𑆠𑇀, 𑆥𑆿𑆰𑆩𑆳𑆔𑆿 𑆲𑆼𑆩𑆤𑇀𑆠𑆂, 𑆦𑆳𑆬𑇀𑆓𑆶𑆤𑆖𑆽𑆠𑇀𑆫𑆿 𑆮𑆱𑆤𑇀𑆠𑆂, 𑆮𑆽𑆯𑆳𑆒𑆘𑇀𑆪𑆼𑆰𑇀𑆜𑆿 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆂; 𑆄𑆰𑆳𑆞𑆯𑇀𑆫𑆳𑆮𑆟𑆿 𑆥𑇀𑆫𑆳𑆮𑆸𑆝𑆴𑆠𑆴 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫, 𑆮𑆫𑇀𑆰𑆳𑆱𑇀𑆮𑆾𑆰𑆣𑆪𑆱𑇀𑆠𑆫𑆶𑆟𑇀𑆪𑆾𑇁𑆬𑇀𑆥𑆮𑆵𑆫𑇀𑆪𑆳 𑆄𑆥𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆳𑆂 𑆑𑇀𑆰𑆴𑆠𑆴𑆩𑆬𑆥𑇀𑆫𑆳𑆪𑆳𑆂, 𑆠𑆳 𑆇𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳 𑆤𑆨𑆱𑆴 𑆩𑆼𑆔𑆳𑆮𑆠𑆠𑆼 𑆘𑆬𑆥𑇀𑆫𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆨𑆷𑆩𑆿 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆯𑆵𑆠𑆮𑆳𑆠𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴𑆠𑆳𑆓𑇀𑆤𑆵𑆤𑆳𑆁 𑆮𑆴𑆢𑆲𑇀𑆪𑆤𑇀𑆠𑆼, 𑆮𑆴𑆢𑆳𑆲𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆱𑆚𑇀𑆖𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴; 𑆱 𑆱𑆚𑇀𑆖𑆪𑆂 𑆯𑆫𑆢𑆴 𑆥𑇀𑆫𑆮𑆴𑆫𑆬𑆩𑆼𑆔𑆼 𑆮𑆴𑆪𑆠𑇀𑆪𑆶𑆥𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆥𑆕𑇀𑆑𑆼𑇁𑆫𑇀𑆑𑆑𑆴𑆫𑆟𑆥𑇀𑆫𑆮𑆴𑆬𑆳𑆪𑆴𑆠𑆂 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆚𑇀𑆘𑆤𑆪𑆠𑆴 𑇅 𑆠𑆳 𑆍𑆮𑆿𑆰𑆣𑆪𑆂 𑆑𑆳𑆬𑆥𑆫𑆴𑆟𑆳𑆩𑆳𑆠𑇀 𑆥𑆫𑆴𑆟𑆠𑆮𑆵𑆫𑇀𑆪𑆳 𑆧𑆬𑆮𑆠𑇀𑆪𑆾 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆥𑆯𑇀𑆖 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆳𑆯𑇀𑆖, 𑆠𑆳 𑆇𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳 𑆩𑆤𑇀𑆢𑆑𑆴𑆫𑆟𑆠𑇀𑆮𑆳𑆢𑇀𑆨𑆳𑆤𑆾𑆂 𑆱𑆠𑆶𑆰𑆳𑆫𑆥𑆮𑆤𑆾𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆴𑆠𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑆮𑆴𑆢𑆓𑇀𑆣𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆳𑆢𑇀𑆓𑆿𑆫𑆮𑆳𑆢𑆶𑆥𑆬𑆼𑆥𑆳𑆖𑇀𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆚𑇀𑆖𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴; 𑆱 𑆱𑆚𑇀𑆖𑆪𑆾 𑆮𑆱𑆤𑇀𑆠𑆼𑇁𑆫𑇀𑆑𑆫𑆯𑇀𑆩𑆴𑆥𑇀𑆫𑆮𑆴𑆬𑆳𑆪𑆴𑆠 𑆆𑆰𑆠𑇀𑆱𑇀𑆠𑆧𑇀𑆣𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆚𑇀𑆘𑆤𑆪𑆠𑆴 𑇅 𑆠𑆳 𑆍𑆮𑆿𑆰𑆣𑆪𑆾 𑆤𑆴𑆢𑆳𑆔𑆼 𑆤𑆴𑆂𑆱𑆳𑆫𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆬𑆔𑇀𑆮𑇀𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆥𑆯𑇀𑆖, 𑆠𑆳 𑆇𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆱𑆷𑆫𑇀𑆪𑆥𑇀𑆫𑆠𑆳𑆥𑆾𑆥𑆯𑆾𑆰𑆴𑆠𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆬𑇀𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆮𑆳𑆪𑆾𑆂 𑆱𑆚𑇀𑆖𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴; 𑆱 𑆱𑆚𑇀𑆖𑆪𑆂 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆴 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆘𑆬𑆾𑆥𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆨𑆷𑆩𑆿 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆯𑆵𑆠𑆮𑆳𑆠𑆮𑆫𑇀𑆰𑆼𑆫𑆴𑆠𑆾 𑆮𑆳𑆠𑆴𑆑𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆚𑇀𑆘𑆤𑆪𑆠𑆴 𑇅 𑆍𑆮𑆩𑆼𑆰 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆚𑇀𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆲𑆼𑆠𑆶𑆫𑆶𑆑𑇀𑆠𑆂 𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫 𑆮𑆫𑇀𑆰𑆳𑆲𑆼𑆩𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼𑆰𑆶 𑆱𑆚𑇀𑆖𑆴𑆠𑆳𑆤𑆳𑆁 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆯𑆫𑆢𑇀𑆮𑆱𑆤𑇀𑆠𑆥𑇀𑆫𑆳𑆮𑆸𑆛𑇀𑆱𑆶 𑆖 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆫𑇀𑆲𑆫𑆟𑆁 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑇀 𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆶𑆥𑆯𑆩𑆾 𑆲𑆼𑆩𑆤𑇀𑆠𑆼, 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆔𑆼, 𑆮𑆳𑆠𑆴𑆑𑆳𑆤𑆳𑆁 𑆯𑆫𑆢𑆴 , 𑆱𑇀𑆮𑆨𑆳𑆮𑆠 𑆍𑆮; 𑆠 𑆍𑆠𑆼 𑆱𑆚𑇀𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆾𑆥𑆯𑆩𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆮𑆱𑆤𑇀𑆠𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆁, 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆱𑇀𑆪, 𑆃𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆂 , 𑆥𑇀𑆫𑆢𑆾𑆰𑆼 𑆮𑆳𑆫𑇀𑆰𑆴𑆑𑆁, 𑆯𑆳𑆫𑆢𑆩𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆼, 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆰𑆱𑆴 𑆲𑆽𑆩𑆤𑇀𑆠𑆩𑆶𑆥𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀; 𑆍𑆮𑆩𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆩𑆥𑆴 𑆮𑆫𑇀𑆰𑆩𑆴𑆮 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆬𑆑𑇀𑆰𑆟𑆁 𑆢𑆾𑆰𑆾𑆥𑆖𑆪𑆥𑇀𑆫𑆑𑆾𑆥𑆾𑆥𑆯𑆩𑆽𑆫𑇀𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇑𑇔𑇆
𑆠𑆠𑇀𑆫, 𑆃𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼𑆰𑆶 𑆉𑆠𑆶𑆰𑇀𑆮𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆳 𑆏𑆰𑆣𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆥𑆯𑇀𑆖; 𑆠𑆳 𑆇𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆪𑆶𑆫𑇀𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆿𑆘𑆱𑇀𑆑𑆫𑇀𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑆢𑆾𑇁𑆢𑆸𑆰𑇀𑆛𑆑𑆳𑆫𑆴𑆠𑆳𑆂, 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆳𑆠𑆮𑆫𑇀𑆰𑆳𑆟𑆴 𑆒𑆬𑆶 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑇀𑆪𑆾𑆰𑆣𑆵𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑇀𑆪𑆥𑆯𑇀𑆖 𑇆𑇑𑇖𑇆
𑆠𑆳𑆱𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆫𑆾𑆓𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆩𑆫𑆑𑆾 𑆮𑆳 𑆨𑆮𑆼𑆢𑆴𑆠𑆴 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫, 𑆃𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆩𑆥𑆳𑆁 𑆖𑆾𑆥𑆪𑆾𑆓𑆂 𑇆𑇑𑇘𑇆
𑆑𑆢𑆳𑆖𑆴𑆢𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼𑆰𑇀𑆮𑆥𑆴 𑆉𑆠𑆶𑆰𑆶 𑆑𑆸𑆠𑇀𑆪𑆳𑆨𑆴𑆯𑆳𑆥𑆫𑆑𑇀𑆰𑆂𑆑𑇀𑆫𑆾𑆣𑆳𑆣𑆫𑇀𑆩𑆽𑆫𑆶𑆥𑆣𑇀𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆘𑆤𑆥𑆢𑆳𑆂, 𑆮𑆴𑆰𑆿𑆰𑆣𑆴𑆥𑆶𑆰𑇀𑆥𑆓𑆤𑇀𑆣𑆼𑆤 𑆮𑆳 𑆮𑆳𑆪𑆶𑆤𑆾𑆥𑆤𑆵𑆠𑆼𑆤𑆳𑆑𑇀𑆫𑆩𑇀𑆪𑆠𑆼 𑆪𑆾 𑆢𑆼𑆯𑆱𑇀𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆮𑆩𑆡𑆶𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆯𑆴𑆫𑆾𑆫𑆶𑆓𑇀𑆘𑇀𑆮𑆫𑆽𑆫𑆶𑆥𑆠𑆥𑇀𑆪𑆤𑇀𑆠𑆼, 𑆓𑇀𑆫𑆲𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆖𑆫𑆴𑆠𑆽𑆫𑇀𑆮𑆳, 𑆓𑆸𑆲𑆢𑆳𑆫𑆯𑆪𑆤𑆳𑆱𑆤𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆩𑆟𑆴𑆫𑆠𑇀𑆤𑆾𑆥𑆑𑆫𑆟𑆓𑆫𑇀𑆲𑆴𑆠𑆬𑆑𑇀𑆰𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆽𑆫𑇀𑆮𑆳 𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫, 𑆱𑇀𑆡𑆳𑆤𑆥𑆫𑆴𑆠𑇀𑆪𑆳𑆓𑆯𑆳𑆤𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆩𑆕𑇀𑆓𑆬𑆘𑆥𑆲𑆾𑆩𑆾𑆥𑆲𑆳𑆫𑆼𑆘𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆴𑆤𑆩𑆱𑇀𑆑𑆳𑆫𑆠𑆥𑆾𑆤𑆴𑆪𑆩- 𑆢𑆪𑆳𑆢𑆳𑆤𑆢𑆵𑆑𑇀𑆰𑆳𑆨𑇀𑆪𑆶𑆥𑆓𑆩𑆢𑆼𑆮𑆠𑆳𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆓𑆶𑆫𑆶𑆥𑆫𑆽𑆫𑇀𑆨𑆮𑆴𑆠𑆮𑇀𑆪𑆩𑇀, 𑆍𑆮𑆁 𑆱𑆳𑆣𑆶 𑆨𑆮𑆠𑆴 𑇆𑇒𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆩𑆸𑆠𑆷𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇒𑇑𑇆
𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆳𑆠𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆂 𑆯𑆵𑆠𑆾 𑆫𑆘𑆾𑆣𑆷𑆩𑆳𑆑𑆶𑆬𑆳 𑆢𑆴𑆯𑆂 𑇅 𑆗𑆤𑇀𑆤𑆱𑇀𑆠𑆶𑆰𑆳𑆫𑆽𑆂 𑆱𑆮𑆴𑆠𑆳 𑆲𑆴𑆩𑆳𑆤𑆢𑇀𑆣𑆳 𑆘𑆬𑆳𑆯𑆪𑆳𑆂 𑇆𑇒𑇒𑇆
𑆢𑆫𑇀𑆥𑆴𑆠𑆳 𑆣𑇀𑆮𑆳𑆕𑇀𑆑𑇀𑆰𑆒𑆕𑇀𑆓𑆳𑆲𑇀𑆮𑆩𑆲𑆴𑆰𑆾𑆫𑆨𑇀𑆫𑆑𑆶𑆚𑇀𑆘𑆫𑆳𑆂 𑇅 𑆫𑆾𑆣𑇀𑆫𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆥𑆶𑆤𑇀𑆤𑆳𑆓𑆳𑆂 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆳 𑆲𑆴𑆩𑆱𑆳𑆲𑇀𑆮𑆪𑆼 𑇆𑇒𑇓𑇆
𑆯𑆴𑆯𑆴𑆫𑆼 𑆯𑆵𑆠𑆩𑆣𑆴𑆑𑆁 𑆮𑆳𑆠𑆮𑆸𑆰𑇀𑆛𑇀𑆪𑆳𑆑𑆶𑆬𑆳 𑆢𑆴𑆯𑆂 𑇅 𑆯𑆼𑆰𑆁 𑆲𑆼𑆩𑆤𑇀𑆠𑆮𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆧𑆶𑆣𑆽𑆂 𑇆𑇒𑇔𑇆
𑆱𑆴𑆢𑇀𑆣𑆮𑆴𑆢𑇀𑆪𑆳𑆣𑆫𑆮𑆣𑆷𑆖𑆫𑆟𑆳𑆬𑆑𑇀𑆠𑆑𑆳𑆕𑇀𑆑𑆴𑆠𑆼 𑇅 𑆩𑆬𑆪𑆼 𑆖𑆤𑇀𑆢𑆤𑆬𑆠𑆳𑆥𑆫𑆴𑆰𑇀𑆮𑆕𑇀𑆓𑆳𑆣𑆴𑆮𑆳𑆱𑆴𑆠𑆼 𑇆𑇒𑇕𑇆
𑆮𑆳𑆠𑆴 𑆑𑆳𑆩𑆴𑆘𑆤𑆳𑆤𑆤𑇀𑆢𑆘𑆤𑆤𑆾𑇁𑆤𑆕𑇀𑆓𑆢𑆵𑆥𑆤𑆂 𑇅 𑆢𑆩𑇀𑆥𑆠𑇀𑆪𑆾𑆫𑇀𑆩𑆳𑆤𑆨𑆴𑆢𑆶𑆫𑆾 𑆮𑆱𑆤𑇀𑆠𑆼 𑆢𑆑𑇀𑆰𑆴𑆟𑆾𑇁𑆤𑆴𑆬𑆂 𑇆𑇒𑇖𑇆
𑆢𑆴𑆯𑆾 𑆮𑆱𑆤𑇀𑆠𑆼 𑆮𑆴𑆩𑆬𑆳𑆂 𑆑𑆳𑆤𑆤𑆽𑆫𑆶𑆥𑆯𑆾𑆨𑆴𑆠𑆳𑆂 𑇅 𑆑𑆴𑆁𑆯𑆶𑆑𑆳𑆩𑇀𑆨𑆾𑆘𑆧𑆑𑆶𑆬𑆖𑆷𑆠𑆳𑆯𑆾𑆑𑆳𑆢𑆴𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆽𑆂 𑇆𑇒𑇗𑇆
𑆑𑆾𑆑𑆴𑆬𑆳𑆰𑆛𑇀𑆥𑆢𑆓𑆟𑆽𑆫𑆶𑆥𑆓𑆵𑆠𑆳 𑆩𑆤𑆾𑆲𑆫𑆳𑆂 𑇅 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆤𑆴𑆬𑆱𑆁𑆮𑆵𑆠𑆳𑆂 𑆱𑆶𑆩𑆶𑆒𑆳𑆂 𑆥𑆬𑇀𑆬𑆮𑆾𑆘𑇀𑆘𑇀𑆮𑆬𑆳𑆂 𑇆𑇒𑇘𑇆
𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆁𑆯𑆶𑆫𑆳𑆢𑆴𑆠𑇀𑆪𑆾 𑆩𑆳𑆫𑆶𑆠𑆾 𑆤𑆽𑆫𑆸𑆠𑆾𑇁𑆱𑆶𑆒𑆂 𑇅 𑆨𑆷𑆱𑇀𑆠𑆥𑇀𑆠𑆳 𑆱𑆫𑆴𑆠𑆱𑇀𑆠𑆤𑇀𑆮𑇀𑆪𑆾 𑆢𑆴𑆯𑆂 𑆥𑇀𑆫𑆘𑇀𑆮𑆬𑆴𑆠𑆳 𑆅𑆮 𑇆𑇒𑇙𑇆
𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆖𑆑𑇀𑆫𑆳𑆲𑇀𑆮𑆪𑆶𑆓𑆬𑆳𑆂 𑆥𑆪𑆂𑆥𑆳𑆤𑆳𑆑𑆶𑆬𑆳 𑆩𑆸𑆓𑆳𑆂 𑇅 𑆣𑇀𑆮𑆱𑇀𑆠𑆮𑆵𑆫𑆶𑆠𑇀𑆠𑆸𑆟𑆬𑆠𑆳 𑆮𑆴𑆥𑆫𑇀𑆟𑆳𑆕𑇀𑆑𑆴𑆠𑆥𑆳𑆢𑆥𑆳𑆂 𑇆𑇓𑇐𑇆
𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑇀𑆪𑆩𑇀𑆧𑆫𑆩𑆳𑆤𑆢𑇀𑆣𑆁 𑆥𑆯𑇀𑆖𑆴𑆩𑆳𑆤𑆴𑆬𑆑𑆫𑇀𑆰𑆴𑆠𑆽𑆂 𑇅 𑆃𑆩𑇀𑆧𑆶𑆢𑆽𑆫𑇀𑆮𑆴𑆢𑇀𑆪𑆶𑆢𑆶𑆢𑇀𑆢𑇀𑆪𑆾𑆠𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆽𑆱𑇀𑆠𑆶𑆩𑆶𑆬𑆱𑇀𑆮𑆤𑆽𑆂 𑇆𑇓𑇑𑇆
𑆑𑆾𑆩𑆬𑆯𑇀𑆪𑆳𑆩𑆯𑆰𑇀𑆥𑆳𑆞𑇀𑆪𑆳 𑆯𑆑𑇀𑆫𑆓𑆾𑆥𑆾𑆘𑇀𑆘𑇀𑆮𑆬𑆳 𑆩𑆲𑆵 𑇅 𑆑𑆢𑆩𑇀𑆧𑆤𑆵𑆥𑆑𑆶𑆛𑆘𑆱𑆫𑇀𑆘𑆑𑆼𑆠𑆑𑆨𑆷𑆰𑆴𑆠𑆳 𑇆𑇓𑇒𑇆
𑆠𑆠𑇀𑆫 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆤𑆢𑇀𑆪𑆾𑇁𑆩𑇀𑆨𑆯𑇀𑆗𑆤𑇀𑆤𑆾𑆒𑆳𑆠𑆠𑆛𑆢𑇀𑆫𑆶𑆩𑆳𑆂 𑇅 𑆮𑆳𑆥𑇀𑆪𑆂 𑆥𑇀𑆫𑆾𑆠𑇀𑆦𑆶𑆬𑇀𑆬𑆑𑆶𑆩𑆶𑆢𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆮𑆴𑆫𑆳𑆘𑆴𑆠𑆳𑆂 𑇆𑇓𑇓𑇆
𑆨𑆷𑆫𑆮𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆡𑆬𑆯𑇀𑆮𑆨𑇀𑆫𑆳 𑆧𑆲𑆶𑆯𑆱𑇀𑆪𑆾𑆥𑆯𑆾𑆨𑆴𑆠𑆳 𑇅 𑆤𑆳𑆠𑆴𑆓𑆫𑇀𑆘𑆠𑇀𑆱𑇀𑆫𑆮𑆤𑇀𑆩𑆼𑆔𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆫𑇀𑆑𑆓𑇀𑆫𑆲𑆁 𑆤𑆨𑆂 𑇆𑇓𑇔𑇆
𑆧𑆨𑇀𑆫𑆶𑆫𑆶𑆰𑇀𑆟𑆂 𑆯𑆫𑆢𑇀𑆪𑆫𑇀𑆑𑆂 𑆯𑇀𑆮𑆼𑆠𑆳𑆨𑇀𑆫𑆮𑆴𑆩𑆬𑆁 𑆤𑆨𑆂 𑇅 𑆠𑆡𑆳 𑆱𑆫𑆳𑆁𑆱𑇀𑆪𑆩𑇀𑆧𑆶𑆫𑆶𑆲𑆽𑆫𑇀𑆨𑆳𑆤𑇀𑆠𑆴 𑆲𑆁𑆱𑆳𑆁𑆱𑆔𑆛𑇀𑆛𑆴𑆠𑆽𑆂 𑇆𑇓𑇕𑇆
𑆥𑆕𑇀𑆑𑆯𑆶𑆰𑇀𑆑𑆢𑇀𑆫𑆶𑆩𑆳𑆑𑆵𑆫𑇀𑆟𑆳 𑆤𑆴𑆩𑇀𑆤𑆾𑆤𑇀𑆤𑆠𑆱𑆩𑆼𑆰𑆶 𑆨𑆷𑆂 𑇅 𑆧𑆳𑆟𑆱𑆥𑇀𑆠𑆳𑆲𑇀𑆮𑆧𑆤𑇀𑆣𑆷𑆑𑆑𑆳𑆯𑆳𑆱𑆤𑆮𑆴𑆫𑆳𑆘𑆴𑆠𑆳 𑇆𑇓𑇖𑇆
𑆱𑇀𑆮𑆓𑆶𑆟𑆽𑆫𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆼𑆰𑆶 𑆮𑆴𑆥𑆫𑆵𑆠𑆼𑆰𑆶 𑆮𑆳 𑆥𑆶𑆤𑆂 𑇅 𑆮𑆴𑆰𑆩𑆼𑆰𑇀𑆮𑆥𑆴 𑆮𑆳 𑆢𑆾𑆰𑆳𑆂 𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆸𑆠𑆶𑆰𑆶 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇆𑇓𑇗𑇆
𑆲𑆫𑆼𑆢𑇀𑆮𑆱𑆤𑇀𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆯𑆫𑆢𑆴 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑇅 𑆮𑆫𑇀𑆰𑆳𑆱𑆶 𑆯𑆩𑆪𑆼𑆢𑇀𑆮𑆳𑆪𑆶𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆪𑆳𑆠𑇀 𑇆𑇓𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆪𑆤𑇀𑆠𑇀𑆫𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆪𑆤𑇀𑆠𑇀𑆫𑆯𑆠𑆩𑆼𑆑𑆾𑆠𑇀𑆠𑆫𑆩𑇀; 𑆃𑆠𑇀𑆫 𑆲𑆱𑇀𑆠𑆩𑆼𑆮 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆮𑆓𑆖𑇀𑆗, (𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁 ? 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆱𑇀𑆠𑆳𑆢𑆸𑆠𑆼 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆼𑆮) 𑆠𑆢𑆣𑆵𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆧𑆳𑆣𑆑𑆫𑆳𑆟𑆴 𑆯𑆬𑇀𑆪𑆳𑆤𑆴; 𑆠𑆼𑆰𑆳𑆩𑆳𑆲𑆫𑆟𑆾𑆥𑆳𑆪𑆾 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑇆𑇔𑇆
𑆠𑆳𑆤𑆴 𑆰𑆛𑇀𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆱𑆤𑇀𑆢𑆁𑆯𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆠𑆳𑆬𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆤𑆳𑆝𑆵𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆯𑆬𑆳𑆑𑆳𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆇𑆥𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 , 𑆢𑇀𑆮𑆼 𑆱𑆤𑇀𑆢𑆁𑆯𑆪𑆤𑇀𑆠𑇀𑆫𑆼, 𑆢𑇀𑆮𑆼 𑆍𑆮 𑆠𑆳𑆬𑆪𑆤𑇀𑆠𑇀𑆫𑆼 , 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆤𑆳𑆝𑇀𑆪𑆂, 𑆃𑆰𑇀𑆛𑆳𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆯𑆬𑆳𑆑𑆳𑆂, 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆶𑆥𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑇆𑇖𑇆
𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆬𑆿𑆲𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆠𑇀𑆥𑇀𑆫𑆠𑆴𑆫𑆷𑆥𑆑𑆳𑆟𑆴 𑆮𑆳 𑆠𑆢𑆬𑆳𑆨𑆼 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫, 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆳𑆬𑆳𑆤𑆳𑆁 𑆩𑆸𑆓𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆁 𑆩𑆶𑆒𑆽𑆫𑇀𑆩𑆶𑆒𑆳𑆤𑆴 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆪𑆯𑆂 𑆱𑆢𑆸𑆯𑆳𑆤𑆴; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆠𑇀𑆱𑆳𑆫𑆷𑆥𑇀𑆪𑆳𑆢𑆳𑆓𑆩𑆳𑆢𑆶𑆥𑆢𑆼𑆯𑆳𑆢𑆤𑇀𑆪𑆪𑆤𑇀𑆠𑇀𑆫𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆴𑆠𑆯𑇀𑆖 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇘𑇆
𑆱𑆩𑆳𑆲𑆴𑆠𑆳𑆤𑆴 𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆒𑆫𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆩𑆶𑆒𑆳𑆤𑆴 𑆖 𑇅 𑆱𑆶𑆢𑆸𑆞𑆳𑆤𑆴 𑆱𑆶𑆫𑆷𑆥𑆳𑆟𑆴 𑆱𑆶𑆓𑇀𑆫𑆲𑆳𑆟𑆴 𑆖 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴- 𑆃𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑆴, 𑆱𑆴𑆁𑆲𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆮𑆸𑆑𑆠𑆫𑆑𑇀𑆰𑇀𑆮𑆸𑆑𑇀𑆰𑆢𑇀𑆮𑆵𑆥𑆴𑆩𑆳𑆫𑇀𑆘𑆳𑆫𑆯𑆸𑆓𑆳𑆬𑆩𑆸𑆓𑆽𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆑𑆳𑆑𑆑𑆕𑇀𑆑𑆑𑆶𑆫𑆫𑆖𑆳𑆱𑆨𑆳𑆱𑆯𑆯𑆔𑆳𑆠𑇀𑆪𑆶𑆬𑆷𑆑𑆖𑆴𑆬𑇀𑆬𑆴𑆯𑇀𑆪𑆼𑆤- 𑆓𑆸𑆣𑇀𑆫𑆑𑇀𑆫𑆿𑆚𑇀𑆖𑆨𑆸𑆕𑇀𑆓𑆫𑆳𑆘𑆳𑆚𑇀𑆘𑆬𑆴𑆑𑆫𑇀𑆟𑆳𑆮𑆨𑆚𑇀𑆘𑆤𑆤𑆤𑇀𑆢𑆵𑆩𑆶𑆒𑆩𑆶𑆒𑆳𑆤𑆴 , 𑆩𑆱𑆷𑆫𑆳𑆑𑆸𑆠𑆴𑆨𑆴𑆂 𑆑𑆵𑆬𑆽𑆫𑆮𑆧𑆢𑇀𑆣𑆳𑆤𑆴 , 𑆩𑆷𑆬𑆼𑇁𑆕𑇀𑆑𑆶𑆯𑆮𑆢𑆳𑆮𑆸𑆠𑇀𑆠𑆮𑆳𑆫𑆕𑇀𑆓𑆳𑆟𑆴 , 𑆃𑆱𑇀𑆡𑆴𑆮𑆴𑆢𑆰𑇀𑆛𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇑𑇐𑇆
𑆱𑆤𑆴𑆓𑇀𑆫𑆲𑆾𑇁𑆤𑆴𑆓𑇀𑆫𑆲𑆯𑇀𑆖 𑆱𑆤𑇀𑆢𑆁𑆯𑆿 𑆰𑆾𑆝𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆿 𑆨𑆮𑆠𑆂, 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆓𑆠𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆼𑆠𑆼 𑇆𑇑𑇑𑇆
𑆠𑆳𑆬𑆪𑆤𑇀𑆠𑇀𑆫𑆼 - 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆼 𑆩𑆠𑇀𑆱𑇀𑆪𑆠𑆳𑆬𑆮𑆢𑆼𑆑𑆠𑆳𑆬𑆢𑇀𑆮𑆴𑆠𑆳𑆬𑆑𑆼, 𑆑𑆫𑇀𑆟𑆤𑆳𑆱𑆳𑆤𑆳𑆝𑆵𑆯𑆬𑇀𑆪𑆳𑆤𑆳𑆩𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑇀 𑇆𑇑𑇒𑇆
𑆤𑆳𑆝𑆵𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 - 𑆃𑆤𑆼𑆑𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆴, 𑆃𑆤𑆼𑆑𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆳𑆤𑆴, 𑆍𑆑𑆠𑆾𑆩𑆶𑆒𑆳𑆤𑇀𑆪𑆶𑆨𑆪𑆠𑆾𑆩𑆶𑆒𑆳𑆤𑆴 𑆖; 𑆠𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆾𑆓𑆠𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆳𑆫𑇀𑆡𑆁, 𑆫𑆾𑆓𑆢𑆫𑇀𑆯𑆤𑆳𑆫𑇀𑆡𑆩𑇀, 𑆄𑆖𑆷𑆰𑆟𑆳𑆫𑇀𑆡𑆁, 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆿𑆑𑆫𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆖𑆼𑆠𑆴; 𑆠𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆾𑆢𑇀𑆮𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆲𑆳𑆤𑆴, 𑆪𑆡𑆳𑆪𑆾𑆓𑆢𑆵𑆫𑇀𑆔𑆳𑆟𑆴 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆫𑇀𑆯𑆾𑆮𑇀𑆫𑆟𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆩𑆷𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆢𑆑𑆾𑆢𑆫𑆣𑆷𑆩𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆥𑇀𑆫𑆑𑆯𑆱𑆤𑇀𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆓𑆶𑆢𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆬𑆳𑆧𑆷𑆯𑆸𑆕𑇀𑆓𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆖𑆾𑆥𑆫𑆴𑆰𑇀𑆛𑆳𑆢𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇓𑇆
𑆯𑆬𑆳𑆑𑆳𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆥𑆴 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆴, 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆳𑆤𑆴, 𑆪𑆡𑆳𑆪𑆾𑆓𑆥𑆫𑆴𑆟𑆳𑆲𑆢𑆵𑆫𑇀𑆔𑆳𑆟𑆴 𑆖; 𑆠𑆼𑆰𑆳𑆁 𑆓𑆟𑇀𑆝𑆷𑆥𑆢𑆱𑆫𑇀𑆥𑆦𑆟𑆯𑆫𑆥𑆶𑆕𑇀𑆒𑆧𑆝𑆴𑆯𑆩𑆶𑆒𑆼 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼, 𑆍𑆰𑆟𑆮𑇀𑆪𑆷𑆲𑆤𑆖𑆳𑆬𑆤𑆳𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆼𑆠𑆼 ; 𑆩𑆱𑆷𑆫𑆢𑆬𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆒𑆼 𑆢𑇀𑆮𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆳𑆤𑆠𑆳𑆓𑇀𑆫𑆼 𑆱𑇀𑆫𑆾𑆠𑆾𑆓𑆠𑆯𑆬𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆟𑆳𑆫𑇀𑆡𑆁; 𑆰𑆛𑇀 𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆑𑆸𑆠𑆾𑆰𑇀𑆟𑆵𑆰𑆳𑆟𑆴 , 𑆥𑇀𑆫𑆩𑆳𑆫𑇀𑆘𑆤𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶; 𑆠𑇀𑆫𑆵𑆟𑆴 𑆢𑆫𑇀𑆮𑇀𑆪𑆳𑆑𑆸𑆠𑆵𑆤𑆴 𑆒𑆬𑇀𑆬𑆩𑆶𑆒𑆳𑆤𑆴, 𑆑𑇀𑆰𑆳𑆫𑆿𑆰𑆣𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆫𑇀𑆡𑆁 ; 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆤𑇀𑆪𑆳𑆤𑆴 𑆘𑆳𑆩𑇀𑆧𑆮𑆮𑆢𑆤𑆳𑆤𑆴, 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆕𑇀𑆑𑆶𑆯𑆮𑆢𑆤𑆳𑆤𑆴, 𑆰𑆝𑆼𑆮𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆱𑇀𑆮𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑆳𑆤𑆴; 𑆤𑆳𑆱𑆳𑆫𑇀𑆧𑆶𑆢𑆲𑆫𑆟𑆳𑆫𑇀𑆡𑆩𑆼𑆑𑆁 𑆑𑆾𑆬𑆳𑆱𑇀𑆡𑆴𑆢𑆬𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆒𑆁 𑆒𑆬𑇀𑆬𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆿𑆰𑇀𑆜𑆁 ; 𑆃𑆚𑇀𑆘𑆤𑆳𑆫𑇀𑆡𑆩𑆼𑆑𑆁 𑆑𑆬𑆳𑆪𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆩𑆶𑆨𑆪𑆠𑆾 𑆩𑆶𑆑𑆶𑆬𑆳𑆓𑇀𑆫𑆁; 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆮𑆴𑆯𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆩𑆼𑆑𑆁 𑆩𑆳𑆬𑆠𑆵𑆥𑆶𑆰𑇀𑆥𑆮𑆸𑆤𑇀𑆠𑆳𑆓𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆩𑆴𑆠𑆴 𑇆𑇑𑇔𑇆
𑆇𑆥𑆪𑆤𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆥𑆴- 𑆫𑆘𑇀𑆘𑆶𑆮𑆼𑆟𑆴𑆑𑆳𑆥𑆛𑇀𑆛𑆖𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆮𑆬𑇀𑆑𑆬𑆬𑆠𑆳𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆰𑇀𑆜𑆵𑆬𑆳𑆯𑇀𑆩𑆩𑆶𑆢𑇀𑆓𑆫𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆘𑆴𑆲𑇀𑆮𑆳- 𑆢𑆤𑇀𑆠𑆤𑆒𑆩𑆶𑆒𑆧𑆳𑆬𑆳𑆯𑇀𑆮𑆑𑆛𑆑𑆯𑆳𑆒𑆳𑆰𑇀𑆜𑆵𑆮𑆤𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆲𑆫𑇀𑆰𑆳𑆪𑆱𑇀𑆑𑆳𑆤𑇀𑆠𑆩𑆪𑆳𑆤𑆴 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆨𑆼𑆰𑆘𑆳𑆤𑆴 𑆖𑆼𑆠𑆴 𑇆𑇑𑇕𑇆
𑆍𑆠𑆳𑆤𑆴 𑆢𑆼𑆲𑆼 𑆱𑆫𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀 𑆢𑆼𑆲𑆱𑇀𑆪𑆳𑆮𑆪𑆮𑆼 𑆠𑆡𑆳 𑇅 𑆱𑆤𑇀𑆣𑆿 𑆑𑆾𑆰𑇀𑆜𑆼 𑆣𑆩𑆤𑇀𑆪𑆳𑆁 𑆖 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆪𑆤𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆠𑆶- 𑆤𑆴𑆫𑇀𑆔𑆳𑆠𑆤𑆥𑆷𑆫𑆟𑆧𑆤𑇀𑆣𑆤𑆮𑇀𑆪𑆷𑆲𑆤𑆮𑆫𑇀𑆠𑆤𑆖𑆳𑆬𑆤𑆮𑆴𑆮𑆫𑇀𑆠𑆤𑆮𑆴𑆮𑆫𑆟𑆥𑆵𑆝𑆤𑆩𑆳𑆫𑇀𑆓𑆮𑆴𑆯𑆾𑆣𑆤𑆮𑆴𑆑𑆫𑇀𑆰𑆟𑆳𑆲𑆫𑆟𑆳𑆚𑇀𑆗𑆤𑆾𑆤𑇀𑆤𑆩𑆤- 𑆮𑆴𑆤𑆩𑆤𑆨𑆚𑇀𑆘𑆤𑆾𑆤𑇀𑆩𑆡𑆤𑆳𑆖𑆷𑆰𑆟𑆽𑆰𑆟𑆢𑆳𑆫𑆟𑆫𑇀𑆘𑆷𑆑𑆫𑆟𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆥𑇀𑆫𑆣𑆩𑆤𑆥𑇀𑆫𑆩𑆳𑆫𑇀𑆘𑆤𑆳𑆤𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑇆𑇑𑇗𑇆
𑆱𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆖𑆳𑆥𑆴 𑆮𑆴𑆨𑆘𑆼𑆢𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆃𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆬𑇀𑆪𑆳𑆤𑆳𑆩𑆴𑆠𑆴 𑆤𑆴𑆯𑇀𑆖𑆪𑆂 𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫, 𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆩𑇀, 𑆃𑆱𑆳𑆫𑆩𑇀, 𑆃𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆩𑇀, 𑆃𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆩𑇀, 𑆃𑆓𑇀𑆫𑆳𑆲𑆴, 𑆮𑆴𑆰𑆩𑆓𑇀𑆫𑆳𑆲𑆴, 𑆮𑆑𑇀𑆫𑆁, 𑆯𑆴𑆡𑆴𑆬𑆩𑇀, 𑆃𑆠𑇀𑆪𑆶𑆤𑇀𑆤𑆠𑆩𑇀, 𑆩𑆸𑆢𑆶𑆑𑆵𑆬𑆁, 𑆩𑆸𑆢𑆶𑆩𑆶𑆒𑆁, 𑆩𑆸𑆢𑆶𑆥𑆳𑆯𑆩𑇀, 𑆅𑆠𑆴 𑆢𑇀𑆮𑆳𑆢𑆯 𑆪𑆤𑇀𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆂 𑇆𑇑𑇙𑇆
𑆍𑆠𑆽𑆫𑇀𑆢𑆾𑆰𑆽𑆫𑇀𑆮𑆴𑆤𑆴𑆫𑇀𑆩𑆶𑆑𑇀𑆠𑆁 𑆪𑆤𑇀𑆠𑇀𑆫𑆩𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑇀 𑇅 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆨𑆴𑆰𑆘𑆳 𑆘𑇀𑆚𑆼𑆪𑆁 𑆠𑆢𑇀𑆣𑆴 𑆑𑆫𑇀𑆩𑆱𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆢𑆸𑆯𑇀𑆪𑆁 𑆱𑆴𑆁𑆲𑆩𑆶𑆒𑆳𑆢𑇀𑆪𑆽𑆱𑇀𑆠𑆶 𑆓𑆷𑆞𑆁 𑆑𑆕𑇀𑆑𑆩𑆶𑆒𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠 𑆯𑆤𑆽𑆂 𑆯𑆬𑇀𑆪𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆼𑆑𑇀𑆰𑆪𑆳 𑇆𑇒𑇑𑇆
𑆤𑆴(𑆮𑆴)𑆮𑆫𑇀𑆠𑆠𑆼 𑆱𑆳𑆣𑇀𑆮𑆮𑆓𑆳𑆲𑆠𑆼 𑆖 𑆯𑆬𑇀𑆪𑆁 𑆤𑆴𑆓𑆸𑆲𑇀𑆪𑆾𑆢𑇀𑆣𑆫𑆠𑆼 𑆖 𑆪𑆱𑇀𑆩𑆳𑆠𑇀 𑇅 𑆪𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑇀𑆮𑆠𑆂 𑆑𑆕𑇀𑆑𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆣𑆴(𑆮𑆴)𑆑𑆳𑆫𑆴 𑆖𑆽𑆮 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆮𑆖𑆳𑆫𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆟𑇀𑆝𑆬𑆳𑆓𑇀𑆫𑆑𑆫𑆥𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑆠𑇀𑆫𑆤𑆒𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑆾𑆠𑇀𑆥𑆬𑆥𑆠𑇀𑆫𑆑𑆳𑆫𑇀𑆣𑆣𑆳𑆫𑆱𑆷𑆖𑆵𑆑𑆶𑆯𑆥𑆠𑇀𑆫𑆳𑆛𑆵𑆩𑆶𑆒- 𑆯𑆫𑆳𑆫𑆴𑆩𑆶𑆒𑆳𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆠𑇀𑆫𑆴𑆑𑆷𑆫𑇀𑆖𑆑𑆑𑆶𑆜𑆳𑆫𑆴𑆑𑆳𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆳𑆫𑆳𑆮𑆼𑆠𑆱𑆥𑆠𑇀𑆫𑆑𑆧𑆝𑆴𑆯𑆢𑆤𑇀𑆠𑆯𑆕𑇀𑆑𑇀𑆮𑆼𑆰𑆟𑇀𑆪 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆩𑆟𑇀𑆝𑆬𑆳𑆓𑇀𑆫𑆑𑆫𑆥𑆠𑇀𑆫𑆼 𑆱𑇀𑆪𑆳𑆠𑆳𑆁 𑆗𑆼𑆢𑆤𑆼 𑆬𑆼𑆒𑆤𑆼 𑆖, 𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑆠𑇀𑆫𑆤𑆒𑆯𑆱𑇀𑆠𑇀𑆫𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑆾𑆠𑇀𑆥𑆬𑆥𑆠𑇀𑆫𑆑𑆳𑆫𑇀𑆣𑆣𑆳𑆫𑆳𑆟𑆴 𑆗𑆼𑆢𑆤𑆼 𑆨𑆼𑆢𑆤𑆼 𑆖, 𑆱𑆷𑆖𑆵𑆑𑆶𑆯𑆥𑆠𑇀𑆫𑆳𑆛𑆵(𑆛𑆳)𑆩𑆶𑆒𑆯𑆫𑆳𑆫𑆴𑆩𑆶𑆒𑆳𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆠𑇀𑆫𑆴𑆑𑆷𑆫𑇀𑆖𑆑𑆳𑆤𑆴 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆼, 𑆑𑆶𑆜𑆳𑆫𑆴𑆑𑆳𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆳𑆫𑆳𑆮𑆼𑆠𑆱𑆥𑆠𑇀𑆫𑆑𑆳𑆟𑆴 𑆮𑇀𑆪𑆣𑆤𑆼 𑆱𑆷𑆖𑆵 𑆖, 𑆧𑆝𑆴𑆯𑆁 𑆢𑆤𑇀𑆠𑆯𑆕𑇀𑆑𑆶𑆯𑇀𑆖𑆳𑆲𑆫𑆟𑆼, 𑆍𑆰𑆟𑇀𑆪𑆼𑆰𑆟𑆼 𑆄𑆤𑆶𑆬𑆾𑆩𑇀𑆪𑆼 𑆖, 𑆱𑆷𑆖𑇀𑆪𑆂 𑆱𑆵𑆮𑆤𑆼; 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆮𑆴𑆣𑆼 𑆑𑆫𑇀𑆩𑆟𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂 𑇆𑇔𑇆
𑆠𑆼𑆰𑆳𑆩𑆡 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆓𑇀𑆫𑆲𑆟𑆱𑆩𑆳𑆱𑆾𑆥𑆳𑆪𑆂 𑆑𑆫𑇀𑆩𑆱𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼- 𑆠𑆠𑇀𑆫 𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑆠𑇀𑆫𑆁 𑆮𑆸𑆤𑇀𑆠𑆦𑆬𑆱𑆳𑆣𑆳𑆫𑆟𑆼 𑆨𑆳𑆓𑆼 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀, 𑆨𑆼𑆢𑆤𑆳𑆤𑇀𑆪𑆼𑆮𑆁 𑆱𑆫𑇀𑆮𑆳𑆟𑆴, 𑆮𑆸𑆢𑇀𑆣𑆴𑆥𑆠𑇀𑆫𑆁 𑆩𑆟𑇀𑆝𑆬𑆳𑆓𑇀𑆫𑆁 𑆖 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆶𑆠𑇀𑆠𑆳𑆤𑆼𑆤 𑆥𑆳𑆟𑆴𑆤𑆳 𑆬𑆼𑆒𑆤𑆼 𑆧𑆲𑆶𑆯𑆾𑇁𑆮𑆖𑆳𑆫𑇀𑆪𑆁, 𑆮𑆸𑆤𑇀𑆠𑆳𑆓𑇀𑆫𑆼 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆤𑆴, 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆠𑆶 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆨𑆵𑆫𑆶𑆤𑆳𑆫𑆵𑆟𑆳𑆁 𑆫𑆳𑆘𑇀𑆚𑆳𑆁 𑆫𑆳𑆘𑆩𑆳(𑆥𑆶)𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆖 𑆠𑇀𑆫𑆴𑆑𑆷𑆫𑇀𑆖𑆑𑆼𑆤 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀, 𑆠𑆬𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆢𑆴𑆠𑆮𑆸𑆤𑇀𑆠𑆩𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆨𑇀𑆪𑆳𑆁 𑆮𑇀𑆫𑆵𑆲𑆴𑆩𑆶𑆒𑆁, 𑆑𑆶𑆜𑆳𑆫𑆴𑆑𑆳𑆁 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆤𑇀𑆪𑆱𑇀𑆠𑆳𑆩𑆴𑆠𑆫𑆲𑆱𑇀𑆠𑆩𑆣𑇀𑆪𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑇁𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑇀𑆛𑆧𑇀𑆣𑆪𑆳𑇁𑆨𑆴𑆲𑆤𑇀𑆪𑆳𑆠𑇀 , 𑆄𑆫𑆳𑆑𑆫𑆥𑆠𑇀𑆫𑆽𑆰𑆟𑇀𑆪𑆾 𑆩𑆷𑆬𑆼, 𑆯𑆼𑆰𑆳𑆟𑆴 𑆠𑆶 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀 𑇆𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆤𑆳𑆩𑆨𑆴𑆫𑆼𑆮𑆳𑆑𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆤𑆒𑆯𑆱𑇀𑆠𑇀𑆫𑆽𑆰𑆟𑇀𑆪𑆳𑆮𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆼 , 𑆱𑆷𑆖𑇀𑆪𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼, (𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑇀𑆪𑆓𑇀𑆫𑆥𑆫𑇀𑆮𑆥𑇀𑆫𑆢𑆼𑆯𑆥𑇀𑆫𑆩𑆳𑆟𑆳 𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑆳, 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆳 𑆯𑆫𑆳𑆫𑆴𑆩𑆶𑆒𑆵 𑆱𑆳 𑆖 (𑆪𑆳 𑆱𑆳) 𑆑𑆫𑇀𑆠𑆫𑆵𑆠𑆴 𑆑𑆡𑇀𑆪𑆠𑆼) 𑇅 𑆯𑆼𑆰𑆳𑆟𑆴 𑆠𑆶 𑆰𑆝𑆕𑇀𑆓𑆶𑆬𑆳𑆤𑆴 𑇆𑇗𑇆
𑆠𑆳𑆤𑆴 𑆱𑆶𑆓𑇀𑆫𑆲𑆳𑆟𑆴, 𑆱𑆶𑆬𑆾𑆲𑆳𑆤𑆴, 𑆱𑆶𑆣𑆳𑆫𑆳𑆟𑆴, 𑆱𑆶𑆫𑆷𑆥𑆳𑆟𑆴, 𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆩𑆶𑆒𑆳𑆓𑇀𑆫𑆳𑆟𑆴, 𑆃𑆑𑆫𑆳𑆬𑆳𑆤𑆴, 𑆖𑆼𑆠𑆴 𑆯𑆱𑇀𑆠𑇀𑆫𑆱𑆩𑇀𑆥𑆠𑇀 𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆮𑆑𑇀𑆫𑆁, 𑆑𑆶𑆟𑇀𑆜𑆁, 𑆒𑆟𑇀𑆝𑆁, 𑆒𑆫𑆣𑆳𑆫𑆩𑇀, 𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆩𑇀, 𑆃𑆠𑇀𑆪𑆬𑇀𑆥𑆩𑇀, 𑆃𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆩𑇀, 𑆃𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆩𑇀, 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆿 𑆯𑆱𑇀𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆂 𑇅 𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆩𑆳𑆢𑆢𑆵𑆠, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫 𑆑𑆫𑆥𑆠𑇀𑆫𑆳𑆠𑇀; 𑆠𑆢𑇀𑆣𑆴 𑆒𑆫𑆣𑆳𑆫𑆩𑆱𑇀𑆡𑆴𑆖𑇀𑆗𑆼𑆢𑆤𑆳𑆫𑇀𑆡𑆩𑇀 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆣𑆳𑆫𑆳 𑆨𑆼𑆢𑆤𑆳𑆤𑆳𑆁 𑆩𑆳𑆱𑆷𑆫𑆵, 𑆬𑆼𑆒𑆤𑆳𑆤𑆳𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆷𑆫𑆵, 𑆮𑇀𑆪𑆣𑆤𑆳𑆤𑆳𑆁 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆤𑆳𑆁 𑆖 𑆑𑆽𑆯𑆴𑆑𑆵, 𑆗𑆼𑆢𑆤𑆳𑆤𑆳𑆩𑆫𑇀𑆣𑆑𑆽𑆯𑆴𑆑𑆵𑆠𑆴 𑇆𑇑𑇐𑇆
𑆧𑆝𑆴𑆯𑆁 𑆢𑆤𑇀𑆠𑆯𑆕𑇀𑆑𑆶𑆯𑇀𑆖𑆳𑆤𑆠𑆳𑆓𑇀𑆫𑆼 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆑𑆟𑇀𑆛𑆑𑆥𑇀𑆫𑆡𑆩𑆪𑆮𑆥𑆠𑇀𑆫𑆩𑆶𑆒𑇀𑆪𑆼𑆰𑆟𑆵 (𑆓𑆟𑇀𑆝𑆷𑆥𑆢𑆳𑆑𑆳𑆫𑆩𑆶𑆒𑆵 𑆖) 𑇆𑇑𑇑𑇆
𑆠𑆼𑆰𑆳𑆁 𑆥𑆳𑆪𑆤𑆳 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆠𑆽𑆬𑆼𑆰𑆶 𑇅 𑆠𑆠𑇀𑆫 𑆑𑇀𑆰𑆳𑆫𑆥𑆳𑆪𑆴𑆠𑆁 𑆯𑆫𑆯𑆬𑇀𑆪𑆳𑆱𑇀𑆡𑆴𑆖𑇀𑆗𑆼𑆢𑆤𑆼𑆰𑆶, 𑆇𑆢𑆑𑆥𑆳𑆪𑆴𑆠𑆁 𑆩𑆳𑆁𑆱𑆖𑇀𑆗𑆼𑆢𑆤𑆨𑆼𑆢𑆤𑆥𑆳𑆛𑆤𑆼𑆰𑆶, 𑆠𑆽𑆬𑆥𑆳𑆪𑆴𑆠𑆁 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆤𑆱𑇀𑆤𑆳𑆪𑆶𑆖𑇀𑆗𑆼𑆢𑆤𑆼𑆰𑆶 𑇆𑇑𑇒𑇆
𑆠𑆼𑆰𑆳𑆁 𑆤𑆴𑆯𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆯𑆴𑆬𑆳 𑆩𑆳𑆰𑆮𑆫𑇀𑆟𑆳; 𑆣𑆳𑆫𑆳𑆱𑆁𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆦𑆬𑆑𑆩𑆴𑆠𑆴 𑇆𑇑𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆢𑆳 𑆱𑆶𑆤𑆴𑆯𑆴𑆠𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆫𑆾𑆩𑆖𑇀𑆗𑆼𑆢𑆴 𑆱𑆶𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆩𑇀 𑇅 𑆱𑆶𑆓𑆸𑆲𑆵𑆠𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆠𑆢𑆳 𑆑𑆫𑇀𑆩𑆱𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆃𑆤𑆶𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆠𑆶 𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆱𑇀𑆦𑆛𑆴𑆑𑆑𑆳𑆖𑆑𑆶𑆫𑆶𑆮𑆴𑆤𑇀𑆢𑆘𑆬𑆿𑆑𑆾𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆤𑆒𑆓𑆾𑆘𑆵𑆯𑆼𑆦𑆳𑆬𑆴𑆑𑆳𑆯𑆳𑆑𑆥𑆠𑇀𑆫𑆑𑆫𑆵𑆫𑆧𑆳𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑆪 𑆅𑆠𑆴 𑇆𑇑𑇕𑇆
𑆯𑆴𑆯𑆷𑆤𑆳𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆨𑆵𑆫𑆷𑆟𑆳𑆁 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆨𑆳𑆮𑆼 𑆖 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆠𑇀𑆮𑆑𑇀𑆱𑆳𑆫𑆳𑆢𑆴𑆖𑆠𑆶𑆫𑇀𑆮𑆫𑇀𑆓𑆁 𑆗𑆼𑆢𑇀𑆪𑆼 𑆨𑆼𑆢𑇀𑆪𑆼 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇑𑇖𑇆
𑆄𑆲𑆳𑆫𑇀𑆪𑆖𑇀𑆗𑆼𑆢𑇀𑆪𑆨𑆼𑆢𑇀𑆪𑆼𑆰𑆶 𑆤𑆒𑆁 𑆯𑆑𑇀𑆪𑆼𑆰𑆶 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆮𑆴𑆣𑆴𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆮𑆲𑇀𑆤𑆴𑆘𑆬𑆿𑆑𑆱𑆳𑆩𑇀 𑇆𑇑𑇗𑇆
𑆪𑆼 𑆱𑇀𑆪𑆶𑆫𑇀𑆩𑆶𑆒𑆓𑆠𑆳 𑆫𑆾𑆓𑆳 𑆤𑆼𑆠𑇀𑆫𑆮𑆫𑇀𑆠𑇀𑆩𑆓𑆠𑆳𑆯𑇀𑆖 𑆪𑆼 𑇅 𑆓𑆾𑆘𑆵𑆯𑆼𑆦𑆳𑆬𑆴𑆑𑆳𑆯𑆳𑆑𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆳𑆤𑇀 𑇆𑇑𑇘𑇆
𑆍𑆰𑇀𑆪𑆼𑆰𑇀𑆮𑆼𑆰𑆟𑇀𑆪𑆬𑆳𑆨𑆼 𑆠𑆶 𑆧𑆳𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆕𑇀𑆑𑆶𑆫𑆳 𑆲𑆴𑆠𑆳𑆂 𑇅𑇑𑇙𑇅 𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆯𑆶𑆢𑇀𑆣𑆯𑆽𑆑𑇀𑆪𑆳𑆪𑆱𑆳𑆤𑆴 𑆠𑆶 𑇅 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑆫𑆟𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆑𑆫𑇀𑆩𑆳𑆫𑆁 𑆑𑆫𑇀𑆩𑆑𑆾𑆮𑆴𑆢𑆩𑇀 𑇆𑇑𑇙𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆘𑇀𑆚𑆱𑇀𑆪 𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆪 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑆤𑆴𑆠𑇀𑆪𑆯𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆫𑆴𑆖𑆪𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆓𑇀𑆫𑆲𑆟𑆼 𑆱𑆢𑆳 𑇆𑇒𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆪𑆾𑆓𑇀𑆪𑆳𑆱𑆷𑆠𑇀𑆫𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆣𑆴𑆓𑆠𑆱𑆫𑇀𑆮𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆫𑇀𑆡𑆩𑆥𑆴 𑆯𑆴𑆰𑇀𑆪𑆁 𑆪𑆾𑆓𑇀𑆪𑆳𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆰𑆶 𑆗𑆼𑆢𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆖 𑆑𑆫𑇀𑆩𑆥𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆱𑆶𑆧𑆲𑆶𑆯𑇀𑆫𑆶𑆠𑆾𑇁𑆥𑇀𑆪𑆑𑆸𑆠𑆪𑆾𑆓𑇀𑆪𑆂 𑆑𑆫𑇀𑆩𑆱𑇀𑆮𑆪𑆾𑆓𑇀𑆪𑆾 𑆨𑆮𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆳𑆬𑆳𑆧𑆷𑆑𑆳𑆬𑆴𑆤𑇀𑆢𑆑𑆠𑇀𑆫𑆥𑆶𑆱𑆽(𑆱𑆾)𑆫𑇀𑆮𑆳𑆫𑆶𑆑𑆫𑇀𑆑𑆳𑆫𑆶𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆗𑆼𑆢𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆢𑆫𑇀𑆯𑆪𑆼𑆠𑇀, 𑆇𑆠𑇀𑆑𑆫𑇀𑆠𑆤𑆳𑆥𑆑𑆫𑇀𑆠𑆤𑆳𑆤𑆴 𑆖𑆾𑆥𑆢𑆴𑆯𑆼𑆠𑇀; 𑆢𑆸𑆠𑆴𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆱𑆼𑆮𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆷𑆢𑆑𑆥𑆕𑇀𑆑𑆥𑆷𑆫𑇀𑆟𑆼𑆰𑆶 𑆨𑆼𑆢𑇀𑆪𑆪𑆾𑆓𑇀𑆪𑆳𑆁; 𑆱𑆫𑆾𑆩𑇀𑆟𑆴 𑆖𑆫𑇀𑆩𑆟𑇀𑆪𑆳𑆠𑆠𑆼 𑆬𑆼𑆒𑇀𑆪𑆱𑇀𑆪; 𑆩𑆸𑆠𑆥𑆯𑆶𑆱𑆴𑆫𑆳𑆱𑆷𑆠𑇀𑆥𑆬𑆤𑆳𑆬𑆼𑆰𑆶 𑆖 𑆮𑆼𑆣𑇀𑆪𑆱𑇀𑆪; 𑆔𑆶𑆟𑆾𑆥𑆲𑆠𑆑𑆳𑆰𑇀𑆜𑆮𑆼𑆟𑆶𑆤𑆬𑆤𑆳𑆬𑆵𑆯𑆶𑆰𑇀𑆑𑆳𑆬𑆳𑆧𑆷𑆩𑆶𑆒𑆼𑆰𑇀𑆮𑆼𑆰𑇀𑆪𑆱𑇀𑆪; 𑆥𑆤𑆱𑆧𑆴𑆩𑇀𑆧𑆵𑆧𑆴𑆬𑇀𑆮𑆦𑆬𑆩𑆘𑇀𑆘𑆩𑆸𑆠𑆥𑆯𑆶𑆢𑆤𑇀𑆠𑆼𑆰𑇀𑆮𑆳𑆲𑆳𑆫𑇀𑆪𑆱𑇀𑆪; 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆾𑆥𑆬𑆴𑆥𑇀𑆠𑆼 𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆦𑆬𑆑𑆼 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆱𑇀𑆪; 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆔𑆤𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑆪𑆾𑆫𑇀𑆩𑆸𑆢𑆶𑆖𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆪𑆾𑆯𑇀𑆖 𑆱𑆵𑆮𑇀𑆪𑆱𑇀𑆪; 𑆥𑆶𑆱𑇀𑆠𑆩𑆪𑆥𑆶𑆫𑆶𑆰𑆳𑆕𑇀𑆓𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆼𑆰𑆶 𑆧𑆤𑇀𑆣𑆤𑆪𑆾𑆓𑇀𑆪𑆳𑆁; 𑆩𑆸𑆢𑆶𑆰𑆶 𑆩𑆳𑆁𑆱𑆒𑆟𑇀𑆝𑆼𑆰𑇀𑆮𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆪𑆾𑆓𑇀𑆪𑆳𑆁; 𑆩𑆸𑆢𑆶𑆖𑆫𑇀𑆩𑆩𑆳𑆁𑆱𑆥𑆼𑆯𑆵𑆰𑆷𑆠𑇀𑆥𑆬𑆤𑆳𑆬𑆼𑆰𑆶 𑆖 𑆑𑆫𑇀𑆟𑆱𑆤𑇀𑆣𑆴𑆧𑆤𑇀𑆣𑆪𑆾𑆓𑇀𑆪𑆳𑆩𑇀; 𑆇𑆢𑆑𑆥𑆷𑆫𑇀𑆟𑆔𑆛𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑇀𑆫𑆾𑆠𑆱𑇀𑆪𑆬𑆳𑆧𑆷𑆩𑆶𑆒𑆳𑆢𑆴𑆰𑆶 𑆖 𑆤𑆼𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆧𑆱𑇀𑆠𑆴𑆮𑇀𑆫𑆟𑆧𑆱𑇀𑆠𑆴𑆥𑆵𑆝𑆤𑆪𑆾𑆓𑇀𑆪𑆳𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆍𑆮𑆩𑆳𑆢𑆴𑆰𑆶 𑆩𑆼𑆣𑆳𑆮𑆵 𑆪𑆾𑆓𑇀𑆪𑆳𑆫𑇀𑆲𑆼𑆰𑆶 𑆪𑆡𑆳𑆮𑆴𑆣𑆴 𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑆶 𑆪𑆾𑆓𑇀𑆪𑆳𑆁 𑆑𑆶𑆫𑇀𑆮𑆳𑆟𑆾 𑆤 𑆥𑇀𑆫𑆩𑆶𑆲𑇀𑆪𑆠𑆴 𑆑𑆫𑇀𑆩𑆱𑆶 𑇆𑇕𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑆿𑆯𑆬𑆩𑆤𑇀𑆮𑆴𑆖𑇀𑆗𑆤𑇀 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆱𑆶 𑇅 𑆪𑆱𑇀𑆪 𑆪𑆠𑇀𑆫𑆼𑆲 𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆁 𑆠𑆠𑇀𑆫 𑆪𑆾𑆓𑇀𑆪𑆳𑆁 𑆱𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇖𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆮𑆴𑆯𑆼𑆰𑆳 𑆫𑆾𑆓𑆼𑆰𑆶 𑆮𑇀𑆫𑆟𑆳𑆱𑇀𑆫𑆳𑆮𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆳𑆢𑆴𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼- ‘𑆠𑆠𑇀𑆫 𑆱𑆦𑆼𑆤𑆁 𑆫𑆑𑇀𑆠𑆩𑆵𑆫𑆪𑆤𑇀𑆤𑆤𑆴𑆬𑆂 𑆱𑆯𑆧𑇀𑆢𑆾 𑆤𑆴𑆫𑇀𑆓𑆖𑇀𑆗𑆠𑆴’(𑆱𑆷. 𑆃.𑇒𑇖) 𑆅𑆠𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆪𑆂, 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆑𑆫𑇀𑆑𑆯𑆩𑆸𑆢𑆶𑆑𑆜𑆴𑆤𑆠𑇀𑆮𑆳𑆢𑆪𑆂 (𑆱𑇀𑆥𑆫𑇀𑆯𑆮𑆴𑆯𑆼𑆰𑆳 ) 𑆘𑇀𑆮𑆫𑆯𑆾𑆦𑆳𑆢𑆴𑆰𑆶, 𑆖𑆑𑇀𑆰𑆶𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆳𑆥𑆖𑆪𑆳𑆪𑆶𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆧𑆬𑆮𑆫𑇀𑆟𑆮𑆴𑆑𑆳𑆫𑆳𑆢𑆪𑆂, 𑆫𑆱𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆢𑆴𑆰𑆶 𑆫𑆱𑆮𑆴𑆯𑆼𑆰𑆳𑆂, 𑆔𑇀𑆫𑆳𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆃𑆫𑆴𑆰𑇀𑆛𑆬𑆴𑆕𑇀𑆓𑆳𑆢𑆴𑆰𑆶 𑆮𑇀𑆫𑆟𑆳𑆤𑆳𑆩𑆮𑇀𑆫𑆟𑆳𑆤𑆳𑆁 𑆖 𑆓𑆤𑇀𑆣𑆮𑆴𑆯𑆼𑆰𑆳𑆂, 𑆥𑇀𑆫𑆯𑇀𑆤𑆼𑆤 𑆖 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆢𑆼𑆯𑆁 𑆑𑆳𑆬𑆁 𑆘𑆳𑆠𑆴𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆳𑆠𑆕𑇀𑆑𑆱𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆁 𑆮𑆼𑆢𑆤𑆳𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆁 𑆧𑆬𑆩𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆁 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆩𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆢𑆵𑆁𑆯𑇀𑆖 𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑇅 𑆄𑆠𑇀𑆩𑆱𑆢𑆸𑆯𑆼𑆰𑆶 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆨𑇀𑆪𑆶𑆥𑆳𑆪𑆼𑆰𑆶 𑆠𑆠𑇀𑆱𑇀𑆡𑆳𑆤𑆵𑆪𑆽𑆫𑇀𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇕𑇆
𑆍𑆮𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑇀 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆪𑆳𑆥𑇀𑆪𑆳𑆤𑇀 𑆪𑆳𑆥𑆪𑆼𑆠𑇀, 𑆃𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑇀𑆤𑆽𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠, 𑆥𑆫𑆴𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆾𑆠𑇀𑆡𑆴𑆠𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇖𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆴𑆡𑇀𑆪𑆳𑆢𑆸𑆰𑇀𑆛𑆳 𑆮𑆴𑆑𑆳𑆫𑆳 𑆲𑆴 𑆢𑆶𑆫𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆱𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆠𑆡𑆳 𑆢𑆶𑆰𑇀𑆥𑆫𑆴𑆩𑆸𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆩𑆾𑆲𑆪𑆼𑆪𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆩𑇀 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆱𑆳𑆣𑇀𑆪𑆳 𑆃𑆥𑆴 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆽𑆰𑆳𑆁 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆠𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆴𑆪𑆤𑆸𑆥𑆠𑆴𑆱𑇀𑆠𑇀𑆫𑆵𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆨𑆵𑆫𑆶𑆫𑆳𑆘𑆱𑆼𑆮𑆑𑆑𑆴𑆠𑆮𑆢𑆶𑆫𑇀𑆧𑆬𑆮𑆽𑆢𑇀𑆪𑆮𑆴𑆢𑆓𑇀𑆣𑆮𑇀𑆪𑆳𑆣𑆴𑆓𑆾𑆥𑆑𑆢𑆫𑆴𑆢𑇀𑆫𑆑𑆸𑆥𑆟𑆑𑇀𑆫𑆾𑆣𑆤𑆳𑆤𑆳𑆩𑆤𑆳𑆠𑇀𑆩𑆮𑆠𑆳𑆩𑆤𑆳𑆡𑆳𑆤𑆳𑆁 𑆖; 𑆍𑆮𑆁 𑆤𑆴𑆫𑆷𑆥𑇀𑆪 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆪𑆯𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑇆𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆠𑇀𑆫𑆵𑆨𑆴𑆂 𑆱𑆲𑆳𑆱𑇀𑆪𑆳𑆁 𑆱𑆁𑆮𑆳𑆱𑆁 𑆥𑆫𑆴𑆲𑆳𑆱𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅 𑆢𑆠𑇀𑆠𑆁 𑆖 𑆠𑆳𑆨𑇀𑆪𑆾 𑆤𑆳𑆢𑆼𑆪𑆩𑆤𑇀𑆤𑆳𑆢𑆤𑇀𑆪𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆮𑆫𑆽𑆂 𑇆𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑇀𑆰𑆳𑆫𑆥𑆳𑆑𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆤𑆶𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆨𑇀𑆪𑆂 𑆑𑇀𑆰𑆳𑆫𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆂, 𑆗𑆼𑆢𑇀𑆪𑆨𑆼𑆢𑇀𑆪𑆬𑆼𑆒𑇀𑆪𑆑𑆫𑆟𑆳𑆠𑇀 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆖𑆳𑆫𑆟𑆳𑆖𑇀𑆖 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆑𑇀𑆰𑆫𑆟𑆳𑆠𑇀 𑆑𑇀𑆰𑆟𑆤𑆳𑆢𑇀𑆮𑆳 𑆑𑇀𑆰𑆳𑆫𑆂 𑇆𑇔𑇆
𑆤𑆳𑆤𑆿𑆰𑆣𑆴𑆱𑆩𑆮𑆳𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆂 , 𑆯𑆶𑆑𑇀𑆬𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆿𑆩𑇀𑆪𑆂; 𑆠𑆱𑇀𑆪 𑆱𑆿𑆩𑇀𑆪𑆱𑇀𑆪𑆳𑆥𑆴 𑆱𑆠𑆾 𑆢𑆲𑆤𑆥𑆖𑆤𑆢𑆳𑆫𑆟𑆳𑆢𑆴𑆯𑆑𑇀𑆠𑆴𑆫𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳, 𑆄𑆓𑇀𑆤𑆼𑆪𑆿𑆰𑆣𑆴𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑆛𑆶𑆑 𑆇𑆰𑇀𑆟𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆥𑆳𑆖𑆤𑆾 𑆮𑆴𑆬𑆪𑆤𑆂 𑆯𑆾𑆣𑆤𑆾 𑆫𑆾𑆥𑆟𑆂 𑆯𑆾𑆰𑆟𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆾 𑆬𑆼𑆒𑆤𑆂 𑆑𑆸𑆩𑇀𑆪𑆳𑆩𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆩𑆼𑆢𑆱𑆳𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆳 𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆖𑆳𑆠𑆴𑆱𑆼𑆮𑆴𑆠𑆂 𑇆𑇕𑇆
𑆱 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂- 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆵𑆪𑆂, 𑆥𑆳𑆤𑆵𑆪𑆯𑇀𑆖 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆵𑆪𑆂 𑆑𑆶𑆰𑇀𑆜𑆑𑆴𑆛𑆴𑆨𑆢𑆢𑇀𑆫𑆶𑆩𑆟𑇀𑆝𑆬𑆑𑆴𑆬𑆳𑆱𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆫𑇀𑆧𑆶𑆢𑆳𑆫𑇀𑆯𑆾𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆤𑆳𑆝𑆵𑆖𑆫𑇀𑆩𑆑𑆵𑆬- 𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆤𑇀𑆪𑆖𑇀𑆗𑆮𑇀𑆪𑆕𑇀𑆓𑆩𑆯𑆑𑆧𑆳𑆲𑇀𑆪𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆳𑆢𑆴𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 , 𑆱𑆥𑇀𑆠𑆱𑆶 𑆖 𑆩𑆶𑆒𑆫𑆾𑆓𑆼𑆰𑆷𑆥𑆘𑆴𑆲𑇀𑆮𑆳𑆣𑆴𑆘𑆴𑆲𑇀𑆮𑆾𑆥𑆑𑆶𑆯𑆢𑆤𑇀𑆠𑆮𑆽𑆢𑆫𑇀𑆨𑆼𑆰𑆶 𑆠𑆴𑆱𑆸𑆰𑆶 𑆖 𑆫𑆾𑆲𑆴𑆟𑆵𑆰𑆶, 𑆍𑆠𑆼𑆰𑇀𑆮𑆼𑆮𑆳𑆤𑆶𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇗𑇆
𑆥𑆳𑆤𑆵𑆪𑆱𑇀𑆠𑆶 𑆓𑆫𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆓𑇀𑆤𑆴𑆱𑆕𑇀𑆓𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆫𑆾𑆖𑆑𑆳𑆤𑆳𑆲- 𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆳𑆫𑇀𑆯𑆂𑆱𑆷𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑇆𑇘𑇆
𑆃𑆲𑆴𑆠𑆱𑇀𑆠𑆶 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆢𑆶𑆫𑇀𑆧𑆬𑆨𑇀𑆫𑆩- 𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆠𑆴𑆩𑆴𑆫𑆥𑆫𑆵𑆠𑆼𑆨𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆯𑇀𑆖𑆽𑆮𑆁𑆮𑆴𑆣𑆼𑆨𑇀𑆪𑆂 𑇆𑇙𑇆
𑆠𑆁 𑆖𑆼𑆠𑆫𑆑𑇀𑆰𑆳𑆫𑆮𑆢𑇀𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀; 𑆠𑆱𑇀𑆪 𑆮𑆴𑆱𑇀𑆠𑆫𑆾𑇁𑆤𑇀𑆪𑆠𑇀𑆫 𑇆𑇑𑇐𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆤𑆽𑆮𑆳𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾 𑆤 𑆩𑆸𑆢𑆶𑆂 𑆯𑆶𑆑𑇀𑆬𑆂 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆾𑇁𑆡 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆂 𑇅 𑆃𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆵 𑆯𑆴𑆮𑆂 𑆯𑆵𑆔𑇀𑆫𑆂 𑆑𑇀𑆰𑆳𑆫𑆾 𑆲𑇀𑆪𑆰𑇀𑆛𑆓𑆶𑆟𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇑𑇖𑇆
𑆃𑆠𑆴𑆩𑆳𑆫𑇀𑆢𑆮𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆱𑆫𑇀𑆥𑆴𑆠𑆳𑆂 𑇅 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆠𑆳𑇁𑆥𑆑𑇀𑆮𑆠𑆳 𑆲𑆵𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆠𑆳 𑆢𑆾𑆰 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆑𑇀𑆰𑆳𑆫𑆱𑆳𑆣𑇀𑆪𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 𑆤𑆴𑆮𑆳𑆠𑆳𑆠𑆥𑆼 𑆢𑆼𑆯𑆼𑇁𑆱𑆩𑇀𑆧𑆳𑆣𑆼𑇁𑆓𑇀𑆫𑆾𑆥𑆲𑆫𑆟𑆵𑆪𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆱𑆩𑇀𑆨𑆸𑆠𑆱𑆩𑇀𑆨𑆳𑆫𑆁, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆠𑆩𑆮𑆑𑆳𑆯𑆁 𑆤𑆴𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆔𑆸𑆰𑇀𑆪𑆳𑆮𑆬𑆴𑆒𑇀𑆪 𑆥𑇀𑆫𑆖𑇀𑆗𑆪𑆴𑆠𑇀𑆮𑆳 , 𑆯𑆬𑆳𑆑𑆪𑆳 𑆑𑇀𑆰𑆳𑆫𑆁 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆪𑆼𑆠𑇀, 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆮𑆳𑆑𑇀𑆯𑆠𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠 𑇆𑇑𑇘𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆴𑆥𑆠𑆴𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆿 𑆑𑆸𑆰𑇀𑆟𑆠𑆳 𑆢𑆓𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅𑇑𑇙𑇅 𑆠𑆠𑇀𑆫𑆳𑆩𑇀𑆬𑆮𑆫𑇀𑆓𑆂 𑆯𑆩𑆤𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆑𑆱𑆁𑆪𑆶𑆠𑆂 𑇆𑇑𑇙𑇆
𑆃𑆡 𑆖𑆼𑆠𑇀 𑆱𑇀𑆡𑆴𑆫𑆩𑆷𑆬𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆢𑆓𑇀𑆣𑆁 𑆤 𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑇅 𑆅𑆢𑆩𑆳𑆬𑆼𑆥𑆤𑆁 𑆠𑆠𑇀𑆫 𑆱𑆩𑆓𑇀𑆫𑆩𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆃𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆧𑆵𑆘𑆳𑆤𑆴 𑆠𑆴𑆬𑆳𑆤𑇀 𑆩𑆣𑆶𑆑𑆩𑆼𑆮 𑆖 𑇅 𑆥𑇀𑆫𑆥𑆼𑆰𑇀𑆪 𑆱𑆩𑆨𑆳𑆓𑆳𑆤𑆴 𑆠𑆼𑆤𑆽𑆤𑆩𑆤𑆶𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆂 𑆱𑆩𑆣𑆶𑆑𑆾 𑆔𑆸𑆠𑆳𑆑𑇀𑆠𑆾 𑆮𑇀𑆫𑆟𑆫𑆾𑆥𑆟𑆂 𑇅𑇒𑇒𑇅 𑆫𑆱𑆼𑆤𑆳𑆩𑇀𑆬𑆼𑆤 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆼𑆤 𑆮𑆵𑆫𑇀𑆪𑆾𑆰𑇀𑆟𑆼𑆤 𑆖 𑆪𑆾𑆘𑆴𑆠𑆂 𑇆𑇒𑇒𑇆
𑆄𑆓𑇀𑆤𑆼𑆪𑆼𑆤𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑆠𑆶𑆬𑇀𑆪𑆂 𑆑𑆡𑆁 𑆑𑇀𑆰𑆳𑆫𑆂 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑇅 𑆍𑆮𑆁 𑆖𑆼𑆤𑇀𑆩𑆤𑇀𑆪𑆱𑆼 𑆮𑆠𑇀𑆱! 𑆥𑇀𑆫𑆾𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇆𑇒𑇓𑇆
𑆃𑆩𑇀𑆬𑆮𑆫𑇀𑆘𑆳𑆤𑇀 𑆫𑆱𑆳𑆤𑇀 𑆑𑇀𑆰𑆳𑆫𑆼 𑆱𑆫𑇀𑆮𑆳𑆤𑆼𑆮 𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇅 𑆑𑆛𑆶𑆑𑆱𑇀𑆠𑆠𑇀𑆫 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆾 𑆬𑆮𑆟𑆾𑇁𑆤𑆶𑆫𑆱𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆩𑇀𑆬𑆼𑆤 𑆱𑆲 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆂 𑆱 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆬𑆮𑆟𑆾 𑆫𑆱𑆼 𑇆𑇒𑇔𑇆
𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁 𑆨𑆘𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆨𑆳𑆮𑆁 𑆮𑆴𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑇅 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆩𑆩𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆮𑆲𑇀𑆤𑆴𑆫𑆢𑇀𑆨𑆴𑆫𑆴𑆮𑆳𑆥𑇀𑆬𑆶𑆠𑆂 𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆼 𑆮𑆴𑆑𑆳𑆫𑆾𑆥𑆯𑆩𑆾 𑆬𑆳𑆔𑆮𑆩𑆤𑆳𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖 𑇅𑇒𑇖𑇅 𑆲𑆵𑆤𑆢𑆓𑇀𑆣𑆼 𑆠𑆾𑆢𑆑𑆟𑇀𑆝𑆶𑆘𑆳𑆝𑇀𑆪𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑇅𑇒𑇖𑇅 𑆃𑆠𑆴𑆢𑆓𑇀𑆣𑆼 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆱𑇀𑆫𑆳𑆮𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆑𑇀𑆬𑆩𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆩𑆫𑆟𑆁 𑆮𑆳 𑇆𑇒𑇖𑇆
𑆑𑇀𑆰𑆳𑆫𑆢𑆓𑇀𑆣𑆮𑇀𑆫𑆟𑆁 𑆠𑆶 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑆴 𑆖𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇆𑇒𑇗𑇆
𑆃𑆡 𑆤𑆽𑆠𑆼 𑆑𑇀𑆰𑆳𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆂- 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆶𑆫𑇀𑆧𑆬𑆧𑆳𑆬𑆱𑇀𑆡𑆮𑆴𑆫𑆨𑆵𑆫𑆶𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆯𑆷𑆤𑆾𑆢𑆫𑆴𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆸𑆠𑆶𑆩𑆠𑆵𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆘𑇀𑆮𑆫𑆴𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆫𑆷𑆑𑇀𑆰𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟- 𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆑𑇀𑆬𑆵𑆧𑆳𑆥𑆮𑆸𑆠𑇀𑆠𑆾𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆦𑆬𑆪𑆾𑆤𑆪𑆂 𑇆𑇒𑇘𑇆
𑆠𑆡𑆳 𑆩𑆫𑇀𑆩𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑆴𑆠𑆫𑆶𑆟𑆳𑆱𑇀𑆡𑆴𑆱𑆼𑆮𑆤𑆵𑆣𑆩𑆤𑆵𑆓𑆬𑆤𑆳𑆨𑆴𑆤𑆒𑆳𑆤𑇀𑆠𑆂𑆯𑆼𑆦𑆂𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆬𑇀𑆥𑆩𑆳𑆁𑆱𑆼𑆰𑆶 𑆖 𑆢𑆼𑆯𑆼𑆰𑇀𑆮𑆑𑇀𑆰𑇀𑆟𑆾𑆯𑇀𑆖 𑆤 𑆢𑆢𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆫𑇀𑆠𑇀𑆩𑆫𑆾𑆓𑆳𑆠𑇀 𑇆𑇒𑇙𑇆
𑆠𑆠𑇀𑆫 𑆑𑇀𑆰𑆳𑆫𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑇀𑆮𑆥𑆴 𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆯𑆷𑆤𑆓𑆳𑆠𑇀𑆫𑆩𑆱𑇀𑆡𑆴𑆯𑆷𑆬𑆴𑆤𑆩𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆁 𑆲𑆸𑆢𑆪𑆱𑆤𑇀𑆣𑆴𑆥𑆵𑆝𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆁 𑆖 𑆑𑇀𑆰𑆳𑆫𑆾 𑆤 𑆱𑆳𑆣𑆪𑆠𑆴 (𑆢𑆶𑆫𑇀𑆧𑆬𑆧𑆳𑆬𑆱𑇀𑆡𑆮𑆴𑆫𑆳𑆢𑆵𑆤𑇀 𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆵𑆪 𑆅𑆠𑆴) 𑇆𑇓𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆴𑆰𑆳𑆓𑇀𑆤𑆴𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆯𑆤𑆴𑆩𑆸𑆠𑇀𑆪𑆶𑆑𑆬𑇀𑆥𑆂 𑆑𑇀𑆰𑆳𑆫𑆾 𑆨𑆮𑆠𑇀𑆪𑆬𑇀𑆥𑆩𑆠𑆴𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑇅 𑆱 𑆣𑆵𑆩𑆠𑆳 𑆱𑆩𑇀𑆪𑆓𑆤𑆶𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆾 𑆫𑆾𑆓𑆳𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆢𑆖𑆴𑆫𑆼𑆟 𑆔𑆾𑆫𑆳𑆤𑇀 𑇆𑇓𑇑𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆑𑇀𑆰𑆳𑆫𑆳𑆢𑆓𑇀𑆤𑆴𑆫𑇀𑆓𑆫𑆵𑆪𑆳𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂, 𑆠𑆢𑇀𑆢𑆓𑇀𑆣𑆳𑆤𑆳𑆁 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆥𑆶𑆤𑆫𑇀𑆨𑆳𑆮𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆽𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑆠𑇀𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑇆𑇓𑇆
𑆃𑆡𑆼𑆩𑆳𑆤𑆴 𑆢𑆲𑆤𑆾𑆥𑆑𑆫𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴- 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆘𑆳𑆯𑆑𑆸𑆢𑇀𑆓𑆾𑆢𑆤𑇀𑆠𑆯𑆫𑆯𑆬𑆳𑆑𑆳𑆘𑆳𑆩𑇀𑆧𑆮𑆿𑆰𑇀𑆜𑆼𑆠𑆫𑆬𑆿𑆲𑆳𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆓𑆶𑆝𑆱𑇀𑆤𑆼𑆲𑆳𑆯𑇀𑆖 𑇅 𑆠𑆠𑇀𑆫, 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆘𑆳𑆯𑆑𑆸𑆢𑇀𑆓𑆾𑆢𑆤𑇀𑆠𑆯𑆫𑆯𑆬𑆳𑆑𑆳𑆱𑇀𑆠𑇀𑆮𑆓𑇀𑆓𑆠𑆳𑆤𑆳𑆁, 𑆘𑆳𑆩𑇀𑆧𑆮𑆿𑆰𑇀𑆜𑆼𑆠𑆫𑆬𑆿𑆲𑆳 𑆩𑆳𑆁𑆱𑆓𑆠𑆳𑆤𑆳𑆁, 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆓𑆶𑆝𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆓𑆠𑆳𑆤𑆳𑆩𑇀 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩 𑆱𑆫𑇀𑆮𑆫𑇀𑆠𑆶𑆰𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫 𑆯𑆫𑆢𑇀𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆳𑆨𑇀𑆪𑆳𑆁; 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆼𑇁𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆱𑆳𑆣𑇀𑆪𑆼 𑆮𑇀𑆪𑆳𑆣𑆿 𑆠𑆠𑇀𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆁 𑆮𑆴𑆣𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑇆𑇕𑇆
𑆱𑆫𑇀𑆮𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶 𑆖 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑆤𑇀𑆤𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆂; 𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆳𑆯𑇀𑆩𑆫𑆵𑆨𑆓𑆤𑇀𑆢𑆫𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆾𑆩𑆶𑆒𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆂 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩𑆳𑆲𑆶𑆫𑆼𑆑𑆼- 𑆠𑇀𑆮𑆓𑇀𑆢𑆓𑇀𑆣𑆁, 𑆩𑆳𑆁𑆱𑆢𑆓𑇀𑆣𑆁 𑆖; 𑆅𑆲 𑆠𑆶 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆰𑇀𑆮𑆥𑆴 𑆤 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆾𑇁𑆓𑇀𑆤𑆴𑆂 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫, 𑆯𑆧𑇀𑆢𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆠𑆳 𑆠𑇀𑆮𑆑𑇀𑆱𑆕𑇀𑆑𑆾𑆖𑆯𑇀𑆖 𑆠𑇀𑆮𑆓𑇀𑆢𑆓𑇀𑆣𑆼, 𑆑𑆥𑆾𑆠𑆮𑆫𑇀𑆟𑆠𑆳𑇁𑆬𑇀𑆥𑆯𑇀𑆮𑆪𑆡𑆶𑆮𑆼𑆢𑆤𑆳 𑆯𑆶𑆰𑇀𑆑𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆮𑇀𑆫𑆟𑆠𑆳 𑆖 𑆩𑆳𑆁𑆱𑆢𑆓𑇀𑆣𑆼; 𑆑𑆸𑆰𑇀𑆟𑆾𑆤𑇀𑆤𑆠𑆮𑇀𑆫𑆟𑆠𑆳 𑆱𑇀𑆫𑆳𑆮𑆱𑆤𑇀𑆤𑆴𑆫𑆾𑆣𑆯𑇀𑆖 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆢𑆓𑇀𑆣𑆼, 𑆫𑆷𑆑𑇀𑆰𑆳𑆫𑆶𑆟𑆠𑆳 𑆑𑆫𑇀𑆑𑆯𑆱𑇀𑆡𑆴𑆫𑆮𑇀𑆫𑆟𑆠𑆳 𑆖 𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆢𑆓𑇀𑆣𑆼 𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆣𑆴𑆩𑆤𑇀𑆡𑆪𑆾𑆫𑇀𑆨𑇀𑆫𑆷𑆬𑆬𑆳𑆛𑆯𑆕𑇀𑆒𑆥𑇀𑆫𑆢𑆼𑆯𑆼𑆰𑆶 𑆢𑆲𑆼𑆠𑇀, 𑆮𑆫𑇀𑆠𑇀𑆩𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆳𑆫𑇀𑆢𑇀𑆫𑆳𑆬𑆑𑇀𑆠𑆑𑆥𑇀𑆫𑆠𑆴𑆖𑇀𑆗𑆤𑇀𑆤𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆫𑇀𑆠𑇀𑆩𑆫𑆾𑆩𑆑𑆷𑆥𑆳𑆤𑇀 𑇆𑇙𑇆
𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆱𑇀𑆡𑆴𑆠𑆼𑇁𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆫𑆶𑆘𑆴 𑆮𑆳𑆪𑆳𑆮𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆑𑆜𑆴𑆤𑆱𑆶𑆥𑇀𑆠𑆩𑆳𑆁𑆱𑆼 𑆮𑇀𑆫𑆟𑆼 𑆓𑇀𑆫𑆤𑇀𑆡𑇀𑆪𑆫𑇀𑆯𑆾𑇁𑆫𑇀𑆧𑆶𑆢𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆥𑆖𑆵𑆯𑇀𑆬𑆵𑆥𑆢𑆖𑆫𑇀𑆩𑆑𑆵𑆬𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆳𑆤𑇀𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆱𑆤𑇀𑆣𑆴𑆱𑆴𑆫𑆳𑆖𑇀𑆗𑆼𑆢𑆤𑆳𑆢𑆴𑆰𑆶 𑆤𑆳𑆝𑆵𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆰𑆶 𑆖𑆳𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆮𑆬𑆪-𑆧𑆴𑆤𑇀𑆢𑆶-𑆮𑆴𑆬𑆼𑆒𑆳-𑆥𑇀𑆫𑆠𑆴𑆱𑆳𑆫𑆟𑆳𑆤𑆵𑆠𑆴 𑆢𑆲𑆤𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑇆𑇑𑇑𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆫𑆾𑆓𑆱𑇀𑆪 𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆱𑆩𑇀𑆪𑆕𑇀𑆤𑆫𑆱𑇀𑆪 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆧𑆬𑆳𑆧𑆬𑆁 𑆖 𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆠𑆡𑆫𑇀𑆠𑆶𑆁 𑆖 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆩𑇀𑆪𑆑𑇀 𑆠𑆠𑆾𑇁𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆓𑆓𑇀𑆤𑆴𑆑𑆫𑇀𑆩 𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆼 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆂 𑇆𑇑𑇓𑇆
𑆃𑆡𑆼𑆩𑆳𑆤𑆓𑇀𑆤𑆴𑆤𑆳 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀- 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆤𑇀𑆠𑆂𑆯𑆾𑆟𑆴𑆠𑆁 𑆨𑆴𑆤𑇀𑆤𑆑𑆾𑆰𑇀𑆜𑆩𑆤𑆶𑆢𑇀𑆣𑆸𑆠𑆯𑆬𑇀𑆪𑆁 𑆢𑆶𑆫𑇀𑆧𑆬𑆁 𑆧𑆳𑆬𑆁 𑆮𑆸𑆢𑇀𑆣𑆁 𑆨𑆵𑆫𑆶𑆩𑆤𑆼𑆑𑆮𑇀𑆫𑆟𑆥𑆵𑆝𑆴𑆠𑆩𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆁𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇔𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆴𑆠𑆫𑆡𑆳𑆢𑆓𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆮𑆳𑇁𑇁(𑆖𑆳)𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆫𑇀𑆢𑆲𑆠𑆴; 𑆃𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆾 𑆲𑆴 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑆴𑆫𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆤𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆯𑆶 𑆢𑆲𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆢𑆓𑇀𑆣𑆼𑇁𑆣𑆴𑆑𑆳 𑆫𑆶𑆘𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆬𑆶𑆰𑇀𑆛𑆁 𑆢𑆶𑆫𑇀𑆢𑆓𑇀𑆣𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆩𑆠𑆴𑆢𑆓𑇀𑆣𑆁 𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆩𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆪𑆢𑇀𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆥𑇀𑆬𑆶𑆰𑇀𑆪𑆠𑆼𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆠𑇀 𑆥𑇀𑆬𑆶𑆰𑇀𑆛𑆁; 𑆪𑆠𑇀𑆫𑆾𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴 𑆱𑇀𑆦𑆾𑆛𑆳𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆳𑆯𑇀𑆖𑆾𑆰𑆢𑆳𑆲𑆫𑆳𑆓𑆥𑆳𑆑𑆮𑆼𑆢𑆤𑆳𑆯𑇀𑆖𑆴𑆫𑆳𑆖𑇀𑆖𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆠𑆢𑇀𑆢𑆶𑆫𑇀𑆢𑆓𑇀𑆣𑆁; 𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆩𑆤𑆮𑆓𑆳𑆞𑆁 𑆠𑆳𑆬𑆮𑆫𑇀𑆟𑆁 𑆱𑆶𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆁 𑆥𑆷𑆫𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆪𑆶𑆑𑇀𑆠𑆁 𑆖; 𑆃𑆠𑆴𑆢𑆓𑇀𑆣𑆼 𑆩𑆳𑆁𑆱𑆳𑆮𑆬𑆩𑇀𑆧𑆤𑆁 𑆓𑆳𑆠𑇀𑆫𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆂 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆤𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆯𑇀𑆖𑆾𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆮𑇀𑆫𑆟𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆖𑆴𑆫𑆼𑆟 𑆫𑆾𑆲𑆠𑆴, 𑆫𑆷𑆞𑆯𑇀𑆖 𑆮𑆴𑆮𑆫𑇀𑆟𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆠𑆢𑆼𑆠𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆩𑆳𑆠𑇀𑆩𑆑𑆫𑇀𑆩𑆥𑇀𑆫𑆱𑆳𑆣𑆑𑆁 𑆨𑆮𑆠𑆴 𑇆𑇑𑇖𑇆
𑆠𑆶𑆬𑇀𑆪𑆮𑆵𑆫𑇀𑆪𑆼 𑆇𑆨𑆼 𑆲𑇀𑆪𑆼𑆠𑆼 𑆫𑆱𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆠𑆱𑇀𑆠𑆡𑆳 𑇅 𑆠𑆼𑆤𑆳𑆱𑇀𑆪 𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆖 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑇆𑇑𑇘𑇆
𑆱𑇀𑆦𑆾𑆛𑆳𑆂 𑆯𑆵𑆔𑇀𑆫𑆁 𑆥𑇀𑆫𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆖 𑆧𑆳𑆣𑆠𑆼 𑇅𑇑𑇙𑇅 𑆢𑆓𑇀𑆣𑆱𑇀𑆪𑆾𑆥𑆯𑆩𑆳𑆫𑇀𑆡𑆳𑆪 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇑𑇙𑇆
𑆥𑇀𑆬𑆶𑆰𑇀𑆛𑆱𑇀𑆪𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆠𑆥𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆡𑆿𑆰𑆣𑆩𑇀 𑇅 𑆯𑆫𑆵𑆫𑆼 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆼 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆨𑆮𑆠𑆴 𑆯𑆾𑆟𑆴𑆠𑆩𑇀 𑇆𑇒𑇐𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆲𑇀𑆪𑆶𑆢𑆑𑆁 𑆯𑆵𑆠𑆁 𑆱𑇀𑆑𑆤𑇀𑆢𑆪𑆠𑇀𑆪𑆠𑆴𑆯𑆾𑆟𑆴𑆠𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆶𑆒𑆪𑆠𑆴 𑆲𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆤𑆤𑆶 𑆯𑆵𑆠𑆁 𑆑𑆡𑆚𑇀𑆖𑆤 𑇆𑇒𑇑𑇆
𑆯𑆵𑆠𑆳𑆩𑆶𑆰𑇀𑆟𑆳𑆁 𑆖 𑆢𑆶𑆫𑇀𑆢𑆓𑇀𑆣𑆼 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆥𑆶𑆤𑆂 𑇅 𑆔𑆸𑆠𑆳𑆬𑆼𑆥𑆤𑆱𑆼𑆑𑆳𑆁𑆱𑇀𑆠𑆶 𑆯𑆵𑆠𑆳𑆤𑆼𑆮𑆳𑆱𑇀𑆪 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇒𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆓𑇀𑆣𑆼 𑆠𑆶𑆓𑆳𑆑𑇀𑆰𑆵𑆫𑆵𑆥𑇀𑆬𑆑𑇀𑆰𑆖𑆤𑇀𑆢𑆤𑆓𑆽𑆫𑆴𑆑𑆽𑆂 𑇅 𑆱𑆳𑆩𑆸𑆠𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑆳𑆬𑆼𑆥𑆁 𑆑𑆳𑆫𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇒𑇓𑇆
𑆃𑆠𑆴𑆢𑆓𑇀𑆣𑆼 𑆮𑆴𑆯𑆵𑆫𑇀𑆟𑆳𑆤𑆴 𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆪𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆯𑆵𑆠𑆬𑆳𑆩𑇀 𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆥𑆯𑇀𑆖𑆳𑆖𑇀𑆗𑆳𑆬𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆑𑆟𑇀𑆝𑆤𑆽𑆂 𑇆𑇒𑇕𑇆
𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆵𑆠𑇀𑆮𑆑𑇀𑆑𑆥𑆳𑆬𑆽𑆫𑇀𑆮𑆳 𑆔𑆸𑆠𑆩𑆴𑆯𑇀𑆫𑆽𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇅 𑆮𑇀𑆫𑆟𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆗𑆳𑆢𑆪𑆼𑆢𑆡𑆮𑆿𑆢𑆑𑆽𑆂 𑇆𑇒𑇖𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆖 𑆤𑆴𑆒𑆴𑆬𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆮𑆠𑇀 𑇅𑇒𑇗𑇅 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆁 𑆱𑆩𑆣𑆶𑆑𑆁 𑆫𑆾𑆣𑇀𑆫𑆁 𑆱𑆫𑇀𑆘𑆫𑆱𑆁 𑆠𑆡𑆳 𑇆𑇒𑇗𑇆
𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆁 𑆖𑆤𑇀𑆢𑆤𑆁 𑆩𑆷𑆫𑇀𑆮𑆳𑆁 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀 𑇅 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆳𑆤𑆳𑆩𑆼𑆠𑆢𑇀𑆫𑆾𑆥𑆟𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇒𑇘𑇆
𑆱𑇀𑆤𑆼𑆲𑆢𑆓𑇀𑆣𑆼 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆫𑆷𑆑𑇀𑆰𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅𑇒𑇙𑇅 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆣𑆷𑆩𑆾𑆥𑆲𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇒𑇙𑇆
𑆯𑇀𑆮𑆱𑆴𑆠𑆴 𑆑𑇀𑆰𑆿𑆠𑆴 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆥𑇀𑆪𑆳𑆣𑆩𑆠𑆴 𑆑𑆳𑆱𑆠𑆼 𑇅 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆂 𑆥𑆫𑆴𑆢𑆳𑆲𑆯𑇀𑆖 𑆫𑆳𑆓𑆯𑇀𑆖𑆽𑆮𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇆𑇓𑇐𑇆
𑆱𑆣𑆷𑆩𑆑𑆁 𑆤𑆴𑆯𑇀𑆮𑆱𑆴𑆠𑆴 𑆔𑇀𑆫𑆼𑆪𑆩𑆤𑇀𑆪𑆤𑇀𑆤 𑆮𑆼𑆠𑇀𑆠𑆴 𑆖 𑇅 𑆠𑆡𑆽𑆮 𑆖 𑆫𑆱𑆳𑆤𑇀 𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆯𑇀𑆫𑆶𑆠𑆴𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆾𑆥𑆲𑆤𑇀𑆪𑆠𑆼 𑇆𑇓𑇑𑇆
𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆪𑆶𑆠𑆂 𑆱𑆵𑆢𑆠𑇀𑆪𑆡 𑆖 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆠𑆴 𑇅 𑆣𑆷𑆩𑆾𑆥𑆲𑆠 𑆅𑆠𑇀𑆪𑆼𑆰𑆂 𑆯𑆸𑆟𑆶 𑆠𑆱𑇀𑆪 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇆𑇓𑇒𑇆
𑆱𑆫𑇀𑆥𑆴𑆫𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆥𑆪𑆾 𑆮𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑇀𑆧𑆶 𑆮𑆳 𑇅 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆿 𑆫𑆱𑆿 𑆮𑆳𑇁𑆥𑆴 𑆮𑆩𑆤𑆳𑆪 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇓𑇓𑇆
𑆮𑆩𑆠𑆂 𑆑𑆾𑆰𑇀𑆜𑆯𑆶𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆣𑆷𑆩𑆓𑆤𑇀𑆣𑆯𑇀𑆖 𑆤𑆯𑇀𑆪𑆠𑆴 𑇅 𑆮𑆴𑆣𑆴𑆤𑆳𑇁𑆤𑆼𑆤 𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆱𑆢𑆤𑆑𑇀𑆰𑆮𑆡𑆶𑆘𑇀𑆮𑆫𑆳𑆂 𑇆𑇓𑇔𑇆
𑆢𑆳𑆲𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆠𑆸𑆝𑆳𑆣𑇀𑆩𑆳𑆤𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆯𑇀𑆖 𑆢𑆳𑆫𑆶𑆟𑆳𑆂 𑇅 𑆩𑆣𑆶𑆫𑆽𑆫𑇀𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆽𑆯𑇀𑆖 𑆑𑆛𑆶𑆑𑆽𑆂 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆽𑆂 𑇆𑇓𑇕𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆤𑇀 𑆩𑆤𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆱𑆵𑆢𑆠𑆴 𑇅 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆾𑆓𑆼𑆤 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆠𑇀 𑇆𑇓𑇖𑇆
𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑇀𑆮𑆴𑆯𑆶𑆣𑇀𑆪𑆠𑆼 𑆖𑆳𑆱𑇀𑆪 𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆁 𑆖 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆃𑆮𑆴𑆢𑆳𑆲𑆴 𑆬𑆔𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆳𑆲𑆳𑆫𑆁 𑆖𑆳𑆱𑇀𑆪 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇓𑇗𑇆
𑆇𑆰𑇀𑆟𑆮𑆳𑆠𑆳𑆠𑆥𑆽𑆫𑇀𑆢𑆓𑇀𑆣𑆼 𑆯𑆵𑆠𑆂 𑆑𑆳𑆫𑇀𑆪𑆾 𑆮𑆴𑆣𑆴𑆂 𑆱𑆢𑆳 𑇅 𑆯𑆵𑆠𑆮𑆫𑇀𑆰𑆳𑆤𑆴𑆬𑆽𑆫𑇀𑆢𑆓𑇀𑆣𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆶𑆰𑇀𑆟𑆁 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇓𑇘𑇆
𑆠𑆡𑆳𑇁𑆠𑆴𑆠𑆼𑆘𑆱𑆳 𑆢𑆓𑇀𑆣𑆼 𑆱𑆴𑆢𑇀𑆣𑆫𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆑𑆡𑆚𑇀𑆖𑆤 𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆮𑆘𑇀𑆫𑆳𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆼𑇁𑆥𑆴 𑆘𑆵𑆮𑆠𑆴 𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆥𑆫𑆵𑆰𑆼𑆑𑆽𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆽𑆯𑇀𑆖 𑆠𑆡𑆳 𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆘𑆬𑆿𑆑𑆳𑆮𑆖𑆳𑆫𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆸𑆥𑆳𑆞𑇀𑆪𑆧𑆳𑆬𑆱𑇀𑆡𑆮𑆴𑆫𑆨𑆵𑆫𑆶𑆢𑆶𑆫𑇀𑆧𑆬𑆤𑆳𑆫𑆵𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑆳𑆩𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆁 𑆥𑆫𑆩𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆾𑇁𑆪𑆁 𑆯𑆾𑆟𑆴𑆠𑆳𑆮𑆱𑆼𑆖𑆤𑆾𑆥𑆳𑆪𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆾 𑆘𑆬𑆿𑆑𑆱𑆂 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆁 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆁 𑆯𑆸𑆕𑇀𑆓𑆘𑆬𑆿𑆑𑆳𑆬𑆳𑆧𑆶𑆨𑆴𑆫𑆮𑆱𑆼𑆖𑆪𑆼𑆠𑇀, 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑆫𑇀𑆮𑆽𑆫𑇀𑆮𑆳 (𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆶 𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁 𑆯𑆸𑆕𑇀𑆓𑆘𑆬𑆿𑆑𑆳𑆬𑆳𑆧𑆶𑆨𑆴𑆫𑇀𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀) 𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆇𑆰𑇀𑆟𑆁 𑆱𑆩𑆣𑆶𑆫𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆓𑆮𑆳𑆁 𑆯𑆸𑆕𑇀𑆓𑆁 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆳𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆠𑆶 𑆲𑆴𑆠𑆁 𑆠𑆢𑆮𑆱𑆼𑆖𑆤𑆼 𑇆𑇕𑇆
𑆯𑆵𑆠𑆳𑆣𑆴𑆮𑆳𑆱𑆳 𑆩𑆣𑆶𑆫𑆳 𑆘𑆬𑆿𑆑𑆳 𑆮𑆳𑆫𑆴𑆱𑆩𑇀𑆨𑆮𑆳 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆠𑆶 𑆲𑆴𑆠𑆳 𑆱𑆳 𑆠𑇀𑆮𑆮𑆱𑆼𑆖𑆤𑆼 𑇆𑇖𑇆
𑆃𑆬𑆳𑆧𑆶 𑆑𑆛𑆶𑆑𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆖 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆠𑆶 𑆲𑆴𑆠𑆁 𑆠𑆢𑆮𑆱𑆼𑆖𑆤𑆼 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆖𑇀𑆗𑆴𑆠𑆼 𑆠𑆤𑆶𑆧𑆱𑇀𑆠𑆴𑆥𑆛𑆬𑆳𑆮𑆤𑆢𑇀𑆣𑆼𑆤 𑆯𑆸𑆕𑇀𑆓𑆼𑆟 𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆱𑆼𑆖𑆪𑆼𑆢𑆳𑆖𑆷𑆰𑆟𑆳𑆠𑇀, 𑆱𑆳𑆤𑇀𑆠𑆫𑇀𑆢𑆵𑆥𑆪𑆳𑇁𑆬𑆳𑆧𑇀𑆮𑆳 (𑆘𑆬𑆳𑆪𑆶𑆑𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼) 𑇆𑇘𑇆
𑆘𑆬𑆩𑆳𑆱𑆳𑆩𑆳𑆪𑆶𑆫𑆴𑆠𑆴 𑆘𑆬𑆳𑆪𑆶𑆑𑆳𑆂, 𑆘𑆬𑆩𑆳𑆱𑆳𑆩𑆾𑆑 𑆅𑆠𑆴 𑆘𑆬𑆿𑆑𑆱𑆂 𑇆𑇙𑇆
𑆠𑆳 𑆢𑇀𑆮𑆳𑆢𑆯; 𑆠𑆳𑆱𑆳𑆁 𑆱𑆮𑆴𑆰𑆳𑆂 𑆰𑆛𑇀, 𑆠𑆳𑆮𑆠𑇀𑆪 𑆍𑆮 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆳𑆂 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆱𑆮𑆴𑆰𑆳𑆂- 𑆑𑆸𑆰𑇀𑆟𑆳, 𑆑𑆫𑇀𑆧𑆶𑆫𑆳, 𑆃𑆬𑆓𑆫𑇀𑆢𑆳, 𑆅𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆣𑆳, 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑆳, 𑆓𑆾𑆖𑆤𑇀𑆢𑆤𑆳 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆳𑆱𑆶, 𑆃𑆚𑇀𑆘𑆤𑆖𑆷𑆫𑇀𑆟𑆮𑆫𑇀𑆟𑆳 𑆥𑆸𑆡𑆶𑆯𑆴𑆫𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆳; 𑆮𑆫𑇀𑆩𑆴𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆢𑆳𑆪𑆠𑆳 𑆗𑆴𑆤𑇀𑆤𑆾𑆤𑇀𑆤𑆠𑆑𑆶𑆑𑇀𑆰𑆴𑆂 𑆑𑆫𑇀𑆧𑆶𑆫𑆳; 𑆫𑆾𑆩𑆯𑆳 𑆩𑆲𑆳𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳 𑆑𑆸𑆰𑇀𑆟𑆩𑆶𑆒𑆵 𑆃𑆬𑆓𑆫𑇀𑆢𑆳; 𑆅𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆣𑆮𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆫𑆳𑆘𑆴𑆨𑆴𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆳 𑆅𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆣𑆳; 𑆆𑆰𑆢𑆱𑆴𑆠𑆥𑆵𑆠𑆴𑆑𑆳 𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆥𑆶𑆰𑇀𑆥𑆳𑆑𑆸𑆠𑆴𑆖𑆴𑆠𑇀𑆫𑆳 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑆳𑆂; 𑆓𑆾𑆮𑆸𑆰𑆟𑆮𑆢𑆣𑆾𑆨𑆳𑆓𑆼 𑆢𑇀𑆮𑆴𑆣𑆳𑆨𑆷𑆠𑆳𑆑𑆸𑆠𑆴𑆫𑆟𑆶𑆩𑆶𑆒𑆵 𑆓𑆾𑆖𑆤𑇀𑆢𑆤𑆼𑆠𑆴 𑇅 𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆥𑆶𑆫𑆶𑆰𑆼 𑆢𑆁𑆯𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆑𑆟𑇀𑆝𑆷𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆘𑇀𑆮𑆫𑆾 𑆢𑆳𑆲𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆩𑆢𑆂 𑆱𑆢𑆤𑆩𑆴𑆠𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆩𑆲𑆳𑆓𑆢𑆂 𑆥𑆳𑆤𑆳𑆬𑆼𑆥𑆤𑆤𑆱𑇀𑆪𑆑𑆫𑇀𑆩𑆳𑆢𑆴𑆰𑆷𑆥𑆪𑆾𑆘𑇀𑆪𑆂 𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆣𑆳𑆢𑆰𑇀𑆛𑆩𑆱𑆳𑆣𑇀𑆪𑆩𑇀 𑇅 𑆅𑆠𑇀𑆪𑆼𑆠𑆳𑆂 𑆱𑆮𑆴𑆰𑆳𑆂 𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇑𑇆
𑆃𑆡 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆳𑆂- 𑆑𑆥𑆴𑆬𑆳, 𑆥𑆴𑆕𑇀𑆓𑆬𑆳, 𑆯𑆕𑇀𑆑𑆶𑆩𑆶𑆒𑆵, 𑆩𑆷𑆰𑆴𑆑𑆳, 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆩𑆶𑆒𑆵, 𑆱𑆳𑆮𑆫𑆴𑆑𑆳 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆫𑆚𑇀𑆘𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑆴𑆮 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆸𑆰𑇀𑆜𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆩𑆶𑆢𑇀𑆓𑆮𑆫𑇀𑆟𑆳 𑆑𑆥𑆴𑆬𑆳; 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆫𑆑𑇀𑆠𑆳 𑆮𑆸𑆠𑇀𑆠𑆑𑆳𑆪𑆳 𑆥𑆴𑆕𑇀𑆓𑆳𑇁𑇁𑆯𑆶𑆓𑆳 𑆖 𑆥𑆴𑆕𑇀𑆓𑆬𑆳; 𑆪𑆑𑆸𑆢𑇀𑆮𑆫𑇀𑆟𑆳 𑆯𑆵𑆔𑇀𑆫𑆥𑆳𑆪𑆴𑆤𑆵 𑆢𑆵𑆫𑇀𑆔𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆶𑆒𑆵 𑆯𑆕𑇀𑆑𑆶𑆩𑆶𑆒𑆵; 𑆩𑆷𑆰𑆴𑆑𑆳𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆳𑇁𑆤𑆴𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆳 𑆖 𑆩𑆷𑆰𑆴𑆑𑆳; 𑆩𑆶𑆢𑇀𑆓𑆮𑆫𑇀𑆟𑆳 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆠𑆶𑆬𑇀𑆪𑆮𑆑𑇀𑆠𑇀𑆫𑆳 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆩𑆶𑆒𑆵; 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆥𑆢𑇀𑆩𑆥𑆠𑇀𑆫𑆮𑆫𑇀𑆟𑆳𑇁𑆰𑇀𑆛𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆳 𑆱𑆳𑆮𑆫𑆴𑆑𑆳, 𑆱𑆳 𑆖 𑆥𑆯𑇀𑆮𑆫𑇀𑆡𑆼; 𑆅𑆠𑇀𑆪𑆼𑆠𑆳 𑆃𑆮𑆴𑆰𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇒𑇆
𑆠𑆳𑆱𑆳𑆁 𑆪𑆮𑆤𑆥𑆳𑆟𑇀𑆝𑇀𑆪𑆱𑆲𑇀𑆪𑆥𑆿𑆠𑆤𑆳𑆢𑆵𑆤𑆴 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆳𑆟𑆴; 𑆠𑆼𑆰𑆶 𑆩𑆲𑆳𑆯𑆫𑆵𑆫𑆳 𑆧𑆬𑆮𑆠𑇀𑆪𑆂 𑆯𑆵𑆔𑇀𑆫𑆥𑆳𑆪𑆴𑆤𑇀𑆪𑆾 𑆩𑆲𑆳𑆯𑆤𑆳 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆳𑆯𑇀𑆖 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆱𑆮𑆴𑆰𑆩𑆠𑇀𑆱𑇀𑆪𑆑𑆵𑆛𑆢𑆫𑇀𑆢𑆶𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆑𑆾𑆡𑆘𑆳𑆠𑆳𑆂 𑆑𑆬𑆶𑆰𑆼𑆰𑇀𑆮𑆩𑇀𑆨𑆱𑆶 𑆖 𑆱𑆮𑆴𑆰𑆳𑆂; 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆤𑆬𑆴𑆤𑆑𑆶𑆩𑆶𑆢𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆑𑆶𑆮𑆬𑆪𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆯𑆽𑆮𑆬𑆑𑆾𑆡𑆘𑆳𑆠𑆳 𑆮𑆴𑆩𑆬𑆼𑆰𑇀𑆮𑆩𑇀𑆨𑆂𑆱𑆶 𑆖 𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑆳𑆂 𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆼𑆰𑆶 𑆮𑆴𑆖𑆫𑆤𑇀𑆠𑇀𑆪𑆼𑆠𑆳𑆂 𑆱𑆬𑆴𑆬𑆳𑆞𑇀𑆪𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆰𑆶 𑇅 𑆤 𑆖 𑆱𑆕𑇀𑆑𑆵𑆫𑇀𑆟𑆖𑆳𑆫𑆴𑆟𑇀𑆪𑆾 𑆤 𑆖 𑆥𑆕𑇀𑆑𑆼𑆯𑆪𑆳𑆂 𑆱𑆶𑆒𑆳𑆂 𑇆𑇑𑇕𑇆
𑆠𑆳𑆱𑆳𑆁 𑆓𑇀𑆫𑆲𑆟𑆩𑆳𑆫𑇀𑆢𑇀𑆫𑆖𑆫𑇀𑆩𑆟𑆳, 𑆃𑆤𑇀𑆪𑆽𑆫𑇀𑆮𑆳 𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆫𑇀𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀 𑇆𑇑𑇖𑇆
𑆃𑆡𑆽𑆤𑆳𑆁 𑆤𑆮𑆼 𑆩𑆲𑆠𑆴 𑆔𑆛𑆼 𑆱𑆫𑆱𑇀𑆠𑆝𑆳𑆓𑆾𑆢𑆑𑆥𑆕𑇀𑆑𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀; 𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆫𑇀𑆡𑆼 𑆖𑆳𑆱𑆳𑆩𑆶𑆥𑆲𑆫𑆼𑆖𑇀𑆗𑆽𑆮𑆬𑆁 𑆮𑆬𑇀𑆬𑆷𑆫𑆩𑆿𑆢𑆑𑆳𑆁𑆯𑇀𑆖 𑆑𑆤𑇀𑆢𑆳𑆁𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑇀𑆪; 𑆯𑆪𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆠𑆸𑆟𑆩𑆿𑆢𑆑𑆳𑆤𑆴 𑆖 𑆥𑆠𑇀𑆫𑆳𑆟𑆴; 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆖𑇀𑆖𑆳𑆨𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆘𑇀𑆘𑆬𑆁 𑆨𑆑𑇀𑆰𑇀𑆪𑆁 𑆖 𑆢𑆢𑇀𑆪𑆳𑆠𑇀; 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆖𑇀𑆖 𑆔𑆛𑆩𑆤𑇀𑆪𑆁 𑆱𑆕𑇀𑆑𑇀𑆫𑆳𑆩𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑇀𑆡𑆷𑆬𑆩𑆣𑇀𑆪𑆳𑆂 𑆥𑆫𑆴𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆳𑆂 𑆥𑆸𑆡𑇀𑆮𑇀𑆪𑆾 𑆩𑆤𑇀𑆢𑆮𑆴𑆖𑆼𑆰𑇀𑆛𑆴𑆠𑆳𑆂 𑇅 𑆃𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑇀𑆪𑆾𑇁𑆬𑇀𑆥𑆥𑆳𑆪𑆴𑆤𑇀𑆪𑆂 𑆱𑆮𑆴𑆰𑆳𑆯𑇀𑆖 𑆤 𑆥𑆷𑆘𑆴𑆠𑆳𑆂 𑇆𑇑𑇘𑇆
𑆃𑆡 𑆘𑆬𑆿𑆑𑆾𑆮𑆱𑆼𑆑𑆱𑆳𑆣𑇀𑆪𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 𑆱𑆁𑆮𑆼𑆯𑇀𑆪 𑆮𑆳, 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑇀𑆪 𑆖𑆳𑆱𑇀𑆪 𑆠𑆩𑆮𑆑𑆳𑆯𑆁 𑆩𑆸𑆢𑇀𑆓𑆾𑆩𑆪𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑇀𑆪𑆢𑇀𑆪𑆫𑆶𑆘𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑇅 𑆓𑆸𑆲𑆵𑆠𑆳𑆯𑇀𑆖 𑆠𑆳𑆂 𑆱𑆫𑇀𑆰𑆥𑆫𑆘𑆤𑆵𑆑𑆬𑇀𑆑𑆾𑆢𑆑𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆓𑆳𑆠𑇀𑆫𑆵𑆂 𑆱𑆬𑆴𑆬𑆱𑆫𑆑𑆩𑆣𑇀𑆪𑆼 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆱𑇀𑆡𑆴𑆠𑆳 𑆮𑆴𑆓𑆠𑆑𑇀𑆬𑆩𑆳 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆠𑆳𑆨𑆵 𑆫𑆾𑆓𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀 𑇅 𑆯𑇀𑆬𑆟𑆯𑆶𑆑𑇀𑆬𑆳𑆫𑇀𑆢𑇀𑆫𑆥𑆴𑆖𑆶𑆥𑇀𑆫𑆾𑆠𑆳𑆮𑆖𑇀𑆗𑆤𑇀𑆤𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆩𑆶𑆒𑆩𑆥𑆳𑆮𑆸𑆟𑆶𑆪𑆳𑆠𑇀; 𑆃𑆓𑆸𑆲𑇀𑆟𑆤𑇀𑆠𑇀𑆪𑆽 𑆑𑇀𑆰𑆵𑆫𑆧𑆴𑆤𑇀𑆢𑆶𑆁 𑆯𑆾𑆟𑆴𑆠𑆧𑆴𑆤𑇀𑆢𑆶𑆁 𑆮𑆳 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑆢𑆳𑆤𑆴 𑆮𑆳 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆪𑆢𑇀𑆪𑆼𑆮𑆩𑆥𑆴 𑆤 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀𑆠𑆢𑆳𑇁𑆤𑇀𑆪𑆳𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆪𑆢𑆳 𑆖 𑆤𑆴𑆮𑆴𑆯𑆠𑆼𑇁𑆯𑇀𑆮𑆒𑆶𑆫𑆮𑆢𑆳𑆤𑆤𑆁 𑆑𑆸𑆠𑇀𑆮𑆾𑆤𑇀𑆤𑆩𑇀𑆪 𑆖 𑆱𑇀𑆑𑆤𑇀𑆣𑆁 𑆠𑆢𑆳 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆵𑆠𑆴; 𑆓𑆸𑆲𑇀𑆟𑆤𑇀𑆠𑆵𑆁 𑆖𑆳𑆫𑇀𑆢𑇀𑆫𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆮𑆖𑇀𑆗𑆤𑇀𑆤𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆢𑆁𑆯𑆼 𑆠𑆾𑆢𑆑𑆟𑇀𑆝𑆶𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆽𑆫𑇀𑆘𑆳𑆤𑆵𑆪𑆳𑆖𑇀𑆗𑆶𑆢𑇀𑆣𑆩𑆴𑆪𑆩𑆳𑆢𑆠𑇀𑆠 𑆅𑆠𑆴; 𑆯𑆶𑆢𑇀𑆣𑆩𑆳𑆢𑆢𑆳𑆤𑆳𑆩𑆥𑆤𑆪𑆼𑆠𑆂 𑆃𑆡 𑆯𑆾𑆟𑆴𑆠𑆓𑆤𑇀𑆣𑆼𑆤 𑆤 𑆩𑆶𑆚𑇀𑆖𑆼𑆤𑇀𑆩𑆶𑆒𑆩𑆱𑇀𑆪𑆳𑆂 𑆱𑆽𑆤𑇀𑆣𑆮𑆖𑆷𑆫𑇀𑆟𑆼𑆤𑆳𑆮𑆑𑆴𑆫𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆃𑆡 𑆥𑆠𑆴𑆠𑆳𑆁 𑆠𑆟𑇀𑆝𑆶𑆬𑆑𑆟𑇀𑆝𑆤𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆓𑆳𑆠𑇀𑆫𑆵𑆁 𑆠𑆽𑆬𑆬𑆮𑆟𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆩𑆶𑆒𑆵𑆁 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆨𑇀𑆪𑆳𑆁 𑆓𑆸𑆲𑆵𑆠𑆥𑆶𑆖𑇀𑆗𑆳𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆲𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆨𑇀𑆪𑆳𑆁 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆫𑆤𑆶𑆬𑆾𑆩𑆩𑆤𑆶𑆩𑆳𑆫𑇀𑆘𑆪𑆼𑆢𑆳𑆩𑆶𑆒𑆳𑆠𑇀, 𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆳𑆤𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆵𑆠𑆴 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆳𑆤𑇀𑆠𑆳 𑆱𑆬𑆴𑆬𑆱𑆫𑆑𑆼 𑆤𑇀𑆪𑆱𑇀𑆠𑆳 𑆨𑆾𑆑𑇀𑆠𑆶𑆑𑆳𑆩𑆳 𑆱𑆠𑆵 𑆖𑆫𑆼𑆠𑇀 𑇅 𑆪𑆳 𑆱𑆵𑆢𑆠𑆵 𑆤 𑆖𑆼𑆰𑇀𑆛𑆠𑆼 𑆱𑆳 𑆢𑆶𑆫𑇀𑆮𑆳𑆤𑇀𑆠𑆳, 𑆠𑆳𑆁 𑆥𑆶𑆤𑆂 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑇅 𑆢𑆶𑆫𑇀𑆮𑆳𑆤𑇀𑆠𑆳𑆪𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆱𑆳𑆣𑇀𑆪 𑆅𑆤𑇀𑆢𑇀𑆫𑆩𑆢𑆾 𑆤𑆳𑆩 𑆨𑆮𑆠𑆴 𑇅 𑆃𑆡 𑆱𑆶𑆮𑆳𑆤𑇀𑆠𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆱𑆤𑇀𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪 𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆳𑆤𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆯𑆠𑆣𑆿𑆠𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆂, 𑆠𑆠𑇀𑆥𑆴𑆖𑆶𑆣𑆳𑆫𑆟𑆁 𑆮𑆳; 𑆘𑆬𑆿𑆑𑆾𑆮𑇀𑆫𑆟𑆳𑆤𑇀 𑆩𑆣𑆶𑆤𑆳𑇁𑆮𑆔𑆛𑇀𑆛𑆪𑆼𑆠𑇀, 𑆯𑆵𑆠𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆂 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆢𑇀𑆧𑆣𑇀𑆤𑆵𑆠 𑆮𑆳, 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆽𑆂 𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑇆𑇒𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆳𑆟𑆴 𑆓𑇀𑆫𑆲𑆟𑆁 𑆘𑆳𑆠𑆵𑆂 𑆥𑆾𑆰𑆟𑆁 𑆱𑆳𑆮𑆖𑆳𑆫𑆟𑆩𑇀 𑇅 𑆘𑆬𑆿𑆑𑆱𑆳𑆁 𑆖 𑆪𑆾 𑆮𑆼𑆠𑇀𑆠𑆴 𑆠𑆠𑇀𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑇀 𑆱 𑆘𑆪𑆼𑆢𑇀𑆓𑆢𑆳𑆤𑇀 𑇆𑇒𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆾𑆟𑆴𑆠𑆮𑆫𑇀𑆟𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆱𑇀𑆪 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆱𑇀𑆪 𑆰𑆝𑇀𑆫𑆱𑆱𑇀𑆪 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆮𑆵𑆫𑇀𑆪𑆱𑇀𑆪𑆳𑆰𑇀𑆛𑆮𑆴𑆣𑆮𑆵𑆫𑇀𑆪𑆱𑇀𑆪 𑆮𑆳𑇁𑆤𑆼𑆑𑆓𑆶𑆟𑆱𑇀𑆪𑆾𑆥𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑆫𑆴𑆟𑆠𑆱𑇀𑆪 𑆪𑆱𑇀𑆠𑆼𑆘𑆾𑆨𑆷𑆠𑆂 𑆱𑆳𑆫𑆂 𑆥𑆫𑆩𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆂 𑆱 `𑆫𑆱𑆂’ 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆪 𑆲𑆸𑆢𑆪𑆁 𑆱𑇀𑆡𑆳𑆤𑆁, 𑆱 𑆲𑆸𑆢𑆪𑆳𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆣𑆩𑆤𑆵𑆫𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆓𑆳𑆢𑆯 𑆢𑆯𑆳𑆣𑆾𑆓𑆳𑆩𑆴𑆤𑇀𑆪𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆯𑇀𑆖 𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆳𑆂 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆫𑆵𑆫𑆩𑆲𑆫𑆲𑆱𑇀𑆠𑆫𑇀𑆥𑆪𑆠𑆴 𑆮𑆫𑇀𑆣𑆪𑆠𑆴 𑆣𑆳𑆫𑆪𑆠𑆴 𑆪𑆳𑆥𑆪𑆠𑆴 𑆖𑆳𑆢𑆸𑆰𑇀𑆛𑆲𑆼𑆠𑆶𑆑𑆼𑆤 𑆑𑆫𑇀𑆩𑆟𑆳 𑇅 𑆠𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆱𑆫𑆠𑆾𑇁𑆤𑆶𑆩𑆳𑆤𑆳𑆢𑇀𑆓𑆠𑆴𑆫𑆶𑆥𑆬𑆑𑇀𑆰𑆪𑆴𑆠𑆮𑇀𑆪𑆳 𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆴𑆮𑆽𑆑𑆸𑆠𑆽𑆂 𑇅 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆯𑆪𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆴 𑆫𑆱𑆼 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳- 𑆑𑆴𑆩𑆪𑆁 𑆱𑆿𑆩𑇀𑆪𑆱𑇀𑆠𑆽𑆘𑆱? 𑆅𑆠𑆴 𑇅 𑆃𑆠𑇀𑆫𑆾𑆖𑇀𑆪𑆠𑆼- 𑆱 𑆒𑆬𑆶 𑆢𑇀𑆫𑆮𑆳𑆤𑆶𑆱𑆳𑆫𑆵 𑆱𑇀𑆤𑆼𑆲𑆤𑆘𑆵𑆮𑆤𑆠𑆫𑇀𑆥𑆟𑆣𑆳𑆫𑆟𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆂 𑆱𑆿𑆩𑇀𑆪 𑆅𑆠𑇀𑆪𑆮𑆓𑆩𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆱 𑆒𑆬𑇀𑆮𑆳𑆥𑇀𑆪𑆾 𑆫𑆱𑆾 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆿 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆫𑆳𑆓𑆩𑆶𑆥𑆽𑆠𑆴 𑇆𑇔𑇆
𑆯𑇀𑆬𑆾𑆑𑆿 𑆖𑆳𑆠𑇀𑆫 𑆨𑆮𑆠𑆂- 𑆫𑆚𑇀𑆘𑆴𑆠𑆳𑆱𑇀𑆠𑆼𑆘𑆱𑆳 𑆠𑇀𑆮𑆳𑆥𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆡𑆼𑆤 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆃𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆳𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆼𑆤 𑆫𑆑𑇀𑆠𑆩𑆴𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇕𑇆
𑆫𑆱𑆳𑆢𑆼𑆮 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆫𑆑𑇀𑆠𑆁 𑆫𑆘𑆂𑆱𑆚𑇀𑆘𑇀𑆚𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆠𑆢𑇀𑆮𑆫𑇀𑆰𑆳𑆢𑇀𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆪𑆳𑆠𑆴 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑆂 𑆑𑇀𑆰𑆪𑆩𑇀 𑇆𑇖𑇆
𑆄𑆫𑇀𑆠𑆮𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆠𑇀𑆮𑆳𑆓𑇀𑆤𑆼𑆪𑆩𑇀, 𑆃𑆓𑇀𑆤𑆵𑆰𑆾𑆩𑆵𑆪𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑇆𑇗𑇆
𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆁 𑆠𑇀𑆮𑆥𑆫𑆼 𑆘𑆵𑆮𑆫𑆑𑇀𑆠𑆩𑆳𑆲𑆶𑆫𑆳𑆖𑆳𑆫𑇀𑆪𑆳𑆂 𑇆𑇘𑇆
𑆮𑆴𑆱𑇀𑆫𑆠𑆳 𑆢𑇀𑆫𑆮𑆠𑆳 𑆫𑆳𑆓𑆂 𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆁 𑆬𑆔𑆶𑆠𑆳 𑆠𑆡𑆳 𑇅 𑆨𑆷𑆩𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆓𑆶𑆟𑆳 𑆲𑇀𑆪𑆼𑆠𑆼 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆖𑆳𑆠𑇀𑆫 𑆯𑆾𑆟𑆴𑆠𑆼 𑇆𑇙𑇆
𑆫𑆱𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆠𑆠𑆾 𑆩𑆳𑆁𑆱𑆁 𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆩𑆼𑆢𑆂 𑆥𑇀𑆫𑆘𑆳𑆪𑆠𑆼 𑇅 𑆩𑆼𑆢𑆱𑆾𑇁𑆱𑇀𑆡𑆴 𑆠𑆠𑆾 𑆩𑆘𑇀𑆘𑆳 𑆩𑆘𑇀𑆘𑇀𑆚𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆠𑆶 𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫𑆽𑆠𑆼𑆰𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆫𑆱𑆂 𑆥𑇀𑆫𑆵𑆟𑆪𑆴𑆠𑆳 𑇆𑇑𑇑𑇆
𑆫𑆱𑆘𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆫𑆱𑆁 𑆫𑆑𑇀𑆰𑆼𑆠𑇀 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆠𑆂 𑇅 𑆃𑆤𑇀𑆤𑆳𑆠𑇀𑆥𑆳𑆤𑆳𑆚𑇀𑆖 𑆩𑆠𑆴𑆩𑆳𑆤𑆳𑆖𑆳𑆫𑆳𑆚𑇀𑆖𑆳𑆥𑇀𑆪𑆠𑆤𑇀𑆢𑇀𑆫𑆴𑆠𑆂 𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 ‘𑆫𑆱’ 𑆓𑆠𑆿 𑆣𑆳𑆠𑆶𑆂, 𑆃𑆲𑆫𑆲𑆫𑇀𑆓𑆖𑇀𑆗𑆠𑆵𑆠𑇀𑆪𑆠𑆾 𑆫𑆱𑆂 𑇆𑇑𑇓𑇆
𑆱 𑆒𑆬𑆶 𑆠𑇀𑆫𑆵𑆟𑆴 𑆠𑇀𑆫𑆵𑆟𑆴 𑆑𑆬𑆳𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆥𑆚𑇀𑆖𑆢𑆯 𑆖 𑆑𑆬𑆳 𑆍𑆑𑆽𑆑𑆱𑇀𑆩𑆴𑆤𑇀 𑆣𑆳𑆠𑆳𑆮𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼; 𑆍𑆮𑆁 𑆩𑆳𑆱𑆼𑆤 𑆫𑆱𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆖𑆳𑆫𑇀𑆠𑆮𑆁 𑆨𑆮𑆠𑆴 𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆰𑇀𑆛𑆳𑆢𑆯𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆲𑇀𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆩𑆶𑆖𑇀𑆖𑆪𑆼 𑇅 𑆑𑆬𑆳𑆤𑆳𑆁 𑆤𑆮𑆠𑆴𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆥𑆫𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆾𑆂 𑇆𑇑𑇕𑇆
𑆱 𑆯𑆧𑇀𑆢𑆳𑆫𑇀𑆖𑆴𑆫𑇀𑆘𑆬𑆱𑆤𑇀𑆠𑆳𑆤𑆮𑆢𑆟𑆶𑆤𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆳𑆤𑆶𑆣𑆳𑆮𑆠𑇀𑆪𑆼𑆮𑆁 𑆯𑆫𑆵𑆫𑆁 𑆑𑆼𑆮𑆬𑆩𑇀 𑇆𑇑𑇖𑇆
𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆾𑆰𑆣𑆪𑆂 𑆱𑇀𑆮𑆧𑆬𑆓𑆶𑆟𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑆢𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆵𑆔𑇀𑆫𑆁 𑆮𑆴𑆫𑆼𑆖𑆪𑆤𑇀𑆠𑆴 𑇆𑇑𑇗𑇆
𑆪𑆡𑆳𑆲𑆴 𑆥𑆶𑆰𑇀𑆥𑆩𑆶𑆑𑆶𑆬𑆱𑇀𑆡𑆾 𑆓𑆤𑇀𑆣𑆾 𑆤 𑆯𑆑𑇀𑆪𑆩𑆴𑆲𑆳𑆱𑇀𑆠𑆵𑆠𑆴 𑆮𑆑𑇀𑆠𑆶𑆁, 𑆤𑆽𑆮 𑆤𑆳𑆱𑇀𑆠𑆵𑆠𑆴; 𑆃𑆡 𑆖𑆳𑆱𑇀𑆠𑆴, 𑆱𑆠𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆨𑆴𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆫𑆴𑆠𑆴 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 , 𑆑𑆼𑆮𑆬𑆁 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆤𑇀𑆤𑆳𑆨𑆴𑆮𑇀𑆪𑆘𑇀𑆪𑆠𑆼; 𑆱 𑆍𑆮 𑆮𑆴𑆮𑆸𑆠𑆥𑆠𑇀𑆫𑆑𑆼𑆯𑆫𑆼 𑆥𑆶𑆰𑇀𑆥𑆼 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆨𑆴𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆁 𑆓𑆖𑇀𑆗𑆠𑆴; 𑆍𑆮𑆁 𑆧𑆳𑆬𑆳𑆤𑆳𑆩𑆥𑆴 𑆮𑆪𑆂𑆥𑆫𑆴𑆟𑆳𑆩𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆫𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆨𑆮𑆠𑆴, 𑆫𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆳𑆢𑆪𑆯𑇀𑆖 𑆮𑆴𑆯𑆼𑆰𑆳 𑆤𑆳𑆫𑆵𑆟𑆳𑆩𑇀 𑇆𑇑𑇘𑇆
𑆱 𑆍𑆮𑆳𑆤𑇀𑆤𑆫𑆱𑆾 𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆳𑆁 (𑆘𑆫𑆳) 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆢𑆥𑇀𑆫𑆵𑆟𑆤𑆾 𑆨𑆮𑆠𑆴 𑇆𑇑𑇙𑇆
𑆠 𑆍𑆠𑆼 𑆯𑆫𑆵𑆫𑆣𑆳𑆫𑆟𑆳𑆢𑇀𑆣𑆳𑆠𑆮 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇒𑇐𑇆
𑆠𑆼𑆰𑆳𑆁 𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆵 𑆯𑆾𑆟𑆴𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆦𑆼𑆤𑆴𑆬𑆩𑆫𑆶𑆟𑆁 𑆑𑆸𑆰𑇀𑆟𑆁 𑆥𑆫𑆶𑆰𑆁 𑆠𑆤𑆶 𑆯𑆵𑆔𑇀𑆫𑆓𑆩𑆱𑇀𑆑𑆤𑇀𑆢𑆴 𑆖 𑆮𑆳𑆠𑆼𑆤 𑆢𑆶𑆰𑇀𑆛𑆁; 𑆤𑆵𑆬𑆁 𑆥𑆵𑆠𑆁 𑆲𑆫𑆴𑆠𑆁 𑆯𑇀𑆪𑆳𑆮𑆁 𑆮𑆴𑆱𑇀𑆫𑆩𑆤𑆴𑆰𑇀𑆛𑆁 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆟𑆳𑆩𑆱𑇀𑆑𑆤𑇀𑆢𑆴 𑆖 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆢𑆶𑆰𑇀𑆛𑆁; 𑆓𑆽𑆫𑆴𑆑𑆾𑆢𑆑𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆯𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆯𑆵𑆠𑆬𑆁 𑆧𑆲𑆬𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆖𑆴𑆫𑆱𑇀𑆫𑆳𑆮𑆴 𑆩𑆳𑆁𑆱𑆥𑆼𑆯𑆵𑆥𑇀𑆫𑆨𑆁 𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆢𑆶𑆰𑇀𑆛𑆁; 𑆱𑆫𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆳𑆨𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆾 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆴 𑆖 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆢𑆶𑆰𑇀𑆛𑆁; 𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆩𑇀 𑇆𑇒𑇑𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆓𑆾𑆥𑆑𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆯𑆩𑆱𑆁𑆲𑆠𑆩𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆖 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇒𑇓𑇆
𑆃𑆡𑆳𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳𑆂- 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆯𑆾𑆦𑆂, 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆖𑆳𑆩𑇀𑆬𑆨𑆾𑆘𑆤𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂, 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑇀𑆪𑆫𑇀𑆯𑆱𑆾𑆢𑆫𑆴𑆯𑆾𑆰𑆴𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆤𑆳𑆁 𑆖 𑆯𑇀𑆮𑆪𑆡𑆮𑆂 𑇆𑇒𑇔𑇆
𑆯𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁- 𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆤𑆁 , 𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆤𑆁 𑆖 𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫, 𑆉𑆘𑇀𑆮𑆱𑆕𑇀𑆑𑆵𑆫𑇀𑆟𑆁 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆱𑆩𑆩𑆤𑆮𑆓𑆳𑆞𑆩𑆤𑆶𑆠𑇀𑆠𑆳𑆤𑆩𑆳𑆯𑆶 𑆖 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆳𑆠𑆪𑆼𑆤𑇀𑆩𑆫𑇀𑆩𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑆵𑆤𑆳𑆁 𑆖𑆳𑆤𑆶𑆥𑆔𑆳𑆠𑆴 𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫, 𑆢𑆶𑆫𑇀𑆢𑆴𑆤𑆼 𑆢𑆶𑆫𑇀𑆮𑆴𑆢𑇀𑆣𑆼 𑆯𑆵𑆠𑆮𑆳𑆠𑆪𑆾𑆫𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆱𑇀𑆑𑆤𑇀𑆢𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆁 𑆤 𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆬𑇀𑆥𑆁 𑆮𑆳 𑆱𑇀𑆫𑆮𑆠𑆴 𑇆𑇒𑇗𑇆
𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆯𑇀𑆫𑆩𑆳𑆫𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆳𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆴𑆤𑆳𑆩𑇀 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆨𑆴𑆨𑆷𑆠𑆨𑆵𑆠𑆳𑆤𑆳𑆁 𑆤𑆸𑆟𑆳𑆁 𑆤𑆳𑆱𑆸𑆑𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇒𑇘𑇆
𑆠𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆁 𑆯𑆾𑆟𑆴𑆠𑆩𑆤𑆴𑆫𑇀𑆲𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆁 𑆯𑆾𑆦𑆢𑆳𑆲𑆫𑆳𑆓𑆥𑆳𑆑𑆮𑆼𑆢𑆤𑆳 𑆘𑆤𑆪𑆼𑆠𑇀 𑇆𑇒𑇙𑇆
𑆃𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆼𑇁𑆠𑆴𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼𑇁𑆠𑆴𑆮𑆴𑆢𑇀𑆣𑆼𑇁𑆘𑇀𑆚𑆽𑆫𑇀𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆠𑆩𑆠𑆴𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 ; 𑆠𑆢𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆁 𑆯𑆴𑆫𑆾𑇁𑆨𑆴𑆠𑆳𑆥𑆩𑆳𑆤𑇀𑆣𑇀𑆪𑆩𑆣𑆴𑆩𑆤𑇀𑆡𑆠𑆴𑆩𑆴𑆫𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆁 𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆩𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆁 𑆢𑆳𑆲𑆁 𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆩𑆼𑆑𑆳𑆕𑇀𑆓𑆮𑆴𑆑𑆳𑆫𑆁 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆿 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑇆𑇓𑇐𑇆
𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆯𑆵𑆠𑆼 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆼 𑆤𑆳𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼 𑆤𑆳𑆠𑆴𑆠𑆳𑆥𑆴𑆠𑆼 𑇅 𑆪𑆮𑆳𑆓𑆷𑆁 𑆥𑇀𑆫𑆠𑆴 𑆥𑆵𑆠𑆱𑇀𑆪 𑆯𑆾𑆟𑆴𑆠𑆁 𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇑𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆓𑆠𑇀𑆮𑆳 𑆪𑆢𑆳 𑆫𑆑𑇀𑆠𑆁 𑆱𑇀𑆮𑆪𑆩𑆼𑆮𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼 𑇅 𑆯𑆶𑆢𑇀𑆣𑆁 𑆠𑆢𑆳 𑆮𑆴𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆠𑆁 𑆖 𑆠𑆠𑇀 𑇆𑇓𑇒𑇆
𑆬𑆳𑆔𑆮𑆁 𑆮𑆼𑆢𑆤𑆳𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆔𑆼𑆫𑇀𑆮𑆼𑆓𑆥𑆫𑆴𑆑𑇀𑆰𑆪𑆂 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆴𑆠𑆼 𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑇀𑆫𑆱𑆳𑆢𑆾 𑆩𑆤𑆱𑆱𑇀𑆠𑆡𑆳 𑇆𑇓𑇓𑇆
𑆠𑇀𑆮𑆓𑇀𑆢𑆾𑆰𑆳 𑆓𑇀𑆫𑆤𑇀𑆡𑆪𑆂 𑆯𑆾𑆦𑆳 𑆫𑆾𑆓𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆯𑇀𑆖 𑆪𑆼 𑇅 𑆫𑆑𑇀𑆠𑆩𑆾𑆑𑇀𑆰𑆟𑆯𑆵𑆬𑆳𑆤𑆳𑆁 𑆤 𑆨𑆮𑆤𑇀𑆠𑆴 𑆑𑆢𑆳𑆖𑆤 𑇆𑇓𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆳𑆠𑇀 𑆱𑇀𑆫𑆶𑆠𑆼 𑆫𑆑𑇀𑆠𑆼 𑆩𑆤𑇀𑆢𑆂 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼𑇁𑆤𑆬𑆂 𑇅 𑆥𑆮𑆤𑆯𑇀𑆖 𑆥𑆫𑆁 𑆑𑆾𑆥𑆁 𑆪𑆳𑆠𑆴 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆠𑆂 𑇆𑇓𑇗𑇆
𑆠𑆁 𑆤𑆳𑆠𑆴𑆯𑆵𑆠𑆽𑆫𑇀𑆬𑆔𑆶𑆨𑆴𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆂 𑆯𑆾𑆟𑆴𑆠𑆮𑆫𑇀𑆣𑆤𑆽𑆂 𑇅 𑆆𑆰𑆢𑆩𑇀𑆬𑆽𑆫𑆤𑆩𑇀𑆬𑆽𑆫𑇀𑆮𑆳 𑆨𑆾𑆘𑆤𑆽𑆂 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇓𑇘𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆪𑆢𑆼𑆠𑆢𑇀𑆣𑆴 𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆪 𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀 𑇅 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆱𑇀𑆑𑆤𑇀𑆢𑆤𑆁 𑆖𑆽𑆮 𑆥𑆳𑆖𑆤𑆁 𑆢𑆲𑆤𑆁 𑆠𑆡𑆳 𑇆𑇓𑇙𑇆
𑆮𑇀𑆫𑆟𑆁 𑆑𑆰𑆳𑆪𑆂 𑆱𑆤𑇀𑆣𑆠𑇀𑆠𑆼 𑆫𑆑𑇀𑆠𑆁 𑆱𑇀𑆑𑆤𑇀𑆢𑆪𑆠𑆼 𑆲𑆴𑆩𑆩𑇀 𑇅 𑆠𑆡𑆳 𑆱𑆩𑇀𑆥𑆳𑆖𑆪𑆼𑆢𑇀𑆨𑆱𑇀𑆩 𑆢𑆳𑆲𑆂 𑆱𑆕𑇀𑆑𑆾𑆖𑆪𑆼𑆠𑇀 𑆱𑆴𑆫𑆳𑆂 𑇆𑇔𑇐𑇆
𑆃𑆱𑇀𑆑𑆤𑇀𑆢𑆩𑆳𑆤𑆼 𑆫𑆶𑆣𑆴𑆫𑆼 𑆱𑆤𑇀𑆣𑆳𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆱𑆤𑇀𑆣𑆳𑆤𑆼 𑆨𑇀𑆫𑆯𑇀𑆪𑆩𑆳𑆤𑆼 𑆠𑆶 𑆥𑆳𑆖𑆤𑆽𑆂 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇔𑇑𑇆
𑆑𑆬𑇀𑆥𑆽𑆫𑆼𑆠𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆮𑆽𑆢𑇀𑆪𑆂 𑆥𑇀𑆫𑆪𑆠𑆼𑆠 𑆪𑆡𑆳𑆮𑆴𑆣𑆴 𑇅 𑆃𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆠𑇀𑆱𑆶 𑆖𑆽𑆠𑆼𑆰𑆶 𑆢𑆳𑆲𑆂 𑆥𑆫𑆩 𑆅𑆰𑇀𑆪𑆠𑆼 𑇆𑇔𑇒𑇆
𑆯𑆼𑆰𑆢𑆾𑆰𑆼 𑆪𑆠𑆾 𑆫𑆑𑇀𑆠𑆼 𑆤 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆱𑆳𑆮𑆯𑆼𑆰𑆼 𑆠𑆠𑆂 𑆱𑇀𑆡𑆼𑆪𑆁 𑆤 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆠𑆴𑆑𑇀𑆫𑆩𑆩𑇀 𑇆𑇔𑇓𑇆
𑆢𑆼𑆲𑆱𑇀𑆪 𑆫𑆶𑆣𑆴𑆫𑆁 𑆩𑆷𑆬𑆁 𑆫𑆶𑆣𑆴𑆫𑆼𑆟𑆽𑆮 𑆣𑆳𑆫𑇀𑆪𑆠𑆼 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆠𑇀𑆤𑆼𑆤 𑆱𑆁𑆫𑆑𑇀𑆰𑇀𑆪𑆁 𑆫𑆑𑇀𑆠𑆁 𑆘𑆵𑆮 𑆅𑆠𑆴 𑆱𑇀𑆡𑆴𑆠𑆴𑆂 𑇆𑇔𑇔𑇆
𑆱𑇀𑆫𑆶𑆠𑆫𑆑𑇀𑆠𑆱𑇀𑆪 𑆱𑆼𑆑𑆳𑆢𑇀𑆪𑆽𑆂 𑆯𑆵𑆠𑆽𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆼𑇁𑆤𑆴𑆬𑆼 𑇅 𑆯𑆾𑆦𑆁 𑆱𑆠𑆾𑆢𑆁 𑆑𑆾𑆰𑇀𑆟𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆠𑇀 𑇆𑇔𑇕𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆴𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆩𑆷𑆬𑆁 𑆲𑆴 𑆯𑆫𑆵𑆫𑆁, 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆼𑆰𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆮𑆴𑆣𑆴𑆮𑆠𑇀 𑆥𑆫𑆴𑆫𑆑𑇀𑆰𑆟𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇖𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆼𑆰𑆳𑆁 𑆑𑇀𑆰𑆵𑆟𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆑𑇀𑆰𑆪𑆼 𑆩𑆤𑇀𑆢𑆖𑆼𑆰𑇀𑆛𑆠𑆳𑇁𑆬𑇀𑆥𑆮𑆳𑆑𑇀𑆠𑇀𑆮𑆩𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆾 𑆩𑆷𑆞𑆱𑆚𑇀𑆘𑇀𑆚𑆠𑆳 𑆖, 𑆥𑆴𑆠𑇀𑆠𑆑𑇀𑆰𑆪𑆼 𑆩𑆤𑇀𑆢𑆾𑆰𑇀𑆩𑆳𑆓𑇀𑆤𑆴𑆠𑆳 𑆤𑆴𑆰𑇀𑆥𑇀𑆫𑆨𑆠𑆳 𑆖, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑇀𑆰𑆪𑆼 𑆫𑆷𑆑𑇀𑆰𑆠𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲 𑆄𑆩𑆳𑆯𑆪𑆼𑆠𑆫𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆯𑆪𑆯𑆷𑆤𑇀𑆪𑆠𑆳 𑆱𑆤𑇀𑆣𑆴𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 (𑆠𑆸𑆰𑇀𑆟𑆳 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆟𑆁) 𑆖 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 𑇆𑇘𑇆
𑆫𑆱𑆑𑇀𑆰𑆪𑆼 𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆳𑆑𑆩𑇀𑆥𑆯𑆷𑆤𑇀𑆪𑆠𑆳𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆖, 𑆯𑆾𑆟𑆴𑆠𑆑𑇀𑆰𑆪𑆼 𑆠𑇀𑆮𑆑𑇀𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆩𑆩𑇀𑆬𑆯𑆵𑆠𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆤𑆳 𑆱𑆴𑆫𑆳𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 𑆖, 𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆼 𑆱𑇀𑆦𑆴𑆓𑇀𑆓𑆟𑇀𑆝𑆿𑆰𑇀𑆜𑆾𑆥𑆱𑇀𑆡𑆾𑆫𑆶𑆮𑆑𑇀𑆰𑆂𑆑𑆑𑇀𑆰𑆳𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆾𑆢𑆫𑆓𑇀𑆫𑆵𑆮𑆳𑆯𑆶𑆰𑇀𑆑𑆠𑆳 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆠𑆾𑆢𑆿 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆱𑆢𑆤𑆁 𑆣𑆩𑆤𑆵𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 𑆖, 𑆩𑆼𑆢𑆂𑆑𑇀𑆰𑆪𑆼 𑆥𑇀𑆬𑆵𑆲𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆱𑆤𑇀𑆣𑆴𑆯𑆷𑆤𑇀𑆪𑆠𑆳 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆩𑆼𑆢𑆶𑆫𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆤𑆳 𑆖, 𑆃𑆱𑇀𑆡𑆴𑆑𑇀𑆰𑆪𑆼𑇁𑆱𑇀𑆡𑆴𑆯𑆷𑆬𑆁 𑆢𑆤𑇀𑆠𑆤𑆒𑆨𑆕𑇀𑆓𑆾 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆖, 𑆩𑆘𑇀𑆘𑆑𑇀𑆰𑆪𑆼𑇁𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆠𑆳 𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑆴𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆾𑇁𑆱𑇀𑆡𑆴𑆯𑆷𑆤𑇀𑆪𑆠𑆳 𑆖, 𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆼 𑆩𑆼𑆞𑇀𑆫𑆮𑆸𑆰𑆟𑆮𑆼𑆢𑆤𑆳𑇁𑆯𑆑𑇀𑆠𑆴𑆫𑇀𑆩𑆽𑆡𑆶𑆤𑆼 𑆖𑆴𑆫𑆳𑆢𑇀𑆮𑆳 𑆥𑇀𑆫𑆱𑆼𑆑𑆂 𑆥𑇀𑆫𑆱𑆼𑆑𑆼 𑆖𑆳𑆬𑇀𑆥𑆫𑆑𑇀𑆠𑆯𑆶𑆑𑇀𑆫𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆂 (𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 ) 𑇆𑇑𑇐𑇆
𑆥𑆶𑆫𑆵𑆰𑆑𑇀𑆰𑆪𑆼 𑆲𑆸𑆢𑆪𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆵𑆝𑆳 𑆱𑆯𑆧𑇀𑆢𑆱𑇀𑆪 𑆖 𑆮𑆳𑆪𑆾𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆩𑆤𑆁 𑆑𑆶𑆑𑇀𑆰𑆿 𑆱𑆚𑇀𑆖𑆫𑆟𑆁 𑆖, 𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆪𑆼 𑆧𑆱𑇀𑆠𑆴𑆠𑆾𑆢𑆾𑇁𑆬𑇀𑆥𑆩𑆷𑆠𑇀𑆫𑆠𑆳 𑆖; 𑆃𑆠𑇀𑆫𑆳𑆥𑆴 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆂 𑇅 𑆱𑇀𑆮𑆼𑆢𑆑𑇀𑆰𑆪𑆼 𑆱𑇀𑆠𑆧𑇀𑆣𑆫𑆾𑆩𑆑𑆷𑆥𑆠𑆳 𑆠𑇀𑆮𑆑𑇀𑆯𑆾𑆰𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆁 𑆱𑇀𑆮𑆼𑆢𑆤𑆳𑆯𑆯𑇀𑆖; 𑆠𑆠𑇀𑆫𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆂 𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆪𑆾𑆓𑆯𑇀𑆖 𑇆𑇑𑇑𑇆
𑆄𑆫𑇀𑆠𑆮𑆑𑇀𑆰𑆪𑆼 𑆪𑆡𑆾𑆖𑆴𑆠𑆑𑆳𑆬𑆳𑆢𑆫𑇀𑆯𑆤𑆩𑆬𑇀𑆥𑆠𑆳 𑆮𑆳 𑆪𑆾𑆤𑆴𑆮𑆼𑆢𑆤𑆳 𑆖; 𑆠𑆠𑇀𑆫 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆳𑆤𑆳𑆁 𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑆶𑆥𑆪𑆾𑆓𑆂 𑇅 𑆱𑇀𑆠𑆤𑆑𑇀𑆰𑆪𑆼 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑇀𑆩𑇀𑆬𑆳𑆤𑆠𑆳 𑆱𑇀𑆠𑆤𑇀𑆪𑆳𑆱𑆩𑇀𑆨𑆮𑆾𑇁𑆬𑇀𑆥𑆠𑆳 𑆮𑆳; 𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆫𑇀𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆂 𑇅 𑆓𑆫𑇀𑆨𑆑𑇀𑆰𑆪𑆼 𑆓𑆫𑇀𑆨𑆳𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆩𑆤𑆶𑆤𑇀𑆤𑆠𑆑𑆶𑆑𑇀𑆰𑆴𑆠𑆳 𑆖; 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆧𑆱𑇀𑆠𑆴𑆑𑆳𑆬𑆳𑆪𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆪𑆾𑆓𑆾 𑆩𑆼𑆢𑇀𑆪𑆳𑆤𑇀𑆤𑆾𑆥𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇒𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆥𑆶𑆤𑆫𑆼𑆰𑆳𑆁 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆱𑆼𑆮𑆤𑆳𑆢𑇀𑆨𑆮𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆮𑆸𑆢𑇀𑆣𑆿 𑆮𑆳𑆑𑇀𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆁 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆁 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆦𑆶𑆫𑆟𑆩𑆶𑆰𑇀𑆟𑆑𑆳𑆩𑆴(𑆩)𑆠𑆳 𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆾𑇁𑆬𑇀𑆥𑆧𑆬𑆠𑇀𑆮𑆁 𑆓𑆳𑆞𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆖; 𑆥𑆴𑆠𑇀𑆠𑆮𑆸𑆢𑇀𑆣𑆿 𑆥𑆵𑆠𑆳𑆮𑆨𑆳𑆱𑆠𑆳 𑆱𑆤𑇀𑆠𑆳𑆥𑆂 𑆯𑆵𑆠𑆑𑆳𑆩𑆴𑆠𑇀𑆮𑆩𑆬𑇀𑆥𑆤𑆴𑆢𑇀𑆫𑆠𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆧𑆬𑆲𑆳𑆤𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆥𑆵𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆠𑇀𑆮𑆁 𑆖; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆸𑆢𑇀𑆣𑆿 𑆯𑆿𑆑𑇀𑆬𑇀𑆪𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆓𑆿𑆫𑆮𑆩𑆮𑆱𑆳𑆢𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆤𑆴𑆢𑇀𑆫𑆳 𑆱𑆤𑇀𑆣𑆴𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆯𑇀𑆖 𑇆𑇑𑇓𑇆
𑆫𑆱𑆾𑇁𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆾 𑆲𑆸𑆢𑆪𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆢𑆁 𑆥𑇀𑆫𑆱𑆼𑆑𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴; 𑆫𑆑𑇀𑆠𑆁 𑆫𑆑𑇀𑆠𑆳𑆕𑇀𑆓𑆳𑆑𑇀𑆰𑆴𑆠𑆳𑆁 𑆱𑆴𑆫𑆳𑆥𑆷𑆫𑇀𑆟𑆠𑇀𑆮𑆁 𑆖; 𑆩𑆳𑆁𑆱𑆁 𑆱𑇀𑆦𑆴𑆓𑇀𑆓𑆟𑇀𑆝𑆿𑆰𑇀𑆜𑆾𑆥𑆱𑇀𑆡𑆾𑆫𑆶𑆧𑆳𑆲𑆶𑆘𑆕𑇀𑆔𑆳𑆱𑆶 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳𑆁 𑆖; 𑆩𑆼𑆢𑆂𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆕𑇀𑆓𑆠𑆳𑆩𑆶𑆢𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆢𑆵𑆤𑇀 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆖; 𑆃𑆱𑇀𑆡𑇀𑆪𑆣𑇀𑆪𑆱𑇀𑆡𑆵𑆤𑇀𑆪𑆣𑆴𑆢𑆤𑇀𑆠𑆳𑆁𑆯𑇀𑆖; 𑆩𑆘𑇀𑆘𑆳 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆤𑆼𑆠𑇀𑆫𑆓𑆿𑆫𑆮𑆁 𑆖; 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆩𑆠𑆴𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆁 𑆖 𑇆𑇑𑇔𑇆
𑆥𑆶𑆫𑆵𑆰𑆩𑆳𑆛𑆾𑆥𑆁 𑆑𑆶𑆑𑇀𑆰𑆿 𑆯𑆷𑆬𑆁 𑆖; 𑆩𑆷𑆠𑇀𑆫𑆁 𑆩𑆷𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆧𑆱𑇀𑆠𑆴𑆠𑆾𑆢𑆩𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆖; 𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑇀𑆮𑆖𑆾 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆑𑆟𑇀𑆝𑆷𑆁 𑆖 𑇆𑇑𑇕𑇆
𑆄𑆫𑇀𑆠𑆮𑆩𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆩𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆖; 𑆱𑇀𑆠𑆤𑇀𑆪𑆁 𑆱𑇀𑆠𑆤𑆪𑆾𑆫𑆳𑆥𑆵𑆤𑆠𑇀𑆮𑆁 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆂 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆠𑆾𑆢𑆁 𑆖; 𑆓𑆫𑇀𑆨𑆾 𑆘𑆜𑆫𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆱𑇀𑆮𑆼𑆢𑆁 𑆖 𑇆𑇑𑇖𑇆
𑆠𑆼𑆰𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆑𑇀𑆰𑆥𑆟𑆁 𑆖 𑆑𑇀𑆰𑆪𑆳𑆢𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆽𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆯𑆼𑆰𑆽𑆂 𑆥𑇀𑆫𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇑𑇗𑇆
𑆥𑆷𑆫𑇀𑆮𑆂 𑆥𑆷𑆫𑇀𑆮𑆾𑇁𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆫𑇀𑆣𑆪𑆼𑆢𑇀𑆣𑆴 𑆥𑆫𑆁 𑆥𑆫𑆩𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆲𑇀𑆫𑆳𑆱𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇆𑇑𑇘𑇆
𑆧𑆬𑆬𑆑𑇀𑆰𑆟𑆁 𑆧𑆬𑆑𑇀𑆰𑆪𑆬𑆑𑇀𑆰𑆟𑆁 𑆖𑆳𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆪𑆠𑇀 𑆥𑆫𑆁 𑆠𑆼𑆘𑆱𑇀𑆠𑆠𑇀 𑆒𑆬𑇀𑆮𑆾𑆘𑆱𑇀𑆠𑆢𑆼𑆮 𑆧𑆬𑆩𑆴𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼, 𑆱𑇀𑆮𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠𑆳𑆠𑇀 𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆧𑆬𑆼𑆤 𑆱𑇀𑆡𑆴𑆫𑆾𑆥𑆖𑆴𑆠𑆩𑆳𑆁𑆱𑆠𑆳 𑆱𑆫𑇀𑆮𑆖𑆼𑆰𑇀𑆛𑆳𑆱𑇀𑆮𑆥𑇀𑆫𑆠𑆴𑆔𑆳𑆠𑆂 𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑆳𑆢𑆾 𑆧𑆳𑆲𑇀𑆪𑆳𑆤𑆳𑆩𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆟𑆳𑆁 𑆖 𑆑𑆫𑆟𑆳𑆤𑆳𑆩𑆳𑆠𑇀𑆩𑆑𑆳𑆫𑇀𑆪𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇒𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆏𑆘𑆂 𑆱𑆾𑆩𑆳𑆠𑇀𑆩𑆑𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆯𑆶𑆑𑇀𑆬𑆁 𑆯𑆵𑆠𑆁 𑆱𑇀𑆡𑆴𑆫𑆁 𑆱𑆫𑆩𑇀 𑇅 𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆁 𑆩𑆸𑆢𑆶 𑆩𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆖 𑆥𑇀𑆫𑆳𑆟𑆳𑆪𑆠𑆤𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇒𑇑𑇆
𑆢𑆼𑆲𑆂 𑆱𑆳𑆮𑆪𑆮𑆱𑇀𑆠𑆼𑆤 𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆾 𑆨𑆮𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆠𑆢𑆨𑆳𑆮𑆳𑆖𑇀𑆖 𑆯𑆵𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆯𑆫𑆵𑆫𑆳𑆟𑆴 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇆𑇒𑇒𑇆
𑆃𑆨𑆴𑆔𑆳𑆠𑆳𑆠𑇀𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑆑𑆾𑆥𑆳𑆖𑇀𑆗𑆾𑆑𑆳𑆢𑇀𑆣𑇀𑆪𑆳𑆤𑆳𑆖𑇀𑆗𑇀𑆫𑆩𑆳𑆠𑇀𑆑𑇀𑆰𑆶𑆣𑆂 𑇅 𑆏𑆘𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆵𑆪𑆠𑆼 𑆲𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆣𑆳𑆠𑆶𑆓𑇀𑆫𑆲𑆟𑆤𑆴𑆂𑆱𑆸𑆠𑆩𑇀 𑇅 𑆠𑆼𑆘𑆂 𑆱𑆩𑆵𑆫𑆴𑆠𑆁 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆪𑆠𑆴 𑆢𑆼𑆲𑆴𑆤𑆂 𑇆𑇒𑇓𑇆
𑆠𑆱𑇀𑆪 𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆾 𑆮𑇀𑆪𑆳𑆥𑆠𑇀 𑆑𑇀𑆰𑆪 𑆅𑆠𑆴 (𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳𑆂;) 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆱𑆤𑇀𑆣𑆴𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆾 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆱𑆢𑆤𑆁 𑆢𑆾𑆰𑆖𑇀𑆪𑆮𑆤𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆤𑇀𑆤𑆴𑆫𑆾𑆣𑆯𑇀𑆖 𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆼, 𑆱𑇀𑆠𑆧𑇀𑆣𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑆳 𑆮𑆳𑆠𑆯𑆾𑆦𑆾 𑆮𑆫𑇀𑆟𑆨𑆼𑆢𑆾 𑆓𑇀𑆬𑆳𑆤𑆴𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆤𑆴𑆢𑇀𑆫𑆳 𑆖 𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼, 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆾 𑆩𑆾𑆲𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆾 𑆩𑆫𑆟𑆩𑆴𑆠𑆴 𑆖 𑆑𑇀𑆰𑆪𑆼 𑇆𑇒𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳 𑆧𑆬𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆤𑆑𑇀𑆰𑆪𑆳𑆂 𑇅 𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆱𑆳𑆢𑆿 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆢𑆾𑆰𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆤𑆁 𑆯𑇀𑆫𑆩𑆂 𑇆𑇒𑇕𑇆
𑆃𑆥𑇀𑆫𑆳𑆖𑆶𑆫𑇀𑆪𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖 𑆧𑆬𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆠𑆳𑇁𑆕𑇀𑆓𑆼𑆰𑆶 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆟𑆱𑇀𑆪 𑆨𑆼𑆢𑆤𑆩𑇀 𑇆𑇒𑇖𑇆
𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆤𑆴𑆢𑇀𑆫𑆳 𑆮𑆳𑆠𑆯𑆾𑆦𑆾 𑆧𑆬𑆮𑇀𑆪𑆳𑆥𑆢𑆴 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆾 𑆩𑆾𑆲𑆂 𑆥𑇀𑆫𑆬𑆳𑆥𑆾𑇁𑆘𑇀𑆚𑆳𑆤𑆩𑆼𑆮 𑆖 𑇆𑇒𑇗𑇆
𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆑𑇀𑆰𑆵𑆟𑆾 𑆧𑆬𑆑𑇀𑆰𑆵𑆟𑆾𑇁𑆥𑆴 𑆮𑆳 𑆤𑆫𑆂 𑇅 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆁 𑆪𑆠𑇀𑆠𑆢𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆠𑆴 𑇆𑇒𑇙𑇆
𑆪𑆢𑇀𑆪𑆢𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆁 𑆠𑆶 𑆑𑇀𑆰𑆵𑆟𑆂 𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆪𑆠𑆼 𑆤𑆫𑆂 𑇅 𑆠𑆱𑇀𑆪 𑆠𑆱𑇀𑆪 𑆱 𑆬𑆳𑆨𑆼 𑆠𑆶 𑆠𑆁 𑆠𑆁 𑆑𑇀𑆰𑆪𑆩𑆥𑆾𑆲𑆠𑆴 𑇆𑇓𑇐𑇆
𑆪𑆱𑇀𑆪 𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆂 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆑𑆫𑇀𑆩 𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀 𑇅 𑆥𑇀𑆫𑆑𑇀𑆰𑆵𑆟𑆁 𑆖 𑆧𑆬𑆁 𑆪𑆱𑇀𑆪 𑆤𑆳𑆱𑆿 𑆯𑆑𑇀𑆪𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆶𑆩𑇀 𑇆𑇓𑇑𑇆
𑆫𑆱𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆼𑆮 𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆁 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆁 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆲𑆳𑆫𑆱𑆼𑆮𑆴𑆤𑆾𑇁𑆣𑇀𑆪𑆯𑆤𑆯𑆵𑆬𑆱𑇀𑆪𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆴𑆤𑆾 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆫𑆠𑆱𑇀𑆪 𑆖𑆳𑆩 𑆍𑆮𑆳𑆤𑇀𑆤𑆫𑆱𑆾 𑆩𑆣𑆶𑆫𑆠𑆫𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆤𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀𑆩𑆼𑆢𑆾 𑆘𑆤𑆪𑆠𑆴, 𑆠𑆢𑆠𑆴𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴 ; 𑆠𑆩𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆁 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆯𑇀𑆮𑆳𑆱𑆥𑆴𑆥𑆳𑆱𑆳𑆑𑇀𑆰𑆶𑆠𑇀𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑇀𑆮𑆼𑆢𑆓𑆳𑆠𑇀𑆫𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆑𑇀𑆫𑆡𑆤𑆓𑆳𑆠𑇀𑆫𑆱𑆳𑆢𑆓𑆢𑇀𑆓𑆢𑆠𑇀𑆮𑆳𑆤𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆼𑆮𑆳𑆮𑆴𑆯𑆤𑇀𑆠𑆴, 𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆂 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆮𑆱𑆩𑆫𑇀𑆡𑆂, 𑆑𑆦𑆩𑆼𑆢𑆾𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆳𑆬𑇀𑆥𑆮𑇀𑆪𑆮𑆳𑆪𑆾 𑆨𑆮𑆠𑆴, 𑆄𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆢𑆼𑆮 𑆯𑆼𑆰𑆳 𑆣𑆳𑆠𑆮𑆾 𑆤𑆳𑆥𑇀𑆪𑆳𑆪𑆤𑇀𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆠𑆾𑇁𑆬𑇀𑆥𑆥𑇀𑆫𑆳𑆟𑆾 𑆨𑆮𑆠𑆴, 𑆥𑇀𑆫𑆩𑆼𑆲𑆥𑆴𑆝𑆑𑆳𑆘𑇀𑆮𑆫𑆨𑆓𑆤𑇀𑆢𑆫𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆥𑆚𑇀𑆖𑆠𑇀𑆮𑆩𑆶𑆥𑆪𑆳𑆠𑆴, 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆖𑆳𑆱𑇀𑆪 𑆫𑆾𑆓𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑇀; 𑆃𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆇𑆠𑇀𑆥𑆤𑇀𑆤𑆼 𑆠𑆶 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆬𑆾𑆲𑆫𑆘𑆾𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑆣𑆶𑆪𑆮𑆩𑆶𑆢𑇀𑆓𑆑𑆾𑆫𑆢𑆷𑆰𑆑𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆖𑇀𑆗𑆼𑆢𑆤𑆵𑆪𑆳𑆤𑆳𑆁 𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑆶𑆥𑆪𑆾𑆓𑆾 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾 𑆬𑆼𑆒𑆤𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇓𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆠𑆬𑆳𑆲𑆳𑆫𑆱𑆼𑆮𑆴𑆤𑆾𑇁𑆠𑆴𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆣𑇀𑆪𑆪𑆤𑆨𑆪𑆯𑆾𑆑𑆣𑇀𑆪𑆳𑆤𑆫𑆳𑆠𑇀𑆫𑆴𑆘𑆳𑆓𑆫𑆟𑆥𑆴𑆥𑆳𑆱𑆳𑆑𑇀𑆰𑆶 𑆠𑇀𑆑𑆰𑆳𑆪𑆳𑆬𑇀𑆥𑆳𑆯𑆤𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆯𑆾𑆰𑆴𑆠𑆾 𑆫𑆱𑆣𑆳𑆠𑆶𑆂 𑆯𑆫𑆵𑆫𑆩𑆤𑆤𑆶𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆤𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆥𑇀𑆫𑆵𑆟𑆳𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆢𑆠𑆴𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆁 𑆨𑆮𑆠𑆴; 𑆱𑆾𑇁𑆠𑆴𑆑𑆸𑆯𑆂 𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆳𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆳𑆠𑆮𑆫𑇀𑆰𑆨𑆳𑆫𑆳𑆢𑆳𑆤𑆼𑆰𑇀𑆮𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆫𑇀𑆮𑆳𑆠𑆫𑆾𑆓𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆬𑇀𑆥𑆥𑇀𑆫𑆳𑆟𑆯𑇀𑆖 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆨𑆮𑆠𑆴, 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆯𑆾𑆰𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆓𑆶𑆬𑇀𑆩𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆩𑆫𑆟𑆩𑆶𑆥𑆪𑆳𑆠𑆴, 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆖𑆳𑆱𑇀𑆪 𑆫𑆾𑆓𑆳 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆬𑇀𑆥𑆥𑇀𑆫𑆳𑆟𑆠𑇀𑆮𑆳𑆠𑇀; 𑆃𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇅 𑆇𑆠𑇀𑆥𑆤𑇀𑆤𑆼 𑆠𑆶 𑆥𑆪𑆱𑇀𑆪𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆯𑆠𑆳𑆮𑆫𑆵𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆤𑆳𑆓𑆧𑆬𑆳𑆤𑆳𑆁 𑆩𑆣𑆶𑆫𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆳𑆱𑆳𑆁 𑆖𑆿𑆰𑆣𑆵𑆤𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂, 𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆔𑆸𑆠𑆩𑆳𑆁𑆱𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆳𑆤𑆳𑆁 𑆖, 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆧𑆸𑆁𑆲𑆟𑆧𑆱𑇀𑆠𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇓𑇓𑇆
𑆪𑆂 𑆥𑆶𑆤𑆫𑆶𑆨𑆪𑆱𑆳𑆣𑆳𑆫𑆟𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆼𑆠 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆫𑆱𑆂 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆑𑇀𑆫𑆳𑆩𑆤𑇀 𑆱𑆩𑆳𑆤𑇀 𑆣𑆳𑆠𑆷𑆤𑆶𑆥𑆖𑆴𑆤𑆾𑆠𑆴, 𑆱𑆩𑆣𑆳𑆠𑆶𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆣𑇀𑆪𑆯𑆫𑆵𑆫𑆾 𑆨𑆮𑆠𑆴 𑆱𑆫𑇀𑆮𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆱𑆩𑆫𑇀𑆡𑆂 𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆳𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆳𑆠𑆮𑆫𑇀𑆰𑆳𑆠𑆥𑆱𑆲𑆾 𑆧𑆬𑆮𑆳𑆁𑆯𑇀𑆖, 𑆱 𑆱𑆠𑆠𑆩𑆤𑆶𑆥𑆳𑆬𑆪𑆴𑆠𑆮𑇀𑆪 𑆅𑆠𑆴 𑇆𑇓𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆠𑇀𑆪𑆤𑇀𑆠𑆓𑆫𑇀𑆲𑆴𑆠𑆳𑆮𑆼𑆠𑆿 𑆱𑆢𑆳 𑆱𑇀𑆡𑆷𑆬𑆑𑆸𑆯𑆿 𑆤𑆫𑆿 𑇅 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆩𑆣𑇀𑆪𑆯𑆫𑆵𑆫𑆱𑇀𑆠𑆶 𑆑𑆸𑆯𑆂 𑆱𑇀𑆡𑆷𑆬𑆳𑆠𑇀𑆠𑆶 𑆥𑆷𑆘𑆴𑆠𑆂 𑇆𑇓𑇕𑇆
𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾 𑆣𑆳𑆠𑆷𑆤𑇀 𑆑𑇀𑆰𑆥𑆪𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆠𑆼𑆘𑆱𑆳 𑇅 𑆅𑆢𑇀𑆣𑆂 𑆱𑇀𑆮𑆠𑆼𑆘𑆱𑆳 𑆮𑆲𑇀𑆤𑆴𑆫𑆶𑆒𑆳𑆓𑆠𑆩𑆴𑆮𑆾𑆢𑆑𑆩𑇀 𑇆𑇓𑇖𑇆
𑆮𑆽𑆬𑆑𑇀𑆰𑆟𑇀𑆪𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆳𑆟𑆳𑆩𑆱𑇀𑆡𑆳𑆪𑆴𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆥𑆫𑆴𑆩𑆳𑆟𑆁 𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑇆𑇓𑇗𑇆
𑆍𑆰𑆳𑆁 𑆱𑆩𑆠𑇀𑆮𑆁 𑆪𑆖𑇀𑆖𑆳𑆥𑆴 𑆨𑆴𑆰𑆓𑇀𑆨𑆴𑆫𑆮𑆣𑆳𑆫𑇀𑆪𑆠𑆼 𑇅 𑆤 𑆠𑆠𑇀 𑆱𑇀𑆮𑆳𑆱𑇀𑆡𑇀𑆪𑆳𑆢𑆸𑆠𑆼 𑆯𑆑𑇀𑆪𑆁 𑆮𑆑𑇀𑆠𑆶𑆩𑆤𑇀𑆪𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳 𑇆𑇓𑇘𑇆
𑆢𑆾𑆰𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑇀𑆮𑆱𑆩𑆠𑆳𑆩𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆃𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆁 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇙𑇆
(𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪 𑆫𑆑𑇀𑆰𑆟𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪 𑆠𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀) 𑇅 𑆑𑇀𑆰𑆥𑆪𑆼𑆢𑇀𑆧𑆸𑆁𑆲𑆪𑆼𑆖𑇀𑆖𑆳𑆥𑆴 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆩𑆬𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆢𑆫𑆾𑆓𑆂 𑆱𑇀𑆪𑆳𑆢𑆼𑆠𑆠𑇀𑆱𑆳𑆩𑇀𑆪𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇔𑇐𑇆
𑆱𑆩𑆢𑆾𑆰𑆂 𑆱𑆩𑆳𑆓𑇀𑆤𑆴𑆯𑇀𑆖 𑆱𑆩𑆣𑆳𑆠𑆶𑆩𑆬𑆑𑇀𑆫𑆴𑆪𑆂 𑇅 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆳𑆠𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆳𑆂 𑆱𑇀𑆮𑆱𑇀𑆡 𑆅𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇔𑇑𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆫𑇀𑆟𑆮𑇀𑆪𑆣𑆧𑆤𑇀𑆣𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆫𑆑𑇀𑆰𑆳𑆨𑆷𑆰𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆧𑆳𑆬𑆱𑇀𑆪 𑆑𑆫𑇀𑆟𑆿 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑆼 𑇅 𑆠𑆿 𑆰𑆰𑇀𑆜𑆼 𑆩𑆳𑆱𑆴 𑆱𑆥𑇀𑆠𑆩𑆼 𑆮𑆳 𑆯𑆶𑆑𑇀𑆬𑆥𑆑𑇀𑆰𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼𑆰𑆶 𑆠𑆴𑆡𑆴𑆑𑆫𑆟𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆰𑆶 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆁 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆑𑆼 𑆑𑆶𑆩𑆳𑆫𑆣𑆫𑆳𑆕𑇀𑆑𑆼 𑆮𑆳 𑆑𑆶𑆩𑆳𑆫𑆩𑆶𑆥𑆮𑆼𑆯𑇀𑆪 𑆧𑆳𑆬𑆑𑇀𑆫𑆵𑆝𑆤𑆑𑆽𑆂 𑆥𑇀𑆫𑆬𑆾𑆨𑇀𑆪𑆳𑆨𑆴𑆱𑆳𑆤𑇀𑆠𑇀𑆮𑆪𑆤𑇀 𑆨𑆴𑆰𑆓𑇀𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆼𑆤𑆳𑆑𑆸𑆰𑇀𑆪 𑆑𑆫𑇀𑆟𑆁 𑆢𑆽𑆮𑆑𑆸𑆠𑆼 𑆗𑆴𑆢𑇀𑆫 𑆄𑆢𑆴𑆠𑇀𑆪𑆑𑆫𑆳𑆮𑆨𑆳𑆱𑆴𑆠𑆼 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆫𑇀𑆢𑆑𑇀𑆰𑆴𑆟𑆲𑆱𑇀𑆠𑆼𑆤𑆫𑇀𑆘𑆶 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀, 𑆥𑇀𑆫𑆠𑆤𑆶𑆑𑆁 𑆱𑆷𑆖𑇀𑆪𑆳, 𑆧𑆲𑆬𑆩𑆳𑆫𑆪𑆳, 𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪, 𑆮𑆳𑆩𑆁 𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆳𑆂; 𑆠𑆠𑆂 𑆥𑆴𑆖𑆶𑆮𑆫𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆠𑇀 𑇆𑇓𑇆
𑆯𑆾𑆟𑆴𑆠𑆧𑆲𑆶𑆠𑇀𑆮𑆼𑆤 𑆮𑆼𑆢𑆤𑆪𑆳 𑆖𑆳𑆤𑇀𑆪𑆢𑆼𑆯𑆮𑆴𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀, 𑆤𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆠𑆪𑆳 𑆠𑆢𑇀𑆢𑆼𑆯𑆮𑆴𑆢𑇀𑆣𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆘𑇀𑆚𑆼𑆤 𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆳 𑆮𑆴𑆢𑇀𑆣𑆳𑆱𑆶 𑆱𑆴𑆫𑆳𑆱𑆶 𑆑𑆳𑆬𑆴𑆑𑆳𑆩𑆫𑇀𑆩𑆫𑆴𑆑𑆳𑆬𑆾𑆲𑆴𑆠𑆴𑆑𑆳𑆱𑆷𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆑𑆳𑆬𑆴𑆑𑆳𑆪𑆳𑆁 𑆘𑇀𑆮𑆫𑆾 𑆢𑆳𑆲𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆮𑆼𑆢𑆤𑆳 𑆖 𑆨𑆮𑆠𑆴; 𑆩𑆫𑇀𑆩𑆫𑆴𑆑𑆳𑆪𑆳𑆁 𑆮𑆼𑆢𑆤𑆳 𑆘𑇀𑆮𑆫𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆪𑆯𑇀𑆖; 𑆬𑆾𑆲𑆴𑆠𑆴𑆑𑆳𑆪𑆳𑆁 𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆥𑆠𑆳𑆤𑆑𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆲𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆼𑆰𑆶 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇕𑇆
𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆘𑆴𑆲𑇀𑆩𑆳𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆱𑆷𑆖𑆵𑆮𑇀𑆪𑆣𑆳𑆢𑇀𑆓𑆳𑆞𑆠𑆫𑆮𑆫𑇀𑆠𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑆾𑆰𑆱𑆩𑆶𑆢𑆳𑆪𑆳𑆢𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆮𑇀𑆪𑆣𑆳𑆢𑇀𑆮𑆳 𑆪𑆠𑇀𑆫 𑆱𑆁𑆫𑆩𑇀𑆨𑆾 𑆮𑆼𑆢𑆤𑆳 𑆮𑆳 𑆨𑆮𑆠𑆴 𑆠𑆠𑇀𑆫 𑆮𑆫𑇀𑆠𑆴𑆩𑆶𑆥𑆲𑆸𑆠𑇀𑆪𑆳𑆯𑆶 𑆩𑆣𑆶𑆑𑆽𑆫𑆟𑇀𑆝𑆩𑆷𑆬𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆪𑆮𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆩𑆣𑆶𑆔𑆸𑆠𑆥𑇀𑆫𑆓𑆳𑆞𑆽𑆫𑆳𑆬𑆼𑆥𑆪𑆼𑆠𑇀𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆶𑆫𑆷𑆞 𑆅𑆠𑆴; 𑆱𑆶𑆫𑆷𑆞𑆁 𑆖𑆽𑆤𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀; 𑆮𑆴𑆣𑆳𑆤𑆁 𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆩𑆼𑆮 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆢𑇀𑆣𑆩𑆳𑆩𑆠𑆽𑆬𑆼𑆤 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀, 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆖𑇀𑆖 𑆮𑆫𑇀𑆠𑆴𑆁 𑆱𑇀𑆡𑆷𑆬𑆠𑆫𑆳𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆥𑆫𑆴𑆰𑆼𑆑𑆁 𑆖 𑆠𑆩𑆼𑆮 𑇆𑇗𑇆
𑆃𑆡 𑆮𑇀𑆪𑆥𑆓𑆠𑆢𑆾𑆰𑆾𑆥𑆢𑇀𑆫𑆮𑆼 𑆑𑆫𑇀𑆟𑆼 𑆮𑆫𑇀𑆣𑆤𑆳𑆫𑇀𑆡𑆁 𑆬𑆔𑆶 𑆮𑆫𑇀𑆣𑆤𑆑𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇘𑇆
𑆍𑆮𑆁 𑆮𑆴𑆮𑆫𑇀𑆣𑆴𑆠𑆂 𑆑𑆫𑇀𑆟𑆯𑇀𑆗𑆴𑆢𑇀𑆪𑆠𑆼 𑆠𑆶 𑆢𑇀𑆮𑆴𑆣𑆳 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆢𑆾𑆰𑆠𑆾 𑆮𑆳𑇁𑆨𑆴𑆔𑆳𑆠𑆳𑆢𑇀𑆮𑆳 𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆠𑆱𑇀𑆪 𑆩𑆼 𑆯𑆸𑆟𑆶 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆱𑆩𑆳𑆱𑆼𑆤 𑆥𑆚𑇀𑆖𑆢𑆯𑆑𑆫𑇀𑆟𑆧𑆤𑇀𑆣𑆳𑆑𑆸𑆠𑆪𑆂 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆤𑆼𑆩𑆴𑆱𑆤𑇀𑆣𑆳𑆤𑆑 𑆇𑆠𑇀𑆥𑆬𑆨𑆼𑆢𑇀𑆪𑆑𑆾 𑆮𑆬𑇀𑆬𑆷𑆫𑆑 𑆄𑆱𑆕𑇀𑆓𑆴𑆩𑆾 𑆓𑆟𑇀𑆝𑆑𑆫𑇀𑆟 𑆄𑆲𑆳𑆫𑇀𑆪𑆾 𑆤𑆴𑆫𑇀𑆮𑆼𑆣𑆴𑆩𑆾 𑆮𑇀𑆪𑆳𑆪𑆾𑆘𑆴𑆩𑆂 𑆑𑆥𑆳𑆛𑆱𑆤𑇀𑆣𑆴𑆑𑆾𑇁𑆫𑇀𑆣𑆑𑆥𑆳𑆛𑆱𑆤𑇀𑆣𑆴𑆑𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆾 𑆲𑆵𑆤𑆑𑆫𑇀𑆟𑆾 𑆮𑆬𑇀𑆬𑆵𑆑𑆫𑇀𑆟𑆾 𑆪𑆰𑇀𑆛𑆴𑆑𑆫𑇀𑆟𑆂 𑆑𑆳𑆑𑆿𑆰𑇀𑆜𑆑 𑆅𑆠𑆴 𑇅 𑆠𑆼𑆰𑆶, 𑆥𑆸𑆡𑆶𑆬𑆳𑆪𑆠𑆱𑆩𑆾𑆨𑆪𑆥𑆳𑆬𑆴𑆫𑇀𑆤𑆼𑆩𑆴𑆱𑆤𑇀𑆣𑆳𑆤𑆑𑆂, 𑆮𑆸𑆠𑇀𑆠𑆳𑆪𑆠𑆱𑆩𑆾𑆨𑆪𑆥𑆳𑆬𑆴𑆫𑆶𑆠𑇀𑆥𑆬𑆨𑆼𑆢𑇀𑆪𑆑𑆂; 𑆲𑇀𑆫𑆱𑇀𑆮𑆮𑆸𑆠𑇀𑆠𑆱𑆩𑆾𑆨𑆪𑆥𑆳𑆬𑆴𑆫𑇀𑆮𑆬𑇀𑆬𑆷𑆫𑆑𑆂; 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆢𑆵𑆫𑇀𑆔𑆽𑆑𑆥𑆳𑆬𑆴𑆫𑆳𑆱𑆕𑇀𑆓𑆴𑆩𑆂; 𑆧𑆳𑆲𑇀𑆪𑆢𑆵𑆫𑇀𑆔𑆽𑆑𑆥𑆳𑆬𑆴𑆫𑇀𑆓𑆟𑇀𑆝𑆑𑆫𑇀𑆟𑆂; 𑆃𑆥𑆳𑆬𑆴𑆫𑆶𑆨𑆪𑆠𑆾𑇁𑆥𑇀𑆪𑆳𑆲𑆳𑆫𑇀𑆪𑆂; 𑆥𑆵𑆜𑆾𑆥𑆩𑆥𑆳𑆬𑆴𑆫𑆶𑆨𑆪𑆠𑆂 𑆑𑇀𑆰𑆵𑆟𑆥𑆶𑆠𑇀𑆫𑆴𑆑𑆳𑆯𑇀𑆫𑆴𑆠𑆾 𑆤𑆴𑆫𑇀𑆮𑆼𑆣𑆴𑆩𑆂, 𑆱𑇀𑆡𑆷𑆬𑆳𑆟𑆶𑆱𑆩𑆮𑆴𑆰𑆩𑆥𑆳𑆬𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆪𑆾𑆘𑆴𑆩𑆂; 𑆃𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆢𑆵𑆫𑇀𑆔𑆽𑆑𑆥𑆳𑆬𑆴𑆫𑆴𑆠𑆫𑆳𑆬𑇀𑆥𑆥𑆳𑆬𑆴𑆂 𑆑𑆥𑆳𑆛𑆱𑆤𑇀𑆣𑆴𑆑𑆂; 𑆧𑆳𑆲𑇀𑆪𑆢𑆵𑆫𑇀𑆔𑆽𑆑𑆥𑆳𑆬𑆴𑆫𑆴𑆠𑆫𑆳𑆬𑇀𑆥𑆥𑆳𑆬𑆴𑆫𑆫𑇀𑆣𑆑𑆥𑆳𑆛𑆱𑆤𑇀𑆣𑆴𑆑𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆢𑆯𑆽𑆠𑆼 𑆑𑆫𑇀𑆟𑆧𑆤𑇀𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆂 ; 𑆠𑆼𑆰𑆳𑆁 𑆱𑇀𑆮𑆤𑆳𑆩𑆨𑆴𑆫𑆼𑆮𑆳𑆑𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆳𑆢𑆪𑆂 𑆥𑆚𑇀𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆯𑆶𑆰𑇀𑆑𑆯𑆰𑇀𑆑𑆶𑆬𑆴𑆫𑆶𑆠𑇀𑆱𑆤𑇀𑆤𑆥𑆳𑆬𑆴𑆫𑆴𑆠𑆫𑆳𑆬𑇀𑆥𑆥𑆳𑆬𑆴𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆂 ; 𑆃𑆤𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆥𑆳𑆬𑆴𑆂 𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆪𑆾𑆂 𑆑𑇀𑆰𑆵𑆟𑆩𑆳𑆁𑆱𑆾 𑆲𑆵𑆤𑆑𑆫𑇀𑆟𑆂; 𑆠𑆤𑆶𑆮𑆴𑆰𑆩𑆳𑆬𑇀𑆥𑆥𑆳𑆬𑆴𑆫𑇀𑆮𑆬𑇀𑆬𑆵𑆑𑆫𑇀𑆟𑆂; 𑆓𑇀𑆫𑆡𑆴𑆠𑆩𑆳𑆁𑆱𑆱𑇀𑆠𑆧𑇀𑆣𑆱𑆴𑆫𑆳𑆠𑆠𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆥𑆳𑆬𑆴𑆫𑇀𑆪𑆰𑇀𑆛𑆴𑆑𑆫𑇀𑆟𑆂; 𑆤𑆴𑆫𑇀𑆩𑆳𑆁𑆱𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆳𑆓𑇀𑆫𑆳𑆬𑇀𑆥𑆯𑆾𑆟𑆴𑆠𑆥𑆳𑆬𑆴𑆂 𑆑𑆳𑆑𑆿𑆰𑇀𑆜𑆑 𑆅𑆠𑆴 𑇅 𑆧𑆢𑇀𑆣𑆼𑆰𑇀𑆮𑆥𑆴 𑆠𑆶 𑆯𑆾𑆦𑆢𑆳𑆲𑆫𑆳𑆓𑆥𑆳𑆑𑆥𑆴𑆝𑆑𑆳𑆱𑇀𑆫𑆳𑆮𑆪𑆶𑆑𑇀𑆠𑆳 𑆤 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑇆𑇑𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆱𑇀𑆪 𑆥𑆳𑆬𑆴𑆢𑇀𑆮𑆪𑆩𑆥𑆴 𑆑𑆫𑇀𑆟𑆱𑇀𑆪 𑆤 𑆨𑆮𑆼𑆢𑆴𑆲 𑇅 𑆑𑆫𑇀𑆟𑆥𑆵𑆜𑆁 𑆱𑆩𑆼 𑆩𑆣𑇀𑆪𑆼 𑆠𑆱𑇀𑆪 𑆮𑆴𑆢𑇀𑆣𑇀𑆮𑆳 𑆮𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆧𑆳𑆲𑇀𑆪𑆳𑆪𑆳𑆩𑆴𑆲 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆳𑆁 𑆱𑆤𑇀𑆣𑆴𑆫𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆾 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆄𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆪𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆳𑆁 𑆧𑆳𑆲𑇀𑆪𑆱𑆤𑇀𑆔𑆴𑆫𑆶𑆢𑆳𑆲𑆸𑆠𑆂 𑇆𑇑𑇒𑇆
𑆍𑆑𑆽𑆮 𑆠𑆶 𑆨𑆮𑆼𑆠𑇀 𑆥𑆳𑆬𑆴𑆂 𑆱𑇀𑆡𑆷𑆬𑆳 𑆥𑆸𑆡𑇀𑆮𑆵 𑆱𑇀𑆡𑆴𑆫𑆳 𑆖 𑆪𑆳 𑇅 𑆠𑆳𑆁 𑆢𑇀𑆮𑆴𑆣𑆳 𑆥𑆳𑆛𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳 𑆖𑆾𑆥𑆫𑆴 𑆱𑆤𑇀𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇓𑇆
𑆓𑆟𑇀𑆝𑆳𑆢𑆶𑆠𑇀𑆥𑆳𑆛𑇀𑆪 𑆩𑆳𑆁𑆱𑆼𑆤 𑆱𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆼𑆤 𑆘𑆵𑆮𑆠𑆳 𑇅 𑆑𑆫𑇀𑆟𑆥𑆳𑆬𑆵𑆩𑆥𑆳𑆬𑆼𑆱𑇀𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆫𑇀𑆬𑆴𑆒𑇀𑆪 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆠𑇀 𑇆𑇑𑇔𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆁 𑆧𑆤𑇀𑆣𑆁 𑆖𑆴𑆑𑆵𑆫𑇀𑆰𑆶𑆫𑆓𑇀𑆫𑆾𑆥𑆲𑆫𑆟𑆵𑆪𑆾𑆑𑇀𑆠𑆾𑆥𑆱𑆩𑇀𑆨𑆸𑆠𑆱𑆩𑇀𑆨𑆳𑆫𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫𑆾𑆥𑆲𑆫𑆼𑆠𑇀 𑆱𑆶𑆫𑆳𑆩𑆟𑇀𑆝𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆢𑆑𑆁 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆁 𑆑𑆥𑆳𑆬𑆖𑆷𑆫𑇀𑆟𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑆾𑇁𑆕𑇀𑆓𑆤𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆮𑆳 𑆓𑇀𑆫𑆡𑆴𑆠𑆑𑆼𑆯𑆳𑆤𑇀𑆠𑆁 𑆬𑆔𑆶 𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆩𑆳𑆥𑇀𑆠𑆽𑆂 𑆱𑆶𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆁 𑆖 𑆑𑆸𑆠𑇀𑆮𑆳, 𑆧𑆤𑇀𑆣𑆩𑆶𑆥𑆣𑆳𑆫𑇀𑆪, 𑆗𑆼𑆢𑇀𑆪𑆨𑆼𑆢𑇀𑆪𑆬𑆼𑆒𑇀𑆪𑆮𑇀𑆪𑆣𑆤𑆽𑆫𑆶𑆥𑆥𑆤𑇀𑆤𑆽𑆫𑆶𑆥𑆥𑆳𑆢𑇀𑆪, 𑆑𑆫𑇀𑆟𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆢𑆶𑆰𑇀𑆛𑆩𑆢𑆶𑆰𑇀𑆛𑆁 𑆮𑆼𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆢𑆶𑆰𑇀𑆛𑆼 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆢𑆶𑆰𑇀𑆛𑆼 𑆯𑆵𑆠𑆾𑆢𑆑𑆥𑆪𑆾𑆨𑇀𑆪𑆳𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆢𑆶𑆰𑇀𑆛𑆼 𑆱𑆶𑆫𑆳𑆩𑆟𑇀𑆝𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆑𑆫𑇀𑆟𑆿, 𑆥𑆶𑆤𑆫𑆮𑆬𑆴𑆒𑇀𑆪𑆳𑆤𑆶𑆤𑇀𑆤𑆠𑆩𑆲𑆵𑆤𑆩𑆮𑆴𑆰𑆩𑆁 𑆖 𑆑𑆫𑇀𑆟𑆱𑆤𑇀𑆣𑆴𑆁 𑆱𑆤𑇀𑆤𑆴𑆮𑆼𑆯𑇀𑆪, 𑆱𑇀𑆡𑆴𑆠𑆫𑆑𑇀𑆠𑆁 𑆱𑆤𑇀𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑆾 𑆩𑆣𑆶𑆔𑆸𑆠𑆼𑆤𑆳𑆨𑇀𑆪𑆘𑇀𑆪 𑆥𑆴𑆖𑆶𑆥𑇀𑆫𑆾𑆠𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆼𑆟𑆳𑆮𑆓𑆶𑆟𑇀𑆜𑇀𑆪 𑆱𑆷𑆠𑇀𑆫𑆼𑆟𑆳𑆤𑆮𑆓𑆳𑆞𑆩𑆤𑆠𑆴𑆯𑆴𑆡𑆴𑆬𑆁 𑆖 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆑𑆥𑆳𑆬𑆖𑆷𑆫𑇀𑆟𑆼𑆤𑆳𑆮𑆑𑆵𑆫𑇀𑆪𑆳𑆖𑆳𑆫𑆴𑆑𑆩𑆶𑆥𑆢𑆴𑆯𑆼𑆠𑇀, 𑆢𑇀𑆮𑆴𑆮𑇀𑆫𑆟𑆵𑆪𑆾𑆑𑇀𑆠𑆼𑆤 𑆖 𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆴𑆔𑆛𑇀𑆛𑆤𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆩𑆠𑆴𑆨𑆾𑆘𑆤𑆩𑇀 𑇅 𑆮𑇀𑆪𑆮𑆳𑆪𑆩𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆳𑆥𑆁 𑆮𑆳𑆑𑇀𑆯𑇀𑆫𑆩𑆁 𑆖 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆤 𑆖𑆳𑆯𑆶𑆢𑇀𑆣𑆫𑆑𑇀𑆠𑆩𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆁 𑆑𑇀𑆰𑆵𑆟𑆫𑆑𑇀𑆠𑆁 𑆮𑆳 𑆱𑆤𑇀𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆱 𑆲𑆴 𑆮𑆳𑆠𑆢𑆶𑆰𑇀𑆛𑆼 𑆫𑆑𑇀𑆠𑆼 𑆫𑆷𑆞𑆾𑇁𑆥𑆴 𑆥𑆫𑆴𑆥𑆶𑆛𑆤𑆮𑆳𑆤𑇀, 𑆥𑆴𑆠𑇀𑆠𑆢𑆶𑆰𑇀𑆛𑆼 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆮𑆼𑆢𑆤𑆳𑆮𑆳𑆤𑇀, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆢𑆶𑆰𑇀𑆛𑆼 𑆱𑇀𑆠𑆧𑇀𑆣𑆂 𑆑𑆟𑇀𑆝𑆷𑆩𑆳𑆤𑇀, 𑆃𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆼 𑆯𑇀𑆪𑆳𑆮𑆯𑆾𑆦𑆮𑆳𑆤𑇀, 𑆑𑇀𑆰𑆵𑆟𑆾𑇁𑆬𑇀𑆥𑆩𑆳𑆁𑆱𑆾 𑆤 𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆶𑆥𑆽𑆠𑆴 𑇆𑇑𑇗𑇆
(𑆄𑆩𑆠𑆽𑆬𑆼𑆤 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀, 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆳𑆖𑇀𑆖 𑆥𑆴𑆖𑆶𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀) 𑇅 𑆱 𑆪𑆢𑆳 𑆱𑆶𑆫𑆷𑆞𑆾 𑆤𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆂 𑆱𑆮𑆫𑇀𑆟𑆾 𑆨𑆮𑆠𑆴 𑆠𑆢𑆽𑆤𑆁 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆫𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀 𑇅 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆱𑆁𑆫𑆩𑇀𑆨𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆮𑆼𑆢𑆤𑆳𑆮𑆳𑆤𑇀, 𑆥𑆶𑆤𑆯𑇀𑆗𑆴𑆢𑇀𑆪𑆠𑆼 𑆮𑆳 𑇆𑇑𑇘𑇆
𑆱𑇀𑆮𑆼𑆢𑆴𑆠𑆾𑆤𑇀𑆩𑆫𑇀𑆢𑆴𑆠𑆁 𑆑𑆫𑇀𑆟𑆁 𑆱𑇀𑆤𑆼𑆲𑆼𑆤𑆽𑆠𑆼𑆤 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆃𑆡𑆳𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆂 𑆱𑆩𑇀𑆪𑆓𑇀𑆧𑆬𑆮𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑇆𑇒𑇐𑇆
𑆠𑆼𑆰𑆳𑆩𑆥𑆳𑆕𑇀𑆓𑆢𑆼𑆯𑆼 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆤𑆩𑆼𑆮 𑆠𑆶 𑇅 𑆧𑆳𑆲𑇀𑆪𑆖𑇀𑆗𑆼𑆢𑆁 𑆤 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆠𑆾𑆣𑇀𑆫𑆶𑆮𑆳𑆂 𑇆𑇒𑇓𑇆
𑆧𑆢𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆶 𑆪𑆂 𑆑𑆫𑇀𑆟𑆁 𑆱𑆲𑆱𑆽𑆮𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀 𑇅 𑆄𑆩𑆑𑆾𑆯𑆵 𑆱𑆩𑆳𑆣𑇀𑆩𑆳𑆠𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆼𑆮 𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇔𑇆
𑆘𑆳𑆠𑆫𑆾𑆩𑆳 𑆱𑆶𑆮𑆫𑇀𑆠𑇀𑆩𑆳 𑆖 𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆱𑆤𑇀𑆣𑆴𑆂 𑆱𑆩𑆂 𑆱𑇀𑆡𑆴𑆫𑆂 𑇅 𑆱𑆶𑆫𑆷𑆞𑆾𑇁𑆮𑆼𑆢𑆤𑆾 𑆪𑆯𑇀𑆖 𑆠𑆁 𑆑𑆫𑇀𑆟𑆁 𑆮𑆫𑇀𑆣𑆪𑆼𑆖𑇀𑆗𑆤𑆽𑆂 𑇆𑇒𑇕𑇆
𑆃𑆩𑆴𑆠𑆳𑆂 𑆑𑆫𑇀𑆟𑆧𑆤𑇀𑆣𑆳𑆱𑇀𑆠𑆶 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆑𑆶𑆯𑆬𑆽𑆫𑆴𑆲 𑇅 𑆪𑆾 𑆪𑆡𑆳 𑆱𑆶𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆁 𑆠𑆡𑆳 𑆮𑆴𑆤𑆴𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 (𑆑𑆫𑇀𑆟𑆥𑆳𑆬𑇀𑆪𑆳𑆩𑆪𑆳𑆤𑇀𑆤𑆹𑆟𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆶𑆯𑇀𑆫𑆶𑆠! 𑇅 𑆑𑆫𑇀𑆟𑆥𑆳𑆬𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂(𑇑) 𑇆𑇒𑇖𑇆
𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆴𑆠𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆡 𑆤𑆳𑆱𑆴𑆑𑆳𑆪𑆳 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆤𑇀𑆣𑆳𑆤𑆮𑆴𑆣𑆴𑆁 𑆪𑆡𑆳𑆮𑆠𑇀 𑇅 𑆤𑆳𑆱𑆳𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆥𑆸𑆡𑆴𑆮𑆵𑆫𑆶𑆲𑆳𑆟𑆳𑆁 𑆥𑆠𑇀𑆫𑆁 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆠𑇀𑆮𑆮𑆬𑆩𑇀𑆧𑆴 𑆠𑆱𑇀𑆪 𑇆𑇒𑇗𑇆
𑆠𑆼𑆤 𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆲𑆴 𑆓𑆟𑇀𑆝𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆢𑆶𑆠𑇀𑆑𑆸𑆠𑇀𑆪 𑆧𑆢𑇀𑆣𑆁 𑆠𑇀𑆮𑆡 𑆤𑆳𑆱𑆴𑆑𑆳𑆓𑇀𑆫𑆩𑇀 𑇅 𑆮𑆴𑆬𑆴𑆒𑇀𑆪 𑆖𑆳𑆯𑆶 𑆥𑇀𑆫𑆠𑆴𑆱𑆤𑇀𑆢𑆣𑆵𑆠 𑆠𑆠𑇀 𑆱𑆳𑆣𑆶𑆧𑆤𑇀𑆣𑆽𑆫𑇀𑆨𑆴𑆰𑆓𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆂 𑇆𑇒𑇘𑇆
𑆱𑆶𑆱𑆁𑆲𑆴𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆠𑆾 𑆪𑆡𑆳𑆮𑆤𑇀𑆤𑆳𑆝𑆵𑆢𑇀𑆮𑆪𑆼𑆤𑆳𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑇅 𑆥𑇀𑆫𑆾𑆤𑇀𑆤𑆩𑇀𑆪 𑆖𑆽𑆤𑆳𑆩𑆮𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑆠𑆶 𑆥𑆠𑆕𑇀𑆓𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆳𑆚𑇀𑆘𑆤𑆽𑆯𑇀𑆖 𑇆𑇒𑇙𑇆
𑆱𑆚𑇀𑆗𑆳𑆢𑇀𑆪 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆴𑆖𑆶𑆤𑆳 𑆱𑆴𑆠𑆼𑆤 𑆠𑆽𑆬𑆼𑆤 𑆱𑆴𑆚𑇀𑆖𑆼𑆢𑆱𑆑𑆸𑆠𑇀𑆠𑆴𑆬𑆳𑆤𑆳𑆩𑇀 𑇅 𑆔𑆸𑆠𑆁 𑆖 𑆥𑆳𑆪𑇀𑆪𑆂 𑆱 𑆤𑆫𑆂 𑆱𑆶𑆘𑆵𑆫𑇀𑆟𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆂 𑆱 𑆪𑆡𑆾𑆥𑆢𑆼𑆯𑆩𑇀 𑇆𑇓𑇐𑇆
𑆫𑆷𑆞𑆁 𑆖 𑆱𑆤𑇀𑆣𑆳𑆤𑆩𑆶𑆥𑆳𑆓𑆠𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑆫𑇀𑆣𑆯𑆼𑆰𑆁 𑆠𑆶 𑆥𑆶𑆤𑆫𑇀𑆤𑆴𑆑𑆸𑆤𑇀𑆠𑆼𑆠𑇀 𑇅 𑆲𑆵𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆫𑇀𑆣𑆪𑆴𑆠𑆶𑆁 𑆪𑆠𑆼𑆠 𑆱𑆩𑆳𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆩𑆳𑆁𑆱𑆳𑆩𑇀 𑇆𑇓𑇑𑇆
𑆤𑆳𑆝𑆵𑆪𑆾𑆓𑆁 𑆮𑆴𑆤𑆿𑆰𑇀𑆜𑆱𑇀𑆪 𑆤𑆳𑆱𑆳𑆱𑆤𑇀𑆣𑆳𑆤𑆮𑆢𑇀𑆮𑆴𑆣𑆴𑆩𑇀 𑇅 𑆪 𑆍𑆮𑆩𑆼𑆮 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱 𑆫𑆳𑆘𑇀𑆚𑆂 𑆑𑆫𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴 𑇆𑇓𑇒𑇆
𑆃𑆡𑆳𑆠 𑆄𑆩𑆥𑆑𑇀𑆮𑆽𑆰𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆯𑆾𑆦𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆬𑆘𑆵𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆮𑇀𑆪𑆳𑆣𑆪𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆳 𑆃𑆤𑆼𑆑𑆳𑆑𑆸𑆠𑆪𑆂, 𑆠𑆽𑆫𑇀𑆮𑆴𑆬𑆑𑇀𑆰𑆟𑆂 𑆥𑆸𑆡𑆶𑆫𑇀𑆓𑇀𑆫𑆡𑆴𑆠𑆂 𑆱𑆩𑆾 𑆮𑆴𑆰𑆩𑆾 𑆮𑆳 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆱𑇀𑆡𑆳𑆪𑆵 𑆢𑆾𑆰𑆱𑆕𑇀𑆔𑆳𑆠𑆂 𑆯𑆫𑆵𑆫𑆽𑆑𑆢𑆼𑆯𑆾𑆠𑇀𑆡𑆴𑆠𑆂 𑆯𑆾𑆦 𑆅𑆠𑇀𑆪𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆱 𑆰𑆝𑇀𑆮𑆴𑆣𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆯𑆾𑆟𑆴𑆠𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑇅 𑆠𑆱𑇀𑆪 𑆢𑆾𑆰𑆫𑆷𑆥𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆽𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆯𑆾𑆦𑆂 𑆑𑆸𑆰𑇀𑆟𑆾𑇁𑆫𑆶𑆟𑆾 𑆮𑆳 𑆥𑆫𑆶𑆰𑆾 𑆩𑆸𑆢𑆶𑆫𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆱𑇀𑆠𑆾𑆢𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆥𑆴𑆠𑇀𑆠𑆯𑆾𑆦𑆂 𑆥𑆵𑆠𑆾 𑆩𑆸𑆢𑆶𑆂 𑆱𑆫𑆑𑇀𑆠𑆾 𑆮𑆳 𑆯𑆵𑆔𑇀𑆫𑆳𑆤𑆶𑆱𑆳𑆫𑇀𑆪𑆾𑆰𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆂 𑆑𑆜𑆴𑆤𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆯𑆵𑆠𑆾 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆩𑆤𑇀𑆢𑆳𑆤𑆶𑆱𑆳𑆫𑆵 𑆑𑆟𑇀𑆝𑇀𑆮𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆱𑆫𑇀𑆮𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆂; 𑆥𑆴𑆠𑇀𑆠𑆮𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆘𑆾𑇁𑆠𑆴𑆑𑆸𑆰𑇀𑆟𑆯𑇀𑆖; 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆬𑆑𑇀𑆰𑆟 𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑇀𑆬𑆾𑆲𑆴𑆠𑆳𑆮𑆨𑆳𑆱𑆯𑇀𑆖 𑇆𑇔𑇆
𑆱 𑆪𑆢𑆳 𑆧𑆳𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆽𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆤 𑆱𑆩𑇀𑆨𑆳𑆮𑆴𑆠𑆂 𑆥𑇀𑆫𑆯𑆩𑆪𑆴𑆠𑆶𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆢𑇀𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑆢𑆳 𑆥𑆳𑆑𑆳𑆨𑆴𑆩𑆶𑆒𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆠𑆱𑇀𑆪𑆳𑆩𑆱𑇀𑆪 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆥𑆑𑇀𑆮𑆱𑇀𑆪 𑆖 𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆥𑆣𑆳𑆫𑆪- 𑇅 𑆠𑆠𑇀𑆫, 𑆩𑆤𑇀𑆢𑆾𑆰𑇀𑆩𑆠𑆳 𑆠𑇀𑆮𑆑𑇀𑆱𑆮𑆫𑇀𑆟𑆠𑆳 𑆯𑆵𑆠𑆯𑆾𑆦𑆠𑆳 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆩𑆤𑇀𑆢𑆮𑆼𑆢𑆤𑆠𑆳𑇁𑆬𑇀𑆥𑆯𑆾𑆦𑆠𑆳 𑆖𑆳𑆩𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁; 𑆱𑆷𑆖𑆴𑆨𑆴𑆫𑆴𑆮 𑆤𑆴𑆱𑇀𑆠𑆶𑆢𑇀𑆪𑆠𑆼, 𑆢𑆯𑇀𑆪𑆠 𑆅𑆮 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆨𑆴𑆂, 𑆠𑆳𑆨𑆴𑆯𑇀𑆖 𑆱𑆁𑆱𑆫𑇀𑆥𑇀𑆪𑆠 𑆅𑆮, 𑆗𑆴𑆢𑇀𑆪𑆠 𑆅𑆮 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟, 𑆨𑆴𑆢𑇀𑆪𑆠 𑆅𑆮 𑆯𑆑𑇀𑆠𑆴𑆨𑆴𑆂, 𑆠𑆳𑆝𑇀𑆪𑆠 𑆅𑆮 𑆢𑆟𑇀𑆝𑆼𑆤, 𑆥𑆵𑆝𑇀𑆪𑆠 𑆅𑆮 𑆥𑆳𑆟𑆴𑆤𑆳, 𑆔𑆛𑇀𑆪𑆠 𑆅𑆮 𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳, 𑆢𑆲𑇀𑆪𑆠𑆼 𑆥𑆖𑇀𑆪𑆠 𑆅𑆮 𑆖𑆳𑆓𑇀𑆤𑆴𑆑𑇀𑆰𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆩𑇀, 𑆏𑆰𑆖𑆾𑆰𑆥𑆫𑆵𑆢𑆳𑆲𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆮𑆴𑆢𑇀𑆣 𑆅𑆮 𑆖 𑆱𑇀𑆡𑆳𑆤𑆳𑆱𑆤𑆯𑆪𑆤𑆼𑆰𑆶 𑆤 𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆶𑆥𑆽𑆠𑆴, 𑆄𑆣𑇀𑆩𑆳𑆠𑆧𑆱𑇀𑆠𑆴𑆫𑆴𑆮𑆳𑆠𑆠𑆯𑇀𑆖 𑆯𑆾𑆦𑆾 𑆨𑆮𑆠𑆴 , 𑆠𑇀𑆮𑆓𑇀𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆯𑆾𑆦𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑆴𑆥𑆳𑆱𑆳 𑆨𑆑𑇀𑆠𑆳𑆫𑆶𑆖𑆴𑆯𑇀𑆖 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆁; 𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆴𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑇁𑆬𑇀𑆥𑆯𑆾𑆦𑆠𑆳 𑆮𑆬𑆵𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆱𑇀𑆠𑇀𑆮𑆑𑇀𑆥𑆫𑆴𑆥𑆶𑆛𑆤𑆁 𑆤𑆴𑆩𑇀𑆤𑆢𑆫𑇀𑆯𑆤𑆩𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆳𑇁𑆮𑆥𑆵𑆝𑆴𑆠𑆼 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆤𑇀𑆤𑆩𑆤𑆁, 𑆧𑆱𑇀𑆠𑆳𑆮𑆴𑆮𑆾𑆢𑆑𑆱𑆚𑇀𑆖𑆫𑆟𑆁 𑆥𑆷𑆪𑆱𑇀𑆪 𑆥𑇀𑆫𑆥𑆵𑆝𑆪𑆠𑇀𑆪𑆼𑆑𑆩𑆤𑇀𑆠𑆩𑆤𑇀𑆠𑆼 𑆖𑆳𑆮𑆥𑆵𑆝𑆴𑆠𑆼, 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆱𑇀𑆠𑆾𑆢𑆂 𑆑𑆟𑇀𑆝𑆷𑆫𑆶𑆤𑇀𑆤𑆠𑆠𑆳 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆨𑆑𑇀𑆠𑆳𑆨𑆴𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳 𑆖 𑆥𑆑𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆩𑇀 𑇅 𑆑𑆦𑆘𑆼𑆰𑆶 𑆠𑆶 𑆫𑆾𑆓𑆼𑆰𑆶 𑆓𑆩𑇀𑆨𑆵𑆫𑆓𑆠𑆴𑆠𑇀𑆮𑆳𑆢𑆨𑆴𑆔𑆳𑆠𑆘𑆼𑆰𑆶 𑆮𑆳 𑆑𑆼𑆰𑆶𑆖𑆴𑆢𑆱𑆩𑆱𑇀𑆠𑆁 𑆥𑆑𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑆑𑇀𑆮𑆩𑆥𑆑𑇀𑆮𑆩𑆴𑆠𑆴 𑆩𑆤𑇀𑆪𑆩𑆳𑆤𑆾 𑆨𑆴𑆰𑆕𑇀𑆩𑆾𑆲𑆩𑆶𑆥𑆽𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆲𑆴 𑆠𑇀𑆮𑆑𑇀𑆱𑆮𑆫𑇀𑆟𑆠𑆳 𑆯𑆵𑆠𑆯𑆾𑆦𑆠𑆳 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆩𑆬𑇀𑆥𑆫𑆶𑆘𑆠𑆳𑇁𑆯𑇀𑆩𑆮𑆖𑇀𑆖 𑆔𑆤𑆠𑆳, 𑆤 𑆩𑆾𑆲𑆩𑆶𑆥𑆼𑆪𑆳𑆢𑆴𑆠𑆴 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆩𑆁 𑆮𑆴𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆖 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆑𑇀𑆮𑆁 𑆖 𑆪𑆾 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀 𑆱 𑆨𑆮𑆼𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆂 𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆱𑇀𑆑𑆫𑆮𑆸𑆠𑇀𑆠𑆪𑆂 𑇆𑇖𑇆
𑆮𑆳𑆠𑆳𑆢𑆸𑆠𑆼 𑆤𑆳𑆱𑇀𑆠𑆴 𑆫𑆶𑆘𑆳 𑆤 𑆥𑆳𑆑𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆸𑆠𑆼 𑆤𑆳𑆱𑇀𑆠𑆴 𑆑𑆦𑆳𑆖𑇀𑆖 𑆥𑆷𑆪𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑆫𑆴𑆥𑆳𑆑𑆑𑆳𑆬𑆼 𑆥𑆖𑆤𑇀𑆠𑆴 𑆯𑆾𑆦𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆪 𑆍𑆮 𑆢𑆾𑆰𑆳𑆂 𑇆𑇗𑇆
𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆨𑇀𑆪𑆶𑆢𑆴𑆠𑆁 𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆮𑆯𑆼 𑆮𑆳𑆠𑆑𑆦𑆿 𑆥𑇀𑆫𑆱𑆲𑇀𑆪 𑇅 𑆥𑆖𑆠𑇀𑆪𑆠𑆂 𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆮 𑆥𑆳𑆑𑆾 𑆩𑆠𑆾𑇁𑆥𑆫𑆼𑆰𑆳𑆁 𑆮𑆴𑆢𑆶𑆰𑆳𑆁 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆂 𑇆𑇘𑇆
𑆠𑆠𑇀𑆫, 𑆄𑆩𑆖𑇀𑆗𑆼𑆢𑆼 𑆩𑆳𑆁𑆱𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆮𑇀𑆪𑆳𑆥𑆳𑆢𑆤𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾𑇁𑆮𑆢𑆫𑆟𑆩𑆤𑆼𑆑𑆾𑆥𑆢𑇀𑆫𑆮𑆢𑆫𑇀𑆯𑆤𑆁 𑆑𑇀𑆰𑆠𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆫𑇀𑆮𑆳 𑆨𑆮𑆠𑆴 𑇅 𑆱 𑆪𑆢𑆳 𑆨𑆪𑆩𑆾𑆲𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆑𑇀𑆮𑆩𑆥𑇀𑆪𑆥𑆑𑇀𑆮𑆩𑆴𑆠𑆴 𑆩𑆤𑇀𑆪𑆩𑆳𑆤𑆯𑇀𑆖𑆴𑆫𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆠𑆢𑆳 𑆓𑆩𑇀𑆨𑆵𑆫𑆳𑆤𑆶𑆓𑆠𑆾 𑆢𑇀𑆮𑆳𑆫𑆩𑆬𑆨𑆩𑆳𑆤𑆂 𑆥𑆷𑆪𑆂 𑆱𑇀𑆮𑆩𑆳𑆯𑇀𑆫𑆪𑆩𑆮𑆢𑆳𑆫𑇀𑆪𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆁 𑆩𑆲𑆳𑆤𑇀𑆠𑆩𑆮𑆑𑆳𑆯𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤𑆳𑆝𑆵𑆁 𑆘𑆤𑆪𑆴𑆠𑇀𑆮𑆳 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆾 𑆮𑆼𑆠𑆴 𑇆𑇙𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆯𑇀𑆗𑆴𑆤𑆠𑇀𑆠𑇀𑆪𑆳𑆩𑆩𑆘𑇀𑆚𑆳𑆤𑆳𑆢𑇀𑆪𑆯𑇀𑆖 𑆥𑆑𑇀𑆮𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆠𑆼 𑇅 𑆯𑇀𑆮𑆥𑆖𑆳𑆮𑆴𑆮 𑆩𑆤𑇀𑆠𑆮𑇀𑆪𑆿 𑆠𑆳𑆮𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆑𑆳𑆫𑆴𑆟𑆿 𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆳𑆑𑇀 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆩𑆟𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆁 𑆨𑆾𑆘𑆪𑆼𑆢𑆳𑆠𑆶𑆫𑆁 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆩𑆢𑇀𑆪𑆥𑆁 𑆥𑆳𑆪𑆪𑆼𑆤𑇀𑆩𑆢𑇀𑆪𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆪𑆾 𑆮𑆼𑆢𑆤𑆳𑇁𑆱𑆲𑆂 𑇆𑇑𑇑𑇆
𑆤 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆠𑇀𑆪𑆤𑇀𑆤𑆱𑆁𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆠𑇀𑆠𑆂 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆤 𑆧𑆶𑆣𑇀𑆪𑆠𑆼 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆮𑆯𑇀𑆪𑆁 𑆨𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆫𑆾𑆓𑆼𑆰𑆷𑆑𑇀𑆠𑆼𑆰𑆶 𑆑𑆫𑇀𑆩𑆟𑆴 𑇆𑇑𑇒𑇆
𑆥𑇀𑆫𑆳𑆟𑆾 𑆲𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆾 𑆤𑆹𑆟𑆳𑆁 𑆧𑆳𑆲𑇀𑆪𑆥𑇀𑆫𑆳𑆟𑆓𑆶𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆂 𑇅 𑆣𑆳𑆫𑆪𑆠𑇀𑆪𑆮𑆴𑆫𑆾𑆣𑆼𑆤 𑆯𑆫𑆵𑆫𑆁 𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆩𑇀 𑇆𑇑𑇓𑇆
𑆃𑆬𑇀𑆥𑆾 𑆩𑆲𑆳𑆤𑇀 𑆮𑆳 𑆑𑇀𑆫𑆴𑆪𑆪𑆳 𑆮𑆴𑆤𑆳 𑆪𑆂 𑆱𑆩𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆂 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴 𑆯𑆾𑆦𑆂 𑇅 𑆮𑆴𑆯𑆳𑆬𑆩𑆷𑆬𑆾 𑆮𑆴𑆰𑆩𑆁 𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆱 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆳𑆁 𑆪𑆳𑆠𑇀𑆪𑆮𑆓𑆳𑆞𑆢𑆾𑆰𑆂 𑇆𑇑𑇔𑇆
𑆄𑆬𑆼𑆥𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆟𑆳𑆯𑆾𑆣𑆤𑆽𑆱𑇀𑆠𑆶 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆪𑆢𑆴 𑆤𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆼𑆠𑇀 𑇅 𑆥𑆖𑇀𑆪𑆼𑆠 𑆯𑆵𑆔𑇀𑆫𑆁 𑆱𑆩𑆩𑆬𑇀𑆥𑆩𑆷𑆬𑆂 𑆱 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆯𑇀𑆖𑆾𑆥𑆫𑆴 𑆖𑆾𑆤𑇀𑆤𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇕𑇆
𑆑𑆑𑇀𑆰𑆁 𑆱𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆪𑆡𑆽𑆮 𑆮𑆲𑇀𑆤𑆴𑆫𑇀𑆮𑆳𑆪𑇀𑆮𑆵𑆫𑆴𑆠𑆂 𑆱𑆤𑇀𑆢𑆲𑆠𑆴 𑆥𑇀𑆫𑆱𑆲𑇀𑆪 𑇅 𑆠𑆡𑆽𑆮 𑆥𑆷𑆪𑆾𑇁𑆥𑇀𑆪𑆮𑆴𑆤𑆴𑆂𑆱𑆸𑆠𑆾 𑆲𑆴 𑆩𑆳𑆁𑆱𑆁 𑆱𑆴𑆫𑆳𑆂 𑆱𑇀𑆤𑆳𑆪𑆶 𑆖 𑆒𑆳𑆢𑆠𑆵𑆲 𑇆𑇑𑇖𑇆
𑆄𑆢𑆿 𑆮𑆴𑆩𑇀𑆬𑆳𑆥𑆤𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆩𑆮𑆱𑆼𑆖𑆤𑆩𑇀 𑇅 𑆠𑆸𑆠𑆵𑆪𑆩𑆶𑆥𑆤𑆳𑆲𑆁 𑆠𑆶 𑆖𑆠𑆶𑆫𑇀𑆡𑆵𑆁 𑆥𑆳𑆛𑆤𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇆𑇑𑇗𑇆
𑆥𑆚𑇀𑆖𑆩𑆁 𑆯𑆾𑆣𑆤𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆰𑆰𑇀𑆜𑆁 𑆫𑆾𑆥𑆟𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆍𑆠𑆼 𑆑𑇀𑆫𑆩𑆳 𑆮𑇀𑆫𑆟𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆳𑆂 𑆱𑆥𑇀𑆠𑆩𑆁 𑆮𑆽𑆑𑆸𑆠𑆳𑆥𑆲𑆩𑇀 𑇆𑇑𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑇀𑆫𑆟𑆳𑆬𑆼𑆥𑆤𑆧𑆤𑇀𑆣𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆄𑆬𑆼𑆥 𑆄𑆢𑇀𑆪 𑆇𑆥𑆑𑇀𑆫𑆩𑆂 , 𑆍𑆰 𑆱𑆫𑇀𑆮𑆯𑆾𑆦𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆯𑇀𑆖, 𑆠𑆁 𑆖 𑆥𑇀𑆫𑆠𑆴𑆫𑆾𑆓𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑆾 𑆧𑆤𑇀𑆣𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆠𑆼𑆤 𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆮𑇀𑆫𑆟𑆫𑆾𑆥𑆟𑆩𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆖 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆩𑆳𑆬𑆴𑆩𑇀𑆥𑆼𑆠𑇀 𑇅 𑆥𑇀𑆫𑆠𑆴𑆬𑆾𑆩𑆼 𑆲𑆴 𑆱𑆩𑇀𑆪𑆓𑆿𑆰𑆣𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼𑇁𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆫𑆾𑆩𑆑𑆷𑆥𑆳𑆤𑇀 𑆱𑇀𑆮𑆼𑆢𑆮𑆳𑆲𑆴𑆨𑆴𑆯𑇀𑆖 𑆱𑆴𑆫𑆳𑆩𑆶𑆒𑆽𑆫𑇀𑆮𑆵𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑇆𑇔𑇆
𑆤 𑆖 𑆯𑆶𑆰𑇀𑆪𑆩𑆳𑆟𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆼𑆠, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫 𑆥𑆵𑆝𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆠𑇀 𑇅 𑆯𑆶𑆰𑇀𑆑𑆾 𑆲𑇀𑆪𑆥𑆳𑆫𑇀𑆡𑆑𑆾 𑆫𑆶𑆑𑇀𑆑𑆫𑆯𑇀𑆖 𑇆𑇕𑇆
𑆱 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂- 𑆥𑇀𑆫𑆬𑆼𑆥𑆂, 𑆥𑇀𑆫𑆢𑆼𑆲, 𑆄𑆬𑆼𑆥𑆯𑇀𑆖 𑇅 𑆥𑇀𑆫𑆬𑆼𑆥𑆥𑇀𑆫𑆢𑆼𑆲𑆪𑆾𑆫𑆤𑇀𑆠𑆫𑆁 - 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆬𑆼𑆥𑆂 𑆯𑆵𑆠𑆱𑇀𑆠𑆤𑆶𑆫𑆮𑆴𑆯𑆾𑆰𑆵 𑆮𑆴𑆯𑆾𑆰𑆵 𑆮𑆳; 𑆥𑇀𑆫𑆢𑆼𑆲𑆱𑇀𑆠𑆷𑆰𑇀𑆟𑆂 𑆯𑆵𑆠𑆾 𑆮𑆳 𑆧𑆲𑆬𑆾𑇁𑆧𑆲𑆶𑆫𑆮𑆴𑆯𑆾𑆰𑆵 𑆖; 𑆩𑆣𑇀𑆪𑆩𑆾𑇁𑆠𑇀𑆫𑆳𑆬𑆼𑆥𑆂 𑇅 𑆠𑆠𑇀𑆫, 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆱𑆳𑆢𑆑𑆸𑆢𑆳𑆬𑆼𑆥𑆂; 𑆥𑇀𑆫𑆢𑆼𑆲𑆾 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆯𑆾𑆣𑆤𑆾 𑆫𑆾𑆥𑆟𑆂 𑆯𑆾𑆦𑆮𑆼𑆢𑆤𑆳𑆥𑆲𑆯𑇀𑆖; 𑆠𑆱𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆂 𑆑𑇀𑆰𑆠𑆳𑆑𑇀𑆰𑆠𑆼𑆰𑆶; 𑆪𑆱𑇀𑆠𑆶 𑆑𑇀𑆰𑆠𑆼𑆰𑆷𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑆱 𑆨𑆷𑆪𑆂 ‘𑆑𑆬𑇀𑆑’ 𑆅𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆠𑆼 𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆬𑆼𑆥𑆤𑆱𑆚𑇀𑆘𑇀𑆚𑆂; 𑆠𑆼𑆤𑆳𑆱𑇀𑆫𑆳𑆮𑆱𑆤𑇀𑆤𑆴𑆫𑆾𑆣𑆾 𑆩𑆸𑆢𑆶𑆠𑆳 𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆳𑆥𑆑𑆫𑇀𑆰𑆟𑆩𑆤𑆤𑇀𑆠𑆫𑇀𑆢𑆾𑆰𑆠𑆳 𑆮𑇀𑆫𑆟𑆯𑆶𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇖𑇆
𑆃𑆮𑆴𑆢𑆓𑇀𑆣𑆼𑆰𑆶 𑆯𑆾𑆦𑆼𑆰𑆶 𑆲𑆴𑆠𑆩𑆳𑆬𑆼𑆥𑆤𑆁 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆢𑆾𑆰𑆯𑆩𑆤𑆁 𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆷𑆫𑆶𑆘𑆳𑆥𑆲𑆩𑇀 𑇆𑇗𑇆
𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑆼𑆮𑆳𑆓𑇀𑆫𑇀𑆪𑆁 𑆩𑆳𑆁𑆱𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑇀 𑇅 𑆢𑆳𑆲𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆫𑆶𑆘𑆳𑆑𑆟𑇀𑆝𑆷𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇘𑇆
𑆩𑆫𑇀𑆩𑆢𑆼𑆯𑆼𑆰𑆶 𑆪𑆼 𑆫𑆾𑆓𑆳 𑆓𑆶𑆲𑇀𑆪𑆼𑆰𑇀𑆮𑆥𑆴 𑆠𑆡𑆳 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆪 𑆠𑆼𑆰𑆳𑆁 𑆲𑆴 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆳𑆬𑆼𑆥𑆤𑆁 𑆨𑆴𑆰𑆑𑇀 𑇆𑇙𑇆
(𑆰𑆝𑇀𑆨𑆳𑆓𑆁 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆱𑇀𑆤𑆼𑆲𑆁 𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆁 𑆠𑆶 𑆮𑆳𑆠𑆴𑆑𑆼 𑇅 𑆃𑆰𑇀𑆛𑆨𑆳𑆓𑆁 𑆠𑆶 𑆑𑆦𑆘𑆼 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀) 𑇆𑇑𑇐𑇆
𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆩𑆲𑆴𑆰𑆳𑆫𑇀𑆢𑇀𑆫𑆖𑆫𑇀𑆩𑆾𑆠𑇀𑆱𑆼𑆣𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑇆𑇑𑇑𑇆
𑆤 𑆖𑆳𑆬𑆼𑆥𑆁 𑆫𑆳𑆠𑇀𑆫𑆿 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 , 𑆩𑆳 𑆨𑆷𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆮𑆴𑆲𑆠𑆾𑆰𑇀𑆩𑆟𑆱𑇀𑆠𑆢𑆤𑆴𑆫𑇀𑆓𑆩𑆳𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆠𑆴 𑇆𑇑𑇒𑇆
𑆥𑇀𑆫𑆢𑆼𑆲𑆱𑆳𑆣𑇀𑆪𑆼 𑆮𑇀𑆪𑆳𑆣𑆿 𑆠𑆶 𑆲𑆴𑆠𑆩𑆳𑆬𑆼𑆥𑆤𑆁 𑆢𑆴𑆮𑆳 𑇅 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆨𑆴𑆔𑆳𑆠𑆾𑆠𑇀𑆡𑆼 𑆱𑆮𑆴𑆰𑆼 𑆖 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇓𑇆
𑆤 𑆖 𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆁 𑆬𑆼𑆥𑆁 𑆑𑆢𑆳𑆖𑆴𑆢𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆇𑆥𑆫𑇀𑆪𑆶𑆥𑆫𑆴 𑆬𑆼𑆥𑆁 𑆖 𑆤 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆈𑆰𑇀𑆩𑆳𑆟𑆁 𑆮𑆼𑆢𑆤𑆳𑆁 𑆢𑆳𑆲𑆁 𑆔𑆤𑆠𑇀𑆮𑆳𑆘𑇀𑆘𑆤𑆪𑆼𑆠𑇀 𑆱 𑆲𑆴 𑇅 𑆤 𑆖 𑆠𑆼𑆤𑆽𑆮 𑆬𑆼𑆥𑆼𑆤 𑆥𑇀𑆫𑆢𑆼𑆲𑆁 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂 𑇅 𑆯𑆶𑆰𑇀𑆑𑆨𑆳𑆮𑆳𑆠𑇀𑆱 𑆤𑆴𑆫𑇀𑆮𑆵𑆫𑇀𑆪𑆾 𑆪𑆶𑆑𑇀𑆠𑆾𑇁𑆥𑆴 𑆱𑇀𑆪𑆳𑆢𑆥𑆳𑆫𑇀𑆡𑆑𑆂 𑇆𑇑𑇕𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑇀𑆫𑆟𑆧𑆤𑇀𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑇀𑆰𑆿𑆩𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆳𑆮𑆴𑆑𑆢𑆶𑆑𑆷𑆬𑆑𑆿𑆯𑆼𑆪𑆥𑆠𑇀𑆫𑆾𑆫𑇀𑆟𑆖𑆵𑆤𑆥𑆛𑇀𑆛𑆖𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆫𑇀𑆮𑆬𑇀𑆑𑆬𑆳𑆬𑆳𑆧𑆷𑆯𑆑𑆬𑆬𑆠𑆳𑆮𑆴𑆢𑆬𑆫𑆘𑇀𑆘𑆶𑆠𑆷𑆬𑆦𑆬𑆱𑆤𑇀𑆠𑆳𑆤𑆴𑆑𑆳𑆬𑆿𑆲𑆳𑆤𑆵𑆠𑆴 ; 𑆠𑆼𑆰𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆑𑆳𑆬𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆂; 𑆥𑇀𑆫𑆑𑆫𑆟𑆠𑆯𑇀𑆖𑆽𑆰𑆳𑆩𑆳𑆢𑆼𑆯𑆂 𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫 𑆑𑆾𑆯𑆢𑆳𑆩𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆳𑆤𑆶𑆮𑆼𑆬𑇀𑆬𑆴𑆠𑆩𑆶(𑆥𑇀𑆫)𑆠𑆾𑆬𑆵𑆩𑆟𑇀𑆝𑆬𑆱𑇀𑆡𑆓𑆴𑆑𑆳𑆪𑆩𑆑𑆒𑆛𑇀𑆮𑆳𑆖𑆵𑆤𑆮𑆴𑆧𑆤𑇀𑆣𑆮𑆴𑆠𑆳𑆤𑆓𑆾𑆦𑆟𑆳𑆂 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆵 𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆢𑆯 𑆧𑆤𑇀𑆣𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆤𑆳𑆩𑆨𑆴𑆫𑆼𑆮𑆳𑆑𑆸𑆠𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆑𑆾𑆯𑆩𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑇀𑆮𑆱𑆶 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆢𑆳𑆩 𑆱𑆩𑇀𑆧𑆳𑆣𑆼𑇁𑆕𑇀𑆓𑆼, 𑆱𑆤𑇀𑆣𑆴𑆑𑆷𑆫𑇀𑆖𑆑𑆨𑇀𑆫𑆷𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆠𑆬𑆑𑆫𑇀𑆟𑆼𑆰𑆶 𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆁, 𑆃𑆤𑆶𑆮𑆼𑆬𑇀𑆬𑆴𑆠𑆁 𑆯𑆳𑆒𑆳𑆱𑆶, 𑆓𑇀𑆫𑆵𑆮𑆳𑆩𑆼𑆞𑇀𑆫𑆪𑆾𑆂 𑆩𑆶(𑆥𑇀𑆫)𑆠𑆾𑆬𑆵𑆁, 𑆮𑆸𑆠𑇀𑆠𑆼𑇁𑆕𑇀𑆓𑆼 𑆩𑆟𑇀𑆝𑆬𑆩𑇀, 𑆃𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆩𑆼𑆞𑇀𑆫𑆳𑆓𑇀𑆫𑆼𑆰𑆶 𑆱𑇀𑆡𑆓𑆴𑆑𑆳𑆁, 𑆪𑆩𑆬𑆮𑇀𑆫𑆟𑆪𑆾𑆫𑇀𑆪𑆩𑆑𑆁, 𑆲𑆤𑆶𑆯𑆕𑇀𑆒𑆓𑆟𑇀𑆝𑆼𑆰𑆶 𑆒𑆛𑇀𑆮𑆳𑆩𑇀, 𑆃𑆥𑆳𑆕𑇀𑆓𑆪𑆾𑆯𑇀𑆖𑆵𑆤𑆁, 𑆥𑆸𑆰𑇀𑆜𑆾𑆢𑆫𑆾𑆫𑆂𑆱𑆶 𑆮𑆴𑆧𑆤𑇀𑆣𑆁, 𑆩𑆷𑆫𑇀𑆣𑆤𑆴 𑆮𑆴𑆠𑆳𑆤𑆁, 𑆖𑆴𑆧𑆶𑆑𑆤𑆳𑆱𑆿𑆰𑇀𑆜𑆳𑆁𑆱𑆧𑆱𑇀𑆠𑆴𑆰𑆶 𑆓𑆾𑆦𑆟𑆳𑆁, 𑆘𑆠𑇀𑆫𑆶𑆟 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑆚𑇀𑆖𑆳𑆕𑇀𑆓𑆵𑆩𑆴𑆠𑆴; 𑆪𑆾 𑆮𑆳 𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆢𑆼𑆯𑆼 𑆱𑆶𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴 𑆠𑆁 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇘𑇆
𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆑𑇀 𑆖 𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆔𑆤𑆳𑆁 𑆑𑆮𑆬𑆴𑆑𑆳𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆥𑆫𑆴𑆑𑇀𑆰𑆼𑆥𑆩𑆸𑆘𑆶𑆩𑆤𑆳𑆮𑆴𑆢𑇀𑆣𑆩𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆁 𑆩𑆸𑆢𑆶 𑆥𑆛𑇀𑆛𑆁 𑆤𑆴𑆮𑆼𑆯𑇀𑆪 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑇅 𑆤 𑆖 𑆮𑇀𑆫𑆟𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆩𑆳𑆧𑆳𑆣𑆑𑆫𑆁 𑆖 𑇆𑇒𑇐𑇆
𑆤 𑆖 𑆮𑆴𑆑𑆼𑆯𑆴𑆑𑆿𑆰𑆣𑆼 𑆃𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼 𑆃𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆼 𑆮𑆴𑆰𑆩𑆼 𑆮𑆳 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆪𑆱𑇀𑆩𑆳𑆢𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑇀 𑆑𑇀𑆬𑆼𑆢𑆾, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆖𑇀𑆗𑆼𑆢𑆾, 𑆢𑆶𑆫𑇀𑆤𑇀𑆪𑆳𑆱𑆳𑆢𑇀𑆮𑇀𑆫𑆟𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆮𑆔𑆫𑇀𑆰𑆟𑆩𑆴𑆠𑆴 𑇆𑇒𑇑𑇆
𑆠𑆠𑇀𑆫 𑆮𑇀𑆫𑆟𑆳𑆪𑆠𑆤𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆧𑆤𑇀𑆣𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾 𑆨𑆮𑆠𑆴- 𑆓𑆳𑆞𑆂, 𑆱𑆩𑆂, 𑆯𑆴𑆡𑆴𑆬 𑆅𑆠𑆴 𑇆𑇒𑇒𑇆
𑆥𑆵𑆝𑆪𑆤𑇀𑆤𑆫𑆶𑆘𑆾 𑆓𑆳𑆞𑆂 𑆱𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆂 𑆯𑆴𑆡𑆴𑆬𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆤𑆽𑆮 𑆓𑆳𑆞𑆾 𑆤 𑆯𑆴𑆡𑆴𑆬𑆂 𑆱𑆩𑆾 𑆧𑆤𑇀𑆣𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇒𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆦𑆴𑆑𑇀𑆑𑆶𑆑𑇀𑆰𑆴𑆑𑆑𑇀𑆰𑆳𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆾𑆫𑆶𑆯𑆴𑆫𑆂𑆱𑆶 𑆓𑆳𑆞𑆂, 𑆯𑆳𑆒𑆳𑆮𑆢𑆤𑆑𑆫𑇀𑆟𑆑𑆟𑇀𑆜𑆩𑆼𑆞𑇀𑆫𑆩𑆶𑆰𑇀𑆑𑆥𑆸𑆰𑇀𑆜𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆾𑆫𑆂𑆱𑆶 𑆱𑆩𑆂, 𑆃𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆖 𑆯𑆴𑆡𑆴𑆬 𑆅𑆠𑆴 𑇆𑇒𑇔𑇆
𑆠𑆠𑇀𑆫 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆁 𑆓𑆳𑆞𑆱𑇀𑆡𑆳𑆤𑆼 𑆱𑆩𑆁 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆱𑆩𑆱𑇀𑆡𑆳𑆤𑆼 𑆯𑆴𑆡𑆴𑆬𑆁, 𑆯𑆴𑆡𑆴𑆬𑆱𑇀𑆡𑆳𑆤𑆼 𑆤𑆽𑆮; 𑆍𑆮𑆁 𑆯𑆾𑆟𑆴𑆠𑆢𑆶𑆰𑇀𑆛𑆁 𑆖; 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆁 𑆯𑆴𑆡𑆴𑆬𑆱𑇀𑆡𑆳𑆤𑆼 𑆱𑆩𑆁, 𑆱𑆩𑆱𑇀𑆡𑆳𑆤𑆼 𑆓𑆳𑆞𑆁, 𑆓𑆳𑆞𑆱𑇀𑆡𑆳𑆤𑆼 𑆓𑆳𑆞𑆠𑆫𑆁; 𑆍𑆮𑆁 𑆮𑆳𑆠𑆢𑆶𑆰𑇀𑆛𑆁 𑆖 𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆁 𑆯𑆫𑆢𑆴 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆢𑇀𑆮𑆴𑆫𑆲𑇀𑆤𑆾 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆫𑆑𑇀𑆠𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑆥𑇀𑆪𑆼𑆮𑆁; 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆁 𑆲𑆼𑆩𑆤𑇀𑆠𑆮𑆱𑆤𑇀𑆠𑆪𑆾𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀 , 𑆮𑆳𑆠𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆩𑆥𑇀𑆪𑆼𑆮𑆩𑇀 𑇅 𑆍𑆮𑆩𑆨𑇀𑆪𑆷𑆲𑇀𑆪 𑆧𑆤𑇀𑆣𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫, 𑆱𑆩𑆯𑆴𑆡𑆴𑆬𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑆓𑆳𑆞𑆁 𑆧𑆢𑇀𑆣𑆼 𑆮𑆴𑆑𑆼𑆯𑆴𑆑𑆿𑆰𑆣𑆤𑆽𑆫𑆫𑇀𑆡𑆑𑇀𑆪𑆁 𑆯𑆾𑆦𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆯𑇀𑆖, 𑆓𑆳𑆞𑆱𑆩𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑆯𑆴𑆡𑆴𑆬𑆁 𑆧𑆢𑇀𑆣𑆼 𑆮𑆴𑆑𑆼𑆯𑆴𑆑𑆿𑆰𑆣𑆥𑆠𑆤𑆁 𑆥𑆛𑇀𑆛𑆱𑆚𑇀𑆖𑆳𑆫𑆳𑆢𑇀𑆮𑇀𑆫𑆟𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆮𑆔𑆫𑇀𑆰𑆟𑆩𑆴𑆠𑆴; 𑆓𑆳𑆞𑆯𑆴𑆡𑆴𑆬𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑆶 𑆱𑆩𑆁 𑆧𑆢𑇀𑆣𑆼 𑆖 𑆓𑆶𑆟𑆳𑆨𑆳𑆮 𑆅𑆠𑆴 𑇆𑇒𑇗𑇆
𑆃𑆮𑆴𑆥𑆫𑆵𑆠𑆧𑆤𑇀𑆣𑆼 𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑆱𑆸𑆑𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆾 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆖 𑇆𑇒𑇘𑇆
𑆃𑆧𑆣𑇀𑆪𑆩𑆳𑆤𑆾 𑆢𑆁𑆯𑆩𑆯𑆑𑆠𑆸𑆟𑆑𑆳𑆰𑇀𑆜𑆾𑆥𑆬𑆥𑆳𑆁𑆯𑆶𑆯𑆵𑆠𑆮𑆳𑆠𑆳𑆠𑆥𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑆨𑆴𑆲𑆤𑇀𑆪𑆠𑆼 𑆮𑇀𑆫𑆟𑆂, 𑆮𑆴𑆮𑆴𑆣𑆮𑆼𑆢𑆤𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆯𑇀𑆖 𑆢𑆶𑆰𑇀𑆛𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴, 𑆄𑆬𑆼𑆥𑆤𑆳𑆢𑆵𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆮𑆴𑆯𑆾𑆰𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑇆𑇒𑇙𑇆
𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆩𑆡𑆴𑆠𑆁 𑆨𑆓𑇀𑆤𑆁 𑆮𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆩𑆠𑆴𑆥𑆳𑆠𑆴𑆠𑆩𑇀 𑇅 𑆃𑆱𑇀𑆡𑆴𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆴𑆫𑆳𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆩𑆳𑆯𑆶 𑆧𑆤𑇀𑆣𑆼𑆤 𑆫𑆾𑆲𑆠𑆴 𑇆𑇓𑇐𑇆
𑆱𑆶𑆒𑆩𑆼𑆮𑆁 𑆮𑇀𑆫𑆟𑆵 𑆯𑆼𑆠𑆼 𑆱𑆶𑆒𑆁 𑆓𑆖𑇀𑆗𑆠𑆴 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇅 𑆱𑆶𑆒𑆁 𑆯𑆪𑇀𑆪𑆳𑆱𑆤𑆱𑇀𑆡𑆱𑇀𑆪 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆱𑆁𑆫𑆾𑆲𑆠𑆴 𑆮𑇀𑆫𑆟𑆂 𑇆𑇓𑇑𑇆
𑆃𑆧𑆤𑇀𑆣𑇀𑆪𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆪𑆢𑆳 𑆯𑆾𑆦𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆠𑆾𑆢𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆨𑆷𑆠𑆳𑆂 𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆳𑆂 𑆥𑆳𑆑𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆶𑆡𑆴𑆠𑆥𑇀𑆫𑆯𑆵𑆫𑇀𑆟𑆩𑆳𑆁𑆱𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇒𑇆
𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆩𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆳𑆤𑆳𑆁 𑆥𑆴𑆝𑆑𑆳 𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆤𑆳𑆩𑇀 𑇅 𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆯𑇀𑆖𑆾𑆤𑇀𑆢𑆶𑆫𑆶𑆮𑆴𑆰𑆼 𑆮𑆴𑆰𑆘𑆶𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆪𑆼 𑆮𑇀𑆫𑆟𑆳𑆂 𑇆𑇓𑇓𑇆

𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆂 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑆱𑆾𑇁𑆱𑆳𑆣𑇀𑆪 𑆇𑆑𑇀𑆠𑆂, ... 𑇅𑇑𑇓𑇅 ... 𑆑𑇀𑆰𑆠𑆘𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆼 𑇅 𑆤𑆮𑆥𑇀𑆫𑆱𑆷𑆠𑆳𑇁𑆲𑆴𑆠𑆨𑆾𑆘𑆤𑆳 𑆪𑆳 𑆪𑆳 𑆖𑆳𑆩𑆓𑆫𑇀𑆨𑆁 𑆮𑆴𑆱𑆸𑆘𑆼𑆢𑆸𑆠𑆿 𑆮𑆳 𑇆𑇑𑇓𑇆
𑆮𑆳𑆪𑆶𑆫𑇀𑆲𑆴 𑆠𑆱𑇀𑆪𑆳𑆂 𑆥𑆫𑆴𑆓𑆸𑆲𑇀𑆪 𑆫𑆑𑇀𑆠𑆁 𑆑𑆫𑆾𑆠𑆴 𑆓𑆶𑆬𑇀𑆩𑆁 𑆱𑆫𑆶𑆘𑆁 𑆱𑆢𑆳𑆲𑆩𑇀 𑇅 𑆥𑆽𑆠𑇀𑆠𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆼𑆤 𑆱𑆩𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑆴𑆯𑆼𑆰𑆟𑆁 𑆖𑆳𑆥𑇀𑆪𑆥𑆫𑆁 𑆤𑆴𑆧𑆾𑆣 𑇆𑇑𑇔𑇆
𑆤 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆤𑆾𑆢𑆫𑆩𑆼𑆠𑆴 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆨𑆮𑆤𑇀𑆠𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆤𑆳𑆩𑇀 𑇅 𑆠𑆁 𑆓𑆫𑇀𑆨𑆑𑆳𑆬𑆳𑆠𑆴𑆓𑆩𑆼 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆩𑆱𑆸𑆓𑇀𑆨𑆮𑆁 𑆓𑆶𑆬𑇀𑆩𑆩𑆶𑆯𑆤𑇀𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆂 𑇆𑇑𑇕𑇆
𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆢𑆴𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂 𑇅 𑆇𑆥𑆳𑆖𑆫𑆼𑆢𑇀𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆤𑆴𑆫𑆷𑆲𑆽𑆂 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆽𑆂 𑇆𑇑𑇖𑇆
𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆢𑆴𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆔𑆸𑆠𑆼𑆤 𑆠𑆶 𑇅 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆩𑆣𑆶𑆫𑆽𑆫𑇀𑆪𑆾𑆓𑆽𑆫𑇀𑆤𑆴𑆫𑆷𑆲𑆽𑆂 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆢𑆴𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆔𑆸𑆠𑆼𑆤 𑆠𑆶 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆁 𑆠𑆢𑇀𑆫𑆷𑆥𑆽𑆫𑇀𑆤𑆴𑆫𑆷𑆲𑆽𑆂 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇘𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆾𑆠𑇀𑆡𑆴𑆠𑆼 𑆓𑆶𑆬𑇀𑆩𑆼 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆾 𑆮𑆴𑆣𑆴𑆫𑇀𑆲𑆴𑆠𑆂 𑇅𑇑𑇙𑇅 𑆥𑆴𑆠𑇀𑆠𑆮𑆢𑇀𑆫𑆑𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑇀𑆪𑆳 𑆤𑆳𑆫𑇀𑆪𑆳𑆂 𑆑𑆳𑆫𑇀𑆪𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆣𑆴𑆂 𑇆𑇑𑇙𑇆
𑆮𑆴𑆯𑆼𑆰𑆩𑆥𑆫𑆁 𑆖𑆳𑆱𑇀𑆪𑆳𑆂 𑆯𑆸𑆟𑆶 𑆫𑆑𑇀𑆠𑆮𑆴𑆨𑆼𑆢𑆤𑆩𑇀 𑇅 𑆥𑆬𑆳𑆯𑆑𑇀𑆰𑆳𑆫𑆠𑆾𑆪𑆼𑆤 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆢𑆢𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆁 𑆖 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆔𑆸𑆠𑆼𑆤 𑆠𑆶 𑇅 𑆇𑆰𑇀𑆟𑆽𑆫𑇀𑆮𑆳 𑆨𑆼𑆢𑆪𑆼𑆢𑇀𑆨𑆴𑆤𑇀𑆤𑆼 𑆮𑆴𑆣𑆴𑆫𑆳𑆱𑆸𑆓𑇀𑆢𑆫𑆾 𑆲𑆴𑆠𑆂 𑇆𑇒𑇑𑇆
𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆑𑆯𑆦𑆳𑆤𑆳𑆁 𑆠𑆶 𑆮𑆱𑆳 𑆱𑆫𑇀𑆥𑆴𑆯𑇀𑆖 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑇅𑇒𑇓𑇅 𑆠𑆽𑆬𑆁 𑆘𑆳𑆕𑇀𑆓𑆬𑆩𑆘𑇀𑆘𑆳𑆤 𑆍𑆮𑆁 𑆓𑆶𑆬𑇀𑆩𑆼 𑆑𑆦𑆾𑆠𑇀𑆡𑆴𑆠𑆼 𑇆𑇒𑇓𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆳𑆤𑆳𑆁 𑆱𑇀𑆮𑆫𑆱𑆼 𑆰𑆝𑆕𑇀𑆓𑆁 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆔𑆸𑆠𑆩𑇀 𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑆽𑆤𑇀𑆣𑆮𑆾𑆥𑆼𑆠𑆁 𑆠𑆢𑇀𑆣𑆴𑆠𑆁 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆼 𑇆𑇒𑇔𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑇀𑆪𑆾𑆰𑆱𑆴𑆤𑇀𑆣𑆷𑆠𑇀𑆡𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆖𑆮𑇀𑆪𑆢𑆳𑆝𑆴𑆩𑆽𑆂 𑇅 𑆢𑆵𑆥𑇀𑆪𑆑𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆑𑆳𑆘𑆳𑆘𑆵𑆲𑆥𑆶𑆰𑆳𑆣𑆳𑆤𑇀𑆪𑆑𑆽𑆂 𑆱𑆩𑆽𑆂 𑇆𑇒𑇕𑇆
𑆢𑆣𑇀𑆪𑆳𑆫𑆤𑆳𑆬𑆧𑆢𑆫𑆩𑆷𑆬𑆑𑆱𑇀𑆮𑆫𑆱𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀 𑇅 𑆠𑆠𑇀𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆳𑆓𑇀𑆤𑆴𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆛𑆾𑆥𑆯𑆷𑆬𑆤𑆶𑆠𑇀 𑇆𑇒𑇖𑇆
𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆳𑆘𑆳𑆘𑆵𑆮𑆴𑆝𑆢𑆳𑆝𑆴𑆩𑆢𑆵𑆥𑇀𑆪𑆑𑆽𑆂 𑇅 𑆥𑆶𑆰𑇀𑆑𑆫𑆮𑇀𑆪𑆾𑆰𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆑𑇀𑆰𑆳𑆫𑆖𑆴𑆠𑇀𑆫𑆑𑆽𑆂 𑇆𑇒𑇗𑇆
𑆯𑆛𑆵𑆮𑆖𑆳𑆘𑆓𑆤𑇀𑆣𑆽𑆬𑆳𑆱𑆶𑆫𑆱𑆽𑆯𑇀𑆖 𑆮𑆴𑆥𑆳𑆖𑆴𑆠𑆩𑇀 𑇅 𑆯𑆷𑆬𑆳𑆤𑆳𑆲𑆲𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑆣𑇀𑆤𑆳 𑆖𑆳𑆤𑆴𑆬𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆳𑆩𑇀 𑇆𑇒𑇘𑇆
𑆮𑆴𑆝𑆢𑆳𑆝𑆴𑆩𑆱𑆴𑆤𑇀𑆣𑆷𑆠𑇀𑆡𑆲𑆶𑆠𑆨𑆶𑆓𑇀𑆮𑇀𑆪𑆾𑆰𑆘𑆵𑆫𑆑𑆽𑆂 𑇅 𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆑𑇀𑆰𑆳𑆫𑆫𑆶𑆓𑇀𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆽𑆂 𑇆𑇒𑇙𑇆
𑆧𑆵𑆘𑆥𑆷𑆫𑆫𑆱𑆾𑆥𑆼𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑆣𑆴𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀 𑇅 𑆱𑆳𑆣𑆴𑆠𑆁 𑆢𑆳𑆣𑆴𑆑𑆁 𑆤𑆳𑆩 𑆓𑆶𑆬𑇀𑆩𑆲𑆸𑆠𑇀 𑆥𑇀𑆬𑆵𑆲𑆯𑆷𑆬𑆘𑆴𑆠𑇀 𑇆𑇓𑇐𑇆
𑆫𑆱𑆾𑆤𑆱𑇀𑆮𑆫𑆱𑆼 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆫𑆱𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀 𑇅 𑆱𑆶𑆫𑆳𑆫𑆤𑆳𑆬𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆩𑆷𑆬𑆑𑆱𑇀𑆮𑆫𑆱𑆽𑆂 𑆱𑆲 𑇆𑇓𑇑𑇆
𑆮𑇀𑆪𑆾𑆰𑆢𑆳𑆝𑆴𑆩𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆪𑆮𑆳𑆤𑆵𑆖𑆮𑇀𑆪𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂 𑇅 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆳𑆘𑆳𑆘𑆵𑆢𑆵𑆥𑇀𑆪𑆑𑆽𑆯𑇀𑆖 𑆱𑆩𑆳𑆁𑆯𑆴𑆑𑆽𑆂 𑇆𑇓𑇒𑇆
𑆱𑆴𑆢𑇀𑆣𑆁 𑆓𑆶𑆬𑇀𑆩𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆂𑆯𑇀𑆮𑆳𑆱𑆾𑆤𑇀𑆩𑆳𑆢𑆑𑇀𑆰𑆪𑆘𑇀𑆮𑆫𑆳𑆤𑇀 𑇅 𑆑𑆳𑆱𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆬𑆵𑆲𑆯𑆷𑆬𑆳𑆤𑆴𑆬𑆳𑆚𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇓𑇓𑇆
𑆢𑆣𑆴 𑆱𑆿𑆮𑆵𑆫𑆑𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑇀𑆮𑆳𑆡𑆿 𑆩𑆶𑆢𑇀𑆓𑆑𑆶𑆬𑆠𑇀𑆡𑆘𑆿 𑇅 𑆥𑆚𑇀𑆖𑆳𑆞𑆑𑆳𑆤𑆴 𑆮𑆴𑆥𑆖𑆼𑆢𑆳𑆮𑆳𑆥𑇀𑆪 𑆢𑇀𑆮𑆴𑆥𑆬𑆳𑆤𑇀𑆪𑆡 𑇆𑇓𑇔𑇆
𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆱𑆫𑇀𑆘𑆴𑆑𑆳𑆁 𑆖 𑆢𑆼𑆮𑆢𑆳𑆫𑇀𑆮𑆡 𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀 𑇅 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆳𑆥𑆲𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆼𑆠𑆢𑇀𑆢𑆵𑆥𑆤𑆩𑆼𑆮 𑆖 𑇆𑇓𑇕𑇆
𑆠𑆸𑆟𑆩𑆷𑆬𑆑𑆰𑆳𑆪𑆼 𑆠𑆶 𑆘𑆵𑆮𑆤𑆵𑆪𑆽𑆂 𑆥𑆖𑆼𑆢𑇀𑆔𑆸𑆠𑆩𑇀 𑇅 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆓𑆟𑆼 𑆮𑆳𑇁𑆥𑆴 𑆓𑆟𑆼 𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆑𑆼 𑇆𑇓𑇖𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆡𑆴𑆠𑆁 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆔𑆸𑆠𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑇀𑆪𑆱𑆁𑆯𑆪𑆩𑇀 𑇅𑇓𑇗𑇅 𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆿 𑆮𑆴𑆥𑆖𑆼𑆢𑇀𑆢𑆵𑆥𑆤𑆵𑆪𑆪𑆶𑆠𑆁 𑆔𑆸𑆠𑆩𑇀 𑇆𑇓𑇗𑇆
𑆑𑇀𑆰𑆳𑆫𑆮𑆫𑇀𑆓𑆼 𑆥𑆖𑆼𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆠𑇀 𑆥𑆖𑆼𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆓𑆟𑆼𑇁𑆥𑆫𑆩𑇀 𑇅 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆓𑆶𑆬𑇀𑆩𑆁 𑆑𑆦𑆾𑆢𑇀𑆨𑆷𑆠𑆁 𑆔𑆸𑆠𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑇀𑆪𑆱𑆁𑆯𑆪𑆩𑇀 𑇆𑇓𑇘𑇆
𑆪𑆡𑆳𑆢𑆾𑆰𑆾𑆖𑇀𑆗𑇀𑆫𑆪𑆁 𑆖𑆳𑆥𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠𑇀𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆩𑇀 𑇅𑇓𑇙𑇅 𑆖𑆷𑆫𑇀𑆟𑆁 𑆲𑆴𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆑𑆁 𑆮𑆳𑇁𑆥𑆴 𑆔𑆸𑆠𑆁 𑆮𑆳 𑆥𑇀𑆬𑆵𑆲𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇓𑇙𑇆
𑆥𑆴𑆧𑆼𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆳𑆥𑆲𑆁 𑆑𑆳𑆬𑆼 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑇀𑆮𑆑𑆩𑆼𑆮 𑆮𑆳 𑇅𑇔𑇐𑇅 𑆠𑆴𑆬𑆼𑆑𑇀𑆰𑆶𑆫𑆑𑆥𑆳𑆬𑆳𑆯𑆱𑆳𑆫𑇀𑆰𑆥𑆁 𑆪𑆳𑆮𑆤𑆳𑆬𑆘𑆩𑇀 𑇆𑇔𑇐𑇆
𑆨𑆱𑇀𑆩 𑆩𑆷𑆬𑆑𑆘𑆁 𑆖𑆳𑆥𑆴 𑆓𑆾𑆘𑆳𑆮𑆴𑆒𑆫𑆲𑆱𑇀𑆠𑆴𑆤𑆳𑆩𑇀 𑇅 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆩𑆲𑆴𑆰𑆵𑆟𑆳𑆁 𑆖 𑆥𑆳𑆬𑆴𑆑𑆽𑆯𑇀𑆖𑆳𑆮𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆽𑆂 𑇆𑇔𑇑𑇆
𑆑𑆶𑆰𑇀𑆜𑆱𑆽𑆤𑇀𑆣𑆮𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆤𑆳𑆓𑆫𑆑𑆸𑆩𑆴𑆔𑆳𑆠𑆴𑆨𑆴𑆂 𑇅 𑆱𑆳𑆘𑆩𑆾𑆢𑆽𑆯𑇀𑆖 𑆢𑆯𑆨𑆴𑆂 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆳𑆖𑇀𑆖 𑆥𑆬𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀 𑇆𑇔𑇒𑇆
𑆃𑆪𑆂𑆥𑆳𑆠𑇀𑆫𑆼𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑇁𑆬𑇀𑆥𑆼𑆤 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆬𑆼𑆲𑇀𑆪(𑆲)𑆩𑆡𑆾𑆢𑇀𑆣𑆫𑆼𑆠𑇀 𑇅 𑆠𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆢𑆣𑇀𑆤𑆳 𑆱𑆶𑆫𑆪𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑆥𑆴 𑆮𑆳 𑇆𑇔𑇓𑇆
𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆼𑆤𑆾𑆰𑇀𑆟𑆠𑆾𑆪𑆼𑆤 𑆑𑆿𑆬𑆠𑇀𑆡𑆼𑆤 𑆫𑆱𑆼𑆤 𑆮𑆳 𑇅 𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑇀 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆑𑇀𑆰𑆳𑆫𑆾𑇁𑆪𑆁 𑆲𑆤𑇀𑆠𑇀𑆪𑆱𑆁𑆯𑆪𑆩𑇀 𑇆𑇔𑇔𑇆
𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆲𑆴𑆠𑆂 𑆑𑇀𑆰𑆳𑆫𑆂 𑆑𑆼𑆠𑆑𑆴𑆘𑆾𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆠𑆽𑆬𑆼𑆤 𑆯𑆩𑆪𑆼𑆠𑇀 𑆥𑆵𑆠𑆾 𑆓𑆶𑆬𑇀𑆩𑆁 𑆥𑆮𑆤𑆱𑆩𑇀𑆨𑆮𑆩𑇀 𑇆𑇔𑇕𑇆
𑆥𑆵𑆠𑆁 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆮𑆳𑇁𑆥𑆴 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀 𑇅𑇔𑇖𑇅 𑆮𑆸𑆯𑇀𑆖𑆵𑆮(𑆫)𑆩𑆶𑆫𑆶𑆧𑆷𑆑𑆁 𑆖 𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆫𑇀𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆩𑇀 𑇆𑇔𑇖𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆁 𑆖 𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆥𑆳𑆢𑆳𑆮𑆯𑆼𑆰𑆴𑆠𑆩𑇀 𑇅 𑆩𑆳𑆓𑆣𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇔𑇗𑇆
𑆩𑆣𑆶𑆤𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆥𑆡𑇀𑆪𑆳𑆖𑆷𑆫𑇀𑆟𑆳𑆫𑇀𑆣𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇅 𑆧𑆶𑆱𑆾𑆰𑆴𑆠𑆁 𑆢𑆯𑆳𑆲𑆁 𑆠𑆶 𑆘𑆵𑆫𑇀𑆟𑆨𑆑𑇀𑆠𑆂 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂 𑇆𑇔𑇘𑇆
𑆃𑆫𑆴𑆰𑇀𑆛𑆾𑇁𑆪𑆁 𑆘𑆪𑆼𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆩𑆮𑆴𑆥𑆳𑆑𑆩𑆫𑆾𑆖𑆑𑆩𑇀 𑇅𑇔𑇙𑇅 𑆥𑆳𑆜𑆳𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆫𑆘𑆤𑆵𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆓𑇀𑆤𑆴𑆑𑆩𑇀 𑇆𑇔𑇙𑇆
𑆬𑆮𑆟𑆁 𑆮𑆸𑆑𑇀𑆰𑆧𑆵𑆘𑆁 𑆖 𑆠𑆶𑆬𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑆤𑆮𑆾 𑆓𑆶𑆝𑆂 𑇅 𑆥𑆡𑇀𑆪𑆳𑆨𑆴𑆫𑇀𑆮𑆳 𑆪𑆶𑆠𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆓𑆮𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆠𑆁 𑆥𑆖𑆼𑆠𑇀 𑇆𑇕𑇐𑇆
𑆓𑆶𑆛𑆴𑆑𑆳𑆱𑇀𑆠𑆢𑇀𑆔𑆤𑆵𑆨𑆷𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆒𑆳𑆢𑆼𑆢𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀 𑇅 𑆓𑆶𑆬𑇀𑆩𑆥𑇀𑆬𑆵𑆲𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆳𑆁𑆱𑇀𑆠𑆳 𑆤𑆳𑆯𑆪𑆼𑆪𑆶𑆫𑆯𑆼𑆰𑆠𑆂 𑇆𑇕𑇑𑇆
𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆖 𑆢𑆳𑆫𑆶𑆟𑆩𑇀 𑇅𑇕𑇒𑇅 𑆱𑆯𑆷𑆬𑆼 𑆱𑆾𑆤𑇀𑆤𑆠𑆼𑇁𑆱𑇀𑆥𑆤𑇀𑆢𑆼 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆶𑆓𑆤𑇀𑆮𑆴𑆠𑆼 𑇆𑇕𑇒𑇆
𑆓𑆶𑆬𑇀𑆩𑆼 𑆫𑆑𑇀𑆠𑆁 𑆘𑆬𑆿𑆑𑆾𑆨𑆴𑆂 𑆱𑆴𑆫𑆳𑆩𑆾𑆑𑇀𑆰𑆼𑆟 𑆮𑆳 𑆲𑆫𑆼𑆠𑇀 𑇅𑇕𑇓𑇅 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆳𑆂 𑆱𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆮𑇀𑆪𑆑𑇀𑆠𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆂 𑇆𑇕𑇓𑇆
𑆑𑆛𑆶𑆠𑇀𑆫𑆴𑆑𑆱𑆩𑆳𑆪𑆶𑆑𑇀𑆠𑆳 𑆲𑆴𑆠𑆳𑆂 𑆥𑆳𑆤𑆼 𑆠𑆶 𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆳𑆩𑇀 𑇅𑇕𑇔𑇅 𑆥𑆼𑆪𑆳 𑆮𑆳𑆠𑆲𑆫𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆑𑆿𑆬𑆠𑇀𑆡𑆳 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳 𑆫𑆱𑆳𑆂 𑇆𑇕𑇔𑇆
𑆒𑆬𑆳𑆂 𑆱𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆯𑇀𑆖 𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆳𑆁 𑆨𑆾𑆘𑆤𑆼 𑆲𑆴𑆠𑆳𑆂 𑇅𑇕𑇕𑇅 𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆾𑆤𑆴𑆬𑆳𑆤𑆳𑆁 𑆠𑆶 𑆱𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇕𑇕𑇆
𑆑𑆶𑆩𑇀𑆨𑆵𑆥𑆴𑆟𑇀𑆝𑆼𑆰𑇀𑆛𑆑𑆳𑆱𑇀𑆮𑆼𑆢𑆳𑆤𑇀 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀 𑇅𑇕𑇖𑇅 𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮𑆾𑆑𑇀𑆠𑆳 𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆠𑆩𑆳 𑆨𑆸𑆯𑆩𑇀 𑇆𑇕𑇖𑇆

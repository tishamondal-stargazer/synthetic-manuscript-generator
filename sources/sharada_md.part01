𑆮𑆼𑆓𑆲𑆳𑆤𑆿 𑆠𑆢𑆼𑆮𑆳𑆩𑇀𑆨𑆱𑇀𑆠𑆠𑇀𑆫𑆽𑆮𑆳𑆤𑇀𑆠𑆫𑇀𑆤𑆴𑆬𑆵𑆪𑆠𑆼 𑇅 𑆢𑆾𑆰𑆮𑆼𑆓𑆾𑆢𑆪𑆼 𑆠𑆢𑇀𑆮𑆢𑆶𑆢𑆵𑆫𑇀𑆪𑆼𑆠 𑆘𑇀𑆮𑆫𑆾𑇁𑆱𑇀𑆪 𑆮𑆽 𑇆𑇗𑇔𑇆
𑆮𑆼𑆓𑆲𑆳𑆤𑆿 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆼𑆠 𑆪𑆡𑆳𑇁𑆩𑇀𑆨𑆂 𑆱𑆳𑆓𑆫𑆼 𑆠𑆡𑆳) 𑇅𑇗𑇕𑇅 𑆮𑆴𑆮𑆴𑆣𑆼𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆼𑆤 𑆘𑇀𑆮𑆫𑆾 𑆪𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇗𑇕𑇆
𑆪𑆡𑆳𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆁 𑆠𑆶 𑆠𑆡𑆳 𑆩𑆤𑇀𑆪𑆼𑆠 𑆠𑆁 𑆘𑇀𑆮𑆫𑆩𑇀 𑇅𑇗𑇖𑇅 𑆯𑇀𑆪𑆳𑆮𑆳𑆱𑇀𑆪𑆠𑆳 𑆮𑆴𑆰𑆑𑆸𑆠𑆼 𑆢𑆳𑆲𑆳𑆠𑆵𑆱𑆳𑆫𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆳𑆂 𑇆𑇗𑇖𑇆
𑆃𑆨𑆑𑇀𑆠𑆫𑆶𑆑𑇀 𑆥𑆴𑆥𑆳𑆱𑆳 𑆖 𑆠𑆾𑆢𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆧𑆬𑆑𑇀𑆰𑆪𑆂 𑇅 𑆏𑆰𑆣𑆵𑆓𑆤𑇀𑆣𑆘𑆼 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆯𑆴𑆫𑆾𑆫𑆶𑆑𑇀 𑆮𑆩𑆡𑆶𑆂 𑆑𑇀𑆰𑆮𑆂 𑇆𑇗𑇗𑇆
𑆑𑆳𑆩𑆘𑆼 𑆖𑆴𑆠𑇀𑆠𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑇁𑇁𑆬𑆱𑇀𑆪𑆩𑆫𑆾𑆖𑆑𑆂 𑇅 𑆲𑆸𑆢𑆪𑆼 𑆮𑆼𑆢𑆤𑆳 𑆖𑆳𑆱𑇀𑆪 𑆓𑆳𑆠𑇀𑆫𑆁 𑆖 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑇆𑇗𑇘𑇆
𑆨𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆬𑆳𑆥𑆂 𑆯𑆾𑆑𑆳𑆖𑇀𑆖 𑆨𑆮𑆼𑆠𑇀 𑆑𑆾𑆥𑆳𑆖𑇀𑆖 𑆮𑆼𑆥𑆡𑆶𑆂 𑇅 𑆃𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆾𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇗𑇙𑇆
𑆨𑆷𑆠𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆢𑆶𑆢𑇀𑆮𑆼𑆓𑆲𑆳𑆱𑇀𑆪𑆑𑆩𑇀𑆥𑆤𑆫𑆾𑆢𑆤𑆩𑇀 𑇅𑇘𑇐𑇅 𑆯𑇀𑆫𑆩𑆑𑇀𑆰𑆪𑆳𑆨𑆴𑆔𑆳𑆠𑆼𑆨𑇀𑆪𑆾 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂 𑇆𑇘𑇐𑇆
𑆥𑆷𑆫𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆒𑆴𑆬𑆁 𑆢𑆼𑆲𑆁 𑆘𑇀𑆮𑆫𑆩𑆳𑆥𑆳𑆢𑆪𑆼𑆢𑇀𑆨𑆸𑆯𑆩𑇀 𑇅𑇘𑇑𑇅 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆠𑆶 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆢𑇀𑆮𑆴𑆢𑆳𑆲𑆳𑆓𑆤𑇀𑆠𑆶𑆠𑆱𑇀𑆠𑆡𑆳 𑇆𑇘𑇑𑇆
𑆘𑇀𑆮𑆫𑆾𑇁𑆥𑆫𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆴 𑆠𑆽𑆱𑇀𑆠𑆽𑆫𑆤𑇀𑆪𑆽𑆯𑇀𑆖 𑆲𑆼𑆠𑆶𑆨𑆴𑆂 𑇅 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱 𑆠𑆶 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆑𑆢𑆳𑆖𑆴𑆤𑇀𑆤𑆳𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇘𑇒𑇆
𑆓𑆶𑆫𑆶𑆠𑆳 𑆲𑆸𑆢𑆪𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆂 𑆱𑆢𑆤𑆁 𑆗𑆫𑇀𑆢𑇀𑆪𑆫𑆾𑆖𑆑𑆿 𑇅 𑆫𑆱𑆱𑇀𑆡𑆼 𑆠𑆶 𑆘𑇀𑆮𑆫𑆼 𑆬𑆴𑆕𑇀𑆓𑆁 𑆢𑆽𑆤𑇀𑆪𑆁 𑆖𑆳𑆱𑇀𑆪𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑇆𑇘𑇓𑇆
𑆫𑆑𑇀𑆠𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆤𑆁 𑆢𑆳𑆲𑆂 𑆱𑇀𑆮𑆼𑆢𑆯𑇀𑆗𑆫𑇀𑆢𑆤𑆮𑆴𑆨𑇀𑆫𑆩𑆿 𑇅 𑆥𑇀𑆫𑆬𑆳𑆥𑆂 𑆥𑆴𑆛𑆴𑆑𑆳 𑆠𑆸𑆰𑇀𑆟𑆳 𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆘𑇀𑆮𑆫𑆼 𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇘𑇔𑇆
𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆸𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆠𑆳 𑇅 𑆈𑆰𑇀𑆩𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆿 𑆓𑇀𑆬𑆳𑆤𑆴𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆁𑆱𑆓𑆼 𑆘𑇀𑆮𑆫𑆼 𑇆𑇘𑇕𑇆
𑆨𑆸𑆯𑆁 𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆸𑆰𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑇀𑆫𑆬𑆳𑆥𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆼𑆮 𑆖 𑇅 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆿 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑇀𑆩𑆼𑆢𑆂𑆱𑇀𑆡𑆼 𑆖𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑆳 𑇆𑇘𑇖𑇆
𑆨𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆑𑆶𑆚𑇀𑆖(𑆘)𑆤𑆁 𑆯𑇀𑆮𑆳𑆱𑆾 𑆮𑆴𑆫𑆼𑆑𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆼𑆮 𑆖 𑇅 𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆟𑆁 𑆖 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆼𑆠𑆢𑆱𑇀𑆡𑆴𑆓𑆠𑆼 𑆘𑇀𑆮𑆫𑆼 𑇆𑇘𑇗𑇆
𑆠𑆩𑆂𑆥𑇀𑆫𑆮𑆼𑆯𑆤𑆁 𑆲𑆴𑆑𑇀𑆑𑆳 𑆑𑆳𑆱𑆂 𑆯𑆽𑆠𑇀𑆪𑆁 𑆮𑆩𑆴𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆾 𑆩𑆲𑆳𑆯𑇀𑆮𑆳𑆱𑆾 𑆩𑆫𑇀𑆩𑆖𑇀𑆗𑆼𑆢𑆯𑇀𑆖 𑆩𑆘𑇀𑆘𑆓𑆼 𑇅 𑆩𑆫𑆟𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼 𑆘𑇀𑆮𑆫𑆼 𑇆𑇘𑇘𑇆
𑆯𑆼𑆦𑆱𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆠𑆳 𑆩𑆾𑆑𑇀𑆰𑆂 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇅 𑆢𑆓𑇀𑆣𑇀𑆮𑆼𑆤𑇀𑆣𑆤𑆁 𑆪𑆡𑆳 𑆮𑆲𑇀𑆤𑆴𑆫𑇀𑆣𑆳𑆠𑆷𑆤𑇀 𑆲𑆠𑇀𑆮𑆳 𑆪𑆡𑆳 𑆮𑆴𑆰𑆩𑇀 𑇆𑇘𑇙𑇆
𑆑𑆸𑆠𑆑𑆸𑆠𑇀𑆪𑆾 𑆮𑇀𑆫𑆘𑆼𑆖𑇀𑆗𑆳𑆤𑇀𑆠𑆴𑆁 𑆢𑆼𑆲𑆁 𑆲𑆠𑇀𑆮𑆳 𑆠𑆡𑆳 𑆘𑇀𑆮𑆫𑆂 𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆾𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆘𑇀𑆮𑆫𑆳𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆪𑆡𑆳 𑇆𑇙𑇐𑇆
𑆠𑆡𑆳 𑆠𑆼𑆰𑆳𑆁 𑆨𑆴𑆰𑆓𑇀𑆧𑇀𑆫𑆷𑆪𑆳𑆢𑇀𑆫𑆱𑆳𑆢𑆴𑆰𑇀𑆮𑆥𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆱𑆩𑆱𑇀𑆠𑆽𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆤 𑆣𑆳𑆠𑆶𑆱𑇀𑆡𑆩𑆥𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇙𑇑𑇆
𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆁 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆽𑆫𑆼𑆮 𑆢𑆾𑆰𑆽𑆯𑇀𑆖𑆳𑆥𑆴 𑆮𑆢𑆼𑆠𑇀 𑆑𑆸𑆠𑆩𑇀 𑇅 𑆓𑆩𑇀𑆨𑆵𑆫𑆱𑇀𑆠𑆶 𑆘𑇀𑆮𑆫𑆾 𑆘𑇀𑆚𑆼𑆪𑆾 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆼𑆤 𑆠𑆸𑆰𑇀𑆟𑆪𑆳 𑇆𑇙𑇒𑇆
𑆄𑆤𑆢𑇀𑆣𑆠𑇀𑆮𑆼𑆤 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆾𑆢𑇀𑆓𑆩𑆼𑆤 𑆖 𑇅𑇙𑇓𑇅 𑆲𑆠𑆥𑇀𑆫𑆨𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆑𑇀𑆰𑆵𑆟𑆩𑆫𑆾𑆖𑆑𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆩𑇀 𑇆𑇙𑇓𑇆
𑆓𑆩𑇀𑆨𑆵𑆫𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆮𑆼𑆓𑆳𑆫𑇀𑆠𑆁 𑆘𑇀𑆮𑆫𑆴𑆠𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅𑇙𑇔𑇅 𑆲𑆵𑆤𑆩𑆣𑇀𑆪𑆳𑆣𑆴𑆑𑆽𑆫𑇀𑆢𑆾𑆰𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆱𑆥𑇀𑆠𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆴𑆑𑆂 𑇆𑇙𑇔𑇆
𑆘𑇀𑆮𑆫𑆮𑆼𑆓𑆾 𑆨𑆮𑆼𑆠𑇀𑆠𑆵𑆮𑇀𑆫𑆾 𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑆶𑆒𑆑𑇀𑆫𑆴𑆪𑆂 𑇅𑇙𑇕𑇅 𑆑𑆳𑆬𑆾 𑆲𑇀𑆪𑆾𑆰 𑆪𑆩𑆯𑇀𑆖𑆽𑆮 𑆤𑆴𑆪𑆠𑆴𑆫𑇀𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆼𑆮 𑆖 𑇆𑇙𑇕𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆮𑇀𑆪𑆥𑆓𑆠𑆼 𑆢𑆼𑆲𑆳𑆘𑇀𑆘𑆤𑇀𑆩𑆼𑆲 𑆥𑆶𑆤𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆅𑆠𑆴 𑆘𑇀𑆮𑆫𑆳𑆂 𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑆑𑆫𑇀𑆩𑆼𑆢𑆳𑆤𑆵𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇙𑇖𑇆
𑆘𑇀𑆮𑆫𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆼𑆰𑆶 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆼𑆰𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆥𑆳𑆪𑆪𑆼𑆠 𑆔𑆸𑆠𑆁 𑆱𑇀𑆮𑆖𑇀𑆗𑆁 𑆠𑆠𑆂 𑆱 𑆬𑆨𑆠𑆼 𑆱𑆶𑆒𑆩𑇀 𑇆𑇙𑇗𑇆

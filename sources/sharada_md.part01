𑆥𑆫𑆱𑇀𑆥𑆫𑆾𑆥𑆑𑆳𑆫𑆼𑆟 𑆮𑆫𑇀𑆠𑆠𑆼 𑆣𑆳𑆫𑇀𑆪𑆠𑆼𑇁𑆥𑆴 𑆖 𑇅 𑆢𑆼𑆮𑆳 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆤𑇀 𑆥𑇀𑆫𑆵𑆟𑆤𑇀𑆠𑆴 𑆠𑆽𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆵𑆁𑆱𑇀𑆠𑆡𑆽𑆮 𑆖 𑇆𑇑𑇔𑇆
𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆽𑆫𑇀𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆯𑆵𑆠𑆮𑆫𑇀𑆰𑆾𑆰𑇀𑆟𑆩𑆳𑆫𑆶𑆠𑆽𑆂 𑇅 𑆅𑆘𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆴𑆤𑆩𑆱𑇀𑆑𑆳𑆫𑆘𑆥𑆲𑆾𑆩𑆮𑇀𑆫𑆠𑆳𑆢𑆴𑆨𑆴𑆂 𑇆𑇑𑇕𑇆
𑆤𑆫𑆳𑆂 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆵𑆟𑆤𑇀𑆠𑆴 𑆠𑇀𑆫𑆴𑆢𑆴𑆮𑆼𑆯𑇀𑆮𑆫𑆳𑆤𑇀 𑇅 𑆨𑆳𑆓𑆣𑆼𑆪𑆁 𑆮𑆴𑆨𑆑𑇀𑆠𑆁 𑆖 𑆯𑆼𑆰𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆤𑇀𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼 𑇆𑇑𑇖𑇆
𑆠𑆢𑇀𑆪𑆶𑆰𑇀𑆩𑆳𑆑𑆁 𑆯𑆶𑆨𑆳 𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆧𑆳𑆬𑆼𑆰𑇀𑆮𑆼𑆮 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆴 𑇅 𑆑𑆶𑆬𑆼𑆰𑆶 𑆪𑆼𑆰𑆶 𑆤𑆼𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆢𑆼𑆮𑆳𑆂 𑆥𑆴𑆠𑆫 𑆍𑆮 𑆖 𑇆𑇑𑇗𑇆
𑆇𑆠𑇀𑆱𑆤𑇀𑆤𑆧𑆬𑆴𑆨𑆴𑆑𑇀𑆰𑆼𑆰𑆶 𑆨𑆴𑆤𑇀𑆤𑆑𑆳𑆁𑆱𑇀𑆪𑆾𑆥𑆨𑆾𑆘𑆴𑆰𑆶 𑇅 𑆓𑆸𑆲𑆼𑆰𑆶 𑆠𑆼𑆰𑆶 𑆪𑆼 𑆧𑆳𑆬𑆳𑆱𑇀𑆠𑆳𑆤𑇀 𑆓𑆸𑆲𑇀𑆟𑆵𑆣𑇀𑆮𑆩𑆯𑆕𑇀𑆑𑆴𑆠𑆳𑆂 𑇆𑇑𑇙𑇆
𑆠𑆠𑇀𑆫 𑆮𑆾 𑆮𑆴𑆥𑆶𑆬𑆳 𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆥𑆷𑆘𑆳 𑆖𑆽𑆮 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆴 𑇅 𑆍𑆮𑆁 𑆓𑇀𑆫𑆲𑆳𑆂 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆳 𑆧𑆳𑆬𑆳𑆤𑇀 𑆓𑆸𑆲𑇀𑆟𑆤𑇀𑆠𑆴 𑆖𑆳𑆥𑇀𑆪𑆠𑆂 𑇆𑇒𑇐𑇆
𑆓𑇀𑆫𑆲𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳 𑆧𑆳𑆬𑆳𑆱𑇀𑆠𑆶 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆠𑆩𑆳 𑆩𑆠𑆳𑆂 𑇅𑇒𑇑𑇅 𑆮𑆽𑆑𑆬𑇀𑆪𑆁 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑆴 𑆣𑇀𑆫𑆶𑆮𑆁 𑆱𑇀𑆑𑆤𑇀𑆢𑆓𑇀𑆫𑆲𑆼 𑆩𑆠𑆩𑇀 𑇆𑇒𑇑𑇆
𑆱𑇀𑆑𑆤𑇀𑆢𑆓𑇀𑆫𑆲𑆾𑇁𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆠𑆩𑆂 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆼𑆮 𑆪𑆠𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆃𑆤𑇀𑆪𑆾 𑆮𑆳 𑆱𑆫𑇀𑆮𑆫𑆷𑆥𑆱𑇀𑆠𑆶 𑆤 𑆱𑆳𑆣𑇀𑆪𑆾 𑆓𑇀𑆫𑆲 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱 𑆢𑆶𑆰𑇀𑆛𑆾 𑆪𑆾𑆤𑆴𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆪𑆾𑆤𑆴𑆫𑆾𑆓𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼 𑇅𑇔𑇅 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆥𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆬𑆑𑇀𑆰𑆟𑆼𑆤 𑆠𑆶 𑇆𑇔𑇆
𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆪𑆾𑆤𑆼𑆫𑇀𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆫𑆾𑆓𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼 𑇅 𑆩𑆴𑆡𑇀𑆪𑆳𑆖𑆳𑆫𑆼𑆟 𑆪𑆳𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆼𑆤𑆳𑆫𑇀𑆠𑆮𑆼𑆤 𑆖 𑇆𑇕𑇆
𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆧𑆵𑆘𑆢𑆾𑆰𑆳𑆖𑇀𑆖 𑆢𑆽𑆮𑆳𑆖𑇀𑆖 𑆯𑆸𑆟𑆶 𑆠𑆳𑆂 𑆥𑆸𑆡𑆑𑇀 𑇅𑇖𑇅 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆳 𑆠𑆡𑆳 𑆮𑆤𑇀𑆣𑇀𑆪𑆳 𑆮𑆴𑆥𑇀𑆬𑆶𑆠𑆳 𑆖 𑆥𑆫𑆴𑆥𑇀𑆬𑆶𑆠𑆳 𑇆𑇖𑇆
𑆮𑆳𑆠𑆬𑆳 𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆾𑆠𑇀𑆡𑆳𑆂, 𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆡𑆳 𑆫𑆶𑆣𑆴𑆫𑆑𑇀𑆰𑆫𑆳 𑇅 𑆮𑆳𑆩𑆴𑆤𑆵 𑆱𑇀𑆫𑆁𑆱𑆴𑆤𑆵 𑆖𑆳𑆥𑆴 𑆥𑆶𑆠𑇀𑆫𑆔𑇀𑆤𑆵 𑆥𑆴𑆠𑇀𑆠𑆬𑆳 𑆖 𑆪𑆳 𑇆𑇗𑇆
𑆃𑆠𑇀𑆪𑆳𑆤𑆤𑇀𑆢𑆳 𑆖 𑆪𑆳 𑆪𑆾𑆤𑆴𑆂 𑆑𑆫𑇀𑆟𑆴𑆤𑆵 𑆖𑆫𑆟𑆳𑆢𑇀𑆮𑆪𑆩𑇀 𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳 𑆖 𑆑𑆦𑆳𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆳, 𑆰𑆟𑇀𑆝𑆳𑆒𑇀𑆪𑆳 𑆦𑆬𑆴𑆤𑆵 𑆠𑆡𑆳 𑇆𑇘𑇆
𑆩𑆲𑆠𑆵 𑆱𑆷𑆖𑆴𑆮𑆑𑇀𑆠𑇀𑆫𑆳 𑆖 𑆱𑆫𑇀𑆮𑆘𑆼𑆠𑆴 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆳 𑇅𑇙𑇅 𑆱𑆦𑆼𑆤𑆴𑆬𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆳 𑆫𑆘𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟 𑆩𑆶𑆚𑇀𑆖𑆠𑆴 𑇆𑇙𑇆
𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆁 𑆤𑆰𑇀𑆛𑆳𑆫𑇀𑆠𑆮𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆥𑇀𑆬𑆶𑆠𑆳𑆁 𑆤𑆴𑆠𑇀𑆪𑆮𑆼𑆢𑆤𑆳𑆩𑇀 𑇅 𑆥𑆫𑆴𑆥𑇀𑆬𑆶𑆠𑆳𑆪𑆳𑆁 𑆨𑆮𑆠𑆴 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆣𑆫𑇀𑆩𑆼 𑆫𑆶𑆘𑆳 𑆨𑆸𑆯𑆩𑇀 𑇆𑇑𑇐𑇆
𑆮𑆳𑆠𑆬𑆳 𑆑𑆫𑇀𑆑𑆯𑆳 𑆱𑇀𑆠𑆧𑇀𑆣𑆳 𑆯𑆷𑆬𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆥𑆵𑆝𑆴𑆠𑆳 𑇅 𑆖𑆠𑆱𑆸𑆰𑇀𑆮𑆥𑆴 𑆖𑆳𑆢𑇀𑆪𑆳𑆱𑆶 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆤𑆴𑆬𑆮𑆼𑆢𑆤𑆳𑆂 𑇆𑇑𑇑𑇆
𑆱𑆢𑆳𑆲𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆫𑆠𑇀𑆪𑆱𑇀𑆫𑆁 𑆪𑆱𑇀𑆪𑆳𑆁 𑆱𑆳 𑆬𑆾𑆲𑆴𑆠𑆑𑇀𑆰𑆫𑆳 𑇅 𑆱𑆮𑆳𑆠𑆩𑆶𑆢𑇀𑆓𑆴𑆫𑆼𑆢𑇀𑆧𑆵𑆘𑆁 𑆮𑆳𑆩𑆴𑆤𑆵 𑆫𑆘𑆱𑆳 𑆪𑆶𑆠𑆩𑇀 𑇆𑇑𑇒𑇆
𑆥𑇀𑆫𑆱𑇀𑆫𑆁𑆱𑆴𑆤𑆵 𑆱𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆠𑆶 𑆑𑇀𑆰𑆾𑆨𑆴𑆠𑆳 𑆢𑆶𑆂𑆥𑇀𑆫𑆱𑆷𑆯𑇀𑆖 𑆪𑆳 𑇅 𑆱𑇀𑆡𑆴𑆠𑆁 𑆱𑇀𑆡𑆴𑆠𑆁 𑆲𑆤𑇀𑆠𑆴 𑆓𑆫𑇀𑆨𑆁 𑆥𑆶𑆠𑇀𑆫𑆔𑇀𑆤𑆵 𑆫𑆑𑇀𑆠𑆱𑆁𑆱𑇀𑆫𑆮𑆳𑆠𑇀 𑇆𑇑𑇓𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆴𑆠𑇀𑆠𑆬𑆳 𑆪𑆾𑆤𑆴𑆫𑇀𑆢𑆳𑆲𑆥𑆳𑆑𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑆮𑆴𑆠𑆳 𑇅 𑆖𑆠𑆱𑆸𑆰𑇀𑆮𑆥𑆴 𑆖𑆳𑆢𑇀𑆪𑆳𑆱𑆶 𑆥𑆴𑆠𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆾𑆖𑇀𑆗𑇀𑆫𑆪𑆾 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆃𑆠𑇀𑆪𑆳𑆤𑆤𑇀𑆢𑆳 𑆤 𑆱𑆤𑇀𑆠𑆾𑆰𑆁 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆣𑆫𑇀𑆩𑆼𑆟 𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆑𑆫𑇀𑆟𑆴𑆤𑇀𑆪𑆳𑆁 𑆑𑆫𑇀𑆟𑆴𑆑𑆳 𑆪𑆾𑆤𑆿 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆱𑆸𑆓𑇀𑆨𑇀𑆪𑆁 𑆥𑇀𑆫𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇕𑇆
𑆩𑆽𑆡𑆶𑆤𑆼𑇁𑆖𑆫𑆟𑆳 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑆶𑆫𑆶𑆰𑆳𑆢𑆠𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼 𑇅 𑆧𑆲𑆶𑆯𑆯𑇀𑆖𑆳𑆠𑆴𑆖𑆫𑆟𑆳𑆢𑆤𑇀𑆪𑆳 𑆧𑆵𑆘𑆁 𑆤 𑆮𑆴𑆤𑇀𑆢𑆠𑆴 𑇆𑇑𑇖𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳 𑆪𑆾𑆤𑆴𑆂 𑆑𑆟𑇀𑆝𑆷𑆪𑆶𑆑𑇀𑆠𑆳𑇁𑆠𑆴𑆯𑆵𑆠𑆬𑆳 𑇅
𑆖𑆠𑆱𑆸𑆰𑇀𑆮𑆥𑆴 𑆖𑆳𑆢𑇀𑆪𑆳𑆱𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆴𑆕𑇀𑆓𑆾𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆴𑆫𑇀𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇗𑇆

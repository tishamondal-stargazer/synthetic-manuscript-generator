𑆅𑆠𑆴 𑆯𑇀𑆮𑆼𑆠𑆑𑆫𑆮𑆵𑆫𑆥𑆬𑇀𑆬𑆮𑆳𑆢𑇀𑆪𑆁 𑆠𑆽𑆬𑆩𑇀𑇅 𑆠𑆴𑆑𑇀𑆠𑆳𑆬𑆳𑆧𑆶𑆑𑆧𑆵𑆘𑆁 𑆢𑇀𑆮𑆼 𑆠𑆶𑆠𑇀𑆡𑆼 𑆫𑆾𑆖𑆤𑆳 𑆲𑆫𑆴𑆢𑇀𑆫𑆼 𑆢𑇀𑆮𑆼𑇅 𑆧𑆸𑆲𑆠𑆵𑆦𑆬𑆩𑆼𑆫𑆟𑇀𑆝𑆂 𑆱𑆮𑆴𑆯𑆳𑆬𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆩𑆷𑆫𑇀𑆮𑆳𑇆𑇑𑇐𑇘𑇆
𑆑𑆳𑆱𑆵𑆱𑆲𑆴𑆕𑇀𑆓𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑇀𑇅 𑆬𑆳𑆕𑇀𑆓𑆳𑆬𑆑𑆁 𑆑𑆶𑆛𑆘𑆠𑇀𑆮𑆑𑇀 𑆑𑆛𑆶𑆑𑆳𑆒𑇀𑆪𑆳 𑆫𑆾𑆲𑆴𑆟𑆵 𑆖𑆽𑆮𑇆𑇑𑇐𑇙𑇆
𑆱𑆫𑇀𑆰𑆥𑆠𑆽𑆬𑆁 𑆑𑆬𑇀𑆑𑆽𑆫𑆼𑆠𑆽𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆼 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼 𑆱𑆳𑆣𑇀𑆪𑆩𑇀𑇅 𑆑𑆟𑇀𑆝𑆷𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑇀𑆩𑆳𑆫𑆶𑆠𑆑𑆦𑆲𑆤𑇀𑆠𑆸𑇆𑇑𑇑𑇐𑇆
𑆅𑆠𑆴 𑆠𑆴𑆑𑇀𑆠𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑇀𑆮𑆳𑆢𑆴𑆠𑆽𑆬𑆩𑇀𑇅 𑆑𑆤𑆑𑆑𑇀𑆰𑆵𑆫𑆵 𑆯𑆽𑆬𑆳 𑆨𑆳𑆫𑇀𑆓𑆵 𑆢𑆤𑇀𑆠𑇀𑆪𑆳𑆂 𑆦𑆬𑆳𑆤𑆴 𑆩𑆷𑆬𑆁 𑆖𑇅 𑆘𑆳𑆠𑆵𑆥𑇀𑆫𑆮𑆳𑆬𑆱𑆫𑇀𑆰𑆥𑆬𑆯𑆶𑆤𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆑𑆫𑆚𑇀𑆘𑆠𑇀𑆮𑆑𑇀𑇆𑇑𑇑𑇑𑇆
𑆱𑆥𑇀𑆠𑆖𑇀𑆗𑆢𑆳𑆫𑇀𑆑𑆥𑆬𑇀𑆬𑆮𑆩𑆷𑆬𑆠𑇀𑆮𑆕𑇀𑆤𑆴𑆩𑇀𑆧𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆱𑇀𑆦𑆾𑆠𑆳𑆂𑇅 𑆓𑆶𑆚𑇀𑆘𑆽𑆫𑆟𑇀𑆝𑆁 𑆧𑆸𑆲𑆠𑆵𑆩𑆷𑆬𑆑𑆱𑆶𑆫𑆱𑆳𑆫𑇀𑆘𑆑𑆦𑆬𑆳𑆤𑆴𑇆𑇑𑇑𑇒𑇆
𑆑𑆶𑆰𑇀𑆜𑆁 𑆥𑆳𑆜𑆳 𑆩𑆶𑆱𑇀𑆠𑆁 𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶𑆩𑆷𑆫𑇀𑆮𑆳𑆮𑆖𑆳𑆂 𑆱𑆰𑆝𑇀𑆓𑇀𑆫𑆤𑇀𑆡𑆳𑆂 𑇅 𑆍𑆝𑆓𑆘𑆑𑆶𑆛𑆘𑆯𑆴𑆓𑇀𑆫𑆶𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆰𑆮𑆑𑆳𑆂𑇆𑇑𑇑𑇓𑇆
𑆲𑆫𑆴𑆠𑆳𑆬𑆩𑆮𑆳𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆵 𑆠𑆶𑆠𑇀𑆡𑆁 𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆾𑇁𑆩𑆸𑆠𑆳𑆱𑆚𑇀𑆘𑇀𑆚𑆂𑇅 𑆱𑆿𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆵 𑆑𑆳𑆱𑆵𑆱𑆁 𑆢𑆳𑆫𑇀𑆮𑆵𑆠𑇀𑆮𑆑𑇀 𑆱𑆫𑇀𑆘𑆴𑆑𑆳𑆬𑆮𑆟𑆩𑇀𑇆𑇑𑇑𑇔𑇆
𑆑𑆬𑇀𑆑𑆽𑆫𑆼𑆠𑆽𑆱𑇀𑆠𑆽𑆬𑆁 𑆑𑆫𑆮𑆵𑆫𑆑𑆩𑆷𑆬𑆥𑆬𑇀𑆬𑆮𑆑𑆰𑆳𑆪𑆼𑇅 𑆱𑆳𑆫𑇀𑆰𑆥𑆩𑆡𑆮𑆳 𑆠𑆽𑆬𑆁 𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆁 𑆱𑆳𑆣𑇀𑆪𑆩𑇀𑇆𑇑𑇑𑇕𑇆
𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆁 𑆑𑆛𑆶𑆑𑆳𑆬𑆳𑆧𑆶𑆤𑆴 𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆼𑆤 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑇀𑆪𑆳𑆯𑆶𑇅 𑆨𑆴𑆤𑇀𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆠𑇀𑆑𑆸𑆩𑆵𑆁𑆯𑇀𑆖 𑆑𑆟𑇀𑆝𑆷𑆁 𑆖 𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇑𑇖𑇆
𑆅𑆠𑆴 𑆑𑆤𑆑𑆑𑇀𑆰𑆵𑆫𑆵𑆠𑆽𑆬𑆩𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆩𑆳𑆬𑆥𑆠𑇀𑆫𑆁 𑆩𑆫𑆴𑆖𑆁 𑆱𑆩𑆤𑆂𑆯𑆴𑆬𑆁 𑆱𑆑𑆳𑆱𑆵𑆱𑆩𑇀𑇅 𑆠𑆽𑆬𑆼𑆤 𑆪𑆶𑆑𑇀𑆠𑆩𑆶𑆰𑆴𑆠𑆁 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆨𑆳𑆘𑆤𑆼 𑆠𑆳𑆩𑇀𑆫𑆼𑇆𑇑𑇑𑇗𑇆
𑆠𑆼𑆤𑆳𑆬𑆴𑆥𑇀𑆠𑆁 𑆱𑆴𑆣𑇀𑆩𑆁 𑆱𑆥𑇀𑆠𑆳𑆲𑆳𑆲𑇀𑆪𑆼𑆠𑆴 𑆠𑆴𑆰𑇀𑆜𑆠𑆾 𑆔𑆫𑇀𑆩𑆼𑇅 𑆩𑆳𑆱𑆳𑆤𑇀𑆤𑆮𑆁 𑆑𑆴𑆬𑆳𑆱𑆁 𑆱𑇀𑆤𑆳𑆤𑆁 𑆩𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆠𑆤𑆾𑆂𑇆𑇑𑇑𑇘𑇆
𑆅𑆠𑆴 𑆱𑆴𑆣𑇀𑆩𑆼 𑆬𑆼𑆥𑆂𑇅 𑆱𑆫𑇀𑆰𑆥𑆑𑆫𑆚𑇀𑆘𑆑𑆾𑆰𑆳𑆠𑆑𑆵𑆤𑆳𑆁 𑆠𑆽𑆬𑆳𑆤𑇀𑆪𑆡𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆤𑆳𑆁 𑆖𑇅 𑆑𑆶𑆰𑇀𑆜𑆼𑆰𑆶 𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆱𑇀𑆠𑆽𑆬𑆁 𑆪𑆖𑇀𑆖𑆳𑆥𑆴 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆱𑇀𑆪𑇆𑇑𑇑𑇙𑇆
𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳 𑆢𑆳𑆫𑇀𑆮𑆵 𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆂 𑆥𑆪𑆱𑇀𑆠𑆶𑆠𑇀𑆡𑆩𑇀𑇅 𑆍𑆰 𑆔𑆸𑆠𑆠𑆽𑆬𑆥𑆳𑆑𑆂 𑆱𑆴𑆢𑇀𑆣𑆂 𑆱𑆴𑆢𑇀𑆣𑆼 𑆖 𑆱𑆫𑇀𑆘𑆫𑆱𑆂𑇆𑇑𑇒𑇐𑇆
𑆢𑆼𑆪𑆂 𑆱𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆾 𑆮𑆴𑆥𑆳𑆢𑆴𑆑𑆳 𑆠𑆼𑆤 𑆯𑆳𑆩𑇀𑆪𑆠𑆼𑇁𑆨𑇀𑆪𑆑𑇀𑆠𑆳𑇅 𑆖𑆫𑇀𑆩𑆽𑆑𑆑𑆶𑆰𑇀𑆜𑆑𑆴𑆛𑆴𑆩𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆯𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆬𑆱𑆑𑆁 𑆖𑇆𑇑𑇒𑇑𑇆
𑆅𑆠𑆴 𑆮𑆴𑆥𑆳𑆢𑆴𑆑𑆳𑆲𑆫𑆔𑆸𑆠𑆠𑆽𑆬𑆼𑇅 𑆑𑆴𑆟𑇀𑆮𑆁 𑆮𑆫𑆳𑆲𑆫𑆶𑆣𑆴𑆫𑆁 𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆖 𑆬𑆼𑆥𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆬𑆼𑆥𑆾 𑆪𑆾𑆘𑇀𑆪𑆂 𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆷𑆟𑆴 𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆩𑆟𑇀𑆝𑆬𑆤𑆶𑆠𑇀𑇆𑇑𑇒𑇒𑇆
𑆥𑆷𑆠𑆵𑆑𑆢𑆳𑆫𑆶𑆘𑆛𑆴𑆬𑆳𑆂 𑆥𑆑𑇀𑆮𑆱𑆶𑆫𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑇀𑆪𑆿 𑆖𑇅 𑆬𑆼𑆥𑆂 𑆱𑆑𑆳𑆑𑆤𑆳𑆱𑆾 𑆩𑆟𑇀𑆝𑆬𑆑𑆶𑆰𑇀𑆜𑆳𑆥𑆲𑆂 𑆱𑆴𑆢𑇀𑆣𑆂𑇆𑇑𑇒𑇓𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆾𑆨𑆳𑆚𑇀𑆘𑆤𑆑𑆿 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆢𑆼𑆮𑆢𑆳𑆫𑆷𑆟𑆴𑇅 𑆒𑆢𑆴𑆫𑆾 𑆣𑆮𑆯𑇀𑆖 𑆬𑆼𑆥𑆂 𑆯𑇀𑆪𑆳𑆩𑆳 𑆢𑆤𑇀𑆠𑆵 𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵 𑆖𑇆𑇑𑇒𑇔𑇆
𑆬𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆽𑆬𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳 𑆖𑆼𑆠𑆴 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆾 𑆬𑆼𑆥𑆳𑆂𑇅 𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆪𑆶𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆢𑆼𑆪𑆳𑆂 𑆰𑆟𑇀𑆩𑆳𑆫𑆶𑆠𑆑𑆦𑆑𑆶𑆰𑇀𑆜𑆔𑇀𑆤𑆳𑆂𑇆𑇑𑇒𑇕𑇆
𑆍𑆝𑆓𑆘𑆑𑆶𑆰𑇀𑆜𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆿𑆮𑆵𑆫𑆑𑆱𑆫𑇀𑆰𑆥𑆽𑆂 𑆑𑆸𑆩𑆴𑆔𑇀𑆤𑆽𑆯𑇀𑆖𑇅 𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆩𑆟𑇀𑆝𑆬𑆳𑆒𑇀𑆪𑆁 𑆢𑆢𑇀𑆫𑆷𑆑𑆶𑆰𑇀𑆜𑆁 𑆖 𑆯𑆩𑆩𑆶𑆥𑆽𑆠𑆴𑇆𑇑𑇒𑇖𑇆
𑆍𑆝𑆓𑆘𑆂 𑆱𑆫𑇀𑆘𑆫𑆱𑆾 𑆩𑆷𑆬𑆑𑆧𑆵𑆘𑆁 𑆖 𑆱𑆴𑆣𑇀𑆩𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑇀𑇅 𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆶 𑆥𑆸𑆡𑆕𑇀𑆩𑆠𑆩𑆴𑆢𑆩𑆶𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆁 𑆬𑆼𑆥𑆳𑆂𑇆𑇑𑇒𑇗𑇆

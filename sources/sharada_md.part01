𑆩𑆷𑆠𑇀𑆫𑆮𑆼𑆓𑆤𑆴𑆫𑆱𑇀𑆠𑆳𑆱𑆶 𑆠𑆳𑆱𑆶 𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑆮𑆼𑆢𑆤𑆳 𑇅 𑆪𑆳𑆮𑆢𑆤𑇀𑆪𑆳 𑆥𑆶𑆤𑆫𑇀𑆤𑆽𑆠𑆴 𑆓𑆶𑆝𑆴𑆑𑆳 𑆱𑇀𑆫𑆾𑆠𑆱𑆾 𑆩𑆶𑆒𑆩𑇀 𑇆𑇑𑇔𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑆩𑇀𑆨𑆮𑆱𑇀𑆪𑆽𑆠𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆡𑆽𑆠𑆼𑆰𑆳𑆩𑆰𑇀𑆛𑆳𑆤𑆳𑆩𑆥𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇑𑇕𑇆
𑆃𑆯𑇀𑆩𑆫𑆵𑆁 𑆖 𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆠𑆠𑇀 𑇅 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆴𑆩𑆥𑆴 𑆖 𑆑𑇀𑆫𑆩𑆩𑇀 𑇆𑇑𑇖𑇆
𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑇀𑆩𑆨𑆴𑆢𑆿 𑆑𑆶𑆩𑇀𑆨𑆵𑆁 𑆲𑆥𑆶𑆰𑆳𑆁 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆴𑆑𑆳𑆩𑇀 𑇅 𑆧𑆬𑆳𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆁 𑆫𑆳𑆱𑇀𑆤𑆳𑆁 𑆮𑆫𑆶𑆟𑆁 𑆓𑆴𑆫𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆩𑇀 𑇆𑇑𑇗𑇆
𑆠𑆡𑆳 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆁 𑆱𑆁𑆲𑆸𑆠𑇀𑆪 𑆠𑇀𑆫𑆽𑆮𑆸𑆠𑆁 𑆥𑆖𑆼𑆠𑇀 𑇅 𑆠𑆽𑆬𑆁 𑆔𑆸𑆠𑆁 𑆮𑆳 𑆠𑆠𑇀 𑆥𑆼𑆪𑆁 𑆠𑆼𑆤 𑆮𑆳𑇁𑆥𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇑𑇘𑇆
𑆢𑆢𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆁 𑆖 𑆮𑆳𑆠𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇅 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆱𑇀𑆮𑆫𑆱𑆼 𑆠𑆽𑆬𑆁 𑆱𑆓𑆶𑆝𑆑𑇀𑆰𑆵𑆫𑆤𑆳𑆓𑆫𑆩𑇀 𑇆𑇑𑇙𑇆
𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆠𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆪𑆾𑆘𑇀𑆪𑆁 𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆫𑆶𑆘𑆳𑆥𑆲𑆩𑇀 𑇅 𑆠𑆸𑆟𑆾𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆑𑆳𑆑𑆾𑆬𑆵𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆓𑆟𑆽𑆂 𑆑𑆸(𑆯𑆸)𑆠𑆩𑇀 𑇆𑇒𑇐𑇆
𑆥𑆵𑆠𑆁 𑆔𑆸𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆤𑆳𑆯𑆪𑆼𑆠 𑆑𑇀𑆰𑆵𑆫𑆩𑆼𑆮 𑆮𑆳 𑇅 𑆢𑆢𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆧𑆱𑇀𑆠𑆴𑆁 𑆖 𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼 𑇆𑇒𑇑𑇆
𑆍𑆨𑆴𑆫𑆼𑆮 𑆑𑆸𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆼𑆰𑇀𑆮𑆥𑆴 𑆧𑆱𑇀𑆠𑆴𑆰𑆶 𑇅 𑆲𑆴𑆠𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖𑆼𑆑𑇀𑆰𑆶𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆽𑆫𑇀𑆪𑆶𑆠𑆩𑇀 𑇆𑇒𑇒𑇆
𑆱𑆶𑆫𑆱𑆾𑆰𑆑𑆩𑆶𑆱𑇀𑆠𑆳𑆢𑆿 𑆮𑆫𑆶𑆟𑆳𑆢𑆿 𑆖 𑆪𑆠𑇀 𑆑𑆸𑆠𑆩𑇀 𑇅 𑆠𑆽𑆬𑆁 𑆠𑆡𑆳 𑆪𑆮𑆳𑆓𑇀𑆮𑆳𑆢𑆴 𑆑𑆦𑆳𑆔𑆳𑆠𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇒𑇓𑇆
𑆪𑆡𑆳𑆢𑆾𑆰𑆾𑆖𑇀𑆗𑇀𑆫𑇀𑆪𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆼𑆠𑆳𑆤𑆼𑆮 𑆖 𑆱𑆫𑇀𑆮𑆘𑆼 𑇅 𑆦𑆬𑇀𑆓𑆶𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆢𑆫𑇀𑆨𑆳𑆯𑇀𑆩𑆱𑆳𑆫𑆖𑆷𑆫𑇀𑆟𑆁 𑆖 𑆮𑆳𑆫𑆴𑆟𑆳 𑇆𑇒𑇔𑇆
𑆱𑆶𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆢𑆫𑇀𑆨𑆳𑆩𑇀𑆧𑆶𑆥𑆵𑆠𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆫𑆶𑆘𑆳𑆥𑆲𑆩𑇀 𑇅 𑆠𑆡𑆳𑇁𑆨𑆴𑆔𑆳𑆠𑆘𑆼 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑆢𑇀𑆪𑆾𑆮𑇀𑆫𑆟𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇆𑇒𑇕𑇆
𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆯𑆑𑆸𑆘𑇀𑆘𑆳𑆠𑆼 𑆑𑆳𑆫𑇀𑆪𑆳 𑆮𑆳𑆠𑆲𑆫𑆵 𑆑𑇀𑆫𑆴𑆪𑆳 𑇅 𑆱𑇀𑆮𑆼𑆢𑆳𑆮𑆓𑆳𑆲𑆳𑆮𑆨𑇀𑆪𑆕𑇀𑆓𑆧𑆱𑇀𑆠𑆴𑆖𑆷𑆫𑇀𑆟𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑇆𑇒𑇖𑇆
𑆪𑆼 𑆠𑇀𑆮𑆤𑇀𑆪𑆼 𑆠𑆶 𑆠𑆡𑆳 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆠𑆪𑆾 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆣𑆴𑆂 𑇆𑇒𑇗𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆩𑆳𑆤𑆶𑆰𑆾𑆥𑆱𑆫𑇀𑆓𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆴𑆯𑆳𑆖𑆫𑆼𑆨𑇀𑆪𑆾 𑆫𑆑𑇀𑆰𑇀𑆪𑆱𑇀𑆠𑆶 𑆤𑆴𑆠𑇀𑆪𑆩𑆼𑆮 𑆑𑇀𑆰𑆠𑆳𑆠𑆶𑆫𑆂 𑇅 𑆅𑆠𑆴 𑆪𑆠𑇀 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆲𑆴𑆠𑆁 𑆮𑆴𑆱𑇀𑆠𑆫𑆱𑇀𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆓𑆶𑆲𑇀𑆪𑆳𑆤𑆳𑆓𑆠𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆤𑆮𑆱𑇀𑆡𑆳𑇁𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑆳 𑇅 𑆑𑇀𑆫𑆴𑆪𑆳 𑆮𑆳𑇁𑆩𑆳𑆤𑆶𑆰𑆵 𑆪𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆓𑇀𑆫𑆲𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑇀𑆪𑆠𑆼 𑇆𑇔𑇆
𑆃𑆯𑆶𑆖𑆴𑆁 𑆨𑆴𑆤𑇀𑆤𑆩𑆫𑇀𑆪𑆳𑆢𑆁 𑆑𑇀𑆰𑆠𑆁 𑆮 𑆪𑆢𑆴 𑆮𑆳𑇁𑆑𑇀𑆰𑆠𑆩𑇀 𑇅 𑆲𑆴𑆁𑆱𑇀𑆪𑆶𑆫𑇀𑆲𑆴𑆁𑆱𑆳𑆮𑆴𑆲𑆳𑆫𑆳𑆫𑇀𑆡𑆁 𑆱𑆠𑇀𑆑𑆳𑆫𑆳𑆫𑇀𑆡𑆩𑆡𑆳𑆥𑆴 𑆮𑆳 𑇆𑇕𑇆
𑆃𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆓𑇀𑆫𑆲𑆓𑆟𑆳 𑆓𑇀𑆫𑆲𑆳𑆣𑆴𑆥𑆠𑆪𑆱𑇀𑆠𑆶 𑆪𑆼 𑇅 𑆮𑇀𑆪𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆮𑆴𑆣𑆳𑆑𑆳𑆫𑆳 𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆼 𑆠𑆡𑆳𑇁𑆰𑇀𑆛𑆣𑆳 𑇆𑇖𑇆
𑆢𑆼𑆮𑆳𑆱𑇀𑆠𑆡𑆳 𑆯𑆠𑇀𑆫𑆶𑆓𑆟𑆳𑆯𑇀𑆖 𑆠𑆼𑆰𑆳𑆁 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆪𑆑𑇀𑆰𑆳𑆂 𑆥𑆴𑆠𑆫𑆾 𑆨𑆶𑆘𑆕𑇀𑆓𑆳𑆂 𑇅 𑆫𑆑𑇀𑆰𑆳𑆁𑆱𑆴 𑆪𑆳 𑆖𑆳𑆥𑆴 𑆥𑆴𑆯𑆳𑆖𑆘𑆳𑆠𑆴𑆫𑆼𑆰𑆾𑇁𑆰𑇀𑆛𑆑𑆾 𑆢𑆼𑆮𑆓𑆟𑆾 𑆓𑇀𑆫𑆲𑆳𑆒𑇀𑆪𑆂 𑇆𑇗𑇆
𑆱𑆤𑇀𑆠𑆶𑆰𑇀𑆛𑆂 𑆯𑆶𑆖𑆴𑆫𑆥𑆴 𑆖𑆼𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆩𑆳𑆬𑇀𑆪𑆾 𑆤𑆴𑆱𑇀𑆠𑆤𑇀𑆢𑇀𑆫𑆵 𑆲𑇀𑆪𑆮𑆴𑆠𑆡𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆥𑇀𑆫𑆨𑆳𑆰𑆵 𑇅 𑆠𑆼𑆘𑆱𑇀𑆮𑆵 𑆱𑇀𑆡𑆴𑆫𑆤𑆪𑆤𑆾 𑆮𑆫𑆥𑇀𑆫𑆢𑆳𑆠𑆳 𑆧𑇀𑆫𑆲𑇀𑆪𑆟𑇀𑆪𑆾 𑆨𑆮𑆠𑆴 𑆤𑆫𑆂 𑆱 𑆢𑆼𑆮𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇘𑇆
𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑆵 𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆢𑆼𑆮𑆢𑆾𑆰𑆮𑆑𑇀𑆠𑆳 𑆘𑆴𑆲𑇀𑆩𑆳𑆑𑇀𑆰𑆾 𑆮𑆴𑆓𑆠𑆨𑆪𑆾 𑆮𑆴𑆩𑆳𑆫𑇀𑆓𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑇅 𑆱𑆤𑇀𑆠𑆶𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴 𑆤 𑆖𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆘𑆳𑆠𑆽𑆫𑇀𑆢𑆶𑆰𑇀𑆛𑆳𑆠𑇀𑆩𑆳 𑆨𑆮𑆠𑆴 𑆖 𑆢𑆼𑆮𑆯𑆠𑇀𑆫𑆶𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇙𑇆
𑆲𑆸𑆰𑇀𑆛𑆳𑆠𑇀𑆩𑆳 𑆥𑆶𑆬𑆴𑆤𑆮𑆤𑆳𑆤𑇀𑆠𑆫𑆾𑆥𑆱𑆼𑆮𑆵 𑆱𑇀𑆮𑆳𑆖𑆳𑆫𑆂 𑆥𑇀𑆫𑆴𑆪𑆥𑆫𑆴𑆓𑆵𑆠𑆓𑆤𑇀𑆣𑆩𑆳𑆬𑇀𑆪𑆂 𑇅 𑆤𑆸𑆠𑇀𑆪𑆤𑇀 𑆮𑆽 𑆥𑇀𑆫𑆲𑆱𑆠𑆴 𑆖𑆳𑆫𑆶 𑆖𑆳𑆬𑇀𑆥𑆯𑆧𑇀𑆢𑆁 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆓𑇀𑆫𑆲𑆥𑆫𑆴𑆥𑆵𑆝𑆴𑆠𑆾 𑆩𑆤𑆶𑆰𑇀𑆪𑆂 𑇆𑇑𑇐𑇆
𑆠𑆳𑆩𑇀𑆫𑆳𑆑𑇀𑆰𑆂 𑆥𑇀𑆫𑆴𑆪𑆠𑆤𑆶𑆫𑆑𑇀𑆠𑆮𑆱𑇀𑆠𑇀𑆫𑆣𑆳𑆫𑆵 𑆓𑆩𑇀𑆨𑆵𑆫𑆾 𑆢𑇀𑆫𑆶𑆠𑆩𑆠𑆴𑆫𑆬𑇀𑆥𑆮𑆳𑆑𑇀 𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆂 𑇅 𑆠𑆼𑆘𑆱𑇀𑆮𑆵 𑆮𑆢𑆠𑆴 𑆖 𑆑𑆴𑆁 𑆢𑆢𑆳𑆩𑆴 𑆑𑆱𑇀𑆩𑆽 𑆪𑆾 𑆪𑆑𑇀𑆰𑆓𑇀𑆫𑆲𑆥𑆫𑆴𑆥𑆵𑆝𑆴𑆠𑆾 𑆩𑆤𑆶𑆰𑇀𑆪𑆂 𑇆𑇑𑇑𑇆
𑆥𑇀𑆫𑆼𑆠𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆱𑆸𑆘𑆠𑆴 𑆱𑆁𑆱𑇀𑆠𑆫𑆼𑆰𑆶 𑆥𑆴𑆟𑇀𑆝𑆳𑆤𑇀 𑆯𑆳𑆤𑇀𑆠𑆳𑆠𑇀𑆩𑆳 𑆘𑆬𑆩𑆥𑆴 𑆖𑆳𑆥𑆱𑆮𑇀𑆪𑆮𑆱𑇀𑆠𑇀𑆫𑆂 𑇅 𑆩𑆳𑆁𑆱𑆼𑆥𑇀𑆱𑆶𑆱𑇀𑆠𑆴𑆬𑆓𑆶𑆝𑆥𑆳𑆪𑆱𑆳𑆨𑆴𑆑𑆳𑆩𑆱𑇀𑆠𑆢𑇀𑆨𑆶𑆑𑇀𑆠𑆾 𑆨𑆮𑆠𑆴 𑆥𑆴𑆠𑆸𑆓𑇀𑆫𑆲𑆳𑆨𑆴𑆨𑆷𑆠𑆂 𑇆𑇑𑇒𑇆
𑆨𑆷𑆩𑆿 𑆪𑆂 𑆥𑇀𑆫𑆱𑆫𑆠𑆴 𑆱𑆫𑇀𑆥𑆮𑆠𑇀 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑆱𑆸𑆑𑇀𑆑𑆴𑆟𑇀𑆪𑆿 𑆮𑆴𑆬𑆴𑆒𑆠𑆴 𑆘𑆴𑆲𑇀𑆮𑆪𑆳 𑆠𑆡𑆽𑆮 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆶𑆫𑇀𑆓𑆝𑆩𑆣𑆶𑆢𑆶𑆓𑇀𑆣𑆥𑆳𑆪𑆱𑆼𑆥𑇀𑆱𑆶𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆨𑆮𑆠𑆴 𑆨𑆶𑆘𑆕𑇀𑆓𑆩𑆼𑆤 𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇑𑇓𑇆

𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆠𑆶𑆬𑇀𑆪𑆳 𑆠𑆶 𑆯𑆷𑆑𑆢𑆶𑆫𑇀𑆨𑆓𑇀𑆤𑆲𑆼𑆠𑆶𑆑𑆳 𑇅 𑆥𑆴𑆝𑆑𑆳 𑆑𑆦𑆫𑆑𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆘𑇀𑆚𑆼𑆪𑆳 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆳 𑆧𑆶𑆣𑆽𑆂 𑇆𑇔𑇆
𑆑𑆜𑆴𑆤𑆳 𑆮𑆴𑆰𑆩𑆽𑆫𑆤𑇀𑆠𑆽𑆫𑇀𑆩𑆳𑆫𑆶𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆠𑆂 𑇅 𑆯𑆷𑆑𑆽𑆱𑇀𑆠𑆶 𑆮𑆴𑆰𑆱𑆩𑇀𑆨𑆶𑆓𑇀𑆤𑆽𑆂 𑆥𑆴𑆝𑆑𑆳𑇁𑆰𑇀𑆜𑆵𑆬𑆴𑆑𑆳 𑆨𑆮𑆼𑆠𑇀 𑇆𑇕𑇆
𑆃𑆬𑆘𑆵𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆩𑆬𑆘𑆵𑆁 𑆖 𑆮𑆴𑆠𑆫𑇀𑆑𑆪𑆼𑆠𑇀 𑇅 𑆩𑆸𑆢𑆴𑆠𑆁 𑆥𑆵𑆝𑆴𑆠𑆁 𑆪𑆠𑇀𑆠𑆶 𑆱𑆁𑆫𑆧𑇀𑆣𑆁 𑆮𑆳𑆪𑆶𑆑𑆾𑆥𑆠𑆂 𑇆𑇗𑇆
𑆗𑆴𑆢𑇀𑆫𑆽𑆫𑆟𑆶𑆩𑆶𑆒𑆽𑆫𑇀𑆮𑆱𑇀𑆠𑆶 𑆖𑆴𑆠𑆁 𑆪𑆱𑇀𑆪 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑇅 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆘𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆂 𑆯𑆠𑆥𑆾𑆤𑆑𑆂 𑇆𑇑𑇒𑇆
𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑆴 𑆖𑆴𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆡𑆮𑆳 𑆯𑆷𑆑𑆳𑆤𑆴 𑆱𑆮𑆴𑆰𑆳𑆟𑆴 𑆖 𑇅 𑆥𑆳𑆠𑆴𑆠𑆳𑆤𑆴 𑆥𑆖𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆩𑆼𑆞𑇀𑆫𑆁 𑆤𑆴𑆫𑆮𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇖𑇆
𑆑𑆳𑆬𑆳𑆤𑆴 𑆨𑆷𑆠𑇀𑆮𑆳 𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆯𑆵𑆫𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆁 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆩𑇀 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆩𑆳𑆁𑆱𑆳𑆫𑇀𑆧𑆶𑆢𑆁 𑆪𑆖𑇀𑆖 𑆩𑆳𑆁𑆱𑆥𑆳𑆑𑆯𑇀𑆖 𑆪𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆯𑇀𑆖 𑆤 𑆱𑆴𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆪𑆼 𑆖 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆳𑆂 𑇆𑇑𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆨𑆓𑇀𑆤𑆳𑆤𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑆠𑆤𑆥𑆵𑆝𑆤𑆥𑇀𑆫𑆲𑆳𑆫𑆳𑆑𑇀𑆰𑆼𑆥𑆟𑆮𑇀𑆪𑆳𑆬𑆩𑆸𑆓𑆢𑆯𑆤𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑆤𑆼𑆑𑆮𑆴𑆣𑆩𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆨𑆕𑇀𑆓𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆨𑆕𑇀𑆓(𑆓𑇀𑆤)𑆘𑆳𑆠𑆩𑆤𑆼𑆑𑆮𑆴𑆣𑆩𑆤𑆶𑆱𑆳𑆫𑇀𑆪𑆩𑆳𑆟𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆼𑆮𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆁, 𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆁 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆰𑆝𑇀𑆮𑆴𑆣𑆁 𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆁, 𑆢𑇀𑆮𑆳𑆢𑆯𑆮𑆴𑆣𑆁 𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆁 𑆨𑆮𑆠𑆴 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆩𑇀- 𑆇𑆠𑇀𑆥𑆴𑆰𑇀𑆛𑆁, 𑆮𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆁, 𑆮𑆴𑆮𑆫𑇀𑆠𑆴𑆠𑆩𑇀, 𑆃𑆮𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆩𑇀, 𑆃𑆠𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆁, 𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆩𑆴𑆠𑆴 𑆰𑆝𑇀𑆮𑆴𑆣𑆩𑇀 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆮𑆴𑆮𑆫𑇀𑆠𑆤𑆳𑆑𑇀𑆰𑆼𑆥𑆟𑆳𑆯𑆑𑇀𑆠𑆴𑆫𑆶𑆓𑇀𑆫𑆫𑆶𑆘𑆠𑇀𑆮𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆱𑆲𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇖𑇆
𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆁 𑆠𑆷𑆠𑇀𑆥𑆴𑆰𑇀𑆛𑆼 𑆱𑆤𑇀𑆣𑆳𑆮𑆶𑆨𑆪𑆠𑆂 𑆯𑆾𑆦𑆾 𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳 𑆮𑆼𑆢𑆤𑆳 𑆫𑆳𑆠𑇀𑆫𑆿 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴; 𑆮𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆼𑇁𑆬𑇀𑆥𑆂 𑆯𑆾𑆦𑆾 𑆮𑆼𑆢𑆤𑆳𑆱𑆳𑆠𑆠𑇀𑆪𑆁 𑆱𑆤𑇀𑆣𑆴𑆮𑆴𑆑𑇀𑆫𑆴𑆪𑆳 𑆖; 𑆮𑆴𑆮𑆫𑇀𑆠𑆴𑆠𑆼 𑆠𑆶 𑆱𑆤𑇀𑆣𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆥𑆓𑆩𑆤𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆳𑆕𑇀𑆓𑆠𑆳 𑆮𑆼𑆢𑆤𑆳 𑆖; 𑆃𑆮𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆼 𑆱𑆤𑇀𑆣𑆴𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆫𑆶𑆘𑆠𑇀𑆮𑆁 𑆖; 𑆃𑆠𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆼 𑆢𑇀𑆮𑆪𑆾𑆂 𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑇀𑆤𑆾𑆫𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆠𑆳 𑆮𑆼𑆢𑆤𑆳 𑆖; 𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆼 𑆠𑇀𑆮𑆼𑆑𑆳𑆱𑇀𑆡𑆴𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆥𑆓𑆩𑆤𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆼𑆢𑆤𑆳 𑆖𑆼𑆠𑆴 𑇆𑇗𑇆
𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆑𑆫𑇀𑆑𑆛𑆑𑆩𑇀, 𑆃𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆁, 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁, 𑆥𑆴𑆖𑇀𑆖𑆴𑆠𑆩𑇀, 𑆃𑆱𑇀𑆡𑆴𑆖𑇀𑆗𑆬𑇀𑆬𑆴𑆠𑆁, 𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆁, 𑆩𑆘𑇀𑆘𑆳𑆤𑆶𑆓𑆠𑆩𑇀, 𑆃𑆠𑆴𑆥𑆳𑆠𑆴𑆠𑆁, 𑆮𑆑𑇀𑆫𑆁, 𑆗𑆴𑆤𑇀𑆤𑆁, 𑆥𑆳𑆛𑆴𑆠𑆁, 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆩𑆴𑆠𑆴 𑆢𑇀𑆮𑆳𑆢𑆯𑆮𑆴𑆣𑆩𑇀 𑇆𑇘𑇆
𑆯𑇀𑆮𑆪𑆡𑆶𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆁 𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆮𑆴𑆮𑆫𑇀𑆠𑆤𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆱𑆲𑆴𑆰𑇀𑆟𑆶𑆠𑇀𑆮𑆩𑆮𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆼 𑆯𑆧𑇀𑆢𑆂 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆠𑆳 𑆮𑆴𑆮𑆴𑆣𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂 𑆱𑆫𑇀𑆮𑆳𑆱𑇀𑆮𑆮𑆱𑇀𑆡𑆳𑆱𑆶 𑆤 𑆯𑆫𑇀𑆩𑆬𑆳𑆨 𑆅𑆠𑆴 𑆱𑆩𑆳𑆱𑆼𑆤 𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇙𑇆
𑆮𑆴𑆯𑆼𑆰𑆱𑇀𑆠𑆶 𑆱𑆩𑇀𑆩𑆷𑆞𑆩𑆶𑆨𑆪𑆠𑆾𑇁𑆱𑇀𑆡𑆴 𑆩𑆣𑇀𑆪𑆼 𑆨(𑆬)𑆓𑇀𑆤𑆁 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑆴𑆮𑆾𑆤𑇀𑆤𑆠𑆁 𑆑𑆫𑇀𑆑𑆛𑆑𑆩𑇀, 𑆃𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆮𑆢𑆶𑆢𑇀𑆓𑆠𑆩𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆑𑆁, 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆯𑆧𑇀𑆢𑆮𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑆮𑆓𑆖𑇀𑆗𑆼𑆠𑇀, 𑆥𑆴𑆖𑇀𑆖𑆴𑆠𑆁 𑆥𑆸𑆡𑆶𑆠𑆳𑆁 𑆓𑆠𑆩𑆤𑆬𑇀𑆥𑆯𑆾𑆦𑆁 , 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆫𑆱𑇀𑆡𑆴 𑆲𑆵𑆤𑆾𑆢𑇀𑆓𑆠𑆩𑆱𑇀𑆡𑆴𑆖𑇀𑆗𑆬𑆴𑆠𑆁, 𑆮𑆼𑆬𑇀𑆬𑆠𑆼 𑆥𑇀𑆫𑆑𑆩𑇀𑆥𑆩𑆳𑆤𑆁 𑆑𑆳𑆟𑇀𑆝𑆨𑆓𑇀𑆤𑆩𑇀, 𑆃𑆱𑇀𑆡𑇀𑆪𑆮𑆪𑆮𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆣𑇀𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆩𑆘𑇀𑆘𑆳𑆤𑆩𑆶𑆤𑇀𑆤𑆲𑇀𑆪𑆠𑆵𑆠𑆴 𑆩𑆘𑇀𑆘𑆳𑆤𑆶𑆓𑆠𑆩𑇀, 𑆃𑆱𑇀𑆡𑆴 𑆤𑆴𑆂𑆯𑆼𑆰𑆠𑆯𑇀𑆗𑆴𑆤𑇀𑆤𑆩𑆠𑆴𑆥𑆳𑆠𑆴𑆠𑆩𑇀, 𑆄𑆨𑆶𑆓𑇀𑆤𑆩𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆡𑆴 𑆮𑆑𑇀𑆫𑆩𑇀, 𑆃𑆤𑇀𑆪𑆠𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆁 𑆗𑆴𑆤𑇀𑆤𑆁, 𑆥𑆳𑆛𑆴𑆠𑆩𑆟𑆶𑆧𑆲𑆶𑆮𑆴𑆢𑆳𑆫𑆴𑆠𑆁 𑆮𑆼𑆢𑆤𑆳𑆮𑆖𑇀𑆖, 𑆯𑆷𑆑𑆥𑆷𑆫𑇀𑆟𑆩𑆴𑆮𑆳𑆣𑇀𑆩𑆳𑆠𑆁 𑆮𑆴𑆥𑆶𑆬𑆁 𑆮𑆴𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆁 𑆱𑇀𑆦𑆶𑆛𑆴𑆠𑆩𑆴𑆠𑆴 𑇆𑇑𑇐𑇆
𑆠𑆼𑆰𑆶 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆳𑆠𑆴𑆥𑆳𑆠𑆴𑆠𑆩𑆘𑇀𑆘𑆳𑆤𑆶𑆓𑆠𑆳𑆤𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆴, 𑆑𑆸𑆯𑆮𑆸𑆢𑇀𑆣𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆑𑆶𑆰𑇀𑆜𑆴𑆯𑇀𑆮𑆳𑆱𑆴𑆤𑆳𑆁 𑆱𑆤𑇀𑆣𑇀𑆪𑆶𑆥𑆓𑆠𑆁 𑆖𑆼𑆠𑆴 𑇆𑇑𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆨𑆴𑆤𑇀𑆤𑆁 𑆑𑆥𑆳𑆬𑆁 𑆑𑆛𑇀𑆪𑆳𑆁 𑆠𑆶 𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆑𑇀𑆠𑆁 𑆠𑆡𑆳 𑆖𑇀𑆪𑆶𑆠𑆩𑇀 𑇅 𑆘𑆔𑆤𑆁 𑆥𑇀𑆫𑆠𑆴 𑆥𑆴𑆰𑇀𑆛𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑆠𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆂 𑇆𑇑𑇒𑇆
𑆃𑆱𑆁𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆑𑆥𑆳𑆬𑆁 𑆠𑆶 𑆬𑆬𑆳𑆛𑆼 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆖 𑆪𑆠𑇀 𑇅 𑆨𑆓𑇀𑆤𑆁 𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆼 𑆯𑆕𑇀𑆒𑆼 𑆥𑆸𑆰𑇀𑆜𑆼 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇓𑇆
𑆄𑆢𑆴𑆠𑆾 𑆪𑆖𑇀𑆖 𑆢𑆶𑆫𑇀𑆘𑆳𑆠𑆩𑆱𑇀𑆡𑆴 𑆱𑆤𑇀𑆣𑆴𑆫𑆡𑆳𑆥𑆴 𑆮𑆳 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆪𑆩𑆴𑆠𑆩𑆥𑇀𑆪𑆱𑇀𑆡𑆴 𑆢𑆶𑆫𑇀𑆤𑇀𑆪𑆳𑆱𑆳𑆢𑇀𑆢𑆶𑆫𑇀𑆤𑆴𑆧𑆤𑇀𑆣𑆤𑆳𑆠𑇀 𑇆𑇑𑇔𑇆
𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆳𑆢𑇀𑆮𑆳𑇁𑆥𑆴 𑆪𑆢𑇀𑆓𑆖𑇀𑆗𑆼𑆢𑇀𑆮𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆠𑆖𑇀𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇅𑇑𑇕𑇅 𑆩𑆣𑇀𑆪𑆱𑇀𑆪 𑆮𑆪𑆱𑆾𑇁𑆮𑆱𑇀𑆡𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆾 𑆪𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆡𑆴𑆫𑆾 𑆨𑆮𑆼𑆘𑇀𑆘𑆤𑇀𑆠𑆶𑆫𑆶𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆾 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇅𑇑𑇖𑇅 𑆠𑆫𑆶𑆟𑆳𑆱𑇀𑆡𑆵𑆤𑆴 𑆤𑆩𑇀𑆪𑆤𑇀𑆠𑆼 𑆨𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆤𑆬𑆑𑆳𑆤𑆴 𑆠𑆶 𑇆𑇑𑇖𑇆
𑆑𑆥𑆳𑆬𑆳𑆤𑆴 𑆮𑆴𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑇀𑆦𑆶𑆛𑆤𑇀𑆠𑆴 𑆫𑆶𑆖𑆑𑆳𑆤𑆴 𑆖 𑇆𑇑𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆂 𑆥𑆚𑇀𑆖𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆱𑆥𑇀𑆠𑆱𑇀𑆮𑆳𑆪𑆠𑆤𑆼𑆰𑆶 𑇅 𑆠𑆠𑇀𑆫𑆳𑆪𑆠𑆤𑆳𑆤𑆴- 𑆏𑆰𑇀𑆜𑆿, 𑆢𑆤𑇀𑆠𑆩𑆷𑆬𑆳𑆤𑆴, 𑆢𑆤𑇀𑆠𑆳𑆂, 𑆘𑆴𑆲𑇀𑆮𑆳, 𑆠𑆳𑆬𑆶, 𑆑𑆟𑇀𑆜𑆂, 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫𑆳𑆰𑇀𑆛𑆳𑆮𑆾𑆰𑇀𑆜𑆪𑆾𑆂, 𑆥𑆚𑇀𑆖𑆢𑆯 𑆢𑆤𑇀𑆠𑆩𑆷𑆬𑆼𑆰𑆶, 𑆃𑆰𑇀𑆛𑆿 𑆢𑆤𑇀𑆠𑆼𑆰𑆶, 𑆥𑆚𑇀𑆖 𑆘𑆴𑆲𑇀𑆮𑆳𑆪𑆳𑆁, 𑆤𑆮 𑆠𑆳𑆬𑆶𑆤𑆴, 𑆱𑆥𑇀𑆠𑆢𑆯 𑆑𑆟𑇀𑆜𑆼, 𑆠𑇀𑆫𑆪𑆂 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆳𑆪𑆠𑆤𑆼𑆰𑆶 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆿𑆰𑇀𑆜𑆥𑇀𑆫𑆑𑆾𑆥𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑆨𑆴𑆔𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑇆𑇔𑇆
𑆑𑆫𑇀𑆑𑆯𑆿 𑆥𑆫𑆶𑆰𑆿 𑆱𑇀𑆠𑆧𑇀𑆣𑆿 𑆑𑆸𑆰𑇀𑆟𑆿 𑆠𑆵𑆮𑇀𑆫𑆫𑆶𑆓𑆤𑇀𑆮𑆴𑆠𑆿 𑇅 𑆢𑆳𑆬𑇀𑆪𑆼𑆠𑆼 𑆥𑆫𑆴𑆥𑆳𑆛𑇀𑆪𑆼𑆠𑆼 𑆲𑇀𑆪𑆾𑆰𑇀𑆜𑆿 𑆩𑆳𑆫𑆶𑆠𑆑𑆾𑆥𑆠𑆂 𑇆𑇕𑇆
𑆄𑆖𑆴𑆠𑆿 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆱𑇀𑆠𑆶 𑆱𑆫𑇀𑆰𑆥𑆳𑆑𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆨𑆸𑆯𑆩𑇀 𑇅 𑆱𑆢𑆳𑆲𑆥𑆳𑆑𑆱𑆁𑆱𑇀𑆫𑆳𑆮𑆿 𑆤𑆵𑆬𑆿 𑆥𑆵𑆠𑆿 𑆖 𑆥𑆴𑆠𑇀𑆠𑆠𑆂 𑇆𑇖𑇆
𑆱𑆮𑆫𑇀𑆟𑆳𑆨𑆴𑆱𑇀𑆠𑆶 𑆖𑆵𑆪𑆼𑆠𑆼 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆫𑆮𑆼𑆢𑆤𑆿 𑇅 𑆑𑆟𑇀𑆝𑆷𑆩𑆤𑇀𑆠𑆿 𑆑𑆦𑆳𑆖𑇀𑆗𑆷𑆤𑆿 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆿 𑆯𑆵𑆠𑆬𑆿 𑆓𑆶𑆫𑆷 𑇆𑇗𑇆

𑆏𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑆫𑆳 𑆨𑆷𑆩𑆴𑆫𑇀𑆲𑆴𑆩𑆮𑆳𑆚𑇀 𑆯𑆽𑆬𑆱𑆠𑇀𑆠𑆩𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆦𑆬𑆳𑆤𑆴 𑆠𑆘𑇀𑆘𑆳𑆤𑆴 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀𑆑𑆳𑆬𑆘𑆳𑆤𑆴 𑆠𑆶𑇆𑇓𑇘𑇆
𑆄𑆥𑆷𑆫𑇀𑆟𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆑𑆳𑆬𑆼 𑆑𑆳𑆬𑆼 𑆪𑆡𑆳𑆮𑆴𑆣𑆴𑇅 𑆄𑆢𑆴𑆠𑇀𑆪𑆥𑆮𑆤𑆖𑇀𑆗𑆳𑆪𑆳𑆱𑆬𑆴𑆬𑆥𑇀𑆫𑆵𑆟𑆴𑆠𑆳𑆤𑆴 𑆖𑇆𑇓𑇙𑇆
𑆪𑆳𑆤𑇀𑆪𑆘𑆓𑇀𑆣𑆳𑆤𑇀𑆪𑆥𑆷𑆠𑆵𑆤𑆴 𑆤𑆴𑆫𑇀𑆮𑇀𑆫𑆟𑆳𑆤𑇀𑆪𑆓𑆢𑆳𑆤𑆴 𑆖𑇅 𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆦𑆬𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆩 𑆖𑆾𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇔𑇐𑇆
𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆨𑆳𑆓𑆳𑆤𑇀 𑆢𑆯𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳𑆤𑇀𑇅 𑆲𑆫𑆵𑆠𑆑𑆵𑆱𑆲𑆱𑇀𑆫𑆁 𑆖 𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆳𑆩𑆬𑆑𑆁 𑆤𑆮𑆩𑇀𑇆𑇔𑇑𑇆
𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆁 𑆧𑆸𑆲𑆠𑆵𑆁 𑆥𑆸𑆯𑇀𑆤𑆴𑆥𑆫𑇀𑆟𑆵𑆁 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑆩𑇀𑇅 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑇀𑆪𑆁 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆥𑆚𑇀𑆖𑆩𑆁 𑆓𑆟𑆩𑇀𑇆𑇔𑇒𑇆
𑆧𑆴𑆬𑇀𑆮𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆁 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆩𑆡 𑆥𑆳𑆛𑆬𑆳𑆩𑇀𑇅 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆁 𑆯𑆷𑆫𑇀𑆥𑆥𑆫𑇀𑆟𑇀𑆪𑆿 𑆧𑆬𑆳𑆩𑆼𑆫𑆟𑇀𑆝𑆩𑆼𑆮 𑆖𑇆𑇔𑇓𑇆
𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆩𑆼𑆢𑆳𑆁 𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆁 𑆱𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑇀𑇅 𑆯𑆫𑆼𑆑𑇀𑆰𑆶𑆢𑆫𑇀𑆨𑆑𑆳𑆯𑆳𑆤𑆳𑆁 𑆯𑆳𑆬𑆵𑆤𑆳𑆁 𑆩𑆷𑆬𑆩𑆼𑆮 𑆖𑇆𑇔𑇔𑇆
𑆅𑆠𑇀𑆪𑆼𑆰𑆳𑆁 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑆶𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇅 𑆨𑆳𑆓𑆳𑆤𑇀 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆁𑆱𑇀𑆠𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆱𑆳𑆣𑇀𑆪𑆁 𑆢𑆯𑆓𑆶𑆟𑆼𑇁𑆩𑇀𑆨𑆱𑆴𑇆𑇔𑇕𑇆
𑆢𑆯𑆨𑆳𑆓𑆳𑆮𑆯𑆼𑆰𑆁 𑆠𑆶 𑆥𑆷𑆠𑆁 𑆠𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆢𑇀𑆫𑆱𑆩𑇀𑇅 𑆲𑆫𑆵𑆠𑆑𑆵𑆯𑇀𑆖 𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆳𑆩𑆬𑆑𑆳𑆤𑆴 𑆖𑇆𑇔𑇖𑇆
𑆠𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆤𑆱𑇀𑆡𑆵𑆤𑆴 𑆦𑆬𑆳𑆤𑇀𑆪𑆳𑆥𑆾𑆡𑇀𑆪 𑆑𑆷𑆫𑇀𑆖𑆤𑆽𑆂𑇅 𑆮𑆴𑆤𑆵𑆪 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆵𑆩𑆳𑆤𑆴 𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇔𑇗𑇆
𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆂 𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑇀𑆪𑆳𑆂 𑆥𑇀𑆬𑆮𑆱𑇀𑆪 𑆖𑇅 𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆱𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆖𑆤𑇀𑆢𑆤𑆳𑆓𑆶𑆫𑆶𑆟𑆾𑆱𑇀𑆠𑆡𑆳𑇆𑇔𑇘𑇆
𑆩𑆣𑆶𑆑𑆱𑇀𑆪 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆪𑆳 𑆮𑆖𑆳𑆪𑆳𑆂 𑆑𑆤𑆑𑆱𑇀𑆪 𑆖𑇅 𑆨𑆳𑆓𑆳𑆁𑆯𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑆬𑆳𑆤𑇀 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆽𑆬𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆖𑆱𑇀𑆠𑆡𑆳𑇆𑇔𑇙𑇆
𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆱𑆲𑆱𑇀𑆫𑆁 𑆖 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆠𑆶𑆬𑆪𑆳𑇁𑆣𑆴𑆑𑆩𑇀𑇅 𑆠𑆽𑆬𑆱𑇀𑆪 𑆢𑇀𑆮𑇀𑆪𑆳𑆞𑆑𑆁 𑆠𑆠𑇀𑆫 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆵𑆟𑆴 𑆖 𑆱𑆫𑇀𑆥𑆴𑆰𑆂𑇆𑇕𑇐𑇆
𑆱𑆳𑆣𑇀𑆪𑆩𑆿𑆢𑆶𑆩𑇀𑆧𑆫𑆼 𑆥𑆳𑆠𑇀𑆫𑆼 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆩𑆸𑆢𑆶𑆤𑆳𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆬𑆼𑆲𑇀𑆪𑆩𑆢𑆓𑇀𑆣𑆁 𑆖 𑆯𑆵𑆠𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆱𑆁𑆱𑆸𑆘𑆼𑆠𑇀𑇆𑇕𑇑𑇆
𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆱𑇀𑆤𑆼𑆲𑆳𑆫𑇀𑆣𑆁 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆼𑇅 𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆁 𑆠𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆳𑆬𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇕𑇒𑇆
𑆪𑆳 𑆤𑆾𑆥𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆢𑆳𑆲𑆳𑆫𑆩𑆼𑆑𑆁 𑆩𑆳𑆠𑇀𑆫𑆳 𑆘𑆫𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑇅 𑆰𑆰𑇀𑆛𑆴𑆑𑆂 𑆥𑆪𑆱𑆳 𑆖𑆳𑆠𑇀𑆫 𑆘𑆵𑆫𑇀𑆟𑆼 𑆨𑆾𑆘𑆤𑆩𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇕𑇓𑇆
𑆮𑆽𑆒𑆳𑆤𑆱𑆳 𑆮𑆳𑆬𑆒𑆴𑆬𑇀𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑆖𑆳𑆤𑇀𑆪𑆼 𑆠𑆥𑆾𑆣𑆤𑆳𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆩𑆴𑆢𑆁 𑆥𑇀𑆫𑆳𑆯𑇀𑆪 𑆧𑆨𑆷𑆮𑆶𑆫𑆩𑆴𑆠𑆳𑆪𑆶𑆰𑆂𑇆𑇕𑇔𑇆
𑆩𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆘𑆵𑆫𑇀𑆟𑆁 𑆮𑆥𑆶𑆯𑇀𑆖𑆳𑆓𑇀𑆫𑇀𑆪𑆩𑆮𑆳𑆥𑆶𑆱𑇀𑆠𑆫𑆶𑆟𑆁 𑆮𑆪𑆂𑇅 𑆮𑆵𑆠𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆑𑇀𑆬𑆩𑆯𑇀𑆮𑆳𑆱𑆳 𑆤𑆴𑆫𑆳𑆠𑆕𑇀𑆑𑆳𑆂 𑆱𑆩𑆳𑆲𑆴𑆠𑆳𑆂𑇆𑇕𑇕𑇆
𑆩𑆼𑆣𑆳𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆬𑆾𑆥𑆼𑆠𑆳𑆯𑇀𑆖𑆴𑆫𑆫𑆳𑆠𑇀𑆫𑆁 𑆠𑆥𑆾𑆣𑆤𑆳𑆂𑇅 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆁 𑆠𑆥𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆁 𑆖𑆼𑆫𑆶𑆯𑇀𑆖𑆳𑆠𑇀𑆪𑆤𑇀𑆠𑆤𑆴𑆰𑇀𑆜𑆪𑆳𑇆𑇕𑇖𑇆
𑆫𑆱𑆳𑆪𑆤𑆩𑆴𑆢𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆩𑆳𑆪𑆶𑆰𑇀𑆑𑆳𑆩𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆪𑆯𑇀𑆖𑆳𑆓𑇀𑆫𑇀𑆪𑆁 𑆑𑆳𑆩𑆳𑆁𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆤𑇀 𑆱𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇕𑇗𑇆
(𑆅𑆠𑆴 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆳𑆤𑆳𑆩𑆳𑆩𑆬𑆑𑆳𑆤𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆁 𑆥𑆴𑆰𑇀𑆛𑆱𑇀𑆮𑆼𑆢𑆤𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑆪𑆱 𑆈𑆰𑇀𑆩𑆟𑆳 𑆱𑆶𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆤𑆳𑆠𑆥𑆯𑆶𑆰𑇀𑆑𑆩𑆤𑆱𑇀𑆡𑆴 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇅 𑆠𑆢𑆳𑆩𑆬𑆑𑆱𑆲𑆱𑇀𑆫𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆁 𑆱𑇀𑆡𑆴𑆫𑆳𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆤𑆳𑆓𑆧𑆬𑆳𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑆵𑆯𑆠𑆳𑆮𑆫𑆵𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆖𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑇀𑆮𑆪𑆕𑇀𑆓𑆶𑆥𑇀𑆠𑆳𑆩𑆸𑆠𑆳- 𑆖𑆤𑇀𑆢𑆤𑆳𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆑𑆩𑆣𑆷𑆑𑆥𑆶𑆰𑇀𑆥𑆾𑆠𑇀𑆥𑆬𑆥𑆢𑇀𑆩𑆩𑆳𑆬𑆠𑆵𑆪𑆶𑆮𑆠𑆵𑆪𑆷𑆡𑆴𑆑𑆳𑆖𑆷𑆫𑇀𑆟𑆳𑆰𑇀𑆛𑆨𑆳𑆓𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆳𑆓𑆧𑆬𑆳𑆱𑆲𑆱𑇀𑆫𑆥𑆬𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆩𑆤𑆳𑆠𑆥𑆯𑆶𑆰𑇀𑆑𑆁 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆴𑆠𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆮𑆳 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆓𑆶𑆝𑆳𑆑𑆸𑆠𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆨𑆱𑇀𑆩𑆫𑆳𑆯𑆼𑆫𑆣𑆂 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆤𑇀𑆠𑆫𑇀𑆨𑆷𑆩𑆼𑆂 𑆥𑆑𑇀𑆰𑆁 𑆑𑆸𑆠𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆳𑆤𑆩𑆡𑆫𑇀𑆮𑆮𑆼𑆢𑆮𑆴𑆢𑆳, 𑆥𑆑𑇀𑆰𑆳𑆠𑇀𑆪𑆪𑆼 𑆖𑆾𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆑𑆤𑆑𑆫𑆘𑆠𑆠𑆳𑆩𑇀𑆫𑆥𑇀𑆫𑆮𑆳𑆬𑆑𑆳𑆬𑆳𑆪𑆱𑆖𑆷𑆫𑇀𑆟𑆳𑆰𑇀𑆛𑆨𑆳𑆓𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆩𑆫𑇀𑆣𑆑𑆫𑇀𑆰𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆾𑇁𑆓𑇀𑆤𑆴𑆧𑆬𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆰𑆰𑇀𑆛𑆴𑆑𑆁 𑆥𑆪𑆱𑆳 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆩𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆾 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑇀 𑆓𑆶𑆟𑆳𑆤𑇀 𑆱𑆩𑆯𑇀𑆤𑆶𑆠 𑆅𑆠𑆴𑇆𑇕𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆅𑆢𑆁 𑆫𑆱𑆳𑆪𑆤𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆁 𑆩𑆲𑆫𑇀𑆰𑆴𑆓𑆟𑆱𑆼𑆮𑆴𑆠𑆩𑇀𑇅 𑆨𑆮𑆠𑇀𑆪𑆫𑆾𑆓𑆾 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆾 𑆩𑆲𑆳𑆧𑆬𑆂𑇆𑇕𑇙𑇆
𑆑𑆳𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆯𑇀𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆢𑆴𑆠𑇀𑆪𑆱𑆩𑆢𑇀𑆪𑆶𑆠𑆴𑆂𑇅 𑆯𑇀𑆫𑆶𑆠𑆁 𑆣𑆳𑆫𑆪𑆠𑆼 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆳𑆫𑇀𑆰𑆁 𑆖𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇖𑇐𑇆
𑆣𑆫𑆟𑆵𑆣𑆫𑆱𑆳𑆫𑆯𑇀𑆖 𑆮𑆳𑆪𑆶𑆤𑆳 𑆱𑆩𑆮𑆴𑆑𑇀𑆫𑆩𑆂𑇅 𑆱 𑆨𑆮𑆠𑇀𑆪𑆮𑆴𑆰𑆁 𑆖𑆳𑆱𑇀𑆪 𑆓𑆳𑆠𑇀𑆫𑆼 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆮𑆴𑆰𑆩𑇀𑇆𑇖𑇑𑇆
(𑆅𑆠𑆴 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆧𑆴𑆬𑇀𑆮𑆾𑇁𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆂 𑆯𑇀𑆪𑆾𑆤𑆳𑆑𑆂 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆂 𑆥𑆳𑆛𑆬𑆴𑆫𑇀𑆧𑆬𑆳𑇅 𑆥𑆫𑇀𑆟𑇀𑆪𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆩𑇀𑇆𑇖𑇒𑇆
𑆯𑆸𑆕𑇀𑆓𑆵 𑆠𑆳𑆩𑆬𑆑𑆵 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳 𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆥𑆶𑆰𑇀𑆑𑆫𑆳𑆓𑆶𑆫𑆶𑇅 𑆃𑆨𑆪𑆳 𑆖𑆳𑆩𑆸𑆠𑆳 𑆉𑆢𑇀𑆣𑆴𑆫𑇀𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆯𑆛𑆵𑇆𑇖𑇓𑇆
𑆩𑆶𑆱𑇀𑆠𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳 𑆩𑆼𑆢𑆳 𑆱𑆽𑆬𑆳 𑆖𑆤𑇀𑆢𑆤𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀𑇅 𑆮𑆴𑆢𑆳𑆫𑆵 𑆮𑆸𑆰𑆩𑆷𑆬𑆳𑆤𑆴 𑆑𑆳𑆑𑆾𑆬𑆵 𑆑𑆳𑆑𑆤𑆳𑆱𑆴𑆑𑆳𑇆𑇖𑇔𑇆
𑆍𑆰𑆳𑆁 𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆚𑇀𑆗𑆠𑆳𑆤𑇀𑆪𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆖𑇅 𑆥𑆚𑇀𑆖 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇆𑇖𑇕𑇆
𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆓𑆠𑆫𑆱𑆳𑆤𑇀𑆪𑆼𑆠𑆳𑆤𑇀𑆪𑆿𑆰𑆣𑆳𑆤𑇀𑆪𑆡 𑆠𑆁 𑆫𑆱𑆩𑇀𑇅 𑆠𑆖𑇀𑆖𑆳𑆩𑆬𑆑𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆤𑆴𑆰𑇀𑆑𑆶𑆬𑆁 𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆂𑇆𑇖𑇖𑇆
𑆥𑆬𑆢𑇀𑆮𑆳𑆢𑆯𑆑𑆼 𑆨𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆖𑆳𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆨𑆴𑆰𑆑𑇀𑇅 𑆩𑆠𑇀𑆱𑇀𑆪𑆟𑇀𑆝𑆴𑆑𑆳𑆪𑆳𑆂 𑆥𑆷𑆠𑆳𑆪𑆳 𑆬𑆼𑆲𑆮𑆠𑇀𑆱𑆳𑆣𑆶 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑇆𑇖𑇗𑇆
𑆰𑆛𑇀𑆥𑆬𑆁 𑆩𑆣𑆶𑆤𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆱𑆴𑆢𑇀𑆣𑆯𑆵𑆠𑆼 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆖𑆠𑆶𑆰𑇀𑆥𑆬𑆁 𑆠𑆶𑆓𑆳𑆑𑇀𑆰𑆵𑆫𑇀𑆪𑆳𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆢𑇀𑆮𑆴𑆥𑆬𑆁 𑆠𑆡𑆳𑇆𑇖𑇘𑇆
𑆥𑆬𑆩𑆼𑆑𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆖 𑆠𑇀𑆮𑆓𑆼𑆬𑆳𑆥𑆠𑇀𑆫𑆑𑆼𑆯𑆫𑆳𑆠𑇀𑇅 𑆅𑆠𑇀𑆪𑆪𑆁 𑆖𑇀𑆪𑆮𑆤𑆥𑇀𑆫𑆳𑆯𑆂 𑆥𑆫𑆩𑆶𑆑𑇀𑆠𑆾 𑆫𑆱𑆳𑆪𑆤𑆂𑇆𑇖𑇙𑇆
𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆲𑆫𑆯𑇀𑆖𑆽𑆮 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇅 𑆑𑇀𑆰𑆵𑆟𑆑𑇀𑆰𑆠𑆳𑆤𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆖𑆳𑆕𑇀𑆓𑆮𑆫𑇀𑆣𑆤𑆂𑇆𑇗𑇐𑇆
𑆱𑇀𑆮𑆫𑆑𑇀𑆰𑆪𑆩𑆶𑆫𑆾𑆫𑆾𑆓𑆁 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑇀𑇅 𑆥𑆴𑆥𑆳𑆱𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆡𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆥𑆑𑆫𑇀𑆰𑆠𑆴𑇆𑇗𑇑𑇆
𑆃𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆪𑆾𑆥𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆤𑇀𑆤 𑆨𑆾𑆘𑆤𑆩𑇀𑇅 𑆃𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆖𑇀𑆖𑇀𑆪𑆮𑆤𑆂 𑆱𑆶𑆮𑆸𑆢𑇀𑆣𑆾𑇁𑆨𑆷𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆪𑆶𑆮𑆳𑇆𑇗𑇒𑇆
𑆩𑆼𑆣𑆳𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆁 𑆑𑆳𑆤𑇀𑆠𑆴𑆩𑆤𑆳𑆩𑆪𑆠𑇀𑆮𑆩𑆳𑆪𑆶𑆂𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆁 𑆧𑆬𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆁 𑆥𑆫𑆩𑆓𑇀𑆤𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆮𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆥𑆮𑆤𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪𑆩𑇀𑇆𑇗𑇓𑇆
𑆫𑆱𑆳𑆪𑆤𑆱𑇀𑆪𑆳𑆱𑇀𑆪 𑆤𑆫𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆬𑇀𑆬𑆨𑆼𑆠 𑆘𑆵𑆫𑇀𑆟𑆾𑇁𑆥𑆴 𑆑𑆶𑆛𑆵𑆥𑇀𑆫𑆮𑆼𑆯𑆳𑆠𑇀𑇅 𑆘𑆫𑆳𑆑𑆸𑆠𑆁 𑆫𑆷𑆥𑆩𑆥𑆳𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆁 𑆧𑆴𑆨𑆫𑇀𑆠𑆴 𑆫𑆷𑆥𑆁 𑆤𑆮𑆪𑆿𑆮𑆤𑆱𑇀𑆪𑇆𑇗𑇔𑇆
(𑆅𑆠𑆴 𑆖𑇀𑆪𑆮𑆤𑆥𑇀𑆫𑆳𑆯𑆂)𑇅 𑆃𑆡𑆳𑆩𑆬𑆑𑆲𑆫𑆵𑆠𑆑𑆵𑆤𑆳𑆩𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆤𑆳𑆁 𑆲𑆫𑆵𑆠𑆑𑆵𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆤𑆳𑆩𑆳𑆩𑆬𑆑𑆲𑆫𑆵𑆠𑆑𑆵𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆤𑆳𑆁 𑆮𑆳 𑆥𑆬𑆳𑆯𑆠𑇀𑆮𑆓𑆮𑆤𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆩𑆸𑆢𑆳𑇁𑆮𑆬𑆴𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑆶𑆑𑆷𑆬𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆤𑆳𑆩𑆑𑆶𑆬𑆑𑆳𑆤𑆳𑆁 𑆥𑆬𑆱𑆲𑆱𑇀𑆫𑆩𑆶𑆬𑆷𑆒𑆬𑆼 𑆱𑆩𑇀𑆥𑆾𑆡𑇀𑆪 𑆢𑆣𑆴𑆔𑆸𑆠𑆩𑆣𑆶𑆥𑆬𑆬𑆠𑆽𑆬𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆨𑆑𑇀𑆰𑆪𑆼𑆢𑆤𑆤𑇀𑆤𑆨𑆶𑆓𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳; 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆼 𑆪𑆮𑆳𑆓𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑇀 , 𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆁 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆽𑆯𑇀𑆖, 𑆃𑆪𑆁 𑆖 𑆫𑆱𑆳𑆪𑆤𑆥𑇀𑆫𑆪𑆾𑆓𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆾 𑆢𑇀𑆮𑆴𑆱𑇀𑆠𑆳𑆮𑆢𑆓𑇀𑆤𑆴𑆧𑆬𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 , 𑆥𑇀𑆫𑆠𑆴𑆨𑆾𑆘𑆤𑆁 𑆪𑆷𑆰𑆼𑆟 𑆥𑆪𑆱𑆳 𑆮𑆳 𑆰𑆰𑇀𑆛𑆴𑆑𑆂 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆂, 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆪𑆡𑆳𑆱𑆶𑆒𑆮𑆴𑆲𑆳𑆫𑆂 𑆑𑆳𑆩𑆨𑆑𑇀𑆰𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆤𑆼𑆤 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟𑆫𑇀𑆰𑆪𑆂 𑆥𑆶𑆤𑆫𑇀𑆪𑆶𑆮𑆠𑇀𑆮𑆩𑆮𑆳𑆥𑆶𑆫𑇀𑆧𑆨𑆷𑆮𑆶𑆯𑇀𑆖𑆳𑆤𑆼𑆑𑆮𑆫𑇀𑆰𑆯𑆠𑆘𑆵𑆮𑆴𑆤𑆾 𑆤𑆴𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆥𑆫𑆁 𑆯𑆫𑆵𑆫𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆱𑆩𑆶𑆢𑆴𑆠𑆳𑆯𑇀𑆖𑆼𑆫𑆶𑆯𑇀𑆖𑆳𑆠𑇀𑆪𑆤𑇀𑆠𑆤𑆴𑆰𑇀𑆜𑆪𑆳 𑆠𑆥𑆂𑇆𑇗𑇕𑇆
(𑆅𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆩𑆬𑆑𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆲𑆫𑆵𑆠𑆑𑇀𑆪𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆥𑆚𑇀𑆖𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆼 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆣𑆶𑆑𑆩𑆣𑆷𑆑𑆑𑆳𑆑𑆾𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆑𑇀𑆰𑆵𑆫𑆯𑆶𑆑𑇀𑆬𑆳𑆑𑆬𑇀𑆑𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆢𑆳𑆫𑆵𑆱𑇀𑆮𑆫𑆱𑆼𑆤 𑆑𑇀𑆰𑆵𑆫𑆳𑆰𑇀𑆛𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆖 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆑𑆶𑆩𑇀𑆨𑆁 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆾𑇁𑆓𑇀𑆤𑆴𑆧𑆬𑆱𑆩𑆳𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆳𑆤𑆶𑆥𑆳𑆤𑆩𑆯𑇀𑆤𑆚𑇀𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆳𑆥𑆳𑆨𑆴𑆖𑆳𑆫𑆮𑇀𑆪𑆥𑆓𑆠𑆨𑆪𑆂 𑆯𑆫𑆵𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆶𑆢𑇀𑆣𑆴𑆧𑆬𑆩𑆠𑆶𑆬𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆳𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆱𑆫𑇀𑆮𑆳𑆫𑆩𑇀𑆨𑆂 𑆥𑆫𑆩𑆳𑆪𑆶𑆫𑆤𑆮𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑇆𑇗𑇖𑇆
(𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆩𑆾 𑆲𑆫𑆵𑆠𑆑𑆵𑆪𑆾𑆓𑆂)𑇅 𑆲𑆫𑆵𑆠𑆑𑇀𑆪𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆫𑆳𑆧𑆬𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆩𑆸𑆠𑆮𑆬𑇀𑆬𑆵𑆮𑆴𑆯𑇀𑆮𑆨𑆼𑆰𑆘𑆩𑆣𑆶𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆳𑆨𑇀𑆪𑆳𑆩𑆥𑆴 𑆖 𑆱𑆤𑇀𑆤𑆵𑆪𑆳𑆩𑆬𑆑𑆱𑇀𑆮𑆫𑆱𑆯𑆠𑆥𑆫𑆴𑆥𑆵𑆠𑆩𑆳𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆩𑆪𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆳𑆟𑆴𑆠𑆬𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆯𑇀𑆪 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆳𑆪𑆁 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆼𑆟 𑆥𑆪𑆱𑆳 𑆮𑆳 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆁 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆤𑇀𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆰𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑆱𑇀𑆪 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴, 𑆯𑇀𑆫𑆶𑆠𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼, 𑆱𑆫𑇀𑆮𑆳𑆩𑆪𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴, 𑆮𑆴𑆰𑆩𑆮𑆴𑆰𑆁 𑆨𑆮𑆠𑆴 𑆓𑆳𑆠𑇀𑆫𑆼, 𑆓𑆳𑆠𑇀𑆫𑆩𑆯𑇀𑆩𑆮𑆠𑇀 𑆱𑇀𑆡𑆴𑆫𑆵𑆨𑆮𑆠𑆴, 𑆃𑆣𑆸𑆰𑇀𑆪𑆾 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆨𑆮𑆠𑆴𑇆𑇗𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳𑇁𑆩𑆫𑆳𑆟𑆳𑆩𑆩𑆸𑆠𑆁 𑆪𑆡𑆳 𑆨𑆾𑆓𑆮𑆠𑆳𑆁 𑆱𑆶𑆣𑆳𑇅 𑆠𑆡𑆳𑇁𑆨𑆮𑆤𑇀𑆩𑆲𑆫𑇀𑆰𑆵𑆟𑆳𑆁 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆴𑆂 𑆥𑆶𑆫𑆳𑇆𑇗𑇘𑇆
𑆤 𑆘𑆫𑆳𑆁 𑆤 𑆖 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆤𑆳𑆠𑆶𑆫𑇀𑆪𑆁 𑆤𑆴𑆣𑆤𑆁 𑆤 𑆖𑇅 𑆘𑆓𑇀𑆩𑆶𑆫𑇀𑆮𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆫𑆱𑆳𑆪𑆤𑆥𑆫𑆳𑆂 𑆥𑆶𑆫𑆳𑇆𑇗𑇙𑇆
𑆤 𑆑𑆼𑆮𑆬𑆁 𑆢𑆵𑆫𑇀𑆔𑆩𑆴𑆲𑆳𑆪𑆶𑆫𑆯𑇀𑆤𑆶𑆠𑆼 𑆫𑆱𑆳𑆪𑆤𑆁 𑆪𑆾 𑆮𑆴𑆣𑆴𑆮𑆤𑇀𑆤𑆴𑆰𑆼𑆮𑆠𑆼𑇅 𑆓𑆠𑆴𑆁 𑆱 𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆤𑆴𑆰𑆼𑆮𑆴𑆠𑆳𑆁 𑆯𑆶𑆨𑆳𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼 𑆧𑇀𑆫𑆲𑇀𑆩 𑆠𑆡𑆼𑆠𑆴 𑆖𑆳𑆑𑇀𑆰𑆪𑆩𑇀 𑇆𑇘𑇐𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆃𑆨𑆪𑆳𑆩𑆬𑆑𑆵𑆪𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆰𑆝𑇀𑆪𑆾𑆓𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆩𑆳𑆪𑆶𑆫𑇀𑆪𑆽𑆫𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇘𑇑𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆥𑆳𑆢𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆳𑆂 𑆯𑆶𑆯𑇀𑆫𑆷𑆰𑆣𑇀𑆮𑆩𑆴𑆢𑆩𑆶𑆖𑇀𑆪𑆩𑆳𑆤𑆩𑆩𑆸𑆠𑆩𑆴𑆮𑆳𑆥𑆫𑆩𑆢𑆴𑆠𑆴𑆱𑆶𑆠𑆲𑆴𑆠𑆑𑆫𑆩𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆳𑆢𑇀𑆨𑆶𑆠𑆥𑇀𑆫𑆨𑆳𑆮𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆑𑆫𑆁 𑆮𑆪𑆱𑆂 𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆤𑆴𑆢𑇀𑆫𑆳𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆳𑆬𑆱𑇀𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆥𑆲𑆫𑆩𑆤𑆴𑆬𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆱𑆳𑆩𑇀𑆪𑆑𑆫𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆩𑆧𑆢𑇀𑆣𑆩𑆳𑆁𑆱𑆲𑆫𑆩𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆁 𑆥𑇀𑆫𑆨𑆳𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆾𑆠𑇀𑆠𑆩𑆑𑆫𑆁 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆳𑆤𑆩𑇀𑇅 𑆃𑆤𑆼𑆤 𑆖𑇀𑆪𑆮𑆤𑆳𑆢𑆪𑆾 𑆩𑆲𑆫𑇀𑆰𑆪𑆂 𑆥𑆶𑆤𑆫𑇀𑆪𑆶𑆮𑆠𑇀𑆮𑆩𑆳𑆥𑆶𑆫𑇀𑆤𑆳𑆫𑆵𑆟𑆳𑆁 𑆖𑆼𑆰𑇀𑆛𑆠𑆩𑆳 𑆧𑆨𑆷𑆮𑆶𑆂, 𑆱𑇀𑆡𑆴𑆫𑆱𑆩𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆳𑆂, 𑆱𑆶𑆱𑆁𑆲𑆠𑆱𑇀𑆡𑆴𑆫𑆯𑆫𑆵𑆫𑆳𑆂, 𑆱𑆶𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆧𑆬𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆂, 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆳𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆳𑆂, 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳𑆯𑇀𑆖𑇅 𑆱𑆫𑇀𑆮𑆼 𑆯𑆫𑆵𑆫𑆢𑆾𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆢𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆯𑆶𑆰𑇀𑆑𑆯𑆳𑆑𑆩𑆳𑆁𑆱𑆠𑆴𑆬𑆥𑆬𑆬𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆨𑆾𑆘𑆴𑆤𑆳𑆁 𑆮𑆴𑆫𑆷𑆞𑆤𑆮𑆯𑆷𑆑𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆫𑆷𑆑𑇀𑆰𑆑𑇀𑆰𑆳𑆫𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆨𑆾𑆘𑆴𑆤𑆳𑆁 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆓𑆶𑆫𑆶𑆥𑆷𑆠𑆴𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆨𑆾𑆘𑆴𑆤𑆳𑆁 𑆮𑆴𑆰𑆩𑆳𑆣𑇀𑆪𑆯𑆤𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑆳𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑇀𑆠𑇀𑆫𑆵𑆩𑆢𑇀𑆪𑆤𑆴𑆠𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑆴𑆰𑆩𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆴𑆠𑆯𑆫𑆵𑆫𑆳𑆟𑆳𑆁 𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆬𑆾𑆨𑆩𑆾𑆲𑆳𑆪𑆳𑆱𑆧𑆲𑆶𑆬𑆳𑆤𑆳𑆩𑇀; 𑆃𑆠𑆾𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆲𑆴 𑆯𑆴𑆡𑆴𑆬𑆵𑆨𑆮𑆤𑇀𑆠𑆴 𑆩𑆳𑆁𑆱𑆳𑆤𑆴, 𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆤𑇀𑆣𑆪𑆂, 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑆫𑆑𑇀𑆠𑆁, 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆠𑆼 𑆖𑆳𑆤𑆬𑇀𑆥𑆁 𑆩𑆼𑆢𑆂, 𑆤 𑆱𑆤𑇀𑆣𑆵𑆪𑆠𑆼𑇁𑆱𑇀𑆡𑆴𑆰𑆶 𑆩𑆘𑇀𑆘𑆳, 𑆯𑆶𑆑𑇀𑆫𑆁 𑆤 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼, 𑆑𑇀𑆰𑆪𑆩𑆶𑆥𑆽𑆠𑇀𑆪𑆾𑆘𑆂; 𑆱 𑆍𑆮𑆩𑇀𑆨𑆷𑆠𑆾 𑆓𑇀𑆬𑆳𑆪𑆠𑆴, 𑆱𑆵𑆢𑆠𑆴, 𑆤𑆴𑆢𑇀𑆫𑆳𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆬𑆱𑇀𑆪𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆾 𑆤𑆴𑆫𑆶𑆠𑇀𑆱𑆳𑆲𑆂 𑆯𑇀𑆮𑆱𑆴𑆠𑆴, 𑆃𑆱𑆩𑆫𑇀𑆡𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆯𑆳𑆫𑆵𑆫𑆩𑆳𑆤𑆱𑆵𑆤𑆳𑆁, 𑆤𑆰𑇀𑆛𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆶𑆢𑇀𑆣𑆴𑆖𑇀𑆗𑆳𑆪𑆾 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆷𑆠𑆾 𑆤 𑆱𑆫𑇀𑆮𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑆮𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆂 𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆲𑆴𑆠𑆳𑆤𑆥𑆳𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆳𑆤𑇀 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆵𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪 𑆇𑆮𑆳𑆖-𑇆𑇓𑇆
𑆄𑆩𑆬𑆑𑆳𑆤𑆳𑆁 𑆱𑆶𑆨𑆷𑆩𑆴𑆘𑆳𑆤𑆳𑆁 𑆑𑆳𑆬𑆘𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆲𑆠𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆳𑆤𑆳𑆩𑆳𑆥𑆷𑆫𑇀𑆟𑆫𑆱𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆫𑆱𑆼𑆤 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆑𑆬𑇀𑆑𑆥𑆳𑆢𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆱𑆳𑆣𑆪𑆼𑆢𑆳𑆞𑆑𑆩𑇀, 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆮𑆴𑆢𑆳𑆫𑆵𑆱𑇀𑆮𑆫𑆱𑆼𑆤 𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆑𑆬𑇀𑆑𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤, 𑆃𑆠𑆂 𑆥𑆫𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑆤 𑆥𑆪𑆱𑆳 𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆑𑆰𑆳𑆪𑆼𑆟 𑆯𑆠𑆳𑆮𑆫𑆵𑆑𑆬𑇀𑆑𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆼𑆤; 𑆃𑆤𑆼𑆤 𑆑𑇀𑆫𑆩𑆼𑆟𑆽𑆑𑆽𑆑𑆁 𑆯𑆠𑆥𑆳𑆑𑆁 𑆱𑆲𑆱𑇀𑆫𑆥𑆳𑆑𑆁 𑆮𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑆿𑆮𑆫𑇀𑆟𑆼 𑆫𑆳𑆘𑆠𑆼 𑆩𑆳𑆫𑇀𑆠𑆴𑆑𑆼 𑆮𑆳 𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀; 𑆠𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆪𑆡𑆳𑆓𑇀𑆤𑆴 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀𑇅 𑆃𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆮𑆪𑆾𑇁𑆘𑆫𑆁 𑆠𑆴𑆰𑇀𑆜𑆠𑆴, 𑆯𑇀𑆫𑆶𑆠𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼, 𑆱𑆫𑇀𑆮𑆳𑆩𑆪𑆳𑆂 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴, 𑆃𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆓𑆠𑆴𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶, 𑆃𑆥𑆠𑇀𑆪𑆮𑆳𑆤𑇀 𑆨𑆮𑆠𑆵𑆠𑆴𑇆𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆧𑆸𑆲𑆖𑇀𑆗𑆫𑆵𑆫𑆁 𑆓𑆴𑆫𑆴𑆱𑆳𑆫𑆱𑆳𑆫𑆁 𑆱𑇀𑆡𑆴𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆖𑆳𑆠𑆴𑆧𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆖𑇅 𑆃𑆣𑆸𑆰𑇀𑆪𑆩𑆤𑇀𑆪𑆽𑆫𑆠𑆴𑆑𑆳𑆤𑇀𑆠𑆫𑆷𑆥𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆴𑆥𑆷𑆘𑆳𑆱𑆶𑆒𑆖𑆴𑆠𑇀𑆠𑆨𑆳𑆑𑇀 𑆖𑇆𑇕𑇆
𑆧𑆬𑆁 𑆩𑆲𑆢𑇀𑆮𑆫𑇀𑆟𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑆓𑇀𑆫𑇀𑆪𑆳 𑆱𑇀𑆮𑆫𑆾 𑆔𑆤𑆿𑆔𑆱𑇀𑆠𑆤𑆴𑆠𑆳𑆤𑆶𑆑𑆳𑆫𑆵𑇅 𑆨𑆮𑆠𑇀𑆪𑆥𑆠𑇀𑆪𑆁 𑆮𑆴𑆥𑆶𑆬𑆁 𑆱𑇀𑆡𑆴𑆫𑆁 𑆖 𑆱𑆩𑆯𑇀𑆤𑆠𑆾 𑆪𑆾𑆓𑆩𑆴𑆩𑆁 𑆤𑆫𑆱𑇀𑆪𑇆𑇖𑇆
(𑆅𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆔𑆸𑆠𑆩𑇀)𑇅 𑆄𑆩𑆬𑆑𑆱𑆲𑆱𑇀𑆫𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆲𑆱𑇀𑆫𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆥𑆬𑆳𑆯𑆠𑆫𑆶𑆟𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆾𑆠𑇀𑆠𑆫𑆁 𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀, 𑆠𑆢𑆤𑆶𑆓𑆠𑆑𑇀𑆰𑆳𑆫𑆾𑆢𑆑𑆩𑆤𑆳𑆠𑆥𑆯𑆶𑆰𑇀𑆑𑆩𑆤𑆱𑇀𑆡𑆴 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆱𑆤𑇀𑆤𑆵𑆪 𑆯𑆫𑇀𑆑𑆫𑆳𑆖𑆷𑆫𑇀𑆟𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆁 𑆰𑆟𑇀𑆩𑆳𑆱𑆳𑆤𑇀 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆤𑇀𑆠𑆫𑇀𑆨𑆷𑆩𑆼𑆂𑇅 𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆓𑇀𑆤𑆴𑆧𑆬𑆱𑆩𑆳𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆒𑆳𑆢𑆼𑆠𑇀, 𑆥𑆿𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆴𑆑𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆾 𑆤𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆴𑆑𑆂, 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆥𑆼𑆑𑇀𑆰𑆯𑇀𑆖𑆳𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆂𑇅 𑆃𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇗𑇆
(𑆅𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆳𑆮𑆬𑆼𑆲𑆂)𑇅 𑆄𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆳𑆞𑆑𑆩𑆼𑆑𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆳𑆠𑇀𑆫𑆩𑆳𑆩𑆬𑆑𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆁 𑆩𑆣𑆶𑆔𑆸𑆠𑆳𑆞𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆑𑆵𑆑𑆸𑆠𑆩𑆰𑇀𑆛𑆨𑆳𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆖𑆷𑆫𑇀𑆟𑆖𑆠𑆶𑆫𑇀𑆨𑆳𑆓𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆴 𑆨𑆱𑇀𑆩𑆫𑆳𑆯𑆿 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀; 𑆠𑆢𑇀𑆮𑆫𑇀𑆰𑆳𑆤𑇀𑆠𑆼 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆥𑆡𑇀𑆪𑆳𑆯𑆵 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀; 𑆃𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆩𑆳𑆪𑆶𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇘𑇆
(𑆅𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆩𑇀)𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆩𑆳𑆞𑆑𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆤𑆳𑆩𑆣𑇀𑆪𑆫𑇀𑆣𑆳𑆞𑆑𑆁 𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆪𑆳𑆂 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆩𑆣𑇀𑆮𑆳𑆞𑆑𑆽𑆂 𑆰𑆝𑇀𑆨𑆴𑆫𑆼𑆑𑆵𑆑𑆸𑆠𑆁 𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆴 𑆨𑆱𑇀𑆩𑆫𑆳𑆯𑆳𑆮𑆴𑆠𑆴 𑆱𑆫𑇀𑆮𑆁 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟 𑆪𑆳𑆮𑆢𑆳𑆯𑆵𑆂𑇆𑇙𑇆
(𑆅𑆠𑆴 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆮𑆬𑆼𑆲𑆂)𑇅 𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆳𑆤𑆳𑆩𑆳𑆩𑆬𑆑𑆳𑆤𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆩𑆳𑆫𑇀𑆢𑇀𑆫𑆥𑆬𑆳𑆯𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆱𑆥𑆴𑆣𑆳𑆤𑆳𑆪𑆳𑆁 𑆧𑆳𑆰𑇀𑆥𑆩𑆤𑆶𑆢𑇀𑆮𑆩𑆤𑇀𑆠𑇀𑆪𑆳𑆩𑆳𑆫𑆟𑇀𑆪𑆓𑆾𑆩𑆪𑆳𑆓𑇀𑆤𑆴𑆨𑆴𑆫𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆠𑆳𑆤𑆴 𑆱𑆶𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆯𑆵𑆠𑆳𑆤𑇀𑆪𑆶𑆢𑇀𑆣𑆸𑆠𑆑𑆶𑆬𑆑𑆳𑆤𑇀𑆪𑆳𑆥𑆾𑆡𑇀𑆪𑆳𑆞𑆑𑆼𑆤 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆼𑆤 𑆖 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆣𑇀𑆪𑆫𑇀𑆣𑆼𑆤 𑆖𑆳𑆞𑆑𑆼𑆤 𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆳 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆩𑆳𑆞𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆠𑆽𑆬𑆱𑇀𑆪 𑆩𑆣𑆶𑆤𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆯𑇀𑆖 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆯𑆶𑆖𑆿 𑆢𑆸𑆞𑆼 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆼𑆑𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆳𑆠𑇀𑆫𑆩𑇀, 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆂; 𑆃𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆩𑆳𑆪𑆶𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇐𑇆
(𑆅𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆳𑆮𑆬𑆼𑆲𑆾𑇁𑆥𑆫𑆂)𑇅 𑆣𑆤𑇀𑆮𑆤𑆴 𑆑𑆶𑆯𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆑𑆸𑆰𑇀𑆟𑆩𑆣𑆶𑆫𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆼 𑆱𑆶𑆮𑆫𑇀𑆟𑆮𑆫𑇀𑆟𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆼 𑆮𑆳 𑆮𑇀𑆪𑆥𑆓𑆠𑆮𑆴𑆰𑆯𑇀𑆮𑆳𑆥𑆢𑆥𑆮𑆤𑆱𑆬𑆴𑆬𑆳𑆓𑇀𑆤𑆴𑆢𑆾𑆰𑆼 𑆑𑆫𑇀𑆰𑆟𑆮𑆬𑇀𑆩𑆵𑆑𑆯𑇀𑆩𑆯𑆳𑆤𑆖𑆽𑆠𑇀𑆪𑆾𑆰𑆫𑆳𑆮𑆱𑆡𑆮𑆫𑇀𑆘𑆴𑆠𑆼 𑆢𑆼𑆯𑆼 𑆪𑆡𑆫𑇀𑆠𑆶𑆱𑆶𑆒𑆥𑆮𑆤𑆱𑆬𑆴𑆬𑆳𑆢𑆴𑆠𑇀𑆪𑆱𑆼𑆮𑆴𑆠𑆼 𑆘𑆳𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆥𑆲𑆠𑆳𑆤𑇀𑆪𑆤𑆣𑇀𑆪𑆳𑆫𑆷𑆞𑆳𑆤𑇀𑆪𑆧𑆳𑆬𑆳𑆤𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆣𑆴𑆓𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆯𑆵𑆫𑇀𑆟𑆥𑆶𑆫𑆳𑆟𑆥𑆫𑇀𑆟𑆳𑆤𑇀𑆪𑆱𑆚𑇀𑆘𑆳𑆠𑆳𑆤𑇀𑆪𑆥𑆫𑇀𑆟𑆳𑆤𑆴 𑆠𑆥𑆱𑆴 𑆠𑆥𑆱𑇀𑆪𑆼 𑆮𑆳 𑆩𑆳𑆱𑆼 𑆯𑆶𑆖𑆴𑆂 𑆥𑇀𑆫𑆪𑆠𑆂 𑆑𑆸𑆠𑆢𑆼𑆮𑆳𑆫𑇀𑆖𑆤𑆂 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆮𑆳𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆵𑆤𑇀 𑆖𑆬𑆼 𑆱𑆶𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆼 𑆤𑆳𑆓𑆧𑆬𑆳𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀, 𑆠𑆼𑆰𑆳𑆁 𑆱𑆶𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑆴𑆟𑇀𑆝𑆩𑆳𑆩𑇀𑆫𑆩𑆳𑆠𑇀𑆫𑆩𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑆳 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆥𑆪𑆱𑆳 𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀, 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆳𑆤𑆴 𑆮𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆪𑆱𑆳, 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆮𑆳 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀𑇅 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑆱𑇀𑆪 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇑𑇆
(𑆅𑆠𑆴 𑆤𑆳𑆓𑆧𑆬𑆳𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆖𑆤𑇀𑆢𑆤𑆳𑆓𑆶𑆫𑆶𑆣𑆮𑆠𑆴𑆤𑆴𑆯𑆒𑆢𑆴𑆫𑆯𑆴𑆁𑆯𑆥𑆳𑆱𑆤𑆱𑇀𑆮𑆫𑆱𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆤𑇀𑆠𑆳𑆯𑇀𑆖𑆿𑆰𑆣𑆪𑆾 𑆢𑆯 𑆤𑆳𑆓𑆧𑆬𑆪𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇅 𑆱𑇀𑆮𑆫𑆱𑆳𑆤𑆳𑆩𑆬𑆳𑆨𑆼 𑆠𑇀𑆮𑆪𑆁 𑆱𑇀𑆮𑆫𑆱𑆮𑆴𑆣𑆴𑆂- 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆩𑆳𑆞𑆑𑆩𑆶𑆢𑆑𑆱𑇀𑆪𑆳𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆱𑇀𑆡𑆴𑆠𑆁 𑆩𑆸𑆢𑆴𑆠𑆥𑆷𑆠𑆁 𑆱𑇀𑆮𑆫𑆱𑆮𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆩𑇀𑇆𑇑𑇒𑇆
𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑇀𑆪𑆤𑆶𑆥𑆲𑆠𑆳𑆤𑇀𑆪𑆤𑆳𑆩𑆪𑆳𑆤𑇀𑆪𑆳𑆥𑆷𑆫𑇀𑆟𑆫𑆱𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆥𑆑𑇀𑆮𑆘𑆳𑆩𑇀𑆧𑆮𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆤𑆴 𑆯𑆶𑆖𑆿 𑆯𑆶𑆑𑇀𑆫𑆼 𑆮𑆳 𑆩𑆳𑆱𑆼 𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪 𑆪𑆮𑆥𑆬𑇀𑆬𑆼 𑆩𑆳𑆰𑆥𑆬𑇀𑆬𑆼 𑆮𑆳 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀, 𑆠𑆳𑆤𑆴 𑆖𑆠𑆶𑆫𑇀𑆩𑆳𑆱𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆴 𑆱𑆲𑆱𑆴 𑆱𑆲𑆱𑇀𑆪𑆼 𑆮𑆳 𑆩𑆳𑆱𑆼 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆶𑆩𑆳𑆫𑆨𑆼𑆠 𑆯𑆵𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆣𑆶𑆫𑆾𑆥𑆱𑇀𑆑𑆸𑆠𑆯𑆫𑆵𑆫𑆂𑇅 𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑆯𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑇀𑆪𑆳𑆥𑆾𑆡𑇀𑆪𑆳𑆰𑇀𑆛𑆓𑆶𑆟𑆼𑆤𑆳𑆩𑇀𑆨𑆱𑆳 𑆱𑆳𑆣𑆶 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆠𑆼𑆰𑆳𑆁 𑆫𑆱𑆩𑆰𑇀𑆛𑆨𑆳𑆓𑆳𑆮𑆯𑆼𑆰𑆁 𑆥𑆷𑆠𑆁 𑆱𑆥𑆪𑆱𑇀𑆑𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆩𑆶𑆒𑆩𑆨𑇀𑆪𑆘𑇀𑆪𑇅 𑆠𑆳𑆤𑇀𑆪𑆼𑆑𑆽𑆑𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆥𑆑𑆫𑇀𑆰𑆼𑆟 𑆢𑆯𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑇀𑆪𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴, 𑆤𑆳𑆠𑆂 𑆥𑆫𑆩𑆶𑆠𑇀𑆑𑆫𑇀𑆰𑆂𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆱𑆲𑆱𑇀𑆫𑆥𑆫 𑆍𑆮 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑇀𑆫𑆪𑆾𑆓𑆂𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆥𑆪𑆱𑆳 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆯𑆤𑆩𑆶𑆥𑆖𑆳𑆫𑆂, 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆤𑇀𑆠𑆼 𑆖 𑆢𑇀𑆮𑆴𑆱𑇀𑆠𑆳𑆮𑆠𑇀 𑆥𑆪𑆱𑆽𑆮𑆾𑆥𑆖𑆳𑆫𑆂𑇅 𑆠𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇓𑇆
(𑆅𑆠𑆴 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆰𑆵𑆫𑆩𑇀)𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑆳𑆁 𑆘𑆫𑇀𑆘𑆫𑆵𑆑𑆸𑆠𑆳𑆤𑆳𑆁 𑆥𑆴𑆰𑇀𑆛𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆥𑆷𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆷𑆩𑆳𑆮𑆳𑆑𑆟𑇀𑆜𑆁 𑆤𑆴𑆒𑆳𑆠𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆴𑆠𑆱𑇀𑆪 𑆢𑆸𑆞𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆑𑆶𑆩𑇀𑆨𑆱𑇀𑆪𑆳𑆫𑆾𑆥𑇀𑆪𑆾𑆝𑆶𑆥𑆼𑆤𑆳𑆥𑆴𑆣𑆳𑆪 𑆑𑆸𑆰𑇀𑆟𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆳𑆮𑆬𑆴𑆥𑇀𑆠𑆁 𑆓𑆾𑆩𑆪𑆳𑆓𑇀𑆤𑆴𑆨𑆴𑆫𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀; 𑆠𑆼𑆰𑆳𑆁 𑆪𑆂 𑆱𑇀𑆮𑆫𑆱𑆂 𑆑𑆶𑆩𑇀𑆨𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆼𑆠, 𑆠𑆩𑆰𑇀𑆛𑆨𑆳𑆓𑆩𑆣𑆶𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆔𑆸𑆠𑆩𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆘𑆫𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆵𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇔𑇆
(𑆅𑆠𑆴 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑇀)𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆥𑆳𑆠𑇀𑆫𑆁 𑆱𑆥𑆪𑆱𑇀𑆑𑆁 𑆩𑆣𑆶𑆑𑆼𑆤 𑆑𑆬𑇀𑆑𑆼𑆤𑆳𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆯𑆠𑆥𑆳𑆑𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆴𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇕𑇆
(𑆅𑆠𑆴 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆩𑇀)𑇅 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆱𑆫𑇀𑆥𑆴𑆂 , 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆰𑆵𑆫𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁, 𑆓𑆶𑆝𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆪𑆷𑆰𑆂, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆥𑆬𑆬𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆱𑆑𑇀𑆠𑆮𑆂, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆬𑆮𑆟𑆁, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆫𑇀𑆥𑆟𑆩𑇀, 𑆅𑆠𑆴 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆨𑆮𑆠𑆴𑇆𑇑𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆥𑆳𑆑𑆵𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑆩𑆳𑆤𑆴 𑆖𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆩𑆸𑆠𑆑𑆬𑇀𑆥𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆪𑆡𑆳𑆮𑆴𑆣𑆴𑇆𑇑𑇗𑇆
𑆍𑆠𑆼 𑆢𑆯𑆮𑆴𑆣𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂𑇅 𑆫𑆾𑆓𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑇀𑆚𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆫𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇘𑇆
𑆑𑆦𑆘𑆾 𑆤 𑆱 𑆫𑆾𑆓𑆾𑇁𑆱𑇀𑆠𑆴 𑆤 𑆮𑆴𑆧𑆤𑇀𑆣𑆾𑇁𑆱𑇀𑆠𑆴 𑆑𑆯𑇀𑆖𑆤𑇅 𑆪𑆁 𑆤 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆁 𑆲𑆤𑇀𑆪𑆳𑆖𑇀𑆗𑆵𑆔𑇀𑆫𑆁 𑆩𑆼𑆣𑆳𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇆𑇑𑇙𑇆
(𑆅𑆠𑆴 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆴𑆂)𑇅 𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆳𑆂 𑆥𑆶𑆫𑆳 𑆘𑆵𑆫𑇀𑆟𑆳𑆯𑇀𑆖𑇀𑆪𑆮𑆤𑆳𑆢𑇀𑆪𑆳 𑆩𑆲𑆫𑇀𑆰𑆪𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆽𑆂 𑆯𑆴𑆮𑆽𑆫𑆼𑆠𑆽𑆫𑇀𑆧𑆨𑆷𑆮𑆶𑆫𑆩𑆴𑆠𑆳𑆪𑆶𑆰𑆂𑇆𑇒𑇐𑇆
𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆁 𑆠𑆥𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆩𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆣𑇀𑆪𑆳𑆤𑆩𑆼𑆮 𑆖𑇅 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆰𑆾 𑆪𑆡𑆳𑆑𑆳𑆩𑆁 𑆱𑆩𑇀𑆨𑆸𑆠𑇀𑆪 𑆠𑇀𑆫𑆴𑆢𑆴𑆮𑆁 𑆓𑆠𑆳𑆂𑇆𑇒𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆪𑆶𑆂𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆫𑇀𑆡𑆁 𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆽𑆂 𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆴𑆨𑆴𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆴𑆂 𑆱𑆼𑆮𑇀𑆪𑆾 𑆮𑆴𑆣𑆴𑆮𑆠𑇀𑆱𑆶𑆱𑆩𑆳𑆲𑆴𑆠𑆽𑆂𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁 𑆱𑆁𑆪𑆾𑆓𑆳𑆂 𑆱𑆴𑆢𑇀𑆣𑆳 𑆨𑆷𑆠𑆲𑆴𑆠𑆽𑆰𑆴𑆟𑆳𑇅 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆵𑆪𑆼 𑆱𑆥𑇀𑆠𑆠𑇀𑆫𑆴𑆁𑆯𑆤𑇀𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳 𑇆𑇒𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆫𑆥𑇀𑆫𑆖𑆴𑆠𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆥𑆳𑆢𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆑𑆫𑆥𑇀𑆫𑆖𑆴𑆠𑆳𑆤𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆳𑆤𑆳𑆩𑆳𑆩𑆬𑆑𑆳𑆤𑆳𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑆳𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆯𑆶𑆰𑇀𑆑𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆳𑆔𑆼 𑆦𑆳𑆬𑇀𑆓𑆶𑆤𑆼 𑆮𑆳 𑆩𑆳𑆱𑆼 𑆠𑇀𑆫𑆴𑆂𑆱𑆥𑇀𑆠𑆑𑆸𑆠𑇀𑆮𑆂 𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑆳𑆁 𑆥𑆶𑆤𑆂 𑆯𑆶𑆰𑇀𑆑𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆩𑆼𑆑𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀, 𑆃𑆡 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆤𑆳𑆁 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆳𑆤𑆳𑆁 𑆱𑇀𑆠𑆤𑇀𑆪𑆘𑆤𑆤𑆳𑆤𑆳𑆁 𑆯𑆶𑆑𑇀𑆫𑆘𑆤𑆤𑆳𑆤𑆳𑆁 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆳𑆁 𑆰𑆝𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆠𑆳𑆯𑇀𑆫𑆴𑆠𑆵𑆪𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆓𑆟𑆳𑆤𑆳𑆁 𑆖𑆤𑇀𑆢𑆤𑆳𑆓𑆶𑆫𑆶𑆣𑆮𑆠𑆴𑆤𑆴𑆯𑆒𑆢𑆴𑆫𑆯𑆴𑆁𑆯𑆥𑆳𑆱𑆤𑆱𑆳𑆫𑆳𑆟𑆳𑆁 𑆖𑆳𑆟𑆶𑆯𑆂 𑆑𑆸𑆠𑇀𑆠𑆳𑆤𑆳𑆩𑆨𑆪𑆳𑆧𑆴𑆨𑆵𑆠𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆖𑆳𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆖 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆩𑆼𑆑𑆁 𑆢𑆯𑆓𑆶𑆟𑆼𑆤𑆳𑆩𑇀𑆨𑆱𑆳 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆳𑆞𑆑𑆳𑆮𑆯𑆼𑆰𑆼 𑆫𑆱𑆼 𑆱𑆶𑆥𑆷𑆠𑆼 𑆠𑆳𑆤𑇀𑆪𑆳𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆓𑆾𑆩𑆪𑆳𑆓𑇀𑆤𑆴𑆨𑆴𑆫𑇀𑆮𑆁𑆯𑆮𑆴𑆢𑆬𑆯𑆫𑆠𑆼𑆘𑆤𑆳𑆓𑇀𑆤𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆪𑆳𑆮𑆢𑆥𑆤𑆪𑆳𑆢𑇀𑆫𑆱𑆱𑇀𑆪, 𑆠𑆩𑆤𑆶𑆥𑆢𑆓𑇀𑆣𑆩𑆶𑆥𑆲𑆸𑆠𑇀𑆪𑆳𑆪𑆱𑆵𑆰𑆶 𑆥𑆳𑆠𑇀𑆫𑆵𑆰𑇀𑆮𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆪 𑆯𑆾𑆰𑆪𑆼𑆠𑇀, 𑆱𑆶𑆯𑆶𑆰𑇀𑆑𑆁 𑆠𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆳𑆘𑆴𑆤𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆢𑆸𑆰𑆢𑆴 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆩𑆪𑆂𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆳𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆩𑆪𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆰𑇀𑆛𑆨𑆳𑆓𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆩𑆓𑇀𑆤𑆴𑆧𑆬𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆢𑆴𑆠𑆴𑇆𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆍𑆠𑆢𑇀𑆫𑆱𑆳𑆪𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆱𑆴𑆰𑇀𑆜𑆂 𑆑𑆯𑇀𑆪𑆥𑆾𑇁𑆕𑇀𑆓𑆴𑆫𑆳𑆂𑇅 𑆘𑆩𑆢𑆓𑇀𑆤𑆴𑆫𑇀𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆾 𑆨𑆸𑆓𑆶𑆫𑆤𑇀𑆪𑆼 𑆖 𑆠𑆢𑇀𑆮𑆴𑆣𑆳𑆂𑇆𑇔𑇆
𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪 𑆥𑇀𑆫𑆪𑆠𑆳 𑆩𑆶𑆑𑇀𑆠𑆳𑆂 𑆯𑇀𑆫𑆩𑆮𑇀𑆪𑆳𑆣𑆴𑆘𑆫𑆳𑆨𑆪𑆳𑆠𑇀𑇅 𑆪𑆳𑆮𑆢𑆽𑆖𑇀𑆗𑆁𑆱𑇀𑆠𑆥𑆱𑇀𑆠𑆼𑆥𑆶𑆱𑇀𑆠𑆠𑇀𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆤𑇀𑆩𑆲𑆳𑆧𑆬𑆳𑆂𑇆𑇕𑇆
𑆅𑆢𑆁 𑆫𑆱𑆳𑆪𑆤𑆁 𑆖𑆑𑇀𑆫𑆼 𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆮𑆳𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆴𑆑𑆩𑇀𑇅 𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆬𑆥𑇀𑆫𑆢𑆩𑇀𑇆𑇖𑇆
(𑆅𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆳𑆪𑆱𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆠𑆥𑆱𑆳 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆼𑆟 𑆣𑇀𑆪𑆳𑆤𑆼𑆤 𑆥𑇀𑆫𑆯𑆩𑆼𑆤 𑆖𑇅 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆑𑆳𑆬𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆖𑆳𑆪𑆶𑆰𑆳𑇆𑇗𑇆
𑆱𑇀𑆡𑆴𑆠𑆳 𑆩𑆲𑆫𑇀𑆰𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆁, 𑆤𑆲𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇅 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆑𑆳𑆫𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑆴𑆣𑇀𑆪𑆠𑇀𑆪𑆥𑇀𑆫𑆪𑆠𑆳𑆠𑇀𑆩𑆤𑆳𑆩𑇀𑇆𑇘𑇆
𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆁 𑆥𑆪𑆾𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆓𑆮𑆳𑆁 𑆩𑆣𑇀𑆪𑆼 𑆮𑆱𑆼𑆠𑇀 𑆱𑆢𑆳𑇅 𑆱𑆳𑆮𑆴𑆠𑇀𑆫𑆵𑆁 𑆩𑆤𑆱𑆳 𑆣𑇀𑆪𑆳𑆪𑆤𑇀 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆵 𑆪𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇆𑇙𑇆
𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆤𑇀𑆠𑆼 𑆥𑆿𑆰𑆵𑆁 𑆮𑆳 𑆩𑆳𑆔𑆵𑆁 𑆮𑆳 𑆦𑆳𑆬𑇀𑆓𑆶𑆤𑆵𑆁 𑆠𑆴𑆡𑆴𑆩𑇀𑇅 𑆠𑇀𑆫𑇀𑆪𑆲𑆾𑆥𑆮𑆳𑆱𑆵 𑆯𑆶𑆑𑇀𑆬𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆩𑆬𑆑𑆵𑆮𑆤𑆩𑇀𑇆𑇑𑇐𑇆
𑆧𑆸𑆲𑆠𑇀𑆦𑆬𑆳𑆞𑇀𑆪𑆩𑆳𑆫𑆶𑆲𑇀𑆪 𑆢𑇀𑆫𑆶𑆩𑆁 𑆯𑆳𑆒𑆳𑆓𑆠𑆁 𑆦𑆬𑆩𑇀𑇅 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆥𑆳𑆟𑆴𑆤𑆳 𑆠𑆴𑆰𑇀𑆜𑆼𑆘𑇀𑆘𑆥𑆤𑇀 𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆩𑆸𑆠𑆳𑆓𑆩𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆠𑆢𑆳 𑆲𑇀𑆪𑆮𑆯𑇀𑆪𑆩𑆩𑆸𑆠𑆁 𑆮𑆱𑆠𑇀𑆪𑆳𑆩𑆬𑆑𑆼 𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆑𑆬𑇀𑆥𑆳𑆤𑆴 𑆱𑇀𑆤𑆼𑆲𑆮𑆤𑇀𑆠𑆴 𑆩𑆸𑆢𑆷𑆤𑆴 𑆖𑇆𑇑𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆩𑆸𑆠𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀𑆠𑆳𑆤𑆴 𑆪𑆳𑆮𑆤𑇀𑆠𑆴 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇅 𑆘𑆵𑆮𑆼𑆢𑇀𑆮𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆠𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆓𑆠𑆪𑆿𑆮𑆤𑆂𑇆𑇑𑇓𑇆
𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆩𑆼𑆰𑆳𑆁 𑆓𑆠𑇀𑆮𑆳 𑆠𑆶 𑆨𑆮𑆠𑇀𑆪𑆩𑆫𑆱𑆤𑇀𑆤𑆴𑆨𑆂𑇅 𑆱𑇀𑆮𑆪𑆁 𑆖𑆳𑆱𑇀𑆪𑆾𑆥𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼 𑆯𑇀𑆫𑆵𑆫𑇀𑆮𑆼𑆢𑆳 𑆮𑆳𑆑𑇀 𑆖 𑆫𑆷𑆥𑆴𑆟𑆵𑇆𑇑𑇔𑇆
(𑆅𑆠𑆴 𑆑𑆼𑆮𑆬𑆳𑆩𑆬𑆑𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳 𑆫𑆱𑆼 𑆩𑆷𑆠𑇀𑆫𑆼 𑆓𑆮𑆳𑆁 𑆑𑇀𑆰𑆳𑆫𑆼 𑆖 𑆬𑆮𑆟𑆼𑇅 𑆑𑇀𑆫𑆩𑆼𑆟 𑆖𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆑𑇀𑆰𑆳𑆫𑆼 𑆑𑆴𑆁𑆯𑆶𑆑𑆑𑇀𑆰𑆳𑆫 𑆍𑆮 𑆖𑇆𑇑𑇕𑇆
𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆪𑆱𑆱𑇀𑆪 𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆮𑆲𑇀𑆤𑆴𑆮𑆫𑇀𑆟𑆳𑆤𑆴 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇅 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆢𑆵𑆫𑇀𑆔𑆳𑆟𑆴 𑆠𑆴𑆬𑆾𑆠𑇀𑆱𑆼𑆣𑆠𑆤𑆷𑆤𑆴 𑆖𑇆𑇑𑇖𑇆
𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆠𑆳𑆤𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆨𑆳𑆤𑆴 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆠𑆳𑆤𑆴 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆩𑆣𑆶𑆤𑆳 𑆫𑆱𑆼𑆤𑆳𑆩𑆬𑆑𑆱𑇀𑆪 𑆖𑇆𑇑𑇗𑇆
𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆬𑆼𑆲𑆮𑆠𑇀 𑆑𑆶𑆩𑇀𑆨𑆼 𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆴 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼𑇅 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆁 𑆤𑆴𑆣𑆼𑆪𑆳𑆤𑆴 𑆪𑆮𑆥𑆬𑇀𑆬𑆼 𑆠𑆡𑆽𑆮 𑆖𑇆𑇑𑇘𑇆
𑆢𑆢𑇀𑆪𑆳𑆢𑆳𑆬𑆾𑆝𑆤𑆁 𑆩𑆳𑆱𑆼 𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆳𑆬𑆾𑆝𑆪𑆤𑇀 𑆧𑆶𑆣𑆂𑇅 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆠𑇀𑆪𑆪𑆼 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆾 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇆𑇑𑇙𑇆
𑆥𑇀𑆫𑆳𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆧𑆬𑆳𑆥𑆼𑆑𑇀𑆰𑆵 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆨𑆾𑆘𑆤𑆩𑇀𑇅 𑆍𑆰 𑆍𑆮 𑆖 𑆬𑆿𑆲𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂𑇆𑇒𑇐𑇆
𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆽𑆫𑇀𑆤 𑆖𑆳𑆠𑆕𑇀𑆑𑆽𑆫𑇀𑆘𑆫𑆪𑆳 𑆤 𑆖 𑆩𑆸𑆠𑇀𑆪𑆶𑆤𑆳𑇅 𑆱 𑆣𑆸𑆰𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆓𑆘𑆥𑇀𑆫𑆳𑆟𑆂 𑆱𑆢𑆳 𑆖𑆳𑆠𑆴𑆧𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇆𑇒𑇑𑇆
𑆣𑆵𑆩𑆳𑆤𑇀 𑆪𑆯𑆱𑇀𑆮𑆵 𑆮𑆳𑆑𑇀𑆱𑆴𑆢𑇀𑆣𑆂 𑆯𑇀𑆫𑆶𑆠𑆣𑆳𑆫𑆵 𑆩𑆲𑆳𑆣𑆤𑆂 𑇅 𑆨𑆮𑆼𑆠𑇀 𑆱𑆩𑆳𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆾 𑆤𑆫𑆾 𑆬𑆿𑆲𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇒𑇒𑇆
𑆃𑆤𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆲𑆼𑆩𑇀𑆤𑆯𑇀𑆖 𑆫𑆘𑆠𑆱𑇀𑆪 𑆖𑇅 𑆄𑆪𑆶𑆂𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆑𑆸𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇒𑇓𑇆
(𑆅𑆠𑆴 𑆬𑆿𑆲𑆳𑆢𑆴𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆎𑆤𑇀𑆢𑇀𑆫𑆵 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆒𑇀𑆪𑆑𑆾 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵 𑆮𑆖𑆳 𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆾 𑆬𑆮𑆟𑆁 𑆲𑆼𑆩 𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵 𑆮𑆴𑆰𑆁 𑆔𑆸𑆠𑆩𑇀𑇆𑇒𑇔𑇆
𑆍𑆰𑆳𑆁 𑆠𑇀𑆫𑆴𑆪𑆮𑆑𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆤𑇀 𑆲𑆼𑆩𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆴𑆰𑆽𑆫𑇀𑆮𑆴𑆤𑆳𑇅 𑆢𑇀𑆮𑆿 𑆪𑆮𑆿 𑆠𑆠𑇀𑆫 𑆲𑆼𑆩𑇀𑆤𑆱𑇀𑆠𑆶 𑆠𑆴𑆬𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆰𑆱𑇀𑆪 𑆖𑇆𑇒𑇕𑇆
𑆱𑆫𑇀𑆥𑆴𑆰𑆯𑇀𑆖 𑆥𑆬𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆔𑆸𑆠𑆥𑇀𑆫𑆨𑆷𑆠𑆁 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖𑆳𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇒𑇖𑇆
𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆼𑆣𑆳𑆑𑆫𑆁 𑆥𑆫𑆩𑇀𑇅 𑆄𑆪𑆶𑆰𑇀𑆪𑆁 𑆥𑆿𑆰𑇀𑆛𑆴𑆑𑆁 𑆣𑆤𑇀𑆪𑆁 𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆩𑇀𑇆𑇒𑇗𑇆
𑆥𑆫𑆩𑆾𑆘𑆱𑇀𑆑𑆫𑆁 𑆖𑆽𑆠𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆩𑆽𑆤𑇀𑆢𑇀𑆫𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇅 𑆤𑆽𑆤𑆠𑇀 𑆥𑇀𑆫𑆱𑆲𑆠𑆼 𑆑𑆸𑆠𑇀𑆪𑆳 𑆤𑆳𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆫𑇀𑆤 𑆮𑆴𑆰𑆁 𑆤 𑆫𑆶𑆑𑇀𑇆𑇒𑇘𑇆
𑆯𑇀𑆮𑆴𑆠𑇀𑆫𑆁 𑆱𑆑𑆶𑆰𑇀𑆜𑆁 𑆘𑆜𑆫𑆳𑆟𑆴 𑆓𑆶𑆬𑇀𑆩𑆳𑆂 𑆥𑇀𑆬𑆵𑆲𑆳 𑆥𑆶𑆫𑆳𑆟𑆾 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆯𑇀𑆖𑇅 𑆩𑆼𑆣𑆳𑆱𑇀𑆩𑆸𑆠𑆴𑆘𑇀𑆚𑆳𑆤𑆲𑆫𑆳𑆯𑇀𑆖 𑆫𑆾𑆓𑆳𑆂 𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆤𑆼𑆤𑆳𑆠𑆴𑆧𑆬𑆳𑆯𑇀𑆖 𑆮𑆳𑆠𑆳𑆂𑇆𑇒𑇙𑇆
(𑆅𑆠𑇀𑆪𑆽𑆤𑇀𑆢𑇀𑆫𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆂 𑆱𑇀𑆮𑆫𑆱𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆂 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑇀𑆪 𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆫𑆱𑆾 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆱𑆩𑆷𑆬𑆥𑆶𑆰𑇀𑆥𑇀𑆪𑆳𑆂 𑆑𑆬𑇀𑆑𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆂 𑆒𑆬𑆶 𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑇀𑆪𑆳𑆂𑇆𑇓𑇐𑇆
𑆄𑆪𑆶𑆂𑆥𑇀𑆫𑆢𑆳𑆤𑇀𑆪𑆳𑆩𑆪𑆤𑆳𑆯𑆤𑆳𑆤𑆴 𑆧𑆬𑆳𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆣𑆤𑆳𑆤𑆴𑇅 𑆩𑆼𑆣𑇀𑆪𑆳𑆤𑆴 𑆖𑆽𑆠𑆳𑆤𑆴 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆴 𑆩𑆼𑆣𑇀𑆪𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆖 𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵𑇆𑇓𑇑𑇆
(𑆅𑆠𑆴 𑆩𑆼𑆣𑇀𑆪𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆴)𑇅 𑆥𑆚𑇀𑆖𑆳𑆰𑇀𑆛𑆿 𑆱𑆥𑇀𑆠 𑆢𑆯 𑆮𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆫𑇀𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆫𑆱𑆳𑆪𑆤𑆓𑆶𑆟𑆳𑆤𑇀𑆮𑆼𑆰𑆵 𑆱𑆩𑆳𑆩𑆼𑆑𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇓𑇒𑇆
𑆠𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆫𑆼 𑆨𑆾𑆘𑆤𑆱𑇀𑆪 𑆖𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆂 𑆑𑆴𑆁𑆯𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆨𑆳𑆮𑆴𑆠𑆳 𑆔𑆸𑆠𑆨𑆫𑇀𑆘𑆴𑆠𑆳𑆂𑇆𑇓𑇓𑇆
𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳 𑆩𑆣𑆶𑆱𑆩𑇀𑆩𑆴𑆯𑇀𑆫𑆳 𑆫𑆱𑆳𑆪𑆤𑆓𑆶𑆟𑆽𑆰𑆴𑆟𑆳𑇅 𑆘𑆼𑆠𑆶𑆁 𑆑𑆳𑆱𑆁 𑆑𑇀𑆰𑆪𑆁 𑆯𑆾𑆰𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆓𑆬𑆳𑆩𑆪𑆳𑆤𑇀𑇆𑇓𑇔𑇆
𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆁 𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆩𑇀𑇅 𑆮𑆽𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆥𑆵𑆤𑆱𑆁 𑆯𑆾𑆦𑆁 𑆓𑆶𑆬𑇀𑆩𑆁 𑆮𑆳𑆠𑆧𑆬𑆳𑆱𑆑𑆩𑇀𑇆𑇓𑇕𑇆
(𑆅𑆠𑆴 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆑𑇀𑆫𑆩𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆢𑆯𑆳𑆲𑆳𑆤𑆴 𑆢𑆯𑆥𑆽𑆥𑇀𑆥𑆬𑆴𑆑𑆁 𑆢𑆴𑆤𑆩𑇀𑇅 𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀 𑆥𑆪𑆱𑆳 𑆱𑆳𑆫𑇀𑆣𑆁 𑆠𑆡𑆽𑆮𑆳𑆥𑆤𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂𑇆𑇓𑇖𑇆
𑆘𑆵𑆫𑇀𑆟𑆼 𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆰𑆰𑇀𑆛𑆴𑆑𑆁 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆪𑆾𑆓𑆾𑇁𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇓𑇗𑇆
𑆥𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆳 𑆧𑆬𑆴𑆨𑆴𑆂 𑆱𑆼𑆮𑇀𑆪𑆳𑆂, 𑆯𑆸𑆠𑆳 𑆩𑆣𑇀𑆪𑆧𑆬𑆽𑆫𑇀𑆤𑆫𑆽𑆂𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆳 𑆲𑇀𑆫𑆱𑇀𑆮𑆧𑆬𑆽𑆫𑇀𑆪𑆾𑆘𑇀𑆪𑆳 𑆢𑆾𑆰𑆳𑆩𑆪𑆳𑆤𑇀 𑆥𑇀𑆫𑆠𑆴𑇆𑇓𑇘𑇆
𑆢𑆯𑆥𑆽𑆥𑇀𑆥𑆬𑆴𑆑𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆩𑆣𑇀𑆪𑆩𑆂 𑆰𑆛𑇀 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆾 𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆂 𑆱 𑆑𑆤𑆵𑆪𑆳𑆤𑇀 𑆱 𑆖𑆳𑆧𑆬𑆽𑆂𑇆𑇓𑇙𑇆
𑆧𑆸𑆲𑆟𑆁 𑆱𑇀𑆮𑆫𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆮𑆪𑆱𑆂 𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆩𑆼𑆣𑇀𑆪𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇔𑇐𑇆
(𑆅𑆠𑆴 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆫𑇀𑆣𑆩𑆳𑆤𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆘𑆫𑆟𑆳𑆤𑇀𑆠𑆼𑇁𑆨𑆪𑆳𑆩𑆼𑆑𑆳𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆨𑆶𑆑𑇀𑆠𑆳𑆢𑇀 𑆢𑇀𑆮𑆼 𑆧𑆴𑆨𑆵𑆠𑆑𑆼𑇅 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆠𑆶 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆖𑆠𑇀𑆮𑆳𑆫𑇀𑆪𑆳𑆩𑆬𑆑𑆳𑆤𑆴 𑆖𑇆𑇔𑇑𑇆
𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆤𑇀 𑆱𑆩𑆳𑆩𑆼𑆑𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇅 𑆘𑆵𑆮𑆼𑆢𑇀𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆥𑆷𑆫𑇀𑆟𑆩𑆘𑆫𑆾𑇁𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆼𑆮 𑆖𑇆𑇔𑇒𑇆
(𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆠𑇀𑆫𑆽𑆦𑆬𑆼𑆤𑆳𑆪𑆱𑆵𑆁 𑆥𑆳𑆠𑇀𑆫𑆵𑆁 𑆑𑆬𑇀𑆑𑆼𑆤𑆳𑆬𑆼𑆥𑆪𑆼𑆤𑇀𑆤𑆮𑆳𑆩𑇀𑇅 𑆠𑆩𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆴𑆑𑆁 𑆬𑆼𑆥𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆾𑆢𑆑𑆳𑆥𑇀𑆬𑆶𑆠𑆩𑇀𑇆𑇔𑇓𑇆
𑆥𑇀𑆫𑆨𑆷𑆠𑆱𑇀𑆤𑆼𑆲𑆩𑆯𑆤𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆃𑆘𑆫𑆾𑇁𑆫𑆶𑆑𑇀 𑆱𑆩𑆳𑆨𑇀𑆪𑆳𑆱𑆳𑆘𑇀𑆘𑆵𑆮𑆼𑆖𑇀𑆖𑆽𑆮 𑆱𑆩𑆳𑆂 𑆯𑆠𑆩𑇀𑇆𑇔𑇔𑇆
(𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆳𑆪𑆤𑆩𑆥𑆫𑆩𑇀)𑇅 𑆩𑆣𑆶𑆑𑆼𑆤 𑆠𑆶𑆓𑆳𑆑𑇀𑆰𑆵𑆫𑇀𑆪𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆱𑆴𑆠𑆪𑆳 𑆖𑆳𑆥𑆴 𑆪𑆶𑆑𑇀𑆠𑆳 𑆱𑆴𑆢𑇀𑆣𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀𑇆𑇔𑇕𑇆
(𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆳𑆪𑆤𑆩𑆥𑆫𑆩𑇀)𑇅 𑆱𑆫𑇀𑆮𑆬𑆿𑆲𑆽𑆂 𑆱𑆶𑆮𑆫𑇀𑆟𑆼𑆤 𑆮𑆖𑆪𑆳 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆨𑇀𑆪𑆳𑆁 𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆬𑆮𑆟𑆼𑆤 𑆖𑇆𑇔𑇖𑇆
𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟 𑆩𑆼𑆣𑆳𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆬𑆥𑇀𑆫𑆢𑆳𑇅 𑆨𑆮𑆠𑇀𑆪𑆳𑆪𑆶𑆂𑆥𑇀𑆫𑆢𑆳 𑆣𑆤𑇀𑆪𑆳 𑆘𑆫𑆳𑆫𑆾𑆓𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆵𑇆𑇔𑇗𑇆
(𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆳𑆪𑆤𑆩𑆥𑆫𑆩𑇀)𑇅 𑆃𑆤𑆩𑇀𑆬𑆁 𑆖 𑆑𑆰𑆳𑆪𑆁 𑆖 𑆑𑆛𑆶 𑆥𑆳𑆑𑆼 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑇅 𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆯𑆵𑆠𑆁 𑆣𑆳𑆠𑆶𑆨𑇀𑆪𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑇀𑆪𑆱𑇀𑆠𑆱𑇀𑆪 𑆱𑆩𑇀𑆨𑆮𑆂𑇆𑇔𑇘𑇆
𑆲𑆼𑆩𑇀𑆤𑆯𑇀𑆖 𑆫𑆘𑆠𑆳𑆠𑇀𑆠𑆳𑆩𑇀𑆫𑆳𑆢𑇀𑆮𑆫𑆳𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆳𑆪𑆱𑆳𑆢𑆥𑆴𑇅 𑆫𑆱𑆳𑆪𑆤𑆁 𑆠𑆢𑇀𑆮𑆴𑆣𑆴𑆨𑆴𑆱𑇀𑆠𑆢𑇀𑆮𑆸𑆰𑇀𑆪𑆁 𑆠𑆖𑇀𑆖 𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇔𑇙𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆔𑇀𑆤𑆽𑆯𑇀𑆖 𑆤𑆴𑆫𑇀𑆪𑆷𑆲𑆽𑆱𑇀𑆠𑆠𑇀 𑆱𑆶𑆨𑆳𑆮𑆴𑆠𑆩𑇀𑇅 𑆮𑆵𑆫𑇀𑆪𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆁 𑆥𑆫𑆁 𑆪𑆳𑆠𑆴 𑆱𑆫𑇀𑆮𑆽𑆫𑆼𑆑𑆽𑆑𑆯𑆾𑇁𑆥𑆴 𑆮𑆳𑇆𑇕𑇐𑇆
𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆾𑆢𑇀𑆣𑆸𑆠𑆩𑆥𑇀𑆪𑆼𑆤𑆠𑇀 𑆥𑆶𑆤𑆱𑇀𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑆼𑆢𑇀𑆫𑆱𑆼𑇅 𑆑𑆾𑆰𑇀𑆟𑆼 𑆱𑆥𑇀𑆠𑆳𑆲𑆩𑆼𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆠𑆱𑇀𑆪 𑆨𑆳𑆮𑆤𑆳𑇆𑇕𑇑𑇆
𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆬𑆾𑆲𑆽𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆽𑆂 𑆱𑆲𑇅 𑆠𑆠𑇀 𑆥𑆵𑆠𑆁 𑆥𑆪𑆱𑆳 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆂 𑆱𑆶𑆒𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇆𑇕𑇒𑇆
𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆢𑆼𑆲𑆢𑆳𑆫𑇀𑆞𑇀𑆪𑆑𑆫𑆁 𑆥𑆫𑆩𑇀𑇅 𑆩𑆼𑆣𑆳𑆱𑇀𑆩𑆸𑆠𑆴𑆑𑆫𑆁 𑆣𑆤𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆯𑆵 𑆠𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇕𑇓𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆱𑆥𑇀𑆠𑆱𑆥𑇀𑆠𑆳𑆲𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆯𑇀𑆖𑆽𑆑𑆯𑇀𑆖 𑆱𑆥𑇀𑆠𑆑𑆂𑇅 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆱𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆾 𑆩𑆣𑇀𑆪𑆾𑇁𑆮𑆫𑆱𑇀𑆠𑆡𑆳𑇆𑇕𑇔𑇆
𑆥𑆬𑆩𑆫𑇀𑆣𑆥𑆬𑆁 𑆑𑆫𑇀𑆰𑆾 𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑆱𑇀𑆪 𑆠𑇀𑆫𑆴𑆣𑆳 𑆩𑆠𑆳𑇅𑇕𑇕𑇅 𑆘𑆳𑆠𑆼𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆁 𑆱𑆮𑆴𑆣𑆴𑆁 𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆠𑆂 𑆥𑆫𑆩𑇀𑇆𑇕𑇕𑇆
𑆲𑆼𑆩𑆳𑆢𑇀𑆪𑆳𑆂 𑆱𑆷𑆫𑇀𑆪𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆳𑆂 𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑆴 𑆓𑆴𑆫𑆴𑆣𑆳𑆠𑆮𑆂𑇅 𑆘𑆠𑇀𑆮𑆳𑆨𑆁 𑆩𑆸𑆢𑆶 𑆩𑆸𑆠𑇀𑆱𑇀𑆤𑆳𑆖𑇀𑆗𑆁 𑆪𑆤𑇀𑆩𑆬𑆁 𑆠𑆖𑇀𑆗𑆴𑆬𑆳𑆘𑆠𑆶𑇆𑇕𑇖𑇆
𑆩𑆣𑆶𑆫𑆯𑇀𑆖 𑆱𑆠𑆴𑆑𑇀𑆠𑆯𑇀𑆖 𑆘𑆥𑆳𑆥𑆶𑆰𑇀𑆥𑆤𑆴𑆨𑆯𑇀𑆖 𑆪𑆂𑇅 𑆑𑆛𑆶𑆫𑇀𑆮𑆴𑆥𑆳𑆑𑆼 𑆯𑆵𑆠𑆯𑇀𑆖 𑆱 𑆱𑆶𑆮𑆫𑇀𑆟𑆱𑇀𑆪 𑆤𑆴𑆱𑇀𑆫𑆮𑆂𑇆𑇕𑇗𑇆
𑆫𑆷𑆥𑇀𑆪𑆱𑇀𑆪 𑆑𑆛𑆶𑆑𑆂 𑆯𑇀𑆮𑆼𑆠𑆂 𑆯𑆵𑆠𑆂 𑆱𑇀𑆮𑆳𑆢𑆶 𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼𑇅 𑆠𑆳𑆩𑇀𑆫𑆱𑇀𑆪 𑆧𑆫𑇀𑆲𑆴𑆑𑆟𑇀𑆜𑆳𑆨𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆾𑆰𑇀𑆟𑆂 𑆥𑆖𑇀𑆪𑆠𑆼 𑆑𑆛𑆶𑇆𑇕𑇘𑇆
𑆪𑆱𑇀𑆠𑆶 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆑𑆳𑆨𑆳𑆱𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆾 𑆬𑆮𑆟𑆳𑆤𑇀𑆮𑆴𑆠𑆂𑇅 𑆑𑆛𑆶𑆫𑇀𑆮𑆴𑆥𑆳𑆑𑆼 𑆯𑆵𑆠𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆂 𑆱 𑆖𑆳𑆪𑆱𑆂𑇆𑇕𑇙𑇆
𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆓𑆤𑇀𑆣𑆪𑆂 𑆱𑆫𑇀𑆮𑆼 𑆱𑆫𑇀𑆮𑆑𑆫𑇀𑆩𑆱𑆶 𑆪𑆿𑆓𑆴𑆑𑆳𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆰𑆶 𑆥𑆯𑇀𑆖𑆴𑆩𑆱𑇀𑆠𑆶 𑆮𑆴𑆯𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇖𑇐𑇆
𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆼 𑆑𑆦𑆼 𑆠𑇀𑆫𑆴𑆰𑆶𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆩𑆬𑆳 𑆲𑆼𑆩𑆳𑆢𑆴𑆣𑆳𑆠𑆶𑆘𑆳𑆂𑇆𑇖𑇑𑇆
𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆰𑆶 𑆮𑆴𑆢𑆳𑆲𑆵𑆤𑆴 𑆓𑆶𑆫𑆷𑆟𑆴 𑆖𑇅 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆁 𑆠𑆶 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆤𑇀 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇖𑇒𑇆
𑆠𑆼 𑆲𑇀𑆪𑆠𑇀𑆪𑆤𑇀𑆠𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆢𑆯𑇀𑆩𑆤𑆾 𑆨𑆼𑆢𑆤𑆳𑆂 𑆥𑆫𑆩𑇀𑇅 𑆬𑆾𑆑𑆼 𑆢𑆸𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆠𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆣𑇀𑆪𑆠𑆼𑇆𑇖𑇓𑇆
𑆥𑆪𑆳𑆁𑆱𑆴 𑆠𑆑𑇀𑆫𑆳𑆟𑆴 𑆫𑆱𑆳𑆂 𑆱𑆪𑆷𑆰𑆳𑆱𑇀𑆠𑆾𑆪𑆁 𑆱𑆩𑆷𑆠𑇀𑆫𑆳 𑆮𑆴𑆮𑆴𑆣𑆳𑆂 𑆑𑆰𑆳𑆪𑆳𑆂𑇅 𑆄𑆬𑆾𑆝𑆤𑆳𑆫𑇀𑆡𑆁 𑆓𑆴𑆫𑆴𑆘𑆱𑇀𑆪 𑆯𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆼 𑆠𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆩𑇀𑇆𑇖𑇔𑇆
𑆤 𑆱𑆾𑇁𑆱𑇀𑆠𑆴 𑆫𑆾𑆓𑆾 𑆨𑆶𑆮𑆴 𑆱𑆳𑆣𑇀𑆪𑆫𑆷𑆥𑆂 𑆯𑆴𑆬𑆳𑆲𑇀𑆮𑆪𑆁 𑆪𑆁 𑆤 𑆘𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆱𑆲𑇀𑆪𑇅 𑆠𑆠𑇀 𑆑𑆳𑆬𑆪𑆾𑆓𑆽𑆫𑇀𑆮𑆴𑆣𑆴𑆨𑆴𑆂 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪 𑆖𑆾𑆫𑇀𑆘𑆳𑆁 𑆮𑆴𑆥𑆶𑆬𑆳𑆁 𑆢𑆢𑆳𑆠𑆴𑇆𑇖𑇕𑇆
(𑆅𑆠𑆴 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆑𑆫𑆥𑇀𑆫𑆖𑆴𑆠𑆴𑆑𑆼 𑆥𑆳𑆢𑆼 𑆢𑆯 𑆰𑆛𑇀 𑆖 𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳𑇅 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆱𑆁𑆪𑆾𑆓𑆳𑆂 𑆱𑆩𑆶𑆢𑆳𑆲𑆸𑆠𑆳𑆂𑇆𑇖𑇖𑇆
𑆃𑆡𑆳𑆠 𑆄𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆥𑆳𑆢𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆉𑆰𑆪𑆂 𑆒𑆬𑆶 𑆑𑆢𑆳𑆖𑆴𑆖𑇀𑆗𑆳𑆬𑆵𑆤𑆳 𑆪𑆳𑆪𑆳𑆮𑆫𑆳𑆯𑇀𑆖 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆿𑆰𑆣𑇀𑆪𑆳𑆲𑆳𑆫𑆳𑆂 𑆱𑆤𑇀𑆠𑆂 𑆱𑆳𑆩𑇀𑆥𑆤𑇀𑆤𑆴𑆑𑆳 𑆩𑆤𑇀𑆢𑆖𑆼𑆰𑇀𑆛𑆳 𑆤𑆳𑆠𑆴𑆑𑆬𑇀𑆪𑆳𑆯𑇀𑆖 𑆥𑇀𑆫𑆳𑆪𑆼𑆟 𑆧𑆨𑆷𑆮𑆶𑆂𑇅 𑆠𑆼 𑆱𑆫𑇀𑆮𑆳𑆱𑆳𑆩𑆴𑆠𑆴𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆠𑆳𑆤𑆳𑆩𑆱𑆩𑆫𑇀𑆡𑆳𑆂 𑆱𑆤𑇀𑆠𑆾 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆮𑆳𑆱𑆑𑆸𑆠𑆩𑆳𑆠𑇀𑆩𑆢𑆾𑆰𑆁 𑆩𑆠𑇀𑆮𑆳 𑆥𑆷𑆫𑇀𑆮𑆤𑆴𑆮𑆳𑆱𑆩𑆥𑆓𑆠𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆢𑆾𑆰𑆁 𑆯𑆴𑆮𑆁 𑆥𑆶𑆟𑇀𑆪𑆩𑆶𑆢𑆳𑆫𑆁 𑆩𑆼𑆣𑇀𑆪𑆩𑆓𑆩𑇀𑆪𑆩𑆱𑆶𑆑𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆓𑆕𑇀𑆓𑆳𑆥𑇀𑆫𑆨𑆮𑆩𑆩𑆫𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆑𑆴𑆤𑇀𑆤𑆫𑆳𑆤𑆶𑆖𑆫𑆴𑆠𑆩𑆤𑆼𑆑𑆫𑆠𑇀𑆤𑆤𑆴𑆖𑆪𑆩𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆳𑆢𑇀𑆨𑆶𑆠𑆥𑇀𑆫𑆨𑆳𑆮𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑇀𑆰𑆴𑆯𑆴𑆢𑇀𑆣𑆖𑆳𑆫𑆟𑆳𑆤𑆶𑆖𑆫𑆴𑆠𑆁 𑆢𑆴𑆮𑇀𑆪𑆠𑆵𑆫𑇀𑆡𑆿𑆰𑆣𑆴𑆥𑇀𑆫𑆨𑆮𑆩𑆠𑆴𑆯𑆫𑆟𑇀𑆪𑆁 𑆲𑆴𑆩𑆮𑆤𑇀𑆠𑆩𑆩𑆫𑆳𑆣𑆴𑆥𑆠𑆴𑆓𑆶𑆥𑇀𑆠𑆁 𑆘𑆓𑇀𑆩𑆶𑆫𑇀𑆨𑆸𑆓𑇀𑆮𑆕𑇀𑆓𑆴𑆫𑆾𑇁𑆠𑇀𑆫𑆴𑆮𑆱𑆴𑆰𑇀𑆜𑆑𑆯𑇀𑆪𑆥𑆳𑆓𑆱𑇀𑆠𑇀𑆪𑆥𑆶𑆬𑆱𑇀𑆠𑇀𑆪𑆮𑆳𑆩𑆢𑆼𑆮𑆳𑆱𑆴𑆠𑆓𑆿𑆠𑆩𑆥𑇀𑆫𑆨𑆸𑆠𑆪𑆾 𑆩𑆲𑆫𑇀𑆰𑆪𑆂𑇆𑇓𑇆
𑆠𑆳𑆤𑆴𑆤𑇀𑆢𑇀𑆫𑆂 𑆱𑆲𑆱𑇀𑆫𑆢𑆸𑆓𑆩𑆫𑆓𑆶𑆫𑆶𑆫𑆧𑇀𑆫𑆮𑆵𑆠𑇀- 𑆱𑇀𑆮𑆳𑆓𑆠𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆮𑆴𑆢𑆳𑆁 𑆘𑇀𑆚𑆳𑆤𑆠𑆥𑆾𑆣𑆤𑆳𑆤𑆳𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑇀𑆰𑆵𑆟𑆳𑆩𑇀𑇅 𑆃𑆱𑇀𑆠𑆴 𑆤𑆤𑆶 𑆮𑆾 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑇀𑆮𑆁 𑆮𑆽𑆱𑇀𑆮𑆫𑇀𑆪𑆁 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆖 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆮𑆳𑆱𑆑𑆸𑆠𑆩𑆱𑆶𑆒𑆩𑆱𑆶𑆒𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆖; 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆾 𑆲𑆴 𑆮𑆳𑆱𑆾 𑆩𑆷𑆬𑆩𑆯𑆱𑇀𑆠𑆳𑆤𑆳𑆁, 𑆠𑆠𑇀 𑆑𑆸𑆠𑆂 𑆥𑆶𑆟𑇀𑆪𑆑𑆸𑆢𑇀𑆨𑆴𑆫𑆤𑆶𑆓𑇀𑆫𑆲𑆂 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁, 𑆱𑇀𑆮𑆯𑆫𑆵𑆫𑆩𑆮𑆼𑆑𑇀𑆰𑆴𑆠𑆶𑆁 𑆑𑆳𑆬𑆂 𑆑𑆳𑆬𑆯𑇀𑆖𑆳𑆪𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆾𑆥𑆢𑆼𑆯𑆱𑇀𑆪 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑇀𑆰𑆵𑆟𑆳𑆩𑇀; 𑆄𑆠𑇀𑆩𑆤𑆂 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆁 𑆖𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆩𑆯𑇀𑆮𑆴𑆤𑆿 𑆩𑆲𑇀𑆪𑆁 𑆥𑇀𑆫𑆳𑆪𑆖𑇀𑆗𑆠𑆳𑆁, 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆫𑆯𑇀𑆮𑆴𑆨𑇀𑆪𑆳𑆁, 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆪𑆼 𑆧𑇀𑆫𑆲𑇀𑆩𑆳, 𑆥𑇀𑆫𑆘𑆳𑆤𑆳𑆩𑆬𑇀𑆥𑆩𑆳𑆪𑆶𑆫𑇀𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆲𑆶𑆬𑆩𑆱𑆶𑆒𑆩𑆱𑆶𑆒𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆩𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆢𑆬𑇀𑆥𑆠𑆥𑆾𑆢𑆩𑆤𑆴𑆪𑆩𑆢𑆳𑆤𑆳𑆣𑇀𑆪𑆪𑆤𑆱𑆚𑇀𑆖𑆪𑆁 𑆩𑆠𑇀𑆮𑆳 𑆥𑆶𑆟𑇀𑆪𑆠𑆩𑆩𑆳𑆪𑆶𑆂𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆑𑆫𑆁 𑆘𑆫𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆷𑆫𑇀𑆘𑆱𑇀𑆑𑆫𑆩𑆩𑆸𑆠𑆁 𑆯𑆴𑆮𑆁 𑆯𑆫𑆟𑇀𑆪𑆩𑆶𑆢𑆳𑆫𑆁 𑆨𑆮𑆤𑇀𑆠𑆾 𑆩𑆠𑇀𑆠𑆂 𑆯𑇀𑆫𑆾𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆳𑆡𑆾𑆥𑆣𑆳𑆫𑆪𑆴𑆠𑆶𑆁 𑆥𑇀𑆫𑆑𑆳𑆯𑆪𑆴𑆠𑆶𑆁 𑆖 𑆥𑇀𑆫𑆘𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆩𑆳𑆫𑇀𑆰𑆁 𑆧𑇀𑆫𑆲𑇀𑆩 𑆖 𑆥𑇀𑆫𑆠𑆴 𑆩𑆽𑆠𑇀𑆫𑆵𑆁 𑆑𑆳𑆫𑆶𑆟𑇀𑆪𑆩𑆳𑆠𑇀𑆩𑆤𑆯𑇀𑆖𑆳𑆤𑆶𑆠𑇀𑆠𑆩𑆁 𑆥𑆶𑆟𑇀𑆪𑆩𑆶𑆢𑆳𑆫𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆩𑆑𑇀𑆰𑆪𑆁 𑆑𑆫𑇀𑆩𑆼𑆠𑆴𑇆𑇔𑇆
𑆠𑆖𑇀𑆗𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆮𑆴𑆧𑆶𑆣𑆥𑆠𑆴𑆮𑆖𑆤𑆩𑆸𑆰𑆪𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆩𑆫𑆮𑆫𑆩𑆸𑆓𑇀𑆨𑆴𑆱𑇀𑆠𑆶𑆰𑇀𑆛𑆶𑆮𑆶𑆂, 𑆥𑇀𑆫𑆲𑆸𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆠𑆢𑇀𑆮𑆖𑆤𑆩𑆨𑆴𑆤𑆤𑆤𑇀𑆢𑆶𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇕𑇆
𑆃𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆱𑇀𑆠𑆢𑆳𑆪𑆶𑆫𑇀𑆮𑆼𑆢𑆳𑆩𑆸𑆠𑆩𑆸𑆰𑆴𑆨𑇀𑆪𑆂 𑆱𑆕𑇀𑆑𑇀𑆫𑆩𑇀𑆪𑆾𑆮𑆳𑆖- 𑆍𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆩𑇀, 𑆃𑆪𑆁 𑆖 𑆯𑆴𑆮𑆂 𑆑𑆳𑆬𑆾 𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁, 𑆢𑆴𑆮𑇀𑆪𑆳𑆯𑇀𑆖𑆿𑆰𑆣𑆪𑆾 𑆲𑆴𑆩𑆮𑆠𑇀𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆎𑆤𑇀𑆢𑇀𑆫𑆵, 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵, 𑆥𑆪𑆱𑇀𑆪𑆳, 𑆑𑇀𑆰𑆵𑆫𑆥𑆶𑆰𑇀𑆥𑆵, 𑆯𑇀𑆫𑆳𑆮𑆟𑆵, 𑆩𑆲𑆳𑆯𑇀𑆫𑆳𑆮𑆟𑆵, 𑆯𑆠𑆳𑆮𑆫𑆵, 𑆮𑆴𑆢𑆳𑆫𑆵, 𑆘𑆵𑆮𑆤𑇀𑆠𑆵, 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳, 𑆤𑆳𑆓𑆧𑆬𑆳, 𑆱𑇀𑆡𑆴𑆫𑆳, 𑆮𑆖𑆳, 𑆗𑆠𑇀𑆫𑆳, 𑆃𑆠𑆴𑆖𑇀𑆗𑆠𑇀𑆫𑆳, 𑆩𑆼𑆢𑆳, 𑆩𑆲𑆳𑆩𑆼𑆢𑆳, 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆂 𑆥𑆪𑆱𑆳 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆰𑆟𑇀𑆩𑆳𑆱𑆳𑆠𑇀 𑆥𑆫𑆩𑆳𑆪𑆶𑆫𑇀𑆮𑆪𑆯𑇀𑆖 𑆠𑆫𑆶𑆟𑆩𑆤𑆳𑆩𑆪𑆠𑇀𑆮𑆁 𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆱𑆩𑇀𑆥𑆢𑆩𑆶𑆥𑆖𑆪𑆁 𑆩𑆼𑆣𑆳𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆶𑆠𑇀𑆠𑆩𑆧𑆬𑆩𑆴𑆰𑇀𑆛𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑆳𑆮𑆲𑆤𑇀𑆠𑆴 𑆱𑆴𑆢𑇀𑆣𑆳𑆂𑇆𑇖𑇆
(𑆅𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆾𑆑𑇀𑆠𑆁 𑆫𑆱𑆳𑆪𑆤𑆩𑇀)𑇅 𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆫𑇀𑆪𑆳 𑆲𑆴𑆫𑆟𑇀𑆪𑆑𑇀𑆰𑆵𑆫𑆳 𑆥𑆶𑆰𑇀𑆑𑆫𑆱𑆢𑆸𑆯𑆥𑆠𑇀𑆫𑆳, 𑆄𑆢𑆴𑆠𑇀𑆪𑆥𑆫𑇀𑆟𑆵 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆫𑇀𑆪𑆳 ‘𑆱𑆷𑆫𑇀𑆪𑆑𑆳𑆤𑇀𑆠𑆳’ 𑆅𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆪𑆠𑆼 𑆱𑆶𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆳 𑆱𑆷𑆫𑇀𑆪𑆩𑆟𑇀𑆝𑆬𑆳𑆑𑆳𑆫𑆥𑆶𑆰𑇀𑆥𑆳 𑆖, 𑆤𑆳𑆫𑆵𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆂 ‘𑆃𑆯𑇀𑆮𑆧𑆬𑆳’ 𑆅𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆪𑆠𑆼 𑆪𑆳 𑆧𑆬𑇀𑆮𑆘𑆱𑆢𑆸𑆯𑆥𑆠𑇀𑆫𑆳 , 𑆑𑆳𑆰𑇀𑆜𑆓𑆾𑆣𑆳 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆫𑇀𑆓𑆾𑆣𑆳𑆑𑆳𑆫𑆳, 𑆱𑆫𑇀𑆥𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆂 𑆱𑆫𑇀𑆥𑆳𑆑𑆳𑆫𑆳, 𑆱𑆾𑆩𑆾 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆫𑆳𑆘𑆂 𑆥𑆚𑇀𑆖𑆢𑆯𑆥𑆫𑇀𑆮𑆳 𑆱 𑆱𑆾𑆩 𑆅𑆮 𑆲𑆵𑆪𑆠𑆼 𑆮𑆫𑇀𑆣𑆠𑆼 𑆖, 𑆥𑆢𑇀𑆩𑆳 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆂 𑆥𑆢𑇀𑆩𑆳𑆑𑆳𑆫𑆳 𑆥𑆢𑇀𑆩𑆫𑆑𑇀𑆠𑆳 𑆥𑆢𑇀𑆩𑆓𑆤𑇀𑆣𑆳 𑆖, 𑆃𑆘𑆳 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆂 ‘𑆃𑆘𑆯𑆸𑆕𑇀𑆓𑆵’ 𑆅𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆪𑆠𑆼, 𑆤𑆵𑆬𑆳 𑆤𑆳𑆩𑆿𑆰𑆣𑆴𑆱𑇀𑆠𑆶 𑆤𑆵𑆬𑆑𑇀𑆰𑆵𑆫𑆳 𑆤𑆵𑆬𑆥𑆶𑆰𑇀𑆥𑆳 𑆬𑆠𑆳𑆥𑇀𑆫𑆠𑆳𑆤𑆧𑆲𑆶𑆬𑆼𑆠𑆴; 𑆄𑆱𑆳𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆁 𑆪𑆳𑆁 𑆪𑆳𑆩𑆼𑆮𑆾𑆥𑆬𑆨𑆼𑆠 𑆠𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆂 𑆱𑇀𑆮𑆫𑆱𑆱𑇀𑆪 𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆓𑆠𑇀𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆴𑆠𑆳𑆪𑆳𑆩𑆳𑆫𑇀𑆢𑇀𑆫𑆥𑆬𑆳𑆯𑆢𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆱𑆥𑆴𑆣𑆳𑆤𑆳𑆪𑆳𑆁 𑆢𑆴𑆓𑇀𑆮𑆳𑆱𑆳𑆂 𑆯𑆪𑆵𑆠, 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆬𑆵𑆪𑆠𑆼, 𑆰𑆟𑇀𑆩𑆳𑆱𑆼𑆤 𑆥𑆶𑆤𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆴, 𑆠𑆱𑇀𑆪𑆳𑆘𑆁 𑆥𑆪𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆥𑆤𑆁; 𑆰𑆟𑇀𑆩𑆳𑆱𑆼𑆤 𑆢𑆼𑆮𑆠𑆳𑆤𑆶𑆑𑆳𑆫𑆵 𑆨𑆮𑆠𑆴 𑆮𑆪𑆾𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆑𑆸𑆠𑆴𑆧𑆬𑆥𑇀𑆫𑆨𑆳𑆨𑆴𑆂, 𑆱𑇀𑆮𑆪𑆁 𑆖𑆳𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆮𑆳𑆖𑆾𑆓𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆢𑆴𑆮𑇀𑆪𑆁 𑆖𑆳𑆱𑇀𑆪 𑆖𑆑𑇀𑆰𑆶𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆖 𑆨𑆮𑆠𑆴, 𑆓𑆠𑆴𑆫𑇀𑆪𑆾𑆘𑆤𑆱𑆲𑆱𑇀𑆫𑆁 𑆢𑆯𑆮𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑇀𑆪𑆳𑆪𑆶𑆫𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆁 𑆖𑆼𑆠𑆴𑇆𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆢𑆴𑆮𑇀𑆪𑆳𑆤𑆳𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆁 𑆪𑆂 𑆥𑇀𑆫𑆨𑆳𑆮𑆂 𑆱 𑆨𑆮𑆢𑇀𑆮𑆴𑆣𑆽𑆂𑇅 𑆯𑆑𑇀𑆪𑆂 𑆱𑆾𑆞𑆶𑆩𑆯𑆑𑇀𑆪𑆱𑇀𑆠𑆶 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆾𑆞𑆶𑆩𑆑𑆸𑆠𑆳𑆠𑇀𑆩𑆨𑆴𑆂𑇆𑇘𑇆
𑆏𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆨𑆳𑆮𑆼𑆟 𑆠𑆴𑆰𑇀𑆜𑆠𑆳𑆁 𑆱𑇀𑆮𑆼 𑆖 𑆑𑆫𑇀𑆩𑆟𑆴𑇅 𑆨𑆮𑆠𑆳𑆁 𑆤𑆴𑆒𑆴𑆬𑆁 𑆯𑇀𑆫𑆼𑆪𑆂 𑆱𑆫𑇀𑆮𑆩𑆼𑆮𑆾𑆥𑆥𑆠𑇀𑆱𑇀𑆪𑆠𑆼𑇆𑇙𑇆
𑆮𑆳𑆤𑆥𑇀𑆫𑆱𑇀𑆡𑆽𑆫𑇀𑆓𑆸𑆲𑆱𑇀𑆡𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆪𑆠𑆽𑆫𑇀𑆤𑆴𑆪𑆠𑆳𑆠𑇀𑆩𑆨𑆴𑆂𑇅 𑆯𑆑𑇀𑆪𑆳 𑆏𑆰𑆣𑆪𑆾 𑆲𑇀𑆪𑆼𑆠𑆳𑆂 𑆱𑆼𑆮𑆴𑆠𑆶𑆁 𑆮𑆴𑆰𑆪𑆳𑆨𑆴𑆘𑆳𑆂𑇆𑇑𑇐𑇆
𑆪𑆳𑆱𑇀𑆠𑆶 𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆓𑆶𑆟𑆽𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆩𑆣𑇀𑆪𑆩𑆼𑆤 𑆖 𑆑𑆫𑇀𑆩𑆟𑆳𑇅 𑆩𑆸𑆢𑆶𑆮𑆵𑆫𑇀𑆪𑆠𑆫𑆳𑆱𑇀𑆠𑆳𑆱𑆳𑆁 𑆮𑆴𑆣𑆴𑆫𑇀𑆘𑇀𑆚𑆼𑆪𑆂 𑆱 𑆍𑆮 𑆠𑆶𑇆𑇑𑇑𑇆
𑆥𑆫𑇀𑆪𑆼𑆰𑇀𑆛𑆶𑆁 𑆠𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆶𑆁 𑆮𑆳 𑆪𑆼𑇁𑆱𑆩𑆫𑇀𑆡𑆳𑆂 𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆴𑆤𑆂𑇅 𑆫𑆱𑆳𑆪𑆤𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆼𑆰𑆳𑆩𑆪𑆩𑆤𑇀𑆪𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇆
𑆧𑆬𑇀𑆪𑆳𑆤𑆳𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆤𑆳𑆁 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆳𑆯𑇀𑆖 𑆪𑆳 𑆢𑆯𑇅 𑆮𑆪𑆱𑆂 𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆳𑆁 𑆖 𑆒𑆢𑆴𑆫𑆱𑇀𑆪𑆳𑆱𑆤𑆱𑇀𑆪 𑆖𑇆𑇑𑇓𑇆
𑆒𑆫𑇀𑆘𑆷𑆫𑆳𑆟𑆳𑆁 𑆩𑆣𑆷𑆑𑆳𑆤𑆳𑆁 𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆳𑆩𑆶𑆠𑇀𑆥𑆬𑆱𑇀𑆪 𑆖𑇅 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆤𑆳𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆮𑆖𑆳𑆪𑆳𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆱𑇀𑆪 𑆖𑇆𑇑𑇔𑇆
𑆯𑆠𑆳𑆮𑆫𑇀𑆪𑆳𑆂 𑆥𑆪𑆱𑇀𑆪𑆳𑆪𑆳𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳 𑆘𑆾𑆕𑇀𑆓𑆑𑆱𑇀𑆪 𑆖𑇅 𑆉𑆣𑇀𑆢𑇀𑆪𑆳 𑆤𑆳𑆓𑆧𑆬𑆳𑆪𑆳𑆯𑇀𑆖 𑆢𑇀𑆮𑆳𑆫𑆢𑆳𑆪𑆳 𑆣𑆮𑆱𑇀𑆪 𑆖𑇆𑇑𑇕𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑇀𑆪𑆾𑆯𑇀𑆖 𑆮𑆴𑆢𑆳𑆫𑇀𑆪𑆳𑆯𑇀𑆖𑆤𑇀𑆢𑆤𑆱𑇀𑆪 𑆖𑇅 𑆅𑆑𑇀𑆰𑆷𑆟𑆳𑆁 𑆯𑆫𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆯𑇀𑆫𑆵𑆥𑆫𑇀𑆟𑇀𑆪𑆳𑆱𑇀𑆠𑆴𑆤𑆴𑆯𑆱𑇀𑆪 𑆖𑇆𑇑𑇖𑇆
𑆫𑆱𑆳𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑇀𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆳𑆂 𑆥𑆬𑆳𑆯𑆑𑇀𑆰𑆳𑆫 𑆍𑆮 𑆖𑇅 𑆍𑆰𑆳𑆁 𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆤𑇀 𑆥𑆪𑆾 𑆓𑆮𑇀𑆪𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀𑇆𑇑𑇗𑇆
𑆢𑇀𑆮𑆼 𑆥𑆳𑆠𑇀𑆫𑆼 𑆠𑆴𑆬𑆠𑆽𑆬𑆱𑇀𑆪 𑆢𑇀𑆮𑆼 𑆖 𑆓𑆮𑇀𑆪𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆰𑆂𑇅 𑆠𑆠𑇀 𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑆫𑇀𑆮𑆩𑆼𑆑𑆠𑇀𑆫 𑆱𑆶𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑇀𑆤𑆼𑆲𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫𑆳𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆳𑆞𑆑𑆁 𑆯𑆠𑆨𑆳𑆮𑆴𑆠𑆩𑇀𑇅 𑆱𑇀𑆮𑆫𑆱𑆼𑆤𑆽𑆮 𑆢𑆳𑆠𑆮𑇀𑆪𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑇀𑆪𑆳𑆨𑆴𑆤𑆮𑆱𑇀𑆪 𑆖𑇆𑇑𑇙𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆖𑆷𑆫𑇀𑆟𑆥𑆳𑆠𑇀𑆫𑆁 𑆖 𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆼𑆑𑆁 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆠𑆶𑆓𑆳𑆑𑇀𑆰𑆵𑆫𑇀𑆪𑆳𑆂 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆂 𑆱𑇀𑆡𑆳𑆥𑇀𑆪𑆁 𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆁 𑆖 𑆠𑆠𑇀𑇆𑇒𑇐𑇆
𑆱𑆶𑆖𑆿𑆑𑇀𑆰𑆼 𑆩𑆳𑆫𑇀𑆠𑆴𑆑𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆩𑆳𑆱𑆳𑆫𑇀𑆣𑆁 𑆔𑆸𑆠𑆨𑆳𑆮𑆴𑆠𑆼𑇅 𑆩𑆳𑆠𑇀𑆫𑆳𑆩𑆓𑇀𑆤𑆴𑆱𑆩𑆳𑆁 𑆠𑆱𑇀𑆪 𑆠𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇒𑇑𑇆
𑆲𑆼𑆩𑆠𑆳𑆩𑇀𑆫𑆥𑇀𑆫𑆮𑆳𑆬𑆳𑆤𑆳𑆩𑆪𑆱𑆂 𑆱𑇀𑆦𑆛𑆴𑆑𑆱𑇀𑆪 𑆖𑇅 𑆩𑆶𑆑𑇀𑆠𑆳𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆯𑆕𑇀𑆒𑆳𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆫𑆘𑆠𑆱𑇀𑆪 𑆖𑇆𑇒𑇒𑇆

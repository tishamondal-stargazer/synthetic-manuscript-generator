𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆡 𑆮𑆠𑇀𑆱𑆑𑆤𑆳𑆩𑆳𑆤𑆴 𑆨𑆼𑆢𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆪𑆾𑆱𑇀𑆠𑆡𑆳𑇅 𑆑𑆬𑇀𑆥𑆁 𑆖𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆪𑆡𑆳𑆠𑆡𑆩𑇀𑇆𑇓𑇆
𑆮𑆠𑇀𑆱𑆑𑆂 𑆑𑆶𑆛𑆘𑆂 𑆯𑆑𑇀𑆫𑆾 𑆮𑆸𑆑𑇀𑆰𑆑𑆾 𑆓𑆴𑆫𑆴𑆩𑆬𑇀𑆬𑆴𑆑𑆳𑇅 𑆧𑆵𑆘𑆳𑆤𑆵𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆠𑆡𑆾𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆳𑆂𑇆𑇔𑇆
𑆧𑆸𑆲𑆠𑇀𑆦𑆬𑆂 𑆯𑇀𑆮𑆼𑆠𑆥𑆶𑆰𑇀𑆥𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆥𑆠𑇀𑆫𑆂 𑆥𑆶𑆩𑆳𑆤𑇀 𑆨𑆮𑆼𑆠𑇀𑇅 𑆯𑇀𑆪𑆳𑆩𑆳 𑆖𑆳𑆫𑆶𑆟𑆥𑆶𑆰𑇀𑆥𑆳 𑆱𑇀𑆠𑇀𑆫𑆵 𑆦𑆬𑆮𑆸𑆤𑇀𑆠𑆽𑆱𑇀𑆠𑆡𑆳𑇁𑆟𑆶𑆨𑆴𑆂 𑇆𑇕𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆔𑇀𑆤𑆱𑇀𑆠𑆶 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆼𑆰𑇀𑆮𑆤𑆠𑇀𑆪𑆪𑆂𑇅 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆘𑇀𑆮𑆫𑆮𑆳𑆠𑆳𑆱𑆸𑆓𑇀𑆮𑆵𑆱𑆫𑇀𑆥𑆳𑆢𑆴𑆰𑆶 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇖𑇆
𑆑𑆳𑆬𑆼 𑆦𑆬𑆳𑆤𑆴 𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪𑆳 𑆠𑆪𑆾𑆂 𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆴 𑆤𑆴𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀 𑇅 𑆠𑆼𑆰𑆳𑆩𑆤𑇀𑆠𑆫𑇀𑆤𑆒𑆁 𑆩𑆶𑆰𑇀𑆛𑆴𑆁 𑆘𑆫𑇀𑆘𑆫𑆵𑆑𑆸𑆠𑇀𑆪 𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇗𑇆
𑆩𑆣𑆶𑆑𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆡𑆳𑇅 𑆤𑆴𑆯𑆴 𑆱𑇀𑆡𑆴𑆠𑆁 𑆮𑆴𑆩𑆸𑆢𑇀𑆪𑆽𑆠𑆬𑇀𑆬𑆮𑆟𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇘𑇆
𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆢𑇀𑆮𑆩𑆤𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆩𑇀𑇅𑇙𑇅 𑆃𑆰𑇀𑆛𑆳𑆲𑆁 𑆥𑆪𑆱𑆳𑇁𑇁𑆫𑇀𑆑𑆼𑆟 𑆠𑆼𑆰𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆨𑆳𑆮𑆪𑆼𑆠𑇀𑇆𑇙𑇆
𑆘𑆵𑆮𑆑𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆠𑆠𑆂 𑆥𑆳𑆟𑆴𑆠𑆬𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆦𑆬𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆤𑆳𑆁 𑆥𑆸𑆡𑆑𑇀 𑆠𑆡𑆳𑇆𑇑𑇐𑇆
𑆱𑆫𑇀𑆰𑆥𑆳𑆟𑆳𑆁 𑆩𑆣𑆷𑆑𑆳𑆤𑆳𑆁 𑆬𑆮𑆟𑆱𑇀𑆪𑆳𑆡𑆮𑆳𑇁𑆩𑇀𑆧𑆶𑆤𑆳𑇅𑇑𑇑𑇅 𑆑𑆸𑆯𑆫𑆼𑆟𑆳𑆡𑆮𑆳 𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆮𑆩𑆤𑆁 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆤𑆮 𑆖𑆷𑆫𑇀𑆟𑆽𑆯𑇀𑆖 𑆥𑆚𑇀𑆖𑆾𑆑𑇀𑆠𑆳𑆂 𑆱𑆬𑆴𑆬𑆽𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇅 𑆍𑆑𑆯𑇀𑆖 𑆑𑆸𑆯𑆫𑆳𑆪𑆳𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆪𑆾𑆓𑆳𑆱𑇀𑆠𑆼𑇁𑆰𑇀𑆛𑆳𑆢𑆯 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆤𑆳𑆩𑆳𑆤𑆴 𑆑𑆬𑇀𑆥𑆁 𑆖𑆳𑆱𑇀𑆪 𑆤𑆴𑆧𑆾𑆣𑆠𑇅 𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆂 𑆑𑆾𑆯𑆳𑆠𑆑𑆵 𑆖𑆾𑆑𑇀𑆠𑆁 𑆩𑆸𑆢𑆕𑇀𑆓𑆦𑆬𑆩𑆼𑆮 𑆖𑇆𑇓𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆑𑆛𑆶𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆁 𑆓𑆳𑆞𑆼𑆰𑇀𑆮𑆴𑆰𑇀𑆛𑆁 𑆓𑆢𑆼𑆰𑆶 𑆖𑇅 𑆑𑆶𑆰𑇀𑆜𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆥𑇀𑆬𑆵𑆲𑆯𑆾𑆦𑆓𑆶𑆬𑇀𑆩𑆓𑆫𑆳𑆢𑆴𑆰𑆶𑇆𑇔𑇆
𑆑𑇀𑆰𑆵𑆫𑆳𑆢𑆴 𑆑𑆶𑆱𑆶𑆩𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆶𑆫𑆳 𑆖𑆽𑆠𑆼𑆰𑆶 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀𑇅𑇕𑇅 𑆱𑆶𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆳𑆁 𑆠𑆶 𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆼𑆑𑆁 𑆢𑇀𑆮𑆼 𑆮𑆳 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇆𑇕𑇆
𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆩𑆣𑆶𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆮𑆨𑆴𑆂 𑆦𑆬𑆮𑆠𑇀 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆑𑇀𑆮𑆳𑆡𑆪𑆴𑆠𑇀𑆮𑆳 𑆦𑆬𑆁 𑆠𑆱𑇀𑆪 𑆥𑆷𑆠𑇀𑆮𑆳 𑆬𑆼𑆲𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇖𑇆
𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆑𑆬𑇀𑆑𑆳𑆁𑆯𑆁 𑆦𑆬𑆳𑆢𑇀𑆪𑆫𑇀𑆣𑆳𑆁𑆯𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇅 𑆥𑆸𑆡𑆑𑇀 𑆖𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑇀𑆫𑆪𑆾𑆢𑆯𑆨𑆴𑆫𑆳𑆱𑆶𑆠𑆩𑇀𑇆𑇗𑇆
𑆯𑆳𑆬𑇀𑆩𑆬𑆵𑆩𑆷𑆬𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆥𑆴𑆖𑇀𑆗𑆳𑆨𑆴𑆫𑇀𑆢𑆯𑆨𑆴𑆱𑇀𑆠𑆡𑆳𑇅𑇘𑇅 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆰𑆛𑇀 𑆦𑆬𑆮𑆠𑇀, 𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆔𑆸𑆠𑆁 𑆠𑆡𑆳𑇆𑇘𑇆
𑆑𑆾𑆯𑆳𑆠𑆑𑆳𑆤𑆴 𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆫𑆱𑆼 𑆥𑆖𑆼𑆠𑇀𑇅 𑆠𑆁 𑆑𑆰𑆳𑆪𑆁 𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆬𑆼𑆲𑆁 𑆥𑆶𑆤𑆂 𑆥𑆖𑆼𑆠𑇀𑇆𑇙𑇆
𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆱𑇀𑆪 𑆠𑆠𑇀𑆫 𑆨𑆳𑆓𑆂 𑆱𑇀𑆪𑆳𑆖𑇀𑆗𑆼𑆰𑆳𑆟𑇀𑆪𑆫𑇀𑆣𑆳𑆁𑆯𑆴𑆑𑆳𑆤𑆴 𑆠𑆶𑇅 𑆑𑆰𑆳𑆪𑆽𑆂 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆳𑆢𑇀𑆪𑆽𑆫𑆼𑆮𑆁 𑆠𑆠𑇀 𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑆥𑆸𑆡𑆑𑇀𑇆𑇑𑇐𑇆
𑆑𑆰𑆳𑆪𑆼𑆰𑆶 𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆩𑆳𑆤𑆷𑆥𑆁 𑆥𑆴𑆯𑆴𑆠𑆁 𑆥𑆸𑆡𑆑𑇀𑇅 𑆑𑆾𑆯𑆳𑆠𑆑𑇀𑆪𑆳 𑆱𑆩𑆁 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆫𑆱𑆁 𑆱𑆬𑆮𑆟𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇑𑇆
𑆦𑆬𑆳𑆢𑆴𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆠𑆶𑆬𑇀𑆪𑆁 𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆫𑆱𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅𑇑𑇒𑇅 𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆁 𑆑𑆳𑆱𑆵 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆁 𑆩𑆴𑆯𑇀𑆫𑆩𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆼𑆤 𑆖𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆑𑇀𑆰𑆵𑆫𑆼 𑆢𑇀𑆮𑆿 𑆢𑇀𑆮𑆿 𑆱𑆶𑆫𑆳 𑆖𑆽𑆑𑆳 𑆑𑇀𑆮𑆳𑆡𑆳 𑆢𑇀𑆮𑆳𑆮𑆴𑆁𑆯𑆠𑆴𑆱𑇀𑆠𑆡𑆳𑇅 𑆢𑆯 𑆥𑆴𑆖𑇀𑆗𑆳 𑆔𑆸𑆠𑆁 𑆖𑆽𑆑𑆁 𑆰𑆛𑇀 𑆖 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆯𑆶𑆨𑆳𑆂𑇆𑇑𑇓𑇆
𑆬𑆼𑆲𑆼𑇁𑆰𑇀𑆛𑆿 𑆱𑆥𑇀𑆠 𑆩𑆳𑆁𑆱𑆼 𑆖 𑆪𑆾𑆓 𑆅𑆑𑇀𑆰𑆶𑆫𑆱𑆼𑇁𑆥𑆫𑆂𑇅 𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆑𑆬𑇀𑆥𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆪𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂𑇆𑇑𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆠𑇀𑆫𑆴𑆮𑆸𑆤𑇀𑆩𑆷𑆬𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆳𑆲𑆶𑆫𑇀𑆩𑆤𑆵𑆰𑆴𑆟𑆂 𑇅 𑆠𑆱𑇀𑆪𑆳𑆂 𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆓𑆶𑆟𑆳𑆂 𑆑𑆫𑇀𑆩 𑆨𑆼𑆢𑆂 𑆑𑆬𑇀𑆥𑆯𑇀𑆖 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇓𑇆

𑆯𑆾𑆦𑆳𑆱𑇀𑆠𑆶 𑆯𑆾𑆦𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳 𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆂 𑇅 𑆤𑆴𑆢𑆳𑆤𑆼𑇁𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆪𑆼𑆮𑆁 𑆠𑆳𑆤𑆴 𑆮𑆴𑆨𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆳𑆱𑆳𑆓𑆠𑆫𑆾𑆓𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆥𑆷𑆫𑇀𑆮𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆼 𑆥𑆷𑆠𑆴𑆤𑆱𑇀𑆪𑆼 𑆖 𑆘𑆤𑇀𑆠𑆾𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆗𑆫𑇀𑆢𑆤𑆁 𑆱𑇀𑆫𑆁𑆱𑆤𑆁 𑆖 𑇅 𑆪𑆶𑆑𑇀𑆠𑆁 𑆨𑆑𑇀𑆠𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆬𑇀𑆥𑆁 𑆬𑆔𑆶 𑆱𑇀𑆪𑆳𑆢𑆶𑆰𑇀𑆟𑆁 𑆠𑆾𑆪𑆁 𑆣𑆷𑆩𑆥𑆳𑆤𑆁 𑆖 𑆑𑆳𑆬𑆼 𑇆𑇓𑇆
𑆲𑆴𑆕𑇀𑆓𑆶 𑆮𑇀𑆪𑆾𑆰𑆁 𑆮𑆠𑇀𑆱𑆑𑆳𑆒𑇀𑆪𑆁 𑆯𑆴𑆮𑆳𑆛𑆵 𑆬𑆳𑆑𑇀𑆰𑆳 𑆧𑆵𑆘𑆁 𑆱𑆿𑆫𑆨𑆁 𑆑𑆛𑇀𑆦𑆬𑆁 𑆖 𑇅 𑆇𑆓𑇀𑆫𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆳 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆤𑆴𑆠𑇀𑆪𑆁 𑆖𑆳𑆮𑆥𑆵𑆝𑆼 𑆑𑆫𑆚𑇀𑆘𑆩𑇀 𑇆𑇔𑇆
𑆤𑆳𑆱𑆳𑆤𑆳𑆲𑆼 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆣𑆷𑆩𑆳 𑆩𑆷𑆫𑇀𑆣𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆤𑆴𑆠𑇀𑆪𑆩𑇀 𑇅 𑆧𑆬𑆳𑆠𑆽𑆬𑆁 𑆱𑆫𑇀𑆮𑆡𑆽𑆮𑆾𑆥𑆪𑆾𑆘𑇀𑆪𑆁 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆳𑆮𑆤𑇀𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆖 𑆪𑆢𑇀𑆪𑆠𑇀 𑇆𑇙𑇆
𑆤𑆳𑆱𑆳𑆱𑇀𑆫𑆳𑆮𑆼 𑆔𑇀𑆫𑆳𑆟𑆠𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆩𑆶𑆑𑇀𑆠𑆁 𑆤𑆳𑆝𑇀𑆪𑆳 𑆢𑆼𑆪𑆁 𑆪𑆾𑇁𑆮𑆥𑆵𑆝𑆯𑇀𑆖 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆣𑆷𑆩𑆁 𑆢𑆼𑆮𑆢𑆳𑆫𑇀𑆮𑆓𑇀𑆤𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆳𑆁𑆱𑆁 𑆮𑆳𑇁𑇁𑆘𑆁 𑆪𑆶𑆑𑇀𑆠𑆩𑆠𑇀𑆫𑆳𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑇆𑇑𑇐𑇆
𑆤𑆳𑆱𑆳𑆯𑆾𑆰𑆼 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁 𑆖𑆳𑆟𑆶𑆑𑆬𑇀𑆥𑆼𑆤 𑆤𑆱𑇀𑆪𑆩𑇀 𑇅 𑆱𑆫𑇀𑆥𑆴𑆂𑆥𑆳𑆤𑆁 𑆨𑆾𑆘𑆤𑆁 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆯𑇀𑆖 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆮𑆼𑆢𑆂 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆯𑇀𑆖𑆳𑆥𑆴 𑆣𑆷𑆩𑆂 𑇆𑇑𑇑𑇆
𑆯𑆼𑆰𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆤𑇀 𑆔𑇀𑆫𑆳𑆟𑆘𑆳𑆤𑇀 𑆱𑆤𑇀𑆤𑆴𑆪𑆖𑇀𑆗𑆼𑆢𑆶𑆑𑇀𑆠𑆁 𑆠𑆼𑆰𑆳𑆁 𑆪𑆢𑇀𑆪𑆡𑆳 𑆱𑆁𑆮𑆴𑆣𑆳𑆤𑆩𑇀 𑇆𑇑𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆤𑆳𑆫𑆵𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆂 𑆯𑆴𑆫𑆱𑆾𑇁𑆨𑆴𑆠𑆳𑆥𑆾 𑆣𑆷𑆩𑆾 𑆫𑆘𑆂 𑆯𑆵𑆠𑆩𑆠𑆴𑆥𑇀𑆫𑆠𑆳𑆥𑆂 𑇅 𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆁 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆪𑆾𑆯𑇀𑆖 𑆱𑆢𑇀𑆪𑆂 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆤𑆴𑆢𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇓𑇆
𑆖𑆪𑆁 𑆓𑆠𑆳 𑆩𑆷𑆫𑇀𑆣𑆤𑆴 𑆩𑆳𑆫𑆶𑆠𑆳𑆢𑆪𑆂 𑆥𑆸𑆡𑆑𑇀 𑆱𑆩𑆱𑇀𑆠𑆳𑆯𑇀𑆖 𑆠𑆡𑆽𑆮 𑆯𑆾𑆟𑆴𑆠𑆩𑇀 𑇅 𑆥𑇀𑆫𑆑𑆾𑆥𑇀𑆪𑆩𑆳𑆟𑆳 𑆮𑆴𑆮𑆴𑆣𑆽𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆽𑆫𑇀𑆤𑆸𑆟𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆑𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇔𑇆
𑆯𑆴𑆫𑆾𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆑𑇀𑆰𑆮𑆡𑆾𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆁 𑆠𑆡𑆳𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆂 𑆥𑆫𑆴𑆲𑆸𑆰𑇀𑆛𑆫𑆾𑆩𑆠𑆳 𑇅 𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆥𑆫𑆼 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳 𑆤𑆸𑆟𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆥𑆶𑆫𑆂𑆱𑆫𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇕𑇆
𑆄𑆤𑆢𑇀𑆣𑆳 𑆥𑆴𑆲𑆴𑆠𑆳 𑆤𑆳𑆱𑆳 𑆠𑆤𑆶𑆱𑇀𑆫𑆳𑆮𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆴𑆤𑆵 𑇅 𑆓𑆬𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆯𑆾𑆰𑆯𑇀𑆖 𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆂 𑆯𑆕𑇀𑆒𑆪𑆾𑆱𑇀𑆠𑆡𑆳 𑇆𑇖𑇆
𑆑𑆸𑆯𑆾𑇁𑆠𑆴𑆥𑆳𑆟𑇀𑆝𑆶𑆂 𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆾 𑆨𑆮𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆴(𑆨𑆴)𑆥𑆵𑆝𑆴𑆠𑆂 𑇅 𑆱𑆣𑆷𑆩𑆁 𑆱𑆲𑆱𑆳 𑆮𑆲𑇀𑆤𑆴𑆁 𑆮𑆩𑆠𑆵𑆮 𑆖 𑆩𑆳𑆤𑆮𑆂 𑇆𑇘𑇆
𑆑𑆦𑆂 𑆑𑆦𑆑𑆸𑆠𑆼 𑆔𑇀𑆫𑆳𑆟𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆬𑆂 𑆯𑆵𑆠𑆂 𑆱𑇀𑆫𑆮𑆼𑆤𑇀𑆩𑆶𑆲𑆶𑆂 𑇅 𑆯𑆶𑆑𑇀𑆬𑆳𑆮𑆨𑆳𑆱𑆂 𑆯𑆷𑆤𑆳𑆑𑇀𑆰𑆾 𑆨𑆮𑆼𑆢𑇀𑆓𑆶𑆫𑆶𑆯𑆴𑆫𑆾𑆩𑆶𑆒𑆂 𑇆𑇙𑇆
𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆾 𑆮𑆳𑇁𑆥𑇀𑆪𑆥𑆑𑇀𑆮𑆾 𑆮𑆳 𑆱 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆨𑆮𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇅 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆖𑆽𑆮 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆥𑆵𑆤𑆱𑆳𑆤𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆘𑆼 𑇆𑇑𑇑𑇆
𑆫𑆑𑇀𑆠𑆘𑆼 𑆠𑆶 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆼 𑆫𑆑𑇀𑆠𑆳𑆱𑇀𑆫𑆳𑆮𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼 𑇅 𑆠𑆳𑆩𑇀𑆫𑆳𑆑𑇀𑆰𑆯𑇀𑆖 𑆨𑆮𑆼𑆘𑇀𑆘𑆤𑇀𑆠𑆶𑆫𑆶𑆫𑆾𑆔𑆳𑆠𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆂 𑇆𑇑𑇒𑇆

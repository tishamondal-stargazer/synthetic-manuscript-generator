𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆱𑆵𑆢𑆤𑇀𑆠𑆴 𑆱𑆶𑆠𑇀𑆮𑆓𑇀𑆨𑆮𑆠𑆴 𑆖𑆳𑆤𑆤𑆩𑇀 𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆳𑆨𑆂 𑆱𑆶𑆒𑆁 𑆖 𑆱𑇀𑆪𑆳𑆤𑇀𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆠𑆽𑆬𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀𑇆𑇘𑇓𑇆
𑆤 𑆑𑆫𑇀𑆟𑆫𑆾𑆓𑆳 𑆮𑆳𑆠𑆾𑆠𑇀𑆡𑆳 𑆤 𑆩𑆤𑇀𑆪𑆳𑆲𑆤𑆶𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆤𑆾𑆖𑇀𑆖𑆽𑆂 𑆯𑇀𑆫𑆶𑆠𑆴𑆫𑇀𑆤 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆁 𑆑𑆫𑇀𑆟𑆠𑆫𑇀𑆥𑆟𑆳𑆠𑇀𑇆𑇘𑇔𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆢𑇀𑆪𑆡𑆳 𑆑𑆶𑆩𑇀𑆨𑆯𑇀𑆖𑆫𑇀𑆩 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆩𑆫𑇀𑆢𑆤𑆳𑆠𑇀𑇅 𑆨𑆮𑆠𑇀𑆪𑆶𑆥𑆳𑆕𑇀𑆓𑆳𑆢𑆑𑇀𑆰𑆯𑇀𑆖 𑆢𑆸𑆞𑆂 𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆾 𑆪𑆡𑆳𑇆𑇘𑇕𑇆
𑆠𑆡𑆳 𑆯𑆫𑆵𑆫𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆢𑇀𑆢𑆸𑆞𑆁 𑆱𑆶𑆠𑇀𑆮𑆑𑇀 𑆖 𑆘𑆳𑆪𑆠𑆼𑇅 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆩𑆳𑆫𑆶𑆠𑆳𑆧𑆳𑆣𑆁 𑆑𑇀𑆬𑆼𑆯𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆱𑆁𑆱𑆲𑆩𑇀𑇆𑇘𑇖𑇆
𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼𑇁𑆨𑇀𑆪𑆣𑆴𑆑𑆾 𑆮𑆳𑆪𑆶𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆁 𑆖 𑆠𑇀𑆮𑆓𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇅 𑆠𑇀𑆮𑆖𑇀𑆪𑆯𑇀𑆖 𑆥𑆫𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆁 𑆯𑆵𑆬𑆪𑆼𑆤𑇀𑆤𑆫𑆂𑇆𑇘𑇗𑇆
𑆤 𑆖𑆳𑆨𑆴𑆔𑆳𑆠𑆳𑆨𑆴𑆲𑆠𑆁 𑆓𑆳𑆠𑇀𑆫𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑆼𑆮𑆴𑆤𑆂𑇅 𑆮𑆴𑆑𑆳𑆫𑆁 𑆨𑆘𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆧𑆬𑆑𑆫𑇀𑆩𑆟𑆴 𑆮𑆳 𑆑𑇀𑆮𑆖𑆴𑆠𑇀𑇆𑇘𑇘𑇆
𑆱𑆶𑆱𑇀𑆥𑆫𑇀𑆯𑆾𑆥𑆖𑆴𑆠𑆳𑆕𑇀𑆓𑆯𑇀𑆖 𑆧𑆬𑆮𑆳𑆤𑇀 𑆥𑇀𑆫𑆴𑆪𑆢𑆫𑇀𑆯𑆤𑆂𑇅 𑆨𑆮𑆠𑇀𑆪𑆨𑇀𑆪𑆕𑇀𑆓𑆤𑆴𑆠𑇀𑆪𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆫𑆾𑇁𑆬𑇀𑆥𑆘𑆫 𑆍𑆮 𑆖𑇆𑇘𑇙𑇆
𑆒𑆫𑆠𑇀𑆮𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆠𑆳 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆯𑇀𑆫𑆩𑆂 𑆱𑆶𑆥𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑆳𑆢𑆪𑆾𑆂𑇅 𑆱𑆢𑇀𑆪 𑆍𑆮𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆴 𑆥𑆳𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀𑇆𑇙𑇐𑇆
𑆘𑆳𑆪𑆠𑆼 𑆱𑆿𑆑𑆶𑆩𑆳𑆫𑇀𑆪𑆁 𑆖 𑆧𑆬𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆖 𑆥𑆳𑆢𑆪𑆾𑆂𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆬𑆨𑆠𑆼 𑆩𑆳𑆫𑆶𑆠𑆯𑇀𑆖𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇆𑇙𑇑𑇆
𑆤 𑆖 𑆱𑇀𑆪𑆳𑆢𑇀𑆓𑆸𑆣𑇀𑆫𑆱𑆵𑆮𑆳𑆠𑆂 𑆥𑆳𑆢𑆪𑆾𑆂 𑆱𑇀𑆦𑆶𑆛𑆤𑆁 𑆤 𑆖𑇅 𑆤 𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆕𑇀𑆑𑆾𑆖𑆂 𑆥𑆳𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼𑆤 𑆥𑆳𑆢𑆪𑆾𑆂𑇆𑇙𑇒𑇆
𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆓𑆿𑆫𑆮𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆑𑆟𑇀𑆝𑆷𑆁 𑆩𑆬𑆩𑆫𑆾𑆖𑆑𑆩𑇀𑇅 𑆱𑇀𑆮𑆼𑆢𑆧𑆵𑆨𑆠𑇀𑆱𑆠𑆳𑆁 𑆲𑆤𑇀𑆠𑆴 𑆯𑆫𑆵𑆫𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆤𑆩𑇀𑇆𑇙𑇓𑇆
𑆥𑆮𑆴𑆠𑇀𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆯𑇀𑆫𑆩𑆱𑇀𑆮𑆼𑆢𑆩𑆬𑆳𑆥𑆲𑆩𑇀 𑇅 𑆯𑆫𑆵𑆫𑆧𑆬𑆱𑆤𑇀𑆣𑆳𑆤𑆁 𑆱𑇀𑆤𑆳𑆤𑆩𑆾𑆘𑆱𑇀𑆑𑆫𑆁 𑆥𑆫𑆩𑇀𑇆𑇙𑇔𑇆
𑆑𑆳𑆩𑇀𑆪𑆁 𑆪𑆯𑆱𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆔𑇀𑆤𑆁 𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆟𑆩𑇀𑇅 𑆯𑇀𑆫𑆵𑆩𑆠𑇀 𑆥𑆳𑆫𑆴𑆰𑆢𑆁 𑆯𑆱𑇀𑆠𑆁 𑆤𑆴𑆫𑇀𑆩𑆬𑆳𑆩𑇀𑆧𑆫𑆣𑆳𑆫𑆟𑆩𑇀𑇆𑇙𑇕𑇆
𑆮𑆸𑆰𑇀𑆪𑆁 𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆑𑆳𑆩𑇀𑆪𑆁 𑆥𑆶𑆰𑇀𑆛𑆴𑆧𑆬𑆥𑇀𑆫𑆢𑆩𑇀𑇅 𑆱𑆿𑆩𑆤𑆱𑇀𑆪𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆔𑇀𑆤𑆁 𑆓𑆤𑇀𑆣𑆩𑆳𑆬𑇀𑆪𑆤𑆴𑆰𑆼𑆮𑆟𑆩𑇀𑇆𑇙𑇖𑇆
𑆣𑆤𑇀𑆪𑆁 𑆩𑆕𑇀𑆓𑆬𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆯𑇀𑆫𑆵𑆩𑆢𑇀𑆮𑇀𑆪𑆱𑆤𑆱𑆷𑆢𑆤𑆩𑇀𑇅 𑆲𑆫𑇀𑆰𑆟𑆁 𑆑𑆳𑆩𑇀𑆪𑆩𑆾𑆘𑆱𑇀𑆪𑆁 𑆫𑆠𑇀𑆤𑆳𑆨𑆫𑆟𑆣𑆳𑆫𑆟𑆩𑇀𑇆𑇙𑇗𑇆
𑆩𑆼𑆣𑇀𑆪𑆁 𑆥𑆮𑆴𑆠𑇀𑆫𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆑𑆬𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆥𑆳𑆢𑆪𑆾𑆫𑇀𑆩𑆬𑆩𑆳𑆫𑇀𑆓𑆳𑆟𑆳𑆁 𑆯𑆿𑆖𑆳𑆣𑆳𑆤𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆯𑆂𑇆𑇙𑇘𑇆
𑆥𑆿𑆰𑇀𑆛𑆴𑆑𑆁 𑆮𑆸𑆰𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆯𑆶𑆖𑆴 𑆫𑆷𑆥𑆮𑆴𑆫𑆳𑆘𑆤𑆩𑇀𑇅 𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆤𑆒𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆬𑇀𑆥𑆤𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑆳𑆣𑆤𑆩𑇀𑇆𑇙𑇙𑇆
𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆲𑆴𑆠𑆁 𑆥𑆳𑆢𑆪𑆾𑆫𑇀𑆮𑇀𑆪𑆱𑆤𑆳𑆥𑆲𑆩𑇀𑇅 𑆧𑆬𑇀𑆪𑆁 𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆱𑆶𑆒𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆥𑆳𑆢𑆠𑇀𑆫𑆣𑆳𑆫𑆟𑆩𑇀𑇆𑇑𑇐𑇐𑇆
𑆆𑆠𑆼𑆂 𑆥𑇀𑆫𑆯𑆩𑆤𑆁 𑆧𑆬𑇀𑆪𑆁 𑆓𑆶𑆥𑇀𑆠𑇀𑆪𑆳𑆮𑆫𑆟𑆯𑆕𑇀𑆑𑆫𑆩𑇀𑇅 𑆔𑆫𑇀𑆩𑆳𑆤𑆴𑆬𑆫𑆘𑆾𑆩𑇀𑆧𑆶𑆔𑇀𑆤𑆁 𑆗𑆠𑇀𑆫𑆣𑆳𑆫𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇑𑇆
𑆱𑇀𑆒𑆬𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆯𑆠𑇀𑆫𑆷𑆟𑆳𑆁 𑆖 𑆤𑆴𑆰𑆷𑆢𑆤𑆩𑇀𑇅 𑆃𑆮𑆰𑇀𑆛𑆩𑇀𑆨𑆤𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆨𑆪𑆔𑇀𑆤𑆁 𑆢𑆟𑇀𑆝𑆣𑆳𑆫𑆟𑆩𑇀𑇆𑇑𑇐𑇒𑇆
𑆤𑆓𑆫𑆵 𑆤𑆓𑆫𑆱𑇀𑆪𑆼𑆮 𑆫𑆡𑆱𑇀𑆪𑆼𑆮 𑆫𑆡𑆵 𑆪𑆡𑆳𑇅 𑆱𑇀𑆮𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆩𑆼𑆣𑆳𑆮𑆵 𑆑𑆸𑆠𑇀𑆪𑆼𑆰𑇀𑆮𑆮𑆲𑆴𑆠𑆾 𑆨𑆮𑆼𑆠𑇀𑇆𑇑𑇐𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆤𑇀𑆤𑆴𑆰𑆼𑆮𑆼𑆠 𑆪𑆼 𑆱𑇀𑆪𑆶𑆫𑇀𑆣𑆫𑇀𑆩𑆳𑆮𑆴𑆫𑆾𑆣𑆴𑆤𑆂𑇅 𑆯𑆩𑆩𑆣𑇀𑆪𑆪𑆤𑆁 𑆖𑆽𑆮 𑆱𑆶𑆒𑆩𑆼𑆮𑆁 𑆱𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇑𑇐𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆩𑆳𑆠𑇀𑆫𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆖 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆩𑇀𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆫𑇀𑆲𑆴𑆠𑆾𑇁𑆨𑇀𑆪𑆳𑆱𑆾 𑆪𑆼𑆰𑆳𑆁, 𑆪𑆼𑆰𑆳𑆁 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇕𑇆
𑆃𑆚𑇀𑆘𑆤𑆁 𑆣𑆷𑆩𑆮𑆫𑇀𑆠𑆴𑆯𑇀𑆖 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆮𑆫𑇀𑆠𑆴𑆑𑆬𑇀𑆥𑆤𑆳𑇅 𑆣𑆷𑆩𑆥𑆳𑆤𑆓𑆶𑆟𑆳𑆂 𑆑𑆳𑆬𑆳𑆂 𑆥𑆳𑆤𑆩𑆳𑆤𑆁 𑆖 𑆪𑆱𑇀𑆪 𑆪𑆠𑇀𑇆𑇑𑇐𑇖𑇆
𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆴𑆖𑆴𑆲𑇀𑆤𑆁 𑆨𑆽𑆰𑆘𑇀𑆪𑆁 𑆣𑆷𑆩𑆾 𑆪𑆼𑆰𑆳𑆁 𑆮𑆴𑆓𑆫𑇀𑆲𑆴𑆠𑆂𑇅 𑆥𑆼𑆪𑆾 𑆪𑆡𑆳 𑆪𑆤𑇀𑆩𑆪𑆁 𑆖 𑆤𑆼𑆠𑇀𑆫𑆁 𑆪𑆱𑇀𑆪 𑆖 𑆪𑆢𑇀𑆮𑆴𑆣𑆩𑇀𑇆𑇑𑇐𑇗𑇆
𑆤𑆱𑇀𑆪𑆑𑆫𑇀𑆩𑆓𑆶𑆟𑆳 𑆤𑆱𑇀𑆠𑆂𑆑𑆳𑆫𑇀𑆪𑆁 𑆪𑆖𑇀𑆖 𑆪𑆡𑆳 𑆪𑆢𑆳𑇅 𑆨𑆑𑇀𑆰𑆪𑆼𑆢𑇀𑆢𑆤𑇀𑆠𑆥𑆮𑆤𑆁 𑆪𑆡𑆳 𑆪𑆢𑇀𑆪𑆢𑇀𑆓𑆶𑆟𑆁 𑆖 𑆪𑆠𑇀𑇆𑇑𑇐𑇘𑇆
𑆪𑆢𑆫𑇀𑆡𑆁 𑆪𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪𑆼𑆤 𑆣𑆳𑆫𑇀𑆪𑆳𑆟𑆴 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆼𑇅 𑆠𑆽𑆬𑆱𑇀𑆪 𑆪𑆼 𑆓𑆶𑆟𑆳 𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆯𑆴𑆫𑆱𑇀𑆠𑆽𑆬𑆓𑆶𑆟𑆳𑆯𑇀𑆖 𑆪𑆼𑇆𑇑𑇐𑇙𑇆
𑆑𑆫𑇀𑆟𑆠𑆽𑆬𑆼 𑆠𑆡𑆳𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆥𑆳𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼𑇁𑆕𑇀𑆓𑆩𑆳𑆫𑇀𑆘𑆤𑆼𑇅 𑆱𑇀𑆤𑆳𑆤𑆼 𑆮𑆳𑆱𑆱𑆴 𑆯𑆶𑆢𑇀𑆣𑆼 𑆖 𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆼 𑆫𑆠𑇀𑆤𑆣𑆳𑆫𑆟𑆼𑇆𑇑𑇑𑇐𑇆
𑆯𑆿𑆖𑆼 𑆱𑆁𑆲𑆫𑆟𑆼 𑆬𑆾𑆩𑇀𑆤𑆳𑆁 𑆥𑆳𑆢𑆠𑇀𑆫𑆖𑇀𑆗𑆠𑇀𑆫𑆣𑆳𑆫𑆟𑆼𑇅 𑆓𑆶𑆟𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆯𑆴𑆠𑆵𑆪𑆼𑇁𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆡𑆾𑆑𑇀𑆠𑆳 𑆢𑆟𑇀𑆝𑆣𑆳𑆫𑆟𑆼𑇆𑇑𑇑𑇑𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆯𑆴𑆠𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆠𑆱𑇀𑆪𑆳𑆯𑆴𑆠𑆳𑆢𑇀𑆪𑆳𑆢𑆳𑆲𑆳𑆫𑆳𑆢𑇀𑆧𑆬𑆁 𑆮𑆫𑇀𑆟𑆯𑇀𑆖 𑆮𑆫𑇀𑆣𑆠𑆼𑇅 𑆪𑆱𑇀𑆪𑆫𑇀𑆠𑆶𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆮𑆴𑆢𑆴𑆠𑆁 𑆖𑆼𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆩𑇀𑇆𑇓𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆁 𑆰𑆝𑆕𑇀𑆓𑆩𑆸𑆠𑆶𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆠𑇀𑆪𑆱𑇀𑆪𑆾𑆢𑆓𑆪𑆤𑆩𑆳𑆢𑆳𑆤𑆁 𑆖 𑆠𑇀𑆫𑆵𑆤𑆸𑆠𑆷𑆚𑇀𑆗𑆴𑆯𑆴𑆫𑆳𑆢𑆵𑆤𑇀 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆳𑆤𑇀𑆠𑆳𑆤𑇀 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀, 𑆮𑆫𑇀𑆰𑆳𑆢𑆵𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆲𑆼𑆩𑆤𑇀𑆠𑆳𑆤𑇀𑆠𑆳𑆤𑇀 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆪𑆤𑆁 𑆮𑆴𑆱𑆫𑇀𑆓𑆁 𑆖𑇆𑇔𑇆
𑆮𑆴𑆱𑆫𑇀𑆓𑆼 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆪𑆮𑆾 𑆤𑆳𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆳𑆂 𑆥𑇀𑆫𑆮𑆳𑆤𑇀𑆠𑆴, 𑆅𑆠𑆫𑆼 𑆥𑆶𑆤𑆫𑆳𑆢𑆳𑆤𑆼; 𑆱𑆾𑆩𑆯𑇀𑆖𑆳𑆮𑇀𑆪𑆳𑆲𑆠𑆧𑆬𑆂 𑆯𑆴𑆯𑆴𑆫𑆳𑆨𑆴𑆫𑇀𑆨𑆳𑆨𑆴𑆫𑆳𑆥𑆷𑆫𑆪𑆚𑇀𑆘𑆓𑆢𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆠𑆴 𑆯𑆯𑇀𑆮𑆠𑇀, 𑆃𑆠𑆾 𑆮𑆴𑆱𑆫𑇀𑆓𑆂 𑆱𑆿𑆩𑇀𑆪𑆂𑇅 𑆄𑆢𑆳𑆤𑆁 𑆥𑆶𑆤𑆫𑆳𑆓𑇀𑆤𑆼𑆪𑆁; 𑆠𑆳𑆮𑆼𑆠𑆳𑆮𑆫𑇀𑆑𑆮𑆳𑆪𑆷 𑆱𑆾𑆩𑆯𑇀𑆖 𑆑𑆳𑆬𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆳𑆫𑇀𑆓𑆥𑆫𑆴𑆓𑆸𑆲𑆵𑆠𑆳𑆂 𑆑𑆳𑆬𑆫𑇀𑆠𑆶𑆫𑆱𑆢𑆾𑆰𑆢𑆼𑆲𑆧𑆬𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆨𑆷𑆠𑆳𑆂 𑆱𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆫𑆮𑆴𑆫𑇀𑆨𑆳𑆨𑆴𑆫𑆳𑆢𑆢𑆳𑆤𑆾 𑆘𑆓𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆁 𑆮𑆳𑆪𑆮𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆫𑆷𑆑𑇀𑆰𑆳𑆯𑇀𑆖𑆾𑆥𑆯𑆾𑆰𑆪𑆤𑇀𑆠𑆂 𑆯𑆴𑆯𑆴𑆫𑆮𑆱𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼𑆰𑆶 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆾 𑆫𑆷𑆑𑇀𑆰𑆳𑆤𑇀 𑆫𑆱𑆳𑆁𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆑𑆳𑆁𑆯𑇀𑆖𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆤𑇀𑆠𑆾 𑆤𑆸𑆟𑆳𑆁 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆳𑆮𑆲𑆤𑇀𑆠𑆴𑇆𑇖𑇆
𑆮𑆫𑇀𑆰𑆳𑆯𑆫𑆢𑇀𑆣𑆼𑆩𑆤𑇀𑆠𑆼𑆰𑆶 𑆠𑆶 𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆨𑆴𑆩𑆶𑆒𑆼𑇁𑆫𑇀𑆑𑆼 𑆑𑆳𑆬𑆩𑆳𑆫𑇀𑆓𑆩𑆼𑆔𑆮𑆳𑆠𑆮𑆫𑇀𑆰𑆳𑆨𑆴𑆲𑆠𑆥𑇀𑆫𑆠𑆳𑆥𑆼, 𑆯𑆯𑆴𑆤𑆴 𑆖𑆳𑆮𑇀𑆪𑆳𑆲𑆠𑆧𑆬𑆼, 𑆩𑆳𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆱𑆬𑆴𑆬𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆱𑆤𑇀𑆠𑆳𑆥𑆼 𑆘𑆓𑆠𑆴, 𑆃𑆫𑆷𑆑𑇀𑆰𑆳 𑆫𑆱𑆳𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆣𑆤𑇀𑆠𑆼𑇁𑆩𑇀𑆬𑆬𑆮𑆟𑆩𑆣𑆶𑆫𑆳 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆁 𑆠𑆠𑇀𑆫 𑆧𑆬𑆩𑆶𑆥𑆖𑆵𑆪𑆠𑆼 𑆤𑆸𑆟𑆳𑆩𑆴𑆠𑆴𑇆𑇗𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆢𑆳𑆮𑆤𑇀𑆠𑆼 𑆖 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆮𑆴𑆱𑆫𑇀𑆓𑆳𑆢𑆳𑆤𑆪𑆾𑆫𑇀𑆤𑆸𑆟𑆳𑆩𑇀𑇅 𑆩𑆣𑇀𑆪𑆼 𑆩𑆣𑇀𑆪𑆧𑆬𑆁, 𑆠𑇀𑆮𑆤𑇀𑆠𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆓𑇀𑆫𑆼 𑆖 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇘𑇆
𑆯𑆵𑆠𑆼 𑆯𑆵𑆠𑆳𑆤𑆴𑆬𑆱𑇀𑆥𑆫𑇀𑆯𑆱𑆁𑆫𑆶𑆢𑇀𑆣𑆾 𑆧𑆬𑆴𑆤𑆳𑆁 𑆧𑆬𑆵𑇅 𑆥𑆑𑇀𑆠𑆳 𑆨𑆮𑆠𑆴 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆫𑆶𑆑𑇀𑆰𑆩𑆂𑇆𑇙𑇆
𑆱 𑆪𑆢𑆳 𑆤𑆼𑆤𑇀𑆣𑆤𑆁 𑆪𑆶𑆑𑇀𑆠𑆁 𑆬𑆨𑆠𑆼 𑆢𑆼𑆲𑆘𑆁 𑆠𑆢𑆳𑇅 𑆫𑆱𑆁 𑆲𑆴𑆤𑆱𑇀𑆠𑇀𑆪𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆯𑆵𑆠𑆂 𑆯𑆵𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆴𑇆𑇑𑇐𑇆
𑆓𑆾𑆫𑆱𑆳𑆤𑆴𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆸𑆠𑆵𑆫𑇀𑆮𑆱𑆳𑆁 𑆠𑆽𑆬𑆁 𑆤𑆮𑆿𑆢𑆤𑆩𑇀𑇅 𑆲𑆼𑆩𑆤𑇀𑆠𑆼𑇁𑆨𑇀𑆪𑆱𑇀𑆪𑆠𑆱𑇀𑆠𑆾𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆖𑆳𑆪𑆶𑆫𑇀𑆤 𑆲𑆵𑆪𑆠𑆼𑇆𑇑𑇓𑇆
𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆁 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆠𑆽𑆬𑆁 𑆘𑆼𑆤𑇀𑆠𑆳𑆑𑆩𑆳𑆠𑆥𑆩𑇀𑇅 𑆨𑆘𑆼𑆢𑇀𑆨𑆷𑆩𑆴𑆓𑆸𑆲𑆁 𑆖𑆾𑆰𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆁 𑆓𑆫𑇀𑆨𑆓𑆸𑆲𑆁 𑆠𑆡𑆳𑇆𑇑𑇔𑇆

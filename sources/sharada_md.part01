𑆣𑆳𑆠𑆶𑆑𑇀𑆰𑆪𑆓𑆢𑆑𑆫𑇀𑆰𑆟𑆮𑆩𑆤𑆳𑆢𑇀𑆪𑆠𑆴𑆪𑆾𑆓𑆱𑆷𑆫𑇀𑆪𑆱𑆤𑇀𑆠𑆳𑆥𑆽𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆿 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆿 𑆱𑆿𑆩𑇀𑆪𑆳𑆤𑇀𑆣𑆳𑆠𑆷𑆁𑆯𑇀𑆖 𑆯𑆾𑆰𑆪𑆠𑆂𑇆𑇕𑇆
𑆫𑆱𑆮𑆳𑆲𑆴𑆤𑆵𑆯𑇀𑆖 𑆤𑆳𑆬𑆵𑆫𑇀𑆘𑆴𑆲𑇀𑆮𑆳𑆩𑆷𑆬𑆓𑆬𑆠𑆳𑆬𑆶𑆑𑆑𑇀𑆬𑆾𑆩𑇀𑆤𑆂 𑇅 𑆱𑆁𑆯𑆾𑆰𑇀𑆪 𑆤𑆸𑆟𑆳𑆁 𑆢𑆼𑆲𑆼 𑆑𑆶𑆫𑆶𑆠𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆩𑆲𑆳𑆧𑆬𑆳𑆮𑆼𑆠𑆿𑇆𑇖𑇆
𑆥𑆵𑆠𑆁 𑆥𑆵𑆠𑆁 𑆲𑆴 𑆘𑆬𑆁 𑆯𑆾𑆰𑆪𑆠𑆱𑇀𑆠𑆳𑆮𑆠𑆾 𑆤 𑆪𑆳𑆠𑆴 𑆯𑆩𑆩𑇀𑇅 𑆔𑆾𑆫𑆮𑇀𑆪𑆳𑆣𑆴𑆑𑆸𑆯𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆨𑆮𑆠𑇀𑆪𑆶𑆥𑆱𑆫𑇀𑆓𑆨𑆷𑆠𑆳 𑆱𑆳𑇆𑇗𑇆
𑆥𑇀𑆫𑆳𑆓𑇀𑆫𑆷𑆥𑆁 𑆩𑆶𑆒𑆯𑆾𑆰𑆂, 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆫𑇀𑆮𑆢𑆳𑇁𑆩𑇀𑆧𑆶𑆑𑆳𑆩𑆴𑆠𑇀𑆮𑆩𑇀𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆮𑆳𑆱𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆬𑆳𑆔𑆮𑆩𑆥𑆳𑆪𑆂𑇆𑇘𑇆
𑆩𑆶𑆒𑆯𑆾𑆰𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆨𑇀𑆫𑆩𑆱𑆤𑇀𑆠𑆳𑆥𑆥𑇀𑆫𑆬𑆳𑆥𑆱𑆁𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆤𑇀𑇅 𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆑𑆟𑇀𑆜𑆘𑆴𑆲𑇀𑆮𑆳𑆑𑆫𑇀𑆑𑆯𑆠𑆳𑆁 𑆖𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆁 𑆖𑇆𑇙𑇆
𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆴𑆫𑇀𑆓𑆩𑆩𑆫𑆶𑆖𑆴𑆁 𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆩𑆫𑇀𑆩𑆢𑆷𑆪𑆤𑆁 𑆱𑆳𑆢𑆩𑇀𑇅 𑆠𑆸𑆰𑇀𑆟𑆾𑆢𑇀𑆨𑆷𑆠𑆳 𑆑𑆶𑆫𑆶𑆠𑆼, 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆠𑆂 𑆯𑆸𑆟𑆶 𑆠𑆳𑆩𑇀𑇆𑇑𑇐𑇆
𑆃𑆧𑇀𑆣𑆳𑆠𑆶𑆁 𑆢𑆼𑆲𑆱𑇀𑆡𑆁 𑆑𑆶𑆥𑆴𑆠𑆂 𑆥𑆮𑆤𑆾 𑆪𑆢𑆳 𑆮𑆴𑆯𑆾𑆰𑆪𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆴𑆚𑇀𑆯𑆶𑆰𑇀𑆑𑆼 𑆯𑆶𑆰𑇀𑆪𑆠𑇀𑆪𑆧𑆬𑆱𑇀𑆠𑆸𑆰𑇀𑆪𑆠𑇀𑆪𑆡 𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆤𑇀𑇆𑇑𑇑𑇆
𑆤𑆴𑆢𑇀𑆫𑆳𑆤𑆳𑆯𑆂 𑆯𑆴𑆫𑆱𑆾 𑆨𑇀𑆫𑆩𑆱𑇀𑆠𑆡𑆳 𑆯𑆶𑆰𑇀𑆑𑆮𑆴𑆫𑆱𑆩𑆶𑆒𑆠𑆳 𑆖 𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆮𑆫𑆾𑆣 𑆅𑆠𑆴 𑆖 𑆱𑇀𑆪𑆳𑆬𑇀𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑆳𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆪𑆳𑆂𑇆𑇑𑇒𑇆
𑆥𑆴𑆠𑇀𑆠𑆁 𑆩𑆠𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆁 𑆑𑆶𑆥𑆴𑆠𑆁 𑆖𑆼𑆠𑇀𑆠𑆳𑆥𑆪𑆠𑇀𑆪𑆥𑆳𑆁 𑆣𑆳𑆠𑆶𑆩𑇀𑇅 𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆂 𑆱 𑆲𑆴 𑆘𑆤𑆪𑆼𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆁 𑆢𑆳𑆲𑆾𑆬𑇀𑆧𑆟𑆳𑆁 𑆤𑆹𑆟𑆳𑆩𑇀𑇆𑇑𑇓𑇆
𑆠𑆴𑆑𑇀𑆠𑆳𑆱𑇀𑆪𑆠𑇀𑆮𑆁 𑆯𑆴𑆫𑆱𑆾 𑆢𑆳𑆲𑆂 𑆯𑆵𑆠𑆳𑆨𑆴𑆤𑆤𑇀𑆢𑆠𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑇅 𑆥𑆵𑆠𑆳𑆑𑇀𑆰𑆴𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆩𑆳𑆑𑆸𑆠𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆪𑆳𑆂𑇆𑇑𑇔𑇆
𑆠𑆸𑆰𑇀𑆟𑆳 𑆪𑆳𑇁𑇁𑆩𑆥𑇀𑆫𑆨𑆮𑆳 𑆱𑆳𑇁𑆥𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆳𑇁𑇁𑆩𑆥𑆴𑆠𑇀𑆠𑆘𑆤𑆴𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆬𑆴𑆕𑇀𑆓𑆁 𑆠𑆱𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆫𑆶𑆖𑆴𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆿 𑆖𑇆𑇑𑇕𑇆
𑆢𑆼𑆲𑆾 𑆫𑆱𑆘𑆾𑇁𑆩𑇀𑆧𑆶𑆨𑆮𑆾 𑆫𑆱𑆯𑇀𑆖 𑆠𑆱𑇀𑆪 𑆑𑇀𑆰𑆪𑆳𑆖𑇀𑆖 𑆠𑆸𑆰𑇀𑆪𑆼𑆢𑇀𑆣𑆴𑇅 𑆢𑆵𑆤𑆱𑇀𑆮𑆫𑆂 𑆥𑇀𑆫𑆠𑆳𑆩𑇀𑆪𑆤𑇀 𑆱𑆁𑆯𑆶𑆰𑇀𑆑𑆲𑆸𑆢𑆪𑆓𑆬𑆠𑆳𑆬𑆶𑆂 𑇆𑇑𑇖𑇆
𑆨𑆮𑆠𑆴 𑆒𑆬𑆶 𑆪𑆾𑆥𑆱𑆫𑇀𑆓𑆳𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆳 𑆯𑆾𑆰𑆴𑆟𑆵 𑆑𑆰𑇀𑆛𑆳𑇅 𑆘𑇀𑆮𑆫𑆩𑆼𑆲𑆑𑇀𑆰𑆪𑆯𑆾𑆰𑆯𑇀𑆮𑆳𑆱𑆳𑆢𑇀𑆪𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆢𑆼𑆲𑆳𑆤𑆳𑆩𑇀 𑇆𑇑𑇗𑇆
𑆱𑆫𑇀𑆮𑆳𑆱𑇀𑆠𑇀𑆮𑆠𑆴𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳 𑆫𑆾𑆓𑆑𑆸𑆯𑆳𑆤𑆳𑆁 𑆮𑆩𑆴𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑇀𑇅 𑆔𑆾𑆫𑆾𑆥𑆢𑇀𑆫𑆮𑆪𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆸𑆟𑆳 𑆩𑆫𑆟𑆳𑆪 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂𑇆𑇑𑇘𑇆
𑆤𑆳𑆓𑇀𑆤𑆴𑆁 𑆮𑆴𑆤𑆳 𑆲𑆴 𑆠𑆫𑇀𑆰𑆂 𑆥𑆮𑆤𑆳𑆢𑇀𑆮𑆳 𑆠𑆿 𑆲𑆴 𑆯𑆾𑆰𑆟𑆼 𑆲𑆼𑆠𑆷𑇅 𑆃𑆧𑇀𑆣𑆳𑆠𑆾𑆫𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆮𑆥𑆳𑆁 𑆑𑇀𑆰𑆪𑆼 𑆠𑆸𑆰𑇀𑆪𑆠𑆼 𑆤𑆫𑆾 𑆲𑆴𑇆𑇑𑇙𑇆
𑆓𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆥𑆪𑆂𑆱𑇀𑆤𑆼𑆲𑆽𑆂 𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆢𑇀𑆨𑆴𑆫𑇀𑆮𑆴𑆢𑆳𑆲𑆑𑆳𑆬𑆼 𑆖𑇅 𑆪𑆱𑇀𑆠𑆸𑆰𑇀𑆪𑆼𑆢𑇀𑆮𑆸𑆠𑆩𑆳𑆫𑇀𑆓𑆼 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆤𑆴𑆬𑆳𑆤𑆬𑆿 𑆲𑆼𑆠𑆷𑇆𑇒𑇐𑇆
𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆫𑆷𑆑𑇀𑆰𑆨𑆳𑆮𑆳𑆤𑇀𑆩𑆢𑇀𑆪𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆿 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆠𑆴𑇅 𑆯𑆾𑆰𑆪𑆠𑆾𑇁𑆥𑆳𑆁 𑆣𑆳𑆠𑆶𑆁 𑆠𑆳𑆮𑆼𑆮 𑆲𑆴 𑆩𑆢𑇀𑆪𑆯𑆵𑆬𑆳𑆤𑆳𑆩𑇀𑇆𑇒𑇑𑇆
𑆠𑆥𑇀𑆠𑆳𑆱𑇀𑆮𑆴𑆮 𑆱𑆴𑆑𑆠𑆳𑆱𑆶 𑆲𑆴 𑆠𑆾𑆪𑆩𑆳𑆯𑆶 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆩𑇀𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆲𑆴𑆩𑆘𑆬𑆥𑆳𑆤𑆳𑆢𑇀𑆨𑆮𑆠𑆴 𑆯𑆫𑇀𑆩𑇆𑇒𑇒𑇆
𑆯𑆴𑆯𑆴𑆫𑆱𑇀𑆤𑆳𑆠𑆱𑇀𑆪𑆾𑆰𑇀𑆩𑆳 𑆫𑆶𑆢𑇀𑆣𑆂 𑆑𑆾𑆰𑇀𑆜𑆁 𑆥𑇀𑆫𑆥𑆢𑇀𑆪 𑆠𑆫𑇀𑆰𑆪𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆾𑆰𑇀𑆟𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆾 𑆨𑆘𑆼𑆠 𑆱𑆲𑆱𑆳 𑆘𑆬𑆁 𑆯𑆵𑆠𑆩𑇀 𑇆𑇒𑇓𑇆
𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆫𑇀𑆮𑆳𑆱𑇀𑆮𑆼𑆠𑆳𑆱𑇀𑆮𑆤𑆴𑆬𑆑𑇀𑆰𑆪𑆥𑆴𑆠𑇀𑆠𑆘𑆁 𑆨𑆮𑆠𑇀𑆪𑆡 𑆠𑆶𑇅 𑆥𑆸𑆡𑆓𑆳𑆓𑆩𑆳𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆠𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆠𑆸𑆰𑇀𑆟𑆳𑆤𑆳𑆩𑇀𑇆𑇒𑇔𑇆
𑆃𑆥𑆳𑆁 𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆣𑆴 𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆁𑆯𑆾𑆰𑇀𑆪 𑆤𑆫𑆁 𑆥𑇀𑆫𑆟𑆳𑆯𑆪𑆼𑆢𑆳𑆯𑆶𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆽𑆤𑇀𑆢𑇀𑆫𑆁 𑆠𑆾𑆪𑆁 𑆱𑆩𑆣𑆶 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆢𑇀𑆓𑆶𑆟𑆁 𑆮𑆳𑇁𑆤𑇀𑆪𑆠𑇀𑇆𑇒𑇕𑇆

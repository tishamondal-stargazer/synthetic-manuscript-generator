𑆮𑆑𑇀𑆠𑇀𑆫𑆩𑆳𑆥𑆷𑆫𑇀𑆪𑆠𑆼𑇁𑆯𑇀𑆫𑆷𑆟𑆳𑆁 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆯𑇀𑆖𑆫𑆟𑆳𑆮𑆶𑆨𑆿 𑇅 𑆖𑆑𑇀𑆰𑆶𑆯𑇀𑆖𑆳𑆑𑆶𑆬𑆠𑆳𑆁 𑆪𑆳𑆠𑆴 𑆪𑆩𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆁 𑆓𑆩𑆴𑆰𑇀𑆪𑆠𑆂 𑇆𑇒𑇓𑇆
𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆬𑆔𑆷𑆤𑆴 𑆱𑇀𑆪𑆶𑆫𑇀𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆓𑆶𑆫𑆶𑆑𑆳𑆟𑆴 𑆮𑆳 𑇅 𑆪𑆱𑇀𑆪𑆳𑆑𑆱𑇀𑆩𑆳𑆠𑇀 𑆱 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆓𑆤𑇀𑆠𑆳 𑆮𑆽𑆮𑆱𑇀𑆮𑆠𑆳𑆬𑆪𑆩𑇀 𑇆𑇒𑇔𑇆
𑆥𑆕𑇀𑆑𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆱𑆳𑆠𑆽𑆬𑆔𑆸𑆠𑆓𑆤𑇀𑆣𑆳𑆁𑆯𑇀𑆖 𑆪𑆼 𑆤𑆫𑆳𑆂 𑇅 𑆩𑆸𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆳𑆁𑆯𑇀𑆖 𑆪𑆼 𑆮𑆳𑆤𑇀𑆠𑆴 𑆓𑆤𑇀𑆠𑆳𑆫𑆱𑇀𑆠𑆼 𑆪𑆩𑆳𑆬𑆪𑆩𑇀 𑇆𑇒𑇕𑇆
𑆪𑆷𑆑𑆳 𑆬𑆬𑆳𑆛𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆧𑆬𑆴𑆁 𑆤𑆳𑆯𑇀𑆤𑆤𑇀𑆠𑆴 𑆮𑆳𑆪𑆱𑆳𑆂 𑇅 𑆪𑆼𑆰𑆳𑆁 𑆖𑆳𑆥𑆴 𑆫𑆠𑆴𑆫𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆪𑆳𑆠𑆳𑆫𑆱𑇀𑆠𑆼 𑆪𑆩𑆳𑆬𑆪𑆩𑇀 𑇆𑇒𑇖𑇆
𑆘𑇀𑆮𑆫𑆳𑆠𑆴𑆱𑆳𑆫𑆯𑆾𑆦𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆪𑆱𑇀𑆪𑆳𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆮𑆱𑆳𑆢𑆴𑆤𑆂 𑇅 𑆥𑇀𑆫𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆤𑆳𑆱𑆿 𑆯𑆑𑇀𑆪𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀 𑇆𑇒𑇗𑇆
𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆑𑇀𑆰𑆶𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆼 𑆲𑆸𑆢𑇀𑆪𑆽𑆫𑇀𑆩𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆲𑆴𑆠𑆽𑆱𑇀𑆠𑆡𑆳 𑇅 𑆤 𑆯𑆳𑆩𑇀𑆪𑆠𑆾𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆽𑆯𑇀𑆖 𑆠𑆱𑇀𑆪 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆂 𑇆𑇒𑇘𑇆
𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳 𑆯𑆴𑆫𑆂𑆯𑆷𑆬𑆁 𑆑𑆾𑆰𑇀𑆜𑆯𑆷𑆬𑆁 𑆖 𑆢𑆳𑆫𑆶𑆟𑆩𑇀 𑇅 𑆥𑆴𑆥𑆳𑆱𑆳 𑆧𑆬𑆲𑆳𑆤𑆴𑆯𑇀𑆖 𑆠𑆱𑇀𑆪 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆂 𑇆𑇒𑇙𑇆
𑆮𑆴𑆰𑆩𑆼𑆟𑆾𑆥𑆖𑆳𑆫𑆼𑆟 𑆑𑆫𑇀𑆩𑆨𑆴𑆯𑇀𑆖 𑆥𑆶𑆫𑆳𑆑𑆸𑆠𑆽𑆂 𑇅 𑆃𑆤𑆴𑆠𑇀𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆘𑆤𑇀𑆠𑆷𑆤𑆳𑆁 𑆘𑆵𑆮𑆴𑆠𑆁 𑆤𑆴𑆣𑆤𑆁 𑆮𑇀𑆫𑆘𑆼𑆠𑇀 𑇆𑇓𑇐𑇆
𑆥𑇀𑆫𑆼𑆠𑆳 𑆨𑆷𑆠𑆳𑆂 𑆥𑆴𑆯𑆳𑆖𑆳𑆯𑇀𑆖 𑆫𑆑𑇀𑆰𑆳𑆁𑆱𑆴 𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑆴 𑆖 𑇅 𑆩𑆫𑆟𑆳𑆨𑆴𑆩𑆶𑆒𑆁 𑆤𑆴𑆠𑇀𑆪𑆩𑆶𑆥𑆱𑆫𑇀𑆥𑆤𑇀𑆠𑆴 𑆩𑆳𑆤𑆮𑆩𑇀 𑇆𑇓𑇑𑇆
𑆠𑆳𑆤𑆴 𑆨𑆼𑆰𑆘𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆠𑆴𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆘𑆴𑆔𑆳𑆁𑆱𑆪𑆳 𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆾𑆔𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆱𑆫𑇀𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆼𑆮 𑆓𑆠𑆳𑆪𑆶𑆰𑆳𑆩𑇀 𑇆𑇓𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑇀𑆮𑆨𑆳𑆮𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆯𑆫𑆵𑆫𑆽𑆑𑆢𑆼𑆯𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆨𑆳𑆮𑆴𑆠𑇀𑆮𑆁 𑆩𑆫𑆟𑆳𑆪 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆶𑆑𑇀𑆬𑆳𑆤𑆳𑆁 𑆑𑆸𑆰𑇀𑆟𑆠𑇀𑆮𑆁, 𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆯𑆶𑆑𑇀𑆬𑆠𑆳, 𑆫𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆮𑆫𑇀𑆟𑆠𑇀𑆮𑆁, 𑆱𑇀𑆡𑆴𑆫𑆳𑆟𑆳𑆁 𑆩𑆸𑆢𑆶𑆠𑇀𑆮𑆁 , 𑆩𑆸𑆢𑆷𑆤𑆳𑆁 𑆱𑇀𑆡𑆴𑆫𑆠𑆳, 𑆖𑆬𑆳𑆤𑆳𑆩𑆖𑆬𑆠𑇀𑆮𑆁, 𑆃𑆖𑆬𑆳𑆤𑆳𑆁 𑆖𑆬𑆠𑆳, 𑆥𑆸𑆡𑆷𑆤𑆳𑆁 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆠𑇀𑆮𑆁, 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆥𑆸𑆡𑆶𑆠𑆳, 𑆢𑆵𑆫𑇀𑆔𑆳𑆟𑆳𑆁 𑆲𑇀𑆫𑆱𑇀𑆮𑆠𑇀𑆮𑆁, 𑆲𑇀𑆫𑆱𑇀𑆮𑆳𑆤𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆠𑆳, 𑆃𑆥𑆠𑆤𑆣𑆫𑇀𑆩𑆴𑆟𑆳𑆁 𑆥𑆠𑆤𑆣𑆫𑇀𑆩𑆴𑆠𑇀𑆮𑆁 , 𑆥𑆠𑆤𑆣𑆫𑇀𑆩𑆴𑆟𑆳𑆩𑆥𑆠𑆤𑆣𑆫𑇀𑆩𑆴𑆠𑇀𑆮𑆩𑆑𑆱𑇀𑆩𑆳𑆠𑇀, 𑆯𑆽𑆠𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆱𑇀𑆤𑆽𑆓𑇀𑆣𑇀𑆪𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆥𑇀𑆫𑆱𑇀𑆠𑆩𑇀𑆨𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆳𑆮𑆱𑆳𑆢𑆤𑆁 𑆖𑆳𑆕𑇀𑆓𑆳𑆤𑆳𑆩𑇀 𑇆𑇓𑇆
𑆱𑇀𑆮𑆼𑆨𑇀𑆪𑆂 𑆱𑇀𑆡𑆳𑆤𑆼𑆨𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆽𑆑𑆢𑆼𑆯𑆳𑆤𑆳𑆩𑆮𑆱𑇀𑆠𑇀𑆫𑆱𑇀𑆠𑆾𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆮𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆥𑆠𑆴𑆠𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆤𑆴𑆫𑇀𑆓𑆠𑆳𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆤𑆴, 𑆥𑇀𑆫𑆮𑆳𑆬𑆮𑆫𑇀𑆟𑆮𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆮𑆳𑇁𑆥𑇀𑆪𑆑𑆱𑇀𑆩𑆳𑆠𑇀, 𑆱𑆴𑆫𑆳𑆟𑆳𑆁 𑆖 𑆢𑆫𑇀𑆯𑆤𑆁 𑆬𑆬𑆳𑆛𑆼, 𑆤𑆳𑆱𑆳𑆮𑆁𑆯𑆼 𑆮𑆳 𑆥𑆴𑆝𑆑𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 , 𑆬𑆬𑆳𑆛𑆼 𑆮𑆳 𑆥𑇀𑆫𑆨𑆳𑆠𑆑𑆳𑆬𑆼 𑆱𑇀𑆮𑆼𑆢𑆂, 𑆤𑆼𑆠𑇀𑆫𑆫𑆾𑆓𑆳𑆢𑇀𑆮𑆴𑆤𑆳 𑆮𑆳𑇁𑆯𑇀𑆫𑆶𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆓𑆾𑆩𑆪𑆖𑆷𑆫𑇀𑆟𑆥𑇀𑆫𑆑𑆳𑆯𑆱𑇀𑆪 𑆮𑆳 𑆫𑆘𑆱𑆾 𑆢𑆫𑇀𑆯𑆤𑆩𑆶𑆠𑇀𑆠𑆩𑆳𑆕𑇀𑆓𑆼 𑆤𑆴𑆬𑆪𑆤𑆁 𑆮𑆳 𑆑𑆥𑆾𑆠𑆑𑆕𑇀𑆑𑆑𑆳𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆳𑆁, 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆳𑆤𑆳𑆁, 𑆠𑆠𑇀𑆥𑇀𑆫𑆟𑆳𑆯𑆾 𑆮𑆳 𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆳𑆤𑆳𑆁, 𑆱𑇀𑆠𑆤𑆩𑆷𑆬𑆲𑆸𑆢𑆪𑆾𑆫𑆂𑆱𑆶 𑆖 𑆯𑆷𑆬𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆪𑆂, 𑆩𑆣𑇀𑆪𑆼 𑆯𑆷𑆤𑆠𑇀𑆮𑆩𑆤𑇀𑆠𑆼𑆰𑆶 𑆥𑆫𑆴𑆩𑇀𑆬𑆳𑆪𑆴𑆠𑇀𑆮𑆁 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆾 𑆮𑆳, 𑆠𑆡𑆳𑇁𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆯𑆾𑆰𑆾𑇁𑆕𑇀𑆓𑆥𑆑𑇀𑆰𑆪𑆾𑆫𑇀𑆮𑆳, 𑆤𑆰𑇀𑆛𑆲𑆵𑆤𑆮𑆴𑆑𑆬𑆮𑆴𑆑𑆸𑆠𑆱𑇀𑆮𑆫𑆠𑆳 𑆮𑆳, 𑆮𑆴𑆮𑆫𑇀𑆟𑆥𑆶𑆰𑇀𑆥𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆮𑆳 𑆢𑆤𑇀𑆠𑆩𑆶𑆒𑆤𑆒𑆯𑆫𑆵𑆫𑆼𑆰𑆶, 𑆪𑆱𑇀𑆪 𑆮𑆳𑇁𑆥𑇀𑆱𑆶 𑆑𑆦𑆥𑆶𑆫𑆵𑆰𑆫𑆼𑆠𑆳𑆁𑆱𑆴 𑆤𑆴𑆩𑆘𑇀𑆘𑆤𑇀𑆠𑆴, 𑆪𑆱𑇀𑆪 𑆮𑆳 𑆢𑆸𑆰𑇀𑆛𑆴𑆩𑆟𑇀𑆝𑆬𑆼 𑆨𑆴𑆤𑇀𑆤𑆮𑆴𑆑𑆸𑆠𑆳𑆤𑆴 𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆳𑆬𑆾𑆑𑇀𑆪𑆤𑇀𑆠𑆼, 𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆑𑆼𑆯𑆳𑆕𑇀𑆓 𑆅𑆮 𑆪𑆾 𑆨𑆳𑆠𑆴, 𑆪𑆯𑇀𑆖 𑆢𑆶𑆫𑇀𑆧𑆬𑆾 𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆳𑆠𑆴𑆱𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆵𑆝𑇀𑆪𑆠𑆼, 𑆑𑆳𑆱𑆩𑆳𑆤𑆯𑇀𑆖 𑆠𑆸𑆰𑇀𑆟𑆳𑆨𑆴𑆨𑆷𑆠𑆂, 𑆑𑇀𑆰𑆵𑆟𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆪𑆶𑆑𑇀𑆠𑆂 𑆱𑆦𑆼𑆤𑆥𑆷𑆪𑆫𑆶𑆣𑆴𑆫𑆾𑆢𑇀𑆮𑆳𑆩𑆵 𑆲𑆠𑆱𑇀𑆮𑆫𑆂 𑆯𑆷𑆬𑆳𑆨𑆴𑆥𑆤𑇀𑆤𑆯𑇀𑆖 𑆩𑆤𑆶𑆰𑇀𑆪𑆂, 𑆯𑆷𑆤𑆑𑆫𑆖𑆫𑆟𑆮𑆢𑆤𑆂𑆑𑇀𑆰𑆵𑆟𑆾𑇁𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰𑆵 𑆱𑇀𑆫𑆱𑇀𑆠𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆳𑆁𑆱𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆾 𑆘𑇀𑆮𑆫𑆑𑆳𑆱𑆳𑆨𑆴𑆨𑆷𑆠𑆂, 𑆪𑆱𑇀𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆨𑆶𑆑𑇀𑆠𑆩𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆗𑆫𑇀𑆢𑆪𑆠𑇀𑆪𑆮𑆴𑆢𑆓𑇀𑆣𑆩𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼 𑆮𑆳 𑆱 𑆯𑇀𑆮𑆳𑆱𑆳𑆤𑇀𑆩𑇀𑆫𑆴𑆪𑆠𑆼, 𑆧𑆱𑇀𑆠𑆮𑆢𑇀𑆮𑆴𑆬𑆥𑆤𑇀 𑆪𑆯𑇀𑆖 𑆨𑆷𑆩𑆿 𑆥𑆠𑆠𑆴 𑆱𑇀𑆫𑆱𑇀𑆠𑆩𑆶𑆰𑇀𑆑𑆂, 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆼𑆞𑇀𑆫𑆾 𑆨𑆓𑇀𑆤𑆓𑇀𑆫𑆵𑆮𑆂 𑆥𑇀𑆫𑆤𑆰𑇀𑆛𑆩𑆼𑆲𑆤𑆯𑇀𑆖 𑆩𑆤𑆶𑆰𑇀𑆪𑆂, 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆩𑆳𑆟𑆳𑆲𑆸𑆢𑆪 𑆄𑆫𑇀𑆢𑇀𑆫𑆯𑆫𑆵𑆫𑆂, 𑆪𑆯𑇀𑆖 𑆬𑆾𑆰𑇀𑆛𑆁 𑆬𑆾𑆰𑇀𑆛𑆼𑆤𑆳𑆨𑆴𑆲𑆤𑇀𑆠𑆴 𑆑𑆳𑆰𑇀𑆜𑆁 𑆑𑆳𑆰𑇀𑆜𑆼𑆤, 𑆠𑆸𑆟𑆳𑆤𑆴 𑆮𑆳 𑆗𑆴𑆤𑆠𑇀𑆠𑆴, 𑆃𑆣𑆫𑆾𑆰𑇀𑆜𑆁 𑆢𑆯𑆠𑆴, 𑆇𑆠𑇀𑆠𑆫𑆾𑆰𑇀𑆜𑆁 𑆮𑆳 𑆬𑆼𑆞𑆴, 𑆄𑆬𑆶𑆚𑇀𑆖𑆠𑆴 𑆮𑆳 𑆑𑆫𑇀𑆟𑆿 𑆑𑆼𑆯𑆳𑆁𑆯𑇀𑆖; 𑆢𑆼𑆮𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆱𑆶𑆲𑆸𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆴, 𑆪𑆱𑇀𑆪 𑆮𑆑𑇀𑆫𑆳𑆤𑆶𑆮𑆑𑇀𑆫𑆓𑆳 𑆓𑇀𑆫𑆲𑆳 𑆓𑆫𑇀𑆲𑆴𑆠𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆳𑆂 𑆥𑆵𑆝𑆪𑆤𑇀𑆠𑆴, 𑆘𑆤𑇀𑆩𑆫𑇀𑆑𑇀𑆰𑆁 𑆮𑆳, 𑆪𑆱𑇀𑆪𑆾𑆬𑇀𑆑𑆳𑆯𑆤𑆴𑆨𑇀𑆪𑆳𑆩𑆨𑆴𑆲𑆤𑇀𑆪𑆠𑆼 𑆲𑆾𑆫𑆳 𑆮𑆳, 𑆓𑆸𑆲𑆢𑆳𑆫𑆯𑆪𑆤𑆳𑆱𑆤𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆩𑆟𑆴𑆫𑆠𑇀𑆤𑆾𑆥𑆑𑆫𑆟𑆓𑆫𑇀𑆲𑆴𑆠𑆬𑆑𑇀𑆰𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆮𑆼𑆠𑆴 𑇆𑇔𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆩𑆳𑆤𑆂 𑆱𑆩𑇀𑆪𑆑𑇀 𑆖 𑆮𑆴𑆑𑆳𑆫𑆾 𑆪𑆾𑇁𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑇅 𑆥𑇀𑆫𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆁 𑆠𑆢𑇀𑆓𑆠𑆳𑆪𑆶𑆰𑆂 𑇆𑇕𑇆
𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆂 𑆱𑆲𑆱𑆳 𑆪𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇅 𑆤 𑆖𑆳𑆲𑆳𑆫𑆦𑆬𑆁 𑆪𑆱𑇀𑆪 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑆱 𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑆴 𑇆𑇖𑇆
𑆍𑆠𑆳𑆤𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆫𑆷𑆥𑆳𑆟𑆴 𑆱𑆩𑇀𑆪𑆓𑇀 𑆧𑆶𑆣𑇀𑆪𑆼𑆠 𑆪𑆾 𑆨𑆴𑆰𑆑𑇀 𑇅 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆪𑆳𑆁 𑆱 𑆫𑆳𑆘𑇀𑆚𑆂 𑆱𑆩𑇀𑆩𑆠𑆾 𑆨𑆮𑆼𑆠𑇀 𑇆𑇗𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆮𑆳𑆫𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆

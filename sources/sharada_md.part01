𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆠𑆼 𑆗𑆫𑇀𑆢𑆪𑆠𑆴 𑆑𑆩𑇀𑆥𑆠𑆼𑇁𑆡 𑆮𑆴𑆩𑆶𑆲𑇀𑆪𑆠𑆴 𑇅 𑆃𑆮𑆴𑆥𑆳𑆑𑆳𑆢𑇀𑆨𑆮𑆼𑆖𑇀𑆗𑆷𑆬𑆱𑇀𑆠𑇀𑆮𑆤𑇀𑆤𑆢𑆾𑆰𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆂 𑇆𑇑𑇔𑇔𑇆
𑆮𑆩𑆤𑆁 𑆬𑆕𑇀𑆔𑆤𑆁 𑆱𑇀𑆮𑆼𑆢𑆂 𑆥𑆳𑆖𑆤𑆁 𑆦𑆬𑆮𑆫𑇀𑆠𑆪𑆂 𑇅 𑆑𑇀𑆰𑆳𑆫𑆳𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆓𑆶𑆛𑆴𑆑𑆳𑆂 𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆯𑆷𑆬𑆤𑆳𑆯𑆤𑆳𑆂 𑇆𑇑𑇔𑇕𑇆
𑆓𑆶𑆬𑇀𑆩𑆳𑆮𑆱𑇀𑆡𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆑𑆳𑆫𑇀𑆪𑆳 𑆪𑆡𑆳𑆮𑆠𑇀 𑆱𑆫𑇀𑆮𑆯𑆷𑆬𑆴𑆤𑆳𑆩𑇀 𑇆𑇑𑇔𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆼𑆓𑆳𑆔𑆳𑆠𑆾𑆰𑇀𑆟𑆫𑆷𑆑𑇀𑆰𑆳𑆤𑇀𑆤𑆽𑆫𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆾𑆥𑆱𑆼𑆮𑆴𑆠𑆽𑆂 𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆽𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆥𑆴(𑆠𑆴) 𑆨𑆾𑆘𑆤𑆽𑆂 𑇆𑇓𑇆
𑆢𑆷𑆰𑆪𑆴𑆠𑇀𑆮𑆳 𑆫𑆱𑆁 𑆢𑆾𑆰𑆳 𑆮𑆴𑆓𑆶𑆟𑆳 𑆲𑆸𑆢𑆪𑆁 𑆓𑆠𑆳𑆂 𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆲𑆸𑆢𑆪𑆼 𑆧𑆳𑆣𑆳𑆁 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆁 𑆠𑆁 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇔𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂 𑆱 𑆢𑆾𑆰𑆽𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆸𑆩𑆴𑆨𑆴𑆯𑇀𑆖 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀 𑇅 𑆬𑆑𑇀𑆰𑆟𑆁 𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇆𑇕𑇆
𑆄𑆪𑆩𑇀𑆪𑆠𑆼 𑆩𑆳𑆫𑆶𑆠𑆘𑆼 𑆲𑆸𑆢𑆪𑆁 𑆠𑆶𑆢𑇀𑆪𑆠𑆼 𑆠𑆡𑆳 𑇅 𑆤𑆴𑆫𑇀𑆩𑆡𑇀𑆪𑆠𑆼 𑆢𑆵𑆫𑇀𑆪𑆠𑆼 𑆖 𑆱𑇀𑆦𑆾𑆛𑇀𑆪𑆠𑆼 𑆥𑆳𑆛𑇀𑆪𑆠𑆼𑇁𑆥𑆴 𑆖 𑇆𑇖𑇆
𑆠𑆸𑆰𑇀𑆟𑆾𑆰𑆳𑆢𑆳𑆲𑆖𑆾𑆰𑆳𑆂 𑆱𑇀𑆪𑆶𑆂 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆲𑆸𑆢𑆪𑆑𑇀𑆬𑆩𑆂 𑇅 𑆣𑆷𑆩𑆳𑆪𑆤𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖 𑆱𑇀𑆮𑆼𑆢𑆂 𑆯𑆾𑆰𑆾 𑆩𑆶𑆒𑆱𑇀𑆪 𑆖 𑇆𑇗𑇆
𑆓𑆿𑆫𑆮𑆁 𑆑𑆦𑆱𑆁𑆱𑇀𑆫𑆳𑆮𑆾𑇁𑆫𑆶𑆖𑆴𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆾𑇁𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑇀𑆢𑆮𑆩𑇀 𑇅 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆥𑆴 𑆖𑆳𑇁𑇁𑆱𑇀𑆪𑆱𑇀𑆪 𑆧𑆬𑆳𑆱𑆳𑆮𑆠𑆠𑆼 𑆲𑆸𑆢𑆴 𑇆𑇘𑇆
𑆮𑆳𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆲𑆸𑆢𑆪𑆼 𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆳𑆠𑆶𑆫𑆩𑇀 𑇅 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆱𑆱𑇀𑆤𑆼𑆲𑆬𑆮𑆟𑆼𑆤 𑆠𑆶 𑇆𑇑𑇑𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆼𑆬𑆳𑆮𑆖𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆪𑆮𑆨𑆱𑇀𑆩𑆳𑆤𑆴 𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀 𑇅 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆩𑆡𑆾 𑆯𑆶𑆟𑇀𑆜𑆵𑆩𑆘𑆩𑆾𑆢𑆳𑆁 𑆖 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑇀 𑇆𑇑𑇒𑇆
𑆦𑆬𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆑𑆿𑆬𑆠𑇀𑆡𑆢𑆣𑆴𑆩𑆢𑇀𑆪𑆳𑆱𑆮𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆥𑆳𑆪𑆪𑆼𑆠 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆁 𑆖 𑆱𑇀𑆤𑆼𑆲𑆼𑆤𑆳𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆮𑆳 𑇆𑇑𑇓𑇆
𑆨𑆾𑆘𑆪𑆼𑆘𑇀𑆘𑆵𑆫𑇀𑆟𑆯𑆳𑆬𑇀𑆪𑆤𑇀𑆤𑆁 𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆂 𑆱𑆔𑆸𑆠𑆽 𑆫𑆱𑆽𑆂 𑇅 𑆮𑆳𑆠𑆔𑇀𑆤𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁 𑆖 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆠𑆂 𑇆𑇑𑇔𑇆
𑆯𑇀𑆫𑆵𑆥𑆫𑇀𑆟𑆵𑆩𑆣𑆶𑆑𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆴𑆠𑆾𑆠𑇀𑆥𑆬𑆘𑆬𑆽𑆫𑇀𑆮𑆩𑆼𑆠𑇀 𑇅 𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆼 𑆲𑆸𑆢𑆪𑆼 𑆱𑆼𑆮𑆼𑆠 𑆩𑆣𑆶𑆫𑆽𑆂 𑆯𑆸𑆠𑆩𑇀 𑇆𑇑𑇕𑇆
𑆖𑆷𑆫𑇀𑆟𑆁 𑆠𑆶 𑆥𑆳𑆪𑆪𑆼𑆠𑆾𑆑𑇀𑆠𑆁 𑆮𑆳𑆠𑆘𑆼 𑆨𑆾𑆘𑆪𑆼𑆖𑇀𑆖 𑆠𑆩𑇀 𑇅 𑆦𑆬𑆳𑆢𑆴𑆩𑆡 𑆩𑆶𑆱𑇀𑆠𑆳𑆢𑆴𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆮𑆳 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂 𑇆𑇑𑇘𑇆
𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆑𑆬𑇀𑆑𑆪𑆶𑆠𑆁 𑆔𑆸𑆠𑆁 𑆮𑆳𑇁𑆥𑆴 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇅 𑆧𑆬𑆳𑆠𑆽𑆬𑆽𑆫𑇀𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆖 𑆧𑆱𑇀𑆠𑆴𑆁 𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆯𑆳𑆫𑆢𑆂 𑇆𑇑𑇙𑇆
𑆑𑆸𑆩𑆴𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆴𑆟𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑆥𑆴𑆯𑆴𑆠𑆿𑆢𑆤𑆩𑇀 𑇅 𑆢𑆣𑇀𑆤𑆳 𑆖 𑆥𑆬𑆬𑆾𑆥𑆼𑆠𑆁 𑆠𑇀𑆫𑇀𑆪𑆲𑆁, 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀 𑇆𑇒𑇐𑇆
𑆱𑆶𑆓𑆤𑇀𑆣𑆴𑆨𑆴𑆂 𑆱𑆬𑆮𑆟𑆽𑆫𑇀𑆪𑆾𑆓𑆽𑆂 𑆱𑆳𑆘𑆳𑆘𑆴𑆯𑆫𑇀𑆑𑆫𑆽𑆂 𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆓𑆳𑆞𑆁 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑆳𑆥𑇀𑆪𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇆𑇒𑇑𑇆
𑆲𑆸𑆢𑆪𑆱𑇀𑆡𑆳𑆂 𑆥𑆠𑆤𑇀𑆠𑇀𑆪𑆼𑆮𑆩𑆣𑆱𑇀𑆠𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆩𑆪𑆾 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆪𑆮𑆳𑆤𑇀𑆤𑆁 𑆮𑆴𑆠𑆫𑆼𑆖𑇀𑆖𑆳𑆱𑇀𑆪 𑆱𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆠𑆂 𑆥𑆫𑆩𑇀 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑇀𑆪𑆮𑆳𑆪𑆩𑆩𑇀𑆬𑆁 𑆬𑆮𑆟𑆳𑆤𑆴 𑆩𑆢𑇀𑆪𑆁 𑆩𑆸𑆢𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆠𑆵𑆮 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑇀 𑇅 𑆤𑆴𑆰𑆼𑆮𑆩𑆳𑆟𑆱𑇀𑆪 𑆮𑆴𑆢𑆷𑆰𑇀𑆪 𑆫𑆑𑇀𑆠𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆢𑆾𑆰𑆳𑆱𑇀𑆠𑇀𑆮𑆖𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆨𑆳𑆮𑆩𑇀 𑇆𑇓𑇆
𑆠𑇀𑆮𑆑𑇀𑆱𑇀𑆦𑆾𑆛𑆤𑆁 𑆰𑇀𑆜𑆵𑆮𑆤𑆓𑆳𑆠𑇀𑆫𑆱𑆳𑆢𑆿 𑆩𑆸𑆢𑇀𑆨𑆑𑇀𑆰𑆟𑆁 𑆥𑇀𑆫𑆼𑆑𑇀𑆰𑆟𑆑𑆷𑆛𑆯𑆾𑆡𑆂 𑇅 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆵𑆠𑆠𑇀𑆮𑆩𑆡𑆳𑆮𑆴𑆥𑆳𑆑𑆾 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆥𑆶𑆫𑆂𑆱𑆫𑆳𑆟𑆴 𑇆𑇕𑇆
𑆱 𑆑𑆳𑆩𑆬𑆳𑆥𑆳𑆤𑆑𑆴𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆂 𑆑𑆶𑆩𑇀𑆨𑆳𑆲𑇀𑆮𑆪𑆾 𑆬𑆳𑆔𑆫(𑆮)𑆑𑆾𑇁𑆬𑆱𑆳𑆒𑇀𑆪𑆂 𑇅 𑆮𑆴𑆨𑆳𑆰𑇀𑆪𑆠𑆼 𑆬𑆑𑇀𑆰𑆟𑆩𑆱𑇀𑆪 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆤𑆴𑆧𑆾𑆣 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆯𑆱𑇀𑆠𑆠𑇀 𑇆𑇖𑇆
𑆑𑆸𑆰𑇀𑆟𑆼𑆑𑇀𑆰𑆟𑆁 𑆑𑆸𑆰𑇀𑆟𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆁 𑆠𑆢𑇀𑆮𑆫𑇀𑆟𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆒𑆳𑆤𑆤𑆁 𑆖 𑇅 𑆮𑆳𑆠𑆼𑆤 𑆥𑆳𑆟𑇀𑆝𑆶𑆁 𑆩𑆤𑆶𑆘𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆽𑆱𑇀𑆠𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆯𑇀𑆖 𑇆𑇗𑇆
𑆥𑆵𑆠𑆼𑆑𑇀𑆰𑆟𑆁 𑆥𑆵𑆠𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆁 𑆠𑆢𑇀𑆮𑆫𑇀𑆟𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆒𑆳𑆤𑆤𑆁 𑆖 𑇅 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆥𑆳𑆟𑇀𑆝𑆶𑆁 𑆩𑆤𑆶𑆘𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆽𑆱𑇀𑆠𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆯𑇀𑆖 𑇆𑇘𑇆
𑆯𑆶𑆑𑇀𑆬𑆼𑆑𑇀𑆰𑆟𑆁 𑆯𑆶𑆑𑇀𑆬𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆁 𑆠𑆢𑇀𑆮𑆫𑇀𑆟𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆒𑆳𑆤𑆤𑆁 𑆖 𑇅 𑆑𑆦𑆼𑆤 𑆥𑆳𑆟𑇀𑆝𑆶𑆁 𑆩𑆤𑆶𑆘𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆽𑆱𑇀𑆠𑆢𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆯𑇀𑆖 𑇆𑇙𑇆
𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆱𑇀𑆠𑆼𑆰𑇀𑆮𑆫𑆶𑆖𑆴𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆾 𑆩𑆷𑆫𑇀𑆣𑆫𑆶𑆘𑆳𑇁𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆂 𑇅 𑆯𑆾𑆦𑆱𑇀𑆠𑆡𑆳 𑆑𑆟𑇀𑆜𑆓𑆠𑆾𑇁𑆧𑆬𑆠𑇀𑆮𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆑𑇀𑆬𑆩𑆾 𑆲𑆸𑆢𑇀𑆪𑆮𑆥𑆵𑆝𑆤𑆁 𑆖 𑇆𑇑𑇓𑇆
𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆶 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆴𑆤𑆁 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆔𑆸𑆠𑆼𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆯𑇀𑆖 𑆯𑆶𑆢𑇀𑆣𑆩𑇀 𑇅 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆔𑆸𑆠𑆥𑇀𑆫𑆓𑆳𑆞𑆽𑆫𑇀𑆲𑆫𑆵𑆠𑆑𑆵𑆖𑆷𑆫𑇀𑆟𑆪𑆶𑆠𑆽𑆂 𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆂 𑇆𑇑𑇔𑇆
𑆥𑆴𑆧𑆼𑆢𑇀𑆔𑆸𑆠𑆁 𑆮𑆳 𑆫𑆘𑆤𑆵𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆪𑆠𑇀𑆠𑇀𑆫𑆽𑆦𑆬𑆁 𑆠𑆽𑆬𑇀𑆮𑆑𑆩𑆼𑆮 𑆮𑆳𑇁𑆥𑆴 𑇅 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑆸𑆠𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑆪𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆮𑆽𑆫𑆼𑆖𑆤𑆴𑆑𑆳𑆤𑇀 𑆔𑆸𑆠𑆼𑆤 𑇆𑇑𑇕𑇆
𑆩𑆷𑆠𑇀𑆫𑆼 𑆤𑆴𑆑𑆶𑆩𑇀𑆨𑆳𑆫𑇀𑆣𑆥𑆬𑆁 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆥𑆴𑆧𑆼𑆢𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆑𑆶𑆝𑆮𑆳𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆩𑇀 𑇅 𑆒𑆳𑆢𑆼𑆢𑇀𑆓𑆶𑆝𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆨𑆪𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆩𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑇀𑆮𑆡𑆴𑆠𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑇆𑇑𑇖𑇆
𑆃𑆪𑆾𑆫𑆘𑆾𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆝𑆕𑇀𑆓𑆖𑆷𑆫𑇀𑆟𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆣𑆫𑆴𑆢𑇀𑆫𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆳𑆁 𑆮𑆳 𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆨𑇀𑆪𑆳𑆁 𑆮𑆴𑆢𑆣𑆵𑆠 𑆮𑆳𑇁𑆥𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆢𑆼𑆯𑆳𑆨𑆴𑆲𑆴𑆠𑆳𑆁𑆯𑇀𑆖 𑆪𑆾𑆓𑆳𑆤𑇀 𑇆𑇑𑇗𑇆
𑆇𑆩𑆼 𑆧𑆸𑆲𑆠𑇀𑆪𑆿 𑆫𑆘𑆤𑆵𑆁 𑆯𑆶𑆑𑆳𑆒𑇀𑆪𑆳𑆁 𑆑𑆳𑆑𑆳𑆢𑆤𑆵𑆁 𑆖𑆳𑆥𑆴 𑆱𑆑𑆳𑆑𑆩𑆳𑆖𑆵𑆩𑇀 𑇅 𑆄𑆢𑆳𑆫𑆴𑆧𑆴𑆩𑇀𑆧𑆵𑆁 𑆱𑆑𑆢𑆩𑇀𑆧𑆥𑆶𑆰𑇀𑆥𑆵𑆁 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆴𑆥𑆖𑆼𑆠𑇀 𑆑𑆰𑆳𑆪𑆼 𑇆𑇑𑇙𑇆
𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆢𑆬𑆳𑆤𑆳𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑇁𑆪𑆱𑆁 𑆖𑆷𑆫𑇀𑆟𑆩𑆤𑆬𑇀𑆥𑆑𑆳𑆬𑆩𑇀 𑇅 𑆥𑇀𑆫𑆮𑆳𑆬𑆩𑆶𑆑𑇀𑆠𑆳𑆚𑇀𑆘𑆤𑆯𑆕𑇀𑆒𑆖𑆷𑆫𑇀𑆟𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀𑆠𑆡𑆳 𑆑𑆳𑆚𑇀𑆖𑆤𑆓𑆽𑆫𑆴𑆑𑆾𑆠𑇀𑆡𑆩𑇀 𑇆𑇒𑇑𑇆
𑆄𑆘𑆁 𑆯𑆑𑆸𑆠𑇀𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆶𑆝𑆮𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆮𑆴𑆝𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳 𑆬𑆮𑆟𑆾𑆠𑇀𑆠𑆩𑆁 𑆖 𑇅 𑆥𑆸𑆡𑆑𑇀 𑆥𑆬𑆳𑆁𑆯𑆳𑆤𑆴 𑆱𑆩𑆓𑇀𑆫𑆩𑆼𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆲𑆴𑆠𑆳𑆯𑆵 𑆩𑆣𑆶𑆤𑆳𑇁𑆮𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆩𑆟𑇀𑆝𑆷𑆫𑆬𑆾𑆲𑆳𑆓𑇀𑆤𑆴𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆡𑇀𑆪𑆳𑆮𑇀𑆪𑆾𑆰𑆳𑆁𑆯𑆑𑆂 𑆱𑆫𑇀𑆮𑆱𑆩𑆳𑆤𑆠𑆳𑆥𑇀𑆪𑆂 𑇅 𑆩𑆷𑆠𑇀𑆫𑆳𑆱𑆶𑆠𑆾𑇁𑆪𑆁 𑆩𑆣𑆶𑆤𑆳𑇁𑆮𑆬𑆼𑆲𑆂 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆁 𑆲𑆤𑇀𑆠𑇀𑆪𑆖𑆴𑆫𑆼𑆟 𑆔𑆾𑆫𑆩𑇀 𑇆𑇒𑇓𑇆
𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆪𑆾𑆩𑆬𑆤𑆳𑆓𑆫𑆳𑆟𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆠𑆴𑆬𑆳𑆤𑆳𑆁 𑆖 𑆓𑆶𑆝𑆯𑇀𑆖 𑆩𑆶𑆒𑇀𑆪𑆂 𑇅 𑆠𑆑𑇀𑆫𑆳𑆤𑆶𑆥𑆳𑆤𑆾 𑆮𑆛𑆑𑆂 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑆑𑇀𑆰𑆴𑆟𑆾𑆠𑆴 𑆔𑆾𑆫𑆳𑆤𑆥𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆤𑇀 𑇆𑇒𑇔𑇆
𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆲𑆴𑆕𑇀𑆓𑆶 𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆁 𑆑𑆬𑆳𑆪𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆮𑆳 𑇅 𑆩𑆷𑆫𑇀𑆮𑆳𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆬𑆑𑆁 𑆖 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆡𑆴𑆠𑆁 𑆓𑆮𑆳𑆁 𑆱𑆥𑇀𑆠𑆢𑆴𑆤𑆳𑆤𑆴 𑆩𑆷𑆠𑇀𑆫𑆼 𑇆𑇒𑇕𑇆
𑆩𑆷𑆬𑆁 𑆧𑆬𑆳𑆖𑆴𑆠𑇀𑆫𑆑𑆪𑆾𑆂 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆳𑆫𑇀𑆠𑆾𑇁𑆑𑇀𑆰𑆱𑆩𑆁 𑆲𑆴𑆠𑆳𑆯𑆵 𑇅 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆮𑆳 𑆬𑆮𑆟𑆼𑆤 𑆠𑆶𑆬𑇀𑆪𑆁 𑆯𑆴𑆓𑇀𑆫𑆾𑆂 𑆦𑆬𑆁 𑆑𑇀𑆰𑆵𑆫𑆨𑆶𑆘𑆾𑆥𑆪𑆾𑆘𑇀𑆪𑆩𑇀 𑇆𑇒𑇖𑇆

𑆪𑆘𑇀𑆘𑆳𑆪𑆠𑆼𑇁𑆤𑇀𑆪𑆠𑇀 𑆒𑆬𑆶 𑆥𑆷𑆫𑇀𑆮𑆘𑆳𑆠𑆼 𑆘𑇀𑆚𑆼𑆪𑆁 𑆠𑆢𑆣𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆩𑆫𑇀𑆧𑆶𑆢𑆘𑇀𑆚𑆽𑆂 𑇅 𑆪𑆢𑇀𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆘𑆳𑆠𑆁 𑆪𑆶𑆓𑆥𑆠𑇀 𑆑𑇀𑆫𑆩𑆳𑆢𑇀𑆮𑆳 𑆢𑇀𑆮𑆴𑆫𑆫𑇀𑆧𑆶𑆢𑆁 𑆠𑆖𑇀𑆖 𑆨𑆮𑆼𑆢𑆱𑆳𑆣𑇀𑆪𑆩𑇀 𑇆𑇒𑇐𑇆
𑆤 𑆥𑆳𑆑𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆑𑆦𑆳𑆣𑆴𑆑𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆼𑆢𑆾𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑇅 𑆢𑆾𑆰𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑇀𑆫𑆡𑆤𑆳𑆖𑇀𑆖 𑆠𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆮𑆳𑆫𑇀𑆧𑆶𑆢𑆳𑆤𑇀𑆪𑆼𑆮 𑆤𑆴𑆱𑆫𑇀𑆓𑆠𑆱𑇀𑆠𑆶 𑇆𑇒𑇑𑇆
𑆮𑆳𑆠𑆂 𑆑𑆦𑆯𑇀𑆖𑆽𑆮 𑆓𑆬𑆼 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆿 𑆩𑆤𑇀𑆪𑆼 𑆠𑆶 𑆱𑆁𑆱𑆸𑆠𑇀𑆪 𑆠𑆡𑆽𑆮 𑆩𑆼𑆢𑆂 𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆓𑆟𑇀𑆝𑆁 𑆑𑇀𑆫𑆩𑆯𑆂 𑆱𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆽𑆂 𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆁 𑆠𑆁 𑆓𑆬𑆓𑆟𑇀𑆝𑆩𑆳𑆲𑆶𑆂 𑇆𑇒𑇒𑇆
𑆠𑆾𑆢𑆳𑆤𑇀𑆮𑆴𑆠𑆂 𑆑𑆸𑆰𑇀𑆟𑆱𑆴𑆫𑆳𑆮𑆤𑆢𑇀𑆣𑆂 𑆑𑆸𑆰𑇀𑆟𑆾𑇁𑆫𑆶𑆟𑆾 𑆮𑆳 𑆥𑆮𑆤𑆳𑆠𑇀𑆩𑆑𑆱𑇀𑆠𑆶 𑇅 𑆩𑆼𑆢𑆾𑆤𑇀𑆮𑆴𑆠𑆯𑇀𑆖𑆾𑆥𑆖𑆴𑆠𑆯𑇀𑆖 𑆑𑆳𑆬𑆳𑆢𑇀𑆨𑆮𑆼𑆢𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆠𑆫𑆾𑇁𑆫𑆶𑆘𑆯𑇀𑆖 𑇆𑇒𑇓𑇆
𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆯𑇀𑆖𑆴𑆫𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆥𑆳𑆑𑆾 𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆳 𑆥𑆳𑆑𑆩𑆴𑆪𑆳𑆠𑇀 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑆮𑆽𑆫𑆱𑇀𑆪𑆩𑆳𑆱𑇀𑆪𑆱𑇀𑆪 𑆖 𑆠𑆱𑇀𑆪 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆨𑆮𑆼𑆠𑇀𑆠𑆡𑆳 𑆠𑆳𑆬𑆶𑆓𑆬𑆥𑇀𑆫𑆯𑆾𑆰𑆂 𑇆𑇒𑇔𑇆
𑆱𑇀𑆡𑆴𑆫𑆂 𑆱𑆮𑆫𑇀𑆟𑆾𑇁𑆬𑇀𑆥𑆫𑆶𑆓𑆶𑆓𑇀𑆫𑆑𑆟𑇀𑆝𑆷𑆂 𑆯𑆵𑆠𑆾 𑆩𑆲𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆱𑇀𑆠𑆶 𑇅 𑆖𑆴𑆫𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆖𑆴𑆫𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆥𑆖𑇀𑆪𑆠𑆼 𑆩𑆤𑇀𑆢𑆫𑆶𑆘𑆂 𑆑𑆢𑆳𑆖𑆴𑆠𑇀 𑇆𑇒𑇕𑇆
𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆳𑆱𑇀𑆪𑆱𑇀𑆪 𑆖 𑆠𑆱𑇀𑆪 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆨𑆮𑆼𑆠𑇀𑆠𑆡𑆳 𑆠𑆳𑆬𑆶𑆓𑆬𑆥𑇀𑆫𑆬𑆼𑆥𑆂 𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆩𑆸𑆢𑆶𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆤𑆴𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆾 𑆩𑆼𑆢𑆂𑆑𑆸𑆠𑆾 𑆤𑆵𑆫𑆶𑆓𑆡𑆳𑆠𑆴𑆑𑆟𑇀𑆝𑆷𑆂 𑇆𑇒𑇖𑇆
𑆥𑇀𑆫𑆬𑆩𑇀𑆧𑆠𑆼𑇁𑆬𑆳𑆧𑆶𑆮𑆢𑆬𑇀𑆥𑆩𑆷𑆬𑆾 𑆢𑆼𑆲𑆳𑆤𑆶𑆫𑆷𑆥𑆑𑇀𑆰𑆪𑆮𑆸𑆢𑇀𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆂 𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆱𑇀𑆪𑆠𑆳 𑆠𑆱𑇀𑆪 𑆨𑆮𑆼𑆖𑇀𑆖 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆓𑆬𑆼𑇁𑆤𑆶𑆯𑆧𑇀𑆢𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆖 𑆤𑆴𑆠𑇀𑆪𑆩𑇀 𑇆𑇒𑇗𑇆
𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆖𑇀𑆗𑇀𑆮𑆱𑆤𑇀𑆠𑆁 𑆩𑆸𑆢𑆶𑆱𑆫𑇀𑆮𑆓𑆳𑆠𑇀𑆫𑆁 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆠𑆵𑆠𑆩𑆫𑆾𑆖𑆑𑆳𑆫𑇀𑆠𑆩𑇀 𑇅 𑆑𑇀𑆰𑆵𑆟𑆁 𑆖 𑆮𑆽𑆢𑇀𑆪𑆾 𑆓𑆬𑆓𑆟𑇀𑆝𑆴𑆤𑆁 𑆠𑆶 𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆮𑆫𑆁 𑆖𑆽𑆮 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑆠𑆶 𑇆𑇒𑇘𑇆
𑆤𑆴𑆧𑆢𑇀𑆣𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆪𑆱𑇀𑆪 𑆩𑆶𑆰𑇀𑆑𑆮𑆬𑇀𑆬𑆩𑇀𑆧𑆠𑆼 𑆓𑆬𑆼 𑇅 𑆩𑆲𑆳𑆤𑇀 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳 𑆲𑇀𑆫𑆱𑇀𑆮𑆾 𑆓𑆬𑆓𑆟𑇀𑆝𑆁 𑆠𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆢𑆁𑆯𑆯𑇀𑆬𑆵𑆥𑆢𑆳𑆤𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆾𑆟𑆴𑆠𑆩𑆼𑆢𑆾𑆩𑆷𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑇀𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆱𑆥𑇀𑆠 𑆮𑆸𑆢𑇀𑆣𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑇀𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼 𑆮𑆸𑆢𑇀𑆣𑆵 𑆮𑆳𑆠𑆱𑆩𑆶𑆠𑇀𑆡𑆼, 𑆑𑆼𑆮𑆬𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆫𑆤𑇀𑆪𑆠𑆩𑆂 𑇆𑇓𑇆
𑆃𑆣𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆾 𑆲𑆴 𑆢𑆾𑆰𑆂 𑆦𑆬𑆑𑆾𑆯𑆮𑆳𑆲𑆴𑆤𑆵𑆫𑆨𑆴𑆥𑇀𑆫𑆥𑆢𑇀𑆪 𑆣𑆩𑆤𑆵𑆂 𑆦𑆬𑆑𑆾𑆰𑆪𑆾𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆠𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇔𑇆
𑆠𑆳𑆱𑆳𑆁 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆵𑆤𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴- 𑆧𑆱𑇀𑆠𑆴𑆑𑆛𑆵𑆩𑆶𑆰𑇀𑆑𑆩𑆼𑆞𑇀𑆫𑆼𑆰𑆶 𑆮𑆼𑆢𑆤𑆳 𑆩𑆳𑆫𑆶𑆠𑆤𑆴𑆓𑇀𑆫𑆲𑆂 𑆦𑆬𑆑𑆾𑆯𑆯𑆾𑆦𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆳𑆁 𑆧𑆱𑇀𑆠𑆴𑆩𑆴𑆮𑆳𑆠𑆠𑆳𑆁 𑆥𑆫𑆶𑆰𑆳𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆫𑆶𑆘𑆳𑆁 𑆮𑆳𑆠𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆥𑆑𑇀𑆮𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆱𑆕𑇀𑆑𑆳𑆯𑆳𑆁 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆾𑆰𑇀𑆩𑆮𑆠𑆵𑆁 𑆖𑆳𑆯𑆶𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆥𑆳𑆑𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆸𑆢𑇀𑆣𑆴𑆁; 𑆑𑆜𑆴𑆤𑆳𑆩𑆬𑇀𑆥𑆮𑆼𑆢𑆤𑆳𑆁 𑆯𑆵𑆠𑆳𑆁 𑆑𑆟𑇀𑆝𑆷𑆩𑆠𑆵𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆸𑆢𑇀𑆣𑆴𑆁; 𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆦𑆾𑆛𑆳𑆮𑆸𑆠𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆸𑆢𑇀𑆣𑆴𑆬𑆴𑆕𑇀𑆓𑆳𑆁 𑆫𑆑𑇀𑆠𑆮𑆸𑆢𑇀𑆣𑆴𑆁, 𑆩𑆸𑆢𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆁 𑆑𑆟𑇀𑆝𑆷𑆩𑆠𑆵𑆩𑆬𑇀𑆥𑆮𑆼𑆢𑆤𑆳𑆁 𑆠𑆳𑆬𑆦𑆬𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆁 𑆩𑆼𑆢𑆾𑆮𑆸𑆢𑇀𑆣𑆴𑆁; 𑆩𑆷𑆠𑇀𑆫𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆯𑆵𑆬𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴, 𑆱𑆳 𑆓𑆖𑇀𑆗𑆠𑆾𑇁𑆩𑇀𑆧𑆶𑆥𑆷𑆫𑇀𑆟𑆳 𑆢𑆸𑆠𑆴𑆫𑆴𑆮 𑆑𑇀𑆰𑆶𑆨𑇀𑆪𑆠𑆴 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆮𑆼𑆢𑆤𑆳𑆁 𑆮𑆸𑆰𑆟𑆪𑆾𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆑𑆾𑆯𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆠𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆨𑆳𑆫𑆲𑆫𑆟𑆧𑆬𑆮𑆢𑇀𑆮𑆴𑆓𑇀𑆫𑆲𑆮𑆸𑆑𑇀𑆰𑆥𑇀𑆫𑆥𑆠𑆤𑆳𑆢𑆴𑆨𑆴𑆫𑆳𑆪𑆳𑆱𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆮𑆳𑆪𑆶𑆫𑆨𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆯𑇀𑆖 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪𑆼𑆠𑆫𑆱𑇀𑆪 𑆖𑆽𑆑𑆢𑆼𑆯𑆁 𑆮𑆴𑆓𑆶𑆟𑆩𑆳𑆢𑆳𑆪𑆳𑆣𑆾 𑆓𑆠𑇀𑆮𑆳 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆱𑆤𑇀𑆣𑆴𑆩𑆶𑆥𑆼𑆠𑇀𑆪 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑆷𑆥𑆼𑆟 𑆱𑇀𑆡𑆴𑆠𑇀𑆮𑆳𑇁𑆥𑇀𑆫𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆼 𑆖 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆦𑆬𑆑𑆾𑆯𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆩𑆶𑆰𑇀𑆑𑆯𑆾𑆦𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆄𑆣𑇀𑆩𑆳𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆫𑆴𑆮𑆳𑆠𑆠𑆂 𑆥𑇀𑆫𑆢𑆵𑆫𑇀𑆔𑆂 𑆱 𑆯𑆾𑆦𑆾 𑆨𑆮𑆠𑆴, 𑆱𑆯𑆧𑇀𑆢𑆩𑆮𑆥𑆵𑆝𑆴𑆠𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆥𑆽𑆠𑆴, 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆯𑇀𑆖 𑆥𑆶𑆤𑆫𑆳𑆣𑇀𑆩𑆳𑆪𑆠𑆼 , 𑆠𑆳𑆩𑆤𑇀𑆠𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆱𑆳𑆣𑇀𑆪𑆳𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆠𑆴𑆩𑆽𑆡𑆶𑆤𑆳𑆢𑆠𑆴𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑆠𑆡𑆳𑇁𑆠𑆴𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑆵𑆁 𑆖𑆴𑆫𑆾𑆠𑇀𑆱𑆸𑆰𑇀𑆛𑆳𑆁 𑆫𑆘𑆱𑇀𑆮𑆬𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆫𑆾𑆩𑆳𑆁 𑆑𑆫𑇀𑆑𑆯𑆫𑆾𑆩𑆳𑆁 𑆱𑆕𑇀𑆑𑆵𑆫𑇀𑆟𑆫𑆾𑆩𑆳𑆁 𑆤𑆴𑆓𑆷𑆞𑆫𑆾𑆩𑆳𑆩𑆬𑇀𑆥𑆢𑇀𑆮𑆳𑆫𑆳𑆁 𑆩𑆲𑆳𑆢𑇀𑆮𑆳𑆫𑆳𑆩𑆥𑇀𑆫𑆴𑆪𑆳𑆩𑆑𑆳𑆩𑆳𑆩𑆖𑆿𑆑𑇀𑆰𑆱𑆬𑆴𑆬𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆪𑆾𑆤𑆴𑆩𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆪𑆾𑆤𑆴𑆁 𑆪𑆾𑆤𑆴𑆫𑆾𑆓𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆾 𑆮𑆳 𑆢𑆶𑆰𑇀𑆛𑆪𑆾𑆤𑆴𑆁 𑆮𑆴𑆪𑆾𑆤𑆴𑆁 𑆮𑆳 𑆤𑆳𑆫𑆵𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆠𑆡𑆳 𑆑𑆫𑆘𑆢𑆯𑆤𑆮𑆴𑆰𑆯𑆷𑆑𑆤𑆴𑆥𑆳𑆠𑆤𑆳𑆢𑇀𑆧𑆤𑇀𑆣𑆤𑆳𑆢𑇀𑆣𑆱𑇀𑆠𑆳𑆨𑆴𑆔𑆳𑆠𑆳𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑆢𑆵𑆓𑆩𑆤𑆳𑆢𑆖𑆿𑆑𑇀𑆰𑆱𑆬𑆴𑆬𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆳𑆢𑆮𑆥𑆵𑆝𑆤𑆳𑆖𑇀𑆗𑇀𑆫𑆶𑆑𑇀𑆫𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆟𑆳𑆤𑇀𑆩𑆽𑆡𑆶𑆤𑆳𑆤𑇀𑆠𑆼 𑆮𑆳𑇁𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆤𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆩𑆼𑆞𑇀𑆫𑆩𑆳𑆓𑆩𑇀𑆪 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆢𑆾𑆰𑆳𑆂 𑆑𑇀𑆰𑆠𑆼𑇁𑆑𑇀𑆰𑆠𑆼 𑆮𑆳 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆶𑆥𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆠𑆩𑆶𑆥𑆢𑆁𑆯𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇗𑇆
𑆱 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆽𑆂 𑆥𑆸𑆡𑆑𑇀 𑆱𑆩𑆱𑇀𑆠𑆽𑆫𑆱𑆸𑆘𑆳 𑆖𑆼𑆠𑆴 𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆴𑆑𑆼 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑆫𑆴𑆥𑆶𑆛𑆤𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆼𑆞𑇀𑆫𑆠𑆳 𑆥𑆫𑆶𑆰𑆯𑆾𑆦𑆠𑆳 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖 𑆮𑆳𑆠𑆮𑆼𑆢𑆤𑆳𑆂; 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆘𑇀𑆮𑆫𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆑𑇀𑆮𑆾𑆝𑆶𑆩𑇀𑆧𑆫𑆱𑆕𑇀𑆑𑆳𑆯𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆢𑆳𑆲𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆥𑆳𑆑𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆼𑆢𑆤𑆳𑆯𑇀𑆖; 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆑𑆟𑇀𑆝𑆷𑆩𑆳𑆤𑇀 𑆑𑆜𑆴𑆤𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆼𑆢𑆤𑆳𑆯𑇀𑆖; 𑆫𑆑𑇀𑆠𑆘𑆼 𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆦𑆾𑆛𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆱𑆸𑆑𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆿 𑆯𑆾𑆰𑆯𑇀𑆖, 𑆪𑆳𑆥𑇀𑆪𑆯𑇀𑆖𑆽𑆮 𑆑𑆢𑆳𑆖𑆴𑆠𑇀; 𑆱𑆫𑇀𑆮𑆘𑆼 𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆢𑆫𑇀𑆯𑆤𑆩𑆮𑆢𑆫𑆟𑆁 𑆖 𑆯𑆼𑆦𑆱𑆂 𑆑𑆸𑆩𑆴𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆩𑆫𑆟𑆁 𑆖𑆼𑆠𑆴 𑇆𑇙𑇆
𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾𑇁𑆣𑆂𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆾𑆫𑆶𑆘𑆳𑆤𑆶𑆘𑆕𑇀𑆔𑆳𑆱𑇀𑆮𑆮𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆳𑆂 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆳𑆢𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆯𑆤𑆽𑆂 𑆯𑆾𑆦𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆠𑆁 𑆯𑇀𑆬𑆵𑆥𑆢𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑇅 𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁- 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑆴 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫, 𑆮𑆳𑆠𑆘𑆁 𑆒𑆫𑆁 𑆑𑆸𑆰𑇀𑆟𑆁 𑆥𑆫𑆶𑆰𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆫𑆶𑆘𑆁 𑆥𑆫𑆴𑆱𑇀𑆦𑆶𑆛𑆠𑆴 𑆖 𑆧𑆲𑆶𑆯𑆂; 𑆥𑆴𑆠𑇀𑆠𑆘𑆁 𑆠𑆶 𑆥𑆵𑆠𑆳𑆮𑆨𑆳𑆱𑆩𑆵𑆰𑆤𑇀𑆩𑆸𑆢𑆶 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆥𑇀𑆫𑆳𑆪𑆁 𑆖; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑆁 𑆠𑆶 𑆯𑇀𑆮𑆼𑆠𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆮𑆨𑆳𑆱𑆁 𑆩𑆤𑇀𑆢𑆮𑆼𑆢𑆤𑆁 𑆨𑆳𑆫𑆴𑆑𑆁 𑆩𑆲𑆳𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆑𑆁 𑆑𑆟𑇀𑆛𑆑𑆽𑆫𑆶𑆥𑆖𑆴𑆠𑆁 𑆖 𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆠𑆵𑆠𑆩𑆠𑆴𑆩𑆲𑆢𑇀𑆮𑆬𑇀𑆩𑆵𑆑𑆘𑆳𑆠𑆁 𑆥𑇀𑆫𑆱𑆸𑆠𑆩𑆴𑆠𑆴 𑆮𑆫𑇀𑆘𑆤𑆵𑆪𑆳𑆤𑆴 𑇆𑇑𑇒𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆥𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆘𑆳𑆤𑆵𑆪𑆳𑆖𑇀𑆗𑇀𑆬𑆵𑆥𑆢𑆳𑆤𑆴 𑆑𑆦𑆾𑆖𑇀𑆗𑇀𑆫𑆪𑆳𑆠𑇀 𑇅 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆖 𑆩𑆲𑆠𑇀𑆠𑇀𑆮𑆁 𑆖 𑆪𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆮𑆴𑆤𑆳 𑆑𑆦𑆳𑆠𑇀 𑇆𑇑𑇓𑇆
𑆥𑆶𑆫𑆳𑆟𑆾𑆢𑆑𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆂 𑆱𑆫𑇀𑆮𑆫𑇀𑆠𑆶𑆰𑆶 𑆖 𑆯𑆵𑆠𑆬𑆳𑆂 𑇅 𑆪𑆼 𑆢𑆼𑆯𑆳𑆱𑇀𑆠𑆼𑆰𑆶 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆯𑇀𑆬𑆵𑆥𑆢𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇑𑇔𑇆
𑆥𑆳𑆢𑆮𑆢𑇀𑆣𑆱𑇀𑆠𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑆴 𑆯𑇀𑆬𑆵𑆥𑆢𑆁 𑆘𑆳𑆪𑆠𑆼 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆤𑆳𑆱𑆴𑆑𑆿𑆰𑇀𑆜𑆼𑆰𑆶 𑆑𑆼𑆖𑆴𑆢𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆠𑆢𑇀𑆮𑆴𑆢𑆂 𑇆𑇑𑇕𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆱𑆩𑆳𑆱𑆼𑆤 𑆖𑆠𑆶𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆫𑆾𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳,- 𑆃𑆘𑆓𑆬𑇀𑆬𑆴𑆑𑆳, 𑆪𑆮𑆥𑇀𑆫𑆒𑇀𑆪𑆳, 𑆃𑆤𑇀𑆣𑆳𑆬𑆘𑆵, 𑆮𑆴𑆮𑆸𑆠𑆳, 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳, 𑆮𑆬𑇀𑆩𑆵𑆑𑆁, 𑆅𑆤𑇀𑆢𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳 , 𑆥𑆤𑆱𑆴𑆑𑆳, 𑆥𑆳𑆰𑆳𑆟𑆓𑆫𑇀𑆢𑆨𑆂, 𑆘𑆳𑆬𑆓𑆫𑇀𑆢𑆨𑆂, 𑆑𑆑𑇀𑆰𑆳 , 𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆑𑆂, 𑆃𑆓𑇀𑆤𑆴𑆫𑆾𑆲𑆴𑆟𑆵, 𑆖𑆴𑆥𑇀𑆥𑆁, 𑆑𑆶𑆤𑆒𑆂, 𑆃𑆤𑆶𑆯𑆪𑆵, 𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆧𑆶𑆢𑆁, 𑆥𑆳𑆩𑆳, 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳, 𑆫𑆑𑆱𑆳, 𑆥𑆳𑆢𑆢𑆳𑆫𑆴𑆑𑆳, 𑆑𑆢𑆫𑆁, 𑆃𑆬𑆱𑆼𑆤𑇀𑆢𑇀𑆫𑆬𑆶𑆥𑇀𑆠𑆿 , 𑆢𑆳𑆫𑆶𑆟𑆑𑆂, 𑆃𑆫𑆶𑆁𑆰𑆴𑆑𑆳, 𑆥𑆬𑆴𑆠𑆁, 𑆩𑆱𑆷𑆫𑆴𑆑𑆳, 𑆪𑆿𑆮𑆤𑆥𑆴𑆝𑆑𑆳, 𑆥𑆢𑇀𑆩𑆴𑆤𑆵𑆑𑆟𑇀𑆛𑆑𑆂, 𑆘𑆠𑆶𑆩𑆟𑆴𑆂, 𑆩𑆯𑆑𑆂, 𑆖𑆫𑇀𑆩𑆑𑆵𑆬𑆂 , 𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆂, 𑆤𑇀𑆪𑆖𑇀𑆗𑆁, 𑆮𑇀𑆪𑆕𑇀𑆓𑆂, 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆴𑆑𑆳, 𑆃𑆮𑆥𑆳𑆛𑆴𑆑𑆳, 𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆥𑇀𑆫𑆑𑆯𑆂 𑆱𑆤𑇀𑆤𑆴𑆫𑆶𑆢𑇀𑆣𑆓𑆶𑆢𑆂, 𑆃𑆲𑆴𑆥𑆷𑆠𑆤𑆁, 𑆮𑆸𑆰𑆟𑆑𑆖𑇀𑆗𑆷𑆂, 𑆓𑆶𑆢𑆨𑇀𑆫𑆁𑆯𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇓𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆱𑆮𑆫𑇀𑆟𑆳 𑆓𑇀𑆫𑆡𑆴𑆠𑆳 𑆤𑆵𑆫𑆶𑆘𑆳 𑆩𑆶𑆢𑇀𑆓𑆱𑆤𑇀𑆤𑆴𑆨𑆳 𑇅 𑆑𑆦𑆮𑆳𑆠𑆾𑆠𑇀𑆡𑆴𑆠𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆧𑆳𑆬𑆳𑆤𑆳𑆩𑆘𑆓𑆬𑇀𑆬𑆴𑆑𑆳 𑇆𑇔𑇆
𑆪𑆮𑆳𑆑𑆳𑆫𑆳 𑆱𑆶𑆑𑆜𑆴𑆤𑆳 𑆓𑇀𑆫𑆡𑆴𑆠𑆳 𑆩𑆳𑆁𑆱𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆳 𑇅 𑆥𑆴𑆝𑆑𑆳 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆪𑆮𑆥𑇀𑆫𑆒𑇀𑆪𑆼𑆠𑆴 𑆱𑆾𑆖𑇀𑆪𑆠𑆼 𑇆𑇕𑇆
𑆔𑆤𑆩𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆁 𑆥𑆴𑆝𑆑𑆳𑆩𑆶𑆤𑇀𑆤𑆠𑆳𑆁 𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆳𑆩𑇀 𑇅 𑆃𑆤𑇀𑆣𑆳𑆬𑆘𑆵𑆩𑆬𑇀𑆥𑆥𑆷𑆪𑆳𑆁 𑆠𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆦𑆮𑆳𑆠𑆘𑆳𑆩𑇀 𑇆𑇖𑇆
𑆮𑆴𑆮𑆸𑆠𑆳𑆱𑇀𑆪𑆳𑆁 𑆩𑆲𑆳𑆢𑆳𑆲𑆳𑆁 𑆥𑆑𑇀𑆮𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆱𑆤𑇀𑆤𑆴𑆨𑆳𑆩𑇀 𑇅 𑆮𑆴𑆮𑆸𑆠𑆳𑆩𑆴𑆠𑆴 𑆠𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆡𑆳𑆁 𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆳𑆩𑇀 𑇆𑇗𑇆
𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆂 𑆥𑆚𑇀𑆖 𑆮𑆳 𑆰𑆝𑇀𑆮𑆳 𑆢𑆳𑆫𑆶𑆟𑆳𑆂 𑆑𑆖𑇀𑆗𑆥𑆾𑆤𑇀𑆤𑆠𑆳𑆂 𑇅 𑆑𑆦𑆳𑆤𑆴𑆬𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆴𑆝𑆑𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳 𑆧𑆶𑆣𑆽𑆂 𑇆𑇘𑇆
𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆠𑆬𑆼 𑆱𑆤𑇀𑆣𑆿 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆟𑆴 𑇅 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑇀𑆮𑆬𑇀𑆩𑆵𑆑𑆮𑆢𑇀𑆪𑆱𑇀𑆠𑆶 𑆯𑆤𑆽𑆂 𑆱𑆩𑆶𑆥𑆖𑆵𑆪𑆠𑆼 𑇆𑇙𑇆
𑆠𑆾𑆢𑆑𑇀𑆬𑆼𑆢𑆥𑆫𑆵𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆷𑆩𑆢𑇀𑆨𑆴𑆫𑇀𑆩𑆶𑆒𑆽𑆫𑇀𑆮𑆸𑆠𑆂 𑇅 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑇀𑆮𑆬𑇀𑆩𑆵𑆑 𑆅𑆠𑇀𑆪𑆼𑆰 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆾𑆢𑇀𑆨𑆮𑆂 𑇆𑇑𑇐𑇆
𑆥𑆢𑇀𑆩𑆥𑆶𑆰𑇀𑆑𑆫𑆮𑆤𑇀𑆩𑆣𑇀𑆪𑆼 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆂 𑆱𑆩𑆳𑆖𑆴𑆠𑆳𑆩𑇀 𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆠𑆶 𑆠𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆡𑆴𑆠𑆳𑆁 𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇑𑇆
𑆲𑆤𑆶𑆱𑆤𑇀𑆣𑆿 𑆱𑆩𑆶𑆢𑇀𑆨𑆷𑆠𑆁 𑆯𑆾𑆦𑆩𑆬𑇀𑆥𑆫𑆶𑆘𑆁 𑆱𑇀𑆡𑆴𑆫𑆩𑇀 𑇅 𑆥𑆳𑆰𑆳𑆟𑆓𑆫𑇀𑆢𑆨𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆧𑆬𑆳𑆱𑆥𑆮𑆤𑆳𑆠𑇀𑆩𑆑𑆩𑇀 𑇆𑇑𑇓𑇆
𑆮𑆴𑆱𑆫𑇀𑆥𑆮𑆠𑇀 𑆱𑆫𑇀𑆥𑆠𑆴 𑆪𑆾 𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆑𑆫𑆱𑇀𑆠𑆤𑆶𑆂 𑇅 𑆃𑆥𑆳𑆑𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀 𑆱 𑆘𑇀𑆚𑆼𑆪𑆾 𑆘𑆳𑆬𑆓𑆫𑇀𑆢𑆨𑆂 𑇆𑇑𑇔𑇆
𑆥𑆴𑆝𑆴𑆑𑆳𑆩𑆶𑆠𑇀𑆠𑆩𑆳𑆕𑇀𑆓𑆱𑇀𑆡𑆳𑆁 𑆮𑆸𑆠𑇀𑆠𑆳𑆩𑆶𑆓𑇀𑆫𑆫𑆶𑆘𑆳𑆘𑇀𑆮𑆫𑆳𑆩𑇀 𑇅 𑆱𑆫𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆳𑆁 𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆳𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑆴𑆫𑆴𑆮𑆼𑆬𑇀𑆬𑆴𑆑𑆳𑆩𑇀 𑇆𑇑𑇕𑇆
𑆧𑆳𑆲𑆶𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆁𑆱𑆑𑆑𑇀𑆰𑆳𑆱𑆶 𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆦𑆾𑆛𑆳𑆁 𑆱𑆮𑆼𑆢𑆤𑆳𑆩𑇀 𑇅 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆱𑆩𑇀𑆨𑆷𑆠𑆳𑆁 𑆑𑆑𑇀𑆰𑆳𑆩𑆴𑆠𑆴 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆍𑆑𑆳𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑆴𑆛𑆴𑆑𑆳𑆁 𑆱𑇀𑆦𑆾𑆛𑆱𑆤𑇀𑆤𑆴𑆨𑆳𑆩𑇀 𑇅 𑆠𑇀𑆮𑆓𑇀𑆓𑆠𑆳𑆁 𑆥𑆴𑆠𑇀𑆠𑆑𑆾𑆥𑆼𑆤 𑆓𑆤𑇀𑆣𑆤𑆳𑆩𑆳𑆁 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼 𑇆𑇑𑇗𑇆
𑆃𑆓𑇀𑆤𑆴𑆢𑆓𑇀𑆣𑆤𑆴𑆨𑆳𑆂 𑆱𑇀𑆦𑆾𑆛𑆳𑆂 𑆱𑆘𑇀𑆮𑆫𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆠𑆂 𑇅 𑆑𑇀𑆮𑆖𑆴𑆠𑇀 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆮𑆳 𑆢𑆼𑆲𑆼 𑆱𑇀𑆩𑆸𑆠𑆳 𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆑𑆳 𑆅𑆠𑆴 𑇆𑇑𑇘𑇆
𑆑𑆑𑇀𑆰𑆳𑆨𑆳𑆓𑆼𑆰𑆶 𑆪𑆼 𑆱𑇀𑆦𑆾𑆛𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆳𑆁𑆱𑆢𑆳𑆫𑆶(𑆫)𑆟𑆳𑆂 𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆑𑆫𑆳 𑆢𑆵𑆥𑇀𑆠𑆥𑆳𑆮𑆑𑆱𑆤𑇀𑆤𑆴𑆨𑆳𑆂 𑇆𑇑𑇙𑇆
𑆱𑆥𑇀𑆠𑆳𑆲𑆳𑆢𑇀𑆮𑆳 𑆢𑆯𑆳𑆲𑆳𑆢𑇀𑆮𑆳 𑆥𑆑𑇀𑆰𑆳𑆢𑇀𑆮𑆳 𑆔𑇀𑆤𑆤𑇀𑆠𑆴 𑆩𑆳𑆤𑆮𑆩𑇀 𑇅 𑆠𑆳𑆩𑆓𑇀𑆤𑆴𑆫𑆾𑆲𑆴𑆟𑆵𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆱𑆳𑆣𑇀𑆪𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆠𑆂 𑇆𑇒𑇐𑇆
𑆤𑆒𑆩𑆳𑆁𑆱𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆪 𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳𑆠𑆯𑇀𑆖 𑆮𑆼𑆢𑆤𑆳𑆩𑇀 𑇅 𑆑𑆫𑆾𑆠𑆴 𑆢𑆳𑆲𑆥𑆳𑆑𑆿 𑆖 𑆠𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆖𑆴𑆥𑇀𑆥𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇑𑇆
𑆠𑆢𑆼𑆮𑆳𑆑𑇀𑆰𑆠𑆫𑆾𑆓𑆳𑆒𑇀𑆪𑆁 𑆠𑆡𑆾𑆥𑆤𑆒𑆩𑆴𑆠𑇀𑆪𑆥𑆴 𑇅 𑆃𑆨𑆴𑆔𑆳𑆠𑆳𑆠𑇀 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆾 𑆪𑆾 𑆤𑆒𑆾 𑆫𑆷𑆑𑇀𑆰𑆾𑇁𑆱𑆴𑆠𑆂 𑆒𑆫𑆂 𑇆𑇒𑇒𑇆
𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆨𑆴𑆤𑇀𑆤𑆾𑇁𑆱𑆿 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆱𑆳𑆤𑆴𑆨𑆩𑇀 𑇅 𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆳𑆱𑇀𑆫𑆳𑆮𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆠𑆠𑇀𑆫 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆓𑆠𑆾𑇁𑆤𑆴𑆬𑆂 𑇆𑇒𑇖𑇆
𑆩𑆳𑆁𑆱𑆁 𑆮𑆴𑆯𑆾𑆰𑇀𑆪 𑆓𑇀𑆫𑆡𑆴𑆠𑆳𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆁 𑆘𑆤𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂 𑇅 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆁 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆁 𑆠𑆠𑆂 𑆱𑆴𑆫𑆳𑆂 𑇆𑇒𑇗𑇆
𑆥𑆫𑆴𑆑𑇀𑆫𑆩𑆟𑆯𑆵𑆬𑆱𑇀𑆪 𑆮𑆳𑆪𑆶𑆫𑆠𑇀𑆪𑆫𑇀𑆡𑆫𑆷𑆑𑇀𑆰𑆪𑆾𑆂 𑇅 𑆥𑆳𑆢𑆪𑆾𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆢𑆳𑆫𑆵𑆁 𑆱𑆫𑆶𑆘𑆳𑆁 𑆠𑆬𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆂 𑇆𑇒𑇙𑇆
𑆯𑆫𑇀𑆑𑆫𑆾𑆤𑇀𑆩𑆡𑆴𑆠𑆼 𑆥𑆳𑆢𑆼 𑆑𑇀𑆰𑆠𑆼 𑆮𑆳 𑆑𑆟𑇀𑆛𑆑𑆳𑆢𑆴𑆨𑆴𑆂 𑇅 𑆩𑆼𑆢𑆾𑆫𑆑𑇀𑆠𑆳𑆤𑆶𑆓𑆽𑆯𑇀𑆖𑆽𑆮 𑆢𑆾𑆰𑆽𑆫𑇀𑆮𑆳 𑆘𑆳𑆪𑆠𑆼 𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇓𑇐𑇆
𑆱𑆑𑆵𑆬𑆑𑆜𑆴𑆤𑆾 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑇀𑆤𑆴𑆩𑇀𑆤𑆩𑆣𑇀𑆪𑆾𑆤𑇀𑆤𑆠𑆾𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆑𑆾𑆬𑆩𑆳𑆠𑇀𑆫𑆂 𑆱𑆫𑆶𑆑𑇀 𑆱𑇀𑆫𑆳𑆮𑆵 𑆘𑆳𑆪𑆠𑆼 𑆑𑆢𑆫𑆱𑇀𑆠𑆶 𑆱𑆂 𑇆𑇓𑇑𑇆
𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆤𑇀𑆠𑆫𑆿 𑆥𑆳𑆢𑆿 𑆑𑆟𑇀𑆝𑆷𑆢𑆳𑆲𑆫𑆶𑆓𑆤𑇀𑆮𑆴𑆠𑆿 𑇅 𑆢𑆶𑆰𑇀𑆛𑆑𑆫𑇀𑆢𑆩𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆢𑆬𑆱𑆁 𑆠𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇓𑇒𑇆
𑆫𑆾𑆩𑆑𑆷𑆥𑆳𑆤𑆶𑆓𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆳𑆠𑆼𑆤 𑆱𑆲 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆩𑇀 𑇅 𑆥𑇀𑆫𑆖𑇀𑆪𑆳𑆮𑆪𑆠𑆴 𑆫𑆾𑆩𑆳𑆟𑆴 𑆠𑆠𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑆯𑆾𑆟𑆴𑆠𑆂 𑇆𑇓𑇓𑇆
𑆫𑆶𑆟𑆢𑇀𑆣𑆴 𑆫𑆾𑆩𑆑𑆷𑆥𑆳𑆁𑆱𑇀𑆠𑆶 𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆱𑆩𑇀𑆨𑆮𑆂 𑇅 𑆠𑆢𑆴𑆤𑇀𑆢𑇀𑆫𑆬𑆶𑆥𑇀𑆠𑆁 𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆁 𑆫𑆶𑆘𑇀𑆪𑆼𑆠𑆴 𑆖 𑆮𑆴𑆨𑆳𑆮𑇀𑆪𑆠𑆼 𑇆𑇓𑇔𑇆
𑆢𑆳𑆫𑆶𑆟𑆳 𑆑𑆟𑇀𑆝𑆶𑆫𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆑𑆼𑆯𑆨𑆷𑆩𑆴𑆂 𑆥𑇀𑆫𑆥𑆳𑆛𑇀𑆪𑆠𑆼 𑇅 𑆑𑆦𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆼𑆟 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆳𑆫𑆶𑆟𑆑𑆁 𑆠𑆶 𑆠𑆩𑇀 𑇆𑇓𑇕𑇆

𑆑𑆰𑆳𑆪𑆠𑆴𑆑𑇀𑆠𑆩𑆣𑆶𑆫𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆳𑆫𑇀𑆠𑆴𑆤𑆳𑆯𑆤𑆂 𑇅 𑆑𑆶𑆰𑇀𑆜𑆑𑇀𑆫𑆴𑆩𑆴𑆲𑆫𑆯𑇀𑆖𑆽𑆮 𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆮𑆴𑆯𑆾𑆣𑆤𑆂 𑇆𑇖𑇕𑇆
𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆤𑇀𑆪𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆠𑇀𑆫𑆴𑆑𑆟𑇀𑆛𑆑𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆥𑆸𑆡𑆑𑇀𑆥𑆫𑇀𑆟𑇀𑆪𑆾 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳 𑆖𑆼𑆠𑆴 𑆑𑆤𑆵𑆪𑆂 𑇆𑇖𑇖𑇆
𑆑𑆰𑆳𑆪𑆠𑆴𑆑𑇀𑆠𑆩𑆣𑆶𑆫𑆁 𑆑𑆤𑆵𑆪𑆂 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆑𑆩𑇀 𑇅 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆯𑆩𑆤𑆁 𑆧𑆸𑆁𑆲𑆟𑆁 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇖𑇗𑇆
𑆧𑆴𑆬𑇀𑆮𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆛𑆴𑆟𑇀𑆛𑆶𑆑𑆥𑆳𑆛𑆬𑆳𑆂 𑆑𑆳𑆯𑇀𑆩𑆫𑆵 𑆖𑆼𑆠𑆴 𑆩𑆲𑆠𑇀 𑇆𑇖𑇘𑇆
𑆱𑆠𑆴𑆑𑇀𑆠𑆁 𑆑𑆦𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆥𑆳𑆑𑆼 𑆬𑆔𑇀𑆮𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆩𑇀 𑇅 𑆩𑆣𑆶𑆫𑆳𑆤𑆶𑆫𑆱𑆁 𑆖𑆽𑆮 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆩𑆲𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇖𑇙𑇆
𑆃𑆤𑆪𑆾𑆫𑇀𑆢𑆯𑆩𑆷𑆬𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇗𑇐𑇆
𑆓𑆟𑆂 𑆯𑇀𑆮𑆳𑆱𑆲𑆫𑆾 𑆲𑇀𑆪𑆼𑆰 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆂 𑇅 𑆄𑆩𑆱𑇀𑆪 𑆥𑆳𑆖𑆤𑆯𑇀𑆖𑆽𑆮 𑆱𑆫𑇀𑆮𑆘𑇀𑆮𑆫𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇆𑇗𑇑𑇆
𑆮𑆴𑆢𑆳𑆫𑆵𑆱𑆳𑆫𑆴𑆮𑆳𑆫𑆘𑆤𑆵𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆾𑇁𑆘𑆯𑆸𑆕𑇀𑆓𑆵 𑆖𑆼𑆠𑆴 𑆮𑆬𑇀𑆬𑆵𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑇆𑇗𑇒𑇆
𑆑𑆫𑆩𑆫𑇀𑆢𑆵𑆠𑇀𑆫𑆴𑆑𑆟𑇀𑆛𑆑𑆱𑆽𑆫𑆵𑆪𑆑𑆯𑆠𑆳𑆮𑆫𑆵𑆓𑆸𑆣𑇀𑆫𑆤𑆒𑇀𑆪 𑆅𑆠𑆴 𑆑𑆟𑇀𑆛𑆑𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑇆𑇗𑇓𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆫𑆿 𑆲𑇀𑆪𑆼𑆠𑆿 𑆯𑆾𑆦𑆠𑇀𑆫𑆪𑆮𑆴𑆤𑆳𑆯𑆤𑆿 𑇅 𑆱𑆫𑇀𑆮𑆩𑆼𑆲𑆲𑆫𑆿 𑆖𑆽𑆮 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆮𑆴𑆤𑆳𑆯𑆤𑆿 𑇆𑇗𑇔𑇆
𑆑𑆶𑆯𑆑𑆳𑆯𑆤𑆬𑆢𑆫𑇀𑆨𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑆶𑆑𑆳 𑆅𑆠𑆴 𑆠𑆸𑆟𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆂 𑇆𑇗𑇕𑇆
𑆩𑆷𑆠𑇀𑆫𑆢𑆾𑆰𑆮𑆴𑆑𑆳𑆫𑆁 𑆖 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆃𑆤𑇀𑆠𑇀𑆪𑆂 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆯𑆵𑆔𑇀𑆫𑆩𑆼𑆮 𑆮𑆴𑆤𑆳𑆯𑆪𑆼𑆠𑇀 𑇆𑇗𑇖𑇆
𑆍𑆰𑆳𑆁 𑆮𑆳𑆠𑆲𑆫𑆳𑆮𑆳𑆢𑇀𑆪𑆳𑆮𑆤𑇀𑆠𑇀𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆤𑆳𑆯𑆤𑆂 𑇅 𑆥𑆚𑇀𑆖𑆑𑆿 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆩𑆤𑆳𑆮𑆴𑆠𑆫𑆿 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆿 𑇆𑇗𑇗𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆢𑆴𑆑𑆩𑆤𑇀𑆪𑆠𑇀𑆫𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇗𑇘𑇆
𑆱𑆩𑆳𑆱𑆼𑆤 𑆓𑆟𑆳 𑆲𑇀𑆪𑆼𑆠𑆼 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆮𑆴𑆱𑇀𑆠𑆫𑆩𑇀 𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴, .... 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆢𑆾𑆰𑆧𑆬𑆳𑆧𑆬𑆩𑇀 𑇆𑇗𑇙𑇆
𑆍𑆨𑆴𑆫𑇀𑆬𑆼𑆥𑆳𑆤𑇀 𑆑𑆰𑆳𑆪𑆳𑆁𑆯𑇀𑆖 𑆠𑆽𑆬𑆁 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆥𑆳𑆤𑆑𑆳𑆤𑇀 𑇅 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪 𑆪𑆡𑆳𑆤𑇀𑆪𑆳𑆪𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑇆𑇘𑇐𑇆
𑆣𑆷𑆩𑆮𑆫𑇀𑆰𑆳𑆤𑆴𑆬𑆑𑇀𑆬𑆼𑆢𑆽𑆂 𑆱𑆫𑇀𑆮𑆫𑇀𑆠𑆶𑆰𑇀𑆮𑆤𑆨𑆴𑆢𑇀𑆫𑆶𑆠𑆼 𑇅 𑆓𑇀𑆫𑆳𑆲𑆪𑆴𑆠𑇀𑆮𑆳 𑆓𑆸𑆲𑆼 𑆤𑇀𑆪𑆱𑇀𑆪𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆤𑆿𑆰𑆣𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆩𑇀 𑇆𑇘𑇑𑇆
𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆨𑆼𑆢𑆳𑆁𑆯𑇀𑆖 𑆨𑆴𑆤𑇀𑆤𑆳𑆤𑇀 𑆩𑆴𑆯𑇀𑆫𑆳𑆤𑇀 𑆨𑆴𑆤𑇀𑆤𑆳𑆤𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆥𑆸𑆡𑆕𑇀𑆩𑆴𑆯𑇀𑆫𑆳𑆤𑇀 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑇀𑆮𑆳 𑆓𑆟𑆁 𑆮𑆳 𑆮𑇀𑆪𑆱𑇀𑆠𑆱𑆁𑆲𑆠𑆩𑇀 𑇆𑇘𑇒𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆁𑆯𑆩𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆢𑆤𑆑𑆶𑆛𑆘𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆱𑆫𑇀𑆰𑆥𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆫𑆚𑇀𑆘𑆥𑇀𑆫𑆥𑆶𑆤𑇀𑆤𑆳𑆝 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆑𑆫𑇀𑆧𑆶𑆢𑆳𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆮𑆴𑆢𑆶𑆬𑆧𑆤𑇀𑆣𑆶𑆘𑆵𑆮𑆑𑆯𑇀𑆮𑆼𑆠𑆳𑆯𑆟𑆥𑆶𑆰𑇀𑆥𑆵𑆧𑆴𑆩𑇀𑆧𑆵𑆮𑆖𑆳𑆩𑆸𑆓𑆼𑆫𑇀𑆮𑆳𑆫𑆮𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆳 𑆖𑆼𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆲𑆫𑆳𑆟𑆴 𑇅 𑆠𑆠𑇀𑆫, 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆳𑆁 𑆦𑆬𑆳𑆤𑆴, 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆩𑆷𑆬𑆳𑆤𑆴 𑇆𑇓𑇆
𑆮𑆴𑆮𑆸𑆠𑆳𑆯𑇀𑆪𑆳𑆩𑆳𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆱𑆥𑇀𑆠𑆬𑆳𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆮𑆴𑆰𑆳𑆟𑆴𑆑𑆳𑆓𑆮𑆳𑆑𑇀𑆰𑆵𑆖𑇀𑆗𑆓𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆵𑆱𑇀𑆤𑆶𑆑𑇀𑆱𑆶 𑆮𑆫𑇀𑆟𑆑𑇀𑆰𑆵𑆫𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆴𑆟𑆴𑆲𑆵𑆑𑆶𑆯𑆑𑆳𑆯𑆠𑆴𑆬𑇀𑆮𑆑𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆫𑆩𑇀𑆪𑆑𑆥𑆳𑆛𑆬𑆳𑆥𑆷𑆓𑆲𑆫𑆵𑆠𑆑𑇀𑆪𑆳 𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆤𑆵𑆬𑆴𑆤𑆵𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆽𑆫𑆟𑇀𑆝𑆥𑆷𑆠𑆵𑆑𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆱𑆥𑇀𑆠𑆖𑇀𑆗𑆢𑆳𑆫𑇀𑆑𑆳 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵 𑆖𑆼𑆠𑇀𑆪𑆣𑆾𑆨𑆳𑆓𑆲𑆫𑆳𑆟𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆠𑆴𑆬𑇀𑆮𑆑𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆳𑆁 𑆩𑆷𑆬𑆳𑆤𑆴 , 𑆠𑆴𑆬𑇀𑆮𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆳𑆛𑆬𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆖𑆂, 𑆑𑆩𑇀𑆥𑆴𑆬𑇀𑆬𑆑𑆦𑆬𑆫𑆘𑆂, 𑆥𑆷𑆓𑆳𑆢𑆵𑆤𑆳𑆩𑆼𑆫𑆟𑇀𑆝𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆦𑆬𑆳𑆤𑆴, 𑆥𑆷𑆠𑆵𑆑𑆳𑆫𑆓𑇀𑆮𑆣𑆪𑆾𑆂 𑆥𑆠𑇀𑆫𑆳𑆟𑆴, 𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆵𑆠𑆴 𑇆𑇔𑇆
𑆑𑆾𑆯𑆳𑆠𑆑𑆵 𑆱𑆥𑇀𑆠𑆬𑆳 𑆯𑆕𑇀𑆒𑆴𑆤𑆵 𑆢𑆼𑆮𑆢𑆳𑆬𑆵 𑆑𑆳𑆫𑆮𑆼𑆬𑇀𑆬𑆴𑆑𑆳 𑆖𑆼𑆠𑇀𑆪𑆶𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆲𑆫𑆳𑆟𑆴 𑇅 𑆍𑆰𑆳𑆁 𑆱𑇀𑆮𑆫𑆱𑆳 𑆅𑆠𑆴 𑇆𑇕𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆯𑆴𑆓𑇀𑆫𑆶𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆯𑆴𑆫𑆵𑆰𑆩𑆫𑆴𑆖𑆑𑆫𑆮𑆵𑆫𑆧𑆴𑆩𑇀𑆧𑆵𑆓𑆴𑆫𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆑𑆴𑆟𑆴𑆲𑆵𑆮𑆖𑆳𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵- 𑆑𑆫𑆚𑇀𑆘𑆳𑆫𑇀𑆑𑆳𑆬𑆫𑇀𑆑𑆬𑆯𑆶𑆤𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆠𑆳𑆬𑆵𑆯𑆠𑆩𑆳𑆬𑆱𑆶𑆫𑆱𑆳𑆫𑇀𑆘𑆑𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆵𑆩𑆶𑆫𑆕𑇀𑆓𑆵𑆥𑆵𑆬𑆶- 𑆘𑆳𑆠𑆵𑆯𑆳𑆬𑆠𑆳𑆬𑆩𑆣𑆷𑆑𑆬𑆳𑆑𑇀𑆰𑆳𑆲𑆴𑆕𑇀𑆓𑆶𑆬𑆮𑆟𑆩𑆢𑇀𑆪𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑆵𑆠𑆴 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆑𑆫𑆮𑆵𑆫𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆳𑆁 𑆦𑆬𑆳𑆤𑆴, 𑆑𑆫𑆮𑆵𑆫𑆳𑆢𑆵𑆤𑆳𑆩𑆫𑇀𑆑𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆩𑆷𑆬𑆳𑆤𑆴, 𑆠𑆳𑆬𑆵𑆯𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆳𑆁 𑆑𑆤𑇀𑆢𑆳𑆂, 𑆠𑆳𑆬𑆵𑆯𑆳𑆢𑆵𑆤𑆳𑆩𑆫𑇀𑆘𑆑𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆥𑆠𑇀𑆫𑆳𑆟𑆴, 𑆅𑆕𑇀𑆓𑆶𑆢𑆵𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑇀𑆪𑆾𑆱𑇀𑆠𑇀𑆮𑆖𑆂, 𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆵𑆩𑆶𑆫𑆕𑇀𑆓𑆵𑆥𑆵𑆬𑆶𑆘𑆳𑆠𑆵𑆤𑆳𑆁 𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴, 𑆯𑆳𑆬𑆠𑆳𑆬𑆩𑆣𑆷𑆑𑆳𑆤𑆳𑆁 𑆱𑆳𑆫𑆳𑆂, 𑆲𑆴𑆕𑇀𑆓𑆶𑆬𑆳𑆑𑇀𑆰𑆼 𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆿, 𑆬𑆮𑆟𑆳𑆤𑆴 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆂; 𑆩𑆢𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆱𑆶𑆠𑆱𑆁𑆪𑆾𑆓𑆳𑆂, 𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆩𑆷𑆠𑇀𑆫𑆼 𑆩𑆬𑆳𑆮𑆴𑆠𑆴 𑇆𑇖𑇆
𑆱𑆁𑆯𑆩𑆤𑆳𑆤𑇀𑆪𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫 𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆑𑆶𑆰𑇀𑆜𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆮𑆫𑆶𑆟𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆫𑇀𑆠𑆓𑆬𑆑𑆖𑇀𑆗𑆶𑆫𑆳𑆯𑆬𑇀𑆬𑆑𑆵𑆑𑆶𑆧𑆼𑆫𑆳𑆑𑇀𑆰𑆵𑆮𑆵𑆫𑆠𑆫𑆶𑆱𑆲𑆖𑆫𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡- 𑆮𑆠𑇀𑆱𑆳𑆢𑆤𑇀𑆪𑆼𑆫𑆟𑇀𑆝𑆳𑆯𑇀𑆩𑆨𑆼𑆢𑆑𑆳𑆬𑆫𑇀𑆑𑆳𑆫𑇀𑆑𑆯𑆠𑆳𑆮𑆫𑆵𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆮𑆱𑆶𑆑𑆮𑆯𑆴𑆫𑆑𑆳𑆚𑇀𑆖𑆤𑆑𑆨𑆳𑆫𑇀𑆓𑆵𑆑𑆳𑆫𑇀𑆥𑆳𑆱𑆵𑆮𑆸𑆯𑇀𑆖𑆴𑆑𑆳𑆬𑆵𑆥𑆠𑇀𑆠𑆷𑆫𑆧𑆢𑆫𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆯𑇀𑆖 𑆢𑇀𑆮𑆼 𑆖𑆳𑆢𑇀𑆪𑆼 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆱𑆩𑆳𑆱𑆼𑆤 𑆮𑆳𑆠𑆱𑆁𑆯𑆩𑆤𑆾 𑆮𑆫𑇀𑆓𑆂 𑇆𑇗𑇆
𑆖𑆤𑇀𑆢𑆤𑆑𑆶𑆖𑆤𑇀𑆢𑆤𑆲𑇀𑆫𑆵𑆧𑆼𑆫𑆾𑆯𑆵𑆫𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆥𑆪𑆱𑇀𑆪𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆯𑆠𑆳𑆮𑆫𑆵𑆓𑆶𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑆽𑆮𑆬𑆑𑆲𑇀𑆬𑆳𑆫𑆑𑆶𑆩𑆶𑆢𑆾𑆠𑇀𑆥𑆬𑆑𑆤𑇀𑆢(𑆢)𑆬𑆵𑆢𑆷𑆫𑇀𑆮𑆳𑆩𑆷𑆫𑇀𑆮𑆳𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆂 𑆱𑆳𑆫𑆴𑆮𑆳𑆢𑆴𑆫𑆚𑇀𑆘𑆤𑆳𑆢𑆴𑆫𑆶𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆫𑇀𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆱𑇀𑆠𑆸𑆟𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆩𑆴𑆠𑆴 𑆱𑆩𑆳𑆱𑆼𑆤 𑆥𑆴𑆠𑇀𑆠𑆱𑆁𑆯𑆩𑆤𑆾 𑆮𑆫𑇀𑆓𑆂 𑇆𑇘𑇆
𑆑𑆳𑆬𑆼𑆪𑆑𑆳𑆓𑆶𑆫𑆶𑆠𑆴𑆬𑆥𑆫𑇀𑆟𑆵𑆑𑆶𑆰𑇀𑆜𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆯𑆵𑆠𑆯𑆴𑆮𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳𑆱𑆫𑆬𑆳𑆫𑆳𑆱𑇀𑆤𑆳𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆪𑆾𑆢𑆑𑆵𑆫𑇀𑆪𑆼𑆕𑇀𑆓𑆶𑆢𑆵𑆱𑆶𑆩𑆤𑆳- 𑆑𑆳𑆑𑆳𑆢𑆤𑆵𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑆵𑆲𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆟𑆩𑆶𑆚𑇀𑆘𑆳𑆠𑆑𑆬𑆳𑆩𑆘𑇀𑆘𑆑𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆴 𑆮𑆬𑇀𑆬𑆵𑆑𑆟𑇀𑆛𑆑𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆫𑇀𑆧𑆸𑆲𑆠𑇀𑆪𑆳𑆢𑆴𑆫𑇀𑆩𑆶𑆰𑇀𑆑𑆑𑆳𑆢𑆴𑆫𑇀𑆮𑆖𑆳𑆢𑆴𑆂 𑆱𑆶𑆫𑆱𑆳𑆢𑆴𑆫𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆫𑆴𑆠𑆴 𑆱𑆩𑆳𑆱𑆼𑆤 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆁𑆯𑆩𑆤𑆾 𑆮𑆫𑇀𑆓𑆂 𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆼𑆮𑆿𑆰𑆣𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆓𑇀𑆤𑆴𑆥𑆶𑆫𑆶𑆰𑆧𑆬𑆳𑆤𑇀𑆪𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫, 𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆬𑆳𑆢𑆣𑆴𑆑𑆩𑆿𑆰𑆣𑆩𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆩𑆶𑆥𑆯𑆩𑇀𑆪 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆩𑆤𑇀𑆪𑆩𑆳𑆮𑆲𑆠𑆴; 𑆃𑆓𑇀𑆤𑆴𑆧𑆬𑆳𑆢𑆣𑆴𑆑𑆩𑆘𑆵𑆫𑇀𑆟𑆁 𑆮𑆴𑆰𑇀𑆛𑆨𑇀𑆪 𑆮𑆳 𑆥𑆖𑇀𑆪𑆠𑆼; 𑆥𑆶𑆫𑆶𑆰𑆧𑆬𑆳𑆢𑆣𑆴𑆑𑆁 𑆓𑇀𑆬𑆳𑆤𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆩𑆢𑆳𑆤𑆳𑆮𑆲𑆠𑆴 𑆱𑆁𑆯𑆩𑆤𑆩𑇀; 𑆍𑆮𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆠𑆴𑆥𑆳𑆠𑆪𑆠𑆴 𑇅 𑆲𑆵𑆤𑆩𑆼𑆨𑇀𑆪𑆾 𑆢𑆠𑇀𑆠𑆩𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆑𑆫𑆁 𑆨𑆮𑆠𑆴 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆩𑆩𑆼𑆮 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆫𑆾𑆓𑆼 𑆯𑆾𑆣𑆤𑆱𑆳𑆣𑇀𑆪𑆼 𑆠𑆶 𑆪𑆾 𑆨𑆮𑆼𑆢𑇀𑆢𑆾𑆰𑆢𑆶𑆫𑇀𑆧𑆬𑆂 𑇅 𑆠𑆱𑇀𑆩𑆽 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆢𑆾𑆰𑆥𑇀𑆫𑆖𑇀𑆪𑆳𑆮𑆳𑆤𑆁 𑆩𑆸𑆢𑆶 𑇆𑇑𑇑𑇆
𑆖𑆬𑆼 𑆢𑆾𑆰𑆼 𑆩𑆸𑆢𑆿 𑆑𑆾𑆰𑇀𑆜𑆼 𑆤𑆼𑆑𑇀𑆰𑆼𑆠𑆳𑆠𑇀𑆫 𑆧𑆬𑆁 𑆤𑆸𑆟𑆳𑆩𑇀 𑇅 𑆃𑆮𑇀𑆪𑆳𑆣𑆴𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪𑆳𑆥𑆴 𑆯𑆾𑆣𑆤𑆁 𑆲𑆴 𑆠𑆢𑆳 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆱𑇀𑆮𑆪𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆢𑆾𑆰𑆱𑇀𑆪 𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆯𑆾𑆣𑆤𑆩𑇀 𑇅 𑆨𑆮𑆼𑆢𑆬𑇀𑆥𑆧𑆬𑆱𑇀𑆪𑆳𑆥𑆴 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆳𑆯𑆤𑆩𑇀 𑇆𑇑𑇓𑇆
𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆳𑆢𑆴𑆰𑆶 𑆠𑆶 𑆩𑆣𑇀𑆪𑆼𑆰𑆶 𑆑𑇀𑆮𑆳𑆡𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆧𑆴𑆝𑆳𑆬𑆥𑆢𑆑𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆢𑆼𑆪𑆂 𑆑𑆬𑇀𑆑𑆾𑇁𑆑𑇀𑆰𑆱𑆩𑇀𑆩𑆴𑆠𑆂 𑇆𑇑𑇔𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆓𑆶𑆟𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆑𑆼𑆖𑆴𑆢𑆳𑆖𑆳𑆫𑇀𑆪𑆳 𑆧𑇀𑆫𑆶𑆮𑆠𑆼- 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆠𑇀𑆮𑆳𑆠𑇀, 𑆅𑆲 𑆒𑆬𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆁 𑆤 𑆫𑆱𑆳𑆢𑆪𑆂, 𑆪𑆡𑆳 𑆄𑆩𑆼 𑆦𑆬𑆼 𑆪𑆼 𑆫𑆱𑆳𑆢𑆪𑆱𑇀𑆠𑆼 𑆥𑆑𑇀𑆮𑆼 𑆤 𑆱𑆤𑇀𑆠𑆴; 𑆤𑆴𑆠𑇀𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖, 𑆤𑆴𑆠𑇀𑆪𑆁 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆤𑆴𑆠𑇀𑆪𑆳 𑆓𑆶𑆟𑆳𑆂, 𑆪𑆡𑆳 𑆑𑆬𑇀𑆑𑆳𑆢𑆴𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆂, 𑆱 𑆍𑆮 𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆫𑆱𑆓𑆤𑇀𑆣𑆾 𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆫𑆱𑆓𑆤𑇀𑆣𑆾 𑆮𑆳 𑆨𑆮𑆠𑆴; 𑆱𑇀𑆮𑆘𑆳𑆠𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆖𑇀𑆖, 𑆪𑆡𑆳 𑆲𑆴 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆤𑇀𑆪𑆨𑆳𑆮𑆁 𑆤 𑆓𑆖𑇀𑆗𑆠𑇀𑆪𑆼𑆮𑆁 𑆯𑆼𑆰𑆳𑆟𑆴; 𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆓𑇀𑆫𑆲𑆟𑆳𑆯𑇀𑆖, 𑆥𑆚𑇀𑆖𑆨𑆴𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆽𑆫𑇀𑆓𑆸𑆲𑇀𑆪𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆤 𑆫𑆱𑆳𑆢𑆪𑆂; 𑆄𑆯𑇀𑆫𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖, 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆳 𑆫𑆱𑆳𑆢𑆪𑆂; 𑆄𑆫𑆩𑇀𑆨𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆳𑆖𑇀𑆖, 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆴𑆠 𑆄𑆫𑆩𑇀𑆨𑆂, 𑆪𑆡𑆳- ‘𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆱𑆕𑇀𑆑𑇀𑆰𑆶𑆢𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀’ 𑆅𑆠𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆴𑆰𑆶 𑆤 𑆫𑆱𑆳𑆢𑆴𑆰𑇀𑆮𑆳𑆫𑆩𑇀𑆨𑆂; 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆳𑆩𑆳𑆟𑇀𑆪𑆳𑆖𑇀𑆖, 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆯𑆼 𑆪𑆾𑆓𑆳𑆤𑆳𑆁, 𑆪𑆡𑆳- ‘𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆿 𑆖’ 𑆅𑆠𑇀𑆪𑆳𑆢𑆿 𑆤 𑆫𑆱𑆳𑆢𑆪 𑆇𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼; 𑆑𑇀𑆫𑆩𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁, 𑆫𑆱𑆳𑆢𑆪𑆾 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑇀𑆫𑆩𑆩𑆥𑆼𑆑𑇀𑆰𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳- 𑆠𑆫𑆶𑆟𑆼 𑆠𑆫𑆶𑆟𑆳𑆂 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆼 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆳 𑆅𑆠𑆴; 𑆍𑆑𑆢𑆼𑆯𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖, 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆼𑆤𑆳𑆥𑆴 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆱𑆳𑆣𑇀𑆪𑆤𑇀𑆠𑆼, 𑆪𑆡𑆳- 𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆼𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁, 𑆤 𑆫𑆱𑆳𑆢𑆪𑆂, 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆤𑆴𑆫𑆮𑆪𑆮𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆁 𑆠𑆶 ‘𑆑𑇀𑆫𑆴𑆪𑆳𑆓𑆶𑆟𑆮𑆠𑇀 𑆱𑆩𑆮𑆳𑆪𑆴𑆑𑆳𑆫𑆟𑆩𑇀’ 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆤𑆼𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆤𑇀𑆪𑆼 , 𑆫𑆱𑆳𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆣𑆳𑆤𑆁; 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆄𑆓𑆩𑆳𑆠𑇀, 𑆄𑆓𑆩𑆾 𑆲𑆴 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆶𑆖𑇀𑆪𑆠𑆼; 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆲𑆴 𑆫𑆱𑆳 𑆃𑆣𑆴𑆑𑆸𑆠𑆳𑆂, 𑆪𑆡𑆳- 𑆫𑆱𑆳𑆪𑆠𑇀𑆠 𑆄𑆲𑆳𑆫 𑆅𑆠𑆴, 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆳𑆟𑆳𑆂; 𑆇𑆥𑆢𑆼𑆯𑆳𑆖𑇀𑆖, 𑆇𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆲𑆴 𑆫𑆱𑆳𑆂, 𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳 𑆮𑆳𑆠𑆁 𑆯𑆩𑆪𑆤𑇀𑆠𑆴; 𑆃𑆤𑆶𑆩𑆳𑆤𑆳𑆖𑇀𑆖, 𑆫𑆱𑆼𑆤 𑆲𑇀𑆪𑆤𑆶𑆩𑆵𑆪𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆁, 𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆩𑆴𑆠𑆴; 𑆉𑆰𑆴𑆮𑆖𑆤𑆳𑆖𑇀𑆖, 𑆉𑆰𑆴𑆮𑆖𑆤𑆁 𑆮𑆼𑆢𑆾 𑆪𑆡𑆳- 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆴𑆘𑇀𑆪𑆳𑆫𑇀𑆡𑆁 𑆩𑆣𑆶𑆫𑆩𑆳𑆲𑆫𑆼𑆢𑆴𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆱𑆳𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆁; 𑆫𑆱𑆼𑆰𑆶 𑆓𑆶𑆟𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑇅 𑆫𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑆤𑇀𑆪𑆠𑇀𑆫𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇔𑇆
𑆤𑆼𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆤𑇀𑆪𑆼 , 𑆮𑆵𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑇅 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆠𑆢𑇀𑆮𑆯𑆼𑆤𑆿𑆰𑆣𑆑𑆫𑇀𑆩𑆤𑆴𑆰𑇀𑆥𑆠𑇀𑆠𑆼𑆂 𑇅 𑆅𑆲𑆿𑆰𑆣𑆑𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆳𑆣𑆾𑆨𑆳𑆓𑆾𑆨𑆪𑆨𑆳𑆓𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆁𑆯𑆩𑆤𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆳𑆓𑇀𑆤𑆴𑆢𑆵𑆥𑆤𑆥𑆵𑆝𑆤𑆬𑆼𑆒𑆤𑆧𑆸𑆁𑆲𑆟- 𑆫𑆱𑆳𑆪𑆤𑆮𑆳𑆘𑆵𑆑𑆫𑆟𑆯𑇀𑆮𑆪𑆡𑆶𑆑𑆫𑆮𑆴𑆬𑆪𑆤𑆢𑆲𑆤𑆢𑆳𑆫𑆟𑆩𑆳𑆢𑆤𑆥𑇀𑆫𑆳𑆟𑆔𑇀𑆤𑆮𑆴𑆰𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆢𑆵𑆤𑆴 𑆮𑆵𑆫𑇀𑆪𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆳𑆢𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆖𑇀𑆖 𑆮𑆵𑆫𑇀𑆪𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆶𑆰𑇀𑆟𑆁 𑆯𑆵𑆠𑆁 𑆖, 𑆃𑆓𑇀𑆤𑆵𑆰𑆾𑆩𑆵𑆪𑆠𑇀𑆮𑆳𑆘𑇀𑆘𑆓𑆠𑆂 𑇅 𑆑𑆼𑆖𑆴𑆢𑆰𑇀𑆛𑆮𑆴𑆣𑆩𑆳𑆲𑆶𑆂- 𑆯𑆵𑆠𑆩𑆶𑆰𑇀𑆟𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆮𑆴𑆯𑆢𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆩𑆸𑆢𑆶 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆍𑆠𑆳𑆤𑆴 𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆱𑇀𑆮𑆧𑆬𑆓𑆶𑆟𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆢𑇀𑆫𑆱𑆩𑆨𑆴𑆨𑆷𑆪𑆳𑆠𑇀𑆩𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑇅 𑆪𑆡𑆳 𑆠𑆳𑆮𑆤𑇀𑆩𑆲𑆠𑇀𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆑𑆰𑆳𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆶𑆫𑆱𑆁 𑆮𑆳𑆠𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆇𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆡𑆳 𑆑𑆶𑆬𑆠𑇀𑆡𑆂 𑆑𑆰𑆳𑆪𑆂, 𑆑𑆛𑆶𑆑𑆂 𑆥𑆬𑆳𑆟𑇀𑆝𑆶𑆂, 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆳𑆖𑇀𑆖; 𑆩𑆣𑆶𑆫𑆯𑇀𑆖𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆾 𑆮𑆳𑆠𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆯𑆵𑆠𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆑𑆛𑆶𑆑𑆳 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆥𑆴𑆠𑇀𑆠𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆩𑆸𑆢𑆶𑆯𑆵𑆠𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆃𑆩𑇀𑆬𑆩𑆳𑆩𑆬𑆑𑆁 𑆬𑆮𑆟𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆖; 𑆠𑆴𑆑𑇀𑆠𑆳 𑆑𑆳𑆑𑆩𑆳𑆖𑆵 𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆇𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀, 𑆩𑆣𑆶𑆫𑆳 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆯𑇀𑆖; 𑆑𑆛𑆶𑆑𑆁 𑆩𑆷𑆬𑆑𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆃𑆩𑇀𑆬𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆳𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆫𑆷𑆑𑇀𑆰𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀, 𑆩𑆣𑆶𑆫𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆖; 𑆠𑆢𑆼𑆠𑆤𑇀𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆩𑆳𑆠𑇀𑆫𑆩𑆶𑆑𑇀𑆠𑆩𑇀 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆼 𑆫𑆱𑆳 𑆮𑆳𑆠𑆯𑆩𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆢𑆴 𑆠𑆼𑆰𑆶 𑆮𑆽 𑇅 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆬𑆳𑆔𑆮𑆯𑆽𑆠𑇀𑆪𑆳𑆤𑆴 𑆤 𑆠𑆼 𑆲𑆤𑇀𑆪𑆶𑆂 𑆱𑆩𑆵𑆫𑆟𑆩𑇀 𑇆𑇖𑇆
𑆪𑆼 𑆫𑆱𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆯𑆩𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆢𑆴 𑆠𑆼𑆰𑆶 𑆮𑆽 𑇅 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆬𑆔𑆶𑆠𑆳𑆯𑇀𑆖𑆽𑆮 𑆤 𑆠𑆼 𑆠𑆠𑇀𑆑𑆫𑇀𑆩𑆑𑆳𑆫𑆴𑆟𑆂 𑇆𑇗𑇆
𑆪𑆼 𑆫𑆱𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑆩𑆤𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆪𑆢𑆴 𑆠𑆼𑆰𑆶 𑆮𑆽 𑇅 𑆱𑇀𑆤𑆼𑆲𑆓𑆿𑆫𑆮𑆯𑆽𑆠𑇀𑆪𑆳𑆤𑆴 𑆤 𑆠𑆼 𑆠𑆠𑇀𑆑𑆫𑇀𑆩𑆑𑆳𑆫𑆴𑆟𑆂 𑇆𑇘𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑇆𑇙𑇆
𑆤𑆼𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆤𑇀𑆪𑆼 , 𑆮𑆴𑆥𑆳𑆑𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆴𑆠𑆴 𑇅 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆱𑆩𑇀𑆪𑆕𑇀𑆩𑆴𑆡𑇀𑆪𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆠𑇀𑆮𑆳𑆠𑇀; 𑆅𑆲 𑆱𑆫𑇀𑆮𑆢𑇀𑆫𑆮𑆳𑆟𑇀𑆪𑆨𑇀𑆪𑆮𑆲𑆸𑆠𑆳𑆤𑆴 𑆱𑆩𑇀𑆪𑆕𑇀𑆩𑆴𑆡𑇀𑆪𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆳𑆤𑆴 𑆓𑆶𑆟𑆁 𑆢𑆾𑆰𑆁 𑆮𑆳 𑆘𑆤𑆪𑆤𑇀𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫𑆳𑆲𑆶𑆫𑆤𑇀𑆪𑆼- 𑆥𑇀𑆫𑆠𑆴 𑆫𑆱𑆁 𑆥𑆳𑆑 𑆅𑆠𑆴 𑇅 𑆑𑆼𑆖𑆴𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴- 𑆩𑆣𑆶𑆫𑆩𑆩𑇀𑆬𑆁 𑆑𑆛𑆶𑆑𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆠𑆠𑇀𑆠𑆶 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆨𑆷𑆠𑆓𑆶𑆟𑆳𑆢𑆳𑆩𑆳𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆾𑇁𑆩𑇀𑆬𑆾 𑆮𑆴𑆥𑆳𑆑𑆾 𑆤𑆳𑆱𑇀𑆠𑆴; 𑆥𑆴𑆠𑇀𑆠𑆁 𑆲𑆴 𑆮𑆴𑆢𑆓𑇀𑆣𑆩𑆩𑇀𑆬𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀; 𑆪𑆢𑇀𑆪𑆼𑆮𑆁 𑆬𑆮𑆟𑆾𑇁𑆥𑇀𑆪𑆤𑇀𑆪𑆂 𑆥𑆳𑆑𑆾 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆴, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆲𑆴 𑆮𑆴𑆢𑆓𑇀𑆣𑆾 𑆬𑆮𑆟𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆵𑆠𑆴 𑇅 𑆩𑆣𑆶𑆫𑆾 𑆩𑆣𑆶𑆫𑆱𑇀𑆪𑆳𑆩𑇀𑆬𑆾𑇁𑆩𑇀𑆬𑆱𑇀𑆪𑆽𑆮𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆠𑆴 𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂; 𑆢𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆁 𑆖𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴- 𑆪𑆡𑆳 𑆠𑆳𑆮𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆒𑆳𑆓𑆠𑆁 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆩𑆣𑆶𑆫𑆩𑆼𑆮 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆡𑆳 𑆯𑆳𑆬𑆴𑆪𑆮𑆩𑆶𑆢𑇀𑆓𑆳𑆢𑆪𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆟𑆳𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆼𑇁𑆥𑆴 𑆤 𑆥𑆫𑆴𑆠𑇀𑆪𑆘𑆤𑇀𑆠𑆴 𑆠𑆢𑇀𑆮𑆢𑆴𑆠𑆴 𑇅 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆢𑆤𑇀𑆠𑆴- 𑆃𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆧𑆬𑆮𑆠𑆳𑆁 𑆮𑆯𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆵𑆠𑆴 𑇅 𑆍𑆮𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆴𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑇀𑆠 𑆍𑆰𑆂 𑇅 𑆄𑆓𑆩𑆼 𑆲𑆴 𑆢𑇀𑆮𑆴𑆮𑆴𑆣 𑆍𑆮 𑆥𑆳𑆑𑆾 𑆩𑆣𑆶𑆫𑆂 𑆑𑆛𑆶𑆑𑆯𑇀𑆖 𑇅 𑆠𑆪𑆾𑆫𑇀𑆩𑆣𑆶𑆫𑆳𑆒𑇀𑆪𑆾 𑆓𑆶𑆫𑆶𑆂, 𑆑𑆛𑆶𑆑𑆳𑆒𑇀𑆪𑆾 𑆬𑆔𑆶𑆫𑆴𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆥𑇀𑆠𑆼𑆘𑆾𑆮𑆳𑆪𑇀𑆮𑆳𑆑𑆳𑆯𑆳𑆤𑆳𑆁 𑆢𑇀𑆮𑆽𑆮𑆴𑆣𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 𑆓𑆶𑆟𑆱𑆳𑆣𑆫𑇀𑆩𑇀𑆪𑆳𑆢𑇀𑆓𑆶𑆫𑆶𑆠𑆳 𑆬𑆔𑆶𑆠𑆳 𑆖; 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆥𑆯𑇀𑆖 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆂, 𑆯𑆼𑆰𑆳𑆟𑆴 𑆬𑆔𑆷𑆤𑆴; 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣 𑆍𑆮 𑆥𑆳𑆑 𑆅𑆠𑆴 𑇆𑇑𑇐𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑆶 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆼𑆰𑆶 𑆪𑆼𑆰𑇀𑆮𑆩𑇀𑆧𑆶𑆥𑆸𑆡𑆴𑆮𑆵𑆓𑆶𑆟𑆳𑆂 𑇅 𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇁𑆣𑆴𑆑𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆥𑆳𑆑𑆾 𑆩𑆣𑆶𑆫 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇑𑇆
𑆠𑆼𑆘𑆾𑇁𑆤𑆴𑆬𑆳𑆑𑆳𑆯𑆓𑆶𑆟𑆳𑆂 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆼𑆰𑆶 𑆪𑆼𑆰𑆶 𑆠𑆶 𑇅 𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇁𑆣𑆴𑆑𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆥𑆳𑆑𑆂 𑆑𑆛𑆶𑆑 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇒𑇆
𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆢𑆫𑇀𑆯𑆴𑆤𑆳𑆩𑆼𑆰 𑆮𑆳𑆢𑆴𑆤𑆳𑆁 𑆮𑆳𑆢𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑇅 𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆩𑆥𑆴 𑆱𑆳𑆩𑆓𑇀𑆫𑇀𑆪𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑇀𑆪𑆠𑇀𑆫 𑆮𑆴𑆥𑆯𑇀𑆖𑆴𑆠𑆂 𑇆𑇑𑇓𑇆
𑆠𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆳𑆠𑇀𑆩𑆤𑆳 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆱𑆼𑆮𑆴𑆠𑆩𑇀 𑇅 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆫𑆱𑆮𑆴𑆥𑆳𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑆾𑆰𑆁 𑆲𑆤𑇀𑆠𑆴 𑆑𑆫𑆾𑆠𑆴 𑆮𑆳 𑇆𑇑𑇔𑇆
𑆥𑆳𑆑𑆾 𑆤𑆳𑆱𑇀𑆠𑆴 𑆮𑆴𑆤𑆳 𑆮𑆵𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁 𑆤𑆳𑆱𑇀𑆠𑆴 𑆮𑆴𑆤𑆳 𑆫𑆱𑆳𑆠𑇀 𑇅 𑆫𑆱𑆾 𑆤𑆳𑆱𑇀𑆠𑆴 𑆮𑆴𑆤𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆠𑆩𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇑𑇕𑇆
𑆘𑆤𑇀𑆩 𑆠𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆪𑆾𑆫𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆑𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆃𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆥𑆼𑆑𑇀𑆰𑆴𑆑𑆁 𑆘𑆤𑇀𑆩 𑆪𑆡𑆳 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆼𑆲𑆢𑆼𑆲𑆴𑆤𑆾𑆂 𑇆𑇑𑇖𑇆
𑆮𑆵𑆫𑇀𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆓𑆶𑆟𑆳 𑆪𑆼𑇁𑆰𑇀𑆛𑆿 𑆠𑆼𑇁𑆥𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇅 𑆫𑆱𑆼𑆰𑆶 𑆤 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆼𑆠𑆼 𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑆳𑆱𑇀𑆠𑆶 𑆓𑆶𑆟𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇑𑇗𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆴 𑆮𑆴𑆥𑆖𑇀𑆪𑆤𑇀𑆠𑆼 𑆤 𑆰𑆝𑇀𑆫𑆱𑆳𑆂 𑇅 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆠𑆾 𑆘𑇀𑆚𑆼𑆪𑆁, 𑆯𑆼𑆰𑆳 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆢𑆳𑆯𑇀𑆫𑆪𑆳𑆂 𑇆𑇑𑇘𑇆
𑆃𑆩𑆵𑆩𑆳𑆁𑆱𑇀𑆪𑆳𑆤𑇀𑆪𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆳𑆤𑆴 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆴 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂 𑇅 𑆄𑆓𑆩𑆼𑆤𑆾𑆥𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆨𑆼𑆰𑆘𑆳𑆤𑆴 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆽𑆂 𑇆𑇑𑇙𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆬𑆑𑇀𑆰𑆟𑆦𑆬𑆳𑆂 𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆯𑇀𑆖 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂 𑇅 𑆤𑆿𑆰𑆣𑆵𑆫𑇀𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆮𑆴𑆢𑇀𑆮𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆑𑆢𑆳𑆖𑆤 𑇆𑇒𑇐𑇆
𑆱𑆲𑆱𑇀𑆫𑆼𑆟𑆳𑆥𑆴 𑆲𑆼𑆠𑆷𑆤𑆳𑆁 𑆤𑆳𑆩𑇀𑆧𑆰𑇀𑆜𑆳𑆢𑆴𑆫𑇀𑆮𑆴𑆫𑆖𑆪𑆼𑆠𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆠𑆶 𑆩𑆠𑆴𑆩𑆳𑆤𑆳𑆓𑆩𑆼 𑆤 𑆠𑆶 𑆲𑆼𑆠𑆶𑆰𑆶 𑇆𑇒𑇑𑇆
𑆃𑆡𑆳𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑆠𑇀𑆫 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆥𑇀𑆠𑆼𑆘𑆾𑆮𑆳𑆪𑇀𑆮𑆳𑆑𑆳𑆯𑆳𑆤𑆳𑆁 𑆱𑆩𑆶𑆢𑆳𑆪𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆇𑆠𑇀𑆑𑆫𑇀𑆰𑆱𑇀𑆠𑇀𑆮𑆨𑆴𑆮𑇀𑆪𑆚𑇀𑆘𑆑𑆾 𑆨𑆮𑆠𑆴- 𑆅𑆢𑆁 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆩𑆴𑆢𑆩𑆳𑆥𑇀𑆪𑆩𑆴𑆢𑆁 𑆠𑆽𑆘𑆱𑆩𑆴𑆢𑆁 𑆮𑆳𑆪𑆮𑇀𑆪𑆩𑆴𑆢𑆩𑆳𑆑𑆳𑆯𑆵𑆪𑆩𑆴𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆡𑆷𑆬𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆤𑇀𑆢𑆱𑇀𑆡𑆴𑆫𑆓𑆶𑆫𑆶𑆑𑆜𑆴𑆤𑆁 𑆓𑆤𑇀𑆣𑆧𑆲𑆶𑆬𑆩𑆵𑆰𑆠𑇀𑆑𑆰𑆳𑆪𑆁 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆩𑆣𑆶𑆫𑆩𑆴𑆠𑆴 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆁; 𑆠𑆠𑇀 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆧𑆬𑆓𑆿𑆫𑆮𑆱𑆕𑇀𑆔𑆳𑆠𑆾𑆥𑆖𑆪𑆑𑆫𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆳𑆣𑆾𑆓𑆠𑆴𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆴𑆠𑆴 𑇅 𑆯𑆵𑆠𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆤𑇀𑆢𑆓𑆶𑆫𑆶𑆱𑆫𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆸𑆢𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆫𑆱𑆧𑆲𑆶𑆬𑆩𑆵𑆰𑆠𑇀𑆑𑆰𑆳𑆪𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆁 𑆩𑆣𑆶𑆫𑆫𑆱𑆥𑇀𑆫𑆳𑆪𑆩𑆳𑆥𑇀𑆪𑆁; 𑆠𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆤𑆲𑇀𑆬𑆳𑆢𑆤𑆑𑇀𑆬𑆼𑆢𑆤𑆧𑆤𑇀𑆣𑆤𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆤𑆑𑆫𑆩𑆴𑆠𑆴 𑇅 𑆇𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆫𑆷𑆑𑇀𑆰𑆒𑆫𑆬𑆔𑆶𑆮𑆴𑆯𑆢𑆁 𑆫𑆷𑆥𑆧𑆲𑆶𑆬𑆩𑆵𑆰𑆢𑆩𑇀𑆬𑆬𑆮𑆟𑆁 𑆑𑆛𑆶𑆑𑆫𑆱𑆥𑇀𑆫𑆳𑆪𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆓𑆠𑆴𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆴𑆠𑆴 𑆠𑆽𑆘𑆱𑆁; 𑆠𑆢𑇀𑆢𑆲𑆤𑆥𑆖𑆤𑆢𑆳𑆫𑆟𑆠𑆳𑆥𑆤𑆥𑇀𑆫𑆑𑆳𑆯𑆤𑆥𑇀𑆫𑆨𑆳𑆮𑆫𑇀𑆟𑆑𑆫𑆩𑆴𑆠𑆴 𑇅 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆫𑆷𑆑𑇀𑆰𑆒𑆫𑆯𑆴𑆯𑆴𑆫𑆬𑆔𑆶𑆮𑆴𑆯𑆢𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆧𑆲𑆶𑆬𑆩𑆵𑆰𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆑𑆰𑆳𑆪𑆩𑆴𑆠𑆴 𑆮𑆳𑆪𑆮𑆵𑆪𑆁; 𑆠𑆢𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆬𑆳𑆔𑆮𑆓𑇀𑆬𑆥𑆤𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆮𑆴𑆖𑆳𑆫𑆟𑆑𑆫𑆩𑆴𑆠𑆴 𑇅 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆩𑆸𑆢𑆶𑆮𑇀𑆪𑆮𑆳𑆪𑆴𑆮𑆴𑆯𑆢𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆁 𑆯𑆧𑇀𑆢𑆧𑆲𑆶𑆬𑆩𑆳𑆑𑆳𑆯𑆵𑆪𑆁; 𑆠𑆤𑇀𑆩𑆳𑆫𑇀𑆢𑆮𑆯𑆿𑆰𑆴𑆫𑇀𑆪𑆬𑆳𑆔𑆮𑆑𑆫𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆃𑆤𑆼𑆤 𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆼𑆤 𑆤𑆳𑆤𑆿𑆰𑆣𑆵𑆨𑆷𑆠𑆁 𑆘𑆓𑆠𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆱𑇀𑆠𑆵𑆠𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆁 𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆩𑆫𑇀𑆡𑆁 𑆖𑆳𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑇀𑆮𑆮𑆵𑆫𑇀𑆪𑆓𑆶𑆟𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆑𑆳𑆫𑇀𑆩𑆶𑆑𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆳𑆤𑆴 𑆪𑆢𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆱 𑆑𑆳𑆬𑆂, 𑆪𑆠𑇀 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆠𑆠𑇀 𑆑𑆫𑇀𑆩, 𑆪𑆼𑆤 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆠𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁, 𑆪𑆠𑇀𑆫 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆠𑆢𑆣𑆴𑆑𑆫𑆟𑆁, 𑆪𑆡𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆱 𑆇𑆥𑆳𑆪𑆂, 𑆪𑆤𑇀𑆤𑆴𑆰𑇀𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴 𑆠𑆠𑇀 𑆦𑆬𑆩𑆴𑆠𑆴 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫, 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆴, 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆥𑆾 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆂, 𑆠𑆳𑆤𑆴 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆢𑆣𑆾 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑆣𑆾𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆤𑆶𑆩𑆳𑆤𑆳𑆠𑇀 ; 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆳𑆪𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆴, 𑆃𑆓𑇀𑆤𑆴𑆮𑆳𑆪𑆶 𑆲𑆴 𑆬𑆔𑆷, 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆠𑆳𑆤𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆩𑆤𑆩𑆥𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑇀; 𑆇𑆨𑆪𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆶𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆩𑇀; 𑆄𑆑𑆳𑆯𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆱𑆁𑆯𑆩𑆤𑆁; 𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆩𑆤𑆴𑆬𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑇀, 𑆃𑆤𑆴𑆬𑆱𑇀𑆪 𑆯𑆾𑆰𑆟𑆳𑆠𑇀𑆩𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆢𑆵𑆥𑆤𑆩𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁, 𑆠𑆠𑇀𑆱𑆩𑆳𑆤𑆠𑇀𑆮𑆳𑆠𑇀; 𑆬𑆼𑆒𑆤𑆩𑆤𑆴𑆬𑆳𑆤𑆬𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁; 𑆧𑆸𑆁𑆲𑆟𑆁 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑇀; 𑆍𑆮𑆩𑆿𑆰𑆣𑆑𑆫𑇀𑆩𑆳𑆟𑇀𑆪𑆤𑆶𑆩𑆳𑆤𑆳𑆠𑇀 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇆𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆨𑆷𑆠𑆼𑆘𑆾𑆮𑆳𑆫𑆴𑆘𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆂 𑆯𑆩𑆁 𑆪𑆳𑆠𑆴 𑆱𑆩𑆵𑆫𑆟𑆂 𑇅 𑆨𑆷𑆩𑇀𑆪𑆩𑇀𑆧𑆶𑆮𑆳𑆪𑆶𑆘𑆽𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑆴𑆩𑇀 𑇆𑇗𑇆
𑆒𑆠𑆼𑆘𑆾𑇁𑆤𑆴𑆬𑆘𑆽𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆯𑆩𑆩𑆼𑆠𑆴 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀 𑇅 𑆮𑆴𑆪𑆠𑇀𑆥𑆮𑆤𑆘𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆨𑇀𑆪𑆼𑆠𑆴 𑆩𑆳𑆫𑆶𑆠𑆂 𑇆𑇘𑇆
𑆄𑆓𑇀𑆤𑆼𑆪𑆩𑆼𑆮 𑆪𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆠𑆼𑆤 𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆢𑆵𑆫𑇀𑆪𑆠𑆼 𑇅 𑆮𑆱𑆶𑆣𑆳𑆘𑆬𑆘𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆧𑆬𑆳𑆱𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑇆𑇙𑇆
𑆍𑆮𑆩𑆼𑆠𑆢𑇀𑆓𑆶𑆟𑆳𑆣𑆴𑆑𑇀𑆪𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆩𑇀 𑇅 𑆢𑇀𑆮𑆴𑆯𑆾 𑆮𑆳 𑆧𑆲𑆶𑆯𑆾 𑆮𑆳𑇁𑆥𑆴 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆢𑆾𑆰𑆼𑆰𑆶 𑆖𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆪 𑆅𑆩𑆼 𑆓𑆶𑆟𑆳 𑆮𑆵𑆫𑇀𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆳𑆂 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆩𑆸𑆢𑆶𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆮𑆴𑆯𑆢𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆳𑆮𑆳𑆓𑇀𑆤𑆼𑆪𑆿, 𑆯𑆵𑆠𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆮𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆿 , 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆂 𑆱𑇀𑆤𑆼𑆲𑆂, 𑆠𑆾𑆪𑆳𑆑𑆳𑆯𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆩𑆸𑆢𑆶𑆠𑇀𑆮𑆁, 𑆮𑆳𑆪𑆶𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁, 𑆑𑇀𑆰𑆴𑆠𑆴𑆱𑆩𑆵𑆫𑆟𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆮𑆽𑆯𑆢𑇀𑆪𑆁; 𑆮𑆴𑆥𑆳𑆑𑆳𑆮𑆶𑆑𑇀𑆠𑆓𑆶𑆟𑆿 𑇅 𑆠𑆠𑇀𑆫, 𑆇𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆿 𑆮𑆳𑆠𑆔𑇀𑆤𑆿, 𑆯𑆵𑆠𑆩𑆸𑆢𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆂, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆫𑆷𑆑𑇀𑆰𑆮𑆴𑆯𑆢𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆳𑆂 𑆓𑆶𑆫𑆶𑆥𑆳𑆑𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆂, 𑆬𑆔𑆶𑆥𑆳𑆑𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆩𑆸𑆢𑆶𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆳𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆳𑆂, 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆮𑆴𑆯𑆢𑆿 𑆖𑆑𑇀𑆰𑆶𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆨𑇀𑆪𑆳𑆁, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆿 𑆖𑆑𑇀𑆰𑆶𑆰𑆳, 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾 𑆩𑆶𑆒𑆼 𑆢𑆶𑆂𑆒𑆾𑆠𑇀𑆥𑆳𑆢𑆤𑆳𑆠𑇀 𑇅 𑆓𑆶𑆫𑆶𑆥𑆳𑆑𑆂 𑆱𑆸𑆰𑇀𑆛𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆠𑆪𑆳 𑆑𑆦𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆼𑆤 𑆖, 𑆬𑆔𑆶𑆫𑇀𑆧𑆢𑇀𑆣𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆠𑆪𑆳 𑆩𑆳𑆫𑆶𑆠𑆑𑆾𑆥𑆼𑆤 𑆖 𑇅 𑆠𑆠𑇀𑆫 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆼𑆰𑆶 𑆨𑆷𑆠𑆼𑆰𑆶 𑆫𑆱𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆩𑆶𑆥𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆾 𑆓𑆶𑆫𑆶𑆯𑇀𑆖 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆂, 𑆩𑆣𑆶𑆫𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑇀𑆖𑆳𑆥𑇀𑆪 𑆅𑆠𑆴 𑇆𑇑𑇑𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆶𑆟𑆳 𑆪 𑆇𑆑𑇀𑆠𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑆶 𑆯𑆫𑆵𑆫𑆼𑆰𑇀𑆮𑆥𑆴 𑆠𑆼 𑆠𑆡𑆳 𑇅 𑆱𑇀𑆡𑆳𑆤𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑇀𑆰𑆪𑆳𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆲𑆼𑆠𑆶𑆑𑆳𑆂 𑇆𑇑𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆱𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆄𑆑𑆳𑆯𑆥𑆮𑆤𑆢𑆲𑆤𑆠𑆾𑆪𑆨𑆷𑆩𑆴𑆰𑆶 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆩𑆼𑆑𑆾𑆠𑇀𑆠𑆫𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆂 𑆯𑆧𑇀𑆢𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆳𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆥𑇀𑆪𑆾 𑆫𑆱𑆂 𑇅 𑆥𑆫𑆱𑇀𑆥𑆫𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀 𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆠𑇀 𑆥𑆫𑆱𑇀𑆥𑆫𑆳𑆤𑆶𑆥𑇀𑆫𑆮𑆼𑆯𑆳𑆖𑇀𑆖 𑆱𑆫𑇀𑆮𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆣𑇀𑆪𑆩𑆱𑇀𑆠𑆴, 𑆇𑆠𑇀𑆑𑆫𑇀𑆰𑆳𑆥𑆑𑆫𑇀𑆰𑆳𑆠𑇀𑆠𑆶 𑆓𑇀𑆫𑆲𑆟𑆩𑇀 𑇅 𑆱 𑆒𑆬𑇀𑆮𑆳𑆥𑇀𑆪𑆾 𑆫𑆱𑆂 𑆯𑆼𑆰𑆨𑆷𑆠𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆰𑆾𑆞𑆳 𑆮𑆴𑆨𑆘𑇀𑆪𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆣𑆶𑆫𑆾𑇁𑆩𑇀𑆬𑆾 𑆬𑆮𑆟𑆂 𑆑𑆛𑆶𑆑𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆂 𑆑𑆰𑆳𑆪 𑆅𑆠𑆴 𑇅 𑆠𑆼 𑆖 𑆨𑆷𑆪𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆣𑆳 𑆨𑆴𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑇅 𑆠𑆠𑇀𑆫, 𑆨𑆷𑆩𑇀𑆪𑆩𑇀𑆧𑆶𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆤𑇀𑆩𑆣𑆶𑆫𑆂, 𑆨𑆷𑆩𑇀𑆪𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆢𑆩𑇀𑆬𑆂, 𑆠𑆾𑆪𑆳𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆬𑇀𑆬𑆮𑆟𑆂 , 𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆑𑆛𑆶𑆑𑆂, 𑆮𑆳𑆪𑇀𑆮𑆳𑆑𑆳𑆯𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆂, 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆤𑆴𑆬𑆓𑆶𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫, 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳 𑆮𑆳𑆠𑆔𑇀𑆤𑆳𑆂, 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆳𑆂, 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆔𑇀𑆤𑆳𑆂 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆪𑆾𑆫𑆳𑆠𑇀𑆩𑆽𑆮𑆳𑆠𑇀𑆩𑆳, 𑆥𑆴𑆠𑇀𑆠𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑆿𑆩𑇀𑆪 𑆅𑆠𑆴 𑇆𑇕𑇆
𑆠 𑆍𑆠𑆼 𑆫𑆱𑆳𑆂 𑆱𑇀𑆮𑆪𑆾𑆤𑆴𑆮𑆫𑇀𑆣𑆤𑆳, 𑆃𑆤𑇀𑆪𑆪𑆾𑆤𑆴𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆯𑇀𑆖 𑇆𑇖𑇆
𑆑𑆼𑆖𑆴𑆢𑆳𑆲𑆶𑆂- 𑆃𑆓𑇀𑆤𑆵𑆰𑆾𑆩𑆵𑆪𑆠𑇀𑆮𑆳𑆘𑇀𑆘𑆓𑆠𑆾 𑆫𑆱𑆳 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆂- 𑆱𑆿𑆩𑇀𑆪𑆳 𑆄𑆓𑇀𑆤𑆼𑆪𑆳𑆯𑇀𑆖 𑇅 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆂 𑆱𑆿𑆩𑇀𑆪𑆳𑆂; 𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆳 𑆄𑆓𑇀𑆤𑆼𑆪𑆳𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆓𑆶𑆫𑆮𑆯𑇀𑆖, 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳 𑆫𑆷𑆑𑇀𑆰𑆳 𑆬𑆔𑆮𑆯𑇀𑆖; 𑆱𑆿𑆩𑇀𑆪𑆳𑆂 𑆯𑆵𑆠𑆳𑆂, 𑆄𑆓𑇀𑆤𑆼𑆪𑆳 𑆇𑆰𑇀𑆟𑆳𑆂 𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑆽𑆠𑇀𑆪𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆬𑆳𑆔𑆮𑆮𑆽𑆯𑆢𑇀𑆪𑆮𑆽𑆰𑇀𑆛𑆩𑇀𑆨𑇀𑆪𑆓𑆶𑆟𑆬𑆑𑇀𑆰𑆟𑆾 𑆮𑆳𑆪𑆶𑆂, 𑆠𑆱𑇀𑆪 𑆱𑆩𑆳𑆤𑆪𑆾𑆤𑆴𑆂 𑆑𑆰𑆳𑆪𑆾 𑆫𑆱𑆂; 𑆱𑆾𑇁𑆱𑇀𑆪 𑆯𑆽𑆠𑇀𑆪𑆳𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁, 𑆬𑆳𑆔𑆮𑆳𑆬𑇀𑆬𑆳𑆔𑆮𑆁, 𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆁, 𑆮𑆽𑆰𑇀𑆛𑆩𑇀𑆨𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆰𑇀𑆛𑆩𑇀𑆨𑇀𑆪𑆩𑆴𑆠𑆴 𑇅 𑆐𑆰𑇀𑆟𑇀𑆪𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆬𑆳𑆔𑆮𑆮𑆽𑆯𑆢𑇀𑆪𑆓𑆶𑆟𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆁, 𑆠𑆱𑇀𑆪 𑆱𑆩𑆳𑆤𑆪𑆾𑆤𑆴𑆂 𑆑𑆛𑆶𑆑𑆾 𑆫𑆱𑆂; 𑆱𑆾𑇁𑆱𑇀𑆪 𑆐𑆰𑇀𑆟𑇀𑆪𑆳𑆢𑆿𑆰𑇀𑆟𑇀𑆪𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆁, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁, 𑆬𑆳𑆔𑆮𑆳𑆬𑇀𑆬𑆳𑆔𑆮𑆁, 𑆮𑆽𑆯𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆯𑆢𑇀𑆪𑆩𑆴𑆠𑆴 𑇅 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆱𑇀𑆤𑆼𑆲𑆓𑆿𑆫𑆮𑆯𑆽𑆠𑇀𑆪𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆓𑆶𑆟𑆬𑆑𑇀𑆰𑆟𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳; 𑆠𑆱𑇀𑆪 𑆱𑆩𑆳𑆤𑆪𑆾𑆤𑆴𑆫𑇀𑆩𑆣𑆶𑆫𑆾 𑆫𑆱𑆂, 𑆱𑆾𑇁𑆱𑇀𑆪 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁 𑆮𑆫𑇀𑆣𑆪𑆠𑆴, 𑆱𑇀𑆤𑆼𑆲𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆁, 𑆓𑆿𑆫𑆮𑆳𑆢𑇀𑆓𑆿𑆫𑆮𑆁, 𑆯𑆽𑆠𑇀𑆪𑆳𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆁, 𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆳𑆠𑇀𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆩𑆴𑆠𑆴 𑇆𑇘𑇆
𑆫𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫, 𑆪𑆂 𑆥𑆫𑆴𑆠𑆾𑆰𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆪𑆠𑆴 𑆠𑆫𑇀𑆥𑆪𑆠𑆴 𑆘𑆵𑆮𑆪𑆠𑆴 𑆩𑆶𑆒𑆾𑆥𑆬𑆼𑆥𑆁 𑆘𑆤𑆪𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆖𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆠𑆴 𑆱 𑆩𑆣𑆶𑆫𑆂; 𑆪𑆾 𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆩𑆶𑆒𑆳𑆱𑇀𑆫𑆳𑆮𑆁 𑆘𑆤𑆪𑆠𑆴 𑆯𑇀𑆫𑆢𑇀𑆣𑆳𑆁 𑆖𑆾𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆱𑆾𑇁𑆩𑇀𑆬𑆂; 𑆪𑆾 𑆨𑆑𑇀𑆠𑆫𑆶𑆖𑆴𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆁 𑆘𑆤𑆪𑆠𑆴 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑆱 𑆬𑆮𑆟𑆂; 𑆪𑆾 𑆘𑆴𑆲𑇀𑆮𑆳𑆓𑇀𑆫𑆁 𑆧𑆳𑆣𑆠𑆼 𑆇𑆢𑇀𑆮𑆼𑆓𑆁 𑆘𑆤𑆪𑆠𑆴 𑆯𑆴𑆫𑆾 𑆓𑆸𑆲𑇀𑆟𑆵𑆠𑆼 𑆤𑆳𑆱𑆴𑆑𑆳𑆁 𑆱𑇀𑆫𑆳𑆮𑆪𑆠𑆴 𑆱 𑆑𑆛𑆶𑆑𑆂; 𑆪𑆾 𑆓𑆬𑆼 𑆖𑆾𑆰𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆩𑆶𑆒𑆮𑆽𑆯𑆢𑇀𑆪𑆁 𑆘𑆤𑆪𑆠𑆴 𑆨𑆑𑇀𑆠𑆫𑆶𑆖𑆴𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑆲𑆫𑇀𑆰𑆁 𑆖 𑆱 𑆠𑆴𑆑𑇀𑆠𑆂; 𑆪𑆾 𑆮𑆑𑇀𑆠𑇀𑆫𑆁 𑆥𑆫𑆴𑆯𑆾𑆰𑆪𑆠𑆴 𑆘𑆴𑆲𑇀𑆮𑆳𑆁 𑆱𑇀𑆠𑆩𑇀𑆨𑆪𑆠𑆴 𑆑𑆟𑇀𑆜𑆁 𑆧𑆣𑇀𑆤𑆳𑆠𑆴 𑆲𑆸𑆢𑆪𑆁 𑆑𑆫𑇀𑆰𑆠𑆴 𑆥𑆵𑆝𑆪𑆠𑆴 𑆖 𑆱 𑆑𑆰𑆳𑆪 𑆅𑆠𑆴 𑇆𑇙𑇆
𑆫𑆱𑆓𑆶𑆟𑆳𑆤𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫, 𑆩𑆣𑆶𑆫𑆾 𑆫𑆱𑆾 𑆫𑆱𑆫𑆑𑇀𑆠𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆿𑆘𑆂𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆠𑆤𑇀𑆪𑆮𑆫𑇀𑆣𑆤𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆂 𑆑𑆼𑆯𑇀𑆪𑆾 𑆮𑆫𑇀𑆟𑇀𑆪𑆾 𑆧𑆬𑆑𑆸𑆠𑇀𑆱𑆤𑇀𑆣𑆳𑆤𑆂 𑆯𑆾𑆟𑆴𑆠𑆫𑆱𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆾 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆲𑆴𑆠𑆂 𑆰𑆛𑇀𑆥𑆢𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆤𑆳𑆩𑆴𑆰𑇀𑆛𑆠𑆩𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆳𑆲𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆰𑆝𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆱𑆳𑆢𑆤𑆂 𑆑𑆸𑆩𑆴𑆑𑆦𑆑𑆫𑆯𑇀𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆳𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆂 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆬𑆱𑆑𑆮𑆩𑆡𑆶𑆮𑆢𑆤𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆱𑇀𑆮𑆫𑆾𑆥𑆔𑆳𑆠𑆑𑆸𑆩𑆴𑆓𑆬𑆓𑆟𑇀𑆝𑆳𑆤𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑆠𑆡𑆳𑇁𑆫𑇀𑆧𑆶𑆢𑆯𑇀𑆬𑆵𑆥𑆢𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆢𑆾𑆥𑆬𑆼𑆥𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆚𑇀𑆘𑆤𑆪𑆠𑆴 𑇅 𑆃𑆩𑇀𑆬𑆾 𑆘𑆫𑆟𑆂 𑆥𑆳𑆖𑆤𑆾 𑆢𑆵𑆥𑆤𑆂 𑆥𑆮𑆤𑆤𑆴𑆓𑇀𑆫𑆲𑆟𑆾𑇁𑆤𑆶𑆬𑆾𑆩𑆤𑆂 𑆑𑆾𑆰𑇀𑆜𑆮𑆴𑆢𑆳𑆲𑆵 𑆧𑆲𑆴𑆂𑆯𑆵𑆠𑆂 𑆑𑇀𑆬𑆼𑆢𑆤𑆂 𑆥𑇀𑆫𑆳𑆪𑆯𑆾 𑆲𑇀𑆪𑆢𑇀𑆪𑆯𑇀𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆾 𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆤𑆪𑆤𑆱𑆩𑇀𑆩𑆵𑆬𑆤𑆫𑆾𑆩𑆱𑆁𑆮𑆼𑆘𑆤𑆑𑆦𑆮𑆴𑆬𑆪𑆤𑆯𑆫𑆵𑆫𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆠𑆡𑆳 𑆑𑇀𑆰𑆠𑆳𑆨𑆴𑆲𑆠𑆢𑆓𑇀𑆣𑆢𑆰𑇀𑆛𑆨𑆓𑇀𑆤𑆫𑆶𑆓𑇀𑆟𑆯𑆷𑆤𑆥𑇀𑆫𑆖𑇀𑆪𑆶𑆠𑆳𑆮𑆩𑆷𑆠𑇀𑆫𑆴𑆠𑆮𑆴𑆱𑆫𑇀𑆥𑆴𑆠𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆨𑆴𑆤𑇀𑆤𑆮𑆴𑆢𑇀𑆣𑆾𑆠𑇀𑆥𑆴𑆰𑇀𑆛𑆳𑆢𑆵𑆤𑆴 𑆥𑆳𑆖𑆪𑆠𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆠𑇀 𑆥𑆫𑆴𑆢𑆲𑆠𑆴 𑆑𑆟𑇀𑆜𑆩𑆶𑆫𑆾 𑆲𑆸𑆢𑆪𑆁 𑆖𑆼𑆠𑆴 𑇅 𑆬𑆮𑆟𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆂 𑆥𑆳𑆖𑆤𑆾 𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆟𑆂 𑆑𑇀𑆬𑆼𑆢𑆤𑆂 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆑𑆸𑆢𑆶𑆰𑇀𑆟𑆂 𑆱𑆫𑇀𑆮𑆫𑆱𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆾 𑆩𑆳𑆫𑇀𑆓𑆮𑆴𑆯𑆾𑆣𑆤𑆂 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆩𑆳𑆫𑇀𑆢𑆮𑆑𑆫𑆯𑇀𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆳𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆾 𑆓𑆳𑆠𑇀𑆫𑆑𑆟𑇀𑆝𑆷𑆑𑆾𑆜𑆯𑆾𑆦𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆾𑆥𑆔𑆳𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆠𑆳𑆥𑆩𑆶𑆒𑆳𑆑𑇀𑆰𑆴𑆥𑆳𑆑𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆳𑆩𑇀𑆬𑆵𑆑𑆳𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆤𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑇅 𑆑𑆛𑆶𑆑𑆾 𑆢𑆵𑆥𑆤𑆂 𑆥𑆳𑆖𑆤𑆾 𑆫𑆾𑆖𑆤𑆂 𑆯𑆾𑆣𑆤𑆂 𑆱𑇀𑆡𑆿𑆬𑇀𑆪𑆳𑆬𑆱𑇀𑆪𑆑𑆦𑆑𑆸𑆩𑆴𑆮𑆴𑆰𑆑𑆶𑆰𑇀𑆜𑆑𑆟𑇀𑆝𑆷𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆱𑆤𑇀𑆣𑆴𑆧𑆤𑇀𑆣𑆮𑆴𑆖𑇀𑆗𑆼𑆢𑆤𑆾𑇁𑆮𑆱𑆳𑆢𑆤𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆢𑆱𑆳𑆩𑆶𑆥𑆲𑆤𑇀𑆠𑆳 𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆾 𑆨𑇀𑆫𑆩𑆩𑆢𑆓𑆬𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆯𑆾𑆰𑆢𑆳𑆲𑆱𑆤𑇀𑆠𑆳𑆥𑆧𑆬𑆮𑆴𑆔𑆳𑆠𑆑𑆩𑇀𑆥𑆠𑆾𑆢𑆨𑆼𑆢𑆑𑆸𑆠𑇀 𑆑𑆫𑆖𑆫𑆟𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆖 𑆮𑆳𑆠𑆯𑆷𑆬𑆳𑆤𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑇅 𑆠𑆴𑆑𑇀𑆠𑆯𑇀𑆗𑆼𑆢𑆤𑆾 𑆫𑆾𑆖𑆤𑆾 𑆢𑆵𑆥𑆤𑆂 𑆯𑆾𑆣𑆤𑆂 𑆑𑆟𑇀𑆝𑆷𑆑𑆾𑆜𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆘𑇀𑆮𑆫𑆥𑇀𑆫𑆯𑆩𑆤𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆯𑆾𑆣𑆤𑆾 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆩𑆼𑆢𑆾𑆮𑆱𑆳𑆥𑆷𑆪𑆾𑆥𑆯𑆾𑆰𑆟𑆯𑇀𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆾 𑆓𑆳𑆠𑇀𑆫𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆳𑆫𑇀𑆢𑆴𑆠𑆯𑆴𑆫𑆂𑆯𑆷𑆬𑆨𑇀𑆫𑆩𑆠𑆾𑆢𑆨𑆼𑆢𑆖𑇀𑆗𑆼𑆢𑆳𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆥𑆳𑆢𑆪𑆠𑆴 𑇅 𑆑𑆰𑆳𑆪𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆑𑆾 𑆫𑆾𑆥𑆟𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆂 𑆯𑆾𑆣𑆤𑆾 𑆬𑆼𑆒𑆤𑆂 𑆯𑆾𑆰𑆟𑆂 𑆥𑆵𑆝𑆤𑆂 𑆑𑇀𑆬𑆼𑆢𑆾𑆥𑆯𑆾𑆰𑆟𑆯𑇀𑆖𑆼𑆠𑆴; 𑆱 𑆍𑆮𑆕𑇀𑆓𑆶𑆟𑆾𑇁𑆥𑇀𑆪𑆼𑆑 𑆍𑆮𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆾 𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆳𑆱𑇀𑆪𑆯𑆾𑆰𑆾𑆢𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆮𑆳𑆑𑇀𑆪𑆓𑇀𑆫𑆲𑆩𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆩𑇀𑆨- 𑆓𑆳𑆠𑇀𑆫𑆱𑇀𑆦𑆶𑆫𑆟𑆖𑆶𑆩𑆶𑆖𑆶𑆩𑆳𑆪𑆤𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆳𑆑𑇀𑆰𑆼𑆥𑆟𑆥𑇀𑆫𑆨𑆸𑆠𑆵𑆚𑇀𑆘𑆤𑆪𑆠𑆴 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫𑆽𑆠𑆼𑆰𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆱𑆁𑆪𑆾𑆓𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆚𑇀𑆖𑆢𑆯 𑆢𑇀𑆮𑆴𑆑𑆳𑆂, 𑆮𑆴𑆁𑆯𑆠𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆳𑆂, 𑆥𑆚𑇀𑆖𑆢𑆯 𑆖𑆠𑆶𑆰𑇀𑆑𑆳𑆂, 𑆰𑆛𑇀 𑆥𑆚𑇀𑆖𑆑𑆳𑆂, 𑆍𑆑𑆯𑆂 𑆰𑆝𑇀𑆫𑆱𑆳𑆂, 𑆍𑆑𑆂 𑆰𑆛𑇀𑆑 𑆅𑆠𑆴 𑇅 𑆠𑆼𑆰𑆳𑆩𑆤𑇀𑆪𑆠𑇀𑆫 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆳𑆤𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆘𑆓𑇀𑆣𑆳𑆂 𑆰𑆝𑆣𑆴𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆧𑆬𑆴𑆤𑆾 𑆮𑆯𑇀𑆪𑆠𑆳𑆁 𑆫𑆱𑆳𑆂 𑇅 𑆪𑆡𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆢𑆾𑆰𑆳 𑆮𑆯𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆧𑆬𑆵𑆪𑆱𑆂 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆘𑆵𑆩𑆷𑆠𑆑𑆑𑆶𑆱𑆶𑆩𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆼𑆮 𑆑𑇀𑆰𑆵𑆫𑆼𑆟, 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑆰𑆶 𑆑𑇀𑆰𑆵𑆫𑆪𑆮𑆳𑆓𑆷𑆁, 𑆫𑆾𑆩𑆯𑆼𑆰𑆶 𑆱𑆤𑇀𑆠𑆳𑆤𑆴𑆑𑆳𑆁, 𑆃𑆫𑆾𑆩𑆯𑆼𑆰𑆶 𑆢𑆣𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆁, 𑆲𑆫𑆴𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆰𑆶 𑆢𑆣𑆴, 𑆠𑆠𑇀𑆑𑆰𑆳𑆪𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆁 𑆮𑆳 𑆱𑆶𑆫𑆳𑆁 𑆑𑆦𑆳𑆫𑆾𑆖𑆑𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆪𑆑𑇀𑆰𑇀𑆩𑆱𑆶; 𑆥𑆫𑇀𑆪𑆳𑆓𑆠𑆼𑆰𑆶 𑆩𑆢𑆤𑆦𑆬𑆩𑆘𑇀𑆘𑆮𑆢𑆶𑆥𑆪𑆾𑆓𑆂 𑇆𑇔𑇆
𑆠𑆢𑇀𑆮𑆢𑆼𑆮 𑆑𑆶𑆛𑆘𑆦𑆬𑆮𑆴𑆣𑆳𑆤𑆩𑇀 𑇆𑇕𑇆
𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆳𑆤𑆳𑆩𑆥𑇀𑆪𑆼𑆰 𑆍𑆮 𑆑𑆬𑇀𑆥𑆂 𑇆𑇖𑇆
𑆅𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶𑆑𑆶𑆱𑆶𑆩𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 , 𑆍𑆮𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟, 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆑𑆦𑆫𑆾𑆓𑆼𑆰𑆷𑆥𑆪𑆾𑆓𑆂 𑇆𑇗𑇆
𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆱𑇀𑆪𑆳𑆥𑆴 𑆩𑆢𑆤𑆦𑆬𑆩𑆘𑇀𑆘𑆮𑆢𑆶𑆥𑆪𑆾𑆓𑆂; 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆓𑆫𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆩𑆪𑆼𑆰𑆶 𑆮𑆳𑆪𑆿 𑆖 𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼 𑇆𑇘𑇆
𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑆳𑆁 𑆧𑆲𑆶𑆯𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆩𑆶𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆰𑆶 𑆢𑆠𑇀𑆠𑆩𑆳𑆔𑇀𑆫𑆳𑆠𑆁 𑆮𑆳𑆩𑆪𑆠𑆴, 𑆠𑆠𑇀𑆠𑇀𑆮𑆤𑆮𑆧𑆢𑇀𑆣𑆢𑆾𑆰𑆼𑆰𑆶 𑆪𑆮𑆳𑆓𑆷𑆩𑆳𑆑𑆟𑇀𑆜𑆳𑆠𑇀𑆥𑆵𑆠𑆮𑆠𑇀𑆱𑆶 𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆾𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆼𑆮𑆁 𑆮𑆳 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇙𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆮𑆩𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆪𑆾𑆓𑆳𑆟𑆳𑆁 𑆢𑆴𑆓𑆴𑆪𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳 𑇅 𑆠𑆳𑆤𑇀 𑆮𑆴𑆨𑆘𑇀𑆪 𑆪𑆡𑆳𑆮𑇀𑆪𑆳𑆣𑆴 𑆑𑆳𑆬𑆯𑆑𑇀𑆠𑆴𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆳𑆠𑇀 𑇆𑇑𑇐𑇆
𑆑𑆰𑆳𑆪𑆽𑆂 𑆱𑇀𑆮𑆫𑆱𑆽𑆂 𑆑𑆬𑇀𑆑𑆽𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑆥𑆴 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆥𑆼𑆪𑆬𑆼𑆲𑇀𑆪𑆳𑆢𑇀𑆪𑆨𑆾𑆘𑇀𑆪𑆼𑆰𑆶 𑆮𑆩𑆤𑆳𑆤𑇀𑆪𑆶𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆫𑆶𑆟𑆳𑆨𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆤𑇀𑆩𑆷𑆬𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆩𑆷𑆬𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑇅 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆠𑆴𑆬𑇀𑆮𑆑𑆱𑇀𑆠𑇀𑆮𑆑𑇀𑆰𑆶 𑆦𑆬𑆼𑆰𑇀𑆮𑆥𑆴 𑆲𑆫𑆵𑆠𑆑𑆵 𑇆𑇓𑇆
𑆠𑆽𑆬𑆼𑆰𑇀𑆮𑆼𑆫𑆟𑇀𑆝𑆘𑆁 𑆠𑆽𑆬𑆁 𑆱𑇀𑆮𑆫𑆱𑆼 𑆑𑆳𑆫𑆮𑆼𑆬𑇀𑆬𑆴𑆑𑆳 𑇅 𑆱𑆶𑆣𑆳𑆥𑆪𑆂 𑆥𑆪𑆂𑆱𑆷𑆑𑇀𑆠𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆣𑆳𑆤𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆪𑆡𑆳𑆮𑆢𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆯𑆂 𑇆𑇔𑇆
𑆮𑆽𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆱𑆳𑆤𑆶𑆥𑆵𑆠𑆁 𑆩𑆷𑆬𑆁 𑆩𑆲𑆠𑇀𑆠𑇀𑆫𑆽𑆮𑆸𑆠𑆩𑆱𑇀𑆠𑆢𑆾𑆰𑆩𑇀 𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆤𑆳𑆓𑆫𑆳𑆞𑇀𑆪𑆩𑆩𑇀𑆬𑆽𑆂 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆳𑆫𑆶𑆠𑆫𑆾𑆓𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇕𑇆
𑆅𑆑𑇀𑆰𑆾𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆫𑇀𑆩𑆣𑆶𑆫𑆽 𑆫𑆱𑆽𑆱𑇀𑆠𑆠𑇀 𑆥𑆽𑆠𑇀𑆠𑆼 𑆓𑆢𑆼 𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆠𑆁 𑆥𑆴𑆧𑆼𑆖𑇀𑆖 𑇅 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆼𑆤 𑆱𑆮𑇀𑆪𑆾𑆰𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑆦𑆘𑆼 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆠𑇀 𑇆𑇖𑇆
𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆟𑆑𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆪𑆶𑆑𑇀𑆠𑆩𑆼𑆠𑆢𑇀𑆓𑆶𑆝𑆼𑆤 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑆤𑆮𑆼𑆤 𑆖𑆷𑆫𑇀𑆟𑆩𑇀 𑇅 𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆖 𑆠𑆤𑇀𑆩𑆷𑆬𑆫𑆱𑆱𑇀𑆪 𑆢𑆠𑇀𑆮𑆳 𑆠𑆤𑇀𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆑𑆶𑆝𑆮𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑇀 𑇆𑇗𑇆
𑆑𑆫𑇀𑆰𑆾𑆤𑇀𑆩𑆴𑆠𑆼 𑆱𑆽𑆤𑇀𑆣𑆮𑆤𑆳𑆓𑆫𑆼 𑆖 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆑𑆬𑇀𑆑𑆵𑆑𑆸𑆠𑆩𑆼𑆠𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀𑆑𑆬𑇀𑆑𑆨𑆳𑆓𑆂 𑆱𑆩𑆲𑆿𑆰𑆣𑆳𑆫𑇀𑆣𑆂 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆾 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆠𑆯𑇀𑆖 𑆥𑆼𑆪𑆂 𑇆𑇘𑇆
𑆱𑆩𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆸𑆤𑇀𑆤𑆳𑆓𑆫𑆑𑆳𑆨𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆨𑆳𑆓𑆳𑆫𑇀𑆣𑆑𑆁 𑆥𑆷𑆓𑆦𑆬𑆁 𑆱𑆶𑆥𑆑𑇀𑆮𑆩𑇀 𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆳𑆫𑆾 𑆩𑆫𑆴𑆖𑆁 𑆱𑆢𑆳𑆫𑆶 𑆪𑆾𑆓𑆂 𑆱𑆱𑆴𑆤𑇀𑆣𑆷𑆢𑇀𑆨𑆮𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑇆𑇙𑇆
(𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆮𑆁 𑆠𑆶 𑆖𑆷𑆫𑇀𑆟𑆁 𑆫𑆱𑆼𑆤 𑆠𑆼𑆰𑆳𑆁 𑆨𑆴𑆰𑆘𑆳 𑆮𑆴𑆩𑆸𑆢𑇀𑆪 𑇅 𑆠𑆤𑇀𑆩𑆷𑆬𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆖 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇁𑇁𑆑𑇀𑆠𑆁 𑆱𑆼𑆮𑇀𑆪𑆁 𑆠𑆢𑆳𑆘𑇀𑆪𑆼 𑆓𑆶𑆛𑆴𑆑𑆵𑆑𑆸𑆠𑆁 𑆖 𑇆𑇑𑇐𑇆
𑆓𑆶𑆝𑆼 𑆖 𑆥𑆳𑆑𑆳𑆨𑆴𑆩𑆶𑆒𑆼 𑆤𑆴𑆣𑆳𑆪 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆴𑆢𑆁 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑇅 𑆯𑆵𑆠𑆁 𑆠𑇀𑆫𑆴𑆘𑆳𑆠𑆳𑆑𑇀𑆠𑆩𑆡𑆾 𑆮𑆴𑆩𑆸𑆢𑇀𑆪 𑆪𑆾𑆓𑆳𑆤𑆶𑆫𑆷𑆥𑆳 𑆓𑆶𑆛𑆴𑆑𑆳𑆂 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳𑆂) 𑇆𑇑𑇑𑇆
𑆮𑆽𑆫𑆼𑆑𑆵𑆪𑆢𑇀𑆫𑆮𑇀𑆪𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆪 𑆨𑆳𑆓𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆳𑆫𑇀𑆣𑆁 𑆑𑇀𑆮𑆳𑆡𑆨𑆳𑆓𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑆴𑆂 𑇅 𑆄𑆩𑆸𑆢𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆠𑆖𑇀𑆗𑆸𑆠𑆼𑆤 𑆠𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑆾𑆰𑇀𑆩𑆱𑇀𑆮𑆼𑆢𑆴𑆠𑆁 𑆱𑆳𑆩𑆴𑆠𑆁 𑆖 𑇆𑇑𑇒𑇆

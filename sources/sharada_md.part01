𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆁 𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆁 𑆖 𑆱𑆑𑇀𑆰𑆳𑆫𑆬𑆮𑆟𑆽𑆫𑇀𑆔𑆸𑆠𑆽𑆂 𑇅 𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆴𑆠𑆳𑆓𑇀𑆤𑆴𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆖 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆖𑆽𑆮 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀 𑇆𑇓𑇙𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆨𑆽𑆰𑆘𑇀𑆪𑆽𑆫𑇀𑆢𑆾𑆰𑆱𑇀𑆠𑆷𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆴𑆠𑆾 𑆧𑆬𑆳𑆠𑇀 𑇅 𑆤𑆴𑆬𑆵𑆪𑆠𑆼 𑆤 𑆩𑆳𑆫𑇀𑆓𑆼𑆰𑆶 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼 𑆨𑆳𑆟𑇀𑆝 𑆅𑆮𑆾𑆢𑆑𑆩𑇀 𑇆𑇔𑇐𑇆
𑆤 𑆖𑆳𑆠𑆴𑆱𑇀𑆤𑆼𑆲𑆥𑆵𑆠𑆱𑇀𑆠𑆶 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀 𑇅 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆖𑆬𑆴𑆠𑆳𑆂 𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑇀𑆨𑆷𑆪𑆂 𑆯𑇀𑆬𑆴𑆰𑇀𑆪𑆤𑇀𑆠𑆴 𑆮𑆫𑇀𑆠𑇀𑆩𑆱𑆶 𑇆𑇔𑇑𑇆
𑆮𑆴𑆰𑆳𑆨𑆴𑆔𑆳𑆠𑆥𑆴𑆝𑆑𑆳𑆯𑆾𑆦𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆴𑆱𑆫𑇀𑆥𑆴𑆟𑆂 𑇅 𑆤𑆳𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆮𑆴𑆯𑆾𑆣𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆡𑆳 𑆑𑆶𑆰𑇀𑆜𑆴𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆂 𑇆𑇔𑇒𑇆
𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆠𑆶 𑆨𑆷𑆪𑆂 𑆱𑆁𑆱𑇀𑆤𑆼𑆲𑇀𑆪 𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇅 𑆠𑆼𑆤 𑆢𑆾𑆰𑆳 𑆲𑆸𑆠𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆨𑆮𑆤𑇀𑆠𑆴 𑆧𑆬𑆮𑆫𑇀𑆣𑆤𑆳𑆂 𑇆𑇔𑇓𑇆
𑆥𑇀𑆫𑆳𑆓𑆥𑆵𑆠𑆁 𑆤𑆫𑆁 𑆯𑆾𑆣𑇀𑆪𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑆿𑆰𑆣𑆁 𑆩𑆸𑆢𑆶 𑇅 𑆠𑆠𑆾 𑆮𑆴𑆘𑇀𑆚𑆳𑆠𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑆶𑆤𑆂 𑇆𑇔𑇔𑇆
𑆱𑆶𑆒𑆁 𑆢𑆸𑆰𑇀𑆛𑆦𑆬𑆁 𑆲𑆸𑆢𑇀𑆪𑆩𑆬𑇀𑆥𑆩𑆳𑆠𑇀𑆫𑆁 𑆩𑆲𑆳𑆓𑆶𑆟𑆩𑇀 𑇅 𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑇀𑆮𑆬𑇀𑆥𑆳𑆠𑇀𑆪𑆪𑆁 𑆖𑆳𑆥𑆴 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆸𑆥𑆠𑆴𑆫𑆿𑆰𑆣𑆩𑇀 𑇆𑇔𑇕𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆮𑆤𑆨𑇀𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆠𑆶 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑇅 𑆢𑆳𑆫𑆶 𑆯𑆶𑆰𑇀𑆑𑆩𑆴𑆮𑆳𑆤𑆳𑆩𑆼 𑆢𑆼𑆲𑆱𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑇆𑇔𑇖𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆖𑆬𑆴𑆠𑆳 𑆫𑆱𑆽𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆽𑆫𑆶𑆢𑆵𑆫𑆴𑆠𑆳𑆂 𑇅 𑆢𑆾𑆰𑆳𑆂 𑆑𑆾𑆰𑇀𑆜𑆓𑆠𑆳 𑆘𑆤𑇀𑆠𑆾𑆂 𑆱𑆶𑆒𑆳 𑆲𑆫𑇀𑆠𑆶𑆁 𑆮𑆴𑆯𑆾𑆣𑆤𑆽𑆂 𑇆𑇔𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆮𑇀𑆪𑆳𑆥𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆽𑆢𑇀𑆪𑆳𑆠𑆶𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆮𑆩𑆤𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖 𑆥𑆚𑇀𑆖𑆢𑆯𑆣𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆠𑆠𑇀𑆫 𑆮𑆩𑆤𑆱𑇀𑆪𑆳𑆣𑆾 𑆓𑆠𑆴𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑇀𑆪𑆼𑆠𑆴 𑆥𑆸𑆡𑆑𑇀; 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆩𑆶𑆨𑆪𑆾𑆂- 𑆱𑆳𑆮𑆯𑆼𑆰𑆿𑆰𑆣𑆠𑇀𑆮𑆁, 𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆠𑇀𑆮𑆁, 𑆲𑆵𑆤𑆢𑆾𑆰𑆳𑆥𑆲𑆸𑆠𑆠𑇀𑆮𑆁, 𑆮𑆳𑆠𑆯𑆷𑆬𑆩𑇀, 𑆃𑆪𑆾𑆓𑆾, 𑆃𑆠𑆴𑆪𑆾𑆓𑆾, 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆩𑇀, 𑆄𑆣𑇀𑆩𑆳𑆤𑆁, 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳, 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆂, 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳, 𑆲𑆸𑆢𑆪𑆾𑆥𑆱𑆫𑆟𑆁, 𑆮𑆴𑆧𑆤𑇀𑆣, 𑆃𑆕𑇀𑆓𑆥𑇀𑆫𑆓𑇀𑆫𑆲 𑆅𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆳𑆥𑆵𑆝𑆴𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑆟𑆳𑆓𑇀𑆤𑆼𑆫𑇀𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆖𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆁 𑆢𑆶𑆫𑇀𑆮𑆩𑆱𑇀𑆪 𑆮𑆳 𑆓𑆶𑆟𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆨𑆳𑆮𑆳𑆢𑇀𑆮𑆩𑆤𑆩𑆣𑆾 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆠𑆠𑇀𑆫𑆼𑆥𑇀𑆱𑆴𑆠𑆳𑆤𑆮𑆳𑆥𑇀𑆠𑆴𑆫𑇀𑆢𑆾𑆰𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆯𑇀𑆖 ; 𑆠𑆩𑆳𑆯𑆶 𑆱𑇀𑆤𑆼𑆲𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆷𑆪𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆫𑆽𑆫𑇀𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑇆𑇔𑇆
𑆃𑆥𑆫𑆴𑆯𑆶𑆢𑇀𑆣𑆳𑆩𑆳𑆯𑆪𑆱𑇀𑆪𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆂 𑆱𑆯𑆼𑆰𑆳𑆤𑇀𑆤𑆱𑇀𑆪 𑆮𑆳𑇁𑆲𑆸𑆢𑇀𑆪𑆩𑆠𑆴𑆥𑇀𑆫𑆨𑆷𑆠𑆁 𑆮𑆳 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆥𑆵𑆠𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆠𑆠𑇀𑆫𑆼𑆥𑇀𑆱𑆴𑆠𑆳𑆤𑆮𑆳𑆥𑇀𑆠𑆴𑆫𑇀𑆢𑆾𑆰𑆾𑆑𑇀𑆬𑆼𑆯𑆯𑇀𑆖 ; 𑆠𑆠𑇀𑆫𑆳𑆯𑆶𑆢𑇀𑆣𑆳𑆩𑆳𑆯𑆪𑆩𑆶𑆬𑇀𑆧𑆟𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆳𑆯𑆶 𑆮𑆳𑆩𑆪𑆴𑆠𑇀𑆮𑆳 𑆨𑆷𑆪𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆫𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀, 𑆄𑆩𑆳𑆤𑇀𑆮𑆪𑆼 𑆠𑇀𑆮𑆳𑆩𑆮𑆠𑇀 𑆱𑆁𑆮𑆴𑆣𑆳𑆤𑆩𑇀, 𑆃𑆲𑆸𑆢𑇀𑆪𑆼𑇁𑆠𑆴𑆥𑇀𑆫𑆨𑆷𑆠𑆼 𑆖 𑆲𑆸𑆢𑇀𑆪𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆪𑆶𑆑𑇀𑆠𑆁 𑆖; 𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑇀𑆪𑆿𑆰𑆣𑆼 𑆤 𑆠𑆸𑆠𑆵𑆪𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑆠𑆱𑇀𑆠𑇀𑆮𑆼𑆤𑆁 𑆩𑆣𑆶𑆔𑆸𑆠𑆦𑆳𑆟𑆴𑆠𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆬𑆼𑆲𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆢𑆾𑆰𑆮𑆴𑆓𑇀𑆫𑆡𑆴𑆠𑆩𑆬𑇀𑆥𑆩𑆿𑆰𑆣𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆴𑆑𑇀𑆫𑆩𑆣𑆾𑆨𑆳𑆓𑆴𑆑𑆁 𑆮𑆳 𑆤 𑆱𑇀𑆫𑆁𑆱𑆪𑆠𑆴 𑆢𑆾𑆰𑆳𑆤𑇀, 𑆠𑆠𑇀𑆫 𑆠𑆸𑆰𑇀𑆟𑆳 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆁 𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑆫𑇀𑆮𑆨𑆼𑆢𑆾 𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆾𑇁𑆫𑆠𑆴𑆫𑆶𑆢𑇀𑆓𑆳𑆫𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆠𑆩𑆶𑆰𑇀𑆟𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆫𑆳𑆯𑆶 𑆮𑆳𑆩𑆪𑆼𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆴𑆑𑆼, 𑆃𑆣𑆾𑆨𑆳𑆓𑆴𑆑𑆼𑇁𑆥𑆴 𑆖 𑆱𑆳𑆮𑆯𑆼𑆰𑆿𑆰𑆣𑆩𑆠𑆴𑆥𑇀𑆫𑆣𑆳𑆮𑆴𑆠𑆢𑆾𑆰𑆩𑆠𑆴𑆧𑆬𑆩𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑆥𑇀𑆪𑆼𑆮𑆁 𑆮𑆳𑆩𑆪𑆼𑆠𑇀 𑇆𑇖𑇆
𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪𑆳𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆤𑆼𑆫𑆬𑇀𑆥𑆩𑆿𑆰𑆣𑆩𑆬𑇀𑆥𑆓𑆶𑆟𑆁 𑆮𑆳 𑆨𑆑𑇀𑆠𑆮𑆠𑇀 𑆥𑆳𑆑𑆩𑆶𑆥𑆽𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆳 𑆢𑆾𑆰𑆳 𑆪𑆡𑆳𑆑𑆳𑆬𑆩𑆤𑆴𑆫𑇀𑆲𑇀𑆫𑆵𑆪𑆩𑆳𑆟𑆳 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆨𑇀𑆫𑆩𑆁 𑆧𑆬𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆁 𑆖𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆩𑆤𑆬𑇀𑆥𑆩𑆩𑆤𑇀𑆢𑆩𑆿𑆰𑆣𑆁 𑆖 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑇆𑇗𑇆
𑆃𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼𑆤𑆳𑆬𑇀𑆥𑆓𑆶𑆟𑆁 𑆮𑆳 𑆨𑆼𑆰𑆘𑆩𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆬𑇀𑆥𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑇀 𑆲𑆤𑇀𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆮𑆩𑆤𑆼 𑆢𑆾𑆰𑆯𑆼𑆰𑆾 𑆓𑆿𑆫𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆁 𑆲𑆸𑆢𑆪𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆠𑆁 𑆪𑆡𑆳𑆪𑆾𑆓𑆁 𑆥𑆳𑆪𑆪𑆴𑆠𑇀𑆮𑆳 𑆮𑆳𑆩𑆪𑆼𑆢𑇀𑆢𑆸𑆞𑆠𑆫𑆁; 𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆠𑆶 𑆓𑆶𑆢𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆤𑆩𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆩𑆤𑆴𑆂𑆱𑆫𑆟𑆁 𑆮𑆳 𑆮𑆳𑆪𑆾𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴; 𑆠𑆩𑆶𑆥𑆥𑆳𑆢𑇀𑆪 𑆨𑆷𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆢𑇀𑆢𑆸𑆞𑆠𑆫𑆁, 𑆢𑆸𑆞𑆁 𑆧𑆲𑆶𑆥𑇀𑆫𑆖𑆬𑆴𑆠𑆢𑆾𑆰𑆁 𑆮𑆳 𑆠𑆸𑆠𑆵𑆪𑆼 𑆢𑆴𑆮𑆱𑆼𑇁𑆬𑇀𑆥𑆓𑆶𑆟𑆁 𑆖𑆼𑆠𑆴 𑇆𑇘𑇆
𑆃𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆼𑆤 𑆫𑆷𑆑𑇀𑆰𑆿𑆰𑆣𑆩𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆩𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑆳 𑆮𑆳 𑆮𑆳𑆪𑆶𑆁 𑆑𑆾𑆥𑆪𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆯𑇀𑆫𑆾𑆟𑆴𑆩𑆤𑇀𑆪𑆳𑆩𑆫𑇀𑆩𑆯𑆷𑆬𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆨𑇀𑆫𑆩𑆁 𑆩𑆢𑆁 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆤𑆳𑆯𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴, 𑆠𑆁 𑆮𑆳𑆠𑆯𑆷𑆬𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆠𑆩𑆨𑇀𑆪𑆘𑇀𑆪 𑆣𑆳𑆤𑇀𑆪𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑆱𑇀𑆮𑆼𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆤 𑆠𑆽𑆬𑆼𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆩𑆮𑆴𑆨𑆳𑆮𑆴𑆠𑆯𑆫𑆵𑆫𑆼𑆟𑆳𑆬𑇀𑆥𑆩𑆿𑆰𑆣𑆩𑆬𑇀𑆥𑆓𑆶𑆟𑆁 𑆮𑆳 𑆥𑆵𑆠𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆾 𑆮𑆳 𑆤𑆳𑆨𑇀𑆪𑆼𑆠𑆴 𑆢𑆾𑆰𑆳𑆁𑆯𑇀𑆖𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑇀𑆪 𑆠𑆽𑆂 𑆱𑆲 𑆧𑆬𑆑𑇀𑆰𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆠𑆠𑇀𑆫𑆳𑆣𑇀𑆩𑆳𑆤𑆁 𑆲𑆸𑆢𑆪𑆓𑇀𑆫𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆢𑆳𑆲𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆠𑆩𑆪𑆾𑆓𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆠𑆩𑆳𑆯𑆶 𑆮𑆳𑆩𑆪𑆼𑆤𑇀𑆩𑆢𑆤𑆦𑆬𑆬𑆮𑆟𑆳𑆩𑇀𑆧𑆶𑆨𑆴𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆫𑆽𑆂 𑆑𑆰𑆳𑆪𑆽𑆯𑇀𑆖 𑇅 𑆢𑆶𑆫𑇀𑆮𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆠𑆶 𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆳 𑆢𑆾𑆰𑆳 𑆮𑇀𑆪𑆳𑆥𑇀𑆪 𑆯𑆫𑆵𑆫𑆁 𑆑𑆟𑇀𑆝𑆷𑆯𑇀𑆮𑆪𑆡𑆶𑆑𑆶𑆰𑇀𑆜𑆥𑆴𑆝𑆑𑆳𑆘𑇀𑆮𑆫𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆤𑆳𑆤𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆠𑆠𑆱𑇀𑆠𑆳𑆤𑆯𑆼𑆰𑆳𑆤𑇀𑆩𑆲𑆿𑆰𑆣𑆼𑆤𑆳𑆥𑆲𑆫𑆼𑆠𑇀 𑇅 𑆃𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆣𑆾𑆤𑆳𑆨𑆼𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆥𑆷𑆫𑇀𑆟𑆾𑆢𑆫𑆠𑆳 𑆯𑆷𑆬𑆁 𑆮𑆳𑆠𑆥𑆶𑆫𑆵𑆰𑆱𑆕𑇀𑆓𑆂 𑆑𑆟𑇀𑆝𑆷𑆩𑆟𑇀𑆝𑆬𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆮𑆳 𑆨𑆮𑆠𑆴, 𑆠𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑇀𑆪 𑆥𑆶𑆤𑆂 𑆱𑆁𑆱𑇀𑆤𑆼𑆲𑇀𑆪 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆼𑆤 𑇅 𑆤𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆼 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑆮𑆳 𑆢𑆶𑆰𑇀𑆛𑆱𑆁𑆯𑆾𑆣𑆤𑆼 𑆠𑆠𑇀𑆱𑆤𑇀𑆠𑆼𑆘𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆥𑆳𑆟𑆴𑆠𑆳𑆥𑆽𑆯𑇀𑆖 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆾𑆢𑆫𑆩𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆢𑆾𑆰𑆳𑆂 𑇅 𑆃𑆤𑆶𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆼 𑆖𑆳𑆬𑇀𑆥𑆢𑆾𑆰𑆼 𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆁 𑆧𑆲𑆶𑆢𑆾𑆰𑆩𑆲𑆂𑆯𑆼𑆰𑆁 𑆧𑆬𑆁 𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆨𑆷𑆪𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑇅 𑆃𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆢𑆾𑆰𑆁 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆢𑆼𑆲𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆁 𑆨𑆷𑆪𑆂 𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇅 𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑇀𑆪 𑆥𑆶𑆤𑆂 𑆱𑆁𑆱𑇀𑆤𑆼𑆲𑇀𑆪 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀 𑇅 𑆲𑇀𑆫𑆵𑆨𑆪𑆬𑆾𑆨𑆽𑆫𑇀𑆮𑆼𑆓𑆳𑆔𑆳𑆠𑆯𑆵𑆬𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆯𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆾 𑆫𑆳𑆘𑆱𑆩𑆵𑆥𑆱𑇀𑆡𑆳 𑆮𑆟𑆴𑆘𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆼 𑆢𑆶𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆳𑆂, 𑆧𑆲𑆶𑆮𑆳𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆃𑆠 𑆍𑆮 𑆠𑆳𑆤𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀 𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆥𑆤𑇀𑆤𑆳𑆚𑇀 𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆠𑆴𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆮𑆳𑇁𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆣𑆴𑆑𑆁 𑆮𑆳 𑆢𑆠𑇀𑆠𑆩𑆿𑆰𑆣𑆩𑆠𑆴𑆪𑆾𑆓𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇅 𑆠𑆠𑇀𑆫 𑆮𑆩𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆧𑆬𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆾 𑆮𑆳𑆠𑆑𑆾𑆥𑆯𑇀𑆖 𑆧𑆬𑆮𑆳𑆤𑇀 𑆨𑆮𑆠𑆴, 𑆠𑆁 𑆔𑆸𑆠𑆼𑆤𑆳𑆨𑇀𑆪𑆘𑇀𑆪𑆳𑆮𑆓𑆳𑆲𑇀𑆪 𑆯𑆵𑆠𑆳𑆱𑇀𑆮𑆥𑇀𑆱𑆶 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑇀𑆬𑆼𑆲𑆽𑆫𑆶𑆥𑆖𑆫𑆼𑆢𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆁; 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆑𑆦𑆱𑇀𑆪𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆖 𑆱𑆫𑆑𑇀𑆠𑆱𑇀𑆪, 𑆠𑆠𑇀𑆫𑆳𑆥𑆴 𑆧𑆬𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆾 𑆮𑆳𑆠𑆑𑆾𑆥𑆯𑇀𑆖 𑆧𑆬𑆮𑆳𑆤𑇀 𑆨𑆮𑆠𑆴, 𑆠𑆩𑆠𑆴𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆨𑆴𑆂 𑆥𑆫𑆴𑆰𑆴𑆖𑇀𑆪𑆳𑆮𑆓𑆳𑆲𑇀𑆪 𑆮𑆳 𑆯𑆵𑆠𑆽𑆱𑇀𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆨𑆴𑆫𑇀𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆽𑆯𑇀𑆗𑆫𑇀𑆢𑆪𑆼𑆠𑇀, 𑆥𑆴𑆖𑇀𑆗𑆳𑆧𑆱𑇀𑆠𑆴𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆖𑆽𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀, 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆳𑆢𑆴𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆥𑆳𑆠𑆶𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆑𑇀𑆰𑆵𑆫𑆫𑆱𑆪𑆾𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆠𑆫𑆼𑆟 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮 𑆮𑆩𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆼 𑆯𑆾𑆟𑆴𑆠𑆁 𑆰𑇀𑆜𑆵𑆮𑆠𑆴 𑆫𑇀𑆗𑇀𑆢𑆪𑆠𑆴 𑆮𑆳, 𑆠𑆠𑇀𑆫 𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆴𑆂𑆱𑆫𑆟𑆩𑆥𑆱𑆫𑆟𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑇀𑆮𑇀𑆪𑆳𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆲𑆤𑆶𑆱𑆁𑆲𑆤𑆤𑆁 𑆠𑆸𑆰𑇀𑆟𑆳 𑆲𑆴𑆑𑇀𑆑𑆳 𑆘𑇀𑆮𑆫𑆾 𑆮𑆽𑆱𑆚𑇀𑆘𑇀𑆚𑇀𑆪𑆩𑆴𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆩𑆘𑆳𑆱𑆸𑆑𑇀𑆖𑆤𑇀𑆢𑆤𑆾𑆯𑆵𑆫𑆳𑆚𑇀𑆘𑆤𑆬𑆳𑆘𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆾𑆢𑆑𑆽𑆫𑇀𑆩𑆤𑇀𑆡𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆦𑆬𑆫𑆱𑆽𑆫𑇀𑆮𑆳 𑆱𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆽𑆂 𑆯𑆶𑆕𑇀𑆓𑆳𑆨𑆴𑆫𑇀𑆮𑆳 𑆮𑆛𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆼𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆁 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆁 𑆮𑆫𑇀𑆖𑆾𑆓𑇀𑆫𑆳𑆲𑆴𑆨𑆴𑆫𑇀𑆮𑆳, 𑆥𑆪𑆱𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆫𑆱𑆼𑆤 𑆮𑆳 𑆨𑆾𑆘𑆪𑆼𑆠𑇀, 𑆃𑆠𑆴𑆱𑇀𑆫𑆶𑆠𑆯𑆾𑆟𑆴𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀; 𑆘𑆴𑆲𑇀𑆮𑆳𑆩𑆠𑆴𑆱𑆫𑇀𑆥𑆴𑆠𑆳𑆁 𑆑𑆛𑆶𑆑𑆬𑆮𑆟𑆖𑆷𑆫𑇀𑆟𑆥𑇀𑆫𑆔𑆸𑆰𑇀𑆛𑆳𑆁 𑆠𑆴𑆬𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆥𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆳𑆁 𑆮𑆳𑇁𑆤𑇀𑆠𑆂 𑆥𑆵𑆝𑆪𑆼𑆠𑇀, 𑆃𑆤𑇀𑆠𑆂𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆳𑆪𑆳𑆩𑆩𑇀𑆬𑆩𑆤𑇀𑆪𑆼 𑆠𑆱𑇀𑆪 𑆥𑆶𑆫𑆱𑇀𑆠𑆳𑆠𑇀 𑆒𑆳𑆢𑆪𑆼𑆪𑆶𑆂; 𑆮𑇀𑆪𑆳𑆮𑆸𑆠𑇀𑆠𑆼 𑆖𑆳𑆑𑇀𑆰𑆴𑆟𑆵 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆼 𑆥𑆵𑆝𑆪𑆼𑆠𑇀, 𑆲𑆤𑆶𑆱𑆁𑆲𑆤𑆤𑆼 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆲𑆫𑆁 𑆤𑆱𑇀𑆪𑆁 𑆱𑇀𑆮𑆼𑆢𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆴𑆰𑆶 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆮𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆼 𑆮𑆼𑆟𑆶𑆮𑆵𑆟𑆳𑆓𑆵𑆠𑆱𑇀𑆮𑆤𑆁 𑆯𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆖 𑆱𑆖𑆤𑇀𑆢𑇀𑆫𑆑𑆁 𑆱𑆬𑆴𑆬𑆩𑆣𑆂 𑆱𑇀𑆫𑆮𑆠𑆴 𑆠𑆠𑆾 𑆩𑆳𑆁𑆱𑆣𑆳𑆮𑆤𑆥𑇀𑆫𑆑𑆳𑆯𑆩𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆘𑆵𑆮𑆯𑆾𑆟𑆴𑆠𑆁 𑆖, 𑆠𑆠𑆾 𑆓𑆶𑆢𑆤𑆴𑆂𑆱𑆫𑆟𑆁 𑆮𑆼𑆥𑆡𑆶𑆫𑇀𑆮𑆩𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆾𑆥𑆢𑇀𑆫𑆮𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆩𑆥𑆴 𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆯𑆾𑆟𑆴𑆠𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀, 𑆤𑆴𑆂𑆱𑆫𑇀𑆥𑆴𑆠𑆓𑆶𑆢𑆱𑇀𑆪 𑆓𑆶𑆢𑆩𑆨𑇀𑆪𑆘𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆤𑇀𑆠𑆂 𑆥𑆵𑆝𑆪𑆼𑆠𑇀 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆫𑆾𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑆳 𑆮𑆵𑆑𑇀𑆰𑆼𑆠, 𑆮𑆼𑆥𑆡𑆿 𑆮𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆣𑆳𑆤𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠, 𑆘𑆴𑆲𑇀𑆮𑆳𑆤𑆴𑆂𑆱𑆫𑆟𑆳𑆢𑆴𑆰𑆷𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂, 𑆃𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆼 𑆮𑆳 𑆘𑆵𑆮𑆯𑆾𑆟𑆴𑆠𑆼 𑆑𑆳𑆯𑇀𑆩𑆫𑆵𑆦𑆬𑆧𑆢𑆫𑆵𑆢𑆷𑆫𑇀𑆮𑆾𑆯𑆵𑆫𑆽𑆂 𑆯𑆸𑆠𑆼𑆤 𑆥𑆪𑆱𑆳 𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆳𑆚𑇀𑆘𑆤𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆱𑆶𑆯𑆵𑆠𑆼𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀, 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆔𑆸𑆠𑆯𑆾𑆟𑆴𑆠𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆽𑆯𑇀𑆖𑆽𑆤𑆁 𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀, 𑆯𑆾𑆟𑆴𑆠𑆰𑇀𑆜𑆵𑆮𑆤𑆼 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆠𑆵𑆱𑆳𑆫𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆁 𑆖𑆳𑆱𑇀𑆪 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀 𑆥𑆳𑆤𑆨𑆾𑆘𑆤𑆼𑆰𑆶 𑇆𑇑𑇓𑇆
𑆘𑆵𑆮𑆯𑆾𑆟𑆴𑆠𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆪𑆾𑆯𑇀𑆖 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳𑆫𑇀𑆡𑆁 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆴𑆖𑆶𑆁 𑆥𑇀𑆬𑆾𑆠𑆁 𑆮𑆳 𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀, 𑆪𑆢𑇀𑆪𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆩𑆥𑆴 𑆮𑆱𑇀𑆠𑇀𑆫𑆁 𑆫𑆚𑇀𑆘𑆪𑆠𑆴 𑆠𑆘𑇀𑆘𑆵𑆮𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆓𑆤𑇀𑆠𑆮𑇀𑆪𑆁; 𑆱𑆨𑆑𑇀𑆠𑆁 𑆖 𑆯𑆶𑆤𑆼 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆑𑇀𑆠𑆶𑆱𑆩𑇀𑆩𑆴𑆯𑇀𑆫𑆁 𑆮𑆳, 𑆱 𑆪𑆢𑇀𑆪𑆶𑆥𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆠𑆘𑇀𑆘𑆵𑆮𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆓𑆤𑇀𑆠𑆮𑇀𑆪𑆩𑇀; 𑆃𑆤𑇀𑆪𑆡𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑆴 𑇆𑇑𑇔𑇆
𑆱𑆯𑆼𑆰𑆳𑆤𑇀𑆤𑆼𑆤 𑆧𑆲𑆶𑆢𑆾𑆰𑆼𑆟 𑆫𑆷𑆑𑇀𑆰𑆼𑆟𑆳𑆤𑆴𑆬𑆥𑇀𑆫𑆳𑆪𑆑𑆾𑆰𑇀𑆜𑆼𑆤𑆳𑆤𑆶𑆰𑇀𑆟𑆩𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆮𑆳 𑆥𑆵𑆠𑆩𑆿𑆰𑆣𑆩𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆠𑆴, 𑆠𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑆕𑇀𑆓𑆂 𑆱𑆩𑆶𑆤𑇀𑆤𑆢𑇀𑆣𑆾𑆢𑆫𑆠𑆳 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆨𑆕𑇀𑆓𑆾 𑆓𑆶𑆢𑆧𑆱𑇀𑆠𑆴𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆤𑆁 𑆨𑆑𑇀𑆠𑆳𑆫𑆶𑆖𑆴𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆠𑆁 𑆖𑆳𑆣𑇀𑆩𑆳𑆤𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆠𑆩𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑇀𑆪𑆳𑆤𑆳𑆲𑆮𑆫𑇀𑆠𑆴𑆢𑆵𑆥𑆤𑆧𑆱𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆴𑆫𑆶𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆑𑇀𑆰𑆳𑆩𑆼𑆟𑆳𑆠𑆴𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆼𑆤 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑆫𑆷𑆑𑇀𑆰𑆼𑆟 𑆮𑆳𑇁𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆳𑆠𑆴𑆬𑆮𑆟𑆩𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆁 𑆮𑆳 𑆥𑆵𑆠𑆩𑆿𑆰𑆣𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆿 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆓𑆶𑆢𑆤𑆳𑆨𑆴𑆩𑆼𑆞𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆯𑆴𑆫𑆂𑆱𑆶 𑆱𑆢𑆳𑆲𑆁 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆤𑆩𑆤𑆴𑆬𑆱𑆕𑇀𑆓𑆾 𑆮𑆳𑆪𑆶𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆾 𑆨𑆑𑇀𑆠𑆳𑆫𑆶𑆖𑆴𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆥𑆴𑆖𑇀𑆗𑆳𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆑𑆸𑆰𑇀𑆟𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆩𑆣𑆶𑆔𑆸𑆠𑆪𑆶𑆑𑇀𑆠𑆂, 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆁 𑆖𑆽𑆤𑆁 𑆥𑆪𑆱𑆳 𑆨𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆁 𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆼𑆤 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆠𑆽𑆬𑆼𑆤 𑆮𑆳𑇁𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪𑆳𑆠𑆴𑆥𑇀𑆫𑆨𑆷𑆠𑆢𑆾𑆰𑆱𑇀𑆪 𑆩𑆸𑆢𑇀𑆮𑆿𑆰𑆣𑆩𑆮𑆖𑆳𑆫𑆴𑆠𑆁 𑆱𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪 𑆢𑆾𑆰𑆳𑆤𑇀𑆤 𑆤𑆴𑆂𑆯𑆼𑆰𑆳𑆤𑆥𑆲𑆫𑆠𑆴, 𑆠𑆠𑆱𑇀𑆠𑆼 𑆢𑆾𑆰𑆳𑆂 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆠𑇀𑆫 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆾𑆢𑆫𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆳𑆫𑆶𑆖𑆴𑆓𑆳𑆠𑇀𑆫𑆱𑆢𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆱𑆮𑆼𑆢𑆤𑆿 𑆖𑆳𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆿 𑆥𑆫𑆴𑆱𑇀𑆫𑆮𑆠𑆂, 𑆠𑆁 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆠𑆩𑆘𑆑𑆫𑇀𑆟𑆣𑆮𑆠𑆴𑆤𑆴𑆯𑆥𑆬𑆳𑆯𑆧𑆬𑆳𑆑𑆰𑆳𑆪𑆽𑆫𑇀𑆩𑆣𑆶𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀, 𑆇𑆥𑆯𑆳𑆤𑇀𑆠𑆢𑆾𑆰𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆖 𑆨𑆷𑆪𑆂 𑆱𑆁𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆃𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆼𑇁𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼 𑆮𑆳 𑆨𑆼𑆰𑆘𑆩𑆮𑆖𑆳𑆫𑆴𑆠𑆩𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆮𑆳𑆠𑆮𑆫𑇀𑆖 𑆇𑆢𑆵𑆫𑆪𑆠𑆴 𑆮𑆼𑆓𑆳𑆔𑆳𑆠𑆼𑆤 𑆮𑆳, 𑆠𑆢𑆳 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳 𑆨𑆮𑆠𑆴; 𑆠𑆠𑇀𑆫 𑆱𑆮𑆳𑆠𑆁 𑆱𑆢𑆳𑆲𑆁 𑆱𑆯𑆷𑆬𑆁 𑆓𑆶𑆫𑆶 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆯𑇀𑆮𑆼𑆠𑆁 𑆑𑆸𑆰𑇀𑆟𑆁 𑆱𑆫𑆑𑇀𑆠𑆁 𑆮𑆳 𑆨𑆸𑆯𑆁 𑆥𑇀𑆫𑆮𑆳𑆲𑆩𑆳𑆟𑆂 𑆑𑆦𑆩𑆶𑆥𑆮𑆴𑆯𑆠𑆴; 𑆠𑆳𑆁 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇘𑇆
𑆪𑆱𑇀𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆾 𑆮𑆳 𑆨𑆼𑆰𑆘𑆮𑆼𑆓𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆩𑆘𑇀𑆚𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆠𑆱𑇀𑆪𑆾𑆥𑆱𑆫𑆟𑆁 𑆲𑆸𑆢𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆢𑆾𑆰𑆳𑆂, 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆫𑇀𑆩𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆢𑇀𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆫𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆾 𑆢𑆤𑇀𑆠𑆳𑆤𑇀 𑆑𑆴𑆛𑆑𑆴𑆛𑆳𑆪𑆠𑆼 𑆇𑆢𑇀𑆓𑆠𑆳𑆑𑇀𑆰𑆾 𑆘𑆴𑆲𑇀𑆮𑆳𑆁 𑆒𑆳𑆢𑆠𑆴 𑆥𑇀𑆫𑆠𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆖𑆼𑆠𑆳𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆠𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆤𑇀𑆠𑆴 𑆩𑆷𑆫𑇀𑆒𑆳𑆂; 𑆠𑆩𑆨𑇀𑆪𑆘𑇀𑆪 𑆣𑆳𑆤𑇀𑆪𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑆱𑇀𑆮𑆼𑆢𑆪𑆼𑆠𑇀, 𑆪𑆰𑇀𑆛𑆴𑆩𑆣𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆖 𑆠𑆽𑆬𑆼𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀, 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖𑆳𑆱𑇀𑆩𑆽 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆾 𑆪𑆰𑇀𑆛𑆴𑆩𑆣𑆶𑆑𑆩𑆴𑆯𑇀𑆫𑆼𑆟 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆗𑆫𑇀𑆢𑆪𑆼𑆠𑇀, 𑆪𑆡𑆳𑆢𑆾𑆰𑆾𑆖𑇀𑆗𑇀𑆫𑆳𑆪𑆼𑆟 𑆖𑆽𑆤𑆁 𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆪𑆱𑇀𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆾 𑆮𑆳 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆢𑆾𑆰𑆂 𑆯𑆵𑆠𑆳𑆓𑆳𑆫𑆩𑆶𑆢𑆑𑆩𑆤𑆴𑆬𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆠𑆱𑇀𑆪 𑆢𑆾𑆰𑆳𑆂 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆮𑆬𑆵𑆪𑆩𑆳𑆤𑆳 𑆔𑆤𑆵𑆨𑆳𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆳 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆯𑆑𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆩𑆳𑆥𑆳𑆢𑇀𑆪 𑆮𑆴𑆧𑆣𑇀𑆪𑆤𑇀𑆠𑆼 , 𑆠𑆱𑇀𑆪𑆳𑆛𑆾𑆥𑆾 𑆢𑆳𑆲𑆾 𑆘𑇀𑆮𑆫𑆾 𑆮𑆼𑆢𑆤𑆳𑆯𑇀𑆖 𑆠𑆵𑆮𑇀𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆩𑆳𑆯𑆶 𑆮𑆳𑆩𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆬𑆳𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆑𑆶𑆫𑇀𑆮𑆵𑆠; 𑆃𑆣𑆾𑆨𑆳𑆓𑆼 𑆠𑇀𑆮𑆣𑆾𑆨𑆳𑆓𑆢𑆾𑆰𑆲𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆩𑇀𑆬𑆩𑆷𑆠𑇀𑆫𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆪 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆖 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆪𑆡𑆳𑆢𑆾𑆰𑆩𑆳𑆲𑆳𑆫𑆑𑇀𑆫𑆩𑆁 𑆖; 𑆇𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆼 𑆠𑆷𑆥𑆢𑇀𑆫𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑇆𑇒𑇐𑇆
𑆪𑆳 𑆠𑆶 𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆓𑆶𑆢𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳 𑆠𑆢𑇀𑆮𑆩𑆤𑆼 𑆑𑆟𑇀𑆜𑆑𑇀𑆰𑆟𑆤𑆁, 𑆪𑆢𑆣𑆂 𑆥𑆫𑆴𑆱𑇀𑆫𑆮𑆟𑆁 𑆱 𑆈𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆱𑆼𑆑𑆂, 𑆪𑆳 𑆠𑇀𑆮𑆣𑆂 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳 𑆱𑆳 𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆯𑆶𑆰𑇀𑆑𑆾𑆢𑇀𑆓𑆳𑆫𑆳 𑆅𑆠𑆴 𑇆𑇒𑇑𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆢𑆯 𑆥𑆚𑇀𑆖 𑆖 𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆂 𑇅 𑆍𑆠𑆳 𑆮𑆴𑆫𑆼𑆑𑆳𑆠𑆴𑆪𑆾𑆓𑆢𑆶𑆫𑇀𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆘𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇒𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆼𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆣𑆳𑆤𑆠𑆩𑆩𑆳𑆲𑆶𑆫𑆳𑆖𑆳𑆫𑇀𑆪𑆳𑆂 𑇅 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆃𑆤𑆼𑆑𑆑𑆫𑇀𑆩𑆑𑆫𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆼𑆂; 𑆅𑆲 𑆒𑆬𑆶 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆱𑆁𑆯𑆩𑆤𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆟𑆳𑆤𑆴 𑆑𑆫𑆾𑆠𑆴, 𑆑𑇀𑆰𑆵𑆟𑆯𑆶𑆑𑇀𑆫𑆁 𑆮𑆳𑆘𑆵𑆑𑆫𑆾𑆠𑆴, 𑆑𑆸𑆯𑆁 𑆧𑆸𑆁𑆲𑆪𑆠𑆴, 𑆱𑇀𑆡𑆷𑆬𑆁 𑆑𑆫𑇀𑆯𑆪𑆠𑆴, 𑆖𑆑𑇀𑆰𑆶𑆂 𑆥𑇀𑆫𑆵𑆟𑆪𑆠𑆴, 𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆩𑆥𑆲𑆤𑇀𑆠𑆴, 𑆮𑆪𑆂 𑆱𑇀𑆡𑆳𑆥𑆪𑆠𑆴 𑇆𑇓𑇆
𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆁 𑆮𑆫𑇀𑆟𑆁 𑆧𑆬𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑆂 𑇅 𑆑𑆶𑆫𑆶𑆠𑆼 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆖 𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆳𑆱𑆴𑆠𑆂 𑇆𑇔𑇆
𑆠𑆡𑆳 𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆠𑆴𑆩𑆴𑆫𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆳𑆣𑆴𑆩𑆤𑇀𑆡𑆳𑆫𑇀𑆢𑆴𑆠𑆳𑆑𑇀𑆰𑆼𑆥𑆑𑆥𑆑𑇀𑆰𑆳𑆔𑆳𑆠𑆽𑆑𑆳𑆕𑇀𑆓𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆳𑆣𑇀𑆩𑆳𑆤𑆾𑆢𑆫- 𑆪𑆾𑆤𑆴𑆯𑆷𑆬𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑆷𑆬𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆢𑆁𑆯𑆳𑆤𑆳𑆲𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆓𑆶𑆬𑇀𑆩𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆾𑆢𑆳𑆮𑆫𑇀𑆠- 𑆯𑆶𑆑𑇀𑆫𑆳𑆫𑇀𑆠𑆮𑆱𑇀𑆠𑆤𑇀𑆪𑆤𑆳𑆯𑆲𑆸𑆢𑇀𑆣𑆤𑆶𑆩𑆤𑇀𑆪𑆳𑆓𑇀𑆫𑆲𑆯𑆫𑇀𑆑𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆩𑆷𑆞𑆓𑆫𑇀𑆨𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆖𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑇆𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆼 𑆖 𑆥𑆴𑆠𑇀𑆠𑆼 𑆖 𑆑𑆦𑆼 𑆫𑆑𑇀𑆠𑆼 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼 𑇅 𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆖 𑆧𑆱𑇀𑆠𑆴𑆫𑆼𑆮 𑆲𑆴𑆠𑆂 𑆱𑆢𑆳 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆱𑆳𑆁𑆮𑆠𑇀𑆱𑆫𑆴𑆑𑆳𑆰𑇀𑆛𑆢𑇀𑆮𑆴𑆫𑆰𑇀𑆛𑆮𑆫𑇀𑆰𑆳𑆟𑆳𑆁 𑆰𑆝𑆰𑇀𑆛𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑆴 𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳𑆤𑆳𑆩𑆴𑆑𑆳𑆩𑆣𑇀𑆪𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑆫𑆴𑆟𑆳𑆲𑆳𑆤𑇀𑆪𑆓𑇀𑆫𑆼𑇁𑆣𑇀𑆪𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆶𑆬𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆳𑆫𑇀𑆣𑆠𑆸𑆠𑆵𑆪𑆳𑆕𑇀𑆓𑆶𑆬𑆱𑆤𑇀𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆤𑆴 𑆑𑆕𑇀𑆑𑆯𑇀𑆪𑆼𑆤𑆧𑆫𑇀𑆲𑆴𑆟𑆥𑆑𑇀𑆰𑆤𑆳𑆝𑆵𑆠𑆶𑆬𑇀𑆪𑆥𑇀𑆫𑆮𑆼𑆯𑆳𑆤𑆴 𑆩𑆶𑆢𑇀𑆓𑆩𑆳𑆰𑆑𑆬𑆳𑆪𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆤𑇀𑆤𑆼𑆠𑇀𑆫𑆳𑆟𑆴 𑇅 𑆠𑆼𑆰𑆶 𑆖𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆳𑆠𑆶𑆫𑆲𑆱𑇀𑆠𑆱𑆩𑇀𑆩𑆴𑆠𑆼𑆤 𑆥𑇀𑆫𑆱𑆸𑆠𑆼𑆤 𑆱𑆩𑇀𑆩𑆴𑆠𑆿 𑆥𑇀𑆫𑆱𑆸𑆠𑆿 𑆢𑇀𑆮𑆿 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆰𑇀𑆛𑆿 𑆖 𑆮𑆴𑆣𑆼𑆪𑆳𑆂 𑇆𑇗𑇆
𑆮𑆫𑇀𑆰𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆤𑆼𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆧𑆱𑇀𑆠𑆴𑆩𑆳𑆤𑆱𑇀𑆪 𑆖𑆽𑆮 𑆲𑆴 𑇅 𑆮𑆪𑆾𑆧𑆬𑆯𑆫𑆵𑆫𑆳𑆟𑆴 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆾𑆠𑇀𑆑𑆫𑇀𑆰𑆪𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆩𑇀 𑇆𑇘𑇆
𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆠𑆼𑆫𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁, 𑆩𑆷𑆬𑆼𑇁𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆾𑆢𑆫𑆥𑆫𑆵𑆟𑆳𑆲𑆩𑇀, 𑆃𑆓𑇀𑆫𑆼 𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆾𑆢𑆫𑆥𑆫𑆵𑆟𑆳𑆲𑆩𑇀, 𑆃𑆓𑇀𑆫𑆼 𑆠𑇀𑆫𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆱𑆤𑇀𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆴𑆑𑆁, 𑆓𑆸𑆣𑇀𑆫𑆥𑆑𑇀𑆰𑆤𑆳𑆝𑆵𑆠𑆶𑆬𑇀𑆪𑆥𑇀𑆫𑆮𑆼𑆯𑆁, 𑆑𑆾𑆬𑆳𑆱𑇀𑆡𑆴𑆩𑆳𑆠𑇀𑆫𑆗𑆴𑆢𑇀𑆫𑆁, 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆑𑆬𑆳𑆪𑆩𑆳𑆠𑇀𑆫𑆗𑆴𑆢𑇀𑆫𑆩𑆴𑆠𑇀𑆪𑆼𑆑𑆼; 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆩𑆷𑆬𑆼 𑆧𑆱𑇀𑆠𑆴𑆤𑆴𑆧𑆤𑇀𑆣𑆤𑆳𑆫𑇀𑆡𑆁 𑆢𑇀𑆮𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆤𑆴 𑇅 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆠𑆶 𑆮𑆴𑆲𑆴𑆠𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆂 𑇅 𑆱𑆥𑇀𑆠𑆠𑆼𑆱𑇀𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆤𑆼𑆠𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆼𑆠𑆢𑆼𑆮, 𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆠𑆶 𑆢𑇀𑆮𑆴𑆫𑆰𑇀𑆛𑆮𑆫𑇀𑆰𑆮𑆠𑇀 𑇆𑇙𑇆
𑆩𑆸𑆢𑆶𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆂 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆪𑆾𑆂 𑇅 𑆠𑆪𑆾𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆠𑆶 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆲𑆴𑆁𑆱𑇀𑆪𑆳𑆢𑇀 𑆧𑆬𑆳𑆪𑆶𑆰𑆵 𑇆𑇑𑇐𑇆
(𑆮𑇀𑆫𑆟𑆤𑆼𑆠𑇀𑆫𑆩𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆩𑆶𑆢𑇀𑆓𑆮𑆳𑆲𑆴𑆱𑇀𑆫𑆾𑆠𑆂; 𑆮𑇀𑆫𑆟𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆑𑆰𑆳𑆪𑆼 𑆮𑆴𑆢𑆣𑆵𑆠) 𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫 𑆤𑆼𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆶𑆮𑆫𑇀𑆟𑆫𑆘𑆠𑆠𑆳𑆩𑇀𑆫𑆳𑆪𑆾𑆫𑆵𑆠𑆴𑆢𑆤𑇀𑆠𑆯𑆸𑆕𑇀𑆓𑆩𑆟𑆴𑆠𑆫𑆶𑆱𑆳𑆫𑆩𑆪𑆳𑆤𑆴 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆢𑆸𑆞𑆳𑆤𑆴 𑆓𑆾𑆥𑆶𑆖𑇀𑆗𑆳𑆑𑆸𑆠𑆵𑆤𑇀𑆪𑆸𑆘𑆷𑆤𑆴 𑆓𑆶𑆛𑆴𑆑𑆳𑆩𑆶𑆒𑆳𑆤𑆴 𑆖 𑇆𑇑𑇒𑇆
𑆧𑆱𑇀𑆠𑆪𑆯𑇀𑆖 𑆧𑆤𑇀𑆣𑇀𑆪𑆳 𑆩𑆸𑆢𑆮𑆾 𑆤𑆳𑆠𑆴𑆧𑆲𑆬𑆳 𑆢𑆸𑆞𑆳𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆤𑇀𑆠𑆾 𑆓𑆾𑆩𑆲𑆴𑆰𑆮𑆫𑆳𑆲𑆳𑆘𑆾𑆫𑆨𑇀𑆫𑆳𑆟𑆳𑆩𑇀 𑇆𑇑𑇓𑇆
𑆤𑆼𑆠𑇀𑆫𑆳𑆬𑆳𑆨𑆼 𑆲𑆴𑆠𑆳 𑆤𑆳𑆝𑆵 𑆤𑆬𑆮𑆁𑆯𑆳𑆱𑇀𑆡𑆴𑆱𑆩𑇀𑆨𑆮𑆳 𑇅 𑆧𑆱𑇀𑆠𑇀𑆪𑆬𑆳𑆨𑆼 𑆲𑆴𑆠𑆁 𑆖𑆫𑇀𑆩 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆁 𑆮𑆳 𑆠𑆳𑆤𑇀𑆠𑆮𑆁 𑆔𑆤𑆩𑇀 𑇆𑇑𑇔𑇆
𑆧𑆱𑇀𑆠𑆴𑆁 𑆤𑆴𑆫𑆶𑆥𑆢𑆴𑆓𑇀𑆣𑆁 𑆠𑆶 𑆯𑆶𑆢𑇀𑆣𑆁 𑆱𑆶𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆴𑆠𑆩𑇀 𑇅 𑆩𑆸𑆢𑇀𑆮𑆤𑆶𑆢𑇀𑆣𑆠𑆲𑆵𑆤𑆁 𑆖 𑆩𑆶𑆲𑆶𑆂 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆩𑆫𑇀𑆢𑆴𑆠𑆩𑇀 𑇆𑇑𑇕𑇆
𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆬𑆼 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑆥𑇀𑆪 𑆤𑇀𑆪𑆶𑆧𑇀𑆘𑆁 𑆠𑆶 𑆮𑆴𑆮𑆸𑆠𑆳𑆤𑆤𑆩𑇀 𑇅 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆬𑆾𑆲𑆼𑆤 𑆠𑆥𑇀𑆠𑆼𑆤 𑆖𑆫𑇀𑆩𑆱𑇀𑆫𑆾𑆠𑆱𑆴 𑆤𑆴𑆫𑇀𑆢𑆲𑆼𑆠𑇀 𑇆𑇑𑇖𑇆
𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑇀𑆪 𑆠𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆁 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆖 𑆠𑆽𑆬𑆁 𑆖 𑆪𑆡𑆳𑆮𑆠𑇀𑆠𑆼𑆤 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆾 𑆧𑆱𑇀𑆠𑆴𑆂- 𑆤𑆽𑆫𑆷𑆲𑆴𑆑𑆂, 𑆱𑇀𑆤𑆽𑆲𑆴𑆑𑆯𑇀𑆖 𑇅 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆁, 𑆤𑆴𑆫𑆷𑆲 𑆅𑆠𑇀𑆪𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆁; 𑆠𑆱𑇀𑆪 𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆩𑆳𑆣𑆶𑆠𑆽𑆬𑆴𑆑𑆂; 𑆠𑆱𑇀𑆪 𑆥𑆫𑇀𑆪𑆳𑆪𑆯𑆧𑇀𑆢𑆾 𑆪𑆳𑆥𑆤𑆾, 𑆪𑆶𑆑𑇀𑆠𑆫𑆡𑆂, 𑆱𑆴𑆢𑇀𑆣𑆧𑆱𑇀𑆠𑆴𑆫𑆴𑆠𑆴 𑇅 𑆱 𑆢𑆾𑆰𑆤𑆴𑆫𑇀𑆲𑆫𑆟𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆤𑆵𑆫𑆾𑆲𑆟𑆳𑆢𑇀𑆮𑆳 𑆤𑆴𑆫𑆷𑆲𑆂, 𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆢𑆳𑆪𑆶𑆂𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆢𑇀𑆮𑆳 𑆄𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑇀 𑇅 𑆩𑆳𑆣𑆶𑆠𑆽𑆬𑆴𑆑𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆤𑆴𑆫𑆷𑆲𑆾𑆥𑆑𑇀𑆫𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆪𑆡𑆳𑆥𑇀𑆫𑆩𑆳𑆟𑆓𑆶𑆟𑆮𑆴𑆲𑆴𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆑𑆬𑇀𑆥𑆾𑇁𑆤𑆶𑆮𑆳𑆱𑆤𑆂 𑆥𑆳𑆢𑆳𑆮(𑆥)𑆑𑆸𑆰𑇀𑆛𑆂 𑇅 𑆃𑆤𑆶𑆮𑆱𑆤𑇀𑆤𑆥𑆴 𑆤 𑆢𑆶𑆰𑇀𑆪𑆠𑇀𑆪𑆤𑆶𑆢𑆴𑆮𑆱𑆁 𑆮𑆳 𑆢𑆵𑆪𑆠 𑆅𑆠𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆂 𑇅 𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆮𑆴𑆑𑆬𑇀𑆥𑆾𑇁𑆫𑇀𑆣𑆳𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆑𑆸𑆰𑇀𑆛𑆾𑇁𑆥𑆫𑆴𑆲𑆳𑆫𑇀𑆪𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆧𑆱𑇀𑆠𑆴𑆫𑆴𑆠𑆴 𑇆𑇑𑇘𑇆
𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆲𑆫𑆯𑇀𑆖𑆳𑆱𑆿 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆖 𑆘𑆵𑆮𑆤𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆢𑆼𑆲𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇒𑇐𑇆
𑆠𑆠𑇀𑆫𑆾𑆤𑇀𑆩𑆳𑆢𑆨𑆪𑆯𑆾𑆑𑆥𑆴𑆥𑆳𑆱𑆳𑆫𑆾𑆖𑆑𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆫𑇀𑆯𑆂𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆨𑇀𑆫𑆩𑆩𑆢𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆾𑆢𑆫𑆱𑇀𑆡𑆿𑆬𑇀𑆪- 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆑𑆟𑇀𑆜𑆯𑆾𑆰𑆯𑆾𑆦𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆑𑇀𑆰𑆠𑆑𑇀𑆰𑆵𑆟𑆖𑆠𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆩𑆳𑆱𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆓𑇀𑆤𑇀𑆪𑆱𑆲𑆳 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆿 𑆖 𑆮𑆳𑆠𑆫𑆾𑆓𑆳𑆢𑆸𑆠𑆼 𑆑𑇀𑆰𑆵𑆟𑆳 𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆳 𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂 𑇆𑇒𑇑𑇆
𑆇𑆢𑆫𑆵 𑆖 𑆥𑇀𑆫𑆩𑆼𑆲𑆵 𑆖 𑆑𑆶𑆰𑇀𑆜𑆵 𑆱𑇀𑆡𑆷𑆬𑆯𑇀𑆖 𑆩𑆳𑆤𑆮𑆂 𑇅 𑆃𑆮𑆯𑇀𑆪𑆁 𑆱𑇀𑆡𑆳𑆥𑆤𑆵𑆪𑆳𑆱𑇀𑆠𑆼 𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆳𑆂 𑆑𑆡𑆚𑇀𑆖𑆤 𑇆𑇒𑇒𑇆
𑆃𑆱𑆳𑆣𑇀𑆪𑆠𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆱𑇀𑆪𑆳𑆢𑆼𑆰𑆳𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆠𑇀 𑇅 𑆃𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆼𑇁𑆥𑆴 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆱𑆢𑆤𑆁 𑆨𑆮𑆼𑆠𑇀 𑇆𑇒𑇓𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆼 𑆠𑆡𑆳 𑆯𑇀𑆫𑆾𑆟𑇀𑆪𑆳𑆁 𑆤𑆳𑆨𑇀𑆪𑆣𑆱𑇀𑆠𑆳𑆖𑇀𑆖 𑆱𑆫𑇀𑆮𑆠𑆂 𑇅 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆟𑆴𑆲𑆴𑆠𑆾 𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇆𑇒𑇔𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆮𑆵𑆫𑇀𑆪𑆁 𑆒𑆽𑆫𑇀𑆢𑆼𑆲𑆩𑆤𑆶𑆱𑆫𑇀𑆥𑆠𑆴 𑇅 𑆮𑆸𑆑𑇀𑆰𑆩𑆷𑆬𑆼 𑆤𑆴𑆰𑆴𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆥𑆳𑆁 𑆮𑆵𑆫𑇀𑆪𑆩𑆴𑆮 𑆢𑇀𑆫𑆶𑆩𑆩𑇀 𑇆𑇒𑇕𑇆
𑆱 𑆖𑆳𑆥𑆴 𑆱𑆲𑆱𑆳 𑆧𑆱𑇀𑆠𑆴𑆂 𑆑𑆼𑆮𑆬𑆂 𑆱𑆩𑆬𑆾𑇁𑆥𑆴 𑆮𑆳 𑇅 𑆥𑇀𑆫𑆠𑇀𑆪𑆼𑆠𑆴 𑆮𑆵𑆫𑇀𑆪𑆁 𑆠𑇀𑆮𑆤𑆴𑆬𑆽𑆫𑆥𑆳𑆤𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆤𑆵𑆪𑆠𑆼 𑇆𑇒𑇖𑇆
𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆧𑆱𑇀𑆠𑆴𑆫𑆳𑆢𑆠𑇀𑆠𑆼 𑆢𑆾𑆰𑆳𑆤𑆳𑆥𑆳𑆢𑆩𑆱𑇀𑆠𑆑𑆳𑆠𑇀(𑆤𑇀) 𑇅 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆾𑇁𑆩𑇀𑆧𑆫𑆓𑆾 𑆨𑆷𑆩𑆼𑆫𑆫𑇀𑆑𑆾 𑆫𑆱𑆳𑆤𑆴𑆮 𑇆𑇒𑇗𑇆
𑆱 𑆑𑆛𑆵𑆥𑆸𑆰𑇀𑆜𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆡𑆳𑆤𑇀 𑆮𑆵𑆫𑇀𑆪𑆼𑆟𑆳𑆬𑆾𑆝𑇀𑆪 𑆱𑆚𑇀𑆖𑆪𑆳𑆤𑇀 𑇅 𑆇𑆠𑇀𑆒𑆳𑆠𑆩𑆷𑆬𑆳𑆤𑇀 𑆲𑆫𑆠𑆴 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆳𑆣𑆶𑆪𑆾𑆘𑆴𑆠𑆂 𑇆𑇒𑇘𑇆
𑆢𑆾𑆰𑆠𑇀𑆫𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆩𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆑𑆾𑆥𑆼 𑆮𑆳𑆪𑆶𑆫𑆵𑆯𑇀𑆮𑆫𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆩𑆨𑆴𑆤𑆴𑆔𑇀𑆤𑆠𑆂 𑇆𑇒𑇙𑇆
𑆮𑆳𑆪𑆾𑆫𑇀𑆮𑆴𑆰𑆲𑆠𑆼 𑆮𑆼𑆓𑆁 𑆤𑆳𑆤𑇀𑆪𑆳 𑆧𑆱𑇀𑆠𑆼𑆫𑆸𑆠𑆼 𑆑𑇀𑆫𑆴𑆪𑆳 𑇅 𑆥𑆮𑆤𑆳𑆮𑆴𑆢𑇀𑆣𑆠𑆾𑆪𑆱𑇀𑆪 𑆮𑆼𑆬𑆳 𑆮𑆼𑆓𑆩𑆴𑆮𑆾𑆢𑆣𑆼𑆂 𑇆𑇓𑇐𑇆
𑆯𑆫𑆵𑆫𑆾𑆥𑆖𑆪𑆁 𑆮𑆫𑇀𑆟𑆁 𑆧𑆬𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑆂 𑇅 𑆑𑆶𑆫𑆶𑆠𑆼 𑆥𑆫𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆖 𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆳𑆱𑆴𑆠𑆂 𑇆𑇓𑇑𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑇅 𑆠𑆠𑇀𑆫 𑆤𑆼𑆠𑇀𑆫𑆁 𑆮𑆴𑆖𑆬𑆴𑆠𑆁, 𑆮𑆴𑆮𑆫𑇀𑆠𑆴𑆠𑆁, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆮𑆥𑆵𑆝𑆴𑆠𑆩𑇀, 𑆃𑆠𑇀𑆪𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆩𑇀, 𑆃𑆮𑆱𑆤𑇀𑆤𑆁, 𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆩𑆴𑆠𑆴 𑆰𑆛𑇀 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆢𑆾𑆰𑆳𑆂; 𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆁, 𑆑𑆫𑇀𑆑𑆯𑆩𑇀, 𑆃𑆮𑆤𑆠𑆁, 𑆃𑆟𑆶𑆨𑆴𑆤𑇀𑆤𑆁 , 𑆱𑆤𑇀𑆤𑆴𑆑𑆸𑆰𑇀𑆛𑆮𑆴𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆴𑆑𑆁, 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆠𑆴𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆩𑇀, 𑆃𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆩𑇀, 𑆃𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆩𑇀 , 𑆃𑆱𑇀𑆫𑆴𑆩𑆢𑆴𑆠𑇀𑆪𑆼𑆑𑆳𑆢𑆯 𑆤𑆼𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆂; 𑆧𑆲𑆬𑆠𑆳, 𑆃𑆬𑇀𑆥𑆠𑆳, 𑆱𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆠𑆳 , 𑆥𑇀𑆫𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆠𑆳, 𑆢𑆶𑆫𑇀𑆧𑆢𑇀𑆣𑆠𑆼𑆠𑆴 𑆥𑆚𑇀𑆖 𑆧𑆱𑇀𑆠𑆴𑆢𑆾𑆰𑆳𑆂; 𑆃𑆠𑆴𑆥𑆵𑆝𑆴𑆠𑆠𑆳, 𑆯𑆴𑆡𑆴𑆬𑆥𑆵𑆝𑆴𑆠𑆠𑆳, 𑆨𑆷𑆪𑆾 𑆨𑆷𑆪𑆾𑇁𑆮𑆥𑆵𑆝𑆤𑆁, 𑆑𑆳𑆬𑆳𑆠𑆴𑆑𑇀𑆫𑆩 𑆅𑆠𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑆵𑆝𑆤𑆢𑆾𑆰𑆳𑆂; 𑆄𑆩𑆠𑆳, 𑆲𑆵𑆤𑆠𑆳, 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆠𑆳, 𑆃𑆠𑆴𑆯𑆵𑆠𑆠𑆳, 𑆃𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆠𑆳, 𑆃𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆠𑆳, 𑆃𑆠𑆴𑆩𑆸𑆢𑆶𑆠𑆳, 𑆃𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆠𑆳, 𑆃𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆠𑆳, 𑆃𑆠𑆴𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆠𑆳, 𑆃𑆠𑆴𑆢𑇀𑆫𑆮𑆠𑆳, 𑆅𑆠𑇀𑆪𑆼𑆑𑆳𑆢𑆯 𑆢𑇀𑆫𑆮𑇀𑆪𑆢𑆾𑆰𑆳𑆂; 𑆃𑆮𑆳𑆑𑇀𑆯𑆵𑆫𑇀𑆰𑆾𑆖𑇀𑆗𑆵𑆫𑇀𑆰𑆤𑇀𑆪𑆶𑆧𑇀𑆘𑆾𑆠𑇀𑆠𑆳𑆤𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆢𑆼𑆲𑆱𑇀𑆡𑆴𑆠𑆢𑆑𑇀𑆰𑆴𑆟𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆳𑆪𑆴𑆤𑆂 𑆥𑇀𑆫𑆢𑆳𑆤𑆩𑆴𑆠𑆴 𑆱𑆥𑇀𑆠 𑆯𑆪𑇀𑆪𑆳𑆢𑆾𑆰𑆳𑆂; 𑆍𑆮𑆩𑆼𑆠𑆳𑆯𑇀𑆖𑆠𑆶𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆢𑇀𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆮𑆽𑆢𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑇅 𑆄𑆠𑆶𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆥𑆚𑇀𑆖𑆢𑆯 𑆄𑆠𑆶𑆫𑆾𑆥𑆢𑇀𑆫𑆮𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼 𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑇀𑆮𑆰𑇀𑆛𑆨𑆴𑆂 𑆑𑆳𑆫𑆟𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆾 𑆤 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆖𑇀𑆗𑆠𑆴 𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆽𑆂, 𑆃𑆯𑆤𑆳𑆨𑆴𑆨𑆷𑆠𑆾, 𑆩𑆬𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆾, 𑆢𑆷𑆫𑆳𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆾, 𑆃𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪, 𑆃𑆤𑆶𑆰𑇀𑆟𑆾, 𑆃𑆬𑇀𑆥𑆩𑇀𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆾, 𑆃𑆬𑇀𑆥𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑆽𑆢𑇀𑆪𑆳𑆠𑆶𑆫𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆃𑆪𑆾𑆓𑆱𑇀𑆠𑆷𑆨𑆪𑆾𑆂, 𑆄𑆣𑇀𑆩𑆳𑆤𑆁, 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳, 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆂, 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳, 𑆲𑆸𑆢𑆪𑆾𑆥𑆱𑆫𑆟𑆩𑇀, 𑆃𑆕𑇀𑆓𑆥𑇀𑆫𑆓𑇀𑆫𑆲𑆾, 𑆃𑆠𑆴𑆪𑆾𑆓𑆾, 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆩𑆴𑆠𑆴 𑆤𑆮 𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆮𑆽𑆢𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆰𑆛𑇀𑆱𑆥𑇀𑆠𑆠𑆴𑆂 𑆱𑆩𑆳𑆱𑆼𑆤 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆳𑆂 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆖 𑆠𑆢𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇆𑇓𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆼𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆮𑇀𑆪𑆳𑆥𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆡 𑆤𑆼𑆠𑇀𑆫𑆼 𑆮𑆴𑆖𑆬𑆴𑆠𑆼 𑆠𑆡𑆳 𑆖𑆽𑆮 𑆮𑆴𑆮𑆫𑇀𑆠𑆴𑆠𑆼 𑇅 𑆓𑆶𑆢𑆼 𑆑𑇀𑆰𑆠𑆁 𑆫𑆶𑆘𑆳 𑆮𑆳 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆢𑇀𑆪𑆂𑆑𑇀𑆰𑆠𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑇆𑇓𑇆
𑆃𑆠𑇀𑆪𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆼𑇁𑆮𑆱𑆤𑇀𑆤𑆼 𑆖 𑆤𑆼𑆠𑇀𑆫𑆼 𑆥𑆳𑆪𑆿 𑆨𑆮𑆼𑆢𑇀𑆫𑆶𑆘𑆳 𑇅 𑆮𑆴𑆣𑆴𑆫𑆠𑇀𑆫𑆳𑆥𑆴 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆂 𑆑𑆳𑆫𑇀𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆽𑆯𑇀𑆖 𑆱𑆼𑆖𑆤𑆩𑇀 𑇆𑇔𑇆
𑆠𑆴𑆫𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆟𑆴𑆲𑆴𑆠𑆼 𑆤𑆼𑆠𑇀𑆫𑆼 𑆠𑆡𑆳 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆮𑆥𑆵𑆝𑆴𑆠𑆼 𑇅 𑆩𑆶𑆒𑆱𑇀𑆪𑆳𑆮𑆫𑆟𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆤 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆉𑆘𑆶 𑆤𑆼𑆠𑇀𑆫𑆁 𑆮𑆴𑆣𑆼𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇆𑇕𑇆
𑆃𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆼 𑆑𑆫𑇀𑆑𑆯𑆼 𑆖 𑆤𑆼𑆠𑇀𑆫𑆼𑇁𑆱𑇀𑆠𑇀𑆫𑆴𑆩𑆠𑆴 𑆔𑆫𑇀𑆰𑆟𑆳𑆠𑇀 𑇅 𑆓𑆶𑆢𑆼 𑆨𑆮𑆼𑆠𑇀 𑆑𑇀𑆰𑆠𑆁 𑆫𑆶𑆑𑇀 𑆖 𑆱𑆳𑆣𑆤𑆁 𑆠𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇆𑇖𑇆
𑆄𑆱𑆤𑇀𑆤𑆑𑆫𑇀𑆟𑆴𑆑𑆼 𑆤𑆼𑆠𑇀𑆫𑆼 𑆨𑆴𑆤𑇀𑆤𑆼𑇁𑆟𑆿 𑆮𑆳𑇁𑆥𑇀𑆪𑆥𑆳𑆫𑇀𑆡𑆑𑆂 𑇅 𑆃𑆮𑆱𑆼𑆑𑆾 𑆨𑆮𑆼𑆢𑇀𑆧𑆱𑇀𑆠𑆼𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆤𑇀 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀 𑇆𑇗𑇆
𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆴𑆑𑆼 𑆫𑆑𑇀𑆠𑆁 𑆓𑆶𑆢𑆩𑆫𑇀𑆩𑆥𑇀𑆫𑆥𑆵𑆝𑆤𑆳𑆠𑇀 𑇅 𑆑𑇀𑆰𑆫𑆠𑇀𑆪𑆠𑇀𑆫𑆳𑆥𑆴 𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆾 𑆮𑆴𑆣𑆴𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆂 𑇆𑇘𑇆

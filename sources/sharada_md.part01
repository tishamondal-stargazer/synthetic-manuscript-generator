𑆲𑆴𑆁𑆱𑇀𑆪𑆳𑆢𑆠𑆴𑆓𑆠𑆁 𑆧𑆱𑇀𑆠𑆴𑆩𑆷𑆤𑆼 𑆱𑇀𑆤𑆼𑆲𑆾 𑆤 𑆓𑆖𑇀𑆗𑆠𑆴𑇅 𑆱𑆶𑆒𑆁 𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪 𑆤𑆴𑆰𑇀𑆑𑆩𑇀𑆥𑆁 𑆤𑆴𑆰𑇀𑆑𑆫𑇀𑆰𑆼𑆤𑇀𑆤𑆼𑆠𑇀𑆫𑆩𑆼𑆮 𑆖𑇆𑇕𑇖𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆠𑆼 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆖 𑆠𑆸𑆠𑆵𑆪𑆁 𑆖 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆃𑆤𑆳𑆓𑆖𑇀𑆗𑆤𑇀𑆤𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆱𑇀𑆠𑆶 𑆫𑆘𑆤𑆵𑆮𑇀𑆪𑆶𑆰𑆴𑆠𑆱𑇀𑆪 𑆖𑇆𑇕𑇗𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆬𑆮𑆟𑆳𑆓𑆳𑆫𑆣𑆷𑆩𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆱𑆫𑇀𑆰𑆥𑆽𑆂𑇅 𑆮𑆳𑆫𑇀𑆠𑆳𑆑𑆶𑆫𑆱𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑇀𑆝𑆵𑆯𑆩𑇀𑆥𑆳𑆑𑆽𑆂 𑆱𑆱𑆲𑆳𑆖𑆫𑆽𑆂𑇆𑇕𑇘𑇆
𑆩𑆷𑆠𑇀𑆫𑆳𑆩𑇀𑆬𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆱𑆓𑆶𑆝𑆽𑆫𑇀𑆮𑆫𑇀𑆠𑆴𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆠𑇀𑇅 𑆃𑆓𑇀𑆫𑆼 𑆠𑆶 𑆱𑆫𑇀𑆰𑆥𑆳𑆑𑆳𑆫𑆳𑆁 𑆥𑆯𑇀𑆖𑆳𑆫𑇀𑆣𑆼 𑆩𑆳𑆰𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆩𑇀𑇆𑇕𑇙𑇆
𑆤𑆼𑆠𑇀𑆫𑆢𑆵𑆫𑇀𑆔𑆳𑆁 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆳𑆁 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆩𑆨𑆕𑇀𑆓𑆶𑆫𑆳𑆩𑇀𑇅 𑆤𑆼𑆠𑇀𑆫𑆮𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆤𑆳𑆝𑇀𑆪𑆳𑆁 𑆠𑆶 𑆥𑆳𑆪𑆿 𑆖𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆩𑇀𑇆𑇖𑇐𑇆
𑆱𑇀𑆤𑆼𑆲𑆼 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆠𑆼 𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆴𑆑𑆾 𑆮𑆴𑆣𑆴𑆂𑇅 𑆥𑆫𑆴𑆲𑆳𑆫𑆯𑇀𑆖 𑆱𑆮𑇀𑆪𑆳𑆥𑆠𑇀 𑆱𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆠𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆂𑇆𑇖𑇑𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆩𑆳𑆫𑇀𑆠𑆮𑆑𑆳𑆬𑆼 𑆠𑆶 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩 𑆠𑆢𑆳𑆖𑆫𑆼𑆠𑇀𑇅 𑆓𑆫𑇀𑆨𑆳𑆱𑆤𑆳 𑆱𑆶𑆒𑆁 𑆱𑇀𑆤𑆼𑆲𑆁 𑆠𑆢𑆳𑇁𑇁𑆢𑆠𑇀𑆠𑆼 𑆲𑇀𑆪𑆥𑆳𑆮𑆸𑆠𑆳𑇆𑇖𑇒𑇆
𑆓𑆫𑇀𑆨𑆁 𑆪𑆾𑆤𑆴𑆱𑇀𑆠𑆢𑆳 𑆯𑆵𑆔𑇀𑆫𑆁 𑆘𑆴𑆠𑆼 𑆓𑆸𑆲𑇀𑆟𑆳𑆠𑆴 𑆩𑆳𑆫𑆶𑆠𑆼𑇅 𑆧𑆱𑇀𑆠𑆴𑆘𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆪𑆾𑆤𑆴𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆘𑆼𑆰𑆶 𑆖𑇆𑇖𑇓𑇆
𑆪𑆾𑆤𑆴𑆯𑆷𑆬𑆼𑆰𑆶 𑆠𑆵𑆮𑇀𑆫𑆼𑆰𑆶 𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑇀𑆮𑆱𑆸𑆓𑇀𑆢𑆫𑆼𑇅 𑆃𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆠𑆴 𑆩𑆷𑆠𑇀𑆫𑆼 𑆖 𑆧𑆴𑆤𑇀𑆢𑆶𑆁 𑆧𑆴𑆤𑇀𑆢𑆶𑆁 𑆱𑇀𑆫𑆮𑆠𑇀𑆪𑆥𑆴𑇆𑇖𑇔𑇆
𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆫𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆿𑆰𑆣𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆩𑇀 𑇅𑇖𑇕𑇅 𑆥𑆶𑆰𑇀𑆥𑆤𑆼𑆠𑇀𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆠𑆶 𑆥𑇀𑆫𑆩𑆢𑆳𑆤𑆳𑆁 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑇀𑇆𑇖𑇕𑇆
𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆂𑆥𑆫𑆵𑆟𑆳𑆲𑆁 𑆩𑆶𑆢𑇀𑆓𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆤𑆶𑆮𑆳𑆲𑆴 𑆖𑇅 𑆃𑆥𑆠𑇀𑆪𑆩𑆳𑆫𑇀𑆓𑆼 𑆤𑆳𑆫𑆵𑆟𑆳𑆁 𑆮𑆴𑆣𑆼𑆪𑆁 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆩𑇀𑇆𑇖𑇖𑇆
𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆁 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆼 𑆠𑆶 𑆧𑆳𑆬𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆑𑆩𑆕𑇀𑆓𑆶𑆬𑆩𑇀𑇅 𑆇𑆠𑇀𑆠𑆳𑆤𑆳𑆪𑆳𑆂 𑆯𑆪𑆳𑆤𑆳𑆪𑆳𑆂 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑆕𑇀𑆑𑆾𑆖𑇀𑆪 𑆱𑆑𑇀𑆡𑆴𑆤𑆵𑇆𑇖𑇗𑇆
𑆃𑆡𑆳𑆱𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆟𑆪𑆼𑆤𑇀𑆤𑆼𑆠𑇀𑆫𑆩𑆤𑆶𑆮𑆁𑆯𑆓𑆠𑆁 𑆱𑆶𑆒𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑆴𑆠𑆴 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆼𑆟 𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇖𑇘𑇆
𑆧𑆱𑇀𑆠𑆿 , 𑆧𑆱𑇀𑆠𑆿 𑆥𑇀𑆫𑆟𑆵𑆠𑆼 𑆖 𑆮𑆫𑇀𑆠𑆴𑆂 𑆥𑆵𑆤𑆠𑆫𑆳 𑆨𑆮𑆼𑆠𑇀𑇅 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆁 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀𑇆𑇖𑇙𑇆
𑆃𑆤𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑆶𑆤𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑇅𑇗𑇐𑇅 𑆃𑆠𑆂 𑆯𑆴𑆫𑆾𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆨𑆼𑆢𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇗𑇐𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆳 𑆢𑆶𑆰𑇀𑆛𑆳𑆂 𑆯𑆕𑇀𑆒𑆢𑆼𑆯𑆼 𑆮𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆳𑆂𑇅 𑆠𑆵𑆮𑇀𑆫𑆫𑆶𑆓𑇀𑆢𑆳𑆲𑆫𑆳𑆓𑆁 𑆲𑆴 𑆯𑆾𑆦𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆢𑆳𑆫𑆶𑆟𑆩𑇀𑇆𑇗𑇑𑇆
𑆱 𑆯𑆴𑆫𑆾 𑆮𑆴𑆰𑆮𑆢𑇀𑆮𑆼𑆓𑆵 𑆤𑆴𑆫𑆶𑆣𑇀𑆪𑆳𑆯𑆶 𑆓𑆬𑆁 𑆠𑆡𑆳𑇅 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆳𑆘𑇀𑆘𑆵𑆮𑆴𑆠𑆁 𑆲𑆤𑇀𑆠𑆴 𑆯𑆕𑇀𑆒𑆑𑆾 𑆤𑆳𑆩 𑆤𑆳𑆩𑆠𑆂𑇆𑇗𑇒𑇆
𑆥𑆫𑆁 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆘𑇀𑆘𑆵𑆮𑆠𑆴 𑆖𑆼𑆠𑇀 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆳𑆖𑆫𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇅 𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆑𑆱𑆼𑆑𑆳𑆢𑆴 𑆱𑆫𑇀𑆮𑆁 𑆮𑆵𑆱𑆫𑇀𑆥𑆤𑆶𑆖𑇀𑆖 𑆪𑆠𑇀𑇆𑇗𑇓𑇆
𑆫𑆷𑆑𑇀𑆰𑆳𑆠𑇀𑆪𑆣𑇀𑆪𑆯𑆤𑆳𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆮𑆳𑆠𑆳𑆮𑆯𑇀𑆪𑆳𑆪𑆩𑆽𑆡𑆶𑆤𑆽𑆂𑇅 𑆮𑆼𑆓𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆪𑆳𑆱𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆽𑆂 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇆𑇗𑇔𑇆
𑆑𑆼𑆮𑆬𑆂 𑆱𑆑𑆦𑆾 𑆮𑆳𑇁𑆫𑇀𑆣𑆁 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆯𑆴𑆫𑆱𑆱𑇀𑆠𑆠𑆂𑇅 𑆩𑆤𑇀𑆪𑆳𑆨𑇀𑆫𑆷𑆯𑆕𑇀𑆒𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆬𑆬𑆳𑆛𑆳𑆫𑇀𑆣𑆼𑇁𑆠𑆴𑆮𑆼𑆢𑆤𑆳𑆩𑇀𑇆𑇗𑇕𑇆
𑆯𑆱𑇀𑆠𑇀𑆫𑆳𑆫𑆟𑆴𑆤𑆴𑆨𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆵𑆮𑇀𑆫𑆳𑆁 𑆱𑆾𑇁𑆫𑇀𑆣𑆳𑆮𑆨𑆼𑆢𑆑𑆂𑇅 𑆤𑆪𑆤𑆁 𑆮𑆳𑇁𑆡𑆮𑆳 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆩𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆾 𑆮𑆴𑆤𑆳𑆯𑆪𑆼𑆠𑇀𑇆𑇗𑇖𑇆
𑆖𑆠𑆶𑆂𑆱𑇀𑆤𑆼𑆲𑆾𑆠𑇀𑆠𑆩𑆳 𑆩𑆳𑆠𑇀𑆫𑆳 𑆯𑆴𑆫𑆂𑆑𑆳𑆪𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆤𑆳𑆝𑆵𑆱𑇀𑆮𑆼𑆢𑆾 𑆔𑆸𑆠𑆁 𑆘𑆵𑆫𑇀𑆟𑆁 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇆𑇗𑇗𑇆

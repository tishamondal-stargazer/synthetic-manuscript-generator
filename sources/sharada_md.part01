𑆫𑆷𑆑𑇀𑆰𑆳𑆪 𑆧𑆲𑆶𑆮𑆳𑆠𑆳𑆪 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆁 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼 𑇅 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆓𑇀𑆤𑇀𑆪𑆳𑆧𑆳𑆣𑆨𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀 𑇆𑇗𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆾𑇁𑆬𑇀𑆥𑆩𑆳𑆠𑇀𑆫𑆾 𑆫𑆷𑆑𑇀𑆰𑆳𑆟𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆑𑆳𑆬𑆩𑆤𑆠𑇀𑆪𑆪𑆂 𑇅 𑆠𑆡𑆳 𑆤𑆴𑆫𑆷𑆲𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆳𑆩𑆬𑇀𑆥𑆩𑆳𑆠𑇀𑆫𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇘𑇐𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆘𑆳𑆂 𑇅 𑆧𑆬𑆮𑆤𑇀𑆠𑆾 𑆪𑆢𑆳 𑆢𑆾𑆰𑆳𑆂 𑆑𑆾𑆰𑇀𑆜𑆼 𑆱𑇀𑆪𑆶𑆫𑆤𑆴𑆬𑆳𑆢𑆪𑆂 𑇆𑇘𑇑𑇆
𑆃𑆬𑇀𑆥𑆮𑆵𑆫𑇀𑆪𑆁 𑆠𑆢𑆳 𑆱𑇀𑆤𑆼𑆲𑆩𑆨𑆴𑆨𑆷𑆪 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆤𑇀 𑇅 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑆱𑇀𑆤𑆼𑆲𑆂, 𑆱 𑆖𑆳𑆥𑆴 𑆤 𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑇆𑇘𑇒𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆠𑆶 𑆱𑇀𑆤𑆼𑆲𑆼 𑆩𑆶𑆒𑆑𑆰𑆳𑆪𑆠𑆳 𑇅 𑆘𑆸𑆩𑇀𑆨𑆳 𑆮𑆳𑆠𑆫𑆶𑆘𑆱𑇀𑆠𑆳𑆱𑇀𑆠𑆳 𑆮𑆼𑆥𑆡𑆶𑆫𑇀𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆂 𑇆𑇘𑇓𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆼 𑆠𑆶 𑆩𑆶𑆒𑆱𑇀𑆪 𑆑𑆛𑆶𑆠𑆳 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆢𑆳𑆲𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆘𑇀𑆮𑆫𑆂 𑆱𑇀𑆮𑆼𑆢𑆾 𑆤𑆼𑆠𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆳𑆕𑇀𑆓𑆥𑆵𑆠𑆠𑆳 𑇆𑇘𑇔𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆼 𑆠𑆶 𑆥𑇀𑆫𑆱𑆼𑆑𑆾 𑆩𑆣𑆶𑆫𑆳𑆱𑇀𑆪𑆠𑆳 𑇅 𑆓𑆿𑆫𑆮𑆁 𑆗𑆫𑇀𑆢𑆴𑆫𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆖𑇀𑆗𑆵𑆠𑆘𑇀𑆮𑆫𑆾𑇁𑆫𑆶𑆖𑆴𑆂 𑇆𑇘𑇕𑇆
𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆳𑆨𑆴𑆨𑆷𑆠𑆼 𑆠𑆶 𑆱𑇀𑆤𑆼𑆲𑆼 𑆧𑆱𑇀𑆠𑆴𑆁 𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀 𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆢𑆾𑆰𑆯𑆩𑆤𑆳𑆤𑇀𑆪𑆶𑆥𑆪𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆪𑆳𑆤𑆴 𑆖 𑇆𑇘𑇖𑇆
𑆃𑆠𑇀𑆪𑆳𑆯𑆴𑆠𑆼𑇁𑆤𑇀𑆤𑆳𑆨𑆴𑆨𑆮𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆾 𑆤𑆽𑆠𑆴 𑆪𑆢𑆳 𑆠𑆢𑆳 𑇅 𑆓𑆶𑆫𑆶𑆫𑆳𑆩𑆳𑆯𑆪𑆂 𑆯𑆷𑆬𑆁 𑆮𑆳𑆪𑆾𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆠𑆴𑆱𑆚𑇀𑆖𑆫𑆂 𑇆𑇘𑇗𑇆
𑆲𑆸𑆠𑇀𑆥𑆵𑆝𑆳 𑆩𑆶𑆒𑆮𑆽𑆫𑆱𑇀𑆪𑆁 𑆯𑇀𑆮𑆳𑆱𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆨𑇀𑆫𑆩𑆾𑇁𑆫𑆶𑆖𑆴𑆂 𑇅 𑆠𑆠𑇀𑆫𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆼 𑆢𑆵𑆥𑆤𑆾 𑆮𑆴𑆣𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇘𑇘𑇆
𑆃𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆩𑆬𑆾𑆤𑇀𑆩𑆴𑆯𑇀𑆫𑆂 𑆱𑇀𑆤𑆼𑆲𑆾 𑆤𑆽𑆠𑆴 𑆪𑆢𑆳 𑆥𑆶𑆤𑆂 𑇅 𑆠𑆢𑆳𑇁𑆕𑇀𑆓𑆱𑆢𑆤𑆳𑆣𑇀𑆩𑆳𑆤𑆼 𑆯𑇀𑆮𑆳𑆱𑆂 𑆯𑆷𑆬𑆁 𑆖 𑆘𑆳𑆪𑆠𑆼 𑇆𑇘𑇙𑇆
𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆖 𑆠𑆠𑇀𑆫 𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆫𑆷𑆲𑆟𑆩𑇀 𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆿𑆰𑆣𑆽𑆫𑆼𑆮 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇙𑇐𑇆
𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆢𑆷𑆫𑆳𑆤𑆶𑆱𑆸𑆠𑆼 𑆱𑇀𑆤𑆼𑆲𑆼 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆢𑆫𑇀𑆯𑆤𑆩𑇀 𑇅 𑆓𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆬𑆼𑆥𑆳𑇁𑆮𑆱𑆳𑆢𑆤𑆩𑇀 𑇆𑇙𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆓𑆤𑇀𑆣𑆴 𑆩𑆶𑆒𑆁 𑆖𑆳𑆥𑆴 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆮𑆫𑆾𑆖𑆑𑆂 𑇅 𑆃𑆠𑆴𑆥𑆵𑆝𑆴𑆠𑆮𑆠𑇀𑆠𑆠𑇀𑆫 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆠𑆡𑆳 𑇆𑇙𑇒𑇆
𑆃𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆳𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆾𑇁𑆬𑇀𑆥𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆴𑆠𑆂 𑇅 𑆯𑆵𑆠𑆾 𑆩𑆸𑆢𑆶𑆯𑇀𑆖 𑆤𑆳𑆨𑇀𑆪𑆼𑆠𑆴 𑆠𑆠𑆾 𑆩𑆤𑇀𑆢𑆁 𑆥𑇀𑆫𑆮𑆳𑆲𑆠𑆼 𑇆𑇙𑇓𑇆
𑆮𑆴𑆧𑆤𑇀𑆣𑆓𑆿𑆫𑆮𑆳𑆣𑇀𑆩𑆳𑆤𑆯𑆷𑆬𑆳𑆂 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆁 𑆥𑇀𑆫𑆠𑆴 𑇅 𑆠𑆠𑇀𑆫𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆼𑆮𑆳𑆯𑆶 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇙𑇔𑇆
𑆃𑆬𑇀𑆥𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆾𑇁𑆬𑇀𑆥𑆾 𑆲𑆴 𑆱𑇀𑆤𑆼𑆲𑆾 𑆩𑆤𑇀𑆢𑆓𑆶𑆟𑆱𑇀𑆠𑆡𑆳 𑇅 𑆢𑆠𑇀𑆠𑆾 𑆤𑆽𑆠𑆴 𑆑𑇀𑆬𑆩𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆿 𑆨𑆸𑆯𑆁 𑆖𑆳𑆫𑆠𑆴𑆩𑆳𑆮𑆲𑆼𑆠𑇀 𑇆𑇙𑇕𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆪𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆯𑆾𑆣𑆤𑆵𑆪𑆼𑆤 𑆧𑆱𑇀𑆠𑆴𑆤𑆳 𑇅 (𑆃𑆤𑇀𑆮𑆳𑆱𑆤𑆁 𑆖 𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆯𑆾𑆣𑆤𑆵𑆪𑆼𑆤 𑆯𑆱𑇀𑆪𑆠𑆼 ) 𑇆𑇙𑇖𑇆
𑆃𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆥𑆴 𑆱𑇀𑆤𑆼𑆲𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆖𑇀𑆗𑆤𑇀𑆤 𑆢𑆶𑆰𑇀𑆪𑆠𑆴 𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆓𑆶𑆟𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆘𑆵𑆫𑇀𑆟𑆱𑇀𑆠𑇀𑆮𑆬𑇀𑆥𑆓𑆶𑆟𑆾 𑆨𑆮𑆼𑆠𑇀 𑇆𑇙𑇗𑇆
𑆪𑆱𑇀𑆪 𑆤𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆫𑆤𑆴𑆂𑆱𑆸𑆠𑆂 𑇅 𑆱𑆫𑇀𑆮𑆾𑇁𑆬𑇀𑆥𑆾𑆮𑆳𑇁𑇁𑆮𑆸𑆠𑆾 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆂 𑆱 𑆮𑆴𑆘𑆳𑆤𑆠𑆳 𑇆𑇙𑇘𑇆
𑆃𑆤𑆳𑆪𑆳𑆤𑇀𑆠𑆁 𑆠𑇀𑆮𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆽𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑇅𑇙𑇙𑇅 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆳𑆮𑆤𑆳𑆪𑆳𑆠𑆼 𑆤𑆳𑆤𑇀𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆾 𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑇆𑇙𑇙𑇆
𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆤𑆼𑆠𑇀𑆫𑆩𑆳𑆠𑆶𑆫𑆳𑆕𑇀𑆓𑆶𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆩𑇀 𑇅 𑆩𑆳𑆬𑆠𑆵𑆥𑆶𑆰𑇀𑆥𑆮𑆸𑆤𑇀𑆠𑆳𑆓𑇀𑆫𑆁 𑆗𑆴𑆢𑇀𑆫𑆁 𑆱𑆫𑇀𑆰𑆥𑆤𑆴𑆫𑇀𑆓𑆩𑆩𑇀 𑇆𑇑𑇐𑇑𑇆
𑆱𑇀𑆤𑆼𑆲𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆥𑆫𑆩𑆁 𑆥𑇀𑆫𑆑𑆶𑆚𑇀𑆖𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇅 𑆥𑆚𑇀𑆖𑆮𑆴𑆁𑆯𑆳𑆢𑆣𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆑𑆬𑇀𑆥𑆴𑆠𑆳𑆩𑇀 𑇆𑇑𑇐𑇒𑇆
𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆴𑆑𑆁 𑆩𑆣𑇀𑆪𑆼, 𑆤𑆳𑆫𑆵𑆟𑆳𑆁 𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬𑆼 𑇅 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆫𑆾𑆠𑆂𑆥𑆫𑆵𑆟𑆳𑆲𑆁 𑆩𑆶𑆢𑇀𑆓𑆮𑆳𑆲𑆴 𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑇀 𑇆𑇑𑇐𑇓𑇆
𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆁 𑆩𑆷𑆠𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆼 𑆠𑆶 𑆑𑆤𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆼𑆑𑆩𑆕𑇀𑆓𑆶𑆬𑆩𑇀 𑇅 𑆮𑆴𑆣𑆼𑆪𑆁 𑆖𑆳𑆕𑇀𑆓𑆶𑆬𑆁 𑆠𑆳𑆱𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆣𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆪𑆡𑆳 𑇆𑇑𑇐𑇕𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪 𑆥𑇀𑆫𑆱𑆸𑆠𑆁 𑆖𑆳𑆠𑇀𑆫 𑆱𑇀𑆮𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆩𑆷𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆩𑇀 𑇅 𑆢𑆼𑆪𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆥𑆫𑆩𑆩𑆫𑇀𑆮𑆳𑆓𑇀 𑆧𑆶𑆢𑇀𑆣𑆴𑆮𑆴𑆑𑆬𑇀𑆥𑆴𑆠𑆩𑇀 𑇆𑇑𑇐𑇖𑇆
𑆐𑆫𑆨𑇀𑆫𑆂 𑆯𑆿𑆑𑆫𑆾 𑆮𑆳𑇁𑆥𑆴 𑆧𑆱𑇀𑆠𑆴𑆫𑆳𑆘𑆯𑇀𑆖 𑆥𑆷𑆘𑆴𑆠𑆂 𑇅 𑆠𑆢𑆬𑆳𑆨𑆼 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆓𑆬𑆖𑆫𑇀𑆩 𑆠𑆶 𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆩𑇀 𑇆𑇑𑇐𑇗𑇆
𑆪𑆮𑆳𑆓𑆷𑆁 𑆱𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆳𑆁 𑆥𑆵𑆠𑆮𑆤𑇀𑆠𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑇀 𑇅 𑆤𑆴𑆰𑆟𑇀𑆟𑆩𑆳𑆘𑆳𑆤𑆶𑆱𑆩𑆼 𑆥𑆵𑆜𑆼 𑆱𑆾𑆥𑆳𑆯𑇀𑆫𑆪𑆼 𑆱𑆩𑆩𑇀 𑇆𑇑𑇐𑇙𑇆
𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆧𑆱𑇀𑆠𑆴𑆩𑆷𑆫𑇀𑆣𑆳𑆤𑆁 𑆠𑆽𑆬𑆼𑆤𑆾𑆰𑇀𑆟𑆼𑆤 𑆩𑆳𑆤𑆮𑆩𑇀 𑇅 𑆠𑆠𑆂 𑆱𑆩𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆤𑆳𑆬𑆩𑆱𑇀𑆪 𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆴𑆠𑆩𑇀 𑇆𑇑𑇑𑇐𑇆
𑆥𑆷𑆫𑇀𑆮𑆁 𑆯𑆬𑆳𑆑𑆪𑆳𑇁𑆤𑇀𑆮𑆴𑆰𑇀𑆪 𑆠𑆠𑆾 𑆤𑆼𑆠𑇀𑆫𑆩𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇅 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆫𑇀𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆬𑆳𑆤𑆴 𑆰𑆛𑇀 𑇆𑇑𑇑𑇑𑇆
𑆩𑆼𑆞𑇀𑆫𑆪𑆳𑆩𑆱𑆩𑆁 𑆑𑆼𑆖𑆴𑆢𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆑𑆩𑇀 𑇅 𑆠𑆠𑆾𑇁𑆮𑆥𑆵𑆝𑆪𑆼𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆁 𑆯𑆤𑆽𑆫𑇀𑆤𑆼𑆠𑇀𑆫𑆁 𑆖 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑇆𑇑𑇑𑇒𑇆
𑆠𑆠𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆠𑆱𑇀𑆤𑆼𑆲𑆩𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆨𑆾𑆘𑆪𑆼𑆠𑇀 𑆥𑆪𑆱𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆪𑆷𑆰𑆼𑆟𑆳𑆡 𑆫𑆱𑆼𑆤 𑆮𑆳 𑇆𑇑𑇑𑇓𑇆
𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆵𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾𑇁𑆥𑆴 𑆮𑆳 𑇅𑇑𑇑𑇔𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆘𑆳𑆤𑇀𑆮𑆽 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆽 𑆢𑆢𑇀𑆪𑆳𑆢𑆶𑆠𑇀𑆠𑆳𑆤𑆳𑆪𑆽 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇆𑇑𑇑𑇔𑇆
𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆥𑆵𑆝𑆪𑆼𑆢𑇀𑆪𑆾𑆤𑆴𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆶𑆩𑆸𑆢𑆶𑆥𑆵𑆝𑆴𑆠𑆩𑇀 𑇅 𑆠𑇀𑆫𑆴𑆑𑆫𑇀𑆟𑆴𑆑𑆼𑆤 𑆤𑆼𑆠𑇀𑆫𑆼𑆟 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆠𑆴 𑇆𑇑𑇑𑇕𑇆
𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆼𑆤 𑆠𑆶 𑇅𑇑𑇑𑇖𑇅 𑆑𑇀𑆮𑆳𑆡𑆥𑇀𑆫𑆩𑆳𑆟𑆁 𑆥𑇀𑆫𑆱𑆸𑆠𑆁, 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆢𑇀𑆮𑆴𑆥𑇀𑆫𑆱𑆸𑆠𑆁 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇑𑇖𑇆
𑆑𑆤𑇀𑆪𑆼𑆠𑆫𑆱𑇀𑆪𑆳𑆂, 𑆑𑆤𑇀𑆪𑆳𑆪𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆑𑆩𑇀 𑇅𑇑𑇑𑇗𑇅 𑆃𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆖𑇀𑆗𑆠𑆴 𑆨𑆴𑆰𑆓𑇀 𑆧𑆱𑇀𑆠𑆳𑆮𑆶𑆠𑇀𑆠𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆼 𑇆𑇑𑇑𑇗𑇆
𑆨𑆷𑆪𑆾 𑆧𑆱𑇀𑆠𑆴𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀𑆠𑆶 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆯𑆾𑆣𑆤𑆽𑆫𑇀𑆓𑆟𑆽𑆂 𑇅 𑆓𑆶𑆢𑆼 𑆮𑆫𑇀𑆠𑆴𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑆯𑆾𑆣𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑇀𑆨𑆸𑆠𑆳𑆩𑇀 𑇆𑇑𑇑𑇘𑇆
𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆢𑇀𑆮𑆳 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆴𑆢𑇀𑆮𑆳𑆫𑆩𑆡𑆽𑆰𑆟𑆵𑆩𑇀 𑇅 𑆥𑆵𑆝𑆪𑆼𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆣𑆾 𑆤𑆳𑆨𑆼𑆫𑇀𑆧𑆬𑆼𑆤𑆾𑆠𑇀𑆠𑆫𑆩𑆶𑆰𑇀𑆛𑆴𑆤𑆳 𑇆𑇑𑇑𑇙𑇆
𑆄𑆫𑆓𑇀𑆮𑆣𑆱𑇀𑆪 𑆥𑆠𑇀𑆫𑆽𑆱𑇀𑆠𑆶 𑆤𑆴𑆫𑇀𑆓𑆶𑆟𑇀𑆝𑇀𑆪𑆳𑆂 𑆱𑇀𑆮𑆫𑆱𑆼𑆤 𑆖 𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆰𑇀𑆛𑆼𑆰𑆶 𑆮𑆫𑇀𑆠𑆵𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆳𑆂 𑇆𑇑𑇒𑇐𑇆
𑆩𑆶𑆢𑇀𑆓𑆽𑆬𑆳𑆱𑆫𑇀𑆰𑆥𑆱𑆩𑆳𑆂 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪 𑆮𑆪𑆳𑆁𑆱𑆴 𑆠𑆶 𑇅 𑆧𑆱𑇀𑆠𑆼𑆫𑆳𑆓𑆩𑆤𑆳𑆫𑇀𑆡𑆳𑆪 𑆠𑆳 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆗𑆬𑆳𑆑𑆪𑆳 𑇆𑇑𑇒𑇑𑇆
𑆄𑆓𑆳𑆫𑆣𑆷𑆩𑆧𑆸𑆲𑆠𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆦𑆬𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂 𑇅 𑆑𑆸𑆠𑆳 𑆮𑆳 𑆯𑆶𑆑𑇀𑆠𑆓𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆶𑆫𑆳𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆱𑆤𑆳𑆓𑆫𑆽𑆂 𑇆𑇑𑇒𑇒𑇆
𑆃𑆤𑆶𑆮𑆳𑆱𑆤𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆖 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅𑇑𑇒𑇓𑇅 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆩𑆴𑆯𑇀𑆫𑆼𑆟 𑆯𑆵𑆠𑆼𑆤 𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇆𑇑𑇒𑇓𑇆
𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆼 𑆠𑆢𑆳 𑆧𑆱𑇀𑆠𑆿 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆁 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆑𑆰𑆳𑆪𑆼𑆟 𑆥𑆪𑆱𑆳 𑆯𑆵𑆠𑆬𑆼𑆤 𑆖 𑇆𑇑𑇒𑇔𑇆
𑆯𑆶𑆑𑇀𑆫𑆁 𑆢𑆶𑆰𑇀𑆛𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆖𑆳𑆕𑇀𑆓𑆤𑆳𑆤𑆳𑆁 𑆥𑆶𑆰𑇀𑆥𑆾𑆢𑇀𑆫𑆼𑆑𑆁 𑆠𑆱𑇀𑆪 𑆤𑆳𑆯𑆁 𑆖 𑆑𑆰𑇀𑆛𑆩𑇀 𑇅 𑆩𑆷𑆠𑇀𑆫𑆳𑆔𑆳𑆠𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆤𑇀 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑇀 𑆪𑆾𑆤𑆴𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆴𑆁 𑆖𑆳𑆥𑆫𑆳𑆪𑆳𑆂 𑇆𑇑𑇒𑇕𑇆
𑆯𑆶𑆑𑇀𑆫𑆾𑆠𑇀𑆱𑆼𑆑𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆯𑇀𑆩𑆫𑆵𑆁 𑆖 𑆯𑆷𑆬𑆁 𑆧𑆱𑇀𑆠𑆿 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼 𑆩𑆼𑆲𑆤𑆼 𑆖 𑇅 𑆔𑆾𑆫𑆳𑆤𑆤𑇀𑆪𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆴𑆘𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆴 𑆫𑆾𑆓𑆳𑆤𑇀 𑆲𑆴𑆠𑇀𑆮𑆳 𑆩𑆼𑆲𑆳𑆤𑆶𑆠𑇀𑆠𑆫𑆾 𑆲𑆤𑇀𑆠𑆴 𑆧𑆱𑇀𑆠𑆴𑆂 𑇆𑇑𑇒𑇖𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆢𑆠𑇀𑆠𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆑𑇀𑆫𑆩 𑆍𑆮 𑆖 𑇅 𑆧𑆱𑇀𑆠𑆼𑆫𑆶𑆠𑇀𑆠𑆫𑆱𑆚𑇀𑆘𑇀𑆚𑆱𑇀𑆪 𑆱𑆩𑆳𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆤𑆳 𑇆𑇑𑇒𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆴𑆫𑆷𑆲𑆑𑇀𑆫𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆃𑆡𑆳𑆤𑆶𑆮𑆳𑆱𑆴𑆠𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀; 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆯𑆫𑆵𑆫𑆩𑆶𑆠𑇀𑆱𑆸𑆰𑇀𑆛𑆧𑆲𑆴𑆫𑇀𑆮𑆼𑆓𑆩𑆮𑆳𑆠𑆼 𑆯𑆶𑆖𑆿 𑆮𑆼𑆯𑇀𑆩𑆤𑆴 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆥𑇀𑆫𑆠𑆠𑆳𑆪𑆳𑆁 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆩𑆣𑆂𑆱𑆶𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆳𑆪𑆳𑆁 𑆯𑇀𑆫𑆾𑆟𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆥𑇀𑆫𑆠𑆴𑆮𑇀𑆪𑆷𑆞𑆳𑆪𑆳𑆩𑆤𑆶𑆥𑆣𑆳𑆤𑆳𑆪𑆳𑆁 𑆮𑆳𑆩𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆳𑆪𑆴𑆤𑆩𑆳𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆢𑆑𑇀𑆰𑆴𑆟𑆱𑆑𑇀𑆡𑆴𑆩𑆴𑆠𑆫𑆥𑇀𑆫𑆱𑆳𑆫𑆴𑆠𑆱𑆑𑇀𑆡𑆴𑆁 𑆱𑆶𑆩𑆤𑆱𑆁 𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑇀𑆤𑆁 𑆮𑆳𑆓𑇀𑆪𑆠𑆁 𑆱𑆶𑆤𑆴𑆰𑆟𑇀𑆟𑆢𑆼𑆲𑆁 𑆮𑆴𑆢𑆴𑆠𑇀𑆮𑆳, 𑆠𑆠𑆾 𑆮𑆳𑆩𑆥𑆳𑆢𑆱𑇀𑆪𑆾𑆥𑆫𑆴 𑆤𑆼𑆠𑇀𑆫𑆁 𑆑𑆸𑆠𑇀𑆮𑆼𑆠𑆫𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆨𑇀𑆪𑆳𑆁 𑆑𑆫𑇀𑆟𑆴𑆑𑆳𑆩𑆶𑆥𑆫𑆴 𑆤𑆴𑆰𑇀𑆥𑆵𑆝𑇀𑆪, 𑆱𑆮𑇀𑆪𑆥𑆳𑆟𑆴𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳𑆤𑆳𑆩𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆧𑆱𑇀𑆠𑆼𑆫𑇀𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆁 𑆱𑆕𑇀𑆑𑆾𑆖𑇀𑆪, 𑆩𑆣𑇀𑆪𑆩𑆳𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑇀𑆪𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆽𑆫𑆫𑇀𑆣𑆁 𑆠𑆶 𑆮𑆴𑆮𑆸𑆠𑆳𑆱𑇀𑆪𑆁 𑆑𑆸𑆠𑇀𑆮𑆳, 𑆧𑆱𑇀𑆠𑆳𑆮𑆿𑆰𑆣𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪, 𑆢𑆑𑇀𑆰𑆴𑆟𑆲𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆼𑆤 𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆩𑆣𑇀𑆪𑆩𑆳𑆨𑇀𑆪𑆳𑆁 𑆖𑆳𑆤𑆶𑆱𑆴𑆑𑇀𑆠𑆩𑆤𑆳𑆪𑆠𑆩𑆧𑆶𑆢𑇀𑆧𑆶𑆢𑆩𑆱𑆕𑇀𑆑𑆶𑆖𑆴𑆠𑆩𑆮𑆳𑆠𑆩𑆿𑆰𑆣𑆳𑆱𑆤𑇀𑆤𑆩𑆶𑆥𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪 , 𑆥𑆶𑆤𑆫𑆶𑆥𑆫𑆴 𑆠𑆢𑆴𑆠𑆫𑆼𑆟 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆤𑆳𑆮𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀, 𑆠𑆠𑆂 𑆱𑆷𑆠𑇀𑆫𑆼𑆟𑆽𑆮𑆿𑆰𑆣𑆳𑆤𑇀𑆠𑆼 𑆢𑇀𑆮𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆫𑇀𑆮𑆳𑇁𑇁𑆮𑆼𑆰𑇀𑆛𑇀𑆪 𑆧𑆣𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆃𑆡 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆤𑆾𑆠𑇀𑆠𑆳𑆤𑆼𑆤 𑆥𑆳𑆟𑆴𑆤𑆳 𑆧𑆱𑇀𑆠𑆴𑆁 𑆓𑆸𑆲𑆵𑆠𑇀𑆮𑆳 𑆮𑆳𑆩𑆲𑆱𑇀𑆠𑆩𑆣𑇀𑆪𑆩𑆳𑆕𑇀𑆓𑆶𑆬𑆴𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆨𑇀𑆪𑆳𑆁 𑆤𑆼𑆠𑇀𑆫𑆩𑆶𑆥𑆱𑆕𑇀𑆓𑆸𑆲𑇀𑆪𑆳𑆕𑇀𑆓𑆶𑆰𑇀𑆜𑆼𑆤 𑆤𑆼𑆠𑇀𑆫𑆢𑇀𑆮𑆳𑆫𑆁 𑆥𑆴𑆣𑆳𑆪, 𑆔𑆸𑆠𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆳𑆓𑇀𑆫𑆤𑆼𑆠𑇀𑆫𑆁 𑆔𑆸𑆠𑆳𑆑𑇀𑆠𑆩𑆶𑆥𑆳𑆢𑆳𑆪 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆢𑆤𑆶𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆁 𑆱𑆩𑆩𑆶𑆤𑇀𑆩𑆶𑆒𑆩𑆳𑆑𑆫𑇀𑆟𑆴𑆑𑆁 𑆤𑆼𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆟𑆴𑆣𑆠𑇀𑆱𑇀𑆮𑆼𑆠𑆴 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀 𑇆𑇓𑇆
𑆧𑆱𑇀𑆠𑆴𑆁 𑆱𑆮𑇀𑆪𑆼 𑆑𑆫𑆼 𑆑𑆸𑆠𑇀𑆮𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆤𑆳𑆮𑆥𑆵𑆝𑆪𑆼𑆠𑇀 𑇅 𑆍𑆑𑆼𑆤𑆽𑆮𑆳𑆮𑆥𑆵𑆝𑆼𑆤 𑆤 𑆢𑇀𑆫𑆶𑆠𑆁 𑆤 𑆮𑆴𑆬𑆩𑇀𑆧𑆴𑆠𑆩𑇀 𑇆𑇔𑇆
𑆠𑆠𑆾 𑆤𑆼𑆠𑇀𑆫𑆩𑆥𑆤𑆵𑆪 𑆠𑇀𑆫𑆴𑆁𑆯𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆂 𑆥𑆵𑆝𑆤𑆑𑆳𑆬𑆳𑆢𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆾𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆪𑆳𑆠𑆶𑆫𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀 𑇅 𑆃𑆡𑆳𑆠𑆶𑆫𑆩𑆶𑆥𑆮𑆼𑆯𑆪𑆼𑆢𑆶𑆠𑇀𑆑𑆶𑆛𑆶𑆑𑆁 𑆧𑆱𑇀𑆠𑇀𑆪𑆳𑆓𑆩𑆤𑆳𑆫𑇀𑆡𑆩𑇀 𑇅 𑆤𑆴𑆫𑆷𑆲𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆓𑆩𑆤𑆑𑆳𑆬𑆱𑇀𑆠𑆶 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆾 𑆨𑆮𑆠𑆴 𑇆𑇕𑇆
𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆧𑆱𑇀𑆠𑆴𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆯𑆳𑆫𑆢𑆂 𑇅 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆮𑆳 𑆠𑆸𑆠𑆵𑆪𑆁 𑆮𑆳 𑆖𑆠𑆶𑆫𑇀𑆡𑆁 𑆮𑆳 𑆪𑆡𑆳𑆫𑇀𑆡𑆠𑆂 𑇆𑇖𑇆
𑆱𑆩𑇀𑆪𑆕𑇀𑆤𑆴𑆫𑆷𑆞𑆬𑆴𑆕𑇀𑆓𑆼 𑆠𑆶 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆧𑆱𑇀𑆠𑆴𑆁 𑆤𑆴𑆮𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑆳𑆁 𑆲𑆵𑆤 𑆍𑆮 𑆑𑇀𑆫𑆩𑆾 𑆲𑆴𑆠𑆂 𑇆𑇗𑇆
𑆃𑆥𑆴 𑆲𑆵𑆤𑆑𑇀𑆫𑆩𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆤 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆠𑆴𑆑𑇀𑆫𑆩𑆩𑇀 𑇅 𑆪𑆱𑇀𑆪 𑆱𑇀𑆪𑆳𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑆬𑇀𑆥𑆾𑇁𑆬𑇀𑆥𑆮𑆼𑆓𑆾 𑆲𑆵𑆤𑆩𑆬𑆳𑆤𑆴𑆬𑆂 𑇆𑇘𑇆
𑆢𑆶𑆫𑇀𑆤𑆴𑆫𑆷𑆞𑆂 𑆱 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆳𑆫𑇀𑆠𑇀𑆪𑆫𑆶𑆖𑆴𑆘𑆳𑆝𑇀𑆪𑆮𑆳𑆤𑇀 𑇅 𑆪𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆪𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆠𑆴𑆮𑆴𑆫𑆼𑆖𑆴𑆠𑆼 𑇆𑇙𑇆

𑆓𑆶𑆛𑆴𑆑𑆳𑆁 𑆣𑆳𑆫𑆪𑆼𑆢𑆳𑆱𑇀𑆪𑆼 𑆖𑆷𑆫𑇀𑆟𑆽𑆫𑇀𑆮𑆳 𑆯𑆾𑆣𑆪𑆼𑆤𑇀𑆩𑆶𑆒𑆩𑇀𑇅 𑆍𑆰𑆳𑆩𑆳𑆬𑆾𑆝𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆳𑆤𑇀𑇆𑇑𑇓𑇙𑇆
𑆱𑆶𑆫𑆳𑆩𑆳𑆣𑇀𑆮𑆵𑆑𑆱𑆵𑆣𑆷𑆤𑆳𑆁 𑆠𑆽𑆬𑆱𑇀𑆪 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆂𑇅 𑆑𑆮𑆬𑆳𑆤𑇀 𑆣𑆳𑆫𑆪𑆼𑆢𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆑𑇀𑆰𑆵𑆫𑆱𑇀𑆪𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆱𑇀𑆪 𑆖𑇆𑇑𑇔𑇐𑇆
𑆪𑆮𑆳𑆤𑆵𑆁 𑆠𑆴𑆤𑇀𑆠𑆴𑆝𑆵𑆑𑆁 𑆖 𑆤𑆳𑆓𑆫𑆁 𑆱𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆩𑇀𑇅 𑆢𑆳𑆝𑆴𑆩𑆁 𑆧𑆢𑆫𑆁 𑆖𑆳𑆩𑇀𑆬𑆁 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆁 𑆖𑆾𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇔𑇑𑇆
𑆣𑆳𑆤𑇀𑆪𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆳𑆘𑆳𑆘𑆵𑆮𑆫𑆳𑆕𑇀𑆓𑆁 𑆖𑆳𑆫𑇀𑆣𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆩𑇀𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆯𑆠𑆁 𑆖𑆽𑆑𑆁 𑆢𑇀𑆮𑆼 𑆯𑆠𑆼 𑆩𑆫𑆴𑆖𑆱𑇀𑆪 𑆖𑇆𑇑𑇔𑇒𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆳𑆯𑇀𑆖 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆥𑆬𑆳𑆤𑇀𑆪𑆼𑆑𑆠𑇀𑆫 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇅 𑆘𑆴𑆲𑇀𑆮𑆳𑆮𑆴𑆯𑆾𑆣𑆤𑆁 𑆲𑆸𑆢𑇀𑆪𑆁 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆨𑆑𑇀𑆠𑆫𑆾𑆖𑆤𑆩𑇀𑇆𑇑𑇔𑇓𑇆
𑆲𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆔𑇀𑆤𑆁 𑆮𑆴𑆧𑆤𑇀𑆣𑆳𑆤𑆳𑆲𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆲𑆫𑆁 𑆓𑇀𑆫𑆳𑆲𑆴 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆾𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀𑇆𑇑𑇔𑇔𑇆
𑆅𑆠𑆴 𑆪𑆮𑆳𑆤𑆵𑆰𑆳𑆝𑆮𑆩𑇀𑇅 𑆠𑆳𑆬𑆵𑆯𑆥𑆠𑇀𑆫𑆁 𑆩𑆫𑆴𑆖𑆁 𑆤𑆳𑆓𑆫𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆯𑆶𑆨𑆳𑇅 𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆁 𑆨𑆳𑆓𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆠𑇀𑆮𑆓𑆼𑆬𑆼 𑆖𑆳𑆫𑇀𑆣𑆨𑆳𑆓𑆴𑆑𑆼𑇆𑇑𑇔𑇕𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆰𑇀𑆛𑆓𑆶𑆟𑆳 𑆖𑆳𑆠𑇀𑆫 𑆥𑇀𑆫𑆢𑆼𑆪𑆳 𑆱𑆴𑆠𑆯𑆫𑇀𑆑𑆫𑆳𑇅 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑆶𑆖𑆴𑆲𑆫𑆁 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆢𑆵𑆥𑆤𑆁 𑆥𑆫𑆩𑇀𑇆𑇑𑇔𑇖𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆯𑆾𑆰𑆥𑇀𑆬𑆵𑆲𑆘𑇀𑆮𑆫𑆳𑆥𑆲𑆩𑇀𑇅 𑆮𑆩𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆯𑆷𑆬𑆔𑇀𑆤𑆁 𑆩𑆷𑆞𑆮𑆳𑆠𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆩𑇀𑇆𑇑𑇔𑇗𑇆
𑆑𑆬𑇀𑆥𑆪𑆼𑆢𑇀𑆓𑆶𑆛𑆴𑆑𑆳𑆁 𑆖𑆽𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆩𑇀𑇅 𑆓𑆶𑆛𑆴𑆑𑆳 𑆲𑇀𑆪𑆓𑇀𑆤𑆴𑆱𑆁𑆪𑆾𑆓𑆳𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆬𑇀𑆬𑆔𑆶𑆠𑆫𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇑𑇔𑇘𑇆
𑆅𑆠𑆴 𑆠𑆳𑆬𑆵𑆯𑆳𑆢𑇀𑆪𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆓𑆶𑆛𑆴𑆑𑆳𑆯𑇀𑆖𑇅 𑆯𑆶𑆰𑇀𑆪𑆠𑆳𑆁 𑆑𑇀𑆰𑆵𑆟𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁 𑆑𑆬𑇀𑆥𑆴𑆠𑆳𑆤𑆴 𑆮𑆴𑆣𑆳𑆤𑆮𑆴𑆠𑇀𑇅 𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆁𑆱𑆳𑆢𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆧𑆸𑆁𑆲𑆟𑆳𑆤𑆴 𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇆𑇑𑇔𑇙𑇆
𑆮𑆳𑆫𑆶𑆟𑆵𑆩𑆟𑇀𑆝𑆤𑆴𑆠𑇀𑆪𑆱𑇀𑆪 𑆧𑆲𑆴𑆫𑇀𑆩𑆳𑆫𑇀𑆘𑆤𑆱𑆼𑆮𑆴𑆤𑆂𑇅 𑆃𑆮𑆴𑆣𑆳𑆫𑆴𑆠𑆮𑆼𑆓𑆱𑇀𑆪 𑆪𑆑𑇀𑆰𑇀𑆩𑆳 𑆤 𑆬𑆨𑆠𑆼𑇁𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇑𑇖𑇔𑇆
𑆩𑆢𑇀𑆪𑆁 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆿𑆰𑇀𑆟𑇀𑆪𑆮𑆽𑆯𑆢𑇀𑆪𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆩𑆶𑆒𑆩𑇀𑇅 𑆥𑇀𑆫𑆩𑆡𑇀𑆪 𑆮𑆴𑆮𑆸𑆟𑆾𑆠𑇀𑆪𑆳𑆯𑆶 𑆠𑆤𑇀𑆩𑆾𑆑𑇀𑆰𑆳𑆠𑇀 𑆱𑆥𑇀𑆠 𑆣𑆳𑆠𑆮𑆂𑇆𑇑𑇖𑇖𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁, 𑆥𑆪𑆱𑆳 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑆯𑆓𑆶𑆟𑆼𑆤 𑆮𑆳𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆩𑆣𑆶𑆫𑆑𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆢𑆯𑆩𑆷𑆬𑆑𑆰𑆳𑆪𑆑𑆽𑆂𑇆𑇑𑇖𑇘𑇆
𑆱𑆪𑆳𑆮𑆯𑆷𑆑𑆽𑆂 𑆱𑆑𑇀𑆰𑆵𑆫𑆽𑆂 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆯𑆾𑆣𑆤𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆫𑆳𑆱𑇀𑆤𑆳𑆧𑆬𑆳𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆱𑇀𑆡𑆴𑆫𑆳𑆮𑆫𑇀𑆰𑆳𑆨𑆶𑆱𑆳𑆣𑆴𑆠𑆩𑇀𑇆𑇑𑇗𑇐𑇆
𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆓𑆫𑇀𑆨𑆁 𑆱𑆑𑇀𑆰𑆵𑆫𑆁 𑆯𑆾𑆰𑆤𑆶𑆢𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆪𑆮𑆳𑆓𑇀𑆮𑆳 𑆮𑆳 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑆩𑆣𑆶𑆤𑆳 𑆱𑆲𑇆𑇑𑇗𑇑𑇆
𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆩𑆼𑆰𑆳𑆩𑆢𑇀𑆪𑆳𑆢𑆤𑇀𑆤𑆼𑆤 𑆮𑆳 𑆱𑆲𑇅 𑆯𑆶𑆰𑇀𑆪𑆠𑆳𑆩𑆼𑆰 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆾 𑆮𑆴𑆣𑆴𑆫𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆴𑆑𑆂𑇆𑇑𑇗𑇒𑇆
𑆧𑆲𑆴𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇁𑆠𑆂 𑆥𑆫𑆁 𑆮𑆴𑆣𑆴𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆑𑇀𑆰𑆵𑆫𑆳𑆩𑇀𑆧𑆶𑆑𑆾𑆰𑇀𑆜𑆼𑆰𑆶 𑆱𑇀𑆮𑆨𑇀𑆪𑆑𑇀𑆠𑆩𑆮𑆓𑆳𑆲𑆪𑆼𑆠𑇀𑇆𑇑𑇗𑇓𑇆
𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆧𑆤𑇀𑆣𑆩𑆾𑆑𑇀𑆰𑆳𑆫𑇀𑆡𑆁 𑆧𑆬𑆥𑆶𑆰𑇀𑆛𑇀𑆪𑆫𑇀𑆡𑆩𑆼𑆮 𑆖𑇅 𑆇𑆠𑇀𑆠𑆵𑆫𑇀𑆟𑆁 𑆩𑆴𑆯𑇀𑆫𑆑𑆽𑆂𑆱𑇀𑆤𑆼𑆲𑆽𑆂 𑆥𑆶𑆤𑆫𑆳𑆑𑇀𑆠𑆽𑆂 𑆱𑆶𑆒𑆽𑆂 𑆑𑆫𑆽𑆂𑇆𑇑𑇗𑇔𑇆
𑆩𑆸𑆢𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆶𑆒𑆩𑆳𑆱𑆵𑆤𑆁 𑆱𑆶𑆒𑆁 𑆖𑆾𑆠𑇀𑆱𑆳𑆢𑆪𑆼𑆤𑇀𑆤𑆫𑆩𑇀𑇅 𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆁 𑆯𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆁 𑆖 𑆮𑆴𑆑𑆱𑆳𑆁 𑆱𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆩𑇀𑇆𑇑𑇗𑇕𑇆
𑆃𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆩𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆁 𑆠𑆫𑇀𑆑𑆳𑆫𑆵𑆁 𑆩𑆣𑆶𑆑𑆁 𑆧𑆬𑆳𑆩𑇀𑇅 𑆮𑆴𑆢𑆳𑆫𑆵𑆁 𑆱𑆫𑇀𑆰𑆥𑆁 𑆑𑆶𑆰𑇀𑆜𑆁 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆤𑆠𑆱𑆵𑆦𑆬𑆩𑇀𑇆𑇑𑇗𑇖𑇆
𑆩𑆳𑆰𑆳𑆁𑆱𑇀𑆠𑆴𑆬𑆳𑆁𑆯𑇀𑆖 𑆑𑆴𑆟𑇀𑆮𑆁 𑆖 𑆱𑆫𑇀𑆮𑆩𑆼𑆑𑆠𑇀𑆫 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇅 𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆴𑆠𑆁 𑆢𑆣𑇀𑆤𑆳 𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑇀𑇆𑇑𑇗𑇗𑇆

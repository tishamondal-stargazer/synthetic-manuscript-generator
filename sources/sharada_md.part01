𑆮𑆳𑆢𑆳𑆤𑇀 𑆱𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆢𑆳𑆤𑇀 𑆲𑆴 𑆮𑆢𑆤𑇀𑆠𑆾 𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆳𑆤𑆴𑆮𑇅 𑆥𑆑𑇀𑆰𑆳𑆤𑇀𑆠𑆁 𑆤𑆽𑆮 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆠𑆴𑆬𑆥𑆵𑆝𑆑𑆮𑆢𑇀𑆓𑆠𑆿𑇆𑇒𑇗𑇆
𑆩𑆶𑆑𑇀𑆠𑇀𑆮𑆽𑆮𑆁 𑆮𑆳𑆢𑆱𑆕𑇀𑆔𑆛𑇀𑆛𑆩𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆩𑆤𑆶𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆠𑆳𑆩𑇀𑇅 𑆤𑆳𑆮𑆴𑆣𑆷𑆠𑆼 𑆠𑆩𑆂𑆱𑇀𑆑𑆤𑇀𑆣𑆼 𑆘𑇀𑆚𑆼𑆪𑆼 𑆘𑇀𑆚𑆳𑆤𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇒𑇘𑇆
𑆪𑆼𑆰𑆳𑆩𑆼𑆮 𑆲𑆴 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆱𑆩𑇀𑆥𑆠𑇀 𑆱𑆚𑇀𑆘𑆤𑆪𑆼𑆤𑇀𑆤𑆫𑆩𑇀𑇅 𑆠𑆼𑆰𑆳𑆩𑆼𑆮 𑆮𑆴𑆥𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆤𑇀𑆱𑆩𑆶𑆢𑆵𑆫𑆪𑆼𑆠𑇀𑇆𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑇀𑆫𑆼𑆪𑆱𑇀𑆪 𑆨𑆓𑆮𑆠𑆾 𑆮𑆖𑆤𑆩𑆤𑆶𑆤𑆴𑆯𑆩𑇀𑆪 𑆥𑆶𑆤𑆫𑆼𑆮 𑆮𑆳𑆩𑆑𑆂 𑆑𑆳𑆯𑆴𑆥𑆠𑆴𑆫𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆁- 𑆨𑆓𑆮𑆤𑇀! 𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆱𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆮𑆴𑆥𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆳𑆤𑆳𑆁 𑆖 𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆑𑆴𑆩𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆳𑆫𑆟𑆩𑆴𑆠𑆴𑇆𑇓𑇐𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆲𑆴𑆠𑆳𑆲𑆳𑆫𑆾𑆥𑆪𑆾𑆓 𑆍𑆑 𑆍𑆮 𑆥𑆶𑆫𑆶𑆰𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆾 𑆨𑆮𑆠𑆴, 𑆃𑆲𑆴𑆠𑆳𑆲𑆳𑆫𑆾𑆥𑆪𑆾𑆓𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑆴 𑇆𑇓𑇑𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆑𑆡𑆩𑆴𑆲 𑆨𑆓𑆮𑆤𑇀! 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆩𑆤𑆥𑆮𑆳𑆢𑆩𑆨𑆴𑆘𑆳𑆤𑆵𑆩𑆲𑆼; 𑆲𑆴𑆠𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆩𑆲𑆴𑆠𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆁 𑆖 𑆩𑆳𑆠𑇀𑆫𑆳𑆑𑆳𑆬𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆷𑆩𑆴𑆢𑆼𑆲𑆢𑆾𑆰𑆥𑆶𑆫𑆶𑆰𑆳𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆮𑆴𑆥𑆫𑆵𑆠𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆩𑆶𑆥𑆬𑆨𑆳𑆩𑆲 𑆅𑆠𑆴𑇆𑇓𑇒𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆪𑆢𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆱𑆩𑆳𑆁𑆯𑇀𑆖𑆽𑆮 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆷𑆤𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆿 𑆱𑇀𑆡𑆳𑆥𑆪𑆠𑆴 𑆮𑆴𑆰𑆩𑆳𑆁𑆯𑇀𑆖 𑆱𑆩𑆵𑆑𑆫𑆾𑆠𑆵𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆣𑆴𑆠𑆁 𑆮𑆴𑆢𑇀𑆣𑆴, 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆠𑇀𑆮𑆲𑆴𑆠𑆩𑆴𑆠𑆴; 𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆣𑆴𑆠𑆳𑆲𑆴𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑆤𑆥𑆮𑆳𑆢𑆁 𑆨𑆮𑆠𑆴𑇆𑇓𑇓𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆖 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆨𑆓𑆮𑆤𑇀! 𑆤 𑆠𑇀𑆮𑆼𑆠𑆢𑆼𑆮𑆩𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆑𑆬𑇀𑆥𑆳𑆂 𑆱𑆫𑇀𑆮𑆨𑆴𑆰𑆘𑆾 𑆮𑆴𑆘𑇀𑆚𑆳𑆱𑇀𑆪𑆤𑇀𑆠𑆴𑇆𑇓𑇔𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆪𑆼𑆰𑆳𑆁 𑆲𑆴 𑆮𑆴𑆢𑆴𑆠𑆩𑆳𑆲𑆳𑆫𑆠𑆠𑇀𑆠𑇀𑆮𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆓𑆶𑆟𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆠𑆂 𑆑𑆫𑇀𑆩𑆠𑆂 𑆱𑆫𑇀𑆮𑆳𑆮𑆪𑆮𑆯𑆯𑇀𑆖 𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆪𑆾 𑆨𑆳𑆮𑆳𑆂, 𑆠 𑆍𑆠𑆢𑆼𑆮𑆩𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆠𑆶𑆩𑆶𑆠𑇀𑆱𑆲𑆤𑇀𑆠𑆼𑇅 𑆪𑆡𑆳 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆠𑆢𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆑𑆬𑇀𑆥𑆳𑆂 𑆱𑆫𑇀𑆮𑆨𑆴𑆰𑆘𑆾 𑆮𑆴𑆘𑇀𑆚𑆳𑆱𑇀𑆪𑆤𑇀𑆠𑆴, 𑆠𑆡𑆽𑆠𑆢𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑆤𑆶𑆢𑆳𑆲𑆫𑆤𑇀𑆠𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆲𑆴 𑆧𑆲𑆶𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆄𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆁𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆬𑆑𑇀𑆰𑆟𑆠𑆯𑇀𑆖𑆳𑆮𑆪𑆮𑆠𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇕𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆄𑆲𑆳𑆫𑆠𑇀𑆮𑆩𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆽𑆑𑆮𑆴𑆣𑆩𑆫𑇀𑆡𑆳𑆨𑆼𑆢𑆳𑆠𑇀; 𑆱 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆴𑆪𑆾𑆤𑆴𑆂, 𑆱𑇀𑆡𑆳𑆮𑆫𑆘𑆕𑇀𑆓𑆩𑆳𑆠𑇀𑆩𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆥𑇀𑆫𑆨𑆳𑆮𑆂, 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆾𑆢𑆫𑇀𑆑𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀; 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆾𑆥𑆪𑆾𑆓𑆂, 𑆥𑆳𑆤𑆳𑆯𑆤𑆨𑆑𑇀𑆰𑇀𑆪𑆬𑆼𑆲𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆳𑆠𑇀; 𑆰𑆝𑆳𑆱𑇀𑆮𑆳𑆢𑆂, 𑆫𑆱𑆨𑆼𑆢𑆠𑆂 𑆰𑆝𑇀𑆮𑆴𑆣𑆠𑇀𑆮𑆳𑆠𑇀; 𑆮𑆴𑆁𑆯𑆠𑆴𑆓𑆶𑆟𑆂, 𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆩𑆤𑇀𑆢𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆱𑇀𑆡𑆴𑆫𑆱𑆫𑆩𑆸𑆢𑆶𑆑𑆜𑆴𑆤- 𑆮𑆴𑆯𑆢𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆒𑆫𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆡𑆷𑆬𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆢𑇀𑆫𑆮𑆳𑆤𑆶𑆓𑆩𑆳𑆠𑇀; 𑆃𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆮𑆴𑆑𑆬𑇀𑆥𑆂, 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆑𑆫𑆟𑆧𑆳𑆲𑆶𑆬𑇀𑆪𑆳𑆠𑇀𑇆𑇓𑇖𑇆
𑆠𑆱𑇀𑆪 𑆒𑆬𑆶 𑆪𑆼 𑆪𑆼 𑆮𑆴𑆑𑆳𑆫𑆳𑆮𑆪𑆮𑆳 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆤𑇀𑆠𑆼, 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆑𑆬𑇀𑆥𑆳𑆤𑆳𑆁 𑆖 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆽𑆮 𑆲𑆴𑆠𑆠𑆩𑆳𑆯𑇀𑆖𑆳𑆲𑆴𑆠𑆠𑆩𑆳𑆯𑇀𑆖, 𑆠𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆪𑆡𑆳𑆮𑆢𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇗𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆬𑆾𑆲𑆴𑆠𑆯𑆳𑆬𑆪𑆂 𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆳𑆁 𑆥𑆡𑇀𑆪𑆠𑆩𑆠𑇀𑆮𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆠𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆩𑆶𑆢𑇀𑆓𑆳𑆂 𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆳𑆩𑇀, 𑆄𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆩𑆶𑆢𑆑𑆳𑆤𑆳𑆁, 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆬𑆮𑆟𑆳𑆤𑆳𑆁, 𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆯𑆳𑆑𑆁 𑆯𑆳𑆑𑆳𑆤𑆳𑆩𑇀, 𑆎𑆟𑆼𑆪𑆁 𑆩𑆸𑆓𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁, 𑆬𑆳𑆮𑆂 𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆁, 𑆓𑆾𑆣𑆳 𑆧𑆴𑆬𑆼𑆯𑆪𑆳𑆤𑆳𑆁, 𑆫𑆾𑆲𑆴𑆠𑆾 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆁, 𑆓𑆮𑇀𑆪𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆁, 𑆓𑆾𑆑𑇀𑆰𑆵𑆫𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆳𑆁, 𑆠𑆴𑆬𑆠𑆽𑆬𑆁 𑆱𑇀𑆡𑆳𑆮𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆳𑆁, 𑆮𑆫𑆳𑆲𑆮𑆱𑆳 𑆄𑆤𑆷𑆥𑆩𑆸𑆓𑆮𑆱𑆳𑆤𑆳𑆁, 𑆖𑆶𑆬𑆶𑆑𑆵𑆮𑆱𑆳 𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆱𑆳𑆤𑆳𑆁, 𑆥𑆳𑆑𑆲𑆁𑆱𑆮𑆱𑆳 𑆘𑆬𑆖𑆫𑆮𑆴𑆲𑆕𑇀𑆓𑆮𑆱𑆳𑆤𑆳𑆁, 𑆑𑆶𑆑𑇀𑆑𑆶𑆛𑆮𑆱𑆳 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆯𑆑𑆶𑆤𑆴𑆮𑆱𑆳𑆤𑆳𑆁, 𑆃𑆘𑆩𑆼𑆢𑆂 𑆯𑆳𑆒𑆳𑆢𑆩𑆼𑆢𑆱𑆳𑆁, 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆁 𑆑𑆤𑇀𑆢𑆳𑆤𑆳𑆁, 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳 𑆦𑆬𑆳𑆤𑆳𑆁, 𑆯𑆫𑇀𑆑𑆫𑆼𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑇀, 𑆅𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆽𑆮 𑆲𑆴𑆠𑆠𑆩𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇓𑇘𑇆
𑆃𑆲𑆴𑆠𑆠𑆩𑆳𑆤𑆥𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆪𑆮𑆑𑆳𑆂 𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆳𑆩𑆥𑆡𑇀𑆪𑆠𑆩𑆠𑇀𑆮𑆼𑆤 𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆠𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆩𑆳𑆰𑆳𑆂 𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆳𑆁, 𑆮𑆫𑇀𑆰𑆳𑆤𑆳𑆢𑆼𑆪𑆩𑆶𑆢𑆑𑆳𑆤𑆳𑆩𑇀, 𑆈𑆰𑆫𑆁 𑆬𑆮𑆟𑆳𑆤𑆳𑆁, 𑆱𑆫𑇀𑆰𑆥𑆯𑆳𑆑𑆁 𑆯𑆳𑆑𑆳𑆤𑆳𑆁, 𑆓𑆾𑆩𑆳𑆁𑆱𑆁 𑆩𑆸𑆓𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁, 𑆑𑆳𑆟𑆑𑆥𑆾𑆠𑆂 𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆁, 𑆨𑆼𑆑𑆾 𑆧𑆴𑆬𑆼𑆯𑆪𑆳𑆤𑆳𑆁, 𑆖𑆴𑆬𑆴𑆖𑆴𑆩𑆾 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑆳𑆩𑇀, 𑆄𑆮𑆴𑆑𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆩𑇀, 𑆃𑆮𑆴𑆑𑇀𑆰𑆵𑆫𑆁 𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆳𑆁, 𑆑𑆶𑆱𑆶𑆩𑇀𑆨𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑇀𑆡𑆳𑆮𑆫𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆳𑆁, 𑆩𑆲𑆴𑆰𑆮𑆱𑆳 𑆄𑆤𑆷𑆥𑆩𑆸𑆓𑆮𑆱𑆳𑆤𑆳𑆁, 𑆑𑆶𑆩𑇀𑆨𑆵𑆫𑆮𑆱𑆳 𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆱𑆳𑆤𑆳𑆁, 𑆑𑆳𑆑𑆩𑆢𑇀𑆓𑆶𑆮𑆱𑆳 𑆘𑆬𑆖𑆫𑆮𑆴𑆲𑆕𑇀𑆓𑆮𑆱𑆳𑆤𑆳𑆁, 𑆖𑆛𑆑𑆮𑆱𑆳 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆯𑆶𑆑𑆤𑆴𑆮𑆱𑆳𑆤𑆳𑆁, 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆢𑆂 𑆯𑆳𑆒𑆳𑆢𑆩𑆼𑆢𑆱𑆳𑆁, 𑆤𑆴𑆑𑆶𑆖𑆁 𑆦𑆬𑆳𑆤𑆳𑆩𑇀, 𑆄𑆬𑆶𑆑𑆁 𑆑𑆤𑇀𑆢𑆳𑆤𑆳𑆁, 𑆦𑆳𑆟𑆴𑆠𑆩𑆴𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑇀, 𑆅𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆽𑆮𑆳𑆲𑆴𑆠𑆠𑆩𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆠𑆩𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; (𑆅𑆠𑆴) 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆳𑆮𑆪𑆮𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠 𑆄𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑇀𑇆𑇓𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆓𑇀𑆫𑇀𑆪𑆳𑆟𑆳𑆁 𑆯𑆠𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆪𑆢𑇀𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆳𑆯𑆢𑆶𑆠𑇀𑆠𑆫𑆩𑇀𑇅 𑆃𑆬𑆩𑆼𑆠𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆔𑆳𑆠𑆳𑆪𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇔𑇑𑇆
𑆱𑆩𑆳𑆤𑆑𑆳𑆫𑆴𑆟𑆾 𑆪𑆼𑇁𑆫𑇀𑆡𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆘𑇀𑆪𑆳𑆪𑆱𑇀𑆠𑇀𑆮𑆁 𑆑𑆳𑆫𑇀𑆪𑆑𑆫𑇀𑆠𑆸𑆠𑇀𑆮𑆼 𑆮𑆫𑆠𑇀𑆮𑆁 𑆖𑆳𑆥𑇀𑆪𑆶𑆢𑆳𑆲𑆸𑆠𑆩𑇀𑇆𑇔𑇒𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑆳𑆁 𑆖 𑆪𑆢𑇀𑆪𑆠𑇀 𑆥𑇀𑆫𑆯𑆩𑆤𑆼 𑆲𑆴𑆠𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆠𑆯𑇀𑆖 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆪𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆲𑆫𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇔𑇓𑇆
𑆍𑆠𑆤𑇀𑆤𑆴𑆯𑆩𑇀𑆪 𑆤𑆴𑆥𑆶𑆟𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆍𑆮𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆱𑆢𑆳 𑆮𑆽𑆢𑇀𑆪𑆾 𑆣𑆫𑇀𑆩𑆑𑆳𑆩𑆿 𑆱𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇔𑇔𑇆
𑆥𑆡𑇀𑆪𑆁 𑆥𑆡𑆾𑇁𑆤𑆥𑆼𑆠𑆁 𑆪𑆢𑇀𑆪𑆖𑇀𑆖𑆾𑆑𑇀𑆠𑆁 𑆩𑆤𑆱𑆂 𑆥𑇀𑆫𑆴𑆪𑆩𑇀𑇅 𑆪𑆖𑇀𑆖𑆳𑆥𑇀𑆫𑆴𑆪𑆩𑆥𑆡𑇀𑆪𑆁 𑆖 𑆤𑆴𑆪𑆠𑆁 𑆠𑆤𑇀𑆤 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇔𑇕𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆑𑆳𑆬𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆷𑆩𑆴𑆢𑆼𑆲𑆢𑆾𑆰𑆓𑆶𑆟𑆳𑆤𑇀𑆠𑆫𑆩𑇀 𑇅 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆠𑆠𑇀𑆠𑆢𑇀𑆣𑆴 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆼 𑆠𑆼 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆡𑆳 𑆠𑆡𑆳𑇆𑇔𑇖𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑇀𑆮𑆨𑆳𑆮𑆾 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆱𑇀𑆠𑆡𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆴𑆫𑆳𑆯𑇀𑆫𑆪𑆂𑇅 𑆠𑆢𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆾𑆨𑆪𑆁 𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆴𑆖𑇀𑆗𑆠𑆳𑇆𑇔𑇗𑇆
𑆠𑆢𑆳𑆠𑇀𑆫𑆼𑆪𑆱𑇀𑆪 𑆨𑆓𑆮𑆠𑆾 𑆮𑆖𑆤𑆩𑆤𑆶𑆤𑆴𑆯𑆩𑇀𑆪 𑆥𑆶𑆤𑆫𑆥𑆴 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆂 𑆑𑆼𑆮𑆬𑆾𑇁𑆪𑆩𑆫𑇀𑆡𑆾 𑆨𑆓𑆮𑆠𑆳 𑆯𑇀𑆫𑆶𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆩𑆳𑆨𑆴𑆂𑇅 𑆄𑆱𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆴𑆢𑆳𑆤𑆵𑆩𑆤𑆥𑆮𑆳𑆢𑆁 𑆬𑆑𑇀𑆰𑆟𑆩𑆤𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆯𑆶𑆯𑇀𑆫𑆷𑆰𑆳𑆩𑆲 𑆅𑆠𑆴𑇆𑇔𑇘𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆣𑆳𑆤𑇀𑆪𑆦𑆬𑆩𑆷𑆬𑆱𑆳𑆫𑆥𑆶𑆰𑇀𑆥𑆑𑆳𑆟𑇀𑆝𑆥𑆠𑇀𑆫𑆠𑇀𑆮𑆖𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆱𑆮𑆪𑆾𑆤𑆪𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆳𑆰𑇀𑆛𑆿 𑆯𑆫𑇀𑆑𑆫𑆳𑆤𑆮𑆩𑆵𑆑𑆳𑆂𑇅 𑆠𑆳𑆱𑇀𑆮𑆼𑆮 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆑𑆫𑆟𑆠𑆾𑇁𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆱𑆶 𑆪𑆡𑆳𑆥𑆡𑇀𑆪𑆠𑆩𑆳𑆤𑆳𑆩𑆳𑆱𑆮𑆳𑆤𑆳𑆁 𑆖𑆠𑆶𑆫𑆯𑆵𑆠𑆴𑆁 𑆤𑆴𑆧𑆾𑆣𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆠𑆶𑆰𑆾𑆢𑆑𑆩𑆽𑆫𑆼𑆪𑆩𑆼𑆢𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆳𑆂 𑆰𑆝𑇀 𑆣𑆳𑆤𑇀𑆪𑆳𑆱𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆒𑆫𑇀𑆘𑆷𑆫𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆣𑆤𑇀𑆮𑆤𑆫𑆳𑆘𑆳𑆢𑆤𑆠𑆸𑆟𑆯𑆷𑆤𑇀𑆪𑆥𑆫𑆷𑆰𑆑𑆳𑆨𑆪𑆳𑆩𑆬𑆑𑆩𑆸𑆓𑆬𑆴𑆟𑇀𑆝𑆴𑆑𑆳𑆘𑆳𑆩𑇀𑆧𑆮𑆑𑆥𑆴𑆠𑇀𑆡- 𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆥𑆵𑆬𑆶𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆥𑆤𑆱𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆥𑇀𑆬𑆑𑇀𑆰𑆑𑆥𑆵𑆠𑆤𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆘𑆩𑆾𑆢𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆯𑆳𑆕𑇀𑆒𑆴𑆤𑆵𑆦𑆬𑆳𑆱𑆮𑆳𑆂 𑆰𑆝𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆮𑆴𑆢𑆳𑆫𑆴𑆓𑆤𑇀𑆣𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆑𑆸𑆰𑇀𑆟𑆓𑆤𑇀𑆣𑆳𑆯𑆠𑆳𑆮𑆫𑆵𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆧𑆴𑆬𑇀𑆮𑆾𑆫𑆶𑆧𑆷𑆑𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆽𑆫𑆼𑆑𑆳𑆢𑆯 𑆩𑆷𑆬𑆳𑆱𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆯𑆳𑆬𑆥𑇀𑆫𑆴𑆪𑆑𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆖𑆤𑇀𑆢𑆤𑆱𑇀𑆪𑆤𑇀𑆢𑆤𑆒𑆢𑆴𑆫𑆑𑆢𑆫𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆫𑇀𑆘𑆶𑆤𑆳𑆱𑆤𑆳𑆫𑆴𑆩𑆼𑆢𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆑𑆴𑆟𑆴𑆲𑆵𑆯𑆩𑆵- 𑆯𑆶𑆑𑇀𑆠𑆴𑆯𑆴𑆁𑆯𑆥𑆳𑆯𑆴𑆫𑆵𑆰𑆮𑆚𑇀𑆘𑆬𑆣𑆤𑇀𑆮𑆤𑆩𑆣𑆷𑆑𑆽𑆂 𑆱𑆳𑆫𑆳𑆱𑆮𑆳 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆤𑆬𑆴𑆑𑆶𑆩𑆶𑆢𑆱𑆿𑆓𑆤𑇀𑆣𑆴𑆑𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆯𑆠𑆥𑆠𑇀𑆫𑆩𑆣𑆷𑆑𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆣𑆳𑆠𑆑𑆵𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑇀𑆢𑆯 𑆥𑆶𑆰𑇀𑆥𑆳𑆱𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆅𑆑𑇀𑆰𑆶𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑇀𑆮𑆴𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆥𑆶𑆟𑇀𑆝𑇀𑆫𑆑𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆂 𑆑𑆳𑆟𑇀𑆝𑆳𑆱𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆥𑆛𑆾𑆬𑆠𑆳𑆝𑆑𑆥𑆠𑇀𑆫𑆳𑆱𑆮𑆿 𑆢𑇀𑆮𑆿 𑆨𑆮𑆠𑆂, 𑆠𑆴𑆬𑇀𑆮𑆑𑆬𑆾𑆣𑇀𑆫𑆽𑆬𑆮𑆳𑆬𑆶𑆑𑆑𑇀𑆫𑆩𑆶𑆑𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆱𑇀𑆠𑇀𑆮𑆓𑆳𑆱𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆯𑆫𑇀𑆑𑆫𑆳𑆱𑆮 𑆍𑆑 𑆍𑆮𑆼𑆠𑆴𑇅 𑆍𑆮𑆩𑆼𑆰𑆳𑆩𑆳𑆱𑆮𑆳𑆤𑆳𑆁 𑆖𑆠𑆶𑆫𑆯𑆵𑆠𑆴𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆼𑆟𑆳𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆩𑆳𑆱𑆮𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑆶𑆥𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆨𑆮𑆠𑆴𑇅 𑆍𑆰𑆳𑆩𑆳𑆱𑆮𑆳𑆤𑆳𑆩𑆳𑆱𑆶𑆠𑆠𑇀𑆮𑆳𑆢𑆳𑆱𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆮𑆴𑆨𑆳𑆓𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆱𑇀𑆠𑇀𑆮𑆼𑆰𑆳𑆁 𑆧𑆲𑆶𑆮𑆴𑆣𑆑𑆬𑇀𑆥𑆂 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆯𑇀𑆖𑇅 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆱𑆁𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳 𑆲𑇀𑆪𑆳𑆱𑆮𑆳𑆂 𑆱𑇀𑆮𑆁 𑆑𑆫𑇀𑆩 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴𑇅 𑆱𑆁𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆢𑆼𑆯𑆑𑆳𑆬𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆪𑆯𑇀𑆖 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆼𑆰𑆳𑆩𑆳𑆱𑆮𑆳𑆤𑆳𑆁 𑆠𑆼 𑆠𑆼 𑆱𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆠𑇀𑆠𑆠𑇀𑆑𑆳𑆫𑇀𑆪𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆼𑆠𑆴𑇆𑇔𑇙𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆥𑇀𑆫𑆢𑆳𑆤𑆳𑆩𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑆾𑆑𑆳𑆫𑆶𑆖𑆴𑆤𑆳𑆯𑆤𑆳𑆤𑆳𑆩𑇀𑇅 𑆱𑆁𑆲𑆫𑇀𑆰𑆟𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆫𑆳𑆱𑆮𑆳𑆤𑆳𑆩𑆯𑆵𑆠𑆴𑆫𑆶𑆑𑇀𑆠𑆳 𑆖𑆠𑆶𑆫𑆶𑆠𑇀𑆠𑆫𑆽𑆰𑆳𑇆𑇕𑇐𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆯𑆫𑆵𑆫𑆫𑆾𑆓𑆥𑇀𑆫𑆑𑆸𑆠𑆿 𑆩𑆠𑆳𑆤𑆴 𑆠𑆠𑇀𑆠𑇀𑆮𑆼𑆤 𑆖𑆳𑆲𑆳𑆫𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆁 𑆖𑇅 𑆇𑆮𑆳𑆖 𑆪𑆘𑇀𑆘𑆂𑆥𑆶𑆫𑆶𑆰𑆳𑆢𑆴𑆑𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆩𑆶𑆤𑆴𑆱𑇀𑆠𑆡𑆳𑇁𑆓𑇀𑆫𑇀𑆪𑆳𑆟𑆴 𑆮𑆫𑆳𑆱𑆮𑆳𑆁𑆯𑇀𑆖𑇆𑇕𑇑𑇆
𑆃𑆡𑆳𑆠 𑆄𑆠𑇀𑆫𑆼𑆪𑆨𑆢𑇀𑆫𑆑𑆳𑆥𑇀𑆪𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆪𑆂 𑆑𑆶𑆩𑆳𑆫𑆯𑆴𑆫𑆳 𑆤𑆳𑆩 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆂 𑆱 𑆖𑆳𑆤𑆔𑆂𑇅 𑆯𑇀𑆫𑆵𑆩𑆳𑆤𑇀 𑆮𑆳𑆫𑇀𑆪𑆾𑆮𑆴𑆢𑆯𑇀𑆖𑆽𑆮 𑆫𑆳𑆘𑆳 𑆩𑆠𑆴𑆩𑆠𑆳𑆁 𑆮𑆫𑆂𑇆𑇔𑇆
𑆤𑆴𑆩𑆴𑆯𑇀𑆖 𑆫𑆳𑆘𑆳 𑆮𑆽𑆢𑆼𑆲𑆾 𑆧𑆝𑆴𑆯𑆯𑇀𑆖 𑆩𑆲𑆳𑆩𑆠𑆴𑆂𑇅 𑆑𑆳𑆕𑇀𑆑𑆳𑆪𑆤𑆯𑇀𑆖 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆾 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆨𑆴𑆰𑆘𑆳𑆁 𑆮𑆫𑆂𑇆𑇕𑇆
𑆍𑆠𑆼 𑆯𑇀𑆫𑆶𑆠𑆮𑆪𑆾𑆮𑆸𑆢𑇀𑆣𑆳 𑆘𑆴𑆠𑆳𑆠𑇀𑆩𑆳𑆤𑆾 𑆩𑆲𑆫𑇀𑆰𑆪𑆂𑇅 𑆮𑆤𑆼 𑆖𑆽𑆠𑇀𑆫𑆫𑆡𑆼 𑆫𑆩𑇀𑆪𑆼 𑆱𑆩𑆵𑆪𑆶𑆫𑇀𑆮𑆴𑆘𑆴𑆲𑆵𑆫𑇀𑆰𑆮𑆂𑇆𑇖𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆠𑇀𑆫𑆾𑆥𑆮𑆴𑆰𑇀𑆛𑆳𑆤𑆳𑆩𑆴𑆪𑆩𑆫𑇀𑆡𑆮𑆠𑆵 𑆑𑆡𑆳𑇅 𑆧𑆨𑆷𑆮𑆳𑆫𑇀𑆡𑆮𑆴𑆢𑆳𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆫𑆱𑆳𑆲𑆳𑆫𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆼𑇆𑇗𑇆
𑆍𑆑 𑆍𑆮 𑆫𑆱 𑆅𑆠𑇀𑆪𑆶𑆮𑆳𑆖 𑆨𑆢𑇀𑆫𑆑𑆳𑆥𑇀𑆪𑆂, 𑆪𑆁 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆘𑆴𑆲𑇀𑆮𑆳𑆮𑆽𑆰𑆪𑆴𑆑𑆁 𑆨𑆳𑆮𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆑𑆶𑆯𑆬𑆳𑆂, 𑆱 𑆥𑆶𑆤𑆫𑆶𑆢𑆑𑆳𑆢𑆤𑆤𑇀𑆪 𑆅𑆠𑆴𑇅 𑆢𑇀𑆮𑆿 𑆫𑆱𑆳𑆮𑆴𑆠𑆴 𑆯𑆳𑆑𑆶𑆤𑇀𑆠𑆼𑆪𑆾 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆂, 𑆗𑆼𑆢𑆤𑆵𑆪 𑆇𑆥𑆯𑆩𑆤𑆵𑆪𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑇀𑆫𑆪𑆾 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆥𑆷𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆾 𑆩𑆿𑆢𑇀𑆓𑆬𑇀𑆪𑆂, 𑆗𑆼𑆢𑆤𑆵𑆪𑆾𑆥𑆯𑆩𑆤𑆵𑆪𑆱𑆳𑆣𑆳𑆫𑆟𑆳 𑆅𑆠𑆴𑇅 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆲𑆴𑆫𑆟𑇀𑆪𑆳𑆑𑇀𑆰𑆂 𑆑𑆿𑆯𑆴𑆑𑆂, 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆲𑆴𑆠𑆯𑇀𑆖 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑆲𑆴𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆲𑆴𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑆲𑆴𑆠𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆥𑆚𑇀𑆖 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆑𑆶𑆩𑆳𑆫𑆯𑆴𑆫𑆳 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆂, 𑆨𑆿𑆩𑆿𑆢𑆑𑆳𑆓𑇀𑆤𑆼𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆳𑆂𑇅 𑆰𑆝𑇀𑆫𑆱𑆳 𑆅𑆠𑆴 𑆮𑆳𑆫𑇀𑆪𑆾𑆮𑆴𑆢𑆾 𑆫𑆳𑆘𑆫𑇀𑆰𑆴𑆂, 𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆳𑆂𑇅 𑆱𑆥𑇀𑆠 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆤𑆴𑆩𑆴𑆫𑇀𑆮𑆽𑆢𑆼𑆲𑆂, 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑇀𑆰𑆳𑆫𑆳𑆂𑇅 𑆃𑆰𑇀𑆛𑆿 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆧𑆝𑆴𑆯𑆾 𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮𑆂, 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑇀𑆰𑆳𑆫𑆳𑆮𑇀𑆪𑆑𑇀𑆠𑆳𑆂𑇅 𑆃𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆫𑆱𑆳 𑆅𑆠𑆴 𑆑𑆳𑆕𑇀𑆑𑆳𑆪𑆤𑆾 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆨𑆴𑆰𑆑𑇀, 𑆄𑆯𑇀𑆫𑆪𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆱𑆁𑆱𑇀𑆮𑆳𑆢𑆮𑆴𑆯𑆼𑆰𑆳𑆟𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇘𑇆
𑆰𑆝𑆼𑆮 𑆫𑆱𑆳 𑆅𑆠𑇀𑆪𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂, 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆰𑆟𑇀𑆟𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆪𑆾𑆤𑆴𑆫𑆶𑆢𑆑𑆁, 𑆗𑆼𑆢𑆤𑆾𑆥𑆯𑆩𑆤𑆼 𑆢𑇀𑆮𑆼 𑆑𑆫𑇀𑆩𑆟𑆵, 𑆠𑆪𑆾𑆫𑇀𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆳𑆠𑇀 𑆱𑆳𑆣𑆳𑆫𑆟𑆠𑇀𑆮𑆁, 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆳 𑆨𑆑𑇀𑆠𑆴𑆂 , 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆿 𑆥𑇀𑆫𑆨𑆳𑆮𑆿, 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆳𑆯𑇀𑆫𑆪𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑆴𑆖𑆳𑆫𑆢𑆼𑆯𑆑𑆳𑆬𑆮𑆯𑆳𑆂, 𑆠𑆼𑆰𑇀𑆮𑆳𑆯𑇀𑆫𑆪𑆼𑆰𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆼𑆰𑆶 𑆓𑆶𑆟𑆳 𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆳𑆢𑇀𑆪𑆳𑆂; 𑆑𑇀𑆰𑆫𑆟𑆳𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆂, 𑆤𑆳𑆱𑆿 𑆫𑆱𑆂 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆠𑆢𑆤𑆼𑆑𑆫𑆱𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆩𑆤𑆼𑆑𑆫𑆱𑆁 𑆑𑆛𑆶𑆑𑆬𑆮𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆤𑆼𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆁 𑆑𑆫𑆟𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆩𑇀; 𑆃𑆮𑇀𑆪𑆑𑇀𑆠𑆵𑆨𑆳𑆮𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆫𑆱𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆿 𑆨𑆮𑆠𑇀𑆪𑆤𑆶𑆫𑆱𑆼𑇁𑆤𑆶𑆫𑆱𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆼 𑆮𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆼; 𑆃𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆁 𑆥𑆶𑆤𑆱𑇀𑆠𑆼𑆰𑆳𑆩𑆳𑆯𑇀𑆫𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆪𑆶𑆑𑇀𑆠𑆩𑇀, 𑆍𑆑𑆽𑆑𑆾𑇁𑆥𑆴 𑆲𑇀𑆪𑆼𑆰𑆳𑆩𑆳𑆯𑇀𑆫𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆳𑆯𑇀𑆫𑆪𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆳𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀, 𑆤 𑆖 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆮𑆩𑆶𑆥𑆥𑆢𑇀𑆪𑆠𑆼; 𑆥𑆫𑆱𑇀𑆥𑆫𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆖𑆽𑆰𑆳𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑆫𑇀𑆓𑆶𑆟𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆤𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆩𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆤𑇀𑆠𑆂𑇅 𑆠𑆖𑇀𑆖𑆽𑆮 𑆑𑆳𑆫𑆟𑆩𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆳𑆂 𑆰𑆟𑇀𑆟𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆥𑆫𑆱𑇀𑆥𑆫𑆼𑆟𑆳𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇙𑇆
𑆃𑆓𑇀𑆫𑆼 𑆠𑆶 𑆠𑆳𑆮𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆼𑆢𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆨𑆴𑆣𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆱𑆫𑇀𑆮𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆩𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆫𑇀𑆡𑆼 ; 𑆠𑆖𑇀𑆖𑆼𑆠𑆤𑆳𑆮𑆢𑆖𑆼𑆠𑆤𑆁 𑆖, 𑆠𑆱𑇀𑆪 𑆓𑆶𑆟𑆳𑆂 𑆯𑆧𑇀𑆢𑆳𑆢𑆪𑆾 𑆓𑆶𑆫𑇀𑆮𑆳𑆢𑆪𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑆠𑆳𑆂, 𑆑𑆫𑇀𑆩 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆩𑆶𑆑𑇀𑆠𑆁 𑆮𑆩𑆤𑆳𑆢𑆴𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆓𑆶𑆫𑆶𑆒𑆫𑆑𑆜𑆴𑆤𑆩𑆤𑇀𑆢𑆱𑇀𑆡𑆴𑆫𑆮𑆴𑆯𑆢𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆱𑇀𑆡𑆷𑆬𑆓𑆤𑇀𑆣𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑆴 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆳𑆤𑆴 , 𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆖𑆪𑆱𑆕𑇀𑆔𑆳𑆠𑆓𑆿𑆫𑆮𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆳𑆟𑆴; 𑆢𑇀𑆫𑆮𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆩𑆤𑇀𑆢𑆩𑆸𑆢𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆫𑆱𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑇀𑆪𑆳𑆥𑇀𑆪𑆳𑆤𑆴, 𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆑𑇀𑆬𑆼𑆢𑆱𑇀𑆤𑆼𑆲𑆧𑆤𑇀𑆣𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆩𑆳𑆫𑇀𑆢𑆮𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆑𑆫𑆳𑆟𑆴; 𑆇𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆬𑆔𑆶𑆫𑆷𑆑𑇀𑆰𑆮𑆴𑆯𑆢𑆫𑆷𑆥𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑇀𑆪𑆳𑆓𑇀𑆤𑆼𑆪𑆳𑆤𑆴, 𑆠𑆳𑆤𑆴 𑆢𑆳𑆲𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆥𑇀𑆫𑆑𑆳𑆯𑆮𑆫𑇀𑆟𑆑𑆫𑆳𑆟𑆴; 𑆬𑆔𑆶𑆯𑆵𑆠𑆫𑆷𑆑𑇀𑆰𑆒𑆫𑆮𑆴𑆯𑆢𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆥𑆫𑇀𑆯𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑆴 𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆤𑆴, 𑆠𑆳𑆤𑆴 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆓𑇀𑆬𑆳𑆤𑆴𑆮𑆴𑆖𑆳𑆫𑆮𑆽𑆯𑆢𑇀𑆪𑆬𑆳𑆔𑆮𑆑𑆫𑆳𑆟𑆴; 𑆩𑆸𑆢𑆶𑆬𑆔𑆶𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆯𑆧𑇀𑆢𑆓𑆶𑆟𑆧𑆲𑆶𑆬𑆳𑆤𑇀𑆪𑆳𑆑𑆳𑆯𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑆴, 𑆠𑆳𑆤𑆴 𑆩𑆳𑆫𑇀𑆢𑆮𑆱𑆿𑆰𑆴𑆫𑇀𑆪𑆬𑆳𑆔𑆮𑆑𑆫𑆳𑆟𑆴𑇆𑇑𑇑𑇆
𑆃𑆤𑆼𑆤𑆾𑆥𑆢𑆼𑆯𑆼𑆤 𑆤𑆳𑆤𑆿𑆰𑆣𑆴𑆨𑆷𑆠𑆁 𑆘𑆓𑆠𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼 𑆠𑆳𑆁 𑆠𑆳𑆁 𑆪𑆶𑆑𑇀𑆠𑆴𑆩𑆫𑇀𑆡𑆁 𑆖 𑆠𑆁 𑆠𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪𑇆𑇑𑇒𑇆
𑆤 𑆠𑆶 𑆑𑆼𑆮𑆬𑆁 𑆓𑆶𑆟𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆢𑆼𑆮 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆑𑆳𑆫𑇀𑆩𑆶𑆑𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆲𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆢𑇀𑆓𑆶𑆟𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆟𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆖𑇀𑆖 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼 𑆠𑆠𑇀𑆠𑆢𑆣𑆴𑆑𑆫𑆟𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆠𑆳𑆁 𑆠𑆳𑆁 𑆖 𑆪𑆶𑆑𑇀𑆠𑆴𑆩𑆫𑇀𑆡𑆁 𑆖 𑆠𑆁 𑆠𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆪𑆠𑇀 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆠𑆠𑇀 𑆑𑆫𑇀𑆩; 𑆪𑆼𑆤 𑆑𑆶𑆫𑇀𑆮𑆴𑆤𑇀𑆠𑆴, 𑆠𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆁; 𑆪𑆠𑇀𑆫 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆠𑆢𑆣𑆴𑆑𑆫𑆟𑆁; 𑆪𑆢𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆱 𑆑𑆳𑆬𑆂; 𑆪𑆡𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆱 𑆇𑆥𑆳𑆪𑆂; 𑆪𑆠𑇀 𑆱𑆳𑆣𑆪𑆤𑇀𑆠𑆴, 𑆠𑆠𑇀 𑆦𑆬𑆩𑇀𑇆𑇑𑇓𑇆
𑆨𑆼𑆢𑆯𑇀𑆖𑆽𑆰𑆳𑆁 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆢𑆼𑆯𑆑𑆳𑆬𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆢𑇀𑆨𑆮𑆠𑆴, 𑆠𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇔𑇆
𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑆩𑇀𑆬𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆪𑆾𑆓𑆁 𑆯𑆼𑆰𑆽𑆫𑆩𑇀𑆬𑆳𑆢𑆪𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆪𑆳𑆤𑇀𑆠𑆴 𑆥𑆚𑇀𑆖𑆢𑆯𑆽𑆠𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑇀𑆮𑆴𑆫𑆱𑆳𑆤𑆴 𑆠𑆶𑇆𑇑𑇕𑇆
𑆥𑆸𑆡𑆓𑆩𑇀𑆬𑆳𑆢𑆴𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆪𑆾𑆓𑆂 𑆯𑆼𑆰𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆨𑆮𑆼𑆠𑇀𑇅 𑆩𑆣𑆶𑆫𑆱𑇀𑆪 𑆠𑆡𑆳𑇁𑆩𑇀𑆬𑆱𑇀𑆪 𑆬𑆮𑆟𑆱𑇀𑆪 𑆑𑆛𑆾𑆱𑇀𑆠𑆡𑆳𑇆𑇑𑇖𑇆
𑆠𑇀𑆫𑆴𑆫𑆱𑆳𑆤𑆴 𑆪𑆡𑆳𑆱𑆕𑇀𑆒𑇀𑆪𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆴𑆁𑆯𑆠𑆴𑆂𑇅𑇑𑇗𑇅 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆶 𑆖𑆠𑆶𑆰𑇀𑆑𑆼𑆟 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑆯 𑆥𑆚𑇀𑆖 𑆖𑇆𑇑𑇗𑇆
𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆿 𑆱𑆲𑆴𑆠𑆿 𑆪𑆾𑆓𑆁 𑆬𑆮𑆟𑆳𑆢𑇀𑆪𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆓𑆠𑆿𑇅 𑆪𑆾𑆓𑆁 𑆯𑆼𑆰𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆪𑆳𑆠𑆯𑇀𑆖𑆠𑆶𑆰𑇀𑆑𑆫𑆱𑆱𑆕𑇀𑆒𑇀𑆪𑆪𑆳𑇆𑇑𑇘𑇆
𑆱𑆲𑆴𑆠𑆿 𑆱𑇀𑆮𑆳𑆢𑆶𑆬𑆮𑆟𑆿 𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑆛𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆪𑆶𑆑𑇀𑆠𑆿 𑆯𑆼𑆰𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆪𑆾𑆓𑆁 𑆪𑆳𑆠𑆂 𑆱𑇀𑆮𑆳𑆢𑆷𑆰𑆟𑆿 𑆠𑆡𑆳𑇆𑇑𑇙𑇆
𑆑𑆛𑇀𑆮𑆳𑆢𑇀𑆪𑆽𑆫𑆩𑇀𑆬𑆬𑆮𑆟𑆿 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆿 𑆱𑆲𑆴𑆠𑆿 𑆥𑆸𑆡𑆑𑇀𑇅 𑆪𑆳𑆠𑆂 𑆯𑆼𑆰𑆽𑆂 𑆥𑆸𑆡𑆓𑇀𑆪𑆾𑆓𑆁 𑆯𑆼𑆰𑆽𑆫𑆩𑇀𑆬𑆑𑆛𑆷 𑆠𑆡𑆳𑇆𑇒𑇐𑇆
𑆪𑆶𑆘𑇀𑆪𑆠𑆼 𑆠𑆶 𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆠𑆴𑆑𑇀𑆠𑆿 𑆬𑆮𑆟𑆾𑆰𑆟𑆿𑇅𑇒𑇑𑇅 𑆰𑆛𑇀 𑆠𑆶 𑆥𑆚𑇀𑆖𑆫𑆱𑆳𑆤𑇀𑆪𑆳𑆲𑆶𑆫𑆼𑆑𑆽𑆑𑆱𑇀𑆪𑆳𑆥𑆮𑆫𑇀𑆘𑆤𑆳𑆠𑇀𑇆𑇒𑇑𑇆
𑆰𑆛𑇀 𑆖𑆽𑆮𑆽𑆑𑆫𑆱𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆫𑆼𑆑𑆁 𑆰𑆝𑇀𑆫𑆱𑆩𑆼𑆮 𑆠𑆶𑇅𑇒𑇒𑇅 𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆫𑆱𑆱𑆕𑇀𑆒𑇀𑆪𑆪𑆳𑇆𑇒𑇒𑇆
𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆮𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆫𑆱𑆳𑆤𑆶𑆫𑆱𑆑𑆬𑇀𑆥𑆤𑆳𑆠𑇀 𑇅 𑆫𑆱𑆳𑆱𑇀𑆠𑆫𑆠𑆩𑆳𑆨𑇀𑆪𑆳𑆁 𑆠𑆳𑆁 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆩𑆠𑆴𑆥𑆠𑆤𑇀𑆠𑆴 𑆲𑆴𑇆𑇒𑇓𑇆
𑆱𑆁𑆪𑆾𑆓𑆳𑆂 𑆱𑆥𑇀𑆠𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀 𑆑𑆬𑇀𑆥𑆤𑆳 𑆠𑆶 𑆠𑇀𑆫𑆴𑆰𑆰𑇀𑆛𑆴𑆣𑆳𑇅 𑆫𑆱𑆳𑆤𑆳𑆁 𑆠𑆠𑇀𑆫 𑆪𑆾𑆓𑇀𑆪𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑆬𑇀𑆥𑆴𑆠𑆳 𑆫𑆱𑆖𑆴𑆤𑇀𑆠𑆑𑆽𑆂𑇆𑇒𑇔𑇆
𑆑𑇀𑆮𑆖𑆴𑆢𑆼𑆑𑆾 𑆫𑆱𑆂 𑆑𑆬𑇀𑆥𑇀𑆪𑆂 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆳𑆯𑇀𑆖 𑆫𑆱𑆳𑆂 𑆑𑇀𑆮𑆖𑆴𑆠𑇀𑇅 𑆢𑆾𑆰𑆿𑆰𑆣𑆳𑆢𑆵𑆤𑇀 𑆱𑆚𑇀𑆖𑆴𑆤𑇀𑆠𑇀𑆪 𑆨𑆴𑆰𑆘𑆳 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆴𑆖𑇀𑆗𑆠𑆳𑇆𑇒𑇕𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑇀𑆮𑆴𑆫𑆱𑆳𑆢𑆵𑆤𑆴 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆫𑆱𑆳𑆤𑇀 𑆧𑆶𑆣𑆳𑆂𑇅 𑆫𑆱𑆳𑆤𑆼𑆑𑆽𑆑𑆯𑆾 𑆮𑆳𑇁𑆥𑆴 𑆑𑆬𑇀𑆥𑆪𑆤𑇀𑆠𑆴 𑆓𑆢𑆳𑆤𑇀 𑆥𑇀𑆫𑆠𑆴𑇆𑇒𑇖𑇆
𑆪𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆫𑆱𑆮𑆴𑆑𑆬𑇀𑆥𑆘𑇀𑆚𑆂 𑆱𑇀𑆪𑆳𑆖𑇀𑆖 𑆢𑆾𑆰𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆠𑇀𑇅 𑆤 𑆱 𑆩𑆶𑆲𑇀𑆪𑆼𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆴𑆰𑆶 𑇆𑇒𑇗𑇆
𑆮𑇀𑆪𑆑𑇀𑆠𑆂 𑆯𑆶𑆰𑇀𑆑𑆱𑇀𑆪 𑆖𑆳𑆢𑆿 𑆖 𑆫𑆱𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟𑆳𑆤𑆶𑆫𑆱𑆾 𑆫𑆱𑆾 𑆤𑆳𑆱𑇀𑆠𑆴 𑆲𑆴 𑆱𑆥𑇀𑆠𑆩𑆂𑇆𑇒𑇘𑇆
𑆥𑆫𑆳𑆥𑆫𑆠𑇀𑆮𑆼 𑆪𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆖 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆱𑆁𑆪𑆾𑆓 𑆍𑆮 𑆖𑇅 𑆮𑆴𑆨𑆳𑆓𑆯𑇀𑆖 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆁 𑆖 𑆥𑆫𑆴𑆩𑆳𑆟𑆩𑆡𑆳𑆥𑆴 𑆖𑇆𑇒𑇙𑇆
𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆾𑇁𑆨𑇀𑆪𑆳𑆱 𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆓𑆶𑆟𑆳 𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆥𑆫𑆳𑆢𑆪𑆂𑇅 𑆱𑆴𑆢𑇀𑆣𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆪𑆳 𑆬𑆑𑇀𑆰𑆟𑆽𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼𑇆𑇓𑇐𑇆
𑆢𑆼𑆯𑆑𑆳𑆬𑆮𑆪𑆾𑆩𑆳𑆤𑆥𑆳𑆑𑆮𑆵𑆫𑇀𑆪𑆫𑆱𑆳𑆢𑆴𑆰𑆶𑇅 𑆥𑆫𑆳𑆥𑆫𑆠𑇀𑆮𑆼, 𑆪𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆖 𑆪𑆾𑆘𑆤𑆳 𑆪𑆳 𑆠𑆶 𑆪𑆶𑆘𑇀𑆪𑆠𑆼𑇆𑇓𑇑𑇆
𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆱𑇀𑆪𑆳𑆢𑇀𑆓𑆟𑆴𑆠𑆁, 𑆪𑆾𑆓𑆂 𑆱𑆲 𑆱𑆁𑆪𑆾𑆓 𑆇𑆖𑇀𑆪𑆠𑆼𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆱𑆫𑇀𑆮𑆽𑆑𑆑𑆫𑇀𑆩𑆘𑆾𑇁𑆤𑆴𑆠𑇀𑆪 𑆍𑆮 𑆖𑇆𑇓𑇒𑇆
𑆮𑆴𑆨𑆳𑆓𑆱𑇀𑆠𑆶 𑆮𑆴𑆨𑆑𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆪𑆾𑆓𑆾 𑆨𑆳𑆓𑆯𑆾 𑆓𑇀𑆫𑆲𑆂𑇅 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆁 𑆱𑇀𑆪𑆳𑆢𑆱𑆁𑆪𑆾𑆓𑆾 𑆮𑆽𑆬𑆑𑇀𑆰𑆟𑇀𑆪𑆩𑆤𑆼𑆑𑆠𑆳𑇆𑇓𑇓𑇆
𑆥𑆫𑆴𑆩𑆳𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆳𑆤𑆁, 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆂 𑆑𑆫𑆟𑆁 𑆩𑆠𑆩𑇀𑇅 𑆨𑆳𑆮𑆳𑆨𑇀𑆪𑆱𑆤𑆩𑆨𑇀𑆪𑆳𑆱𑆂 𑆯𑆵𑆬𑆤𑆁 𑆱𑆠𑆠𑆑𑇀𑆫𑆴𑆪𑆳𑇆𑇓𑇔𑇆
𑆅𑆠𑆴 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑆶𑆑𑇀𑆠𑆳 𑆓𑆶𑆟𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆥𑆫𑆳𑆢𑆪𑆂𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆪𑆽𑆫𑆮𑆴𑆢𑆴𑆠𑆽𑆫𑇀𑆤 𑆪𑆡𑆳𑆮𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇓𑇕𑇆
𑆓𑆶𑆟𑆳 𑆓𑆶𑆟𑆳𑆯𑇀𑆫𑆪𑆳 𑆤𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆱𑆓𑆶𑆟𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀𑇅 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆟𑆳𑆤𑇀 𑆑𑆫𑇀𑆠𑆶𑆫𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆳𑆂 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆂𑇆𑇓𑇖𑇆
𑆃𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆸𑆠𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆖𑇅 𑆠𑆤𑇀𑆠𑇀𑆫𑆑𑆫𑇀𑆠𑆶𑆫𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆳𑆤𑆶𑆥𑆳𑆪𑆳𑆁𑆯𑇀𑆖𑆳𑆫𑇀𑆡𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇓𑇗𑇆
𑆰𑆝𑇀𑆮𑆴𑆨𑆑𑇀𑆠𑆵𑆂 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆫𑆱𑆳𑆤𑆳𑆩𑆠 𑆇𑆠𑇀𑆠𑆫𑆩𑇀𑇅 𑆰𑆛𑇀 𑆥𑆚𑇀𑆖𑆨𑆷𑆠𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆯𑇀𑆖 𑆪𑆡𑆳 𑆫𑆱𑆳𑆂𑇆𑇓𑇘𑇆
𑆱𑆿𑆩𑇀𑆪𑆳𑆂 𑆒𑆬𑇀𑆮𑆳𑆥𑆾𑇁𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆥𑇀𑆫𑆨𑆮𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑆵𑆠𑆳 𑆬𑆔𑇀𑆮𑇀𑆪𑆯𑇀𑆖𑆳𑆮𑇀𑆪𑆑𑇀𑆠𑆫𑆱𑆳𑆯𑇀𑆖, 𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆳𑆢𑇀𑆨𑇀𑆫𑆯𑇀𑆪𑆩𑆳𑆤𑆳 𑆨𑇀𑆫𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆓𑆶𑆟𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆳 𑆘𑆕𑇀𑆓𑆩𑆱𑇀𑆡𑆳𑆮𑆫𑆳𑆟𑆳𑆁 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆩𑆷𑆫𑇀𑆠𑆵𑆫𑆨𑆴𑆥𑇀𑆫𑆵𑆟𑆪𑆤𑇀𑆠𑆴, 𑆠𑆳𑆱𑆶 𑆩𑆷𑆫𑇀𑆠𑆴𑆰𑆶 𑆰𑆝𑆨𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆫𑆱𑆳𑆂𑇆𑇓𑇙𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆵𑆠𑆁 𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆪𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆩𑆣𑆶𑆫𑆁 𑆫𑆱𑆥𑆳𑆑𑆪𑆾𑆂𑇅 𑆠𑆪𑆾𑆫𑆩𑇀𑆬𑆁 𑆪𑆢𑆶𑆰𑇀𑆟𑆁 𑆖 𑆪𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆑𑆛𑆶𑆑𑆁 𑆠𑆪𑆾𑆂𑇆𑇔𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆫𑆱𑆾𑆥𑆢𑆼𑆯𑆼𑆤 𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑇀𑆪𑆾 𑆓𑆶𑆟𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆮𑆵𑆫𑇀𑆪𑆠𑆾𑇁𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆳𑆁 𑆥𑆳𑆑𑆠𑆯𑇀𑆖𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇔𑇖𑇆
𑆪𑆡𑆳 𑆥𑆪𑆾 𑆪𑆡𑆳 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆪𑆡𑆳 𑆮𑆳 𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆿𑇅 𑆍𑆮𑆩𑆳𑆢𑆵𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆢𑇀𑆫𑆱𑆠𑆾 𑆨𑆴𑆰𑆑𑇀𑇆𑇔𑇗𑇆
𑆩𑆣𑆶𑆫𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆶𑆰𑇀𑆟𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆩𑆼𑆮 𑆖𑇅 𑆪𑆡𑆳 𑆩𑆲𑆠𑇀𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆁 𑆪𑆡𑆳𑇁𑆧𑇀𑆘𑆳𑆤𑆷𑆥𑆩𑆳𑆩𑆴𑆰𑆩𑇀𑇆𑇔𑇘𑇆
𑆬𑆮𑆟𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆤𑆾𑆰𑇀𑆟𑆩𑆩𑇀𑆬𑆩𑆳𑆩𑆬𑆑𑆁 𑆠𑆡𑆳𑇅 𑆃𑆫𑇀𑆑𑆳𑆓𑆶𑆫𑆶𑆓𑆶𑆝𑆷𑆖𑆵𑆤𑆳𑆁 𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆶𑆰𑇀𑆟𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇙𑇆
𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆩𑇀𑆬𑆁 𑆲𑆴 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆩𑇀𑆬𑆁 𑆨𑆴𑆤𑆠𑇀𑆠𑆴 𑆖𑇅 𑆪𑆡𑆳 𑆑𑆥𑆴𑆠𑇀𑆡𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆨𑆼𑆢𑆴 𑆖𑆳𑆩𑆬𑆑𑆁 𑆠𑆡𑆳𑇆𑇕𑇐𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆤𑆳𑆓𑆫𑆁 𑆮𑆸𑆰𑇀𑆪𑆁 𑆑𑆛𑆶 𑆖𑆳𑆮𑆸𑆰𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆑𑆰𑆳𑆪𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆂 𑆯𑆵𑆠𑆂 𑆱𑆾𑇁𑆨𑆪𑆳𑆪𑆳𑆩𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇆𑇕𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆱𑆾𑆥𑆢𑆼𑆯𑆼𑆤 𑆤 𑆱𑆫𑇀𑆮𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇅 𑆢𑆸𑆰𑇀𑆛𑆁 𑆠𑆶𑆬𑇀𑆪𑆫𑆱𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆼 𑆓𑆶𑆟𑆳𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇕𑇒𑇆
𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪𑆾 𑆫𑆷𑆑𑇀𑆰𑆳𑆟𑆳𑆩𑆶𑆠𑇀𑆠𑆩𑆾 𑆩𑆣𑇀𑆪𑆩𑆂 𑆑𑆛𑆶𑆂𑇅 𑆠𑆴𑆑𑇀𑆠𑆾𑇁𑆮𑆫𑆱𑇀𑆠𑆡𑆾𑆰𑇀𑆟𑆳𑆤𑆳𑆩𑆶𑆰𑇀𑆟𑆠𑇀𑆮𑆳𑆬𑇀𑆬𑆮𑆟𑆂 𑆥𑆫𑆂𑇆𑇕𑇓𑇆
𑆩𑆣𑇀𑆪𑆾𑇁𑆩𑇀𑆬𑆂 𑆑𑆛𑆶𑆑𑆯𑇀𑆖𑆳𑆤𑇀𑆠𑇀𑆪𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑆳𑆁 𑆩𑆣𑆶𑆫𑆂 𑆥𑆫𑆂𑇅 𑆩𑆣𑇀𑆪𑆾𑇁𑆩𑇀𑆬𑆾 𑆬𑆮𑆟𑆯𑇀𑆖𑆳𑆤𑇀𑆠𑇀𑆪𑆾 𑆫𑆱𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇕𑇔𑇆
𑆩𑆣𑇀𑆪𑆾𑆠𑇀𑆑𑆸𑆰𑇀𑆛𑆳𑆮𑆫𑆳𑆂 𑆯𑆽𑆠𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆂 𑇅 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆢𑆣𑆴𑆑𑆂 𑆑𑆰𑆳𑆪𑆳𑆬𑇀𑆬𑆮𑆟𑆾𑇁𑆮𑆫𑆂𑇆𑇕𑇕𑇆
𑆃𑆩𑇀𑆬𑆳𑆠𑇀 𑆑𑆛𑆶𑆱𑇀𑆠𑆠𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆾 𑆬𑆔𑆶𑆠𑇀𑆮𑆳𑆢𑆶𑆠𑇀𑆠𑆩𑆾𑆠𑇀𑆠𑆩𑆂𑇅 𑆑𑆼𑆖𑆴𑆬𑇀𑆬𑆔𑆷𑆤𑆳𑆩𑆮𑆫𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆬𑆮𑆟𑆁 𑆫𑆱𑆩𑇀𑇆𑇕𑇖𑇆
𑆓𑆿𑆫𑆮𑆼 𑆬𑆳𑆔𑆮𑆼 𑆖𑆽𑆮 𑆱𑆾𑇁𑆮𑆫𑆱𑇀𑆠𑆷𑆨𑆪𑆾𑆫𑆥𑆴𑇅𑇕𑇗𑇅 𑆥𑆫𑆁 𑆖𑆳𑆠𑆾 𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇕𑇗𑇆
𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆮𑆴𑆥𑆳𑆑𑆂 𑆥𑇀𑆫𑆳𑆪𑆯𑆂 𑆑𑆛𑆶𑆂𑇅 𑆃𑆩𑇀𑆬𑆾𑇁𑆩𑇀𑆬𑆁 𑆥𑆖𑇀𑆪𑆠𑆼 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆩𑆣𑆶𑆫𑆁 𑆬𑆮𑆟𑆱𑇀𑆠𑆡𑆳𑇆𑇕𑇘𑇆
𑆩𑆣𑆶𑆫𑆾 𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆿 𑆖 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆨𑆳𑆮𑆳𑆠𑇀𑆠𑇀𑆫𑆪𑆾 𑆫𑆱𑆳𑆂𑇅 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆪𑆾 𑆩𑆾𑆑𑇀𑆰𑆼 𑆱𑆶𑆒𑆳 𑆩𑆠𑆳𑆂𑇆𑇕𑇙𑇆
𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑆶 𑆫𑆷𑆑𑇀𑆰𑆨𑆳𑆮𑆳𑆠𑇀𑆠𑇀𑆫𑆪𑆾 𑆫𑆱𑆳𑆂𑇅 𑆢𑆶𑆂𑆒𑆳𑆪 𑆩𑆾𑆑𑇀𑆰𑆼 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆳𑆠𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆫𑆼𑆠𑆱𑆳𑆩𑇀𑇆𑇖𑇐𑇆
𑆯𑆶𑆑𑇀𑆫𑆲𑆳 𑆧𑆢𑇀𑆣𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆾 𑆮𑆴𑆥𑆳𑆑𑆾 𑆮𑆳𑆠𑆬𑆂 𑆑𑆛𑆶𑆂𑇅 𑆩𑆣𑆶𑆫𑆂 𑆱𑆸𑆰𑇀𑆛𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆾 𑆮𑆴𑆥𑆳𑆑𑆂 𑆑𑆦𑆯𑆶𑆑𑇀𑆫𑆬𑆂𑇆𑇖𑇑𑇆
𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑇀 𑆱𑆸𑆰𑇀𑆛𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆂 𑆥𑆳𑆑𑆾𑇁𑆩𑇀𑆬𑆂 𑆯𑆶𑆑𑇀𑆫𑆤𑆳𑆯𑆤𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆩𑆣𑆶𑆫𑆂 𑆑𑆛𑆶𑆑𑆳𑆩𑇀𑆬𑆳𑆮𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇆𑇖𑇒𑇆
𑆮𑆴𑆥𑆳𑆑𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆪𑆳𑆬𑇀𑆥𑆩𑆣𑇀𑆪𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆠𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆶𑆟𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫𑆾𑆥𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇖𑇓𑇆
𑆩𑆸𑆢𑆶𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆯𑆵𑆠𑆬𑆩𑇀𑇅 𑆮𑆵𑆫𑇀𑆪𑆩𑆰𑇀𑆛𑆮𑆴𑆣𑆁 𑆑𑆼𑆖𑆴𑆠𑇀, 𑆑𑆼𑆖𑆴𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆱𑇀𑆡𑆴𑆠𑆳𑆂𑇆𑇖𑇔𑇆
𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆩𑆴𑆠𑆴, 𑆮𑆵𑆫𑇀𑆪𑆁 𑆠𑆶 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆪𑆼𑆤 𑆪𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆤𑆳𑆮𑆵𑆫𑇀𑆪𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑆫𑇀𑆮𑆳 𑆮𑆵𑆫𑇀𑆪𑆑𑆸𑆠𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑇆𑇖𑇕𑇆
𑆫𑆱𑆾 𑆤𑆴𑆥𑆳𑆠𑆼 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁, 𑆮𑆴𑆥𑆳𑆑𑆂 𑆑𑆫𑇀𑆩𑆤𑆴𑆰𑇀𑆜𑆪𑆳𑇅 𑆮𑆵𑆫𑇀𑆪𑆁 𑆪𑆳𑆮𑆢𑆣𑆵𑆮𑆳𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆖𑇀𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇆𑇖𑇖𑇆
𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆪𑆠𑇀𑆫 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆮𑆴𑆯𑆼𑆰𑆂 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆖𑆽𑆮 𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆠𑆱𑇀𑆪 𑆱 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇖𑇗𑇆
𑆑𑆛𑆶𑆑𑆂 𑆑𑆛𑆶𑆑𑆂 𑆥𑆳𑆑𑆼 𑆮𑆵𑆫𑇀𑆪𑆾𑆰𑇀𑆟𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆾 𑆩𑆠𑆂𑇅 𑆠𑆢𑇀𑆮𑆢𑇀𑆢𑆤𑇀𑆠𑆵 𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆠𑇀𑆠𑆶 𑆮𑆴𑆫𑆼𑆖𑆪𑆠𑆴 𑆩𑆳𑆤𑆮𑆩𑇀 𑇆𑇖𑇘𑇆
𑆮𑆴𑆰𑆁 𑆮𑆴𑆰𑆔𑇀𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆪𑆠𑇀 𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆠𑆠𑇀𑆫 𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆳𑆤𑆶𑆬𑆾𑆩𑆴𑆑𑆁 𑆪𑆖𑇀𑆖 𑆠𑆠𑇀 𑆥𑇀𑆫𑆨𑆳𑆮𑆥𑇀𑆫𑆨𑆳𑆮𑆴𑆠𑆩𑇀𑇆𑇖𑇙𑇆
𑆩𑆟𑆵𑆤𑆳𑆁 𑆣𑆳𑆫𑆟𑆵𑆪𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆩 𑆪𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆠𑇀𑆩𑆑𑆩𑇀𑇅 𑆠𑆠𑇀 𑆥𑇀𑆫𑆨𑆳𑆮𑆑𑆸𑆠𑆁 𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆨𑆳𑆮𑆾𑇁𑆖𑆴𑆤𑇀𑆠𑇀𑆪 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇗𑇐𑇆
𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆥𑆳𑆑𑆮𑆵𑆫𑇀𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆨𑆳𑆮𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆢𑆳𑆲𑆸𑆠𑆂𑇅 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆫𑆱𑆼𑆤 𑆑𑆶𑆫𑆶𑆠𑆼 𑆑𑆫𑇀𑆩 𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆖𑆳𑆥𑆫𑆩𑇀𑇆𑇗𑇑𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆁 𑆓𑆶𑆟𑆼𑆤 𑆥𑆳𑆑𑆼𑆤 𑆥𑇀𑆫𑆨𑆳𑆮𑆼𑆟 𑆖 𑆑𑆴𑆚𑇀𑆖𑆤𑇅 𑆫𑆱𑆁 𑆮𑆴𑆥𑆳𑆑𑆱𑇀𑆠𑆿 𑆮𑆵𑆫𑇀𑆪𑆁 𑆥𑇀𑆫𑆨𑆳𑆮𑆱𑇀𑆠𑆳𑆤𑆥𑆾𑆲𑆠𑆴𑇆𑇗𑇒𑇆
𑆧𑆬𑆱𑆳𑆩𑇀𑆪𑆼 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆩𑆴𑆠𑆴 𑆤𑆽𑆱𑆫𑇀𑆓𑆴𑆑𑆁 𑆧𑆬𑆩𑇀𑇅𑇗𑇓𑇅 𑆰𑆟𑇀𑆟𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑇀𑆪𑆠𑆂 𑆥𑆫𑆩𑇀𑇆𑇗𑇓𑇆
𑆱𑇀𑆤𑆼𑆲𑆤𑆥𑇀𑆫𑆵𑆟𑆤𑆳𑆲𑇀𑆬𑆳𑆢𑆩𑆳𑆫𑇀𑆢𑆮𑆽𑆫𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇅 𑆩𑆶𑆒𑆱𑇀𑆡𑆾 𑆩𑆣𑆶𑆫𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆁 𑆮𑇀𑆪𑆳𑆥𑇀𑆤𑆶𑆮𑆀𑆬𑇀𑆬𑆴𑆩𑇀𑆥𑆠𑆵𑆮 𑆖𑇆𑇗𑇔𑇆
𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆳𑆤𑇀𑆩𑆶𑆒𑆳𑆱𑇀𑆫𑆳𑆮𑆳𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆤𑆳𑆤𑇀𑆩𑆶𑆒𑆧𑆾𑆣𑆤𑆳𑆠𑇀𑇅 𑆮𑆴𑆢𑆳𑆲𑆳𑆖𑇀𑆖𑆳𑆱𑇀𑆪𑆑𑆟𑇀𑆜𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆯𑇀𑆪𑆽𑆮𑆳𑆩𑇀𑆬𑆁 𑆫𑆱𑆁 𑆮𑆢𑆼𑆠𑇀𑇆𑇗𑇕𑇆
𑆥𑇀𑆫𑆬𑆵𑆪𑆤𑇀 𑆑𑇀𑆬𑆼𑆢𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆩𑆶𑆒𑆼𑇅 𑆪𑆂 𑆯𑆵𑆔𑇀𑆫𑆁 𑆬𑆮𑆟𑆾 𑆘𑇀𑆚𑆼𑆪𑆂 𑆱 𑆮𑆴𑆢𑆳𑆲𑆳𑆤𑇀𑆩𑆶𑆒𑆱𑇀𑆪 𑆖𑇆𑇗𑇖𑇆
𑆱𑆁𑆮𑆼𑆘𑆪𑆼𑆢𑇀𑆪𑆾 𑆫𑆱𑆳𑆤𑆳𑆁 𑆤𑆴𑆥𑆳𑆠𑆼 𑆠𑆶𑆢𑆠𑆵𑆮 𑆖𑇅 𑆮𑆴𑆢𑆲𑆤𑇀𑆩𑆶𑆒𑆤𑆳𑆱𑆳𑆑𑇀𑆰𑆴 𑆱𑆁𑆱𑇀𑆫𑆳𑆮𑆵 𑆱 𑆑𑆛𑆶𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇗𑇗𑇆
𑆥𑇀𑆫𑆠𑆴𑆲𑆤𑇀𑆠𑆴 𑆤𑆴𑆥𑆳𑆠𑆼 𑆪𑆾 𑆫𑆱𑆤𑆁 𑆱𑇀𑆮𑆢𑆠𑆼 𑆤 𑆖𑇅 𑆱 𑆠𑆴𑆑𑇀𑆠𑆾 𑆩𑆶𑆒𑆮𑆽𑆯𑆢𑇀𑆪𑆯𑆾𑆰𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆑𑆳𑆫𑆑𑆂 𑇆𑇗𑇘𑇆
𑆮𑆽𑆯𑆢𑇀𑆪𑆱𑇀𑆠𑆩𑇀𑆨𑆘𑆳𑆝𑇀𑆪𑆽𑆫𑇀𑆪𑆾 𑆫𑆱𑆤𑆁 𑆪𑆾𑆘𑆪𑆼𑆢𑇀𑆫𑆱𑆂𑇅 𑆧𑆣𑇀𑆤𑆳𑆠𑆵𑆮 𑆖 𑆪𑆂 𑆑𑆟𑇀𑆜𑆁 𑆑𑆰𑆳𑆪𑆂 𑆱 𑆮𑆴𑆑𑆳𑆱𑇀𑆪𑆥𑆴𑇆𑇗𑇙𑇆
𑆍𑆮𑆩𑆶𑆑𑇀𑆠𑆮𑆤𑇀𑆠𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆨𑆓𑆮𑆤𑇀! 𑆯𑇀𑆫𑆶𑆠𑆩𑆼𑆠𑆢𑆮𑆴𑆠𑆡𑆩𑆫𑇀𑆡𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆨𑆓𑆮𑆠𑆾 𑆪𑆡𑆳𑆮𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆳𑆣𑆴𑆑𑆳𑆫𑆼 𑆮𑆖𑆂, 𑆥𑆫𑆁 𑆠𑇀𑆮𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆮𑆽𑆫𑆾𑆣𑆴𑆑𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆩𑆤𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆯𑆶𑆯𑇀𑆫𑆷𑆰𑆳𑆩𑆲 𑆅𑆠𑆴𑇆𑇘𑇐𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆢𑆼𑆲𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆨𑆷𑆠𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑆼𑆲𑆣𑆳𑆠𑆶𑆨𑆴𑆫𑇀𑆮𑆴𑆫𑆾𑆣𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼; 𑆥𑆫𑆱𑇀𑆥𑆫𑆓𑆶𑆟𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑆴 𑆑𑆳𑆤𑆴𑆖𑆴𑆠𑇀, 𑆑𑆳𑆤𑆴𑆖𑆴𑆠𑇀 𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀, 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆳𑆢𑆥𑆫𑆳𑆟𑆴, 𑆢𑆼𑆯𑆑𑆳𑆬𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆟𑆴, 𑆠𑆡𑆳 𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆢𑆥𑆫𑆳𑆟𑆴𑇆𑇘𑇑𑇆
𑆠𑆠𑇀𑆫 𑆪𑆳𑆤𑇀𑆪𑆳𑆲𑆳𑆫𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆼𑆰𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆁 𑆮𑆽𑆫𑆾𑆣𑆴𑆑𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆤 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑇀 𑆥𑆪𑆱𑆳 𑆱𑆲𑆳𑆨𑇀𑆪𑆮𑆲𑆫𑆼𑆠𑇀, 𑆇𑆨𑆪𑆁 𑆲𑇀𑆪𑆼𑆠𑆤𑇀𑆩𑆣𑆶𑆫𑆁 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆁 𑆩𑆲𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆮𑆵𑆫𑇀𑆪𑆁 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆮𑆵𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆳𑆪 𑆩𑆲𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆾𑆥𑆫𑆾𑆣𑆳𑆪 𑆖𑇆𑇘𑇒𑇆
𑆠𑆤𑇀𑆤𑆴𑆯𑆩𑇀𑆪𑆳𑆠𑇀𑆫𑆼𑆪𑆮𑆖𑆤𑆩𑆤𑆶 𑆨𑆢𑇀𑆫𑆑𑆳𑆥𑇀𑆪𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆩𑆶𑆮𑆳𑆖- 𑆱𑆫𑇀𑆮𑆳𑆤𑆼𑆮 𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆤𑇀 𑆥𑆪𑆱𑆳 𑆱𑆲𑆳𑆨𑇀𑆪𑆮𑆲𑆫𑆼𑆢𑆤𑇀𑆪𑆠𑇀𑆫𑆽𑆑𑆱𑇀𑆩𑆳𑆖𑇀𑆖𑆴𑆬𑆴𑆖𑆴𑆩𑆳𑆠𑇀, 𑆱 𑆥𑆶𑆤𑆂 𑆯𑆑𑆬𑆵 𑆬𑆾𑆲𑆴𑆠𑆤𑆪𑆤𑆂 𑆱𑆫𑇀𑆮𑆠𑆾 𑆬𑆾𑆲𑆴𑆠𑆫𑆳𑆘𑆵 𑆫𑆾𑆲𑆴𑆠𑆳𑆑𑆳𑆫𑆂 𑆥𑇀𑆫𑆳𑆪𑆾 𑆨𑆷𑆩𑆿 𑆖𑆫𑆠𑆴, 𑆠𑆁 𑆖𑆼𑆠𑇀 𑆥𑆪𑆱𑆳 𑆱𑆲𑆳𑆨𑇀𑆪𑆮𑆲𑆫𑆼𑆤𑇀𑆤𑆴𑆂𑆱𑆁𑆯𑆪𑆁 𑆯𑆾𑆟𑆴𑆠𑆘𑆳𑆤𑆳𑆁 𑆮𑆴𑆧𑆤𑇀𑆣𑆘𑆳𑆤𑆳𑆁 𑆖 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆩𑆡𑆮𑆳 𑆩𑆫𑆟𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇘𑇓𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆪𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑆾𑆰𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆤 𑆤𑆴𑆫𑇀𑆲𑆫𑆠𑆴 𑆑𑆳𑆪𑆠𑆂𑇅 𑆄𑆲𑆳𑆫𑆘𑆳𑆠𑆁 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆲𑆴𑆠𑆳𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇘𑇕𑇆
𑆪𑆖𑇀𑆖𑆳𑆥𑆴 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆓𑇀𑆤𑆴𑆩𑆳𑆠𑇀𑆫𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆤𑆴𑆬𑆳𑆢𑆴𑆨𑆴𑆂𑇅 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆠𑆾 𑆮𑆵𑆫𑇀𑆪𑆠𑆯𑇀𑆖 𑆑𑆾𑆰𑇀𑆜𑆳𑆮𑆱𑇀𑆡𑆳𑆑𑇀𑆫𑆩𑆽𑆫𑆥𑆴𑇆𑇘𑇖𑇆
𑆥𑆫𑆴𑆲𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆳𑆑𑆳𑆠𑇀 𑆱𑆁𑆪𑆾𑆓𑆠𑆾𑇁𑆥𑆴 𑆖𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆖𑇀𑆖 𑆤 𑆲𑆴𑆠𑆁 𑆲𑆸𑆠𑇀𑆱𑆩𑇀𑆥𑆢𑇀𑆮𑆴𑆣𑆴𑆨𑆴𑆯𑇀𑆖 𑆪𑆠𑇀𑇆𑇘𑇗𑇆
𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆢𑆼𑆯𑆠𑆱𑇀𑆠𑆳𑆮𑆢𑇀𑆫𑆷𑆑𑇀𑆰𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆢𑆴 𑆣𑆤𑇀𑆮𑆤𑆴𑇅 𑆄𑆤𑆷𑆥𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆳𑆢𑆴 𑆨𑆼𑆰𑆘𑆁 𑆪𑆤𑇀𑆤𑆴𑆰𑆼𑆮𑇀𑆪𑆠𑆼𑇆𑇘𑇘𑇆
𑆑𑆳𑆬𑆠𑆾𑇁𑆥𑆴 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆪𑆖𑇀𑆗𑆵𑆠𑆫𑆷𑆑𑇀𑆰𑆳𑆢𑆴𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆯𑆵𑆠𑆼 𑆑𑆳𑆬𑆼, 𑆠𑆡𑆾𑆰𑇀𑆟𑆼 𑆖 𑆑𑆛𑆶𑆑𑆾𑆰𑇀𑆟𑆳𑆢𑆴𑆱𑆼𑆮𑆤𑆩𑇀𑇆𑇘𑇙𑇆
𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆤𑆬𑆼 𑆠𑆢𑇀𑆮𑆢𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆼𑇅 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆩𑆣𑆸𑆠𑆁 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆠𑆢𑇀𑆮𑆴𑆫𑆶𑆣𑇀𑆪𑆠𑆼𑇆𑇙𑇐𑇆
𑆑𑆛𑆶𑆑𑆾𑆰𑇀𑆟𑆳𑆢𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆮𑆳𑆢𑆶𑆯𑆵𑆠𑆳𑆢𑆴𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆪𑆠𑇀𑆠𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆶 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑇀𑆮𑆤𑆴𑆬𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇙𑇑𑇆
𑆪𑆳 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆳𑆨𑇀𑆪𑆳𑆱𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑇀𑆤𑆿𑆰𑆣𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆠𑆾 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆢𑇀𑆪𑆢𑇀𑆨𑆾𑆘𑇀𑆪𑆁 𑆮𑆴𑆰𑆮𑆢𑇀𑆨𑆮𑆼𑆠𑇀𑇆𑇙𑇒𑇆
𑆍𑆫𑆟𑇀𑆝𑆱𑆵𑆱𑆑𑆳𑆱𑆑𑇀𑆠𑆁 𑆯𑆴𑆒𑆴𑆩𑆳𑆁𑆱𑆁 𑆪𑆡𑆽𑆮 𑆲𑆴𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆮𑆵𑆫𑇀𑆪𑆠𑆾 𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆵𑆫𑇀𑆪𑆠𑆂 𑆯𑆵𑆠𑆬𑆳𑆠𑇀𑆩𑆑𑆩𑇀𑇆𑇙𑇓𑇆
𑆠𑆠𑇀 𑆱𑆁𑆪𑆾𑆘𑇀𑆪𑆾𑆰𑇀𑆟𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆟 𑆱𑆲 𑆱𑆼𑆮𑇀𑆪𑆠𑆼𑇅 𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆖𑆳𑆠𑇀𑆪𑆬𑇀𑆥𑆁 𑆩𑆤𑇀𑆢𑆮𑆵𑆫𑇀𑆪𑆩𑆨𑆼𑆢𑆤𑆩𑇀𑇆𑇙𑇔𑇆
𑆩𑆸𑆢𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆓𑆶𑆫𑆶 𑆖 𑆨𑆼𑆢𑆤𑆵𑆪𑆁 𑆠𑆡𑆳 𑆧𑆲𑆶𑇅 𑆍𑆠𑆠𑇀 𑆑𑆾𑆰𑇀𑆜𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆶, 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆱𑇀𑆪𑆳𑆢𑆮𑆱𑇀𑆡𑆪𑆳𑇆𑇙𑇕𑇆
𑆯𑇀𑆫𑆩𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆱𑆑𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆴𑆬𑆑𑆾𑆥𑆤𑆩𑇀𑇅 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆱𑆱𑇀𑆪𑆳𑆬𑆱𑆱𑇀𑆪 𑆨𑆾𑆘𑆤𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆤𑆩𑇀𑇆𑇙𑇖𑇆
𑆪𑆖𑇀𑆖𑆳𑆤𑆶𑆠𑇀𑆱𑆸𑆘𑇀𑆪 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆁 𑆨𑆶𑆕𑇀𑆑𑇀𑆠𑆼 𑆪𑆯𑇀𑆖𑆳𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆂𑇅 𑆠𑆖𑇀𑆖 𑆑𑇀𑆫𑆩𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆪𑆖𑇀𑆖𑆳𑆠𑆴𑆑𑇀𑆰𑆶𑆢𑇀𑆮𑆯𑆳𑆤𑆶𑆓𑆂𑇆𑇙𑇗𑇆
𑆥𑆫𑆴𑆲𑆳𑆫𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆶 𑆮𑆫𑆳𑆲𑆳𑆢𑆵𑆤𑇀𑆤𑆴𑆰𑆼𑆮𑇀𑆪 𑆪𑆠𑇀𑇅 𑆱𑆼𑆮𑆼𑆠𑆾𑆰𑇀𑆟𑆁 𑆔𑆸𑆠𑆳𑆢𑆵𑆁𑆯𑇀𑆖 𑆥𑆵𑆠𑇀𑆮𑆳 𑆯𑆵𑆠𑆁 𑆤𑆴𑆰𑆼𑆮𑆠𑆼𑇆𑇙𑇘𑇆
𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆥𑆳𑆑𑆠𑆯𑇀𑆖𑆳𑆥𑆴 𑆢𑆶𑆰𑇀𑆛𑆢𑆶𑆫𑇀𑆢𑆳𑆫𑆶𑆱𑆳𑆣𑆴𑆠𑆩𑇀𑇅 𑆃𑆥𑆑𑇀𑆮𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆥𑆑𑇀𑆮𑆢𑆓𑇀𑆣𑆁 𑆖 𑆪𑆢𑇀𑆨𑆮𑆼𑆠𑇀𑇅 𑆱𑆁𑆪𑆾𑆓𑆠𑆾 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆢𑇀𑆪𑆡𑆳𑇁𑆩𑇀𑆬𑆁 𑆥𑆪𑆱𑆳 𑆱𑆲𑇆𑇙𑇙𑇆
𑆃𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆫𑆱𑆁 𑆮𑆳𑇁𑆥𑆴 𑆮𑆴𑆥𑆤𑇀𑆤𑆫𑆱𑆩𑆼𑆮 𑆮𑆳𑇅 𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆴𑆣𑆴𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆶 𑆨𑆶𑆘𑇀𑆪𑆠𑆼 𑆤𑆴𑆨𑆸𑆠𑆼 𑆤 𑆪𑆠𑇀𑇅 𑆠𑆢𑆼𑆮𑆁𑆮𑆴𑆣𑆩𑆤𑇀𑆤𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆶𑆥𑆪𑆾𑆘𑆴𑆠𑆩𑇀𑇆𑇑𑇐𑇑𑇆
𑆑𑆴𑆬𑆳𑆱𑆑𑆶𑆰𑇀𑆜𑆓𑇀𑆫𑆲𑆟𑆵𑆓𑆢𑆳𑆤𑆳𑆁 𑆯𑆾𑆡𑆳𑆩𑇀𑆬𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆥𑆵𑆤𑆱𑆳𑆤𑆳𑆩𑇀 𑇅 𑆱𑆤𑇀𑆠𑆳𑆤𑆢𑆾𑆰𑆱𑇀𑆪 𑆠𑆡𑆽𑆮 𑆩𑆸𑆠𑇀𑆪𑆾𑆫𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆩𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆲𑆼𑆠𑆶𑆩𑇀𑇆𑇑𑇐𑇓𑇆
𑆍𑆰𑆳𑆁 𑆒𑆬𑇀𑆮𑆥𑆫𑆼𑆰𑆳𑆁 𑆖 𑆮𑆽𑆫𑆾𑆣𑆴𑆑𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆴𑆩𑆼 𑆨𑆳𑆮𑆳𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆩𑆤𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆖, 𑆠𑆢𑇀𑆮𑆴𑆫𑆾𑆣𑆴𑆤𑆳𑆁 𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑆁𑆯𑆩𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆪𑆾𑆓𑆂, 𑆠𑆡𑆳𑆮𑆴𑆣𑆽𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆨𑆴𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆼𑆠𑆴𑇆𑇑𑇐𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆯𑆤𑆘𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆫𑆠𑆴𑆲𑆤𑇀𑆠𑆴 𑆮𑆴𑆮𑆼𑆖𑆤𑆩𑇀𑇅 𑆮𑆩𑆤𑆁 𑆯𑆩𑆤𑆁 𑆖𑆽𑆮 𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆳 𑆲𑆴𑆠𑆱𑆼𑆮𑆤𑆩𑇀𑇆𑇑𑇐𑇕𑇆
𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆾𑇁𑆬𑇀𑆥𑆠𑆪𑆳 𑆮𑆳𑇁𑆥𑆴 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆼𑆱𑇀𑆠𑆫𑆶𑆟𑆱𑇀𑆪 𑆖𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆧𑆬𑆴𑆤𑆳𑆁 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆮𑆴𑆠𑆡𑆁 𑆨𑆮𑆼𑆠𑇀𑇆𑇑𑇐𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆩𑆠𑆴𑆫𑆳𑆱𑆵𑆤𑇀𑆩𑆲𑆫𑇀𑆰𑆵𑆟𑆳𑆁 𑆪𑆳 𑆪𑆳 𑆫𑆱𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆼𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆨𑇀𑆪𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆫𑆱𑆳𑆯𑇀𑆫𑆪𑆳𑇆𑇑𑇐𑇗𑇆
𑆑𑆳𑆫𑆟𑆁 𑆫𑆱𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆪𑆳 𑆫𑆱𑆳𑆤𑆶𑆫𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆥𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆓𑆶𑆟𑆳𑆤𑆳𑆁 𑆖 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆥𑆸𑆡𑆑𑇀𑆥𑆸𑆡𑆑𑇀𑇆𑇑𑇐𑇘𑇆
𑆥𑆚𑇀𑆖𑆳𑆠𑇀𑆩𑆑𑆳𑆤𑆳𑆁 𑆰𑆛𑇀𑆠𑇀𑆮𑆁 𑆖 𑆫𑆱𑆳𑆤𑆳𑆁 𑆪𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳𑇅 𑆈𑆫𑇀𑆣𑇀𑆮𑆳𑆤𑆶𑆬𑆾𑆩𑆨𑆳𑆘𑆯𑇀𑆖 𑆪𑆢𑇀𑆓𑆶𑆟𑆳𑆠𑆴𑆯𑆪𑆳𑆢𑇀𑆫𑆱𑆳𑆂𑇆𑇑𑇐𑇙𑇆
𑆰𑆟𑇀𑆟𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆰𑆛𑇀𑆠𑇀𑆮𑆼 𑆖 𑆱𑆮𑆴𑆨𑆑𑇀𑆠𑆳 𑆮𑆴𑆨𑆑𑇀𑆠𑆪𑆂𑇅 𑆇𑆢𑇀𑆢𑆼𑆯𑆯𑇀𑆖𑆳𑆥𑆮𑆳𑆢𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆟𑆴𑇆𑇑𑇑𑇐𑇆
𑆥𑇀𑆫𑆮𑆫𑆳𑆮𑆫𑆩𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆓𑆿𑆫𑆮𑆳𑆢𑆴𑆰𑆶𑇅 𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆪𑆾𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑆵𑆫𑇀𑆪𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇑𑇑𑇑𑇆
𑆰𑆟𑇀𑆟𑆳𑆩𑆳𑆱𑇀𑆮𑆳𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆫𑆱𑆳𑆤𑆳𑆁 𑆪𑆠𑇀 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆪𑆢𑇀𑆪𑆢𑇀𑆮𑆴𑆫𑆶𑆣𑇀𑆪𑆠𑆼 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆼𑆤 𑆪𑆠𑇀𑆑𑆳𑆫𑆴 𑆖𑆽𑆮 𑆪𑆠𑇀𑇆𑇑𑇑𑇒𑇆
𑆮𑆽𑆫𑆾𑆣𑆴𑆑𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆿𑆰𑆣𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆄𑆠𑇀𑆫𑆼𑆪𑆨𑆢𑇀𑆫𑆑𑆳𑆥𑇀𑆪𑆵𑆪𑆼 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆮𑆢𑆤𑇀𑆩𑆶𑆤𑆴𑆂𑇆𑇑𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆴𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆰𑇀𑆛𑆮𑆫𑇀𑆟𑆓𑆤𑇀𑆣𑆫𑆱𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆮𑆴𑆣𑆴𑆮𑆴𑆲𑆴𑆠𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆑𑆶𑆯𑆬𑆳𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆦𑆬𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀; 𑆠𑆢𑆴𑆤𑇀𑆣𑆤𑆳 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆼𑆂 𑆱𑇀𑆡𑆴𑆠𑆴𑆂; 𑆠𑆠𑇀 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆷𑆫𑇀𑆘𑆪𑆠𑆴, 𑆠𑆖𑇀𑆗𑆫𑆵𑆫𑆣𑆳𑆠𑆶𑆮𑇀𑆪𑆷𑆲𑆧𑆬𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆱𑆳𑆢𑆑𑆫𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑆶𑆥𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆁, 𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆲𑆴𑆠𑆳𑆪 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇓𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆴𑆠𑆳𑆲𑆴𑆠𑆳𑆮𑆧𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆴𑆩𑆒𑆴𑆬𑆼𑆤𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆠𑆠𑇀 𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆢𑆶𑆢𑆑𑇀𑆠𑆁 𑆑𑇀𑆬𑆼𑆢𑆪𑆠𑆴, 𑆬𑆮𑆟𑆁 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆠𑆴, 𑆑𑇀𑆰𑆳𑆫𑆂 𑆥𑆳𑆖𑆪𑆠𑆴, 𑆩𑆣𑆶 𑆱𑆤𑇀𑆢𑆣𑆳𑆠𑆴, 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆪𑆠𑆴, 𑆑𑇀𑆰𑆵𑆫𑆁 𑆘𑆵𑆮𑆪𑆠𑆴, 𑆩𑆳𑆁𑆱𑆁 𑆧𑆸𑆁𑆲𑆪𑆠𑆴, 𑆫𑆱𑆂 𑆥𑇀𑆫𑆵𑆟𑆪𑆠𑆴, 𑆱𑆶𑆫𑆳 𑆘𑆫𑇀𑆘𑆫𑆵𑆑𑆫𑆾𑆠𑆴, 𑆯𑆵𑆣𑆶𑆫𑆮𑆣𑆩𑆠𑆴, 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆱𑆮𑆾 𑆢𑆵𑆥𑆪𑆠𑆴, 𑆦𑆳𑆟𑆴𑆠𑆩𑆳𑆖𑆴𑆤𑆾𑆠𑆴, 𑆢𑆣𑆴 𑆯𑆾𑆦𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆯𑆳𑆑𑆁 𑆓𑇀𑆬𑆥𑆪𑆠𑆴, 𑆥𑇀𑆫𑆨𑆷𑆠𑆳𑆤𑇀𑆠𑆫𑇀𑆩𑆬𑆾 𑆩𑆳𑆰𑆱𑆷𑆥𑆂, 𑆢𑆸𑆰𑇀𑆛𑆴𑆯𑆶𑆑𑇀𑆫𑆔𑇀𑆤𑆂 𑆑𑇀𑆰𑆳𑆫𑆂, 𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑆴𑆠𑇀𑆠𑆬𑆩𑆩𑇀𑆬𑆩𑆤𑇀𑆪𑆠𑇀𑆫 𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑆬𑆑𑆳𑆠𑇀, 𑆥𑇀𑆫𑆳𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆁 𑆩𑆣𑆶𑆫𑆩𑆤𑇀𑆪𑆠𑇀𑆫 𑆩𑆣𑆶𑆤𑆂 𑆥𑆶𑆫𑆳𑆟𑆳𑆖𑇀𑆖 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆳𑆠𑇀, 𑆥𑇀𑆫𑆳𑆪𑆱𑇀𑆠𑆴𑆑𑆁 𑆮𑆳𑆠𑆬𑆩𑆮𑆸𑆰𑇀𑆪𑆁 𑆖𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆼𑆓𑆳𑆓𑇀𑆫𑆳𑆩𑆸𑆠𑆳𑆥𑆛𑆾𑆬𑆥𑆠𑇀𑆫𑆳𑆠𑇀, 𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆛𑆶𑆑𑆁 𑆮𑆳𑆠𑆬𑆩𑆮𑆸𑆰𑇀𑆪𑆁 𑆖𑆳𑆤𑇀𑆪𑆠𑇀𑆫 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆮𑆴𑆯𑇀𑆮𑆨𑆼𑆰𑆘𑆳𑆠𑇀𑇆𑇔𑇆
𑆥𑆫𑆩𑆠𑆾 𑆮𑆫𑇀𑆓𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆳𑆲𑆳𑆫𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇕𑇆
𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆩𑆳𑆁𑆱𑆯𑆳𑆑𑆦𑆬𑆳𑆯𑇀𑆫𑆪𑆳𑆤𑇀𑇅 𑆮𑆫𑇀𑆓𑆳𑆤𑇀 𑆲𑆫𑆴𑆠𑆩𑆢𑇀𑆪𑆳𑆩𑇀𑆧𑆶𑆓𑆾𑆫𑆱𑆼𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆳𑆫𑆴𑆑𑆳𑆤𑇀𑇆𑇖𑇆
𑆢𑆯 𑆢𑇀𑆮𑆿 𑆖𑆳𑆥𑆫𑆿 𑆮𑆫𑇀𑆓𑆿 𑆑𑆸𑆠𑆳𑆤𑇀𑆤𑆳𑆲𑆳𑆫𑆪𑆾𑆓𑆴𑆤𑆳𑆩𑇀𑇅 𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆨𑆳𑆮𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼𑇆𑇗𑇆
𑆃𑆡 𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆮𑆫𑇀𑆓𑆂- 𑆫𑆑𑇀𑆠𑆯𑆳𑆬𑆴𑆫𑇀𑆩𑆲𑆳𑆯𑆳𑆬𑆴𑆂 𑆑𑆬𑆩𑆂 𑆯𑆑𑆶𑆤𑆳𑆲𑆸𑆠𑆂 𑇅 𑆠𑆷𑆫𑇀𑆟𑆑𑆾 𑆢𑆵𑆫𑇀𑆔𑆯𑆷𑆑𑆯𑇀𑆖 𑆓𑆿𑆫𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆬𑆳𑆕𑇀𑆓𑆶𑆬𑆿𑇆𑇘𑇆
𑆱𑆶𑆓𑆤𑇀𑆣𑆑𑆾 𑆬𑆾𑆲𑆮𑆳𑆬𑆂 𑆱𑆳𑆫𑆴𑆮𑆳𑆒𑇀𑆪𑆂 𑆥𑇀𑆫𑆩𑆾𑆢𑆑𑆂𑇅 𑆥𑆠𑆕𑇀𑆓𑆱𑇀𑆠𑆥𑆤𑆵𑆪𑆯𑇀𑆖 𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼 𑆯𑆳𑆬𑆪𑆂 𑆯𑆶𑆨𑆳𑆂𑇆𑇙𑇆
𑆯𑆵𑆠𑆳 𑆫𑆱𑆼 𑆮𑆴𑆥𑆳𑆑𑆼 𑆖 𑆩𑆣𑆶𑆫𑆳𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆩𑆳𑆫𑆶𑆠𑆳𑆂𑇅 𑆧𑆢𑇀𑆣𑆳𑆬𑇀𑆥𑆮𑆫𑇀𑆖𑆱𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆧𑆸𑆁𑆲𑆟𑆳𑆂 𑆯𑆶𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆬𑆳𑆂𑇆𑇑𑇐𑇆
𑆫𑆑𑇀𑆠𑆯𑆳𑆬𑆴𑆫𑇀𑆮𑆫𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆔𑇀𑆤𑆱𑇀𑆠𑇀𑆫𑆴𑆩𑆬𑆳𑆥𑆲𑆂 𑇅 𑆩𑆲𑆳𑆁𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆶 𑆑𑆬𑆩𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆤𑆶 𑆠𑆠𑆂 𑆥𑆫𑆼𑇆𑇑𑇑𑇆
𑆪𑆮𑆑𑆳 𑆲𑆳𑆪𑆤𑆳𑆂 𑆥𑆳𑆁𑆱𑆶𑆮𑆳𑆥𑇀𑆪𑆤𑆽𑆰𑆣𑆑𑆳𑆢𑆪𑆂 𑇅 𑆯𑆳𑆬𑆵𑆤𑆳𑆁 𑆯𑆳𑆬𑆪𑆂 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆤𑆶𑆑𑆳𑆫𑆁 𑆓𑆶𑆟𑆳𑆓𑆶𑆟𑆽𑆂𑇆𑇑𑇒𑇆
𑆯𑆵𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑇁𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆂 𑆱𑇀𑆡𑆴𑆫𑆳𑆠𑇀𑆩𑆑𑆂𑇅 𑆰𑆰𑇀𑆛𑆴𑆑𑆂 𑆥𑇀𑆫𑆮𑆫𑆾 𑆓𑆿𑆫𑆂 𑆑𑆸𑆰𑇀𑆟𑆓𑆿𑆫𑆱𑇀𑆠𑆠𑆾𑇁𑆤𑆶 𑆖𑇆𑇑𑇓𑇆
𑆮𑆫𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆿 𑆖𑆵𑆤𑆯𑆳𑆫𑆢𑆾𑆘𑇀𑆘𑇀𑆮𑆬𑆢𑆫𑇀𑆢𑆶𑆫𑆳𑆂𑇅 𑆓𑆤𑇀𑆣𑆤𑆳𑆂 𑆑𑆶𑆫𑆶𑆮𑆴𑆤𑇀𑆢𑆳𑆯𑇀𑆖 𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆬𑇀𑆥𑆳𑆤𑇀𑆠𑆫𑆳 𑆓𑆶𑆟𑆽𑆂𑇆𑇑𑇔𑇆
𑆩𑆣𑆶𑆫𑆯𑇀𑆖𑆳𑆩𑇀𑆬𑆥𑆳𑆑𑆯𑇀𑆖 𑆮𑇀𑆫𑆵𑆲𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆑𑆫𑆾 𑆓𑆶𑆫𑆶𑆂𑇅 𑆧𑆲𑆶𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆾𑆰𑇀𑆩𑆳 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆱𑇀𑆠𑇀𑆮𑆼𑆮 𑆥𑆳𑆛𑆬𑆂𑇆𑇑𑇕𑇆
𑆱𑆑𑆾𑆫𑆢𑆷𑆰𑆂 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆂 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆾 𑆬𑆔𑆶𑆂𑇅 𑆮𑆳𑆠𑆬𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆂 𑆯𑆵𑆠𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆯𑆾𑆰𑆟𑆂𑇆𑇑𑇖𑇆
𑆩𑆶𑆑𑆶𑆤𑇀𑆢𑆾 𑆙𑆴𑆟𑇀𑆛𑆴𑆓𑆫𑇀𑆩𑆷𑆛𑆵 𑆮𑆫𑆶𑆑𑆳 𑆮𑆫𑆑𑆳𑆱𑇀𑆠𑆡𑆳𑇅 𑆯𑆴𑆧𑆴𑆫𑆾𑆠𑇀𑆑𑆛𑆘𑆷𑆫𑇀𑆟𑆳𑆲𑇀𑆮𑆳𑆂 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆱𑆢𑆸𑆯𑆳 𑆓𑆶𑆟𑆽𑆂𑇆𑇑𑇘𑇆
𑆫𑆷𑆑𑇀𑆰𑆂 𑆯𑆵𑆠𑆾𑇁𑆓𑆶𑆫𑆶𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆧𑆲𑆶𑆮𑆳𑆠𑆯𑆑𑆸𑆢𑇀𑆪𑆮𑆂𑇅 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆸𑆠𑇀 𑆱𑆑𑆰𑆳𑆪𑆯𑇀𑆖 𑆧𑆬𑇀𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆤𑆶𑆠𑇀𑇆𑇑𑇙𑇆
𑆫𑆷𑆑𑇀𑆰𑆂 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆾 𑆩𑆣𑆶𑆫𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆲𑆳𑇅 𑆩𑆼𑆢𑆂𑆑𑇀𑆫𑆴𑆩𑆴𑆮𑆴𑆰𑆔𑇀𑆤𑆯𑇀𑆖 𑆧𑆬𑇀𑆪𑆾 𑆮𑆼𑆟𑆶𑆪𑆮𑆾 𑆩𑆠𑆂𑇆𑇒𑇐𑇆
𑆱𑆤𑇀𑆣𑆳𑆤𑆑𑆸𑆢𑇀𑆮𑆳𑆠𑆲𑆫𑆾 𑆓𑆾𑆣𑆷𑆩𑆂 𑆱𑇀𑆮𑆳𑆢𑆶𑆯𑆵𑆠𑆬𑆂𑇅 𑆘𑆵𑆮𑆤𑆾 𑆧𑆸𑆁𑆲𑆟𑆾 𑆮𑆸𑆰𑇀𑆪𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆾 𑆓𑆶𑆫𑆶𑆂𑇆𑇒𑇑𑇆
𑆤𑆳𑆤𑇀𑆢𑆵𑆩𑆶𑆒𑆵 𑆩𑆣𑆷𑆬𑆵 𑆖 𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆬𑆼𑇅 𑆅𑆠𑇀𑆪𑆪𑆁 𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆤𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆾 𑆮𑆫𑇀𑆓𑆂 𑆱𑆩𑆳𑆥𑇀𑆪𑆠𑆼𑇆𑇒𑇒𑇆
𑆅𑆠𑆴 𑆯𑆷𑆑𑆣𑆳𑆤𑇀𑆪𑆮𑆫𑇀𑆓𑆂 𑆥𑇀𑆫𑆡𑆩𑆂𑇅 𑆃𑆡 𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆮𑆫𑇀𑆓𑆂- 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆾 𑆫𑆷𑆑𑇀𑆰𑆂 𑆯𑆵𑆠𑆂 𑆥𑆳𑆑𑆼 𑆑𑆛𑆶𑆫𑇀𑆬𑆔𑆶𑆂𑇅 𑆮𑆴𑆯𑆢𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆾 𑆩𑆶𑆢𑇀𑆓𑆂 𑆱𑆷𑆥𑇀𑆪𑆾𑆠𑇀𑆠𑆩𑆾 𑆩𑆠𑆂𑇆𑇒𑇓𑇆
𑆮𑆸𑆰𑇀𑆪𑆂 𑆥𑆫𑆁 𑆮𑆳𑆠𑆲𑆫𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆾 𑆩𑆣𑆶𑆫𑆾 𑆓𑆶𑆫𑆶𑆂𑇅 𑆧𑆬𑇀𑆪𑆾 𑆧𑆲𑆶𑆩𑆬𑆂 𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆁 𑆩𑆳𑆰𑆂 𑆯𑆵𑆔𑇀𑆫𑆁 𑆢𑆢𑆳𑆠𑆴 𑆖𑇆𑇒𑇔𑇆
𑆫𑆳𑆘𑆩𑆳𑆰𑆂 𑆱𑆫𑆾 𑆫𑆶𑆖𑇀𑆪𑆂 𑆑𑆦𑆯𑆶𑆑𑇀𑆫𑆳𑆩𑇀𑆬𑆥𑆴𑆠𑇀𑆠𑆤𑆶𑆠𑇀𑇅 𑆠𑆠𑇀𑆱𑇀𑆮𑆳𑆢𑆶𑆫𑇀𑆮𑆳𑆠𑆬𑆾 𑆫𑆷𑆑𑇀𑆰𑆂 𑆑𑆰𑆳𑆪𑆾 𑆮𑆴𑆯𑆢𑆾 𑆓𑆶𑆫𑆶𑆂𑇆𑇒𑇕𑇆
𑆇𑆰𑇀𑆟𑆳𑆂 𑆑𑆰𑆳𑆪𑆳𑆂 𑆥𑆳𑆑𑆼𑇁𑆩𑇀𑆬𑆳𑆂 𑆑𑆦𑆯𑆶𑆑𑇀𑆫𑆳𑆤𑆴𑆬𑆳𑆥𑆲𑆳𑆂𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆳 𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑆂 𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆲𑆴𑆠𑆳𑆂𑇆𑇒𑇖𑇆
𑆩𑆣𑆶𑆫𑆳 𑆩𑆣𑆶𑆫𑆳𑆂 𑆥𑆳𑆑𑆼 𑆓𑇀𑆫𑆳𑆲𑆴𑆟𑆾 𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆬𑆳𑆂𑇅 𑆩𑆑𑆶𑆰𑇀𑆜𑆑𑆳𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆳𑆢𑆴𑆰𑆶𑇆𑇒𑇗𑇆
𑆖𑆟𑆑𑆳𑆯𑇀𑆖 𑆩𑆱𑆷𑆫𑆳𑆯𑇀𑆖 𑆒𑆟𑇀𑆝𑆴𑆑𑆳𑆂 𑆱𑆲𑆫𑆼𑆟𑆮𑆂𑇅 𑆬𑆔𑆮𑆂 𑆯𑆵𑆠𑆩𑆣𑆶𑆫𑆳𑆂 𑆱𑆑𑆰𑆳𑆪𑆳 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆳𑆂𑇆𑇒𑇘𑇆
𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑆷𑆥𑆼𑆰𑇀𑆮𑆳𑆬𑆼𑆥𑆤𑆼𑆰𑆶 𑆖𑇅 𑆠𑆼𑆰𑆳𑆁 𑆩𑆱𑆷𑆫𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆵 𑆑𑆬𑆳𑆪𑆾 𑆮𑆳𑆠𑆬𑆂 𑆥𑆫𑆩𑇀𑇆𑇒𑇙𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆾 𑆩𑆣𑆶𑆫𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆂 𑆑𑆰𑆳𑆪𑆂 𑆑𑆛𑆶𑆑𑆱𑇀𑆠𑆴𑆬𑆂𑇅 𑆠𑇀𑆮𑆖𑇀𑆪𑆂 𑆑𑆼𑆯𑇀𑆪𑆯𑇀𑆖 𑆧𑆬𑇀𑆪𑆯𑇀𑆖 𑆮𑆳𑆠𑆔𑇀𑆤𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆑𑆸𑆠𑇀𑇆𑇓𑇐𑇆
𑆩𑆣𑆶𑆫𑆳𑆂 𑆯𑆵𑆠𑆬𑆳 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆾 𑆧𑆬𑆔𑇀𑆤𑇀𑆪𑆾 𑆫𑆷𑆑𑇀𑆰𑆟𑆳𑆠𑇀𑆩𑆴𑆑𑆳𑆂𑇅 𑆱𑆱𑇀𑆤𑆼𑆲𑆳 𑆧𑆬𑆴𑆨𑆴𑆫𑇀𑆨𑆾𑆘𑇀𑆪𑆳 𑆮𑆴𑆮𑆴𑆣𑆳𑆂 𑆯𑆴𑆩𑇀𑆧𑆴𑆘𑆳𑆠𑆪𑆂𑇆𑇓𑇑𑇆
𑆯𑆴𑆩𑇀𑆧𑆵 𑆫𑆷𑆑𑇀𑆰𑆳 𑆑𑆰𑆳𑆪𑆳 𑆖 𑆑𑆾𑆰𑇀𑆜𑆼 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆴𑆤𑆵𑇅 𑆤 𑆖 𑆮𑆸𑆰𑇀𑆪𑆳 𑆤 𑆖𑆑𑇀𑆰𑆶𑆰𑇀𑆪𑆳 𑆮𑆴𑆰𑇀𑆛𑆨𑇀𑆪 𑆖 𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼𑇆𑇓𑇒𑇆
𑆄𑆞𑆑𑆵 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆔𑇀𑆤𑆵 𑆮𑆳𑆠𑆬𑆳, 𑆑𑆦𑆮𑆳𑆠𑆤𑆶𑆠𑇀𑇅 𑆃𑆮𑆬𑇀𑆓𑆶𑆘𑆂 𑆱𑆽𑆝𑆓𑆘𑆾, 𑆤𑆴𑆰𑇀𑆥𑆳𑆮𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆬𑆳𑆂𑇆𑇓𑇓𑇆
𑆑𑆳𑆑𑆳𑆟𑇀𑆝𑆾𑆩𑆳(𑆬𑆳)𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆩𑆳𑆰𑆮𑆠𑇀 𑆦𑆬𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇅 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆾𑇁𑆪𑆁 𑆯𑆩𑆵𑆣𑆳𑆤𑇀𑆪𑆮𑆫𑇀𑆓𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾 𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇓𑇔𑇆
𑆨𑆷𑆯𑆪𑆳 𑆧𑆴𑆬𑆮𑆳𑆱𑆴𑆠𑇀𑆮𑆳𑆢𑆳𑆤𑆷𑆥𑆳𑆤𑆷𑆥𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆠𑇀 𑇅 𑆘𑆬𑆼 𑆤𑆴𑆮𑆳𑆱𑆳𑆘𑇀𑆘𑆬𑆘𑆳 𑆘𑆬𑆼𑆖𑆫𑇀𑆪𑆳𑆘𑇀𑆘𑆬𑆼𑆖𑆫𑆳𑆂𑇆𑇕𑇔𑇆
𑆱𑇀𑆡𑆬𑆘𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆩𑆸𑆓𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆖𑆳𑆫𑆴𑆟𑆂𑇅 𑆮𑆴𑆑𑆵𑆫𑇀𑆪 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑇀𑆫𑆠𑆶𑆢𑇀𑆪 𑆥𑇀𑆫𑆠𑆶𑆢𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇕𑇕𑇆
𑆓𑆶𑆫𑆷𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆣𑆶𑆫𑆳 𑆧𑆬𑆾𑆥𑆖𑆪𑆮𑆫𑇀𑆣𑆤𑆳𑆂𑇅 𑆮𑆸𑆰𑇀𑆪𑆳𑆂 𑆥𑆫𑆁 𑆮𑆳𑆠𑆲𑆫𑆳𑆂 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆂𑇆𑇕𑇗𑇆
𑆬𑆔𑆮𑆂 𑆯𑆵𑆠𑆩𑆣𑆶𑆫𑆳𑆂 𑆱𑆑𑆰𑆳𑆪𑆳 𑆲𑆴𑆠𑆳 𑆤𑆸𑆟𑆳𑆩𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆮𑆳𑆠𑆩𑆣𑇀𑆪𑆼 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆑𑆦𑆳𑆤𑆶𑆓𑆼𑇆𑇖𑇐𑇆
𑆖𑆛𑆑𑆳𑆤𑆳𑆁 𑆖 𑆪𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆫𑆟𑇀𑆝𑆳𑆤𑆴 𑆖 𑆲𑆴𑆠𑆳𑆤𑆴 𑆖𑇅 𑆑𑇀𑆰𑆵𑆟𑆫𑆼𑆠𑆂𑆱𑆶 𑆑𑆳𑆱𑆼𑆰𑆶 𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆼𑆰𑆶 𑆑𑇀𑆰𑆠𑆼𑆰𑆶 𑆖𑇆𑇘𑇖𑇆
𑆩𑆣𑆶𑆫𑆳𑆟𑇀𑆪𑆮𑆴𑆢𑆳𑆲𑆵𑆤𑆴 𑆱𑆢𑇀𑆪𑆾𑆧𑆬𑆑𑆫𑆳𑆟𑆴 𑆖𑇅 𑆯𑆫𑆵𑆫𑆧𑆸𑆁𑆲𑆟𑆼 𑆤𑆳𑆤𑇀𑆪𑆠𑇀 𑆒𑆳𑆢𑇀𑆪𑆁 𑆩𑆳𑆁𑆱𑆳𑆢𑇀𑆮𑆴𑆯𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇘𑇗𑇆
𑆅𑆠𑆴 𑆮𑆫𑇀𑆓𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆾𑇁𑆪𑆁 𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂𑇅 𑆅𑆠𑆴 𑆩𑆳𑆁𑆱𑆮𑆫𑇀𑆓𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆂𑇅 𑆃𑆡 𑆯𑆳𑆑𑆮𑆫𑇀𑆓𑆂- 𑆥𑆳𑆜𑆳𑆯𑆶𑆰𑆳𑆯𑆛𑆵𑆯𑆳𑆑𑆁 𑆮𑆳𑆱𑇀𑆠𑆶𑆑𑆁 𑆱𑆶𑆤𑆴𑆰𑆟𑇀𑆟𑆳𑆑𑆩𑇀𑇆𑇘𑇘𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆓𑇀𑆫𑆳𑆲𑆴 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆁 𑆨𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑆶 𑆮𑆳𑆱𑇀𑆠𑆶𑆑𑆩𑇀𑇅 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆯𑆩𑆤𑆵 𑆮𑆸𑆰𑇀𑆪𑆳 𑆑𑆳𑆑𑆩𑆳𑆖𑆵 𑆫𑆱𑆳𑆪𑆤𑆵𑇆𑇘𑇙𑇆
𑆤𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆯𑆵𑆠𑆮𑆵𑆫𑇀𑆪𑆳 𑆖 𑆨𑆼𑆢𑆴𑆤𑆵 𑆑𑆶𑆰𑇀𑆜𑆤𑆳𑆯𑆴𑆤𑆵𑇅 𑆫𑆳𑆘𑆑𑇀𑆰𑆮𑆑𑆯𑆳𑆑𑆁 𑆠𑆶 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆯𑆩𑆤𑆁 𑆬𑆔𑆶𑇆𑇙𑇐𑇆
𑆓𑇀𑆫𑆳𑆲𑆴 𑆯𑆱𑇀𑆠𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆫𑇀𑆯𑆾𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆳𑆩𑇀𑇅 𑆑𑆳𑆬𑆯𑆳𑆑𑆁 𑆠𑆶 𑆑𑆛𑆶𑆑𑆁 𑆢𑆵𑆥𑆤𑆁 𑆓𑆫𑆯𑆾𑆦𑆘𑆴𑆠𑇀𑇆𑇙𑇑𑇆

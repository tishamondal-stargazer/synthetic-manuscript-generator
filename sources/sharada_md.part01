𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆳𑆬𑇀𑆥𑆫𑆷𑆑𑇀𑆰𑆳𑆲𑆳𑆫𑆳𑆢𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇅 𑆲𑆪𑆾𑆰𑇀𑆛𑇀𑆫𑆪𑆳𑆤𑆪𑆳𑆤𑆳𑆩𑇀𑆧𑆶𑆑𑇀𑆫𑆵𑆝𑆳𑆥𑇀𑆬𑆮𑆤𑆬𑆕𑇀𑆔𑆤𑆽𑆂 𑇆𑇙𑇆
𑆇𑆰𑇀𑆟𑆼 𑆖𑆳𑆠𑇀𑆪𑆣𑇀𑆮𑆮𑆽𑆰𑆩𑇀𑆪𑆳𑆢𑇀𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆢𑇀𑆮𑆼𑆓𑆤𑆴𑆓𑇀𑆫𑆲𑆳𑆠𑇀 𑇅 𑆮𑆳𑆪𑆶𑆫𑇀𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆾 𑆮𑆸𑆢𑇀𑆣𑆼𑆤 𑆫𑆑𑇀𑆠𑆼𑆤𑆳𑆮𑆳𑆫𑆴𑆠𑆂 𑆥𑆡𑆴𑇆𑇑𑇐𑇆
𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆱𑆤𑇀𑆢𑆷𑆰𑆪𑆼𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆠𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑇀𑇅 𑆒𑆶𑆝𑆁 𑆮𑆳𑆠𑆧𑆬𑆳𑆱𑆳𑆒𑇀𑆪𑆩𑆳𑆞𑇀𑆪𑆮𑆳𑆠𑆁 𑆖 𑆤𑆳𑆩𑆨𑆴𑆂𑇆𑇑𑇑𑇆
𑆠𑆱𑇀𑆪 𑆱𑇀𑆡𑆳𑆤𑆁 𑆑𑆫𑆿 𑆥𑆳𑆢𑆳𑆮𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆂 𑆱𑆫𑇀𑆮𑆱𑆤𑇀𑆣𑆪𑆂𑇅 𑆑𑆸𑆠𑇀𑆮𑆳𑇁𑇁𑆢𑆿 𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆼 𑆠𑆶 𑆩𑆷𑆬𑆁 𑆢𑆼𑆲𑆼 𑆮𑆴𑆣𑆳𑆮𑆠𑆴𑇆𑇑𑇒𑇆
𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆱𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆥𑆮𑆤𑆱𑇀𑆪𑆳𑆱𑆸𑆘𑆱𑇀𑆠𑆡𑆳𑇅 𑆠𑆢𑇀𑆢𑇀𑆫𑆮𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆢𑆼𑆲𑆁 𑆓𑆖𑇀𑆗𑆤𑇀 𑆱𑆴𑆫𑆳𑆪𑆤𑆽𑆂𑇆𑇑𑇓𑇆
𑆥𑆫𑇀𑆮𑆱𑇀𑆮𑆨𑆴𑆲𑆠𑆁 𑆑𑇀𑆰𑆶𑆧𑇀𑆣𑆁 𑆮𑆑𑇀𑆫𑆠𑇀𑆮𑆳𑆢𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼𑇅 𑆱𑇀𑆡𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆳𑆢𑆴𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆁 𑆠𑆳𑆱𑇀𑆠𑆳𑆂 𑆱𑆸𑆘𑆠𑆴 𑆮𑆼𑆢𑆤𑆳𑆂𑇆𑇑𑇔𑇆
𑆱𑇀𑆮𑆼𑆢𑆾𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆤 𑆮𑆳 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆘𑇀𑆚𑆠𑇀𑆮𑆁 𑆑𑇀𑆰𑆠𑆼𑇁𑆠𑆴𑆫𑆶𑆑𑇀𑇅 𑆱𑆤𑇀𑆣𑆴𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆩𑆳𑆬𑆱𑇀𑆪𑆁 𑆱𑆢𑆤𑆁 𑆥𑆴𑆝𑆑𑆾𑆢𑇀𑆓𑆩𑆂𑇆𑇑𑇖𑇆
𑆘𑆳𑆤𑆶𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆑𑆛𑇀𑆪𑆁𑆱𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆱𑆤𑇀𑆣𑆴𑆰𑆶𑇅 𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆂 𑆱𑇀𑆦𑆶𑆫𑆟𑆁 𑆨𑆼𑆢𑆾 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆁 𑆱𑆶𑆥𑇀𑆠𑆴𑆫𑆼𑆮 𑆖𑇆𑇑𑇗𑇆
𑆑𑆟𑇀𑆝𑆷𑆂 𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆫𑆶𑆓𑇀𑆨𑆷𑆠𑇀𑆮𑆳 𑆨𑆷𑆠𑇀𑆮𑆳 𑆤𑆯𑇀𑆪𑆠𑆴 𑆖𑆳𑆱𑆑𑆸𑆠𑇀𑇅 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆩𑆟𑇀𑆝𑆬𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆳𑆱𑆸𑆑𑇀𑆥𑆷𑆫𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇘𑇆
𑆇𑆠𑇀𑆠𑆳𑆤𑆩𑆡 𑆓𑆩𑇀𑆨𑆵𑆫𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆠𑆠𑇀 𑆥𑇀𑆫𑆖𑆑𑇀𑆰𑆠𑆼𑇅 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆯𑇀𑆫𑆪𑆩𑆶𑆠𑇀𑆠𑆳𑆤𑆁 𑆓𑆩𑇀𑆨𑆵𑆫𑆁 𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆳𑆯𑇀𑆫𑆪𑆩𑇀𑇆𑇑𑇙𑇆
𑆑𑆟𑇀𑆝𑆷𑆢𑆳𑆲𑆫𑆶𑆓𑆳𑆪𑆳𑆩𑆠𑆾𑆢𑆱𑇀𑆦𑆶𑆫𑆟𑆑𑆶𑆚𑇀𑆖𑆤𑆽𑆂𑇅 𑆃𑆤𑇀𑆮𑆴𑆠𑆳 𑆯𑇀𑆪𑆳𑆮𑆫𑆑𑇀𑆠𑆳 𑆠𑇀𑆮𑆓𑇀𑆧𑆳𑆲𑇀𑆪𑆼 𑆠𑆳𑆩𑇀𑆫𑆳 𑆠𑆡𑆼𑆰𑇀𑆪𑆠𑆼𑇆𑇒𑇐𑇆
𑆓𑆩𑇀𑆨𑆵𑆫𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆂 𑆑𑆜𑆴𑆤𑆾𑇁𑆤𑇀𑆠𑆫𑇀𑆨𑆸𑆯𑆳𑆫𑇀𑆠𑆴𑆩𑆳𑆤𑇀𑇅 𑆯𑇀𑆪𑆳𑆮𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆾𑇁𑆡𑆮𑆳 𑆢𑆳𑆲𑆠𑆾𑆢𑆱𑇀𑆦𑆶𑆫𑆟𑆥𑆳𑆑𑆮𑆳𑆤𑇀𑇆𑇒𑇑𑇆
𑆫𑆶𑆓𑇀𑆮𑆴𑆢𑆳𑆲𑆳𑆤𑇀𑆮𑆴𑆠𑆾𑇁𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆳𑆪𑆶𑆂 𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆱𑆶𑇅 𑆗𑆴𑆤𑇀𑆢𑆤𑇀𑆤𑆴𑆮 𑆖𑆫𑆠𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆮𑆑𑇀𑆫𑆵𑆑𑆶𑆫𑇀𑆮𑆁𑆯𑇀𑆖 𑆮𑆼𑆓𑆮𑆳𑆤𑇀𑇆𑇒𑇒𑇆
𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑇀𑆨𑆸𑆯𑆫𑆶𑆑𑇀 𑆠𑆾𑆢𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆯𑇀𑆖𑆴𑆩𑆴𑆖𑆴𑆩𑆳𑆪𑆠𑆼𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆽𑆂 𑆯𑆩𑆁 𑆤𑆽𑆠𑆴 𑆑𑆟𑇀𑆝𑆷𑆑𑇀𑆬𑆼𑆢𑆳𑆤𑇀𑆮𑆴𑆠𑆾𑇁𑆱𑆸𑆘𑆴 𑇆𑇒𑇗𑇆
𑆮𑆴𑆢𑆳𑆲𑆾 𑆮𑆼𑆢𑆤𑆳 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆱𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆩𑆢𑆾 𑆨𑇀𑆫𑆩𑆂𑇅 𑆫𑆳𑆓𑆂 𑆥𑆳𑆑𑆯𑇀𑆖 𑆨𑆼𑆢𑆯𑇀𑆖 𑆯𑆾𑆰𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑇆𑇒𑇘𑇆
𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆁 𑆓𑆿𑆫𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆂 𑆱𑆶𑆥𑇀𑆠𑆴𑆫𑇀𑆩𑆤𑇀𑆢𑆳 𑆖 𑆫𑆶𑆑𑇀 𑆑𑆦𑆼𑇅 𑆲𑆼𑆠𑆶𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆩𑇀𑇆𑇒𑇙𑇆
𑆍𑆑𑆢𑆾𑆰𑆳𑆤𑆶𑆓𑆁 𑆱𑆳𑆣𑇀𑆪𑆁 𑆤𑆮𑆁, 𑆪𑆳𑆥𑇀𑆪𑆁 𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆘𑆩𑇀𑇅 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆪𑆱𑇀𑆪 𑆖 𑆱𑇀𑆪𑆶𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂𑇆𑇓𑇐𑇆
𑆃𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆫𑆾𑆖𑆑𑆯𑇀𑆮𑆳𑆱𑆩𑆳𑆁𑆱𑆑𑆾𑆡𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆲𑆳𑆂𑇅 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆩𑆢𑆫𑆶𑆑𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆘𑇀𑆮𑆫𑆩𑆾𑆲𑆥𑇀𑆫𑆮𑆼𑆥𑆑𑆳𑆂𑇆𑇓𑇑𑇆
𑆲𑆴𑆑𑇀𑆑𑆳𑆥𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆮𑆵𑆱𑆫𑇀𑆥𑆥𑆳𑆑𑆠𑆾𑆢𑆨𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆳𑆂𑇅 𑆃𑆕𑇀𑆓𑆶𑆬𑆵𑆮𑆑𑇀𑆫𑆠𑆳 𑆱𑇀𑆦𑆾𑆛𑆳 𑆢𑆳𑆲𑆩𑆫𑇀𑆩𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆧𑆶𑆢𑆳𑆂𑇆𑇓𑇒𑇆
𑆍𑆠𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆫𑇀𑆮𑆫𑇀𑆘𑇀𑆪𑆁 𑆩𑆾𑆲𑆼𑆤𑆽𑆑𑆼𑆤 𑆮𑆳𑇁𑆥𑆴 𑆪𑆠𑇀𑇅 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑇀𑆫𑆳𑆮𑆴 𑆮𑆴𑆮𑆫𑇀𑆟𑆁 𑆖 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆫𑇀𑆧𑆶𑆢𑆑𑆸𑆖𑇀𑆖 𑆪𑆠𑇀𑇆𑇓𑇓𑇆
𑆮𑆫𑇀𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆮 𑆱𑆕𑇀𑆑𑆾𑆖𑆑𑆫𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆠𑆳𑆥𑆤𑆩𑇀𑇅 𑆃𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆪𑆳𑆥𑇀𑆪𑆁 𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆩𑇀𑇆𑇓𑇔𑇆
𑆫𑆑𑇀𑆠𑆩𑆳𑆫𑇀𑆓𑆁 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆯𑆳𑆒𑆳𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆩𑆳𑆫𑆶𑆠𑆂𑇅 𑆤𑆴𑆮𑆴𑆯𑇀𑆪𑆳𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆩𑆳𑆮𑆳𑆫𑇀𑆪 𑆮𑆼𑆢𑆤𑆳𑆨𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑆱𑆷𑆤𑇀𑇆𑇓𑇕𑇆
𑆠𑆠𑇀𑆫 𑆩𑆶𑆚𑇀𑆖𑆼𑆢𑆱𑆸𑆑𑇀 𑆯𑆸𑆕𑇀𑆓𑆘𑆬𑆿𑆑𑆂𑆱𑆷𑆖𑇀𑆪𑆬𑆳𑆧𑆶𑆨𑆴𑆂𑇅 𑆥𑇀𑆫𑆖𑇀𑆗𑆤𑆽𑆫𑇀𑆮𑆳 𑆱𑆴𑆫𑆳𑆨𑆴𑆫𑇀𑆮𑆳 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑇀𑇆𑇓𑇖𑇆
𑆫𑆶𑆓𑇀𑆢𑆳𑆲𑆯𑆷𑆬𑆠𑆾𑆢𑆳𑆫𑇀𑆠𑆳𑆢𑆱𑆸𑆑𑇀 𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁 𑆘𑆬𑆿𑆑𑆱𑆳𑇅 𑆯𑆸𑆕𑇀𑆓𑆽𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆽𑆫𑇀𑆲𑆫𑆼𑆠𑇀 𑆱𑆶𑆥𑇀𑆠𑆴𑆑𑆟𑇀𑆝𑆷𑆖𑆴𑆩𑆴𑆖𑆴𑆩𑆳𑆪𑆤𑆳𑆠𑇀𑇆𑇓𑇗𑇆
𑆢𑆼𑆯𑆳𑆢𑇀𑆢𑆼𑆯𑆁 𑆮𑇀𑆫𑆘𑆠𑇀 𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁 𑆱𑆴𑆫𑆳𑆨𑆴𑆂 𑆥𑇀𑆫𑆖𑇀𑆗𑆤𑆼𑆤 𑆮𑆳𑇅 𑆃𑆕𑇀𑆓𑆓𑇀𑆬𑆳𑆤𑆿 𑆤 𑆠𑆶 𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆁 𑆫𑆷𑆑𑇀𑆰𑆼 𑆮𑆳𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆖 𑆪𑆠𑇀 𑇆𑇓𑇘𑇆
𑆓𑆩𑇀𑆨𑆵𑆫𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆱𑇀𑆠𑆩𑇀𑆨𑆁 𑆑𑆩𑇀𑆥𑆁 𑆱𑇀𑆤𑆳𑆪𑆶𑆱𑆴𑆫𑆳𑆩𑆪𑆳𑆤𑇀𑇅 𑆓𑇀𑆬𑆳𑆤𑆴𑆁 𑆖𑆳𑆥𑆴 𑆱𑆱𑆕𑇀𑆑𑆾𑆖𑆳𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑆱𑆸𑆑𑇀𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑇆𑇓𑇙𑇆
𑆒𑆳𑆚𑇀𑆘𑇀𑆪𑆳𑆢𑆵𑆤𑇀 𑆮𑆳𑆠𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆩𑆸𑆠𑇀𑆪𑆶𑆁 𑆖𑆳𑆠𑇀𑆪𑆮𑆱𑆼𑆖𑆤𑆳𑆠𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀𑇆𑇔𑇐𑇆
𑆮𑆴𑆫𑆼𑆖𑇀𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑇁𑆢𑆿 𑆱𑇀𑆤𑆼𑆲𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂𑇅 𑆫𑆷𑆑𑇀𑆰𑆽𑆫𑇀𑆮𑆳 𑆩𑆸𑆢𑆶𑆨𑆴𑆂 𑆯𑆱𑇀𑆠𑆩𑆱𑆑𑆸𑆢𑇀𑆮𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆖𑇆𑇔𑇑𑇆
𑆱𑆼𑆑𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆤𑇀𑆤𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆮𑆴𑆢𑆳𑆲𑆴𑆤𑆂𑇅 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠 ...𑇅𑇔𑇒𑇅 ... 𑆮𑆴𑆯𑆼𑆰𑆁 𑆠𑆶 𑆤𑆴𑆧𑆾𑆣 𑆩𑆼𑇆𑇔𑇒𑇆
𑆧𑆳𑆲𑇀𑆪𑆩𑆳𑆬𑆼𑆥𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆥𑆫𑆴𑆰𑆼𑆑𑆾𑆥𑆤𑆳𑆲𑆤𑆽𑆂𑇅 𑆮𑆴𑆫𑆼𑆑𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆽𑆫𑇀𑆓𑆩𑇀𑆨𑆵𑆫𑆩𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇔𑇓𑇆
𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆳𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂𑇅 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆽𑆫𑆶𑆥𑆤𑆳𑆲𑆽𑆯𑇀𑆖 𑆮𑆳𑆠𑆾𑆠𑇀𑆠𑆫𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇔𑇔𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆫𑇀𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆤𑆽𑆂 𑆱𑆼𑆑𑆽𑆂 𑆱𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂𑇅 𑆯𑆵𑆠𑆽𑆫𑇀𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆟𑆽𑆯𑇀𑆖𑆳𑆥𑆴 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆘𑆪𑆼𑆠𑇀𑇆𑇔𑇕𑇆
𑆮𑆩𑆤𑆁 𑆩𑆸𑆢𑆶 𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑇀𑆤𑆼𑆲𑆱𑆼𑆑𑆿 𑆮𑆴𑆬𑆕𑇀𑆔𑆤𑆩𑇀𑇅 𑆑𑆾𑆰𑇀𑆟𑆳 𑆬𑆼𑆥𑆳𑆯𑇀𑆖 𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆼𑇆𑇔𑇖𑇆
𑆑𑆦𑆮𑆳𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆯𑆵𑆠𑆽𑆂 𑆥𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆼 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆼𑇅 𑆢𑆳𑆲𑆯𑆾𑆡𑆫𑆶𑆘𑆳𑆑𑆟𑇀𑆝𑆷𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆳𑆢𑇀𑆨𑆮𑆼𑆠𑇀𑇆𑇔𑇗𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆖𑆾𑆰𑇀𑆟𑆽𑆫𑇀𑆢𑆳𑆲𑆂 𑆑𑇀𑆬𑆼𑆢𑆾𑇁𑆮𑆢𑆳𑆫𑆟𑆩𑇀𑇅 𑆨𑆮𑆼𑆠𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑇀𑆢𑆾𑆰𑆧𑆬𑆁 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳𑇁𑇁𑆖𑆫𑆼𑆠𑇀𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇆𑇔𑇘𑇆
𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆱𑆱𑆤𑇀𑆠𑆳𑆥𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆁 𑆩𑆽𑆡𑆶𑆤𑆁 𑆠𑆡𑆳𑇅 𑆑𑆛𑆷𑆰𑇀𑆟𑆁 𑆓𑆶𑆫𑇀𑆮𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴 𑆬𑆮𑆟𑆳𑆩𑇀𑆬𑆁 𑆖 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇔𑇙𑇆
𑆥𑆶𑆫𑆳𑆟𑆳 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆤𑆵𑆮𑆳𑆫𑆳𑆂 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆂𑇅 𑆨𑆾𑆘𑆤𑆳𑆫𑇀𑆡𑆁 𑆫𑆱𑆳𑆫𑇀𑆡𑆁 𑆮𑆳 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆥𑇀𑆫𑆠𑆶𑆢𑆳 𑆲𑆴𑆠𑆳𑆂𑇆𑇕𑇐𑇆
𑆄𑆞𑆑𑇀𑆪𑆯𑇀𑆖𑆟𑆑𑆳 𑆩𑆶𑆢𑇀𑆓𑆳 𑆩𑆱𑆷𑆫𑆳𑆂 𑆱𑆩𑆑𑆶𑆰𑇀𑆜𑆑𑆳𑆂𑇅 𑆪𑆷𑆰𑆳𑆫𑇀𑆡𑆁 𑆧𑆲𑆶𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆳𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆼𑇆𑇕𑇑𑇆
𑆱𑆶𑆤𑆴𑆰𑆟𑇀𑆟𑆑𑆮𑆼𑆠𑇀𑆫𑆳𑆓𑇀𑆫𑆑𑆳𑆑𑆩𑆳𑆖𑆵𑆯𑆠𑆳𑆮𑆫𑆵𑇅 𑆮𑆳𑆱𑇀𑆠𑆶𑆑𑆾𑆥𑆾𑆢𑆴𑆑𑆳𑆯𑆳𑆑𑆁 𑆯𑆳𑆑𑆁 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆠𑆡𑆳𑇆𑇕𑇒𑇆
𑆔𑆸𑆠𑆩𑆳𑆁𑆱𑆫𑆱𑆽𑆫𑇀𑆨𑆸𑆰𑇀𑆛𑆁 𑆯𑆳𑆑𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆪 𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆫𑇀𑆡𑆁, 𑆠𑆡𑆳 𑆓𑆮𑇀𑆪𑆁 𑆩𑆳𑆲𑆴𑆰𑆳𑆘𑆁 𑆥𑆪𑆾 𑆲𑆴𑆠𑆩𑇀𑇆𑇕𑇓𑇆
𑆅𑆠𑆴 𑆱𑆕𑇀𑆑𑇀𑆰𑆼𑆥𑆠𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆁 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆍𑆠𑆢𑆼𑆮 𑆥𑆶𑆤𑆂 𑆱𑆫𑇀𑆮𑆁 𑆮𑇀𑆪𑆳𑆱𑆠𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇕𑇔𑇆
𑆯𑇀𑆫𑆳𑆮𑆟𑆵𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆽𑆂 𑆱𑆩𑆽𑆂𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆩𑆣𑆶𑆑𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆤𑆶𑆠𑇀𑇆𑇕𑇕𑇆
𑆧𑆬𑆳𑆩𑆠𑆴𑆧𑆬𑆳𑆁 𑆩𑆼𑆢𑆳𑆩𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑇀𑇅 𑆑𑆳𑆑𑆾𑆬𑆵𑆁 𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆁 𑆫𑆳𑆱𑇀𑆤𑆳𑆩𑆸𑆢𑇀𑆣𑆴𑆁 𑆖 𑆥𑆼𑆰𑆪𑆼𑆠𑇀𑇆𑇕𑇖𑇆
𑆔𑆸𑆠𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆑𑇀𑆰𑆵𑆫𑆁 𑆠𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆤𑆶𑆠𑇀𑇅 𑆲𑆸𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆮𑆵𑆱𑆫𑇀𑆥𑆑𑆳𑆩𑆬𑆳𑆘𑇀𑆮𑆫𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇕𑇗𑇆
𑆠𑇀𑆫𑆳𑆪𑆤𑇀𑆠𑆴𑆑𑆳𑆠𑆳𑆩𑆬𑆑𑆵𑆢𑇀𑆮𑆴𑆑𑆳𑆑𑆾𑆬𑆵𑆯𑆠𑆳𑆮𑆫𑆵𑇅 𑆑𑆯𑆼𑆫𑆶𑆑𑆳𑆑𑆰𑆳𑆪𑆼𑆟 𑆑𑆬𑇀𑆑𑆽𑆫𑆼𑆨𑆴𑆂 𑆥𑆖𑆼𑆢𑇀𑆣𑆸𑆠𑆩𑇀𑇆𑇕𑇘𑇆
𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆥𑆫𑆷𑆰𑆑𑆳𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆳𑆤𑇀 𑆱𑆩𑆳𑆤𑇀𑇅 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆢𑆳𑆫𑇀𑆪𑆳𑆂 𑆱𑇀𑆮𑆫𑆱𑆁 𑆠𑆡𑆳 𑆑𑇀𑆰𑆵𑆫𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀𑇆𑇕𑇙𑇆
𑆍𑆠𑆠𑇀 𑆥𑇀𑆫𑆳𑆪𑆾𑆓𑆴𑆑𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆳𑆫𑆷𑆰𑆑𑆩𑆴𑆠𑆴 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇅 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆑𑇀𑆰𑆠𑆼 𑆑𑇀𑆰𑆵𑆟𑆼 𑆮𑆵𑆱𑆫𑇀𑆥𑆼 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆘𑇀𑆮𑆫𑆼𑇆𑇖𑇐𑇆
𑆅𑆠𑆴 𑆥𑆳𑆫𑆷𑆰𑆑𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆢𑇀𑆮𑆼 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆼 𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆩𑆼𑆫𑆟𑇀𑆝𑆁 𑆱𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆩𑇀𑇅 𑆩𑆶𑆢𑇀𑆓𑆥𑆫𑇀𑆟𑆵𑆁 𑆩𑆲𑆳𑆩𑆼𑆢𑆳𑆁 𑆩𑆳𑆰𑆥𑆫𑇀𑆟𑆵𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑇀𑇆𑇖𑇑𑇆
𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵𑆩𑆮𑆳𑆑𑇀𑆥𑆶𑆰𑇀𑆥𑆵𑆁 𑆫𑆳𑆱𑇀𑆤𑆳𑆩𑆠𑆴𑆧𑆬𑆳𑆁 𑆧𑆬𑆳𑆩𑇀𑇅 𑆥𑆸𑆡𑆓𑇀𑆢𑇀𑆮𑆴𑆥𑆬𑆴𑆑𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇆𑇖𑇒𑇆
𑆥𑆳𑆢𑆯𑆼𑆰𑆼 𑆱𑆩𑆳𑆤𑇀 𑆑𑇀𑆰𑆵𑆫𑆣𑆳𑆠𑇀𑆫𑆵𑆑𑇀𑆰𑆶𑆖𑇀𑆗𑆳𑆓𑆬𑆳𑆤𑇀 𑆫𑆱𑆳𑆤𑇀𑇅 𑆔𑆸𑆠𑆳𑆞𑆑𑆼𑆤 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆯𑆤𑆽𑆫𑇀𑆩𑆸𑆢𑇀𑆮𑆓𑇀𑆤𑆴𑆤𑆳 𑆥𑆖𑆼𑆠𑇀𑇆𑇖𑇓𑇆
𑆑𑆬𑇀𑆑𑆳𑆤𑆳𑆮𑆳𑆥𑇀𑆪 𑆩𑆼𑆢𑆼 𑆢𑇀𑆮𑆼 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆦𑆬𑆩𑆶𑆠𑇀𑆥𑆬𑆩𑇀𑇅 𑆠𑇀𑆮𑆑𑇀𑆑𑇀𑆰𑆵𑆫𑆵𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆥𑆢𑇀𑆩𑆧𑆵𑆘𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆩𑇀𑇆𑇖𑇔𑇆
𑆤𑆳𑆓𑆫𑆁 𑆑𑇀𑆰𑆵𑆫𑆑𑆳𑆑𑆾𑆬𑆵𑆁 𑆥𑆢𑇀𑆩𑆑𑆁 𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆩𑇀𑇅 𑆮𑆵𑆫𑆳𑆁 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆁 𑆨𑆮𑇀𑆪𑆩𑆶𑆫𑆶𑆩𑆳𑆟𑆁 𑆤𑆴𑆑𑆾𑆖𑆑𑆩𑇀𑇆𑇖𑇕𑇆
𑆒𑆫𑇀𑆘𑆷𑆫𑆳𑆑𑇀𑆰𑆾𑆛𑆮𑆳𑆠𑆳𑆩𑆩𑆶𑆚𑇀𑆘𑆳𑆠𑆳𑆨𑆴𑆰𑆶𑆑𑆳𑆁𑆱𑇀𑆠𑆡𑆳𑇅 𑆍𑆠𑆽𑆫𑇀𑆔𑆸𑆠𑆳𑆞𑆑𑆼 𑆱𑆴𑆢𑇀𑆣𑆼 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆯𑆵𑆠𑆼 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇖𑇖𑇆
𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆱𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆱𑆤𑇀𑆤𑆴𑆣𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆑𑆸𑆠𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆴𑆁 𑆖𑆿𑆑𑇀𑆰𑆼 𑆥𑇀𑆫𑆳𑆯𑆪𑆼𑆢𑆑𑇀𑆰𑆱𑆩𑇀𑆩𑆴𑆠𑆩𑇀𑇆𑇖𑇗𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆘𑇀𑆮𑆫𑆁 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆁 𑆨𑆓𑆤𑇀𑆢𑆫𑆩𑇀𑇅 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆷𑆬𑆁 𑆑𑇀𑆰𑆪𑆁 𑆑𑆳𑆱𑆁 𑆥𑇀𑆬𑆵𑆲𑆳𑆤𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑇀𑇆𑇖𑇘𑇆
𑆑𑇀𑆰𑆠𑆯𑆾𑆰𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆩𑆯𑇀𑆩𑆫𑆵𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆁 𑆠𑆡𑆳𑇅 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆽𑆑𑆳𑆕𑇀𑆓𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆩𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑆁 𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀𑇆𑇖𑇙𑇆
𑆧𑆬𑆮𑆫𑇀𑆟𑆑𑆫𑆁 𑆣𑆤𑇀𑆪𑆁 𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆘𑆵𑆮𑆤𑆵𑆪𑆩𑆴𑆢𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆸𑆰𑇀𑆪𑆁 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆱𑆶𑆠𑆥𑇀𑆫𑆢𑆩𑇀𑇆𑇗𑇐𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑆣𑆶(𑆣𑆷)𑆑𑆠𑆾𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑆱𑆴𑆠𑆾𑆥𑆬𑆩𑇀𑇅 𑆥𑆴𑆧𑆼𑆢𑇀𑆣𑆸𑆠𑆁 𑆠𑆡𑆳 𑆑𑇀𑆰𑆵𑆫𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆱𑇀𑆮𑆫𑆱𑆼 𑆯𑆸𑆠𑆩𑇀𑇆𑇗𑇑𑇆
𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆩𑆼𑆢𑆳𑆩𑆸𑆰𑇀𑆪𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆁 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑇀𑇅 𑆩𑆣𑆶𑆑𑆁 𑆩𑆣𑆶𑆥𑆫𑇀𑆟𑆵𑆁 𑆖 𑆑𑆳𑆑𑆾𑆬𑆵𑆢𑇀𑆮𑆪𑆩𑆼𑆮 𑆖𑇆𑇗𑇒𑇆
𑆩𑆶𑆢𑇀𑆓𑆩𑆳𑆰𑆳𑆒𑇀𑆪𑆥𑆫𑇀𑆟𑆴𑆤𑇀𑆪𑆿 𑆢𑆯𑆩𑆷𑆬𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆩𑇀𑇅 𑆧𑆬𑆳𑆩𑆸𑆠𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆯𑇀𑆖 𑆱𑆳𑆯𑇀𑆮𑆓𑆤𑇀𑆣𑆳𑆯𑇀𑆩𑆨𑆼𑆢𑆑𑆳𑆂𑇆𑇗𑇓𑇆
𑆍𑆰𑆳𑆁 𑆑𑆰𑆳𑆪𑆑𑆬𑇀𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆖 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑇅 𑆬𑆳𑆨𑆠𑆯𑇀𑆖 𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆣𑆳𑆤𑇀𑆮𑆥𑇀𑆫𑆳𑆠𑆶𑆢𑆮𑆽𑆰𑇀𑆑𑆴𑆫𑆩𑇀𑇆𑇗𑇔𑇆
𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑆤 𑆥𑆪𑆱𑆳 𑆠𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳𑆠𑆯𑆾𑆟𑆴𑆠𑆩𑇀𑇅 𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆳𑆯𑇀𑆫𑆴𑆠𑆁 𑆲𑆤𑇀𑆠𑆴 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆔𑆾𑆫𑆳𑆁𑆯𑇀𑆖 𑆮𑆳𑆠𑆘𑆳𑆤𑇀𑇆𑇗𑇕𑇆
𑆱𑇀𑆡𑆴𑆫𑆳 𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳 𑆧𑆸𑆲𑆠𑆵 𑆱𑆳𑆫𑆴𑆮𑆳 𑆱𑆯𑆠𑆳𑆮𑆫𑆵𑇅 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆳𑆟𑇀𑆪𑆳𑆠𑇀𑆩𑆓𑆶𑆥𑇀𑆠𑆳 𑆖 𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆾 𑆢𑇀𑆮𑆼 𑆧𑆬𑆼 𑆠𑆡𑆳𑇆𑇗𑇖𑇆
𑆍𑆰𑆳𑆁 𑆑𑇀𑆮𑆳𑆡𑆼 𑆖𑆠𑆶𑆂𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆸𑆡𑆑𑇀 𑆠𑆽𑆬𑆁 𑆥𑆸𑆡𑆓𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆩𑆼𑆢𑆳𑆯𑆠𑆳𑆮𑆫𑆵𑆪𑆰𑇀𑆛𑆴𑆘𑆵𑆮𑆤𑇀𑆠𑆵𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆽𑆂𑇆𑇗𑇗𑇆
𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆩𑆳𑆠𑇀𑆫𑆳 𑆠𑆠𑆂 𑆑𑇀𑆰𑆵𑆫𑆠𑇀𑆫𑆴𑆓𑆶𑆟𑆳𑇁𑆣𑇀𑆪𑆫𑇀𑆣𑆯𑆫𑇀𑆑𑆫𑆳𑇅 𑆒𑆘𑆼𑆤 𑆩𑆡𑆴𑆠𑆳 𑆥𑆼𑆪𑆳 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆼𑇆𑇗𑇘𑇆
𑆠𑆽𑆬𑆁 𑆥𑆪𑆂 𑆯𑆫𑇀𑆑𑆫𑆳𑆁 𑆖 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆮𑆳 𑆱𑆶𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆩𑇀𑇅 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆱𑆴𑆠𑆳𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆽𑆫𑇀𑆩𑆴𑆯𑇀𑆫𑆁 𑆮𑆳𑇁𑆥𑆴 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆪𑆂𑇆𑇗𑇙𑇆
𑆃𑆁𑆯𑆶𑆩𑆠𑇀𑆪𑆳 𑆯𑆸𑆠𑆂 𑆥𑇀𑆫𑆱𑇀𑆡𑆂 𑆥𑆪𑆱𑆾 𑆢𑇀𑆮𑆴𑆱𑆴𑆠𑆾𑆥𑆬𑆂𑇅 𑆥𑆳𑆤𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑆠𑆢𑇀𑆮𑆠𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆓𑆫𑆽𑆂 𑆯𑆸𑆠𑆂𑇆𑇘𑇐𑇆
𑆧𑆬𑆳𑆯𑆠𑆳𑆮𑆬𑆵𑆫𑆳𑆱𑇀𑆤𑆳𑆢𑆯𑆩𑆷𑆬𑆽𑆂 𑆱𑆥𑆵𑆬𑆶𑆨𑆴𑆂𑇅 𑆯𑇀𑆪𑆳𑆩𑆽𑆫𑆟𑇀𑆝𑆱𑇀𑆡𑆴𑆫𑆳𑆨𑆴𑆯𑇀𑆖 𑆮𑆳𑆠𑆳𑆫𑇀𑆠𑆴𑆔𑇀𑆤𑆁 𑆯𑆸𑆠𑆁 𑆥𑆪𑆂𑇆𑇘𑇑𑇆
𑆣𑆳𑆫𑆾𑆰𑇀𑆟𑆁 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆁 𑆢𑆾𑆰𑆳𑆤𑆶𑆬𑆾𑆩𑆤𑆩𑇀𑇅 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑆱𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆮𑆸𑆠𑆳𑆤𑆴𑆬𑆂𑇆𑇘𑇒𑇆
𑆑𑇀𑆰𑆵𑆫𑆼𑆟𑆽𑆫𑆟𑇀𑆝𑆠𑆽𑆬𑆁 𑆮𑆳 𑆥𑇀𑆫𑆪𑆾𑆓𑆼𑆟 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂𑇅 𑆧𑆲𑆶𑆢𑆾𑆰𑆾 𑆮𑆴𑆫𑆼𑆑𑆳𑆫𑇀𑆡𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆑𑇀𑆰𑆵𑆫𑆿𑆢𑆤𑆳𑆯𑆤𑆂𑇆𑇘𑇓𑇆
𑆑𑆰𑆳𑆪𑆩𑆨𑆪𑆳𑆤𑆳𑆁 𑆮𑆳 𑆔𑆸𑆠𑆨𑆸𑆰𑇀𑆛𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂𑇅 𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑆶𑆥𑆳𑆤𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆖𑆷𑆫𑇀𑆟𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆼𑆤 𑆮𑆳𑇆𑇘𑇔𑇆
𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆱𑆥𑆫𑆷𑆰𑆑𑆳𑆩𑇀𑇅 𑆯𑆸𑆠𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆴𑆫𑆼𑆑𑆳𑆪 𑆬𑆮𑆟𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇘𑇕𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆪𑆳𑆂 𑆑𑆰𑆳𑆪𑆁 𑆮𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆣𑆳𑆠𑇀𑆫𑆵𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆩𑆶𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑆰𑆳𑆪𑆁 𑆮𑆳 𑆑𑆦𑆳𑆣𑆴𑆑𑆂𑇆𑇘𑇖𑇆
𑆪𑆾𑆓𑆽𑆯𑇀𑆖 𑆑𑆬𑇀𑆥𑆮𑆴𑆲𑆴𑆠𑆽𑆫𑆱𑆑𑆸𑆠𑇀𑆠𑆁 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑇅 𑆩𑆸𑆢𑆶𑆨𑆴𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆮𑆳𑆠𑆁 𑆩𑆬𑆳𑆮𑆸𑆠𑆩𑇀𑇆𑇘𑇗𑇆
𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑇀𑆮𑆳 𑆩𑆬𑆁 𑆠𑆱𑇀𑆪 𑆱𑆔𑆸𑆠𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆂𑇅 𑆤 𑆲𑆴 𑆧𑆱𑇀𑆠𑆴𑆱𑆩𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇆𑇘𑇘𑇆

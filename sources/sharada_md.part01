𑆖𑆴𑆤𑇀𑆠𑆳𑆑𑆳𑆩𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆾𑆢𑇀𑆮𑆼𑆓𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆡𑆳𑇅 𑆩𑆤𑆱𑇀𑆪𑆨𑆴𑆲𑆠𑆼 𑆤𑆹𑆟𑆳𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇕𑇆
𑆣𑆩𑆤𑆵𑆨𑆴𑆂 𑆯𑇀𑆫𑆴𑆠𑆳 𑆢𑆾𑆰𑆳 𑆲𑆸𑆢𑆪𑆁 𑆥𑆵𑆝𑆪𑆤𑇀𑆠𑆴 𑆲𑆴𑇅 𑆱𑆩𑇀𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆾 𑆮𑇀𑆪𑆡𑆠𑆼 𑆩𑆷𑆞𑆾 𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑆤 𑆖𑆼𑆠𑆱𑆳𑇆𑇖𑇆
𑆥𑆯𑇀𑆪𑆠𑇀𑆪𑆱𑆤𑇀𑆠𑆴 𑆫𑆷𑆥𑆳𑆟𑆴 𑆥𑆠𑆠𑆴 𑆥𑇀𑆫𑆱𑇀𑆦𑆶𑆫𑆠𑇀𑆪𑆥𑆴𑇅 𑆘𑆴𑆲𑇀𑆮𑆳𑆑𑇀𑆰𑆴𑆨𑇀𑆫𑆷𑆂 𑆱𑇀𑆫𑆮𑆬𑇀𑆬𑆳𑆬𑆾 𑆲𑆱𑇀𑆠𑆿 𑆥𑆳𑆢𑆿 𑆖 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑆤𑇀𑇆𑇗𑇆
𑆢𑆾𑆰𑆮𑆼𑆓𑆼 𑆖 𑆮𑆴𑆓𑆠𑆼 𑆱𑆶𑆥𑇀𑆠𑆮𑆠𑇀 𑆥𑇀𑆫𑆠𑆴𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆠𑆼𑇅𑇘𑇅 𑆥𑆸𑆡𑆓𑇀𑆢𑆾𑆰𑆽𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆱 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂𑇆𑇘𑇆
𑆑𑆩𑇀𑆥𑆠𑆼 𑆥𑇀𑆫𑆢𑆯𑆼𑆢𑇀𑆢𑆤𑇀𑆠𑆳𑆤𑇀 𑆦𑆼𑆤𑆾𑆢𑇀𑆮𑆳𑆩𑆵 𑆯𑇀𑆮𑆱𑆴𑆠𑇀𑆪𑆥𑆴𑇅 𑆥𑆫𑆶𑆰𑆳𑆫𑆶𑆟𑆑𑆸𑆰𑇀𑆟𑆳𑆤𑆴 𑆥𑆯𑇀𑆪𑆼𑆢𑇀𑆫𑆷𑆥𑆳𑆟𑆴 𑆖𑆳𑆤𑆴𑆬𑆳𑆠𑇀𑇆𑇙𑇆
𑆥𑆵𑆠𑆦𑆼𑆤𑆳𑆕𑇀𑆓𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆂 𑆥𑆵𑆠𑆳𑆱𑆸𑆓𑇀𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆂𑇅 𑆱𑆠𑆸𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆳𑆤𑆬𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆬𑆾𑆑𑆢𑆫𑇀𑆯𑆵 𑆖 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆂𑇆𑇑𑇐𑇆
𑆯𑆶𑆑𑇀𑆬𑆦𑆼𑆤𑆳𑆕𑇀𑆓𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆂 𑆯𑆵𑆠𑆾 𑆲𑆸𑆰𑇀𑆛𑆳𑆕𑇀𑆓𑆘𑆾 𑆓𑆶𑆫𑆶𑆂𑇅 𑆥𑆯𑇀𑆪𑆚𑇀𑆗𑆶𑆑𑇀𑆬𑆳𑆤𑆴 𑆫𑆷𑆥𑆳𑆟𑆴 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆾 𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆖𑆴𑆫𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆱𑆫𑇀𑆮𑆽𑆫𑆼𑆠𑆽𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆱𑇀𑆠𑆶 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆘𑇀𑆚𑆼𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆂𑇅 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆂 𑆱 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆾 𑆪𑆂 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪𑆳𑆤𑆮𑆯𑇀𑆖 𑆪𑆂𑇆𑇑𑇒𑇆
𑆥𑆑𑇀𑆰𑆳𑆢𑇀𑆮𑆳 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆳𑆢𑇀𑆮𑆳 𑆩𑆳𑆱𑆳𑆢𑇀𑆮𑆳 𑆑𑆶𑆥𑆴𑆠𑆳 𑆩𑆬𑆳𑆂𑇅 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆪 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆮𑆼𑆓𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆡𑆳𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇑𑇓𑇆
𑆠𑆽𑆫𑆳𑆮𑆸𑆠𑆳𑆤𑆳𑆁 𑆲𑆸𑆠𑇀𑆱𑇀𑆫𑆾𑆠𑆾𑆩𑆤𑆱𑆳𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆧𑆾𑆣𑆤𑆩𑇀𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑆳𑆢𑆿 𑆨𑆴𑆰𑆑𑇀 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆑𑆫𑇀𑆩𑆨𑆴𑆫𑇀𑆮𑆩𑆤𑆳𑆢𑆴𑆨𑆴𑆂𑇆𑇑𑇔𑇆
𑆮𑆳𑆠𑆴𑆑𑆁 𑆧𑆱𑇀𑆠𑆴𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆽𑆂 𑆥𑆽𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆳𑆪𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂𑇅 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆁 𑆮𑆩𑆤𑆥𑇀𑆫𑆳𑆪𑆽𑆫𑆥𑆱𑇀𑆩𑆳𑆫𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇑𑇕𑇆
𑆱𑆫𑇀𑆮𑆠𑆂 𑆱𑆶𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑆩𑇀𑆪𑆓𑆳𑆯𑇀𑆮𑆳𑆱𑆴𑆠𑆱𑇀𑆪 𑆖𑇅 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆳𑆫𑇀𑆡𑆁 𑆪𑆾𑆓𑆳𑆤𑇀 𑆱𑆁𑆯𑆩𑆤𑆳𑆚𑇀𑆗𑆸𑆟𑆶𑇆𑇑𑇖𑇆
𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆽𑆂 𑆱𑆩𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆴𑆧𑆼𑆢𑆥𑆱𑇀𑆩𑆳𑆫𑆑𑆳𑆩𑆬𑆳𑆘𑇀𑆮𑆫𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇑𑇗𑇆
𑆅𑆠𑆴 𑆥𑆚𑇀𑆖𑆓𑆮𑇀𑆪𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆢𑇀𑆮𑆼 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆫𑆘𑆤𑇀𑆪𑆿 𑆑𑆶𑆛𑆘𑆠𑇀𑆮𑆖𑆩𑇀𑇅 𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆩𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆁 𑆤𑆵𑆬𑆴𑆤𑆵𑆁 𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆩𑇀𑇆𑇑𑇘𑇆
𑆯𑆩𑇀𑆥𑆳𑆑𑆁 𑆦𑆬𑇀𑆓𑆶𑆩𑆷𑆬𑆁 𑆖 𑆥𑆿𑆰𑇀𑆑𑆫𑆁 𑆱𑆢𑆶𑆫𑆳𑆬𑆨𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆥𑆬𑆳𑆤𑆴 𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆥𑆳𑆢𑆳𑆮𑆯𑆼𑆰𑆴𑆠𑆼𑇆𑇑𑇙𑇆
𑆨𑆳𑆫𑇀𑆓𑆵𑆁 𑆥𑆳𑆜𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆤𑆴𑆖𑆶𑆬𑆳𑆤𑆴 𑆖𑇅 𑆯𑇀𑆫𑆼𑆪𑆱𑆵𑆩𑆳𑆞𑆑𑆵𑆁 𑆩𑆷𑆫𑇀𑆮𑆳𑆁 𑆢𑆤𑇀𑆠𑆵𑆁 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆖𑆴𑆠𑇀𑆫𑆑𑆿𑇆𑇒𑇐𑇆
𑆢𑇀𑆮𑆼 𑆱𑆳𑆫𑆴𑆮𑆼 𑆫𑆾𑆲𑆴𑆰𑆁 𑆖 𑆨𑆷𑆠𑆵𑆑𑆁 𑆩𑆢𑆪𑆤𑇀𑆠𑆴𑆑𑆳𑆩𑇀𑇅 𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆠𑆼𑆤 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆔𑆸𑆠𑆳𑆠𑇀 𑆥𑆖𑆼𑆠𑇀𑇆𑇒𑇑𑇆
𑆓𑆾𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆑𑇀𑆰𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆽𑆯𑇀𑆖 𑆠𑆠𑇀𑆱𑆩𑆽𑆂𑇅 𑆥𑆚𑇀𑆖𑆓𑆮𑇀𑆪𑆩𑆴𑆠𑆴 𑆒𑇀𑆪𑆳𑆠𑆁 𑆩𑆲𑆠𑇀𑆠𑆢𑆩𑆸𑆠𑆾𑆥𑆩𑆩𑇀𑇆𑇒𑇒𑇆
𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆼 𑆠𑆡𑆾𑆤𑇀𑆩𑆳𑆢𑆼 𑆯𑇀𑆮𑆪𑆡𑆳𑆮𑆶𑆢𑆫𑆼𑆰𑆶 𑆖𑇅 𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆂𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆼𑆰𑆶 𑆑𑆳𑆩𑆬𑆳𑆪𑆳𑆁 𑆲𑆬𑆵𑆩𑆑𑆼𑇆𑇒𑇓𑇆
𑆯𑆱𑇀𑆪𑆠𑆼 𑆔𑆸𑆠𑆩𑆼𑆠𑆠𑇀𑆠𑆶 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼𑇅 𑆃𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆓𑇀𑆫𑆲𑆫𑆾𑆓𑆔𑇀𑆤𑆁 𑆖𑆳𑆠𑆶𑆫𑇀𑆡𑆑𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇒𑇔𑇆
𑆅𑆠𑆴 𑆩𑆲𑆳𑆥𑆚𑇀𑆖𑆓𑆮𑇀𑆪𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆫𑆱𑆮𑆖𑆳𑆑𑆶𑆰𑇀𑆜𑆯𑆕𑇀𑆒𑆥𑆶𑆰𑇀𑆥𑆵𑆨𑆴𑆫𑆼𑆮 𑆖𑇅 𑆥𑆶𑆫𑆳𑆟𑆁 𑆔𑆸𑆠𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆬𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆥𑆱𑇀𑆩𑆳𑆫𑆥𑆳𑆥𑆤𑆶𑆠𑇀𑇆𑇒𑇕𑇆
𑆔𑆸𑆠𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆲𑆴𑆕𑇀𑆓𑆶𑆨𑇀𑆪𑆳𑆁 𑆮𑆳𑆫𑇀𑆰𑆼 𑆧𑆳𑆱𑇀𑆠𑆼 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼𑇅 𑆩𑆷𑆠𑇀𑆫𑆼 𑆱𑆴𑆢𑇀𑆣𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆳𑆩𑆪𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇒𑇖𑇆

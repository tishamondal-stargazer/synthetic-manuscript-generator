𑆑𑇀𑆰𑆴𑆥𑆼𑆖𑇀𑆗𑆵𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆩𑆫𑆴𑆖𑆽𑆂 𑆱𑆲𑇅 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆬𑆼𑆲𑆪𑆼𑆢𑆼𑆠𑆢𑆵𑆯𑇀𑆮𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇒𑇕𑇆
𑆑𑆶𑆝𑆮𑆳𑆁𑆯𑆳𑆤𑇀 𑆫𑆱𑆳𑆤𑆴𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆥𑆵𑆬𑆶𑆥𑆫𑆶𑆰𑆑𑆳𑆠𑇀𑇅 𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆥𑆬𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆠𑇀 𑆑𑆶𑆝𑆮𑆳𑆫𑇀𑆣𑆁 𑆖 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑇆𑇒𑇖𑇆
𑆠𑆁 𑆬𑆼𑆲𑆁 𑆪𑆾𑆘𑆪𑆼𑆖𑇀𑆗𑆵𑆠𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆴𑆠𑇀𑇅 𑆍𑆠𑆢𑆶𑆠𑇀𑆱𑆤𑇀𑆤𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆩𑆵𑆯𑇀𑆮𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇒𑇗𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆾𑆢𑆑𑆳𑆤𑇀 𑆮𑆫𑇀𑆠𑆵𑆫𑇀𑆓𑆶𑆬𑆴𑆑𑆳𑆩𑆳𑆁𑆱𑆥𑆷𑆥𑆑𑆳𑆤𑇀𑇅 𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆳𑆤𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇒𑇘𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆤𑆳𑆓𑆫𑆁 𑆑𑇀𑆰𑆳𑆫𑆁 𑆯𑇀𑆪𑆳𑆩𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆪𑆳 𑆱𑆲𑇅 𑆬𑆼𑆲𑆪𑆼𑆤𑇀𑆩𑆣𑆶𑆤𑆳 𑆱𑆳𑆫𑇀𑆣𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆳𑆤𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇒𑇙𑇆
𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆳𑆨𑆪𑆳𑆣𑆳𑆠𑇀𑆫𑆵𑆯𑇀𑆫𑆵𑆥𑆫𑇀𑆟𑆵𑆑𑆾𑆬𑆢𑆳𑆝𑆴𑆩𑆳𑆠𑇀𑇅 𑆱𑆶𑆨𑆸𑆰𑇀𑆛𑆳𑆤𑇀 𑆱𑇀𑆮𑆫𑆱𑆳𑆁𑆱𑇀𑆠𑆽𑆬𑆼 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑆠𑆠𑇀𑆫 𑆖𑆳𑆮𑆥𑆼𑆠𑇀𑇆𑇓𑇐𑇆
𑆱𑆲𑆑𑆳𑆫𑆳𑆠𑇀 𑆑𑆥𑆴𑆠𑇀𑆡𑆳𑆖𑇀𑆖 𑆩𑆣𑇀𑆪𑆩𑆩𑇀𑆬𑆁 𑆖 𑆪𑆠𑇀 𑆦𑆬𑆩𑇀𑇅 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆧𑆲𑆬𑆵𑆨𑆷𑆠𑆼 𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆱𑆩𑆳𑆮𑆥𑆼𑆠𑇀𑇆𑇓𑇑𑇆
𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆑𑆼𑆯𑆫𑆽𑆬𑆳𑆤𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆩𑆣𑆶 𑆖 𑆩𑆳𑆠𑇀𑆫𑆪𑆳𑇅 𑆬𑆼𑆲𑆾𑇁𑆪𑆁 𑆑𑆦𑆥𑆷𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆵𑆯𑇀𑆮𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇓𑇒𑇆
𑆥𑆳𑆤𑆑𑆳𑆤𑆴 𑆫𑆱𑆳𑆤𑇀 𑆪𑆷𑆰𑆳𑆤𑇀𑆩𑆾𑆢𑆑𑆳𑆤𑇀 𑆫𑆳𑆓𑆰𑆳𑆝𑆮𑆳𑆤𑇀𑇅 𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆑𑆳𑆫𑇀𑆡𑆁 𑆑𑆦𑆳𑆣𑆴𑆑𑆼𑇆𑇓𑇓𑇆
𑆨𑆸𑆕𑇀𑆓𑆽𑆬𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆩𑆳 𑆤𑆵𑆬𑆵 𑆠𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑆽𑆯𑇀𑆖 𑆯𑆫𑇀𑆑𑆫𑆳𑇅 𑆖𑆷𑆫𑇀𑆟𑆁 𑆦𑆬𑆫𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆑𑇀𑆠𑆶𑆨𑆴𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇓𑇔𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆾𑆠𑇀𑆡𑆼𑆰𑆶 𑆫𑆾𑆓𑆼𑆰𑇀𑆮𑆬𑇀𑆥𑆳𑆤𑆬𑆼𑆰𑆶 𑆖𑇅 𑆤𑆫𑆼𑆰𑆶 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆼𑆰𑆶 𑆤𑆴𑆫𑆥𑆳𑆪𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇓𑇕𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆥𑆴𑆥𑇀𑆥𑆬𑆴𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆽𑆂𑇅 𑆩𑆾𑆢𑆑𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆾𑆫𑇀𑆣𑇀𑆮𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆳𑆥𑆲𑆂𑇆𑇓𑇖𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆗𑆳𑆟𑆳 𑆩𑆠𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆯𑇀𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆠𑇀𑆮𑆖𑆂𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑇀𑆰𑆳𑆫𑆯𑆳𑆟𑆳𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆯𑇀𑆖 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆳𑆂𑇆𑇓𑇗𑇆
𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆨𑇀𑆪𑆳𑆁 𑆖 𑆩𑆾𑆢𑆑𑆁 𑆮𑆳 𑆓𑆶𑆝𑆼𑆤 𑆠𑆶𑇅 𑆨𑆑𑇀𑆰𑆪𑆼𑆤𑇀𑆤𑆴𑆰𑇀𑆥𑆫𑆵𑆲𑆳𑆫𑆩𑆼𑆠𑆖𑇀𑆗𑆾𑆣𑆤𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀 𑇆𑇓𑇘𑇆
𑆓𑆶𑆬𑇀𑆩𑆁 𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆲𑆬𑆵𑆩𑆑𑆩𑆫𑆾𑆖𑆑𑆩𑇀𑇅 𑆑𑆦𑆮𑆳𑆠𑆑𑆸𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆼𑆠𑆲𑇀𑆪𑆥𑆾𑆲𑆠𑆴𑇆𑇓𑇙𑇆
𑆬𑆮𑆟𑆳𑆤𑇀𑆪𑆘𑆩𑆾𑆢𑆳𑆁 𑆖 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆁 𑆥𑆸𑆡𑆑𑇀𑇅 𑆠𑆴𑆬𑆠𑆽𑆬𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆨𑆳𑆓𑆿 𑆖𑆳𑆰𑇀𑆛𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆿𑇆𑇔𑇑𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆫𑆱𑆥𑇀𑆫𑆱𑇀𑆡𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑇀 𑆓𑆶𑆝𑆳𑆫𑇀𑆣𑆠𑆶𑆬𑆳𑆁 𑆠𑆡𑆳𑇅 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆩𑆸𑆢𑇀𑆮𑆓𑇀𑆤𑆴𑆤𑆳 𑆒𑆳𑆢𑆼𑆢𑇀𑆧𑆢𑆫𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆾𑆥𑆩𑆳𑆤𑇀𑇆𑇔𑇒𑇆
𑆓𑆶𑆝𑆳𑆤𑇀 𑆑𑆸𑆠𑇀𑆮𑆳 𑆤 𑆖𑆳𑆠𑇀𑆫 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆲𑆳𑆫𑆳𑆲𑆳𑆫𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆳𑇅 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆠𑇀𑆮𑆁 𑆘𑇀𑆮𑆫𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆩𑆫𑆾𑆖𑆑𑆩𑇀𑇆𑇔𑇓𑇆
𑆃𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆓𑆳𑆠𑇀𑆫𑆯𑆷𑆬𑆁 𑆖 𑆑𑆳𑆱𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆨𑇀𑆫𑆩𑆁 𑆑𑇀𑆰𑆪𑆩𑇀𑇅 𑆑𑆶𑆰𑇀𑆜𑆳𑆫𑇀𑆯𑆂𑆑𑆳𑆩𑆬𑆳𑆩𑆼𑆲𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆤𑇀𑇆𑇔𑇔𑇆
𑆓𑇀𑆫𑆲𑆟𑆵𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆲𑆤𑇀𑆪𑆶𑆂 𑆥𑆶𑆁𑆱𑆮𑆤𑆳𑆯𑇀𑆖 𑆠𑆼𑇅 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆳 𑆅𑆠𑆴 𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆸𑆠𑆶𑆰𑆶 𑆪𑆿𑆓𑆴𑆑𑆳𑆂𑇆𑇔𑇕𑇆
𑆅𑆠𑆴 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆓𑆶𑆝𑆂𑇅𑇔𑇖𑇅 𑆮𑇀𑆪𑆾𑆰𑆠𑇀𑆮𑆑𑇀𑆥𑆠𑇀𑆫𑆩𑆶𑆱𑇀𑆠𑆽𑆬𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆩𑆬𑆑𑆳𑆨𑆪𑆳𑆂 𑇅 𑆱𑆩𑆨𑆳𑆓𑆳 𑆨𑆴𑆰𑆓𑇀𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆖 𑆩𑆶𑆑𑆷𑆬𑆑𑆩𑇀𑇆𑇔𑇖𑇆
𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆾𑇁𑆰𑇀𑆛𑆓𑆶𑆟𑆁 𑆨𑆳𑆓𑆁 𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆳𑆯𑇀𑆖 𑆰𑆝𑇀𑆓𑆶𑆟𑆩𑇀𑇅 𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆁 𑆓𑆶𑆝𑆴𑆑𑆳𑆂 𑆑𑆸𑆠𑇀𑆮𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆼𑆟 𑆥𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆳𑆂𑇆𑇔𑇗𑇆
𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑆑𑆬𑇀𑆪𑆩𑆶𑆠𑇀𑆡𑆳𑆪 𑆯𑆵𑆠𑆁 𑆖𑆳𑆤𑆶 𑆥𑆴𑆧𑆼𑆘𑇀𑆘𑆬𑆩𑇀𑇅 𑆩𑆷𑆠𑇀𑆫𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼 𑆘𑇀𑆮𑆫𑆼 𑆮𑆩𑇀𑆪𑆳𑆁 𑆑𑆳𑆱𑆼 𑆯𑇀𑆮𑆳𑆱𑆼 𑆨𑇀𑆫𑆩𑆼 𑆑𑇀𑆰𑆪𑆼𑇆𑇔𑇘𑇆
𑆠𑆳𑆥𑆼 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆼𑇁𑆬𑇀𑆥𑆼𑇁𑆓𑇀𑆤𑆿 𑆯𑆱𑇀𑆠𑆳 𑆤𑆴𑆫𑇀𑆪𑆤𑇀𑆠𑇀𑆫𑆟𑆳𑆯𑆴𑆤𑆂𑇅 𑆪𑆾𑆓𑆂 𑆱𑆫𑇀𑆮𑆮𑆴𑆰𑆳𑆟𑆳𑆁 𑆖 𑆩𑆠𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆾 𑆮𑆴𑆫𑆼𑆖𑆤𑆼𑇆𑇔𑇙𑇆

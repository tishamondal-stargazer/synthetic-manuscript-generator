𑆥𑆪𑆯𑇀𑆖 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆫𑆠𑆴𑆢𑆳𑆲𑆠𑆫𑇀𑆰𑆴𑆠𑆼 𑆮𑆴𑆯𑆾𑆣𑆤𑆵𑆪𑆼 𑆠𑆶 𑆱𑆩𑆷𑆠𑇀𑆫𑆩𑆴𑆰𑇀𑆪𑆠𑆼𑇅 𑆑𑆦𑆾𑆠𑇀𑆡𑆴𑆠𑆁 𑆑𑇀𑆰𑆳𑆫𑆑𑆛𑆷𑆰𑇀𑆟𑆱𑆁𑆪𑆶𑆠𑆽𑆂 𑆱𑆩𑆷𑆠𑇀𑆫𑆠𑆑𑇀𑆫𑆳𑆱𑆮𑆪𑆶𑆑𑇀𑆠𑆴𑆨𑆴𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇆
𑆮𑇀𑆪𑆾𑆰𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆫𑆾𑆲𑆴𑆟𑆵 𑆖 𑆱𑆳𑆪𑆾𑆫𑆘𑆱𑇀𑆑𑆳 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆼𑆤𑇅 𑆥𑆵𑆠𑆁 𑆑𑆦𑆾𑆠𑇀𑆡𑆁 𑆯𑆩𑆪𑆼𑆠𑇀𑆠𑆶 𑆯𑆾𑆦𑆁 𑆓𑆮𑇀𑆪𑆼𑆤 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆲𑆫𑆵𑆠𑆑𑆵 𑆖𑇆𑇒𑇑𑇆
𑆲𑆫𑆵𑆠𑆑𑆵𑆤𑆳𑆓𑆫𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆱𑆶𑆒𑆳𑆩𑇀𑆧𑆶𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆁 𑆮𑆳𑇅 𑆱𑆫𑇀𑆮𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑇀𑆫𑆴𑆰𑇀𑆮𑆥𑆴 𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑇀𑆤𑆳𑆠𑆯𑇀𑆖 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆱𑆳𑇁𑆤𑇀𑆤𑆩𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇒𑇆
𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆤𑆳𑆓𑆫𑆩𑆶𑆱𑇀𑆠𑆑𑆬𑇀𑆑𑆳𑆤𑇀 𑆥𑇀𑆫𑆱𑇀𑆡𑆼𑆤 𑆣𑆵𑆫𑆂 𑆥𑆪𑆱𑆳𑇁𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳𑆤𑇀𑇅 𑆩𑆪𑆷𑆫𑆑𑆁 𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆁 𑆱𑆩𑆷𑆬𑆳𑆁 𑆱𑆤𑆳𑆓𑆫𑆳𑆁 𑆮𑆳 𑆥𑇀𑆫𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆮𑆳𑆠𑆼𑇆𑇒𑇓𑇆
𑆢𑆤𑇀𑆠𑆵𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆖𑆴𑆠𑇀𑆫𑆑𑆽𑆫𑇀𑆮𑆳 𑆥𑆪𑆂 𑆯𑆸𑆠𑆁 𑆢𑆾𑆰𑆲𑆫𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆳𑇅 𑆢𑇀𑆮𑆴𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆳𑆠𑇀𑆫𑆁 𑆠𑆶 𑆥𑆬𑆳𑆫𑇀𑆣𑆴𑆑𑆽𑆱𑇀𑆠𑆽𑆫𑆫𑇀𑆣𑆳𑆮𑆯𑆴𑆰𑇀𑆛𑆁 𑆥𑆮𑆤𑆼 𑆱𑆥𑆴𑆠𑇀𑆠𑆼𑇆𑇒𑇔𑇆
𑆱𑆯𑆶𑆟𑇀𑆜𑆴𑆥𑆵𑆠𑆢𑇀𑆫𑆶𑆫𑆱𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆯𑇀𑆪𑆳𑆩𑆾𑆫𑆶𑆧𑆷𑆑𑆾𑆰𑆟𑆱𑆳𑆣𑆴𑆠𑆁 𑆮𑆳𑇅 𑆠𑇀𑆮𑆓𑇀𑆢𑆳𑆫𑆶𑆮𑆫𑇀𑆰𑆳𑆨𑆶𑆩𑆲𑆿𑆰𑆣𑆽𑆫𑇀𑆮𑆳 𑆓𑆶𑆝𑆷𑆖𑆴𑆑𑆳𑆤𑆳𑆓𑆫𑆢𑆤𑇀𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆳𑇆𑇒𑇕𑇆
𑆱𑆥𑇀𑆠𑆳𑆲𑆩𑆿𑆰𑇀𑆛𑇀𑆫𑆁 𑆠𑇀𑆮𑆡𑆮𑆳𑇁𑆥𑆴 𑆩𑆳𑆱𑆁 𑆥𑆪𑆂 𑆥𑆴𑆧𑆼𑆢𑇀𑆨𑆾𑆘𑆤𑆮𑆳𑆫𑆴𑆮𑆫𑇀𑆘𑆵𑇅 𑆓𑆮𑇀𑆪𑆁 𑆱𑆩𑆷𑆠𑇀𑆫𑆁 𑆩𑆲𑆴𑆰𑆵𑆥𑆪𑆾 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆳𑆯𑆤𑆾 𑆩𑆷𑆠𑇀𑆫𑆩𑆡𑆾 𑆓𑆮𑆳𑆁 𑆮𑆳𑇆𑇒𑇖𑇆
𑆠𑆑𑇀𑆫𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑆓𑆶𑆫𑆶𑆨𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆖𑆳𑆂 𑆱𑆮𑇀𑆪𑆾𑆰𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆁 𑆖𑇅 𑆓𑆶𑆝𑆳𑆨𑆪𑆳𑆁 𑆮𑆳 𑆓𑆶𑆝𑆤𑆳𑆓𑆫𑆁 𑆮𑆳 𑆱𑆢𑆾𑆰𑆨𑆴𑆤𑇀𑆤𑆳𑆩𑆮𑆴𑆧𑆢𑇀𑆣𑆮𑆫𑇀𑆖𑆳𑆂𑇆𑇒𑇗𑇆
𑆮𑆴𑆝𑇀𑆮𑆳𑆠𑆱𑆕𑇀𑆓𑆼 𑆥𑆪𑆱𑆳 𑆫𑆱𑆽𑆫𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆓𑇀𑆨𑆑𑇀𑆠𑆩𑆢𑇀𑆪𑆳𑆢𑆶𑆫𑆶𑆧𑆷𑆑𑆠𑆽𑆬𑆩𑇀 𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆮𑆴𑆧𑆤𑇀𑆣𑆼𑇁𑆓𑇀𑆤𑆴𑆫𑆶𑆖𑆴𑆥𑇀𑆫𑆟𑆳𑆯𑆼 𑆩𑆢𑇀𑆪𑆳𑆤𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆳𑆁𑆯𑇀𑆖 𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆶𑆘𑆳𑆠𑆳𑆤𑇀𑇆𑇒𑇘𑇆
𑆓𑆟𑇀𑆝𑆵𑆫𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆁𑆯𑇀𑆖 𑆮𑇀𑆪𑆾𑆰𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆧𑆸𑆲𑆠𑆵𑆢𑇀𑆮𑆪𑆁 𑆖𑇅 𑆢𑇀𑆮𑆴𑆥𑇀𑆫𑆱𑇀𑆡𑆴𑆑𑆁 𑆓𑆾𑆩𑆪𑆥𑆳𑆮𑆑𑆼𑆤 𑆢𑇀𑆫𑆾𑆟𑆼 𑆥𑆖𑆼𑆠𑇀 𑆑𑆷𑆫𑇀𑆖𑆴𑆑𑆩𑆱𑇀𑆠𑆶𑆤𑆱𑇀𑆠𑆶 𑇆𑇒𑇙𑇆
𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆯𑆼𑆰𑆁 𑆖 𑆱𑆶𑆥𑆷𑆠𑆯𑆵𑆠𑆁 𑆢𑇀𑆫𑆾𑆟𑆼𑆤 𑆠𑆠𑇀 𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆩𑆱𑇀𑆠𑆶𑆤𑆳 𑆖𑇅 𑆱𑆴𑆠𑆾𑆥𑆬𑆳𑆪𑆳𑆯𑇀𑆖 𑆯𑆠𑆼𑆤 𑆪𑆶𑆑𑇀𑆠𑆁 𑆬𑆴𑆥𑇀𑆠𑆼 𑆔𑆛𑆼 𑆖𑆴𑆠𑇀𑆫𑆑𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆩𑇀𑇆𑇓𑇐𑇆
𑆮𑆽𑆲𑆳𑆪𑆱𑆼 𑆱𑇀𑆡𑆳𑆥𑆴𑆠𑆩𑆳𑆢𑆯𑆳𑆲𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆁𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆯𑆾𑆦𑆳𑆤𑇀𑇅 𑆨𑆓𑆤𑇀𑆢𑆫𑆳𑆫𑇀𑆯𑆂𑆑𑇀𑆫𑆴𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆲𑆳𑆤𑇀 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆳𑆤𑆴𑆬𑆲𑆴𑆑𑇀𑆑𑆤𑆁 𑆖𑇆𑇓𑇑𑇆
𑆅𑆠𑆴 𑆓𑆟𑇀𑆝𑆵𑆫𑆳𑆢𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆫𑆴𑆖𑆳𑆨𑆪𑆳𑆑𑇀𑆰𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆦𑆬𑆳𑆤𑆳𑆁 𑆖 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆩𑇀𑇅 𑆯𑆠𑆁 𑆯𑆠𑆁 𑆘𑆵𑆫𑇀𑆟𑆓𑆶𑆝𑆳𑆠𑇀𑆠𑆶𑆬𑆳𑆁 𑆖 𑆱𑆕𑇀𑆑𑇀𑆰𑆶𑆢𑇀𑆪 𑆑𑆶𑆩𑇀𑆨𑆼 𑆩𑆣𑆶𑆤𑆳 𑆥𑇀𑆫𑆬𑆴𑆥𑇀𑆠𑆼𑇆𑇓𑇒𑇆
𑆱𑆥𑇀𑆠𑆳𑆲𑆩𑆶𑆰𑇀𑆟𑆼 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆠𑆶 𑆯𑆵𑆠𑆼 𑆱𑇀𑆡𑆴𑆠𑆁 𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆪𑆶𑆠𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆳𑇅 𑆯𑆾𑆦𑆳𑆤𑇀 𑆮𑆴𑆧𑆤𑇀𑆣𑆳𑆤𑇀 𑆑𑆦𑆮𑆳𑆠𑆘𑆳𑆁𑆯𑇀𑆖 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆾𑇁𑆰𑇀𑆛𑆯𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆑𑆸𑆖𑇀𑆖𑇆𑇓𑇓𑇆
𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆯𑆠𑆾𑇁𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆼 𑆢𑇀𑆮𑆼 𑆖 𑆧𑆬𑆼 𑆱𑆥𑆳𑆜𑆼 𑆢𑆤𑇀𑆠𑆵𑆁 𑆓𑆶𑆝𑆷𑆖𑆵𑆩𑆡 𑆖𑆴𑆠𑇀𑆫𑆑𑆁 𑆖𑇅 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑆁 𑆖 𑆠𑇀𑆫𑆴𑆥𑆬𑆳𑆤𑆴 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆢𑇀𑆫𑆾𑆟𑆳𑆮𑆯𑆼𑆰𑆼 𑆱𑆬𑆴𑆬𑆼 𑆠𑆠𑆱𑇀𑆠𑆩𑇀𑇆𑇓𑇔𑇆
𑆥𑆷𑆠𑇀𑆮𑆳 𑆫𑆱𑆁 𑆢𑇀𑆮𑆼 𑆖 𑆓𑆶𑆝𑆳𑆠𑇀 𑆥𑆶𑆫𑆳𑆟𑆳𑆠𑇀𑆠𑆶𑆬𑆼 𑆩𑆣𑆶𑆥𑇀𑆫𑆱𑇀𑆡𑆪𑆶𑆠𑆁 𑆱𑆶𑆯𑆵𑆠𑆩𑇀𑇅 𑆩𑆳𑆱𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆁 𑆥𑆬𑇀𑆬𑆼 𑆪𑆮𑆳𑆤𑆳𑆁 𑆥𑆫𑆠𑆱𑇀𑆠𑆶 𑆩𑆳𑆱𑆳𑆠𑇀𑇆𑇓𑇕𑇆
𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆽𑆫𑆫𑇀𑆣𑆥𑆬𑆳𑆁𑆯𑆴𑆑𑆽𑆱𑇀𑆠𑆁 𑆥𑆠𑇀𑆫𑆠𑇀𑆮𑆓𑆼𑆬𑆳𑆩𑆫𑆴𑆖𑆳𑆩𑇀𑆧𑆶𑆬𑆾𑆲𑆽𑆂 𑇅 𑆓𑆤𑇀𑆣𑆳𑆤𑇀𑆮𑆴𑆠𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆔𑆸𑆠𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆼 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆴𑆧𑆼𑆢𑇀 𑆮𑇀𑆪𑆳𑆣𑆴𑆧𑆬𑆁 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑇆𑇓𑇖𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆁 𑆥𑇀𑆬𑆵𑆲𑆘𑇀𑆮𑆫𑆳𑆫𑆾𑆖𑆑𑆩𑆼𑆲𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑇀𑇅 𑆨𑆓𑆤𑇀𑆢𑆫𑆁 𑆰𑆝𑇀𑆘𑆜𑆫𑆳𑆟𑆴 𑆑𑆳𑆱𑆁 𑆯𑇀𑆮𑆳𑆱𑆁 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆳𑆩𑆪𑆑𑆶𑆰𑇀𑆜𑆑𑆟𑇀𑆝𑆷𑆂𑇆𑇓𑇗𑇆
𑆯𑆳𑆒𑆳𑆤𑆴𑆬𑆁 𑆧𑆢𑇀𑆣𑆥𑆶𑆫𑆵𑆰𑆠𑆳𑆁 𑆖 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆑𑆴𑆬𑆳𑆱𑆁 𑆖 𑆲𑆬𑆵𑆩𑆑𑆁 𑆖𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆘𑆪𑆼𑆢𑇀𑆮𑆫𑇀𑆟𑆧𑆬𑆳𑆪𑆶𑆫𑆾𑆘𑆱𑇀𑆠𑆼𑆘𑆾𑆤𑇀𑆮𑆴𑆠𑆾 𑆩𑆳𑆁𑆱𑆫𑆱𑆳𑆤𑇀𑆤𑆨𑆾𑆘𑆵𑇆𑇓𑇘𑇆
𑆅𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆢𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆦𑆬𑆠𑇀𑆫𑆴𑆑𑆁 𑆢𑆵𑆥𑇀𑆪𑆑𑆖𑆴𑆠𑇀𑆫𑆑𑆿 𑆖 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆬𑆾𑆲𑆫𑆘𑆾 𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑇀𑇅 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆑𑆿𑆝𑆮𑆴𑆑𑆁 𑆢𑇀𑆮𑆴𑆫𑆁𑆯𑆁 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆥𑆶𑆫𑆳𑆟𑆱𑇀𑆪 𑆠𑆶𑆬𑆳𑆁 𑆓𑆶𑆝𑆱𑇀𑆪𑇆𑇓𑇙𑇆
𑆩𑆳𑆱𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆢𑇀𑆔𑆸𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆁 𑆪𑆮𑆼𑆰𑆶 𑆠𑆳𑆤𑆼𑆮 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆤𑇀𑇅 𑆪𑆼 𑆖𑆳𑆫𑇀𑆯𑆱𑆳𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆮𑆴𑆑𑆳𑆫𑆴𑆟𑆳𑆁 𑆖 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆲𑆴𑆠𑆳𑆂 𑆯𑆾𑆦𑆴𑆰𑆶 𑆠𑆼𑇁𑆥𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆳𑆂𑇆𑇔𑇐𑇆
𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆢𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆑𑆸𑆰𑇀𑆟𑆳 𑆱𑆥𑆳𑆜𑆳 𑆓𑆘𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆖 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳 𑆖𑆴𑆠𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆼 𑆖𑇅 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆫𑆘𑆤𑇀𑆪𑆘𑆳𑆘𑆵𑆩𑆶𑆱𑇀𑆠𑆁 𑆖 𑆖𑆷𑆫𑇀𑆟𑆁 𑆱𑆶𑆒𑆠𑆾𑆪𑆥𑆵𑆠𑆩𑇀𑇆𑇔𑇑𑇆
𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆁 𑆖𑆴𑆫𑆘𑆁 𑆖 𑆯𑆾𑆦𑆁 𑆑𑆬𑇀𑆑𑆯𑇀𑆖 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆩𑆲𑆿𑆰𑆣𑆱𑇀𑆪𑇅 𑆃𑆪𑆾𑆫𑆘𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆪𑆳𑆮𑆯𑆷𑆑𑆖𑆷𑆫𑇀𑆟𑆁 𑆖 𑆥𑆵𑆠𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆼𑆤𑇆𑇔𑇒𑇆
𑆑𑇀𑆰𑆳𑆫𑆢𑇀𑆮𑆪𑆁 𑆱𑇀𑆪𑆳𑆬𑇀𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑆠𑇀𑆮𑆳𑆫𑇀𑆪𑆪𑆾𑆫𑆘𑆾 𑆮𑇀𑆪𑆾𑆰𑆦𑆬𑆠𑇀𑆫𑆴𑆑𑆼 𑆖𑇅 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆳𑆫𑆁 𑆩𑆶𑆱𑇀𑆠𑆳𑆘𑆩𑆾𑆢𑆳𑆩𑆫𑆢𑆳𑆫𑆶𑆧𑆴𑆬𑇀𑆮𑆩𑇀𑇆𑇔𑇓𑇆
𑆑𑆬𑆴𑆕𑇀𑆓𑆑𑆳𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆥𑆳𑆜𑆼 𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆪𑆁 𑆱𑆳𑆠𑆴𑆮𑆴𑆰𑆁 𑆥𑆬𑆳𑆁𑆯𑆩𑇀𑇅 𑆱𑆲𑆴𑆕𑇀𑆓𑆶𑆑𑆫𑇀𑆰𑆁 𑆠𑇀𑆮𑆟𑆶𑆯𑆶𑆰𑇀𑆑𑆖𑆷𑆫𑇀𑆟𑆁 𑆢𑇀𑆫𑆾𑆟𑆁 𑆠𑆡𑆳 𑆩𑆷𑆬𑆑𑆯𑆶𑆟𑇀𑆜𑆑𑆳𑆤𑆳𑆩𑇀𑇆𑇔𑇔𑇆
𑆱𑇀𑆪𑆳𑆢𑇀𑆨𑆱𑇀𑆩𑆤𑆱𑇀𑆠𑆠𑇀 𑆱𑆬𑆴𑆬𑆼𑆤 𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆪𑆳𑆮𑆢𑇀𑆔𑆤𑆩𑆥𑇀𑆫𑆢𑆓𑇀𑆣𑆩𑇀𑇅 𑆱𑇀𑆠𑇀𑆪𑆳𑆤𑆁 𑆠𑆠𑆂 𑆑𑆾𑆬𑆱𑆩𑆳𑆁 𑆠𑆶 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑆶𑆯𑆶𑆰𑇀𑆑𑆳𑆁 𑆮𑆴𑆣𑆴𑆤𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇕𑇆
𑆥𑇀𑆬𑆵𑆲𑆾𑆢𑆫𑆯𑇀𑆮𑆴𑆠𑇀𑆫𑆲𑆬𑆵𑆩𑆑𑆳𑆫𑇀𑆯𑆂𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆳𑆫𑆾𑆖𑆑𑆯𑆾𑆰𑆯𑆾𑆦𑆳𑆤𑇀𑇅 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆓𑆶𑆬𑇀𑆩𑆓𑆫𑆳𑆯𑇀𑆩𑆫𑆵𑆯𑇀𑆖 𑆱𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆳𑆂 𑆥𑇀𑆫𑆟𑆶𑆢𑆼𑆠𑇀 𑆱𑆑𑆶𑆰𑇀𑆜𑆳𑆂𑇆𑇔𑇖𑇆
𑆅𑆠𑆴 𑆑𑇀𑆰𑆳𑆫𑆓𑆶𑆝𑆴𑆑𑆳𑇅 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆢𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆁 𑆮𑆳 𑆠𑆶𑆬𑇀𑆪𑆁 𑆓𑆶𑆝𑆼𑆤𑆳𑆫𑇀𑆣𑆥𑆬𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳𑇅 𑆩𑆳𑆠𑇀𑆫𑆳 𑆥𑆫𑆁 𑆥𑆚𑇀𑆖𑆥𑆬𑆳𑆤𑆴 𑆩𑆳𑆱𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆾 𑆪𑆷𑆰𑆫𑆱𑆳𑆯𑇀𑆖 𑆨𑆑𑇀𑆠𑆩𑇀𑇆𑇔𑇗𑇆
𑆓𑆶𑆬𑇀𑆩𑆾𑆢𑆫𑆳𑆫𑇀𑆯𑆂𑆯𑇀𑆮𑆪𑆡𑆶𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆚𑇀 𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆬𑆱𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆤𑇀𑇅 𑆱𑆑𑆳𑆩𑆬𑆳𑆯𑆾𑆰𑆩𑆤𑆾𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆑𑆳𑆱𑆁 𑆑𑆦𑆁 𑆖𑆽𑆮 𑆘𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆓𑆂𑇆𑇔𑇘𑇆
𑆫𑆱𑆱𑇀𑆠𑆡𑆽𑆮𑆳𑆫𑇀𑆢𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆱𑇀𑆪 𑆥𑆼𑆪𑆾𑇁𑆡 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆱𑆳𑇁𑆤𑇀𑆤𑆩𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆘𑆠𑇀𑆮𑆯𑇀𑆩𑆘𑆁 𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆫𑆱𑆼𑆤 𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆥𑇀𑆫𑆱𑆲𑇀𑆪𑇆𑇔𑇙𑇆
𑆅𑆠𑆴 𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆥𑇀𑆫𑆪𑆾𑆓𑆂𑇅 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆱𑇀𑆪 𑆥𑆖𑆼𑆠𑇀 𑆑𑆰𑆳𑆪𑆼 𑆑𑆁𑆱𑆼𑇁𑆨𑆪𑆳𑆤𑆳𑆁 𑆖 𑆯𑆠𑆁 𑆓𑆶𑆝𑆱𑇀𑆪𑇅 𑆬𑆼𑆲𑆼 𑆱𑆶𑆱𑆴𑆢𑇀𑆣𑆼𑇁𑆡 𑆮𑆴𑆤𑆵𑆪 𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑇀𑆪𑆾𑆰𑆁 𑆠𑇀𑆫𑆴𑆱𑆿𑆓𑆤𑇀𑆣𑇀𑆪𑆩𑆶𑆰𑆳𑆱𑇀𑆡𑆴𑆠𑆼 𑆖𑇆𑇕𑇐𑇆
𑆥𑇀𑆫𑆱𑇀𑆡𑆳𑆫𑇀𑆣𑆩𑆳𑆠𑇀𑆫𑆁 𑆩𑆣𑆶𑆤𑆂 𑆱𑆶𑆯𑆵𑆠𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆖𑇀𑆖 𑆖𑆷𑆫𑇀𑆟𑆳𑆢𑆥𑆴 𑆪𑆳𑆮𑆯𑆷𑆑𑆳𑆠𑇀𑇅 𑆍𑆑𑆳𑆨𑆪𑆳𑆁 𑆥𑇀𑆫𑆳𑆯𑇀𑆪 𑆠𑆠𑆯𑇀𑆖 𑆬𑆼𑆲𑆳𑆖𑇀𑆗𑆶𑆑𑇀𑆠𑆴𑆁 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆩𑇀𑇆𑇕𑇑𑇆
𑆯𑇀𑆮𑆳𑆱𑆘𑇀𑆮𑆫𑆳𑆫𑆾𑆖𑆑𑆩𑆼𑆲𑆓𑆶𑆬𑇀𑆩𑆥𑇀𑆬𑆵𑆲𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆾𑆢𑆫𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆤𑇀𑇅 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆳𑆩𑆮𑆳𑆠𑆳𑆮𑆱𑆸𑆓𑆩𑇀𑆬𑆥𑆴𑆠𑇀𑆠𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆷𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆳𑆤𑇀𑇆𑇕𑇒𑇆
𑆅𑆠𑆴 𑆑𑆁𑆱𑆲𑆫𑆵𑆠𑆑𑆵𑇅 𑆥𑆛𑆾𑆬𑆩𑆷𑆬𑆳𑆩𑆫𑆢𑆳𑆫𑆶𑆢𑆤𑇀𑆠𑆵𑆠𑇀𑆫𑆳𑆪𑆤𑇀𑆠𑆴𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆨𑆪𑆳𑆮𑆴𑆯𑆳𑆬𑆳𑆂𑇅 𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆫𑆾𑆲𑆴𑆟𑆵 𑆖 𑆱𑆖𑆤𑇀𑆢𑆤𑆳 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆖𑆶𑆬𑆳𑆤𑆴 𑆢𑆳𑆫𑇀𑆮𑆵𑇆𑇕𑇓𑇆
𑆑𑆫𑇀𑆰𑆾𑆤𑇀𑆩𑆴𑆠𑆽𑆱𑇀𑆠𑆽𑆂 𑆑𑇀𑆮𑆡𑆴𑆠𑆂 𑆑𑆰𑆳𑆪𑆾 𑆔𑆸𑆠𑆼𑆤 𑆥𑆼𑆪𑆂 𑆑𑆶𑆝𑆮𑆼𑆤 𑆪𑆶𑆑𑇀𑆠𑆂𑇅 𑆮𑆵𑆱𑆫𑇀𑆥𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆠𑆸𑆰𑇀𑆟𑆳𑆮𑆴𑆰𑆳𑆟𑆴 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆖 𑆲𑆤𑇀𑆠𑆴𑇆𑇕𑇔𑇆
𑆱𑆖𑆴𑆠𑇀𑆫𑆑𑆁 𑆣𑆳𑆤𑇀𑆪𑆪𑆮𑆳𑆤𑇀𑆪𑆘𑆳𑆘𑆵𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆮𑆼𑆠𑆱𑆳𑆩𑇀𑆬𑆩𑇀𑇅 𑆧𑆴𑆬𑇀𑆮𑆳𑆠𑇀 𑆦𑆬𑆁 𑆢𑆳𑆝𑆴𑆩𑆪𑆳𑆮𑆯𑆷𑆑𑆿 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆩𑆡𑆳𑆥𑆴 𑆖𑆮𑇀𑆪𑆩𑇀𑇆𑇕𑇕𑇆
𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴 𑆘𑆬𑆳𑆞𑆑𑆼𑆤 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆩𑆡 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆓𑆶𑆬𑇀𑆩𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆖 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆮𑆲𑇀𑆤𑆴𑆁 𑆖 𑆑𑆫𑆾𑆠𑆴 𑆢𑆵𑆥𑇀𑆠𑆩𑇀𑇆𑇕𑇖𑇆
𑆥𑆴𑆧𑆼𑆢𑇀𑆔𑆸𑆠𑆁 𑆮𑆳𑇁𑆰𑇀𑆛𑆓𑆶𑆟𑆳𑆩𑇀𑆧𑆶𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑇀𑆰𑆳𑆫𑆩𑆶𑆢𑆳𑆫𑆮𑆵𑆫𑇀𑆪𑆩𑇀𑇅 𑆑𑆬𑇀𑆪𑆳𑆟𑆑𑆁 𑆮𑆳𑇁𑆥𑆴 𑆱𑆥𑆚𑇀𑆖𑆓𑆮𑇀𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆁 𑆩𑆲𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆡 𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆮𑆳𑇆𑇕𑇗𑇆
𑆑𑇀𑆰𑆵𑆫𑆁 𑆔𑆛𑆼 𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆬𑇀𑆑𑆬𑆴𑆥𑇀𑆠𑆼 𑆢𑆣𑇀𑆪𑆳𑆓𑆠𑆁 𑆱𑆳𑆣𑆶 𑆮𑆴𑆩𑆡𑇀𑆪 𑆠𑆼𑆤𑇅 𑆠𑆘𑇀𑆘𑆁 𑆔𑆸𑆠𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆓𑆫𑇀𑆨𑆁 𑆠𑆑𑇀𑆫𑆼𑆟 𑆱𑆴𑆢𑇀𑆣𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆔𑇀𑆤𑆩𑆓𑇀𑆫𑇀𑆪𑆩𑇀𑇆𑇕𑇘𑇆
𑆃𑆫𑇀𑆯𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑆳𑆤𑆴𑆬𑆓𑆶𑆬𑇀𑆩𑆩𑆼𑆲𑆳𑆁𑆯𑇀𑆖𑆽𑆠𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆧𑆬𑆥𑇀𑆫𑆢𑆁 𑆖𑇅 𑆠𑆑𑇀𑆫𑆼𑆟 𑆖𑆳𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆔𑆸𑆠𑆼𑆤 𑆠𑆼𑆤 𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆱𑆴𑆢𑇀𑆣𑆳𑆩𑆡𑆮𑆳 𑆪𑆮𑆳𑆓𑆷𑆩𑇀𑇆𑇕𑇙𑇆
𑆅𑆠𑆴 𑆖𑆴𑆠𑇀𑆫𑆑𑆔𑆸𑆠𑆩𑇀𑇅 𑆘𑆵𑆮𑆤𑇀𑆠𑇀𑆪𑆘𑆳𑆘𑆵𑆯𑆛𑆴𑆥𑆶𑆰𑇀𑆑𑆫𑆳𑆲𑇀𑆮𑆽𑆂 𑆱𑆑𑆳𑆫𑆮𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆧𑆴𑆬𑇀𑆮𑆩𑆣𑇀𑆪𑆽𑆂𑇅 𑆱𑆪𑆳𑆮𑆯𑆷𑆑𑆽𑆫𑇀𑆧𑆢𑆫𑆥𑇀𑆫𑆩𑆳𑆟𑆽𑆫𑇀𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆪𑆶𑆑𑇀𑆠𑆳 𑆔𑆸𑆠𑆠𑆽𑆬𑆨𑆸𑆰𑇀𑆛𑆳𑇆𑇖𑇐𑇆
𑆃𑆫𑇀𑆯𑆾𑇁𑆠𑆴𑆱𑆳𑆫𑆳𑆤𑆴𑆬𑆓𑆶𑆬𑇀𑆩𑆯𑆾𑆦𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆲𑆴𑆠𑆳 𑆪𑆮𑆳𑆓𑆷𑆂𑇅 𑆪𑆳 𑆥𑆚𑇀𑆖𑆑𑆾𑆬𑆽𑆫𑇀𑆮𑆴𑆣𑆴𑆤𑆽𑆮 𑆠𑆼𑆤 𑆱𑆴𑆢𑇀𑆣𑆳 𑆨𑆮𑆼𑆠𑇀 𑆱𑆳 𑆖 𑆱𑆩𑆳 𑆠𑆪𑆽𑆮𑇆𑇖𑇑𑇆
𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆷𑆰𑆯𑇀𑆖 𑆱𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆾 𑆩𑆿𑆢𑇀𑆓𑆯𑇀𑆖 𑆱𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆪𑆳𑆮𑆯𑆷𑆑𑆂𑇅 𑆫𑆱𑆱𑇀𑆠𑆡𑆳 𑆮𑆴𑆰𑇀𑆑𑆴𑆫𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆳𑆁 𑆱𑆑𑆷𑆫𑇀𑆩𑆓𑆾𑆣𑆳𑆯𑆴𑆒𑆴𑆯𑆬𑇀𑆬𑆑𑆳𑆤𑆳𑆩𑇀𑇆𑇖𑇒𑇆
𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳 𑆓𑆸𑆚𑇀𑆘𑆤𑆑𑆁 𑆥𑆛𑆾𑆬𑆁 𑆱𑆮𑆳𑆪𑆱𑆵𑆩𑆷𑆬𑆑𑆮𑆼𑆠𑇀𑆫𑆤𑆴𑆩𑇀𑆧𑆩𑇀𑇅 𑆯𑆳𑆑𑆳𑆫𑇀𑆡𑆴𑆤𑆳𑆁 𑆯𑆳𑆑𑆩𑆴𑆠𑆴 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆨𑆾𑆘𑇀𑆪𑆼 𑆥𑆶𑆫𑆳𑆟𑆯𑇀𑆖 𑆪𑆮𑆂 𑆱𑆯𑆳𑆬𑆴𑆂𑇆𑇖𑇓𑇆
𑆄𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆁 𑆨𑆼𑆰𑆘𑆩𑆶𑆑𑇀𑆠𑆩𑆼𑆠𑆢𑇀𑆧𑆫𑇀𑆲𑆴𑆫𑇀𑆲𑆴𑆠𑆁 𑆪𑆖𑇀𑆗𑆸𑆟𑆶 𑆠𑆢𑇀𑆪𑆡𑆳𑆮𑆠𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆤𑇀 𑆥𑆫𑆴𑆰𑆼𑆖𑆤𑆳𑆤𑆴 𑆱𑇀𑆮𑆼𑆢𑆳𑆁𑆯𑇀𑆖 𑆮𑆳𑆠𑆥𑇀𑆫𑆧𑆬𑆱𑇀𑆪 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇆𑇖𑇔𑇆
𑆯𑆽𑆬𑆼𑆪𑆑𑆶𑆰𑇀𑆜𑆳𑆓𑆶𑆫𑆶𑆢𑆳𑆫𑆶𑆑𑆿𑆤𑇀𑆠𑆵𑆠𑇀𑆮𑆑𑇀𑆥𑆢𑇀𑆩𑆑𑆽𑆬𑆳𑆩𑇀𑆧𑆶𑆥𑆬𑆳𑆯𑆩𑆶𑆱𑇀𑆠𑆽𑆂𑇅 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆡𑆿𑆟𑆼𑆪𑆑𑆲𑆼𑆩𑆩𑆳𑆁𑆱𑆵𑆠𑆳𑆬𑆵𑆯𑆥𑆠𑇀𑆫𑆥𑇀𑆬𑆮𑆥𑆠𑇀𑆫𑆣𑆳𑆤𑇀𑆪𑆽𑆂𑇆𑇖𑇕𑇆

𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆨𑇀𑆪𑆳𑆁 𑆲𑆴 𑆩𑆤𑆾𑇁𑆤𑆶𑆧𑆢𑇀𑆣𑆁 𑆘𑇀𑆚𑆳𑆤𑆁 𑆮𑆴𑆤𑆳 𑆠𑆠𑇀𑆫 𑆲𑆴 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆳𑆂𑇅 𑆓𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆾𑆱𑇀𑆠𑆶 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆶𑆑𑇀𑆠𑆁 𑆩𑆤𑆂 𑆱𑆢𑆾𑆰𑆁 𑆧𑆬𑆮𑆖𑇀𑆖 𑆑𑆫𑇀𑆩𑇆𑇓𑇘𑇆
𑆫𑆾𑆓𑆳𑆂 𑆑𑆶𑆠𑆂 𑆱𑆁𑆯𑆩𑆤𑆁 𑆑𑆴𑆩𑆼𑆰𑆳𑆁 𑆲𑆫𑇀𑆰𑆱𑇀𑆪 𑆯𑆾𑆑𑆱𑇀𑆪 𑆖 𑆑𑆴𑆁 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑇀𑇅 𑆯𑆫𑆵𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆥𑇀𑆫𑆨𑆮𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆑𑆡𑆁 𑆤 𑆯𑆳𑆤𑇀𑆠𑆳𑆂 𑆥𑆶𑆤𑆫𑆳𑆥𑆠𑆼𑆪𑆶𑆂𑇆𑇓𑇙𑇆
𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆾 𑆮𑆴𑆰𑆩𑆳𑆱𑇀𑆠𑆡𑆳𑇁𑆫𑇀𑆡𑆳 𑆲𑆼𑆠𑆶𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆂 𑆥𑆫𑆴𑆟𑆳𑆩𑆑𑆳𑆬𑆂𑇅 𑆱𑆫𑇀𑆮𑆳𑆩𑆪𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆖 𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆑𑆳𑆬𑆳𑆂 𑆱𑆩𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆳𑆂𑇆𑇔𑇐𑇆
𑆣𑆫𑇀𑆩𑇀𑆪𑆳𑆂 𑆑𑇀𑆫𑆴𑆪𑆳 𑆲𑆫𑇀𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆯𑆾𑆑𑆮𑆯𑆁 𑆤𑆪𑆤𑇀𑆠𑆴𑇅 𑆯𑆫𑆵𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆥𑇀𑆫𑆨𑆮𑆳𑆱𑇀𑆠𑆶 𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆪𑆾𑆫𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆳 𑆤 𑆨𑆮𑆤𑇀𑆠𑆴 𑆨𑆷𑆪𑆂𑇆𑇔𑇑𑇆
𑆫𑆷𑆥𑆱𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆖 𑆱𑆤𑇀𑆠𑆠𑆴𑆫𑇀𑆪𑆳 𑆤𑆾𑆑𑇀𑆠𑆱𑇀𑆠𑆢𑆳𑆢𑆴𑆫𑇀𑆤𑆲𑆴 𑆱𑆾𑇁𑆱𑇀𑆠𑆴 𑆑𑆯𑇀𑆖𑆴𑆠𑇀𑇅 𑆠𑆪𑆾𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆥𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆣𑆸𑆠𑆴𑆱𑇀𑆩𑆸𑆠𑆴𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑆪𑆳 𑆣𑆴𑆪𑆳 𑆖𑇆𑇔𑇒𑇆
𑆱𑆠𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆼 𑆮𑆳 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆼 𑆪𑆡𑆾𑆑𑇀𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆓𑆢𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩 𑆤𑆴𑆠𑇀𑆪𑆩𑇀𑇅 𑆘𑆴𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆤𑆳𑆤𑆶𑆥𑆠𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆠𑇀𑆑𑆳𑆬𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆢𑆴 𑆤𑆳𑆱𑇀𑆠𑆴 𑆢𑆽𑆮𑆩𑇀𑇆𑇔𑇓𑇆
𑆢𑆽𑆮𑆁 𑆥𑆶𑆫𑆳 𑆪𑆠𑇀 𑆑𑆸𑆠𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆠𑆠𑇀 𑆠𑆠𑇀 𑆥𑆿𑆫𑆶𑆰𑆁 𑆪𑆠𑇀𑆠𑇀𑆮𑆴𑆲 𑆑𑆫𑇀𑆩 𑆢𑆸𑆰𑇀𑆛𑆩𑇀𑇅 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆰𑆩𑆂 𑆱 𑆢𑆸𑆰𑇀𑆛𑆾 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆫𑇀𑆲𑆴 𑆱𑆩𑆂 𑆱 𑆍𑆮𑇆𑇔𑇔𑇆
𑆲𑆽𑆩𑆤𑇀𑆠𑆴𑆑𑆁 𑆢𑆾𑆰𑆖𑆪𑆁 𑆮𑆱𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆮𑆳𑆲𑆪𑆤𑇀 𑆓𑇀𑆫𑆽𑆰𑇀𑆩𑆴𑆑𑆩𑆨𑇀𑆫𑆑𑆳𑆬𑆼𑇅 𑆔𑆤𑆳𑆠𑇀𑆪𑆪𑆼 𑆮𑆳𑆫𑇀𑆰𑆴𑆑𑆩𑆳𑆯𑆶 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆫𑆾𑆓𑆳𑆤𑆸𑆠𑆶𑆘𑆳𑆤𑇀𑆤 𑆘𑆳𑆠𑆶 𑇆𑇔𑇕𑇆
𑆤𑆫𑆾 𑆲𑆴𑆠𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆱𑆼𑆮𑆵 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆑𑆳𑆫𑆵 𑆮𑆴𑆰𑆪𑆼𑆰𑇀𑆮𑆱𑆑𑇀𑆠𑆂𑇅 𑆢𑆳𑆠𑆳 𑆱𑆩𑆂 𑆱𑆠𑇀𑆪𑆥𑆫𑆂 𑆑𑇀𑆰𑆩𑆳𑆮𑆳𑆤𑆳𑆥𑇀𑆠𑆾𑆥𑆱𑆼𑆮𑆵 𑆖 𑆨𑆮𑆠𑇀𑆪𑆫𑆾𑆓𑆂𑇆𑇔𑇖𑇆
𑆩𑆠𑆴𑆫𑇀𑆮𑆖𑆂 𑆑𑆫𑇀𑆩 𑆱𑆶𑆒𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆮𑆴𑆣𑆼𑆪𑆁 𑆮𑆴𑆯𑆢𑆳 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆂𑇅 𑆘𑇀𑆚𑆳𑆤𑆁 𑆠𑆥𑆱𑇀𑆠𑆠𑇀𑆥𑆫𑆠𑆳 𑆖 𑆪𑆾𑆓𑆼 𑆪𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆴 𑆠𑆁 𑆤𑆳𑆤𑆶𑆥𑆠𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆂𑇆𑇔𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂𑇅 𑆅𑆲𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆱𑇀𑆪 𑆩𑆲𑆳𑆫𑇀𑆡𑆪𑆶𑆑𑇀𑆠𑆁 𑆰𑆛𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆑𑆁 𑆥𑇀𑆫𑆯𑇀𑆤𑆓𑆟𑆁 𑆩𑆲𑆫𑇀𑆰𑆴𑆂𑇅 𑆃𑆠𑆶𑆬𑇀𑆪𑆓𑆾𑆠𑇀𑆫𑆼 𑆨𑆓𑆮𑆳𑆤𑇀 𑆪𑆡𑆳𑆮𑆤𑇀𑆤𑆴𑆫𑇀𑆟𑆵𑆠𑆮𑆳𑆤𑇀 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆳𑆫𑇀𑆡𑆩𑇀𑇆𑇔𑇘𑇆
𑆃𑆡𑆳𑆠𑆂 𑆒𑆶𑆝𑇀𑆝𑆴𑆑𑆳𑆁 𑆓𑆫𑇀𑆨𑆳𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆳𑆤𑆶𑆥𑆲𑆠𑆫𑆼𑆠𑆱𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆪𑆾𑆤𑆴𑆯𑆾𑆟𑆴𑆠𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆳𑆪𑆳 𑆪𑆢𑆳 𑆨𑆮𑆠𑆴 𑆱𑆁𑆱𑆫𑇀𑆓𑆂 𑆉𑆠𑆶𑆑𑆳𑆬𑆼, 𑆪𑆢𑆳 𑆖𑆳𑆤𑆪𑆾𑆱𑇀𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆼 𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆱𑆁𑆱𑆫𑇀𑆓𑆩𑆤𑇀𑆠𑆫𑇀𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆓𑆠𑆁 𑆘𑆵𑆮𑆾𑇁𑆮𑆑𑇀𑆫𑆳𑆩𑆠𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆾𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆠𑆼𑆠𑆼, 𑆱 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆫𑆱𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑆫𑆾𑆓𑆾𑇁𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆖𑆳𑆫𑆽𑆯𑇀𑆖𑆾𑆥𑆖𑆫𑇀𑆪𑆩𑆳𑆟𑆂, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆬𑆂 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆂 𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆯𑆫𑆵𑆫𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆁𑆲𑆤𑆤𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆂 𑆱𑆶𑆒𑆼𑆤 𑆘𑆳𑆪𑆠𑆼 𑆱𑆩𑆶𑆢𑆪𑆳𑆢𑆼𑆰𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁- 𑆩𑆳𑆠𑆸𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂 𑆥𑆴𑆠𑆸𑆘𑆯𑇀𑆖𑆳𑆠𑇀𑆩𑆘𑆯𑇀𑆖 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆯𑇀𑆖 𑆫𑆱𑆘𑆯𑇀𑆖, 𑆃𑆱𑇀𑆠𑆴 𑆖 𑆒𑆬𑆶 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆿𑆥𑆥𑆳𑆢𑆶𑆑𑆩𑆴𑆠𑆴 𑆲𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇓𑇆
𑆤𑆼𑆠𑆴 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆂, 𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁- 𑆤 𑆲𑆴 𑆩𑆳𑆠𑆳 𑆤 𑆥𑆴𑆠𑆳 𑆤𑆳𑆠𑇀𑆩𑆳 𑆤 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆤 𑆥𑆳𑆤𑆳𑆯𑆤𑆨𑆑𑇀𑆰𑇀𑆪𑆬𑆼𑆲𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆳 𑆓𑆫𑇀𑆨𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆤 𑆖 𑆥𑆫𑆬𑆾𑆑𑆳𑆢𑆼𑆠𑇀𑆪 𑆓𑆫𑇀𑆨𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆮𑆑𑇀𑆫𑆳𑆩𑆠𑆴 (𑇑)𑇅𑇔𑇅 𑆪𑆢𑆴 𑆲𑆴 𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑆫𑆿 𑆓𑆫𑇀𑆨𑆁 𑆘𑆤𑆪𑆼𑆠𑆳𑆁, 𑆨𑆷𑆪𑆱𑇀𑆪𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂 𑆥𑆶𑆩𑆳𑆁𑆱𑆯𑇀𑆖 𑆨𑆷𑆪𑆳𑆁𑆱𑆂 𑆥𑆶𑆠𑇀𑆫𑆑𑆳𑆩𑆳𑆂, 𑆠𑆼 𑆱𑆫𑇀𑆮𑆼 𑆥𑆶𑆠𑇀𑆫𑆘𑆤𑇀𑆩𑆳𑆨𑆴𑆱𑆤𑇀𑆣𑆳𑆪 𑆩𑆽𑆡𑆶𑆤𑆣𑆫𑇀𑆩𑆩𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆥𑆶𑆠𑇀𑆫𑆳𑆤𑆼𑆮 𑆘𑆤𑆪𑆼𑆪𑆶𑆫𑇀𑆢𑆶𑆲𑆴𑆠𑆹𑆫𑇀𑆮𑆳 𑆢𑆶𑆲𑆴𑆠𑆸𑆑𑆳𑆩𑆳𑆂, 𑆤 𑆠𑆶 𑆑𑆳𑆯𑇀𑆖𑆴𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂 𑆑𑆼𑆖𑆴𑆢𑇀𑆮𑆳 𑆥𑆶𑆫𑆶𑆰𑆳 𑆤𑆴𑆫𑆥𑆠𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆥𑆠𑇀𑆪𑆑𑆳𑆩𑆳 𑆮𑆳 𑆥𑆫𑆴𑆢𑆼𑆮𑆼𑆫𑆤𑇀 (𑇒)𑇅𑇔𑇅 𑆤 𑆖𑆳𑆠𑇀𑆩𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆁 𑆘𑆤𑆪𑆠𑆴𑇅 𑆪𑆢𑆴 𑆲𑇀𑆪𑆳𑆠𑇀𑆩𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆁 𑆘𑆤𑆪𑆼𑆘𑇀𑆘𑆳𑆠𑆾 𑆮𑆳 𑆘𑆤𑆪𑆼𑆢𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆘𑆳𑆠𑆾 𑆮𑆳, 𑆠𑆖𑇀𑆖𑆾𑆨𑆪𑆡𑆳𑇁𑆥𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆩𑇀𑇅 𑆤 𑆲𑆴 𑆘𑆳𑆠𑆾 𑆘𑆤𑆪𑆠𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆠𑇀, 𑆤 𑆖𑆳𑆘𑆳𑆠𑆾 𑆘𑆤𑆪𑆠𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆠𑇀, 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆨𑆪𑆡𑆳𑇁𑆥𑇀𑆪𑆤𑆶𑆥𑆥𑆠𑇀𑆠𑆴𑆂𑇅 𑆠𑆴𑆰𑇀𑆜𑆠𑆶 𑆠𑆳𑆮𑆢𑆼𑆠𑆠𑇀𑇅 𑆪𑆢𑇀𑆪𑆪𑆩𑆳𑆠𑇀𑆩𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆁 𑆯𑆑𑇀𑆠𑆾 𑆘𑆤𑆪𑆴𑆠𑆶𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆠𑇀𑆮𑆼𑆤𑆩𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆮𑆼𑆮 𑆑𑆡𑆁 𑆪𑆾𑆤𑆴𑆰𑆶 𑆘𑆤𑆪𑆼𑆢𑇀𑆮𑆯𑆴𑆤𑆩𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆓𑆠𑆴𑆁 𑆑𑆳𑆩𑆫𑆷𑆥𑆴𑆟𑆁 𑆠𑆼𑆘𑆾𑆧𑆬𑆘𑆮𑆮𑆫𑇀𑆟𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆁𑆲𑆤𑆤𑆱𑆩𑆶𑆢𑆴𑆠𑆩𑆘𑆫𑆩𑆫𑆶𑆘𑆩𑆩𑆫𑆩𑇀; 𑆍𑆮𑆁𑆮𑆴𑆣𑆁 𑆲𑇀𑆪𑆳𑆠𑇀𑆩𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆩𑆴𑆖𑇀𑆗𑆠𑇀𑆪𑆠𑆾 𑆮𑆳 𑆨𑆷𑆪𑆂 (𑇓)𑇅𑇔𑇅 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂𑇅 𑆪𑆢𑆴 𑆲𑆴 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆂𑆱𑇀𑆪𑆳𑆠𑇀, 𑆠𑆫𑇀𑆲𑆴 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆼𑆮𑆴𑆤𑆳𑆩𑆼𑆮𑆽𑆑𑆳𑆤𑇀𑆠𑆼𑆤 𑆥𑇀𑆫𑆘𑆳 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆼𑆮𑆴𑆤𑆯𑇀𑆖 𑆤𑆴𑆒𑆴𑆬𑆼𑆤𑆳𑆤𑆥𑆠𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆠𑆖𑇀𑆖𑆾𑆨𑆪𑆩𑆶𑆨𑆪𑆠𑇀𑆫𑆽𑆮 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 (𑇔)𑇅𑇔𑇅 𑆃𑆫𑆱𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂𑇅 𑆪𑆢𑆴 𑆲𑆴 𑆫𑆱𑆘𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆑𑆼𑆖𑆴𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆼𑆰𑇀𑆮𑆤𑆥𑆠𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆤 𑆲𑆴 𑆑𑆯𑇀𑆖𑆴𑆢𑆱𑇀𑆠𑇀𑆪𑆼𑆰𑆳𑆁 𑆪𑆾 𑆫𑆱𑆳𑆤𑇀𑆤𑆾𑆥𑆪𑆶𑆕𑇀𑆑𑇀𑆠𑆼; 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆫𑆱𑆾𑆥𑆪𑆾𑆓𑆴𑆤𑆳𑆁 𑆖𑆼𑆢𑇀𑆓𑆫𑇀𑆨𑆳 𑆘𑆳𑆪𑆤𑇀𑆠 𑆅𑆠𑇀𑆪𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑆩𑆴𑆠𑆴, 𑆍𑆮𑆁 𑆱𑆠𑇀𑆪𑆳𑆘𑆿𑆫𑆨𑇀𑆫𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆪𑆷𑆫𑆓𑆾𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆔𑆸𑆠𑆩𑆣𑆶𑆠𑆽𑆬𑆱𑆽𑆤𑇀𑆣𑆮𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆶𑆢𑇀𑆓𑆯𑆳𑆬𑆴𑆨𑆸𑆠𑆳𑆤𑆳𑆩𑆼𑆮𑆽𑆑𑆳𑆤𑇀𑆠𑆼𑆤 𑆥𑇀𑆫𑆘𑆳 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆮𑆫𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆑𑆾𑆫𑆢𑆷𑆰𑆑𑆑𑆤𑇀𑆢𑆩𑆷𑆬𑆨𑆑𑇀𑆰𑆳𑆯𑇀𑆖 𑆤𑆴𑆒𑆴𑆬𑆼𑆤𑆳𑆤𑆥𑆠𑇀𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆠𑆖𑇀𑆖𑆾𑆨𑆪𑆩𑆶𑆨𑆪𑆠𑇀𑆫 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 (𑇕)𑇅𑇔𑇅 𑆤 𑆒𑆬𑇀𑆮𑆥𑆴 𑆥𑆫𑆬𑆾𑆑𑆳𑆢𑆼𑆠𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆓𑆫𑇀𑆨𑆩𑆮𑆑𑇀𑆫𑆳𑆩𑆠𑆴; 𑆪𑆢𑆴 𑆲𑇀𑆪𑆼𑆤𑆩𑆮𑆑𑇀𑆫𑆳𑆩𑆼𑆠𑇀, 𑆤𑆳𑆱𑇀𑆪 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆥𑆿𑆫𑇀𑆮𑆢𑆼𑆲𑆴𑆑𑆁 𑆱𑇀𑆪𑆳𑆢𑆮𑆴𑆢𑆴𑆠𑆩𑆯𑇀𑆫𑆶𑆠𑆩𑆢𑆸𑆰𑇀𑆛𑆁 𑆮𑆳, 𑆱 𑆖 𑆠𑆖𑇀𑆖 𑆤 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆥𑆴 𑆱𑇀𑆩𑆫𑆠𑆴 (𑇖)𑇆𑇔𑇆
𑆤𑆼𑆠𑆴 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂, 𑆱𑆫𑇀𑆮𑆼𑆨𑇀𑆪 𑆍𑆨𑇀𑆪𑆾 𑆨𑆳𑆮𑆼𑆨𑇀𑆪𑆂 𑆱𑆩𑆶𑆢𑆴𑆠𑆼𑆨𑇀𑆪𑆾 𑆓𑆫𑇀𑆨𑆾𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇕𑇆
𑆩𑆳𑆠𑆸𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂𑇅 𑆤 𑆲𑆴 𑆩𑆳𑆠𑆶𑆫𑇀𑆮𑆴𑆤𑆳 𑆓𑆫𑇀𑆨𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆖 𑆘𑆤𑇀𑆩 𑆘𑆫𑆳𑆪𑆶𑆘𑆳𑆤𑆳𑆩𑇀𑇅 𑆪𑆳𑆤𑆴 𑆒𑆬𑇀𑆮𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆩𑆳𑆠𑆸𑆘𑆳𑆤𑆴, 𑆪𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆩𑆳𑆠𑆸𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑇀𑆮𑆑𑇀𑆖 𑆬𑆾𑆲𑆴𑆠𑆁 𑆖 𑆩𑆳𑆁𑆱𑆁 𑆖 𑆩𑆼𑆢𑆯𑇀𑆖 𑆤𑆳𑆨𑆴𑆯𑇀𑆖 𑆲𑆸𑆢𑆪𑆁 𑆖 𑆑𑇀𑆬𑆾𑆩 𑆖 𑆪𑆑𑆸𑆖𑇀𑆖 𑆥𑇀𑆬𑆵𑆲𑆳 𑆖 𑆮𑆸𑆑𑇀𑆑𑆿 𑆖 𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑆶𑆫𑆵𑆰𑆳𑆣𑆳𑆤𑆁 𑆖𑆳𑆩𑆳𑆯𑆪𑆯𑇀𑆖 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆯𑇀𑆖𑆾𑆠𑇀𑆠𑆫𑆓𑆶𑆢𑆁 𑆖𑆳𑆣𑆫𑆓𑆶𑆢𑆁 𑆖 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆖 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆖 𑆮𑆳𑆥𑆳 𑆖 𑆮𑆥𑆳𑆮𑆲𑆤𑆁 𑆖𑆼𑆠𑆴 (𑆩𑆳𑆠𑆸𑆘𑆳𑆤𑆴)𑇆𑇖𑇆
𑆥𑆴𑆠𑆸𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂𑇅 𑆤𑆲𑆴 𑆥𑆴𑆠𑆶𑆫𑆸𑆠𑆼 𑆓𑆫𑇀𑆨𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆖 𑆘𑆤𑇀𑆩 𑆘𑆫𑆳𑆪𑆶𑆘𑆳𑆤𑆳𑆩𑇀𑇅 𑆪𑆳𑆤𑆴 𑆒𑆬𑇀𑆮𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆥𑆴𑆠𑆸𑆘𑆳𑆤𑆴, 𑆪𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆥𑆴𑆠𑆸𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆤𑆒𑆬𑆾𑆩𑆢𑆤𑇀𑆠𑆳𑆱𑇀𑆡𑆴𑆱𑆴𑆫𑆳𑆱𑇀𑆤𑆳𑆪𑆶𑆣𑆩𑆤𑇀𑆪𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆖𑆼𑆠𑆴 (𑆥𑆴𑆠𑆸𑆘𑆳𑆤𑆴)𑇆𑇗𑇆
𑆄𑆠𑇀𑆩𑆘𑆯𑇀𑆖𑆳𑆪𑆁 𑆓𑆫𑇀𑆨𑆂𑇅 𑆓𑆫𑇀𑆨𑆳𑆠𑇀𑆩𑆳 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑆳𑆠𑇀𑆩𑆳 𑆪𑆂, 𑆠𑆁 ‘𑆘𑆵𑆮’ 𑆅𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆯𑆳𑆯𑇀𑆮𑆠𑆩𑆫𑆶𑆘𑆩𑆘𑆫𑆩𑆩𑆫𑆩𑆑𑇀𑆰𑆪𑆩𑆨𑆼𑆢𑇀𑆪𑆩𑆖𑇀𑆗𑆼𑆢𑇀𑆪𑆩𑆬𑆾𑆝𑇀𑆪𑆁 𑆮𑆴𑆯𑇀𑆮𑆫𑆷𑆥𑆁 𑆮𑆴𑆯𑇀𑆮𑆑𑆫𑇀𑆩𑆳𑆟𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆩𑆤𑆳𑆢𑆴𑆩𑆤𑆴𑆣𑆤𑆩𑆑𑇀𑆰𑆫𑆩𑆥𑆴𑇅 𑆱 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆪𑆾𑆓𑆩𑆼𑆠𑇀𑆪 𑆓𑆫𑇀𑆨𑆠𑇀𑆮𑆼𑆤 𑆘𑆤𑆪𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆩𑇀, 𑆄𑆠𑇀𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆲𑆴 𑆓𑆫𑇀𑆨𑆼𑇅 𑆠𑆱𑇀𑆪 𑆥𑆶𑆤𑆫𑆳𑆠𑇀𑆩𑆤𑆾 𑆘𑆤𑇀𑆩𑆳𑆤𑆳𑆢𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆘𑆳𑆠 𑆍𑆮𑆳𑆪𑆩𑆘𑆳𑆠𑆁 𑆓𑆫𑇀𑆨𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆃𑆘𑆳𑆠𑆾 𑆲𑇀𑆪𑆪𑆩𑆘𑆳𑆠𑆁 𑆓𑆫𑇀𑆨𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆱 𑆖𑆽𑆮 𑆓𑆫𑇀𑆨𑆂 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆧𑆳𑆬𑆪𑆶𑆮𑆱𑇀𑆡𑆮𑆴𑆫𑆨𑆳𑆮𑆳𑆤𑇀 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴, 𑆱 𑆪𑆱𑇀𑆪𑆳𑆁 𑆪𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆁 𑆮𑆫𑇀𑆠𑆠𑆼 𑆠𑆱𑇀𑆪𑆳𑆁 𑆠𑆱𑇀𑆪𑆳𑆁 𑆘𑆳𑆠𑆾 𑆨𑆮𑆠𑆴, 𑆪𑆳 𑆠𑇀𑆮𑆱𑇀𑆪 𑆥𑆶𑆫𑆱𑇀𑆑𑆸𑆠𑆳𑆠𑆱𑇀𑆪𑆳𑆁 𑆘𑆤𑆴𑆰𑇀𑆪𑆩𑆳𑆟𑆯𑇀𑆖, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱 𑆍𑆮 𑆘𑆳𑆠𑆯𑇀𑆖𑆳𑆘𑆳𑆠𑆯𑇀𑆖 𑆪𑆶𑆓𑆥𑆢𑇀𑆨𑆮𑆠𑆴; 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆽𑆠𑆢𑆶𑆨𑆪𑆁 𑆱𑆩𑇀𑆨𑆮𑆠𑆴 𑆘𑆳𑆠𑆠𑇀𑆮𑆁 𑆘𑆤𑆴𑆰𑇀𑆪𑆩𑆳𑆟𑆠𑇀𑆮𑆁 𑆖 𑆱 𑆘𑆳𑆠𑆾 𑆘𑆤𑇀𑆪𑆠𑆼, 𑆱 𑆖𑆽𑆮𑆳𑆤𑆳𑆓𑆠𑆼𑆰𑇀𑆮𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑇀𑆮𑆘𑆳𑆠𑆾 𑆘𑆤𑇀𑆪𑆪𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆳𑇁𑇁𑆠𑇀𑆩𑆳𑆤𑆩𑇀𑇅 𑆱𑆠𑆾 𑆲𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆓𑆩𑆤𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆮 𑆲𑆴 𑆘𑆤𑇀𑆩 𑆖𑆾𑆖𑇀𑆪𑆠𑆼 𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫 𑆮𑆪𑆱𑆴 𑆠𑆱𑇀𑆪𑆳𑆁 𑆠𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆁; 𑆪𑆡𑆳- 𑆱𑆠𑆳𑆩𑆼𑆮 𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆘𑆵𑆮𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆑𑇀 𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆠𑇀𑆮𑆁 𑆤 𑆨𑆮𑆠𑆴, 𑆠𑆖𑇀𑆖 𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆨𑆮𑆠𑆴; 𑆪𑆡𑆳- 𑆱𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆽𑆮 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆓𑆥𑆠𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑆸𑆠𑇀𑆮𑆁 𑆤 𑆨𑆮𑆠𑆴, 𑆠𑆖𑇀𑆖𑆳𑆥𑆠𑇀𑆪𑆳𑆢𑇀𑆨𑆮𑆠𑆴; 𑆠𑆡𑆳 𑆱𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆽𑆮 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆠𑆱𑇀𑆪𑆳𑆁 𑆠𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆁 𑆘𑆳𑆠𑆠𑇀𑆮𑆩𑆘𑆳𑆠𑆠𑇀𑆮𑆁 𑆖𑆾𑆖𑇀𑆪𑆠𑆼𑇆𑇘𑇆
𑆤 𑆒𑆬𑆶 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆤 𑆖 𑆩𑆳𑆠𑆶𑆫𑇀𑆤 𑆥𑆴𑆠𑆶𑆫𑇀𑆤 𑆖𑆳𑆠𑇀𑆩𑆤𑆂 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆼𑆰𑆶 𑆪𑆡𑆼𑆰𑇀𑆛𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆩𑆱𑇀𑆠𑆴; 𑆠𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑇀𑆮𑆮𑆯𑆳𑆠𑇀 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴, 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆑𑆫𑇀𑆩𑆮𑆯𑆳𑆠𑇀, 𑆑𑇀𑆮𑆖𑆴𑆖𑇀𑆖𑆽𑆰𑆳𑆁 𑆑𑆫𑆟𑆯𑆑𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆠𑆴, 𑆑𑇀𑆮𑆖𑆴𑆤𑇀𑆤 𑆨𑆮𑆠𑆴𑇅 𑆪𑆠𑇀𑆫 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑆴𑆑𑆫𑆟𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆠𑇀𑆫 𑆪𑆡𑆳𑆧𑆬𑆩𑆼𑆮 𑆪𑆡𑆼𑆰𑇀𑆛𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆩𑇀, 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆂𑇅 𑆤 𑆖 𑆑𑆫𑆟𑆢𑆾𑆰𑆳𑆢𑆑𑆫𑆟𑆩𑆳𑆠𑇀𑆩𑆳𑆱𑆩𑇀𑆨𑆮𑆠𑆴 𑆓𑆫𑇀𑆨𑆘𑆤𑆤𑆼, 𑆢𑆸𑆰𑇀𑆛𑆁 𑆖𑆼𑆰𑇀𑆛𑆳 𑆪𑆾𑆤𑆴𑆫𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆁 𑆩𑆾𑆑𑇀𑆰𑆯𑇀𑆖𑆳𑆠𑇀𑆩𑆮𑆴𑆢𑇀𑆨𑆴𑆫𑆳𑆠𑇀𑆩𑆳𑆪𑆠𑇀𑆠𑆩𑇀𑇅 𑆤𑆲𑇀𑆪𑆤𑇀𑆪𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆪𑆾𑆂 𑆑𑆫𑇀𑆠𑆳𑇅 𑆤 𑆖𑆳𑆤𑇀𑆪𑆠𑆾 𑆓𑆫𑇀𑆨𑆾 𑆘𑆳𑆪𑆠𑆼 𑆘𑆳𑆪𑆩𑆳𑆤𑆂, 𑆤𑆳𑆕𑇀𑆑𑆶𑆫𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆧𑆵𑆘𑆳𑆠𑇀𑇆𑇙𑇆
𑆪𑆳𑆤𑆴 𑆠𑆶 𑆒𑆬𑇀𑆮𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆪𑆳𑆠𑇀𑆩𑆘𑆳𑆤𑆴, 𑆪𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪𑆳𑆠𑇀𑆩𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑆳𑆱𑆶 𑆠𑆳𑆱𑆶 𑆪𑆾𑆤𑆴𑆰𑆷𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆳𑆪𑆶𑆫𑆳𑆠𑇀𑆩𑆘𑇀𑆚𑆳𑆤𑆁 𑆩𑆤 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆥𑇀𑆫𑆳𑆟𑆳𑆥𑆳𑆤𑆿 𑆥𑇀𑆫𑆼𑆫𑆟𑆁 𑆣𑆳𑆫𑆟𑆩𑆳𑆑𑆸𑆠𑆴𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆼 𑆅𑆖𑇀𑆗𑆳𑆢𑇀𑆮𑆼𑆰𑆿 𑆖𑆼𑆠𑆤𑆳 𑆣𑆸𑆠𑆴𑆫𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑆲𑆕𑇀𑆑𑆳𑆫𑆂 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆯𑇀𑆖𑆼𑆠𑆴 (𑆄𑆠𑇀𑆩𑆘𑆳𑆤𑆴)𑇆𑇑𑇐𑇆
𑆪𑆖𑇀𑆖𑆾𑆑𑇀𑆠𑆁- 𑆪𑆢𑆴 𑆖 𑆩𑆤𑆶𑆰𑇀𑆪𑆾 𑆩𑆤𑆶𑆰𑇀𑆪𑆥𑇀𑆫𑆨𑆮𑆂, 𑆑𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆘𑆝𑆳𑆢𑆴𑆨𑇀𑆪𑆾 𑆘𑆳𑆠𑆳𑆂 𑆥𑆴𑆠𑆸𑆱𑆢𑆸𑆯𑆫𑆷𑆥𑆳 𑆨𑆮𑆤𑇀𑆠𑆵𑆠𑆴; 𑆠𑆠𑇀𑆫𑆾𑆖𑇀𑆪𑆠𑆼- 𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆲𑇀𑆪𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆱𑇀𑆪 𑆧𑆵𑆘𑆼 𑆧𑆵𑆘 𑆨𑆳𑆓 𑆇𑆥𑆠𑆥𑇀𑆠𑆾 𑆨𑆮𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆠𑆱𑇀𑆪𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆱𑇀𑆪 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼, 𑆤𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑆖𑆳𑆤𑆶𑆥𑆠𑆳𑆥𑆳𑆠𑇀; 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆨𑆪𑆾𑆥𑆥𑆠𑇀𑆠𑆴𑆫𑆥𑇀𑆪𑆠𑇀𑆫𑇅 𑆱𑆫𑇀𑆮𑆱𑇀𑆪 𑆖𑆳𑆠𑇀𑆩𑆘𑆳𑆤𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴, 𑆠𑆼𑆰𑆳𑆁 𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆲𑆼𑆠𑆶𑆫𑇀𑆢𑆽𑆮𑆁; 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆽𑆑𑆳𑆤𑇀𑆠𑆠𑆾 𑆘𑆝𑆳𑆢𑆴𑆨𑇀𑆪𑆾 𑆘𑆳𑆠𑆳𑆂 𑆥𑆴𑆠𑆸𑆱𑆢𑆸𑆯𑆫𑆷𑆥𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇗𑇆
𑆤 𑆖𑆳𑆠𑇀𑆩𑆳 𑆱𑆠𑇀𑆱𑇀𑆮𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆰𑆶 𑆘𑇀𑆚𑆂, 𑆃𑆱𑆠𑇀𑆱𑆶 𑆮𑆳 𑆨𑆮𑆠𑇀𑆪𑆘𑇀𑆚𑆂; 𑆤 𑆲𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆂 𑆑𑆢𑆳𑆖𑆴𑆢𑆳𑆠𑇀𑆩𑆳, 𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆯𑆼𑆰 𑆅𑆠𑆴𑇆𑇑𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆤 𑆑𑆫𑇀𑆠𑆶𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆨𑆳𑆮𑆳𑆠𑇀 𑆑𑆳𑆫𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆪𑆳 𑆑𑇀𑆫𑆴𑆪𑆳 𑆮𑆫𑇀𑆠𑆠𑆼 𑆨𑆳𑆮𑆽𑆂 𑆱𑆳 𑆮𑆴𑆤𑆳 𑆠𑆽𑆫𑇀𑆤 𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇑𑇙𑇆
𑆘𑆳𑆤𑆤𑇀𑆤𑆥𑆴 𑆩𑆸𑆢𑆾𑇁𑆨𑆳𑆮𑆳𑆠𑇀 𑆑𑆶𑆩𑇀𑆨𑆑𑆸𑆤𑇀𑆤 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅𑇒𑇐𑇅 𑆯𑇀𑆫𑆷𑆪𑆠𑆳𑆁 𑆖𑆼𑆢𑆩𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆩𑆳𑆠𑇀𑆩𑆘𑇀𑆚𑆳𑆤𑆧𑆬𑆁 𑆩𑆲𑆠𑇀𑇆𑇒𑇐𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆖 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆩𑆤𑆂 𑆱𑆕𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆖𑆚𑇀𑆖𑆬𑆩𑇀𑇅 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆩𑆳𑆠𑇀𑆩𑆘𑇀𑆚𑆂 𑆱𑇀𑆮𑆼 𑆘𑇀𑆚𑆳𑆤𑆼 𑆥𑆫𑇀𑆪𑆮𑆱𑇀𑆡𑆴𑆠𑆂𑇆𑇒𑇑𑇆
𑆱𑆫𑇀𑆮𑆠𑇀𑆫𑆳𑆮𑆲𑆴𑆠𑆘𑇀𑆚𑆳𑆤𑆂 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆠𑆼𑇅𑇒𑇒𑇅 𑆓𑆸𑆲𑇀𑆟𑆵𑆰𑇀𑆮 𑆖𑆼(𑆮𑆼)𑆢𑆩𑆥𑆫𑆁 𑆨𑆫𑆢𑇀𑆮𑆳𑆘 𑆮𑆴𑆤𑆴𑆫𑇀𑆟𑆪𑆩𑇀𑇆𑇒𑇒𑇆
𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆳𑆑𑇀𑆖𑆼𑆰𑇀𑆛𑆂 𑆱𑆶𑆥𑇀𑆠𑆂 𑆱𑇀𑆮𑆥𑇀𑆤𑆓𑆠𑆾 𑆪𑆢𑆳𑇅 𑆮𑆴𑆰𑆪𑆳𑆤𑇀 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆼 𑆖 𑆮𑆼𑆠𑇀𑆠𑆴 𑆤𑆳𑆘𑇀𑆚𑆾𑇁𑆥𑇀𑆪𑆠𑆂 𑆱𑇀𑆩𑆸𑆠𑆂𑇆𑇒𑇓𑇆
𑆤𑆳𑆠𑇀𑆩𑆘𑇀𑆚𑆳𑆤𑆳𑆢𑆸𑆠𑆼 𑆖𑆽𑆑𑆁 𑆘𑇀𑆚𑆳𑆤𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆤 𑆲𑇀𑆪𑆼𑆑𑆾 𑆮𑆫𑇀𑆠𑆠𑆼 𑆨𑆳𑆮𑆾 𑆮𑆫𑇀𑆠𑆠𑆼 𑆤𑆳𑆥𑇀𑆪𑆲𑆼𑆠𑆶𑆑𑆂𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑇀𑆚𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑇀𑆖𑆳𑆠𑇀𑆩𑆳 𑆢𑇀𑆫𑆰𑇀𑆛𑆳 𑆑𑆳𑆫𑆟𑆩𑆼𑆮 𑆖𑇅 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆢𑇀𑆨𑆫𑆢𑇀𑆮𑆳𑆘 𑆤𑆴𑆫𑇀𑆟𑆵𑆠𑆁 𑆘𑆲𑆴 𑆱𑆁𑆯𑆪𑆩𑇀𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆲𑆼𑆠𑆶𑆫𑇀𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆿 𑆮𑆸𑆢𑇀𑆣𑆿 𑆘𑆤𑇀𑆩𑆤𑆴 𑆖𑆽𑆮 𑆪𑆂𑇅 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑆠𑆴𑆫𑇀𑆪𑆳 𑆖 𑆨𑆫𑆢𑇀𑆮𑆳𑆘𑆩𑆠𑆴𑆯𑇀𑆖 𑆪𑆳𑇆𑇒𑇖𑇆
𑆥𑇀𑆫𑆠𑆴𑆘𑇀𑆚𑆳𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆯𑇀𑆖 𑆮𑆴𑆯𑆢𑆯𑇀𑆖𑆳𑆠𑇀𑆩𑆤𑆴𑆫𑇀𑆟𑆪𑆂𑇅 𑆓𑆫𑇀𑆨𑆳𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆩𑆶𑆢𑇀𑆢𑆴𑆯𑇀𑆪 𑆒𑆶𑆝𑇀𑆝𑆵𑆑𑆳𑆁 𑆠𑆠𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀𑇆𑇒𑇗𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆲𑆠𑆵𑆁 𑆓𑆫𑇀𑆨𑆳𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆪𑆠𑆯𑇀𑆖 𑆓𑆫𑇀𑆨𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆴, 𑆪𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆓𑆫𑇀𑆨𑆱𑆚𑇀𑆘𑇀𑆚𑆳, 𑆪𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆯𑇀𑆖 𑆓𑆫𑇀𑆨𑆂, 𑆪𑆪𑆳 𑆖𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆠𑆼 𑆑𑆶𑆑𑇀𑆰𑆿, 𑆪𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑆼𑆠𑆶𑆂, 𑆪𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆳𑆘𑆤𑇀𑆩 𑆨𑆮𑆠𑆴, 𑆪𑆠𑆯𑇀𑆖 𑆘𑆳𑆪𑆩𑆳𑆤𑆂 𑆑𑆶𑆑𑇀𑆰𑆿 𑆮𑆴𑆤𑆳𑆯𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴, 𑆪𑆠𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤𑆳𑆮𑆴𑆤𑆯𑇀𑆪𑆤𑇀 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇆
𑆩𑆳𑆠𑆸𑆠𑆂 𑆥𑆴𑆠𑆸𑆠 𑆄𑆠𑇀𑆩𑆠𑆂 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆾 𑆫𑆱𑆠𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆠 𑆅𑆠𑇀𑆪𑆼𑆠𑆼𑆨𑇀𑆪𑆾 𑆨𑆳𑆮𑆼𑆨𑇀𑆪𑆂 𑆱𑆩𑆶𑆢𑆴𑆠𑆼𑆨𑇀𑆪𑆾 𑆓𑆫𑇀𑆨𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆴𑇅 𑆠𑆱𑇀𑆪 𑆪𑆼 𑆪𑆼𑇁𑆮𑆪𑆮𑆳 𑆪𑆠𑆾 𑆪𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆠𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆳𑆤𑇀 𑆮𑆴𑆨𑆘𑇀𑆪 𑆩𑆳𑆠𑆸𑆘𑆳𑆢𑆵𑆤𑆮𑆪𑆮𑆳𑆤𑇀 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆫𑆼𑇆𑇔𑇆
𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆘𑆵𑆮𑆱𑆁𑆪𑆾𑆓𑆼 𑆠𑆶 𑆒𑆬𑆶 𑆑𑆶𑆑𑇀𑆰𑆴𑆓𑆠𑆼 𑆓𑆫𑇀𑆨𑆱𑆚𑇀𑆘𑇀𑆚𑆳 𑆨𑆮𑆠𑆴𑇆𑇕𑇆
𑆓𑆫𑇀𑆨𑆱𑇀𑆠𑆶 𑆒𑆬𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆠𑆾𑆪𑆨𑆷𑆩𑆴𑆮𑆴𑆑𑆳𑆫𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆷𑆠𑆂𑇅 𑆍𑆮𑆩𑆤𑆪𑆳 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑆶𑆢𑆳𑆪𑆳𑆠𑇀𑆩𑆑𑆾 𑆓𑆫𑇀𑆨𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆷𑆠𑆂; 𑆱 𑆲𑇀𑆪𑆱𑇀𑆪 𑆰𑆰𑇀𑆜𑆾 𑆣𑆳𑆠𑆶𑆫𑆶𑆑𑇀𑆠𑆂𑇆𑇖𑇆
𑆪𑆪𑆳 𑆖𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆠𑆼 𑆑𑆶𑆑𑇀𑆰𑆿 𑆠𑆳𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆓𑆠𑆼 𑆥𑆶𑆫𑆳𑆟𑆼 𑆫𑆘𑆱𑆴 𑆤𑆮𑆼 𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆼 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆤𑆳𑆠𑆳𑆁 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆩𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆪𑆾𑆤𑆴𑆯𑆾𑆟𑆴𑆠𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆳𑆩𑆸𑆠𑆶𑆩𑆠𑆵𑆩𑆳𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼𑇅 𑆠𑆪𑆳 𑆱𑆲 𑆠𑆡𑆳𑆨𑆷𑆠𑆪𑆳 𑆪𑆢𑆳 𑆥𑆶𑆩𑆳𑆤𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆧𑆵𑆘𑆾 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆁 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆠𑆢𑆳 𑆠𑆱𑇀𑆪 𑆲𑆫𑇀𑆰𑆾𑆢𑆵𑆫𑆴𑆠𑆂 𑆥𑆫𑆂 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆳 𑆯𑆶𑆑𑇀𑆫𑆨𑆷𑆠𑆾𑇁𑆕𑇀𑆓𑆳𑆢𑆕𑇀𑆓𑆳𑆠𑇀 𑆱𑆩𑇀𑆨𑆮𑆠𑆴𑇅 𑆱 𑆠𑆡𑆳 𑆲𑆫𑇀𑆰𑆨𑆷𑆠𑆼𑆤𑆳𑆠𑇀𑆩𑆤𑆾𑆢𑆵𑆫𑆴𑆠𑆯𑇀𑆖𑆳𑆣𑆴𑆰𑇀𑆜𑆴𑆠𑆯𑇀𑆖 𑆧𑆵𑆘𑆫𑆷𑆥𑆾 𑆣𑆳𑆠𑆶𑆂 𑆥𑆶𑆫𑆶𑆰𑆯𑆫𑆵𑆫𑆳𑆢𑆨𑆴𑆤𑆴𑆰𑇀𑆥𑆠𑇀𑆠𑇀𑆪𑆾𑆖𑆴𑆠𑆼𑆤 𑆥𑆡𑆳 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆫𑇀𑆠𑆮𑆼𑆤𑆳𑆨𑆴𑆱𑆁𑆱𑆫𑇀𑆓𑆩𑆼𑆠𑆴𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆁 𑆖𑆼𑆠𑆤𑆳𑆣𑆳𑆠𑆶𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆑𑆫𑆟𑆾 𑆓𑆶𑆟𑆓𑇀𑆫𑆲𑆟𑆳𑆪 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼; 𑆱 𑆲𑆴 𑆲𑆼𑆠𑆶𑆂 𑆑𑆳𑆫𑆟𑆁 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆑𑇀𑆰𑆫𑆁 𑆑𑆫𑇀𑆠𑆳 𑆩𑆤𑇀𑆠𑆳 𑆮𑆼𑆢𑆴𑆠𑆳 𑆧𑆾𑆢𑇀𑆣𑆳 𑆢𑇀𑆫𑆰𑇀𑆛𑆳 𑆣𑆳𑆠𑆳 𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆮𑆴𑆯𑇀𑆮𑆑𑆫𑇀𑆩𑆳 𑆮𑆴𑆯𑇀𑆮𑆫𑆷𑆥𑆂 𑆥𑆶𑆫𑆶𑆰𑆂 𑆥𑇀𑆫𑆨𑆮𑆾𑇁𑆮𑇀𑆪𑆪𑆾 𑆤𑆴𑆠𑇀𑆪𑆾 𑆓𑆶𑆟𑆵 𑆓𑇀𑆫𑆲𑆟𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆮𑇀𑆪𑆑𑇀𑆠𑆁 𑆘𑆵𑆮𑆾 𑆘𑇀𑆚𑆂 𑆥𑆶𑆢𑇀𑆓𑆬𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆮𑆳𑆤𑇀 𑆮𑆴𑆨𑆶𑆫𑇀𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆳 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆠𑇀𑆩𑆳 𑆖𑆳𑆤𑇀𑆠𑆫𑆳𑆠𑇀𑆩𑆳 𑆖𑆼𑆠𑆴𑇅 𑆱 𑆓𑆶𑆟𑆾𑆥𑆳𑆢𑆳𑆤𑆑𑆳𑆬𑆼𑇁𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆁 𑆥𑆷𑆫𑇀𑆮𑆠𑆫𑆩𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆓𑆶𑆟𑆼𑆨𑇀𑆪 𑆇𑆥𑆳𑆢𑆠𑇀𑆠𑆼, 𑆪𑆡𑆳- 𑆥𑇀𑆫𑆬𑆪𑆳𑆠𑇀𑆪𑆪𑆼 𑆱𑆴𑆱𑆸𑆑𑇀𑆰𑆶𑆫𑇀𑆨𑆷𑆠𑆳𑆤𑇀𑆪𑆑𑇀𑆰𑆫𑆨𑆷𑆠 𑆄𑆠𑇀𑆩𑆳 𑆱𑆠𑇀𑆠𑇀𑆮𑆾𑆥𑆳𑆢𑆳𑆤𑆂 𑆥𑆷𑆫𑇀𑆮𑆠𑆫𑆩𑆳𑆑𑆳𑆯𑆁 𑆱𑆸𑆘𑆠𑆴, 𑆠𑆠𑆂 𑆑𑇀𑆫𑆩𑆼𑆟 𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆫𑆓𑆶𑆟𑆳𑆤𑇀 𑆣𑆳𑆠𑆷𑆤𑇀 𑆮𑆳𑆪𑇀𑆮𑆳𑆢𑆴𑆑𑆳𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆂; 𑆠𑆡𑆳 𑆢𑆼𑆲𑆓𑇀𑆫𑆲𑆟𑆼𑇁𑆥𑆴 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆂 𑆥𑆷𑆫𑇀𑆮𑆠𑆫𑆩𑆳𑆑𑆳𑆯𑆩𑆼𑆮𑆾𑆥𑆳𑆢𑆠𑇀𑆠𑆼, 𑆠𑆠𑆂 𑆑𑇀𑆫𑆩𑆼𑆟 𑆮𑇀𑆪𑆑𑇀𑆠𑆠𑆫𑆓𑆶𑆟𑆳𑆤𑇀 𑆣𑆳𑆠𑆷𑆤𑇀 𑆮𑆳𑆪𑇀𑆮𑆳𑆢𑆴𑆑𑆳𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆂𑇅 𑆱𑆫𑇀𑆮𑆩𑆥𑆴 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆠𑆢𑇀𑆓𑆶𑆟𑆾𑆥𑆳𑆢𑆳𑆤𑆩𑆟𑆶𑆤𑆳 𑆑𑆳𑆬𑆼𑆤 𑆨𑆮𑆠𑆴𑇆𑇘𑇆
𑆱 𑆱𑆫𑇀𑆮𑆓𑆶𑆟𑆮𑆳𑆤𑇀 𑆓𑆫𑇀𑆨𑆠𑇀𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆂 𑆥𑇀𑆫𑆡𑆩𑆼 𑆩𑆳𑆱𑆴 𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆂 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆑𑆬𑆶𑆰𑆵𑆑𑆸𑆠𑆂 𑆒𑆼𑆛𑆨𑆷𑆠𑆾 𑆨𑆮𑆠𑇀𑆪𑆮𑇀𑆪𑆑𑇀𑆠𑆮𑆴𑆓𑇀𑆫𑆲𑆂 𑆱𑆢𑆱𑆢𑇀𑆨𑆷𑆠𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆂𑇆𑇙𑇆
𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆩𑆳𑆱𑆴 𑆔𑆤𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆥𑆴𑆟𑇀𑆝𑆂 𑆥𑆼𑆯𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆁 𑆮𑆳𑇅 𑆠𑆠𑇀𑆫 𑆔𑆤𑆂 𑆥𑆶𑆫𑆶𑆰𑆂, 𑆥𑆼𑆯𑆵 𑆱𑇀𑆠𑇀𑆫𑆵, 𑆃𑆫𑇀𑆧𑆶𑆢𑆁 𑆤𑆥𑆶𑆁𑆱𑆑𑆩𑇀𑇆𑇑𑇐𑇆
𑆠𑆸𑆠𑆵𑆪𑆼 𑆩𑆳𑆱𑆴 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆯𑇀𑆖 𑆪𑆿𑆓𑆥𑆢𑇀𑆪𑆼𑆤𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫𑆳𑆱𑇀𑆪 𑆑𑆼𑆖𑆴𑆢𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳 𑆩𑆳𑆠𑆸𑆘𑆳𑆢𑆵𑆤𑆮𑆪𑆮𑆳𑆤𑇀 𑆮𑆴𑆨𑆘𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆳 𑆪𑆡𑆳𑆮𑆠𑇀𑇅 𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆠𑇀𑆮𑆴𑆢𑆳𑆤𑆵𑆩𑆱𑇀𑆪 𑆠𑆳𑆁𑆯𑇀𑆖𑆽𑆮𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆤𑇀 𑆑𑆳𑆁𑆯𑇀𑆖𑆴𑆠𑇀 𑆥𑆫𑇀𑆪𑆳𑆪𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆥𑆫𑆳𑆁𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆩𑆳𑆠𑆸𑆘𑆳𑆢𑆪𑆾𑇁𑆥𑇀𑆪𑆱𑇀𑆪 𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆳 𑆍𑆮𑇅 𑆠𑆠𑇀𑆫𑆳𑆱𑇀𑆪𑆳𑆑𑆳𑆯𑆳𑆠𑇀𑆩𑆑𑆁 𑆯𑆧𑇀𑆢𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆬𑆳𑆔𑆮𑆁 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆁 𑆮𑆴𑆮𑆼𑆑𑆯𑇀𑆖, 𑆮𑆳𑆪𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆥𑇀𑆫𑆼𑆫𑆟𑆁 𑆣𑆳𑆠𑆶𑆮𑇀𑆪𑆷𑆲𑆤𑆁 𑆖𑆼𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆯𑆳𑆫𑆵𑆫𑇀𑆪𑆂, 𑆃𑆓𑇀𑆤𑇀𑆪𑆳𑆠𑇀𑆩𑆑𑆁 𑆫𑆷𑆥𑆁 𑆢𑆫𑇀𑆯𑆤𑆁 𑆥𑇀𑆫𑆑𑆳𑆯𑆂 𑆥𑆑𑇀𑆠𑆴𑆫𑆿𑆰𑇀𑆟𑇀𑆪𑆁 𑆖, 𑆃𑆧𑆳𑆠𑇀𑆩𑆑𑆁 𑆫𑆱𑆾 𑆫𑆱𑆤𑆁 𑆯𑆽𑆠𑇀𑆪𑆁 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆂 𑆑𑇀𑆬𑆼𑆢𑆯𑇀𑆖, 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆠𑇀𑆩𑆑𑆁 𑆓𑆤𑇀𑆣𑆾 𑆔𑇀𑆫𑆳𑆟𑆁 𑆓𑆿𑆫𑆮𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆁 𑆩𑆷𑆫𑇀𑆠𑆴𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇒𑇆
𑆍𑆮𑆩𑆪𑆁 𑆬𑆾𑆑𑆱𑆩𑇀𑆩𑆴𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆂𑇅 𑆪𑆳𑆮𑆤𑇀𑆠𑆾 𑆲𑆴 𑆬𑆾𑆑𑆼 𑆩𑆷𑆫𑇀𑆠𑆴𑆩𑆤𑇀𑆠𑆾 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆼, 𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆼 𑆠𑆳𑆮𑆤𑇀𑆠𑆾 𑆬𑆾𑆑𑆼 𑆅𑆠𑆴; 𑆧𑆶𑆣𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆮𑆁 𑆢𑇀𑆫𑆰𑇀𑆛𑆶𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴𑇆𑇑𑇓𑇆
𑆍𑆮𑆩𑆱𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑇀𑆪𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆯𑇀𑆖 𑆪𑆿𑆓𑆥𑆢𑇀𑆪𑆼𑆤𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼𑇁𑆤𑇀𑆪𑆠𑇀𑆫 𑆠𑆼𑆨𑇀𑆪𑆾 𑆨𑆳𑆮𑆼𑆨𑇀𑆪𑆾 𑆪𑆼𑇁𑆱𑇀𑆪 𑆘𑆳𑆠𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆘𑆳𑆪𑆤𑇀𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆤𑇀𑆠𑆳 𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆤𑆴 𑆮𑇀𑆪𑆑𑇀𑆠𑆵𑆨𑆳𑆮𑆱𑇀𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆥𑆫𑆳𑆟𑆴𑇅 𑆍𑆰𑆳 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆂, 𑆮𑆴𑆑𑆸𑆠𑆴𑆂 𑆥𑆶𑆤𑆫𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇅 𑆱𑆤𑇀𑆠𑆴 𑆒𑆬𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀 𑆓𑆫𑇀𑆨𑆼 𑆑𑆼𑆖𑆴𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆳 𑆨𑆳𑆮𑆳𑆂, 𑆱𑆤𑇀𑆠𑆴 𑆖𑆳𑆤𑆴𑆠𑇀𑆪𑆳𑆂 𑆑𑆼𑆖𑆴𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆪 𑆍𑆮𑆳𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆂 𑆱𑆤𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼, 𑆠 𑆍𑆮 𑆱𑇀𑆠𑇀𑆫𑆵𑆬𑆴𑆕𑇀𑆓𑆁 𑆥𑆶𑆫𑆶𑆰𑆬𑆴𑆕𑇀𑆓𑆁 𑆤𑆥𑆶𑆁𑆱𑆑𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑆳 𑆧𑆴𑆨𑇀𑆫𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆪𑆾𑆫𑇀𑆪𑆼 𑆮𑆽𑆯𑆼𑆰𑆴𑆑𑆳 𑆨𑆳𑆮𑆳𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆱𑆁𑆯𑇀𑆫𑆪𑆳 𑆓𑆶𑆟𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆯𑇀𑆖, 𑆠𑆼𑆰𑆳𑆁 𑆪𑆠𑆾 𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆮𑆁 𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆫𑆨𑆳𑆮𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑇀𑆬𑆽𑆧𑇀𑆪𑆁 𑆨𑆵𑆫𑆶𑆠𑇀𑆮𑆩𑆮𑆽𑆯𑆳𑆫𑆢𑇀𑆪𑆁 𑆩𑆾𑆲𑆾𑇁𑆤𑆮𑆱𑇀𑆡𑆳𑆤𑆩𑆣𑆾𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆩𑆱𑆲𑆤𑆁 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆧𑆵𑆘𑆨𑆳𑆓𑆱𑇀𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆥𑆫𑆳𑆟𑆴 𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑆳𑆟𑆴, 𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆥𑆶𑆫𑆶𑆰𑆑𑆫𑆳𑆟𑆴, 𑆇𑆨𑆪𑆨𑆳𑆓𑆳𑆮𑆪𑆮𑆳 𑆤𑆥𑆶𑆁𑆱𑆑𑆑𑆫𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇔𑇆
𑆠𑆱𑇀𑆪 𑆪𑆠𑇀𑆑𑆳𑆬𑆩𑆼𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆱𑆤𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼, 𑆠𑆠𑇀𑆑𑆳𑆬𑆩𑆼𑆮 𑆖𑆼𑆠𑆱𑆴 𑆮𑆼𑆢𑆤𑆳 𑆤𑆴𑆫𑇀𑆧𑆤𑇀𑆣𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆓𑆫𑇀𑆨𑆂 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼, 𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆪𑆠𑆼 𑆖 𑆘𑆤𑇀𑆩𑆳𑆤𑇀𑆠𑆫𑆳𑆤𑆶𑆨𑆷𑆠𑆁 𑆪𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀, 𑆠𑆢𑇀𑆢𑇀𑆮𑆽𑆲𑆸𑆢𑆪𑇀𑆪𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆮𑆸𑆢𑇀𑆣𑆳𑆂𑇅 𑆩𑆳𑆠𑆸𑆘𑆁 𑆖𑆳𑆱𑇀𑆪 𑆲𑆸𑆢𑆪𑆁 𑆩𑆳𑆠𑆸𑆲𑆸𑆢𑆪𑆼𑆤𑆳𑆨𑆴𑆱𑆩𑇀𑆧𑆢𑇀𑆣𑆁 𑆨𑆮𑆠𑆴 𑆫𑆱𑆮𑆳𑆲𑆴𑆤𑆵𑆨𑆴𑆂 𑆱𑆁𑆮𑆳𑆲𑆴𑆤𑆵𑆨𑆴𑆂; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆪𑆾𑆱𑇀𑆠𑆳𑆨𑆴𑆫𑇀𑆨𑆑𑇀𑆠𑆴𑆂 𑆱𑆁𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑇅 𑆠𑆖𑇀𑆖𑆽𑆮 𑆑𑆳𑆫𑆟𑆩𑆮𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆳 𑆤 𑆢𑇀𑆮𑆽𑆲𑆸𑆢𑆪𑇀𑆪𑆱𑇀𑆪 𑆮𑆴𑆩𑆳𑆤𑆴𑆠𑆁 𑆓𑆫𑇀𑆨𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆑𑆫𑇀𑆠𑆶𑆩𑇀𑇅 𑆮𑆴𑆩𑆳𑆤𑆤𑆼 𑆲𑇀𑆪𑆱𑇀𑆪 𑆢𑆸𑆯𑇀𑆪𑆠𑆼 𑆮𑆴𑆤𑆳𑆯𑆾 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑇀𑆮𑆳𑇅 𑆱𑆩𑆳𑆤𑆪𑆾𑆓𑆑𑇀𑆰𑆼𑆩𑆳 𑆲𑆴 𑆠𑆢𑆳 𑆨𑆮𑆠𑆴 𑆓𑆫𑇀𑆨𑆼𑆟 𑆑𑆼𑆰𑆶𑆖𑆴𑆢𑆫𑇀𑆡𑆼𑆰𑆶 𑆩𑆳𑆠𑆳𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆴𑆪𑆲𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆾𑆥𑆖𑆫𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇆𑇑𑇕𑇆
𑆠𑆱𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆳𑆥𑆠𑇀𑆠𑆼𑆫𑇀𑆢𑇀𑆮𑆽𑆲𑆸𑆢𑆪𑇀𑆪𑆱𑇀𑆪 𑆖 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆱𑆩𑆳𑆱𑆼𑆤𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆇𑆥𑆖𑆳𑆫𑆱𑆳𑆣𑆤𑆁 𑆲𑇀𑆪𑆱𑇀𑆪 𑆘𑇀𑆚𑆳𑆤𑆼, 𑆘𑇀𑆚𑆳𑆤𑆁 𑆖 𑆬𑆴𑆕𑇀𑆓𑆠𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆴𑆰𑇀𑆛𑆾 𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆢𑆼𑆯𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆄𑆫𑇀𑆠𑆮𑆳𑆢𑆫𑇀𑆯𑆤𑆩𑆳𑆱𑇀𑆪𑆱𑆁𑆱𑇀𑆫𑆮𑆟𑆩𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆫𑆾𑆖𑆑𑆾𑇁𑆩𑇀𑆬𑆑𑆳𑆩𑆠𑆳 𑆖 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆯𑇀𑆫𑆢𑇀𑆣𑆳𑆥𑇀𑆫𑆟𑆪𑆤𑆩𑆶𑆖𑇀𑆖𑆳𑆮𑆖𑆼𑆰𑆶 𑆨𑆳𑆮𑆼𑆰𑆶 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑇀𑆮𑆁 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑇀𑆓𑇀𑆬𑆳𑆤𑆴𑆂 𑆱𑇀𑆠𑆤𑆪𑆾𑆂 𑆱𑇀𑆠𑆤𑇀𑆪𑆩𑆾𑆰𑇀𑆜𑆪𑆾𑆂 𑆱𑇀𑆠𑆤𑆩𑆟𑇀𑆝𑆬𑆪𑆾𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆳𑆢𑆪𑆾𑆫𑆵𑆰𑆬𑇀𑆬𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆶𑆢𑇀𑆓𑆩𑆾 𑆪𑆾𑆤𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆛𑆳𑆬𑆠𑇀𑆮𑆩𑆴𑆠𑆴 𑆓𑆫𑇀𑆨𑆼 𑆥𑆫𑇀𑆪𑆳𑆓𑆠𑆼 𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇖𑇆
𑆱𑆳 𑆪𑆢𑇀𑆪𑆢𑆴𑆖𑇀𑆗𑆼𑆠𑇀𑆠𑆠𑇀𑆠𑆢𑆱𑇀𑆪𑆽 𑆢𑆢𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫 𑆓𑆫𑇀𑆨𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆼𑆨𑇀𑆪𑆾 𑆨𑆳𑆮𑆼𑆨𑇀𑆪𑆂𑇆𑇑𑇗𑇆
𑆓𑆫𑇀𑆨𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆫𑇀𑆮𑆩𑆠𑆴𑆓𑆶𑆫𑆷𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑆳𑆫𑆶𑆟𑆳𑆯𑇀𑆖 𑆖𑆼𑆰𑇀𑆛𑆳𑆂; 𑆅𑆩𑆳𑆁𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆮𑆸𑆢𑇀𑆣𑆳𑆂- 𑆢𑆼𑆮𑆠𑆳𑆫𑆑𑇀𑆰𑆾𑇁𑆤𑆶𑆖𑆫𑆥𑆫𑆴𑆫𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁 𑆤 𑆫𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆳𑆱𑆳𑆁𑆱𑆴 𑆧𑆴𑆨𑆸𑆪𑆳𑆤𑇀𑆤 𑆩𑆢𑆑𑆫𑆳𑆟𑆴 𑆩𑆢𑇀𑆪𑆳𑆤𑇀𑆪𑆨𑇀𑆪𑆮𑆲𑆫𑆼𑆤𑇀𑆤 𑆪𑆳𑆤𑆩𑆣𑆴𑆫𑆾𑆲𑆼𑆤𑇀𑆤 𑆩𑆳𑆁𑆱𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆥𑇀𑆫𑆠𑆴𑆑𑆷𑆬𑆳𑆁𑆯𑇀𑆖 𑆨𑆳𑆮𑆳𑆤𑇀 𑆢𑆷𑆫𑆠𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀, 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆾 𑆮𑆴𑆢𑇀𑆪𑆶𑆂𑇆𑇑𑇘𑇆
𑆠𑆵𑆮𑇀𑆫𑆳𑆪𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆤𑆳𑆪𑆳𑆁 𑆑𑆳𑆩𑆩𑆲𑆴𑆠𑆩𑆥𑇀𑆪𑆱𑇀𑆪𑆽 𑆲𑆴𑆠𑆼𑆤𑆾𑆥𑆲𑆴𑆠𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆤𑆳𑆮𑆴𑆤𑆪𑆤𑆳𑆫𑇀𑆡𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆫𑇀𑆡𑆤𑆳𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆢𑇀𑆣𑆴 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑇀𑆠𑆂𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆖𑆫𑆤𑇀 𑆓𑆫𑇀𑆨𑆱𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆮𑆴𑆤𑆳𑆯𑆁 𑆮𑆽𑆫𑆷𑆥𑇀𑆪𑆁 𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇙𑇆
𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆩𑆳𑆱𑆴 𑆱𑇀𑆡𑆴𑆫𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆓𑆫𑇀𑆨𑆂, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑇀𑆮𑆩𑆣𑆴𑆑𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑇆𑇒𑇐𑇆
𑆥𑆚𑇀𑆖𑆩𑆼 𑆩𑆳𑆱𑆴 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆾𑆥𑆖𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆣𑆴𑆑𑆩𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆩𑆳𑆱𑆼𑆨𑇀𑆪𑆂, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑇆𑇒𑇑𑇆
𑆰𑆰𑇀𑆜𑆼 𑆩𑆳𑆱𑆴 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆥𑆖𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆣𑆴𑆑𑆩𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆩𑆳𑆱𑆼𑆨𑇀𑆪𑆂, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆧𑆬𑆮𑆫𑇀𑆟𑆲𑆳𑆤𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑇆𑇒𑇒𑇆
𑆱𑆥𑇀𑆠𑆩𑆼 𑆩𑆳𑆱𑆴 𑆓𑆫𑇀𑆨𑆂 𑆱𑆫𑇀𑆮𑆽𑆫𑇀𑆨𑆳𑆮𑆽𑆫𑆳𑆥𑇀𑆪𑆳𑆪𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑆵 𑆱𑆫𑇀𑆮𑆳𑆑𑆳𑆫𑆽𑆂 𑆑𑇀𑆬𑆳𑆤𑇀𑆠𑆠𑆩𑆳 𑆨𑆮𑆠𑆴𑇆𑇒𑇓𑇆
𑆃𑆰𑇀𑆛𑆩𑆼 𑆩𑆳𑆱𑆴 𑆓𑆫𑇀𑆨𑆯𑇀𑆖 𑆩𑆳𑆠𑆸𑆠𑆾 𑆓𑆫𑇀𑆨𑆠𑆯𑇀𑆖 𑆩𑆳𑆠𑆳 𑆫𑆱𑆲𑆳𑆫𑆴𑆟𑆵𑆨𑆴𑆂 𑆱𑆁𑆮𑆳𑆲𑆴𑆤𑆵𑆨𑆴𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆫𑆾𑆘𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆠 𑆄𑆢𑆢𑆳𑆠𑆼 𑆓𑆫𑇀𑆨𑆱𑇀𑆪𑆳𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆲𑆶𑆫𑇀𑆩𑆶𑆢𑆳 𑆪𑆶𑆑𑇀𑆠𑆳 𑆨𑆮𑆠𑆴 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆶𑆲𑆶𑆯𑇀𑆖 𑆩𑇀𑆬𑆳𑆤𑆳, 𑆠𑆡𑆳 𑆓𑆫𑇀𑆨𑆂; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆢𑆳 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆘𑆤𑇀𑆩 𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆴𑆩𑆢𑇀𑆨𑆮𑆠𑇀𑆪𑆾𑆘𑆱𑆾𑇁𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑇅 𑆠𑆁 𑆖𑆽𑆮𑆳𑆫𑇀𑆡𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆰𑇀𑆛𑆩𑆁 𑆩𑆳𑆱𑆩𑆓𑆟𑇀𑆪𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆑𑆶𑆯𑆬𑆳𑆂𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆑𑆢𑆴𑆮𑆱𑆳𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑇁𑆥𑆴 𑆤𑆮𑆩𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆳𑆢𑆳𑆪 𑆥𑇀𑆫𑆱𑆮𑆑𑆳𑆬𑆩𑆴𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑆳𑆢𑆯𑆩𑆳𑆤𑇀𑆩𑆳𑆱𑆳𑆠𑇀𑇅 𑆍𑆠𑆳𑆮𑆳𑆤𑇀 𑆥𑇀𑆫𑆱𑆮𑆑𑆳𑆬𑆂, 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆩𑆠𑆂 𑆥𑆫𑆁 𑆑𑆶𑆑𑇀𑆰𑆳𑆮𑆮𑆱𑇀𑆡𑆳𑆤𑆁 𑆓𑆫𑇀𑆨𑆱𑇀𑆪𑇆𑇒𑇕𑇆
𑆍𑆮𑆩𑆤𑆪𑆳𑇁𑇁𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆠𑆼 𑆑𑆶𑆑𑇀𑆰𑆿𑇆𑇒𑇖𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆒𑆬𑆶 𑆓𑆫𑇀𑆨𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆱𑆩𑇀𑆥𑆢𑆱𑇀𑆠𑆡𑆳 𑆮𑆸𑆠𑇀𑆠𑆱𑇀𑆪 𑆱𑆿𑆰𑇀𑆜𑆮𑆳𑆤𑇀𑆩𑆳𑆠𑆸𑆠𑆯𑇀𑆖𑆽𑆮𑆾𑆥𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆁 𑆑𑆳𑆬𑆥𑆫𑆴𑆟𑆳𑆩𑆳𑆠𑇀 𑆱𑇀𑆮𑆨𑆳𑆮𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆼𑆯𑇀𑆖 𑆑𑆶𑆑𑇀𑆰𑆿 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴𑇆𑇒𑇗𑇆
𑆩𑆳𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑆳𑆩𑆼𑆮 𑆠𑆶 𑆒𑆬𑆶 𑆓𑆫𑇀𑆨𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆴𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆱𑇀𑆪𑆳𑆘𑆤𑇀𑆩 𑆨𑆮𑆠𑆴𑇆𑇒𑇘𑇆
𑆪𑆼 𑆲𑇀𑆪𑆱𑇀𑆪 𑆑𑆶𑆑𑇀𑆰𑆿 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑆼𑆠𑆶𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆢𑆶𑆢𑆫𑆼 𑆮𑆴𑆤𑆳𑆯𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆃𑆡𑆮𑆳𑇁𑆥𑇀𑆪𑆖𑆴𑆫𑆘𑆳𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇙𑇆
𑆪𑆠𑆱𑇀𑆠𑆶 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤𑆳𑆮𑆴𑆤𑆯𑇀𑆪𑆤𑇀 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆪𑆢𑆳 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆾𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆳𑆪𑆳 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆱𑆫𑇀𑆥𑆤𑇀𑆠𑆂 𑆯𑆾𑆟𑆴𑆠𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆳𑆮𑆶𑆥𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 , 𑆤 𑆖 𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆯𑆾𑆟𑆴𑆠𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆿 𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑆴, 𑆠𑆢𑆼𑆪𑆁 𑆓𑆫𑇀𑆨𑆁 𑆬𑆨𑆠𑆼 𑆱𑇀𑆠𑇀𑆫𑆵; 𑆠𑆢𑆳 𑆠𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆩𑆳𑆠𑆸𑆘𑆳𑆤𑆳𑆩𑆮𑆪𑆮𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆾𑇁𑆮𑆪𑆮𑆾 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠 𑆍𑆑𑆾𑇁𑆡𑆮𑆳𑇁𑆤𑆼𑆑𑆼, 𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆲𑇀𑆪𑆮𑆪𑆮𑆱𑇀𑆪 𑆧𑆵𑆘𑆼 𑆧𑆵𑆘𑆨𑆳𑆓𑆼 𑆮𑆳 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆁 𑆠𑆩𑆮𑆪𑆮𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑆳𑆮𑆴𑆯𑆠𑆴𑇅 𑆪𑆢𑆳 𑆲𑇀𑆪𑆱𑇀𑆪𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆼 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆧𑆵𑆘𑆨𑆳𑆓𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆮𑆤𑇀𑆣𑇀𑆪𑆳𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆥𑆶𑆤𑆫𑆱𑇀𑆪𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆼 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆮𑆪𑆮𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆥𑆷𑆠𑆴𑆥𑇀𑆫𑆘𑆳𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆠𑇀𑆮𑆱𑇀𑆪𑆳𑆂 𑆯𑆾𑆟𑆴𑆠𑆼 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆮𑆪𑆮𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑆳𑆟𑆳𑆁 𑆖 𑆯𑆫𑆵𑆫𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆤𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆳𑆑𑆸𑆠𑆴𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆩𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆁 𑆮𑆳𑆫𑇀𑆠𑆳𑆁 𑆤𑆳𑆩 𑆘𑆤𑆪𑆠𑆴, 𑆠𑆳𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆮𑇀𑆪𑆳𑆥𑆢𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇓𑇐𑇆
𑆍𑆮𑆩𑆼𑆮 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆪𑆢𑆳 𑆧𑆵𑆘𑆼 𑆧𑆵𑆘𑆨𑆳𑆓𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆮𑆤𑇀𑆣𑇀𑆪𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆥𑆶𑆤𑆫𑆱𑇀𑆪 𑆧𑆵𑆘𑆼 𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆮𑆪𑆮𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆥𑆷𑆠𑆴𑆥𑇀𑆫𑆘𑆁 𑆘𑆤𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆠𑇀𑆮𑆱𑇀𑆪 𑆧𑆵𑆘𑆼 𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆮𑆪𑆮𑆂 𑆥𑆶𑆫𑆶𑆰𑆑𑆫𑆳𑆟𑆳𑆁 𑆖 𑆯𑆫𑆵𑆫𑆧𑆵𑆘𑆨𑆳𑆓𑆳𑆤𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆂 𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆥𑆶𑆫𑆶𑆰𑆳𑆑𑆸𑆠𑆴𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑆥𑆶𑆫𑆶𑆰𑆁 𑆠𑆸𑆟𑆥𑆶𑆠𑇀𑆫𑆴𑆑𑆁 𑆤𑆳𑆩 𑆘𑆤𑆪𑆠𑆴; 𑆠𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆮𑇀𑆪𑆳𑆥𑆢𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇓𑇑𑇆
𑆍𑆠𑆼𑆤 𑆩𑆳𑆠𑆸𑆘𑆳𑆤𑆳𑆁 𑆥𑆴𑆠𑆸𑆘𑆳𑆤𑆳𑆁 𑆖𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆤𑆼𑆤 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆘𑆳𑆤𑆳𑆁 𑆫𑆱𑆘𑆳𑆤𑆳𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆘𑆳𑆤𑆳𑆁 𑆖𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆠𑆴𑇆𑇓𑇒𑇆
𑆤𑆴𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆂 𑆥𑆫𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆳 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆂; 𑆱𑆠𑇀𑆠𑇀𑆮𑆯𑆫𑆵𑆫𑆪𑆾𑆱𑇀𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆾𑆥𑆬𑆧𑇀𑆣𑆴𑆂𑇆𑇓𑇓𑇆
𑆠𑆠𑇀𑆫 𑆠𑇀𑆫𑆪𑆂 𑆯𑆫𑆵𑆫𑆢𑆾𑆰𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂, 𑆠𑆼 𑆯𑆫𑆵𑆫𑆁 𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑆴; 𑆢𑇀𑆮𑆿 𑆥𑆶𑆤𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆢𑆾𑆰𑆿 𑆫𑆘𑆱𑇀𑆠𑆩𑆯𑇀𑆖, 𑆠𑆿 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆢𑆷𑆰𑆪𑆠𑆂𑇅 𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆖 𑆱𑆠𑇀𑆠𑇀𑆮𑆯𑆫𑆵𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑆶𑆰𑇀𑆛𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼, 𑆤𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑆖𑆳𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆨𑇀𑆪𑆳𑆩𑇀𑇆𑇓𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑆫𑆵𑆫𑆁 𑆪𑆾𑆤𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆩𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆫𑆼𑇆𑇓𑇕𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆒𑆬𑆶 𑆱𑆠𑇀𑆠𑇀𑆮𑆁- 𑆯𑆶𑆢𑇀𑆣𑆁, 𑆫𑆳𑆘𑆱𑆁, 𑆠𑆳𑆩𑆱𑆩𑆴𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆯𑆶𑆢𑇀𑆣𑆩𑆢𑆾𑆰𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀, 𑆫𑆳𑆘𑆱𑆁 𑆱𑆢𑆾𑆰𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆫𑆾𑆰𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀, 𑆠𑆳𑆩𑆱𑆩𑆥𑆴 𑆱𑆢𑆾𑆰𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆩𑆾𑆲𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆥𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆳𑆩𑆼𑆑𑆽𑆑𑆱𑇀𑆪 𑆨𑆼𑆢𑆳𑆓𑇀𑆫𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆠𑆫𑆠𑆩𑆪𑆾𑆓𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆪𑆾𑆤𑆴𑆮𑆴𑆯𑆼𑆰𑆼𑆨𑇀𑆪𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆳𑆤𑆶𑆮𑆴𑆣𑆳𑆤𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑇅 𑆯𑆫𑆵𑆫𑆁 𑆲𑇀𑆪𑆥𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆤𑆶𑆮𑆴𑆣𑆵𑆪𑆠𑆼, 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆖 𑆯𑆫𑆵𑆫𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑆠𑆴𑆖𑆴𑆠𑇀𑆱𑆠𑇀𑆠𑇀𑆮𑆨𑆼𑆢𑆳𑆤𑆤𑆷𑆑𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆼𑆤 𑆤𑆴𑆢𑆫𑇀𑆯𑆤𑆳𑆫𑇀𑆡𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇖𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆶𑆖𑆴𑆁 𑆱𑆠𑇀𑆪𑆳𑆨𑆴𑆱𑆤𑇀𑆣𑆁 𑆘𑆴𑆠𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆱𑆁𑆮𑆴𑆨𑆳𑆓𑆴𑆤𑆁 𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆮𑆖𑆤𑆥𑇀𑆫𑆠𑆴𑆮𑆖𑆤𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆤𑇀𑆠𑆁 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆩𑆳𑆤𑆩𑆾𑆲𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆲𑆫𑇀𑆰𑆳𑆩𑆫𑇀𑆰𑆳𑆥𑆼𑆠𑆁 𑆱𑆩𑆁 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆼𑆰𑆶 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇑)𑇅 𑆅𑆘𑇀𑆪𑆳𑆣𑇀𑆪𑆪𑆤𑆮𑇀𑆫𑆠𑆲𑆾𑆩𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆥𑆫𑆩𑆠𑆴𑆡𑆴𑆮𑇀𑆫𑆠𑆩𑆶𑆥𑆯𑆳𑆤𑇀𑆠𑆩𑆢𑆩𑆳𑆤𑆫𑆳𑆓𑆢𑇀𑆮𑆼𑆰𑆩𑆾𑆲𑆬𑆾𑆨𑆫𑆾𑆰𑆁 𑆥𑇀𑆫𑆠𑆴𑆨𑆳𑆮𑆖𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆾𑆥𑆣𑆳𑆫𑆟𑆯𑆑𑇀𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆳𑆫𑇀𑆰𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇒)𑇅 𑆎𑆯𑇀𑆮𑆫𑇀𑆪𑆮𑆤𑇀𑆠𑆩𑆳𑆢𑆼𑆪𑆮𑆳𑆑𑇀𑆪𑆁 𑆪𑆘𑇀𑆮𑆳𑆤𑆁 𑆯𑆷𑆫𑆩𑆾𑆘𑆱𑇀𑆮𑆴𑆤𑆁 𑆠𑆼𑆘𑆱𑆾𑆥𑆼𑆠𑆩𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆳𑆟𑆁 𑆢𑆵𑆫𑇀𑆔𑆢𑆫𑇀𑆯𑆴𑆤𑆁 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆳𑆨𑆴𑆫𑆠𑆩𑆽𑆤𑇀𑆢𑇀𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇓)𑇅 𑆬𑆼𑆒𑆳𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆫𑆴𑆟𑆩𑆱𑆩𑇀𑆥𑇀𑆫𑆲𑆳𑆫𑇀𑆪𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆮𑆤𑇀𑆠𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆤𑇀𑆠𑆩𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆬𑆩𑇀𑆨𑆴𑆤𑆁 𑆮𑇀𑆪𑆥𑆓𑆠𑆫𑆳𑆓𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆮𑆼𑆰𑆩𑆾𑆲𑆁 𑆪𑆳𑆩𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇔)𑇅 𑆯𑆷𑆫𑆁 𑆣𑆵𑆫𑆁 𑆯𑆶𑆖𑆴𑆩𑆯𑆶𑆖𑆴𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆁 𑆪𑆘𑇀𑆮𑆳𑆤𑆩𑆩𑇀𑆨𑆾𑆮𑆴𑆲𑆳𑆫𑆫𑆠𑆴𑆩𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆳𑆟𑆁 𑆱𑇀𑆡𑆳𑆤𑆑𑆾𑆥𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆮𑆳𑆫𑆶𑆟𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇕)𑇅 𑆱𑇀𑆡𑆳𑆤𑆩𑆳𑆤𑆾𑆥𑆨𑆾𑆓𑆥𑆫𑆴𑆮𑆳𑆫𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆤𑆴𑆠𑇀𑆪𑆁 𑆯𑆶𑆖𑆴𑆁 𑆱𑆶𑆒𑆮𑆴𑆲𑆳𑆫𑆁 𑆮𑇀𑆪𑆑𑇀𑆠𑆑𑆾𑆥𑆥𑇀𑆫𑆱𑆳𑆢𑆁 𑆑𑆿𑆧𑆼𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇖)𑇅 𑆥𑇀𑆫𑆴𑆪𑆤𑆸𑆠𑇀𑆪𑆓𑆵𑆠𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆾𑆬𑇀𑆬𑆳𑆥𑆑𑆯𑇀𑆬𑆾𑆑𑆳𑆒𑇀𑆪𑆳𑆪𑆴𑆑𑆼𑆠𑆴𑆲𑆳𑆱𑆥𑆶𑆫𑆳𑆟𑆼𑆰𑆶 𑆑𑆶𑆯𑆬𑆁 𑆓𑆤𑇀𑆣𑆩𑆳𑆬𑇀𑆪𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆮𑆱𑆤𑆱𑇀𑆠𑇀𑆫𑆵𑆮𑆴𑆲𑆳𑆫𑆑𑆳𑆩𑆤𑆴𑆠𑇀𑆪𑆩𑆤𑆱𑆷𑆪𑆑𑆁 𑆓𑆳𑆤𑇀𑆣𑆫𑇀𑆮𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇗)𑇅 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆁 𑆨𑆼𑆢𑆳𑆁𑆯𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑇀𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀𑆠𑆶 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆩𑆠𑇀𑆪𑆤𑇀𑆠𑆯𑆶𑆢𑇀𑆣𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇓𑇗𑇆
𑆯𑆷𑆫𑆁 𑆖𑆟𑇀𑆝𑆩𑆱𑆷𑆪𑆑𑆩𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆮𑆤𑇀𑆠𑆩𑆿𑆥𑆣𑆴𑆑𑆁 𑆫𑆿𑆢𑇀𑆫𑆩𑆤𑆤𑆶𑆑𑇀𑆫𑆾𑆯𑆩𑆳𑆠𑇀𑆩𑆥𑆷𑆘𑆑𑆩𑆳𑆱𑆶𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇑)𑇅 𑆃𑆩𑆫𑇀𑆰𑆴𑆟𑆩𑆤𑆶𑆧𑆤𑇀𑆣𑆑𑆾𑆥𑆁 𑆗𑆴𑆢𑇀𑆫𑆥𑇀𑆫𑆲𑆳𑆫𑆴𑆟𑆁 𑆑𑇀𑆫𑆷𑆫𑆩𑆳𑆲𑆳𑆫𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆫𑆶𑆖𑆴𑆩𑆳𑆩𑆴𑆰𑆥𑇀𑆫𑆴𑆪𑆠𑆩𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆪𑆳𑆱𑆧𑆲𑆶𑆬𑆩𑆵𑆫𑇀𑆰𑇀𑆪𑆶𑆁 𑆫𑆳𑆑𑇀𑆰𑆱𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇒)𑇅 𑆩𑆲𑆳𑆯𑆤𑆁 𑆱𑇀𑆠𑇀𑆫𑆽𑆟𑆁 𑆱𑇀𑆠𑇀𑆫𑆵𑆫𑆲𑆱𑇀𑆑𑆳𑆩𑆩𑆯𑆶𑆖𑆴𑆁 𑆯𑆶𑆖𑆴𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆁 𑆨𑆵𑆫𑆶𑆁 𑆨𑆵𑆰𑆪𑆴𑆠𑆳𑆫𑆁 𑆮𑆴𑆑𑆸𑆠𑆮𑆴𑆲𑆳𑆫𑆳𑆲𑆳𑆫𑆯𑆵𑆬𑆁 𑆥𑆽𑆯𑆳𑆖𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇓)𑇅 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆯𑆷𑆫𑆩𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆨𑆵𑆫𑆶𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆳𑆪𑆳𑆱𑆧𑆲𑆶𑆬𑆁 𑆱𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆠𑆓𑆾𑆖𑆫𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆥𑆫𑆁 𑆱𑆳𑆫𑇀𑆥𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇔)𑇅 𑆄𑆲𑆳𑆫𑆑𑆳𑆩𑆩𑆠𑆴𑆢𑆶𑆂𑆒𑆯𑆵𑆬𑆳𑆖𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆩𑆱𑆷𑆪𑆑𑆩𑆱𑆁𑆮𑆴𑆨𑆳𑆓𑆴𑆤𑆩𑆠𑆴𑆬𑆾𑆬𑆶𑆥𑆩𑆑𑆫𑇀𑆩𑆯𑆵𑆬𑆁 𑆥𑇀𑆫𑆽𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇕)𑇅 𑆃𑆤𑆶𑆰𑆑𑇀𑆠𑆑𑆳𑆩𑆩𑆘𑆱𑇀𑆫𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆥𑆫𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆩𑆫𑇀𑆰𑆟𑆩𑆱𑆚𑇀𑆖𑆪𑆁 𑆯𑆳𑆑𑆶𑆤𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇖)𑇅 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆒𑆬𑆶 𑆫𑆳𑆘𑆱𑆱𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆰𑆕𑇀𑆮𑆴𑆣𑆁 𑆨𑆼𑆢𑆳𑆁𑆯𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆫𑆾𑆰𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇓𑇘𑇆
𑆤𑆴𑆫𑆳𑆑𑆫𑆴𑆰𑇀𑆟𑆶𑆩𑆩𑆼𑆣𑆱𑆁 𑆘𑆶𑆓𑆶𑆥𑇀𑆱𑆴𑆠𑆳𑆖𑆳𑆫𑆳𑆲𑆫𑆁 𑆩𑆽𑆡𑆶𑆤𑆥𑆫𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑆵𑆬𑆁 𑆥𑆳𑆯𑆮𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇑)𑇅 𑆨𑆵𑆫𑆶𑆩𑆧𑆶𑆣𑆩𑆳𑆲𑆳𑆫𑆬𑆶𑆧𑇀𑆣𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆤𑆶𑆰𑆑𑇀𑆠𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆁 𑆱𑆫𑆟𑆯𑆵𑆬𑆁 𑆠𑆾𑆪𑆑𑆳𑆩𑆁 𑆩𑆳𑆠𑇀𑆱𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇒)𑇅 𑆃𑆬𑆱𑆁 𑆑𑆼𑆮𑆬𑆩𑆨𑆴𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆩𑆳𑆲𑆳𑆫𑆼 𑆱𑆫𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆕𑇀𑆓𑆲𑆵𑆤𑆁 𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇓)𑇅 𑆅𑆠𑇀𑆪𑆼𑆮𑆁 𑆠𑆳𑆩𑆱𑆱𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆨𑆼𑆢𑆳𑆁𑆯𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆾𑆲𑆳𑆁𑆯𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇓𑇙𑇆
𑆅𑆠𑇀𑆪𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆨𑆼𑆢𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆥𑆴 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆳𑆁 𑆨𑆼𑆢𑆽𑆑𑆢𑆼𑆯𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆂; 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆾 𑆧𑇀𑆫𑆲𑇀𑆩𑆫𑇀𑆰𑆴𑆯𑆑𑇀𑆫𑆪𑆩𑆮𑆫𑆶𑆟𑆑𑆶𑆧𑆼𑆫𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆶𑆑𑆳𑆫𑆼𑆟, 𑆫𑆳𑆘𑆱𑆱𑇀𑆪 𑆰𑆝𑇀𑆮𑆴𑆣𑆾 𑆢𑆽𑆠𑇀𑆪𑆥𑆴𑆯𑆳𑆖𑆫𑆳𑆑𑇀𑆰𑆱𑆱𑆫𑇀𑆥𑆥𑇀𑆫𑆼𑆠𑆯𑆑𑆶𑆤𑆴𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆶𑆑𑆳𑆫𑆼𑆟, 𑆠𑆳𑆩𑆱𑆱𑇀𑆪 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂 𑆥𑆯𑆶𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆶𑆑𑆳𑆫𑆼𑆟, 𑆑𑆡𑆁 𑆖 𑆪𑆡𑆳𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆶𑆥𑆖𑆳𑆫𑆂 𑆱𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇔𑇐𑇆
𑆑𑆼𑆮𑆬𑆯𑇀𑆖𑆳𑆪𑆩𑆶𑆢𑇀𑆢𑆼𑆯𑆾 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴 𑆓𑆫𑇀𑆨𑆳𑆮𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆴𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 ; 𑆠𑆱𑇀𑆪 𑆖𑆳𑆫𑇀𑆡𑆱𑇀𑆪 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆁 𑆓𑆫𑇀𑆨𑆑𑆫𑆳𑆟𑆳𑆁 𑆖 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆤𑆶𑆱𑆩𑆳𑆣𑆴𑆂, 𑆮𑆴𑆣𑆳𑆠𑆯𑇀𑆖 𑆮𑆴𑆔𑆳𑆠𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆴𑆠𑆴𑇆𑇔𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆳𑆠𑇀𑆩𑆳 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆑𑆶𑆑𑇀𑆰𑆿 𑆑𑇀𑆫𑆩𑆼𑆟 𑆖𑇅 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑆼𑆠𑆶𑆯𑇀𑆖 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆥𑆚𑇀𑆖𑆳𑆫𑇀𑆡𑆳𑆂 𑆯𑆶𑆨𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑆂𑇆𑇔𑇒𑇆
𑆃𑆘𑆤𑇀𑆩𑆤𑆴 𑆖 𑆪𑆾 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆤𑆳𑆯𑆼 𑆮𑆴𑆑𑆸𑆠𑆳𑆮𑆥𑆴𑇅 𑆅𑆩𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆵𑆤𑆯𑆶𑆨𑆳𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑆳𑆲𑆶𑆫𑇀𑆓𑆫𑇀𑆨𑆮𑆴𑆔𑆳𑆠𑆑𑆳𑆤𑇀𑇆𑇔𑇓𑇆
𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆰𑇀𑆛𑆿 𑆨𑆳𑆮𑆳𑆤𑆴𑆩𑆳𑆤𑇀 𑆨𑆴𑆰𑆑𑇀𑇅 𑆱𑆫𑇀𑆮𑆡𑆳 𑆮𑆼𑆢 𑆪𑆂 𑆱𑆫𑇀𑆮𑆳𑆤𑇀 𑆱 𑆫𑆳𑆘𑇀𑆚𑆂 𑆑𑆫𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴𑇆𑇔𑇔𑇆
𑆃𑆮𑆳𑆥𑇀𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆳𑆤𑇀 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆱 𑆍𑆮𑆁 𑆘𑇀𑆚𑆳𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴𑇅 𑆪𑆼 𑆖 𑆓𑆫𑇀𑆨𑆮𑆴𑆔𑆳𑆠𑆾𑆑𑇀𑆠𑆳 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆢𑆳𑆫𑆣𑆵𑆂𑇆𑇔𑇕𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆮𑆴𑆖𑆪𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
‘𑆥𑆶𑆫𑆶𑆰𑆾𑇁𑆪𑆁 𑆬𑆾𑆑𑆱𑆩𑇀𑆩𑆴𑆠𑆂’ 𑆅𑆠𑇀𑆪𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇅 𑆪𑆳𑆮𑆤𑇀𑆠𑆾 𑆲𑆴 𑆬𑆾𑆑𑆼 (𑆩𑆷𑆫𑇀𑆠𑆴𑆩𑆤𑇀𑆠𑆾 ) 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆼, 𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆼 𑆠𑆳𑆮𑆤𑇀𑆠𑆾 𑆬𑆾𑆑𑆼; 𑆅𑆠𑇀𑆪𑆼𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆤𑆽𑆠𑆳𑆮𑆠𑆳 𑆮𑆳𑆑𑇀𑆪𑆼𑆤𑆾𑆑𑇀𑆠𑆁 𑆮𑆳𑆑𑇀𑆪𑆳𑆫𑇀𑆡𑆩𑆮𑆓𑆳𑆲𑆳𑆩𑆲𑆼, 𑆨𑆓𑆮𑆠𑆳 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆨𑆷𑆪𑆱𑇀𑆠𑆫𑆩𑆠𑆾𑇁𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆩𑆳𑆤𑆁 𑆯𑆶𑆯𑇀𑆫𑆷𑆰𑆳𑆩𑆲 𑆅𑆠𑆴𑇆𑇓𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆃𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆬𑆾𑆑𑆳𑆮𑆪𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆂, 𑆥𑆶𑆫𑆶𑆰𑆳𑆮𑆪𑆮𑆮𑆴𑆯𑆼𑆰𑆳 𑆃𑆥𑇀𑆪𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆡𑆷𑆬𑆁 𑆑𑆠𑆴𑆖𑆴𑆢𑇀𑆨𑆳𑆮𑆳𑆤𑇀 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪𑆾𑆢𑆳𑆲𑆫𑆴𑆰𑇀𑆪𑆳𑆩𑆂, 𑆠𑆳𑆤𑆼𑆑𑆩𑆤𑆳 𑆤𑆴𑆧𑆾𑆣 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆓𑇀𑆤𑆴𑆮𑆼𑆯!𑇅 𑆰𑆝𑇀𑆣𑆳𑆠𑆮𑆂 𑆱𑆩𑆶𑆢𑆴𑆠𑆳𑆂 ‘𑆥𑆶𑆫𑆶𑆰’ 𑆅𑆠𑆴 𑆯𑆧𑇀𑆢𑆁 𑆬𑆨𑆤𑇀𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆥𑆱𑇀𑆠𑆼𑆘𑆾 𑆮𑆳𑆪𑆶𑆫𑆳𑆑𑆳𑆯𑆁 𑆧𑇀𑆫𑆲𑇀𑆩 𑆖𑆳𑆮𑇀𑆪𑆑𑇀𑆠𑆩𑆴𑆠𑆴, 𑆍𑆠 𑆍𑆮 𑆖 𑆰𑆝𑇀𑆣𑆳𑆠𑆮𑆂 𑆱𑆩𑆶𑆢𑆴𑆠𑆳𑆂 ‘𑆥𑆶𑆫𑆶𑆰’ 𑆅𑆠𑆴 𑆯𑆧𑇀𑆢𑆁 𑆬𑆨𑆤𑇀𑆠𑆼𑇆𑇔𑇆
𑆘𑇀𑆮𑆬𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆴 𑆱𑆁𑆫𑆶𑆢𑇀𑆣𑆁 𑆠𑆠𑇀 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆱𑆁𑆮𑆸𑆠𑆳𑆪𑆤𑆼𑇅 𑆯𑆶𑆢𑇀𑆣𑆂 𑆱𑇀𑆡𑆴𑆫𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆳𑆫𑇀𑆖𑆴𑆫𑇀𑆢𑆵𑆥𑆾 𑆢𑆵𑆥𑆳𑆯𑆪𑆼 𑆪𑆡𑆳𑇆𑇑𑇕𑇆
𑆯𑆶𑆢𑇀𑆣𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆪 𑆪𑆳 𑆯𑆶𑆢𑇀𑆣𑆳 𑆱𑆠𑇀𑆪𑆳 𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆪𑆪𑆳 𑆨𑆴𑆤𑆠𑇀𑆠𑇀𑆪𑆠𑆴𑆧𑆬𑆁 𑆩𑆲𑆳𑆩𑆾𑆲𑆩𑆪𑆁 𑆠𑆩𑆂𑇆𑇑𑇖𑇆
𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆱𑇀𑆮𑆨𑆳𑆮𑆘𑇀𑆚𑆾 𑆪𑆪𑆳 𑆨𑆮𑆠𑆴 𑆤𑆴𑆂𑆱𑇀𑆥𑆸𑆲𑆂𑇅 𑆪𑆾𑆓𑆁 𑆪𑆪𑆳 𑆱𑆳𑆣𑆪𑆠𑆼 𑆱𑆳𑆕𑇀𑆒𑇀𑆪𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆪𑆪𑆳𑇆𑇑𑇗𑇆
𑆪𑆪𑆳 𑆤𑆾𑆥𑆽𑆠𑇀𑆪𑆲𑆕𑇀𑆑𑆳𑆫𑆁 𑆤𑆾𑆥𑆳𑆱𑇀𑆠𑆼 𑆑𑆳𑆫𑆟𑆁 𑆪𑆪𑆳𑇅 𑆪𑆪𑆳 𑆤𑆳𑆬𑆩𑇀𑆧𑆠𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆱𑆤𑇀𑆤𑇀𑆪𑆱𑇀𑆪𑆠𑆼 𑆪𑆪𑆳𑇆𑇑𑇘𑇆
𑆪𑆳𑆠𑆴 𑆧𑇀𑆫𑆲𑇀𑆩 𑆪𑆪𑆳 𑆤𑆴𑆠𑇀𑆪𑆩𑆘𑆫𑆁 𑆯𑆳𑆤𑇀𑆠𑆩𑆮𑇀𑆪𑆪𑆩𑇀 𑇅 𑆮𑆴𑆢𑇀𑆪𑆳 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑇀𑆩𑆠𑆴𑆫𑇀𑆩𑆼𑆣𑆳 𑆥𑇀𑆫𑆘𑇀𑆚𑆳 𑆘𑇀𑆚𑆳𑆤𑆁 𑆖 𑆱𑆳 𑆩𑆠𑆳𑇆𑇑𑇙𑇆
𑆬𑆾𑆑𑆼 𑆮𑆴𑆠𑆠𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆬𑆾𑆑𑆁 𑆖𑆳𑆠𑇀𑆩𑆤𑆴 𑆥𑆯𑇀𑆪𑆠𑆂𑇅 𑆥𑆫𑆳𑆮𑆫𑆢𑆸𑆯𑆂 𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆩𑆷𑆬𑆳 𑆤 𑆤𑆯𑇀𑆪𑆠𑆴𑇆𑇒𑇐𑇆
𑆥𑆯𑇀𑆪𑆠𑆂 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆳𑆤𑇀 𑆲𑆴 𑆱𑆫𑇀𑆮𑆳𑆮𑆱𑇀𑆡𑆳𑆱𑆶 𑆱𑆫𑇀𑆮𑆢𑆳𑇅 𑆧𑇀𑆫𑆲𑇀𑆩𑆨𑆷𑆠𑆱𑇀𑆪 𑆱𑆁𑆪𑆾𑆓𑆾 𑆤 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇒𑇑𑇆
𑆤𑆳𑆠𑇀𑆩𑆤𑆂 𑆑𑆫𑆟𑆳𑆨𑆳𑆮𑆳𑆬𑇀𑆬𑆴𑆕𑇀𑆓𑆩𑆥𑇀𑆪𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇅 𑆱 𑆱𑆫𑇀𑆮𑆑𑆫𑆟𑆳𑆪𑆾𑆓𑆳𑆤𑇀𑆩𑆶𑆑𑇀𑆠 𑆅𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇆𑇒𑇒𑇆
𑆮𑆴𑆥𑆳𑆥𑆁 𑆮𑆴𑆫𑆘𑆂 𑆯𑆳𑆤𑇀𑆠𑆁 𑆥𑆫𑆩𑆑𑇀𑆰𑆫𑆩𑆮𑇀𑆪𑆪𑆩𑇀𑇅 𑆃𑆩𑆸𑆠𑆁 𑆧𑇀𑆫𑆲𑇀𑆩 𑆤𑆴𑆫𑇀𑆮𑆳𑆟𑆁 𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆂 𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇒𑇓𑇆
𑆍𑆠𑆠𑇀𑆠𑆠𑇀 𑆱𑆿𑆩𑇀𑆪! 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆪𑆘𑇀𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆩𑆶𑆑𑇀𑆠𑆱𑆁𑆯𑆪𑆳𑆂𑇅 𑆩𑆶𑆤𑆪𑆂 𑆥𑇀𑆫𑆯𑆩𑆁 𑆘𑆓𑇀𑆩𑆶𑆫𑇀𑆮𑆵𑆠𑆩𑆾𑆲𑆫𑆘𑆂𑆱𑇀𑆥𑆸𑆲𑆳𑆂𑇆𑇒𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆱𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆬𑆾𑆑𑆱𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪 𑆖𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆩𑆷𑆬𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆿 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆿 𑆩𑆳𑆫𑇀𑆓 𑆍𑆮 𑆖𑇆𑇒𑇕𑇆
𑆯𑆶𑆢𑇀𑆣𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑆳𑆣𑆳𑆤𑆁 𑆱𑆠𑇀𑆪𑆳 𑆧𑆶𑆢𑇀𑆣𑆴𑆯𑇀𑆖 𑆤𑆽𑆰𑇀𑆜𑆴𑆑𑆵𑇅 𑆮𑆴𑆖𑆪𑆼 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆳 𑆤𑆴𑆰𑇀𑆜𑆳 𑆖 𑆥𑆫𑆩𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆫𑆵𑆫𑆮𑆴𑆖𑆪𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆯𑆫𑆵𑆫𑆮𑆴𑆖𑆪𑆂 𑆯𑆫𑆵𑆫𑆾𑆥𑆑𑆳𑆫𑆳𑆫𑇀𑆡𑆩𑆴𑆰𑇀𑆪𑆠𑆼𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆲𑆴 𑆯𑆫𑆵𑆫𑆠𑆠𑇀𑆠𑇀𑆮𑆁 𑆯𑆫𑆵𑆫𑆾𑆥𑆑𑆳𑆫𑆑𑆫𑆼𑆰𑆶 𑆨𑆳𑆮𑆼𑆰𑆶 𑆘𑇀𑆚𑆳𑆤𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆮𑆴𑆖𑆪𑆁 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆯𑆫𑆵𑆫𑆁 𑆤𑆳𑆩 𑆖𑆼𑆠𑆤𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆷𑆠𑆁 𑆥𑆚𑇀𑆖𑆩𑆲𑆳𑆨𑆷𑆠𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑆶𑆢𑆳𑆪𑆳𑆠𑇀𑆩𑆑𑆁 𑆱𑆩𑆪𑆾𑆓𑆮𑆳𑆲𑆴 𑇅 𑆪𑆢𑆳 𑆲𑇀𑆪𑆱𑇀𑆩𑆴𑆚𑇀 𑆯𑆫𑆵𑆫𑆼 𑆣𑆳𑆠𑆮𑆾 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆢𑆳 𑆑𑇀𑆬𑆼𑆯𑆁 𑆮𑆴𑆤𑆳𑆯𑆁 𑆮𑆳 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴𑇅 𑆮𑆽𑆰𑆩𑇀𑆪𑆓𑆩𑆤𑆁 𑆲𑆴 𑆥𑆶𑆤𑆫𑇀𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆓𑆩𑆤𑆩𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳 𑆖𑇆𑇔𑇆
𑆪𑆿𑆓𑆥𑆢𑇀𑆪𑆼𑆤 𑆠𑆶 𑆮𑆴𑆫𑆾𑆣𑆴𑆤𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆿 𑆨𑆮𑆠𑆂𑇅 𑆪𑆢𑇀𑆣𑆴 𑆪𑆱𑇀𑆪 𑆣𑆳𑆠𑆾𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆁 𑆠𑆠𑇀𑆠𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆱𑇀𑆪 𑆣𑆳𑆠𑆾𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆮𑆳𑆪𑆑𑆫𑆁 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇕𑇆
𑆠𑆢𑆼𑆮 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆁 𑆱𑆩𑇀𑆪𑆓𑆮𑆖𑆳𑆫𑇀𑆪𑆩𑆳𑆟𑆁 𑆪𑆶𑆓𑆥𑆤𑇀𑆤𑇀𑆪𑆷𑆤𑆳𑆠𑆴𑆫𑆴𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆳𑆩𑇀𑆪𑆑𑆫𑆁 𑆨𑆮𑆠𑆴, 𑆃𑆣𑆴𑆑𑆩𑆥𑆑𑆫𑇀𑆰𑆠𑆴 𑆤𑇀𑆪𑆷𑆤𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆠𑆴𑇆𑇖𑇆
𑆍𑆠𑆳𑆮𑆢𑆼𑆮 𑆲𑆴 𑆨𑆽𑆰𑆘𑇀𑆪𑆥𑇀𑆫𑆪𑆾𑆓𑆼 𑆦𑆬𑆩𑆴𑆰𑇀𑆛𑆁 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆶𑆰𑇀𑆜𑆳𑆤𑆼 𑆖 𑆪𑆳𑆮𑆢𑇀𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆳𑆩𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆳 𑆲𑇀𑆪𑆥𑆴 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆳𑆩𑇀𑆪𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆩𑆼𑆮 𑆑𑆶𑆯𑆬𑆳 𑆫𑆱𑆓𑆶𑆟𑆳𑆤𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆥𑆫𑇀𑆪𑆳𑆪𑆼𑆟𑆼𑆖𑇀𑆗𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆪𑆾𑆑𑇀𑆠𑆶𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆩𑆳𑆘𑇀𑆚𑆳𑆠𑆳𑆤𑇀; 𑆍𑆑𑆥𑇀𑆫𑆑𑆳𑆫𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆁𑆯𑇀𑆖𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆑𑆫𑆱𑆩𑆳𑆘𑇀𑆚𑆳𑆠𑆪𑆳 𑆖𑆼𑆰𑇀𑆛𑆪𑆳 𑆱𑆩𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆑𑆫𑇀𑆠𑆶𑆩𑇀𑇆𑇗𑇆
𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆠𑇀𑆩𑆓𑆶𑆟𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆳𑆁 𑆲𑆴 𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆖 𑆑𑇀𑆫𑆴𑆪𑆾𑆥𑆪𑆾𑆓𑆂 𑆱𑆩𑇀𑆪𑆑𑇀, 𑆱𑆫𑇀𑆮𑆳𑆠𑆴𑆪𑆾𑆓𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆩𑇀, 𑆃𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆖 𑆓𑆠𑆴𑆩𑆠𑆳𑆁, 𑆱𑆳𑆲𑆱𑆳𑆤𑆳𑆁 𑆖 𑆮𑆫𑇀𑆘𑆤𑆁, 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆩𑆼𑆠𑆳𑆮𑆢𑇀𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆳𑆩𑇀𑆪𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇘𑇆
𑆣𑆳𑆠𑆮𑆂 𑆥𑆶𑆤𑆂 𑆯𑆳𑆫𑆵𑆫𑆳𑆂 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆽𑆂 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆽𑆫𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆽𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑆴, 𑆲𑇀𑆫𑆳𑆱𑆁 𑆠𑆶 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆽𑆫𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆳𑆲𑆳𑆫𑆽𑆫𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆽𑆂𑇆𑇙𑇆
𑆠𑆠𑇀𑆫𑆼𑆩𑆼 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆳𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆱𑆳𑆩𑆫𑇀𑆡𑇀𑆪𑆑𑆫𑆳𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆓𑆶𑆫𑆶𑆬𑆔𑆶𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆩𑆤𑇀𑆢𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆱𑇀𑆡𑆴𑆫𑆱𑆫𑆩𑆸𑆢𑆶𑆑𑆜𑆴𑆤𑆮𑆴𑆯𑆢𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆒𑆫𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆡𑆷𑆬𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆢𑇀𑆫𑆮𑆳𑆂𑇅 𑆠𑆼𑆰𑆶 𑆪𑆼 𑆓𑆶𑆫𑆮𑆱𑇀𑆠𑆼 𑆓𑆶𑆫𑆶𑆨𑆴𑆫𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆓𑆶𑆟𑆽𑆫𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆽𑆫𑆳𑆥𑇀𑆪𑆳𑆪𑇀𑆪𑆤𑇀𑆠𑆼, 𑆬𑆔𑆮𑆯𑇀𑆖 𑆲𑇀𑆫𑆱𑆤𑇀𑆠𑆴; 𑆬𑆔𑆮𑆱𑇀𑆠𑆶 𑆬𑆔𑆶𑆨𑆴𑆫𑆳𑆥𑇀𑆪𑆳𑆪𑇀𑆪𑆤𑇀𑆠𑆼, 𑆓𑆶𑆫𑆮𑆯𑇀𑆖 𑆲𑇀𑆫𑆱𑆤𑇀𑆠𑆴𑇅 𑆍𑆮𑆩𑆼𑆮 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆓𑆶𑆟𑆳𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆪𑆾𑆓𑆳𑆢𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆂, 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆢𑇀𑆣𑇀𑆫𑆳𑆱𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆳𑆁𑆱𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑇀𑆪𑆠𑆼 𑆩𑆳𑆁𑆱𑆼𑆤 𑆨𑆷𑆪𑆱𑇀𑆠𑆫𑆩𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆶𑆨𑇀𑆪𑆂, 𑆠𑆡𑆳 𑆬𑆾𑆲𑆴𑆠𑆁 𑆬𑆾𑆲𑆴𑆠𑆼𑆤, 𑆩𑆼𑆢𑆾 𑆩𑆼𑆢𑆱𑆳, 𑆮𑆱𑆳 𑆮𑆱𑆪𑆳, 𑆃𑆱𑇀𑆡𑆴 𑆠𑆫𑆶𑆟𑆳𑆱𑇀𑆡𑇀𑆤𑆳, 𑆩𑆘𑇀𑆘𑆳 𑆩𑆘𑇀𑆘𑇀𑆚𑆳, 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆶𑆑𑇀𑆫𑆼𑆟, 𑆓𑆫𑇀𑆨𑆱𑇀𑆠𑇀𑆮𑆳𑆩𑆓𑆫𑇀𑆨𑆼𑆟𑇆𑇑𑇐𑇆
𑆪𑆠𑇀𑆫 𑆠𑇀𑆮𑆼𑆮𑆁𑆬𑆑𑇀𑆰𑆟𑆼𑆤 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆼𑆤 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆮𑆠𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆱𑆳𑆤𑇀𑆤𑆴𑆣𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆱𑆤𑇀𑆤𑆴𑆲𑆴𑆠𑆳𑆤𑆳𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆠𑇀𑆮𑆳𑆤𑇀𑆤𑆾𑆥𑆪𑆾𑆓𑆾 𑆔𑆸𑆟𑆴𑆠𑇀𑆮𑆳𑆢𑆤𑇀𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆳 𑆑𑆳𑆫𑆟𑆳𑆠𑇀, 𑆱 𑆖 𑆣𑆳𑆠𑆶𑆫𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆴𑆠𑆮𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆠𑆱𑇀𑆪 𑆪𑆼 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳 𑆃𑆱𑆼𑆮𑇀𑆪𑆳𑆯𑇀𑆖, 𑆠𑆠𑇀𑆫 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆤𑆳𑆩𑆥𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆶𑆑𑇀𑆫𑆑𑇀𑆰𑆪𑆼 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆫𑆶𑆥𑆪𑆾𑆓𑆾 𑆩𑆣𑆶𑆫𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆵𑆠𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆁 𑆖𑆳𑆥𑆫𑆼𑆰𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁, 𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆪𑆼 𑆥𑆶𑆤𑆫𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆮𑆳𑆫𑆶𑆟𑆵𑆩𑆟𑇀𑆝𑆢𑇀𑆫𑆮𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆾𑆥𑆑𑇀𑆬𑆼𑆢𑆴𑆤𑆳𑆁, 𑆥𑆶𑆫𑆵𑆰𑆑𑇀𑆰𑆪𑆼 𑆑𑆶𑆬𑇀𑆩𑆳𑆰𑆩𑆳𑆰𑆑𑆶𑆰𑇀𑆑𑆶𑆟𑇀𑆝𑆳𑆘𑆩𑆣𑇀𑆪𑆪𑆮𑆯𑆳𑆑𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆳𑆤𑆳𑆁, 𑆮𑆳𑆠𑆑𑇀𑆰𑆪𑆼 𑆑𑆛𑆶𑆑𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆯𑆵𑆠𑆳𑆤𑆳𑆁, 𑆥𑆴𑆠𑇀𑆠𑆑𑇀𑆰𑆪𑆼𑇁𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆾𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆳𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑇀𑆰𑆪𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆤𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆩𑇀𑇅 𑆑𑆫𑇀𑆩𑆳𑆥𑆴 𑆪𑆢𑇀𑆪𑆱𑇀𑆪 𑆣𑆳𑆠𑆾𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆁 𑆠𑆠𑇀𑆠𑆢𑆳𑆱𑆼𑆮𑇀𑆪𑆩𑇀𑇅 𑆍𑆮𑆩𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆥𑆴 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆿 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆑𑆳𑆫𑇀𑆪𑆿𑇅 𑆅𑆠𑆴 𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆷𑆤𑆳𑆩𑆼𑆑𑆽𑆑𑆯𑆾𑇁𑆠𑆴𑆢𑆼𑆯𑆠𑆯𑇀𑆖 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆑𑆫𑆳𑆟𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇑𑇆
𑆑𑆳𑆫𑇀𑆠𑇀𑆱𑇀𑆤𑇀𑆪𑆼𑆤 𑆯𑆫𑆵𑆫𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆳𑆬𑆪𑆾𑆓𑆂, 𑆱𑇀𑆮𑆨𑆳𑆮𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆴𑆂, 𑆄𑆲𑆳𑆫𑆱𑆿𑆰𑇀𑆜𑆮𑆩𑇀, 𑆃𑆮𑆴𑆔𑆳𑆠𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇒𑇆
𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆧𑆬𑆮𑆠𑇀𑆥𑆶𑆫𑆶𑆰𑆼 𑆢𑆼𑆯𑆼 𑆘𑆤𑇀𑆩 𑆧𑆬𑆮𑆠𑇀𑆥𑆶𑆫𑆶𑆰𑆼 𑆑𑆳𑆬𑆼 𑆖, 𑆱𑆶𑆒𑆯𑇀𑆖 𑆑𑆳𑆬𑆪𑆾𑆓𑆂, 𑆧𑆵𑆘𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆖𑇀𑆖, 𑆄𑆲𑆳𑆫𑆱𑆩𑇀𑆥𑆖𑇀𑆖, 𑆯𑆫𑆵𑆫𑆱𑆩𑇀𑆥𑆖𑇀𑆖, 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆩𑇀𑆥𑆖𑇀𑆖, 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑇀𑆥𑆖𑇀𑆖, 𑆱𑇀𑆮𑆨𑆳𑆮𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆴𑆯𑇀𑆖, 𑆪𑆿𑆮𑆤𑆁 𑆖, 𑆑𑆫𑇀𑆩 𑆖, 𑆱𑆁𑆲𑆫𑇀𑆰𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇓𑇆
𑆄𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆑𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆈𑆰𑇀𑆩𑆳, 𑆮𑆳𑆪𑆶𑆂, 𑆑𑇀𑆬𑆼𑆢𑆂, 𑆱𑇀𑆤𑆼𑆲𑆂, 𑆑𑆳𑆬𑆂, 𑆱𑆩𑆪𑆾𑆓𑆯𑇀𑆖𑆼𑆠𑆴 𑇆𑇑𑇔𑇆
𑆠𑆠𑇀𑆫 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆷𑆰𑇀𑆩𑆳𑆢𑆵𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆴𑆩𑆼 𑆑𑆫𑇀𑆩𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆈𑆰𑇀𑆩𑆳 𑆥𑆖𑆠𑆴, 𑆮𑆳𑆪𑆶𑆫𑆥𑆑𑆫𑇀𑆰𑆠𑆴, 𑆑𑇀𑆬𑆼𑆢𑆂 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆩𑆳𑆥𑆳𑆢𑆪𑆠𑆴, 𑆱𑇀𑆤𑆼𑆲𑆾 𑆩𑆳𑆫𑇀𑆢𑆮𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆑𑆳𑆬𑆂 𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆴𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴, 𑆱𑆩𑆪𑆾𑆓𑆱𑇀𑆠𑇀𑆮𑆼𑆰𑆳𑆁 𑆥𑆫𑆴𑆟𑆳𑆩𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆑𑆫𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇕𑇆
𑆥𑆫𑆴𑆟𑆩𑆠𑆱𑇀𑆠𑇀𑆮𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆓𑆶𑆟𑆳𑆂 𑆯𑆫𑆵𑆫𑆓𑆶𑆟𑆨𑆳𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆂; 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆯𑇀𑆖 𑆮𑆴𑆲𑆤𑇀𑆪𑆶𑆫𑇀𑆮𑆴𑆲𑆠𑆳𑆯𑇀𑆖 𑆮𑆴𑆫𑆾𑆣𑆴𑆨𑆴𑆂 𑆯𑆫𑆵𑆫𑆩𑇀𑇆𑇑𑇖𑇆
𑆯𑆫𑆵𑆫𑆓𑆶𑆟𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆂 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟- 𑆩𑆬𑆨𑆷𑆠𑆳𑆂, 𑆥𑇀𑆫𑆱𑆳𑆢𑆨𑆷𑆠𑆳𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆩𑆬𑆨𑆷𑆠𑆳𑆱𑇀𑆠𑆼 𑆪𑆼 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆳𑆧𑆳𑆣𑆑𑆫𑆳𑆂 𑆱𑇀𑆪𑆶𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆫𑆵𑆫𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆰𑆷𑆥𑆢𑆼𑆲𑆳𑆂 𑆥𑆸𑆡𑆓𑇀𑆘𑆤𑇀𑆩𑆳𑆤𑆾 𑆧𑆲𑆴𑆫𑇀𑆩𑆶𑆒𑆳𑆂, 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆳𑆯𑇀𑆖 𑆣𑆳𑆠𑆮𑆂, 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆯𑇀𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂, 𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼𑇁𑆥𑆴 𑆑𑆼𑆖𑆴𑆖𑇀𑆗𑆫𑆵𑆫𑆼 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆾 𑆨𑆳𑆮𑆳𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆾𑆥𑆔𑆳𑆠𑆳𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆱𑆫𑇀𑆮𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀𑆩𑆬𑆼 𑆱𑆚𑇀𑆖𑆑𑇀𑆰𑇀𑆩𑆲𑆼; 𑆅𑆠𑆫𑆳𑆁𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆱𑆳𑆢𑆼 , 𑆓𑆶𑆫𑇀𑆮𑆳𑆢𑆵𑆁𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑆠𑆳𑆤𑇀 𑆓𑆶𑆟𑆨𑆼𑆢𑆼𑆤, 𑆫𑆱𑆳𑆢𑆵𑆁𑆯𑇀𑆖 𑆯𑆶𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆤𑇀 𑆢𑇀𑆫𑆮𑇀𑆪𑆨𑆼𑆢𑆼𑆤𑇆𑇑𑇗𑇆
𑆠𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾 𑆢𑆶𑆰𑇀𑆛𑆳 𑆢𑆷𑆰𑆪𑆴𑆠𑆳𑆫𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆢𑆾𑆰𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆠𑇀𑇅 𑆮𑆳𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆣𑆳𑆠𑇀𑆮𑆤𑇀𑆠𑆫𑆼 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆫𑆼 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑆴𑆠𑆥𑆵𑆠𑆵𑆪𑆼𑇁𑆣𑇀𑆪𑆳𑆪𑆼 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴𑇅 𑆍𑆠𑆳𑆮𑆠𑇀𑆪𑆼𑆮 𑆢𑆶𑆰𑇀𑆛𑆢𑆾𑆰𑆓𑆠𑆴𑆫𑇀𑆪𑆳𑆮𑆠𑇀 𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆣𑆳𑆠𑆷𑆤𑆳𑆩𑇀𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆮𑆳𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆦𑆬𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆳𑆮𑆼 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆢𑇀𑆨𑆴𑆫𑆴𑆠𑆴𑇆𑇑𑇘𑇆
𑆱 𑆖𑆾𑆥𑆱𑇀𑆡𑆴𑆠𑆑𑆳𑆬𑆼 𑆘𑆤𑇀𑆩𑆤𑆴 𑆥𑇀𑆫𑆱𑆷𑆠𑆴𑆩𑆳𑆫𑆶𑆠𑆪𑆾𑆓𑆳𑆠𑇀 𑆥𑆫𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆳𑆮𑆳𑆑𑇀𑆯𑆴𑆫𑆳 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆳𑆩𑆠𑇀𑆪𑆥𑆠𑇀𑆪𑆥𑆡𑆼𑆤, 𑆍𑆰𑆳 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆂, 𑆮𑆴𑆑𑆸𑆠𑆴𑆂 𑆥𑆶𑆤𑆫𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑇅 𑆥𑆫𑆁 𑆠𑇀𑆮𑆠𑆂 𑆱𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆨𑆮𑆠𑆴𑇆𑇒𑇔𑇆
𑆠𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆿 𑆘𑆳𑆠𑆴𑆱𑆷𑆠𑇀𑆫𑆵𑆪𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆮𑆮𑆴𑆑𑆳𑆫𑆑𑆫𑆿 𑆖𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆿 𑆨𑆮𑆠𑆂𑇆𑇒𑇕𑇆
𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆮 𑆖 𑆮𑆴𑆰𑆩𑆱𑆼𑆮𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆘𑆳𑆠𑆂 𑆱𑆢𑇀𑆪 𑆇𑆥𑆲𑆤𑇀𑆪𑆠𑆼 𑆠𑆫𑆶𑆫𑆴𑆮𑆳𑆖𑆴𑆫𑆮𑇀𑆪𑆥𑆫𑆾𑆥𑆴𑆠𑆾 𑆮𑆳𑆠𑆳𑆠𑆥𑆳𑆨𑇀𑆪𑆳𑆩𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆩𑆷𑆬𑆂𑇆𑇒𑇖𑇆
𑆄𑆥𑇀𑆠𑆾𑆥𑆢𑆼𑆯𑆳𑆢𑆢𑇀𑆨𑆶𑆠𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖𑆳𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆤𑆶𑆫𑆷𑆥𑆳 𑆢𑆼𑆮𑆳𑆢𑆴𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇒𑇗𑇆
𑆑𑆳𑆬𑆳𑆑𑆳𑆬𑆩𑆸𑆠𑇀𑆪𑇀𑆮𑆾𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆪𑆾𑆫𑆴𑆢𑆩𑆣𑇀𑆪𑆮𑆱𑆴𑆠𑆁 𑆤𑆂- “𑆪𑆂 𑆑𑆯𑇀𑆖𑆴𑆤𑇀 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆱 𑆑𑆳𑆬 𑆍𑆮 𑆩𑇀𑆫𑆴𑆪𑆠𑆼, 𑆤 𑆲𑆴 𑆑𑆳𑆬𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆩𑆱𑇀𑆠𑆴” 𑆅𑆠𑇀𑆪𑆼𑆑𑆼 𑆨𑆳𑆰𑆤𑇀𑆠𑆼𑇅 𑆠𑆖𑇀𑆖𑆳𑆱𑆩𑇀𑆪𑆑𑇀𑇅 𑆤 𑆲𑇀𑆪𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆠𑆳 𑆱𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆠𑆳 𑆮𑆳 𑆑𑆳𑆬𑆱𑇀𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼, 𑆑𑆳𑆬𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆲𑆶𑆫𑆥𑆫𑆼- 𑆪𑆾 𑆪𑆢𑆳 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆱 𑆠𑆱𑇀𑆪 𑆤𑆴𑆪𑆠𑆾 𑆩𑆸𑆠𑇀𑆪𑆶𑆑𑆳𑆬𑆂; 𑆱 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆱𑆠𑇀𑆪𑆂, 𑆱𑆩𑆑𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆢𑆴𑆠𑆴𑇅 𑆍𑆠𑆢𑆥𑆴 𑆖𑆳𑆤𑇀𑆪𑆡𑆳𑇁𑆫𑇀𑆡𑆓𑇀𑆫𑆲𑆟𑆩𑇀𑇅 𑆤 𑆲𑆴 𑆑𑆯𑇀𑆖𑆴𑆤𑇀𑆤 𑆩𑇀𑆫𑆴𑆪𑆠 𑆅𑆠𑆴 𑆱𑆩𑆑𑇀𑆫𑆴𑆪𑆂𑇅 𑆑𑆳𑆬𑆾 𑆲𑇀𑆪𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪𑆾𑆖𑇀𑆪𑆠𑆼𑇅 𑆪𑆱𑇀𑆪 𑆖𑆼𑆰𑇀𑆛𑆁 𑆪𑆾 𑆪𑆢𑆳 𑆩𑇀𑆫𑆴𑆪𑆠𑆼 𑆱 𑆠𑆱𑇀𑆪 𑆩𑆸𑆠𑇀𑆪𑆶𑆑𑆳𑆬 𑆅𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆼 𑆨𑆳𑆮𑆳 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆤𑆴𑆪𑆠𑆑𑆳𑆬𑆳 𑆨𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆠𑆴; 𑆠𑆖𑇀𑆖 𑆤𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁 𑆲𑇀𑆪𑆑𑆳𑆬𑆳𑆲𑆳𑆫𑆮𑆖𑆤𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆦𑆬𑆩𑆤𑆴𑆰𑇀𑆛𑆁, 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼 𑆖𑆼𑆰𑇀𑆛𑆁; 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆠𑆯𑇀𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼 𑆒𑆬𑆶 𑆑𑆳𑆬𑆳𑆑𑆳𑆬𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆱𑇀𑆠𑆳𑆱𑆶 𑆠𑆳𑆱𑇀𑆮𑆮𑆱𑇀𑆡𑆳𑆱𑆶 𑆠𑆁 𑆠𑆩𑆫𑇀𑆡𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆳𑆬𑆾𑇁𑆪𑆩𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆿𑆰𑆣𑆱𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆟𑆾 𑆮𑆴𑆱𑆫𑇀𑆓𑆱𑇀𑆪, 𑆃𑆑𑆳𑆬𑆾 𑆮𑆼𑆠𑆴𑇅 𑆬𑆾𑆑𑆼𑇁𑆥𑇀𑆪𑆼𑆠𑆢𑇀𑆨𑆮𑆠𑆴- 𑆑𑆳𑆬𑆼 𑆢𑆼𑆮𑆾 𑆮𑆫𑇀𑆰𑆠𑇀𑆪𑆑𑆳𑆬𑆼 𑆢𑆼𑆮𑆾 𑆮𑆫𑇀𑆰𑆠𑆴, 𑆑𑆳𑆬𑆼 𑆯𑆵𑆠𑆩𑆑𑆳𑆬𑆼 𑆯𑆵𑆠𑆁, 𑆑𑆳𑆬𑆼 𑆠𑆥𑆠𑇀𑆪𑆑𑆳𑆬𑆼 𑆠𑆥𑆠𑆴, 𑆑𑆳𑆬𑆼 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆩𑆑𑆳𑆬𑆼 𑆖 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆩𑆴𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆨𑆪𑆩𑆱𑇀𑆠𑆴- 𑆑𑆳𑆬𑆼 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆑𑆳𑆬𑆼 𑆖; 𑆤𑆽𑆑𑆳𑆤𑇀𑆠𑆴𑆑𑆩𑆠𑇀𑆫𑇅 𑆪𑆢𑆴 𑆲𑇀𑆪𑆑𑆳𑆬𑆼 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑇀𑆤 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆴𑆪𑆠𑆑𑆳𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆳𑆪𑆶𑆂 𑆱𑆫𑇀𑆮𑆁 𑆱𑇀𑆪𑆳𑆠𑇀; 𑆍𑆮𑆁 𑆓𑆠𑆼 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆘𑇀𑆚𑆳𑆤𑆩𑆑𑆳𑆫𑆟𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆤𑆶𑆩𑆳𑆤𑆾𑆥𑆢𑆼𑆯𑆳𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆫𑇀𑆪𑆼 𑆥𑇀𑆫𑆩𑆳𑆟𑆨𑆷𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆠𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑆶, 𑆪𑆽𑆫𑆳𑆪𑆶𑆰𑇀𑆪𑆳𑆟𑇀𑆪𑆤𑆳𑆪𑆶𑆰𑇀𑆪𑆳𑆟𑆴 𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆤𑇀𑆠𑆼𑇅 𑆮𑆳𑆓𑇀𑆮𑆱𑇀𑆠𑆶𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆠𑆢𑇀𑆮𑆳𑆢𑆩𑆸𑆰𑆪𑆾 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼- 𑆤𑆳𑆑𑆳𑆬𑆼 𑆩𑆸𑆠𑇀𑆪𑆶𑆫𑆱𑇀𑆠𑆵𑆠𑆴𑇆𑇒𑇘𑇆
𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆒𑆬𑇀𑆮𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼𑇆𑇒𑇙𑇆
𑆠𑆱𑇀𑆪 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆓𑆶𑆟𑆳𑆠𑇀𑆩𑆱𑆩𑇀𑆥𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆾𑆥𑆱𑆼𑆮𑆤𑆁 𑆖𑆼𑆠𑆴𑇆𑇓𑇐𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆯𑆫𑆵𑆫𑆁 𑆪𑆢𑇀𑆪𑆡𑆳 𑆠𑆖𑇀𑆖 𑆮𑆫𑇀𑆠𑆠𑆼 𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆩𑆳𑆩𑆪𑆽𑆂𑇅 𑆪𑆡𑆳 𑆑𑇀𑆬𑆼𑆯𑆁 𑆮𑆴𑆤𑆳𑆯𑆁 𑆖 𑆪𑆳𑆠𑆴 𑆪𑆼 𑆖𑆳𑆱𑇀𑆪 𑆣𑆳𑆠𑆮𑆂𑇆𑇓𑇑𑇆
𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆿 𑆪𑆡𑆳 𑆠𑆼𑆰𑆳𑆁 𑆑𑇀𑆰𑆵𑆟𑆳𑆤𑆳𑆩𑆿𑆰𑆣𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆢𑆼𑆲𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆳 𑆨𑆳𑆮𑆳 𑆧𑆬𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆳𑆯𑇀𑆖 𑆪𑆼𑇆𑇓𑇒𑇆
𑆥𑆫𑆴𑆟𑆳𑆩𑆑𑆫𑆳 𑆨𑆳𑆮𑆳 𑆪𑆳 𑆖 𑆠𑆼𑆰𑆳𑆁 𑆥𑆸𑆡𑆑𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆩𑆬𑆳𑆒𑇀𑆪𑆳𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆱𑆳𑆢𑆳𑆒𑇀𑆪𑆳 𑆣𑆳𑆠𑆮𑆂 𑆥𑇀𑆫𑆯𑇀𑆤 𑆍𑆮 𑆖𑇆𑇓𑇓𑇆
𑆤𑆮𑆑𑆾 𑆤𑆴𑆫𑇀𑆟𑆪𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆴𑆣𑆴𑆮𑆠𑇀 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆂𑇅 𑆠𑆡𑇀𑆪𑆂 𑆯𑆫𑆵𑆫𑆮𑆴𑆖𑆪𑆼 𑆯𑆳𑆫𑆵𑆫𑆼 𑆥𑆫𑆩𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇓𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆫𑆵𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆯𑆫𑆵𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆩𑆮𑆪𑆮𑆯𑆂 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆁 𑆯𑆫𑆵𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆤𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆫𑇀𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆥𑆥𑇀𑆫𑆖𑇀𑆗𑇆𑇓𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆯𑆸𑆟𑆶 𑆩𑆠𑇀𑆠𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆩𑆳𑆖𑆑𑇀𑆰𑆳𑆟𑆱𑇀𑆪 𑆪𑆡𑆳 𑆥𑇀𑆫𑆯𑇀𑆤𑆩𑆼𑆑𑆩𑆤𑆳 𑆪𑆡𑆳𑆮𑆠𑇀𑇅 𑆯𑆫𑆵𑆫𑆼 𑆰𑆛𑇀 𑆠𑇀𑆮𑆖𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆇𑆢𑆑𑆣𑆫𑆳 𑆠𑇀𑆮𑆓𑇀𑆧𑆳𑆲𑇀𑆪𑆳, 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳 𑆠𑇀𑆮𑆱𑆸𑆓𑇀𑆣𑆫𑆳, 𑆠𑆸𑆠𑆵𑆪𑆳 𑆱𑆴𑆣𑇀𑆩𑆑𑆴𑆬𑆳𑆱𑆱𑆩𑇀𑆨𑆮𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳, 𑆖𑆠𑆶𑆫𑇀𑆡𑆵 𑆢𑆢𑇀𑆫𑆷𑆑𑆶𑆰𑇀𑆜𑆱𑆩𑇀𑆨𑆮𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳, 𑆥𑆚𑇀𑆖𑆩𑆵 𑆠𑇀𑆮𑆬𑆘𑆵𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆱𑆩𑇀𑆨𑆮𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳, 𑆰𑆰𑇀𑆜𑆵 𑆠𑆶 𑆪𑆱𑇀𑆪𑆳𑆁 𑆗𑆴𑆤𑇀𑆤𑆳𑆪𑆳𑆁 𑆠𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆤𑇀𑆣 𑆅𑆮 𑆖 𑆠𑆩𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴 𑆪𑆳𑆁 𑆖𑆳𑆥𑇀𑆪𑆣𑆴𑆰𑇀𑆜𑆳𑆪𑆳𑆫𑆷𑆁𑆰𑆴 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆥𑆫𑇀𑆮𑆱𑆶 𑆑𑆸𑆰𑇀𑆟𑆫𑆑𑇀𑆠𑆳𑆤𑆴 𑆱𑇀𑆡𑆷𑆬𑆩𑆷𑆬𑆳𑆤𑆴 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆠𑆩𑆳𑆤𑆴 𑆖; 𑆅𑆠𑆴 𑆰𑆛𑇀 𑆠𑇀𑆮𑆖𑆂𑇅 𑆍𑆠𑆳𑆂 𑆰𑆝𑆕𑇀𑆓𑆁 𑆯𑆫𑆵𑆫𑆩𑆮𑆠𑆠𑇀𑆪 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆪𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆳𑆕𑇀𑆓𑆮𑆴𑆨𑆳𑆓𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑇀𑆮𑆿 𑆧𑆳𑆲𑆷, 𑆢𑇀𑆮𑆼 𑆱𑆑𑇀𑆡𑆴𑆤𑆵, 𑆯𑆴𑆫𑆾𑆓𑇀𑆫𑆵𑆮𑆩𑇀, 𑆃𑆤𑇀𑆠𑆫𑆳𑆣𑆴𑆂, 𑆅𑆠𑆴 𑆰𑆝𑆕𑇀𑆓𑆩𑆕𑇀𑆓𑆩𑇀𑇆𑇕𑇆
𑆠𑇀𑆫𑆵𑆟𑆴 𑆱𑆰𑆰𑇀𑆛𑆵𑆤𑆴 𑆯𑆠𑆳𑆤𑇀𑆪𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆱𑆲 𑆢𑆤𑇀𑆠𑆾𑆬𑆷𑆒𑆬𑆤𑆒𑆼𑆤 𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆢𑆤𑇀𑆠𑆳𑆂, 𑆢𑇀𑆮𑆳𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀𑆢𑆤𑇀𑆠𑆾𑆬𑆷𑆒𑆬𑆳𑆤𑆴, 𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆤𑆒𑆳𑆂, 𑆰𑆰𑇀𑆛𑆴𑆂 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆶𑆬𑇀𑆪𑆱𑇀𑆡𑆵𑆤𑆴, 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆯𑆬𑆳𑆑𑆳𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆯𑆬𑆳𑆑𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆤𑆴, 𑆢𑇀𑆮𑆼 𑆥𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆾𑆫𑆱𑇀𑆡𑆴𑆤𑆵, 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑆳𑆢𑆪𑆾𑆫𑇀𑆓𑆶𑆬𑇀𑆦𑆳𑆂, 𑆢𑇀𑆮𑆿 𑆩𑆟𑆴𑆑𑆿 𑆲𑆱𑇀𑆠𑆪𑆾𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑇀𑆪𑆫𑆠𑇀𑆤𑇀𑆪𑆾𑆫𑆱𑇀𑆡𑆵𑆤𑆴, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆘𑆕𑇀𑆔𑆪𑆾𑆂, 𑆢𑇀𑆮𑆼 𑆘𑆳𑆤𑆶𑆤𑆵, 𑆢𑇀𑆮𑆼 𑆘𑆳𑆤𑆶𑆑𑆥𑆳𑆬𑆴𑆑𑆼, 𑆢𑇀𑆮𑆳𑆮𑆷𑆫𑆶𑆤𑆬𑆑𑆿, 𑆢𑇀𑆮𑆿 𑆧𑆳𑆲𑆶𑆤𑆬𑆑𑆿, 𑆢𑇀𑆮𑆳𑆮𑆁𑆱𑆿, 𑆢𑇀𑆮𑆼 𑆃𑆁𑆱𑆦𑆬𑆑𑆼, 𑆢𑇀𑆮𑆳𑆮𑆑𑇀𑆰𑆑𑆿, 𑆍𑆑𑆁 𑆘𑆠𑇀𑆫𑆶, 𑆢𑇀𑆮𑆼 𑆠𑆳𑆬𑆶𑆑𑆼, 𑆢𑇀𑆮𑆼 𑆯𑇀𑆫𑆾𑆟𑆴𑆦𑆬𑆑𑆼, 𑆍𑆑𑆁 𑆨𑆓𑆳𑆱𑇀𑆡𑆴, 𑆥𑆚𑇀𑆖𑆖𑆠𑇀𑆮𑆳𑆫𑆴𑆁𑆯𑆠𑇀 𑆥𑆸𑆰𑇀𑆜𑆓𑆠𑆳𑆤𑇀𑆪𑆱𑇀𑆡𑆵𑆤𑆴, 𑆥𑆚𑇀𑆖𑆢𑆯 𑆓𑇀𑆫𑆵𑆮𑆳𑆪𑆳𑆁, 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆾𑆫𑆱𑆴, 𑆢𑇀𑆮𑆪𑆾𑆂 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑆫𑇀𑆯𑆶𑆑𑆳𑆂, 𑆠𑆳𑆮𑆤𑇀𑆠𑆴 𑆱𑇀𑆡𑆳𑆬𑆑𑆳𑆤𑆴, 𑆠𑆳𑆮𑆤𑇀𑆠𑆴 𑆖𑆽𑆮 𑆱𑇀𑆡𑆳𑆬𑆑𑆳𑆫𑇀𑆧𑆶𑆢𑆳𑆤𑆴, 𑆍𑆑𑆁 𑆲𑆤𑇀𑆮𑆱𑇀𑆡𑆴, 𑆢𑇀𑆮𑆼 𑆲𑆤𑆶𑆩𑆷𑆬𑆧𑆤𑇀𑆣𑆤𑆼, 𑆍𑆑𑆳𑆱𑇀𑆡𑆴 𑆤𑆳𑆱𑆴𑆑𑆳𑆓𑆟𑇀𑆝𑆑𑆷𑆛𑆬𑆬𑆳𑆛𑆁, 𑆢𑇀𑆮𑆿 𑆯𑆕𑇀𑆒𑆿, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆯𑆴𑆫𑆂𑆑𑆥𑆳𑆬𑆳𑆤𑆵𑆠𑆴; 𑆍𑆮𑆁 𑆠𑇀𑆫𑆵𑆟𑆴 𑆱𑆰𑆰𑇀𑆛𑆵𑆤𑆴 𑆯𑆠𑆳𑆤𑇀𑆪𑆱𑇀𑆡𑇀𑆤𑆳𑆁 𑆱𑆲 𑆢𑆤𑇀𑆠𑆾𑆬𑆷𑆒𑆬𑆤𑆒𑆼𑆤𑆼𑆠𑆴𑇆𑇖𑇆
𑆥𑆚𑇀𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆳𑆤𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑇀𑆮𑆓𑇀, 𑆘𑆴𑆲𑇀𑆮𑆳, 𑆤𑆳𑆱𑆴𑆑𑆳, 𑆃𑆑𑇀𑆰𑆴𑆟𑆵, 𑆑𑆫𑇀𑆟𑆿 𑆖𑇅 𑆥𑆚𑇀𑆖 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆁, 𑆫𑆱𑆤𑆁, 𑆔𑇀𑆫𑆳𑆟𑆁, 𑆢𑆫𑇀𑆯𑆤𑆁, 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆩𑆴𑆠𑆴𑇅 𑆥𑆚𑇀𑆖 𑆑𑆫𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆲𑆱𑇀𑆠𑆿, 𑆥𑆳𑆢𑆿, 𑆥𑆳𑆪𑆶𑆂, 𑆇𑆥𑆱𑇀𑆡𑆂, 𑆘𑆴𑆲𑇀𑆮𑆳 𑆖𑆼𑆠𑆴𑇆𑇗𑇆
𑆲𑆸𑆢𑆪𑆁 𑆖𑆼𑆠𑆤𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆼𑆑𑆩𑇀𑇆𑇘𑇆
𑆢𑆯 𑆥𑇀𑆫𑆳𑆟𑆳𑆪𑆠𑆤𑆳𑆤𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆷𑆫𑇀𑆣𑆳, 𑆑𑆟𑇀𑆜𑆂, 𑆲𑆸𑆢𑆪𑆁, 𑆤𑆳𑆨𑆴𑆂, 𑆓𑆶𑆢𑆁, 𑆧𑆱𑇀𑆠𑆴𑆂, 𑆏𑆘𑆂, 𑆯𑆶𑆑𑇀𑆫𑆁, 𑆯𑆾𑆟𑆴𑆠𑆁, 𑆩𑆳𑆁𑆱𑆩𑆴𑆠𑆴𑇅 𑆠𑆼𑆰𑆶 𑆰𑆛𑇀 𑆥𑆷𑆫𑇀𑆮𑆳𑆟𑆴 𑆩𑆫𑇀𑆩𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴𑇆𑇙𑇆
𑆥𑆚𑇀𑆖𑆢𑆯 𑆑𑆾𑆰𑇀𑆜𑆳𑆕𑇀𑆓𑆳𑆤𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆤𑆳𑆨𑆴𑆯𑇀𑆖, 𑆲𑆸𑆢𑆪𑆁 𑆖, 𑆑𑇀𑆬𑆾𑆩 𑆖, 𑆪𑆑𑆸𑆖𑇀𑆖, 𑆥𑇀𑆬𑆵𑆲𑆳 𑆖, 𑆮𑆸𑆑𑇀𑆑𑆿 𑆖, 𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖, 𑆥𑆶𑆫𑆵𑆰𑆳𑆣𑆳𑆫𑆯𑇀𑆖, 𑆄𑆩𑆳𑆯𑆪𑆯𑇀𑆖, 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆯𑇀𑆖, 𑆇𑆠𑇀𑆠𑆫𑆓𑆶𑆢𑆁 𑆖, 𑆃𑆣𑆫𑆓𑆶𑆢𑆁 𑆖, 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆖, 𑆱𑇀𑆡𑆷𑆬𑆳𑆤𑇀𑆠𑇀𑆫𑆁 𑆖, 𑆮𑆥𑆳𑆮𑆲𑆤𑆁 𑆖𑆼𑆠𑆴𑇆𑇑𑇐𑇆
𑆰𑆛𑇀𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀 𑆥𑇀𑆫𑆠𑇀𑆪𑆕𑇀𑆓𑆳𑆤𑆴 𑆰𑆛𑇀𑆱𑇀𑆮𑆕𑇀𑆓𑆼𑆰𑆷𑆥𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆤𑆴, 𑆪𑆳𑆤𑇀𑆪𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆩𑆕𑇀𑆓𑆼𑆰𑆶 𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆪𑆩𑆳𑆤𑆼𑆰𑆶, 𑆠𑆳𑆤𑇀𑆪𑆤𑇀𑆪𑆽𑆂 𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆫𑆴𑆲 𑆥𑇀𑆫𑆑𑆳𑆯𑇀𑆪𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑇀𑆮𑆼 𑆘𑆕𑇀𑆔𑆳𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆼, 𑆢𑇀𑆮𑆼 𑆈𑆫𑆶𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆼, 𑆢𑇀𑆮𑆿 𑆱𑇀𑆦𑆴𑆖𑆿, 𑆢𑇀𑆮𑆿 𑆮𑆸𑆰𑆟𑆿, 𑆍𑆑𑆁 𑆯𑆼𑆦𑆂, 𑆢𑇀𑆮𑆼 𑆇𑆒𑆼, 𑆢𑇀𑆮𑆿 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆿, 𑆢𑇀𑆮𑆿 𑆑𑆶𑆑𑆶𑆤𑇀𑆢𑆫𑆿, 𑆍𑆑𑆁 𑆧𑆱𑇀𑆠𑆴𑆯𑆵𑆫𑇀𑆰𑆩𑇀, 𑆍𑆑𑆩𑆶𑆢𑆫𑆁, 𑆢𑇀𑆮𑆿 𑆱𑇀𑆠𑆤𑆿, 𑆢𑇀𑆮𑆿 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆨𑆶𑆮𑆿 , 𑆢𑇀𑆮𑆼 𑆧𑆳𑆲𑆶𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆼, 𑆖𑆴𑆧𑆶𑆑𑆩𑆼𑆑𑆁, 𑆢𑇀𑆮𑆳𑆮𑆾𑆰𑇀𑆜𑆿, 𑆢𑇀𑆮𑆼 𑆱𑆸𑆑𑇀𑆑𑆟𑇀𑆪𑆿, 𑆢𑇀𑆮𑆿 𑆢𑆤𑇀𑆠𑆮𑆼𑆰𑇀𑆛𑆑𑆿, 𑆍𑆑𑆁 𑆠𑆳𑆬𑆶, 𑆍𑆑𑆳 𑆓𑆬𑆯𑆶𑆟𑇀𑆝𑆴𑆑𑆳, 𑆢𑇀𑆮𑆼 𑆇𑆥𑆘𑆴𑆲𑇀𑆮𑆴𑆑𑆼, 𑆍𑆑𑆳 𑆓𑆾𑆘𑆴𑆲𑇀𑆮𑆴𑆑𑆳, 𑆢𑇀𑆮𑆿 𑆓𑆟𑇀𑆝𑆿, 𑆢𑇀𑆮𑆼 𑆑𑆫𑇀𑆟𑆯𑆰𑇀𑆑𑆶𑆬𑆴𑆑𑆼, 𑆢𑇀𑆮𑆿 𑆑𑆫𑇀𑆟𑆥𑆶𑆠𑇀𑆫𑆑𑆿, 𑆢𑇀𑆮𑆼 𑆃𑆑𑇀𑆰𑆴𑆑𑆷𑆛𑆼, 𑆖𑆠𑇀𑆮𑆳𑆫𑇀𑆪𑆑𑇀𑆰𑆴𑆮𑆫𑇀𑆠𑇀𑆩𑆳𑆤𑆴, 𑆢𑇀𑆮𑆼 𑆃𑆑𑇀𑆰𑆴𑆑𑆤𑆵𑆤𑆴𑆑𑆼, 𑆢𑇀𑆮𑆼 𑆨𑇀𑆫𑆶𑆮𑆿, 𑆍𑆑𑆳𑇁𑆮𑆛𑆶𑆂, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆲𑆸𑆢𑆪𑆳𑆤𑆴𑇆𑇑𑇑𑇆
𑆤𑆮 𑆩𑆲𑆤𑇀𑆠𑆴 𑆗𑆴𑆢𑇀𑆫𑆳𑆟𑆴- 𑆱𑆥𑇀𑆠 𑆯𑆴𑆫𑆱𑆴, 𑆢𑇀𑆮𑆼 𑆖𑆳𑆣𑆂𑇆𑇑𑇒𑇆
𑆍𑆠𑆳𑆮𑆢𑇀𑆢𑆸𑆯𑇀𑆪𑆁 𑆯𑆑𑇀𑆪𑆩𑆥𑆴 𑆤𑆴𑆫𑇀𑆢𑆼𑆰𑇀𑆛𑆶𑆩𑇀𑇆𑇑𑇓𑇆
𑆃𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑇀𑆪𑆩𑆠𑆂 𑆥𑆫𑆁 𑆠𑆫𑇀𑆑𑇀𑆪𑆩𑆼𑆮𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆤𑆮 𑆱𑇀𑆤𑆳𑆪𑆶𑆯𑆠𑆳𑆤𑆴, 𑆱𑆥𑇀𑆠 𑆱𑆴𑆫𑆳𑆯𑆠𑆳𑆤𑆴, 𑆢𑇀𑆮𑆼 𑆣𑆩𑆤𑆵𑆯𑆠𑆼, 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆥𑆼𑆯𑆵𑆯𑆠𑆳𑆤𑆴, 𑆱𑆥𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆁 𑆩𑆫𑇀𑆩𑆯𑆠𑆁, 𑆢𑇀𑆮𑆼 𑆱𑆤𑇀𑆣𑆴𑆯𑆠𑆼, 𑆍𑆑𑆾𑆤𑆠𑇀𑆫𑆴𑆁𑆯𑆠𑇀𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆤𑆮 𑆖 𑆯𑆠𑆳𑆤𑆴 𑆰𑆛𑇀𑆥𑆚𑇀𑆖𑆳𑆯𑆠𑇀𑆑𑆳𑆤𑆴 𑆱𑆴𑆫𑆳𑆣𑆩𑆤𑆵𑆤𑆳𑆩𑆟𑆶𑆯𑆂 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆩𑆶𑆒𑆳𑆓𑇀𑆫𑆥𑆫𑆴𑆩𑆳𑆟𑆁, 𑆠𑆳𑆮𑆤𑇀𑆠𑆴 𑆖𑆽𑆮 𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆬𑆾𑆩𑆳𑆤𑆵𑆠𑆴𑇅 𑆍𑆠𑆢𑇀𑆪𑆡𑆳𑆮𑆠𑇀𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆁 𑆠𑇀𑆮𑆑𑇀𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆢𑆸𑆯𑇀𑆪𑆁, 𑆠𑆫𑇀𑆑𑇀𑆪𑆩𑆠𑆂 𑆥𑆫𑆩𑇀𑇅 𑆍𑆠𑆢𑆶𑆨𑆪𑆩𑆥𑆴 𑆤 𑆮𑆴𑆑𑆬𑇀𑆥𑆠𑆼, 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆳𑆮𑆳𑆖𑇀𑆗𑆫𑆵𑆫𑆱𑇀𑆪𑇆𑇑𑇔𑇆
𑆪𑆠𑇀𑆠𑇀𑆮𑆚𑇀𑆘𑆬𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆁 𑆠𑆢𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂; 𑆠𑆠𑇀 𑆥𑆫𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆨𑆴𑆘𑇀𑆚𑆼𑆪𑆁, 𑆠𑆖𑇀𑆖 𑆮𑆸𑆢𑇀𑆣𑆴𑆲𑇀𑆫𑆳𑆱𑆪𑆾𑆓𑆴, 𑆠𑆫𑇀𑆑𑇀𑆪𑆩𑆼𑆮𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆯𑆾𑆢𑆑𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆪𑆂 𑆯𑆫𑆵𑆫𑆼 𑆱𑇀𑆮𑆼𑆤𑆳𑆚𑇀𑆘𑆬𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤, 𑆪𑆠𑇀𑆠𑆶 𑆥𑇀𑆫𑆖𑇀𑆪𑆮𑆩𑆳𑆤𑆁 𑆥𑆶𑆫𑆵𑆰𑆩𑆤𑆶𑆧𑆣𑇀𑆤𑆳𑆠𑇀𑆪𑆠𑆴𑆪𑆾𑆓𑆼𑆤 𑆠𑆡𑆳 𑆩𑆷𑆠𑇀𑆫𑆁 𑆫𑆶𑆣𑆴𑆫𑆩𑆤𑇀𑆪𑆳𑆁𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆷𑆤𑇀, 𑆪𑆠𑇀𑆠𑆶 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆖𑆫𑆁 𑆧𑆳𑆲𑇀𑆪𑆳 𑆠𑇀𑆮𑆓𑇀𑆧𑆴𑆨𑆫𑇀𑆠𑆴, 𑆪𑆠𑇀𑆠𑆶 𑆠𑇀𑆮𑆓𑆤𑇀𑆠𑆫𑆼 𑆮𑇀𑆫𑆟𑆓𑆠𑆁 𑆬𑆱𑆵𑆑𑆳𑆯𑆧𑇀𑆢𑆁 𑆬𑆨𑆠𑆼, 𑆪𑆖𑇀𑆖𑆾𑆰𑇀𑆩𑆟𑆳𑇁𑆤𑆶𑆧𑆢𑇀𑆣𑆁 𑆬𑆾𑆩𑆑𑆷𑆥𑆼𑆨𑇀𑆪𑆾 𑆤𑆴𑆰𑇀𑆥𑆠𑆠𑇀 𑆱𑇀𑆮𑆼𑆢𑆯𑆧𑇀𑆢𑆩𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆴, 𑆠𑆢𑆶𑆢𑆑𑆁 𑆢𑆯𑆳𑆚𑇀𑆘𑆬𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆁; 𑆤𑆮𑆳𑆚𑇀𑆘𑆬𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆣𑆳𑆠𑆾𑆂, 𑆪𑆁 ‘𑆫𑆱’ 𑆅𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆃𑆰𑇀𑆛𑆿 𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪, 𑆱𑆥𑇀𑆠 𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆪, 𑆰𑆛𑇀 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆂, 𑆥𑆚𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪, 𑆖𑆠𑇀𑆮𑆳𑆫𑆾 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆪, 𑆠𑇀𑆫𑆪𑆾 𑆮𑆱𑆳𑆪𑆳𑆂, 𑆢𑇀𑆮𑆿 𑆩𑆼𑆢𑆱𑆂, 𑆍𑆑𑆾 𑆩𑆘𑇀𑆘𑆳𑆪𑆳𑆂, 𑆩𑆱𑇀𑆠𑆴𑆰𑇀𑆑𑆱𑇀𑆪𑆳𑆫𑇀𑆣𑆳𑆚𑇀𑆘𑆬𑆴𑆂, 𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆪 𑆠𑆳𑆮𑆢𑆼𑆮 𑆥𑇀𑆫𑆩𑆳𑆟𑆁, 𑆠𑆳𑆮𑆢𑆼𑆮 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆱𑇀𑆪𑆿𑆘𑆱 𑆅𑆠𑆴𑇅 𑆍𑆠𑆖𑇀𑆗𑆫𑆵𑆫𑆠𑆠𑇀𑆠𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆪𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑆱𑇀𑆡𑆷𑆬𑆁 𑆱𑇀𑆡𑆴𑆫𑆁 𑆩𑆷𑆫𑇀𑆠𑆴𑆩𑆢𑇀𑆓𑆶𑆫𑆶𑆒𑆫𑆑𑆜𑆴𑆤𑆩𑆕𑇀𑆓𑆁 𑆤𑆒𑆳𑆱𑇀𑆡𑆴𑆢𑆤𑇀𑆠𑆩𑆳𑆁𑆱𑆖𑆫𑇀𑆩𑆮𑆫𑇀𑆖𑆂𑆑𑆼𑆯𑆯𑇀𑆩𑆯𑇀𑆫𑆶𑆬𑆾𑆩𑆑𑆟𑇀𑆝𑆫𑆳𑆢𑆴 𑆠𑆠𑇀 𑆥𑆳𑆫𑇀𑆡𑆴𑆮𑆁 𑆓𑆤𑇀𑆣𑆾 𑆔𑇀𑆫𑆳𑆟𑆁 𑆖; 𑆪𑆢𑇀𑆢𑇀𑆫𑆮𑆱𑆫𑆩𑆤𑇀𑆢𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑆸𑆢𑆶𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆫𑆱𑆫𑆶𑆣𑆴𑆫𑆮𑆱𑆳𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆮𑆼𑆢𑆳𑆢𑆴 𑆠𑆢𑆳𑆥𑇀𑆪𑆁 𑆫𑆱𑆾 𑆫𑆱𑆤𑆁 𑆖; 𑆪𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆩𑆷𑆰𑇀𑆩𑆳 𑆖 𑆪𑆾 𑆪𑆳 𑆖 𑆨𑆳𑆂 𑆯𑆫𑆵𑆫𑆼 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆁 𑆫𑆷𑆥𑆁 𑆢𑆫𑇀𑆯𑆤𑆁 𑆖; 𑆪𑆢𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆯𑇀𑆮𑆳𑆱𑆾𑆤𑇀𑆩𑆼𑆰𑆤𑆴𑆩𑆼𑆰𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆥𑇀𑆫𑆱𑆳𑆫𑆟𑆓𑆩𑆤𑆥𑇀𑆫𑆼𑆫𑆟𑆣𑆳𑆫𑆟𑆳𑆢𑆴 𑆠𑆢𑇀𑆮𑆳𑆪𑆮𑆵𑆪𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆁 𑆖; 𑆪𑆢𑇀𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆁 𑆪𑆢𑆶𑆖𑇀𑆪𑆠𑆼 𑆩𑆲𑆳𑆤𑇀𑆠𑆴 𑆖𑆳𑆟𑆷𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆠𑆢𑆳𑆤𑇀𑆠𑆫𑆵𑆑𑇀𑆰𑆁 𑆯𑆧𑇀𑆢𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆖; 𑆪𑆠𑇀 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆸 𑆠𑆠𑇀 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆩𑆤𑆯𑇀𑆖𑇅 𑆅𑆠𑆴 𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆪𑆡𑆳𑆱𑇀𑆡𑆷𑆬𑆨𑆼𑆢𑆼𑆤𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑇆𑇑𑇖𑇆
𑆯𑆫𑆵𑆫𑆳𑆮𑆪𑆮𑆳𑆱𑇀𑆠𑆶 𑆥𑆫𑆩𑆳𑆟𑆶𑆨𑆼𑆢𑆼𑆤𑆳𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆃𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑆠𑆴𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆢𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑆁𑆪𑆾𑆓𑆮𑆴𑆨𑆳𑆓𑆼 𑆥𑆫𑆩𑆳𑆟𑆷𑆤𑆳𑆁 𑆑𑆳𑆫𑆟𑆁 𑆮𑆳𑆪𑆶𑆂 𑆑𑆫𑇀𑆩𑆱𑇀𑆮𑆨𑆳𑆮𑆯𑇀𑆖𑇆𑇑𑇗𑇆
𑆠𑆢𑆼𑆠𑆖𑇀𑆗𑆫𑆵𑆫𑆁 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆩𑆤𑆼𑆑𑆳𑆮𑆪𑆮𑆁 𑆢𑆸𑆰𑇀𑆛𑆩𑆼𑆑𑆠𑇀𑆮𑆼𑆤 𑆱𑆕𑇀𑆓𑆂, 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤𑆳𑆥𑆮𑆫𑇀𑆓𑆂𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆣𑆳𑆤𑆩𑆱𑆑𑇀𑆠𑆁 𑆱𑆫𑇀𑆮𑆱𑆠𑇀𑆠𑆳𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆿 𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑆅𑆠𑆴𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆯𑆫𑆵𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆁 𑆪𑆾 𑆮𑆼𑆢 𑆱𑆫𑇀𑆮𑆳𑆮𑆪𑆮𑆯𑆾 𑆨𑆴𑆰𑆑𑇀𑇅 𑆠𑆢𑆘𑇀𑆚𑆳𑆤𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆤 𑆱 𑆩𑆾𑆲𑆼𑆤 𑆤 𑆪𑆶𑆘𑇀𑆪𑆠𑆼𑇆𑇑𑇙𑇆
𑆃𑆩𑆷𑆞𑆾 𑆩𑆾𑆲𑆩𑆷𑆬𑆽𑆯𑇀𑆖 𑆤 𑆢𑆾𑆰𑆽𑆫𑆨𑆴𑆨𑆷𑆪𑆠𑆼𑇅 𑆤𑆴𑆫𑇀𑆢𑆾𑆰𑆾 𑆤𑆴𑆂𑆱𑇀𑆥𑆸𑆲𑆂 𑆯𑆳𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑇀𑆪𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆂𑇆𑇒𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆘𑆳𑆠𑆴𑆱𑆷𑆠𑇀𑆫𑆵𑆪𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆪𑆾𑆫𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆯𑆶𑆑𑇀𑆫𑆯𑆾𑆟𑆴𑆠𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆪𑆾𑆂 𑆯𑇀𑆫𑆼𑆪𑆱𑆵𑆁 𑆥𑇀𑆫𑆘𑆳𑆩𑆴𑆖𑇀𑆗𑆠𑆾𑆱𑇀𑆠𑆢𑆫𑇀𑆡𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆫𑆁 𑆑𑆫𑇀𑆩𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇆
𑆃𑆡𑆳𑆥𑇀𑆪𑆼𑆠𑆿 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆁𑆱𑆿 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆥𑆳𑆢𑇀𑆪, 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆯𑆾𑆣𑇀𑆪, 𑆑𑇀𑆫𑆩𑆼𑆟 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆳𑆢𑆪𑆼𑆠𑇀𑇅 𑆱𑆁𑆯𑆶𑆢𑇀𑆣𑆿 𑆖𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀; 𑆇𑆥𑆳𑆖𑆫𑆼𑆖𑇀𑆖 𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆁, 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆁 𑆠𑆶 𑆠𑆽𑆬𑆩𑆳𑆰𑆳𑆨𑇀𑆪𑆳𑆩𑇀𑇆𑇔𑇆
𑆠𑆠𑆂 𑆥𑆶𑆰𑇀𑆥𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆩𑆳𑆱𑆵𑆠 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑇀𑆪𑆣𑆂𑆯𑆳𑆪𑆴𑆤𑆵, 𑆥𑆳𑆟𑆴𑆨𑇀𑆪𑆳𑆩𑆤𑇀𑆤𑆩𑆘𑆫𑇀𑆘𑆫𑆥𑆳𑆠𑇀𑆫𑆳𑆢𑇀𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆳 , 𑆤 𑆖 𑆑𑆳𑆚𑇀𑆖𑆴𑆤𑇀𑆩𑆸𑆘𑆳𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆠𑇅 𑆠𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆼𑇁𑆲𑆤𑇀𑆪𑆼𑆤𑆳𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑇀𑆪 𑆱𑆯𑆴𑆫𑆱𑇀𑆑𑆁 𑆱𑇀𑆤𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆯𑆶𑆑𑇀𑆬𑆳𑆤𑆴 𑆮𑆳𑆱𑆳𑆁𑆱𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆢𑆪𑆼𑆠𑇀 𑆥𑆶𑆫𑆶𑆰𑆁 𑆖𑇅 𑆠𑆠𑆂 𑆯𑆶𑆑𑇀𑆬𑆮𑆳𑆱𑆱𑆿 𑆱𑇀𑆫𑆓𑇀𑆮𑆴𑆟𑆿 𑆱𑆶𑆩𑆤𑆱𑆳𑆮𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆩𑆨𑆴𑆑𑆳𑆩𑆿 𑆱𑆁𑆮𑆱𑆼𑆪𑆳𑆠𑆳𑆁 𑆱𑇀𑆤𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆪𑆶𑆓𑇀𑆩𑆼𑆰𑇀𑆮𑆲𑆂𑆱𑆶 𑆥𑆶𑆠𑇀𑆫𑆑𑆳𑆩𑆿, 𑆃𑆪𑆶𑆓𑇀𑆩𑆼𑆰𑆶 𑆢𑆶𑆲𑆴𑆠𑆸𑆑𑆳𑆩𑆿𑇆𑇕𑇆
𑆤 𑆖 𑆤𑇀𑆪𑆶𑆧𑇀𑆘𑆳𑆁 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆓𑆠𑆳𑆁 𑆮𑆳 𑆱𑆁𑆱𑆼𑆮𑆼𑆠𑇅 𑆤𑇀𑆪𑆶𑆧𑇀𑆘𑆳𑆪𑆳 𑆮𑆳𑆠𑆾 𑆧𑆬𑆮𑆳𑆤𑇀 𑆱 𑆪𑆾𑆤𑆴𑆁 𑆥𑆵𑆝𑆪𑆠𑆴, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆓𑆠𑆳𑆪𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱 𑆖𑇀𑆪𑆶𑆠𑆂 𑆥𑆴𑆢𑆣𑆳𑆠𑆴 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆁, 𑆮𑆳𑆩𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼 𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆢𑆱𑇀𑆪𑆳𑆂 𑆥𑆵𑆝𑆴𑆠𑆁 𑆮𑆴𑆢𑆲𑆠𑆴 𑆫𑆑𑇀𑆠𑆁 𑆯𑆶𑆑𑇀𑆫𑆁 𑆖, 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆠𑇀𑆠𑆳𑆤𑆳 𑆧𑆵𑆘𑆁 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀; 𑆠𑆡𑆳𑆲𑆴 𑆪𑆡𑆳𑆱𑇀𑆡𑆳𑆤𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼 𑆢𑆾𑆰𑆳𑆂𑇅 𑆥𑆫𑇀𑆪𑆳𑆥𑇀𑆠𑆼 𑆖𑆽𑆤𑆳𑆁 𑆯𑆵𑆠𑆾𑆢𑆑𑆼𑆤 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆼𑆠𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆠𑇀𑆪𑆯𑆴𑆠𑆳 𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆳 𑆥𑆴𑆥𑆳𑆱𑆴𑆠𑆳 𑆨𑆵𑆠𑆳 𑆮𑆴𑆩𑆤𑆳𑆂 𑆯𑆾𑆑𑆳𑆫𑇀𑆠𑆳 𑆑𑇀𑆫𑆶𑆢𑇀𑆣𑆳𑇁𑆤𑇀𑆪𑆁 𑆖 𑆥𑆶𑆩𑆳𑆁𑆱𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆵 𑆩𑆽𑆡𑆶𑆤𑆼 𑆖𑆳𑆠𑆴𑆑𑆳𑆩𑆳 𑆮𑆳 𑆤 𑆓𑆫𑇀𑆨𑆁 𑆣𑆠𑇀𑆠𑆼, 𑆮𑆴𑆓𑆶𑆟𑆳𑆁 𑆮𑆳 𑆥𑇀𑆫𑆘𑆳𑆁 𑆘𑆤𑆪𑆠𑆴𑇅 𑆃𑆠𑆴𑆧𑆳𑆬𑆳𑆩𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆢𑆵𑆫𑇀𑆔𑆫𑆾𑆓𑆴𑆟𑆵𑆩𑆤𑇀𑆪𑆼𑆤 𑆮𑆳 𑆮𑆴𑆑𑆳𑆫𑆼𑆟𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆁 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆥𑆶𑆫𑆶𑆰𑆼𑇁𑆥𑇀𑆪𑆼𑆠 𑆍𑆮 𑆢𑆾𑆰𑆳𑆂𑇅 𑆃𑆠𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆮𑆫𑇀𑆘𑆴𑆠𑆿 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆿 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆼𑆪𑆳𑆠𑆳𑆩𑇀𑇆𑇖𑇆
𑆱𑆚𑇀𑆘𑆳𑆠𑆲𑆫𑇀𑆰𑆿 𑆩𑆽𑆡𑆶𑆤𑆼 𑆖𑆳𑆤𑆶𑆑𑆷𑆬𑆳𑆮𑆴𑆰𑇀𑆛𑆓𑆤𑇀𑆣𑆁 𑆱𑇀𑆮𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆁 𑆱𑆶𑆒𑆁 𑆯𑆪𑆤𑆩𑆶𑆥𑆑𑆬𑇀𑆥𑇀𑆪 𑆩𑆤𑆾𑆘𑇀𑆚𑆁 𑆲𑆴𑆠𑆩𑆯𑆤𑆩𑆯𑆴𑆠𑇀𑆮𑆳 𑆤𑆳𑆠𑇀𑆪𑆯𑆴𑆠𑆿 𑆢𑆑𑇀𑆰𑆴𑆟𑆥𑆳𑆢𑆼𑆤 𑆥𑆶𑆩𑆳𑆤𑆳𑆫𑆾𑆲𑆼𑆠𑇀 𑆮𑆳𑆩𑆥𑆳𑆢𑆼𑆤 𑆱𑇀𑆠𑇀𑆫𑆵𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆩𑆤𑇀𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠- “𑆃𑆲𑆴𑆫𑆱𑆴 𑆄𑆪𑆶𑆫𑆱𑆴 𑆱𑆫𑇀𑆮𑆠𑆂 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆳𑇁𑆱𑆴 𑆣𑆳𑆠𑆳 𑆠𑇀𑆮𑆳 𑆢𑆢𑆠𑆶 𑆮𑆴𑆣𑆳𑆠𑆳 𑆠𑇀𑆮𑆳 𑆢𑆣𑆳𑆠𑆶 𑆧𑇀𑆫𑆲𑇀𑆩𑆮𑆫𑇀𑆖𑆱𑆳 𑆨𑆮” 𑆅𑆠𑆴𑇅 “𑆧𑇀𑆫𑆲𑇀𑆩𑆳 𑆧𑆸𑆲𑆱𑇀𑆥𑆠𑆴𑆫𑇀𑆮𑆴𑆰𑇀𑆟𑆶𑆂𑆱𑆾𑆩𑆂𑆱𑆷𑆫𑇀𑆪𑆱𑇀𑆠𑆡𑆳𑇁𑆯𑇀𑆮𑆴𑆤𑆿𑇅 𑆨𑆓𑆾𑇁𑆡 𑆩𑆴𑆠𑇀𑆫𑆳𑆮𑆫𑆶𑆟𑆿 𑆮𑆵𑆫𑆁 𑆢𑆢𑆠𑆶 𑆩𑆼 𑆱𑆶𑆠𑆩𑇀” 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆱𑆁𑆮𑆱𑆼𑆪𑆳𑆠𑆳𑆩𑇀𑇆𑇘𑇆
𑆱𑆳 𑆖𑆼𑆢𑆼𑆮𑆩𑆳𑆯𑆳𑆱𑆵𑆠- 𑆧𑆸𑆲𑆤𑇀𑆠𑆩𑆮𑆢𑆳𑆠𑆁 𑆲𑆫𑇀𑆪𑆑𑇀𑆰𑆩𑆾𑆘𑆱𑇀𑆮𑆴𑆤𑆁 𑆯𑆶𑆖𑆴𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆥𑆶𑆠𑇀𑆫𑆩𑆴𑆖𑇀𑆗𑆼𑆪𑆩𑆴𑆠𑆴, 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆤𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑇀𑆪𑆱𑇀𑆪𑆽 𑆩𑆤𑇀𑆡𑆩𑆮𑆢𑆳𑆠𑆪𑆮𑆳𑆤𑆳𑆁 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆯𑇀𑆮𑆼𑆠𑆳𑆪𑆳 𑆓𑆾𑆂 𑆱𑆫𑆷𑆥𑆮𑆠𑇀𑆱𑆳𑆪𑆳𑆂 𑆥𑆪𑆱𑆳𑇁𑇁𑆬𑆾𑆝𑇀𑆪 𑆫𑆳𑆘𑆠𑆼 𑆑𑆳𑆁𑆱𑇀𑆪𑆼 𑆮𑆳 𑆥𑆳𑆠𑇀𑆫𑆼 𑆑𑆳𑆬𑆼 𑆑𑆳𑆬𑆼 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆱𑆠𑆠𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆠𑇀 𑆥𑆳𑆤𑆳𑆪𑇅 𑆥𑇀𑆫𑆳𑆠𑆯𑇀𑆖 𑆯𑆳𑆬𑆴𑆪𑆮𑆳𑆤𑇀𑆤𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀 𑆢𑆣𑆴𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆂 𑆥𑆪𑆾𑆨𑆴𑆫𑇀𑆮𑆳 𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆨𑆶𑆚𑇀𑆘𑆵𑆠, 𑆠𑆡𑆳 𑆱𑆳𑆪𑆩𑆮𑆢𑆳𑆠𑆯𑆫𑆟𑆯𑆪𑆤𑆳𑆱𑆤𑆥𑆳𑆤𑆮𑆱𑆤𑆨𑆷𑆰𑆟𑆳 𑆖 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆱𑆳𑆪𑆁 𑆥𑇀𑆫𑆳𑆠𑆯𑇀𑆖 𑆯𑆯𑇀𑆮𑆖𑇀𑆗𑇀𑆮𑆼𑆠𑆁 𑆩𑆲𑆳𑆤𑇀𑆠𑆁 𑆮𑆸𑆰𑆨𑆩𑆳𑆘𑆳𑆤𑆼𑆪𑆁 𑆮𑆳 𑆲𑆫𑆴𑆖𑆤𑇀𑆢𑆤𑆳𑆕𑇀𑆓𑆢𑆁 𑆥𑆯𑇀𑆪𑆼𑆠𑇀𑇅 𑆱𑆿𑆩𑇀𑆪𑆳𑆨𑆴𑆯𑇀𑆖𑆽𑆤𑆳𑆁 𑆑𑆡𑆳𑆨𑆴𑆫𑇀𑆩𑆤𑆾𑆤𑆶𑆑𑆷𑆬𑆳𑆨𑆴𑆫𑆶𑆥𑆳𑆱𑆵𑆠𑇅 𑆱𑆿𑆩𑇀𑆪𑆳𑆑𑆸𑆠𑆴𑆮𑆖𑆤𑆾𑆥𑆖𑆳𑆫𑆖𑆼𑆰𑇀𑆛𑆳𑆁𑆯𑇀𑆖 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆳𑆤𑆴𑆠𑆫𑆳𑆤𑆥𑆴 𑆖𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆤𑆮𑆢𑆳𑆠𑆳𑆤𑇀 𑆥𑆯𑇀𑆪𑆼𑆠𑇀𑇅 𑆱𑆲𑆖𑆫𑇀𑆪𑆯𑇀𑆖𑆽𑆤𑆳𑆁 𑆥𑇀𑆫𑆴𑆪𑆲𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆠𑆠𑆩𑆶𑆥𑆖𑆫𑆼𑆪𑆶𑆱𑇀𑆠𑆡𑆳 𑆨𑆫𑇀𑆠𑆳𑇅 𑆤 𑆖 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆪𑆳𑆠𑆳𑆩𑆴𑆠𑆴𑇅 𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆱𑇀𑆡𑆴𑆠𑇀𑆮𑆳𑇁𑆰𑇀𑆛𑆩𑆼𑇁𑆲𑆤𑇀𑆪𑆳𑆥𑇀𑆬𑆶𑆠𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆂 𑆱𑆯𑆴𑆫𑆱𑇀𑆑𑆁 𑆱𑆲 𑆨𑆫𑇀𑆠𑇀𑆫𑆳 𑆃𑆲𑆠𑆳𑆤𑆴 𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆢𑆪𑆼𑆢𑆮𑆢𑆳𑆠𑆳𑆤𑆴, 𑆃𑆮𑆢𑆳𑆠𑆳𑆯𑇀𑆖 𑆱𑇀𑆫𑆘𑆾 𑆨𑆷𑆰𑆟𑆳𑆤𑆴 𑆖 𑆧𑆴𑆨𑆸𑆪𑆳𑆠𑇀𑇆𑇙𑇆
𑆤 𑆒𑆬𑆶 𑆑𑆼𑆮𑆬𑆩𑆼𑆠𑆢𑆼𑆮 𑆑𑆫𑇀𑆩 𑆮𑆫𑇀𑆟𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆑𑆫𑆁 𑆨𑆮𑆠𑆴𑇅 𑆃𑆥𑆴 𑆠𑆶 𑆠𑆼𑆘𑆾𑆣𑆳𑆠𑆶𑆫𑆥𑇀𑆪𑆶𑆢𑆑𑆳𑆤𑇀𑆠𑆫𑆴𑆑𑇀𑆰𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆾𑇁𑆮𑆢𑆳𑆠𑆮𑆫𑇀𑆟𑆑𑆫𑆾 𑆨𑆮𑆠𑆴, 𑆥𑆸𑆡𑆴𑆮𑆵𑆮𑆳𑆪𑆶𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆂 𑆑𑆸𑆰𑇀𑆟𑆮𑆫𑇀𑆟𑆑𑆫𑆂, 𑆱𑆩𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆥𑇀𑆫𑆳𑆪𑆂 𑆯𑇀𑆪𑆳𑆩𑆮𑆫𑇀𑆟𑆑𑆫𑆂𑇆𑇑𑇕𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆑𑆫𑆳𑆟𑆴 𑆥𑆶𑆤𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑆸𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆮𑆠𑇀𑆤𑇀𑆪𑆳𑆂 𑆯𑇀𑆫𑆶𑆠𑆪𑆯𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑇀𑆮𑆾𑆖𑆴𑆠𑆁 𑆖 𑆑𑆫𑇀𑆩 𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆨𑇀𑆪𑆳𑆱𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇖𑇆
𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆾𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆯𑆫𑆵𑆫𑆪𑆾𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆪𑆾𑆫𑇀𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆩𑆳𑆥𑆤𑇀𑆤𑆪𑆾𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆾𑆟𑆴𑆠𑆼𑆤 𑆱𑆲 𑆱𑆁𑆪𑆾𑆓𑆁 𑆱𑆩𑆼𑆠𑇀𑆪𑆳𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆩𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼𑆤 𑆪𑆾𑆤𑆳𑆮𑆤𑆶𑆥𑆲𑆠𑆳𑆪𑆳𑆩𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆼 𑆓𑆫𑇀𑆨𑆳𑆯𑆪𑆼 𑆓𑆫𑇀𑆨𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑇀𑆪𑆼𑆑𑆳𑆤𑇀𑆠𑆼𑆤𑇅 𑆪𑆡𑆳- 𑆤𑆴𑆫𑇀𑆩𑆬𑆼 𑆮𑆳𑆱𑆱𑆴 𑆱𑆶𑆥𑆫𑆴𑆑𑆬𑇀𑆥𑆴𑆠𑆼 𑆫𑆚𑇀𑆘𑆤𑆁 𑆱𑆩𑆶𑆢𑆴𑆠𑆓𑆶𑆟𑆩𑆶𑆥𑆤𑆴𑆥𑆳𑆠𑆳𑆢𑆼𑆮 𑆫𑆳𑆓𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴, 𑆠𑆢𑇀𑆮𑆠𑇀; 𑆪𑆡𑆳 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆁 𑆢𑆣𑇀𑆤𑆳𑇁𑆨𑆴𑆰𑆶𑆠𑆩𑆨𑆴𑆰𑆮𑆟𑆳𑆢𑇀𑆮𑆴𑆲𑆳𑆪 𑆱𑇀𑆮𑆨𑆳𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆢𑆣𑆴𑆨𑆳𑆮𑆁, 𑆯𑆶𑆑𑇀𑆫𑆁 𑆠𑆢𑇀𑆮𑆠𑇀𑇆𑇑𑇗𑇆
𑆍𑆮𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆱𑇀𑆪 𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆠𑇀𑆮𑆼 𑆲𑆼𑆠𑆶𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆂𑇅 𑆪𑆡𑆳 𑆲𑆴 𑆧𑆵𑆘𑆩𑆤𑆶𑆥𑆠𑆥𑇀𑆠𑆩𑆶𑆥𑇀𑆠𑆁 𑆱𑇀𑆮𑆳𑆁 𑆱𑇀𑆮𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆤𑆶𑆮𑆴𑆣𑆵𑆪𑆠𑆼 𑆮𑇀𑆫𑆵𑆲𑆴𑆫𑇀𑆮𑆳 𑆮𑇀𑆫𑆵𑆲𑆴𑆠𑇀𑆮𑆁 𑆪𑆮𑆾 𑆮𑆳 𑆪𑆮𑆠𑇀𑆮𑆁 𑆠𑆡𑆳 𑆱𑇀𑆠𑇀𑆫𑆵𑆥𑆶𑆫𑆶𑆰𑆳𑆮𑆥𑆴 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆲𑆼𑆠𑆶𑆮𑆴𑆨𑆳𑆓𑆩𑆤𑆶𑆮𑆴𑆣𑆵𑆪𑆼𑆠𑆼𑇆𑇑𑇘𑇆
𑆠𑆪𑆾𑆂 𑆑𑆫𑇀𑆩𑆟𑆳 𑆮𑆼𑆢𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆮𑆫𑇀𑆠𑆤𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆵𑆨𑆳𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆱𑆩𑇀𑆪𑆑𑇀𑇅 𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆲𑆴 𑆢𑆼𑆯𑆑𑆳𑆬𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆳𑆤𑆳𑆁 𑆤𑆴𑆪𑆠𑆩𑆴𑆰𑇀𑆛𑆦𑆬𑆠𑇀𑆮𑆁, 𑆠𑆡𑆼𑆠𑆫𑆼𑆰𑆳𑆩𑆴𑆠𑆫𑆠𑇀𑆮𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆥𑆤𑇀𑆤𑆓𑆫𑇀𑆨𑆳𑆁 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆵𑆨𑆳𑆮𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆥𑆶𑆁𑆱𑆮𑆤𑆩𑆱𑇀𑆪𑆽 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆓𑆾𑆰𑇀𑆜𑆼 𑆘𑆳𑆠𑆱𑇀𑆪 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆓𑆶𑆠𑇀𑆠𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆳𑆒𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆶𑆕𑇀𑆓𑆼 𑆃𑆤𑆶𑆥𑆲𑆠𑆼 𑆄𑆢𑆳𑆪 𑆢𑇀𑆮𑆳𑆨𑇀𑆪𑆳𑆁 𑆣𑆳𑆤𑇀𑆪𑆩𑆳𑆰𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆳 𑆱𑆲 𑆢𑆣𑇀𑆤𑆴 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆶𑆰𑇀𑆪𑆼𑆟 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆠𑆡𑆽𑆮𑆳𑆥𑆫𑆳𑆚𑇀𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆱𑆲𑆖𑆫𑆑𑆬𑇀𑆑𑆳𑆁𑆯𑇀𑆖 𑆪𑆶𑆓𑆥𑆢𑆼𑆑𑆽𑆑𑆯𑆾 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆥𑆪𑆱𑆳, 𑆑𑆶𑆝𑇀𑆪𑆑𑆵𑆛𑆑𑆁 𑆩𑆠𑇀𑆱𑇀𑆪𑆑𑆁 𑆮𑆾𑆢𑆑𑆳𑆚𑇀𑆘𑆬𑆿 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆶𑆰𑇀𑆪𑆼𑆟 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆠𑆡𑆳 𑆑𑆤𑆑𑆩𑆪𑆳𑆤𑇀 𑆫𑆳𑆘𑆠𑆳𑆤𑆳𑆪𑆱𑆳𑆁𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆑𑆳𑆤𑆓𑇀𑆤𑆴𑆮𑆫𑇀𑆟𑆳𑆤𑆟𑆶𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑇀 𑆢𑆣𑇀𑆤𑆴 𑆥𑆪𑆱𑇀𑆪𑆶𑆢𑆑𑆳𑆚𑇀𑆘𑆬𑆿 𑆮𑆳 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆴𑆧𑆼𑆢𑆤𑆮𑆯𑆼𑆰𑆠𑆂 𑆥𑆶𑆰𑇀𑆪𑆼𑆟, 𑆥𑆶𑆰𑇀𑆪𑆼𑆟𑆽𑆮 𑆖 𑆯𑆳𑆬𑆴𑆥𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑆥𑆖𑇀𑆪𑆩𑆳𑆤𑆱𑇀𑆪𑆾𑆰𑇀𑆩𑆳𑆟𑆩𑆶𑆥𑆳𑆔𑇀𑆫𑆳𑆪 𑆠𑆱𑇀𑆪𑆽𑆮 𑆖 𑆥𑆴𑆰𑇀𑆛𑆱𑇀𑆪𑆾𑆢𑆑𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆱𑇀𑆪 𑆫𑆱𑆁 𑆢𑆼𑆲𑆬𑇀𑆪𑆳𑆩𑆶𑆥𑆤𑆴𑆣𑆳𑆪 𑆢𑆑𑇀𑆰𑆴𑆟𑆼 𑆤𑆳𑆱𑆳𑆥𑆶𑆛𑆼 𑆱𑇀𑆮𑆪𑆩𑆳𑆱𑆴𑆚𑇀𑆖𑆼𑆠𑇀 𑆥𑆴𑆖𑆶𑆤𑆳𑇅 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳 𑆧𑇀𑆫𑆷𑆪𑆶𑆫𑆳𑆥𑇀𑆠𑆳 𑆮𑆳 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂 𑆥𑆶𑆁𑆱𑆮𑆤𑆩𑆴𑆰𑇀𑆛𑆁 𑆠𑆖𑇀𑆖𑆳𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆩𑇀𑇅 𑆅𑆠𑆴 𑆥𑆶𑆁𑆱𑆮𑆤𑆳𑆤𑆴𑇆𑇑𑇙𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆎𑆤𑇀𑆢𑇀𑆫𑆵 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵 𑆯𑆠𑆮𑆵𑆫𑇀𑆪𑆳 𑆱𑆲𑆱𑇀𑆫𑆮𑆵𑆫𑇀𑆪𑆳𑇁𑆩𑆾𑆔𑆳𑇁𑆮𑇀𑆪𑆡𑆳 𑆯𑆴𑆮𑆳𑇁𑆫𑆴𑆰𑇀𑆛𑆳 𑆮𑆳𑆛𑇀𑆪𑆥𑆶𑆰𑇀𑆥𑆵 𑆮𑆴𑆰𑇀𑆮𑆑𑇀𑆱𑆼𑆤𑆑𑆳𑆤𑇀𑆠𑆳 𑆖𑆼𑆠𑇀𑆪𑆳𑆱𑆳𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆁 𑆯𑆴𑆫𑆱𑆳 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆤 𑆮𑆳 𑆥𑆳𑆟𑆴𑆤𑆳 𑆣𑆳𑆫𑆟𑆁, 𑆍𑆠𑆳𑆨𑆴𑆯𑇀𑆖𑆽𑆮 𑆱𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆥𑆪𑆱𑆂 𑆱𑆫𑇀𑆥𑆴𑆰𑆾 𑆮𑆳 𑆥𑆳𑆤𑆩𑇀, 𑆍𑆠𑆳𑆨𑆴𑆯𑇀𑆖𑆽𑆮 𑆥𑆶𑆰𑇀𑆪𑆼 𑆥𑆶𑆰𑇀𑆪𑆼 𑆱𑇀𑆤𑆳𑆤𑆁, 𑆱𑆢𑆳 𑆖 𑆠𑆳𑆂 𑆱𑆩𑆳𑆬𑆨𑆼𑆠𑇅 𑆠𑆡𑆳 𑆱𑆫𑇀𑆮𑆳𑆱𑆳𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆁 𑆱𑆢𑆾𑆥𑆪𑆾𑆓𑆱𑇀𑆠𑆽𑆱𑇀𑆠𑆽𑆫𑆶𑆥𑆪𑆾𑆓𑆮𑆴𑆣𑆴𑆨𑆴𑆂𑇅 𑆅𑆠𑆴 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇒𑇐𑇆
𑆓𑆫𑇀𑆨𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆳𑆱𑇀𑆠𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆇𑆠𑇀𑆑𑆛𑆮𑆴𑆰𑆩𑆑𑆜𑆴𑆤𑆳𑆱𑆤𑆱𑆼𑆮𑆴𑆤𑇀𑆪𑆳 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆳𑆤𑆶𑆥𑆫𑆶𑆤𑇀𑆣𑆠𑇀𑆪𑆳 𑆢𑆳𑆫𑆶𑆟𑆳𑆤𑆶𑆖𑆴𑆠𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆱𑆼𑆮𑆴𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆱𑆼𑆮𑆴𑆤𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆩𑆴𑆠𑆳𑆯𑆤𑆱𑆼𑆮𑆴𑆤𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆾 𑆩𑇀𑆫𑆴𑆪𑆠𑆼𑇁𑆤𑇀𑆠𑆂 𑆑𑆶𑆑𑇀𑆰𑆼𑆂, 𑆃𑆑𑆳𑆬𑆼 𑆮𑆳 𑆱𑇀𑆫𑆁𑆱𑆠𑆼, 𑆯𑆾𑆰𑆵 𑆮𑆳 𑆨𑆮𑆠𑆴; 𑆠𑆡𑆳𑇁𑆨𑆴𑆔𑆳𑆠𑆥𑇀𑆫𑆥𑆵𑆝𑆤𑆽𑆂 𑆯𑇀𑆮𑆨𑇀𑆫𑆑𑆷𑆥𑆥𑇀𑆫𑆥𑆳𑆠𑆢𑆼𑆯𑆳𑆮𑆬𑆾𑆑𑆤𑆽𑆫𑇀𑆮𑆳𑇁𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆩𑆳𑆠𑆶𑆂 𑆥𑇀𑆫𑆥𑆠𑆠𑇀𑆪𑆑𑆳𑆬𑆼𑆓𑆫𑇀𑆨𑆂, 𑆠𑆡𑆳𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆴𑆨𑆴𑆫𑇀𑆪𑆳𑆤𑆽𑆫𑇀𑆪𑆳𑆤𑆼𑆤, 𑆃𑆥𑇀𑆫𑆴𑆪𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆯𑇀𑆫𑆮𑆟𑆽𑆫𑇀𑆮𑆳𑇅 𑆥𑇀𑆫𑆠𑆠𑆾𑆠𑇀𑆠𑆳𑆤𑆯𑆳𑆪𑆴𑆤𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆓𑆫𑇀𑆨𑆱𑇀𑆪 𑆤𑆳𑆨𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳 𑆤𑆳𑆝𑆵 𑆑𑆟𑇀𑆜𑆩𑆤𑆶𑆮𑆼𑆰𑇀𑆛𑆪𑆠𑆴, 𑆮𑆴𑆮𑆸𑆠𑆯𑆳𑆪𑆴𑆤𑆵 𑆤𑆑𑇀𑆠𑆚𑇀𑆖𑆳𑆫𑆴𑆟𑆵 𑆖𑆾𑆤𑇀𑆩𑆠𑇀𑆠𑆁 𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆴𑆟𑆁 𑆥𑆶𑆤𑆂 𑆑𑆬𑆴𑆑𑆬𑆲𑆯𑆵𑆬𑆳, 𑆮𑇀𑆪𑆮𑆳𑆪𑆯𑆵𑆬𑆳 𑆢𑆶𑆫𑇀𑆮𑆥𑆶𑆰𑆩𑆲𑇀𑆫𑆵𑆑𑆁 𑆱𑇀𑆠𑇀𑆫𑆽𑆟𑆁 𑆮𑆳, 𑆯𑆾𑆑𑆤𑆴𑆠𑇀𑆪𑆳 𑆨𑆵𑆠𑆩𑆥𑆖𑆴𑆠𑆩𑆬𑇀𑆥𑆳𑆪𑆶𑆰𑆁 𑆮𑆳, 𑆃𑆨𑆴𑆣𑇀𑆪𑆳𑆠𑇀𑆫𑆵 𑆥𑆫𑆾𑆥𑆠𑆳𑆥𑆴𑆤𑆩𑆵𑆫𑇀𑆰𑇀𑆪𑆶𑆁 𑆱𑇀𑆠𑇀𑆫𑆽𑆟𑆁 𑆮𑆳, 𑆱𑇀𑆠𑆼𑆤𑆳 𑆠𑇀𑆮𑆳𑆪𑆳𑆱𑆧𑆲𑆶𑆬𑆩𑆠𑆴𑆢𑇀𑆫𑆾𑆲𑆴𑆟𑆩𑆑𑆫𑇀𑆩𑆯𑆵𑆬𑆁 𑆮𑆳, 𑆃𑆩𑆫𑇀𑆰𑆴𑆟𑆵 𑆖𑆟𑇀𑆝𑆩𑆿𑆥𑆣𑆴𑆑𑆩𑆱𑆷𑆪𑆑𑆁 𑆮𑆳 𑆱𑇀𑆮𑆥𑇀𑆤𑆤𑆴𑆠𑇀𑆪𑆳 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆬𑆶𑆩𑆧𑆶𑆣𑆩𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆴𑆁 𑆮𑆳, 𑆩𑆢𑇀𑆪𑆤𑆴𑆠𑇀𑆪𑆳 𑆥𑆴𑆥𑆳𑆱𑆳𑆬𑆶𑆩𑆬𑇀𑆥𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆖𑆴𑆠𑇀𑆠𑆁 𑆮𑆳, 𑆓𑆾𑆣𑆳𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆳𑆪𑆳 𑆯𑆳𑆫𑇀𑆑𑆫𑆴𑆟𑆩𑆯𑇀𑆩𑆫𑆴𑆟𑆁 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆴𑆟𑆁 𑆮𑆳, 𑆮𑆫𑆳𑆲𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆳𑆪𑆳 𑆫𑆑𑇀𑆠𑆳𑆑𑇀𑆰𑆁 𑆑𑇀𑆫𑆡𑆤𑆩𑆠𑆴𑆥𑆫𑆶𑆰𑆫𑆾𑆩𑆳𑆟𑆁 𑆮𑆳, 𑆩𑆠𑇀𑆱𑇀𑆪𑆩𑆳𑆁𑆱𑆤𑆴𑆠𑇀𑆪𑆳 𑆖𑆴𑆫𑆤𑆴𑆩𑆼𑆰𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆳𑆑𑇀𑆰𑆁 𑆮𑆳, 𑆩𑆣𑆶𑆫𑆤𑆴𑆠𑇀𑆪𑆳 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆁 𑆩𑆷𑆑𑆩𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆁 𑆮𑆳, 𑆃𑆩𑇀𑆬𑆤𑆴𑆠𑇀𑆪𑆳 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆴𑆤𑆁 𑆠𑇀𑆮𑆓𑆑𑇀𑆰𑆴𑆫𑆾𑆓𑆴𑆟𑆁 𑆮𑆳, 𑆬𑆮𑆟𑆤𑆴𑆠𑇀𑆪𑆳 𑆯𑆵𑆔𑇀𑆫𑆮𑆬𑆵𑆥𑆬𑆴𑆠𑆁 𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆫𑆾𑆓𑆴𑆟𑆁 𑆮𑆳, 𑆑𑆛𑆶𑆑𑆤𑆴𑆠𑇀𑆪𑆳 𑆢𑆶𑆫𑇀𑆧𑆬𑆩𑆬𑇀𑆥𑆯𑆶𑆑𑇀𑆫𑆩𑆤𑆥𑆠𑇀𑆪𑆁 𑆮𑆳, 𑆠𑆴𑆑𑇀𑆠𑆤𑆴𑆠𑇀𑆪𑆳 𑆯𑆾𑆰𑆴𑆟𑆩𑆧𑆬𑆩𑆤𑆶𑆥𑆖𑆴𑆠𑆁 𑆮𑆳, 𑆑𑆰𑆳𑆪𑆤𑆴𑆠𑇀𑆪𑆳 𑆯𑇀𑆪𑆳𑆮𑆩𑆳𑆤𑆳𑆲𑆴𑆤𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆴𑆤𑆁 𑆮𑆳, 𑆪𑆢𑇀𑆪𑆖𑇀𑆖 𑆪𑆱𑇀𑆪 𑆪𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆤𑆴𑆢𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆁 𑆠𑆠𑇀𑆠𑆢𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆮𑆠𑇀𑆤𑆵 𑆠𑆤𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆧𑆲𑆶𑆬𑆩𑆥𑆠𑇀𑆪𑆁 𑆘𑆤𑆪𑆠𑆴𑇅 𑆥𑆴𑆠𑆸𑆘𑆳𑆱𑇀𑆠𑆶 𑆯𑆶𑆑𑇀𑆫𑆢𑆾𑆰𑆳 𑆩𑆳𑆠𑆸𑆘𑆽𑆫𑆥𑆖𑆳𑆫𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇅 𑆅𑆠𑆴 𑆓𑆫𑇀𑆨𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆳 𑆨𑆳𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆲𑆴𑆠𑆳𑆤𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆳𑆤𑇀 𑆥𑇀𑆫𑆘𑆳𑆱𑆩𑇀𑆥𑆢𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆵 𑆱𑇀𑆠𑇀𑆫𑆵 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆱𑆳𑆣𑇀𑆮𑆳𑆖𑆳𑆫𑆳 𑆖𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆶𑆥𑆖𑆫𑆼𑆢𑇀𑆣𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆳𑆨𑇀𑆪𑆳𑆩𑆴𑆠𑆴𑇆𑇒𑇑𑇆
𑆮𑇀𑆪𑆳𑆣𑆵𑆁𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆳 𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆯𑆴𑆯𑆴𑆫𑆱𑆶𑆒𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆥𑇀𑆫𑆳𑆪𑆽𑆫𑆿𑆰𑆣𑆳𑆲𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆽𑆫𑆶𑆥𑆖𑆫𑆼𑆠𑇀, 𑆤 𑆖𑆳𑆱𑇀𑆪𑆳 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀, 𑆤 𑆫𑆑𑇀𑆠𑆩𑆮𑆱𑆼𑆖𑆪𑆼𑆠𑇀, 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆁 𑆖 𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆩𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆮𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆼𑆂𑇅 𑆃𑆰𑇀𑆛𑆩𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆳𑆢𑆳𑆪 𑆮𑆩𑆤𑆳𑆢𑆴𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑆶 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆼𑆰𑆶 𑆩𑆸𑆢𑆶𑆨𑆴𑆫𑇀𑆮𑆩𑆤𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆢𑆫𑇀𑆡𑆑𑆳𑆫𑆴𑆨𑆴𑆫𑇀𑆮𑆾𑆥𑆖𑆳𑆫𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆥𑆷𑆫𑇀𑆟𑆩𑆴𑆮 𑆠𑆽𑆬𑆥𑆳𑆠𑇀𑆫𑆩𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆪𑆠𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆮𑆠𑇀𑆤𑆵 𑆨𑆮𑆠𑇀𑆪𑆶𑆥𑆖𑆫𑇀𑆪𑆳𑇆𑇒𑇒𑇆
𑆱𑆳 𑆖𑆼𑆢𑆥𑆖𑆳𑆫𑆳𑆢𑇀 𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑇀𑆫𑆴𑆰𑆶 𑆮𑆳 𑆩𑆳𑆱𑆼𑆰𑆶 𑆥𑆶𑆰𑇀𑆥𑆁 𑆥𑆯𑇀𑆪𑆼𑆤𑇀𑆤𑆳𑆱𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆂 𑆱𑇀𑆡𑆳𑆱𑇀𑆪𑆠𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆃𑆘𑆳𑆠𑆱𑆳𑆫𑆾 𑆲𑆴 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼 𑆨𑆮𑆠𑆴 𑆓𑆫𑇀𑆨𑆂𑇆𑇒𑇓𑇆
𑆱𑆳 𑆖𑆼𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆰𑆶 𑆩𑆳𑆱𑆼𑆰𑆶 𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆳𑆱𑆷𑆪𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆨𑆪𑆠𑇀𑆫𑆳𑆱𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆯𑆪𑆤𑆱𑇀𑆡𑆳𑆤𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆠𑇀 𑆑𑆢𑆳𑆲𑆳𑆫𑆳𑆢𑇀𑆮𑆳 𑆥𑆶𑆰𑇀𑆥𑆁 𑆥𑆯𑇀𑆪𑆼𑆠𑇀, 𑆠𑆱𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆱𑇀𑆡𑆳𑆥𑆤𑆮𑆴𑆣𑆴𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆥𑆶𑆰𑇀𑆥𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑆼𑆮𑆽𑆤𑆳𑆁 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆯𑆪𑆤𑆁 𑆠𑆳𑆮𑆤𑇀𑆩𑆸𑆢𑆶𑆱𑆶𑆒𑆯𑆴𑆯𑆴𑆫𑆳𑆱𑇀𑆠𑆫𑆟𑆱𑆁𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆩𑆵𑆰𑆢𑆮𑆤𑆠𑆯𑆴𑆫𑆱𑇀𑆑𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆱𑇀𑆮𑆼𑆠𑆴𑇅 𑆠𑆠𑆾 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑆩𑆯𑆴𑆯𑆴𑆫𑆮𑆳𑆫𑆴𑆟𑆵 𑆱𑆁𑆱𑇀𑆡𑆴𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆴𑆖𑆶𑆩𑆳𑆥𑇀𑆬𑆳𑆮𑇀𑆪𑆾𑆥𑆱𑇀𑆡𑆱𑆩𑆵𑆥𑆼 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆂, 𑆠𑆡𑆳 𑆯𑆠𑆣𑆿𑆠𑆱𑆲𑆱𑇀𑆫𑆣𑆿𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆩𑆣𑆾𑆤𑆳𑆨𑆼𑆂 𑆱𑆫𑇀𑆮𑆠𑆂 𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪𑆳𑆠𑇀, 𑆱𑆫𑇀𑆮𑆠𑆯𑇀𑆖 𑆓𑆮𑇀𑆪𑆼𑆤 𑆖𑆽𑆤𑆳𑆁 𑆥𑆪𑆱𑆳 𑆱𑆶𑆯𑆵𑆠𑆼𑆤 𑆩𑆣𑆶𑆑𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆮𑆳 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆳 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆢𑆣𑆾 𑆤𑆳𑆨𑆼𑆂, 𑆇𑆢𑆑𑆁 𑆮𑆳 𑆱𑆶𑆯𑆵𑆠𑆩𑆮𑆓𑆳𑆲𑆪𑆼𑆠𑇀, 𑆑𑇀𑆰𑆵𑆫𑆴𑆟𑆳𑆁 𑆑𑆰𑆳𑆪𑆢𑇀𑆫𑆶𑆩𑆳𑆟𑆳𑆁 𑆖 𑆱𑇀𑆮𑆫𑆱𑆥𑆫𑆴𑆥𑆵𑆠𑆳𑆤𑆴 𑆖𑆼𑆬𑆳𑆤𑆴 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀, 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆯𑆶𑆕𑇀𑆓𑆳𑆱𑆴𑆢𑇀𑆣𑆪𑆾𑆫𑇀𑆮𑆳𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆾𑆂 𑆥𑆴𑆖𑆶𑆁 𑆓𑇀𑆫𑆳𑆲𑆪𑆼𑆠𑇀, 𑆃𑆠𑆯𑇀𑆖𑆽𑆮𑆳𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑇀𑆫𑆳𑆯𑆪𑆼𑆠𑇀, 𑆥𑇀𑆫𑆳𑆯𑆪𑆼𑆢𑇀𑆮𑆳 𑆑𑆼𑆮𑆬𑆁 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆂, 𑆥𑆢𑇀𑆩𑆾𑆠𑇀𑆥𑆬𑆑𑆶𑆩𑆶𑆢𑆑𑆴𑆚𑇀𑆘𑆬𑇀𑆑𑆳𑆁𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆽 𑆱𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆳𑆤𑇀 𑆬𑆼𑆲𑆳𑆫𑇀𑆡𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀, 𑆯𑆸𑆕𑇀𑆓𑆳𑆛𑆑𑆥𑆶𑆰𑇀𑆑𑆫𑆧𑆵𑆘𑆑𑆯𑆼𑆫𑆶𑆑𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑇀𑆟𑆳𑆫𑇀𑆡𑆁, 𑆓𑆤𑇀𑆣𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑇀𑆮𑆱𑆴𑆠𑆾𑆠𑇀𑆥𑆬𑆯𑆳𑆬𑆷𑆑𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆯𑆬𑆳𑆛𑆶𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆯𑆶𑆕𑇀𑆓𑆳𑆤𑆴 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆢𑆼𑆤𑆳𑆩𑆳𑆘𑆼𑆤 𑆥𑆪𑆱𑆳, 𑆥𑆪𑆱𑆳 𑆖𑆽𑆤𑆳𑆁 𑆧𑆬𑆳𑆠𑆴𑆧𑆬𑆳𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆼𑆑𑇀𑆰𑆶𑆩𑆷𑆬𑆑𑆳𑆑𑆾𑆬𑆵𑆯𑆸𑆠𑆼𑆤 𑆱𑆩𑆣𑆶𑆯𑆫𑇀𑆑𑆫𑆁 𑆫𑆑𑇀𑆠𑆯𑆳𑆬𑆵𑆤𑆳𑆩𑆾𑆢𑆤𑆁 𑆩𑆸𑆢𑆶𑆱𑆶𑆫𑆨𑆴𑆯𑆵𑆠𑆬𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀, 𑆬𑆳𑆮𑆑𑆥𑆴𑆚𑇀𑆘𑆬𑆑𑆶𑆫𑆕𑇀𑆓𑆯𑆩𑇀𑆧𑆫𑆯𑆯𑆲𑆫𑆴𑆟𑆽𑆟𑆑𑆳𑆬𑆥𑆶𑆖𑇀𑆗𑆑𑆫𑆱𑆼𑆤 𑆮𑆳 𑆔𑆸𑆠𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆼𑆤 𑆱𑆶𑆒𑆯𑆴𑆯𑆴𑆫𑆾𑆥𑆮𑆳𑆠𑆢𑆼𑆯𑆱𑇀𑆡𑆳𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀, 𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆳𑆪𑆳𑆱𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆼𑆨𑇀𑆪𑆯𑇀𑆖𑆳𑆨𑆴𑆫𑆑𑇀𑆰𑆼𑆠𑇀, 𑆱𑆿𑆩𑇀𑆪𑆳𑆨𑆴𑆯𑇀𑆖𑆽𑆤𑆳𑆁 𑆑𑆡𑆳𑆨𑆴𑆫𑇀𑆩𑆤𑆾𑆤𑆶𑆑𑆷𑆬𑆳𑆨𑆴𑆫𑆶𑆥𑆳𑆱𑆵𑆠; 𑆠𑆡𑆳𑇁𑆱𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴𑇆𑇒𑇔𑇆
𑆪𑆱𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑆳𑆩𑆳𑆤𑇀𑆮𑆪𑆳𑆠𑇀 𑆥𑆶𑆰𑇀𑆥𑆢𑆫𑇀𑆯𑆤𑆁 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆥𑇀𑆫𑆳𑆪𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆢𑇀𑆓𑆫𑇀𑆨𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆁 𑆨𑆮𑆠𑆴, 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆪𑆾𑆂𑇆𑇒𑇕𑇆
𑆪𑆱𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑆶𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆴𑆟𑇀𑆪𑆳 𑆩𑆲𑆠𑆴 𑆱𑆚𑇀𑆘𑆳𑆠𑆱𑆳𑆫𑆼 𑆓𑆫𑇀𑆨𑆼 𑆥𑆶𑆰𑇀𑆥𑆢𑆫𑇀𑆯𑆤𑆁 𑆱𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆾 𑆮𑆳 𑆪𑆾𑆤𑆴𑆱𑇀𑆫𑆳𑆮𑆱𑇀𑆠𑆱𑇀𑆪𑆳 𑆓𑆫𑇀𑆨𑆾 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆤 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆑𑆳𑆬𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁, 𑆠𑆩𑆶𑆥𑆮𑆴𑆰𑇀𑆛𑆑𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆑𑆼𑆖𑆴𑆠𑇀𑇅 𑆇𑆥𑆮𑆳𑆱𑆮𑇀𑆫𑆠𑆑𑆫𑇀𑆩𑆥𑆫𑆳𑆪𑆳𑆂 𑆥𑆶𑆤𑆂 𑆑𑆢𑆳𑆲𑆳𑆫𑆳𑆪𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑇀𑆪𑆳 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆾𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆳𑆪𑆳 𑆓𑆫𑇀𑆨𑆾 𑆮𑆸𑆢𑇀𑆣𑆴𑆁 𑆤 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆖𑆳𑆥𑆴 𑆑𑆳𑆬𑆩𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑇀 , 𑆃𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆠𑆁 𑆠𑆶 𑆤𑆳𑆓𑆾𑆢𑆫𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇒𑇖𑇆
𑆤𑆳𑆫𑇀𑆪𑆾𑆱𑇀𑆠𑆪𑆾𑆫𑆶𑆨𑆪𑆾𑆫𑆥𑆴 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆨𑆿𑆠𑆴𑆑𑆘𑆵𑆮𑆤𑆵𑆪𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆩𑆣𑆶𑆫𑆮𑆳𑆠𑆲𑆫𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑆁 𑆥𑆪𑆱𑆳𑆩𑆳𑆩𑆓𑆫𑇀𑆨𑆳𑆟𑆳𑆁 𑆖𑆾𑆥𑆪𑆾𑆓𑆾 𑆓𑆫𑇀𑆨𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆂; 𑆠𑆡𑆳 𑆱𑆩𑇀𑆨𑆾𑆘𑆤𑆩𑆼𑆠𑆽𑆫𑆼𑆮 𑆱𑆴𑆢𑇀𑆣𑆽𑆯𑇀𑆖 𑆔𑆸𑆠𑆳𑆢𑆴𑆨𑆴𑆂 𑆱𑆶𑆨𑆴𑆑𑇀𑆰𑆳𑆪𑆳𑆂 , 𑆃𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆪𑆳𑆤𑆮𑆳𑆲𑆤𑆳𑆥𑆩𑆳𑆫𑇀𑆘𑆤𑆳𑆮𑆘𑆸𑆩𑇀𑆨𑆟𑆽𑆫𑆶𑆥𑆥𑆳𑆢𑆤𑆩𑆴𑆠𑆴𑇆𑇒𑇗𑇆
𑆪𑆱𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆓𑆫𑇀𑆨𑆂 𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆾 𑆤 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼 𑆠𑆳𑆁 𑆯𑇀𑆪𑆼𑆤𑆩𑆠𑇀𑆱𑇀𑆪𑆓𑆮𑆪𑆯𑆴𑆒𑆴𑆠𑆳𑆩𑇀𑆫𑆖𑆷𑆝𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆵𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆩𑆠𑆳 𑆫𑆱𑆼𑆤 𑆩𑆳𑆰𑆪𑆷𑆰𑆼𑆟 𑆮𑆳 𑆥𑇀𑆫𑆨𑆷𑆠𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆩𑆷𑆬𑆑𑆪𑆷𑆰𑆼𑆟 𑆮𑆳 𑆫𑆑𑇀𑆠𑆯𑆳𑆬𑆵𑆤𑆳𑆩𑆾𑆢𑆤𑆁 𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆬𑆁 𑆨𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆠𑆽𑆬𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼𑆤 𑆖𑆳𑆱𑇀𑆪𑆳 𑆃𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆶𑆢𑆫𑆧𑆱𑇀𑆠𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆾𑆫𑆶𑆑𑆛𑆵𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆥𑇀𑆫𑆢𑆼𑆯𑆳𑆤𑆵𑆰𑆢𑆶𑆰𑇀𑆟𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀𑇆𑇒𑇘𑇆
𑆪𑆱𑇀𑆪𑆳𑆂 𑆥𑆶𑆤𑆫𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆮𑆴𑆧𑆤𑇀𑆣𑆂 𑆱𑇀𑆪𑆳𑆢𑆰𑇀𑆛𑆩𑆼 𑆩𑆳𑆱𑆼 𑆤 𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆱𑆳𑆣𑇀𑆪𑆁 𑆩𑆤𑇀𑆪𑆼𑆠 𑆠𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆯𑆩𑆤𑆩𑆶𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆤𑇀𑆤𑆴𑆫𑆷𑆲𑆩𑇀𑇅 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆾 𑆲𑇀𑆪𑆶𑆥𑆼𑆑𑇀𑆰𑆴𑆠𑆂 𑆱𑆲𑆱𑆳 𑆱𑆓𑆫𑇀𑆨𑆳𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆁 𑆓𑆫𑇀𑆨𑆩𑆡𑆮𑆳𑇁𑆠𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀𑇅 𑆠𑆠𑇀𑆫 𑆮𑆵𑆫𑆟𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆑𑆶𑆯𑆑𑆳𑆯𑆼𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆮𑆼𑆠𑆱𑆥𑆫𑆴𑆮𑇀𑆪𑆳𑆣𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆨𑆷𑆠𑆵𑆑𑆳𑆤𑆤𑇀𑆠𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆥𑆫𑆷𑆰𑆑𑆩𑆣𑆶𑆑𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆤𑆳𑆁 𑆖 𑆥𑆪𑆱𑆳𑇁𑆫𑇀𑆣𑆾𑆢𑆑𑆼𑆤𑆾𑆢𑇀𑆓𑆩𑆪𑇀𑆪 𑆫𑆱𑆁 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆧𑆴𑆨𑆵𑆠𑆑𑆩𑆘𑇀𑆘𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆩𑆵𑆰𑆬𑇀𑆬𑆮𑆟𑆩𑆤𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆖 𑆤𑆴𑆫𑆷𑆲𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆮𑇀𑆪𑆥𑆓𑆠𑆮𑆴𑆧𑆤𑇀𑆣𑆳𑆁 𑆖𑆽𑆤𑆳𑆁 𑆱𑆶𑆒𑆱𑆬𑆴𑆬𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆳𑆕𑇀𑆓𑆵𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆑𑆫𑆩𑆮𑆴𑆢𑆳𑆲𑆴𑆤𑆩𑆳𑆲𑆳𑆫𑆁 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆵𑆁 𑆱𑆳𑆪𑆁 𑆩𑆣𑆶𑆫𑆑𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆠𑆽𑆬𑆼𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀𑇅 𑆤𑇀𑆪𑆶𑆧𑇀𑆘𑆳𑆁 𑆠𑇀𑆮𑆼𑆤𑆳𑆩𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆖𑆫𑆼𑆠𑇀𑇆𑇒𑇙𑇆
𑆃𑆱𑆩𑇀𑆪𑆑𑇀𑆑𑆬𑇀𑆥𑆤𑆼 𑆲𑆴 𑆤𑆳𑆝𑇀𑆪𑆳 𑆄𑆪𑆳𑆩𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑆠𑇀𑆠𑆶𑆟𑇀𑆝𑆴𑆠𑆳-𑆥𑆴𑆟𑇀𑆝𑆬𑆴𑆑𑆳-𑆮𑆴𑆤𑆳𑆩𑆴𑆑𑆳-𑆮𑆴𑆘𑆸𑆩𑇀𑆨𑆴𑆑𑆳𑆧𑆳𑆣𑆼𑆨𑇀𑆪𑆾 𑆨𑆪𑆩𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆮𑆴𑆢𑆳𑆲𑆴𑆨𑆴𑆫𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆽𑆫𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆥𑆫𑆴𑆰𑆼𑆑𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆯𑇀𑆖𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑇆𑇔𑇕𑇆
𑆃𑆡𑆳𑆱𑇀𑆪 𑆫𑆑𑇀𑆰𑆳𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀- 𑆄𑆢𑆳𑆤𑆵𑆒𑆢𑆴𑆫𑆑𑆫𑇀𑆑𑆤𑇀𑆣𑆶𑆥𑆵𑆬𑆶𑆥𑆫𑆷𑆰𑆑𑆯𑆳𑆒𑆳𑆨𑆴𑆫𑆱𑇀𑆪𑆳 𑆓𑆸𑆲𑆁 𑆱𑆩𑆤𑇀𑆠𑆠𑆂 𑆥𑆫𑆴𑆮𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆱𑆫𑇀𑆮𑆠𑆯𑇀𑆖 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆳𑆫𑆱𑇀𑆪 𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆠𑆟𑇀𑆝𑆶𑆬𑆑𑆟𑆑𑆟𑆴𑆑𑆳𑆂 𑆥𑇀𑆫𑆑𑆴𑆫𑆼𑆪𑆶𑆂𑇅 𑆠𑆡𑆳 𑆠𑆟𑇀𑆝𑆶𑆬𑆧𑆬𑆴𑆲𑆾𑆩𑆂 𑆱𑆠𑆠𑆩𑆶𑆨𑆪𑆑𑆳𑆬𑆁 𑆑𑇀𑆫𑆴𑆪𑆼𑆠𑆳𑆤𑆳𑆩𑆑𑆫𑇀𑆩𑆟𑆂 𑇅 𑆢𑇀𑆮𑆳𑆫𑆼 𑆖 𑆩𑆶𑆱𑆬𑆁 𑆢𑆼𑆲𑆬𑆵𑆩𑆤𑆶 𑆠𑆴𑆫𑆯𑇀𑆖𑆵𑆤𑆁 𑆤𑇀𑆪𑆱𑆼𑆠𑇀𑇅 𑆮𑆖𑆳𑆑𑆶𑆰𑇀𑆜𑆑𑇀𑆰𑆿𑆩𑆑𑆲𑆴𑆕𑇀𑆓𑆶𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆬𑆯𑆶𑆤𑆑𑆟𑆑𑆟𑆴𑆑𑆳𑆤𑆳𑆁 𑆫𑆑𑇀𑆰𑆾𑆔𑇀𑆤𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆳𑆁 𑆖𑆿𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑆾𑆛𑇀𑆛𑆬𑆴𑆑𑆳𑆁 𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆳𑆫𑆱𑇀𑆪𑆾𑆠𑇀𑆠𑆫𑆢𑆼𑆲𑆬𑇀𑆪𑆳𑆩𑆮𑆱𑆸𑆘𑆼𑆠𑇀, 𑆠𑆡𑆳 𑆱𑆷𑆠𑆴𑆑𑆳𑆪𑆳𑆂 𑆑𑆟𑇀𑆜𑆼 𑆱𑆥𑆶𑆠𑇀𑆫𑆳𑆪𑆳𑆂, 𑆱𑇀𑆡𑆳𑆬𑇀𑆪𑆶𑆢𑆑𑆑𑆶𑆩𑇀𑆨𑆥𑆫𑇀𑆪𑆕𑇀𑆑𑆼𑆰𑇀𑆮𑆥𑆴, 𑆠𑆡𑆽𑆮 𑆖 𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆳𑆫𑆥𑆑𑇀𑆰𑆪𑆾𑆂𑇅 𑆑𑆟𑆑𑆑𑆟𑇀𑆛𑆑𑆼𑆤𑇀𑆣𑆤𑆮𑆳𑆤𑆓𑇀𑆤𑆴𑆱𑇀𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆑𑆳𑆰𑇀𑆜𑆼𑆤𑇀𑆣𑆤𑆯𑇀𑆖𑆳𑆓𑇀𑆤𑆴𑆂 𑆱𑆷𑆠𑆴𑆑𑆳𑆓𑆳𑆫𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆾 𑆤𑆴𑆠𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆯𑇀𑆖𑆽𑆤𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆳𑆂 𑆱𑆶𑆲𑆸𑆢𑆯𑇀𑆖𑆳𑆤𑆶𑆯𑇀𑆖𑆳𑆤𑆶𑆘𑆳𑆓𑆸𑆪𑆶𑆫𑇀𑆢𑆯𑆳𑆲𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆁 𑆮𑆳𑇅 𑆃𑆤𑆶𑆥𑆫𑆠𑆥𑇀𑆫𑆢𑆳𑆤𑆩𑆕𑇀𑆓𑆬𑆳𑆯𑆵𑆂𑆱𑇀𑆠𑆶𑆠𑆴𑆓𑆵𑆠𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆯𑆢𑆩𑆤𑆶𑆫𑆑𑇀𑆠𑆥𑇀𑆫𑆲𑆸𑆰𑇀𑆛𑆘𑆤𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆁 𑆖 𑆠𑆢𑇀𑆮𑆼𑆯𑇀𑆩 𑆑𑆳𑆫𑇀𑆪𑆩𑇀𑇅 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆯𑇀𑆖𑆳𑆡𑆫𑇀𑆮𑆮𑆼𑆢𑆮𑆴𑆠𑇀 𑆱𑆠𑆠𑆩𑆶𑆨𑆪𑆑𑆳𑆬𑆁 𑆯𑆳𑆤𑇀𑆠𑆴𑆁 𑆘𑆶𑆲𑆶𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆪𑆤𑆳𑆫𑇀𑆡𑆁 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆠𑆡𑆳 𑆱𑆷𑆠𑆴𑆑𑆳𑆪𑆳𑆂𑇅 𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆳𑆤𑆩𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇔𑇗𑇆
𑆱𑆷𑆠𑆴𑆑𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆳𑆁 𑆮𑆴𑆢𑆴𑆠𑇀𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆁 𑆥𑆳𑆪𑆪𑆼𑆠 𑆥𑆫𑆩𑆪𑆳 𑆯𑆑𑇀𑆠𑇀𑆪𑆳 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆮𑆱𑆳𑆁 𑆩𑆘𑇀𑆘𑆳𑆤𑆁 𑆮𑆳 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆵𑆨𑆳𑆮𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆖𑆷𑆫𑇀𑆟𑆱𑆲𑆴𑆠𑆩𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆁 𑆥𑆵𑆠𑆮𑆠𑇀𑆪𑆳𑆯𑇀𑆖 𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆳𑆨𑇀𑆪𑆳𑆩𑆨𑇀𑆪𑆘𑇀𑆪 𑆮𑆼𑆰𑇀𑆛𑆪𑆼𑆢𑆶𑆢𑆫𑆁 𑆩𑆲𑆠𑆳𑇁𑆖𑇀𑆗𑆼𑆤 𑆮𑆳𑆱𑆱𑆳; 𑆠𑆡𑆳 𑆠𑆱𑇀𑆪𑆳 𑆤 𑆮𑆳𑆪𑆶𑆫𑆶𑆢𑆫𑆼 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑇀𑆪𑆤𑆮𑆑𑆳𑆯𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆠𑆶 𑆱𑇀𑆤𑆼𑆲𑆼 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑆼𑆮 𑆱𑆴𑆢𑇀𑆣𑆳𑆁 𑆪𑆮𑆳𑆓𑆷𑆁 𑆱𑆶𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆁 𑆢𑇀𑆫𑆮𑆳𑆁 𑆩𑆳𑆠𑇀𑆫𑆯𑆂 𑆥𑆳𑆪𑆪𑆼𑆠𑇀𑇅 𑆇𑆨𑆪𑆠𑆂𑆑𑆳𑆬𑆁 𑆖𑆾𑆰𑇀𑆟𑆾𑆢𑆑𑆼𑆤 𑆖 𑆥𑆫𑆴𑆰𑆼𑆖𑆪𑆼𑆠𑇀 𑆥𑇀𑆫𑆳𑆑𑇀 𑆱𑇀𑆤𑆼𑆲𑆪𑆮𑆳𑆓𑆷𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑇀𑇅 𑆍𑆮𑆁 𑆥𑆚𑇀𑆖𑆫𑆳𑆠𑇀𑆫𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆮𑆳𑇁𑆤𑆶𑆥𑆳𑆬𑇀𑆪 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆼𑆠𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆩𑆼𑆠𑆳𑆮𑆠𑇀 𑆱𑆷𑆠𑆴𑆑𑆳𑆪𑆳𑆂𑇆𑇔𑇘𑇆
𑆠𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆱 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆾 𑆨𑆮𑆠𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆾 𑆮𑆳, 𑆓𑆫𑇀𑆨𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑇀𑆰𑆪𑆴𑆠𑆯𑆴𑆡𑆴𑆬𑆱𑆫𑇀𑆮𑆣𑆳𑆠𑆶𑆠𑇀𑆮𑆳𑆠𑇀, 𑆥𑇀𑆫𑆮𑆳𑆲𑆟𑆮𑆼𑆢𑆤𑆳𑆑𑇀𑆬𑆼𑆢𑆤𑆫𑆑𑇀𑆠𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆯𑆷𑆤𑇀𑆪𑆯𑆫𑆵𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆖; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆾𑆥𑆖𑆫𑆼𑆠𑇀; 𑆨𑆿𑆠𑆴𑆑𑆘𑆵𑆮𑆤𑆵𑆪𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆩𑆣𑆶𑆫𑆮𑆳𑆠𑆲𑆫𑆱𑆴𑆢𑇀𑆣𑆽𑆫𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆤𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆮𑆴𑆣𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆠𑆯𑇀𑆖𑆾𑆥𑆖𑆫𑆼𑆠𑇀; 𑆮𑆴𑆯𑆼𑆰𑆠𑆾 𑆲𑆴 𑆯𑆷𑆤𑇀𑆪𑆯𑆫𑆵𑆫𑆳𑆂 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆂 𑆥𑇀𑆫𑆘𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇙𑇆
𑆢𑆯𑆩𑆼 𑆠𑇀𑆮𑆲𑆤𑆴 𑆱𑆥𑆶𑆠𑇀𑆫𑆳 𑆱𑇀𑆠𑇀𑆫𑆵 𑆱𑆫𑇀𑆮𑆓𑆤𑇀𑆣𑆿𑆰𑆣𑆽𑆫𑇀𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆬𑆾𑆣𑇀𑆫𑆽𑆯𑇀𑆖 𑆱𑇀𑆤𑆳𑆠𑆳 𑆬𑆔𑇀𑆮𑆲𑆠𑆯𑆶𑆖𑆴𑆮𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆫𑆴𑆣𑆳𑆪 𑆥𑆮𑆴𑆠𑇀𑆫𑆼𑆰𑇀𑆛𑆬𑆔𑆶𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆨𑆷𑆰𑆟𑆮𑆠𑆵 𑆖 𑆱𑆁𑆱𑇀𑆥𑆸𑆯𑇀𑆪 𑆩𑆕𑇀𑆓𑆬𑆳𑆤𑇀𑆪𑆶𑆖𑆴𑆠𑆳𑆩𑆫𑇀𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆖 𑆢𑆼𑆮𑆠𑆳𑆁 𑆯𑆴𑆒𑆴𑆤𑆂 𑆯𑆶𑆑𑇀𑆬𑆮𑆳𑆱𑆱𑆾𑇁𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆁𑆯𑇀𑆖 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆤𑇀 𑆱𑇀𑆮𑆱𑇀𑆠𑆴 𑆮𑆳𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆑𑆶𑆩𑆳𑆫𑆩𑆲𑆠𑆳𑆤𑆳𑆁 𑆖 𑆮𑆳𑆱𑆱𑆳𑆁 𑆱𑆚𑇀𑆖𑆪𑆼 𑆥𑇀𑆫𑆳𑆑𑇀𑆯𑆴𑆫𑆱𑆩𑆶𑆢𑆑𑇀𑆯𑆴𑆫𑆱𑆁 𑆮𑆳 𑆱𑆁𑆮𑆼𑆯𑇀𑆪 𑆢𑆼𑆮𑆠𑆳𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆴𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆟𑆩𑆠𑆵𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆥𑆴𑆠𑆳 𑆢𑇀𑆮𑆼 𑆤𑆳𑆩𑆤𑆵 𑆑𑆳𑆫𑆪𑆼𑆤𑇀𑆤𑆳𑆑𑇀𑆰𑆠𑇀𑆫𑆴𑆑𑆁 𑆤𑆳𑆩𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆴𑆑𑆁 𑆖𑇅 𑆠𑆠𑇀𑆫𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆴𑆑𑆁 𑆔𑆾𑆰𑆮𑆢𑆳𑆢𑇀𑆪𑆤𑇀𑆠𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆩𑆷𑆰𑇀𑆩𑆳𑆤𑇀𑆠𑆁 𑆮𑆳𑇁𑆮𑆸𑆢𑇀𑆣𑆁 𑆠𑇀𑆫𑆴𑆥𑆶𑆫𑆶𑆰𑆳𑆤𑆷𑆑𑆩𑆤𑆮𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆁, 𑆤𑆳𑆑𑇀𑆰𑆳𑆠𑇀𑆫𑆴𑆑𑆁 𑆠𑆶 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆢𑆼𑆮𑆠𑆳𑆱𑆩𑆳𑆤𑆳𑆒𑇀𑆪𑆁 𑆢𑇀𑆮𑇀𑆪𑆑𑇀𑆰𑆫𑆁 𑆖𑆠𑆶𑆫𑆑𑇀𑆰𑆫𑆁 𑆮𑆳𑇆𑇕𑇐𑇆
𑆮𑆸𑆠𑇀𑆠𑆼 𑆖 𑆤𑆳𑆩𑆑𑆫𑇀𑆩𑆟𑆴 𑆑𑆶𑆩𑆳𑆫𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆶𑆩𑆶𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆲𑆼𑆠𑆾𑆂𑇅 𑆠𑆠𑇀𑆫𑆼𑆩𑆳𑆤𑇀𑆪𑆳𑆪𑆶𑆰𑇀𑆩𑆠𑆳𑆁 𑆑𑆶𑆩𑆳𑆫𑆳𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆍𑆑𑆽𑆑𑆘𑆳 𑆩𑆸𑆢𑆮𑆾𑇁𑆬𑇀𑆥𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆂 𑆱𑆶𑆧𑆢𑇀𑆣𑆩𑆷𑆬𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆳𑆂 𑆑𑆼𑆯𑆳𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼, 𑆱𑇀𑆡𑆴𑆫𑆳 𑆧𑆲𑆬𑆳 𑆠𑇀𑆮𑆑𑇀, 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑇁𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆵𑆰𑆠𑇀𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆩𑆤𑆶𑆫𑆷𑆥𑆩𑆳𑆠𑆥𑆠𑇀𑆫𑆾𑆥𑆩𑆁 𑆯𑆴𑆫𑆂, 𑆮𑇀𑆪𑆷𑆞𑆁 𑆢𑆸𑆞𑆁 𑆱𑆩𑆁 𑆱𑆶𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆯𑆕𑇀𑆒𑆱𑆤𑇀𑆣𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆶𑆥𑆖𑆴𑆠𑆁 𑆮𑆬𑆴𑆨𑆩𑆫𑇀𑆣𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆑𑆸𑆠𑆴 𑆬𑆬𑆳𑆛𑆁, 𑆧𑆲𑆬𑆿 𑆮𑆴𑆥𑆶𑆬𑆱𑆩𑆥𑆵𑆜𑆿 𑆱𑆩𑆿 𑆤𑆵𑆖𑆽𑆫𑇀𑆮𑆸𑆢𑇀𑆣𑆿 𑆥𑆸𑆰𑇀𑆜𑆠𑆾𑇁𑆮𑆤𑆠𑆿 𑆱𑆶𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆑𑆫𑇀𑆟𑆥𑆶𑆠𑇀𑆫𑆑𑆿 𑆩𑆲𑆳𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆿 𑆑𑆫𑇀𑆟𑆿, 𑆆𑆰𑆠𑇀𑆥𑇀𑆫𑆬𑆩𑇀𑆧𑆴𑆤𑇀𑆪𑆳𑆮𑆱𑆕𑇀𑆓𑆠𑆼 𑆱𑆩𑆼 𑆱𑆁𑆲𑆠𑆼 𑆩𑆲𑆠𑇀𑆪𑆿 𑆨𑇀𑆫𑆶𑆮𑆿, 𑆱𑆩𑆼 𑆱𑆩𑆳𑆲𑆴𑆠𑆢𑆫𑇀𑆯𑆤𑆼 𑆮𑇀𑆪𑆑𑇀𑆠𑆨𑆳𑆓𑆮𑆴𑆨𑆳𑆓𑆼 𑆧𑆬𑆮𑆠𑆵 𑆠𑆼𑆘𑆱𑆾𑆥𑆥𑆤𑇀𑆤𑆼 𑆱𑇀𑆮𑆕𑇀𑆓𑆳𑆥𑆳𑆕𑇀𑆓𑆼 𑆖𑆑𑇀𑆰𑆶𑆰𑆵, 𑆉𑆘𑇀𑆮𑆵 𑆩𑆲𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆳 𑆮𑆁𑆯𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆼𑆰𑆢𑆮𑆤𑆠𑆳𑆓𑇀𑆫𑆳 𑆤𑆳𑆱𑆴𑆑𑆳, 𑆩𑆲𑆢𑆸𑆘𑆶𑆱𑆶𑆤𑆴𑆮𑆴𑆰𑇀𑆛𑆢𑆤𑇀𑆠𑆩𑆳𑆱𑇀𑆪𑆩𑇀, 𑆄𑆪𑆳𑆩𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆾𑆥𑆥𑆤𑇀𑆤𑆳 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳 𑆠𑆤𑇀𑆮𑆵 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆪𑆶𑆑𑇀𑆠𑆳 𑆘𑆴𑆲𑇀𑆮𑆳, 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆁 𑆪𑆶𑆑𑇀𑆠𑆾𑆥𑆖𑆪𑆩𑆷𑆰𑇀𑆩𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆫𑆑𑇀𑆠𑆁 𑆠𑆳𑆬𑆶, 𑆩𑆲𑆳𑆤𑆢𑆵𑆤𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑇁𑆤𑆶𑆤𑆳𑆢𑆵 𑆓𑆩𑇀𑆨𑆵𑆫𑆱𑆩𑆶𑆠𑇀𑆡𑆾 𑆣𑆵𑆫𑆂 𑆱𑇀𑆮𑆫𑆂, 𑆤𑆳𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆿 𑆤𑆳𑆠𑆴𑆑𑆸𑆯𑆿 𑆮𑆴𑆱𑇀𑆠𑆳𑆫𑆾𑆥𑆥𑆤𑇀𑆤𑆳𑆮𑆳𑆱𑇀𑆪𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆢𑆤𑆿 𑆫𑆑𑇀𑆠𑆳𑆮𑆾𑆰𑇀𑆜𑆿, 𑆩𑆲𑆠𑇀𑆪𑆿 𑆲𑆤𑆷, 𑆮𑆸𑆠𑇀𑆠𑆳 𑆤𑆳𑆠𑆴𑆩𑆲𑆠𑆵 𑆓𑇀𑆫𑆵𑆮𑆳, 𑆮𑇀𑆪𑆷𑆞𑆩𑆶𑆥𑆖𑆴𑆠𑆩𑆶𑆫𑆂, 𑆓𑆷𑆞𑆁 𑆘𑆠𑇀𑆫𑆶 𑆥𑆸𑆰𑇀𑆜𑆮𑆁𑆯𑆯𑇀𑆖, 𑆮𑆴𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆳𑆤𑇀𑆠𑆫𑆿 𑆱𑇀𑆠𑆤𑆿, 𑆃𑆱𑆩𑇀𑆥𑆳𑆠𑆴𑆤𑆵 𑆱𑇀𑆡𑆴𑆫𑆼 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆼, 𑆮𑆸𑆠𑇀𑆠𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆳𑆪𑆠𑆿 𑆧𑆳𑆲𑆷 𑆱𑆑𑇀𑆡𑆴𑆤𑆵 𑆃𑆕𑇀𑆓𑆶𑆬𑆪𑆯𑇀𑆖, 𑆩𑆲𑆢𑆶𑆥𑆖𑆴𑆠𑆁 𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆁, 𑆱𑇀𑆡𑆴𑆫𑆳 𑆮𑆸𑆠𑇀𑆠𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆱𑇀𑆠𑆳𑆩𑇀𑆫𑆳𑆱𑇀𑆠𑆶𑆕𑇀𑆓𑆳𑆂 𑆑𑆷𑆫𑇀𑆩𑆳𑆑𑆳𑆫𑆳𑆂 𑆑𑆫𑆘𑆳𑆂, 𑆥𑇀𑆫𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆮𑆫𑇀𑆠𑆳 𑆱𑆾𑆠𑇀𑆱𑆕𑇀𑆓𑆳 𑆖 𑆤𑆳𑆨𑆴𑆂, 𑆇𑆫𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆳𑆓𑆲𑆵𑆤𑆳 𑆱𑆩𑆳 𑆱𑆩𑆶𑆥𑆖𑆴𑆠𑆩𑆳𑆁𑆱𑆳 𑆑𑆛𑆵, 𑆮𑆸𑆠𑇀𑆠𑆿 𑆱𑇀𑆡𑆴𑆫𑆾𑆥𑆖𑆴𑆠𑆩𑆳𑆁𑆱𑆿 𑆤𑆳𑆠𑇀𑆪𑆶𑆤𑇀𑆤𑆠𑆿 𑆤𑆳𑆠𑇀𑆪𑆮𑆤𑆠𑆿 𑆱𑇀𑆦𑆴𑆖𑆿, 𑆃𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆁 𑆮𑆸𑆠𑇀𑆠𑆳𑆮𑆶𑆥𑆖𑆪𑆪𑆶𑆑𑇀𑆠𑆳𑆮𑆷𑆫𑆷, 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆖𑆴𑆠𑆼 𑆤𑆳𑆠𑇀𑆪𑆥𑆖𑆴𑆠𑆼 𑆍𑆟𑆵𑆥𑆢𑆼 𑆥𑇀𑆫𑆓𑆷𑆞𑆱𑆴𑆫𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆵 𑆘𑆕𑇀𑆔𑆼, 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆖𑆴𑆠𑆿 𑆤𑆳𑆠𑇀𑆪𑆥𑆖𑆴𑆠𑆿 𑆓𑆶𑆬𑇀𑆦𑆿, 𑆥𑆷𑆫𑇀𑆮𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆓𑆶𑆟𑆿 𑆥𑆳𑆢𑆿 𑆑𑆷𑆫𑇀𑆩𑆳𑆑𑆳𑆫𑆿, 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆓𑆶𑆲𑇀𑆪𑆳𑆤𑆴 𑆠𑆡𑆳 𑆱𑇀𑆮𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆟𑆳𑆪𑆳𑆱𑆱𑇀𑆩𑆴𑆠𑆫𑆶𑆢𑆴𑆠𑆱𑇀𑆠𑆤𑆓𑇀𑆫𑆲𑆟𑆳𑆤𑆴, 𑆪𑆖𑇀𑆖 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆤𑇀𑆪𑆢𑆥𑇀𑆪𑆤𑆶𑆑𑇀𑆠𑆩𑆱𑇀𑆠𑆴 𑆠𑆢𑆥𑆴 𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆩𑆴𑆰𑇀𑆛𑆁, 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆥𑆶𑆤𑆫𑆤𑆴𑆰𑇀𑆛𑆩𑇀𑇅 𑆅𑆠𑆴 𑆢𑆵𑆫𑇀𑆔𑆳𑆪𑆶𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴𑇆𑇕𑇑𑇆
𑆃𑆠𑆾 𑆣𑆳𑆠𑇀𑆫𑆵𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆃𑆡 𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀- 𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆳𑆤𑆪 𑆱𑆩𑆳𑆤𑆮𑆫𑇀𑆟𑆳𑆁 𑆪𑆿𑆮𑆤𑆱𑇀𑆡𑆳𑆁 𑆤𑆴𑆨𑆸𑆠𑆳𑆩𑆤𑆳𑆠𑆶𑆫𑆳𑆩𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆩𑆮𑇀𑆪𑆱𑆤𑆳𑆩𑆮𑆴𑆫𑆷𑆥𑆳𑆩𑆘𑆶𑆓𑆶𑆥𑇀𑆱𑆴𑆠𑆳𑆁 𑆢𑆼𑆯𑆘𑆳𑆠𑆵𑆪𑆳𑆩𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆳𑆩𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆫𑇀𑆩𑆴𑆟𑆵𑆁 𑆑𑆶𑆬𑆼 𑆘𑆳𑆠𑆳𑆁 𑆮𑆠𑇀𑆱𑆬𑆳𑆩𑆫𑆾𑆓𑆳𑆁 𑆘𑆵𑆮𑆢𑇀𑆮𑆠𑇀𑆱𑆳𑆁 𑆥𑆶𑆁𑆮𑆠𑇀𑆱𑆳𑆁 𑆢𑆾𑆓𑇀𑆣𑇀𑆫𑆵𑆩𑆥𑇀𑆫𑆩𑆠𑇀𑆠𑆳𑆩𑆤𑆶𑆖𑇀𑆖𑆳𑆫𑆯𑆳𑆪𑆴𑆤𑆵𑆩𑆤𑆤𑇀𑆠𑇀𑆪𑆳𑆮𑆱𑆳𑆪𑆴𑆤𑆵𑆁 𑆑𑆶𑆯𑆬𑆾𑆥𑆖𑆳𑆫𑆳𑆁 𑆯𑆶𑆖𑆴𑆩𑆯𑆶𑆖𑆴𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆵𑆁 𑆱𑇀𑆠𑆤𑆱𑇀𑆠𑆤𑇀𑆪𑆱𑆩𑇀𑆥𑆢𑆶𑆥𑆼𑆠𑆳𑆩𑆴𑆠𑆴𑇆𑇕𑇒𑇆
𑆠𑆠𑇀𑆫𑆼𑆪𑆁 𑆱𑇀𑆠𑆤𑆱𑆩𑇀𑆥𑆠𑇀- 𑆤𑆳𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆿 𑆤𑆳𑆠𑆴𑆬𑆩𑇀𑆧𑆳𑆮𑆤𑆠𑆴𑆑𑆸𑆯𑆳𑆮𑆤𑆠𑆴𑆥𑆵𑆤𑆿 𑆪𑆶𑆑𑇀𑆠𑆥𑆴𑆥𑇀𑆥𑆬𑆑𑆿 𑆱𑆶𑆒𑆥𑇀𑆫𑆥𑆳𑆤𑆿 𑆖𑆼𑆠𑆴 (𑆱𑇀𑆠𑆤𑆱𑆩𑇀𑆥𑆠𑇀)𑇆𑇕𑇓𑇆
𑆱𑇀𑆠𑆤𑇀𑆪𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆶 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆓𑆤𑇀𑆣𑆫𑆱𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑇀, 𑆇𑆢𑆥𑆳𑆠𑇀𑆫𑆼 𑆖 𑆢𑆶𑆲𑇀𑆪𑆩𑆳𑆤𑆩𑆶𑆢𑆑𑆁 𑆮𑇀𑆪𑆼𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑇀 𑆥𑆶𑆰𑇀𑆛𑆴𑆑𑆫𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆑𑆫𑆁 𑆖𑆼𑆠𑆴 (𑆱𑇀𑆠𑆤𑇀𑆪𑆱𑆩𑇀𑆥𑆠𑇀)𑇆𑇕𑇔𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆁 𑆘𑇀𑆚𑆼𑆪𑆩𑇀𑇅 𑆠𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆳𑆂- 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆁 𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆫𑆱𑆁 𑆮𑆴𑆯𑆢𑆩𑆤𑆳𑆬𑆑𑇀𑆰𑇀𑆪𑆓𑆤𑇀𑆣𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆢𑇀𑆫𑆮𑆁 𑆦𑆼𑆤𑆴𑆬𑆁 𑆬𑆔𑇀𑆮𑆠𑆸𑆥𑇀𑆠𑆴𑆑𑆫𑆁 𑆑𑆫𑇀𑆯𑆤𑆁 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆑𑆫𑇀𑆠𑆸 𑆮𑆳𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆨𑆴𑆘𑇀𑆚𑆼𑆪𑆁 ; 𑆑𑆸𑆰𑇀𑆟𑆤𑆵𑆬𑆥𑆵𑆠𑆠𑆳𑆩𑇀𑆫𑆳𑆮𑆨𑆳𑆱𑆁 𑆠𑆴𑆑𑇀𑆠𑆳𑆩𑇀𑆬𑆑𑆛𑆶𑆑𑆳𑆤𑆶𑆫𑆱𑆁 𑆑𑆶𑆟𑆥𑆫𑆶𑆣𑆴𑆫𑆓𑆤𑇀𑆣𑆴 𑆨𑆸𑆯𑆾𑆰𑇀𑆟𑆁 𑆥𑆴𑆠𑇀𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆑𑆫𑇀𑆠𑆸 𑆖 𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆨𑆴𑆘𑇀𑆚𑆼𑆪𑆩𑇀, 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆯𑆶𑆑𑇀𑆬𑆩𑆠𑆴𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆁 𑆬𑆮𑆟𑆳𑆤𑆶𑆫𑆱𑆁 𑆔𑆸𑆠𑆠𑆽𑆬𑆮𑆱𑆳𑆩𑆘𑇀𑆘𑆓𑆤𑇀𑆣𑆴 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆠𑆤𑇀𑆠𑆶𑆩𑆢𑆶𑆑𑆥𑆳𑆠𑇀𑆫𑆼𑇁𑆮𑆱𑆵𑆢𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆑𑆫𑇀𑆠𑆸 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆨𑆴𑆘𑇀𑆚𑆼𑆪𑆩𑇀𑇆𑇕𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆥𑆴 𑆑𑇀𑆰𑆵𑆫𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆖 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆤𑆴 𑆮𑆴𑆨𑆘𑇀𑆪 𑆑𑆸𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆥𑆳𑆤𑆳𑆯𑆤𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆶 𑆢𑆶𑆰𑇀𑆛𑆑𑇀𑆰𑆵𑆫𑆳𑆪𑆳 𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆩𑆶𑆢𑇀𑆓𑆲𑆫𑆼𑆟𑆶𑆑𑆑𑆶𑆬𑆠𑇀𑆡𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆑𑆩𑆽𑆫𑆼𑆪𑆩𑆼𑆢𑆑𑆬𑆯𑆶𑆤𑆑𑆫𑆚𑇀𑆘𑆥𑇀𑆫𑆳𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆑𑇀𑆰𑆵𑆫𑆢𑆾𑆰𑆮𑆴𑆯𑆼𑆰𑆳𑆁𑆯𑇀𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆠𑆠𑇀𑆠𑆢𑇀𑆮𑆴𑆣𑆳𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆥𑆳𑆜𑆳𑆩𑆲𑆿𑆰𑆣𑆱𑆶𑆫𑆢𑆳𑆫𑆶𑆩𑆶𑆱𑇀𑆠𑆩𑆷𑆫𑇀𑆮𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆮𑆠𑇀𑆱𑆑𑆦𑆬𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆑𑆑𑆛𑆶𑆑𑆫𑆾𑆲𑆴𑆟𑆵𑆱𑆳𑆫𑆴𑆮𑆳𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆁 𑆖 𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼, 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆑𑆩𑆣𑆶𑆫𑆳𑆟𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆑𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑆳𑆬𑆁 𑆖𑇅 𑆅𑆠𑆴 𑆑𑇀𑆰𑆵𑆫𑆮𑆴𑆯𑆾𑆣𑆤𑆳𑆤𑆴𑇆𑇕𑇖𑇆
𑆣𑆳𑆠𑇀𑆫𑆵 𑆠𑆶 𑆪𑆢𑆳 𑆱𑇀𑆮𑆳𑆢𑆶𑆧𑆲𑆶𑆬𑆯𑆶𑆢𑇀𑆣𑆢𑆶𑆓𑇀𑆣𑆳 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆢𑆳𑆱𑇀𑆤𑆳𑆠𑆳𑆤𑆶𑆬𑆴𑆥𑇀𑆠𑆳 𑆯𑆶𑆑𑇀𑆬𑆮𑆱𑇀𑆠𑇀𑆫𑆁 𑆥𑆫𑆴𑆣𑆳𑆪𑆽𑆤𑇀𑆢𑇀𑆫𑆵𑆁 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆁 𑆯𑆠𑆮𑆵𑆫𑇀𑆪𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆮𑆵𑆫𑇀𑆪𑆳𑆩𑆩𑆾𑆔𑆳𑆩𑆮𑇀𑆪𑆡𑆳𑆁 𑆯𑆴𑆮𑆳𑆩𑆫𑆴𑆰𑇀𑆛𑆳𑆁 𑆮𑆳𑆛𑇀𑆪𑆥𑆶𑆰𑇀𑆥𑆵𑆁 𑆮𑆴𑆰𑇀𑆮𑆑𑇀𑆱𑆼𑆤𑆑𑆳𑆤𑇀𑆠𑆳𑆁 𑆮𑆳 𑆧𑆴𑆨𑇀𑆫𑆠𑇀𑆪𑆾𑆰𑆣𑆴𑆁 𑆑𑆶𑆩𑆳𑆫𑆁 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆶𑆒𑆁 𑆥𑇀𑆫𑆡𑆩𑆁 𑆢𑆑𑇀𑆰𑆴𑆟𑆁 𑆱𑇀𑆠𑆤𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀𑇅 𑆅𑆠𑆴 𑆣𑆳𑆠𑇀𑆫𑆵𑆑𑆫𑇀𑆩𑇆𑇕𑇘𑇆
𑆃𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆁 𑆑𑆶𑆩𑆳𑆫𑆳𑆓𑆳𑆫𑆮𑆴𑆣𑆴𑆩𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆮𑆳𑆱𑇀𑆠𑆶𑆮𑆴𑆢𑇀𑆪𑆳𑆑𑆶𑆯𑆬𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆫𑆩𑇀𑆪𑆩𑆠𑆩𑆱𑇀𑆑𑆁 𑆤𑆴𑆮𑆳𑆠𑆁 𑆥𑇀𑆫𑆮𑆳𑆠𑆽𑆑𑆢𑆼𑆯𑆁 𑆢𑆸𑆞𑆩𑆥𑆓𑆠𑆯𑇀𑆮𑆳𑆥𑆢𑆥𑆯𑆶𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆴𑆩𑆷𑆰𑆴𑆑𑆥𑆠𑆕𑇀𑆓𑆁 𑆱𑆶𑆮𑆴𑆨𑆑𑇀𑆠𑆱𑆬𑆴𑆬𑆾𑆬𑆷𑆒𑆬𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆖𑆂𑆱𑇀𑆡𑆳𑆤𑆱𑇀𑆤𑆳𑆤𑆨𑆷𑆩𑆴𑆩𑆲𑆳𑆤𑆱𑆩𑆸𑆠𑆶𑆱𑆶𑆒𑆁 𑆪𑆡𑆫𑇀𑆠𑆶𑆯𑆪𑆤𑆳𑆱𑆤𑆳𑆱𑇀𑆠𑆫𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀; 𑆠𑆡𑆳 𑆱𑆶𑆮𑆴𑆲𑆴𑆠𑆫𑆑𑇀𑆰𑆳𑆮𑆴𑆣𑆳𑆤𑆧𑆬𑆴𑆩𑆕𑇀𑆓𑆬𑆲𑆾𑆩𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆁 𑆯𑆶𑆖𑆴𑆮𑆸𑆢𑇀𑆣𑆮𑆽𑆢𑇀𑆪𑆳𑆤𑆶𑆫𑆑𑇀𑆠𑆘𑆤𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆅𑆠𑆴 𑆑𑆶𑆩𑆳𑆫𑆳𑆓𑆳𑆫𑆮𑆴𑆣𑆴𑆂𑇆𑇕𑇙𑇆
𑆯𑆪𑆤𑆳𑆱𑆤𑆳𑆱𑇀𑆠𑆫𑆟𑆥𑇀𑆫𑆳𑆮𑆫𑆟𑆳𑆤𑆴 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆩𑆸𑆢𑆶𑆬𑆔𑆶𑆯𑆶𑆖𑆴𑆱𑆶𑆓𑆤𑇀𑆣𑆵𑆤𑆴 𑆱𑇀𑆪𑆶𑆂; 𑆱𑇀𑆮𑆼𑆢𑆩𑆬𑆘𑆤𑇀𑆠𑆶𑆩𑆤𑇀𑆠𑆴 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆴 𑆖 𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆂; 𑆃𑆱𑆠𑆴 𑆱𑆩𑇀𑆨𑆮𑆼𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆖 𑆱𑆶𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆾𑆥𑆣𑆳𑆤𑆳𑆤𑆴 𑆱𑆶𑆣𑆷𑆥𑆴𑆠𑆳𑆤𑆴 𑆯𑆶𑆢𑇀𑆣𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑇀𑆪𑆶𑆥𑆪𑆾𑆓𑆁 𑆓𑆖𑇀𑆗𑆼𑆪𑆶𑆂𑇆𑇖𑇐𑇆
𑆣𑆷𑆥𑆤𑆳𑆤𑆴 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆱𑆱𑆳𑆁 𑆯𑆪𑆤𑆳𑆱𑇀𑆠𑆫𑆟𑆥𑇀𑆫𑆳𑆮𑆫𑆟𑆳𑆤𑆳𑆁 𑆖 𑆪𑆮𑆱𑆫𑇀𑆰𑆥𑆳𑆠𑆱𑆵𑆲𑆴𑆕𑇀𑆓𑆶𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆮𑆖𑆳𑆖𑆾𑆫𑆑𑆮𑆪𑆂𑆱𑇀𑆡𑆳𑆓𑆾𑆬𑆾𑆩𑆵𑆘𑆛𑆴𑆬𑆳𑆥𑆬𑆕𑇀𑆑𑆰𑆳𑆯𑆾𑆑𑆫𑆾𑆲𑆴𑆟𑆵𑆱𑆫𑇀𑆥𑆤𑆴𑆫𑇀𑆩𑆾𑆑𑆳𑆟𑆴 𑆔𑆸𑆠𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆂𑇆𑇖𑇑𑇆
𑆩𑆟𑆪𑆯𑇀𑆖 𑆣𑆳𑆫𑆟𑆵𑆪𑆳𑆂 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆒𑆝𑇀𑆓𑆫𑆶𑆫𑆶𑆓𑆮𑆪𑆮𑆸𑆰𑆨𑆳𑆟𑆳𑆁 𑆘𑆵𑆮𑆠𑆳𑆩𑆼𑆮 𑆢𑆑𑇀𑆰𑆴𑆟𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆰𑆳𑆟𑆼𑆨𑇀𑆪𑆾𑇁𑆓𑇀𑆫𑆳𑆟𑆴 𑆓𑆸𑆲𑆵𑆠𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆂; 𑆎𑆤𑇀𑆢𑇀𑆫𑇀𑆪𑆳𑆢𑇀𑆪𑆳𑆯𑇀𑆖𑆿𑆰𑆣𑆪𑆾 𑆘𑆵𑆮𑆑𑆫𑇀𑆰𑆨𑆑𑆿 𑆖, 𑆪𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆥𑆴 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆂 𑆥𑇀𑆫𑆯𑆁𑆱𑆼𑆪𑆶𑆫𑆡𑆫𑇀𑆮𑆮𑆼𑆢𑆮𑆴𑆢𑆂𑇆𑇖𑇒𑇆
𑆑𑇀𑆫𑆵𑆝𑆤𑆑𑆳𑆤𑆴 𑆒𑆬𑆶 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆳𑆟𑆴 𑆔𑆾𑆰𑆮𑆤𑇀𑆠𑇀𑆪𑆨𑆴𑆫𑆳𑆩𑆳𑆟𑆴 𑆖𑆳𑆓𑆶𑆫𑆷𑆟𑆴 𑆖𑆳𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆓𑇀𑆫𑆳𑆟𑆴 𑆖𑆳𑆤𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆼𑆯𑆵𑆤𑆴 𑆖𑆳𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆳𑆟𑆴 𑆖𑆳𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆂𑇆𑇖𑇓𑇆
𑆤 𑆲𑇀𑆪𑆱𑇀𑆪 𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆁 𑆱𑆳𑆣𑆶𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆫𑆶𑆢𑆠𑇀𑆪𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆼 𑆮𑆳𑇁𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆴𑆣𑆼𑆪𑆠𑆳𑆩𑆓𑆖𑇀𑆗𑆠𑆴 𑆫𑆳𑆑𑇀𑆰𑆱𑆥𑆴𑆯𑆳𑆖𑆥𑆷𑆠𑆤𑆳𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆤𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆲𑇀𑆮𑆪𑆠𑆳 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆪 𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆳𑆫𑇀𑆡𑆁 𑆤𑆳𑆩𑆓𑇀𑆫𑆲𑆟𑆁 𑆤 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇆𑇖𑇔𑇆
𑆪𑆢𑆴 𑆠𑇀𑆮𑆳𑆠𑆶𑆫𑇀𑆪𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆑𑆶𑆩𑆳𑆫𑆩𑆳𑆓𑆖𑇀𑆗𑆼𑆠𑇀 𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆯𑆪𑆮𑆴𑆯𑆼𑆰𑆽𑆱𑇀𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆾𑇁𑆤𑆶𑆧𑆶𑆣𑇀𑆪 𑆱𑆫𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆳𑆠𑆶𑆫𑆿𑆰𑆣𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆯𑇀𑆫𑆪𑆳𑆤𑆮𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆶𑆩𑆳𑆫𑆨𑆼𑆠𑆽𑆤𑆁 𑆩𑆣𑆶𑆫𑆩𑆸𑆢𑆶𑆬𑆔𑆶𑆱𑆶𑆫𑆨𑆴𑆯𑆵𑆠𑆯𑆕𑇀𑆑𑆫𑆁 𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑇅 𑆍𑆮𑆁𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳 𑆲𑆴 𑆑𑆶𑆩𑆳𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆡𑆳 𑆠𑆼 𑆯𑆫𑇀𑆩 𑆬𑆨𑆤𑇀𑆠𑆼 𑆖𑆴𑆫𑆳𑆪𑇅 𑆃𑆫𑆾𑆓𑆼 𑆠𑇀𑆮𑆫𑆾𑆓𑆮𑆸𑆠𑇀𑆠𑆩𑆳𑆠𑆴𑆰𑇀𑆜𑆼𑆢𑇀𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆠𑇀𑆩𑆓𑆶𑆟𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆂, 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆤𑆴 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆂 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆲𑆴𑆠𑆳𑆤𑆴 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆠𑆡𑆳 𑆧𑆬𑆮𑆫𑇀𑆟𑆯𑆫𑆵𑆫𑆳𑆪𑆶𑆰𑆳𑆁 𑆱𑆩𑇀𑆥𑆢𑆩𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆵𑆠𑆴𑇆𑇖𑇕𑇆
𑆍𑆮𑆩𑆼𑆤𑆁 𑆑𑆶𑆩𑆳𑆫𑆩𑆳𑆪𑆿𑆮𑆤𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼𑆫𑇀𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆿𑆯𑆬𑆳𑆓𑆩𑆤𑆳𑆖𑇀𑆖𑆳𑆤𑆶𑆥𑆳𑆬𑆪𑆼𑆠𑇀𑇆𑇖𑇖𑇆
𑆅𑆠𑆴 𑆥𑆶𑆠𑇀𑆫𑆳𑆯𑆴𑆰𑆳𑆁 𑆱𑆩𑆸𑆢𑇀𑆣𑆴𑆑𑆫𑆁 𑆑𑆫𑇀𑆩 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑇀𑇅 𑆠𑆢𑆳𑆖𑆫𑆤𑇀 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆣𑆴𑆨𑆴𑆂 𑆥𑆷𑆘𑆳𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆬𑆨𑆠𑆼𑇁𑆤𑆱𑆷𑆪𑆑 𑆅𑆠𑆴𑇆𑇖𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆥𑆶𑆠𑇀𑆫𑆳𑆯𑆴𑆰𑆳𑆁 𑆑𑆫𑇀𑆩 𑆱𑆩𑆸𑆢𑇀𑆣𑆴𑆑𑆳𑆫𑆑𑆁 𑆪𑆢𑆶𑆑𑇀𑆠𑆩𑆼𑆠𑆤𑇀𑆩𑆲𑆢𑆫𑇀𑆡𑆱𑆁𑆲𑆴𑆠𑆩𑇀𑇅 𑆠𑆢𑆳𑆖𑆫𑆤𑇀 𑆘𑇀𑆚𑆾 𑆮𑆴𑆣𑆴𑆨𑆴𑆫𑇀𑆪𑆡𑆳𑆠𑆡𑆁 𑆥𑆷𑆘𑆳𑆁 𑆪𑆡𑆼𑆰𑇀𑆛𑆁 𑆬𑆨𑆠𑆼𑇁𑆤𑆱𑆷𑆪𑆑𑆂𑇆𑇖𑇘𑇆
𑆯𑆫𑆵𑆫𑆁 𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆠𑆼 𑆱𑆫𑇀𑆮𑆁 𑆢𑆽𑆮𑆩𑆳𑆤𑆶𑆰𑆱𑆩𑇀𑆥𑆢𑆳𑇅 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆽𑆫𑇀𑆪𑆠𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆳𑆫𑆵𑆫𑆁 𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇖𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆘𑇀𑆮𑆫𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆲𑆼𑆠𑆶𑆫𑇀𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆳𑆪𑆠𑆤𑆁 𑆑𑆫𑇀𑆠𑆳 𑆑𑆳𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆂 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆁 𑆤𑆴𑆢𑆳𑆤𑆩𑆴𑆠𑇀𑆪𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆩𑇀𑇅 𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑇀- 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆂, 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆂, 𑆥𑆫𑆴𑆟𑆳𑆩𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇓𑇆
𑆃𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑆴- 𑆄𑆓𑇀𑆤𑆼𑆪𑆳𑆂, 𑆱𑆿𑆩𑇀𑆪𑆳𑆂, 𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆯𑇀𑆖; 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼- 𑆫𑆳𑆘𑆱𑆳𑆂, 𑆠𑆳𑆩𑆱𑆳𑆯𑇀𑆖𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆳𑆩𑆪𑆾 𑆓𑆢 𑆄𑆠𑆕𑇀𑆑𑆾 𑆪𑆑𑇀𑆰𑇀𑆩𑆳 𑆘𑇀𑆮𑆫𑆾 𑆮𑆴𑆑𑆳𑆫𑆾 𑆫𑆾𑆓 𑆅𑆠𑇀𑆪𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇕𑇆
𑆠𑆱𑇀𑆪𑆾𑆥𑆬𑆧𑇀𑆣𑆴𑆫𑇀𑆤𑆴𑆢𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆯𑆪𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆠𑆂𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆤𑆴𑆢𑆳𑆤𑆁 𑆑𑆳𑆫𑆟𑆩𑆴𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆓𑇀𑆫𑆼𑇆𑇗𑇆
𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴 𑆬𑆑𑇀𑆰𑆟𑆁 𑆮𑇀𑆪𑆳𑆣𑆼𑆂𑇆𑇘𑇆
𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆷𑆠𑆬𑆑𑇀𑆰𑆟𑆁 𑆥𑆶𑆤𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆬𑆴𑆕𑇀𑆓𑆩𑆳𑆑𑆸𑆠𑆴𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆁 𑆖𑆴𑆲𑇀𑆤𑆁 𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆁 𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆁 𑆫𑆷𑆥𑆩𑆴𑆠𑇀𑆪𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇙𑇆
𑆇𑆥𑆯𑆪𑆂 𑆥𑆶𑆤𑆫𑇀𑆲𑆼𑆠𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆫𑇀𑆡𑆑𑆳𑆫𑆴𑆟𑆳𑆁 𑆖𑆿𑆰𑆣𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆳𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂 𑆱𑆶𑆒𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆂𑇆𑇑𑇐𑇆
𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆫𑇀𑆘𑆳𑆠𑆴𑆫𑆳𑆓𑆠𑆴𑆫𑆴𑆠𑇀𑆪𑆤𑆫𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆁 𑆮𑇀𑆪𑆳𑆣𑆼𑆂𑇆𑇑𑇑𑇆
𑆱𑆳 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆮𑆴𑆣𑆴𑆮𑆴𑆑𑆬𑇀𑆥𑆧𑆬𑆑𑆳𑆬𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆨𑆴𑆢𑇀𑆪𑆠𑆼𑇅𑇑𑇒𑇅 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆠𑆳𑆮𑆢𑇀𑆪𑆡𑆳- 𑆃𑆰𑇀𑆛𑆿 𑆘𑇀𑆮𑆫𑆳𑆂, 𑆥𑆚𑇀𑆖 𑆓𑆶𑆬𑇀𑆩𑆳𑆂, 𑆱𑆥𑇀𑆠 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑇀𑆪𑆼𑆮𑆩𑆳𑆢𑆴𑆂𑇅𑇑𑇒𑇅 𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑆫𑆠𑆩𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇅 𑆠𑆠𑇀𑆫 𑆢𑇀𑆮𑆪𑆾𑆱𑇀𑆠𑆫𑆂, 𑆠𑇀𑆫𑆴𑆰𑆶 𑆠𑆩 𑆅𑆠𑆴𑇅𑇑𑇒𑇅 𑆮𑆴𑆣𑆴𑆫𑇀𑆤𑆳𑆩- 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆮𑇀𑆪𑆳𑆣𑆪𑆾 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆨𑆼𑆢𑆼𑆤, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆨𑆼𑆢𑆼𑆤, 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆩𑆸𑆢𑆶𑆢𑆳𑆫𑆶𑆟𑆨𑆼𑆢𑆼𑆤𑇅𑇑𑇒𑇅 𑆱𑆩𑆮𑆼𑆠𑆳𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆁𑆯𑆳𑆁𑆯𑆧𑆬𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆮𑆴𑆑𑆬𑇀𑆥𑆾𑇁𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆫𑇀𑆡𑆼𑇅𑇑𑇒𑇅 𑆧𑆬𑆑𑆳𑆬𑆮𑆴𑆯𑆼𑆰𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆸𑆠𑇀𑆮𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆳𑆲𑆳𑆫𑆑𑆳𑆬𑆮𑆴𑆣𑆴𑆮𑆴𑆤𑆴𑆪𑆠𑆾 𑆨𑆮𑆠𑆴𑇆𑇑𑇒𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆨𑆴𑆰𑆓𑆤𑆶𑆥𑆲𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆲𑆼𑆠𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆨𑆳𑆮𑆽𑆫𑇀𑆪𑆡𑆳𑆮𑆢𑆤𑆶𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆼𑆠𑇆𑇑𑇓𑇆
𑆅𑆠𑇀𑆪𑆫𑇀𑆡𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆾 𑆤𑆴𑆢𑆳𑆤𑆱𑇀𑆡𑆳𑆤𑆱𑇀𑆪𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴𑇅 𑆠𑆁 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆾 𑆨𑆷𑆪𑆱𑇀𑆠𑆫𑆩𑆠𑆾𑇁𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇔𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆡𑆩𑆠 𑆍𑆮 𑆠𑆳𑆮𑆢𑆳𑆢𑇀𑆪𑆳𑆀𑆬𑇀𑆬𑆾𑆨𑆳𑆨𑆴𑆢𑇀𑆫𑆾𑆲𑆑𑆾𑆥𑆥𑇀𑆫𑆨𑆮𑆳𑆤𑆰𑇀𑆛𑆿 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀𑆤𑆴𑆢𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆼𑆟 𑆑𑇀𑆫𑆩𑆼𑆟 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂, 𑆠𑆡𑆳 𑆱𑆷𑆠𑇀𑆫𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆩𑆳𑆠𑇀𑆫𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆪𑆳𑆂𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼𑆰𑆶 𑆖𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆁 𑆪𑆡𑆾𑆥𑆖𑆴𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇕𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆘𑇀𑆮𑆫 𑆍𑆮𑆳𑆢𑆿 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼, 𑆠𑆠𑇀𑆥𑇀𑆫𑆡𑆩𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑆳𑆫𑆵𑆫𑆳𑆟𑆳𑆩𑇀𑇆𑇑𑇖𑇆
𑆃𑆡 𑆒𑆬𑇀𑆮𑆰𑇀𑆛𑆳𑆨𑇀𑆪𑆂 𑆑𑆳𑆫𑆟𑆼𑆨𑇀𑆪𑆾 𑆘𑇀𑆮𑆫𑆂 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆠𑆳𑆠𑇀, 𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀, 𑆑𑆦𑆳𑆠𑇀, 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁, 𑆮𑆳𑆠𑆑𑆦𑆳𑆨𑇀𑆪𑆳𑆁, 𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆨𑇀𑆪𑆳𑆁, 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆼𑆨𑇀𑆪𑆂, 𑆄𑆓𑆤𑇀𑆠𑆾𑆫𑆰𑇀𑆛𑆩𑆳𑆠𑇀 𑆑𑆳𑆫𑆟𑆳𑆠𑇀𑇆𑇑𑇗𑇆
𑆠𑆱𑇀𑆪 𑆤𑆴𑆢𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆯𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇘𑇆
𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆯𑆵𑆠𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑆼𑆓𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆤𑆯𑆤𑆳𑆨𑆴𑆔𑆳𑆠- 𑆮𑇀𑆪𑆮𑆳𑆪𑆾𑆢𑇀𑆮𑆼𑆓𑆯𑆾𑆑𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆰𑆼𑆑𑆘𑆳𑆓𑆫𑆟𑆮𑆴𑆰𑆩𑆯𑆫𑆵𑆫𑆤𑇀𑆪𑆳𑆱𑆼𑆨𑇀𑆪𑆾𑇁𑆠𑆴𑆱𑆼𑆮𑆴𑆠𑆼𑆨𑇀𑆪𑆾 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇙𑇆
𑆱 𑆪𑆢𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆩𑆷𑆰𑇀𑆩𑆟𑆳 𑆱𑆲 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆷𑆪𑆳𑆢𑇀𑆪𑆩𑆳𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆣𑆳𑆠𑆶𑆁 𑆫𑆱𑆤𑆳𑆩𑆳𑆤𑆩𑆤𑇀𑆮𑆮𑆼𑆠𑇀𑆪 𑆫𑆱𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑆴𑆣𑆳𑆪𑆳𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆲𑆠𑇀𑆪 𑆥𑆑𑇀𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆧𑆲𑆴𑆫𑇀𑆤𑆴𑆫𑆱𑇀𑆪 𑆑𑆼𑆮𑆬𑆁 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆘𑇀𑆮𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇒𑇐𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆴𑆰𑆩𑆳𑆫𑆩𑇀𑆨𑆮𑆴𑆱𑆫𑇀𑆓𑆴𑆠𑇀𑆮𑆩𑇀, 𑆈𑆰𑇀𑆩𑆟𑆾 𑆮𑆽𑆰𑆩𑇀𑆪𑆁, 𑆠𑆵𑆮𑇀𑆫𑆠𑆤𑆶𑆨𑆳𑆮𑆳𑆤𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆘𑇀𑆮𑆫𑆱𑇀𑆪, 𑆘𑆫𑆟𑆳𑆤𑇀𑆠𑆼 𑆢𑆴𑆮𑆱𑆳𑆤𑇀𑆠𑆼 𑆤𑆴𑆯𑆳𑆤𑇀𑆠𑆼 𑆔𑆫𑇀𑆩𑆳𑆤𑇀𑆠𑆼 𑆮𑆳 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆓𑆩𑆤𑆩𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆮𑆳, 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑆫𑆶𑆰𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆠𑇀𑆮𑆁 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆠𑇀𑆮𑆖𑆳𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆑𑇀𑆬𑆸𑆥𑇀𑆠𑆵𑆨𑆳𑆮𑆯𑇀𑆖; 𑆃𑆤𑆼𑆑𑆮𑆴𑆣𑆾𑆥𑆩𑆳𑆯𑇀𑆖𑆬𑆳𑆖𑆬𑆳𑆯𑇀𑆖 𑆮𑆼𑆢𑆤𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆼𑆰𑆳𑆩𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆳𑆢𑆪𑆾𑆂 𑆱𑆶𑆥𑇀𑆠𑆠𑆳, 𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆪𑆾𑆫𑆶𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁, 𑆘𑆳𑆤𑆶𑆤𑆾𑆂 𑆑𑆼𑆮𑆬𑆳𑆤𑆳𑆁 𑆖 𑆱𑆤𑇀𑆣𑆵𑆤𑆳𑆁 𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆟𑆩𑇀, 𑆈𑆫𑇀𑆮𑆾𑆂 𑆱𑆳𑆢𑆂, 𑆑𑆛𑆵𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆱𑇀𑆑𑆤𑇀𑆣𑆧𑆳𑆲𑇀𑆮𑆁𑆱𑆾𑆫𑆱𑆳𑆁 𑆖 𑆨𑆓𑇀𑆤𑆫𑆶𑆓𑇀𑆟𑆩𑆸𑆢𑆴𑆠𑆩𑆡𑆴𑆠𑆖𑆛𑆴𑆠𑆳𑆮𑆥𑆳𑆛𑆴𑆠𑆳𑆮𑆤𑆶𑆤𑇀𑆤𑆠𑇀𑆮𑆩𑆴𑆮 , 𑆲𑆤𑇀𑆮𑆾𑆯𑇀𑆖𑆳𑆥𑇀𑆫𑆱𑆴𑆢𑇀𑆣𑆴𑆂, 𑆱𑇀𑆮𑆤𑆯𑇀𑆖 𑆑𑆫𑇀𑆟𑆪𑆾𑆂, 𑆯𑆕𑇀𑆒𑆪𑆾𑆫𑇀𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆂, 𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆪𑆠𑆳 𑆄𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆁 𑆮𑆳, 𑆩𑆶𑆒𑆠𑆳𑆬𑆶𑆑𑆟𑇀𑆜𑆯𑆾𑆰𑆂, 𑆥𑆴𑆥𑆳𑆱𑆳, 𑆲𑆸𑆢𑆪𑆓𑇀𑆫𑆲𑆂, 𑆯𑆶𑆰𑇀𑆑𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆂, 𑆯𑆶𑆰𑇀𑆑𑆑𑆳𑆱𑆂, 𑆑𑇀𑆰𑆮𑆡𑆷𑆢𑇀𑆓𑆳𑆫𑆮𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆂, 𑆃𑆤𑇀𑆤𑆫𑆱𑆒𑆼𑆢𑆂, 𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆂, 𑆮𑆴𑆰𑆳𑆢𑆘𑆸𑆩𑇀𑆨𑆳𑆮𑆴𑆤𑆳𑆩𑆮𑆼𑆥𑆡𑆶𑆯𑇀𑆫𑆩𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆳𑆥𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆳𑆂, 𑆇𑆰𑇀𑆟𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆠𑆳, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆯𑆪𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑆥𑆯𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆮𑆳𑆠𑆘𑇀𑆮𑆫𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇒𑇑𑇆
𑆇𑆰𑇀𑆟𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑇀𑆰𑆳𑆫𑆑𑆛𑆶𑆑𑆳𑆘𑆵𑆫𑇀𑆟𑆨𑆾𑆘𑆤𑆼𑆨𑇀𑆪𑆾𑇁𑆠𑆴𑆱𑆼𑆮𑆴𑆠𑆼𑆨𑇀𑆪𑆱𑇀𑆠𑆡𑆳 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆠𑆥𑆳𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆳𑆥𑆯𑇀𑆫𑆩𑆑𑇀𑆫𑆾𑆣𑆮𑆴𑆰𑆩𑆳𑆲𑆳𑆫𑆼𑆨𑇀𑆪𑆯𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇒𑇒𑇆
𑆠𑆢𑇀𑆪𑆢𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆩𑆳𑆩𑆳𑆯𑆪𑆳𑆢𑆷𑆰𑇀𑆩𑆳𑆟𑆩𑆶𑆥𑆱𑆸𑆘𑇀𑆪𑆳𑆢𑇀𑆪𑆩𑆳𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆣𑆳𑆠𑆶𑆁 𑆫𑆱𑆤𑆳𑆩𑆳𑆤𑆩𑆤𑇀𑆮𑆮𑆼𑆠𑇀𑆪 𑆫𑆱𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑆴𑆣𑆳𑆪 𑆢𑇀𑆫𑆮𑆠𑇀𑆮𑆳𑆢𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆲𑆠𑇀𑆪 𑆥𑆑𑇀𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆧𑆲𑆴𑆫𑇀𑆤𑆴𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆥𑆵𑆝𑆪𑆠𑇀 𑆑𑆼𑆮𑆬𑆁 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆘𑇀𑆮𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇒𑇓𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆪𑆶𑆓𑆥𑆢𑆼𑆮 𑆑𑆼𑆮𑆬𑆼 𑆯𑆫𑆵𑆫𑆼 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆓𑆩𑆤𑆩𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆮𑆳 𑆨𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆢𑆳𑆲𑆑𑆳𑆬𑆼 𑆩𑆣𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆼𑇁𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆼 𑆯𑆫𑆢𑆴 𑆮𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟, 𑆑𑆛𑆶𑆑𑆳𑆱𑇀𑆪𑆠𑆳, 𑆔𑇀𑆫𑆳𑆟𑆩𑆶𑆒𑆑𑆟𑇀𑆜𑆿𑆰𑇀𑆜𑆠𑆳𑆬𑆶𑆥𑆳𑆑𑆂, 𑆠𑆸𑆰𑇀𑆟𑆳, 𑆩𑆢𑆾, 𑆨𑇀𑆫𑆩𑆾, 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳, 𑆥𑆴𑆠𑇀𑆠𑆖𑇀𑆗𑆫𑇀𑆢𑆤𑆩𑇀, 𑆃𑆠𑆵𑆱𑆳𑆫𑆂, 𑆃𑆤𑇀𑆤𑆢𑇀𑆮𑆼𑆰𑆂, 𑆱𑆢𑆤𑆁, 𑆒𑆼𑆢𑆂, 𑆥𑇀𑆫𑆬𑆳𑆥𑆂, 𑆫𑆑𑇀𑆠𑆑𑆾𑆜𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆯𑆫𑆵𑆫𑆼, 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆠𑇀𑆮𑆁 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆠𑇀𑆮𑆖𑆳𑆩𑇀, 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆷𑆰𑇀𑆩𑆟𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆨𑆳𑆮𑆂, 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆢𑆳𑆲𑆂, 𑆯𑆵𑆠𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆠𑆳, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆶𑆥𑆯𑆪𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑆥𑆯𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇒𑇔𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆯𑆵𑆠𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆲𑆫𑇀𑆰𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆼𑆨𑇀𑆪𑆾𑇁𑆠𑆴𑆱𑆼𑆮𑆴𑆠𑆼𑆨𑇀𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇒𑇕𑇆
𑆱 𑆪𑆢𑆳 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆩𑆷𑆰𑇀𑆩𑆟𑆳 𑆱𑆲𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆷𑆪𑆳𑆢𑇀𑆪𑆩𑆳𑆲𑆳𑆫𑆥𑆫𑆴𑆟𑆳𑆩𑆣𑆳𑆠𑆶𑆁 𑆫𑆱𑆤𑆳𑆩𑆳𑆤𑆩𑆤𑇀𑆮𑆮𑆼𑆠𑇀𑆪 𑆫𑆱𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑆴𑆣𑆳𑆪𑆳𑆓𑇀𑆤𑆴𑆩𑆶𑆥𑆲𑆠𑇀𑆪 𑆥𑆑𑇀𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆧𑆲𑆴𑆫𑇀𑆤𑆴𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆥𑆵𑆝𑆪𑆤𑇀 𑆑𑆼𑆮𑆬𑆁 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆢𑆳 𑆘𑇀𑆮𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇒𑇖𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆪𑆶𑆓𑆥𑆢𑆼𑆮 𑆑𑆼𑆮𑆬𑆼 𑆯𑆫𑆵𑆫𑆼 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆓𑆩𑆤𑆩𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆮𑆳 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆥𑆷𑆫𑇀𑆮𑆳𑆲𑇀𑆟𑆼 𑆥𑆷𑆫𑇀𑆮𑆫𑆳𑆠𑇀𑆫𑆼 𑆮𑆱𑆤𑇀𑆠𑆑𑆳𑆬𑆼 𑆮𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟, 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑇀𑆮𑆩𑇀, 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆱𑆼𑆑𑆂, 𑆩𑆶𑆒𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁, 𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆂, 𑆲𑆸𑆢𑆪𑆾𑆥𑆬𑆼𑆥𑆂, 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆠𑇀𑆮𑆁, 𑆗𑆫𑇀𑆢𑆴𑆂, 𑆩𑆸𑆢𑇀𑆮𑆓𑇀𑆤𑆴𑆠𑆳, 𑆤𑆴𑆢𑇀𑆫𑆳𑆣𑆴𑆑𑇀𑆪𑆁, 𑆱𑇀𑆠𑆩𑇀𑆨𑆂, 𑆠𑆤𑇀𑆢𑇀𑆫𑆳, 𑆑𑆳𑆱𑆂, 𑆯𑇀𑆮𑆳𑆱𑆂, 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆂, 𑆯𑆽𑆠𑇀𑆪𑆁, 𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆁 𑆖 𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆠𑇀𑆮𑆖𑆳𑆩𑇀, 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆖 𑆯𑆵𑆠𑆥𑆴𑆝𑆑𑆳 𑆨𑆸𑆯𑆩𑆕𑇀𑆓𑆼𑆨𑇀𑆪 𑆇𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴, 𑆇𑆰𑇀𑆟𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆠𑆳, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆶𑆥𑆯𑆪𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑆥𑆯𑆪𑆯𑇀𑆖; 𑆅𑆠𑆴 (𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆘𑇀𑆮𑆫𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴)𑇆𑇒𑇗𑇆
𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆳𑆢𑆤𑆯𑆤𑆳𑆢𑆤𑇀𑆤𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆳𑆢𑆸𑆠𑆶𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆼𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆓𑆤𑇀𑆣𑆾𑆥𑆔𑇀𑆫𑆳𑆟𑆳𑆢𑇀𑆮𑆴𑆰𑆾𑆥𑆲𑆠𑆱𑇀𑆪 𑆖𑆾𑆢𑆑𑆱𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑇀𑆓𑆫𑆼𑆨𑇀𑆪𑆾 𑆓𑆴𑆫𑆵𑆟𑆳𑆁 𑆖𑆾𑆥𑆯𑇀𑆬𑆼𑆰𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆤𑆳𑆩𑆪𑆡𑆳𑆮𑆠𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆠𑇀 𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑆁𑆱𑆫𑇀𑆘𑆤𑆳𑆢𑇀𑆮𑆳 𑆱𑇀𑆠𑇀𑆫𑆵𑆟𑆳𑆁 𑆖 𑆮𑆴𑆰𑆩𑆥𑇀𑆫𑆘𑆤𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆖 𑆩𑆴𑆡𑇀𑆪𑆾𑆥𑆖𑆳𑆫𑆳𑆢𑇀 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆖 𑆲𑆼𑆠𑆷𑆤𑆳𑆁 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆳𑆢𑇀𑆪𑆡𑆳𑆤𑆴𑆢𑆳𑆤𑆁 𑆢𑇀𑆮𑆤𑇀𑆢𑇀𑆮𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆂 𑆱𑆫𑇀𑆮𑆼 𑆮𑆳 𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳 𑆪𑆶𑆓𑆥𑆠𑇀 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆪𑆽𑆮𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳 𑆘𑇀𑆮𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴𑇆𑇒𑇘𑇆
𑆠𑆠𑇀𑆫 𑆠𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆘𑇀𑆮𑆫𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑇀𑆢𑇀𑆮𑆳𑆤𑇀𑆢𑇀𑆮𑆴𑆑𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆘𑇀𑆮𑆫𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆁 𑆮𑆳 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇙𑇆
𑆃𑆨𑆴𑆔𑆳𑆠𑆳𑆨𑆴𑆰𑆕𑇀𑆓𑆳𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆼𑆨𑇀𑆪 𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑇀𑆲𑆴 𑆮𑇀𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆾𑇁𑆰𑇀𑆛𑆩𑆾 𑆘𑇀𑆮𑆫𑆾 𑆨𑆮𑆠𑆴𑇅 𑆱 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆑𑆳𑆬𑆩𑆳𑆓𑆤𑇀𑆠𑆶𑆂 𑆑𑆼𑆮𑆬𑆾 𑆨𑆷𑆠𑇀𑆮𑆳 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆢𑆾𑆰𑆽𑆫𑆤𑆶𑆧𑆣𑇀𑆪𑆠𑆼𑇅 𑆠𑆠𑇀𑆫𑆳𑆨𑆴𑆔𑆳𑆠𑆘𑆾 𑆮𑆳𑆪𑆶𑆤𑆳 𑆢𑆶𑆰𑇀𑆛𑆯𑆾𑆟𑆴𑆠𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼𑆤, 𑆃𑆨𑆴𑆰𑆕𑇀𑆓𑆘𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆩𑇀, 𑆃𑆨𑆴𑆖𑆳𑆫𑆳𑆨𑆴𑆯𑆳𑆥𑆘𑆿 𑆠𑆶 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆤𑆳𑆤𑆶𑆧𑆣𑇀𑆪𑆼𑆠𑆼𑇆𑇓𑇐𑇆
𑆱 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆳𑆢𑇀𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆑𑇀𑆫𑆩𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆾 𑆮𑆼𑆢𑆴𑆠𑆮𑇀𑆪𑆂, 𑆑𑆫𑇀𑆩𑆟𑆳 𑆱𑆳𑆣𑆳𑆫𑆟𑆼𑆤 𑆖𑆾𑆥𑆖𑆫𑇀𑆪𑆠𑆼 𑇅 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆮𑆴𑆣𑆳 𑆘𑇀𑆮𑆫𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆶𑆑𑇀𑆠𑆳𑇆𑇓𑇑𑇆
𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑇀𑆮𑆼𑆑 𑆍𑆮 𑆱𑆤𑇀𑆠𑆳𑆥𑆬𑆑𑇀𑆰𑆟𑆂𑇅 𑆠𑆩𑆼𑆮𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼, 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆤𑆴𑆘𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆁 𑆖𑆳𑆲𑆶𑆫𑇀𑆨𑆴𑆰𑆘𑆾 𑆮𑆳𑆠𑆳𑆢𑆴𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆠𑇀𑇆𑇓𑇒𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆩𑆶𑆒𑆮𑆽𑆫𑆱𑇀𑆪𑆁, 𑆓𑆶𑆫𑆶𑆓𑆳𑆠𑇀𑆫𑆠𑇀𑆮𑆩𑇀, 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑆳𑆑𑆶𑆬𑆠𑇀𑆮𑆩𑇀, 𑆃𑆯𑇀𑆫𑇀𑆮𑆳𑆓𑆩𑆤𑆁, 𑆤𑆴𑆢𑇀𑆫𑆳𑆣𑆴𑆑𑇀𑆪𑆩𑇀, 𑆃𑆫𑆠𑆴𑆂, 𑆘𑆸𑆩𑇀𑆨𑆳, 𑆮𑆴𑆤𑆳𑆩𑆂, 𑆮𑆼𑆥𑆡𑆶𑆂, 𑆯𑇀𑆫𑆩𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆳𑆥𑆘𑆳𑆓𑆫𑆟𑆫𑆾𑆩𑆲𑆫𑇀𑆰𑆢𑆤𑇀𑆠𑆲𑆫𑇀𑆰𑆳𑆂, 𑆯𑆧𑇀𑆢𑆯𑆵𑆠𑆮𑆳𑆠𑆳𑆠𑆥𑆱𑆲𑆠𑇀𑆮𑆳𑆱𑆲𑆠𑇀𑆮𑆩𑇀, 𑆃𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆿, 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑇀, 𑆃𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆂, 𑆱𑆢𑆤𑆩𑇀, 𑆃𑆬𑇀𑆥𑆥𑇀𑆫𑆳𑆟𑆠𑆳, 𑆢𑆵𑆫𑇀𑆔𑆱𑆷𑆠𑇀𑆫𑆠𑆳, 𑆄𑆬𑆱𑇀𑆪𑆩𑇀, 𑆇𑆖𑆴𑆠𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆾 𑆲𑆳𑆤𑆴𑆂, 𑆥𑇀𑆫𑆠𑆵𑆥𑆠𑆳 𑆱𑇀𑆮𑆑𑆳𑆫𑇀𑆪𑆼𑆰𑆶, 𑆓𑆶𑆫𑆷𑆟𑆳𑆁 𑆮𑆳𑆑𑇀𑆪𑆼𑆰𑇀𑆮𑆨𑇀𑆪𑆱𑆷𑆪𑆳, 𑆧𑆳𑆬𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆢𑇀𑆮𑆼𑆰𑆂, 𑆱𑇀𑆮𑆣𑆫𑇀𑆩𑆼𑆰𑇀𑆮𑆖𑆴𑆤𑇀𑆠𑆳, 𑆩𑆳𑆬𑇀𑆪𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆨𑆾𑆘𑆤𑆥𑆫𑆴𑆑𑇀𑆬𑆼𑆯𑆤𑆁, 𑆩𑆣𑆶𑆫𑆼𑆨𑇀𑆪𑆯𑇀𑆖 𑆨𑆑𑇀𑆰𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆢𑇀𑆮𑆼𑆰𑆂, 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆥𑇀𑆫𑆴𑆪𑆠𑆳 𑆖, 𑆅𑆠𑆴 𑆘𑇀𑆮𑆫𑆱𑇀𑆪 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆳𑆑𑇀𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆠𑇀; 𑆃𑆥𑆴 𑆖𑆽𑆤𑆁 𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆫𑇀𑆠𑆩𑆤𑆶𑆧𑆣𑇀𑆤𑆤𑇀𑆠𑆴𑇆𑇓𑇓𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆳𑆤𑇀𑆪𑆼𑆑𑆽𑆑𑆯𑆾 𑆘𑇀𑆮𑆫𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆱𑆩𑆳𑆱𑆳𑆨𑇀𑆪𑆳𑆩𑇀𑇆𑇓𑇔𑇆
𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆩𑆲𑆼𑆯𑇀𑆮𑆫𑆑𑆾𑆥𑆥𑇀𑆫𑆨𑆮𑆂, 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆾, 𑆢𑆼𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆱𑇀𑆠𑆳𑆥𑆑𑆫𑆂, 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆧𑆬𑆮𑆫𑇀𑆟𑆲𑆫𑇀𑆰𑆾𑆠𑇀𑆱𑆳𑆲𑆲𑇀𑆫𑆳𑆱𑆑𑆫𑆂 , 𑆯𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆩𑆾𑆲𑆳𑆲𑆳𑆫𑆾𑆥𑆫𑆾𑆣𑆱𑆚𑇀𑆘𑆤𑆤𑆂; 𑆘𑇀𑆮𑆫𑆪𑆠𑆴 𑆯𑆫𑆵𑆫𑆳𑆟𑆵𑆠𑆴 𑆘𑇀𑆮𑆫𑆂, 𑆤𑆳𑆤𑇀𑆪𑆼 𑆮𑇀𑆪𑆳𑆣𑆪𑆱𑇀𑆠𑆡𑆳 𑆢𑆳𑆫𑆶𑆟𑆳 𑆧𑆲𑆷𑆥𑆢𑇀𑆫𑆮𑆳 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆳𑆯𑇀𑆖 𑆪𑆡𑆳𑇁𑆪𑆩𑇀𑇅 𑆱 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆳𑆣𑆴𑆥𑆠𑆴𑆂, 𑆤𑆳𑆤𑆳𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆪𑆾𑆤𑆴𑆰𑆶 𑆖 𑆧𑆲𑆶𑆮𑆴𑆣𑆽𑆂 𑆯𑆧𑇀𑆢𑆽𑆫𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆱𑆫𑇀𑆮𑆼 𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆂 𑆱𑆘𑇀𑆮𑆫𑆳 𑆍𑆮 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆱𑆘𑇀𑆮𑆫𑆳 𑆍𑆮 𑆩𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑆖; 𑆱 𑆩𑆲𑆳𑆩𑆾𑆲𑆂, 𑆠𑆼𑆤𑆳𑆨𑆴𑆨𑆷𑆠𑆳𑆂 𑆥𑇀𑆫𑆳𑆓𑇀𑆢𑆽𑆲𑆴𑆑𑆁 𑆢𑆼𑆲𑆴𑆤𑆂 𑆑𑆫𑇀𑆩 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆥𑆴 𑆤 𑆱𑇀𑆩𑆫𑆤𑇀𑆠𑆴, 𑆱𑆫𑇀𑆮𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆳𑆁 𑆖 𑆘𑇀𑆮𑆫 𑆍𑆮𑆳𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑆳𑆢𑆠𑇀𑆠𑆼𑇆𑇓𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆼 𑆘𑇀𑆮𑆫𑆳𑆢𑆿 𑆮𑆳 𑆲𑆴𑆠𑆁 𑆬𑆔𑇀𑆮𑆯𑆤𑆩𑆥𑆠𑆫𑇀𑆥𑆟𑆁 𑆮𑆳, 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑆂 𑆑𑆰𑆳𑆪𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆢𑆼𑆲𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆾𑆥𑆯𑆩𑆤- 𑆤𑆱𑇀𑆠𑆂𑆑𑆫𑇀𑆩𑆣𑆷𑆥𑆣𑆷𑆩𑆥𑆳𑆤𑆳𑆚𑇀𑆘𑆤𑆑𑇀𑆰𑆵𑆫𑆨𑆾𑆘𑆤𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆩𑇀𑇆𑇓𑇖𑇆
𑆘𑆵𑆫𑇀𑆟𑆘𑇀𑆮𑆫𑆼𑆰𑆶 𑆠𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆼𑆮 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆥𑆳𑆤𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑆪𑆡𑆳𑆱𑇀𑆮𑆿𑆰𑆣𑆱𑆴𑆢𑇀𑆣𑆱𑇀𑆪; 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆲𑆴 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑇀𑆮𑆳𑆠𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆳𑆠𑇀 𑆑𑆦𑆁, 𑆯𑆽𑆠𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆩𑆷𑆰𑇀𑆩𑆳𑆟𑆁 𑆖; 𑆠𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑆵𑆫𑇀𑆟𑆘𑇀𑆮𑆫𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆼𑆮 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆲𑆴𑆠𑆩𑆶𑆢𑆑𑆩𑆴𑆮𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆬𑆶𑆰𑇀𑆛𑆼𑆰𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑇀𑆮𑆴𑆠𑆴𑇆𑇓𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆡𑆳 𑆥𑇀𑆫𑆘𑇀𑆮𑆬𑆴𑆠𑆁 𑆮𑆼𑆯𑇀𑆩 𑆥𑆫𑆴𑆰𑆴𑆚𑇀𑆖𑆤𑇀𑆠𑆴 𑆮𑆳𑆫𑆴𑆟𑆳𑇅 𑆤𑆫𑆳𑆂 𑆯𑆳𑆤𑇀𑆠𑆴𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆠𑆡𑆳 𑆘𑆵𑆫𑇀𑆟𑆘𑇀𑆮𑆫𑆼 𑆔𑆸𑆠𑆩𑇀𑇆𑇓𑇘𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑇀𑆮𑆳𑆠𑆁 𑆯𑆩𑆪𑆠𑆴, 𑆯𑆽𑆠𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁 𑆤𑆴𑆪𑆖𑇀𑆗𑆠𑆴𑇅 𑆔𑆸𑆠𑆁 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆁 𑆢𑆾𑆰𑆁 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆳𑆠𑇀𑆠𑆶 𑆘𑆪𑆼𑆠𑇀 𑆑𑆦𑆩𑇀𑇆𑇓𑇙𑇆
𑆤𑆳𑆤𑇀𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑆡𑆳 𑆑𑆯𑇀𑆖𑆴𑆠𑇀 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆪𑆡𑆳 𑆱𑆫𑇀𑆥𑆴𑆫𑆠𑆂 𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆫𑇀𑆮𑆱𑇀𑆤𑆼𑆲𑆾𑆠𑇀𑆠𑆩𑆁 𑆩𑆠𑆩𑇀𑇆𑇔𑇐𑇆
𑆓𑆢𑇀𑆪𑆾𑆑𑇀𑆠𑆾 𑆪𑆂 𑆥𑆶𑆤𑆂 𑆯𑇀𑆬𑆾𑆑𑆽𑆫𑆫𑇀𑆡𑆂 𑆱𑆩𑆤𑆶𑆓𑆵𑆪𑆠𑆼𑇅 𑆠𑆢𑇀𑆮𑇀𑆪𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆳𑆫𑇀𑆡𑆁 𑆢𑇀𑆮𑆴𑆫𑆶𑆑𑇀𑆠𑆁 𑆠𑆤𑇀𑆤 𑆓𑆫𑇀𑆲𑇀𑆪𑆠𑆼𑇆𑇔𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆤𑆳𑆩𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆫𑇀𑆲𑆼𑆠𑆶𑆁 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆓𑆢𑆩𑇀𑇅 𑆓𑆢𑆬𑆑𑇀𑆰𑆟𑆥𑆫𑇀𑆪𑆳𑆪𑆳𑆤𑇀 𑆮𑇀𑆪𑆳𑆣𑆼𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆓𑇀𑆫𑆲𑆩𑇀𑇆𑇔𑇒𑇆
𑆘𑇀𑆮𑆫𑆩𑆰𑇀𑆛𑆮𑆴𑆣𑆁 𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆳𑆱𑆤𑇀𑆤𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆖 𑆫𑆷𑆥𑆁 𑆖 𑆨𑆼𑆰𑆘𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟 𑆖𑇆𑇔𑇓𑇆
𑆮𑇀𑆪𑆳𑆘𑆲𑆳𑆫 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆳𑆓𑇀𑆫𑆼 𑆤𑆴𑆢𑆳𑆤𑆼 𑆮𑆴𑆓𑆠𑆘𑇀𑆮𑆫𑆂𑇅 𑆨𑆓𑆮𑆳𑆤𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆳𑆪 𑆥𑇀𑆫𑆟𑆠𑆳𑆪 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂𑇆𑇔𑇔𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑆴𑆠𑇀𑆠𑆁 𑆪𑆡𑆳𑆨𑆷𑆠𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆠𑆼, 𑆠𑆢𑇀 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇆
𑆪𑆢𑆳 𑆘𑆤𑇀𑆠𑆶𑆫𑇀𑆪𑆮𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆑𑆾𑆫𑆢𑆷𑆰𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑇀𑆪𑆤𑇀𑆤𑆳𑆤𑆴 𑆨𑆶𑆕𑇀𑆑𑇀𑆠𑆼, 𑆨𑆸𑆯𑆾𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆥𑆴 𑆖𑆳𑆤𑇀𑆪𑆢𑆤𑇀𑆤𑆘𑆳𑆠𑆁 𑆤𑆴𑆰𑇀𑆥𑆳𑆮𑆩𑆳𑆰𑆑𑆶𑆬𑆠𑇀𑆡𑆱𑆷𑆥𑆑𑇀𑆰𑆳𑆫𑆾𑆥𑆱𑆁𑆲𑆴𑆠𑆁, 𑆢𑆣𑆴𑆢𑆣𑆴𑆩𑆟𑇀𑆝𑆾𑆢𑆯𑇀𑆮𑆴𑆠𑇀𑆑𑆛𑇀𑆮𑆫𑆳𑆩𑇀𑆬𑆑𑆳𑆚𑇀𑆘𑆴𑆑𑆾𑆥𑆱𑆼𑆑𑆁 𑆮𑆳, 𑆮𑆳𑆫𑆳𑆲𑆩𑆳𑆲𑆴𑆰𑆳𑆮𑆴𑆑𑆩𑆳𑆠𑇀𑆱𑇀𑆪𑆓𑆮𑇀𑆪𑆥𑆴𑆯𑆴𑆠𑆁, 𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆥𑆴𑆟𑇀𑆝𑆳𑆬𑆶𑆯𑆶𑆰𑇀𑆑𑆯𑆳𑆑𑆾𑆥𑆲𑆴𑆠𑆁, 𑆩𑆷𑆬𑆑𑆱𑆫𑇀𑆰𑆥𑆬𑆯𑆶𑆤𑆑𑆫𑆚𑇀𑆘𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶(𑆒𑆝𑆪𑆷𑆰 ) 𑆨𑆷𑆱𑇀𑆠𑆸𑆟𑆱𑆶𑆩𑆶𑆒𑆱𑆶𑆫𑆱𑆑𑆶𑆜𑆼𑆫𑆑𑆓𑆟𑇀𑆝𑆵𑆫𑆑𑆳𑆬𑆩𑆳𑆬𑆑𑆥𑆫𑇀𑆟𑆳𑆱𑆑𑇀𑆰𑆮𑆑𑆦𑆟𑆴𑆘𑇀𑆙𑆑𑆾𑆥𑆢𑆁𑆯𑆁, 𑆱𑆶𑆫𑆳𑆱𑆿𑆮𑆵𑆫𑆠𑆶𑆰𑆾𑆢𑆑𑆩𑆽𑆫𑆼𑆪𑆩𑆼𑆢𑆑𑆩𑆣𑆷𑆬𑆑𑆯𑆶𑆑𑇀𑆠𑆑𑆶𑆮𑆬𑆧𑆢𑆫𑆳𑆩𑇀𑆬𑆥𑇀𑆫𑆳𑆪𑆳𑆤𑆶𑆥𑆳𑆤𑆁 𑆮𑆳, 𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆾𑆠𑇀𑆠𑆫𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑇀; 𑆇𑆰𑇀𑆟𑆳𑆨𑆴𑆠𑆥𑇀𑆠𑆾 𑆮𑆳𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆠𑆴𑆮𑆼𑆬𑆁 𑆮𑆳𑇁𑇁𑆩𑆁 𑆥𑆪𑆂 𑆥𑆴𑆧𑆠𑆴, 𑆥𑆪𑆱𑆳 𑆱𑆩𑆯𑇀𑆤𑆳𑆠𑆴 𑆫𑆿𑆲𑆴𑆟𑆵𑆑𑆁 , 𑆑𑆳𑆟𑆑𑆥𑆾𑆠𑆁 𑆮𑆳 𑆱𑆫𑇀𑆰𑆥𑆠𑆽𑆬𑆑𑇀𑆰𑆳𑆫𑆱𑆴𑆢𑇀𑆣𑆁, 𑆑𑆶𑆬𑆠𑇀𑆡𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆘𑆳𑆩𑇀𑆧𑆮𑆬𑆑𑆶𑆖𑆥𑆑𑇀𑆮𑆽𑆂 𑆯𑆿𑆑𑇀𑆠𑆴𑆑𑆽𑆫𑇀𑆮𑆳 𑆱𑆲 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆴𑆧𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆳𑆨𑆴𑆠𑆥𑇀𑆠𑆂 ; 𑆠𑆱𑇀𑆪𑆽𑆮𑆩𑆳𑆖𑆫𑆠𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆬𑆾𑆲𑆴𑆠𑆁 𑆖 𑆱𑇀𑆮𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆼 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆱𑆫𑇀𑆥𑆢𑇀𑆪𑆢𑆼𑆮 𑆪𑆑𑆸𑆠𑇀𑆥𑇀𑆬𑆵𑆲𑆥𑇀𑆫𑆨𑆮𑆳𑆟𑆳𑆁 𑆬𑆾𑆲𑆴𑆠𑆮𑆲𑆳𑆤𑆳𑆁 𑆖 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆬𑆾𑆲𑆴𑆠𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆓𑆶𑆫𑆷𑆟𑆴 𑆩𑆶𑆒𑆳𑆤𑇀𑆪𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆫𑆶𑆤𑇀𑆣𑇀𑆪𑆳𑆠𑇀 𑆠𑆢𑆼𑆮 𑆬𑆾𑆲𑆴𑆠𑆁 𑆢𑆷𑆰𑆪𑆠𑆴𑇆𑇔𑇆
𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆬𑇀𑆬𑆾𑆲𑆴𑆠𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆳𑆬𑇀𑆬𑆾𑆲𑆴𑆠𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆳𑆤𑆶𑆮𑆴𑆣𑆳𑆤𑆳𑆖𑇀𑆖 𑆥𑆴𑆠𑇀𑆠𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇕𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆨𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆢𑆳𑆲𑆂, 𑆯𑆶𑆑𑇀𑆠𑆳𑆩𑇀𑆬𑆓𑆤𑇀𑆣𑆫𑆱 𑆇𑆢𑇀𑆓𑆳𑆫𑆂, 𑆗𑆫𑇀𑆢𑆼𑆫𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆳𑆓𑆩𑆤𑆁, 𑆗𑆫𑇀𑆢𑆴𑆠𑆱𑇀𑆪 𑆧𑆵𑆨𑆠𑇀𑆱𑆠𑆳, 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆾, 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆱𑆢𑆤𑆁, 𑆥𑆫𑆴𑆢𑆳𑆲𑆂, 𑆩𑆶𑆒𑆳𑆢𑇀𑆣𑆷𑆩𑆳𑆓𑆩 𑆅𑆮, 𑆬𑆾𑆲𑆬𑆾𑆲𑆴𑆠𑆩𑆠𑇀𑆱𑇀𑆪𑆳𑆩𑆓𑆤𑇀𑆣𑆴𑆠𑇀𑆮𑆩𑆴𑆮 𑆖𑆳𑆱𑇀𑆪𑆱𑇀𑆪, 𑆫𑆑𑇀𑆠𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆠𑇀𑆮𑆩𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆯𑆑𑆸𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆮𑆼𑆢𑆬𑆳𑆬𑆳𑆱𑆴𑆕𑇀𑆔𑆳𑆟𑆑𑆳𑆱𑇀𑆪𑆑𑆫𑇀𑆟𑆩𑆬𑆥𑆴𑆝𑆑𑆾𑆬𑆴𑆑𑆳𑆥𑆴𑆝𑆑𑆳𑆤𑆳𑆩𑇀 , 𑆃𑆕𑇀𑆓𑆮𑆼𑆢𑆤𑆳, 𑆬𑆾𑆲𑆴𑆠𑆤𑆵𑆬𑆥𑆵𑆠𑆯𑇀𑆪𑆳𑆮𑆳𑆤𑆳𑆩𑆫𑇀𑆖𑆴𑆰𑇀𑆩𑆠𑆳𑆁 𑆖 𑆫𑆷𑆥𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆢𑆫𑇀𑆯𑆤𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆴𑆠𑆴 (𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴)𑇆𑇖𑇆
𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆯𑆾𑆦𑆯𑆾𑆰𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆂 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆯𑇀𑆖𑇆𑇗𑇆
𑆩𑆳𑆫𑇀𑆓𑆿 𑆥𑆶𑆤𑆫𑆱𑇀𑆪 𑆢𑇀𑆮𑆿 𑆈𑆫𑇀𑆣𑇀𑆮𑆁, 𑆖𑆳𑆣𑆯𑇀𑆖𑇅 𑆠𑆢𑇀𑆧𑆲𑆶𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆴 𑆯𑆫𑆵𑆫𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆑𑆫𑇀𑆟𑆤𑆳𑆱𑆴𑆑𑆳𑆤𑆼𑆠𑇀𑆫𑆳𑆱𑇀𑆪𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆖𑇀𑆪𑆮𑆠𑆼, 𑆧𑆲𑆶𑆮𑆳𑆠𑆼 𑆠𑆶 𑆯𑆫𑆵𑆫𑆼 𑆮𑆳𑆠𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑆣𑆂 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆩𑆳𑆫𑇀𑆓𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆖𑇀𑆪𑆮𑆠𑆼, 𑆧𑆲𑆶𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆳𑆠𑆼 𑆠𑆶 𑆯𑆫𑆵𑆫𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆳𑆠𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆢𑇀𑆢𑇀𑆮𑆳𑆮𑆥𑆴 𑆩𑆳𑆫𑇀𑆓𑆿 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆿 𑆩𑆳𑆫𑇀𑆓𑆿 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆱𑆫𑇀𑆮𑆼𑆨𑇀𑆪 𑆍𑆮 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆨𑇀𑆪𑆂 𑆒𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆖𑇀𑆪𑆮𑆠𑆼 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆪𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆁 𑆠𑆠𑇀 𑆱𑆳𑆣𑇀𑆪𑆁, 𑆮𑆴𑆫𑆼𑆖𑆤𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆵𑆪𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆲𑇀𑆮𑆿𑆰𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖; 𑆪𑆢𑆣𑆾𑆨𑆳𑆓𑆁 𑆠𑆢𑇀𑆪𑆳𑆥𑇀𑆪𑆁, 𑆮𑆩𑆤𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆵𑆪𑆠𑇀𑆮𑆳𑆢𑆬𑇀𑆥𑆿𑆰𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖; 𑆪𑆢𑆶𑆨𑆪𑆨𑆳𑆓𑆁 𑆠𑆢𑆱𑆳𑆣𑇀𑆪𑆁, 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆪𑆾𑆓𑆴𑆠𑇀𑆮𑆳𑆢𑆤𑆿𑆰𑆣𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇙𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑆶𑆫𑆳 𑆢𑆑𑇀𑆰𑆪𑆘𑇀𑆚𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆼 𑆫𑆶𑆢𑇀𑆫𑆑𑆾𑆥𑆳𑆩𑆫𑇀𑆰𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆳𑆁 𑆥𑆫𑆴𑆓𑆠𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑆳𑆩𑆨𑆮𑆘𑇀𑆘𑇀𑆮𑆫𑆩𑆤𑆶𑇆𑇑𑇐𑇆
𑆠𑆱𑇀𑆪𑆳𑆯𑆶𑆑𑆳𑆫𑆴𑆟𑆾 𑆢𑆳𑆮𑆳𑆓𑇀𑆤𑆼𑆫𑆴𑆮𑆳𑆥𑆠𑆴𑆠𑆱𑇀𑆪𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆱𑇀𑆪𑆳𑆯𑆶 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑇀𑆪𑆽 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆢𑆼𑆯𑆁 𑆑𑆳𑆬𑆁 𑆖𑆳𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆤𑇀𑆠𑆫𑇀𑆥𑆟𑆼𑆤𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆼𑆤 𑆮𑆳 𑆩𑆸𑆢𑆶𑆩𑆣𑆶𑆫𑆯𑆴𑆯𑆴𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆽𑆫𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆽𑆂 𑆥𑇀𑆫𑆢𑆼𑆲𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆽𑆫𑇀𑆮𑆩𑆤𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆮𑆳 𑆠𑆠𑇀𑆫𑆳𑆮𑆲𑆴𑆠𑆼𑆤𑆼𑆠𑆴𑇆𑇑𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆳𑆣𑇀𑆪𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆢𑇀𑆪𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑇀𑆪 𑆪𑆾𑆓𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆱𑇀𑆪 𑆖𑇆𑇑𑇒𑇆
𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆠𑆶 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆘𑆪𑆳𑆫𑇀𑆡𑆼 𑆥𑆫𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆪𑆯𑇀𑆖 𑆠𑆠𑇀𑆫𑆳𑆤𑇀𑆮𑆪𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑆱𑇀𑆪 𑆖𑆳𑆤𑆣𑆩𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇓𑇆
𑆨𑆮𑆼𑆢𑇀𑆪𑆾𑆓𑆳𑆮𑆲𑆁 𑆠𑆠𑇀𑆫 𑆩𑆣𑆶𑆫𑆁 𑆖𑆽𑆮 𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆳𑆣𑇀𑆪𑆁 𑆩𑆠𑆁 𑆫𑆑𑇀𑆠𑆁 𑆪𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇆
𑆫𑆑𑇀𑆠𑆁 𑆠𑆶 𑆪𑆢𑆣𑆾𑆨𑆳𑆓𑆁 𑆠𑆢𑇀𑆪𑆳𑆥𑇀𑆪𑆩𑆴𑆠𑆴 𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆩𑇀𑇅 𑆮𑆩𑆤𑆱𑇀𑆪𑆳𑆬𑇀𑆥𑆪𑆾𑆓𑆴𑆠𑇀𑆮𑆳𑆢𑆬𑇀𑆥𑆠𑇀𑆮𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆱𑇀𑆪 𑆖𑇆𑇑𑇕𑇆
𑆮𑆩𑆤𑆁 𑆲𑆴 𑆤 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆲𑆫𑆟𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆪𑆯𑇀𑆖 𑆠𑆠𑇀𑆫𑆳𑆤𑇀𑆮𑆪𑆾 𑆮𑆳𑆪𑆶𑆱𑇀𑆠𑆖𑇀𑆗𑆳𑆤𑇀𑆠𑆿 𑆖𑆳𑆮𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀𑇆𑇑𑇖𑇆
𑆠𑆖𑇀𑆖𑆳𑆪𑆾𑆓𑆳𑆮𑆲𑆁 𑆠𑆠𑇀𑆫 𑆑𑆰𑆳𑆪𑆁 𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆤𑆴 𑆖𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆳𑆥𑇀𑆪𑆁 𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆪𑆢𑆶𑆑𑇀𑆠𑆩𑆤𑆶𑆬𑆾𑆩𑆓𑆩𑇀 𑇆𑇑𑇗𑇆
𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆶 𑆪𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆿 𑆢𑇀𑆮𑆳𑆮𑆥𑆴 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆃𑆱𑆳𑆣𑇀𑆪𑆩𑆴𑆠𑆴 𑆠𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆁 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆢𑆼𑆮 𑆑𑆳𑆫𑆟𑆳𑆠𑇀𑇆𑇑𑇘𑇆
𑆤𑆲𑆴 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆱𑇀𑆠𑇀𑆪𑆱𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆩𑆳𑆫𑇀𑆓𑆓𑆩𑇀𑇅 𑆥𑇀𑆫𑆠𑆴𑆩𑆳𑆫𑇀𑆓𑆁 𑆖 𑆲𑆫𑆟𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇆𑇑𑇙𑇆
𑆍𑆮𑆩𑆼𑆮𑆾𑆥𑆯𑆩𑆤𑆁 𑆱𑆫𑇀𑆮𑆯𑆾 𑆤𑆳𑆱𑇀𑆪 𑆮𑆴𑆢𑇀𑆪𑆠𑆼𑇅 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆼𑆰𑆶 𑆖 𑆢𑆾𑆰𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆘𑆴𑆖𑇀𑆗𑆩𑆤𑆁 𑆩𑆠𑆩𑇀 𑇆𑇒𑇐𑇆
𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾𑆢𑆫𑇀𑆑𑆁 𑆫𑆑𑇀𑆠𑆁 𑆩𑆳𑆫𑇀𑆓𑆮𑆴𑆯𑆼𑆰𑆠𑆂𑇅𑇒𑇑𑇅 𑆍𑆨𑇀𑆪𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆲𑆼𑆠𑆶𑆨𑇀𑆪𑆂 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆱𑆳𑆣𑇀𑆪𑆁 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴𑇆𑇒𑇑𑇆
𑆥𑇀𑆫𑆼𑆰𑇀𑆪𑆾𑆥𑆑𑆫𑆟𑆳𑆨𑆳𑆮𑆳𑆢𑇀𑆢𑆿𑆫𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆢𑆾𑆰𑆠𑆂𑇅 𑆃𑆑𑆫𑇀𑆩𑆠𑆯𑇀𑆖 𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆫𑆾𑆓𑆾𑇁𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫𑆳𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆩𑆼𑆑𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆳𑆣𑇀𑆪𑆪𑆳𑆥𑇀𑆪𑆥𑆫𑆴𑆑𑇀𑆫𑆩𑆳𑆠𑇀𑇅𑇒𑇓𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆴𑆢𑆁 𑆠𑆱𑇀𑆪𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇒𑇓𑇆
𑆪𑆠𑇀 𑆑𑆸𑆰𑇀𑆟𑆩𑆡𑆮𑆳 𑆤𑆵𑆬𑆁 𑆪𑆢𑇀𑆮𑆳 𑆯𑆑𑇀𑆫𑆣𑆤𑆶𑆰𑇀𑆥𑇀𑆫𑆨𑆩𑇀𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆢𑇀𑆮𑆳𑆱𑆱𑆾 𑆫𑆚𑇀𑆘𑆤𑆁 𑆖 𑆪𑆠𑇀𑇆𑇒𑇔𑇆
𑆨𑆸𑆯𑆁 𑆥𑆷𑆠𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆖 𑆱𑆫𑇀𑆮𑆾𑆥𑆢𑇀𑆫𑆮𑆮𑆖𑇀𑆖 𑆪𑆠𑇀𑇅 𑆧𑆬𑆩𑆳𑆁𑆱𑆑𑇀𑆰𑆪𑆼 𑆪𑆖𑇀𑆖 𑆠𑆖𑇀𑆖 𑆫𑆑𑇀𑆠𑆩𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆠𑇀𑇆𑇒𑇕𑇆
𑆪𑆼𑆤 𑆖𑆾𑆥𑆲𑆠𑆾 𑆫𑆑𑇀𑆠𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆩𑆳𑆤𑆮𑆂𑇅 𑆥𑆯𑇀𑆪𑆼𑆢𑇀𑆢𑆸𑆯𑇀𑆪𑆁 𑆮𑆴𑆪𑆖𑇀𑆖𑆳𑆥𑆴 𑆠𑆖𑇀𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆁 𑆤 𑆱𑆁𑆯𑆪𑆂𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆱𑆳𑆣𑇀𑆪𑆁 𑆥𑆫𑆴𑆠𑇀𑆪𑆳𑆘𑇀𑆪𑆁, 𑆪𑆳𑆥𑇀𑆪𑆁 𑆪𑆠𑇀𑆤𑆼𑆤 𑆪𑆳𑆥𑆪𑆼𑆠𑇀𑇅 𑆱𑆳𑆣𑇀𑆪𑆁 𑆖𑆳𑆮𑆲𑆴𑆠𑆂 𑆱𑆴𑆢𑇀𑆣𑆽𑆫𑇀𑆨𑆼𑆰𑆘𑆽𑆂 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀𑇆𑇒𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆑𑆳𑆫𑆟𑆁 𑆤𑆳𑆩𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑇅 𑆩𑆳𑆫𑇀𑆓𑆿 𑆢𑆾𑆰𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆖 𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆤 𑆖 𑆲𑆼𑆠𑆶𑆩𑆠𑇀𑇆𑇒𑇘𑇆
𑆤𑆴𑆢𑆳𑆤𑆼 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆘𑆲𑆳𑆫 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂𑇅 𑆮𑆵𑆠𑆩𑆾𑆲𑆫𑆘𑆾𑆢𑆾𑆰𑆬𑆾𑆨𑆩𑆳𑆤𑆩𑆢𑆱𑇀𑆥𑆸𑆲𑆂𑇆𑇒𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆓𑆶𑆬𑇀𑆩𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆥𑆚𑇀𑆖 𑆓𑆶𑆬𑇀𑆩𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆂, 𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆓𑆶𑆬𑇀𑆩𑆾, 𑆤𑆴𑆖𑆪𑆓𑆶𑆬𑇀𑆩𑆂, 𑆯𑆾𑆟𑆴𑆠𑆓𑆶𑆬𑇀𑆩 𑆅𑆠𑆴𑇆𑇓𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆑𑆡𑆩𑆴𑆲 𑆨𑆓𑆮𑆤𑇀 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆁 𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆩𑆨𑆴𑆘𑆳𑆤𑆵𑆩𑆲𑆼; 𑆤𑆲𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆢𑇀𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆿𑆰𑆣𑆮𑆴𑆢𑆥𑆴 𑆨𑆴𑆰𑆑𑇀 𑆥𑇀𑆫𑆯𑆩𑆤𑆱𑆩𑆫𑇀𑆡𑆾 𑆨𑆮𑆠𑆵𑆠𑆴𑇆𑇔𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆬𑆴𑆕𑇀𑆓𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆳𑆁 𑆨𑆮𑆠𑇀𑆪𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆖 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆠𑆠𑇀𑆠𑆶 𑆒𑆬𑆶 𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑆷𑆖𑇀𑆪𑆩𑆳𑆤𑆁 𑆤𑆴𑆧𑆾𑆣𑇆𑇕𑇆
𑆪𑆢𑆳 𑆥𑆶𑆫𑆶𑆰𑆾 𑆮𑆳𑆠𑆬𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆘𑇀𑆮𑆫𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆠𑆵𑆱𑆳𑆫𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆑𑆫𑇀𑆯𑆤𑆼𑆤 𑆑𑆫𑇀𑆯𑆴𑆠𑆾 𑆮𑆳𑆠𑆬𑆩𑆳𑆲𑆳𑆫𑆩𑆳𑆲𑆫𑆠𑆴, 𑆯𑆵𑆠𑆁 𑆮𑆳 𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑇀 , 𑆃𑆱𑇀𑆤𑆼𑆲𑆥𑆷𑆫𑇀𑆮𑆼 𑆮𑆳 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆼 𑆥𑆴𑆧𑆠𑆴, 𑆃𑆤𑆶𑆢𑆵𑆫𑇀𑆟𑆳𑆁 𑆮𑆳 𑆗𑆫𑇀𑆢𑆴𑆩𑆶𑆢𑆵𑆫𑆪𑆠𑆴, 𑆇𑆢𑆵𑆫𑇀𑆟𑆳𑆤𑇀 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆟𑆢𑇀𑆣𑆴, 𑆃𑆠𑇀𑆪𑆯𑆴𑆠𑆾 𑆮𑆳 𑆥𑆴𑆧𑆠𑆴 𑆤𑆮𑆾𑆢𑆑𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑇀, 𑆃𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆴𑆟𑆳 𑆮𑆳 𑆪𑆳𑆤𑆼𑆤 𑆪𑆳𑆠𑆴, 𑆃𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆩𑆢𑇀𑆪𑆯𑆾𑆑𑆫𑆶𑆖𑆴𑆫𑇀𑆮𑆳, 𑆃𑆨𑆴𑆔𑆳𑆠𑆩𑆸𑆖𑇀𑆗𑆠𑆴 𑆮𑆳, 𑆮𑆴𑆰𑆩𑆳𑆱𑆤𑆯𑆪𑆤𑆱𑇀𑆡𑆳𑆤𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆱𑆼𑆮𑆵 𑆮𑆳 𑆨𑆮𑆠𑆴, 𑆃𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆼𑆮𑆁𑆮𑆴𑆣𑆁 𑆮𑆴𑆰𑆩𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆘𑆳𑆠𑆩𑆳𑆫𑆨𑆠𑆼, 𑆠𑆱𑇀𑆪𑆳𑆥𑆖𑆳𑆫𑆳𑆢𑇀𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇖𑇆
𑆱 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆫𑇀𑆩𑆲𑆳𑆱𑇀𑆫𑆾𑆠𑆾𑇁𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀 𑆑𑆜𑆴𑆤𑆵𑆨𑆷𑆠𑆩𑆳𑆥𑇀𑆬𑆶𑆠𑇀𑆪 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆾𑇁𑆮𑆱𑇀𑆡𑆳𑆤𑆁 𑆑𑆫𑆾𑆠𑆴 𑆲𑆸𑆢𑆴 𑆧𑆱𑇀𑆠𑆿 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆫𑇀𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆳; 𑆱 𑆯𑆷𑆬𑆩𑆶𑆥𑆘𑆤𑆪𑆠𑆴 𑆓𑇀𑆫𑆤𑇀𑆡𑆵𑆁𑆯𑇀𑆖𑆳𑆤𑆼𑆑𑆮𑆴𑆣𑆳𑆤𑇀, 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆯𑇀𑆖𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆠𑆼, 𑆱 𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆠𑇀𑆮𑆳𑆢𑇀 ‘𑆓𑆶𑆬𑇀𑆩’ 𑆅𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼; 𑆱 𑆩𑆶𑆲𑆶𑆫𑆳𑆣𑆩𑆠𑆴 , 𑆩𑆶𑆲𑆶𑆫𑆬𑇀𑆥𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼; 𑆃𑆤𑆴𑆪𑆠𑆮𑆴𑆥𑆶𑆬𑆳𑆟𑆶𑆮𑆼𑆢𑆤𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑆖𑆬𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳𑆪𑆾𑆂, 𑆩𑆶𑆲𑆶𑆂 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆱𑆩𑇀𑆥𑇀𑆫𑆖𑆳𑆫 𑆅𑆮𑆳𑆕𑇀𑆓𑆼𑆰𑆶, 𑆠𑆾𑆢𑆨𑆼𑆢𑆱𑇀𑆦𑆶𑆫𑆟𑆳𑆪𑆳𑆩𑆱𑆕𑇀𑆑𑆾𑆖𑆱𑆶𑆥𑇀𑆠𑆴𑆲𑆫𑇀𑆰𑆥𑇀𑆫𑆬𑆪𑆾𑆢𑆪𑆧𑆲𑆶𑆬𑆂; 𑆠𑆢𑆳𑆠𑆶𑆫𑆂 𑆱𑆷𑆖𑇀𑆪𑆼𑆮 𑆯𑆕𑇀𑆑𑆶𑆤𑆼𑆮 𑆖𑆳𑆨𑆴𑆱𑆁𑆮𑆴𑆢𑇀𑆣𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆩𑆤𑇀𑆪𑆠𑆼, 𑆃𑆥𑆴 𑆖 𑆢𑆴𑆮𑆱𑆳𑆤𑇀𑆠𑆼 𑆘𑇀𑆮𑆫𑇀𑆪𑆠𑆼 , 𑆯𑆶𑆰𑇀𑆪𑆠𑆴 𑆖𑆳𑆱𑇀𑆪𑆳𑆱𑇀𑆪𑆩𑇀, 𑆇𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆯𑇀𑆖𑆾𑆥𑆫𑆶𑆣𑇀𑆪𑆠𑆼, 𑆲𑆸𑆰𑇀𑆪𑆤𑇀𑆠𑆴 𑆖𑆳𑆱𑇀𑆪 𑆫𑆾𑆩𑆳𑆟𑆴 𑆮𑆼𑆢𑆤𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆼; 𑆥𑇀𑆬𑆵𑆲𑆳𑆛𑆾𑆥𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆳𑆮𑆴𑆥𑆳𑆑𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆩𑆤𑇀𑆪𑆳𑆯𑆴𑆫𑆂𑆯𑆕𑇀𑆒𑆯𑆷𑆬𑆧𑇀𑆫𑆣𑇀𑆤𑆫𑆾𑆓𑆳𑆯𑇀𑆖𑆽𑆤𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆴; 𑆑𑆸𑆰𑇀𑆟𑆳𑆫𑆶𑆟𑆥𑆫𑆶𑆰𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆨𑆮𑆠𑆴, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼, 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆖𑆾𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆂𑇆𑇗𑇆
𑆠𑆽𑆫𑆼𑆮 𑆠𑆶 𑆑𑆫𑇀𑆯𑆤𑆽𑆂 𑆑𑆫𑇀𑆯𑆴𑆠𑆱𑇀𑆪𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆑𑇀𑆰𑆳𑆫𑆾𑆰𑇀𑆟𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆯𑆶𑆑𑇀𑆠𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆩𑆢𑇀𑆪𑆲𑆫𑆴𑆠𑆑𑆦𑆬𑆳𑆩𑇀𑆬𑆳𑆤𑆳𑆁 𑆮𑆴𑆢𑆳𑆲𑆴𑆤𑆳𑆁 𑆖 𑆯𑆳𑆑𑆣𑆳𑆤𑇀𑆪𑆩𑆳𑆁𑆱𑆳𑆢𑆵𑆤𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆤𑆶𑆓𑆠𑆼 𑆖𑆳𑆩𑆳𑆯𑆪𑆼 𑆮𑆩𑆤𑆩𑆠𑆴𑆮𑆼𑆬𑆁 𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆁 𑆮𑆳𑆠𑆳𑆠𑆥𑆿 𑆖𑆳𑆠𑆴𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆥𑆴𑆠𑇀𑆠𑆁 𑆱𑆲 𑆩𑆳𑆫𑆶𑆠𑆼𑆤 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇘𑇆
𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆩𑆳𑆫𑆶𑆠 𑆄𑆩𑆳𑆯𑆪𑆽𑆑𑆢𑆼𑆯𑆼 𑆱𑆁𑆮𑆫𑇀𑆠𑇀𑆪 𑆠𑆳𑆤𑆼𑆮 𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑆶𑆥𑆘𑆤𑆪𑆠𑆴, 𑆪 𑆇𑆑𑇀𑆠𑆳 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆼; 𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑇀𑆮𑆼𑆤𑆁 𑆮𑆴𑆢𑆲𑆠𑆴 𑆑𑆶𑆑𑇀𑆰𑆿 𑆲𑆸𑆢𑇀𑆪𑆶𑆫𑆱𑆴 𑆑𑆟𑇀𑆜𑆼 𑆖; 𑆱 𑆮𑆴𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆂 𑆱𑆣𑆷𑆩𑆩𑆴𑆮𑆾𑆢𑇀𑆓𑆳𑆫𑆩𑆶𑆢𑇀𑆓𑆴𑆫𑆠𑇀𑆪𑆩𑇀𑆬𑆳𑆤𑇀𑆮𑆴𑆠𑆁, 𑆓𑆶𑆬𑇀𑆩𑆳𑆮𑆑𑆳𑆯𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆢𑆲𑇀𑆪𑆠𑆼 𑆢𑆷𑆪𑆠𑆼 𑆣𑆷𑆥𑇀𑆪𑆠𑆼 𑆈𑆰𑇀𑆩𑆳𑆪𑆠𑆼 𑆱𑇀𑆮𑆴𑆢𑇀𑆪𑆠𑆴 𑆑𑇀𑆬𑆴𑆢𑇀𑆪𑆠𑆴 𑆯𑆴𑆡𑆴𑆬 𑆅𑆮 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆱𑆲𑆾𑇁𑆬𑇀𑆥𑆫𑆾𑆩𑆳𑆚𑇀𑆖𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆘𑇀𑆮𑆫𑆨𑇀𑆫𑆩𑆢𑆮𑆡𑆶𑆥𑆴𑆥𑆳𑆱𑆳𑆓𑆬𑆠𑆳𑆬𑆶𑆩𑆶𑆒𑆯𑆾𑆰𑆥𑇀𑆫𑆩𑆾𑆲𑆮𑆴𑆝𑇀𑆨𑆼𑆢𑆳𑆯𑇀𑆖𑆽𑆤𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆴; 𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑇀𑆖 𑆨𑆮𑆠𑆴; 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼, 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆬𑇀𑆩𑆂𑇆𑇙𑇆
𑆠𑆽𑆫𑆼𑆮 𑆠𑆶 𑆑𑆫𑇀𑆯𑆤𑆽𑆂 𑆑𑆫𑇀𑆯𑆴𑆠𑆱𑇀𑆪𑆳𑆠𑇀𑆪𑆯𑆤𑆳𑆢𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆯𑆵𑆠𑆳𑆯𑆤𑆳𑆠𑇀 𑆥𑆴𑆰𑇀𑆛𑆼𑆑𑇀𑆰𑆶𑆑𑇀𑆰𑆵𑆫𑆠𑆴𑆬𑆩𑆳𑆰𑆓𑆶𑆝𑆮𑆴𑆑𑆸𑆠𑆴𑆱𑆼𑆮𑆤𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆑𑆩𑆢𑇀𑆪𑆳𑆠𑆴𑆥𑆳𑆤𑆳𑆢𑇀𑆣𑆫𑆴𑆠𑆑𑆳𑆠𑆴𑆥𑇀𑆫𑆟𑆤𑆪𑆳𑆢𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆩𑆳𑆁𑆱𑆳𑆠𑆴𑆨𑆑𑇀𑆰𑆟𑆳𑆠𑇀 𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆢𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆱𑇀𑆪 𑆖𑆳𑆠𑆴𑆥𑇀𑆫𑆓𑆳𑆞𑆩𑆶𑆢𑆥𑆳𑆤𑆳𑆠𑇀 𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆟𑆳𑆢𑇀𑆮𑆳 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆱𑆲 𑆩𑆳𑆫𑆶𑆠𑆼𑆤 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇆
𑆠𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆩𑆳𑆫𑆶𑆠 𑆄𑆩𑆳𑆯𑆪𑆽𑆑𑆢𑆼𑆯𑆼 𑆱𑆁𑆮𑆫𑇀𑆠𑇀𑆪 𑆠𑆳𑆤𑆼𑆮 𑆮𑆼𑆢𑆤𑆳𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑆶𑆥𑆘𑆤𑆪𑆠𑆴 𑆪 𑆇𑆑𑇀𑆠𑆳 𑆮𑆳𑆠𑆓𑆶𑆬𑇀𑆩𑆼; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑇀𑆮𑆱𑇀𑆪 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆲𑆫𑇀𑆰𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆱𑇀𑆪𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆓𑆿𑆫𑆮𑆯𑆴𑆫𑆾𑆨𑆴𑆠𑆳𑆥𑆳𑆤𑆶𑆥𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑆴 𑆖 𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆪 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆓𑆿𑆫𑆮𑆑𑆳𑆜𑆴𑆤𑇀𑆪𑆳𑆮𑆓𑆳𑆞𑆱𑆶𑆥𑇀𑆠𑆠𑆳𑆂, 𑆠𑆡𑆳 𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆤𑇀 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆁 𑆖𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆂, 𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆁 𑆠𑇀𑆮𑆕𑇀𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆼𑆰𑆷𑆥𑆘𑆤𑆪𑆠𑆴, 𑆤𑆴𑆢𑆳𑆤𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆤𑆾𑆥𑆯𑆼𑆫𑆠𑆼, 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆖𑆾𑆥𑆯𑆼𑆫𑆠 𑆅𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆓𑆶𑆬𑇀𑆩𑆂𑇆𑇑𑇑𑇆
𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆠𑆶 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆁 𑆓𑆶𑆬𑇀𑆩𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇅 𑆱 𑆮𑆴𑆥𑇀𑆫𑆠𑆴𑆰𑆴𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆢𑆱𑆳𑆣𑇀𑆪𑆾 𑆤𑆴𑆖𑆪𑆓𑆶𑆬𑇀𑆩𑆂𑇆𑇑𑇒𑇆
𑆯𑆾𑆟𑆴𑆠𑆓𑆶𑆬𑇀𑆩𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆍𑆮 𑆨𑆮𑆠𑆴 𑆤 𑆥𑆶𑆫𑆶𑆰𑆱𑇀𑆪, 𑆓𑆫𑇀𑆨𑆑𑆾𑆰𑇀𑆜𑆳𑆫𑇀𑆠𑆮𑆳𑆓𑆩𑆤𑆮𑆽𑆯𑆼𑆰𑇀𑆪𑆳𑆠𑇀𑇅 𑆥𑆳𑆫𑆠𑆤𑇀𑆠𑇀𑆫𑇀𑆪𑆳𑆢𑆮𑆽𑆯𑆳𑆫𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆠𑆠𑆩𑆶𑆥𑆖𑆳𑆫𑆳𑆤𑆶𑆫𑆾𑆣𑆳𑆢𑇀𑆮𑆳 𑆮𑆼𑆓𑆳𑆤𑆶𑆢𑆵𑆫𑇀𑆟𑆳𑆤𑆶𑆥𑆫𑆶𑆤𑇀𑆣𑆠𑇀𑆪𑆳 𑆄𑆩𑆓𑆫𑇀𑆨𑆼 𑆮𑆳𑇁𑆥𑇀𑆪𑆖𑆴𑆫𑆥𑆠𑆴𑆠𑆼𑇁𑆡𑆮𑆳𑇁𑆥𑇀𑆪𑆖𑆴𑆫𑆥𑇀𑆫𑆘𑆳𑆠𑆳𑆪𑆳 𑆉𑆠𑆿 𑆮𑆳 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆤𑇀𑆪𑆳𑆱𑆼𑆮𑆩𑆳𑆤𑆳𑆪𑆳𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇆
𑆱 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆾 𑆪𑆾𑆤𑆴𑆩𑆶𑆒𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆫𑇀𑆠𑆮𑆩𑆶𑆥𑆫𑆶𑆟𑆢𑇀𑆣𑆴, 𑆩𑆳𑆱𑆴 𑆩𑆳𑆱𑆴 𑆠𑆢𑆳𑆫𑇀𑆠𑆮𑆩𑆶𑆥𑆫𑆶𑆣𑇀𑆪𑆩𑆳𑆤𑆁 𑆑𑆶𑆑𑇀𑆰𑆴𑆩𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆠𑆴𑇅 𑆠𑆱𑇀𑆪𑆳𑆂 𑆯𑆷𑆬𑆑𑆳𑆱𑆳𑆠𑆵𑆱𑆳𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆱𑇀𑆪𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆑𑆦𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆂 𑆱𑆩𑆶𑆥𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆱𑇀𑆠𑆤𑆪𑆾𑆯𑇀𑆖 𑆱𑇀𑆠𑆤𑇀𑆪𑆩𑇀, 𑆏𑆰𑇀𑆜𑆪𑆾𑆂 𑆱𑇀𑆠𑆤𑆩𑆟𑇀𑆝𑆬𑆪𑆾𑆯𑇀𑆖 𑆑𑆳𑆫𑇀𑆰𑇀𑆟𑇀𑆪𑆩𑇀, 𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆓𑇀𑆬𑆳𑆤𑆴𑆯𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆂, 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳, 𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆂, 𑆢𑆾𑆲𑆢𑆂, 𑆯𑇀𑆮𑆪𑆡𑆶𑆯𑇀𑆖 𑆥𑆳𑆢𑆪𑆾𑆂, 𑆆𑆰𑆖𑇀𑆖𑆾𑆢𑇀𑆓𑆩𑆾 𑆫𑆾𑆩𑆫𑆳𑆘𑇀𑆪𑆳𑆂, 𑆪𑆾𑆤𑇀𑆪𑆳𑆯𑇀𑆖𑆳𑆛𑆳𑆬𑆠𑇀𑆮𑆩𑇀, 𑆃𑆥𑆴 𑆖 𑆪𑆾𑆤𑇀𑆪𑆳 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆩𑆳𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼, 𑆑𑆼𑆮𑆬𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆳 𑆓𑆶𑆬𑇀𑆩𑆂 𑆥𑆴𑆟𑇀𑆝𑆴𑆠 𑆍𑆮 𑆱𑇀𑆥𑆤𑇀𑆢𑆠𑆼, 𑆠𑆳𑆩𑆓𑆫𑇀𑆨𑆳𑆁 𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆩𑆴𑆠𑇀𑆪𑆳𑆲𑆶𑆫𑇀𑆩𑆷𑆞𑆳𑆂𑇆𑇑𑇔𑇆
𑆍𑆰𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆥𑆚𑇀𑆖𑆳𑆤𑆳𑆁 𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆓𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼𑆫𑆴𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆰𑆟𑆩𑇀, 𑆃𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆿, 𑆃𑆓𑇀𑆤𑆴𑆮𑆽𑆰𑆩𑇀𑆪𑆁, 𑆮𑆴𑆢𑆳𑆲𑆾 𑆨𑆶𑆑𑇀𑆠𑆱𑇀𑆪, 𑆥𑆳𑆑𑆑𑆳𑆬𑆼 𑆖𑆳𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆗𑆫𑇀𑆢𑇀𑆪𑆶𑆢𑇀𑆓𑆳𑆫𑆿, 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆳𑆤𑆳𑆁 𑆖𑆳𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆂, 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆖𑆳𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆵𑆰𑆢𑆳𑆓𑆩𑆤𑆁 𑆮𑆳, 𑆮𑆳𑆠𑆯𑆷𑆬𑆳𑆛𑆾𑆥𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆳𑆥𑆫𑆴𑆲𑆫𑇀𑆰𑆟𑆳𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆥𑆶𑆫𑆵𑆰𑆠𑆳𑆂, 𑆃𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆳, 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁, 𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆱𑇀𑆪 𑆖𑆳𑆱𑆲𑆠𑇀𑆮𑆩𑆴𑆠𑆴𑇆𑇑𑇕𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆥𑆴 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑆶 𑆤 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆮𑆳𑆠𑆳𑆢𑆸𑆠𑆼 𑆱𑆩𑇀𑆨𑆮𑆠𑆴 𑆓𑆶𑆬𑇀𑆩𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆤𑆽𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠, 𑆍𑆑𑆢𑆾𑆰𑆘𑆼 𑆠𑆶 𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑆳𑆫𑆩𑇀𑆨𑆁 𑆥𑇀𑆫𑆟𑆪𑆼𑆠𑇀, 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆁𑆱𑇀𑆠𑆶 𑆱𑆳𑆣𑆳𑆫𑆟𑆼𑆤 𑆑𑆫𑇀𑆩𑆟𑆾𑆥𑆖𑆫𑆼𑆠𑇀𑇅 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑇀𑆪𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆩𑆤𑇀𑆪𑆼𑆠 𑆠𑆢𑆥𑇀𑆪𑆮𑆖𑆳𑆫𑆪𑆼𑆢𑇀𑆮𑆴𑆨𑆘𑇀𑆪 𑆓𑆶𑆫𑆶𑆬𑆳𑆔𑆮𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆟𑆳𑆁, 𑆓𑆶𑆫𑆷𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆁𑆱𑇀𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆘𑇀𑆘𑆔𑆤𑇀𑆪𑆩𑆴𑆠𑆫𑆳𑆤𑇀𑇅 𑆠𑇀𑆮𑆫𑆩𑆳𑆟𑆱𑇀𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆩𑆤𑆶𑆥𑆬𑆨𑆩𑆳𑆤𑆾 𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑇀𑆮𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆼 𑆑𑆫𑇀𑆩𑆟𑆴 𑆮𑆳𑆠𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆥𑇀𑆫𑆟𑆪𑆼𑆠𑇀, 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆮𑆳𑆠𑆲𑆫𑆿 𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆱𑆁𑆲𑆴𑆠𑆁 𑆖 𑆩𑆸𑆢𑆶 𑆮𑆴𑆫𑆼𑆖𑆤𑆁 𑆧𑆱𑇀𑆠𑆵𑆁𑆯𑇀𑆖; 𑆃𑆩𑇀𑆬𑆬𑆮𑆟𑆩𑆣𑆶𑆫𑆳𑆁𑆯𑇀𑆖 𑆫𑆱𑆳𑆤𑇀 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳𑇁𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀𑇅 𑆩𑆳𑆫𑆶𑆠𑆼 𑆲𑇀𑆪𑆶𑆥𑆯𑆳𑆤𑇀𑆠𑆼 𑆱𑇀𑆮𑆬𑇀𑆥𑆼𑆤𑆳𑆥𑆴 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆼𑆤 𑆯𑆑𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆾𑇁𑆥𑆴 𑆢𑆾𑆰𑆾 𑆤𑆴𑆪𑆤𑇀𑆠𑆶𑆁 𑆓𑆶𑆬𑇀𑆩𑆼𑆰𑇀𑆮𑆴𑆠𑆴𑇆𑇑𑇖𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆶𑆬𑇀𑆩𑆴𑆤𑆳𑆩𑆤𑆴𑆬𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑆶𑆥𑆳𑆪𑆽𑆂 𑆱𑆫𑇀𑆮𑆯𑆾 𑆮𑆴𑆣𑆴𑆮𑆢𑆳𑆖𑆫𑆴𑆠𑆮𑇀𑆪𑆳𑇅 𑆩𑆳𑆫𑆶𑆠𑆼 𑆲𑇀𑆪𑆮𑆘𑆴𑆠𑆼𑇁𑆤𑇀𑆪𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆁 𑆢𑆾𑆰𑆩𑆬𑇀𑆥𑆩𑆥𑆴 𑆑𑆫𑇀𑆩 𑆤𑆴𑆲𑆤𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆫𑆷𑆥𑆳𑆟𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆩𑆡𑆳𑆥𑆴 𑆖𑇅 𑆢𑆴𑆰𑇀𑆛𑆁 𑆤𑆴𑆢𑆳𑆤𑆼 𑆓𑆶𑆬𑇀𑆩𑆳𑆤𑆳𑆩𑆼𑆑𑆢𑆼𑆯𑆯𑇀𑆖 𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀𑇆𑇑𑇘𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆑𑆳𑆫𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼𑇁𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆂𑇅 𑆠𑆠𑇀𑆫 𑆪𑆡𑆳 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴 𑆠𑆡𑆳𑇁𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇓𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆤𑆴𑆢𑆳𑆤𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆑𑆳𑆫𑆮𑆴𑆔𑆳𑆠𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆥𑇀𑆫𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆪𑆢𑆳 𑆲𑇀𑆪𑆼𑆠𑆼 𑆠𑇀𑆫𑆪𑆾 𑆤𑆴𑆢𑆳𑆤𑆳𑆢𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆥𑆫𑆱𑇀𑆥𑆫𑆁 𑆤𑆳𑆤𑆶𑆧𑆣𑇀𑆤𑆤𑇀𑆠𑇀𑆪𑆡𑆮𑆳 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆢𑆧𑆬𑆵𑆪𑆳𑆁𑆱𑆾𑇁𑆡𑆮𑆳𑇁𑆤𑆶𑆧𑆣𑇀𑆤𑆤𑇀𑆠𑆴 𑆤 𑆠𑆢𑆳 𑆮𑆴𑆑𑆳𑆫𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆖𑆴𑆫𑆳𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼, 𑆠𑆤𑆮𑆾 𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆪𑆡𑆾𑆑𑇀𑆠𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆳 𑆮𑆳; 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆂; 𑆅𑆠𑆴 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆮𑆴𑆔𑆳𑆠𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆥𑇀𑆫𑆠𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆫𑇀𑆨𑆮𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆂𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆼𑆩𑆼 𑆠𑇀𑆫𑆪𑆾 𑆤𑆴𑆢𑆳𑆤𑆳𑆢𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆟𑆳𑆩𑆳𑆯𑇀𑆮𑆨𑆴𑆫𑇀𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆲𑆳𑆪𑆤𑆑𑆪𑆮𑆑𑆖𑆵𑆤𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆤𑆽𑆰𑆣𑆼𑆠𑇀𑆑𑆛𑆩𑆶𑆑𑆶𑆤𑇀𑆢𑆑𑆩𑆲𑆳𑆮𑇀𑆫𑆵𑆲𑆴𑆥𑇀𑆫𑆩𑆾𑆢𑆑𑆱𑆶𑆓𑆤𑇀𑆣𑆑𑆳𑆤𑆳𑆁 𑆤𑆮𑆳𑆤𑆳𑆩𑆠𑆴𑆮𑆼𑆬𑆩𑆠𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆼𑆤 𑆖𑆾𑆥𑆪𑆾𑆓𑆂, 𑆠𑆡𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆩𑆠𑆳𑆁 𑆤𑆮𑆲𑆫𑆼𑆟𑆶𑆩𑆳𑆰𑆱𑆷𑆥𑇀𑆪𑆳𑆤𑆳𑆁, 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆳𑆤𑆳𑆁 𑆖 𑆩𑆳𑆁𑆱𑆳𑆤𑆳𑆁, 𑆯𑆳𑆑𑆠𑆴𑆬𑆥𑆬𑆬𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆥𑆳𑆪𑆱𑆑𑆸𑆯𑆫𑆳𑆮𑆴𑆬𑆼𑆥𑆵𑆑𑇀𑆰𑆶𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁, 𑆑𑇀𑆰𑆵𑆫𑆤𑆮𑆩𑆢𑇀𑆪𑆩𑆤𑇀𑆢𑆑𑆢𑆣𑆴𑆢𑇀𑆫𑆮𑆩𑆣𑆶𑆫𑆠𑆫𑆶𑆟𑆥𑇀𑆫𑆳𑆪𑆳𑆟𑆳𑆁 𑆖𑆾𑆥𑆪𑆾𑆓𑆂, 𑆩𑆸𑆘𑆳𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑆫𑇀𑆘𑆤𑆁, 𑆱𑇀𑆮𑆥𑇀𑆤𑆯𑆪𑆤𑆳𑆱𑆤𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆂, 𑆪𑆯𑇀𑆖 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆮𑆴𑆣𑆴𑆫𑆤𑇀𑆪𑆾𑇁𑆥𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆼𑆢𑆾𑆩𑆷𑆠𑇀𑆫𑆱𑆚𑇀𑆘𑆤𑆤𑆂, 𑆱 𑆱𑆫𑇀𑆮𑆾 𑆤𑆴𑆢𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆂𑇆𑇕𑇆
𑆧𑆲𑆶𑆢𑇀𑆫𑆮𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆢𑆾𑆰𑆮𑆴𑆯𑆼𑆰𑆂𑇆𑇖𑇆
𑆧𑆲𑇀𑆮𑆧𑆢𑇀𑆣𑆁 𑆩𑆼𑆢𑆾 𑆩𑆳𑆁𑆱𑆁 𑆯𑆫𑆵𑆫𑆘𑆑𑇀𑆬𑆼𑆢𑆂 𑆯𑆶𑆑𑇀𑆫𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆮𑆱𑆳 𑆩𑆘𑇀𑆘𑆳 𑆬𑆱𑆵𑆑𑆳 𑆫𑆱𑆯𑇀𑆖𑆿𑆘𑆂𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠 𑆅𑆠𑆴 𑆢𑆷𑆰𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆂𑇆𑇗𑇆
𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆩𑆼𑆰𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆳𑆢𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆥𑇀𑆫𑆳𑆓𑆠𑆴𑆨𑆷𑆪𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆼𑆮 𑆯𑆫𑆵𑆫𑆼 𑆮𑆴𑆱𑆸𑆥𑇀𑆠𑆴𑆁 𑆬𑆨𑆠𑆼, 𑆯𑆫𑆵𑆫𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆳𑆠𑇀; 𑆱 𑆮𑆴𑆱𑆫𑇀𑆥𑆚𑇀 𑆯𑆫𑆵𑆫𑆼 𑆩𑆼𑆢𑆱𑆽𑆮𑆳𑆢𑆴𑆠𑆾 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆳𑆮𑆁 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆩𑆼𑆢𑆱𑆯𑇀𑆖𑆽𑆮 𑆧𑆲𑇀𑆮𑆧𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆯𑇀𑆖 𑆓𑆶𑆟𑆽𑆂 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆩𑆼𑆢𑆱𑆳 𑆩𑆴𑆯𑇀𑆫𑆵𑆨𑆮𑆤𑇀 𑆢𑆷𑆰𑆪𑆠𑇀𑆪𑆼𑆤𑆠𑇀, 𑆮𑆴𑆑𑆸𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆮𑆴𑆑𑆸𑆠𑆾 𑆢𑆶𑆰𑇀𑆛𑆼𑆤 𑆩𑆼𑆢𑆱𑆾𑆥𑆲𑆴𑆠𑆂 𑆯𑆫𑆵𑆫𑆑𑇀𑆬𑆼𑆢𑆩𑆳𑆁𑆱𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆱𑆫𑇀𑆓𑆁 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆑𑇀𑆬𑆼𑆢𑆩𑆳𑆁𑆱𑆪𑆾𑆫𑆠𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀; 𑆱 𑆩𑆳𑆁𑆱𑆼 𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆢𑆾𑆰𑆳𑆠𑇀 𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆥𑆴𑆝𑆑𑆳𑆂 𑆯𑆫𑆳𑆮𑆴𑆑𑆳𑆑𑆖𑇀𑆗𑆥𑆴𑆑𑆳𑆢𑇀𑆪𑆳𑆂 𑆱𑆚𑇀𑆘𑆤𑆪𑆠𑆴, 𑆃𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆠𑇀𑆮𑆳𑆠𑇀; 𑆯𑆫𑆵𑆫𑆑𑇀𑆬𑆼𑆢𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆷𑆰𑆪𑆤𑇀 𑆩𑆷𑆠𑇀𑆫𑆠𑇀𑆮𑆼𑆤 𑆥𑆫𑆴𑆟𑆩𑆪𑆠𑆴, 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆳𑆤𑆳𑆁 𑆖 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆨𑆮𑆳𑆟𑆳𑆁 𑆩𑆼𑆢𑆂𑆑𑇀𑆬𑆼𑆢𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑆴 𑆓𑆶𑆫𑆷𑆟𑆴 𑆩𑆶𑆒𑆳𑆤𑇀𑆪𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆫𑆶𑆣𑇀𑆪𑆠𑆼; 𑆠𑆠𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆁𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆩𑆱𑆳𑆣𑇀𑆪𑆠𑆳𑆁 𑆮𑆳 𑆘𑆤𑆪𑆠𑆴, 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇘𑇆
𑆯𑆫𑆵𑆫𑆑𑇀𑆬𑆼𑆢𑆱𑇀𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆩𑆼𑆢𑆾𑆩𑆴𑆯𑇀𑆫𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆤𑇀 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆁 𑆩𑆷𑆠𑇀𑆫𑆠𑇀𑆮𑆩𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆂 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆽𑆫𑆼𑆨𑆴𑆫𑇀𑆢𑆯𑆨𑆴𑆫𑇀𑆓𑆶𑆟𑆽𑆫𑆶𑆥𑆱𑆸𑆘𑇀𑆪𑆠𑆼 𑆮𑆽𑆰𑆩𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆽𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆮𑆼𑆠𑆯𑆵𑆠𑆩𑆷𑆫𑇀𑆠𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆳𑆖𑇀𑆗𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆓𑆶𑆫𑆶𑆩𑆣𑆶𑆫𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆱𑆳𑆢𑆩𑆤𑇀𑆢𑆽𑆂, 𑆠𑆠𑇀𑆫 𑆪𑆼𑆤 𑆓𑆶𑆟𑆼𑆤𑆽𑆑𑆼𑆤𑆳𑆤𑆼𑆑𑆼𑆤 𑆮𑆳 𑆨𑆷𑆪𑆱𑇀𑆠𑆫𑆩𑆶𑆥𑆱𑆸𑆘𑇀𑆪𑆠𑆼 𑆠𑆠𑇀𑆱𑆩𑆳𑆒𑇀𑆪𑆁 𑆓𑆿𑆟𑆁 𑆤𑆳𑆩𑆮𑆴𑆯𑆼𑆰𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴𑇆𑇙𑇆
𑆠𑆼 𑆠𑆶 𑆒𑆬𑇀𑆮𑆴𑆩𑆼 𑆢𑆯 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆤𑆳𑆩𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆇𑆢𑆑𑆩𑆼𑆲𑆯𑇀𑆖, 𑆅𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳𑆫𑆱𑆩𑆼𑆲𑆯𑇀𑆖, 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖, 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆱𑆳𑆢𑆩𑆼𑆲𑆯𑇀𑆖, 𑆯𑆶𑆑𑇀𑆬𑆩𑆼𑆲𑆯𑇀𑆖, 𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖, 𑆯𑆵𑆠𑆩𑆼𑆲𑆯𑇀𑆖, 𑆱𑆴𑆑𑆠𑆳𑆩𑆼𑆲𑆯𑇀𑆖, 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆯𑇀𑆖, 𑆄𑆬𑆳𑆬𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇐𑇆
𑆠𑆼 𑆢𑆯 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆂; 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆩𑆼𑆢𑆂𑆱𑇀𑆡𑆳𑆤𑆑𑆠𑇀𑆮𑆳𑆠𑇀, 𑆑𑆦𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆳𑆠𑇀, 𑆱𑆩𑆑𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆩𑆼𑆲𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴-𑇆𑇑𑇒𑇆
𑆃𑆖𑇀𑆗𑆁 𑆧𑆲𑆶 𑆱𑆴𑆠𑆁 𑆯𑆵𑆠𑆁 𑆤𑆴𑆫𑇀𑆓𑆤𑇀𑆣𑆩𑆶𑆢𑆑𑆾𑆥𑆩𑆩𑇀𑇅 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆳𑆤𑇀𑆤𑆫𑆾 𑆩𑆷𑆠𑇀𑆫𑆩𑆶𑆢𑆩𑆼𑆲𑆵 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇆𑇑𑇓𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆣𑆶𑆫𑆁 𑆯𑆵𑆠𑆩𑆵𑆰𑆠𑇀𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆩𑆳𑆮𑆴𑆬𑆩𑇀𑇅 𑆑𑆳𑆟𑇀𑆝𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆕𑇀𑆑𑆳𑆯𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇆𑇑𑇔𑇆
𑆪𑆱𑇀𑆪 𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆵𑆨𑆮𑆠𑆴 𑆨𑆳𑆘𑆤𑆼𑇅 𑆥𑆶𑆫𑆶𑆰𑆁 𑆑𑆦𑆑𑆾𑆥𑆼𑆤 𑆠𑆩𑆳𑆲𑆶𑆂 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇑𑇕𑇆
𑆪𑆱𑇀𑆪 𑆱𑆁𑆲𑆤𑇀𑆪𑆠𑆼 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆱𑆵𑆢𑆠𑆴𑇅 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆥𑇀𑆫𑆱𑆳𑆢𑆩𑆼𑆲𑆵𑆠𑆴 𑆠𑆩𑆳𑆲𑆶𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇑𑇖𑇆
𑆯𑆶𑆑𑇀𑆬𑆁 𑆥𑆴𑆰𑇀𑆛𑆤𑆴𑆨𑆁 𑆩𑆷𑆠𑇀𑆫𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆪𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇅 𑆥𑆶𑆫𑆶𑆰𑆁 𑆑𑆦𑆑𑆾𑆥𑆼𑆤 𑆠𑆩𑆳𑆲𑆶𑆂 𑆯𑆶𑆑𑇀𑆬𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇑𑇗𑇆
𑆯𑆶𑆑𑇀𑆫𑆳𑆨𑆁 𑆯𑆶𑆑𑇀𑆫𑆩𑆴𑆯𑇀𑆫𑆁 𑆮𑆳 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆯𑆶𑆑𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇑𑇘𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆣𑆶𑆫𑆁 𑆯𑆵𑆠𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆨𑆸𑆯𑆩𑇀𑇅 𑆯𑆵𑆠𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇑𑇙𑇆
𑆩𑆷𑆫𑇀𑆠𑆳𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆓𑆠𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑆟𑆷𑆤𑇀𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆱𑆴𑆑𑆠𑆳𑆩𑆼𑆲𑆴𑆤𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆁 𑆤𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇒𑇐𑇆
𑆩𑆤𑇀𑆢𑆁 𑆩𑆤𑇀𑆢𑆩𑆮𑆼𑆓𑆁 𑆠𑆶 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆁 𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆪𑆼𑆖𑇀𑆗𑆤𑆽𑆂𑇅 𑆯𑆤𑆽𑆫𑇀𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇒𑇑𑇆
𑆠𑆤𑇀𑆠𑆶𑆧𑆢𑇀𑆣𑆩𑆴𑆮𑆳𑆬𑆳𑆬𑆁 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆁 𑆪𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇅 𑆄𑆬𑆳𑆬𑆩𑆼𑆲𑆴𑆤𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆁 𑆤𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆾𑆥𑆠𑆂𑇆𑇒𑇒𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆢𑆯 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇒𑇓𑇆
𑆇𑆰𑇀𑆟𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑇀𑆰𑆳𑆫𑆑𑆛𑆶𑆑𑆳𑆘𑆵𑆫𑇀𑆟𑆨𑆾𑆘𑆤𑆾𑆥𑆱𑆼𑆮𑆴𑆤𑆱𑇀𑆠𑆡𑆳𑇁𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆠𑆥𑆳𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆳𑆥𑆯𑇀𑆫𑆩 𑆑𑇀𑆫𑆾𑆣𑆮𑆴𑆰𑆩𑆳𑆲𑆳𑆫𑆾𑆥𑆱𑆼𑆮𑆴𑆤𑆯𑇀𑆖 𑆠𑆡𑆳𑆮𑆴𑆣𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆽𑆮 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆠𑇀𑆠𑆶 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆁 𑆠𑆪𑆽𑆮𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆳 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑆴𑆩𑆳𑆤𑇀 𑆰𑆛𑇀 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆠𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴𑇆𑇒𑇔𑇆
𑆠𑆼𑆰𑆳𑆩𑆥𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆟𑆮𑆴𑆯𑆼𑆰𑆼𑆟𑆽𑆮 𑆤𑆳𑆩𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑇀𑆰𑆳𑆫𑆩𑆼𑆲𑆯𑇀𑆖, 𑆑𑆳𑆬𑆩𑆼𑆲𑆯𑇀𑆖, 𑆤𑆵𑆬𑆩𑆼𑆲𑆯𑇀𑆖, 𑆬𑆾𑆲𑆴𑆠𑆩𑆼𑆲𑆯𑇀𑆖, 𑆩𑆳𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆩𑆼𑆲𑆯𑇀𑆖, 𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇒𑇕𑇆
𑆠𑆼 𑆰𑆝𑇀𑆨𑆴𑆫𑆼𑆮 𑆑𑇀𑆰𑆳𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆑𑆮𑆴𑆱𑇀𑆫𑆾𑆰𑇀𑆟𑆽𑆂 𑆥𑆴𑆠𑇀𑆠𑆓𑆶𑆟𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇒𑇖𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮 𑆠𑆼 𑆪𑆳𑆥𑇀𑆪𑆳𑆂 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆢𑆾𑆰𑆩𑆼𑆢𑆂𑆱𑇀𑆡𑆳𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇒𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆩𑆼𑆲𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴-𑇆𑇒𑇘𑇆
𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆱𑇀𑆥𑆫𑇀𑆯𑆽𑆫𑇀𑆪𑆡𑆳 𑆑𑇀𑆰𑆳𑆫𑆱𑇀𑆠𑆡𑆳𑆮𑆴𑆣𑆩𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆑𑆾𑆥𑆳𑆤𑇀𑆤𑆫𑆾 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆳𑆫𑆩𑆼𑆲𑆵 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇆𑇒𑇙𑇆
𑆩𑆱𑆵𑆮𑆫𑇀𑆟𑆩𑆘𑆱𑇀𑆫𑆁 𑆪𑆾 𑆩𑆷𑆠𑇀𑆫𑆩𑆶𑆰𑇀𑆟𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇅 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆑𑆾𑆥𑆼𑆟 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆳𑆬𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇐𑇆
𑆖𑆳𑆰𑆥𑆑𑇀𑆰𑆤𑆴𑆨𑆁 𑆩𑆷𑆠𑇀𑆫𑆩𑆩𑇀𑆬𑆁 𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆑𑆾𑆥𑆼𑆟 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆤𑆵𑆬𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇑𑇆
𑆮𑆴𑆱𑇀𑆫𑆁 𑆬𑆮𑆟𑆩𑆶𑆰𑇀𑆟𑆁 𑆖 𑆫𑆑𑇀𑆠𑆁 𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆑𑆾𑆥𑆼𑆟 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇒𑇆
𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆾𑆢𑆑𑆱𑆕𑇀𑆑𑆳𑆯𑆁 𑆨𑆸𑆯𑆁 𑆮𑆴𑆱𑇀𑆫𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇅 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆑𑆾𑆥𑆳𑆠𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇓𑇆
𑆲𑆫𑆴𑆢𑇀𑆫𑆾𑆢𑆑𑆱𑆕𑇀𑆑𑆳𑆯𑆁 𑆑𑆛𑆶𑆑𑆁 𑆪𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆠𑆴𑇅 𑆥𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆥𑆫𑆴𑆑𑆾𑆥𑆳𑆠𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆣𑆳𑆫𑆴𑆢𑇀𑆫𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇓𑇔𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆰𑆛𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇓𑇕𑇆
𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆯𑆵𑆠𑆮𑇀𑆪𑆮𑆳𑆪𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤-𑆯𑆴𑆫𑆾𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆠𑆴𑆪𑆾𑆓𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆤𑆯𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆳𑆠𑆥𑆾𑆢𑇀𑆮𑆼𑆓𑆯𑆾𑆑𑆯𑆾𑆟𑆴𑆠𑆳𑆠𑆴𑆰𑆼𑆑- 𑆘𑆳𑆓𑆫𑆟𑆮𑆴𑆰𑆩𑆯𑆫𑆵𑆫𑆤𑇀𑆪𑆳𑆱𑆳𑆤𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆠𑆡𑆳𑆮𑆴𑆣𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆽𑆮 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇓𑇖𑇆
𑆱 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆠𑆡𑆳𑆮𑆴𑆣𑆼 𑆯𑆫𑆵𑆫𑆼 𑆮𑆴𑆱𑆫𑇀𑆥𑆤𑇀 𑆪𑆢𑆳 𑆮𑆱𑆳𑆩𑆳𑆢𑆳𑆪 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆠𑆼 𑆠𑆢𑆳 𑆮𑆱𑆳𑆩𑆼𑆲𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆥𑆶𑆤𑆫𑇀𑆩𑆘𑇀𑆘𑆳𑆤𑆁 𑆩𑆷𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆳𑆮𑆳𑆑𑆫𑇀𑆰𑆠𑆴 𑆠𑆢𑆳 𑆩𑆘𑇀𑆘𑆩𑆼𑆲𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴; 𑆪𑆢𑆳 𑆠𑆶 𑆬𑆱𑆵𑆑𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆼𑇁𑆨𑆴𑆮𑆲𑆤𑇀𑆩𑆷𑆠𑇀𑆫𑆩𑆤𑆶𑆧𑆤𑇀𑆣𑆁 𑆖𑇀𑆪𑆾𑆠𑆪𑆠𑆴 𑆬𑆱𑆵𑆑𑆳𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆟𑆳𑆖𑇀𑆖 𑆮𑆳𑆪𑆾𑆂 𑆒𑆬𑇀𑆮𑆱𑇀𑆪𑆳𑆠𑆴𑆩𑆷𑆠𑇀𑆫𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑆕𑇀𑆓𑆁 𑆑𑆫𑆾𑆠𑆴, 𑆠𑆢𑆳 𑆱 𑆩𑆠𑇀𑆠 𑆅𑆮 𑆓𑆘𑆂 𑆑𑇀𑆰𑆫𑆠𑇀𑆪𑆘𑆱𑇀𑆫𑆁 𑆩𑆷𑆠𑇀𑆫𑆩𑆮𑆼𑆓𑆁, 𑆠𑆁 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼; 𑆏𑆘𑆂 𑆥𑆶𑆤𑆫𑇀𑆩𑆣𑆶𑆫𑆱𑇀𑆮𑆨𑆳𑆮𑆁, 𑆠𑆢𑇀 𑆪𑆢𑆳 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆂 𑆑𑆰𑆳𑆪𑆠𑇀𑆮𑆼𑆤𑆳𑆨𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆳𑆯𑆪𑆼𑇁𑆨𑆴𑆮𑆲𑆠𑆴 𑆠𑆢𑆳 𑆩𑆣𑆶𑆩𑆼𑆲𑆁 𑆑𑆫𑆾𑆠𑆴𑇆𑇓𑇗𑇆
𑆅𑆩𑆳𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀 𑆮𑆳𑆠𑆘𑆳𑆤𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆨𑆴𑆰𑆘𑆂, 𑆩𑆲𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇓𑇘𑇆
𑆠𑆼𑆰𑆳𑆩𑆥𑆴 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑇀𑆓𑆶𑆟𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆤𑆳𑆩𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆱𑆳𑆩𑆼𑆲𑆯𑇀𑆖, 𑆩𑆘𑇀𑆘𑆩𑆼𑆲𑆯𑇀𑆖, 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆯𑇀𑆖, 𑆩𑆣𑆶𑆩𑆼𑆲𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇓𑇙𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳 𑆮𑆳𑆠𑆥𑇀𑆫𑆩𑆼𑆲𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆳 𑆨𑆮𑆤𑇀𑆠𑆴-𑇆𑇔𑇐𑇆
𑆮𑆱𑆳𑆩𑆴𑆯𑇀𑆫𑆁 𑆮𑆱𑆳𑆨𑆁 𑆮𑆳 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆮𑆱𑆳𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆳𑆠𑆑𑆾𑆥𑆠𑆂𑇆𑇔𑇑𑇆
𑆩𑆘𑇀𑆘𑆳𑆤𑆁 𑆱𑆲 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆩𑆶𑆲𑆶𑆫𑇀𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆩𑆘𑇀𑆘𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆳𑆠𑆑𑆾𑆥𑆠𑆂𑇆𑇔𑇒𑇆
𑆲𑆱𑇀𑆠𑆵 𑆩𑆠𑇀𑆠 𑆅𑆮𑆳𑆘𑆱𑇀𑆫𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆑𑇀𑆰𑆫𑆠𑆴 𑆪𑆾 𑆨𑆸𑆯𑆩𑇀𑇅 𑆲𑆱𑇀𑆠𑆴𑆩𑆼𑆲𑆴𑆤𑆩𑆳𑆲𑆶𑆱𑇀𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆳𑆠𑆑𑆾𑆥𑆠𑆂𑇆𑇔𑇓𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆁 𑆥𑆳𑆟𑇀𑆝𑆶 𑆫𑆷𑆑𑇀𑆰𑆁 𑆩𑆼𑆲𑆠𑆴 𑆪𑆾 𑆤𑆫𑆂𑇅 𑆮𑆳𑆠𑆑𑆾𑆥𑆳𑆢𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆁 𑆥𑇀𑆫𑆠𑆵𑆪𑆳𑆤𑇀𑆩𑆣𑆶𑆩𑆼𑆲𑆴𑆤𑆩𑇀𑇆𑇔𑇔𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆼 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇕𑇆
𑆍𑆮𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆮𑆴𑆁𑆯𑆠𑆴𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇖𑇆
𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆴𑆰𑇀𑆪𑆤𑇀𑆠 𑆅𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆢𑆫𑇀𑆯𑆪𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑆛𑆴𑆬𑆵𑆨𑆳𑆮𑆁 𑆑𑆼𑆯𑆼𑆰𑆶, 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆳𑆱𑇀𑆪𑆱𑇀𑆪, 𑆑𑆫𑆥𑆳𑆢𑆪𑆾𑆂 𑆱𑆶𑆥𑇀𑆠𑆠𑆳𑆢𑆳𑆲𑆿, 𑆩𑆶𑆒𑆠𑆳𑆬𑆶𑆑𑆟𑇀𑆜𑆯𑆾𑆰𑆁, 𑆥𑆴𑆥𑆳𑆱𑆳𑆩𑇀, 𑆄𑆬𑆱𑇀𑆪𑆁, 𑆩𑆬𑆁 𑆑𑆳𑆪𑆼, 𑆑𑆳𑆪𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆼𑆰𑆷𑆥𑆢𑆼𑆲𑆁, 𑆥𑆫𑆴𑆢𑆳𑆲𑆁 𑆱𑆶𑆥𑇀𑆠𑆠𑆳𑆁 𑆖𑆳𑆕𑇀𑆓𑆼𑆰𑆶, 𑆰𑆛𑇀𑆥𑆢𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆨𑆴𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆩𑆷𑆠𑇀𑆫𑆳𑆨𑆴𑆱𑆫𑆟𑆁, 𑆩𑆷𑆠𑇀𑆫𑆼 𑆖 𑆩𑆷𑆠𑇀𑆫𑆢𑆾𑆰𑆳𑆤𑇀, 𑆮𑆴𑆱𑇀𑆫𑆁 𑆯𑆫𑆵𑆫𑆓𑆤𑇀𑆣𑆁, 𑆤𑆴𑆢𑇀𑆫𑆳𑆁, 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆩𑆴𑆠𑆴𑇆𑇔𑇗𑇆
𑆇𑆥𑆢𑇀𑆫𑆮𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆥𑇀𑆫𑆩𑆼𑆲𑆴𑆟𑆳𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆠𑆵𑆱𑆳𑆫𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆂 𑆥𑆷𑆠𑆴𑆩𑆳𑆁𑆱𑆥𑆴𑆝𑆑𑆳𑆬𑆘𑆵𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆳𑆢𑆪𑆯𑇀𑆖 𑆠𑆠𑇀𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆢𑇀𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆸𑆣𑇀𑆤𑆶𑆩𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆼𑆰𑆶 𑆱𑇀𑆤𑆳𑆤𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆢𑇀𑆮𑆴𑆰𑆩𑇀𑇅 𑆥𑇀𑆫𑆩𑆼𑆲𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆨𑇀𑆪𑆼𑆠𑆴 𑆤𑆵𑆝𑆢𑇀𑆫𑆶𑆩𑆩𑆴𑆮𑆳𑆟𑇀𑆝𑆘𑆂𑇆𑇕𑇐𑇆
𑆩𑆤𑇀𑆢𑆾𑆠𑇀𑆱𑆳𑆲𑆩𑆠𑆴𑆱𑇀𑆡𑆷𑆬𑆩𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆩𑆲𑆳𑆯𑆤𑆩𑇀𑇅 𑆩𑆸𑆠𑇀𑆪𑆶𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆫𑆷𑆥𑆼𑆟 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆳𑆢𑆳𑆪 𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇕𑇑𑇆
𑆪𑆱𑇀𑆠𑇀𑆮𑆳𑆲𑆳𑆫𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆑𑆫𑆁 𑆤𑆫𑆂𑇅 𑆱𑆼𑆮𑆠𑆼 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆳𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳𑆂 𑆱 𑆱𑆶𑆒𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇕𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆟𑆳𑆁 𑆖 𑆑𑆳𑆫𑆟𑆩𑇀𑇅 𑆢𑆾𑆰𑆣𑆳𑆠𑆶𑆱𑆩𑆳𑆪𑆾𑆓𑆾 𑆫𑆷𑆥𑆁 𑆮𑆴𑆮𑆴𑆣𑆩𑆼𑆮 𑆖𑇆𑇕𑇓𑇆
𑆢𑆯 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆸𑆠𑆳 𑆪𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆂 𑆰𑆛𑇀 𑆖 𑆥𑆴𑆠𑇀𑆠𑆘𑆳𑆂𑇅 𑆪𑆡𑆳 𑆖 𑆮𑆳𑆪𑆶𑆯𑇀𑆖𑆠𑆶𑆫𑆂 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆤𑇀 𑆑𑆶𑆫𑆶𑆠𑆼 𑆧𑆬𑆵𑇆𑇕𑇔𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆯𑇀𑆖 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂𑇅 𑆥𑇀𑆫𑆩𑆼𑆲𑆳𑆟𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆷𑆠𑇀𑆫𑆁 𑆖 𑆨𑆳𑆰𑆴𑆠𑆩𑇀𑇆𑇕𑇕𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆶𑆰𑇀𑆜𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆱𑆥𑇀𑆠 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆤𑇀𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆮𑆴𑆑𑆸𑆠𑆳𑆂, 𑆢𑆷𑆰𑇀𑆪𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆮𑆱𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆬𑆱𑆵𑆑𑆳𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆣𑆳 𑆢𑆾𑆰𑆾𑆥𑆔𑆳𑆠𑆮𑆴𑆑𑆸𑆠𑆳 𑆅𑆠𑆴𑇅 𑆍𑆠𑆠𑇀 𑆱𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆱𑆥𑇀𑆠𑆣𑆳𑆠𑆶𑆑𑆩𑆼𑆮𑆕𑇀𑆓𑆠𑆩𑆳𑆘𑆤𑆤𑆁 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆩𑇀, 𑆃𑆠𑆂𑆥𑇀𑆫𑆨𑆮𑆳𑆟𑇀𑆪𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆳𑆤𑆴 𑆑𑆼𑆮𑆬𑆁 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆠𑆥𑆤𑇀𑆠𑆴𑇆𑇓𑇆
𑆤 𑆖 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆱𑇀𑆠𑆴 𑆑𑆶𑆰𑇀𑆜𑆩𑆼𑆑𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑇀, 𑆃𑆱𑇀𑆠𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆱𑆩𑆳𑆤𑆥𑇀𑆫𑆑𑆸𑆠𑆵𑆤𑆳𑆩𑆥𑆴 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁 𑆢𑆾𑆰𑆳𑆁𑆯𑆳𑆁𑆯𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆨𑆳𑆓𑆼𑆤 𑆮𑆼𑆢𑆤𑆳𑆮𑆫𑇀𑆟𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆨𑆳𑆮𑆤𑆳𑆩𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆮𑆴𑆯𑆼𑆰𑆂𑇅 𑆱 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆾𑇁𑆰𑇀𑆛𑆳𑆢𑆯𑆮𑆴𑆣𑆾𑇁𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆮𑆴𑆣𑆾 𑆮𑆳 𑆨𑆮𑆠𑆴𑇅 𑆢𑆾𑆰𑆳 𑆲𑆴 𑆮𑆴𑆑𑆬𑇀𑆥𑆤𑆽𑆫𑇀𑆮𑆴𑆑𑆬𑇀𑆥𑇀𑆪𑆩𑆳𑆤𑆳 𑆮𑆴𑆑𑆬𑇀𑆥𑆪𑆤𑇀𑆠𑆴 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑇀, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫𑆳𑆱𑆳𑆣𑇀𑆪𑆨𑆳𑆮𑆳𑆠𑇀𑇅 𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆑𑆳𑆫𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆤𑆼𑇁𑆠𑆴𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆩𑆼𑆮 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆯𑆼𑆰𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇔𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆩𑆥𑆴 𑆲𑇀𑆪𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆩𑆳𑆟𑆳𑆤𑆳𑆁 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆬𑆱𑆵𑆑𑆳𑆑𑆾𑆡𑆑𑇀𑆬𑆼𑆢𑆱𑆁𑆱𑇀𑆮𑆼𑆢𑆘𑆳𑆂 𑆑𑇀𑆫𑆴𑆩𑆪𑆾𑇁𑆨𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆤𑇀𑆠𑆴; 𑆠𑆼 𑆨𑆑𑇀𑆰𑆪𑆤𑇀𑆠𑆱𑇀𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆤𑇀 𑆢𑆾𑆰𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆢𑆷𑆰𑆪𑆤𑇀𑆠 𑆅𑆩𑆳𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆤𑇀 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴- 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆂 𑆯𑇀𑆪𑆳𑆮𑆳𑆫𑆶𑆟𑆮𑆫𑇀𑆟𑆁 𑆥𑆫𑆶𑆰𑆠𑆳𑆩𑆥𑆴 𑆖 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆯𑆷𑆬𑆯𑆾𑆰𑆠𑆾𑆢𑆮𑆼𑆥𑆡𑆶𑆲𑆫𑇀𑆰𑆱𑆕𑇀𑆑𑆾𑆖𑆳𑆪𑆳𑆱𑆱𑇀𑆠𑆩𑇀𑆨𑆱𑆶𑆥𑇀𑆠𑆴𑆨𑆼𑆢𑆨𑆕𑇀𑆓𑆳𑆤𑇀, 𑆥𑆴𑆠𑇀𑆠𑆁 𑆢𑆳𑆲𑆱𑇀𑆮𑆼𑆢𑆑𑇀𑆬𑆼𑆢𑆑𑆾𑆡𑆱𑇀𑆫𑆳𑆮𑆥𑆳𑆑𑆫𑆳𑆓𑆳𑆤𑇀, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑇀𑆮𑆱𑇀𑆪 𑆯𑇀𑆮𑆽𑆠𑇀𑆪𑆯𑆽𑆠𑇀𑆪𑆑𑆟𑇀𑆝𑆷𑆱𑇀𑆡𑆽𑆫𑇀𑆪𑆓𑆿𑆫𑆮𑆾𑆠𑇀𑆱𑆼𑆣𑆾𑆥𑆱𑇀𑆤𑆼𑆲𑆾𑆥𑆬𑆼𑆥𑆳𑆤𑇀, 𑆑𑇀𑆫𑆴𑆩𑆪𑆱𑇀𑆠𑆶 𑆠𑇀𑆮𑆓𑆳𑆢𑆵𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆂 𑆱𑆴𑆫𑆳𑆂 𑆱𑇀𑆤𑆳𑆪𑆷𑆯𑇀𑆖𑆳𑆱𑇀𑆡𑆵𑆤𑇀𑆪𑆥𑆴 𑆖 𑆠𑆫𑆶𑆟𑆳𑆤𑇀𑆪𑆳𑆢𑆢𑆠𑆼 𑇆𑇑𑇐𑇆
𑆃𑆱𑇀𑆪𑆳𑆁 𑆖𑆽𑆮𑆳𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆂 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆁 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆟𑆩𑆕𑇀𑆓𑆨𑆼𑆢𑆂 𑆥𑆠𑆤𑆳𑆤𑇀𑆪𑆕𑇀𑆓𑆳𑆮𑆪𑆮𑆳𑆤𑆳𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆢𑆳𑆲𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆯𑇀𑆖, 𑆠𑆡𑆳𑆮𑆴𑆣𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇑𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆪𑆩𑆴𑆠𑆴 𑆪𑆂 𑆥𑆷𑆫𑇀𑆮𑆁 𑆤𑆫𑆾 𑆫𑆾𑆓𑆩𑆶𑆥𑆼𑆑𑇀𑆰𑆠𑆼𑇅 𑆱 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆑𑆳𑆬𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆩𑆸𑆠 𑆍𑆮𑆳𑆮𑆧𑆶𑆣𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇆
𑆪𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆳𑆓𑆼𑆮 𑆫𑆾𑆓𑆼𑆨𑇀𑆪𑆾 𑆫𑆾𑆓𑆼𑆰𑆶 𑆠𑆫𑆶𑆟𑆼𑆰𑆶 𑆮𑆳𑇅 𑆨𑆼𑆰𑆘𑆁 𑆑𑆶𑆫𑆶𑆠𑆼 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱 𑆖𑆴𑆫𑆁 𑆱𑆶𑆒𑆩𑆯𑇀𑆤𑆶𑆠𑆼𑇆𑇑𑇓𑇆
𑆪𑆡𑆳 𑆲𑇀𑆪𑆬𑇀𑆥𑆼𑆤 𑆪𑆠𑇀𑆤𑆼𑆤 𑆗𑆴𑆢𑇀𑆪𑆠𑆼 𑆠𑆫𑆶𑆟𑆱𑇀𑆠𑆫𑆶𑆂𑇅 𑆱 𑆍𑆮𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆠𑆶 𑆗𑆴𑆢𑇀𑆪𑆠𑆼𑇁𑆠𑆴𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆠𑆂𑇆𑇑𑇔𑇆
𑆍𑆮𑆩𑆼𑆮 𑆮𑆴𑆑𑆳𑆫𑆾𑇁𑆥𑆴 𑆠𑆫𑆶𑆟𑆂 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆱𑆶𑆒𑆩𑇀𑇅 𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆂 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆢𑆱𑆳𑆣𑇀𑆪𑆾 𑆮𑆳𑇁𑆥𑆴 𑆘𑆳𑆪𑆠𑆼𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑆾𑆰𑆳𑆯𑇀𑆖 𑆲𑆼𑆠𑆮𑆂 𑆥𑆷𑆫𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳𑆂 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁 𑆑𑆿𑆰𑇀𑆜𑆴𑆑𑆼 𑆥𑆸𑆡𑆑𑇀𑇆𑇑𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆯𑆾𑆰𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆖𑆠𑇀𑆮𑆳𑆫𑆴 𑆯𑆾𑆰𑆱𑇀𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆳𑆲𑆱𑆁 𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆁 𑆑𑇀𑆰𑆪𑆾 𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆩𑆴𑆠𑆴𑇆𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆲𑆳𑆫𑆱𑇀𑆪 𑆥𑆫𑆁 𑆣𑆳𑆩 𑆯𑆶𑆑𑇀𑆫𑆁 𑆠𑆢𑇀𑆫𑆑𑇀𑆰𑇀𑆪𑆩𑆳𑆠𑇀𑆩𑆤𑆂𑇅 𑆑𑇀𑆰𑆪𑆾 𑆲𑇀𑆪𑆱𑇀𑆪 𑆧𑆲𑆷𑆤𑇀 𑆫𑆾𑆓𑆳𑆤𑇀𑆩𑆫𑆟𑆁 𑆮𑆳 𑆤𑆴𑆪𑆖𑇀𑆗𑆠𑆴𑇆𑇙𑇆
𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆁 𑆯𑆾𑆰𑆱𑇀𑆪𑆳𑆪𑆠𑆤𑆩𑆴𑆠𑆴 𑆪𑆢𑆶𑆑𑇀𑆠𑆁, 𑆠𑆢𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆪𑆢𑆳 𑆥𑆶𑆫𑆶𑆰𑆂 𑆥𑆳𑆤𑆳𑆯𑆤𑆨𑆑𑇀𑆰𑇀𑆪𑆬𑆼𑆲𑇀𑆪𑆾𑆥𑆪𑆾𑆓𑆳𑆤𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆑𑆫𑆟𑆱𑆁𑆪𑆾𑆓𑆫𑆳𑆯𑆴𑆢𑆼𑆯𑆑𑆳𑆬𑆾𑆥𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆡𑆾𑆥𑆯𑆪𑆮𑆴𑆰𑆩𑆳𑆤𑆳𑆱𑆼𑆮𑆠𑆼, 𑆠𑆢𑆳 𑆠𑆱𑇀𑆪 𑆠𑆼𑆨𑇀𑆪𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼; 𑆠𑆼 𑆮𑆴𑆰𑆩𑆳𑆂 𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆱𑆸𑆠𑇀𑆪 𑆪𑆢𑆳 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆪𑆤𑆩𑆶𑆒𑆳𑆤𑆴 𑆥𑇀𑆫𑆠𑆴𑆮𑆳𑆫𑇀𑆪𑆳𑆮𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼 𑆠𑆢𑆳 𑆘𑆤𑇀𑆠𑆶𑆫𑇀𑆪𑆢𑇀𑆪𑆢𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆩𑆳𑆲𑆫𑆠𑆴 𑆠𑆠𑇀𑆠𑆢𑆱𑇀𑆪 𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆩𑆼𑆮𑆾𑆥𑆘𑆳𑆪𑆠𑆼 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆤𑆳𑆤𑇀𑆪𑆱𑇀𑆠𑆡𑆳 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆶𑆂; 𑆱 𑆥𑆶𑆫𑆵𑆰𑆾𑆥𑆰𑇀𑆛𑆩𑇀𑆨𑆳𑆢𑇀𑆮𑆫𑇀𑆠𑆪𑆠𑆴, 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆶𑆰𑇀𑆪𑆠𑆾 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆥𑆶𑆫𑆵𑆰𑆩𑆤𑆶𑆫𑆑𑇀𑆰𑇀𑆪𑆁 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆩𑆠𑆴𑆑𑆸𑆯𑆢𑆶𑆫𑇀𑆧𑆬𑆳𑆤𑆳𑆁; 𑆠𑆱𑇀𑆪𑆳𑆤𑆳𑆥𑇀𑆪𑆳𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆾𑆥𑆖𑆴𑆠𑆳 𑆢𑆾𑆰𑆳𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆫𑇀𑆪𑆶𑆚𑇀𑆘𑆤𑇀𑆠𑆾 𑆨𑆷𑆪𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆯𑆾𑆰𑆪𑆤𑇀𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆂 𑆯𑆷𑆬𑆩𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆁 𑆑𑆟𑇀𑆜𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑆁 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆁𑆫𑆶𑆘𑆤𑆩𑆁𑆱𑆳𑆮𑆩𑆫𑇀𑆢𑆁 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆁 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆁 𑆖𑆾𑆥𑆘𑆤𑆪𑆠𑆴; 𑆥𑆴𑆠𑇀𑆠𑆁 𑆘𑇀𑆮𑆫𑆩𑆠𑆵𑆱𑆳𑆫𑆩𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆁 𑆖; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑆶 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆁 𑆯𑆴𑆫𑆱𑆾 𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆩𑆫𑆾𑆖𑆑𑆁 𑆑𑆳𑆱𑆁 𑆖, 𑆱 𑆑𑆳𑆱𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆳𑆢𑆶𑆫𑆱𑆴 𑆑𑇀𑆰𑆠𑆼 𑆯𑆾𑆟𑆴𑆠𑆁 𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆠𑆴, 𑆯𑆾𑆟𑆴𑆠𑆓𑆩𑆤𑆳𑆖𑇀𑆖𑆳𑆱𑇀𑆪 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆍𑆮𑆩𑆼𑆠𑆼 𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆾𑆥𑆖𑆴𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆢𑆾𑆰𑆳 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆪𑆳𑆟𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴𑇅 𑆱 𑆠𑆽𑆫𑆶𑆥𑆯𑆾𑆰𑆟𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆯𑆤𑆽𑆂 𑆯𑆤𑆽𑆂 𑆯𑆶𑆰𑇀𑆪𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆶𑆫𑆶𑆰𑆾 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆑𑆫𑆟𑆱𑆁𑆪𑆾𑆓𑆫𑆳𑆯𑆴𑆢𑆼𑆯𑆑𑆳𑆬𑆾𑆥𑆪𑆾𑆓𑆱𑆁𑆱𑇀𑆡𑆾𑆥𑆯𑆪𑆳𑆢𑆮𑆴𑆰𑆩𑆩𑆳𑆲𑆳𑆫𑆩𑆳𑆲𑆫𑆼𑆠𑇀𑇆𑇑𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆲𑆴𑆠𑆳𑆯𑆵 𑆱𑇀𑆪𑆳𑆤𑇀𑆩𑆴𑆠𑆳𑆯𑆵 𑆱𑇀𑆪𑆳𑆠𑇀𑆑𑆳𑆬𑆨𑆾𑆘𑆵 𑆘𑆴𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇅 𑆥𑆯𑇀𑆪𑆤𑇀 𑆫𑆾𑆓𑆳𑆤𑇀 𑆧𑆲𑆷𑆤𑇀 𑆑𑆰𑇀𑆛𑆳𑆤𑇀 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆍𑆠𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑆴𑆂 𑆯𑆾𑆰𑆱𑇀𑆪𑆳𑆪𑆠𑆤𑆽𑆫𑆶𑆥𑆱𑆼𑆮𑆴𑆠𑆽𑆫𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼𑇅 𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆽𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆯𑆾𑆰𑆪𑆤𑇀𑆠𑆴𑇅 𑆠𑆁 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆳𑆟𑆳𑆁 𑆑𑆰𑇀𑆛𑆠𑆩𑆠𑇀𑆮𑆳𑆢𑇀𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆨𑆴𑆰𑆘𑆂; 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆳 𑆥𑆷𑆫𑇀𑆮𑆩𑆳𑆱𑆵𑆢𑇀𑆨𑆓𑆮𑆠𑆂 𑆱𑆾𑆩𑆱𑇀𑆪𑆾𑆝𑆶𑆫𑆳𑆘𑆱𑇀𑆪 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆼𑆠𑆴𑇆𑇑𑇒𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆂, 𑆑𑇀𑆰𑆮𑆡𑆶𑆫𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆱𑆼𑆑𑆂, 𑆩𑆶𑆒𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑇀, 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆃𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑆖𑆳𑆪𑆳𑆱𑆂, 𑆢𑆾𑆰𑆢𑆫𑇀𑆯𑆤𑆩𑆢𑆾𑆰𑆼𑆰𑇀𑆮𑆬𑇀𑆥𑆢𑆾𑆰𑆼𑆰𑆶 𑆮𑆳 𑆨𑆳𑆮𑆼𑆰𑆶 𑆥𑆳𑆠𑇀𑆫𑆾𑆢𑆑𑆳𑆤𑇀𑆤𑆱𑆷𑆥𑆳𑆥𑆷𑆥𑆾𑆥𑆢𑆁𑆯𑆥𑆫𑆴𑆮𑆼𑆯𑆑𑆼𑆰𑆶, 𑆨𑆶𑆑𑇀𑆠𑆮𑆠𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆲𑆸𑆬𑇀𑆬𑆳𑆱𑆂, 𑆠𑆡𑆾𑆬𑇀𑆬𑆼𑆒𑆤𑆩𑆥𑇀𑆪𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑆳𑆤𑇀𑆠𑆫𑆳, 𑆩𑆶𑆒𑆱𑇀𑆪 𑆥𑆳𑆢𑆪𑆾𑆯𑇀𑆖 𑆯𑆾𑆦𑆂 , 𑆥𑆳𑆟𑇀𑆪𑆾𑆯𑇀𑆖𑆳𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑇀, 𑆃𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆯𑇀𑆮𑆼𑆠𑆳𑆮𑆨𑆳𑆱𑆠𑆳 𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁, 𑆧𑆳𑆲𑇀𑆮𑆾𑆯𑇀𑆖 𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆳, 𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆳𑆩𑆠𑆳, 𑆤𑆴𑆫𑇀𑆔𑆸𑆟𑆴𑆠𑇀𑆮𑆁, 𑆧𑆵𑆨𑆠𑇀𑆱𑆢𑆫𑇀𑆯𑆤𑆠𑆳 𑆖𑆳𑆱𑇀𑆪 𑆑𑆳𑆪𑆼, 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑆫𑇀𑆯𑆤𑆩𑆤𑆶𑆢𑆑𑆳𑆤𑆳𑆩𑆶𑆢𑆑𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆳𑆁 𑆯𑆷𑆤𑇀𑆪𑆳𑆤𑆳𑆁 𑆖 𑆓𑇀𑆫𑆳𑆩𑆤𑆓𑆫𑆤𑆴𑆓𑆩𑆘𑆤𑆥𑆢𑆳𑆤𑆳𑆁 𑆯𑆶𑆰𑇀𑆑𑆢𑆓𑇀𑆣𑆨𑆓𑇀𑆤𑆳𑆤𑆳𑆁 𑆖 𑆮𑆤𑆳𑆤𑆳𑆁 𑆑𑆸𑆑𑆬𑆳𑆱𑆩𑆪𑆷𑆫𑆮𑆳𑆤𑆫𑆯𑆶𑆑𑆱𑆫𑇀𑆥𑆑𑆳𑆑𑆾𑆬𑆷𑆑𑆳𑆢𑆴𑆨𑆴𑆂 𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆩𑆣𑆴𑆫𑆾𑆲𑆟𑆁 𑆪𑆳𑆤𑆁 𑆮𑆳 𑆯𑇀𑆮𑆾𑆰𑇀𑆛𑇀𑆫𑆒𑆫𑆮𑆫𑆳𑆲𑆽𑆂 𑆑𑆼𑆯𑆳𑆱𑇀𑆡𑆴𑆨𑆱𑇀𑆩𑆠𑆶𑆰𑆳𑆕𑇀𑆓𑆳𑆫𑆫𑆳𑆯𑆵𑆤𑆳𑆁 𑆖𑆳𑆣𑆴𑆫𑆾𑆲𑆟𑆩𑆴𑆠𑆴 (𑆯𑆾𑆰𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴)𑇆𑇑𑇓𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆩𑆼𑆑𑆳𑆢𑆯𑆫𑆷𑆥𑆳𑆟𑆴 𑆠𑆱𑇀𑆪 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆴𑆫𑆱𑆂 𑆥𑆫𑆴𑆥𑆷𑆫𑇀𑆟𑆠𑇀𑆮𑆁, 𑆑𑆳𑆱𑆂, 𑆯𑇀𑆮𑆳𑆱𑆂, 𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆂, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆯𑇀𑆗𑆫𑇀𑆢𑆤𑆁, 𑆯𑆾𑆟𑆴𑆠𑆰𑇀𑆜𑆵𑆮𑆤𑆁, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆱𑆁𑆫𑆾𑆘𑆤𑆩𑇀, 𑆃𑆁𑆱𑆳𑆮𑆩𑆫𑇀𑆢𑆂, 𑆘𑇀𑆮𑆫𑆂, 𑆃𑆠𑆵𑆱𑆳𑆫𑆂, 𑆃𑆫𑆾𑆖𑆑𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑆫𑆴𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆾 𑆧𑆬𑆮𑆳𑆤𑆘𑆳𑆠𑆳𑆫𑆴𑆰𑇀𑆛𑆂 𑆱𑆫𑇀𑆮𑆽𑆫𑆥𑆴 𑆯𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆶𑆥𑆢𑇀𑆫𑆶𑆠𑆂 𑆱𑆳𑆣𑇀𑆪𑆾 𑆘𑇀𑆚𑆼𑆪𑆂𑇅 𑆧𑆬𑆮𑆳𑆤𑆶𑆥𑆖𑆴𑆠𑆾 𑆲𑆴 𑆱𑆲𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆿𑆰𑆣𑆧𑆬𑆱𑇀𑆪 𑆑𑆳𑆩𑆁 𑆱𑆶𑆧𑆲𑆶𑆬𑆴𑆕𑇀𑆓𑆾𑇁𑆥𑇀𑆪𑆬𑇀𑆥𑆬𑆴𑆕𑇀𑆓 𑆍𑆮 𑆩𑆤𑇀𑆠𑆮𑇀𑆪𑆂𑇆𑇑𑇕𑇆
𑆢𑆶𑆫𑇀𑆧𑆬𑆁 𑆠𑇀𑆮𑆠𑆴𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆩𑆬𑇀𑆥𑆬𑆴𑆕𑇀𑆓𑆩𑆘𑆳𑆠𑆳𑆫𑆴𑆰𑇀𑆛𑆩𑆥𑆴 𑆧𑆲𑆶𑆬𑆴𑆕𑇀𑆓𑆁 𑆘𑆳𑆠𑆳𑆫𑆴𑆰𑇀𑆛𑆁 𑆖 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆃𑆱𑆲𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆿𑆰𑆣𑆧𑆬𑆱𑇀𑆪; 𑆠𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀, 𑆑𑇀𑆰𑆟𑆼𑆤𑆽𑆮 𑆲𑆴 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑆴, 𑆃𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆯𑇀𑆖𑆳𑆫𑆴𑆰𑇀𑆛𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮 𑆅𑆠𑆴𑇆𑇑𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆁 𑆖 𑆬𑆴𑆕𑇀𑆓𑆁 𑆖 𑆪𑆂 𑆯𑆾𑆰𑆱𑇀𑆪𑆳𑆮𑆧𑆶𑆣𑇀𑆪𑆠𑆼𑇅 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆖 𑆠𑆠𑇀𑆠𑇀𑆮𑆼𑆤 𑆱 𑆫𑆳𑆘𑇀𑆚𑆂 𑆑𑆫𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴𑇆𑇑𑇗𑇆
𑆃𑆡𑆳𑆠 𑆇𑆤𑇀𑆩𑆳𑆢𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆥𑆚𑇀𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆳𑆓𑆤𑇀𑆠𑆶𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆯𑇀𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆨𑆵𑆫𑆷𑆟𑆳𑆩𑆶𑆥𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆳𑆩𑆶𑆠𑇀𑆱𑆤𑇀𑆤𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆩𑆬𑆮𑆴𑆑𑆸𑆠𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆤𑆶𑆖𑆴𑆠𑆳𑆤𑇀𑆪𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆳𑆤𑆴 𑆮𑆽𑆰𑆩𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆼𑆤𑆾𑆥𑆪𑆾𑆓𑆮𑆴𑆣𑆴𑆤𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆳𑆤𑆳𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆩𑆥𑆴 𑆮𑆴𑆰𑆩𑆩𑆳𑆖𑆫𑆠𑆳𑆩𑆤𑇀𑆪𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆖𑆼𑆰𑇀𑆛𑆳 𑆮𑆴𑆰𑆩𑆳𑆂 𑆱𑆩𑆳𑆖𑆫𑆠𑆳𑆩𑆠𑇀𑆪𑆶𑆥𑆑𑇀𑆰𑆵𑆟𑆢𑆼𑆲𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆼𑆓𑆱𑆩𑆶𑆢𑇀𑆨𑇀𑆫𑆩𑆴𑆠𑆳𑆤𑆳𑆩𑆶𑆥𑆲𑆠𑆩𑆤𑆱𑆳𑆁 𑆮𑆳 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆲𑆫𑇀𑆰𑆨𑆪𑆩𑆾𑆲𑆳𑆪𑆳𑆱𑆯𑆾𑆑𑆖𑆴𑆤𑇀𑆠𑆾𑆢𑇀𑆮𑆼𑆓𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆨𑆷𑆪𑆾𑇁𑆨𑆴𑆔𑆳𑆠𑆳𑆨𑇀𑆪𑆳𑆲𑆠𑆳𑆤𑆳𑆁 𑆮𑆳 𑆩𑆤𑆱𑇀𑆪𑆶𑆥𑆲𑆠𑆼 𑆧𑆶𑆢𑇀𑆣𑆿 𑆖 𑆥𑇀𑆫𑆖𑆬𑆴𑆠𑆳𑆪𑆳𑆩𑆨𑇀𑆪𑆶𑆢𑆵𑆫𑇀𑆟𑆳 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆲𑆸𑆢𑆪𑆩𑆶𑆥𑆱𑆸𑆠𑇀𑆪 𑆩𑆤𑆾𑆮𑆲𑆳𑆤𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆳𑆮𑆸𑆠𑇀𑆪 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆤𑇀𑆩𑆳𑆢𑆩𑇀𑇆𑇔𑇆
𑆇𑆤𑇀𑆩𑆳𑆢𑆁 𑆥𑆶𑆤𑆫𑇀𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆴𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆘𑇀𑆚𑆳𑆤𑆱𑇀𑆩𑆸𑆠𑆴𑆨𑆑𑇀𑆠𑆴𑆯𑆵𑆬𑆖𑆼𑆰𑇀𑆛𑆳𑆖𑆳𑆫𑆮𑆴𑆨𑇀𑆫𑆩𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇕𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑆴𑆫𑆱𑆂 𑆯𑆷𑆤𑇀𑆪𑆠𑆳, 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆫𑆳𑆑𑆶𑆬𑆠𑆳, 𑆱𑇀𑆮𑆤𑆂 𑆑𑆫𑇀𑆟𑆪𑆾𑆂, 𑆇𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆱𑇀𑆪𑆳𑆣𑆴𑆑𑇀𑆪𑆩𑇀, 𑆄𑆱𑇀𑆪𑆱𑆁𑆱𑇀𑆫𑆮𑆟𑆩𑇀, 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆳𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆳𑆂, 𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆂, 𑆣𑇀𑆪𑆳𑆤𑆳𑆪𑆳𑆱𑆱𑆩𑇀𑆩𑆾𑆲𑆾𑆢𑇀𑆮𑆼𑆓𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆡𑆳𑆤𑆼, 𑆱𑆠𑆠𑆁 𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆂, 𑆘𑇀𑆮𑆫𑆯𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑇀, 𑆇𑆤𑇀𑆩𑆠𑇀𑆠𑆖𑆴𑆠𑇀𑆠𑆠𑇀𑆮𑆩𑇀, 𑆇𑆢𑆫𑇀𑆢𑆴𑆠𑇀𑆮𑆩𑇀 , 𑆃𑆫𑇀𑆢𑆴𑆠𑆳𑆑𑆸𑆠𑆴𑆑𑆫𑆟𑆁 𑆖 𑆮𑇀𑆪𑆳𑆣𑆼𑆂, 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆢𑆫𑇀𑆯𑆤𑆁 𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆖𑆬𑆴𑆠𑆳𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆳𑆁 𑆫𑆷𑆥𑆳𑆟𑆳𑆩𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆖 𑆠𑆴𑆬𑆥𑆵𑆝𑆑𑆖𑆑𑇀𑆫𑆳𑆣𑆴𑆫𑆾𑆲𑆟𑆁 𑆮𑆳𑆠𑆑𑆶𑆟𑇀𑆝𑆬𑆴𑆑𑆳𑆨𑆴𑆯𑇀𑆖𑆾𑆤𑇀𑆩𑆡𑆤𑆁 𑆤𑆴𑆩𑆘𑇀𑆘𑆤𑆁 𑆖 𑆑𑆬𑆶𑆰𑆳𑆟𑆳𑆩𑆩𑇀𑆨𑆱𑆳𑆩𑆳𑆮𑆫𑇀𑆠𑆼 𑆖𑆑𑇀𑆰𑆶𑆰𑆾𑆯𑇀𑆖𑆳𑆥𑆱𑆫𑇀𑆥𑆟𑆩𑆴𑆠𑆴 (𑆢𑆾𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆤𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴)𑇆𑇖𑇆
𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆼𑆮𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆼𑆮𑇅 𑆠𑆠𑇀𑆫𑆼𑆢𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆫𑆴𑆱𑆫𑆟𑆩𑆘𑆱𑇀𑆫𑆩𑇀, 𑆃𑆑𑇀𑆰𑆴𑆨𑇀𑆫𑆶𑆮𑆿𑆰𑇀𑆜𑆳𑆁𑆱𑆲𑆤𑇀𑆮𑆓𑇀𑆫𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆳𑆕𑇀𑆓𑆮𑆴𑆑𑇀𑆰𑆼𑆥𑆟𑆩𑆑𑆱𑇀𑆩𑆳𑆠𑇀 , 𑆱𑆠𑆠𑆩𑆤𑆴𑆪𑆠𑆳𑆤𑆳𑆁 𑆖 𑆓𑆴𑆫𑆳𑆩𑆶𑆠𑇀𑆱𑆫𑇀𑆓𑆂, 𑆦𑆼𑆤𑆳𑆓𑆩𑆤𑆩𑆳𑆱𑇀𑆪𑆳𑆠𑇀, 𑆃𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑇀𑆩𑆴𑆠𑆲𑆱𑆴𑆠𑆤𑆸𑆠𑇀𑆪𑆓𑆵𑆠𑆮𑆳𑆢𑆴𑆠𑇀𑆫𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆡𑆳𑆤𑆼, 𑆮𑆵𑆟𑆳𑆮𑆁𑆯𑆯𑆕𑇀𑆒𑆯𑆩𑇀𑆪𑆳𑆠𑆳𑆬𑆯𑆧𑇀𑆢𑆳𑆤𑆶𑆑𑆫𑆟𑆩𑆱𑆳𑆩𑇀𑆤𑆳, 𑆪𑆳𑆤𑆩𑆪𑆳𑆤𑆽𑆂, 𑆃𑆬𑆕𑇀𑆑𑆫𑆟𑆩𑆤𑆬𑆕𑇀𑆑𑆳𑆫𑆴𑆑𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆂, 𑆬𑆾𑆨𑆯𑇀𑆖𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆼𑆰𑇀𑆮𑆬𑆧𑇀𑆣𑆼𑆰𑆶, 𑆬𑆧𑇀𑆣𑆼𑆰𑆶 𑆖𑆳𑆮𑆩𑆳𑆤𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆩𑆳𑆠𑇀𑆱𑆫𑇀𑆪𑆁 𑆖, 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆁, 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆩𑇀, 𑆇𑆠𑇀𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆳𑆫𑆶𑆟𑆳𑆑𑇀𑆰𑆠𑆳, 𑆮𑆳𑆠𑆾𑆥𑆯𑆪𑆮𑆴𑆥𑆫𑇀𑆪𑆳𑆱𑆳𑆢𑆤𑆶𑆥𑆯𑆪𑆠𑆳 𑆖; 𑆅𑆠𑆴 𑆮𑆳𑆠𑆾𑆤𑇀𑆩𑆳𑆢𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴(𑇑); 𑆃𑆩𑆫𑇀𑆰𑆂, 𑆑𑇀𑆫𑆾𑆣𑆂, 𑆱𑆁𑆫𑆩𑇀𑆨𑆯𑇀𑆖𑆳𑆱𑇀𑆡𑆳𑆤𑆼, 𑆯𑆱𑇀𑆠𑇀𑆫𑆬𑆾𑆰𑇀𑆛𑇀𑆫𑆑𑆯𑆳𑆑𑆳𑆰𑇀𑆜𑆩𑆶𑆰𑇀𑆛𑆴𑆨𑆴𑆫𑆨𑆴𑆲𑆤𑆤𑆁 𑆱𑇀𑆮𑆼𑆰𑆳𑆁 𑆥𑆫𑆼𑆰𑆳𑆁 𑆮𑆳, 𑆃𑆨𑆴𑆢𑇀𑆫𑆮𑆟𑆁, 𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆪𑆯𑆵𑆠𑆾𑆢𑆑𑆳𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆱𑆤𑇀𑆠𑆳𑆥𑆯𑇀𑆖𑆳𑆠𑆴𑆮𑆼𑆬𑆁, 𑆠𑆳𑆩𑇀𑆫𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆱𑆁𑆫𑆧𑇀𑆣𑆳𑆑𑇀𑆰𑆠𑆳, 𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆯𑆪𑆮𑆴𑆥𑆫𑇀𑆪𑆳𑆱𑆳𑆢𑆤𑆶𑆥𑆯𑆪𑆠𑆳 𑆖; 𑆅𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆾𑆤𑇀𑆩𑆳𑆢𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴(𑇒); 𑆱𑇀𑆡𑆳𑆤𑆩𑆼𑆑𑆢𑆼𑆯𑆼, 𑆠𑆷𑆰𑇀𑆟𑆵𑆩𑇀𑆨𑆳𑆮𑆂, 𑆃𑆬𑇀𑆥𑆯𑆯𑇀𑆖𑆕𑇀𑆑𑇀𑆫𑆩𑆟𑆁, 𑆬𑆳𑆬𑆳𑆯𑆴𑆕𑇀𑆔𑆳𑆟𑆑𑆱𑇀𑆫𑆮𑆟𑆩𑇀, 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆂, 𑆫𑆲𑆱𑇀𑆑𑆳𑆩𑆠𑆳, 𑆧𑆵𑆨𑆠𑇀𑆱𑆠𑇀𑆮𑆁, 𑆯𑆿𑆖𑆢𑇀𑆮𑆼𑆰𑆂, 𑆱𑇀𑆮𑆥𑇀𑆤𑆤𑆴𑆠𑇀𑆪𑆠𑆳, 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆳𑆤𑆤𑆼, 𑆯𑆶𑆑𑇀𑆬𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆩𑆬𑆾𑆥𑆢𑆴𑆓𑇀𑆣𑆳𑆑𑇀𑆰𑆠𑇀𑆮𑆁, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆥𑆯𑆪𑆮𑆴𑆥𑆫𑇀𑆪𑆳𑆱𑆳𑆢𑆤𑆶𑆥𑆯𑆪𑆠𑆳 𑆖; 𑆅𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆤𑇀𑆩𑆳𑆢𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴(𑇓); 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆠𑆶 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆴𑆑𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆑𑆶𑆯𑆬𑆳𑆂𑇆𑇗𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑆶 𑆠𑇀𑆫𑆪𑆳𑆟𑆳𑆁 𑆱𑆳𑆣𑆤𑆳𑆤𑆴- 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆾𑆥𑆯𑆩𑆤 𑆤𑆱𑇀𑆠𑆂𑆑𑆫𑇀𑆩𑆣𑆷𑆩𑆣𑆷𑆥𑆤𑆳𑆚𑇀𑆘𑆤𑆳𑆮𑆥𑆵𑆝𑆥𑇀𑆫𑆣𑆩𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆥𑇀𑆫𑆢𑆼𑆲𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆤𑆶𑆬𑆼𑆥𑆤𑆮𑆣𑆧𑆤𑇀𑆣𑆤𑆳𑆮𑆫𑆾𑆣𑆤- 𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆥𑆤𑆮𑆴𑆱𑇀𑆩𑆳𑆫𑆟𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆱𑆴𑆫𑆳𑆮𑇀𑆪𑆣𑆤𑆳𑆤𑆴, 𑆨𑆾𑆘𑆤𑆮𑆴𑆣𑆳𑆤𑆁 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳, 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆤𑇀𑆤𑆴𑆢𑆳𑆤𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆿𑆰𑆣𑆁 𑆑𑆳𑆫𑇀𑆪𑆁 𑆠𑆢𑆥𑆴 𑆱𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆇𑆤𑇀𑆩𑆳𑆢𑆳𑆤𑇀 𑆢𑆾𑆰𑆘𑆳𑆤𑇀 𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑇀 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆓𑆶𑆠𑇀𑆠𑆩𑆂𑇅 𑆃𑆤𑆼𑆤 𑆮𑆴𑆣𑆴𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆑𑆫𑇀𑆩𑆟𑆳 𑆪𑆠𑇀 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀𑇆𑇙𑇆
𑆪𑆱𑇀𑆠𑆶 𑆢𑆾𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆨𑇀𑆪 𑆇𑆤𑇀𑆩𑆳𑆢𑆼𑆨𑇀𑆪𑆂 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆬𑆴𑆕𑇀𑆓𑆮𑆼𑆢𑆤𑆾𑆥𑆯𑆪𑆮𑆴𑆯𑆼𑆰𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆾 𑆨𑆮𑆠𑇀𑆪𑆶𑆤𑇀𑆩𑆳𑆢𑆱𑇀𑆠𑆩𑆳𑆓𑆤𑇀𑆠𑆶𑆑𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇅 𑆑𑆼𑆖𑆴𑆠𑇀 𑆥𑆶𑆤𑆂 𑆥𑆷𑆫𑇀𑆮𑆑𑆸𑆠𑆁 𑆑𑆫𑇀𑆩𑆳𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆠𑆱𑇀𑆪 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖 𑆲𑆼𑆠𑆶𑆂 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣 𑆍𑆮𑆼𑆠𑆴 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇅 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆳𑆢𑇀𑆣𑇀𑆪𑆪𑆁 𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆥𑆴𑆠𑆸𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆪𑆑𑇀𑆰𑆫𑆳𑆑𑇀𑆰𑆱𑆥𑆴𑆯𑆳𑆖𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆖𑆳𑆫𑇀𑆪𑆥𑆷𑆘𑇀𑆪𑆳𑆤𑆮𑆩𑆠𑇀𑆪𑆳𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆳𑆖𑆫𑆠𑆴, 𑆃𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆼𑆮𑆁𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩𑆳𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆩𑆳𑆫𑆨𑆠𑆼; 𑆠𑆩𑆳𑆠𑇀𑆩𑆤𑆳 𑆲𑆠𑆩𑆶𑆥𑆔𑇀𑆤𑆤𑇀𑆠𑆾 𑆢𑆼𑆮𑆳𑆢𑆪𑆂 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆤𑇀𑆩𑆠𑇀𑆠𑆩𑇀𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆢𑆼𑆮𑆳𑆢𑆴𑆥𑇀𑆫𑆑𑆾𑆥𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆤𑆳𑆓𑆤𑇀𑆠𑆶𑆑𑆾𑆤𑇀𑆩𑆳𑆢𑆼𑆤 𑆥𑆶𑆫𑆱𑇀𑆑𑆸𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆢𑆼𑆮𑆓𑆾𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆠𑆥𑆱𑇀𑆮𑆴𑆤𑆳𑆁 𑆲𑆴𑆁𑆱𑆳𑆫𑆶𑆖𑆴𑆠𑇀𑆮𑆁, 𑆑𑆾𑆥𑆤𑆠𑇀𑆮𑆁, 𑆤𑆸𑆯𑆁𑆱𑆳𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆠𑆳, 𑆃𑆫𑆠𑆴𑆂, 𑆏𑆘𑆾𑆮𑆫𑇀𑆟𑆖𑇀𑆗𑆳𑆪𑆳𑆧𑆬𑆮𑆥𑆶𑆰𑆳𑆩𑆶𑆥𑆠𑆥𑇀𑆠𑆴𑆂, 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆖 𑆢𑆼𑆮𑆳𑆢𑆴𑆨𑆴𑆫𑆨𑆴𑆨𑆫𑇀𑆠𑇀𑆱𑆤𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆁 𑆖𑆼𑆠𑆴; 𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂𑇆𑇑𑇑𑇆
𑆠𑆠𑇀𑆫𑆳𑆪𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆪𑆴𑆰𑇀𑆪𑆠𑆳𑆩𑆳𑆫𑆩𑇀𑆨𑆮𑆴𑆯𑆼𑆰𑆾 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆮𑆬𑆾𑆑𑆪𑆤𑇀𑆠𑆾 𑆢𑆼𑆮𑆳 𑆘𑆤𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆤𑇀𑆩𑆳𑆢𑆁, 𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆩𑆲𑆫𑇀𑆰𑆪𑆾𑇁𑆨𑆴𑆯𑆥𑆤𑇀𑆠𑆂, 𑆥𑆴𑆠𑆫𑆾 𑆢𑆫𑇀𑆯𑆪𑆤𑇀𑆠𑆂 , 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆠𑆾 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆳𑆂, 𑆱𑆩𑆳𑆮𑆴𑆯𑆤𑇀𑆠𑆾 𑆪𑆑𑇀𑆰𑆳𑆂, 𑆫𑆳𑆑𑇀𑆰𑆱𑆳𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑇀𑆩𑆓𑆤𑇀𑆣𑆩𑆳𑆔𑇀𑆫𑆳𑆥𑆪𑆤𑇀𑆠𑆂, 𑆥𑆴𑆯𑆳𑆖𑆳𑆂 𑆥𑆶𑆤𑆫𑆳𑆫𑆶𑆲𑇀𑆪 𑆮𑆳𑆲𑆪𑆤𑇀𑆠𑆂𑇆𑇑𑇒𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆧𑆬𑆮𑆵𑆫𑇀𑆪𑆥𑆿𑆫𑆶𑆰𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆓𑇀𑆫𑆲𑆟𑆣𑆳𑆫𑆟𑆱𑇀𑆩𑆫𑆟𑆘𑇀𑆚𑆳𑆤𑆮𑆖𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆤𑆴 , 𑆃𑆤𑆴𑆪𑆠𑆯𑇀𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆑𑆳𑆬𑆂𑇆𑇑𑇓𑇆
𑆇𑆤𑇀𑆩𑆳𑆢𑆪𑆴𑆰𑇀𑆪𑆠𑆳𑆩𑆥𑆴 𑆒𑆬𑆶 𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆥𑆴𑆠𑆸𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆪𑆑𑇀𑆰𑆫𑆳𑆑𑇀𑆰𑆱𑆥𑆴𑆯𑆳𑆖𑆳𑆤𑆳𑆁 𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆮𑆳 𑆍𑆰𑇀𑆮𑆤𑇀𑆠𑆫𑆼𑆰𑇀𑆮𑆨𑆴𑆓𑆩𑆤𑆵𑆪𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆳𑆥𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆂 𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆼, 𑆥𑆷𑆫𑇀𑆮𑆑𑆸𑆠𑆱𑇀𑆪 𑆮𑆳 𑆑𑆫𑇀𑆩𑆟𑆂 𑆥𑆫𑆴𑆟𑆳𑆩𑆑𑆳𑆬𑆼, 𑆍𑆑𑆱𑇀𑆪 𑆮𑆳 𑆯𑆷𑆤𑇀𑆪𑆓𑆸𑆲𑆮𑆳𑆱𑆼 𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆼 𑆮𑆳, 𑆱𑆤𑇀𑆣𑇀𑆪𑆳𑆮𑆼𑆬𑆳𑆪𑆳𑆩𑆥𑇀𑆫𑆪𑆠𑆨𑆳𑆮𑆼 𑆮𑆳 𑆥𑆫𑇀𑆮𑆱𑆤𑇀𑆣𑆴𑆰𑆶 𑆮𑆳 𑆩𑆴𑆡𑆶𑆤𑆵𑆨𑆳𑆮𑆼, 𑆫𑆘𑆱𑇀𑆮𑆬𑆳𑆨𑆴𑆓𑆩𑆤𑆼 𑆮𑆳, 𑆮𑆴𑆓𑆶𑆟𑆼 𑆮𑆳𑇁𑆣𑇀𑆪𑆪𑆤𑆧𑆬𑆴𑆩𑆕𑇀𑆓𑆬𑆲𑆾𑆩𑆥𑇀𑆫𑆪𑆾𑆓𑆼, 𑆤𑆴𑆪𑆩𑆮𑇀𑆫𑆠𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆨𑆕𑇀𑆓𑆼 𑆮𑆳, 𑆩𑆲𑆳𑆲𑆮𑆼 𑆮𑆳, 𑆢𑆼𑆯𑆑𑆶𑆬𑆥𑆶𑆫𑆮𑆴𑆤𑆳𑆯𑆼 𑆮𑆳, 𑆩𑆲𑆳𑆓𑇀𑆫𑆲𑆾𑆥𑆓𑆩𑆤𑆼 𑆮𑆳, 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆳 𑆮𑆳 𑆥𑇀𑆫𑆘𑆤𑆤𑆑𑆳𑆬𑆼, 𑆮𑆴𑆮𑆴𑆣𑆨𑆷𑆠𑆳𑆯𑆶𑆨𑆳𑆯𑆶𑆖𑆴𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼 𑆮𑆳, 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆫𑆶𑆣𑆴𑆫𑆱𑇀𑆫𑆳𑆮𑆼, 𑆃𑆯𑆶𑆖𑆼𑆫𑆥𑇀𑆫𑆪𑆠𑆱𑇀𑆪 𑆮𑆳 𑆖𑆽𑆠𑇀𑆪𑆢𑆼𑆮𑆳𑆪𑆠𑆤𑆳𑆨𑆴𑆓𑆩𑆤𑆼 𑆮𑆳, 𑆩𑆳𑆁𑆱𑆩𑆣𑆶𑆠𑆴𑆬𑆓𑆶𑆝𑆩𑆢𑇀𑆪𑆾𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆼 𑆮𑆳, 𑆢𑆴𑆓𑇀𑆮𑆳𑆱𑆱𑆴 𑆮𑆳, 𑆤𑆴𑆯𑆴 𑆤𑆓𑆫𑆤𑆴𑆓𑆩𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆾𑆥𑆮𑆤𑆯𑇀𑆩𑆯𑆳𑆤𑆳𑆔𑆳𑆠𑆤𑆳𑆨𑆴𑆓𑆩𑆤𑆼 𑆮𑆳, 𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆱𑆶𑆫𑆪𑆠𑆴𑆥𑆷𑆘𑇀𑆪𑆳𑆨𑆴𑆣𑆫𑇀𑆰𑆟𑆼 𑆮𑆳, 𑆣𑆫𑇀𑆩𑆳𑆒𑇀𑆪𑆳𑆤𑆮𑇀𑆪𑆠𑆴𑆑𑇀𑆫𑆩𑆼 𑆮𑆳, 𑆃𑆤𑇀𑆪𑆱𑇀𑆪 𑆮𑆳 𑆑𑆫𑇀𑆩𑆟𑆾𑇁𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆫𑆩𑇀𑆨𑆼, 𑆅𑆠𑇀𑆪𑆨𑆴𑆔𑆳𑆠𑆑𑆳𑆬𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇔𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆠𑆶 𑆒𑆬𑆷𑆤𑇀𑆩𑆳𑆢𑆑𑆫𑆳𑆟𑆳𑆁 𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆶𑆤𑇀𑆩𑆳𑆢𑆤𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆲𑆴𑆁𑆱𑆳, 𑆫𑆠𑆴𑆂, 𑆃𑆨𑇀𑆪𑆫𑇀𑆖𑆤𑆁 𑆖𑆼𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆤𑆮𑆴𑆯𑆼𑆰𑆩𑆶𑆤𑇀𑆩𑆠𑇀𑆠𑆳𑆖𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆬𑆑𑇀𑆰𑆟𑆽𑆫𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆠𑇀𑆫 𑆲𑆴𑆁𑆱𑆳𑆫𑇀𑆡𑆴𑆤𑆾𑆤𑇀𑆩𑆳𑆢𑇀𑆪𑆩𑆳𑆤𑆾𑇁𑆓𑇀𑆤𑆴𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴, 𑆃𑆥𑇀𑆱𑆶 𑆤𑆴𑆩𑆘𑇀𑆘𑆠𑆴, 𑆱𑇀𑆡𑆬𑆳𑆖𑇀𑆗𑇀𑆮𑆨𑇀𑆫𑆼 𑆮𑆳 𑆥𑆠𑆠𑆴, 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑆯𑆳𑆑𑆳𑆰𑇀𑆜𑆬𑆾𑆰𑇀𑆛𑆩𑆶𑆰𑇀𑆛𑆴𑆨𑆴𑆫𑇀𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑇀, 𑆃𑆤𑇀𑆪𑆖𑇀𑆖 𑆥𑇀𑆫𑆳𑆟𑆮𑆣𑆳𑆫𑇀𑆡𑆩𑆳𑆫𑆨𑆠𑆼 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀, 𑆠𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆱𑆳𑆣𑇀𑆪𑆿 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆳𑆮𑆴𑆠𑆫𑆿𑇆𑇑𑇕𑇆
𑆠𑆪𑆾𑆂 𑆱𑆳𑆣𑆤𑆳𑆤𑆴- 𑆩𑆤𑇀𑆠𑇀𑆫𑆿𑆰𑆣𑆴𑆩𑆟𑆴𑆩𑆕𑇀𑆓𑆬𑆧𑆬𑇀𑆪𑆶𑆥𑆲𑆳𑆫𑆲𑆾𑆩𑆤𑆴𑆪𑆩𑆮𑇀𑆫𑆠𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆾𑆥𑆮𑆳𑆱 𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆪𑆤𑆥𑇀𑆫𑆟𑆴𑆥𑆳𑆠𑆓𑆩𑆤𑆳𑆢𑆵𑆤𑆴𑇆𑇑𑇖𑇆
𑆍𑆮𑆩𑆼𑆠𑆼 𑆥𑆚𑇀𑆖𑆾𑆤𑇀𑆩𑆳𑆢𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇗𑇆
𑆠𑆼 𑆠𑆶 𑆒𑆬𑆶 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆖 𑆥𑇀𑆫𑆮𑆴𑆨𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆥𑆚𑇀𑆖 𑆱𑆤𑇀𑆠𑆾 𑆢𑇀𑆮𑆳𑆮𑆼𑆮 𑆨𑆮𑆠𑆂𑇅 𑆠𑆿 𑆖 𑆥𑆫𑆱𑇀𑆥𑆫𑆩𑆤𑆶𑆧𑆣𑇀𑆤𑆵𑆠𑆂 𑆑𑆢𑆳𑆖𑆴𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆲𑆼𑆠𑆶𑆱𑆁𑆱𑆫𑇀𑆓𑆳𑆠𑇀𑇅 𑆠𑆪𑆾𑆂 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆩𑆼𑆮 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆨𑆮𑆠𑆴, 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆩𑆼𑆮 𑆖 𑆬𑆴𑆕𑇀𑆓𑆩𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆱𑆳𑆣𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆁 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆁 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆱𑆳𑆣𑇀𑆪𑆁 𑆠𑆶 𑆱𑆳𑆣𑇀𑆪𑆱𑆁𑆪𑆾𑆓𑆩𑇀𑇅 𑆠𑆱𑇀𑆪 𑆱𑆳𑆣𑆤𑆁 𑆱𑆳𑆣𑆤𑆱𑆁𑆪𑆾𑆓𑆩𑆼𑆮 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇑𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆤𑆽𑆮 𑆢𑆼𑆮𑆳 𑆤 𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆳 𑆤 𑆥𑆴𑆯𑆳𑆖𑆳 𑆤 𑆫𑆳𑆑𑇀𑆰𑆱𑆳𑆂𑇅 𑆤 𑆖𑆳𑆤𑇀𑆪𑆼 𑆱𑇀𑆮𑆪𑆩𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆩𑆶𑆥𑆑𑇀𑆬𑆴𑆯𑇀𑆤𑆤𑇀𑆠𑆴 𑆩𑆳𑆤𑆮𑆩𑇀𑇆𑇑𑇙𑇆
𑆪𑆼 𑆠𑇀𑆮𑆼𑆤𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆑𑇀𑆬𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆱𑇀𑆮𑆑𑆫𑇀𑆩𑆟𑆳𑇅 𑆤 𑆱 𑆠𑆢𑇀𑆣𑆼𑆠𑆶𑆑𑆂 𑆑𑇀𑆬𑆼𑆯𑆾 𑆤 𑆲𑇀𑆪𑆱𑇀𑆠𑆴 𑆑𑆸𑆠𑆑𑆸𑆠𑇀𑆪𑆠𑆳𑇆𑇒𑇐𑇆
𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆳𑆠𑇀 𑆱𑆩𑇀𑆨𑆷𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆿 𑆑𑆫𑇀𑆩𑆘 𑆄𑆠𑇀𑆩𑆤𑆂𑇅 𑆤𑆳𑆨𑆴𑆯𑆁𑆱𑆼𑆢𑇀𑆧𑆶𑆣𑆾 𑆢𑆼𑆮𑆳𑆤𑇀𑆤 𑆥𑆴𑆠𑆹𑆤𑇀𑆤𑆳𑆥𑆴 𑆫𑆳𑆑𑇀𑆰𑆱𑆳𑆤𑇀𑇆𑇒𑇑𑇆
𑆄𑆠𑇀𑆩𑆳𑆤𑆩𑆼𑆮 𑆩𑆤𑇀𑆪𑆼𑆠 𑆑𑆫𑇀𑆠𑆳𑆫𑆁 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆪𑆾𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑇀𑆫𑆼𑆪𑆱𑇀𑆑𑆫𑆁 𑆩𑆳𑆫𑇀𑆓𑆁 𑆥𑇀𑆫𑆠𑆴𑆥𑆢𑇀𑆪𑆼𑆠 𑆤𑆾 𑆠𑇀𑆫𑆱𑆼𑆠𑇀𑇆𑇒𑇒𑇆
𑆢𑆼𑆮𑆳𑆢𑆵𑆤𑆳𑆩𑆥𑆖𑆴𑆠𑆴𑆫𑇀𑆲𑆴𑆠𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆠𑆼 𑆖 𑆠𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆫𑆾𑆣𑆯𑇀𑆖 𑆱𑆫𑇀𑆮𑆩𑆳𑆪𑆠𑇀𑆠𑆩𑆳𑆠𑇀𑆩𑆤𑆴𑇆𑇒𑇓𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆱𑆕𑇀𑆒𑇀𑆪𑆳 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆳𑆓𑇀𑆫𑆷𑆥𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆳𑆣𑇀𑆪𑆠𑆳 𑆤 𑆖𑇅 𑆇𑆤𑇀𑆩𑆳𑆢𑆳𑆤𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆷𑆠𑇀𑆫𑆁 𑆖 𑆨𑆳𑆰𑆴𑆠𑆩𑇀𑇆𑇒𑇔𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆥𑆱𑇀𑆩𑆳𑆫𑆤𑆴𑆢𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆖𑆠𑇀𑆮𑆳𑆫𑆾𑇁𑆥𑆱𑇀𑆩𑆳𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂𑇆𑇓𑇆
𑆠 𑆍𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆨𑆸𑆠𑆳𑆁 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆲𑆠𑆖𑆼𑆠𑆱𑆳𑆩𑆶𑆢𑇀𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆮𑆴𑆰𑆩𑆧𑆲𑆶𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆱𑆩𑆬𑆮𑆴𑆑𑆸𑆠𑆾𑆥𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆯𑆶𑆖𑆵𑆤𑇀𑆪𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆘𑆳𑆠𑆳𑆤𑆴 𑆮𑆽𑆰𑆩𑇀𑆪𑆪𑆶𑆑𑇀𑆠𑆼𑆤𑆾𑆥𑆪𑆾𑆓𑆮𑆴𑆣𑆴𑆤𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆳𑆤𑆳𑆁 𑆠𑆤𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆩𑆥𑆴 𑆖 𑆮𑆴𑆰𑆩𑆩𑆳𑆖𑆫𑆠𑆳𑆩𑆤𑇀𑆪𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆖𑆼𑆰𑇀𑆛𑆳 𑆮𑆴𑆰𑆩𑆳𑆂 𑆱𑆩𑆳𑆖𑆫𑆠𑆳𑆩𑆠𑇀𑆪𑆶𑆥𑆑𑇀𑆰𑆪𑆳𑆢𑇀𑆮𑆳 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳 𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆲𑆠𑆖𑆼𑆠𑆱𑆳𑆩𑆤𑇀𑆠𑆫𑆳𑆠𑇀𑆩𑆤𑆂 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆠𑆩𑆩𑆳𑆪𑆠𑆤𑆁 𑆲𑆸𑆢𑆪𑆩𑆶𑆥𑆱𑆸𑆠𑇀𑆪𑆾𑆥𑆫𑆴 𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼, 𑆠𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆴 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆂 𑆱𑆤𑇀𑆠𑆾 𑆪𑆢𑆳 𑆲𑆸𑆢𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆴 𑆖𑆼𑆫𑆴𑆠𑆳𑆂 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆨𑆪𑆬𑆾𑆨𑆩𑆾𑆲𑆲𑆫𑇀𑆰𑆯𑆾𑆑𑆖𑆴𑆤𑇀𑆠𑆾𑆢𑇀𑆮𑆼𑆓𑆳𑆢𑆴𑆨𑆴𑆂 𑆱𑆲𑆱𑆳𑇁𑆨𑆴𑆥𑆷𑆫𑆪𑆤𑇀𑆠𑆴, 𑆠𑆢𑆳 𑆘𑆤𑇀𑆠𑆶𑆫𑆥𑆱𑇀𑆩𑆫𑆠𑆴𑇆𑇔𑇆
𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆁 𑆥𑆶𑆤𑆂 𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆶𑆢𑇀𑆣𑆴𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑇀𑆥𑇀𑆬𑆮𑆳𑆢𑇀𑆧𑆵𑆨𑆠𑇀𑆱𑆖𑆼𑆰𑇀𑆛𑆩𑆳𑆮𑆱𑇀𑆡𑆴𑆑𑆁 𑆠𑆩𑆂 𑆥𑇀𑆫𑆮𑆼𑆯𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇕𑇆
𑆠𑆱𑇀𑆪𑆼𑆩𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆨𑇀𑆫𑆷𑆮𑇀𑆪𑆶𑆢𑆳𑆱𑆂 𑆱𑆠𑆠𑆩𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑇀𑆮𑆽𑆑𑆸𑆠𑆩𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆁 𑆬𑆳𑆬𑆳𑆱𑆴𑆕𑇀𑆔𑆳𑆟𑆥𑇀𑆫𑆱𑇀𑆫𑆮𑆟𑆩𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆰𑆟𑆩𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆿 𑆲𑆸𑆢𑆪𑆓𑇀𑆫𑆲𑆂 𑆑𑆶𑆑𑇀𑆰𑆼𑆫𑆳𑆛𑆾𑆥𑆾 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆩𑆱𑇀𑆡𑆴𑆨𑆼𑆢𑆾𑇁𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾 𑆩𑆾𑆲𑆱𑇀𑆠𑆩𑆱𑆾 𑆢𑆫𑇀𑆯𑆤𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆨𑇀𑆫𑆩𑆯𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆖 𑆩𑆢𑆤𑆫𑇀𑆠𑆤𑆮𑇀𑆪𑆣𑆤𑆮𑇀𑆪𑆡𑆤𑆮𑆼𑆥𑆤𑆥𑆠𑆤𑆳𑆢𑆵𑆤𑆵𑆠𑆴𑇆𑇖𑇆
𑆠𑆠𑆾𑇁𑆤𑆤𑇀𑆠𑆫𑆩𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆼𑆮𑇆𑇗𑇆
𑆠𑆼𑆰𑆳𑆩𑆳𑆓𑆤𑇀𑆠𑆶𑆫𑆤𑆶𑆧𑆤𑇀𑆣𑆾 𑆨𑆮𑆠𑇀𑆪𑆼𑆮 𑆑𑆢𑆳𑆖𑆴𑆠𑇀, 𑆠𑆩𑆶𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆬𑆴𑆕𑇀𑆓𑆳𑆣𑆴𑆑𑇀𑆪𑆩𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆶𑆫𑆷𑆥𑆁 𑆖 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑇆𑇙𑇆
𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆥𑆱𑇀𑆩𑆳𑆫𑆴𑆨𑇀𑆪𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆴 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆤𑇀𑆪𑆶𑆥𑆯𑆩𑆤𑆳𑆤𑆴 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁, 𑆩𑆤𑇀𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑆴 𑆖𑆳𑆓𑆤𑇀𑆠𑆶𑆱𑆁𑆪𑆾𑆓𑆼𑇆𑇑𑇐𑇆
𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆲𑆴 𑆢𑆑𑇀𑆰𑆳𑆣𑇀𑆮𑆫𑆣𑇀𑆮𑆁𑆱𑆼 𑆢𑆼𑆲𑆴𑆤𑆳𑆁 𑆤𑆳𑆤𑆳𑆢𑆴𑆑𑇀𑆰𑆶 𑆮𑆴𑆢𑇀𑆫𑆮𑆠𑆳𑆩𑆨𑆴𑆢𑇀𑆫𑆮𑆟𑆠𑆫𑆟𑆣𑆳𑆮𑆤𑆥𑇀𑆬𑆮𑆤𑆬𑆕𑇀𑆔𑆤𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆢𑆼𑆲𑆮𑆴𑆑𑇀𑆰𑆾𑆨𑆟𑆽𑆂 𑆥𑆶𑆫𑆳 𑆓𑆶𑆬𑇀𑆩𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆨𑆷𑆠𑇀, 𑆲𑆮𑆴𑆰𑇀𑆥𑇀𑆫𑆳𑆯𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆼𑆲𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆳𑆁, 𑆨𑆪𑆠𑇀𑆫𑆳𑆱𑆯𑆾𑆑𑆽𑆫𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆤𑆳𑆁, 𑆮𑆴𑆮𑆴𑆣𑆨𑆷𑆠𑆳𑆯𑆶𑆖𑆴𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆢𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆟𑆳𑆁, 𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆩𑆲𑆼𑆯𑇀𑆮𑆫𑆬𑆬𑆳𑆛𑆥𑇀𑆫𑆨𑆮𑆂 , 𑆠𑆠𑇀𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑇀, 𑆃𑆠𑆴𑆮𑇀𑆪𑆮𑆳𑆪𑆳𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆫𑆳𑆘𑆱𑇀𑆪 𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆼𑆠𑆴𑇆𑇑𑇑𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆾 𑆲𑆴 𑆮𑆳𑆠𑆼𑆤 𑆥𑆴𑆠𑇀𑆠𑆼𑆤 𑆖 𑆑𑆦𑆼𑆤 𑆖𑇅 𑆖𑆠𑆶𑆫𑇀𑆡𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆤 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆱𑇀𑆠𑆡𑆳𑆮𑆴𑆣𑆂𑇆𑇑𑇒𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆁𑆱𑇀𑆠𑆶 𑆨𑆴𑆰𑆘𑆂 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆳𑆂 𑆱𑆳𑆣𑆪𑆤𑇀𑆠𑆴 𑆱𑆩𑆳𑆲𑆴𑆠𑆳𑆂𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆽𑆯𑇀𑆖𑆽𑆮 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆯𑆩𑆤𑆽𑆫𑆥𑆴𑇆𑇑𑇓𑇆
𑆪𑆢𑆳 𑆢𑆾𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆱𑇀𑆪 𑆨𑆮𑆠𑇀𑆪𑆳𑆓𑆤𑇀𑆠𑆶𑆫𑆤𑇀𑆮𑆪𑆂𑇅 𑆠𑆢𑆳 𑆱𑆳𑆣𑆳𑆫𑆟𑆁 𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆓𑇀𑆮𑆴𑆢𑆂𑇆𑇑𑇔𑇆
𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆂 𑆱𑆫𑇀𑆮𑆿𑆰𑆣𑆮𑆴𑆯𑆳𑆫𑆢𑆂𑇅 𑆨𑆴𑆰𑆑𑇀 𑆱𑆫𑇀𑆮𑆳𑆩𑆪𑆳𑆤𑇀 𑆲𑆤𑇀𑆠𑆴 𑆤 𑆖 𑆩𑆾𑆲𑆁 𑆤𑆴𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇑𑇕𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑆒𑆴𑆬𑆼𑆤𑆾𑆑𑇀𑆠𑆁 𑆤𑆴𑆢𑆳𑆤𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇅𑇑𑇖𑇅 𑆤𑆴𑆢𑆳𑆤𑆳𑆫𑇀𑆡𑆑𑆫𑆾 𑆫𑆾𑆓𑆾 𑆫𑆾𑆓𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑇀𑆮𑆫𑆱𑆤𑇀𑆠𑆳𑆥𑆳𑆢𑇀𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆢𑆵𑆫𑇀𑆪𑆠𑆼𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆱𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆾𑆰𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆘𑆳𑆪𑆠𑆼 𑇆𑇑𑇗𑇆
𑆥𑇀𑆬𑆵𑆲𑆳𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆘𑆜𑆫𑆁 𑆘𑆜𑆫𑆳𑆖𑇀𑆗𑆾𑆡 𑆍𑆮 𑆖𑇅 𑆃𑆫𑇀𑆯𑆾𑆨𑇀𑆪𑆾 𑆘𑆜𑆫𑆁 𑆢𑆶𑆂𑆒𑆁 𑆓𑆶𑆬𑇀𑆩𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇑𑇘𑇆
𑆥𑇀𑆫𑆠𑆴𑆯𑇀𑆪𑆳𑆪𑆳𑆢𑇀𑆨𑆮𑆼𑆠𑇀 𑆑𑆳𑆱𑆂 𑆑𑆳𑆱𑆳𑆠𑇀 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼 𑆑𑇀𑆰𑆪𑆂𑇅 𑆑𑇀𑆰𑆪𑆾 𑆫𑆾𑆓𑆱𑇀𑆪 𑆲𑆼𑆠𑆶𑆠𑇀𑆮𑆼 𑆯𑆾𑆰𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇆𑇑𑇙𑇆
𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆑𑆼𑆮𑆬𑆳 𑆫𑆾𑆓𑆳𑆂 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆣𑆼𑆠𑇀𑆮𑆫𑇀𑆡𑆑𑆳𑆫𑆴𑆟𑆂𑇅 𑆇𑆨𑆪𑆳𑆫𑇀𑆡𑆑𑆫𑆳 𑆢𑆸𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆡𑆽𑆮𑆽𑆑𑆳𑆫𑇀𑆡𑆑𑆳𑆫𑆴𑆟𑆂 𑇆𑇒𑇐𑇆
𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆣𑆴 𑆫𑆾𑆓𑆾 𑆫𑆾𑆓𑆱𑇀𑆪 𑆲𑆼𑆠𑆶𑆫𑇀𑆨𑆷𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴𑇅 𑆤 𑆥𑇀𑆫𑆯𑆳𑆩𑇀𑆪𑆠𑆴 𑆖𑆳𑆥𑇀𑆪𑆤𑇀𑆪𑆾 𑆲𑆼𑆠𑇀𑆮𑆫𑇀𑆡𑆁 𑆑𑆶𑆫𑆶𑆠𑆼𑇁𑆥𑆴 𑆖𑇆𑇒𑇑𑇆
𑆍𑆮𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑆩𑆳 𑆤𑆹𑆟𑆳𑆁 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆱𑆕𑇀𑆑𑆫𑆳𑆂𑇅 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆥𑆫𑆴𑆯𑆶𑆢𑇀𑆣𑆠𑇀𑆮𑆳𑆠𑇀𑆠𑆡𑆳 𑆖𑆳𑆤𑇀𑆪𑆾𑆤𑇀𑆪𑆱𑆩𑇀𑆨𑆮𑆳𑆠𑇀𑇆𑇒𑇒𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆂 𑆯𑆩𑆪𑆼𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆪𑆾𑇁𑆤𑇀𑆪𑆩𑆤𑇀𑆪𑆩𑆶𑆢𑆵𑆫𑆪𑆼𑆠𑇀𑇅 𑆤𑆳𑆱𑆿 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆂, 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆠𑆶 𑆯𑆩𑆪𑆼𑆢𑇀𑆪𑆾 𑆤 𑆑𑆾𑆥𑆪𑆼𑆠𑇀𑇆𑇒𑇓𑇆
𑆍𑆑𑆾 𑆲𑆼𑆠𑆶𑆫𑆤𑆼𑆑𑆱𑇀𑆪 𑆠𑆡𑆽𑆑𑆱𑇀𑆪𑆽𑆑 𑆍𑆮 𑆲𑆴𑇅 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆼𑆑𑆱𑇀𑆪 𑆖𑆳𑆤𑆼𑆑𑆾 𑆧𑆲𑆷𑆤𑆳𑆁 𑆧𑆲𑆮𑆾𑇁𑆥𑆴 𑆖𑇆𑇒𑇔𑇆
𑆘𑇀𑆮𑆫𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆳𑆥𑆳𑆢𑇀𑆪𑆳 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆫𑆷𑆑𑇀𑆰𑆲𑆼𑆠𑆶𑆘𑆳𑆂𑇅 𑆫𑆷𑆑𑇀𑆰𑆼𑆟𑆽𑆑𑆼𑆤 𑆖𑆳𑆥𑇀𑆪𑆼𑆑𑆾 𑆘𑇀𑆮𑆫 𑆍𑆮𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇒𑇕𑇆
𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆨𑆴𑆯𑇀𑆖𑆽𑆑𑆾 𑆘𑇀𑆮𑆫𑆾 𑆫𑆷𑆑𑇀𑆰𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆨𑆮𑆼𑆠𑇀𑇅 𑆫𑆷𑆑𑇀𑆰𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆳𑆢𑇀𑆪𑆳𑆯𑇀𑆖 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆱𑆩𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴𑇆𑇒𑇖𑇆
𑆬𑆴𑆕𑇀𑆓𑆁 𑆖𑆽𑆑𑆩𑆤𑆼𑆑𑆱𑇀𑆪 𑆠𑆡𑆽𑆮𑆽𑆑𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆧𑆲𑆷𑆤𑇀𑆪𑆼𑆑𑆱𑇀𑆪 𑆖 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑇀𑆧𑆲𑆷𑆤𑆳𑆁 𑆱𑇀𑆪𑆶𑆫𑇀𑆧𑆲𑆷𑆤𑆴 𑆖𑇆𑇒𑇗𑇆
𑆮𑆴𑆰𑆩𑆳𑆫𑆩𑇀𑆨𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆬𑆴𑆕𑇀𑆓𑆩𑆼𑆑𑆁 𑆘𑇀𑆮𑆫𑆾 𑆩𑆠𑆂𑇅 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆽𑆑𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆼𑆑𑆂 𑆱𑆤𑇀𑆠𑆳𑆥𑆾 𑆬𑆴𑆕𑇀𑆓𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇒𑇘𑇆
𑆮𑆴𑆰𑆩𑆳𑆫𑆩𑇀𑆨𑆩𑆷𑆬𑆽𑆯𑇀𑆖 𑆘𑇀𑆮𑆫 𑆍𑆑𑆾 𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑆼𑆠𑆽𑆫𑇀𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆢𑇀𑆪𑆳𑆂 𑆱𑆤𑇀𑆠𑆴 𑆖𑆳𑆩𑆪𑆳𑆂𑇆𑇒𑇙𑇆
𑆍𑆑𑆳 𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑆤𑆼𑆑𑆱𑇀𑆪 𑆠𑆡𑆽𑆮𑆽𑆑𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆮𑇀𑆪𑆳𑆣𑆼𑆫𑆼𑆑𑆱𑇀𑆪 𑆖𑆳𑆤𑆼𑆑𑆳 𑆧𑆲𑆷𑆤𑆳𑆁 𑆧𑆲𑇀𑆮𑇀𑆪 𑆍𑆮 𑆖𑇆𑇓𑇐𑇆
𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑆳𑆩𑆳𑆯𑆪𑆾𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆬𑆕𑇀𑆔𑆤𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆽𑆑𑆱𑇀𑆪 𑆖𑆳𑆥𑇀𑆪𑆼𑆑𑆳 𑆯𑆳𑆤𑇀𑆠𑆴𑆫𑇀𑆬𑆕𑇀𑆔𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇓𑇑𑇆
𑆠𑆡𑆳 𑆬𑆔𑇀𑆮𑆯𑆤𑆳𑆢𑇀𑆪𑆳𑆯𑇀𑆖 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆽𑆑𑆱𑇀𑆪 𑆯𑆳𑆤𑇀𑆠𑆪𑆂𑇅 𑆍𑆠𑆳𑆯𑇀𑆖𑆽𑆮 𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆪𑆂𑇆𑇓𑇒𑇆
𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆂 𑆱𑆶𑆒𑆾𑆥𑆳𑆪𑆂 𑆑𑆳𑆬𑆼𑆤𑆳𑆬𑇀𑆥𑆼𑆤 𑆱𑆳𑆣𑇀𑆪𑆠𑆼𑇅 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆠𑆶 𑆪𑆠𑇀𑆤𑆼𑆤 𑆩𑆲𑆠𑆳 𑆖𑆴𑆫𑆳𑆠𑇀𑇆𑇓𑇓𑇆
𑆪𑆳𑆠𑆴 𑆤𑆳𑆯𑆼𑆰𑆠𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆱𑆳𑆣𑇀𑆪𑆾 𑆪𑆳𑆥𑇀𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂𑇅 𑆥𑆫𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆱𑆫𑇀𑆮𑆳𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆾𑇁𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇓𑇔𑇆
𑆤𑆳𑆱𑆳𑆣𑇀𑆪𑆂 𑆱𑆳𑆣𑇀𑆪𑆠𑆳𑆁 𑆪𑆳𑆠𑆴 𑆱𑆳𑆣𑇀𑆪𑆾 𑆪𑆳𑆠𑆴 𑆠𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆠𑆳𑆩𑇀𑇅 𑆥𑆳𑆢𑆳𑆥𑆖𑆳𑆫𑆳𑆢𑇀𑆢𑆽𑆮𑆳𑆢𑇀𑆮𑆳 𑆪𑆳𑆤𑇀𑆠𑆴 𑆨𑆳𑆮𑆳𑆤𑇀𑆠𑆫𑆁 𑆓𑆢𑆳𑆂𑇆𑇓𑇕𑇆
𑆮𑆸𑆢𑇀𑆣𑆴𑆱𑇀𑆡𑆳𑆤𑆑𑇀𑆰𑆪𑆳𑆮𑆱𑇀𑆡𑆳𑆁 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆶𑆥𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆱𑆶𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆩𑆥𑆴 𑆖 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆢𑆼𑆲𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆖𑆼𑆠𑆱𑆳𑆩𑇀𑇆𑇓𑇖𑇆
𑆮𑇀𑆪𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑇀 𑆲𑆴 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇅 𑆠𑆱𑇀𑆪𑆳𑆁 𑆠𑆱𑇀𑆪𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆪𑆳𑆁 𑆖𑆠𑆶𑆂𑆯𑇀𑆫𑆼𑆪𑆂 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇓𑇗𑇆
𑆥𑇀𑆫𑆳𑆪𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆠𑆳 𑆢𑆾𑆰𑆳𑆂 𑆑𑇀𑆬𑆼𑆯𑆪𑆤𑇀𑆠𑇀𑆪𑆳𑆠𑆶𑆫𑆳𑆁𑆯𑇀𑆖𑆴𑆫𑆩𑇀𑇅 𑆠𑆼𑆰𑆶 𑆤 𑆠𑇀𑆮𑆫𑆪𑆳 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆢𑆼𑆲𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆮𑆴𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇆𑇓𑇘𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆂 𑆑𑇀𑆰𑆥𑆪𑆼𑆢𑇀𑆮𑆳 𑆠𑆳𑆤𑇀 𑆱𑆶𑆒𑆁 𑆮𑆳 𑆑𑆾𑆰𑇀𑆜𑆩𑆳𑆤𑆪𑆼𑆠𑇀𑇅 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆑𑆾𑆰𑇀𑆜𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑇀 𑆪𑆡𑆳𑆱𑆤𑇀𑆤𑆁 𑆲𑆫𑆼𑆢𑇀𑆧𑆶𑆣𑆂𑇆𑇓𑇙𑇆
𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆪𑆳𑆤𑆴 𑆖𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆣𑆴𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑇅 𑆮𑇀𑆪𑆳𑆣𑆪𑆱𑇀𑆠𑆼 𑆠𑆢𑆳𑆠𑇀𑆮𑆼 𑆠𑆶 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆵𑆰𑇀𑆛𑆳𑆤𑆴 𑆤𑆳𑆩𑆪𑆳𑆂𑇆𑇔𑇐𑇆
𑆮𑆴𑆑𑆳𑆫𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑇀𑆖𑆽𑆮 𑆢𑇀𑆮𑆪𑆁 𑆱𑆫𑇀𑆮𑆁 𑆱𑆩𑆳𑆱𑆠𑆂𑇅 𑆠𑆢𑇀𑆣𑆼𑆠𑆶𑆮𑆯𑆓𑆁 𑆲𑆼𑆠𑆾𑆫𑆨𑆳𑆮𑆳𑆤𑇀𑆤𑆳𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇔𑇑𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆲𑆼𑆠𑆮𑆂 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆶𑆥𑆯𑆪𑆱𑇀𑆠𑆡𑆳𑇅 𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆴𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂 𑆱𑆷𑆠𑇀𑆫𑆩𑆳𑆠𑇀𑆫𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆠𑇀𑇆𑇔𑇒𑇆
𑆘𑇀𑆮𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆱𑆳𑆣𑇀𑆪𑆠𑆳 𑆤 𑆖𑇅 𑆥𑆸𑆡𑆓𑆼𑆑𑆽𑆑𑆯𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆲𑆼𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆂𑇆𑇔𑇓𑇆
𑆲𑆼𑆠𑆶𑆥𑆫𑇀𑆪𑆳𑆪𑆤𑆳𑆩𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆪 𑆖𑇅 𑆤𑆴𑆢𑆳𑆤𑆱𑇀𑆡𑆳𑆤𑆩𑆼𑆠𑆳𑆮𑆠𑇀 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇔𑇔𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆡 𑆒𑆬𑆶 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆫𑇀𑆡𑆁 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑆶𑆒𑆾𑆥𑆨𑆾𑆓𑆠𑆩𑆽𑆂 𑆱𑆲𑆳𑆤𑇀𑆪𑆽𑆫𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆽𑆂 𑆑𑆬𑇀𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆨𑆼𑆢𑆳𑆫𑇀𑆡𑆁 𑆮𑆴𑆨𑆳𑆓𑆳𑆫𑇀𑆡𑆁 𑆖𑆼𑆠𑇀𑆪𑆫𑇀𑆡𑆂 , 𑆠𑆢𑇀𑆪𑆾𑆓𑆳𑆤𑆳𑆁 𑆖 𑆑𑇀𑆫𑆴𑆪𑆳𑆮𑆴𑆣𑆼𑆂 𑆱𑆶𑆒𑆾𑆥𑆳𑆪𑆱𑇀𑆪 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆑𑆬𑇀𑆥𑆤𑆳𑆫𑇀𑆡𑆁 𑆑𑆬𑇀𑆥𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯!𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆲𑆫𑆟𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆁 𑆮𑆩𑆤𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑇀, 𑆃𑆣𑆾𑆨𑆳𑆓𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑇀; 𑆇𑆨𑆪𑆁 𑆮𑆳 𑆯𑆫𑆵𑆫𑆩𑆬𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆬𑆨𑆠𑆼𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆾𑆰𑇀𑆟-𑆠𑆵𑆑𑇀𑆰𑇀𑆟-𑆱𑆷𑆑𑇀𑆰𑇀𑆩-𑆮𑇀𑆪𑆮𑆳𑆪𑆴-𑆮𑆴𑆑𑆳𑆯𑆵𑆤𑇀𑆪𑆿𑆰𑆣𑆳𑆤𑆴 𑆱𑇀𑆮𑆮𑆵𑆫𑇀𑆪𑆼𑆟 𑆲𑆸𑆢𑆪𑆩𑆶𑆥𑆼𑆠𑇀𑆪 𑆣𑆩𑆤𑆵𑆫𑆤𑆶𑆱𑆸𑆠𑇀𑆪 𑆱𑇀𑆡𑆷𑆬𑆳𑆟𑆶𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑇀𑆪𑆂 𑆑𑆼𑆮𑆬𑆁 𑆯𑆫𑆵𑆫𑆓𑆠𑆁 𑆢𑆾𑆰𑆱𑆕𑇀𑆔𑆳𑆠𑆩𑆳𑆓𑇀𑆤𑆼𑆪𑆠𑇀𑆮𑆳𑆢𑇀 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆤𑇀𑆠𑆴, 𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆢𑇀 𑆮𑆴𑆖𑇀𑆗𑆴𑆤𑇀𑆢𑆤𑇀𑆠𑆴, 𑆱 𑆮𑆴𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆂 𑆥𑆫𑆴𑆥𑇀𑆬𑆮𑆤𑇀 𑆱𑇀𑆤𑆼𑆲𑆨𑆳𑆮𑆴𑆠𑆼 𑆑𑆳𑆪𑆼 𑆱𑇀𑆤𑆼𑆲𑆳𑆑𑇀𑆠𑆨𑆳𑆘𑆤𑆱𑇀𑆡𑆩𑆴𑆮 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆱𑆘𑇀𑆘𑆤𑇀𑆤𑆟𑆶𑆥𑇀𑆫𑆮𑆟𑆨𑆳𑆮𑆳𑆢𑆳𑆩𑆳𑆯𑆪𑆩𑆳𑆓𑆩𑇀𑆪𑆾𑆢𑆳𑆤𑆥𑇀𑆫𑆟𑆶𑆤𑇀𑆤𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆳𑆪𑇀𑆮𑆳𑆠𑇀𑆩𑆑𑆠𑇀𑆮𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆨𑆳𑆓𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆢𑆿𑆰𑆣𑆱𑇀𑆪𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆪𑆠𑆼, 𑆱𑆬𑆴𑆬𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆠𑇀𑆩𑆑𑆠𑇀𑆮𑆳𑆢𑆣𑆾𑆨𑆳𑆓𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆖𑇀𑆖𑆿𑆰𑆣𑆱𑇀𑆪𑆳𑆣𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼, 𑆇𑆨𑆪𑆠𑆯𑇀𑆖𑆾𑆨𑆪𑆓𑆶𑆟𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆬𑆑𑇀𑆰𑆟𑆾𑆢𑇀𑆢𑆼𑆯𑆂𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆦𑆬-𑆘𑆵𑆩𑆷𑆠𑆑𑆼𑆑𑇀𑆰𑇀𑆮𑆳𑆑𑆶-𑆣𑆳𑆩𑆳𑆫𑇀𑆓𑆮-𑆑𑆶𑆛𑆘-𑆑𑆸𑆠𑆮𑆼𑆣𑆤𑆳𑆤𑆳𑆁, 𑆯𑇀𑆪𑆳𑆩𑆳-𑆠𑇀𑆫𑆴𑆮𑆸𑆖𑇀𑆖𑆠𑆶𑆫𑆕𑇀𑆓𑆶𑆬-𑆠𑆴𑆬𑇀𑆮𑆑-𑆩𑆲𑆳𑆮𑆸𑆑𑇀𑆰-𑆱𑆥𑇀𑆠𑆬𑆳-𑆯𑆕𑇀𑆒𑆴𑆤𑆵-𑆢𑆤𑇀𑆠𑆵-𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆤𑆳𑆁 𑆖, 𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆢𑆼𑆯𑆑𑆳𑆬𑆱𑆩𑇀𑆨𑆮𑆳𑆱𑇀𑆮𑆳𑆢-𑆫𑆱-𑆮𑆵𑆫𑇀𑆪-𑆮𑆴𑆥𑆳𑆑-𑆥𑇀𑆫𑆨𑆳𑆮𑆓𑇀𑆫𑆲𑆟𑆳𑆢𑇀 𑆢𑆼𑆲-𑆢𑆾𑆰-𑆥𑇀𑆫𑆑𑆸𑆠𑆴-𑆮𑆪𑆾-𑆧𑆬𑆳𑆓𑇀𑆤𑆴-𑆨𑆑𑇀𑆠𑆴-𑆱𑆳𑆠𑇀𑆩𑇀𑆪-𑆫𑆾𑆓𑆳𑆮𑆱𑇀𑆡𑆳𑆢𑆵𑆤𑆳𑆁 𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆨𑆳𑆮𑆮𑆠𑇀𑆠𑇀𑆮𑆳𑆖𑇀𑆖 , 𑆮𑆴𑆖𑆴𑆠𑇀𑆫𑆓𑆤𑇀𑆣-𑆮𑆫𑇀𑆟-𑆫𑆱-𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆤𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆱𑆶𑆒𑆳𑆫𑇀𑆡𑆩𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆱𑆁𑆪𑆾𑆓𑆳𑆤𑆳𑆩𑆥𑆴 𑆖 𑆱𑆠𑆳𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆮𑆴𑆑𑆬𑇀𑆥𑆩𑆳𑆫𑇀𑆓𑆾𑆥𑆢𑆫𑇀𑆯𑆤𑆳𑆫𑇀𑆡𑆁 𑆰𑆝𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆪𑆾𑆓𑆯𑆠𑆳𑆤𑆴 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇖𑇆
𑆠𑆳𑆤𑆴 𑆠𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑆼𑆯-𑆑𑆳𑆬-𑆓𑆶𑆟-𑆨𑆳𑆘𑆤-𑆱𑆩𑇀𑆥𑆢𑇀𑆮𑆵𑆫𑇀𑆪𑆧𑆬𑆳𑆣𑆳𑆤𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆩𑆫𑇀𑆡𑆠𑆩𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇗𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆂 𑆒𑆬𑆶 𑆢𑆼𑆯𑆂- 𑆘𑆳𑆕𑇀𑆓𑆬𑆂, 𑆄𑆤𑆷𑆥𑆂, 𑆱𑆳𑆣𑆳𑆫𑆟𑆯𑇀𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫 𑆘𑆳𑆕𑇀𑆓𑆬𑆂 𑆥𑆫𑇀𑆪𑆳𑆑𑆳𑆯𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆂, 𑆠𑆫𑆶𑆨𑆴𑆫𑆥𑆴 𑆖 𑆑𑆢𑆫-𑆒𑆢𑆴𑆫𑆳𑆱𑆤𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟-𑆣𑆮-𑆠𑆴𑆤𑆴𑆯-𑆯𑆬𑇀𑆬𑆑𑆵-𑆱𑆳𑆬-𑆱𑆾𑆩𑆮𑆬𑇀𑆑-𑆧𑆢𑆫𑆵-𑆠𑆴𑆤𑇀𑆢𑆶𑆑𑆳𑆯𑇀𑆮𑆠𑇀𑆡-𑆮𑆛𑆳𑆩𑆬𑆑𑆵𑆮𑆤𑆓𑆲𑆤𑆂, 𑆃𑆤𑆼𑆑𑆯𑆩𑆵-𑆑𑆑𑆶𑆨-𑆯𑆴𑆁𑆯𑆥𑆳𑆥𑇀𑆫𑆳𑆪𑆂, 𑆱𑇀𑆡𑆴𑆫𑆯𑆶𑆰𑇀𑆑𑆥𑆮𑆤𑆧𑆬𑆮𑆴𑆣𑆷𑆪𑆩𑆳𑆤𑆥𑇀𑆫𑆤𑆸𑆠𑇀𑆪𑆠𑇀𑆠𑆫𑆶𑆟𑆮𑆴𑆛𑆥𑆂, 𑆥𑇀𑆫𑆠𑆠𑆩𑆸𑆓𑆠𑆸𑆰𑇀𑆟𑆴𑆑𑆾𑆥𑆓𑆷𑆞𑆠𑆤𑆶𑆒𑆫𑆥𑆫𑆶𑆰𑆱𑆴𑆑𑆠𑆳𑆯𑆫𑇀𑆑𑆫𑆳𑆧𑆲𑆶𑆬𑆂, 𑆬𑆳𑆮𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆴𑆖𑆑𑆾𑆫𑆳𑆤𑆶𑆖𑆫𑆴𑆠𑆨𑆷𑆩𑆴𑆨𑆳𑆓𑆂, 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆧𑆲𑆶𑆬𑆂, 𑆱𑇀𑆡𑆴𑆫𑆑𑆜𑆴𑆤𑆩𑆤𑆶𑆰𑇀𑆪𑆥𑇀𑆫𑆳𑆪𑆾 𑆘𑇀𑆚𑆼𑆪𑆂, 𑆃𑆡𑆳𑆤𑆷𑆥𑆾 𑆲𑆴𑆤𑇀𑆠𑆳𑆬𑆠𑆩𑆳𑆬𑆤𑆳𑆫𑆴𑆑𑆼𑆬𑆑𑆢𑆬𑆵𑆮𑆤𑆓𑆲𑆤𑆂, 𑆱𑆫𑆴𑆠𑇀𑆱𑆩𑆶𑆢𑇀𑆫𑆥𑆫𑇀𑆪𑆤𑇀𑆠𑆥𑇀𑆫𑆳𑆪𑆂, 𑆯𑆴𑆯𑆴𑆫𑆥𑆮𑆤𑆧𑆲𑆶𑆬𑆂, 𑆮𑆚𑇀𑆘𑆶𑆬𑆮𑆳𑆤𑆵𑆫𑆾𑆥𑆯𑆾𑆨𑆴𑆠𑆠𑆵𑆫𑆳𑆨𑆴𑆂 𑆱𑆫𑆴𑆢𑇀𑆨𑆴𑆫𑆶𑆥𑆓𑆠𑆨𑆷𑆩𑆴𑆨𑆳𑆓𑆂, 𑆑𑇀𑆰𑆴𑆠𑆴𑆣𑆫𑆤𑆴𑆑𑆶𑆚𑇀𑆘𑆾𑆥𑆯𑆾𑆨𑆴𑆠𑆂, 𑆩𑆤𑇀𑆢𑆥𑆮𑆤𑆳𑆤𑆶𑆮𑆵𑆘𑆴𑆠𑆑𑇀𑆰𑆴𑆠𑆴𑆫𑆶𑆲𑆓𑆲𑆤𑆂, 𑆃𑆤𑆼𑆑𑆮𑆤𑆫𑆳𑆘𑆵𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆮𑆤𑆓𑆲𑆤𑆨𑆷𑆩𑆴𑆨𑆳𑆓𑆂, 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆠𑆫𑆶𑆥𑇀𑆫𑆠𑆳𑆤𑆾𑆥𑆓𑆷𑆞𑆂, 𑆲𑆁𑆱-𑆖𑆑𑇀𑆫𑆮𑆳𑆑-𑆧𑆬𑆳𑆑𑆳-𑆤𑆤𑇀𑆢𑆵𑆩𑆶𑆒-𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑-𑆑𑆳𑆢𑆩𑇀𑆧-𑆩𑆢𑇀𑆓𑆶 -𑆨𑆸𑆕𑇀𑆓𑆫𑆳𑆘-𑆯𑆠𑆥𑆠𑇀𑆫-𑆩𑆠𑇀𑆠𑆑𑆾𑆑𑆴𑆬𑆳𑆤𑆶𑆤𑆳𑆢𑆴𑆠𑆠𑆫𑆶𑆮𑆴𑆛𑆥𑆂, 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆥𑆶𑆫𑆶𑆰𑆂, 𑆥𑆮𑆤𑆑𑆦𑆥𑇀𑆫𑆳𑆪𑆾 𑆘𑇀𑆚𑆼𑆪𑆂; 𑆃𑆤𑆪𑆾𑆫𑆼𑆮 𑆢𑇀𑆮𑆪𑆾𑆫𑇀𑆢𑆼𑆯𑆪𑆾𑆫𑇀𑆮𑆵𑆫𑆶𑆢𑇀𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆯𑆑𑆶𑆤𑆴𑆩𑆸𑆓𑆓𑆟𑆪𑆶𑆠𑆂 𑆱𑇀𑆡𑆴𑆫𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆁𑆲𑆤𑆤𑆾𑆥𑆥𑆤𑇀𑆤𑆱𑆳𑆣𑆳𑆫𑆟𑆓𑆶𑆟𑆪𑆶𑆑𑇀𑆠𑆥𑆶𑆫𑆶𑆰𑆂 𑆱𑆳𑆣𑆳𑆫𑆟𑆾 𑆘𑇀𑆚𑆼𑆪𑆂𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆢𑆼𑆯𑆼 𑆱𑆳𑆣𑆳𑆫𑆟𑆼 𑆘𑆳𑆕𑇀𑆓𑆬𑆼 𑆮𑆳 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆯𑆴𑆯𑆴𑆫𑆳𑆠𑆥𑆥𑆮𑆤𑆱𑆬𑆴𑆬𑆱𑆼𑆮𑆴𑆠𑆼 𑆱𑆩𑆼 𑆯𑆶𑆖𑆿 𑆥𑇀𑆫𑆢𑆑𑇀𑆰𑆴𑆟𑆾𑆢𑆑𑆼 𑆯𑇀𑆩𑆯𑆳𑆤-𑆖𑆽𑆠𑇀𑆪-𑆢𑆼𑆮𑆪𑆘𑆤𑆳𑆓𑆳𑆫-𑆱𑆨𑆳-𑆯𑇀𑆮𑆨𑇀𑆫𑆳𑆫𑆳𑆩-𑆮𑆬𑇀𑆩𑆵𑆑𑆾𑆰𑆫𑆮𑆴𑆫𑆲𑆴𑆠𑆼 𑆑𑆶𑆯𑆫𑆾𑆲𑆴𑆰𑆳𑆱𑇀𑆠𑆵𑆫𑇀𑆟𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆑𑆸𑆰𑇀𑆟𑆩𑆣𑆶𑆫𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆼 𑆱𑆶𑆮𑆫𑇀𑆟𑆮𑆫𑇀𑆟𑆩𑆣𑆶𑆫𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆼 𑆮𑆳 𑆩𑆸𑆢𑆳𑆮𑆦𑆳𑆬𑆑𑆸𑆰𑇀𑆛𑆼𑇁𑆤𑆶𑆥𑆲𑆠𑆼𑇁𑆤𑇀𑆪𑆽𑆫𑇀𑆧𑆬𑆮𑆠𑇀𑆠𑆫𑆽𑆫𑇀𑆢𑇀𑆫𑆶𑆩𑆽𑆫𑆿𑆰𑆣𑆳𑆤𑆴 𑆘𑆳𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇙𑇆
𑆠𑆠𑇀𑆫 𑆪𑆳𑆤𑆴 𑆑𑆳𑆬𑆘𑆳𑆠𑆳𑆤𑇀𑆪𑆶𑆥𑆳𑆓𑆠𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆥𑇀𑆫𑆩𑆳𑆟-𑆫𑆱𑆮𑆵𑆫𑇀𑆪-𑆓𑆤𑇀𑆣𑆳𑆤𑆴 𑆑𑆳𑆬𑆳𑆠𑆥𑆳𑆓𑇀𑆤𑆴𑆱𑆬𑆴𑆬𑆥𑆮𑆤𑆘𑆤𑇀𑆠𑆶𑆨𑆴𑆫𑆤𑆶𑆥𑆲𑆠𑆓𑆤𑇀𑆣-𑆮𑆫𑇀𑆟-𑆫𑆱-𑆱𑇀𑆥𑆫𑇀𑆯-𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆟𑆴 𑆥𑇀𑆫𑆠𑇀𑆪𑆓𑇀𑆫𑆳𑆟𑇀𑆪𑆶𑆢𑆵𑆖𑇀𑆪𑆳𑆁 𑆢𑆴𑆯𑆴 𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆴; 𑆠𑆼𑆰𑆳𑆁 𑆯𑆳𑆒𑆳𑆥𑆬𑆳𑆯𑆩𑆖𑆴𑆫𑆥𑇀𑆫𑆫𑆷𑆞𑆁 𑆮𑆫𑇀𑆰𑆳𑆮𑆱𑆤𑇀𑆠𑆪𑆾𑆫𑇀𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆁, 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆼 𑆩𑆷𑆬𑆳𑆤𑆴 𑆯𑆴𑆯𑆴𑆫𑆼 𑆮𑆳 𑆯𑆵𑆫𑇀𑆟𑆥𑇀𑆫𑆫𑆷𑆞𑆥𑆫𑇀𑆟𑆳𑆤𑆳𑆁, 𑆯𑆫𑆢𑆴 𑆠𑇀𑆮𑆑𑇀𑆑𑆤𑇀𑆢𑆑𑇀𑆰𑆵𑆫𑆳𑆟𑆴, 𑆲𑆼𑆩𑆤𑇀𑆠𑆼 𑆱𑆳𑆫𑆳𑆟𑆴, 𑆪𑆡𑆫𑇀𑆠𑆶 𑆥𑆶𑆰𑇀𑆥𑆦𑆬𑆩𑆴𑆠𑆴; 𑆩𑆕𑇀𑆓𑆬𑆳𑆖𑆳𑆫𑆂 𑆑𑆬𑇀𑆪𑆳𑆟𑆮𑆸𑆠𑇀𑆠𑆂 𑆯𑆶𑆖𑆴𑆂 𑆯𑆶𑆑𑇀𑆬𑆮𑆳𑆱𑆳𑆂 𑆱𑆩𑇀𑆥𑆷𑆘𑇀𑆪 𑆢𑆼𑆮𑆠𑆳 𑆃𑆯𑇀𑆮𑆴𑆤𑆿 𑆓𑆾𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆁𑆯𑇀𑆖 𑆑𑆸𑆠𑆾𑆥𑆮𑆳𑆱𑆂 𑆥𑇀𑆫𑆳𑆕𑇀𑆩𑆶𑆒 𑆇𑆢𑆕𑇀𑆩𑆶𑆒𑆾 𑆮𑆳 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀𑇆𑇑𑇐𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆢𑇀𑆮𑆿 𑆢𑇀𑆮𑆿 𑆨𑆳𑆓𑆿 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆠𑇀𑆫𑆴𑆂𑆱𑆥𑇀𑆠𑆑𑆸𑆠𑇀𑆮𑆂 𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀, 𑆠𑆼𑆤 𑆫𑆱𑆼𑆤 𑆠𑆸𑆠𑆵𑆪𑆁 𑆨𑆳𑆓𑆁 𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆲𑆫𑆵𑆠𑆑𑆵𑆨𑆴𑆫𑇀𑆧𑆴𑆨𑆵𑆠𑆑𑆽𑆫𑆳𑆩𑆬𑆽𑆫𑇀𑆮𑆳 𑆠𑆶𑆬𑇀𑆪𑆳𑆁 𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀, 𑆠𑆳𑆱𑆳𑆩𑆼𑆑𑆳𑆁 𑆢𑇀𑆮𑆼 𑆮𑆳 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆑𑆰𑆳𑆪𑆳𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪𑆳𑆚𑇀𑆘𑆬𑆴𑆩𑆳𑆠𑇀𑆫𑆼𑆟 𑆮𑆴𑆩𑆸𑆢𑇀𑆪 𑆧𑆬𑆮𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆱𑆼𑆑𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆘𑇀𑆮𑆫𑆾𑆢𑆫𑆳𑆫𑆶𑆖𑆴𑆰𑆶 𑆥𑆳𑆪𑆪𑆼𑆢𑆴𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇖𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑇀𑆰𑆵𑆫𑆁, 𑆠𑆼𑆤 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆪𑆮𑆳𑆓𑆷𑆩𑆣𑆾𑆨𑆳𑆓𑆼 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆼 𑆲𑆸𑆢𑇀𑆢𑆳𑆲𑆼 𑆖; 𑆠𑆘𑇀𑆘𑆱𑇀𑆪 𑆮𑆳 𑆢𑆣𑇀𑆤 𑆇𑆠𑇀𑆠𑆫𑆑𑆁 𑆑𑆦𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆠𑆩𑆑𑆥𑇀𑆫𑆱𑆼𑆑𑆼𑆰𑆶 ; 𑆠𑆱𑇀𑆪 𑆮𑆳 𑆥𑆪𑆱𑆂 𑆯𑆵𑆠𑆱𑇀𑆪 𑆱𑆤𑇀𑆠𑆳𑆤𑆴𑆑𑆳𑆚𑇀𑆘𑆬𑆴𑆁 𑆥𑆴𑆠𑇀𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆼 𑆇𑆫𑆂𑆑𑆟𑇀𑆜𑆲𑆸𑆢𑆪𑆼 𑆖 𑆠𑆤𑆶𑆑𑆦𑆾𑆥𑆢𑆴𑆓𑇀𑆣𑆼, 𑆅𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇗𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆯𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆳𑆤𑇀𑆤𑆮𑆤𑆵𑆠𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆁 𑆦𑆬𑆳𑆢𑆴𑆑𑆬𑇀𑆑𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑆦𑆳𑆨𑆴𑆨𑆷𑆠𑆳𑆓𑇀𑆤𑆴𑆁 𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆢𑇀𑆢𑆼𑆲𑆁 𑆖 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆥𑆳𑆪𑆪𑆼𑆢𑆴𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇘𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆦𑆬𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆠𑇀𑆫𑆴𑆂𑆱𑆥𑇀𑆠𑆑𑆸𑆠𑇀𑆮𑆂 𑆱𑆶𑆥𑆫𑆴𑆨𑆳𑆮𑆴𑆠𑆼𑆤 𑆥𑆶𑆰𑇀𑆥𑆫𑆘𑆂𑆥𑇀𑆫𑆑𑆳𑆯𑆼𑆤 𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆱𑆫𑆱𑆴 𑆱𑆚𑇀𑆘𑆳𑆠𑆁 𑆧𑆸𑆲𑆠𑇀𑆱𑆫𑆾𑆫𑆶𑆲𑆁 𑆱𑆳𑆪𑆳𑆲𑇀𑆤𑆼𑇁𑆮𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀, 𑆠𑆢𑇀𑆫𑆳𑆠𑇀𑆫𑆴𑆮𑇀𑆪𑆶𑆰𑆴𑆠𑆁 𑆥𑇀𑆫𑆨𑆳𑆠𑆼 𑆥𑆶𑆤𑆫𑆮𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆸𑆱𑆫𑆑𑇀𑆰𑆵𑆫𑆪𑆮𑆳𑆓𑆷𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆓𑆶𑆝𑆦𑆳𑆟𑆴𑆠𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆑𑆟𑇀𑆜𑆁 𑆥𑆵𑆠𑆮𑆤𑇀𑆠𑆩𑆳𑆔𑇀𑆫𑆳𑆥𑆪𑆼𑆠𑇀 𑆱𑆶𑆑𑆶𑆩𑆳𑆫𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆩𑆿𑆰𑆣𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆩𑆴𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇑𑇙𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆴𑆥𑆫𑆴𑆱𑇀𑆫𑆶𑆠𑆁 𑆱𑇀𑆮𑆫𑆱𑆁 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆦𑆳𑆟𑆴𑆠𑆵𑆨𑆷𑆠𑆩𑆳𑆠𑆤𑇀𑆠𑆶𑆬𑆵𑆨𑆳𑆮𑆳𑆬𑇀𑆬𑆼𑆲𑆪𑆼𑆠𑇀; 𑆄𑆠𑆥𑆯𑆶𑆰𑇀𑆑𑆁 𑆮𑆳 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑆁 𑆘𑆵𑆩𑆷𑆠𑆑𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆼𑆟 𑆥𑆴𑆠𑇀𑆠𑆼 𑆑𑆦𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆼 𑆥𑆳𑆪𑆪𑆼𑆢𑆴𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇒𑇐𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆦𑆬𑆳𑆢𑆵𑆤𑆳𑆁 𑆰𑆟𑇀𑆟𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆑𑆰𑆳𑆪𑆱𑇀𑆫𑆶𑆠𑆳𑆤𑆴 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆦𑆬𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆾𑆥𑆱𑆫𑇀𑆘𑆤𑆳𑆂 𑆥𑆼𑆪𑆳 𑆅𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇒𑇑𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆤𑆳𑆩𑆳𑆫𑆓𑇀𑆮𑆣 -𑆮𑆸𑆑𑇀𑆰𑆑-𑆱𑇀𑆮𑆳𑆢𑆶𑆑𑆟𑇀𑆛𑆑-𑆥𑆳𑆜𑆳-𑆥𑆳𑆛𑆬𑆳-𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆼𑆰𑇀𑆛𑆳-𑆩𑆷𑆫𑇀𑆮𑆳-𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟-𑆤𑆑𑇀𑆠𑆩𑆳𑆬-𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢-𑆥𑆛𑆾𑆬-𑆱𑆶𑆰𑆮𑆵-𑆓𑆶𑆝𑆷𑆖𑆵-𑆱𑆾𑆩𑆮𑆬𑇀𑆑-𑆢𑇀𑆮𑆵𑆥𑆴𑆑𑆳𑆤𑆳𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵-𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬-𑆲𑆱𑇀𑆠𑆴𑆥𑆴𑆥𑇀𑆥𑆬𑆵-𑆖𑆴𑆠𑇀𑆫𑆑-𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆳𑆟𑆳𑆁 𑆖𑆳𑆤𑇀𑆪𑆠𑆩𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆴𑆢𑇀𑆣𑆾 𑆬𑆼𑆲 𑆅𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇒𑇒𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆰𑇀𑆮𑆼𑆬𑆳-𑆲𑆫𑆼𑆟𑆶𑆑𑆳-𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳-𑆑𑆶𑆱𑇀𑆠𑆶𑆩𑇀𑆧𑆶𑆫𑆶-𑆠𑆓𑆫-𑆑𑆶𑆰𑇀𑆜-𑆠𑇀𑆮𑆑𑇀-𑆖𑆾𑆫𑆑-𑆩𑆫𑆶𑆧𑆑𑆳𑆓𑆶𑆫𑆶-𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑇀𑆮𑆼𑆬𑆮𑆳𑆬𑆶𑆑-𑆯𑇀𑆫𑆵𑆮𑆼𑆰𑇀𑆛𑆑-𑆥𑆫𑆴𑆥𑆼𑆬𑆮-𑆩𑆳𑆁𑆱𑆵-𑆯𑆽𑆬𑆼𑆪𑆑-𑆱𑇀𑆡𑆿𑆟𑆼𑆪𑆑-𑆱𑆫𑆬-𑆥𑆳𑆫𑆳𑆮𑆠𑆥𑆢𑇀𑆪𑆯𑆾𑆑𑆫𑆾𑆲𑆴𑆟𑆵𑆤𑆳𑆁 𑆮𑆴𑆁𑆯𑆠𑆼𑆫𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆱𑆳𑆣𑆴𑆠𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳 𑆇𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆑𑆬𑇀𑆥𑆼𑆤, 𑆩𑆾𑆢𑆑𑆳 𑆮𑆳 𑆩𑆾𑆢𑆑𑆑𑆬𑇀𑆥𑆼𑆤, 𑆪𑆡𑆳𑆢𑆾𑆰𑆫𑆾𑆓𑆨𑆑𑇀𑆠𑆴 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆳 𑆅𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇒𑇓𑇆
𑆦𑆬𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑇀𑆮𑆫𑆱𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆨𑆳𑆮𑆴𑆠𑆳𑆤𑆴 𑆠𑆴𑆬𑆯𑆳𑆬𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑆴 𑆠𑆠𑇀𑆑𑆰𑆳𑆪𑆾𑆥𑆱𑆫𑇀𑆘𑆤𑆳𑆤𑆴 𑆯𑆰𑇀𑆑𑆶𑆬𑆵𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆳 𑆯𑆰𑇀𑆑𑆶𑆬𑇀𑆪𑆂, 𑆥𑆷𑆥𑆑𑆬𑇀𑆥𑆼𑆤 𑆮𑆳 𑆥𑆷𑆥𑆳𑆂 𑆅𑆠𑆴 𑆱𑆩𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑇆𑇒𑇔𑇆
𑆍𑆠𑆼𑆤𑆽𑆮 𑆖 𑆑𑆬𑇀𑆥𑆼𑆤 𑆱𑆶𑆩𑆶𑆒-𑆱𑆶𑆫𑆱-𑆑𑆶𑆜𑆼𑆫𑆑-𑆑𑆳𑆟𑇀𑆝𑆵𑆫-𑆑𑆳𑆬𑆩𑆳𑆬𑆑-𑆥𑆫𑇀𑆟𑆳𑆱𑆑-𑆑𑇀𑆰𑆮𑆑-𑆦𑆟𑆴𑆘𑇀𑆙𑆑-𑆓𑆸𑆚𑇀𑆘𑆤-𑆑𑆳𑆱𑆩𑆫𑇀𑆢-𑆨𑆸𑆕𑇀𑆓𑆫𑆳𑆘𑆳𑆤𑆳𑆁 𑆥𑆾𑆛𑆼𑆑𑇀𑆰𑆶𑆮𑆳𑆬𑆴𑆑𑆳-𑆑𑆳𑆬𑆕𑇀𑆑𑆠𑆑-𑆢𑆟𑇀𑆝𑆽𑆫𑆑𑆳𑆟𑆳𑆁 𑆖𑆳𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇆𑇒𑇕𑇆
𑆠𑆡𑆳 𑆧𑆢𑆫𑆰𑆳𑆝𑆮-𑆫𑆳𑆓-𑆬𑆼𑆲-𑆩𑆾𑆢𑆑𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳-𑆠𑆫𑇀𑆥𑆟-𑆥𑆳𑆤𑆑-𑆩𑆳𑆁𑆱𑆫𑆱-𑆪𑆷𑆰-𑆩𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆩𑆢𑆤𑆦𑆬𑆳𑆤𑇀𑆪𑆤𑇀𑆪𑆠𑆩𑆼𑆤𑆾𑆥𑆱𑆸𑆘𑇀𑆪 𑆪𑆡𑆳𑆢𑆾𑆰𑆫𑆾𑆓𑆨𑆑𑇀𑆠𑆴 𑆢𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆽𑆂 𑆱𑆳𑆣𑆶 𑆮𑆩𑆠𑆵𑆠𑆴𑇆𑇒𑇖𑇆
𑆩𑆢𑆤𑆂 𑆑𑆫𑆲𑆳𑆛𑆯𑇀𑆖 𑆫𑆳𑆜𑆂 𑆥𑆴𑆟𑇀𑆝𑆵𑆠𑆑𑆂 𑆦𑆬𑆩𑇀𑇅 𑆯𑇀𑆮𑆱𑆤𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑆠𑆱𑇀𑆪 𑆑𑆬𑇀𑆥𑆤𑆳𑇆𑇒𑇗𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆤𑆮 𑆪𑆾𑆓𑆳𑆂 𑆑𑆰𑆳𑆪𑆼𑆰𑆶, 𑆩𑆳𑆠𑇀𑆫𑆳𑆱𑇀𑆮𑆰𑇀𑆛𑆿 , 𑆥𑆪𑆾𑆔𑆸𑆠𑆼𑇅 𑆥𑆚𑇀𑆖, 𑆦𑆳𑆟𑆴𑆠𑆖𑆷𑆫𑇀𑆟𑆼 𑆢𑇀𑆮𑆿 𑆔𑇀𑆫𑆼𑆪𑆼, 𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆰𑆛𑇀𑇆𑇒𑇘𑇆
𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑇀𑆬𑆼𑆲𑆩𑆾𑆢𑆑𑆾𑆠𑇀𑆑𑆳𑆫𑆴𑆑𑆳𑆱𑆶 𑆖𑇅 𑆯𑆰𑇀𑆑𑆶𑆬𑆵𑆥𑆷𑆥𑆪𑆾𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆪𑆾𑆓𑆳𑆂 𑆰𑆾𑆝𑆯 𑆰𑆾𑆝𑆯𑇆𑇒𑇙𑇆
𑆢𑆯𑆳𑆤𑇀𑆪𑆼 𑆰𑆳𑆝𑆮𑆳𑆢𑇀𑆪𑆼𑆰𑆶 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑆴𑆢𑆁 𑆯𑆠𑆩𑇀𑇅 𑆪𑆾𑆓𑆳𑆤𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆦𑆬𑆑𑆬𑇀𑆥𑆼 𑆩𑆲𑆫𑇀𑆰𑆴𑆟𑆳𑇆𑇓𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆘𑆵𑆩𑆷𑆠𑆑𑆑𑆬𑇀𑆥𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆑𑆬𑇀𑆥𑆁 𑆘𑆵𑆩𑆷𑆠𑆑𑆱𑇀𑆪𑆼𑆩𑆁 𑆦𑆬𑆥𑆶𑆰𑇀𑆥𑆳𑆯𑇀𑆫𑆪𑆁 𑆯𑆶𑆟𑆶𑇅 𑆓𑆫𑆳𑆓𑆫𑆵 𑆖 𑆮𑆼𑆟𑆵 𑆖 𑆠𑆡𑆳 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆼𑆮𑆠𑆳𑆝𑆑𑆂𑇆𑇓𑇆
𑆘𑆵𑆩𑆷𑆠𑆑𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆔𑇀𑆤𑆁 𑆪𑆡𑆳𑆱𑇀𑆮𑆿𑆰𑆣𑆑𑆬𑇀𑆥𑆴𑆠𑆩𑇀𑇅 𑆥𑇀𑆫𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆢𑇀𑆪𑆼𑆰𑇀𑆮𑆳𑆩𑆪𑆼𑆰𑆶 𑆖𑇆𑇔𑇆
𑆪𑆡𑆾𑆑𑇀𑆠𑆓𑆶𑆟𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆼𑆯𑆘𑆳𑆤𑆳𑆁 𑆪𑆡𑆳𑆮𑆴𑆣𑆴𑇅 𑆥𑆪𑆂 𑆥𑆶𑆰𑇀𑆥𑆼𑇁𑆱𑇀𑆪, 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆼 𑆦𑆬𑆼 𑆥𑆼𑆪𑆳 𑆥𑆪𑆱𑇀𑆑𑆸𑆠𑆳𑇆𑇕𑇆
𑆬𑆾𑆩𑆯𑆼 𑆑𑇀𑆰𑆵𑆫𑆱𑆤𑇀𑆠𑆳𑆤𑆁, 𑆢𑆣𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆩𑆬𑆾𑆩𑆯𑆼𑇅 𑆯𑆸𑆠𑆼 𑆥𑆪𑆱𑆴 𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆁 𑆘𑆳𑆠𑆁 𑆲𑆫𑆴𑆠𑆥𑆳𑆟𑇀𑆝𑆶𑆑𑆼𑇆𑇖𑇆
𑆘𑆵𑆫𑇀𑆟𑆳𑆤𑆳𑆁 𑆖 𑆱𑆶𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑆳𑆁 𑆤𑇀𑆪𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆨𑆳𑆘𑆤𑆼 𑆯𑆶𑆖𑆿𑇅 𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆪 𑆥𑆪𑆱𑆳 𑆯𑆶𑆑𑇀𑆠𑆴𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆫𑇀𑆢𑆴𑆠𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇗𑇆
𑆄𑆱𑆶𑆠𑇀𑆪 𑆖 𑆱𑆶𑆫𑆳𑆩𑆟𑇀𑆝𑆼 𑆩𑆸𑆢𑆴𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆑𑆦𑆘𑆼𑇁𑆫𑆾𑆖𑆑𑆼 𑆑𑆳𑆱𑆼 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆼 𑆱𑆪𑆑𑇀𑆰𑇀𑆩𑆟𑆴𑇆𑇘𑇆
𑆢𑇀𑆮𑆼 𑆖𑆳𑆥𑆾𑆡𑇀𑆪𑆳𑆡𑆮𑆳 𑆠𑇀𑆫𑆵𑆟𑆴 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆳 𑆩𑆣𑆶𑆑𑆱𑇀𑆪 𑆮𑆳𑇅 𑆑𑆾𑆮𑆴𑆢𑆳𑆫𑆳𑆢𑆴𑆑𑆳𑆤𑆳𑆁 𑆮𑆳 𑆤𑆴𑆩𑇀𑆧𑆱𑇀𑆪 𑆑𑆶𑆛𑆘𑆱𑇀𑆪 𑆮𑆳𑇆𑇙𑇆
𑆑𑆰𑆳𑆪𑆼𑆰𑇀𑆮𑆳𑆱𑆶𑆠𑆁 𑆥𑆷𑆠𑇀𑆮𑆳 𑆠𑆼𑆤𑆽𑆮 𑆮𑆴𑆣𑆴𑆤𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆃𑆡𑆮𑆳𑇁𑇁𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆥𑇀𑆠𑆳𑆤𑆳𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇐𑇆

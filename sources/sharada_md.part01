𑆍𑆰𑇀𑆮𑆼𑆮 𑆠𑆽𑆬𑆁 𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆁 𑆤𑆱𑇀𑆪𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼𑆰𑆶 𑆥𑆷𑆘𑆴𑆠𑆩 𑆍𑆠𑆳𑆤𑆼𑆮𑆳𑆩𑆪𑆳𑆤𑇀 𑆲𑆤𑇀𑆠𑆴 𑆪𑆼 𑆖 𑆢𑆶𑆰𑇀𑆛𑆮𑇀𑆫𑆟𑆳 𑆤𑆸𑆟𑆳𑆩𑇀 𑇆𑇖𑇗𑇆
𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆁 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆳𑆁 𑆢𑆤𑇀𑆠𑆵𑆁 𑆤𑆵𑆬𑆵𑆁 𑆯𑇀𑆪𑆳𑆩𑆳𑆁 𑆠𑆡𑆽𑆮 𑆖 𑇅 𑆱𑆥𑇀𑆠𑆬𑆳𑆁 𑆯𑆕𑇀𑆒𑆴𑆤𑆵𑆁 𑆖𑆽𑆮 𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆓𑆳𑆬𑆪𑆼𑆠𑇀 𑇆𑇖𑇘𑇆
𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆖 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑇀𑆮𑆳𑆡𑆩𑆼𑆰 𑆑𑇀𑆰𑆳𑆫𑆱𑇀𑆠𑆶 𑆱𑆳𑆣𑆴𑆠𑆂 𑇅 𑆃𑆣𑆾 𑆓𑆖𑇀𑆗𑆠𑆴 𑆥𑆵𑆠𑆱𑇀𑆠𑆶 𑆥𑆷𑆫𑇀𑆮𑆽𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆳𑆯𑆴𑆰𑆂 𑆱𑆩𑆳𑆂 𑇆𑇖𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆫𑆾𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆠𑆠𑇀𑆫𑆳𑆘𑆓𑆬𑇀𑆬𑆴𑆑𑆳𑆩𑆳𑆩𑆳𑆁 𑆘𑆬𑆿𑆑𑆾𑆨𑆴𑆫𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆯𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆫𑆶𑆔𑇀𑆤𑆵𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆑𑆬𑇀𑆑𑆽𑆯𑇀𑆖𑆳𑆬𑆼𑆥𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇓𑇆
𑆯𑇀𑆪𑆳𑆩𑆳𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑆴𑆥𑆳𑆜𑆳𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑆴 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆥𑆑𑇀𑆮𑆳𑆁 𑆮𑇀𑆫𑆟𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆪𑆡𑆾𑆑𑇀𑆠𑆼𑆤 𑆥𑇀𑆫𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇆𑇔𑇆
𑆃𑆤𑇀𑆣𑆳𑆬𑆘𑆵𑆁 𑆪𑆮𑆥𑇀𑆫𑆒𑇀𑆪𑆳𑆁 𑆥𑆤𑆱𑆵𑆁 𑆑𑆖𑇀𑆗𑆥𑆵𑆁 𑆠𑆡𑆳 𑇅 𑆥𑆳𑆰𑆳𑆟𑆓𑆫𑇀𑆢𑆨𑆁 𑆖𑆽𑆮 𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑇀𑆮𑆼𑆢𑆼𑆤 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆠𑆳𑆬𑆑𑆶𑆰𑇀𑆜𑆢𑆳𑆫𑆶𑆑𑆬𑇀𑆑𑆽𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇅 𑆥𑆫𑆴𑆥𑆳𑆑𑆓𑆠𑆳𑆤𑇀 𑆨𑆴𑆠𑇀𑆠𑇀𑆮𑆳 𑆮𑇀𑆫𑆟𑆮𑆠𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇖𑇆
𑆮𑆴𑆮𑆸𑆠𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆖 𑆓𑆫𑇀𑆢𑆨𑆵𑆁 𑆘𑆳𑆬𑆓𑆫𑇀𑆢𑆨𑆩𑇀 𑇅 𑆅𑆫𑆴𑆮𑆼𑆬𑇀𑆬𑆵𑆁 𑆓𑆤𑇀𑆣𑆤𑆳𑆩𑇀𑆤𑆵𑆁 𑆑𑆑𑇀𑆰𑆳𑆁 𑆮𑆴𑆱𑇀𑆦𑆾𑆛𑆑𑆳𑆁𑆱𑇀𑆠𑆡𑆳 𑇆𑇗𑇆
𑆥𑆴𑆠𑇀𑆠𑆘𑆱𑇀𑆪 𑆮𑆴𑆱𑆫𑇀𑆥𑆱𑇀𑆪 𑆑𑇀𑆫𑆴𑆪𑆪𑆳 𑆱𑆳𑆣𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇅 𑆫𑆾𑆥𑆪𑆼𑆠𑇀 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆥𑆑𑇀𑆮𑆳𑆤𑇀 𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆽𑆂 𑇆𑇘𑇆
𑆖𑆴𑆥𑇀𑆪 (𑆥𑇀𑆥) 𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆱𑆴𑆑𑇀𑆠𑆩𑆶𑆠𑇀𑆑𑆸𑆠𑇀𑆪 𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇅 𑆖𑆑𑇀𑆫𑆠𑆽𑆬𑆼𑆤 𑆖𑆳𑆨𑇀𑆪𑆘𑇀𑆪 𑆱𑆫𑇀𑆘𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀 𑇆𑇙𑇆
𑆧𑆤𑇀𑆣𑆼𑆤𑆾𑆥𑆖𑆫𑆼𑆖𑇀𑆖𑆽𑆤𑆩𑆯𑆑𑇀𑆪𑆁 𑆖𑆳𑆓𑇀𑆤𑆴𑆤𑆳 𑆢𑆲𑆼𑆠𑇀 𑇅 𑆩𑆣𑆶𑆫𑆿𑆰𑆣𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆠𑆠𑆱𑇀𑆠𑆽𑆬𑆼𑆤 𑆫𑆾𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆑𑆶𑆤𑆒𑆼 𑆮𑆴𑆣𑆴𑆫𑆥𑇀𑆪𑆼𑆰 𑆑𑆳𑆫𑇀𑆪𑆾 𑆲𑆴 𑆨𑆴𑆰𑆘𑆳 𑆨𑆮𑆼𑆠𑇀 𑇅 𑆇𑆥𑆳𑆖𑆫𑆼𑆢𑆤𑆶𑆯𑆪𑆵𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆮𑆴𑆢𑇀𑆫𑆣𑆴𑆮𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑇆𑇑𑇑𑇆
𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳𑆁 𑆱𑆩𑆨𑇀𑆪𑆘𑇀𑆪 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆁 𑆮𑆴𑆩𑇀𑆬𑆳𑆥𑇀𑆪 𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇅 𑆤𑆓𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆧𑆴𑆬𑇀𑆮𑆩𑆷𑆬𑆽𑆂 𑆱𑆶𑆥𑆼𑆰𑆴𑆠𑆽𑆂 𑇆𑇑𑇒𑇆
𑆮𑇀𑆫𑆟𑆨𑆳𑆮𑆓𑆠𑆳𑆪𑆳𑆁 𑆮𑆳 𑆑𑆸𑆠𑇀𑆮𑆳 𑆱𑆁𑆯𑆾𑆣𑆤𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀 𑇅 𑆫𑆾𑆥𑆟𑆳𑆫𑇀𑆡𑆁 𑆲𑆴𑆠𑆁 𑆠𑆽𑆬𑆁 𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆽𑆂 𑆯𑆸𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆥𑇀𑆫𑆖𑇀𑆗𑆳𑆤𑆽𑆫𑇀𑆮𑆳 𑆘𑆬𑆿𑆑𑆾𑆨𑆴𑆂 𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳𑇁𑆥𑆑𑇀𑆮𑆳 𑆮𑆴𑆢𑆳𑆫𑆴𑆑𑆳 𑇅 𑆃𑆘𑆑𑆫𑇀𑆟𑆽𑆂 𑆱𑆥𑆳𑆬𑆳𑆯𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆽𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆥𑆑𑇀𑆮𑆳𑆁 𑆮𑆴𑆢𑆳𑆫𑇀𑆪 𑆯𑆱𑇀𑆠𑇀𑆫𑆼𑆟 𑆥𑆛𑆾𑆬𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆪𑆾𑆂 𑇅 𑆑𑆬𑇀𑆑𑆼𑆤 𑆠𑆴𑆬𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆴𑆯𑇀𑆫𑆼𑆟 𑆬𑆼𑆥𑆪𑆼𑆠𑇀 𑇆𑇑𑇕𑇆
𑆧𑆢𑇀𑆣𑇀𑆮𑆳 𑆖 𑆑𑇀𑆰𑆵𑆫𑆮𑆸𑆑𑇀𑆰𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆽𑆂 𑆒𑆢𑆴𑆫𑆱𑇀𑆪 𑆖 𑇅 𑆮𑇀𑆫𑆟𑆁 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆪𑆼𑆖𑇀𑆗𑆶𑆢𑇀𑆣𑆳𑆁 𑆠𑆠𑆱𑇀𑆠𑆳𑆁 𑆫𑆾𑆥𑆪𑆼𑆠𑇀 𑆥𑆶𑆤𑆂 𑇆𑇑𑇖𑇆
𑆩𑆼𑆢𑆾𑇁𑆫𑇀𑆧𑆶𑆢𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆱𑆳𑆣𑆪𑆼𑆖𑇀𑆗𑆫𑇀𑆑𑆫𑆳𑆫𑇀𑆧𑆶𑆢𑆩𑇀 𑇅 𑆑𑆖𑇀𑆗𑆷𑆁 𑆮𑆴𑆖𑆫𑇀𑆖𑆴𑆑𑆳𑆁 𑆥𑆳𑆩𑆳𑆁 𑆑𑆶𑆰𑇀𑆜𑆮𑆠𑇀 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇑𑇗𑇆
𑆬𑆼𑆥𑆯𑇀𑆖 𑆯𑆱𑇀𑆪𑆠𑆼 𑆱𑆴𑆑𑇀𑆡𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆓𑆿𑆫𑆱𑆫𑇀𑆰𑆥𑆽𑆂 𑇅 𑆮𑆖𑆳𑆢𑆳𑆫𑇀𑆮𑆵𑆱𑆫𑇀𑆰𑆥𑆽𑆫𑇀𑆮𑆳 𑆠𑆽𑆬𑆁 𑆮𑆳 𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆘𑆩𑇀 𑇆𑇑𑇘𑇆
𑆱𑆳𑆫𑆠𑆽𑆬𑆩𑆡𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆑𑆛𑆶𑆑𑆽𑆂 𑆯𑆸𑆠𑆩𑇀 𑇅 𑆥𑆳𑆢𑆢𑆳𑆫𑇀𑆪𑆳𑆁 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆿 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇑𑇙𑇆

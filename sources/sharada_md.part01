𑆢𑆫𑇀𑆯𑆪𑆤𑇀𑆠𑆴 𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆱𑇀𑆠𑆶 𑆮𑆴𑆯𑇀𑆮𑆫𑆷𑆥𑆳𑆤𑇀𑆤𑆴𑆱𑆫𑇀𑆓𑆠𑆂 𑇅 𑆃𑆥𑆱𑇀𑆩𑆳𑆫𑆾 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆱𑇀𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆾𑆰𑆘 𑆍𑆮 𑆠𑆶 𑇆𑇒𑇑𑇆
𑆠𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆾 𑆮𑆴𑆣𑆴𑆂 𑆱𑆫𑇀𑆮𑆾 𑆪 𑆇𑆤𑇀𑆩𑆳𑆢𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇅 𑆥𑆶𑆫𑆳𑆟𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆥𑆳𑆤𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆯𑇀𑆖𑆽𑆮 𑆥𑆷𑆘𑆴𑆠𑆂 𑇆𑇒𑇒𑇆
𑆇𑆥𑆪𑆾𑆓𑆾 𑆓𑇀𑆫𑆲𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆪𑆾𑆓𑆳𑆤𑆳𑆁 𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇅 𑆠𑆠𑆂 𑆱𑆴𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆠𑆼 𑆱𑆫𑇀𑆮𑆼 𑆪𑆾𑆓𑆽𑆫𑆤𑇀𑆪𑆽𑆯𑇀𑆖 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑇅 𑆯𑆴𑆓𑇀𑆫𑆶𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆑𑆴𑆟𑇀𑆮𑆳𑆲𑆴𑆤𑆴𑆩𑇀𑆧𑆠𑇀𑆮𑆓𑇀𑆫𑆱𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇆𑇒𑇓𑇆
𑆥𑆴𑆠𑇀𑆠𑆼𑆰𑆶 𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁 𑆖 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼𑆰𑆶 𑆥𑆷𑆘𑆴𑆠𑆩𑇀 𑇅𑇒𑇕𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆽𑆫𑆶𑆨𑆪𑆠𑆾𑆨𑆳𑆓𑆽𑆂 𑆯𑆴𑆫𑆯𑇀𑆖𑆳𑆥𑆴 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇒𑇕𑇆
𑆥𑆷𑆘𑆳𑆁 𑆫𑆶𑆢𑇀𑆫𑆱𑇀𑆪 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆠𑆢𑇀𑆓𑆟𑆳𑆤𑆳𑆁 𑆖 𑆤𑆴𑆠𑇀𑆪𑆯𑆂 𑇅𑇒𑇖𑇅 𑆮𑆳𑆠𑆴𑆑𑆁 𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆁 𑆠𑆶 𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂 𑇆𑇒𑇖𑇆
𑆑𑆦𑆘𑆁 𑆮𑆩𑆤𑆽𑆫𑇀𑆣𑆵𑆩𑆳𑆤𑆥𑆱𑇀𑆩𑆳𑆫𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅𑇒𑇗𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆪𑆮𑆑𑆾𑆬𑆳𑆤𑆴 𑆯𑆟𑆧𑆵𑆘𑆁 𑆥𑆬𑆕𑇀𑆑𑆰𑆳𑆩𑇀 𑇆𑇒𑇗𑇆
𑆘𑆛𑆴𑆬𑆳𑆁 𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑇀𑆪𑆿 𑆢𑇀𑆮𑆼 𑆥𑆡𑇀𑆪𑆳𑆁 𑆖𑆾𑆠𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆪𑆠𑇀𑆤𑆠𑆂 𑇅 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆪𑆶𑆠𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆖𑆼𑆠𑇀𑆠𑆢𑇀𑆮𑆳𑆠𑆴𑆑𑆼 𑆲𑆴𑆠𑆩𑇀 𑇆𑇒𑇘𑇆
𑆑𑆳𑆑𑆾𑆬𑇀𑆪𑆳𑆢𑆴𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆥𑇀𑆫𑆡𑆩𑆼 𑆓𑆟𑆼 𑇅 𑆥𑆪𑆾𑆩𑆣𑆶𑆱𑆴𑆠𑆳𑆪𑆶𑆑𑇀𑆠𑆁 𑆔𑆸𑆠𑆁 𑆠𑆠𑇀 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆲𑆴𑆠𑆩𑇀 𑇆𑇒𑇙𑇆
𑆑𑆸𑆰𑇀𑆟𑆳𑆮𑆖𑆳𑆩𑆶𑆱𑇀𑆠𑆑𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆩𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆼 𑇅 𑆥𑆑𑇀𑆮𑆁 𑆖 𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆓𑆼 𑆠𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆴𑆟𑆼 𑆲𑆴𑆠𑆩𑇀 𑇆𑇓𑇐𑇆
𑆱𑆶𑆫𑆢𑇀𑆫𑆶𑆩𑆮𑆖𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆮𑇀𑆪𑆾𑆰𑆲𑆴𑆕𑇀𑆓𑆶𑆨𑆴𑆂 𑇅 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆫𑆘𑆤𑆵𑆪𑆶𑆓𑇀𑆩𑆱𑆩𑆕𑇀𑆓𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆩𑇀𑆧𑆶𑆢𑆽𑆂 𑇆𑇓𑇑𑇆
𑆑𑆫𑆚𑇀𑆘𑆧𑆵𑆘𑆯𑆽𑆫𑆵𑆰𑆓𑆴𑆫𑆴𑆑𑆫𑇀𑆟𑆵𑆲𑆶𑆠𑆳𑆯𑆤𑆽𑆂 𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆁 𑆤𑆳𑆩 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀 𑇆𑇓𑇒𑇆
𑆑𑆸𑆩𑆴𑆑𑆶𑆰𑇀𑆜𑆓𑆫𑆯𑇀𑆮𑆳𑆱𑆧𑆬𑆳𑆱𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆤𑇀 𑇅 𑆱𑆫𑇀𑆮𑆨𑆷𑆠𑆓𑇀𑆫𑆲𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆤𑆥𑆱𑇀𑆩𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀 𑇆𑇓𑇓𑇆
𑆢𑆯𑆩𑆷𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆮𑆸𑆑𑇀𑆰𑆠𑇀𑆮𑆕𑇀𑆩𑆷𑆫𑇀𑆮𑆳𑆨𑆳𑆫𑇀𑆓𑆵𑆦𑆬𑆠𑇀𑆫𑆴𑆑𑆽𑆂 𑇅 𑆯𑆩𑇀𑆥𑆳𑆑𑆯𑇀𑆫𑆼𑆪𑆱𑆵𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆥𑆳𑆩𑆳𑆫𑇀𑆓𑆦𑆬𑇀𑆓𑆶𑆨𑆴𑆂 𑇆𑇓𑇔𑇆
𑆯𑆸𑆠𑆽𑆂 𑆑𑆬𑇀𑆑𑆽𑆯𑇀𑆖 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆥𑆷𑆠𑆵𑆑𑆮𑇀𑆪𑆾𑆰𑆖𑆴𑆠𑇀𑆫𑆑𑆽𑆂 𑇅 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆥𑆳𑆜𑆳𑆤𑆴𑆯𑆳𑆪𑆶𑆓𑇀𑆩𑆱𑆳𑆫𑆴𑆮𑆳𑆢𑇀𑆮𑆪𑆥𑆿𑆰𑇀𑆑𑆫𑆽𑆂 𑇆𑇓𑇕𑇆
𑆑𑆛𑆶𑆑𑆳𑆪𑆳𑆱𑆢𑆤𑇀𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆳𑆤𑆵𑆬𑆴𑆤𑆵𑆑𑇀𑆫𑆴𑆩𑆴𑆯𑆠𑇀𑆫𑆶𑆨𑆴𑆂 𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑆼𑆨𑆴𑆯𑇀𑆖 𑆓𑆾𑆑𑇀𑆰𑆵𑆫𑆢𑆣𑆴𑆩𑆷𑆠𑇀𑆫𑆯𑆑𑆸𑆢𑇀𑆫𑆱𑆽𑆂 𑇆𑇓𑇖𑇆
𑆱𑆳𑆣𑆴𑆠𑆁 𑆥𑆚𑇀𑆖𑆓𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆁 𑆱𑆫𑇀𑆮𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆨𑆷𑆠𑆤𑆶𑆠𑇀 𑇅 𑆖𑆳𑆠𑆶𑆫𑇀𑆡𑆑𑆑𑇀𑆰𑆪𑆯𑇀𑆮𑆳𑆱𑆳𑆤𑆶𑆤𑇀𑆩𑆳𑆢𑆳𑆁𑆯𑇀𑆖 𑆤𑆴𑆪𑆖𑇀𑆗𑆠𑆴 𑇆𑇓𑇗𑇆
𑆨𑆳𑆫𑇀𑆓𑆵𑆯𑆸𑆠𑆼 𑆥𑆖𑆼𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆼 𑆯𑆳𑆬𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆥𑆳𑆪𑆱𑆩𑇀 𑇅 𑆠𑇀𑆫𑇀𑆪𑆲𑆁 𑆯𑆶𑆢𑇀𑆣𑆳𑆪 𑆠𑆁 𑆨𑆾𑆑𑇀𑆠𑆶𑆁 𑆮𑆫𑆳𑆲𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀 𑇆𑇓𑇘𑇆
𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆖 𑆩𑆣𑆶𑆫𑆵𑆨𑆷𑆠𑆁 𑆠𑆁 𑆮𑆴𑆯𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆩𑆶𑆢𑇀𑆣𑆫𑆼𑆠𑇀 𑇅 𑆠𑇀𑆫𑆵𑆤𑇀 𑆨𑆳𑆓𑆳𑆁𑆱𑇀𑆠𑆱𑇀𑆪 𑆖𑆷𑆫𑇀𑆟𑆱𑇀𑆪 𑆑𑆴𑆟𑇀𑆮𑆨𑆳𑆓𑆼𑆤 𑆱𑆁𑆱𑆸𑆘𑆼𑆠𑇀 𑇆𑇓𑇙𑇆
𑆩𑆟𑇀𑆝𑆾𑆢𑆑𑆳𑆫𑇀𑆡𑆼 𑆢𑆼𑆪𑆯𑇀𑆖 𑆨𑆳𑆫𑇀𑆓𑆵𑆑𑇀𑆮𑆳𑆡𑆂 𑆱𑆶𑆯𑆵𑆠𑆬𑆂 𑇅 𑆯𑆶𑆢𑇀𑆣𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆖𑇀𑆖 𑆱𑆩𑇀𑆨𑆳𑆫𑆁 𑆠𑆁 𑆱𑆶𑆫𑆳𑆁 𑆠𑆠𑆂 𑇆𑇔𑇐𑇆
𑆘𑆳𑆠𑆓𑆤𑇀𑆣𑆳𑆁 𑆘𑆳𑆠𑆫𑆱𑆳𑆁 𑆥𑆳𑆪𑆪𑆼𑆢𑆳𑆠𑆶𑆫𑆁 𑆨𑆴𑆰𑆑𑇀 𑇅𑇔𑇑𑇅 𑆱𑆴𑆫𑆳𑆁 𑆮𑆴𑆣𑇀𑆪𑆼𑆢𑆡 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆁 𑆩𑆕𑇀𑆓𑆬𑇀𑆪𑆳𑆤𑆴 𑆖 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇔𑇑𑇆
𑆃𑆡𑆳𑆠 𑆇𑆤𑇀𑆩𑆳𑆢𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆢𑆪𑆤𑇀𑆠𑇀𑆪𑆶𑆢𑇀𑆣(𑆢𑇀𑆓)𑆠𑆳 𑆢𑆾𑆰𑆳 𑆪𑆱𑇀𑆩𑆳𑆢𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑇅 𑆩𑆳𑆤𑆱𑆾𑇁𑆪𑆩𑆠𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆤𑇀𑆩𑆳𑆢 𑆅𑆠𑆴 𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆂 𑇆𑇓𑇆
𑆍𑆑𑆽𑆑𑆯𑆂 𑆱𑆩𑆱𑇀𑆠𑆽𑆯𑇀𑆖 𑆢𑆾𑆰𑆽𑆫𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆴𑆠𑆽𑆂 𑇅 𑆩𑆳𑆤𑆱𑆼𑆤𑆳 𑆖 𑆢𑆶𑆂𑆒𑆼𑆤 𑆱 𑆥𑆚𑇀𑆖𑆮𑆴𑆣 𑆇𑆖𑇀𑆪𑆠𑆼 𑇆𑇔𑇆
𑆮𑆴𑆰𑆳𑆢𑇀𑆨𑆮𑆠𑆴 𑆰𑆰𑇀𑆜𑆯𑇀𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆠𑆠𑇀𑆫 𑆨𑆼𑆰𑆘𑆩𑇀 𑇅 𑆱 𑆖𑆳𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆱𑇀𑆠𑆫𑆶𑆟𑆾 𑆩𑆢𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆧𑆴𑆨𑆫𑇀𑆠𑆴 𑆖 𑇆𑇕𑇆
𑆩𑆾𑆲𑆾𑆢𑇀𑆮𑆼𑆓𑆿 𑆱𑇀𑆮𑆤𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆼 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆩𑆥𑆑𑆫𑇀𑆰𑆟𑆩𑇀 𑇅 𑆃𑆠𑇀𑆪𑆶𑆠𑇀𑆱𑆳𑆲𑆾𑇁𑆫𑆶𑆖𑆴𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆼 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆑𑆬𑆶𑆰𑆨𑆾𑆘𑆤𑆩𑇀 𑇆𑇖𑇆

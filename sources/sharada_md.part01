𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆢𑇀𑆢𑇀𑆮𑆳𑆢𑆯𑆨𑆴𑆫𑆣𑇀𑆪𑆳𑆪𑆽𑆫𑇀𑆮𑇀𑆪𑆳𑆱𑆠𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆠𑆴𑆠𑆩𑇀𑇅 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆳𑆁 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆘𑆵𑆮𑆴𑆠𑆳𑆤𑇀𑆠𑆑𑆸𑆠𑇀𑇆𑇔𑇐𑇆
𑆠𑆠𑇀 𑆱𑆩𑆳𑆱𑆼𑆤 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂 𑆥𑆫𑇀𑆪𑆳𑆪𑆳𑆤𑇀𑆠𑆫𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇅 𑆥𑆫𑇀𑆪𑆳𑆪𑆮𑆖𑆤𑆁 𑆲𑇀𑆪𑆫𑇀𑆡𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆪𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇔𑇑𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆶𑆤𑆫𑆼𑆮𑆼𑆪𑆁 𑆮𑆴𑆮𑆑𑇀𑆰𑆳 𑆤𑆾 𑆮𑆴𑆣𑆵𑆪𑆠𑆼𑇅 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆼𑆮𑆳𑆣𑆴𑆑𑆫𑆟𑆼 𑆪𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆩𑆨𑆴𑆯𑆧𑇀𑆢𑆴𑆠𑆩𑇀𑇆𑇔𑇒𑇆
𑆮𑆱𑆠𑆳𑆁 𑆖𑆫𑆩𑆁 𑆑𑆳𑆬𑆁 𑆯𑆫𑆵𑆫𑆼𑆰𑆶 𑆯𑆫𑆵𑆫𑆴𑆟𑆳𑆩𑇀𑇅 𑆃𑆨𑇀𑆪𑆶𑆓𑇀𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆤𑆳𑆯𑆳𑆪 𑆢𑆼𑆲𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆮𑆴𑆮𑆠𑇀𑆱𑆠𑆳𑆩𑇀𑇆𑇔𑇓𑇆
𑆅𑆰𑇀𑆛𑆳𑆁𑆱𑇀𑆠𑆴𑆠𑆴𑆑𑇀𑆰𑆠𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀 𑆑𑆳𑆤𑇀𑆠𑆁 𑆮𑆳𑆱𑆁 𑆘𑆴𑆲𑆳𑆱𑆠𑆳𑆩𑇀𑇅 𑆠𑆤𑇀𑆠𑇀𑆫𑆪𑆤𑇀𑆠𑇀𑆫𑆼𑆰𑆶 𑆨𑆴𑆤𑇀𑆤𑆼𑆰𑆶 𑆠𑆩𑆾𑇁𑆤𑇀𑆠𑇀𑆪𑆁 𑆥𑇀𑆫𑆮𑆴𑆮𑆴𑆑𑇀𑆰𑆠𑆳𑆩𑇀𑇆𑇔𑇔𑇆
𑆮𑆴𑆤𑆳𑆯𑆳𑆪𑆼𑆲 𑆫𑆷𑆥𑆳𑆟𑆴 𑆪𑆳𑆤𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆖𑇅 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆳𑆤𑆴 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆁 𑆪𑆡𑆳𑆓𑆩𑆩𑇀𑇆𑇔𑇕𑇆
𑆥𑇀𑆫𑆳𑆟𑆳𑆂 𑆱𑆩𑆶𑆥𑆠𑆥𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆶𑆥𑆫𑆶𑆣𑇀𑆪𑆠𑆼𑇅 𑆮𑆩𑆤𑇀𑆠𑆴 𑆧𑆬𑆩𑆕𑇀𑆓𑆳𑆤𑆴 𑆖𑆼𑆰𑇀𑆛𑆳 𑆮𑇀𑆪𑆶𑆥𑆫𑆩𑆤𑇀𑆠𑆴 𑆖𑇆𑇔𑇖𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆮𑆴𑆤𑆯𑇀𑆪𑆤𑇀𑆠𑆴 𑆒𑆴𑆬𑆵𑆨𑆮𑆠𑆴 𑆖𑆼𑆠𑆤𑆳 𑇅 𑆐𑆠𑇀𑆱𑆶𑆑𑇀𑆪𑆁 𑆨𑆘𑆠𑆼 𑆱𑆠𑇀𑆠𑇀𑆮𑆁 𑆖𑆼𑆠𑆾 𑆨𑆵𑆫𑆳𑆮𑆴𑆯𑆠𑇀𑆪𑆥𑆴𑇆𑇔𑇗𑇆
𑆱𑇀𑆩𑆸𑆠𑆴𑆱𑇀𑆠𑇀𑆪𑆘𑆠𑆴 𑆩𑆼𑆣𑆳 𑆖 𑆲𑇀𑆫𑆵𑆯𑇀𑆫𑆴𑆪𑆿 𑆖𑆳𑆥𑆱𑆫𑇀𑆥𑆠𑆂𑇅 𑆇𑆥𑆥𑇀𑆬𑆮𑆤𑇀𑆠𑆼 𑆥𑆳𑆥𑇀𑆩𑆳𑆤 𑆏𑆘𑆱𑇀𑆠𑆼𑆘𑆯𑇀𑆖 𑆤𑆯𑇀𑆪𑆠𑆴𑇆𑇔𑇘𑇆
𑆯𑆵𑆬𑆁 𑆮𑇀𑆪𑆳𑆮𑆫𑇀𑆠𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆨𑆑𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑆫𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆮𑆴𑆑𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆠𑆴𑆖𑇀𑆗𑆳𑆪𑆳𑆯𑇀𑆗𑆳𑆪𑆳𑆯𑇀𑆖 𑆮𑆴𑆑𑆸𑆠𑆴𑆁 𑆥𑇀𑆫𑆠𑆴𑇆𑇔𑇙𑇆
𑆯𑆶𑆑𑇀𑆫𑆁 𑆥𑇀𑆫𑆖𑇀𑆪𑆮𑆠𑆼 𑆱𑇀𑆡𑆳𑆤𑆳𑆢𑆶𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆁 𑆨𑆘𑆠𑆼𑇁𑆤𑆴𑆬𑆂𑇅 𑆑𑇀𑆰𑆪𑆁 𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆓𑆖𑇀𑆗𑆠𑇀𑆪𑆱𑆸𑆓𑆥𑆴 𑆑𑇀𑆰𑆪𑆩𑇀𑇆𑇕𑇐𑇆
𑆈𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑇀𑆫𑆬𑆪𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆮𑆴𑆯𑇀𑆬𑆼𑆰𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆱𑆤𑇀𑆣𑆪𑆂𑇅 𑆓𑆤𑇀𑆣𑆳 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆨𑆼𑆢𑆁 𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆿 𑆠𑆡𑆳𑇆𑇕𑇑𑇆
𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆨𑆘𑆠𑆼 𑆑𑆳𑆪𑆂 𑆑𑆳𑆪𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆁 𑆮𑆴𑆯𑆶𑆰𑇀𑆪𑆠𑆴𑇅 𑆣𑆷𑆩𑆂 𑆱𑆚𑇀𑆘𑆳𑆪𑆠𑆼 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆢𑆳𑆫𑆶𑆟𑆳𑆒𑇀𑆪𑆯𑇀𑆖 𑆖𑆷𑆫𑇀𑆟𑆑𑆂𑇆𑇕𑇒𑇆
𑆱𑆠𑆠𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆳 𑆢𑆼𑆯𑆳𑆂 𑆯𑆫𑆵𑆫𑆼 𑆪𑆼𑇁𑆨𑆴𑆬𑆑𑇀𑆰𑆴𑆠𑆳𑆂𑇅 𑆠𑆼 𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆤𑆶𑆓𑆠𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆤 𑆖𑆬𑆤𑇀𑆠𑆴 𑆑𑆡𑆚𑇀𑆖𑆤𑇆𑇕𑇓𑇆
𑆓𑆶𑆟𑆳𑆂 𑆯𑆫𑆵𑆫𑆢𑆼𑆯𑆳𑆤𑆳𑆁 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆩𑆸𑆢𑆶𑆢𑆳𑆫𑆶𑆟𑆳𑆂𑇅 𑆮𑆴𑆥𑆫𑇀𑆪𑆳𑆱𑆼𑆤 𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆱𑇀𑆡𑆳𑆤𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆠𑆢𑇀𑆮𑆴𑆣𑆳𑆂𑇆𑇕𑇔𑇆
𑆤𑆒𑆼𑆰𑆶 𑆘𑆳𑆪𑆠𑆼 𑆥𑆶𑆰𑇀𑆥𑆁 𑆥𑆕𑇀𑆑𑆾 𑆢𑆤𑇀𑆠𑆼𑆰𑆶 𑆘𑆳𑆪𑆠𑆼𑇅 𑆘𑆛𑆳𑆂 𑆥𑆑𑇀𑆰𑇀𑆩𑆱𑆶 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆱𑆵𑆩𑆤𑇀𑆠𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆩𑆷𑆫𑇀𑆣𑆤𑆴𑇆𑇕𑇕𑇆
𑆨𑆼𑆰𑆘𑆳𑆤𑆴 𑆤 𑆱𑆁𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆮𑆤𑇀𑆠𑆴 𑆪𑆡𑆳𑆫𑆶𑆖𑆴𑇅 𑆪𑆳𑆤𑆴 𑆖𑆳𑆥𑇀𑆪𑆶𑆥𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆠𑆼𑆰𑆳𑆁 𑆮𑆵𑆫𑇀𑆪𑆁 𑆤 𑆱𑆴𑆣𑇀𑆪𑆠𑆴𑇆𑇕𑇖𑇆
𑆤𑆳𑆤𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆪𑆂 𑆑𑇀𑆫𑆷𑆫𑆳 𑆮𑆴𑆑𑆳𑆫𑆳 𑆮𑆴𑆮𑆴𑆣𑆿𑆰𑆣𑆳𑆂𑇅 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆱𑆩𑆨𑆴𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑇀𑆪 𑆧𑆬𑆿𑆘𑆱𑆵𑇆𑇕𑇗𑇆
𑆯𑆧𑇀𑆢𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆾 𑆫𑆱𑆾 𑆫𑆷𑆥𑆁 𑆓𑆤𑇀𑆣𑆯𑇀𑆖𑆼𑆰𑇀𑆛𑆳 𑆮𑆴𑆖𑆴𑆤𑇀𑆠𑆴𑆠𑆩𑇀 𑇅 𑆇𑆠𑇀𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆯𑆶𑆨𑆳𑆤𑇀𑆪𑆼𑆮 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆰𑆶𑇆𑇕𑇘𑇆
𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆢𑆳𑆫𑆶𑆟𑆳𑆂 𑆱𑇀𑆮𑆥𑇀𑆤𑆳 𑆢𑆿𑆫𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆥𑇀𑆫𑆼𑆰𑇀𑆪𑆳𑆂 𑆥𑇀𑆫𑆠𑆵𑆥𑆠𑆳𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆼𑆠𑆳𑆑𑆸𑆠𑆴𑆫𑆶𑆢𑆵𑆫𑇀𑆪𑆠𑆼𑇆𑇕𑇙𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆲𑆵𑆪𑆠𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆯𑇀𑆖𑆳𑆨𑆴𑆮𑆫𑇀𑆣𑆠𑆼𑇅 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆩𑆿𑆠𑇀𑆥𑆳𑆠𑆴𑆑𑆁 𑆔𑆾𑆫𑆩𑆫𑆴(𑆤𑆴)𑆰𑇀𑆛𑆩𑆶𑆥𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇖𑇐𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆳𑆤𑆴 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆨𑆮𑆤𑇀𑆠𑆴 𑆮𑆴𑆤𑆯𑆴𑆰𑇀𑆪𑆠𑆳𑆩𑇀𑇅 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆪𑆡𑆾𑆢𑇀𑆢𑆼𑆯𑆁 𑆪𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆪𑆡𑆳𑆓𑆩𑆩𑇀𑇆𑇖𑇑𑇆
𑆩𑆫𑆟𑆳𑆪𑆼𑆲 𑆫𑆷𑆥𑆳𑆟𑆴 𑆥𑆯𑇀𑆪𑆠𑆳𑇁𑆥𑆴 𑆨𑆴𑆰𑆓𑇀𑆮𑆴𑆢𑆳𑇅 𑆃𑆥𑆸𑆰𑇀𑆛𑆼𑆤 𑆤 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆩𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇖𑇒𑇆
𑆥𑆸𑆰𑇀𑆛𑆼𑆤𑆳𑆥𑆴 𑆤 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆠𑆠𑇀𑆫 𑆪𑆠𑇀𑆫𑆾𑆥𑆔𑆳𑆠𑆑𑆩𑇀𑇅 𑆄𑆠𑆶𑆫𑆱𑇀𑆪 𑆨𑆮𑆼𑆢𑇀𑆢𑆶𑆂𑆒𑆩𑆡𑆮𑆳𑇁𑆤𑇀𑆪𑆱𑇀𑆪 𑆑𑆱𑇀𑆪𑆖𑆴𑆠𑇀𑇆𑇖𑇓𑇆
𑆃𑆧𑇀𑆫𑆶𑆮𑆤𑇀𑆩𑆫𑆟𑆁 𑆠𑆱𑇀𑆪 𑆤𑆽𑆤𑆩𑆴𑆖𑇀𑆗𑆼𑆖𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆶𑆩𑇀𑇅 𑆪𑆱𑇀𑆪 𑆥𑆯𑇀𑆪𑆼𑆢𑇀𑆮𑆴𑆤𑆳𑆯𑆳𑆪 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆑𑆶𑆯𑆬𑆾 𑆨𑆴𑆰𑆑𑇀𑇆𑇖𑇔𑇆
𑆬𑆴𑆕𑇀𑆓𑆼𑆨𑇀𑆪𑆾 𑆩𑆫𑆟𑆳𑆒𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆥𑆯𑇀𑆪𑆠𑆳𑇅 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆳𑆓𑆤𑇀𑆠𑆶 𑆮𑆑𑇀𑆠𑆮𑇀𑆪𑆁 𑆨𑆴𑆰𑆘𑆳 𑆣𑇀𑆫𑆶𑆮𑆩𑇀𑇆𑇖𑇕𑇆
𑆢𑆷𑆠𑆽𑆫𑆿𑆠𑇀𑆥𑆳𑆠𑆴𑆑𑆽𑆫𑇀𑆨𑆳𑆮𑆽𑆂 𑆥𑆡𑇀𑆪𑆳𑆠𑆶𑆫𑆑𑆶𑆬𑆳𑆯𑇀𑆫𑆪𑆽𑆂𑇅 𑆄𑆠𑆶𑆫𑆳𑆖𑆳𑆫𑆯𑆵𑆬𑆼𑆰𑇀𑆛𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆩𑇀𑆥𑆠𑇀𑆠𑆴𑆬𑆑𑇀𑆰𑆟𑆽𑆂𑇆𑇖𑇖𑇆
𑆱𑇀𑆮𑆳𑆖𑆳𑆫𑆁 𑆲𑆸𑆰𑇀𑆛𑆩𑆮𑇀𑆪𑆕𑇀𑆓𑆁 𑆪𑆯𑆱𑇀𑆪𑆁 𑆯𑆶𑆑𑇀𑆬𑆮𑆳𑆱𑆱𑆩𑇀𑇅 𑆃𑆩𑆶𑆟𑇀𑆝𑆩𑆘𑆛𑆁 𑆢𑆷𑆠𑆁 𑆘𑆳𑆠𑆴𑆮𑆼𑆯𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆩𑆩𑇀𑇆𑇖𑇗𑇆
𑆃𑆤𑆶𑆰𑇀𑆛𑇀𑆫𑆒𑆫𑆪𑆳𑆤𑆱𑇀𑆡𑆩𑆱𑆤𑇀𑆣𑇀𑆪𑆳𑆱𑇀𑆮𑆓𑇀𑆫𑆲𑆼𑆰𑆶 𑆖𑇅 𑆃𑆢𑆳𑆫𑆶𑆟𑆼𑆰𑆶 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆰𑇀𑆮𑆤𑆶𑆓𑇀𑆫𑆼𑆰𑆶 𑆣𑇀𑆫𑆶𑆮𑆼𑆰𑆶 𑆖𑇆𑇖𑇘𑇆
𑆮𑆴𑆤𑆳 𑆖𑆠𑆶𑆫𑇀𑆡𑆵𑆁 𑆤𑆮𑆩𑆵𑆁 𑆮𑆴𑆤𑆳 𑆫𑆴𑆑𑇀𑆠𑆳𑆁 𑆖𑆠𑆶𑆫𑇀𑆢𑆯𑆵𑆩𑇀𑇅 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆩𑆫𑇀𑆣𑆫𑆳𑆠𑇀𑆫𑆁 𑆖 𑆨𑆷𑆑𑆩𑇀𑆥𑆁 𑆫𑆳𑆲𑆶𑆢𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇖𑇙𑇆
𑆮𑆴𑆤𑆳 𑆢𑆼𑆯𑆩𑆯𑆱𑇀𑆠𑆁 𑆖𑆳𑆯𑆱𑇀𑆠𑆿𑆠𑇀𑆥𑆳𑆠𑆴𑆑𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆢𑆷𑆠𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆩𑆮𑇀𑆪𑆓𑇀𑆫𑆁 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑆼𑆢𑆳𑆓𑆠𑆁 𑆨𑆴𑆰𑆑𑇀𑇆𑇗𑇐𑇆
𑆢𑆣𑇀𑆪𑆑𑇀𑆰𑆠𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆵𑆤𑆳𑆁 𑆮𑆸𑆰𑆨𑆳𑆟𑆳𑆁 𑆤𑆸𑆥𑆱𑇀𑆪 𑆖𑇆𑇗𑇑𑇆
𑆩𑆸𑆓𑆥𑆑𑇀𑆰𑆴𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆳𑆯𑇀𑆖 𑆓𑆴𑆫𑆂 𑆯𑆶𑆨𑆳𑆂𑇅 𑆗𑆠𑇀𑆫𑆣𑇀𑆮𑆘𑆥𑆠𑆳𑆑𑆳𑆤𑆳𑆩𑆶𑆠𑇀𑆑𑇀𑆰𑆼𑆥𑆟𑆩𑆨𑆴𑆰𑇀𑆛𑆶𑆠𑆴𑆂𑇆𑇗𑇘𑇆
𑆨𑆼𑆫𑆵𑆩𑆸𑆢𑆕𑇀𑆓𑆯𑆕𑇀𑆒𑆳𑆤𑆳𑆁 𑆯𑆧𑇀𑆢𑆳𑆂 𑆥𑆶𑆟𑇀𑆪𑆳𑆲𑆤𑆴𑆱𑇀𑆮𑆤𑆳𑆂𑇅 𑆮𑆼𑆢𑆳𑆣𑇀𑆪𑆪𑆤𑆯𑆧𑇀𑆢𑆳𑆯𑇀𑆖 𑆱𑆶𑆒𑆾 𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆢𑆑𑇀𑆰𑆴𑆟𑆂𑇆𑇗𑇙𑇆
𑆥𑆡𑆴 𑆮𑆼𑆯𑇀𑆩𑆥𑇀𑆫𑆮𑆼𑆯𑆼 𑆠𑆶 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆳𑆫𑆾𑆓𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅𑇘𑇐𑇅 𑆩𑆕𑇀𑆓𑆬𑆳𑆖𑆳𑆫𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆂 𑆱𑆳𑆠𑆶𑆫𑆾 𑆮𑆽𑆯𑇀𑆩𑆴𑆑𑆾 𑆘𑆤𑆂𑇆𑇘𑇐𑇆
𑆯𑇀𑆫𑆢𑇀𑆢𑆣𑆳𑆤𑆾𑇁𑆤𑆶𑆑𑆷𑆬𑆯𑇀𑆖 𑆥𑇀𑆫𑆨𑆷𑆠𑆢𑇀𑆫𑆮𑇀𑆪𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆣𑆤𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆱𑆶𑆒𑆳𑆮𑆳𑆥𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆛𑆬𑆳𑆨𑆂 𑆱𑆶𑆒𑆼𑆤 𑆖𑇆𑇘𑇑𑇆
𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆠𑆠𑇀𑆫 𑆪𑆾𑆓𑇀𑆪𑆳𑆤𑆳𑆁 𑆪𑆾𑆘𑆤𑆳 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆼𑆮 𑆖𑇅 𑆓𑆸𑆲𑆥𑇀𑆫𑆳𑆱𑆳𑆢𑆯𑆽𑆬𑆳𑆤𑆳𑆁 𑆤𑆳𑆓𑆳𑆤𑆳𑆩𑆸𑆰𑆨𑆱𑇀𑆪 𑆖𑇆𑇘𑇒𑇆
𑆲𑆪𑆳𑆤𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆁 𑆖 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆱𑆩𑆣𑆴𑆫𑆾𑆲𑆟𑆩𑇀𑇅 𑆱𑆾𑆩𑆳𑆫𑇀𑆑𑆳𑆓𑇀𑆤𑆴𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆵𑆤𑆳𑆁 𑆓𑆮𑆳𑆁 𑆤𑆹𑆟𑆳𑆁 𑆥𑆪𑆱𑇀𑆮𑆴𑆤𑆳𑆩𑇀𑇆𑇘𑇓𑇆
𑆃𑆫𑇀𑆟𑆮𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆫𑆟𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆂 𑆱𑆩𑇀𑆧𑆳𑆣𑆤𑆴𑆂𑆱𑆸𑆠𑆴𑆂𑇅 𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆢𑆼𑆮𑆽𑆂 𑆱𑆥𑆴𑆠𑆸𑆨𑆴𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆽𑆯𑇀𑆖𑆳𑆨𑆴𑆨𑆳𑆰𑆟𑆩𑇀𑇆𑇘𑇔𑇆
𑆢𑆫𑇀𑆯𑆤𑆁 𑆯𑆶𑆑𑇀𑆬𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆲𑇀𑆫𑆢𑆱𑇀𑆪 𑆮𑆴𑆩𑆬𑆱𑇀𑆪 𑆖𑇅 𑆩𑆳𑆁𑆱𑆩𑆠𑇀𑆱𑇀𑆪𑆮𑆴𑆰𑆳𑆩𑆼𑆣𑇀𑆪𑆖𑇀𑆗𑆠𑇀𑆫𑆳𑆢𑆫𑇀𑆯𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆂𑇆𑇘𑇕𑇆
𑆱𑇀𑆮𑆥𑇀𑆤𑆼 𑆱𑆶𑆩𑆤𑆱𑆳𑆁 𑆖𑆽𑆮 𑆯𑆶𑆑𑇀𑆬𑆳𑆤𑆳𑆁 𑆢𑆫𑇀𑆯𑆤𑆁 𑆯𑆶𑆨𑆩𑇀𑇅 𑆃𑆯𑇀𑆮𑆓𑆾𑆫𑆡𑆪𑆳𑆤𑆁 𑆖 𑆪𑆳𑆤𑆁 𑆥𑆷𑆫𑇀𑆮𑆾𑆠𑇀𑆠𑆫𑆼𑆟 𑆖𑇅 𑆫𑆾𑆢𑆤𑆁 𑆥𑆠𑆴𑆠𑆾𑆠𑇀𑆡𑆳𑆤𑆁 𑆢𑇀𑆮𑆴𑆰𑆠𑆳𑆁 𑆖𑆳𑆮𑆩𑆫𑇀𑆢𑆤𑆩𑇀𑇆𑇘𑇖𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆱𑆁𑆪𑆾𑆓𑆾 𑆨𑆑𑇀𑆠𑆴𑆫𑇀𑆮𑆽𑆢𑇀𑆪𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆴𑆰𑆶𑇅 𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆁 𑆤 𑆖 𑆤𑆴𑆫𑇀𑆮𑆼𑆢𑆱𑇀𑆠𑆢𑆳𑆫𑆾𑆓𑇀𑆪𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇘𑇗𑇆
𑆄𑆫𑆾𑆓𑇀𑆪𑆳𑆢𑇀𑆧𑆬𑆩𑆳𑆪𑆶𑆯𑇀𑆖 𑆱𑆶𑆒𑆁 𑆖 𑆬𑆨𑆠𑆼 𑆩𑆲𑆠𑇀𑇅 𑆅𑆰𑇀𑆛𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆥𑆫𑆳𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑇀 𑆥𑆶𑆫𑆶𑆰𑆂 𑆯𑆶𑆨𑆬𑆑𑇀𑆰𑆟𑆂𑇆𑇘𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆇𑆑𑇀𑆠𑆁 𑆓𑆾𑆩𑆪𑆖𑆷𑆫𑇀𑆟𑆵𑆪𑆼 𑆩𑆫𑆟𑆳𑆫𑆾𑆓𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆢𑆷𑆠𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆠𑆶𑆫𑆾𑆠𑇀𑆥𑆳𑆠𑆪𑆶𑆑𑇀𑆠𑆴𑆱𑆴𑆢𑇀𑆣𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆩𑇀𑇆𑇘𑇙𑇆
𑆅𑆠𑆵𑆢𑆩𑆶𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆁 𑆪𑆡𑆳𑆠𑆡𑆁 𑆠𑆢𑆤𑇀𑆮𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆁 𑆱𑆠𑆠𑆁 𑆨𑆴𑆰𑆓𑇀𑆮𑆴𑆢𑆳𑇅 𑆠𑆡𑆳 𑆲𑆴 𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆖 𑆪𑆯𑆯𑇀𑆖 𑆯𑆳𑆯𑇀𑆮𑆠𑆁 𑆱 𑆱𑆴𑆢𑇀𑆣𑆑𑆫𑇀𑆩𑆳 𑆬𑆨𑆠𑆼 𑆣𑆤𑆳𑆤𑆴 𑆖𑇆𑇙𑇐𑇆
𑆃𑆡𑆳𑆠𑆾 𑆫𑆱𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆫𑆷𑆥𑆾𑆥𑆯𑆪𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆮𑆴𑆣𑆴𑆮𑆴𑆑𑆬𑇀𑆥 𑆧𑆬𑆑𑆳𑆬𑆮𑆴𑆯𑆼𑆰𑆳𑆤𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆳𑆤𑆤𑇀𑆠𑆫𑆁 𑆢𑆾𑆰𑆨𑆼𑆰𑆘𑆢𑆼𑆯𑆑𑆳𑆬𑆧𑆬𑆯𑆫𑆵𑆫𑆱𑆳𑆫𑆳𑆲𑆳𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆪𑆱𑆳𑆁 𑆩𑆳𑆤𑆩𑆮𑆲𑆴𑆠𑆩𑆤𑆱𑆳 𑆪𑆡𑆳𑆮𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆁 𑆨𑆮𑆠𑆴 𑆨𑆴𑆰𑆘𑆳, 𑆢𑆾𑆰𑆳𑆢𑆴𑆩𑆳𑆤𑆘𑇀𑆚𑆳𑆤𑆳𑆪𑆠𑇀𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆳𑆂𑇅 𑆤 𑆲𑇀𑆪𑆩𑆳𑆤𑆘𑇀𑆚𑆾 𑆢𑆾𑆰𑆳𑆢𑆵𑆤𑆳𑆁 𑆨𑆴𑆰𑆓𑇀 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆱𑆩𑆫𑇀𑆡𑆾 𑆨𑆮𑆠𑆴𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑆾𑆰𑆳𑆢𑆴𑆩𑆳𑆤𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆁 𑆮𑆴𑆩𑆳𑆤𑆱𑇀𑆡𑆳𑆤𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯!𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆿 𑆫𑆱𑆢𑇀𑆫𑆮𑇀𑆪𑆢𑆾𑆰𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆫𑆱𑆳𑆱𑇀𑆠𑆳𑆮𑆠𑇀 𑆰𑆛𑇀- 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆂𑇅 𑆠𑆼 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆯𑆫𑆵𑆫𑆁 𑆪𑆳𑆥𑆪𑆤𑇀𑆠𑆴, 𑆩𑆴𑆡𑇀𑆪𑆾𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆤𑇀𑆠𑆼𑇆𑇔𑇆
𑆢𑆾𑆰𑆳𑆂 𑆥𑆶𑆤𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂𑇅 𑆠𑆼 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆳𑆂 𑆯𑆫𑆵𑆫𑆾𑆥𑆑𑆳𑆫𑆑𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆽𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆽𑆂 𑆯𑆫𑆵𑆫𑆩𑆶𑆥𑆠𑆳𑆥𑆪𑆤𑇀𑆠𑆴𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆢𑆾𑆰𑆩𑆼𑆑𑆽𑆑𑆁 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆾 𑆫𑆱𑆳 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆪𑆯𑇀𑆖𑆾𑆥𑆯𑆩𑆪𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳 𑆮𑆳𑆠𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆤𑆁 𑆯𑆩𑆪𑆤𑇀𑆠𑆴; 𑆑𑆛𑇀𑆮𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆩𑆣𑆶𑆫𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆤𑆖𑇀𑆗𑇀𑆩𑆪𑆤𑇀𑆠𑆴; 𑆩𑆣𑆶𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆑𑆰𑆳𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆤𑆁 𑆯𑆩𑆪𑆤𑇀𑆠𑆴𑇆𑇖𑇆
𑆫𑆱𑆢𑆾𑆰𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆠𑆶 𑆪𑆼 𑆫𑆱𑆳 𑆪𑆽𑆫𑇀𑆢𑆾𑆰𑆽𑆂 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆳𑆂 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳 𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆠𑆼 𑆠𑆳𑆤𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆤𑇀𑆠𑆴, 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆳 𑆮𑆴𑆥𑆫𑆵𑆠𑆓𑆶𑆟𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆳 𑆮𑆳 𑆯𑆩𑆪𑆤𑇀𑆠𑇀𑆪𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆳 𑆅𑆠𑆴𑇅 𑆍𑆠𑆢𑇀𑆮𑇀𑆪𑆮𑆱𑇀𑆡𑆳𑆲𑆼𑆠𑆾𑆂 𑆰𑆛𑇀𑆠𑇀𑆮𑆩𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑆫𑆱𑆳𑆤𑆳𑆁 𑆥𑆫𑆱𑇀𑆥𑆫𑆼𑆟𑆳𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁, 𑆠𑇀𑆫𑆴𑆠𑇀𑆮𑆁 𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑇀𑇆𑇗𑇆
𑆱𑆁𑆱𑆫𑇀𑆓𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆱𑇀𑆠𑆫𑆾 𑆲𑇀𑆪𑆼𑆰𑆳𑆩𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆾 𑆨𑆮𑆠𑆴, 𑆮𑆴𑆑𑆬𑇀𑆥𑆨𑆼𑆢𑆳𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇘𑇆
𑆠𑆠𑇀𑆫 𑆒𑆬𑇀𑆮𑆤𑆼𑆑𑆫𑆱𑆼𑆰𑆶 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆰𑇀𑆮𑆤𑆼𑆑𑆢𑆾𑆰𑆳𑆠𑇀𑆩𑆑𑆼𑆰𑆶 𑆖 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑆶 𑆫𑆱𑆢𑆾𑆰𑆥𑇀𑆫𑆨𑆳𑆮𑆩𑆼𑆑𑆽𑆑𑆯𑇀𑆪𑆼𑆤𑆳𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆠𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆑𑆳𑆫𑆪𑆾𑆂 𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆠𑇀𑆠𑇀𑆮𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇙𑇆
𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆼 𑆲𑆴 𑆱𑆩𑆶𑆢𑆪𑆼 𑆱𑆩𑆶𑆢𑆳𑆪𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆠𑇀𑆠𑇀𑆮𑆩𑆼𑆮𑆩𑆼𑆮𑆾𑆥𑆬𑆨𑇀𑆪 𑆠𑆠𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆠𑇀𑆠𑇀𑆮𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇑𑇑𑇆
𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆫𑆱𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆯𑇀𑆖 𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆯𑇀𑆖 𑆢𑆾𑆰𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆯𑇀𑆖 𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆯𑇀𑆖 𑆠𑆠𑇀𑆠𑇀𑆮𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫𑆽𑆰 𑆫𑆱𑆥𑇀𑆫𑆨𑆳𑆮 𑆇𑆥𑆢𑆴𑆰𑇀𑆛𑆾 𑆨𑆮𑆠𑆴𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆥𑇀𑆫𑆨𑆳𑆮𑆁 𑆥𑆶𑆤𑆫𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆽𑆬𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆷𑆤𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆫𑇀𑆡𑆳𑆤𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇓𑇆
𑆠𑆠𑇀𑆫 𑆠𑆽𑆬𑆁 𑆱𑇀𑆤𑆼𑆲𑆿𑆰𑇀𑆟𑇀𑆪𑆓𑆿𑆫𑆮𑆾𑆥𑆥𑆤𑇀𑆤𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆳𑆠𑆁 𑆘𑆪𑆠𑆴 𑆱𑆠𑆠𑆩𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆁; 𑆮𑆳𑆠𑆾 𑆲𑆴 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆯𑆽𑆠𑇀𑆪𑆬𑆳𑆔𑆮𑆾𑆥𑆥𑆤𑇀𑆤𑆾 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆓𑆶𑆟𑆾 𑆨𑆮𑆠𑆴, 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆓𑆶𑆟𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆲𑆴 𑆨𑆷𑆪𑆱𑆳𑇁𑆬𑇀𑆥𑆩𑆮𑆘𑆵𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆽𑆬𑆁 𑆮𑆳𑆠𑆁 𑆘𑆪𑆠𑆴 𑆱𑆠𑆠𑆩𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆩𑇀𑇅 𑆱𑆫𑇀𑆥𑆴𑆂 𑆒𑆬𑇀𑆮𑆼𑆮𑆩𑆼𑆮 𑆥𑆴𑆠𑇀𑆠𑆁 𑆘𑆪𑆠𑆴, 𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆽𑆠𑇀𑆪𑆳𑆤𑇀𑆩𑆤𑇀𑆢𑆠𑇀𑆮𑆳𑆖𑇀𑆖 ; 𑆥𑆴𑆠𑇀𑆠𑆁 𑆲𑇀𑆪𑆩𑆣𑆶𑆫𑆩𑆶𑆰𑇀𑆟𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆖𑇅 𑆩𑆣𑆶 𑆖 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆘𑆪𑆠𑆴, 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀 𑆑𑆰𑆳𑆪𑆠𑇀𑆮𑆳𑆖𑇀𑆖; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆲𑆴 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆩𑆤𑇀𑆢𑆾 𑆩𑆣𑆶𑆫𑆯𑇀𑆖 𑇅 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆩𑆼𑆮𑆁 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆼𑆨𑇀𑆪𑆾 𑆓𑆶𑆟𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆖𑇀𑆖𑆽𑆠𑆳𑆚𑇀𑆘𑆪𑆠𑇀𑆪𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆩𑇀𑇆𑇑𑇔𑇆
𑆃𑆡 𑆒𑆬𑆶 𑆠𑇀𑆫𑆵𑆟𑆴 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠𑆳𑆣𑆴𑆑𑆩𑆤𑇀𑆪𑆼𑆨𑇀𑆪𑆾 𑆢𑇀𑆫𑆮𑇀𑆪𑆼𑆨𑇀𑆪𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑆴𑆥𑇀𑆥𑆬𑆵, 𑆑𑇀𑆰𑆳𑆫𑆂, 𑆬𑆮𑆟𑆩𑆴𑆠𑆴𑇆𑇑𑇕𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆾 𑆲𑆴 𑆑𑆛𑆶𑆑𑆳𑆂 𑆱𑆠𑇀𑆪𑆾 𑆩𑆣𑆶𑆫𑆮𑆴𑆥𑆳𑆑𑆳 𑆓𑆶𑆫𑇀𑆮𑇀𑆪𑆾𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾𑆰𑇀𑆟𑆳𑆂 𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆴𑆤𑇀𑆪𑆾 𑆨𑆼𑆰𑆘𑆳𑆨𑆴𑆩𑆠𑆳𑆯𑇀𑆖𑆠𑆳𑆂 𑆱𑆢𑇀𑆪𑆂; 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆑𑆳𑆫𑆴𑆟𑇀𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆄𑆥𑆳𑆠𑆨𑆢𑇀𑆫𑆳𑆂, 𑆥𑇀𑆫𑆪𑆾𑆓𑆱𑆩𑆱𑆳𑆢𑇀𑆓𑆶𑆟𑇀𑆪𑆳𑆠𑇀; 𑆢𑆾𑆰𑆱𑆚𑇀𑆖𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆳𑆂;- 𑆱𑆠𑆠𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆳 𑆲𑆴 𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆴𑆠𑇀𑆮𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆪𑆤𑇀𑆠𑆴, 𑆐𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆁, 𑆤 𑆖 𑆮𑆳𑆠𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆤𑇀𑆠𑆼𑇁𑆬𑇀𑆥𑆱𑇀𑆤𑆼𑆲𑆾𑆰𑇀𑆟𑆨𑆳𑆮𑆳𑆠𑇀; 𑆪𑆾𑆓𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆫𑇀𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠𑇆𑇑𑇖𑇆
𑆑𑇀𑆰𑆳𑆫𑆂 𑆥𑆶𑆤𑆫𑆿𑆰𑇀𑆟𑇀𑆪𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑆪𑆬𑆳𑆔𑆮𑆾𑆥𑆥𑆤𑇀𑆤𑆂 𑆑𑇀𑆬𑆼𑆢𑆪𑆠𑇀𑆪𑆳𑆢𑆿 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆮𑆴𑆯𑆾𑆰𑆪𑆠𑆴 , 𑆱 𑆥𑆖𑆤𑆢𑆲𑆤𑆨𑆼𑆢𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼; 𑆱𑆾𑇁𑆠𑆴𑆥𑇀𑆫𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆂 𑆑𑆼𑆯𑆳𑆑𑇀𑆰𑆴𑆲𑆸𑆢𑆪𑆥𑆶𑆁𑆱𑇀𑆠𑇀𑆮𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆂 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆪𑆼 𑆲𑇀𑆪𑆼𑆤𑆁 𑆓𑇀𑆫𑆳𑆩𑆤𑆓𑆫𑆤𑆴𑆓𑆩𑆘𑆤𑆥𑆢𑆳𑆂 𑆱𑆠𑆠𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆠𑆼 𑆠 𑆄𑆤𑇀𑆣𑇀𑆪𑆰𑆳𑆟𑇀𑆞𑇀𑆪𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆥𑆳𑆬𑆴𑆠𑇀𑆪𑆨𑆳𑆘𑆾 𑆲𑆸𑆢𑆪𑆳𑆥𑆑𑆫𑇀𑆠𑆴𑆤𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆳𑆖𑇀𑆪𑆳𑆯𑇀𑆖𑆵𑆤𑆳𑆯𑇀𑆖; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆁 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠𑇆𑇑𑇗𑇆
𑆬𑆮𑆟𑆁 𑆥𑆶𑆤𑆫𑆿𑆰𑇀𑆟𑇀𑆪𑆠𑆽𑆑𑇀𑆰𑇀𑆟𑇀𑆪𑆾𑆥𑆥𑆤𑇀𑆤𑆩𑇀, 𑆃𑆤𑆠𑆴𑆓𑆶𑆫𑆶, 𑆃𑆤𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆩𑇀, 𑆇𑆥𑆑𑇀𑆬𑆼𑆢𑆴, 𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆤𑆱𑆩𑆫𑇀𑆡𑆩𑇀, 𑆃𑆤𑇀𑆤𑆢𑇀𑆫𑆮𑇀𑆪𑆫𑆶𑆖𑆴𑆑𑆫𑆩𑇀, 𑆄𑆥𑆳𑆠𑆨𑆢𑇀𑆫𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆱𑆩𑆱𑆳𑆢𑇀𑆓𑆶𑆟𑇀𑆪𑆳𑆠𑇀, 𑆢𑆾𑆰𑆱𑆚𑇀𑆖𑆪𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆁, 𑆠𑆢𑇀𑆫𑆾𑆖𑆤𑆥𑆳𑆖𑆤𑆾𑆥𑆑𑇀𑆬𑆼𑆢𑆤𑆮𑆴𑆱𑇀𑆫𑆁𑆱𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼𑇅 𑆠𑆢𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆁 𑆓𑇀𑆬𑆳𑆤𑆴𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆑𑆫𑆁 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆨𑆮𑆠𑆴𑇅 𑆪𑆼 𑆲𑇀𑆪𑆼𑆤𑆢𑇀𑆓𑇀𑆫𑆳𑆩𑆤𑆓𑆫𑆤𑆴𑆓𑆩𑆘𑆤𑆥𑆢𑆳𑆂 𑆱𑆠𑆠𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆠𑆼, 𑆠𑆼 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆓𑇀𑆬𑆳𑆱𑇀𑆤𑆮𑆂 𑆯𑆴𑆡𑆴𑆬𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳 𑆃𑆥𑆫𑆴𑆑𑇀𑆬𑆼𑆯𑆱𑆲𑆳𑆯𑇀𑆖 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆱𑆿𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆴𑆑𑆱𑆽𑆤𑇀𑆣𑆮𑆱𑆿𑆮𑆵𑆫𑆑𑆳𑆂; 𑆠𑆼 𑆲𑆴 𑆥𑆪𑆱𑆳𑇁𑆥𑆴 𑆱𑆲 𑆬𑆮𑆟𑆩𑆯𑇀𑆤𑆤𑇀𑆠𑆴𑇅 𑆪𑆼𑇁𑆥𑆵𑆲 𑆨𑆷𑆩𑆼𑆫𑆠𑇀𑆪𑆷𑆰𑆫𑆳 𑆢𑆼𑆯𑆳𑆱𑇀𑆠𑆼𑆰𑇀𑆮𑆾𑆰𑆣𑆴𑆮𑆵𑆫𑆶𑆢𑇀𑆮𑆤𑆱𑇀𑆥𑆠𑆴𑆮𑆳𑆤𑆱𑇀𑆥𑆠𑇀𑆪𑆳 𑆤 𑆘𑆳𑆪𑆤𑇀𑆠𑆼𑇁𑆬𑇀𑆥𑆠𑆼𑆘𑆱𑆾 𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆬𑆮𑆟𑆾𑆥𑆲𑆠𑆠𑇀𑆮𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆬𑇀𑆬𑆮𑆟𑆁 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠𑇅 𑆪𑆼 𑆲𑇀𑆪𑆠𑆴𑆬𑆮𑆟𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆩𑆥𑆴 𑆒𑆳𑆬𑆴𑆠𑇀𑆪𑆥𑆳𑆬𑆴𑆠𑇀𑆪𑆳𑆤𑆴 𑆮𑆬𑆪𑆯𑇀𑆖𑆳𑆑𑆳𑆬𑆼 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇘𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀𑆠𑆼𑆰𑆳𑆁 𑆠𑆠𑇀𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆠𑆂 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆥𑆓𑆩𑆤𑆁 𑆯𑇀𑆫𑆼𑆪𑆂𑇅 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆥𑆴 𑆲𑆴 𑆑𑇀𑆫𑆩𑆼𑆟𑆾𑆥𑆤𑆴𑆮𑆫𑇀𑆠𑇀𑆪𑆩𑆳𑆤𑆩𑆢𑆾𑆰𑆩𑆬𑇀𑆥𑆢𑆾𑆰𑆁 𑆮𑆳 𑆨𑆮𑆠𑆴𑇆𑇑𑇙𑇆
𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆤𑆳𑆩 𑆠𑆢𑇀 𑆪𑆢𑆳𑆠𑇀𑆩𑆤𑇀𑆪𑆶𑆥𑆯𑆼𑆠𑆼; 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆫𑇀𑆡𑆾 𑆲𑇀𑆪𑆶𑆥𑆯𑆪𑆳𑆫𑇀𑆡𑆂𑇅 𑆠𑆠𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆥𑇀𑆫𑆮𑆫𑆳𑆮𑆫𑆩𑆣𑇀𑆪𑆮𑆴𑆨𑆳𑆓𑆼𑆤; 𑆱𑆥𑇀𑆠𑆮𑆴𑆣𑆁 𑆠𑆶 𑆫𑆱𑆽𑆑𑆽𑆑𑆠𑇀𑆮𑆼𑆤 𑆱𑆫𑇀𑆮𑆫𑆱𑆾𑆥𑆪𑆾𑆓𑆳𑆖𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆫𑆱𑆁 𑆥𑇀𑆫𑆮𑆫𑆩𑇀, 𑆃𑆮𑆫𑆩𑆼𑆑𑆫𑆱𑆁, 𑆩𑆣𑇀𑆪𑆁 𑆠𑆶 𑆥𑇀𑆫𑆮𑆫𑆳𑆮𑆫𑆩𑆣𑇀𑆪𑆱𑇀𑆡𑆩𑇀𑇅 𑆠𑆠𑇀𑆫𑆳𑆮𑆫𑆩𑆣𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆨𑇀𑆪𑆳𑆁 𑆑𑇀𑆫𑆩𑆼𑆟𑆽𑆮 𑆥𑇀𑆫𑆮𑆫𑆩𑆶𑆥𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑇀𑇅 𑆱𑆫𑇀𑆮𑆫𑆱𑆩𑆥𑆴 𑆖 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆶𑆥𑆥𑆤𑇀𑆤𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑇀𑆪𑆶𑆥𑆪𑆾𑆑𑇀𑆠𑇀𑆫𑆰𑇀𑆛𑆩𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆳𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆪𑆠𑆤𑆳𑆤𑇀𑆪𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆲𑆴𑆠𑆩𑆼𑆮𑆳𑆤𑆶𑆫𑆶𑆣𑇀𑆪𑆼𑆠𑇆𑇒𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆫𑆱𑆳𑆤𑇀 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆢𑆾𑆰𑆳𑆁𑆯𑇀𑆖 𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆂𑇅 𑆮𑆼𑆢 𑆪𑆾 𑆢𑆼𑆯𑆑𑆳𑆬𑆿 𑆖 𑆯𑆫𑆵𑆫𑆁 𑆖 𑆱 𑆤𑆾 𑆨𑆴𑆰𑆑𑇀𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆮𑆴𑆩𑆳𑆤𑆳𑆫𑇀𑆡𑆾 𑆫𑆱𑆢𑇀𑆫𑆮𑇀𑆪𑆢𑆾𑆰𑆫𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆂𑇅 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆴 𑆤𑆳𑆠𑆴𑆱𑆼𑆮𑇀𑆪𑆳𑆤𑆴 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆼𑆮 𑆖𑇆𑇒𑇗𑇆
𑆄𑆲𑆳𑆫𑆳𑆪𑆠𑆤𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆿 𑆨𑆾𑆘𑇀𑆪𑆱𑆳𑆢𑇀𑆓𑆶𑆟𑇀𑆪𑆩𑆼𑆮 𑆖𑇅 𑆮𑆴𑆩𑆳𑆤𑆼 𑆫𑆱𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆼 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀𑇆𑇒𑇘𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆑𑆶𑆑𑇀𑆰𑆵𑆪𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆑𑆶𑆑𑇀𑆰𑆿 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑆮𑆑𑆳𑆯𑆳𑆁𑆯𑆩𑆳𑆲𑆳𑆫𑆱𑇀𑆪𑆳𑆲𑆳𑆫𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆍𑆑𑆩𑆮𑆑𑆳𑆯𑆳𑆁𑆯𑆁 𑆩𑆷𑆫𑇀𑆠𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑇀, 𑆍𑆑𑆁 𑆢𑇀𑆫𑆮𑆳𑆟𑆳𑆩𑇀, 𑆍𑆑𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆩𑇀; 𑆍𑆠𑆳𑆮𑆠𑆵𑆁 𑆲𑇀𑆪𑆳𑆲𑆳𑆫𑆩𑆳𑆠𑇀𑆫𑆳𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆳𑆤𑆾 𑆤𑆳𑆩𑆳𑆠𑇀𑆫𑆳𑆲𑆳𑆫𑆘𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆯𑆶𑆨𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆾𑆠𑆴𑇆𑇓𑇆
𑆤 𑆖 𑆑𑆼𑆮𑆬𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑆼𑆮𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆩𑆳𑆲𑆳𑆫𑆦𑆬𑆱𑆿𑆰𑇀𑆜𑆮𑆩𑆮𑆳𑆥𑇀𑆠𑆶𑆁 𑆯𑆑𑇀𑆪𑆁, 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆩𑆰𑇀𑆛𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆪𑆠𑆤𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆴𑆨𑆑𑇀𑆠𑆦𑆬𑆠𑇀𑆮𑆳𑆠𑇀𑇆𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆪𑆁 𑆠𑆳𑆮𑆢𑆳𑆲𑆳𑆫𑆫𑆳𑆯𑆴𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆩𑆳𑆠𑇀𑆫𑆳𑆦𑆬𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆳𑆫𑇀𑆡𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆂𑇅 𑆍𑆠𑆳𑆮𑆳𑆤𑆼𑆮 𑆲𑇀𑆪𑆳𑆲𑆳𑆫𑆫𑆳𑆯𑆴𑆮𑆴𑆣𑆴𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆪𑆳𑆮𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑇀𑆠𑇀𑆮𑆩𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑇀𑆠𑇀𑆮𑆁 𑆖𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑇀𑆠𑇀𑆮𑆁 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆑𑆶𑆑𑇀𑆰𑇀𑆪𑆁𑆯𑆮𑆴𑆨𑆳𑆓𑆼𑆤, 𑆠𑆢𑇀𑆨𑆷𑆪𑆾 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆶𑆑𑇀𑆰𑆼𑆫𑆥𑇀𑆫𑆟𑆵𑆝𑆤𑆩𑆳𑆲𑆳𑆫𑆼𑆟, 𑆲𑆸𑆢𑆪𑆱𑇀𑆪𑆳𑆤𑆮𑆫𑆾𑆣𑆂, 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆪𑆾𑆫𑆮𑆴𑆥𑆳𑆛𑆤𑆩𑇀, 𑆃𑆤𑆠𑆴𑆓𑆿𑆫𑆮𑆩𑆶𑆢𑆫𑆱𑇀𑆪, 𑆥𑇀𑆫𑆵𑆟𑆤𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁, 𑆑𑇀𑆰𑆶𑆠𑇀𑆥𑆴𑆥𑆳𑆱𑆾𑆥𑆫𑆩𑆂, 𑆱𑇀𑆡𑆳𑆤𑆳𑆱𑆤𑆯𑆪𑆤𑆓𑆩𑆤𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆥𑇀𑆫𑆯𑇀𑆮𑆳𑆱𑆲𑆳𑆱𑇀𑆪𑆱𑆕𑇀𑆑𑆡𑆳𑆱𑆶 𑆱𑆶𑆒𑆳𑆤𑆶𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆱𑆳𑆪𑆁 𑆥𑇀𑆫𑆳𑆠𑆯𑇀𑆖 𑆱𑆶𑆒𑆼𑆤 𑆥𑆫𑆴𑆟𑆩𑆤𑆁 , 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆥𑆖𑆪𑆑𑆫𑆠𑇀𑆮𑆁 𑆖; 𑆅𑆠𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑆾 𑆬𑆑𑇀𑆰𑆟𑆩𑆳𑆲𑆳𑆫𑆱𑇀𑆪 𑆨𑆮𑆠𑆴𑇆𑇖𑇆
𑆃𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑇀𑆠𑇀𑆮𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼- 𑆲𑆵𑆤𑆩𑇀, 𑆃𑆣𑆴𑆑𑆁 𑆖𑇅 𑆠𑆠𑇀𑆫 𑆲𑆵𑆤𑆩𑆳𑆠𑇀𑆫𑆩𑆳𑆲𑆳𑆫𑆫𑆳𑆯𑆴𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆥𑆖𑆪𑆑𑇀𑆰𑆪𑆑𑆫𑆩𑆠𑆸𑆥𑇀𑆠𑆴𑆑𑆫𑆩𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆑𑆫𑆩𑆤𑆳𑆪𑆶𑆰𑇀𑆪𑆮𑆸𑆰𑇀𑆪𑆩𑆤𑆿𑆘𑆱𑇀𑆪𑆁 𑆯𑆫𑆵𑆫𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆔𑆳𑆠𑆑𑆫𑆁 𑆱𑆳𑆫𑆮𑆴𑆣𑆩𑆤𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆮𑆲𑆩𑆯𑆵𑆠𑆼𑆯𑇀𑆖 𑆮𑆳𑆠𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆳𑆪𑆠𑆤𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼, 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆥𑆶𑆤𑆂 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂𑇅 𑆪𑆾 𑆲𑆴 𑆩𑆷𑆫𑇀𑆠𑆳𑆤𑆳𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆳𑆤𑆳𑆁 𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆓𑆠𑇀𑆮𑆳 𑆢𑇀𑆫𑆮𑆽𑆱𑇀𑆠𑆸𑆥𑇀𑆠𑆴𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼 𑆨𑆷𑆪𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆓𑆠𑆳 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆾𑇁𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆼𑆟𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆼𑆟𑆳𑆠𑆴𑆥𑇀𑆫𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆪𑆶𑆓𑆥𑆠𑇀 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆳𑆱𑇀𑆠𑆩𑆼𑆮𑆳𑆲𑆳𑆫𑆫𑆳𑆯𑆴𑆩𑆥𑆫𑆴𑆟𑆠𑆩𑆳𑆮𑆴𑆯𑇀𑆪 𑆑𑆶𑆑𑇀𑆰𑇀𑆪𑆼𑆑𑆢𑆼𑆯𑆩𑆤𑇀𑆤𑆳𑆯𑇀𑆫𑆴𑆠𑆳 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆪𑆤𑇀𑆠𑆂 𑆱𑆲𑆱𑆳 𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆳𑆣𑆫𑆳𑆨𑇀𑆪𑆳𑆁 𑆩𑆳𑆫𑇀𑆓𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆖𑇀𑆪𑆳𑆮𑆪𑆤𑇀𑆠𑆂 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆓𑆴𑆩𑆳𑆤𑇀 𑆮𑆴𑆑𑆳𑆫𑆳𑆤𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆨𑆾𑆑𑇀𑆠𑆶𑆂𑇅 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆂 𑆯𑆷𑆬𑆳𑆤𑆳𑆲𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆩𑆶𑆒𑆯𑆾𑆰𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆨𑇀𑆫𑆩𑆳𑆓𑇀𑆤𑆴𑆮𑆽𑆰𑆩𑇀𑆪- 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆑𑆛𑆴𑆓𑇀𑆫𑆲𑆱𑆴𑆫𑆳𑆑𑆶𑆚𑇀𑆖𑆤𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆳𑆤𑆴 𑆑𑆫𑆾𑆠𑆴, 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑆶𑆤𑆫𑇀𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆳𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆢𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆥𑆤𑆳𑆤𑆴, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆠𑆶 𑆗𑆫𑇀𑆢𑇀𑆪𑆫𑆾𑆖𑆑𑆳𑆮𑆴𑆥𑆳𑆑𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆬𑆱𑇀𑆪𑆓𑆳𑆠𑇀𑆫𑆓𑆿𑆫𑆮𑆳𑆟𑆴𑇆𑇗𑇆
𑆤 𑆖 𑆒𑆬𑆶 𑆑𑆼𑆮𑆬𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆼𑆮𑆳𑆲𑆳𑆫𑆫𑆳𑆯𑆴𑆩𑆳𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆑𑆫𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 , 𑆃𑆥𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆓𑆶𑆫𑆶𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆯𑆶𑆰𑇀𑆑𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆯𑆶𑆖𑆴𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆤𑆳𑆩𑆑𑆳𑆬𑆼 𑆖𑆳𑆤𑇀𑆤𑆥𑆳𑆤𑆳𑆤𑆳𑆩𑆶𑆥𑆱𑆼𑆮𑆤𑆁, 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆩𑆾𑆲𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆲𑇀𑆫𑆵𑆯𑆾𑆑𑆩𑆳𑆤𑆾𑆢𑇀𑆮𑆼𑆓𑆨𑆪𑆾𑆥𑆠𑆥𑇀𑆠𑆩𑆤𑆱𑆳 𑆮𑆳 𑆪𑆢𑆤𑇀𑆤𑆥𑆳𑆤𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆠𑆼, 𑆠𑆢𑆥𑇀𑆪𑆳𑆩𑆩𑆼𑆮 𑆥𑇀𑆫𑆢𑆷𑆰𑆪𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆳𑆠𑇀𑆫𑆪𑆳𑇁𑆥𑇀𑆪𑆨𑇀𑆪𑆮𑆲𑆸𑆠𑆁 𑆥𑆡𑇀𑆪𑆁 𑆖𑆳𑆤𑇀𑆤𑆁 𑆤 𑆘𑆵𑆫𑇀𑆪𑆠𑆴𑇅 𑆖𑆴𑆤𑇀𑆠𑆳𑆯𑆾𑆑𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆢𑆶𑆂𑆒𑆯𑆪𑇀𑆪𑆳𑆥𑇀𑆫𑆘𑆳𑆓𑆫𑆽𑆂𑇆𑇙𑇆
𑆠𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆳𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆩𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆨𑆴𑆰𑆘𑆂- 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆩𑇀, 𑆃𑆬𑆱𑆑𑆁 𑆖𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆖𑆳𑆣𑆯𑇀𑆖 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆳𑆩𑆢𑆾𑆰𑆳𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆫𑆷𑆥𑆳𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆃𑆬𑆱𑆑𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪𑆳𑆬𑇀𑆥𑆳𑆓𑇀𑆤𑆼𑆫𑇀𑆧𑆲𑆶𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆾 𑆮𑆳𑆠𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆮𑆼𑆓𑆮𑆴𑆣𑆳𑆫𑆴𑆟𑆂 𑆱𑇀𑆡𑆴𑆫𑆓𑆶𑆫𑆶𑆧𑆲𑆶𑆫𑆷𑆑𑇀𑆰𑆯𑆵𑆠𑆯𑆶𑆰𑇀𑆑𑆳𑆤𑇀𑆤𑆱𑆼𑆮𑆴𑆤𑆱𑇀𑆠𑆢𑆤𑇀𑆤𑆥𑆳𑆤𑆩𑆤𑆴𑆬𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆖 𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆥𑇀𑆫𑆬𑆵𑆤𑆩𑆬𑆱𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆧𑆲𑆴𑆫𑇀𑆩𑆶𑆒𑆵𑆨𑆮𑆠𑆴, 𑆠𑆠𑆯𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆤𑇀𑆪𑆳𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆨𑆴𑆢𑆫𑇀𑆯𑆪𑆠𑇀𑆪𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆳𑆟𑆴𑇅 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆩𑆧𑆢𑇀𑆣𑆩𑆳𑆫𑇀𑆓𑆳𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆂 𑆑𑆢𑆳𑆖𑆴𑆢𑆼𑆮 𑆑𑆼𑆮𑆬𑆩𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆁 𑆢𑆟𑇀𑆝𑆮𑆠𑇀 𑆱𑇀𑆠𑆩𑇀𑆨𑆪𑆤𑇀𑆠𑆴, 𑆠𑆠𑆱𑇀𑆠𑆁 𑆢𑆟𑇀𑆝𑆳𑆬𑆱𑆑𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆧𑇀𑆫𑆶𑆮𑆠𑆼𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆯𑆤𑆯𑆵𑆬𑆴𑆤𑆂 𑆥𑆶𑆤𑆫𑆳𑆩𑆢𑆾𑆰𑆩𑆳𑆩𑆮𑆴𑆰𑆩𑆴𑆠𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆨𑆴𑆰𑆘𑆂, 𑆮𑆴𑆰𑆱𑆢𑆸𑆯𑆬𑆴𑆕𑇀𑆓𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑇀 𑆥𑆫𑆩𑆱𑆳𑆣𑇀𑆪𑆩𑇀, 𑆄𑆯𑆶𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆾𑆥𑆑𑇀𑆫𑆩𑆠𑇀𑆮𑆳𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆱𑆳𑆣𑇀𑆪𑆩𑆳𑆩𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆩𑆬𑆱𑆵𑆨𑆷𑆠𑆩𑆶𑆬𑇀𑆬𑆼𑆒𑆪𑆼𑆢𑆳𑆢𑆿 𑆥𑆳𑆪𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑆬𑆮𑆟𑆩𑆶𑆰𑇀𑆟𑆁 𑆮𑆳𑆫𑆴, 𑆠𑆠𑆂 𑆱𑇀𑆮𑆼𑆢𑆤𑆮𑆫𑇀𑆠𑆴𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆨𑇀𑆪𑆳𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆢𑆶𑆥𑆮𑆳𑆱𑆪𑆼𑆖𑇀𑆖𑆽𑆤𑆩𑇀𑇅 𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆪𑆳𑆁 𑆠𑆶 𑆬𑆕𑇀𑆔𑆤𑆩𑆼𑆮𑆳𑆓𑇀𑆫𑆼 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆮𑆖𑇀𑆖𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑆵𑇅 𑆄𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆼𑆰𑆶 𑆠𑇀𑆮𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑆘𑆵𑆫𑇀𑆟𑆳𑆲𑆳𑆫𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆾𑆰𑆳𑆮𑆬𑆴𑆥𑇀𑆠𑆳𑆩𑆳𑆯𑆪𑆁 𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆓𑆶𑆫𑆶𑆑𑆾𑆰𑇀𑆜𑆩𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆳𑆰𑆴𑆟𑆩𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑆳𑆪𑆪𑆼𑆢𑇀𑆢𑆾𑆰𑆯𑆼𑆰𑆥𑆳𑆖𑆤𑆳𑆫𑇀𑆡𑆩𑆿𑆰𑆣𑆩𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆣𑆶𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁 𑆖, 𑆤𑆠𑇀𑆮𑆼𑆮𑆳𑆘𑆵𑆫𑇀𑆟𑆳𑆯𑆤𑆩𑇀; 𑆄𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆢𑆶𑆫𑇀𑆧𑆬𑆾 𑆲𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑇀𑆤 𑆪𑆶𑆓𑆥𑆢𑇀𑆢𑆾𑆰𑆩𑆿𑆰𑆣𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆁 𑆖 𑆯𑆑𑇀𑆠𑆂 𑆥𑆑𑇀𑆠𑆶𑆩𑇀𑇅 𑆃𑆥𑆴 𑆖𑆳𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆳𑆲𑆳𑆫𑆿𑆰𑆣𑆮𑆴𑆨𑇀𑆫𑆩𑆾𑇁𑆠𑆴𑆧𑆬𑆠𑇀𑆮𑆳𑆢𑆶𑆥𑆫𑆠𑆑𑆳𑆪𑆳𑆓𑇀𑆤𑆴𑆁 𑆱𑆲𑆱𑆽𑆮𑆳𑆠𑆶𑆫𑆩𑆧𑆬𑆩𑆠𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀𑇅 𑆄𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆘𑆳𑆤𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆥𑆠𑆫𑇀𑆥𑆟𑆼𑆤𑆽𑆮𑆾𑆥𑆫𑆩𑆾 𑆨𑆮𑆠𑆴, 𑆱𑆠𑆴 𑆠𑇀𑆮𑆤𑆶𑆧𑆤𑇀𑆣𑆼 𑆑𑆸𑆠𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆤𑆴𑆓𑇀𑆫𑆲𑆼 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆥𑆳𑆱𑇀𑆪𑆿𑆰𑆣𑆩𑆳𑆠𑆕𑇀𑆑𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆼𑆮𑆳𑆮𑆖𑆳𑆫𑆪𑆼𑆢𑇀𑆪𑆡𑆳𑆱𑇀𑆮𑆩𑇀𑇅 𑆱𑆫𑇀𑆮𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆩𑆥𑆴 𑆖 𑆤𑆴𑆓𑇀𑆫𑆲𑆼 𑆲𑆼𑆠𑆶𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆴𑆥𑆫𑆵𑆠𑆩𑆿𑆰𑆣𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂, 𑆠𑆢𑆫𑇀𑆡𑆑𑆳𑆫𑆴 𑆮𑆳𑇅 𑆮𑆴𑆩𑆶𑆑𑇀𑆠𑆳𑆩𑆥𑇀𑆫𑆢𑆾𑆰𑆱𑇀𑆪 𑆥𑆶𑆤𑆂 𑆥𑆫𑆴𑆥𑆑𑇀𑆮𑆢𑆾𑆰𑆱𑇀𑆪 𑆢𑆵𑆥𑇀𑆠𑆼 𑆖𑆳𑆓𑇀𑆤𑆳𑆮𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆁 𑆮𑆴𑆣𑆴𑆮𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆁 𑆖 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑇀𑆫𑆪𑆾𑆘𑇀𑆪𑆁 𑆥𑇀𑆫𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆨𑆼𑆰𑆘𑆢𑆼𑆯𑆑𑆳𑆬𑆧𑆬𑆯𑆫𑆵𑆫𑆳𑆲𑆳𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆪𑆱𑆳𑆩𑆮𑆱𑇀𑆡𑆳𑆤𑇀𑆠𑆫𑆳𑆟𑆴 𑆮𑆴𑆑𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆱𑆩𑇀𑆪𑆓𑆴𑆠𑆴𑇆𑇑𑇓𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆲𑆳𑆫𑆮𑆴𑆣𑇀𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆴 𑆖𑆳𑆰𑇀𑆛𑆿 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆠𑇀𑆩𑆲𑆴𑆠𑆁 𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆤𑇀𑆪𑆯𑇀𑆖 𑆪𑆂 𑆑𑆯𑇀𑆖𑆴𑆢𑆴𑆲𑆳𑆱𑇀𑆠𑆴 𑆩𑆳𑆫𑇀𑆓𑆾 𑆲𑆴𑆠𑆾𑆥𑆪𑆾𑆓𑆼𑆰𑆶 𑆨𑆘𑆼𑆠 𑆠𑆁 𑆖𑇆𑇑𑇔𑇆
𑆃𑆯𑆴𑆠𑆁 𑆒𑆳𑆢𑆴𑆠𑆁 𑆥𑆵𑆠𑆁 𑆬𑆵𑆞𑆁 𑆖 𑆑𑇀𑆮 𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼𑇅 𑆍𑆠𑆠𑇀𑆠𑇀𑆮𑆳𑆁 𑆣𑆵𑆫! 𑆥𑆸𑆖𑇀𑆗𑆳𑆩𑆱𑇀𑆠𑆤𑇀𑆤 𑆄𑆖𑆑𑇀𑆰𑇀𑆮 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆤𑇀𑇆𑇑𑇕𑇆
𑆅𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆥𑇀𑆫𑆩𑆶𑆒𑆽𑆂 𑆯𑆴𑆰𑇀𑆪𑆽𑆂 𑆥𑆸𑆰𑇀𑆛𑆂 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂𑇅 𑆄𑆖𑆖𑆑𑇀𑆰𑆼 𑆠𑆠𑆱𑇀𑆠𑆼𑆨𑇀𑆪𑆾 𑆪𑆠𑇀𑆫𑆳𑆲𑆳𑆫𑆾 𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇆
𑆤𑆳𑆨𑆴𑆱𑇀𑆠𑆤𑆳𑆤𑇀𑆠𑆫𑆁 𑆘𑆤𑇀𑆠𑆾𑆫𑆳𑆩𑆳𑆯𑆪 𑆅𑆠𑆴 𑆱𑇀𑆩𑆸𑆠𑆂𑇅 𑆃𑆯𑆴𑆠𑆁 𑆒𑆳𑆢𑆴𑆠𑆁 𑆥𑆵𑆠𑆁 𑆬𑆵𑆞𑆁 𑆖𑆳𑆠𑇀𑆫 𑆮𑆴𑆥𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇗𑇆
𑆄𑆩𑆳𑆯𑆪𑆓𑆠𑆂 𑆥𑆳𑆑𑆩𑆳𑆲𑆳𑆫𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆑𑆼𑆮𑆬𑆩𑇀𑇅 𑆥𑆑𑇀𑆮𑆂 𑆱𑆫𑇀𑆮𑆳𑆯𑆪𑆁 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆣𑆩𑆤𑆵𑆨𑆴𑆂 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆠𑆱𑇀𑆪 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆠𑆾 𑆬𑆴𑆕𑇀𑆓𑆁 𑆦𑆬𑆁 𑆖𑆾𑆑𑇀𑆠𑆁 𑆪𑆡𑆳𑆪𑆡𑆩𑇀𑇅 𑆃𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆪 𑆠𑆡𑆳 𑆬𑆴𑆕𑇀𑆓𑆁 𑆦𑆬𑆁 𑆖𑆾𑆑𑇀𑆠𑆁 𑆮𑆴𑆨𑆳𑆓𑆯𑆂𑇆𑇑𑇙𑇆
𑆃𑆡𑆳𑆠𑆾 𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑆵𑆪𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆘𑆤𑆥𑆢𑆩𑆟𑇀𑆝𑆬𑆼 𑆥𑆚𑇀𑆖𑆳𑆬𑆑𑇀𑆰𑆼𑆠𑇀𑆫𑆼 𑆢𑇀𑆮𑆴𑆘𑆳𑆠𑆴𑆮𑆫𑆳𑆣𑇀𑆪𑆶𑆰𑆴𑆠𑆼 𑆑𑆳𑆩𑇀𑆥𑆴𑆬𑇀𑆪𑆫𑆳𑆘𑆣𑆳𑆤𑇀𑆪𑆳𑆁 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆾𑇁𑆤𑇀𑆠𑆼𑆮𑆳𑆱𑆴𑆓𑆟𑆥𑆫𑆴𑆮𑆸𑆠𑆂 𑆥𑆯𑇀𑆖𑆴𑆩𑆼 𑆔𑆫𑇀𑆩𑆩𑆳𑆱𑆼 𑆓𑆕𑇀𑆓𑆳𑆠𑆵𑆫𑆼 𑆮𑆤𑆮𑆴𑆖𑆳𑆫𑆩𑆤𑆶𑆮𑆴𑆖𑆫𑆚𑇀𑆗𑆴𑆰𑇀𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆩𑆧𑇀𑆫𑆮𑆵𑆠𑇀𑇆𑇓𑇆
𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆲𑆴 𑆒𑆬𑆶 𑆱𑆿𑆩𑇀𑆪! 𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆓𑇀𑆫𑆲𑆓𑆟𑆖𑆤𑇀𑆢𑇀𑆫𑆱𑆷𑆫𑇀𑆪𑆳𑆤𑆴𑆬𑆳𑆤𑆬𑆳𑆤𑆳𑆁 𑆢𑆴𑆯𑆳𑆁 𑆖𑆳𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆸𑆠𑆶𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳 𑆨𑆳𑆮𑆳𑆂, 𑆃𑆖𑆴𑆫𑆳𑆢𑆴𑆠𑆾 𑆨𑆷𑆫𑆥𑆴 𑆖 𑆤 𑆪𑆡𑆳𑆮𑆢𑇀𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆩𑆾𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑆮𑆴𑆣𑆳𑆱𑇀𑆪𑆠𑆴, 𑆠𑆢𑇀𑆮𑆴𑆪𑆾𑆓𑆳𑆖𑇀𑆖𑆳𑆠𑆕𑇀𑆑𑆥𑇀𑆫𑆳𑆪𑆠𑆳 𑆤𑆴𑆪𑆠𑆳𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆓𑆶𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆑𑇀 𑆖 𑆨𑆷𑆩𑆼𑆫𑇀𑆮𑆴𑆫𑆱𑆵𑆨𑆳𑆮𑆳𑆢𑆶𑆢𑇀𑆣𑆫𑆣𑇀𑆮𑆁 𑆱𑆿𑆩𑇀𑆪! 𑆨𑆽𑆰𑆘𑇀𑆪𑆳𑆤𑆴 𑆪𑆳𑆮𑆤𑇀𑆤𑆾𑆥𑆲𑆠𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆟𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆮𑆪𑆁 𑆖𑆽𑆰𑆳𑆁 𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆤𑆶𑆥𑆪𑆾𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆲𑆼 𑆪𑆼 𑆖𑆳𑆱𑇀𑆩𑆳𑆤𑆤𑆶𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆤𑇀𑆠𑆴, 𑆪𑆳𑆁𑆯𑇀𑆖 𑆮𑆪𑆩𑆤𑆶𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳𑆩𑆂𑇅 𑆤 𑆲𑆴 𑆱𑆩𑇀𑆪𑆓𑆶𑆢𑇀𑆣𑆸𑆠𑆼𑆰𑆶 𑆱𑆿𑆩𑇀𑆪! 𑆨𑆽𑆰𑆘𑇀𑆪𑆼𑆰𑆶 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆲𑆴𑆠𑆼𑆰𑆶 𑆱𑆩𑇀𑆪𑆑𑇀 𑆖𑆳𑆮𑆖𑆳𑆫𑆴𑆠𑆼𑆰𑆶 𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆑𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆓𑆿𑆫𑆮𑆁 𑆨𑆮𑆠𑆴𑇆𑇔𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆇𑆢𑇀𑆣𑆸𑆠𑆳𑆤𑆴 𑆒𑆬𑆶 𑆨𑆓𑆮𑆤𑇀! 𑆨𑆽𑆰𑆘𑇀𑆪𑆳𑆤𑆴, 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆲𑆴𑆠𑆳𑆤𑆴, 𑆱𑆩𑇀𑆪𑆓𑆮𑆖𑆳𑆫𑆴𑆠𑆳𑆤𑆴 𑆖; 𑆃𑆥𑆴 𑆠𑆶 𑆒𑆬𑆶 𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑆩𑆼𑆑𑆼𑆤𑆽𑆮 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆳 𑆪𑆶𑆓𑆥𑆢𑆱𑆩𑆳𑆤𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆢𑆼𑆲𑆧𑆬𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆱𑆠𑇀𑆠𑇀𑆮𑆮𑆪𑆱𑆳𑆁 𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆑𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆮𑆠𑆵𑆠𑆴𑇆𑇕𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆍𑆮𑆩𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆮𑆠𑆳𑆩𑆥𑇀𑆪𑆼𑆨𑆴𑆫𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆨𑆳𑆮𑆽𑆫𑇀𑆩𑆤𑆶𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆪𑆼𑇁𑆤𑇀𑆪𑆼 𑆨𑆳𑆮𑆳𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆳𑆠𑇀 𑆱𑆩𑆳𑆤𑆑𑆳𑆬𑆳𑆂 𑆱𑆩𑆳𑆤𑆬𑆴𑆕𑇀𑆓𑆳𑆯𑇀𑆖 𑆮𑇀𑆪𑆳𑆣𑆪𑆾𑇁𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆳 𑆘𑆤𑆥𑆢𑆩𑆶𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆪𑆤𑇀𑆠𑆴𑇅 𑆠𑆼 𑆠𑆶 𑆒𑆬𑇀𑆮𑆴𑆩𑆼 𑆨𑆳𑆮𑆳𑆂 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳 𑆘𑆤𑆥𑆢𑆼𑆰𑆶 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆪𑆶𑆂, 𑆇𑆢𑆑𑆁, 𑆢𑆼𑆯𑆂, 𑆑𑆳𑆬 𑆅𑆠𑆴𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆩𑆼𑆮𑆁𑆮𑆴𑆣𑆩𑆤𑆳𑆫𑆾𑆓𑇀𑆪𑆑𑆫𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆢𑇀𑆪𑆡𑆳-𑆪𑆡𑆫𑇀𑆠𑆶𑆮𑆴𑆰𑆩𑆩𑆠𑆴𑆱𑇀𑆠𑆴𑆩𑆴𑆠𑆩𑆠𑆴𑆖𑆬𑆩𑆠𑆴𑆥𑆫𑆶𑆰𑆩𑆠𑆴𑆯𑆵𑆠𑆩𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆩𑆠𑆴𑆫𑆷𑆑𑇀𑆰𑆩𑆠𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆩𑆠𑆴𑆨𑆽𑆫𑆮𑆳𑆫𑆳𑆮𑆩𑆠𑆴𑆥𑇀𑆫𑆠𑆴𑆲𑆠- 𑆥𑆫𑆱𑇀𑆥𑆫𑆓𑆠𑆴𑆩𑆠𑆴𑆑𑆶𑆟𑇀𑆝𑆬𑆴𑆤𑆩𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆓𑆤𑇀𑆣𑆧𑆳𑆰𑇀𑆥𑆱𑆴𑆑𑆠𑆳𑆥𑆳𑆁𑆯𑆶𑆣𑆷𑆩𑆾𑆥𑆲𑆠𑆩𑆴𑆠𑆴 (𑇑); 𑆇𑆢𑆑𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆠𑇀𑆪𑆫𑇀𑆡𑆮𑆴𑆑𑆸𑆠𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆑𑇀𑆬𑆼𑆢𑆧𑆲𑆶𑆬𑆩𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆘𑆬𑆖𑆫𑆮𑆴𑆲𑆕𑇀𑆓𑆩𑆶𑆥𑆑𑇀𑆰𑆵𑆟𑆘𑆬𑆼𑆯𑆪𑆩𑆥𑇀𑆫𑆵𑆠𑆴𑆑𑆫𑆩𑆥𑆓𑆠𑆓𑆶𑆟𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇒); 𑆢𑆼𑆯𑆁 𑆥𑆶𑆤𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆮𑆫𑇀𑆟𑆓𑆤𑇀𑆣𑆫𑆱𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆑𑇀𑆬𑆼𑆢𑆧𑆲𑆶𑆬𑆩𑆶𑆥𑆱𑆸𑆰𑇀𑆛𑆁 𑆱𑆫𑆵𑆱𑆸𑆥𑆮𑇀𑆪𑆳𑆬𑆩𑆯𑆑𑆯𑆬𑆨𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆩𑆷𑆰𑆑𑆾𑆬𑆷𑆑𑆯𑇀𑆩𑆳𑆯𑆳𑆤𑆴𑆑𑆯𑆑𑆶𑆤𑆴𑆘𑆩𑇀𑆧𑆷𑆑𑆳𑆢𑆴𑆨𑆴𑆱𑇀𑆠𑆸𑆟𑆾𑆬𑆷𑆥𑆾𑆥𑆮𑆤𑆮𑆤𑇀𑆠𑆁 𑆥𑇀𑆫𑆠𑆳𑆤𑆳𑆢𑆴𑆧𑆲𑆶𑆬𑆩𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆮𑆥𑆠𑆴𑆠𑆯𑆶𑆰𑇀𑆑𑆤𑆰𑇀𑆛𑆯𑆱𑇀𑆪𑆁 𑆣𑆷𑆩𑇀𑆫𑆥𑆮𑆤𑆁 𑆥𑇀𑆫𑆣𑇀𑆩𑆳𑆠𑆥𑆠𑆠𑇀𑆫𑆴𑆓𑆟𑆩𑆶𑆠𑇀𑆑𑇀𑆫𑆶𑆰𑇀𑆛𑆯𑇀𑆮𑆓𑆟𑆩𑆶𑆢𑇀𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆮𑇀𑆪𑆡𑆴𑆠𑆮𑆴𑆮𑆴𑆣𑆩𑆸𑆓𑆥𑆑𑇀𑆰𑆴𑆱𑆕𑇀𑆔𑆩𑆶𑆠𑇀𑆱𑆸𑆰𑇀𑆛𑆤𑆰𑇀𑆛𑆣𑆫𑇀𑆩𑆱𑆠𑇀𑆪𑆬𑆘𑇀𑆘𑆳𑆖𑆳𑆫𑆯𑆵𑆬𑆓𑆶𑆟𑆘𑆤𑆥𑆢𑆁 𑆯𑆯𑇀𑆮𑆠𑇀𑆑𑇀𑆰𑆶𑆨𑆴𑆠𑆾𑆢𑆵𑆫𑇀𑆟𑆱𑆬𑆴𑆬𑆳𑆯𑆪𑆁 𑆥𑇀𑆫𑆠𑆠𑆾𑆬𑇀𑆑𑆳𑆥𑆳𑆠𑆤𑆴𑆫𑇀𑆔𑆳𑆠𑆨𑆷𑆩𑆴𑆑𑆩𑇀𑆥𑆩𑆠𑆴𑆨𑆪𑆳𑆫𑆳𑆮𑆫𑆷𑆥𑆁 𑆫𑆷𑆑𑇀𑆰𑆠𑆳𑆩𑇀𑆫𑆳𑆫𑆶𑆟𑆱𑆴𑆠𑆳𑆨𑇀𑆫𑆘𑆳𑆬𑆱𑆁𑆮𑆸𑆠𑆳𑆫𑇀𑆑𑆖𑆤𑇀𑆢𑇀𑆫𑆠𑆳𑆫𑆑𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑆱𑆩𑇀𑆨𑇀𑆫𑆩𑆾𑆢𑇀𑆮𑆼𑆓𑆩𑆴𑆮 𑆱𑆠𑇀𑆫𑆳𑆱𑆫𑆶𑆢𑆴𑆠𑆩𑆴𑆮 𑆱𑆠𑆩𑆱𑇀𑆑𑆩𑆴𑆮 𑆓𑆶𑆲𑇀𑆪𑆑𑆳𑆖𑆫𑆴𑆠𑆩𑆴𑆮𑆳𑆑𑇀𑆫𑆤𑇀𑆢𑆴𑆠𑆯𑆧𑇀𑆢𑆧𑆲𑆶𑆬𑆁 𑆖𑆳𑆲𑆴𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 (𑇓); 𑆑𑆳𑆬𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆪𑆡𑆫𑇀𑆠𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆬𑆴𑆕𑇀𑆓𑆩𑆠𑆴𑆬𑆴𑆕𑇀𑆓𑆁 𑆲𑆵𑆤𑆬𑆴𑆕𑇀𑆓𑆁 𑆖𑆳𑆲𑆴𑆠𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀 (𑇔); 𑆅𑆩𑆳𑆤𑆼𑆮𑆤𑇀𑆢𑆾𑆰𑆪𑆶𑆑𑇀𑆠𑆳𑆁𑆯𑇀𑆖𑆠𑆶𑆫𑆾 𑆨𑆳𑆮𑆳𑆚𑇀𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆑𑆫𑆳𑆤𑇀 𑆮𑆢𑆤𑇀𑆠𑆴 𑆑𑆶𑆯𑆬𑆳𑆂; 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳𑆨𑆷𑆠𑆳𑆁𑆱𑇀𑆠𑆶 𑆲𑆴𑆠𑆳𑆤𑆳𑆖𑆑𑇀𑆰𑆠𑆼𑇆𑇗𑇆
𑆮𑆴𑆓𑆶𑆟𑆼𑆰𑇀𑆮𑆥𑆴 𑆒𑆬𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆑𑆫𑆼𑆰𑆶 𑆨𑆳𑆮𑆼𑆰𑆶 𑆨𑆼𑆰𑆘𑆼𑆤𑆾𑆥𑆥𑆳𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆩𑆨𑆪𑆁 𑆨𑆮𑆠𑆴 𑆫𑆾𑆓𑆼𑆨𑇀𑆪 𑆅𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆶𑆥𑆥𑆤𑇀𑆤𑆳𑆤𑆳𑆁 𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆤𑆴𑆬𑆳𑆩𑇀𑆨𑆱𑆳𑆩𑇀𑇅 𑆓𑆫𑆵𑆪𑆱𑇀𑆠𑇀𑆮𑆁 𑆮𑆴𑆯𑆼𑆰𑆼𑆟 𑆲𑆼𑆠𑆶𑆩𑆠𑇀 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇙𑇆
𑆮𑆳𑆠𑆳𑆘𑇀𑆘𑆬𑆁 𑆘𑆬𑆳𑆢𑇀𑆢𑆼𑆯𑆁 𑆢𑆼𑆯𑆳𑆠𑇀 𑆑𑆳𑆬𑆁 𑆱𑇀𑆮𑆨𑆳𑆮𑆠𑆂𑇅 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆥𑆫𑆴𑆲𑆳𑆫𑇀𑆪𑆠𑇀𑆮𑆳𑆢𑇀𑆓𑆫𑆵𑆪𑆱𑇀𑆠𑆫𑆩𑆫𑇀𑆡𑆮𑆴𑆠𑇀 𑇆𑇑𑇐𑇆
𑆮𑆳𑆪𑇀𑆮𑆳𑆢𑆴𑆰𑆶 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆠𑇀𑇅 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆱𑇀𑆪 𑆱𑆿𑆑𑆫𑇀𑆪𑆼 𑆮𑆴𑆢𑇀𑆪𑆳𑆬𑇀𑆬𑆳𑆔𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇑𑇆
𑆖𑆠𑆶𑆫𑇀𑆰𑇀𑆮𑆥𑆴 𑆠𑆶 𑆢𑆶𑆰𑇀𑆛𑆼𑆰𑆶 𑆑𑆳𑆬𑆳𑆤𑇀𑆠𑆼𑆰𑆶 𑆪𑆢𑆳 𑆤𑆫𑆳𑆂𑇅 𑆨𑆼𑆰𑆘𑆼𑆤𑆾𑆥𑆥𑆳𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆤 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆠𑆶𑆫𑆳𑆱𑇀𑆠𑆢𑆳𑇆𑇑𑇒𑇆
𑆪𑆼𑆰𑆳𑆁 𑆤 𑆩𑆸𑆠𑇀𑆪𑆶𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆁 𑆤 𑆖 𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑇀𑇅 𑆑𑆫𑇀𑆩 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆁 𑆠𑆼𑆰𑆳𑆁 𑆨𑆼𑆰𑆘𑆁 𑆥𑆫𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇆
𑆫𑆱𑆳𑆪𑆤𑆳𑆤𑆳𑆁 𑆮𑆴𑆣𑆴𑆮𑆖𑇀𑆖𑆾𑆥𑆪𑆾𑆓𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆯𑆱𑇀𑆪𑆠𑆼 𑆢𑆼𑆲𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆨𑆼𑆰𑆘𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆢𑇀𑆣𑆸𑆠𑆽𑆂𑇆𑇑𑇔𑇆
𑆱𑆠𑇀𑆪𑆁 𑆨𑆷𑆠𑆼 𑆢𑆪𑆳 𑆢𑆳𑆤𑆁 𑆧𑆬𑆪𑆾 𑆢𑆼𑆮𑆠𑆳𑆫𑇀𑆖𑆤𑆩𑇀𑇅 𑆱𑆢𑇀𑆣𑆸𑆠𑇀𑆠𑆱𑇀𑆪𑆳𑆤𑆶𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆯𑆩𑆾 𑆓𑆶𑆥𑇀𑆠𑆴𑆫𑆳𑆠𑇀𑆩𑆤𑆂𑇆𑇑𑇕𑇆
𑆲𑆴𑆠𑆁 𑆘𑆤𑆥𑆢𑆳𑆤𑆳𑆁 𑆖 𑆯𑆴𑆮𑆳𑆤𑆳𑆩𑆶𑆥𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆱𑆼𑆮𑆤𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆱𑇀𑆪 𑆠𑆡𑆽𑆮 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆳𑆫𑆴𑆟𑆳𑆩𑇀𑇆𑇑𑇖𑇆
𑆱𑆕𑇀𑆑𑆡𑆳 𑆣𑆫𑇀𑆩𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆩𑆲𑆫𑇀𑆰𑆵𑆟𑆳𑆁 𑆘𑆴𑆠𑆳𑆠𑇀𑆩𑆤𑆳𑆩𑇀𑇅 𑆣𑆳𑆫𑇀𑆩𑆴𑆑𑆽𑆂 𑆱𑆳𑆠𑇀𑆠𑇀𑆮𑆴𑆑𑆽𑆫𑇀𑆤𑆴𑆠𑇀𑆪𑆁 𑆱𑆲𑆳𑆱𑇀𑆪𑆳 𑆮𑆸𑆢𑇀𑆣𑆱𑆩𑇀𑆩𑆠𑆽𑆂𑇆𑇑𑇗𑇆
𑆅𑆠𑇀𑆪𑆼𑆠𑆢𑇀𑆨𑆼𑆰𑆘𑆁 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆩𑆳𑆪𑆶𑆰𑆂 𑆥𑆫𑆴𑆥𑆳𑆬𑆤𑆩𑇀𑇅 𑆪𑆼𑆰𑆳𑆩𑆤𑆴𑆪𑆠𑆾 𑆩𑆸𑆠𑇀𑆪𑆶𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼 𑆱𑆶𑆢𑆳𑆫𑆶𑆟𑆼𑇆𑇑𑇘𑇆
𑆅𑆠𑆴 𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆘𑆤𑆥𑆢𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑆼 𑆑𑆳𑆫𑆟𑆳𑆤𑆴 𑆥𑆶𑆤𑆫𑆥𑆴 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆃𑆡 𑆒𑆬𑆶 𑆨𑆓𑆮𑆤𑇀! 𑆑𑆶𑆠𑆾𑆩𑆷𑆬𑆩𑆼𑆰𑆳𑆁 𑆮𑆳𑆪𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼? 𑆪𑆼𑆤𑆾𑆥𑆥𑆤𑇀𑆤𑆳 𑆘𑆤𑆥𑆢𑆩𑆶𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆪𑆤𑇀𑆠𑆵𑆠𑆴𑇆𑇑𑇙𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆥𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆮𑆳𑆪𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆪𑆢𑇀𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆠𑆱𑇀𑆪 𑆩𑆷𑆬𑆩𑆣𑆫𑇀𑆩𑆂, 𑆠𑆤𑇀𑆩𑆷𑆬𑆁 𑆮𑆳𑇁𑆱𑆠𑇀𑆑𑆫𑇀𑆩 𑆥𑆷𑆫𑇀𑆮𑆑𑆸𑆠𑆁; 𑆠𑆪𑆾𑆫𑇀𑆪𑆾𑆤𑆴𑆂 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣 𑆍𑆮𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆪𑆢𑆳 𑆮𑆽 𑆢𑆼𑆯𑆤𑆓𑆫𑆤𑆴𑆓𑆩𑆘𑆤𑆥𑆢𑆥𑇀𑆫𑆣𑆳𑆤𑆳 𑆣𑆫𑇀𑆩𑆩𑆶𑆠𑇀𑆑𑇀𑆫𑆩𑇀𑆪𑆳𑆣𑆫𑇀𑆩𑆼𑆟 𑆥𑇀𑆫𑆘𑆳𑆁 𑆮𑆫𑇀𑆠𑆪𑆤𑇀𑆠𑆴, 𑆠𑆢𑆳𑆯𑇀𑆫𑆴𑆠𑆾𑆥𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂 𑆥𑆿𑆫𑆘𑆤𑆥𑆢𑆳 𑆮𑇀𑆪𑆮𑆲𑆳𑆫𑆾𑆥𑆘𑆵𑆮𑆴𑆤𑆯𑇀𑆖 𑆠𑆩𑆣𑆫𑇀𑆩𑆩𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆤𑇀𑆠𑆴, 𑆠𑆠𑆂 𑆱𑆾𑇁𑆣𑆫𑇀𑆩𑆂 𑆥𑇀𑆫𑆱𑆨𑆁 𑆣𑆫𑇀𑆩𑆩𑆤𑇀𑆠𑆫𑇀𑆣𑆠𑇀𑆠𑆼, 𑆠𑆠𑆱𑇀𑆠𑆼𑇁𑆤𑇀𑆠𑆫𑇀𑆲𑆴𑆠𑆣𑆫𑇀𑆩𑆳𑆟𑆾 𑆢𑆼𑆮𑆠𑆳𑆨𑆴𑆫𑆥𑆴 𑆠𑇀𑆪𑆘𑇀𑆪𑆤𑇀𑆠𑆼; 𑆠𑆼𑆰𑆳𑆁 𑆠𑆡𑆳𑇁𑆤𑇀𑆠𑆫𑇀𑆲𑆴𑆠𑆣𑆫𑇀𑆩𑆟𑆳𑆩𑆣𑆫𑇀𑆩𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆤𑆳𑆩𑆥𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆢𑆼𑆮𑆠𑆳𑆤𑆳𑆩𑆸𑆠𑆮𑆾 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼; 𑆠𑆼𑆤 𑆤𑆳𑆥𑆾 𑆪𑆡𑆳𑆑𑆳𑆬𑆁 𑆢𑆼𑆮𑆾 𑆮𑆫𑇀𑆰𑆠𑆴 𑆤 𑆮𑆳 𑆮𑆫𑇀𑆰𑆠𑆴 𑆮𑆴𑆑𑆸𑆠𑆁 𑆮𑆳 𑆮𑆫𑇀𑆰𑆠𑆴, 𑆮𑆳𑆠𑆳 𑆤 𑆱𑆩𑇀𑆪𑆓𑆨𑆴𑆮𑆳𑆤𑇀𑆠𑆴, 𑆑𑇀𑆰𑆴𑆠𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆱𑆬𑆴𑆬𑆳𑆤𑇀𑆪𑆶𑆥𑆯𑆶𑆰𑇀𑆪𑆤𑇀𑆠𑆴, 𑆏𑆰𑆣𑆪𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆁 𑆥𑆫𑆴𑆲𑆳𑆪𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆑𑆸𑆠𑆴𑆁; 𑆠𑆠 𑆇𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑇀𑆠𑆼 𑆘𑆤𑆥𑆢𑆳𑆂 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑇀𑆪𑆢𑆾𑆰𑆳𑆠𑇀 𑇆𑇒𑇐𑇆
𑆫𑆑𑇀𑆰𑆾𑆓𑆟𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆮𑆳 𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑇀𑆨𑆷𑆠𑆱𑆕𑇀𑆔𑆽𑆱𑇀𑆠𑆩𑆣𑆫𑇀𑆩𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆥𑆖𑆳𑆫𑆳𑆤𑇀𑆠𑆫𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆳𑆨𑆴𑆲𑆤𑇀𑆪𑆤𑇀𑆠𑆼𑇆𑇒𑇒𑇆
𑆠𑆡𑆳𑇁𑆨𑆴𑆯𑆳𑆥𑆥𑇀𑆫𑆨𑆮𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆣𑆫𑇀𑆩 𑆍𑆮 𑆲𑆼𑆠𑆶𑆫𑇀𑆨𑆮𑆠𑆴𑇅 𑆪𑆼 𑆬𑆶𑆥𑇀𑆠𑆣𑆫𑇀𑆩𑆳𑆟𑆾 𑆣𑆫𑇀𑆩𑆳𑆢𑆥𑆼𑆠𑆳𑆱𑇀𑆠𑆼 𑆓𑆶𑆫𑆶𑆮𑆸𑆢𑇀𑆣𑆱𑆴𑆢𑇀𑆣𑆫𑇀𑆰𑆴𑆥𑆷𑆘𑇀𑆪𑆳𑆤𑆮𑆩𑆠𑇀𑆪𑆳𑆲𑆴𑆠𑆳𑆤𑇀𑆪𑆳𑆖𑆫𑆤𑇀𑆠𑆴; 𑆠𑆠𑆱𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆘𑆳 𑆓𑆶𑆫𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆫𑆨𑆴𑆯𑆥𑇀𑆠𑆳 𑆨𑆱𑇀𑆩𑆠𑆳𑆩𑆶𑆥𑆪𑆳𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆳𑆓𑆼𑆮𑆳𑆤𑆼𑆑𑆥𑆶𑆫𑆶𑆰𑆑𑆶𑆬𑆮𑆴𑆤𑆳𑆯𑆳𑆪, 𑆤𑆴𑆪𑆠𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆾𑆥𑆬𑆩𑇀𑆨𑆳𑆢𑆤𑆴𑆪𑆠𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼 𑇆𑇒𑇓𑇆
𑆥𑇀𑆫𑆳𑆓𑆥𑆴 𑆖𑆳𑆣𑆫𑇀𑆩𑆳𑆢𑆸𑆠𑆼 𑆤𑆳𑆯𑆶𑆨𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆤𑇀𑆪𑆠𑆾𑇁𑆨𑆷𑆠𑇀𑇅 𑆄𑆢𑆴𑆑𑆳𑆬𑆼 𑆲𑇀𑆪𑆢𑆴𑆠𑆴𑆱𑆶𑆠𑆱𑆩𑆿𑆘𑆱𑆾𑇁𑆠𑆴𑆮𑆴𑆩𑆬𑆮𑆴𑆥𑆶𑆬𑆥𑇀𑆫𑆨𑆳𑆮𑆳𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆢𑆼𑆮𑆢𑆼𑆮𑆫𑇀𑆰𑆴𑆣𑆫𑇀𑆩𑆪𑆘𑇀𑆚𑆮𑆴𑆣𑆴𑆮𑆴𑆣𑆳𑆤𑆳𑆂 𑆯𑆽𑆬𑆱𑆳𑆫𑆱𑆁𑆲𑆠𑆱𑇀𑆡𑆴𑆫𑆯𑆫𑆵𑆫𑆳𑆂 𑆥𑇀𑆫𑆱𑆤𑇀𑆤𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆂 𑆥𑆮𑆤𑆱𑆩𑆧𑆬𑆘𑆮𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆳𑆯𑇀𑆖𑆳𑆫𑆶𑆱𑇀𑆦𑆴𑆖𑆾𑇁𑆨𑆴𑆫𑆷𑆥𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆑𑆸𑆠𑆴𑆥𑇀𑆫𑆱𑆳𑆢𑆾𑆥𑆖𑆪𑆮𑆤𑇀𑆠𑆂 𑆱𑆠𑇀𑆪𑆳𑆫𑇀𑆘𑆮𑆳𑆤𑆸𑆯𑆁𑆱𑇀𑆪𑆢𑆳𑆤𑆢𑆩𑆤𑆴𑆪𑆩𑆠𑆥𑆾𑆥𑆮𑆳𑆱𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆮𑇀𑆫𑆠𑆥𑆫𑆳 𑆮𑇀𑆪𑆥𑆓𑆠𑆨𑆪𑆫𑆳𑆓𑆢𑇀𑆮𑆼𑆰𑆩𑆾𑆲𑆬𑆾𑆨𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆩𑆳𑆤𑆫𑆾𑆓𑆤𑆴𑆢𑇀𑆫𑆳𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑇀𑆫𑆩𑆑𑇀𑆬𑆩𑆳𑆬𑆱𑇀𑆪𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆳𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆳 𑆧𑆨𑆷𑆮𑆶𑆫𑆩𑆴𑆠𑆳𑆪𑆶𑆰𑆂𑇅 𑆠𑆼𑆰𑆳𑆩𑆶𑆢𑆳𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆓𑆶𑆟𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆓𑆶𑆟𑆱𑆩𑆶𑆢𑆴𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆧𑆨𑆷𑆮𑆶𑆂 𑆯𑆱𑇀𑆪𑆳𑆤𑆴 𑆱𑆫𑇀𑆮𑆓𑆶𑆟𑆱𑆩𑆶𑆢𑆴𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆸𑆠𑆪𑆶𑆓𑆱𑇀𑆪𑆳𑆢𑆿𑇅 𑆨𑇀𑆫𑆯𑇀𑆪𑆠𑆴 𑆠𑆶 𑆑𑆸𑆠𑆪𑆶𑆓𑆼 𑆑𑆼𑆰𑆳𑆚𑇀𑆖𑆴𑆢𑆠𑇀𑆪𑆳𑆢𑆳𑆤𑆳𑆠𑇀 𑆱𑆳𑆩𑇀𑆥𑆤𑇀𑆤𑆴𑆑𑆳𑆤𑆳𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆳𑆁 𑆯𑆫𑆵𑆫𑆓𑆿𑆫𑆮𑆩𑆳𑆱𑆵𑆠𑇀, 𑆯𑆫𑆵𑆫𑆓𑆿𑆫𑆮𑆳𑆖𑇀𑆗𑇀𑆫𑆩𑆂, 𑆯𑇀𑆫𑆩𑆳𑆢𑆳𑆬𑆱𑇀𑆪𑆩𑇀, 𑆄𑆬𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆚𑇀𑆖𑆪𑆂, 𑆱𑆚𑇀𑆖𑆪𑆳𑆠𑇀 𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆂, 𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆳𑆬𑇀𑆬𑆾𑆨𑆂 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑆳𑆱𑆵𑆠𑇀 𑆑𑆸𑆠𑆼𑇅 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆼𑆠𑆳𑆪𑆳𑆁 𑆬𑆾𑆨𑆳𑆢𑆨𑆴𑆢𑇀𑆫𑆾𑆲𑆂, 𑆃𑆨𑆴𑆢𑇀𑆫𑆾𑆲𑆳𑆤𑆸𑆠𑆮𑆖𑆤𑆩𑇀, 𑆃𑆤𑆸𑆠𑆮𑆖𑆤𑆳𑆠𑇀 𑆑𑆳𑆩𑆑𑇀𑆫𑆾𑆣𑆩𑆳𑆤𑆢𑇀𑆮𑆼𑆰𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆳𑆨𑆴𑆔𑆳𑆠𑆨𑆪𑆠𑆳𑆥𑆯𑆾𑆑𑆖𑆴𑆤𑇀𑆠𑆾𑆢𑇀𑆮𑆼𑆓𑆳𑆢𑆪𑆂 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆳𑆂𑇅 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆼𑆠𑆳𑆪𑆳𑆁 𑆣𑆫𑇀𑆩𑆥𑆳𑆢𑆾𑇁𑆤𑇀𑆠𑆫𑇀𑆣𑆳𑆤𑆩𑆓𑆩𑆠𑇀𑇅 𑆠𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑇀𑆣𑆳𑆤𑆳𑆠𑇀 𑆪𑆶𑆓𑆮𑆫𑇀𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆱𑇀𑆪 𑆥𑆳𑆢𑆲𑇀𑆫𑆳𑆱𑆂, 𑆥𑆸𑆡𑆴𑆮𑇀𑆪𑆳𑆢𑆼𑆯𑇀𑆖 𑆓𑆶𑆟𑆥𑆳𑆢𑆥𑇀𑆫𑆟𑆳𑆯𑆾𑇁𑆨𑆷𑆠𑇀𑇅 𑆠𑆠𑇀𑆥𑇀𑆫𑆟𑆳𑆯𑆑𑆸𑆠𑆯𑇀𑆖 𑆯𑆱𑇀𑆪𑆳𑆤𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆮𑆽𑆩𑆬𑇀𑆪𑆫𑆱𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆥𑆳𑆑𑆥𑇀𑆫𑆨𑆳𑆮𑆓𑆶𑆟𑆥𑆳𑆢𑆨𑇀𑆫𑆳𑆁𑆯𑆂𑇅 𑆠𑆠𑆱𑇀𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆘𑆳𑆯𑆫𑆵𑆫𑆳𑆟𑆴 𑆲𑆵𑆪𑆩𑆳𑆤𑆓𑆶𑆟𑆥𑆳𑆢𑆽𑆫𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆽𑆫𑆪𑆡𑆳𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆥𑆰𑇀𑆛𑆨𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑆶𑆠𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆨𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆳𑆢𑆴𑆨𑆴𑆫𑆳𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆳𑆤𑆴𑇅 𑆃𑆠𑆂 𑆥𑇀𑆫𑆳𑆟𑆴𑆤𑆾 𑆲𑇀𑆫𑆳𑆱𑆩𑆮𑆳𑆥𑆶𑆫𑆳𑆪𑆶𑆰𑆂 𑆑𑇀𑆫𑆩𑆯 𑆅𑆠𑆴𑇆𑇒𑇔𑇆
𑆨𑆮𑆠𑆯𑇀𑆖𑆳𑆠𑇀𑆫- 𑆪𑆶𑆓𑆼 𑆪𑆶𑆓𑆼 𑆣𑆫𑇀𑆩𑆥𑆳𑆢𑆂 𑆑𑇀𑆫𑆩𑆼𑆟𑆳𑆤𑆼𑆤 𑆲𑆵𑆪𑆠𑆼𑇅 𑆓𑆶𑆟𑆥𑆳𑆢𑆯𑇀𑆖 𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆼𑆮𑆁 𑆬𑆾𑆑𑆂 𑆥𑇀𑆫𑆬𑆵𑆪𑆠𑆼𑇆𑇒𑇕𑇆
𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆯𑆠𑆼 𑆥𑆷𑆫𑇀𑆟𑆼 𑆪𑆳𑆠𑆴 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆂 𑆑𑇀𑆰𑆪𑆩𑇀𑇅 𑆢𑆼𑆲𑆴𑆤𑆳𑆩𑆳𑆪𑆶𑆰𑆂 𑆑𑆳𑆬𑆼 𑆪𑆠𑇀𑆫 𑆪𑆤𑇀𑆩𑆳𑆤𑆩𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇒𑇖𑇆
𑆅𑆠𑆴 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆓𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆲𑆼𑆠𑆶𑆫𑆶𑆑𑇀𑆠𑆾 𑆨𑆮𑆠𑆴𑇆𑇒𑇗𑇆
𑆍𑆮𑆁𑆮𑆳𑆢𑆴𑆤𑆁 𑆨𑆓𑆮𑆤𑇀𑆠𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯 𑆇𑆮𑆳𑆖- 𑆑𑆴𑆤𑇀𑆤𑆶 𑆒𑆬𑆶 𑆨𑆓𑆮𑆤𑇀! 𑆤𑆴𑆪𑆠𑆑𑆳𑆬𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆳𑆪𑆶𑆂 𑆱𑆫𑇀𑆮𑆁 𑆤 𑆮𑆼𑆠𑆴𑇆𑇒𑇘𑇆
𑆠𑆁 𑆨𑆓𑆮𑆳𑆤𑆶𑆮𑆳𑆖- 𑆅𑆲𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯! 𑆨𑆷𑆠𑆳𑆤𑆳𑆩𑆳𑆪𑆶𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆴𑆩𑆥𑆼𑆑𑇀𑆰𑆠𑆼𑇅 𑆢𑆽𑆮𑆼 𑆥𑆶𑆫𑆶𑆰𑆑𑆳𑆫𑆼 𑆖 𑆱𑇀𑆡𑆴𑆠𑆁 𑆲𑇀𑆪𑆱𑇀𑆪 𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇆𑇒𑇙𑇆
𑆢𑆽𑆮𑆩𑆳𑆠𑇀𑆩𑆑𑆸𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆑𑆫𑇀𑆩 𑆪𑆠𑇀 𑆥𑆿𑆫𑇀𑆮𑆢𑆽𑆲𑆴𑆑𑆩𑇀𑇅 𑆱𑇀𑆩𑆸𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆑𑆳𑆫𑆱𑇀𑆠𑆶 𑆑𑇀𑆫𑆴𑆪𑆠𑆼 𑆪𑆢𑆴𑆲𑆳𑆥𑆫𑆩𑇀𑇆𑇓𑇐𑇆
𑆧𑆬𑆳𑆧𑆬𑆮𑆴𑆯𑆼𑆰𑆾𑇁𑆱𑇀𑆠𑆴 𑆠𑆪𑆾𑆫𑆥𑆴 𑆖 𑆑𑆫𑇀𑆩𑆟𑆾𑆂𑇅 𑆢𑆸𑆰𑇀𑆛𑆁 𑆲𑆴 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩 𑆲𑆵𑆤𑆁 𑆩𑆣𑇀𑆪𑆩𑆩𑆶𑆠𑇀𑆠𑆩𑆩𑇀𑇆𑇓𑇑𑇆
𑆠𑆪𑆾𑆫𑆶𑆢𑆳𑆫𑆪𑆾𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆴𑆫𑇀𑆢𑆵𑆫𑇀𑆔𑆱𑇀𑆪 𑆖 𑆱𑆶𑆒𑆱𑇀𑆪 𑆖𑇅 𑆤𑆴𑆪𑆠𑆱𑇀𑆪𑆳𑆪𑆶𑆰𑆾 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑆫𑆳𑇆𑇓𑇒𑇆
𑆩𑆣𑇀𑆪𑆩𑆳 𑆩𑆣𑇀𑆪𑆩𑆱𑇀𑆪𑆼𑆰𑇀𑆛𑆳 𑆑𑆳𑆫𑆟𑆁 𑆯𑆸𑆟𑆶 𑆖𑆳𑆥𑆫𑆩𑇀𑇅𑇓𑇓𑇅 𑆢𑆽𑆮𑆁 𑆥𑆶𑆫𑆶𑆰𑆑𑆳𑆫𑆼𑆟 𑆢𑆶𑆫𑇀𑆧𑆬𑆁 𑆲𑇀𑆪𑆶𑆥𑆲𑆤𑇀𑆪𑆠𑆼𑇆𑇓𑇓𑇆
𑆃𑆡𑆳𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆥𑆥𑇀𑆫𑆖𑇀𑆗- 𑆑𑆴𑆤𑇀𑆤𑆶 𑆒𑆬𑆶 𑆨𑆓𑆮𑆤𑇀! 𑆘𑇀𑆮𑆫𑆴𑆠𑆼𑆨𑇀𑆪𑆂 𑆥𑆳𑆤𑆵𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆾 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁 𑆤 𑆠𑆡𑆳 𑆯𑆵𑆠𑆩𑇀, 𑆃𑆱𑇀𑆠𑆴 𑆖 𑆯𑆵𑆠𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆥𑆴 𑆣𑆳𑆠𑆶𑆫𑇀𑆘𑇀𑆮𑆫𑆑𑆫 𑆅𑆠𑆴𑇆𑇓𑇙𑇆
𑆠𑆩𑆶𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂- 𑆘𑇀𑆮𑆫𑆴𑆠𑆱𑇀𑆪 𑆑𑆳𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆢𑆼𑆯𑆑𑆳𑆬𑆳𑆤𑆨𑆴𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪 𑆥𑆳𑆖𑆤𑆳𑆫𑇀𑆡𑆁 𑆥𑆳𑆤𑆵𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆂𑇅 𑆘𑇀𑆮𑆫𑆾 𑆲𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆂, 𑆥𑇀𑆫𑆳𑆪𑆾 𑆨𑆼𑆰𑆘𑆳𑆤𑆴 𑆖𑆳𑆩𑆳𑆯𑆪𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆥𑆳𑆖𑆤𑆮𑆩𑆤𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆱𑆩𑆫𑇀𑆡𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆥𑆳𑆖𑆤𑆳𑆫𑇀𑆡𑆁 𑆖 𑆥𑆳𑆤𑆵𑆪𑆩𑆶𑆰𑇀𑆟𑆁, 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆘𑇀𑆘𑇀𑆮𑆫𑆴𑆠𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆾 𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆩𑇀𑇅 𑆠𑆢𑇀𑆣𑆴 𑆠𑆼𑆰𑆳𑆁 𑆥𑆵𑆠𑆁 𑆮𑆳𑆠𑆩𑆤𑆶𑆬𑆾𑆩𑆪𑆠𑆴, 𑆃𑆓𑇀𑆤𑆴𑆁 𑆖𑆾𑆢𑆫𑇀𑆪𑆩𑆶𑆢𑆵𑆫𑆪𑆠𑆴, 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆘𑆫𑆳𑆁 𑆓𑆖𑇀𑆗𑆠𑆴, 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆥𑆫𑆴𑆯𑆾𑆰𑆪𑆠𑆴, 𑆱𑇀𑆮𑆬𑇀𑆥𑆩𑆥𑆴 𑆖 𑆥𑆵𑆠𑆁 𑆠𑆸𑆰𑇀𑆟𑆳𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆪𑆾𑆥𑆑𑆬𑇀𑆥𑆠𑆼; 𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆩𑆥𑆴 𑆖𑆽𑆠𑆤𑇀𑆤𑆳𑆠𑇀𑆪𑆫𑇀𑆡𑆾𑆠𑇀𑆱𑆤𑇀𑆤𑆥𑆴𑆠𑇀𑆠𑆼 𑆘𑇀𑆮𑆫𑆼 𑆱𑆢𑆳𑆲𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆳𑆥𑆳𑆠𑆴𑆱𑆳𑆫𑆼 𑆮𑆳 𑆥𑇀𑆫𑆢𑆼𑆪𑆩𑇀, 𑆇𑆰𑇀𑆟𑆼𑆤 𑆲𑆴 𑆢𑆳𑆲𑆨𑇀𑆫𑆩𑆥𑇀𑆫𑆬𑆳𑆥𑆳𑆠𑆴𑆱𑆳𑆫𑆳 𑆨𑆷𑆪𑆾𑇁𑆨𑆴𑆮𑆫𑇀𑆣𑆤𑇀𑆠𑆼, 𑆯𑆵𑆠𑆼𑆤 𑆖𑆾𑆥𑆯𑆳𑆩𑇀𑆪𑆤𑇀𑆠𑆵𑆠𑆴𑇆𑇔𑇐𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆯𑆵𑆠𑆼𑆤𑆾𑆰𑇀𑆟𑆑𑆸𑆠𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆚𑇀𑆗𑆩𑆪𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆓𑇀𑆮𑆴𑆢𑆂𑇅 𑆪𑆼 𑆠𑆶 𑆯𑆵𑆠𑆑𑆸𑆠𑆳 𑆫𑆾𑆓𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆩𑆶𑆰𑇀𑆟𑆁 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆩𑇀𑇆𑇔𑇑𑇆
𑆍𑆮𑆩𑆴𑆠𑆫𑆼𑆰𑆳𑆩𑆥𑆴 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆤𑆴𑆢𑆳𑆤𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆨𑆼𑆰𑆘𑆁 𑆨𑆮𑆠𑆴; 𑆪𑆡𑆳- 𑆃𑆥𑆠𑆫𑇀𑆥𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆥𑆷𑆫𑆟𑆩𑆱𑇀𑆠𑆴 𑆯𑆳𑆤𑇀𑆠𑆴𑆂, 𑆠𑆡𑆳 𑆥𑆷𑆫𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆥𑆠𑆫𑇀𑆥𑆟𑆩𑇀𑇆𑇔𑇒𑇆
𑆃𑆥𑆠𑆫𑇀𑆥𑆟𑆩𑆥𑆴 𑆖 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁- 𑆬𑆕𑇀𑆔𑆤𑆁, 𑆬𑆕𑇀𑆔𑆤𑆥𑆳𑆖𑆤𑆁, 𑆢𑆾𑆰𑆳𑆮𑆱𑆼𑆖𑆤𑆁 𑆖𑆼𑆠𑆴𑇆𑇔𑇓𑇆
𑆠𑆠𑇀𑆫 𑆬𑆕𑇀𑆔𑆤𑆩𑆬𑇀𑆥𑆧𑆬𑆢𑆾𑆰𑆳𑆟𑆳𑆁 , 𑆬𑆕𑇀𑆔𑆤𑆼𑆤 𑆲𑇀𑆪𑆓𑇀𑆤𑆴𑆩𑆳𑆫𑆶𑆠𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳 𑆮𑆳𑆠𑆳𑆠𑆥𑆥𑆫𑆵𑆠𑆩𑆴𑆮𑆳𑆬𑇀𑆥𑆩𑆶𑆢𑆑𑆩𑆬𑇀𑆥𑆾 𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆯𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼; 𑆬𑆕𑇀𑆔𑆤𑆥𑆳𑆖𑆤𑆼 𑆠𑆶 𑆩𑆣𑇀𑆪𑆧𑆬𑆢𑆾𑆰𑆳𑆟𑆳𑆁, 𑆬𑆕𑇀𑆔𑆤𑆥𑆳𑆖𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆲𑆴 𑆱𑆷𑆫𑇀𑆪𑆱𑆤𑇀𑆠𑆳𑆥𑆩𑆳𑆫𑆶𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆳𑆁𑆯𑆶𑆨𑆱𑇀𑆩𑆳𑆮𑆑𑆴𑆫𑆟𑆽𑆫𑆴𑆮 𑆖𑆳𑆤𑆠𑆴𑆧𑆲𑆷𑆢𑆑𑆁 𑆩𑆣𑇀𑆪𑆧𑆬𑆾 𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆯𑆾𑆰𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼; 𑆧𑆲𑆶𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆢𑆾𑆰𑆳𑆮𑆱𑆼𑆖𑆤𑆩𑆼𑆮 𑆑𑆳𑆫𑇀𑆪𑆁, 𑆤 𑆲𑇀𑆪𑆨𑆴𑆤𑇀𑆤𑆼 𑆑𑆼𑆢𑆳𑆫𑆱𑆼𑆠𑆿 𑆥𑆬𑇀𑆮𑆬𑆳𑆥𑇀𑆫𑆱𑆼𑆑𑆾𑇁𑆱𑇀𑆠𑆴, 𑆠𑆢𑇀𑆮𑆢𑇀𑆢𑆾𑆰𑆳𑆮𑆱𑆼𑆖𑆤𑆩𑇀𑇆𑇔𑇔𑇆
𑆢𑆾𑆰𑆳𑆮𑆱𑆼𑆖𑆤𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆨𑆼𑆰𑆘𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆑𑆳𑆬𑆩𑆥𑇀𑆪𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆤𑆽𑆮𑆁𑆮𑆴𑆣𑆱𑇀𑆪 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑆥𑆮𑆳𑆢𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆱𑇀𑆪𑆳𑆣𑆤𑆱𑇀𑆪𑆳𑆥𑆫𑆴𑆖𑆳𑆫𑆑𑆱𑇀𑆪 𑆮𑆽𑆢𑇀𑆪𑆩𑆳𑆤𑆴𑆤𑆯𑇀𑆖𑆟𑇀𑆝𑆱𑇀𑆪𑆳𑆱𑆷𑆪𑆑𑆱𑇀𑆪 𑆠𑆵𑆮𑇀𑆫𑆳𑆣𑆫𑇀𑆩𑆳𑆫𑆶𑆖𑆼𑆫𑆠𑆴𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆱𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆫𑆾𑆓𑆾𑆥𑆲𑆠𑆱𑇀𑆪 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆮𑆴𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑆴𑇅 𑆍𑆮𑆁𑆮𑆴𑆣𑆁 𑆲𑇀𑆪𑆳𑆠𑆶𑆫𑆩𑆶𑆥𑆖𑆫𑆤𑇀 𑆨𑆴𑆰𑆑𑇀 𑆥𑆳𑆥𑆵𑆪𑆱𑆳𑇁𑆪𑆯𑆱𑆳 𑆪𑆾𑆓𑆩𑆸𑆖𑇀𑆗𑆠𑆵𑆠𑆴𑇆𑇔𑇕𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆢𑆳𑆠𑇀𑆮𑆼 𑆖𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆼 𑆮𑆳 𑆪𑆱𑇀𑆪 𑆱𑇀𑆪𑆳𑆢𑆯𑆶𑆨𑆁 𑆦𑆬𑆩𑇀𑇅 𑆑𑆫𑇀𑆩𑆟𑆱𑇀𑆠𑆤𑇀𑆤 𑆑𑆫𑇀𑆠𑆮𑇀𑆪𑆩𑆼𑆠𑆢𑇀𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳𑆁 𑆩𑆠𑆩𑇀𑇆𑇔𑇖𑇆
(𑆃𑆬𑇀𑆥𑆾𑆢𑆑𑆢𑇀𑆫𑆶𑆩𑆾 𑆪𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆮𑆳𑆠𑆂 𑆥𑇀𑆫𑆖𑆶𑆫𑆳𑆠𑆥𑆂𑇅 𑆘𑇀𑆚𑆼𑆪𑆂 𑆱 𑆘𑆳𑆕𑇀𑆓𑆬𑆾 𑆢𑆼𑆯𑆂 𑆱𑇀𑆮𑆬𑇀𑆥𑆫𑆾𑆓𑆠𑆩𑆾𑇁𑆥𑆴 𑆖𑇆𑇔𑇗𑇆
𑆥𑇀𑆫𑆖𑆶𑆫𑆾𑆢𑆑𑆮𑆸𑆑𑇀𑆰𑆾 𑆪𑆾 𑆤𑆴𑆮𑆳𑆠𑆾 𑆢𑆶𑆫𑇀𑆬𑆨𑆳𑆠𑆥𑆂𑇅 𑆃𑆤𑆷𑆥𑆾 𑆧𑆲𑆶𑆢𑆾𑆰𑆯𑇀𑆖, 𑆱𑆩𑆂 𑆱𑆳𑆣𑆳𑆫𑆟𑆾 𑆩𑆠𑆂)𑇆𑇔𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆳 𑆲𑆼𑆠𑆮𑆂 𑆱𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆳𑆂𑇅 𑆢𑆼𑆯𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆱𑇀𑆪 𑆨𑆽𑆰𑆘𑇀𑆪𑆁 𑆲𑆼𑆠𑆷𑆤𑆳𑆁 𑆩𑆷𑆬𑆩𑆼𑆮 𑆖𑇆𑇔𑇙𑇆
𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆑𑆳𑆫𑆱𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆳𑆪𑆶𑆰𑆯𑇀𑆖 𑆑𑇀𑆰𑆪𑆑𑇀𑆫𑆩𑆂𑇅 𑆩𑆫𑆟𑆁 𑆥𑇀𑆫𑆠𑆴 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆑𑆳𑆬𑆳𑆑𑆳𑆬𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇕𑇐𑇆
𑆪𑆡𑆳 𑆖𑆳𑆑𑆳𑆬𑆩𑆫𑆟𑆁 𑆪𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆁 𑆖 𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆪𑆳𑆠𑇀𑆪𑆿𑆰𑆣𑆁 𑆪𑆼𑆰𑆳𑆁 𑆤 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆪𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳𑇆𑇕𑇑𑇆
𑆠𑆢𑆳𑆠𑇀𑆫𑆼𑆪𑆾𑇁𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆳𑆪 𑆤𑆴𑆒𑆴𑆬𑆁 𑆱𑆫𑇀𑆮𑆩𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀𑇅 𑆢𑆼𑆯𑆾𑆢𑇀𑆣𑇀𑆮𑆁𑆱𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆵𑆪𑆼 𑆮𑆴𑆩𑆳𑆤𑆼 𑆩𑆶𑆤𑆴𑆱𑆠𑇀𑆠𑆩𑆂𑇆𑇕𑇒𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆒𑆬𑆶 𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳 𑆄𑆥𑇀𑆠𑆾𑆥𑆢𑆼𑆯𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆁 𑆖𑆼𑆠𑆴𑇆𑇓𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆼𑆤 𑆒𑆬𑇀𑆮𑆤𑆼𑆤 𑆘𑇀𑆚𑆳𑆤𑆱𑆩𑆶𑆢𑆳𑆪𑆼𑆤 𑆥𑆷𑆫𑇀𑆮𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪 𑆫𑆾𑆓𑆁 𑆱𑆫𑇀𑆮𑆡𑆳 𑆱𑆫𑇀𑆮𑆩𑆡𑆾𑆠𑇀𑆠𑆫𑆑𑆳𑆬𑆩𑆣𑇀𑆪𑆮𑆱𑆳𑆤𑆩𑆢𑆾𑆰𑆁 𑆨𑆮𑆠𑆴, 𑆤 𑆲𑆴 𑆘𑇀𑆚𑆳𑆤𑆳𑆮𑆪𑆮𑆼𑆤 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆼 𑆘𑇀𑆚𑆼𑆪𑆼 𑆘𑇀𑆚𑆳𑆤𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆼 𑆠𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀 𑆘𑇀𑆚𑆳𑆤𑆱𑆩𑆶𑆢𑆪𑆼 𑆥𑆷𑆫𑇀𑆮𑆩𑆳𑆥𑇀𑆠𑆾𑆥𑆢𑆼𑆯𑆳𑆘𑇀𑆘𑇀𑆚𑆳𑆤𑆁, 𑆠𑆠𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆤𑆶𑆩𑆳𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆑𑆴𑆁 𑆲𑇀𑆪𑆤𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁 𑆥𑆷𑆫𑇀𑆮𑆁 𑆪𑆠𑇀𑆠𑆠𑇀 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆤𑆶𑆩𑆳𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑆩𑆳𑆟𑆾 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆳𑆁 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆁 𑆖; 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆮𑆳 𑆱𑆲𑆾𑆥𑆢𑆼𑆯𑆼𑆤𑇆𑇕𑇆
𑆠𑆠𑇀𑆫𑆼𑆢𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆤𑇀𑆠𑆂- 𑆫𑆾𑆓𑆩𑆼𑆑𑆽𑆑𑆩𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑆼𑆮𑆁𑆪𑆾𑆤𑆴𑆩𑆼𑆮𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆩𑆼𑆮𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆼𑆮𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆼𑆮𑆁𑆮𑆼𑆢𑆤𑆩𑆼𑆮𑆁 𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆩𑆼𑆮𑆁𑆯𑆧𑇀𑆢𑆱𑇀𑆥𑆫𑇀𑆯𑆫𑆷𑆥𑆫𑆱𑆓𑆤𑇀𑆣𑆩𑆼𑆮𑆩𑆶𑆥𑆢𑇀𑆫𑆮𑆩𑆼𑆮𑆁𑆮𑆸𑆢𑇀𑆣𑆴𑆱𑇀𑆡𑆳𑆤𑆑𑇀𑆰𑆪𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆩𑆼𑆮𑆩𑆶𑆢𑆫𑇀𑆑 𑆩𑆼𑆮𑆤𑇀𑆤𑆳𑆩𑆳𑆤𑆩𑆼𑆮𑆁𑆪𑆾𑆓𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆠𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆴𑆪𑆁 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆳𑆫𑇀𑆡𑆳 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆡𑆮𑆳 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆠𑇀𑆪𑆶𑆥𑆢𑆼𑆯𑆳𑆘𑇀𑆘𑇀𑆚𑆳𑆪𑆠𑆼𑇆𑇖𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆠𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆫𑆾𑆓𑆠𑆠𑇀𑆠𑇀𑆮𑆁 𑆧𑆶𑆨𑆶𑆠𑇀𑆱𑆶𑆂 𑆱𑆫𑇀𑆮𑆽𑆫𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆽𑆂 𑆱𑆫𑇀𑆮𑆳𑆤𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆳𑆤𑆳𑆠𑆶𑆫𑆯𑆫𑆵𑆫𑆓𑆠𑆳𑆤𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠, 𑆃𑆤𑇀𑆪𑆠𑇀𑆫 𑆫𑆱𑆘𑇀𑆚𑆳𑆤𑆳𑆠𑇀; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆤𑆁, 𑆱𑆤𑇀𑆣𑆴𑆱𑇀𑆦𑆶𑆛𑆤𑆩𑆕𑇀𑆓𑆶𑆬𑆵𑆥𑆫𑇀𑆮𑆟𑆳𑆁 𑆖, 𑆱𑇀𑆮𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆁𑆯𑇀𑆖, 𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼𑇁𑆥𑆴 𑆑𑆼𑆖𑆴𑆖𑇀𑆗𑆫𑆵𑆫𑆾𑆥𑆓𑆠𑆳𑆂 𑆯𑆧𑇀𑆢𑆳𑆂 𑆱𑇀𑆪𑆶𑆱𑇀𑆠𑆳𑆚𑇀𑆗𑇀𑆫𑆾𑆠𑇀𑆫𑆼𑆟 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆮𑆫𑇀𑆟𑆱𑆁𑆱𑇀𑆡𑆳𑆤𑆥𑇀𑆫𑆩𑆳𑆟𑆖𑇀𑆗𑆳𑆪𑆳𑆂 , 𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆳𑆫𑆿, 𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆮𑆽𑆰𑆪𑆴𑆑𑆳𑆟𑆴 𑆪𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆤𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆠𑆳𑆤𑆴 𑆖𑆑𑇀𑆰𑆶𑆰𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆫𑆱𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆳𑆠𑆶𑆫𑆯𑆫𑆵𑆫𑆓𑆠𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆽𑆰𑆪𑆴𑆑𑆩𑆥𑇀𑆪𑆤𑆶𑆩𑆳𑆤𑆳𑆢𑆮𑆓𑆖𑇀𑆗𑆼𑆠𑇀, 𑆤 𑆲𑇀𑆪𑆱𑇀𑆪 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆼𑆟 𑆓𑇀𑆫𑆲𑆟𑆩𑆶𑆥𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆱𑇀𑆩𑆳𑆢𑆳𑆠𑆶𑆫𑆥𑆫𑆴𑆥𑇀𑆫𑆯𑇀𑆤𑆼𑆤𑆽𑆮𑆳𑆠𑆶𑆫𑆩𑆶𑆒𑆫𑆱𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀, 𑆪𑆷𑆑𑆳𑆥𑆱𑆫𑇀𑆥𑆟𑆼𑆤 𑆠𑇀𑆮𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆮𑆽𑆫𑆱𑇀𑆪𑆁, 𑆩𑆑𑇀𑆰𑆴𑆑𑆾𑆥𑆱𑆫𑇀𑆥𑆟𑆼𑆤 𑆯𑆫𑆵𑆫𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆁, 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆱𑆤𑇀𑆢𑆼𑆲𑆼 𑆠𑆶 𑆑𑆴𑆁 𑆣𑆳𑆫𑆴𑆬𑆾𑆲𑆴𑆠𑆁 𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆼𑆠𑆴 𑆯𑇀𑆮𑆑𑆳𑆑𑆨𑆑𑇀𑆰𑆟𑆳𑆢𑇀𑆣𑆳𑆫𑆴𑆬𑆾𑆲𑆴𑆠𑆩𑆨𑆑𑇀𑆰𑆟𑆳𑆬𑇀𑆬𑆾𑆲𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆩𑆴𑆠𑇀𑆪𑆤𑆶𑆩𑆳𑆠𑆮𑇀𑆪𑆩𑇀, 𑆍𑆮𑆩𑆤𑇀𑆪𑆳𑆤𑆥𑇀𑆪𑆳𑆠𑆶𑆫𑆯𑆫𑆵𑆫𑆓𑆠𑆳𑆤𑇀 𑆫𑆱𑆳𑆤𑆤𑆶𑆩𑆴𑆩𑆵𑆠; 𑆓𑆤𑇀𑆣𑆳𑆁𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆓𑆠𑆳𑆤𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳𑆤𑇀 𑆔𑇀𑆫𑆳𑆟𑆼𑆤 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠; 𑆱𑇀𑆥𑆫𑇀𑆯𑆁 𑆖 𑆥𑆳𑆟𑆴𑆤𑆳 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆩𑇀𑇅 𑆅𑆠𑆴 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆠𑆾𑇁𑆤𑆶𑆩𑆳𑆤𑆳𑆢𑆶𑆥𑆢𑆼𑆯𑆠𑆯𑇀𑆖 𑆥𑆫𑆵𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆩𑇀𑇆𑇗𑇆
𑆅𑆩𑆼 𑆠𑆶 𑆒𑆬𑇀𑆮𑆤𑇀𑆪𑆼𑇁𑆥𑇀𑆪𑆼𑆮𑆩𑆼𑆮 𑆨𑆷𑆪𑆾𑇁𑆤𑆶𑆩𑆳𑆤𑆘𑇀𑆚𑆼𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆨𑆳𑆮𑆳𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆓𑇀𑆤𑆴𑆁 𑆘𑆫𑆟𑆯𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠, 𑆧𑆬𑆁 𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆑𑇀𑆠𑇀𑆪𑆳, 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆳𑆢𑆵𑆤𑆴 𑆯𑆧𑇀𑆢𑆳𑆢𑇀𑆪𑆫𑇀𑆡𑆓𑇀𑆫𑆲𑆟𑆼𑆤, 𑆩𑆤𑆾𑇁𑆫𑇀𑆡𑆳𑆮𑇀𑆪𑆨𑆴𑆖𑆫𑆟𑆼𑆤, 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆼𑆤, 𑆫𑆘𑆂𑆱𑆕𑇀𑆓𑆼𑆤, 𑆩𑆾𑆲𑆩𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼𑆤, 𑆑𑇀𑆫𑆾𑆣𑆩𑆨𑆴𑆢𑇀𑆫𑆾𑆲𑆼𑆟, 𑆯𑆾𑆑𑆁 𑆢𑆽𑆤𑇀𑆪𑆼𑆤, 𑆲𑆫𑇀𑆰𑆩𑆳𑆩𑆾𑆢𑆼𑆤, 𑆥𑇀𑆫𑆵𑆠𑆴𑆁 𑆠𑆾𑆰𑆼𑆟, 𑆨𑆪𑆁 𑆮𑆴𑆰𑆳𑆢𑆼𑆤, 𑆣𑆽𑆫𑇀𑆪𑆩𑆮𑆴𑆰𑆳𑆢𑆼𑆤, 𑆮𑆵𑆫𑇀𑆪𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆼𑆤 , 𑆃𑆮𑆱𑇀𑆡𑆳𑆤𑆩𑆮𑆴𑆨𑇀𑆫𑆩𑆼𑆟, 𑆯𑇀𑆫𑆢𑇀𑆣𑆳𑆩𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆼𑆟, 𑆩𑆼𑆣𑆳𑆁 𑆓𑇀𑆫𑆲𑆟𑆼𑆤, 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆤𑆳𑆩𑆓𑇀𑆫𑆲𑆟𑆼𑆤, 𑆱𑇀𑆩𑆸𑆠𑆴𑆁 𑆱𑇀𑆩𑆫𑆟𑆼𑆤, 𑆲𑇀𑆫𑆴𑆪𑆩𑆥𑆠𑇀𑆫𑆥𑆟𑆼𑆤, 𑆯𑆵𑆬𑆩𑆤𑆶𑆯𑆵𑆬𑆤𑆼𑆤, 𑆢𑇀𑆮𑆼𑆰𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆼𑆤, 𑆇𑆥𑆣𑆴𑆩𑆤𑆶𑆧𑆤𑇀𑆣𑆼𑆤 , 𑆣𑆸𑆠𑆴𑆩𑆬𑆿𑆬𑇀𑆪𑆼𑆤, 𑆮𑆯𑇀𑆪𑆠𑆳𑆁 𑆮𑆴𑆣𑆼𑆪𑆠𑆪𑆳, 𑆮𑆪𑆾𑆨𑆑𑇀𑆠𑆴𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆮𑇀𑆪𑆳𑆣𑆴𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆤𑆴 𑆑𑆳𑆬𑆢𑆼𑆯𑆾𑆥𑆯𑆪𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆼𑆟, 𑆓𑆷𑆞𑆬𑆴𑆕𑇀𑆓𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆩𑆶𑆥𑆯𑆪𑆳𑆤𑆶𑆥𑆯𑆪𑆳𑆨𑇀𑆪𑆳𑆁, 𑆢𑆾𑆰𑆥𑇀𑆫𑆩𑆳𑆟𑆮𑆴𑆯𑆼𑆰𑆩𑆥𑆖𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆼𑆟, 𑆄𑆪𑆶𑆰𑆂 𑆑𑇀𑆰𑆪𑆩𑆫𑆴𑆰𑇀𑆛𑆽𑆂, 𑆇𑆥𑆱𑇀𑆡𑆴𑆠𑆯𑇀𑆫𑆼𑆪𑆱𑇀𑆠𑇀𑆮𑆁 𑆑𑆬𑇀𑆪𑆳𑆟𑆳𑆨𑆴𑆤𑆴𑆮𑆼𑆯𑆼𑆤, 𑆃𑆩𑆬𑆁 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆮𑆴𑆑𑆳𑆫𑆼𑆟, 𑆓𑇀𑆫𑆲𑆟𑇀𑆪𑆳𑆱𑇀𑆠𑆶 𑆩𑆸𑆢𑆶𑆢𑆳𑆫𑆶𑆟𑆠𑇀𑆮𑆁 𑆱𑇀𑆮𑆥𑇀𑆤𑆢𑆫𑇀𑆯𑆤𑆩𑆨𑆴𑆥𑇀𑆫𑆳𑆪𑆁 𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆼𑆰𑇀𑆛𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆳𑆤𑆴 𑆖𑆳𑆠𑆶𑆫𑆥𑆫𑆴𑆥𑇀𑆫𑆯𑇀𑆤𑆼𑆤𑆽𑆮 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇘𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆄𑆥𑇀𑆠𑆠𑆯𑇀𑆖𑆾𑆥𑆢𑆼𑆯𑆼𑆤 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆑𑆫𑆟𑆼𑆤 𑆖𑇅 𑆃𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆖 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇆𑇙𑇆
𑆱𑆫𑇀𑆮𑆡𑆳 𑆱𑆫𑇀𑆮𑆩𑆳𑆬𑆾𑆖𑇀𑆪 𑆪𑆡𑆳𑆱𑆩𑇀𑆨𑆮𑆩𑆫𑇀𑆡𑆮𑆴𑆠𑇀𑇅 𑆃𑆡𑆳𑆣𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑆠𑆠𑇀𑆠𑇀𑆮𑆼 𑆖 𑆑𑆳𑆫𑇀𑆪𑆼 𑆖 𑆠𑆢𑆤𑆤𑇀𑆠𑆫𑆩𑇀𑇆𑇑𑇐𑇆
𑆑𑆳𑆫𑇀𑆪𑆠𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆯𑆼𑆰𑆘𑇀𑆚𑆂 𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆿 𑆤 𑆩𑆶𑆲𑇀𑆪𑆠𑆴𑇅 𑆃𑆩𑆷𑆞𑆂 𑆦𑆬𑆩𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆪𑆢𑆩𑆾𑆲𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆘𑆩𑇀𑇆𑇑𑇑𑇆
𑆘𑇀𑆚𑆳𑆤𑆧𑆶𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆢𑆵𑆥𑆼𑆤 𑆪𑆾 𑆤𑆳𑆮𑆴𑆯𑆠𑆴 𑆠𑆠𑇀𑆠𑇀𑆮𑆮𑆴𑆠𑇀 𑇅 𑆄𑆠𑆶𑆫𑆱𑇀𑆪𑆳𑆤𑇀𑆠𑆫𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆤 𑆱 𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆠𑆴𑇆𑇑𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆮𑆴𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆘𑇀𑆚𑆳𑆤𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆩𑇀𑇅 𑆪𑆡𑆳 𑆖𑆾𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑇀𑆪𑆳𑆥𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁 𑆓𑆸𑆲𑇀𑆪𑆠𑆼 𑆪𑆡𑆳𑇆𑇑𑇓𑇆
𑆪𑆼 𑆪𑆡𑆳 𑆖𑆳𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆘𑇀𑆚𑆼𑆪𑆳𑆱𑇀𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆶𑆢𑆳𑆫𑆣𑆵𑆂𑇅 𑆨𑆳𑆮𑆳𑆁𑆱𑇀𑆠𑇀𑆫𑆴𑆫𑆾𑆓𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆮𑆴𑆩𑆳𑆤𑆼 𑆩𑆶𑆤𑆴𑆫𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀𑇆𑇑𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆴𑆩𑆳𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆪𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆼 𑆩𑆷𑆫𑇀𑆠𑆴𑆩𑆤𑇀𑆠𑆾 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆳𑆮𑆤𑇀𑆠 𑆍𑆮𑆳𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆥𑇀𑆫𑆑𑆳𑆫𑆮𑆴𑆯𑆼𑆰𑆳𑆂𑇅 𑆱𑆫𑇀𑆮𑆼 𑆲𑆴 𑆨𑆳𑆮𑆳 𑆥𑆶𑆫𑆶𑆰𑆼 𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆤𑇀𑆠𑆼, 𑆑𑇀𑆰𑆪𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆨𑆴𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴𑇅 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆒𑆬𑆶 𑆥𑆫𑆴𑆟𑆳𑆩𑆩𑆳𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆩𑆨𑆴𑆮𑆳𑆲𑆵𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆪𑆤𑆳𑆫𑇀𑆡𑆼𑆤𑇆𑇓𑇆
𑆃𑆥𑆴 𑆖𑆽𑆑𑆼 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆼𑆮 𑆱𑆩𑆶𑆢𑆪𑆁 𑆥𑆶𑆫𑆶𑆰𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴, 𑆱𑆫𑇀𑆮𑆓𑆠𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆱𑆫𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆳𑆩𑇀𑇅 𑆤 𑆠𑇀𑆮𑆼𑆠𑆢𑆼𑆮𑆁, 𑆪𑆱𑇀𑆪 𑆲𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴, 𑆪𑆖𑇀𑆖 𑆮𑆲𑆤𑇀𑆠𑆴, 𑆪𑆖𑇀𑆖𑆳𑆮𑆲𑆤𑇀𑆠𑆴, 𑆪𑆠𑇀𑆫 𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆤𑆴, 𑆱𑆫𑇀𑆮𑆁 𑆠𑆢𑆤𑇀𑆪𑆠𑇀𑆠𑆼𑆨𑇀𑆪𑆂𑇆𑇔𑇆
𑆃𑆠𑆴𑆧𑆲𑆶𑆠𑇀𑆮𑆳𑆠𑇀 𑆒𑆬𑆶 𑆑𑆼𑆖𑆴𑆢𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑇀𑆪𑆳𑆖𑆑𑇀𑆰𑆠𑆼 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴, 𑆥𑆫𑆴𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆳𑆤𑆴 𑆥𑆶𑆤𑆫𑆤𑇀𑆪𑆼𑇆𑇕𑇆
𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆒𑆬𑆶 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆪𑆡𑆳𑆱𑇀𑆡𑆷𑆬𑆁 𑆑𑆠𑆴𑆖𑆴𑆠𑇀𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆤𑇀𑆩𑆷𑆬𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆑𑆾𑆥𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆠𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆪𑆼 𑆨𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆬𑆩𑆤𑆶𑆑𑇀𑆠𑆳𑆫𑇀𑆡𑆘𑇀𑆚𑆳𑆤𑆳𑆪 𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆳𑆁, 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆪 𑆖𑆳𑆘𑇀𑆚𑆳𑆤𑆮𑆠𑆳𑆩𑇀𑇆𑇖𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆳𑆟𑆾𑆢𑆑𑆳𑆤𑇀𑆤𑆫𑆱𑆫𑆶𑆣𑆴𑆫𑆩𑆳𑆁𑆱𑆩𑆼𑆢𑆾𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆯𑆶𑆑𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑆵𑆠𑆴; 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳𑆁 𑆥𑆶𑆤𑆂 𑆱𑆫𑇀𑆮𑆯𑆫𑆵𑆫𑆖𑆫𑆳𑆟𑆳𑆁 𑆱𑆫𑇀𑆮𑆳𑆟𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆪𑆤𑆨𑆷𑆠𑆳𑆤𑆴, 𑆠𑆢𑇀𑆮𑆢𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆥𑆶𑆤𑆂 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑆼𑆮𑆬𑆁 𑆖𑆼𑆠𑆤𑆳𑆮𑆖𑇀𑆗𑆫𑆵𑆫𑆩𑆪𑆤𑆨𑆷𑆠𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆨𑆷𑆠𑆁 𑆖𑇅 𑆠𑆢𑆼𑆠𑆠𑇀 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆮𑆴𑆑𑆳𑆫𑆽𑆫𑆶𑆥𑆱𑆸𑆘𑇀𑆪𑆠𑆼 𑆯𑆫𑆵𑆫𑆩𑇀𑇆𑇗𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆲𑆸𑆢𑆪𑆁 𑆩𑆷𑆬𑆁 𑆩𑆲𑆳𑆱𑇀𑆫𑆾𑆠𑆯𑇀𑆖, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆠𑆴𑆱𑆸𑆰𑇀𑆛𑆩𑆠𑆴𑆧𑆢𑇀𑆣𑆁 𑆑𑆶𑆥𑆴𑆠𑆩𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆳 𑆱𑆯𑆧𑇀𑆢𑆯𑆷𑆬𑆩𑆶𑆖𑇀𑆗𑇀𑆮𑆱𑆤𑇀𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆟𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆇𑆢𑆑𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆠𑆳𑆬𑆶𑆩𑆷𑆬𑆁 𑆑𑇀𑆬𑆾𑆩 𑆖, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆘𑆴𑆲𑇀𑆮𑆳𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆑𑆟𑇀𑆜𑆑𑇀𑆬𑆾𑆩𑆯𑆾𑆰𑆁 𑆥𑆴𑆥𑆳𑆱𑆳𑆁 𑆖𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆾𑆢𑆑𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆤𑇀𑆤𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆳𑆩𑆳𑆯𑆪𑆾 𑆩𑆷𑆬𑆁 𑆮𑆳𑆩𑆁 𑆖 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆁, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑆤𑇀𑆤𑆳𑆨𑆴𑆬𑆰𑆟𑆩𑆫𑆾𑆖𑆑𑆮𑆴𑆥𑆳𑆑𑆿 𑆗𑆫𑇀𑆢𑆴𑆁 𑆖 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳𑇁𑆤𑇀𑆤𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆫𑆱𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆲𑆸𑆢𑆪𑆁 𑆩𑆷𑆬𑆁 𑆢𑆯 𑆖 𑆣𑆩𑆤𑇀𑆪𑆂𑇅 𑆯𑆾𑆟𑆴𑆠𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆪𑆑𑆸𑆤𑇀𑆩𑆷𑆬𑆁 𑆥𑇀𑆬𑆵𑆲𑆳 𑆖𑇅 𑆩𑆳𑆁𑆱𑆮𑆲𑆳𑆤𑆳𑆁 𑆖 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆱𑇀𑆤𑆳𑆪𑆶𑆫𑇀𑆩𑆷𑆬𑆁 𑆠𑇀𑆮𑆑𑇀 𑆖𑇅 𑆩𑆼𑆢𑆾𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆸𑆑𑇀𑆑𑆿 𑆩𑆷𑆬𑆁 𑆮𑆥𑆳𑆮𑆲𑆤𑆁 𑆖𑇅 𑆃𑆱𑇀𑆡𑆴𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆩𑆼𑆢𑆾 𑆩𑆷𑆬𑆁 𑆘𑆔𑆤𑆁 𑆖𑇅 𑆩𑆘𑇀𑆘𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑆱𑇀𑆡𑆵𑆤𑆴 𑆩𑆷𑆬𑆁 𑆱𑆤𑇀𑆣𑆪𑆯𑇀𑆖𑇅 𑆯𑆶𑆑𑇀𑆫𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆸𑆰𑆟𑆿 𑆩𑆷𑆬𑆁 𑆯𑆼𑆦𑆯𑇀𑆖𑇅 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆁 𑆫𑆱𑆳𑆢𑆴𑆮𑆲𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆴𑆮𑆴𑆣𑆳𑆯𑆴𑆠𑆥𑆵𑆠𑆵𑆪𑆼; 𑆪𑆳𑆤𑇀𑆪𑆼𑆮 𑆲𑆴 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆥𑇀𑆫𑆢𑆾𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳𑆤𑆴 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆶𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆩𑇀𑇅 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆩𑆷𑆬𑆁 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆿 𑆖, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆠𑆴𑆱𑆸𑆰𑇀𑆛𑆩𑆠𑆴𑆧𑆢𑇀𑆣𑆁 𑆥𑇀𑆫𑆑𑆶𑆥𑆴𑆠𑆩𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆮𑆳 𑆧𑆲𑆬𑆁 𑆱𑆯𑆷𑆬𑆁 𑆩𑆷𑆠𑇀𑆫𑆪𑆤𑇀𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆥𑆶𑆫𑆵𑆰𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆾 𑆩𑆷𑆬𑆁 𑆱𑇀𑆡𑆷𑆬𑆓𑆶𑆢𑆁 𑆖, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟𑆳𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆁 𑆱𑆯𑆧𑇀𑆢𑆯𑆷𑆬𑆩𑆠𑆴𑆢𑇀𑆫𑆮𑆩𑆠𑆴𑆓𑇀𑆫𑆡𑆴𑆠𑆩𑆠𑆴𑆧𑆲𑆶 𑆖𑆾𑆥𑆮𑆴𑆯𑆤𑇀𑆠𑆁 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆥𑆶𑆫𑆵𑆰𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑆳𑆁 𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆩𑆼𑆢𑆾 𑆩𑆷𑆬𑆁 𑆬𑆾𑆩𑆑𑆷𑆥𑆳𑆯𑇀𑆖, 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆳𑆩𑆴𑆢𑆁 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆨𑆮𑆠𑆴; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆱𑇀𑆮𑆼𑆢𑆤𑆩𑆠𑆴𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆥𑆳𑆫𑆶𑆰𑇀𑆪𑆩𑆠𑆴𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆠𑆳𑆩𑆕𑇀𑆓𑆱𑇀𑆪 𑆥𑆫𑆴𑆢𑆳𑆲𑆁 𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆁 𑆖 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆱𑇀𑆮𑆼𑆢𑆮𑆲𑆳𑆤𑇀𑆪𑆱𑇀𑆪 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇘𑇆
𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴, 𑆱𑆴𑆫𑆳𑆂, 𑆣𑆩𑆤𑇀𑆪𑆂, 𑆫𑆱𑆳𑆪𑆤𑇀𑆪𑆂, 𑆫𑆱𑆮𑆳𑆲𑆴𑆤𑇀𑆪𑆂, 𑆤𑆳𑆝𑇀𑆪𑆂, 𑆥𑆤𑇀𑆡𑆳𑆤𑆂, 𑆩𑆳𑆫𑇀𑆓𑆳𑆂, 𑆯𑆫𑆵𑆫𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆳𑆟𑆴, 𑆱𑆁𑆮𑆸𑆠𑆳𑆱𑆁𑆮𑆸𑆠𑆳𑆤𑆴, 𑆱𑇀𑆡𑆳𑆤𑆳𑆤𑆴, 𑆄𑆯𑆪𑆳𑆂, 𑆤𑆴𑆑𑆼𑆠𑆳𑆯𑇀𑆖𑆼𑆠𑆴 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑇀𑆮𑆮𑆑𑆳𑆯𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑇀𑆪𑆳𑆬𑆑𑇀𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆤𑆳𑆩𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆠𑇀 𑆱𑇀𑆡𑆳𑆤𑆱𑇀𑆡𑆳𑆯𑇀𑆖𑆽𑆮 𑆩𑆳𑆫𑇀𑆓𑆓𑆳𑆯𑇀𑆖 𑆯𑆫𑆵𑆫𑆣𑆳𑆠𑆮𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼, 𑆅𑆠𑆫𑆼𑆰𑆳𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆢𑆴𑆠𑆫𑆳𑆟𑆴 𑆖𑇅 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑆴 𑆱𑇀𑆫𑆾𑆠𑆳𑆁𑆱𑇀𑆪𑆼𑆮, 𑆣𑆳𑆠𑆮𑆯𑇀𑆖 𑆣𑆳𑆠𑆷𑆤𑆼𑆮 𑆥𑇀𑆫𑆢𑆷𑆰𑆪𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳 𑆢𑆷𑆰𑆪𑆴𑆠𑆳𑆫𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆢𑆾𑆰𑆱𑇀𑆮𑆨𑆳𑆮𑆳𑆢𑆴𑆠𑆴𑇆𑇙𑇆

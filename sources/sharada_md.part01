𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑆾𑆥𑆔𑆳𑆠𑆳 𑆪𑆼 𑆢𑆾𑆰𑆘𑆳 𑆩𑆳𑆤𑆱𑆳𑆱𑇀𑆠𑆡𑆳 𑇅 𑆇𑆥𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆥𑇀𑆫𑆢𑆼𑆯𑆼𑆰𑆶 𑆠𑆼𑆰𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆳𑆫𑆟𑆩𑇀 𑇆𑇕𑇆
𑆯𑆵𑆠𑆾𑆢𑆑𑆁 𑆥𑆪𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑆴𑆠𑇀𑆪𑆼𑆑𑆯𑆾 𑆢𑇀𑆮𑆴𑆯𑆂 𑇅 𑆠𑇀𑆫𑆴𑆯𑆂 𑆱𑆩𑆱𑇀𑆠𑆩𑆡𑆮𑆳 𑆥𑇀𑆫𑆳𑆑𑇀 𑆥𑆵𑆠𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑇀𑆮𑆪𑆂 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆖𑆷𑆫𑇀𑆟𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆩𑆣𑆶𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆡𑆳𑆧𑆬𑆁 𑆯𑆵𑆠𑆠𑆾𑆪𑆼𑆤𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆯𑆵𑆠𑆠𑆾𑆪𑆁 𑆖𑆳𑆤𑆶𑆥𑆴𑆧𑆼𑆢𑆼𑆮𑆩𑆲𑆫𑆲𑆫𑇀𑆩𑆳𑆱𑆁, 𑆠𑆢𑆼𑆮 𑆩𑆣𑆶𑆪𑆶𑆑𑇀𑆠𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆮𑆳, 𑆩𑆣𑆶𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆑𑇀𑆮𑆳𑆡𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳, 𑆩𑆣𑇀𑆮𑆳𑆩𑆬𑆑𑆫𑆱𑆳𑆨𑇀𑆪𑆳𑆁 𑆮𑆳, 𑆓𑆶𑆝𑆷𑆖𑆵𑆑𑇀𑆮𑆳𑆡𑆼𑆤 𑆮𑆳, 𑆍𑆮𑆩𑆼𑆠𑆼 𑆥𑆚𑇀𑆖 𑆥𑇀𑆫𑆪𑆾𑆓𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆘𑆵𑆫𑇀𑆟𑆼 𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟𑆳𑆬𑆮𑆟𑆼𑆤𑆳𑆬𑇀𑆥𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆔𑆸𑆠𑆮𑆤𑇀𑆠𑆩𑆾𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀; 𑆍𑆠𑆼 𑆒𑆬𑇀𑆮𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆑𑇀𑆰𑆥𑆪𑆤𑇀𑆠𑆴, 𑆑𑆸𑆩𑆵𑆤𑆶𑆥𑆔𑇀𑆤𑆤𑇀𑆠𑆴, 𑆓𑇀𑆫𑆲𑆟𑆣𑆳𑆫𑆟𑆯𑆑𑇀𑆠𑆴𑆁 𑆘𑆤𑆪𑆤𑇀𑆠𑆴, 𑆩𑆳𑆱𑆼 𑆩𑆳𑆱𑆼 𑆖 𑆥𑇀𑆫𑆪𑆾𑆓𑆼 𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆳𑆪𑆶𑆰𑆾𑇁𑆨𑆴𑆮𑆸𑆢𑇀𑆣𑆴𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇗𑇆
𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆤𑆳𑆁 𑆢𑇀𑆫𑆾𑆟𑆁 𑆥𑆴𑆰𑇀𑆛𑆥𑆖𑆤𑆼 𑆥𑆴𑆰𑇀𑆛𑆮𑆢𑆶𑆥𑆱𑇀𑆮𑆼𑆢𑇀𑆪 𑆮𑆴𑆓𑆠𑆑𑆰𑆳𑆪𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆢𑆸𑆰𑆢𑆴 𑆥𑆴𑆰𑇀𑆛𑆩𑆳𑆪𑆱𑆼 𑆢𑆸𑆞𑆼 𑆑𑆶𑆩𑇀𑆨𑆼 𑆩𑆣𑆷𑆢𑆑𑆾𑆠𑇀𑆠𑆫𑆁 𑆥𑇀𑆫𑆳𑆮𑆸𑆰𑆴 𑆨𑆱𑇀𑆩𑆫𑆳𑆯𑆳𑆮𑆤𑇀𑆠𑆫𑇀𑆓𑆸𑆲𑆼 𑆖𑆠𑆶𑆫𑆾 𑆩𑆳𑆱𑆳𑆤𑇀𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆮𑆫𑇀𑆰𑆳𑆮𑆴𑆓𑆩𑆼 𑆖𑆾𑆢𑇀𑆣𑆸𑆠𑇀𑆪𑆾𑆥𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆯𑆫𑆵𑆫𑆂 𑆱𑆲𑆱𑇀𑆫𑆱𑆩𑇀𑆥𑆳𑆠𑆳𑆨𑆴𑆲𑆶𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆥𑇀𑆫𑆳𑆠𑆂- 𑆥𑇀𑆫𑆳𑆠𑆫𑇀𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟𑆳𑆬𑆮𑆟𑆼𑆤 𑆔𑆸𑆠𑆮𑆤𑇀𑆠𑆩𑆾𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆥𑆳𑆁𑆯𑆶𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆯𑆪𑆵𑆠, 𑆠𑆱𑇀𑆪 𑆩𑆳𑆱𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆼𑆨𑇀𑆪𑆂 𑆑𑆸𑆩𑆪𑆾 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆠𑆴, 𑆠𑆳𑆤𑆟𑆶𑆠𑆽𑆬𑆼𑆤𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆱𑇀𑆪 𑆮𑆁𑆯𑆮𑆴𑆢𑆬𑆼𑆤𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆼 𑆪𑆷𑆑𑆳𑆱𑇀𑆠𑆡𑆽𑆮𑆳𑆥𑆲𑆫𑆼𑆠𑇀, 𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆢𑆤𑇀𑆠𑆤𑆒𑆫𑆾𑆩𑆳𑆟𑇀𑆪𑆮𑆯𑆵𑆫𑇀𑆪𑆤𑇀𑆠𑆼; 𑆥𑆚𑇀𑆖𑆩𑆼 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆓𑆶𑆟𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆃𑆩𑆳𑆤𑆶𑆰𑆁 𑆖𑆳𑆢𑆴𑆠𑇀𑆪𑆥𑇀𑆫𑆑𑆳𑆯𑆁 𑆮𑆥𑆶𑆫𑆣𑆴𑆓𑆖𑇀𑆗𑆠𑆴, 𑆢𑆷𑆫𑆳𑆖𑇀𑆗𑇀𑆫𑆮𑆟𑆳𑆤𑆴 𑆢𑆫𑇀𑆯𑆤𑆳 𑆤𑆴𑆖𑆳𑆱𑇀𑆪 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆫𑆘𑆱𑇀𑆠𑆩𑆱𑆵 𑆖𑆳𑆥𑆾𑆲𑇀𑆪 𑆱𑆠𑇀𑆠𑇀𑆮𑆩𑆣𑆴𑆠𑆴𑆰𑇀𑆜𑆠𑆴, 𑆯𑇀𑆫𑆶𑆠𑆤𑆴𑆓𑆳𑆢𑇀𑆪𑆥𑆷𑆫𑇀𑆮𑆾𑆠𑇀𑆥𑆳𑆢𑆵 𑆓𑆘𑆧𑆬𑆾𑇁𑆯𑇀𑆮𑆘𑆮𑆂 𑆥𑆶𑆤𑆫𑇀𑆪𑆶𑆮𑆳𑇁𑆰𑇀𑆛𑆿 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆤𑇀𑆪𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆴; 𑆠𑆱𑇀𑆪𑆳𑆟𑆶𑆠𑆽𑆬𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆫𑇀𑆡𑆼, 𑆃𑆘𑆑𑆫𑇀𑆟𑆑𑆰𑆳𑆪𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆫𑇀𑆡𑆼, 𑆱𑆾𑆯𑆵𑆫𑆁 𑆑𑆷𑆥𑆾𑆢𑆑𑆁 𑆱𑇀𑆤𑆳𑆤𑆳𑆫𑇀𑆡𑆼, 𑆖𑆤𑇀𑆢𑆤𑆩𑆶𑆥𑆬𑆼𑆥𑆤𑆳𑆫𑇀𑆡𑆼, 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆳𑆤𑆮𑆢𑆳𑆲𑆳𑆫𑆂 𑆥𑆫𑆴𑆲𑆳𑆫𑆯𑇀𑆖 𑇆𑇘𑇆
𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆳𑆟𑆳𑆁 𑆤𑆴𑆰𑇀𑆑𑆶𑆬𑆵𑆑𑆸𑆠𑆳𑆤𑆳𑆩𑆼𑆰 𑆍𑆮 𑆑𑆬𑇀𑆥𑆂 𑆥𑆳𑆁𑆯𑆶𑆯𑆪𑇀𑆪𑆳𑆨𑆾𑆘𑆤𑆮𑆫𑇀𑆘𑆁; 𑆃𑆠𑇀𑆫 𑆲𑆴 𑆥𑆪𑆱𑆳 𑆯𑆸𑆠𑆼𑆤 𑆨𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆁, 𑆱𑆩𑆳𑆤𑆩𑆤𑇀𑆪𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑆳𑆯𑆴𑆰𑆯𑇀𑆖 𑇅 𑆯𑆾𑆟𑆴𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆰𑆶 𑆮𑆴𑆑𑆳𑆫𑆼𑆰𑇀𑆮𑆼𑆠𑆼𑆰𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂 𑇆𑇙𑇆
𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆧𑆬𑆳𑆩𑆷𑆬𑆳𑆫𑇀𑆣𑆥𑆬𑆁 𑆥𑆬𑆁 𑆮𑆳 𑆥𑆪𑆱𑆳𑇁𑇁𑆬𑆾𑆝𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆍𑆮𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆢𑇀𑆮𑆳𑆢𑆯 𑆮𑆫𑇀𑆰𑆳𑆟𑆴 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴; 𑆍𑆮𑆁 𑆢𑆴𑆮𑆱𑆯𑆠𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆮𑆫𑇀𑆰𑆯𑆠𑆁 𑆮𑆪𑆱𑇀𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇅 𑆍𑆮𑆩𑆼𑆮𑆳𑆠𑆴𑆧𑆬𑆳𑆤𑆳𑆓𑆧𑆬𑆳𑆮𑆴𑆢𑆳𑆫𑆵𑆯𑆠𑆳𑆮𑆫𑆵𑆟𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆂 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑇀𑆮𑆠𑆴𑆧𑆬𑆳𑆩𑆶𑆢𑆑𑆼𑆤, 𑆤𑆳𑆓𑆧𑆬𑆳𑆖𑆷𑆫𑇀𑆟𑆁 𑆩𑆣𑆶𑆤𑆳, 𑆮𑆴𑆢𑆳𑆫𑆵𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑇀𑆰𑆵𑆫𑆼𑆟, 𑆯𑆠𑆳𑆮𑆫𑆵𑆩𑆥𑇀𑆪𑆼𑆮𑆁, 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑆳𑆤𑇀𑆪𑆠𑇀 𑆱𑆩𑆳𑆤𑆩𑆳𑆯𑆴𑆰𑆯𑇀𑆖 𑆱𑆩𑆳𑆂 𑇅 𑆍𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆿𑆰𑆣𑆪𑆾 𑆧𑆬𑆑𑆳𑆩𑆳𑆤𑆳𑆁 𑆯𑆾𑆰𑆴𑆟𑆳𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆾𑆥𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆯𑆾𑆟𑆴𑆠𑆁 𑆗𑆫𑇀𑆢𑆪𑆠𑆳𑆁 𑆮𑆴𑆫𑆴𑆖𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆢𑆴𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑇆𑇑𑇐𑇆
𑆮𑆳𑆫𑆳𑆲𑆵𑆩𑆷𑆬𑆠𑆶𑆬𑆳𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆠𑆠𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆩𑆣𑆶𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆥𑆪𑆱𑆳𑇁𑇁𑆬𑆾𑆝𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆾𑇁𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 ; 𑆥𑇀𑆫𑆪𑆾𑆓𑆩𑆴𑆩𑆩𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆾 𑆮𑆫𑇀𑆰𑆯𑆠𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆴 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆖𑆳𑆑𑇀𑆰𑆪𑆠𑆳𑆩𑇀, 𑆍𑆠𑆼𑆤𑆽𑆮 𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆥𑆪𑆾𑇁𑆮𑆖𑆷𑆫𑇀𑆟𑇀𑆪 𑆯𑆸𑆠𑆯𑆵𑆠𑆩𑆨𑆴𑆩𑆡𑇀𑆪𑆳𑆘𑇀𑆪𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑇀𑆪 𑆩𑆣𑆶𑆪𑆶𑆠𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆱𑆳𑆪𑆩𑇀𑆥𑇀𑆫𑆳𑆠𑆫𑆼𑆑𑆑𑆳𑆬𑆁 𑆮𑆳, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆍𑆮𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇑𑇑𑇆
𑆖𑆑𑇀𑆰𑆶𑆂𑆑𑆳𑆩𑆂 𑆥𑇀𑆫𑆳𑆟𑆑𑆳𑆩𑆾 𑆮𑆳 𑆧𑆵𑆘𑆑𑆱𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆩𑆤𑇀𑆡𑆩𑆷𑆬𑆁 𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆩𑆳𑆰𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆱𑆳𑆣𑆪𑆼𑆠𑇀, 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆱𑆴𑆣𑇀𑆪𑆠𑆴 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆳𑆤𑆳𑆩𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆁 𑆑𑆬𑇀𑆑𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑆳𑆩𑆬𑆑𑆫𑆱𑆖𑆠𑆶𑆫𑇀𑆡𑆨𑆳𑆓𑆁, 𑆠𑆠𑆂 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆱𑆲𑆱𑇀𑆫𑆱𑆩𑇀𑆥𑆳𑆠𑆳𑆨𑆴𑆲𑆶𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆯𑆵𑆠𑆵𑆨𑆷𑆠𑆁 𑆩𑆣𑆶𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑇀𑆪𑆳𑆁 𑆱𑆁𑆱𑆸𑆘𑇀𑆪𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆪𑆡𑆳𑆧𑆬𑆁, 𑆪𑆡𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆖 𑆬𑆮𑆟𑆁 𑆥𑆫𑆴𑆲𑆫𑆤𑇀 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇅 𑆘𑆵𑆫𑇀𑆟𑆼 𑆩𑆶𑆢𑇀𑆓𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟𑆳𑆬𑆮𑆟𑆼𑆤 𑆔𑆸𑆠𑆮𑆤𑇀𑆠𑆩𑆾𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆥𑆪𑆱𑆳 𑆮𑆳 𑆩𑆳𑆱𑆠𑇀𑆫𑆪𑆩𑇀; 𑆍𑆮𑆩𑆳𑆨𑇀𑆪𑆳𑆁 𑆥𑇀𑆫𑆪𑆾𑆓𑆳𑆨𑇀𑆪𑆳𑆁 𑆖𑆑𑇀𑆰𑆶𑆂 𑆱𑆿𑆥𑆫𑇀𑆟𑆁 𑆨𑆮𑆠𑇀𑆪𑆤𑆬𑇀𑆥𑆧𑆬𑆂 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆖𑆳𑆑𑇀𑆰𑆪𑆾 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆵𑆠𑆴 𑇆𑇑𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆪𑆱𑆳 𑆱𑆲 𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆴 𑆤𑆫𑆂 𑆯𑆟𑆦𑆬𑆳𑆤𑆴 𑆪𑆂 𑇅 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑆥𑆪𑆱𑆳 𑆱𑆳𑆫𑇀𑆣𑆁 𑆮𑆪𑆱𑇀𑆠𑆱𑇀𑆪 𑆤 𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆼𑆣𑆳𑆪𑆶𑆰𑇀𑆑𑆳𑆩𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆩𑆼𑆣𑆳𑆪𑆶𑆂𑆑𑆳𑆩𑆂 𑆯𑇀𑆮𑆼𑆠𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆦𑆬𑆳𑆤𑇀𑆪𑆳𑆠𑆥𑆥𑆫𑆴𑆯𑆶𑆰𑇀𑆑𑆳𑆟𑇀𑆪𑆳𑆢𑆳𑆪 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆑𑆸𑆠𑇀𑆮𑆳 𑆓𑆶𑆝𑆼𑆤 𑆱𑆲𑆳𑆬𑆾𑆝𑇀𑆪 𑆱𑇀𑆤𑆼𑆲𑆑𑆶𑆩𑇀𑆨𑆼 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆁 𑆣𑆳𑆤𑇀𑆪𑆫𑆳𑆯𑆿 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆢𑆶𑆢𑇀𑆣𑆸𑆠𑇀𑆪 𑆲𑆸𑆠𑆢𑆾𑆰𑆱𑇀𑆪 𑆪𑆡𑆳𑆧𑆬𑆁 𑆥𑆴𑆟𑇀𑆝𑆁 𑆥𑇀𑆫𑆪𑆖𑇀𑆗𑆼𑆢𑆤𑆶𑆢𑆴𑆠𑆼 𑆱𑆷𑆫𑇀𑆪𑆼, 𑆇𑆰𑇀𑆟𑆾𑆢𑆑𑆁 𑆖𑆳𑆤𑆶𑆥𑆴𑆧𑆼𑆠𑇀; 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆮𑆴𑆣𑆳𑆤𑆮𑆖𑇀𑆖𑆳𑆓𑆳𑆫𑆥𑇀𑆫𑆮𑆼𑆯𑆂, 𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆲𑆴𑆩𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆂 𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆓𑆳𑆠𑇀𑆫𑆂 𑆯𑆳𑆬𑆵𑆤𑆳𑆁 𑆰𑆰𑇀𑆛𑆴𑆑𑆳𑆤𑆳𑆁 𑆖 𑆥𑆪𑆱𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆫𑆼𑆟𑆿𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀; 𑆍𑆮𑆁 𑆰𑆟𑇀𑆩𑆳𑆱𑆳𑆤𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆮𑆴𑆓𑆠𑆥𑆳𑆥𑇀𑆩𑆳 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆥𑆼𑆠𑆂 𑆯𑇀𑆫𑆶𑆠𑆤𑆴𑆓𑆳𑆢𑆵 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆤𑆫𑆾𑆓𑆾 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇅 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆁 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆩𑆶𑆢𑆫𑆴𑆟𑆁 𑆮𑆳 𑆑𑆸𑆰𑇀𑆟𑆳𑆪𑆳 𑆓𑆾𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆼𑆟𑆳𑆬𑆾𑆝𑇀𑆪𑆳𑆫𑇀𑆣𑆥𑆬𑆴𑆑𑆁 𑆥𑆴𑆟𑇀𑆝𑆁 𑆮𑆴𑆓𑆠𑆬𑆿𑆲𑆴𑆠𑇀𑆪𑆼 𑆱𑆮𑆴𑆠𑆫𑆴 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆖𑆳𑆬𑆮𑆟𑆼𑆤𑆳𑆩𑆬𑆑𑆪𑆷𑆰𑆼𑆟 𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆩𑆤𑇀𑆠𑆩𑆾𑆢𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀, 𑆍𑆮𑆁 𑆩𑆳𑆱𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆤𑆫𑆾𑆓𑆾 𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇅 𑆍𑆰 𑆍𑆮𑆾𑆥𑆪𑆾𑆓𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆳𑆤𑆳𑆁 𑆫𑆘𑆤𑇀𑆪𑆳𑆯𑇀𑆖; 𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆷𑆬𑆼 𑆮𑆴𑆯𑆼𑆰𑆾 𑆢𑇀𑆮𑆴𑆥𑆬𑆴𑆑𑆁 𑆥𑆴𑆟𑇀𑆝𑆁 𑆥𑆫𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆁, 𑆯𑆼𑆰𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀 𑇆𑇓𑇆
𑆲𑆸𑆠𑆢𑆾𑆰 𑆍𑆮𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆨𑆑𑇀𑆠𑆾 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆱𑇀𑆮𑆫𑆱𑆩𑆳𑆢𑆳𑆪 𑆱𑆲𑆱𑇀𑆫𑆱𑆩𑇀𑆥𑆳𑆠𑆳𑆨𑆴𑆲𑆶𑆠𑆁 𑆑𑆸𑆠𑇀𑆮𑆳 𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆲𑇀𑆟𑆼 𑆪𑆮𑆳𑆓𑆷𑆩𑆬𑆮𑆟𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆑𑇀𑆰𑆵𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆾 𑆮𑆳 𑆥𑆪𑆱𑆳 𑆨𑆶𑆚𑇀𑆘𑆵𑆠, 𑆍𑆮𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆧𑇀𑆫𑆲𑇀𑆩𑆮𑆫𑇀𑆖𑆱𑆵 𑆩𑆼𑆣𑆳𑆮𑆵 𑆨𑆮𑆠𑆴, 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆓𑇀𑆫𑆤𑇀𑆡𑆩𑆵𑆥𑇀𑆱𑆴𑆠𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆤𑆰𑇀𑆛𑆁 𑆖𑆳𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆮𑆠𑆴, 𑆠𑆸𑆠𑆵𑆪𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆢𑇀𑆮𑆴𑆫𑆶𑆖𑇀𑆖𑆳𑆫𑆴𑆠𑆁 𑆯𑆠𑆩𑆥𑇀𑆪𑆮𑆣𑆳𑆫𑆪𑆠𑆴, 𑆍𑆮𑆩𑆼𑆑𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆳𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆫𑆥𑆑𑇀𑆫𑆳𑆩𑆠𑆴; 𑆩𑆷𑆫𑇀𑆠𑆴𑆩𑆠𑆵 𑆖𑆽𑆤𑆁 𑆮𑆳𑆓𑇀𑆢𑆼𑆮𑇀𑆪𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴, 𑆱𑆫𑇀𑆮𑆳𑆯𑇀𑆖𑆽𑆤𑆁 𑆯𑇀𑆫𑆶𑆠𑆪 𑆇𑆥𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆴, 𑆯𑇀𑆫𑆶𑆠𑆣𑆫𑆂 𑆥𑆚𑇀𑆖𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑇆𑇕𑇆
𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵𑆱𑇀𑆮𑆫𑆱𑆥𑇀𑆫𑆱𑇀𑆡𑆢𑇀𑆮𑆪𑆼 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆮𑆴𑆝𑆕𑇀𑆓𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆤𑆳𑆁 𑆑𑆶𑆝𑆮𑆁 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆬𑆼 𑆮𑆖𑆳𑆩𑆸𑆠𑆪𑆾𑆫𑇀𑆢𑇀𑆮𑆳𑆢𑆯 𑆲𑆫𑆵𑆠𑆑𑇀𑆪𑆳𑆩𑆬𑆑𑆧𑆴𑆨𑆵𑆠𑆑𑆳𑆤𑆴 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆪𑆽𑆑𑆣𑇀𑆪𑆁 𑆱𑆳𑆣𑆪𑆴𑆠𑇀𑆮𑆳 𑆱𑇀𑆮𑆤𑆶𑆓𑆶𑆥𑇀𑆠𑆁 𑆤𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆠𑆠𑆂 𑆥𑆷𑆫𑇀𑆮𑆮𑆴𑆣𑆳𑆤𑆼𑆤 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆪𑆡𑆳𑆧𑆬𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆥𑆷𑆫𑇀𑆮𑆮𑆖𑇀𑆖𑆳𑆠𑇀𑆫 𑆥𑆫𑆵𑆲𑆳𑆫𑆂, 𑆍𑆠𑆼𑆤𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆣𑆱𑇀𑆠𑆴𑆫𑇀𑆪𑆑𑇀 𑆑𑆸𑆩𑆪𑆾 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆠𑆴, 𑆃𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆫𑆥𑆑𑇀𑆫𑆳𑆩𑆠𑆴, 𑆥𑆶𑆰𑇀𑆑𑆫𑆮𑆫𑇀𑆟𑆂 𑆱𑇀𑆡𑆴𑆫𑆮𑆪𑆳𑆂 𑆯𑇀𑆫𑆶𑆠𑆤𑆴𑆓𑆳𑆢𑆵 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴; 𑆍𑆠𑆢𑆼𑆮 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆾𑆤𑇀𑆩𑆳𑆢𑆮𑆴𑆰𑆨𑆷𑆠𑆓𑇀𑆫𑆲𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆖 𑆩𑆲𑆳𑆮𑇀𑆪𑆳𑆣𑆴𑆰𑆶 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆳𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑇆𑇖𑇆
𑆲𑆸𑆠𑆢𑆾𑆰 𑆍𑆮𑆳𑆓𑆳𑆫𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆲𑆽𑆩𑆮𑆠𑇀𑆪𑆳 𑆮𑆖𑆳𑆪𑆳𑆂 𑆥𑆴𑆟𑇀𑆝𑆩𑆳𑆩𑆬𑆑𑆩𑆳𑆠𑇀𑆫𑆩𑆨𑆴𑆲𑆶𑆠𑆁 𑆥𑆪𑆱𑆳𑇁𑇁𑆬𑆾𑆝𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆘𑆵𑆫𑇀𑆟𑆼 𑆥𑆪𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑆾𑆢𑆤 𑆅𑆠𑇀𑆪𑆳𑆲𑆳𑆫𑆂, 𑆍𑆮𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆫𑆳𑆠𑇀𑆫 𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆮𑆴𑆮𑇀𑆫𑆴𑆪𑆠𑆼, 𑆢𑇀𑆮𑆴𑆫𑆨𑇀𑆪𑆳𑆱𑆳𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆴𑆩𑆳𑆤𑇀 𑆨𑆮𑆠𑆴, 𑆠𑇀𑆫𑆴𑆫𑆨𑇀𑆪𑆳𑆱𑆳𑆖𑇀𑆗𑇀𑆫𑆶𑆠𑆩𑆳𑆢𑆠𑇀𑆠𑆼, 𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆮𑆳𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆱𑆫𑇀𑆮𑆁 𑆠𑆫𑆠𑆴 𑆑𑆴𑆬𑇀𑆧𑆴𑆰𑆁, 𑆠𑆳𑆫𑇀𑆑𑇀𑆰𑇀𑆪𑆢𑆫𑇀𑆯𑆤𑆩𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼, 𑆯𑆠𑆳𑆪𑆶𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇅 𑆢𑇀𑆮𑆼 𑆢𑇀𑆮𑆼 𑆥𑆬𑆼 𑆅𑆠 𑆫𑆱𑇀𑆪𑆳 𑆮𑆖𑆳𑆪𑆳 𑆤𑆴𑆰𑇀𑆑𑇀𑆮𑆳𑆡𑇀𑆪 𑆥𑆴𑆧𑆼𑆠𑇀 𑆥𑆪𑆱𑆳, 𑆱𑆩𑆳𑆤𑆁 𑆨𑆾𑆘𑆤𑆁, 𑆱𑆩𑆳𑆂 𑆥𑆷𑆫𑇀𑆮𑆼𑆟𑆳𑆯𑆴𑆰𑆯𑇀𑆖 𑇆𑇗𑇆
𑆮𑆖𑆳𑆯𑆠𑆥𑆳𑆑𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆢𑇀𑆫𑆾𑆟𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆥𑆚𑇀𑆖𑆮𑆫𑇀𑆰𑆯𑆠𑆳𑆪𑆶𑆫𑇀𑆨𑆮𑆠𑆴, 𑆓𑆬𑆓𑆟𑇀𑆝𑆳𑆥𑆖𑆵𑆯𑇀𑆬𑆵𑆥𑆢𑆱𑇀𑆮𑆫𑆨𑆼𑆢𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆲𑆤𑇀𑆠𑆵𑆠𑆴 𑇆𑇘𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆄𑆪𑆶𑆰𑇀𑆑𑆳𑆩𑆫𑆱𑆳𑆪𑆤𑆩𑇀 𑇅 𑆩𑆤𑇀𑆠𑇀𑆫𑆿𑆰𑆣𑆱𑆩𑆳𑆪𑆶𑆑𑇀𑆠𑆁 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆦𑆬𑆥𑇀𑆫𑆢𑆩𑇀 𑇆𑇙𑇆
𑆧𑆴𑆬𑇀𑆮𑆱𑇀𑆪 𑆖𑆷𑆫𑇀𑆟𑆁 𑆥𑆶𑆰𑇀𑆪𑆼 𑆠𑆶 𑆲𑆶𑆠𑆁 𑆮𑆳𑆫𑆳𑆤𑇀 𑆱𑆲𑆱𑇀𑆫𑆯𑆂 𑇅 𑆯𑇀𑆫𑆵𑆱𑆷𑆑𑇀𑆠𑆼𑆤 𑆤𑆫𑆂 𑆑𑆬𑇀𑆪𑆼 𑆱𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼 𑇆𑇑𑇐𑇆
𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆪𑆶𑆠𑆁 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆤𑆳𑆯𑆤𑆁 𑆥𑆫𑆩𑇀 𑇅 𑆠𑇀𑆮𑆖𑆁 𑆮𑆴𑆲𑆳𑆪 𑆧𑆴𑆬𑇀𑆮𑆱𑇀𑆪 𑆩𑆷𑆬𑆑𑇀𑆮𑆳𑆡𑆁 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼 𑇆𑇑𑇑𑇆
𑆥𑇀𑆫𑆳𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆥𑆪𑆱𑆳 𑆱𑆳𑆫𑇀𑆣𑆁 𑆱𑇀𑆤𑆳𑆠𑇀𑆮𑆳 𑆲𑆶𑆠𑇀𑆮𑆳 𑆱𑆩𑆳𑆲𑆴𑆠𑆂 𑇅 𑆢𑆯𑆱𑆳𑆲𑆱𑇀𑆫𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆁 𑆱𑇀𑆩𑆸𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆫𑆡𑆁 𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇒𑇆
𑆲𑆶𑆠𑇀𑆮𑆳 𑆧𑆴𑆱𑆳𑆤𑆳𑆁 𑆑𑇀𑆮𑆳𑆡𑆁 𑆠𑆶 𑆩𑆣𑆶𑆬𑆳𑆘𑆽𑆯𑇀𑆖 𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇅 𑆃𑆩𑆾𑆔𑆁 𑆯𑆠𑆱𑆳𑆲𑆱𑇀𑆫𑆁 𑆪𑆶𑆑𑇀𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆫𑆡𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆥𑆢𑇀𑆩𑆧𑆵𑆘𑆳𑆤𑆴 𑆩𑆣𑆶 𑆬𑆳𑆘𑆳𑆂 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆮𑆂 𑇅 𑆓𑆮𑇀𑆪𑆼𑆤 𑆥𑆪𑆱𑆳 𑆥𑆵𑆠𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆪𑆼𑆠𑇀 𑇆𑇑𑇔𑇆
𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆢𑆬𑆑𑇀𑆮𑆳𑆡𑆾 𑆓𑆮𑇀𑆪𑆼𑆤 𑆥𑆪𑆱𑆳 𑆯𑆸𑆠𑆂 𑇅 𑆱𑆱𑆶𑆮𑆫𑇀𑆟𑆱𑇀𑆠𑆴𑆬𑆽𑆂 𑆱𑆳𑆫𑇀𑆣𑆩𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆤𑆳𑆯𑆤𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇑𑇕𑇆
𑆓𑆮𑇀𑆪𑆁 𑆥𑆪𑆂 𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆖 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆁 𑆖 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆩𑇀 𑇅 𑆥𑆵𑆠𑆁 𑆯𑆠𑆱𑆲𑆱𑇀𑆫𑆳𑆨𑆴𑆲𑆶𑆠𑆁 𑆪𑆶𑆑𑇀𑆠𑆫𑆡𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇆𑇑𑇖𑇆
𑆮𑆖𑆳𑆔𑆸𑆠𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆖 𑆧𑆴𑆬𑇀𑆮𑆖𑆷𑆫𑇀𑆟𑆩𑆴𑆠𑆴 𑆠𑇀𑆫𑆪𑆩𑇀 𑇅 𑆩𑆼𑆣𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆥𑆶𑆰𑇀𑆛𑆴𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆮𑆫𑇀𑆣𑆤𑆩𑇀 𑇆𑇑𑇗𑇆
𑆮𑆳𑆱𑆳𑆩𑆷𑆬𑆠𑆶𑆬𑆳𑆑𑇀𑆮𑆳𑆡𑆼 𑆠𑆽𑆬𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆱𑆳𑆣𑆴𑆠𑆩𑇀 𑇅 𑆲𑆶𑆠𑇀𑆮𑆳 𑆱𑆲𑆱𑇀𑆫𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆤𑇀𑆩𑆼𑆣𑇀𑆪𑆩𑆳𑆪𑆶𑆰𑇀𑆪𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇆𑇑𑇘𑇆
𑆪𑆳𑆮𑆑𑆳𑆁𑆱𑇀𑆠𑆳𑆮𑆑𑆳𑆤𑇀 𑆒𑆳𑆢𑆼𑆢𑆨𑆴𑆨𑆷𑆪 𑆪𑆮𑆳𑆁𑆱𑇀𑆠𑆡𑆳 𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆣𑆶𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀 𑆯𑆴𑆑𑇀𑆰𑆳 𑆖𑆫𑆟𑆮𑆢𑇀𑆨𑆮𑆼𑆠𑇀 𑇆𑇑𑇙𑇆
𑆩𑆣𑇀𑆮𑆳𑆩𑆬𑆑𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆱𑆶𑆮𑆫𑇀𑆟𑆩𑆴𑆠𑆴 𑆖 𑆠𑇀𑆫𑆪𑆩𑇀 𑇅 𑆥𑇀𑆫𑆳𑆯𑇀𑆪𑆳𑆫𑆴𑆰𑇀𑆛𑆓𑆸𑆲𑆵𑆠𑆾𑇁𑆥𑆴 𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑆥𑇀𑆫𑆳𑆟𑆱𑆁𑆯𑆪𑆳𑆠𑇀 𑇆𑇒𑇐𑇆
𑆯𑆠𑆳𑆮𑆫𑆵𑆔𑆸𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑆶𑆥𑆪𑆶𑆑𑇀𑆠𑆁 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼 𑇅 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆱𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆖 𑆤𑆫𑆼𑆤𑇀𑆢𑇀𑆫𑆁 𑆱𑇀𑆡𑆳𑆥𑆪𑆼𑆢𑇀𑆮𑆯𑆼 𑇆𑇒𑇑𑇆
𑆓𑆾𑆖𑆤𑇀𑆢𑆤𑆳 𑆩𑆾𑆲𑆤𑆴𑆑𑆳 𑆩𑆣𑆶𑆑𑆁 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆁 𑆩𑆣𑆶 𑇅 𑆱𑆶𑆮𑆫𑇀𑆟𑆩𑆴𑆠𑆴 𑆱𑆁𑆪𑆾𑆓𑆂 𑆥𑆼𑆪𑆂 𑆱𑆿𑆨𑆳𑆓𑇀𑆪𑆩𑆴𑆖𑇀𑆗𑆠𑆳 𑇆𑇒𑇒𑇆
𑆥𑆢𑇀𑆩𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆑𑇀𑆮𑆳𑆡𑆼 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑆁𑆪𑆶𑆠𑆼 𑇅 𑆱𑆫𑇀𑆥𑆴𑆫𑆳𑆱𑆳𑆢𑆴𑆠𑆁 𑆓𑆮𑇀𑆪𑆁 𑆱𑆱𑆶𑆮𑆫𑇀𑆟𑆁 𑆱𑆢𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑇆𑇒𑇓𑇆
𑆥𑆪𑆯𑇀𑆖𑆳𑆤𑆶𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆼𑆰𑆳𑆩𑆼𑆮 𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆼 𑇅 𑆃𑆬𑆑𑇀𑆰𑇀𑆩𑆵𑆔𑇀𑆤𑆁 𑆱𑆢𑆳𑇁𑇁𑆪𑆶𑆰𑇀𑆪𑆁 𑆫𑆳𑆘𑇀𑆪𑆳𑆪 𑆱𑆶𑆨𑆓𑆳𑆪 𑆖 𑇆𑇒𑇔𑇆
𑆪𑆠𑇀𑆫 𑆤𑆾𑆢𑆵𑆫𑆴𑆠𑆾 𑆩𑆤𑇀𑆠𑇀𑆫𑆾 𑆪𑆾𑆓𑆼𑆰𑇀𑆮𑆼𑆠𑆼𑆰𑆶 𑆱𑆳𑆣𑆤𑆼 𑇅 𑆯𑆧𑇀𑆢𑆴𑆠𑆳 𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆮𑆠𑇀𑆫 𑆓𑆳𑆪𑆠𑇀𑆫𑆵 𑆠𑇀𑆫𑆴𑆥𑆢𑆳 𑆨𑆮𑆼𑆠𑇀 𑇆𑇒𑇕𑇆
𑆥𑆳𑆥𑇀𑆩𑆳𑆤𑆁 𑆤𑆳𑆯𑆪𑆤𑇀𑆠𑇀𑆪𑆼𑆠𑆳 𑆢𑆢𑇀𑆪𑆶𑆯𑇀𑆖𑆿𑆰𑆣𑆪𑆂 𑆯𑇀𑆫𑆴𑆪𑆩𑇀 𑇅 𑆑𑆶𑆫𑇀𑆪𑆶𑆫𑇀𑆤𑆳𑆓𑆧𑆬𑆁 𑆖𑆳𑆥𑆴 𑆩𑆤𑆶𑆰𑇀𑆪𑆩𑆩𑆫𑆾𑆥𑆩𑆩𑇀 𑇆𑇒𑇖𑇆
𑆱𑆠𑆠𑆳𑆣𑇀𑆪𑆪𑆤𑆁 𑆮𑆳𑆢𑆂 𑆥𑆫𑆠𑆤𑇀𑆠𑇀𑆫𑆳𑆮𑆬𑆾𑆑𑆤𑆩𑇀 𑇅 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆖𑆳𑆫𑇀𑆪𑆱𑆼𑆮𑆳 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆼𑆣𑆳𑆑𑆫𑆾 𑆓𑆶(𑆓)𑆟𑆂 𑇆𑇒𑇗𑇆
𑆄𑆪𑆶𑆰𑇀𑆪𑆁 𑆨𑆾𑆘𑆤𑆁 𑆘𑆵𑆫𑇀𑆟𑆼 𑆮𑆼𑆓𑆳𑆤𑆳𑆁 𑆖𑆳𑆮𑆴𑆣𑆳𑆫𑆟𑆩𑇀 𑇅 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆩𑆲𑆴𑆁𑆱𑆳 𑆖 𑆱𑆳𑆲𑆱𑆳𑆤𑆳𑆁 𑆖 𑆮𑆫𑇀𑆘𑆤𑆩𑇀 𑇆𑇒𑇘𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆮𑆨𑆳𑆮𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆤𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆳𑆢𑆪𑆾𑇁𑆱𑆸𑆘𑆤𑇀 𑆥𑆷𑆫𑇀𑆮𑆩𑆩𑆸𑆠𑆁 𑆱𑆾𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆩𑇀 𑇅 𑆘𑆫𑆳𑆩𑆸𑆠𑇀𑆪𑆶𑆮𑆴𑆤𑆳𑆯𑆳𑆪 𑆮𑆴𑆣𑆳𑆤𑆁 𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆍𑆑 𑆍𑆮 𑆒𑆬𑆶 𑆨𑆓𑆮𑆳𑆤𑇀 𑆱𑆾𑆩𑆂 𑆱𑇀𑆡𑆳𑆤𑆤𑆳𑆩𑆳𑆑𑆸𑆠𑆴𑆮𑆵𑆫𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆁𑆯𑆠𑆴𑆣𑆳 𑆨𑆴𑆢𑇀𑆪𑆠𑆼 𑇆𑇔𑇆
𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆁𑆯𑆶𑆩𑆳𑆤𑇀 𑆩𑆶𑆚𑇀𑆘𑆮𑆳𑆁𑆯𑇀𑆖𑆽𑆮 𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆳 𑆫𑆘𑆠𑆥𑇀𑆫𑆨𑆂 𑇅 𑆢𑆷𑆫𑇀𑆮𑆳𑆱𑆾𑆩𑆂 𑆑𑆤𑆵𑆪𑆳𑆁𑆯𑇀𑆖 𑆯𑇀𑆮𑆼𑆠𑆳𑆑𑇀𑆰𑆂 𑆑𑆤𑆑𑆥𑇀𑆫𑆨𑆂 𑇆𑇕𑇆
𑆥𑇀𑆫𑆠𑆳𑆤𑆮𑆳𑆁𑆱𑇀𑆠𑆳𑆬𑆮𑆸𑆤𑇀𑆠𑆂 𑆑𑆫𑆮𑆵𑆫𑆾𑆁𑇁𑆯𑆮𑆳𑆤𑆥𑆴 𑇅 𑆱𑇀𑆮𑆪𑆩𑇀𑆥𑇀𑆫𑆨𑆾 𑆩𑆲𑆳𑆱𑆾𑆩𑆾 𑆪𑆯𑇀𑆖𑆳𑆥𑆴 𑆓𑆫𑆶𑆝𑆳𑆲𑆸𑆠𑆂 𑇆𑇖𑇆
𑆓𑆳𑆪𑆠𑇀𑆫𑆱𑇀𑆠𑇀𑆫𑆽𑆰𑇀𑆛𑆶𑆨𑆂 𑆥𑆳𑆕𑇀𑆑𑇀𑆠𑆾 𑆘𑆳𑆓𑆠𑆂 𑆯𑆳𑆑𑇀𑆮𑆫𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆓𑇀𑆤𑆴𑆰𑇀𑆛𑆾𑆩𑆾 𑆫𑆽𑆮𑆠𑆯𑇀𑆖 𑆪𑆡𑆾𑆑𑇀𑆠 𑆅𑆠𑆴 𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇆𑇗𑇆
𑆓𑆳𑆪𑆠𑇀𑆫𑇀𑆪𑆳 𑆠𑇀𑆫𑆴𑆥𑆢𑆳 𑆪𑆶𑆑𑇀𑆠𑆾 𑆪𑆯𑇀𑆖𑆾𑆝𑆶𑆥𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆍𑆠𑆼 𑆱𑆾𑆩𑆳𑆂 𑆱𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆮𑆼𑆢𑆾𑆑𑇀𑆠𑆽𑆫𑇀𑆤𑆳𑆩𑆨𑆴𑆂 𑆯𑆶𑆨𑆽𑆂 𑇆𑇘𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆖𑆽𑆠𑆼𑆰𑆳𑆩𑆼𑆑𑆾 𑆮𑆴𑆣𑆴𑆫𑆶𑆥𑆳𑆱𑆤𑆼 𑇅 𑆱𑆫𑇀𑆮𑆼 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆳𑆯𑇀𑆖𑆽𑆮 𑆮𑆴𑆣𑆳𑆤𑆁 𑆠𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇙𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆁 𑆱𑆾𑆩𑆩𑆶𑆥𑆪𑆶𑆪𑆶𑆑𑇀𑆰𑆶𑆂 𑆱𑆫𑇀𑆮𑆾𑆥𑆑𑆫𑆟𑆥𑆫𑆴𑆖𑆳𑆫𑆑𑆾𑆥𑆼𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼 𑆢𑆼𑆯𑆼 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆩𑆳𑆓𑆳𑆫𑆁 𑆑𑆳𑆫𑆪𑆴𑆠𑇀𑆮𑆳 𑆲𑆸𑆠𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆨𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆼𑆰𑆶 𑆠𑆴𑆡𑆴𑆑𑆫𑆟𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆤𑆑𑇀𑆰𑆠𑇀𑆫𑆼𑆰𑆶 𑆃𑆁𑆯𑆶𑆩𑆤𑇀𑆠𑆩𑆳𑆢𑆳𑆪𑆳𑆣𑇀𑆮𑆫𑆑𑆬𑇀𑆥𑆼𑆤𑆳𑆲𑆸𑆠𑆩𑆨𑆴𑆰𑆶𑆠𑆩𑆨𑆴𑆲𑆶𑆠𑆁 𑆖𑆳𑆤𑇀𑆠𑆫𑆳𑆓𑆳𑆫𑆼 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆱𑇀𑆮𑆱𑇀𑆠𑆴𑆮𑆳𑆖𑆤𑆂 𑆱𑆾𑆩𑆑𑆤𑇀𑆢𑆁 𑆱𑆶𑆮𑆫𑇀𑆟𑆱𑆷𑆖𑇀𑆪𑆳 𑆮𑆴𑆢𑆳𑆫𑇀𑆪 𑆥𑆪𑆾 𑆓𑆸𑆲𑇀𑆟𑆵𑆪𑆳𑆠𑇀 𑆱𑆿𑆮𑆫𑇀𑆟𑆼 (𑆫𑆳𑆘𑆠𑆼 𑆮𑆳 ) 𑆥𑆳𑆠𑇀𑆫𑆼𑇁𑆚𑇀𑆘𑆬𑆴𑆩𑆳𑆠𑇀𑆫𑆁, 𑆠𑆠𑆂 𑆱𑆑𑆸𑆢𑆼𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆤𑆳𑆒𑆳𑆢𑆪𑆤𑇀, 𑆠𑆠 𑆇𑆥𑆱𑇀𑆥𑆸𑆯𑇀𑆪 𑆯𑆼𑆰𑆩𑆥𑇀𑆱𑇀𑆮𑆮𑆱𑆳𑆢𑇀𑆪 𑆪𑆩𑆤𑆴𑆪𑆩𑆳𑆨𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆱𑆁𑆪𑆾𑆘𑇀𑆪 𑆮𑆳𑆓𑇀𑆪𑆠𑆾𑇁𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆠𑆂 𑆱𑆶𑆲𑆸𑆢𑇀𑆨𑆴𑆫𑆶𑆥𑆳𑆱𑇀𑆪𑆩𑆳𑆤𑆾 𑆮𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇑𑇐𑇆
𑆫𑆱𑆳𑆪𑆤𑆁 𑆥𑆵𑆠𑆮𑆳𑆁𑆱𑇀𑆠𑆶 𑆤𑆴𑆮𑆳𑆠𑆼 𑆠𑆤𑇀𑆩𑆤𑆳𑆂 𑆯𑆶𑆖𑆴𑆂 𑇅 𑆄𑆱𑆵𑆠 𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀 𑆑𑇀𑆫𑆳𑆩𑆼𑆖𑇀𑆖 𑆤 𑆑𑆡𑆚𑇀𑆖𑆤 𑆱𑆁𑆮𑆴𑆯𑆼𑆠𑇀 𑇆𑇑𑇑𑇆
𑆱𑆳𑆪𑆁 𑆮𑆳 𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑆶𑆥𑆯𑇀𑆫𑆶𑆠𑆯𑆳𑆤𑇀𑆠𑆴𑆂 𑆑𑆶𑆯𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆘𑆴𑆤𑆾𑆠𑇀𑆠𑆫𑆳𑆪𑆳𑆁 𑆱𑆶𑆲𑆸𑆢𑇀𑆨𑆴𑆫𑆶𑆥𑆳𑆱𑇀𑆪𑆩𑆳𑆤𑆂 𑆯𑆪𑆵𑆠, 𑆠𑆸𑆰𑆴𑆠𑆾 𑆮𑆳 𑆯𑆵𑆠𑆾𑆢𑆑𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 (𑆃𑆯𑆤𑆳𑆪𑆴𑆠𑆾 𑆮𑆳 𑆑𑇀𑆰𑆳𑆫𑆁); 𑆠𑆠𑆂 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆠𑇀𑆡𑆳𑆪𑆾𑆥𑆯𑇀𑆫𑆶𑆠𑆯𑆳𑆤𑇀𑆠𑆴𑆂 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆾 𑆓𑆳𑆁 𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆠𑆡𑆽𑆮𑆳𑆱𑆵𑆠, 𑆠𑆱𑇀𑆪 𑆘𑆵𑆫𑇀𑆟𑆼 𑆱𑆾𑆩𑆼 𑆗𑆫𑇀𑆢𑆴𑆫𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆠𑆂 𑆯𑆾𑆟𑆴𑆠𑆳𑆑𑇀𑆠𑆁 𑆑𑆸𑆩𑆴𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆁 𑆗𑆫𑇀𑆢𑆴𑆠𑆮𑆠𑆼 𑆱𑆳𑆪𑆁 𑆯𑆸𑆠𑆯𑆵𑆠𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀; 𑆠𑆠𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆼𑇁𑆲𑆤𑆴 𑆑𑆸𑆩𑆴𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆩𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼, 𑆱 𑆠𑆼𑆤𑆳𑆤𑆴𑆰𑇀𑆛𑆥𑇀𑆫𑆠𑆴𑆓𑇀𑆫𑆲𑆨𑆶𑆑𑇀𑆠𑆥𑇀𑆫𑆨𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆽𑆫𑇀𑆮𑆴𑆤𑆴𑆫𑇀𑆩𑆶𑆑𑇀𑆠𑆂 𑆯𑆶𑆢𑇀𑆣𑆠𑆤𑆶𑆫𑇀𑆨𑆮𑆠𑆴, 𑆠𑆠𑆂 𑆱𑆳𑆪𑆁 𑆱𑇀𑆤𑆳𑆠𑆳𑆪 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆼𑆮 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀, 𑆑𑇀𑆰𑆿𑆩𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆱𑇀𑆠𑆸𑆠𑆳𑆪𑆳𑆁 𑆖𑆽𑆤𑆁 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆯𑆳𑆪𑆪𑆼𑆠𑇀; 𑆠𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆼𑇁𑆲𑆤𑆴 𑆠𑆱𑇀𑆪 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆶𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼, 𑆠𑆠𑆂 𑆱𑆫𑇀𑆮𑆳𑆕𑇀𑆓𑆼𑆨𑇀𑆪𑆂 𑆑𑆸𑆩𑆪𑆾 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆳𑆩𑆤𑇀𑆠𑆴, 𑆠𑆢𑆲𑆯𑇀𑆖 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆥𑆳𑆁𑆯𑆶𑆨𑆴𑆫𑆮𑆑𑆵𑆫𑇀𑆪𑆩𑆳𑆟𑆂 𑆯𑆪𑆵𑆠, 𑆠𑆠𑆂 𑆱𑆳𑆪𑆁 𑆥𑆷𑆫𑇀𑆮𑆮𑆢𑆼𑆮 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀; 𑆍𑆮𑆁 𑆥𑆚𑇀𑆖𑆩𑆰𑆰𑇀𑆜𑆪𑆾𑆫𑇀𑆢𑆴𑆮𑆱𑆪𑆾𑆫𑇀𑆮𑆫𑇀𑆠𑆼𑆠, 𑆑𑆼𑆮𑆬𑆩𑆶𑆨𑆪𑆑𑆳𑆬𑆩𑆱𑇀𑆩𑆽 𑆑𑇀𑆰𑆵𑆫𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀; 𑆠𑆠𑆂 𑆱𑆥𑇀𑆠𑆩𑆼𑇁𑆲𑆤𑆴 𑆤𑆴𑆫𑇀𑆩𑆳𑆁𑆱𑆱𑇀𑆠𑇀𑆮𑆓𑆱𑇀𑆡𑆴𑆨𑆷𑆠𑆂 𑆑𑆼𑆮𑆬𑆁 𑆱𑆾𑆩𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆳𑆢𑆼𑆮𑆾𑆖𑇀𑆗𑇀𑆮𑆱𑆴𑆠𑆴, 𑆠𑆢𑆲𑆯𑇀𑆖 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆼𑆤 𑆥𑆫𑆴𑆰𑆴𑆖𑇀𑆪 𑆠𑆴𑆬𑆩𑆣𑆶𑆑𑆖𑆤𑇀𑆢𑆤𑆳𑆤𑆶𑆬𑆴𑆥𑇀𑆠𑆢𑆼𑆲𑆁 𑆥𑆪𑆂 𑆥𑆳𑆪𑆪𑆼𑆠𑇀; 𑆠𑆠𑆾𑇁𑆰𑇀𑆛𑆩𑆼𑇁𑆲𑆤𑆴 𑆥𑇀𑆫𑆳𑆠𑆫𑆼𑆮 𑆑𑇀𑆰𑆵𑆫𑆥𑆫𑆴𑆰𑆴𑆑𑇀𑆠𑆁 𑆖𑆤𑇀𑆢𑆤𑆥𑇀𑆫𑆢𑆴𑆓𑇀𑆣𑆓𑆳𑆠𑇀𑆫𑆁 𑆥𑆪𑆂 𑆥𑆳𑆪𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆳𑆁𑆯𑆶𑆯𑆪𑇀𑆪𑆳𑆁 𑆱𑆩𑆶𑆠𑇀𑆱𑆸𑆘𑇀𑆪 𑆑𑇀𑆰𑆿𑆩𑆮𑆱𑇀𑆠𑇀𑆫𑆳𑆱𑇀𑆠𑆸𑆠𑆳𑆪𑆳𑆁 𑆯𑆪𑇀𑆪𑆳𑆪𑆳𑆁 𑆯𑆳𑆪𑆪𑆼𑆠𑇀, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆩𑆳𑆁𑆱𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑇀𑆪𑆠𑆼, 𑆠𑇀𑆮𑆑𑇀 𑆖𑆳𑆮𑆢𑆬𑆠𑆴, 𑆢𑆤𑇀𑆠𑆤𑆒𑆫𑆾𑆩𑆳𑆟𑆴 𑆖𑆳𑆱𑇀𑆪 𑆥𑆠𑆤𑇀𑆠𑆴, 𑆠𑆱𑇀𑆪 𑆤𑆮𑆩𑆢𑆴𑆮𑆱𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑇀𑆪𑆟𑆶𑆠𑆽𑆬𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆂 𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆰𑆼𑆑𑆂; 𑆠𑆠𑆾 𑆢𑆯𑆩𑆼𑇁𑆲𑆤𑇀𑆪𑆼𑆠𑆢𑆼𑆮 𑆮𑆴𑆠𑆫𑆼𑆠𑇀, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆠𑇀𑆮𑆑𑇀 𑆱𑇀𑆡𑆴𑆫𑆠𑆳𑆩𑆶𑆥𑆽𑆠𑆴; 𑆍𑆮𑆩𑆼𑆑𑆳𑆢𑆯𑆢𑇀𑆮𑆳𑆢𑆯𑆪𑆾𑆫𑇀𑆮𑆫𑇀𑆠𑆼𑆠; 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆪𑆾𑆢𑆯𑆳𑆠𑇀 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆱𑆾𑆩𑆮𑆬𑇀𑆑𑆑𑆰𑆳𑆪𑆥𑆫𑆴𑆰𑆼𑆑𑆂, 𑆍𑆮𑆩𑆳𑆰𑆾𑆝𑆯𑆳𑆢𑇀𑆮𑆫𑇀𑆠𑆼𑆠; 𑆠𑆠𑆂 𑆱𑆥𑇀𑆠𑆢𑆯𑆳𑆰𑇀𑆛𑆳𑆢𑆯𑆪𑆾𑆫𑇀𑆢𑆴𑆮𑆱𑆪𑆾𑆫𑇀𑆢𑆯𑆤𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆯𑆴𑆒𑆫𑆴𑆟𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆮𑆘𑇀𑆫𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆱𑇀𑆦𑆛𑆴𑆑𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆂 𑆱𑆩𑆳𑆂 𑆱𑇀𑆡𑆴𑆫𑆳𑆂 𑆱𑆲𑆴𑆰𑇀𑆟𑆮𑆂, 𑆠𑆢𑆳 𑆥𑇀𑆫𑆨𑆸𑆠𑆴 𑆖𑆳𑆤𑆮𑆽𑆂 𑆯𑆳𑆬𑆴𑆠𑆟𑇀𑆝𑆶𑆬𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆪𑆮𑆳𑆓𑆷𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠 𑆪𑆳𑆮𑆠𑇀 𑆥𑆚𑇀𑆖𑆫𑇀𑆮𑆴𑆯𑆠𑆴𑆫𑆴𑆠𑆴; 𑆠𑆠𑆾𑇁𑆱𑇀𑆩𑆽 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆳𑆬𑇀𑆪𑆾𑆢𑆤𑆁 𑆩𑆸𑆢𑆷𑆨𑆪𑆑𑆳𑆬𑆁 𑆥𑆪𑆱𑆳, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆤𑆒𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆮𑆴𑆢𑇀𑆫𑆶𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆓𑆾𑆥𑆑𑆠𑆫𑆶𑆟𑆳𑆢𑆴𑆠𑇀𑆪𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆂, 𑆱𑇀𑆡𑆴𑆫𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳 𑆬𑆑𑇀𑆰𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆳𑆂 𑆑𑆼𑆯𑆳𑆯𑇀𑆖 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼, 𑆠𑇀𑆮𑆑𑇀 𑆖 𑆤𑆵𑆬𑆾𑆠𑇀𑆥𑆬𑆳𑆠𑆱𑆵𑆥𑆶𑆰𑇀𑆥𑆮𑆽𑆢𑆷𑆫𑇀𑆪𑆥𑇀𑆫𑆑𑆳𑆯𑆳; 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆖 𑆩𑆳𑆱𑆳𑆠𑇀 𑆑𑆼𑆯𑆳𑆤𑇀 𑆮𑆳𑆥𑆪𑆼𑆠𑇀, 𑆮𑆳𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆖𑆾𑆯𑆵𑆫𑆖𑆤𑇀𑆢𑆤𑆑𑆸𑆰𑇀𑆟𑆠𑆴𑆬𑆑𑆬𑇀𑆑𑆽𑆂 𑆯𑆴𑆫𑆂 𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆥𑆪𑆱𑆳 𑆮𑆳 𑆱𑇀𑆤𑆳𑆥𑆪𑆼𑆠𑇀; 𑆠𑆠𑆾𑇁𑆱𑇀𑆪𑆳𑆤𑆤𑇀𑆠𑆫𑆁 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀 𑆑𑆼𑆯𑆳 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆨𑇀𑆫𑆩𑆫𑆳𑆚𑇀𑆘𑆤𑆤𑆴𑆨𑆳𑆂 𑆑𑆶𑆚𑇀𑆖𑆴𑆠𑆳𑆂 𑆱𑇀𑆡𑆴𑆫𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆂; 𑆠𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀 𑆥𑇀𑆫𑆡𑆩𑆳𑆮𑆱𑆡𑆥𑆫𑆴𑆱𑆫𑆳𑆤𑇀𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆩𑇀𑆪 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆁 𑆱𑇀𑆡𑆴𑆠𑇀𑆮𑆳 𑆥𑆶𑆤𑆫𑆼𑆮𑆳𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆼𑆠𑇀, 𑆠𑆠𑆾𑇁𑆱𑇀𑆪 𑆧𑆬𑆳𑆠𑆽𑆬𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆫𑇀𑆡𑆼𑇁𑆮𑆖𑆳𑆫𑇀𑆪𑆁, 𑆪𑆮𑆥𑆴𑆰𑇀𑆛𑆩𑆶𑆢𑇀𑆮𑆫𑇀𑆠𑆤𑆳𑆫𑇀𑆡𑆼, 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆖 𑆥𑆪𑆂 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆫𑇀𑆡𑆼, 𑆃𑆘𑆑𑆫𑇀𑆟𑆑𑆰𑆳𑆪𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆫𑇀𑆡𑆼, 𑆱𑆾𑆯𑆵𑆫𑆁 𑆑𑆷𑆥𑆾𑆢𑆑𑆁 𑆱𑇀𑆤𑆳𑆤𑆳𑆫𑇀𑆡𑆼, 𑆖𑆤𑇀𑆢𑆤𑆩𑆤𑆶𑆬𑆼𑆥𑆳𑆫𑇀𑆡𑆼, 𑆄𑆩𑆬𑆑𑆫𑆱𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆪𑆷𑆰𑆱𑆷𑆥𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆂, 𑆑𑇀𑆰𑆵𑆫𑆩𑆣𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆖 𑆑𑆸𑆰𑇀𑆟𑆠𑆴𑆬𑆩𑆮𑆖𑆳𑆫𑆟𑆳𑆫𑇀𑆡𑆼, 𑆍𑆮𑆁 𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁; 𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆢𑇀𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆥𑆫𑆴𑆱𑆫𑆼 𑆮𑆫𑇀𑆠𑆼𑆠; 𑆠𑆠𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆼 𑆥𑆫𑆴𑆱𑆫𑆼 𑆱𑇀𑆡𑆴𑆫𑆵𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆤𑇀𑆪𑆢𑇀𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆩𑆳𑆱𑆵𑆠, 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆳𑆠𑆥𑆥𑆮𑆤𑆳𑆤𑇀 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆥𑆶𑆤𑆯𑇀𑆖𑆳𑆤𑇀𑆠𑆂 𑆥𑇀𑆫𑆮𑆴𑆯𑆼𑆠𑇀, 𑆤 𑆖𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆢𑆫𑇀𑆯𑆼𑇁𑆥𑇀𑆱𑆶 𑆮𑆳 𑆤𑆴𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆫𑆷𑆥𑆯𑆳𑆬𑆴𑆠𑇀𑆮𑆳𑆠𑇀; 𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆢𑇀𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆁 𑆑𑇀𑆫𑆾𑆣𑆳𑆢𑆵𑆤𑇀 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 , 𑆍𑆮𑆁 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆶𑆥𑆪𑆾𑆓𑆮𑆴𑆑𑆬𑇀𑆥𑆂 𑇅 𑆮𑆴𑆯𑆼𑆰𑆠𑆱𑇀𑆠𑆶 𑆮𑆬𑇀𑆬𑆵𑆥𑇀𑆫𑆠𑆳𑆤𑆑𑇀𑆰𑆶𑆥𑆑𑆳𑆢𑆪𑆂 𑆱𑆾𑆩𑆳 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆑𑇀𑆰𑆠𑇀𑆫𑆴𑆪𑆮𑆽𑆯𑇀𑆪𑆽𑆫𑇀𑆨𑆑𑇀𑆰𑆪𑆴𑆠𑆮𑇀𑆪𑆳𑆂 𑇅 𑆠𑆼𑆰𑆳𑆁 𑆠𑆶 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆫𑇀𑆣𑆖𑆠𑆶𑆰𑇀𑆑𑆩𑆶𑆰𑇀𑆛𑆪𑆂 𑇆𑇑𑇒𑇆
𑆃𑆁𑆯𑆶𑆩𑆤𑇀𑆠𑆁 𑆱𑆿𑆮𑆫𑇀𑆟𑆼 𑆥𑆳𑆠𑇀𑆫𑆼𑇁𑆨𑆴𑆰𑆶𑆟𑆶𑆪𑆳𑆠𑇀, 𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆱𑆁 𑆫𑆳𑆘𑆠𑆼; 𑆠𑆳𑆮𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆳𑆰𑇀𑆛𑆓𑆶𑆟𑆩𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆩𑆮𑆳𑆥𑇀𑆪𑆼𑆯𑆳𑆤𑆁 𑆢𑆼𑆮𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑆠𑆴, 𑆯𑆼𑆰𑆳𑆁𑆱𑇀𑆠𑆶 𑆠𑆳𑆩𑇀𑆫𑆩𑆪𑆼 𑆩𑆸𑆤𑇀𑆩𑆪𑆼 𑆮𑆳 𑆫𑆾𑆲𑆴𑆠𑆼 𑆮𑆳 𑆖𑆫𑇀𑆩𑆟𑆴 𑆮𑆴𑆠𑆠𑆼; 𑆯𑆷𑆢𑇀𑆫𑆮𑆫𑇀𑆘𑆁 𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆮𑆫𑇀𑆟𑆽𑆂 𑆱𑆾𑆩𑆳 𑆇𑆥𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳𑆂 𑇅 𑆠𑆠𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆡𑆼 𑆩𑆳𑆱𑆼 𑆥𑆿𑆫𑇀𑆟𑆩𑆳𑆱𑇀𑆪𑆳𑆁 𑆯𑆶𑆖𑆿 𑆢𑆼𑆯𑆼 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆤𑆫𑇀𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆑𑆸𑆠𑆩𑆕𑇀𑆓𑆬𑆾 𑆤𑆴𑆰𑇀𑆑𑇀𑆫𑆩𑇀𑆪 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆮𑇀𑆫𑆘𑆼𑆢𑆴𑆠𑆴 𑇆𑇑𑇓𑇆
𑆏𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑆠𑆴𑆁 𑆱𑆾𑆩𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪 𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂 𑇅 𑆢𑆯𑆮𑆫𑇀𑆰𑆱𑆲𑆱𑇀𑆫𑆳𑆟𑆴 𑆤𑆮𑆳𑆁 𑆣𑆳𑆫𑆪𑆠𑆼 𑆠𑆤𑆶𑆩𑇀 𑇆𑇑𑇔𑇆
𑆤𑆳𑆓𑇀𑆤𑆴𑆫𑇀𑆤 𑆠𑆾𑆪𑆁 𑆤 𑆮𑆴𑆰𑆁 𑆤 𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆤𑆳𑆱𑇀𑆠𑇀𑆫𑆩𑆼𑆮 𑆖 𑇅 𑆠𑆱𑇀𑆪𑆳𑆬𑆩𑆳𑆪𑆶𑆂𑆑𑇀𑆰𑆥𑆟𑆼 𑆱𑆩𑆫𑇀𑆡𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇑𑇕𑇆
𑆨𑆢𑇀𑆫𑆳𑆟𑆳𑆁 𑆰𑆰𑇀𑆛𑆴𑆮𑆫𑇀𑆰𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆳𑆤𑆳𑆩𑆤𑆼𑆑𑆣𑆳 𑇅 𑆑𑆶𑆚𑇀𑆘𑆫𑆳𑆟𑆳𑆁 𑆱𑆲𑆱𑇀𑆫𑆱𑇀𑆪 𑆧𑆬𑆁 𑆱𑆩𑆣𑆴𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇑𑇖𑇆
𑆑𑇀𑆰𑆵𑆫𑆾𑆢𑆁 𑆯𑆑𑇀𑆫𑆱𑆢𑆤𑆩𑆶𑆠𑇀𑆠𑆫𑆳𑆁𑆯𑇀𑆖 𑆑𑆶𑆫𑆷𑆤𑆥𑆴 𑇅 𑆪𑆠𑇀𑆫𑆼𑆖𑇀𑆗𑆠𑆴 𑆱 𑆓𑆤𑇀𑆠𑆶𑆁 𑆮𑆳 𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆳 𑆓𑆠𑆴𑆂 𑇆𑇑𑇗𑇆
𑆑𑆤𑇀𑆢𑆫𑇀𑆥 𑆅𑆮 𑆫𑆷𑆥𑆼𑆟 𑆑𑆳𑆤𑇀𑆠𑇀𑆪𑆳 𑆖𑆤𑇀𑆢𑇀𑆫 𑆅𑆮𑆳𑆥𑆫𑆂 𑇅 𑆥𑇀𑆫𑆲𑇀𑆬𑆳𑆢𑆪𑆠𑆴 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆩𑆤𑆳𑆁𑆱𑆴 𑆱 𑆩𑆲𑆳𑆢𑇀𑆪𑆶𑆠𑆴𑆂 𑇆𑇑𑇘𑇆
𑆱𑆳𑆕𑇀𑆓𑆾𑆥𑆳𑆕𑇀𑆓𑆳𑆁𑆯𑇀𑆖 𑆤𑆴𑆒𑆴𑆬𑆳𑆤𑇀 𑆮𑆼𑆢𑆳𑆤𑇀 𑆮𑆴𑆤𑇀𑆢𑆠𑆴 𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆂 𑇅 𑆖𑆫𑆠𑇀𑆪𑆩𑆾𑆔𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆾 𑆢𑆼𑆮𑆮𑆖𑇀𑆖𑆳𑆒𑆴𑆬𑆁 𑆘𑆓𑆠𑇀 𑇆𑇑𑇙𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆱𑆾𑆩𑆳𑆤𑆳𑆁 𑆥𑆠𑇀𑆫𑆳𑆟𑆴 𑆢𑆯 𑆥𑆚𑇀𑆖 𑆖 𑇅 𑆠𑆳𑆤𑆴 𑆯𑆶𑆑𑇀𑆬𑆼 𑆖 𑆑𑆸𑆰𑇀𑆟𑆼 𑆖 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆤𑆴𑆥𑆠𑆤𑇀𑆠𑆴 𑆖 𑇆𑇒𑇐𑇆
𑆍𑆑𑆽𑆑𑆁 𑆘𑆳𑆪𑆠𑆼 𑆥𑆠𑇀𑆫𑆁 𑆱𑆾𑆩𑆱𑇀𑆪𑆳𑆲𑆫𑆲𑆱𑇀𑆠𑆢𑆳 𑇅 𑆯𑆶𑆑𑇀𑆬𑆱𑇀𑆪 𑆥𑆿𑆫𑇀𑆟𑆩𑆳𑆱𑇀𑆪𑆳𑆁 𑆠𑆶 𑆨𑆮𑆼𑆠𑇀 𑆥𑆚𑇀𑆖𑆢𑆯𑆖𑇀𑆗𑆢𑆂 𑇆𑇒𑇑𑇆
𑆯𑆵𑆫𑇀𑆪𑆠𑆼 𑆥𑆠𑇀𑆫𑆩𑆼𑆑𑆽𑆑𑆁 𑆢𑆴𑆮𑆱𑆼 𑆢𑆴𑆮𑆱𑆼 𑆥𑆶𑆤𑆂 𑇅 𑆑𑆸𑆰𑇀𑆟𑆥𑆑𑇀𑆰𑆑𑇀𑆰𑆪𑆼 𑆖𑆳𑆥𑆴 𑆬𑆠𑆳 𑆨𑆮𑆠𑆴 𑆑𑆼𑆮𑆬𑆳 𑇆𑇒𑇒𑇆
𑆃𑆁𑆯𑆶𑆩𑆳𑆤𑆳𑆘𑇀𑆪𑆓𑆤𑇀𑆣𑆱𑇀𑆠𑆶 𑆑𑆤𑇀𑆢𑆮𑆳𑆤𑇀 𑆫𑆘𑆠𑆥𑇀𑆫𑆨𑆂 𑇅 𑆑𑆢𑆬𑇀𑆪𑆳𑆑𑆳𑆫𑆑𑆤𑇀𑆢𑆱𑇀𑆠𑆶 𑆩𑆶𑆚𑇀𑆘𑆮𑆳𑆁𑆬𑇀𑆬𑆯𑆶𑆤𑆖𑇀𑆗𑆢𑆂 𑇆𑇒𑇓𑇆
𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆳𑆂 𑆑𑆤𑆑𑆳𑆨𑆳𑆱𑆾 𑆘𑆬𑆼 𑆖𑆫𑆠𑆴 𑆱𑆫𑇀𑆮𑆢𑆳 𑇅 𑆓𑆫𑆶𑆝𑆳𑆲𑆸𑆠𑆤𑆳𑆩𑆳 𑆖 𑆯𑇀𑆮𑆼𑆠𑆳𑆑𑇀𑆰𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆿 𑇆𑇒𑇔𑇆
𑆱𑆫𑇀𑆥𑆤𑆴𑆫𑇀𑆩𑆾𑆑𑆱𑆢𑆸𑆯𑆿 𑆠𑆿 𑆮𑆸𑆑𑇀𑆰𑆳𑆓𑇀𑆫𑆳𑆮𑆬𑆩𑇀𑆧𑆴𑆤𑆿 𑇅 𑆠𑆡𑆳𑇁𑆤𑇀𑆪𑆼 𑆩𑆟𑇀𑆝𑆬𑆽𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆽𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆴𑆠𑆳 𑆅𑆮 𑆨𑆳𑆤𑇀𑆠𑆴 𑆠𑆼 𑇆𑇒𑇕𑇆
𑆱𑆫𑇀𑆮 𑆍𑆮 𑆠𑆶 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑆂 𑆱𑆾𑆩𑆳𑆂 𑆥𑆚𑇀𑆖𑆢𑆯𑆖𑇀𑆗𑆢𑆳𑆂 𑇅 𑆑𑇀𑆰𑆵𑆫𑆑𑆤𑇀𑆢𑆬𑆠𑆳𑆮𑆤𑇀𑆠𑆂 𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆽𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑇆𑇒𑇖𑇆
𑆲𑆴𑆩𑆮𑆠𑇀𑆪𑆫𑇀𑆧𑆶𑆢𑆼 𑆱𑆲𑇀𑆪𑆼 𑆩𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆼 𑆩𑆬𑆪𑆼 𑆠𑆡𑆳 𑇅 𑆯𑇀𑆫𑆵𑆥𑆫𑇀𑆮𑆠𑆼 𑆢𑆼𑆮𑆓𑆴𑆫𑆿 𑆓𑆴𑆫𑆿 𑆢𑆼𑆮𑆱𑆲𑆼 𑆠𑆡𑆳 𑇆𑇒𑇗𑇆
𑆥𑆳𑆫𑆴𑆪𑆳𑆠𑇀𑆫𑆼 𑆖 𑆮𑆴𑆤𑇀𑆣𑇀𑆪𑆼 𑆖 𑆢𑆼𑆮𑆱𑆶𑆤𑇀𑆢𑆼 𑆲𑆢𑆼 𑆠𑆡𑆳 𑇅 𑆇𑆠𑇀𑆠𑆫𑆼𑆟 𑆮𑆴𑆠𑆱𑇀𑆠𑆳𑆪𑆳𑆂 𑆥𑇀𑆫𑆮𑆸𑆢𑇀𑆣𑆳 𑆪𑆼 𑆩𑆲𑆵𑆣𑆫𑆳𑆂 𑇆𑇒𑇘𑇆
𑆥𑆚𑇀𑆖 𑆠𑆼𑆰𑆳𑆩𑆣𑆾 𑆩𑆣𑇀𑆪𑆼 𑆱𑆴𑆤𑇀𑆣𑆶𑆤𑆳𑆩𑆳 𑆩𑆲𑆳𑆤𑆢𑆂 𑇅 𑆲𑆜𑆮𑆠𑇀 𑆥𑇀𑆬𑆮𑆠𑆼 𑆠𑆠𑇀𑆫 𑆖𑆤𑇀𑆢𑇀𑆫𑆩𑆳𑆂 𑆱𑆾𑆩𑆱𑆠𑇀𑆠𑆩𑆂 𑇆𑇒𑇙𑇆
𑆠𑆱𑇀𑆪𑆾𑆢𑇀𑆢𑆼𑆯𑆼𑆰𑆶 𑆖𑆳𑆥𑇀𑆪𑆱𑇀𑆠𑆴 𑆩𑆶𑆚𑇀𑆘𑆮𑆳𑆤𑆁𑆯𑆶𑆩𑆳𑆤𑆥𑆴 𑇅 𑆑𑆳𑆯𑇀𑆩𑆵𑆫𑆼𑆰𑆶 𑆱𑆫𑆾 𑆢𑆴𑆮𑇀𑆪𑆁 𑆤𑆳𑆩𑇀𑆤𑆳 𑆑𑇀𑆰𑆶𑆢𑇀𑆫𑆑𑆩𑆳𑆤𑆱𑆩𑇀 𑇆𑇓𑇐𑇆
𑆓𑆳𑆪𑆠𑇀𑆫𑆱𑇀𑆠𑇀𑆫𑆽𑆰𑇀𑆛𑆶𑆨𑆂 𑆥𑆳𑆕𑇀𑆑𑇀𑆠𑆾 𑆘𑆳𑆓𑆠𑆂 𑆯𑆳𑆑𑇀𑆮𑆫𑆱𑇀𑆠𑆡𑆳 𑇅 𑆃𑆠𑇀𑆫 𑆱𑆤𑇀𑆠𑇀𑆪𑆥𑆫𑆼 𑆖𑆳𑆥𑆴 𑆱𑆾𑆩𑆳𑆂 𑆱𑆾𑆩𑆱𑆩𑆥𑇀𑆫𑆨𑆳𑆂 𑇆𑇓𑇑𑇆
𑆪𑆽𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆩𑆤𑇀𑆢𑆨𑆳𑆓𑇀𑆪𑆽𑆱𑇀𑆠𑆼 𑆨𑆴𑆰𑆘𑆯𑇀𑆖𑆳𑆥𑆩𑆳𑆤𑆴𑆠𑆳𑆂 𑇅 𑆤 𑆠𑆳𑆤𑇀 𑆥𑆯𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆣𑆫𑇀𑆩𑆴𑆰𑇀𑆜𑆳𑆂 𑆑𑆸𑆠𑆔𑇀𑆤𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆩𑆳𑆤𑆮𑆳𑆂 𑇅 𑆨𑆼𑆰𑆘𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆯𑇀𑆖𑆳𑆥𑆴 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆢𑇀𑆮𑆼𑆰𑆴𑆟𑆱𑇀𑆠𑆡𑆳 𑇆𑇓𑇒𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆱𑆤𑇀𑆠𑆳𑆥𑆵𑆪𑆁 𑆫𑆱𑆳𑆪𑆤𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆪𑆡𑆳 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆱𑆤𑇀𑆠𑆳𑆥𑆳 𑆩𑆾𑆢𑆤𑇀𑆠𑆼 𑆢𑆴𑆮𑆴 𑆢𑆼𑆮𑆠𑆳𑆂 𑇅 𑆠𑆡𑆿𑆰𑆣𑆵𑆫𑆴𑆩𑆳𑆂 𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆩𑆾𑆢𑆤𑇀𑆠𑆼 𑆨𑆶𑆮𑆴 𑆩𑆳𑆤𑆮𑆳𑆂 𑇆𑇓𑇆
𑆃𑆡 𑆒𑆬𑆶 𑆱𑆥𑇀𑆠 𑆥𑆶𑆫𑆶𑆰𑆳 𑆫𑆱𑆳𑆪𑆤𑆁 𑆤𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆫𑆤𑇀; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆤𑆳𑆠𑇀𑆩𑆮𑆳𑆤𑆬𑆱𑆾 𑆢𑆫𑆴𑆢𑇀𑆫𑆂 𑆥𑇀𑆫𑆩𑆳𑆢𑆵 𑆮𑇀𑆪𑆱𑆤𑆵 𑆥𑆳𑆥𑆑𑆸𑆢𑇀 𑆨𑆼𑆰𑆘𑆳𑆥𑆩𑆳𑆤𑆵 𑆖𑆼𑆠𑆴 𑇅 𑆱𑆥𑇀𑆠𑆨𑆴𑆫𑆼𑆮 𑆑𑆳𑆫𑆟𑆽𑆫𑇀𑆤 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆃𑆘𑇀𑆚𑆳𑆤𑆳𑆢𑆤𑆳𑆫𑆩𑇀𑆨𑆳𑆢𑆱𑇀𑆡𑆴𑆫𑆖𑆴𑆠𑇀𑆠𑆠𑇀𑆮𑆳𑆢𑇀𑆢𑆳𑆫𑆴𑆢𑇀𑆫𑇀𑆪𑆳𑆢𑆤𑆳𑆪𑆠𑇀𑆠𑆠𑇀𑆮𑆳𑆢𑆣𑆫𑇀𑆩𑆳𑆢𑆿𑆰𑆣𑆳𑆬𑆳𑆨𑆳𑆖𑇀𑆖𑆼𑆠𑆴 𑇆𑇔𑇆
𑆃𑆡𑆿𑆰𑆣𑆵𑆫𑇀𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆠𑆠𑇀𑆫𑆳𑆘𑆓𑆫𑆵, 𑆯𑇀𑆮𑆼𑆠𑆑𑆳𑆥𑆾𑆠𑆵, 𑆑𑆸𑆰𑇀𑆟𑆑𑆳𑆥𑆾𑆠𑆵, 𑆓𑆾𑆤𑆱𑆵, 𑆮𑆳𑆫𑆳𑆲𑆵, 𑆑𑆤𑇀𑆪𑆳, 𑆗𑆠𑇀𑆫𑆳, 𑆃𑆠𑆴𑆖𑇀𑆗𑆠𑇀𑆫𑆳, 𑆑𑆫𑆼𑆟𑆶𑆂, 𑆃𑆘𑆳, 𑆖𑆑𑇀𑆫𑆑𑆳, 𑆄𑆢𑆴𑆠𑇀𑆪𑆥𑆫𑇀𑆟𑆵, 𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳, 𑆯𑇀𑆫𑆳𑆮𑆟𑆵, 𑆩𑆲𑆳𑆯𑇀𑆫𑆳𑆮𑆟𑆵, 𑆓𑆾𑆬𑆾𑆩𑆵, 𑆃𑆘𑆬𑆾𑆩𑆵, 𑆩𑆲𑆳𑆮𑆼𑆓𑆮𑆠𑆵, 𑆖𑆼𑆠𑇀𑆪𑆰𑇀𑆛𑆳𑆢𑆯 𑆱𑆾𑆩𑆱𑆩𑆮𑆵𑆫𑇀𑆪𑆳 𑆩𑆲𑆿𑆰𑆣𑆪𑆾 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂 𑇅 𑆠𑆳𑆱𑆳𑆁 𑆱𑆾𑆩𑆮𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆯𑆵𑆂𑆱𑇀𑆠𑆶𑆠𑆪𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆼𑇁𑆨𑆴𑆲𑆴𑆠𑆳𑆂 𑇅 𑆠𑆳𑆱𑆳𑆩𑆳𑆓𑆳𑆫𑆼𑇁𑆨𑆴𑆲𑆶𑆠𑆳𑆤𑆳𑆁 𑆪𑆳𑆂 𑆑𑇀𑆰𑆵𑆫𑆮𑆠𑇀𑆪𑆱𑇀𑆠𑆳𑆱𑆳𑆁 𑆑𑇀𑆰𑆵𑆫𑆑𑆶𑆝𑆮𑆁 𑆱𑆑𑆸𑆢𑆼𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 , 𑆪𑆳𑆱𑇀𑆠𑇀𑆮𑆑𑇀𑆰𑆵𑆫𑆳 𑆩𑆷𑆬𑆮𑆠𑇀𑆪𑆱𑇀𑆠𑆳𑆱𑆳𑆁 𑆥𑇀𑆫𑆢𑆼𑆯𑆴𑆤𑆵𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆤𑆴 𑆠𑇀𑆫𑆵𑆟𑆴 𑆑𑆳𑆟𑇀𑆝𑆳𑆤𑆴 𑆥𑇀𑆫𑆩𑆳𑆟𑆩𑆶𑆥𑆪𑆾𑆓𑆼, 𑆯𑇀𑆮𑆼𑆠𑆑𑆳𑆥𑆾𑆠𑆵 𑆱𑆩𑆷𑆬𑆥𑆠𑇀𑆫𑆳 𑆨𑆑𑇀𑆰𑆪𑆴𑆠𑆮𑇀𑆪𑆳, 𑆓𑆾𑆤𑆱𑇀𑆪𑆘𑆓𑆫𑆵𑆑𑆸𑆰𑇀𑆟𑆑𑆳𑆥𑆾𑆠𑆵𑆤𑆳𑆁 𑆱𑆤𑆒𑆩𑆶𑆰𑇀𑆛𑆴𑆁 𑆒𑆟𑇀𑆝𑆯𑆂 𑆑𑆬𑇀𑆥𑆪𑆴𑆠𑇀𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪𑆳𑆨𑆴𑆔𑆳𑆫𑆴𑆠𑆩𑆨𑆴𑆲𑆶𑆠𑆁 𑆖 𑆱𑆑𑆸𑆢𑆼𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆖𑆑𑇀𑆫𑆑𑆳𑆪𑆳𑆂 𑆥𑆪𑆂 𑆱𑆑𑆸𑆢𑆼𑆮, 𑆧𑇀𑆫𑆲𑇀𑆩𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳 𑆱𑆥𑇀𑆠𑆫𑆳𑆠𑇀𑆫𑆩𑆶𑆥𑆪𑆾𑆑𑇀𑆠𑆮𑇀𑆪𑆳 𑆨𑆑𑇀𑆰𑇀𑆪𑆑𑆬𑇀𑆥𑆼𑆤, 𑆯𑆼𑆰𑆳𑆟𑆳𑆁 𑆥𑆚𑇀𑆖 𑆥𑆚𑇀𑆖 𑆥𑆬𑆳𑆤𑆴 𑆑𑇀𑆰𑆵𑆫𑆳𑆞𑆑𑆑𑇀𑆮𑆡𑆴𑆠𑆳𑆤𑆴 𑆥𑇀𑆫𑆱𑇀𑆡𑆼𑇁𑆮𑆯𑆴𑆰𑇀𑆛𑆼𑇁𑆮𑆠𑆳𑆫𑇀𑆪 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑇀𑆪 𑆱𑆑𑆸𑆢𑆼𑆮𑆾𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑇅 𑆱𑆾𑆩𑆮𑆢𑆳𑆲𑆳𑆫𑆮𑆴𑆲𑆳𑆫𑆿 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆿, 𑆑𑆼𑆮𑆬𑆁 𑆤𑆮𑆤𑆵𑆠𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆫𑇀𑆡𑆼, 𑆯𑆼𑆰𑆁 𑆱𑆾𑆩𑆮𑆢𑆳𑆤𑆴𑆫𑇀𑆓𑆩𑆳𑆢𑆴𑆠𑆴 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆶𑆮𑆳𑆤𑆁 𑆱𑆴𑆁𑆲𑆮𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆁 𑆑𑆳𑆤𑇀𑆠𑆁 𑆯𑇀𑆫𑆶𑆠𑆤𑆴𑆓𑆳𑆢𑆴𑆤𑆩𑇀 𑇅 𑆑𑆶𑆫𑇀𑆪𑆶𑆫𑆼𑆠𑆳𑆂 𑆑𑇀𑆫𑆩𑆼𑆟𑆽𑆮 𑆢𑇀𑆮𑆴𑆱𑆲𑆱𑇀𑆫𑆳𑆪𑆶𑆰𑆁 𑆤𑆫𑆩𑇀 𑇆𑇖𑇆
𑆃𑆕𑇀𑆓𑆢𑆵 𑆑𑆶𑆟𑇀𑆝𑆬𑆵 𑆩𑆿𑆬𑆵 𑆢𑆴𑆮𑇀𑆪𑆱𑇀𑆫𑆑𑇀𑆖𑆤𑇀𑆢𑆤𑆳𑆩𑇀𑆧𑆫𑆂 𑇅 𑆖𑆫𑆠𑇀𑆪𑆩𑆾𑆔𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆾 𑆤𑆨𑆱𑇀𑆪𑆩𑇀𑆧𑆶𑆢𑆢𑆶𑆫𑇀𑆓𑆩𑆼 𑇆𑇗𑇆
𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑆴 𑆥𑆑𑇀𑆰𑆴𑆟𑆾 𑆪𑆼𑆤 𑆘𑆬𑆬𑆩𑇀𑆧𑆳𑆯𑇀𑆖 𑆠𑆾𑆪𑆢𑆳𑆂 𑇅 𑆓𑆠𑆴𑆂 𑆱𑆿𑆰𑆣𑆴𑆱𑆴𑆢𑇀𑆣𑆱𑇀𑆪 𑆱𑆾𑆩𑆱𑆴𑆢𑇀𑆣𑆼 𑆓𑆠𑆴𑆂 𑆥𑆫𑆳 𑇆𑇘𑇆
𑆃𑆡 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆿𑆰𑆣𑆵𑆤𑆳𑆁 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀 𑇅 𑆩𑆟𑇀𑆝𑆬𑆽𑆂 𑆑𑆥𑆴𑆬𑆽𑆯𑇀𑆖𑆴𑆠𑇀𑆫𑆽𑆂 𑆱𑆫𑇀𑆥𑆳𑆨𑆳 𑆥𑆚𑇀𑆖𑆥𑆫𑇀𑆟𑆴𑆤𑆵 𑇆𑇙𑇆
𑆥𑆚𑇀𑆖𑆳𑆫𑆠𑇀𑆤𑆴𑆥𑇀𑆫𑆩𑆳𑆟𑆳 𑆖 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳𑇁𑆘𑆓𑆫𑆵 𑆧𑆶𑆣𑆽𑆂 𑇅 𑆤𑆴𑆰𑇀𑆥𑆠𑇀𑆫𑆳 𑆑𑆤𑆑𑆳𑆨𑆳𑆱𑆳 𑆩𑆷𑆬𑆼 𑆢𑇀𑆮𑇀𑆪𑆕𑇀𑆓𑆶𑆬𑆱𑆩𑇀𑆩𑆴𑆠𑆳 𑇆𑇑𑇐𑇆

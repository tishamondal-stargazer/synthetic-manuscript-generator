𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆖𑇀𑆖 𑆮𑆴𑆲𑆳𑆫𑆳𑆖𑇀𑆖 𑆮𑆴𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆖𑆼𑆠𑆱𑆂𑇅 𑆤 𑆑𑇀𑆬𑆼𑆢𑆩𑆶𑆥𑆓𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆢𑆴𑆮𑆳 𑆠𑆼𑆤𑆳𑆱𑇀𑆪 𑆣𑆳𑆠𑆮𑆂𑇆𑇒𑇓𑇙𑇆
𑆃𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆼𑆰𑇀𑆮𑆤𑇀𑆤𑆩𑆳𑆱𑆴𑆑𑇀𑆠𑆩𑆤𑇀𑆪𑆠𑇀𑆠𑆼𑆰𑆶 𑆤 𑆢𑆶𑆰𑇀𑆪𑆠𑆴𑇅 𑆃𑆮𑆴𑆢𑆓𑇀𑆣 𑆅𑆮 𑆑𑇀𑆰𑆵𑆫𑆼 𑆑𑇀𑆰𑆵𑆫𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆴𑆩𑆴𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇆𑇒𑇔𑇐𑇆
𑆤𑆽𑆮 𑆢𑆷𑆰𑇀𑆪𑆠𑆴 𑆠𑆼𑆤𑆽𑆮 𑆱𑆩𑆁 𑆱𑆩𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆪𑆡𑆳𑇅 𑆫𑆳𑆠𑇀𑆫𑆿 𑆠𑆶 𑆲𑆸𑆢𑆪𑆼 𑆩𑇀𑆬𑆳𑆤𑆼 𑆱𑆁𑆮𑆸𑆠𑆼𑆰𑇀𑆮𑆪𑆤𑆼𑆰𑆶 𑆖𑇅 𑆪𑆳𑆤𑇀𑆠𑆴 𑆑𑆾𑆰𑇀𑆜𑆼 𑆥𑆫𑆴𑆑𑇀𑆬𑆼𑆢𑆁 𑆱𑆁𑆮𑆸𑆠𑆼 𑆢𑆼𑆲𑆣𑆳𑆠𑆮𑆂𑇆𑇒𑇔𑇑𑇆
𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆢𑆥𑆑𑇀𑆮𑆼𑆰𑆶 𑆠𑆼𑆰𑇀𑆮𑆳𑆱𑆴𑆑𑇀𑆠𑆁 𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆪𑆠𑆴𑇅 𑆮𑆴𑆢𑆓𑇀𑆣𑆼𑆰𑆶 𑆥𑆪𑆂𑆱𑇀𑆮𑆤𑇀𑆪𑆠𑇀 𑆥𑆪𑆱𑇀𑆠𑆥𑇀𑆠𑆩𑆴𑆮𑆳𑆫𑇀𑆥𑆴𑆠𑆩𑇀𑇆𑇒𑇔𑇒𑇆
𑆤𑆽𑆯𑆼𑆰𑇀𑆮𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆼𑆰𑆶 𑆤𑆳𑆮𑆴𑆥𑆑𑇀𑆮𑆼𑆰𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆱𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀𑆥𑆳𑆬𑆪𑆴𑆰𑇀𑆪𑆤𑇀𑆧𑆬𑆳𑆪𑆶𑆰𑆵𑇆𑇒𑇔𑇓𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆃𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆓𑆶𑆟𑆳 𑆢𑆼𑆲𑆁 𑆪𑆡𑆳 𑆣𑆳𑆫𑆪𑆠𑆼 𑆖 𑆱𑆂𑇅 𑆪𑆡𑆳𑇁𑆤𑇀𑆤𑆁 𑆥𑆖𑇀𑆪𑆠𑆼 𑆪𑆳𑆁𑆯𑇀𑆖 𑆪𑆡𑆳𑇁𑇁𑆲𑆳𑆫𑆂 𑆑𑆫𑆾𑆠𑇀𑆪𑆥𑆴𑇆𑇒𑇔𑇔𑇆
𑆪𑆼𑇁𑆓𑇀𑆤𑆪𑆾 𑆪𑆳𑆁𑆯𑇀𑆖 𑆥𑆶𑆰𑇀𑆪𑆤𑇀𑆠𑆴 𑆪𑆳𑆮𑆤𑇀𑆠𑆾 𑆪𑆼 𑆥𑆖𑆤𑇀𑆠𑆴 𑆪𑆳𑆤𑇀𑇅 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆑𑇀𑆫𑆩𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑇀𑆩𑆬𑆳𑆤𑆳𑆁 𑆠𑆼𑆨𑇀𑆪 𑆍𑆮 𑆖𑇆𑇒𑇔𑇕𑇆
𑆮𑆸𑆰𑇀𑆪𑆳𑆟𑆳𑆩𑆳𑆯𑆶𑆑𑆸𑆢𑇀𑆣𑆼𑆠𑆶𑆫𑇀𑆣𑆳𑆠𑆶𑆑𑆳𑆬𑆾𑆢𑇀𑆨𑆮𑆑𑇀𑆫𑆩𑆂𑇅 𑆫𑆾𑆓𑆽𑆑𑆢𑆼𑆯𑆑𑆸𑆢𑇀𑆣𑆼𑆠𑆶𑆫𑆤𑇀𑆠𑆫𑆓𑇀𑆤𑆴𑆫𑇀𑆪𑆡𑆳𑇁𑆣𑆴𑆑𑆂𑇆𑇒𑇔𑇖𑇆
𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆪𑆠𑆴 𑆪𑆡𑆳 𑆢𑆶𑆰𑇀𑆛𑆾 𑆪𑆳𑆤𑇀 𑆫𑆾𑆓𑆳𑆚𑇀𑆘𑆤𑆪𑆠𑇀𑆪𑆥𑆴𑇅 𑆓𑇀𑆫𑆲𑆟𑆵 𑆪𑆳 𑆪𑆡𑆳 𑆪𑆖𑇀𑆖 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇒𑇔𑇗𑇆
𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆥𑆸𑆡𑆑𑇀 𑆖𑆽𑆮 𑆮𑇀𑆪𑆚𑇀𑆘𑆤𑆁 𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆱𑇀𑆪 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆠𑆡𑆳 𑆖𑆳𑆮𑆱𑇀𑆡𑆴𑆑𑆵 𑆑𑇀𑆫𑆴𑆪𑆳𑇆𑇒𑇔𑇘𑇆
𑆘𑆳𑆪𑆠𑆼 𑆖 𑆪𑆡𑆳𑇁𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑇀𑆪𑆖𑇀𑆖 𑆠𑆱𑇀𑆪 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑇀𑇅 𑆇𑆑𑇀𑆠𑆮𑆳𑆤𑆴𑆲 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆑𑆼 𑆩𑆶𑆤𑆴𑆂𑇆𑇒𑇔𑇙𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂 𑆥𑆚𑇀𑆖 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆽𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇅 𑆖𑆠𑆶𑆫𑇀𑆡𑆂 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼𑆤 𑆥𑆚𑇀𑆖𑆩𑆾 𑆨𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆩𑆸𑆢𑆂𑇆𑇓𑇆
𑆢𑆾𑆰𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆥𑇀𑆫𑆣𑆳𑆤𑆳𑆱𑇀𑆠𑆶 𑆪𑆱𑇀𑆪 𑆑𑆶𑆥𑇀𑆪𑆤𑇀𑆠𑆴 𑆣𑆳𑆠𑆶𑆰𑆶𑇅 𑆯𑆽𑆡𑆴𑆬𑇀𑆪𑆁 𑆠𑆱𑇀𑆪 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆓𑆿𑆫𑆮𑆁 𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇔𑇆
𑆠𑆠𑆾 𑆮𑆫𑇀𑆟𑆧𑆬𑆱𑇀𑆤𑆼𑆲𑆳 𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼𑇁𑆥𑇀𑆪𑆾𑆘𑆱𑆾 𑆓𑆶𑆟𑆳𑆂𑇅 𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑆴 𑆑𑇀𑆰𑆪𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆢𑆾𑆰𑆢𑆷𑆰𑇀𑆪𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆳𑆠𑇀𑇆𑇕𑇆
𑆱𑆾𑇁𑆬𑇀𑆥𑆫𑆑𑇀𑆠𑆾𑇁𑆬𑇀𑆥𑆩𑆼𑆢𑆱𑇀𑆑𑆾 𑆤𑆴𑆂𑆱𑆳𑆫𑆂 𑆯𑆴𑆡𑆴𑆬𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇅 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆁 𑆨𑆘𑆠𑆼, 𑆠𑆱𑇀𑆪 𑆲𑆼𑆠𑆶𑆁 𑆯𑆸𑆟𑆶 𑆱𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇖𑇆
𑆑𑇀𑆰𑆳𑆫𑆳𑆩𑇀𑆬𑆬𑆮𑆟𑆳𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆨𑆾𑆘𑆤𑆳𑆠𑇀𑇅 𑆤𑆴𑆰𑇀𑆥𑆳𑆮𑆩𑆳𑆰𑆥𑆴𑆟𑇀𑆪𑆳𑆑𑆠𑆴𑆬𑆠𑆽𑆬𑆤𑆴𑆰𑆼𑆮𑆟𑆳𑆠𑇀𑇆𑇗𑇆
𑆮𑆴𑆢𑆓𑇀𑆣𑆼𑇁𑆤𑇀𑆤𑆼 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆳𑆤𑇀𑆩𑆽𑆡𑆶𑆤𑆳𑆠𑇀𑆠𑆡𑆳𑇅 𑆥𑇀𑆫𑆠𑆴𑆑𑆫𑇀𑆩𑆫𑇀𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆳𑆢𑇀𑆮𑆼𑆓𑆳𑆤𑆳𑆁 𑆖 𑆮𑆴𑆣𑆳𑆫𑆟𑆳𑆠𑇀𑇆𑇘𑇆
𑆑𑆳𑆩𑆖𑆴𑆤𑇀𑆠𑆳𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆯𑆾𑆑𑆾𑆥𑆲𑆠𑆖𑆼𑆠𑆱𑆂𑇅 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆟𑆁 𑆪𑆢𑆳 𑆥𑆴𑆠𑇀𑆠𑆁 𑆲𑆸𑆢𑆪𑆼 𑆱𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇙𑇆
𑆮𑆳𑆪𑆶𑆤𑆳 𑆧𑆬𑆴𑆤𑆳 𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆪 𑆣𑆩𑆤𑆵𑆫𑇀𑆢𑆯𑇅 𑆥𑇀𑆫𑆥𑆤𑇀𑆤𑆁 𑆑𑆼𑆮𑆬𑆁 𑆢𑆼𑆲𑆁 𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑇀𑆠𑆫𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇆𑇑𑇐𑇆
𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆑𑆦𑆮𑆳𑆠𑆳𑆱𑆸𑆑𑇀𑆠𑇀𑆮𑆕𑇀𑆩𑆳𑆁𑆱𑆳𑆤𑆴 𑆑𑆫𑆾𑆠𑆴 𑆠𑆠𑇀𑇅 𑆥𑆳𑆟𑇀𑆝𑆶𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆲𑆫𑆴𑆠𑆳𑆤𑇀 𑆮𑆫𑇀𑆟𑆳𑆤𑇀 𑆧𑆲𑆶𑆮𑆴𑆣𑆳𑆁𑆱𑇀𑆠𑇀𑆮𑆖𑆴𑇆𑇑𑇑𑇆
𑆱 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆂 ...𑇅𑇑𑇒𑇅 ... 𑆠𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆁 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆂𑇅 𑆲𑆸𑆢𑆪𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆁 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆁 𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑆳𑆮𑆂 𑆯𑇀𑆫𑆩𑆱𑇀𑆠𑆡𑆳𑇆𑇑𑇒𑇆
𑆱𑆩𑇀𑆨𑆷𑆠𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀 𑆨𑆮𑆼𑆠𑇀 𑆱𑆫𑇀𑆮𑆂 𑆑𑆫𑇀𑆟𑆑𑇀𑆰𑇀𑆮𑆼𑆝𑆵 𑆲𑆠𑆳𑆤𑆬𑆂𑇅 𑆢𑆶𑆫𑇀𑆧𑆬𑆂 𑆱𑆢𑆤𑆾𑇁𑆤𑇀𑆤𑆢𑇀𑆮𑆴𑆛𑇀 𑆯𑇀𑆫𑆩𑆨𑇀𑆫𑆩𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆂𑇆𑇑𑇓𑇆
𑆓𑆳𑆠𑇀𑆫𑆯𑆷𑆬𑆘𑇀𑆮𑆫𑆯𑇀𑆮𑆳𑆱𑆓𑆿𑆫𑆮𑆳𑆫𑆶𑆖𑆴𑆩𑆳𑆤𑇀𑆤𑆫𑆂𑇅 𑆩𑆸𑆢𑆴𑆠𑆽𑆫𑆴𑆮 𑆓𑆳𑆠𑇀𑆫𑆽𑆯𑇀𑆖 𑆥𑆵𑆝𑆴𑆠𑆾𑆤𑇀𑆩𑆡𑆴𑆠𑆽𑆫𑆴𑆮𑇆𑇑𑇔𑇆
𑆯𑆷𑆤𑆳𑆑𑇀𑆰𑆴𑆑𑆷𑆛𑆾 𑆲𑆫𑆴𑆠𑆂 𑆯𑆵𑆫𑇀𑆟𑆬𑆾𑆩𑆳 𑆲𑆠𑆥𑇀𑆫𑆨𑆂𑇅 𑆑𑆾𑆥𑆤𑆂 𑆯𑆴𑆯𑆴𑆫𑆢𑇀𑆮𑆼𑆰𑆵 𑆤𑆴𑆢𑇀𑆫𑆳𑆬𑆶𑆂 𑆰𑇀𑆜𑆵𑆮𑆤𑆾𑇁𑆬𑇀𑆥𑆮𑆳𑆑𑇀𑇆𑇑𑇕𑇆
𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆑𑆛𑇀𑆪𑆷𑆫𑆶𑆥𑆳𑆢𑆫𑆶𑆑𑇀𑆱𑆢𑆤𑆳𑆤𑆴 𑆖𑇅 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆫𑆾𑆲𑆟𑆳𑆪𑆳𑆱𑆽𑆫𑇀𑆮𑆴𑆯𑆼𑆰𑆯𑇀𑆖𑆳𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇆
𑆄𑆲𑆳𑆫𑆽𑆫𑆶𑆥𑆖𑆳𑆫𑆽𑆯𑇀𑆖 𑆮𑆳𑆠𑆬𑆽𑆂 𑆑𑆶𑆥𑆴𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇅 𑆘𑆤𑆪𑆼𑆠𑇀𑆑𑆸𑆰𑇀𑆟𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑇀𑆮𑆁 𑆠𑆡𑆳 𑆫𑆷𑆑𑇀𑆰𑆳𑆫𑆶𑆟𑆳𑆕𑇀𑆓𑆠𑆳𑆩𑇀𑇆𑇑𑇗𑇆
𑆃𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆁 𑆫𑆶𑆘𑆁 𑆠𑆾𑆢𑆁 𑆑𑆩𑇀𑆥𑆁 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆩𑇀𑇅 𑆮𑆫𑇀𑆖𑆂𑆯𑆾𑆰𑆳𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆯𑆾𑆦𑆳𑆤𑆳𑆲𑆧𑆬𑆑𑇀𑆰𑆪𑆳𑆤𑇀𑇆𑇑𑇘𑇆
𑆥𑆴𑆠𑇀𑆠𑆬𑆱𑇀𑆪𑆳𑆖𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆽𑆂 𑆱𑇀𑆮𑆽𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆽𑆂𑇅 𑆢𑆷𑆰𑆪𑆴𑆠𑇀𑆮𑆳 𑆠𑆶 𑆫𑆑𑇀𑆠𑆳𑆢𑆵𑆤𑇀 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼𑇆𑇑𑇙𑇆
𑆱 𑆥𑆵𑆠𑆾 𑆲𑆫𑆴𑆠𑆳𑆨𑆾 𑆮𑆳 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆱𑆩𑆤𑇀𑆮𑆴𑆠𑆂𑇅 𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆥𑆴𑆥𑆳𑆱𑆳𑆫𑇀𑆠𑆂 𑆥𑆵𑆠𑆩𑆷𑆠𑇀𑆫𑆯𑆑𑆸𑆤𑇀𑆤𑆫𑆂𑇆𑇒𑇐𑇆
𑆱𑇀𑆮𑆼𑆢𑆤𑆂 𑆯𑆵𑆠𑆑𑆳𑆩𑆯𑇀𑆖 𑆤 𑆖𑆳𑆤𑇀𑆤𑆩𑆨𑆴𑆤𑆤𑇀𑆢𑆠𑆴𑇅 𑆑𑆛𑆶𑆑𑆳𑆱𑇀𑆪𑆾 𑆤 𑆖𑆳𑆱𑇀𑆪𑆾𑆰𑇀𑆟𑆩𑆶𑆥𑆯𑆼𑆠𑆼𑇁𑆩𑇀𑆬𑆩𑆼𑆮 𑆖𑇆𑇒𑇑𑇆
𑆇𑆢𑇀𑆓𑆳𑆫𑆾𑇁𑆩𑇀𑆬𑆾 𑆮𑆴𑆢𑆳𑆲𑆯𑇀𑆖 𑆮𑆴𑆢𑆓𑇀𑆣𑆼𑇁𑆤𑇀𑆤𑆼𑇁𑆱𑇀𑆪 𑆘𑆳𑆪𑆠𑆼𑇅 𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆁 𑆨𑆴𑆤𑇀𑆤𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆠𑆩 𑆍𑆮 𑆖𑇆𑇒𑇒𑇆
𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆽𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆱 𑆥𑆷𑆫𑇀𑆮𑆮𑆠𑇀𑇅 𑆑𑆫𑆾𑆠𑆴 𑆓𑆿𑆫𑆮𑆁 𑆠𑆤𑇀𑆢𑇀𑆫𑆳 𑆗𑆫𑇀𑆢𑆴𑆁 𑆯𑇀𑆮𑆼𑆠𑆳𑆮𑆨𑆳𑆱𑆠𑆳𑆩𑇀𑇆𑇒𑇓𑇆
𑆥𑇀𑆫𑆱𑆼𑆑𑆁 𑆬𑆾𑆩𑆲𑆫𑇀𑆰𑆁 𑆖 𑆱𑆳𑆢𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆁 𑆨𑇀𑆫𑆩𑆁 𑆑𑇀𑆬𑆩𑆩𑇀𑇅 𑆯𑇀𑆮𑆳𑆱𑆁 𑆑𑆳𑆱𑆁 𑆠𑆡𑆳𑇁𑇁𑆬𑆱𑇀𑆪𑆩𑆫𑆶𑆖𑆴𑆁 𑆮𑆳𑆑𑇀𑆱𑇀𑆮𑆫𑆓𑇀𑆫𑆲𑆩𑇀𑇆𑇒𑇔𑇆
𑆯𑆶𑆑𑇀𑆬𑆩𑆷𑆠𑇀𑆫𑆳𑆑𑇀𑆰𑆴𑆮𑆫𑇀𑆖𑆱𑇀𑆠𑇀𑆮𑆁 𑆑𑆛𑆶𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆑𑆳𑆩𑆠𑆳𑆩𑇀𑇅 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆩𑆣𑆶𑆫𑆳𑆱𑇀𑆪𑆠𑇀𑆮𑆩𑆴𑆠𑆴 𑆥𑆳𑆟𑇀𑆝𑇀𑆮𑆳𑆩𑆪𑆂 𑆑𑆦𑆳𑆠𑇀𑇆𑇒𑇕𑇆
𑆱𑆫𑇀𑆮𑆳𑆤𑇀𑆤𑆱𑆼𑆮𑆴𑆤𑆂 𑆱𑆫𑇀𑆮𑆼 𑆢𑆶𑆰𑇀𑆛𑆳 𑆢𑆾𑆰𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆩𑇀𑇅 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆬𑆴𑆕𑇀𑆓𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆁 𑆱𑆶𑆢𑆶𑆂𑆱𑆲𑆩𑇀𑇆𑇒𑇖𑇆
𑆩𑆸𑆠𑇀𑆠𑆴𑆑𑆳𑆢𑆤𑆯𑆵𑆬𑆱𑇀𑆪 𑆑𑆶𑆥𑇀𑆪𑆠𑇀𑆪𑆤𑇀𑆪𑆠𑆩𑆾 𑆩𑆬𑆂𑇅 𑆑𑆰𑆳𑆪𑆳 𑆩𑆳𑆫𑆶𑆠𑆁, 𑆥𑆴𑆠𑇀𑆠𑆩𑆷𑆰𑆫𑆳, 𑆩𑆣𑆶𑆫𑆳 𑆑𑆦𑆩𑇀𑇆𑇒𑇗𑇆

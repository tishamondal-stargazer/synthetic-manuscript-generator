𑆱𑇀𑆮𑆫𑆱𑆂 𑆑𑇀𑆮𑆡𑆴𑆠𑆾 𑆢𑆳𑆫𑇀𑆮𑇀𑆪𑆳 𑆔𑆤𑆵𑆨𑆷𑆠𑆾 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆱𑆸𑆓𑇀𑆢𑆾𑆰𑆤𑆳𑆝𑆵𑆮𑇀𑆫𑆟𑆳𑆥𑆲𑆳𑇆𑇒𑇐𑇒𑇆
𑆠𑆳𑆬𑆶𑆯𑆾𑆰𑆼 𑆠𑇀𑆮𑆠𑆸𑆰𑇀𑆟𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆫𑆿𑆠𑇀𑆠𑆫𑆨𑆑𑇀𑆠𑆴𑆑𑆩𑇀𑇅 𑆤𑆳𑆮𑆤𑆁 𑆩𑆣𑆶𑆫𑆳𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆂 𑆯𑆵𑆠𑆳𑆯𑇀𑆖𑆽𑆮 𑆫𑆱𑆳 𑆲𑆴𑆠𑆳𑆂𑇆𑇒𑇐𑇓𑇆
𑆩𑆶𑆒𑆥𑆳𑆑𑆼 𑆱𑆴𑆫𑆳𑆑𑆫𑇀𑆩 𑆯𑆴𑆫𑆂𑆑𑆳𑆪𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆩𑆷𑆠𑇀𑆫𑆠𑆽𑆬𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆑𑇀𑆰𑆵𑆫𑆽𑆯𑇀𑆖 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆳𑆂𑇆𑇒𑇐𑇔𑇆
𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑆳𑆜𑆳𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆘𑆳𑆠𑆴𑆥𑆬𑇀𑆬𑆮𑆳𑆂𑇅 𑆑𑆰𑆳𑆪𑆠𑆴𑆑𑇀𑆠𑆑𑆳𑆂 𑆯𑆵𑆠𑆳𑆂 𑆑𑇀𑆮𑆳𑆡𑆳𑆯𑇀𑆖 𑆩𑆶𑆒𑆣𑆳𑆮𑆤𑆳𑆂𑇆𑇒𑇐𑇕𑇆
𑆠𑆶𑆬𑆳𑆁 𑆒𑆢𑆴𑆫𑆱𑆳𑆫𑆱𑇀𑆪 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆳𑆩𑆫𑆴𑆩𑆼𑆢𑆱𑆂𑇅 𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑇀𑆪 𑆘𑆫𑇀𑆘𑆫𑆵𑆑𑆸𑆠𑇀𑆪 𑆖𑆠𑆶𑆫𑇀𑆢𑇀𑆫𑆾𑆟𑆼𑇁𑆩𑇀𑆨𑆱𑆂 𑆥𑆖𑆼𑆠𑇀𑇆𑇒𑇐𑇖𑇆
𑆢𑇀𑆫𑆾𑆟𑆯𑆼𑆰𑆁 𑆑𑆰𑆳𑆪𑆁 𑆠𑆁 𑆥𑆷𑆠𑇀𑆮𑆳 𑆨𑆷𑆪𑆂 𑆥𑆖𑆼𑆖𑇀𑆗𑆤𑆽𑆂𑇅 𑆠𑆠𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆔𑆤𑆵𑆨𑆷𑆠𑆼 𑆖𑆷𑆫𑇀𑆟𑆵𑆑𑆸𑆠𑇀𑆪𑆳𑆑𑇀𑆰𑆨𑆳𑆓𑆴𑆑𑆩𑇀𑇆𑇒𑇐𑇗𑇆
𑆖𑆤𑇀𑆢𑆤𑆁 𑆥𑆢𑇀𑆩𑆑𑆾𑆯𑆵𑆫𑆁 𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳 𑆣𑆳𑆠𑆑𑆵 𑆔𑆤𑆩𑇀𑇅 𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆁 𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆠𑇀𑆮𑆓𑆼𑆬𑆳𑆥𑆢𑇀𑆩𑆑𑆼𑆯𑆫𑆩𑇀𑇆𑇒𑇐𑇘𑇆
𑆬𑆳𑆑𑇀𑆰𑆳𑆁 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆁 𑆩𑆳𑆁𑆱𑆵𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆬𑆾𑆣𑇀𑆫𑆮𑆳𑆬𑆑𑆩𑇀𑇅 𑆫𑆘𑆤𑇀𑆪𑆿 𑆦𑆬𑆴𑆤𑆵𑆩𑆼𑆬𑆳𑆁 𑆱𑆩𑆕𑇀𑆓𑆳𑆁 𑆑𑆛𑇀𑆦𑆬𑆁 𑆮𑆖𑆳𑆩𑇀𑇆𑇒𑇐𑇙𑇆
𑆪𑆮𑆳𑆱𑆳𑆓𑆶𑆫𑆶𑆥𑆠𑇀𑆠𑆕𑇀𑆓𑆓𑆽𑆫𑆴𑆑𑆳𑆚𑇀𑆘𑆤𑆩𑆳𑆮𑆥𑆼𑆠𑇀𑇅 𑆬𑆮𑆕𑇀𑆓𑆤𑆒𑆑𑆑𑇀𑆑𑆾𑆬𑆘𑆳𑆠𑆴𑆑𑆾𑆯𑆳𑆤𑇀 𑆥𑆬𑆾𑆤𑇀𑆩𑆴𑆠𑆳𑆤𑇀𑇆𑇒𑇑𑇐𑇆
𑆑𑆫𑇀𑆥𑆷𑆫𑆑𑆶𑆝𑆮𑆁 𑆖𑆳𑆥𑆴 𑆑𑇀𑆰𑆴𑆥𑆼𑆖𑇀𑆗𑆵𑆠𑆼𑇁𑆮𑆠𑆳𑆫𑆴𑆠𑆼𑇅 𑆠𑆠𑆱𑇀𑆠𑆶 𑆓𑆶𑆛𑆴𑆑𑆳𑆂𑆑𑆳𑆫𑇀𑆪𑆳𑆂𑆯𑆶𑆰𑇀𑆑𑆳𑆯𑇀𑆖𑆳𑆱𑇀𑆪𑆼𑆤 𑆣𑆳𑆫𑆪𑆼𑆠𑇀𑇆𑇒𑇑𑇑𑇆
𑆠𑆽𑆬𑆁 𑆖𑆳𑆤𑆼𑆤 𑆑𑆬𑇀𑆑𑆼𑆤 𑆑𑆰𑆳𑆪𑆼𑆟 𑆖 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑇅 𑆢𑆤𑇀𑆠𑆳𑆤𑆳𑆁 𑆖𑆬𑆤𑆨𑇀𑆫𑆁𑆯𑆯𑆿𑆯𑆴𑆫𑇀𑆪𑆑𑇀𑆫𑆴𑆩𑆴𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇒𑇑𑇒𑇆
𑆩𑆶𑆒𑆥𑆳𑆑𑆳𑆱𑇀𑆪𑆢𑆿𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆘𑆳𑆝𑇀𑆪𑆳𑆫𑆾𑆖𑆑𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆱𑇀𑆫𑆳𑆮𑆾𑆥𑆬𑆼𑆥𑆥𑆽𑆖𑇀𑆗𑆴𑆬𑇀𑆪𑆮𑆽𑆱𑇀𑆮𑆫𑇀𑆪𑆓𑆬𑆯𑆾𑆰𑆤𑆶𑆠𑇀𑇆𑇒𑇑𑇓𑇆
𑆢𑆤𑇀𑆠𑆳𑆱𑇀𑆪𑆓𑆬𑆫𑆾𑆓𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆼𑆰𑇀𑆮𑆼𑆠𑆠𑇀 𑆥𑆫𑆳𑆪𑆟𑆩𑇀𑇅 𑆒𑆢𑆴𑆫𑆳𑆢𑆴𑆓𑆶𑆛𑆵𑆑𑆼𑆪𑆁 𑆠𑆽𑆬𑆁 𑆖 𑆒𑆢𑆴𑆫𑆳𑆢𑆴𑆑𑆩𑇀𑇆𑇒𑇑𑇔𑇆
𑆅𑆠𑆴 𑆒𑆢𑆴𑆫𑆳𑆢𑆴𑆓𑆶𑆛𑆴𑆑𑆳 𑆠𑆽𑆬𑆁 𑆖𑇅 𑆃𑆫𑆶𑆖𑆿 𑆑𑆮𑆬𑆓𑇀𑆫𑆳𑆲𑆳 𑆣𑆷𑆩𑆳𑆂 𑆱𑆩𑆶𑆒𑆣𑆳𑆮𑆤𑆳𑆂𑇅 𑆩𑆤𑆾𑆘𑇀𑆚𑆩𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆖 𑆲𑆫𑇀𑆰𑆟𑆳𑆯𑇀𑆮𑆳𑆱𑆤𑆳𑆤𑆴 𑆖𑇆𑇒𑇑𑇕𑇆
𑆑𑆶𑆰𑇀𑆜𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆳𑆘𑆳𑆘𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆫𑆴𑆖𑆁 𑆧𑆴𑆝𑆩𑇀𑇅 𑆣𑆳𑆠𑇀𑆫𑇀𑆪𑆼𑆬𑆳𑆥𑆢𑇀𑆩𑆑𑆾𑆯𑆵𑆫𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆶𑆠𑇀𑆥𑆬𑆖𑆤𑇀𑆢𑆤𑆩𑇀𑇆𑇒𑇑𑇖𑇆
𑆬𑆾𑆣𑇀𑆫𑆁 𑆠𑆼𑆘𑆾𑆮𑆠𑆵 𑆥𑆡𑇀𑆪𑆳 𑆠𑇀𑆫𑇀𑆪𑆷𑆰𑆟𑆁 𑆱𑆪𑆮𑆳𑆓𑇀𑆫𑆘𑆩𑇀𑇅 𑆄𑆫𑇀𑆢𑇀𑆫𑆢𑆳𑆝𑆴𑆩𑆤𑆴𑆫𑇀𑆪𑆳𑆱𑆯𑇀𑆖𑆳𑆘𑆳𑆘𑆵𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆶𑆠𑆂𑇆𑇒𑇑𑇗𑇆
𑆱𑆠𑆽𑆬𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆠𑆼 𑆖𑆠𑇀𑆮𑆳𑆫𑆂 𑆑𑆮𑆬𑆓𑇀𑆫𑆲𑆳𑆂𑇅 𑆖𑆠𑆶𑆫𑆾𑇁𑆫𑆾𑆖𑆑𑆳𑆤𑇀 𑆲𑆤𑇀𑆪𑆶𑆫𑇀𑆮𑆳𑆠𑆳𑆢𑇀𑆪𑆼𑆑𑆘𑆱𑆫𑇀𑆮𑆘𑆳𑆤𑇀𑇆𑇒𑇑𑇘𑇆
𑆑𑆳𑆫𑆮𑆵𑆩𑆫𑆴𑆖𑆳𑆘𑆳𑆘𑆵𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆮𑆸𑆑𑇀𑆰𑆳𑆩𑇀𑆬𑆢𑆳𑆝𑆴𑆩𑆩𑇀𑇅 𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆁 𑆓𑆶𑆝𑆂 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆱𑆫𑇀𑆮𑆳𑆫𑆾𑆖𑆑𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇒𑇑𑇙𑇆
𑆧𑆱𑇀𑆠𑆴𑆁 𑆱𑆩𑆵𑆫𑆟𑆼, 𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆴𑆫𑆼𑆑𑆁, 𑆮𑆩𑆤𑆁 𑆑𑆦𑆼𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆣𑆸𑆢𑇀𑆪𑆳𑆤𑆶𑆑𑆷𑆬𑆳𑆤𑆴 𑆲𑆫𑇀𑆰𑆟𑆁 𑆖 𑆩𑆤𑆾𑆔𑇀𑆤𑆘𑆼𑇆𑇒𑇒𑇐𑇆
𑆅𑆠𑇀𑆪𑆫𑆾𑆖𑆑𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑇅 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆼 𑆠𑆶 𑆮𑆳𑆠𑆔𑇀𑆤𑆵 𑆲𑆴𑆠𑆳 𑆥𑆵𑆤𑆱𑆮𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆂 𑆥𑆷𑆫𑆟𑆁 𑆤𑆱𑇀𑆪𑆁 𑆥𑆳𑆑𑆱𑇀𑆫𑆳𑆮𑆼 𑆮𑇀𑆫𑆟𑆑𑇀𑆫𑆴𑆪𑆳𑆂𑇆𑇒𑇒𑇑𑇆
𑆨𑆾𑆘𑇀𑆪𑆳𑆤𑆴 𑆖 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆥𑆷𑆫𑆟𑆳𑆤𑇀𑇅 𑆲𑆴𑆕𑇀𑆓𑆶𑆠𑆶𑆩𑇀𑆧𑆫𑆶𑆯𑆶𑆟𑇀𑆜𑆵𑆨𑆴𑆱𑇀𑆠𑆽𑆬𑆁 𑆠𑆶 𑆱𑆳𑆫𑇀𑆰𑆥𑆁 𑆥𑆖𑆼𑆠𑇀𑇆𑇒𑇒𑇒𑇆
𑆍𑆠𑆢𑇀𑆣𑆴 𑆥𑆷𑆫𑆟𑆁 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀𑇅 𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆮𑆖𑆳𑆯𑆶𑆟𑇀𑆜𑆵𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆽𑆤𑇀𑆣𑆮𑆽𑆂𑇆𑇒𑇒𑇓𑇆
𑆠𑆽𑆬𑆁 𑆱𑆴𑆢𑇀𑆣𑆁 𑆧𑆱𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆼 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆤𑆴𑆮𑆳𑆫𑆟𑆩𑇀𑇅 𑆮𑆫𑆳𑆛𑆑𑆳𑆤𑇀 𑆱𑆩𑆳𑆲𑆸𑆠𑇀𑆪 𑆢𑆲𑆼𑆤𑇀𑆩𑆸𑆢𑇀𑆨𑆳𑆘𑆤𑆼 𑆤𑆮𑆼𑇆𑇒𑇒𑇔𑇆
𑆠𑆢𑇀𑆨𑆱𑇀𑆩 𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆪𑆼𑆠𑇀𑆠𑆼𑆤 𑆓𑆤𑇀𑆣𑆠𑆽𑆬𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇅 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆱𑇀𑆪 𑆯𑆶𑆟𑇀𑆜𑇀𑆪𑆳𑆯𑇀𑆖 𑆑𑆬𑇀𑆑𑆳𑆨𑇀𑆪𑆳𑆁 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆤𑆶𑆠𑇀𑇆𑇒𑇒𑇕𑇆
𑆯𑆶𑆰𑇀𑆑𑆩𑆷𑆬𑆑𑆯𑆶𑆟𑇀𑆜𑆳𑆤𑆳𑆁 𑆑𑇀𑆰𑆳𑆫𑆾 𑆲𑆴𑆕𑇀𑆓𑆶 𑆩𑆲𑆿𑆰𑆣𑆩𑇀𑇅 𑆯𑆠𑆥𑆶𑆰𑇀𑆥𑆳 𑆮𑆖𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆢𑆳𑆫𑆶 𑆯𑆴𑆓𑇀𑆫𑆶 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇆𑇒𑇒𑇖𑇆
𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆾𑆢𑇀𑆨𑆴𑆢𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀𑇅 𑆨𑆷𑆫𑇀𑆘𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆫𑇀𑆧𑆴𑆝𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆩𑆣𑆶𑆯𑆶𑆑𑇀𑆠𑆁 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆩𑇀𑇆𑇒𑇒𑇗𑇆
𑆩𑆳𑆠𑆶𑆬𑆶𑆕𑇀𑆓𑆫𑆱𑆯𑇀𑆖𑆽𑆮 𑆑𑆢𑆬𑇀𑆪𑆳 𑆫𑆱 𑆍𑆮 𑆖𑇅 𑆱𑆫𑇀𑆮𑆽𑆫𑆼𑆠𑆽𑆫𑇀𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆽𑆂 𑆑𑇀𑆰𑆳𑆫𑆠𑆽𑆬𑆁 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇆𑇒𑇒𑇘𑇆
𑆧𑆳𑆣𑆴𑆫𑇀𑆪𑆁 𑆑𑆫𑇀𑆟𑆤𑆳𑆢𑆯𑇀𑆖 𑆥𑆷𑆪𑆱𑇀𑆫𑆳𑆮𑆯𑇀𑆖 𑆢𑆳𑆫𑆶𑆟𑆂𑇅 𑆑𑇀𑆫𑆴𑆩𑆪𑆂 𑆑𑆫𑇀𑆟𑆯𑆷𑆬𑆁 𑆖 𑆥𑆷𑆫𑆟𑆳𑆢𑆱𑇀𑆪 𑆤𑆯𑇀𑆪𑆠𑆴 𑇆𑇒𑇒𑇙𑇆
𑆩𑆶𑆒𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆫𑆾𑆓𑆼𑆰𑆶 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆥𑆵𑆤𑆱𑆼 𑆮𑆴𑆣𑆴𑆩𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑆿 𑆢𑆾𑆰𑆑𑆳𑆬𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇆𑇒𑇓𑇐𑇆
𑆅𑆠𑆴 𑆑𑆫𑇀𑆟𑆫𑆾𑆓𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑇅 𑆇𑆠𑇀𑆥𑆤𑇀𑆤𑆩𑆳𑆠𑇀𑆫𑆼 𑆠𑆫𑆶𑆟𑆼 𑆤𑆼𑆠𑇀𑆫𑆫𑆾𑆓𑆼 𑆧𑆴𑆝𑆳𑆬𑆑𑆂𑇅 𑆑𑆳𑆫𑇀𑆪𑆾 𑆢𑆳𑆲𑆾𑆥𑆢𑆼𑆲𑆳𑆯𑇀𑆫𑆶𑆯𑆾𑆦𑆫𑆳𑆓𑆤𑆴𑆮𑆳𑆫𑆟𑆂𑇆𑇒𑇓𑇑𑇆
𑆤𑆳𑆓𑆫𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆟𑇀𑆝𑆼𑆤 𑆖 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆤𑆴𑆔𑆸𑆰𑇀𑆛𑆁 𑆮𑆳𑆠𑆴𑆑𑆼 𑆠𑆢𑇀𑆮𑆤𑇀𑆩𑆣𑆶𑆱𑆽𑆤𑇀𑆣𑆮𑆓𑆽𑆫𑆴𑆑𑆩𑇀𑇆𑇒𑇓𑇒𑇆
𑆠𑆡𑆳 𑆯𑆳𑆮𑆫𑆑𑆁 𑆬𑆾𑆣𑇀𑆫𑆁 𑆔𑆸𑆠𑆨𑆸𑆰𑇀𑆛𑆁 𑆧𑆴𑆝𑆳𑆬𑆑𑆂𑇅 𑆠𑆢𑇀𑆮𑆠𑇀 𑆑𑆳𑆫𑇀𑆪𑆾 𑆲𑆫𑆵𑆠𑆑𑇀𑆪𑆳 𑆔𑆸𑆠𑆨𑆸𑆰𑇀𑆛𑆾 𑆫𑆶𑆘𑆳𑆥𑆲𑆂𑇆𑇒𑇓𑇓𑇆
𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆖𑆤𑇀𑆢𑆤𑆳𑆤𑆤𑇀𑆠𑆳𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆨𑆴𑆫𑇀𑆧𑆴𑆝𑆳𑆬𑆑𑆂𑇅 𑆑𑆳𑆫𑇀𑆪𑆂 𑆥𑆢𑇀𑆩𑆑𑆪𑆰𑇀𑆛𑇀𑆪𑆳𑆲𑇀𑆮𑆩𑆳𑆁𑆱𑆵𑆑𑆳𑆬𑆵𑆪𑆑𑆽𑆱𑇀𑆠𑆡𑆳𑇆𑇒𑇓𑇔𑇆
𑆓𑆽𑆫𑆴𑆑𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆫𑆾𑆖𑆤𑆳 𑆖 𑆫𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆑𑆦𑆼 𑆑𑆳𑆫𑇀𑆪𑆳 𑆠𑆡𑆳 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆥𑇀𑆫𑆴𑆪𑆕𑇀𑆓𑆶𑆂 𑆱𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑇆𑇒𑇓𑇕𑇆
𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆠𑆶 𑆱𑆫𑇀𑆮𑆽𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆧𑆲𑆴𑆫𑆑𑇀𑆰𑇀𑆟𑆾𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆤𑆩𑇀𑇅 𑆥𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑇀𑆪𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆠𑆳 𑆑𑆳𑆫𑇀𑆪𑆁 𑆱𑆩𑇀𑆥𑆑𑇀𑆮𑆼 𑆠𑇀𑆮𑆚𑇀𑆘𑆤𑆁 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑇆𑇒𑇓𑇖𑇆
𑆄𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆁 𑆩𑆳𑆫𑆶𑆠𑆘𑆼 𑆑𑇀𑆮𑆳𑆡𑆾 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆨𑆴𑆫𑇀𑆲𑆴𑆠𑆂𑇅 𑆑𑆾𑆰𑇀𑆟𑆂 𑆱𑆽𑆫𑆟𑇀𑆝𑆠𑆫𑇀𑆑𑆳𑆫𑆵𑆧𑆸𑆲𑆠𑆵𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆶𑆨𑆴𑆂𑇆𑇒𑇓𑇗𑇆
𑆥𑆸𑆡𑇀𑆮𑆵𑆑𑆳𑆢𑆳𑆫𑇀𑆮𑆴𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆬𑆳𑆑𑇀𑆰𑆳𑆢𑇀𑆮𑆴𑆩𑆣𑆶𑆑𑆾𑆠𑇀𑆥𑆬𑆽𑆂𑇅 𑆑𑇀𑆮𑆳𑆡𑆂 𑆱𑆯𑆫𑇀𑆑𑆫𑆂 𑆯𑆵𑆠𑆂 𑆥𑆷𑆫𑆟𑆁 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆤𑆶𑆠𑇀𑇆𑇒𑇓𑇘𑇆
𑆤𑆳𑆓𑆫𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆩𑆶𑆱𑇀𑆠𑆤𑆴𑆩𑇀𑆧𑆮𑆳𑆱𑆳𑆫𑆱𑆂 𑆑𑆦𑆼𑇅 𑆑𑆾𑆰𑇀𑆟𑆩𑆳𑆯𑇀𑆖𑇀𑆪𑆾𑆠𑆤𑆁 𑆩𑆴𑆯𑇀𑆫𑆽𑆫𑆾𑆰𑆣𑆽𑆂 𑆱𑆳𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆑𑆼𑇆𑇒𑇓𑇙𑇆
𑆧𑆸𑆲𑆠𑇀𑆪𑆼𑆫𑆟𑇀𑆝𑆩𑆷𑆬𑆠𑇀𑆮𑆑𑇀 𑆯𑆴𑆓𑇀𑆫𑆾𑆂 𑆥𑆶𑆰𑇀𑆥𑆁 𑆱𑆱𑆽𑆤𑇀𑆣𑆮𑆩𑇀𑇅 𑆃𑆘𑆳𑆑𑇀𑆰𑆵𑆫𑆼𑆟 𑆥𑆴𑆰𑇀𑆛𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆫𑇀𑆠𑆴𑆫𑇀𑆮𑆳𑆠𑆳𑆑𑇀𑆰𑆴𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇒𑇔𑇐𑇆
𑆱𑆶𑆩𑆤𑆂𑆑𑆾𑆫𑆑𑆳𑆂 𑆯𑆕𑇀𑆒𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆩𑆣𑆶𑆑𑆁 𑆧𑆬𑆳𑇅 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆥𑆲𑆳 𑆮𑆫𑇀𑆠𑆴𑆂 𑆥𑆴𑆰𑇀𑆛𑆳 𑆢𑆴𑆮𑇀𑆪𑆼𑆤 𑆮𑆳𑆫𑆴𑆟𑆳𑇆𑇒𑇔𑇑𑇆

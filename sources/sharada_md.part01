𑆍𑆑𑆽𑆑𑆯𑆂 𑆱𑆩𑆱𑇀𑆠𑆳𑆤𑇀 𑆮𑆳 𑆤𑆳𑆣𑇀𑆪𑆯𑇀𑆤𑆵𑆪𑆳𑆢𑇀𑆫𑆱𑆳𑆤𑇀 𑆱𑆢𑆳 𑇅 𑆥𑇀𑆫𑆳𑆓𑇀𑆨𑆶𑆑𑇀𑆠𑆼 𑆠𑇀𑆮𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆼𑇁𑆓𑇀𑆤𑆿 𑆢𑇀𑆮𑆴𑆫𑆤𑇀𑆤𑆁 𑆤 𑆱𑆩𑆳𑆖𑆫𑆼𑆠𑇀 𑇆𑇔𑇙𑇒𑇆
𑆥𑆷𑆫𑇀𑆮𑆨𑆶𑆑𑇀𑆠𑆼 𑆮𑆴𑆢𑆓𑇀𑆣𑆼𑇁𑆤𑇀𑆤𑆼 𑆨𑆶𑆚𑇀𑆘𑆳𑆤𑆾 𑆲𑆤𑇀𑆠𑆴 𑆥𑆳𑆮𑆑𑆩𑇀 𑇅 𑆩𑆳𑆠𑇀𑆫𑆳𑆓𑆶𑆫𑆶𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆢𑆳𑆲𑆳𑆫𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆠𑆯𑇀𑆖 𑆪𑆂 𑇆𑇔𑇙𑇓𑇆
𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆁 𑆤𑆽𑆮 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆮𑆳 𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆴𑆠𑆂 𑇅 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆁 𑆖 𑆥𑆴𑆧𑆼𑆠𑇀𑆠𑆾𑆪𑆁 𑆱𑆶𑆒𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆘𑆵𑆫𑇀𑆪𑆠𑆴 𑇅 𑆥𑆼𑆪𑆬𑆼𑆲𑇀𑆪𑆳𑆢𑇀𑆪𑆨𑆑𑇀𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆶𑆫𑆶 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆡𑆾𑆠𑇀𑆠𑆫𑆩𑇀 𑇆𑇔𑇙𑇔𑇆
𑆓𑆶𑆫𑆷𑆟𑆳𑆩𑆫𑇀𑆣𑆱𑆿𑆲𑆴𑆠𑇀𑆪𑆁 𑆬𑆔𑆷𑆤𑆳𑆁 𑆠𑆸𑆥𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇅 𑆢𑇀𑆫𑆮𑆾𑆠𑇀𑆠𑆫𑆾 𑆢𑇀𑆫𑆮𑆯𑇀𑆖𑆳𑆥𑆴 𑆤 𑆩𑆳𑆠𑇀𑆫𑆳𑆓𑆶𑆫𑆶𑆫𑆴𑆰𑇀𑆪𑆠𑆼 𑇆𑇔𑇙𑇕𑇆
𑆢𑇀𑆫𑆮𑆳𑆞𑇀𑆪𑆩𑆥𑆴 𑆯𑆶𑆰𑇀𑆑𑆁 𑆠𑆶 𑆱𑆩𑇀𑆪𑆓𑆼𑆮𑆾𑆥𑆥𑆢𑇀𑆪𑆠𑆼 𑇅 𑆮𑆴𑆯𑆶𑆰𑇀𑆑𑆩𑆤𑇀𑆤𑆩𑆨𑇀𑆪𑆱𑇀𑆠𑆁 𑆤 𑆥𑆳𑆑𑆁 𑆱𑆳𑆣𑆶 𑆓𑆖𑇀𑆗𑆠𑆴 𑇆𑇔𑇙𑇖𑇆
𑆥𑆴𑆟𑇀𑆝𑆵𑆑𑆸𑆠𑆩𑆱𑆕𑇀𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆁 𑆮𑆴𑆢𑆳𑆲𑆩𑆶𑆥𑆓𑆖𑇀𑆗𑆠𑆴 𑇅 𑆱𑇀𑆫𑆾𑆠𑆱𑇀𑆪𑆤𑇀𑆤𑆮𑆲𑆼 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑆑𑇀𑆠𑆿 𑆮𑆳 𑆪𑆱𑇀𑆪 𑆠𑆴𑆰𑇀𑆜𑆠𑆴 𑇆𑇔𑇙𑇗𑇆
𑆮𑆴𑆢𑆳𑆲𑆴 𑆨𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆪𑆢𑇀𑆮𑆳 𑆠𑆱𑇀𑆪𑆳𑆥𑇀𑆪𑆤𑇀𑆤𑆁 𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑇅 𑆯𑆶𑆰𑇀𑆑𑆁 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆁 𑆮𑆴𑆰𑇀𑆛𑆩𑇀𑆨𑆴 𑆮𑆲𑇀𑆤𑆴𑆮𑇀𑆪𑆳𑆥𑆢𑆩𑆳𑆮𑆲𑆼𑆠𑇀 𑇆𑇔𑇙𑇘𑇆
𑆄𑆩𑆁 𑆮𑆴𑆢𑆓𑇀𑆣𑆁 𑆮𑆴𑆰𑇀𑆛𑆧𑇀𑆣𑆁 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆴𑆬𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆂 𑇅 𑆃𑆘𑆵𑆫𑇀𑆟𑆁 𑆑𑆼𑆖𑆴𑆢𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆡𑆁 𑆫𑆱𑆯𑆼𑆰𑆠𑆂 𑇆𑇔𑇙𑇙𑇆
𑆃𑆠𑇀𑆪𑆩𑇀𑆧𑆶𑆥𑆳𑆤𑆳𑆢𑇀𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆳𑆢𑇀𑆮𑆳 𑆱𑆤𑇀𑆣𑆳𑆫𑆟𑆳𑆠𑇀 𑆱𑇀𑆮𑆥𑇀𑆤𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆖𑇀𑆖 𑇅 𑆑𑆳𑆬𑆼𑇁𑆥𑆴 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆁 𑆬𑆔𑆶 𑆖𑆳𑆥𑆴 𑆨𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆤𑆁 𑆤 𑆥𑆳𑆑𑆁 𑆨𑆘𑆠𑆼 𑆤𑆫𑆱𑇀𑆪 𑇆𑇕𑇐𑇐𑇆
𑆆𑆫𑇀𑆰𑇀𑆪𑆳𑆨𑆪𑆑𑇀𑆫𑆾𑆣𑆥𑆫𑆴𑆑𑇀𑆰𑆠𑆼𑆤 𑆬𑆶𑆧𑇀𑆣𑆼𑆤 𑆯𑆶𑆓𑇀𑆢𑆽𑆤𑇀𑆪𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆼𑆤 𑇅 𑆥𑇀𑆫𑆢𑇀𑆮𑆼𑆰𑆪𑆶𑆑𑇀𑆠𑆼𑆤 𑆖 𑆱𑆼𑆮𑇀𑆪𑆩𑆳𑆤𑆩𑆤𑇀𑆤𑆁 𑆤 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑆫𑆴𑆟𑆳𑆩𑆩𑆼𑆠𑆴 𑇆𑇕𑇐𑇑𑇆
𑆩𑆳𑆣𑆶𑆫𑇀𑆪𑆩𑆤𑇀𑆤𑆁 𑆓𑆠𑆩𑆳𑆩𑆱𑆚𑇀𑆘𑇀𑆚𑆁 𑆮𑆴𑆢𑆓𑇀𑆣𑆱𑆚𑇀𑆘𑇀𑆚𑆁 𑆓𑆠𑆩𑆩𑇀𑆬𑆨𑆳𑆮𑆩𑇀 𑇅 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆮𑆴𑆥𑆑𑇀𑆮𑆁, 𑆨𑆸𑆯𑆠𑆾𑆢𑆯𑆷𑆬𑆁 𑆮𑆴𑆰𑇀𑆛𑆧𑇀𑆣𑆩𑆳𑆤𑆢𑇀𑆣𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆮𑆳𑆠𑆩𑇀 𑇆𑇕𑇐𑇒𑇆
𑆇𑆢𑇀𑆓𑆳𑆫𑆯𑆶𑆢𑇀𑆣𑆳𑆮𑆥𑆴 𑆨𑆑𑇀𑆠𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳 𑆤 𑆘𑆳𑆪𑆠𑆼 𑆲𑆸𑆢𑇀𑆓𑆶𑆫𑆶𑆠𑆳 𑆖 𑆪𑆱𑇀𑆪 𑇅 𑆫𑆱𑆳𑆮𑆯𑆼𑆰𑆼𑆟 𑆠𑆶 𑆱𑆥𑇀𑆫𑆱𑆼𑆑𑆁 𑆖𑆠𑆶𑆫𑇀𑆡𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆩𑇀 𑇆𑇕𑇐𑇓𑇆
𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆥𑇀𑆫𑆬𑆳𑆥𑆾 𑆮𑆩𑆡𑆶𑆂 𑆥𑇀𑆫𑆱𑆼𑆑𑆂 𑆱𑆢𑆤𑆁 𑆨𑇀𑆫𑆩𑆂 𑇅 𑆇𑆥𑆢𑇀𑆫𑆮𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆼𑆠𑆼 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆠𑆂 𑇆𑇕𑇐𑇔𑇆
𑆠𑆠𑇀𑆫𑆳𑆩𑆼 𑆬𑆕𑇀𑆔𑆤𑆁 𑆑𑆳𑆫𑇀𑆪𑆁, 𑆮𑆴𑆢𑆓𑇀𑆣𑆼 𑆮𑆩𑆤𑆁 𑆲𑆴𑆠𑆩𑇀 𑇅 𑆮𑆴𑆰𑇀𑆛𑆧𑇀𑆣𑆼 𑆱𑇀𑆮𑆼𑆢𑆤𑆁 𑆥𑆡𑇀𑆪𑆁, 𑆫𑆱𑆯𑆼𑆰𑆼 𑆯𑆪𑆵𑆠 𑆖 𑇆𑇕𑇐𑇕𑇆
𑆮𑆳𑆩𑆪𑆼𑆢𑆳𑆯𑆶 𑆠𑆁 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆰𑇀𑆟𑆼𑆤 𑆬𑆮𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑇅 𑆑𑆳𑆫𑇀𑆪𑆁 𑆮𑆳𑇁𑆤𑆯𑆤𑆁 𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆤𑇀𑆤 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆨𑆘𑆼𑆠𑇀 𑇆𑇕𑇐𑇖𑇆
𑆬𑆔𑆶𑆑𑆳𑆪𑆩𑆠𑆯𑇀𑆖𑆽𑆤𑆁 𑆬𑆕𑇀𑆔𑆤𑆽𑆂 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀 𑇅 𑆪𑆳𑆮𑆤𑇀𑆤 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆾𑆰𑆠𑆂 𑆥𑇀𑆫𑆳𑆟𑆠𑆱𑇀𑆠𑆡𑆳 𑇆𑇕𑇐𑇗𑇆
𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆾𑆥𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆩𑆤𑇀𑆤𑆁 𑆱𑆩𑆯𑆤𑆁 𑆱𑇀𑆩𑆸𑆠𑆩𑇀 𑇅 𑆧𑆲𑆶 𑆱𑇀𑆠𑆾𑆑𑆩𑆑𑆳𑆬𑆼 𑆮𑆳 𑆠𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆴𑆰𑆩𑆳𑆯𑆤𑆩𑇀 𑇆𑇕𑇐𑇘𑇆
𑆃𑆘𑆵𑆫𑇀𑆟𑆼 𑆨𑆶𑆘𑇀𑆪𑆠𑆼 𑆪𑆠𑇀𑆠𑆶 𑆠𑆢𑆣𑇀𑆪𑆯𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼 𑇅 𑆠𑇀𑆫𑆪𑆩𑆼𑆠𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆧𑆲𑆷𑆤𑇀𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀𑆑𑆫𑆾𑆠𑆴 𑆮𑆳 𑇆𑇕𑇐𑇙𑇆
𑆃𑆤𑇀𑆤𑆁 𑆮𑆴𑆢𑆓𑇀𑆣𑆁 𑆲𑆴 𑆤𑆫𑆱𑇀𑆪 𑆯𑆵𑆔𑇀𑆫𑆁 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆮𑆽 𑆥𑆫𑆴𑆥𑆳𑆑𑆩𑆼𑆠𑆴 𑇅 𑆠𑆢𑇀𑆣𑇀𑆪𑆱𑇀𑆪 𑆯𑆽𑆠𑇀𑆪𑆼𑆤 𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑆥𑆴𑆠𑇀𑆠𑆩𑆳𑆑𑇀𑆬𑆼𑆢𑆴𑆨𑆳𑆮𑆳𑆖𑇀𑆖 𑆤𑆪𑆠𑇀𑆪𑆣𑆱𑇀𑆠𑆳𑆠𑇀 𑇆𑇕𑇑𑇐𑇆
𑆮𑆴𑆢𑆲𑇀𑆪𑆠𑆼 𑆪𑆱𑇀𑆪 𑆠𑆶 𑆨𑆶𑆑𑇀𑆠𑆩𑆳𑆠𑇀𑆫𑆼 𑆢𑆲𑇀𑆪𑆼𑆠 𑆲𑆸𑆠𑇀𑆑𑆾𑆰𑇀𑆜𑆓𑆬𑆁 𑆖 𑆪𑆱𑇀𑆪 𑇅 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆨𑆪𑆳𑆁 𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆱𑆩𑇀𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆁 𑆬𑆵𑆞𑇀𑆮𑆳𑇁𑆨𑆪𑆳𑆁 𑆮𑆳 𑆱 𑆱𑆶𑆒𑆁 𑆬𑆨𑆼𑆠 𑇆𑇕𑇑𑇑𑇆
𑆨𑆮𑆼𑆢𑆘𑆵𑆫𑇀𑆟𑆁 𑆥𑇀𑆫𑆠𑆴 𑆪𑆱𑇀𑆪 𑆯𑆕𑇀𑆑𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆧𑆬𑆴𑆤𑆾𑇁𑆤𑇀𑆤𑆑𑆳𑆬𑆼 𑇅 𑆥𑇀𑆫𑆳𑆠𑆂 𑆱𑆯𑆶𑆟𑇀𑆜𑆵𑆩𑆨𑆪𑆳𑆩𑆯𑆕𑇀𑆑𑆾 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆯𑇀𑆪 𑆲𑆴𑆠𑆁 𑆲𑆴𑆠𑆳𑆫𑇀𑆡𑆵 𑇆𑇕𑇑𑇒𑇆
𑆱𑇀𑆮𑆬𑇀𑆥𑆁 𑆪𑆢𑆳 𑆢𑆾𑆰𑆮𑆴𑆧𑆢𑇀𑆣𑆩𑆳𑆩𑆁 𑆬𑆵𑆤𑆁 𑆤 𑆠𑆼𑆘𑆂𑆥𑆡𑆩𑆳𑆮𑆸𑆟𑆾𑆠𑆴 𑇅 𑆨𑆮𑆠𑇀𑆪𑆘𑆵𑆫𑇀𑆟𑆼𑇁𑆥𑆴 𑆠𑆢𑆳 𑆧𑆶𑆨𑆶𑆑𑇀𑆰𑆳 𑆪𑆳 𑆩𑆤𑇀𑆢𑆧𑆶𑆢𑇀𑆣𑆴𑆁 𑆮𑆴𑆰𑆮𑆤𑇀𑆤𑆴𑆲𑆤𑇀𑆠𑆴 𑇆𑇕𑇑𑇓𑇆
𑆃𑆠 𑆇𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆓𑆶𑆟𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆩𑆮𑆴𑆱𑇀𑆠𑆫𑆩𑇀 𑇅 𑆑𑆫𑇀𑆩𑆨𑆴𑆱𑇀𑆠𑇀𑆮𑆤𑆶𑆩𑆵𑆪𑆤𑇀𑆠𑆼 𑆤𑆳𑆤𑆳𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳 𑆓𑆶𑆟𑆳𑆂 𑇆𑇕𑇑𑇔𑇆
𑆲𑇀𑆬𑆳𑆢𑆤𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆂 𑆯𑆵𑆠𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆠𑆸𑆛𑇀𑆱𑇀𑆮𑆼𑆢𑆢𑆳𑆲𑆘𑆴𑆠𑇀 𑇅 𑆇𑆰𑇀𑆟𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆥𑆳𑆖𑆤𑆯𑇀𑆖 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇕𑇑𑇕𑇆
𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆫𑇀𑆢𑆮𑆑𑆸𑆠𑇀 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆑𑆫𑆱𑇀𑆠𑆡𑆳 𑇅 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆯𑆼𑆰𑆳𑆠𑇀 𑆱𑇀𑆠𑆩𑇀𑆨𑆤𑆂 𑆒𑆫𑆂 𑇆𑇕𑇑𑇖𑇆
𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆾 𑆘𑆵𑆮𑆤𑆾 𑆧𑆬𑇀𑆪𑆂 𑆱𑆤𑇀𑆣𑆳𑆤𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆬𑆾 𑆓𑆶𑆫𑆶𑆂 𑇅 𑆮𑆴𑆯𑆢𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑇁𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑇀𑆬𑆼𑆢𑆳𑆖𑆷𑆰𑆟𑆫𑆾𑆥𑆟𑆂 𑇆𑇕𑇑𑇗𑇆
𑆢𑆳𑆲𑆥𑆳𑆑𑆑𑆫𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆂 𑆱𑇀𑆫𑆳𑆮𑆟𑆾, 𑆩𑆸𑆢𑆶𑆫𑆤𑇀𑆪𑆡𑆳 𑇅 𑆱𑆳𑆢𑆾𑆥𑆬𑆼𑆥𑆧𑆬𑆑𑆸𑆢𑇀𑆓𑆶𑆫𑆶𑆱𑇀𑆠𑆫𑇀𑆥𑆟𑆧𑆸𑆁𑆲𑆟𑆂 𑇆𑇕𑇑𑇘𑇆
𑆬𑆔𑆶𑆱𑇀𑆠𑆢𑇀𑆮𑆴𑆥𑆫𑆵𑆠𑆂 𑆱𑇀𑆪𑆳𑆬𑇀𑆬𑆼𑆒𑆤𑆾 𑆫𑆾𑆥𑆟𑆱𑇀𑆠𑆡𑆳 𑇅 𑆢𑆯𑆳𑆢𑇀𑆪𑆳𑆂 𑆑𑆫𑇀𑆩𑆠𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆑𑆫𑇀𑆩𑆮𑆴𑆯𑆼𑆰𑆟𑆽𑆂 𑇆𑇕𑇑𑇙𑇆
𑆢𑆯𑆽𑆮𑆳𑆤𑇀𑆪𑆳𑆤𑇀 𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆢𑇀𑆫𑆮𑆳𑆢𑆵𑆁𑆱𑇀𑆠𑆳𑆤𑇀𑆤𑆴𑆧𑆾𑆣 𑆩𑆼 𑇅 𑆢𑇀𑆫𑆮𑆂 𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆤𑆂, 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆂 𑆱𑇀𑆡𑆷𑆬𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆧𑆤𑇀𑆣𑆑𑆳𑆫𑆑𑆂 𑇆𑇕𑇒𑇐𑇆
𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆂 𑆥𑆴𑆖𑇀𑆗𑆴𑆬𑆮𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆂 𑆑𑆫𑇀𑆑𑆯𑆾 𑆮𑆴𑆯𑆢𑆾 𑆪𑆡𑆳 𑇅 𑆱𑆶𑆒𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆵 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆯𑇀𑆖 𑆱𑆶𑆓𑆤𑇀𑆣𑆾 𑆫𑆾𑆖𑆤𑆾 𑆩𑆸𑆢𑆶𑆂 𑇆𑇕𑇒𑇑𑇆
𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆾𑇁𑆱𑇀𑆩𑆳𑆢𑇀𑆣𑆸𑆬𑇀𑆬𑆳𑆱𑆳𑆫𑆶𑆖𑆴𑆑𑆳𑆫𑆑𑆂 𑇅 𑆱𑆫𑆾𑇁𑆤𑆶𑆬𑆾𑆩𑆤𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆾, 𑆩𑆤𑇀𑆢𑆾 𑆪𑆳𑆠𑇀𑆫𑆳𑆑𑆫𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇕𑇒𑇒𑇆
𑆮𑇀𑆪𑆮𑆳𑆪𑆵 𑆖𑆳𑆒𑆴𑆬𑆁 𑆢𑆼𑆲𑆁 𑆮𑇀𑆪𑆳𑆥𑇀𑆪 𑆥𑆳𑆑𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼 𑇅 𑆮𑆴𑆑𑆳𑆱𑆵 𑆮𑆴𑆑𑆱𑆤𑇀𑆤𑆼𑆮𑆁 𑆣𑆳𑆠𑆶𑆧𑆤𑇀𑆣𑆳𑆤𑇀 𑆮𑆴𑆩𑆾𑆑𑇀𑆰𑆪𑆼𑆠𑇀 𑇆𑇕𑇒𑇓𑇆
𑆄𑆯𑆶𑆑𑆳𑆫𑆵 𑆠𑆡𑆳𑇁𑇁𑆯𑆶𑆠𑇀𑆮𑆳𑆢𑇀𑆣𑆳𑆮𑆠𑇀𑆪𑆩𑇀𑆨𑆱𑆴 𑆠𑆽𑆬𑆮𑆠𑇀 𑇅 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆠𑆶 𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆠𑇀 𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆼𑆰𑆶 𑆱𑇀𑆫𑆾𑆠𑆂𑆱𑇀𑆮𑆤𑆶𑆱𑆫𑆂 𑆱𑇀𑆩𑆸𑆠𑆂 𑇆𑇕𑇒𑇔𑇆
𑆥𑆚𑇀𑆖𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆑𑆼 𑆢𑆼𑆲𑆼 𑆲𑇀𑆪𑆳𑆲𑆳𑆫𑆂 𑆥𑆳𑆚𑇀𑆖𑆨𑆿𑆠𑆴𑆑𑆂 𑇅 𑆮𑆴𑆥𑆑𑇀𑆮𑆂 𑆥𑆚𑇀𑆖𑆣𑆳 𑆱𑆩𑇀𑆪𑆓𑇀𑆓𑆶𑆟𑆳𑆤𑇀 𑆱𑇀𑆮𑆳𑆤𑆨𑆴𑆮𑆫𑇀𑆣𑆪𑆼𑆠𑇀 𑇆𑇕𑇒𑇖𑇆
𑆃𑆮𑆴𑆢𑆓𑇀𑆣𑆂 𑆑𑆦𑆁, 𑆥𑆴𑆠𑇀𑆠𑆁 𑆮𑆴𑆢𑆓𑇀𑆣𑆂, 𑆥𑆮𑆤𑆁 𑆥𑆶𑆤𑆂 𑇅 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆥𑆑𑇀𑆮𑆾 𑆤𑆴𑆂𑆱𑆳𑆫 𑆄𑆲𑆳𑆫𑆂 𑆥𑆫𑆴𑆧𑆸𑆁𑆲𑆪𑆼𑆠𑇀 𑇆𑇕𑇒𑇗𑇆
𑆑𑆦𑆂 𑆥𑆴𑆠𑇀𑆠𑆁 𑆩𑆬𑆂 𑆒𑆼𑆰𑆶 𑆱𑇀𑆮𑆼𑆢𑆂 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆒𑆫𑆾𑆩 𑆖 𑇅 𑆤𑆼𑆠𑇀𑆫𑆮𑆴𑆛𑇀 𑆠𑇀𑆮𑆑𑇀𑆰𑆶 𑆖 𑆱𑇀𑆤𑆼𑆲𑆾 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆑𑇀𑆫𑆩𑆯𑆾 𑆩𑆬𑆳𑆂 𑇆𑇕𑇒𑇙𑇆
𑆢𑆴𑆮𑆳 𑆮𑆴𑆧𑆶𑆢𑇀𑆣𑆼 𑆲𑆸𑆢𑆪𑆼 𑆘𑆳𑆓𑇀𑆫𑆠𑆂 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆮𑆠𑇀 𑇅 𑆃𑆤𑇀𑆤𑆩𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆣𑆳𑆠𑆶𑆠𑇀𑆮𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆼𑇁𑆥𑆴 𑆲𑆴𑆠𑆁 𑆤𑆴𑆯𑆴 𑇆𑇕𑇓𑇐𑇆
𑆲𑆸𑆢𑆴 𑆱𑆩𑇀𑆩𑆵𑆬𑆴𑆠𑆼 𑆫𑆳𑆠𑇀𑆫𑆿 𑆥𑇀𑆫𑆱𑆶𑆥𑇀𑆠𑆱𑇀𑆪 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇅 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆮𑆴𑆱𑇀𑆫𑆱𑇀𑆠𑆣𑆳𑆠𑆶𑆠𑇀𑆮𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆼 𑆤 𑆲𑆴𑆠𑆁 𑆢𑆴𑆮𑆳 𑇆𑇕𑇓𑇑𑇆
𑆅𑆩𑆁 𑆮𑆴𑆣𑆴𑆁 𑆪𑆾𑇁𑆤𑆶𑆩𑆠𑆁 𑆩𑆲𑆳𑆩𑆶𑆤𑆼𑆫𑇀𑆤𑆸𑆥𑆫𑇀𑆰𑆴𑆩𑆶𑆒𑇀𑆪𑆱𑇀𑆪 𑆥𑆜𑆼𑆢𑇀𑆣𑆴 𑆪𑆠𑇀𑆤𑆠𑆂 𑇅 𑆱 𑆨𑆷𑆩𑆴𑆥𑆳𑆬𑆳𑆪 𑆮𑆴𑆣𑆳𑆠𑆶𑆩𑆿𑆰𑆣𑆁 𑆩𑆲𑆳𑆠𑇀𑆩𑆤𑆳𑆁 𑆖𑆳𑆫𑇀𑆲𑆠𑆴 𑆱𑆷𑆫𑆴𑆱𑆠𑇀𑆠𑆩𑆂 𑇆𑇕𑇓𑇒𑇆
𑆃𑆡𑆳𑆠 𑆐𑆥𑆢𑇀𑆫𑆮𑆴𑆑𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆

𑆢𑆷𑆫𑇀𑆮𑆳𑆁 𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆁 𑆖𑆽𑆮 𑆬𑆼𑆥𑆼 𑆱𑆳𑆣𑇀𑆮𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇅 𑆩𑆲𑆳𑆱𑆶𑆓𑆤𑇀𑆣𑆳𑆩𑆡𑆮𑆳 𑆥𑆳𑆬𑆴𑆤𑇀𑆢𑆵𑆁 𑆖𑆳𑆩𑇀𑆬𑆥𑆼𑆰𑆴𑆠𑆳𑆩𑇀 𑇆𑇔𑇐𑇆
𑆯𑆵𑆠𑆳𑆁𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆥𑆫𑆵𑆰𑆼𑆑𑆳𑆤𑇀 𑆥𑇀𑆫𑆢𑆼𑆲𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅𑇔𑇑𑇅 𑆃𑆮𑆥𑆵𑆝𑆯𑇀𑆖 𑆢𑆼𑆪𑆾𑇁𑆠𑇀𑆫 𑆱𑆷𑆫𑇀𑆪𑆳𑆮𑆫𑇀𑆠𑆤𑆴𑆮𑆳𑆫𑆟𑆂 𑇆𑇔𑇑𑇆
𑆑𑆸𑆩𑆴𑆑𑇀𑆰𑆪𑆑𑆸𑆠𑆿 𑆲𑆴𑆠𑇀𑆮𑆳 𑆯𑆴𑆫𑆾𑆫𑆾𑆓𑆼𑆰𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇅 𑆩𑆣𑆶𑆠𑆽𑆬𑆱𑆩𑆳𑆪𑆶𑆑𑇀𑆠𑆽𑆂 𑆯𑆴𑆫𑆳𑆁𑆱𑇀𑆪𑆠𑆴𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀 𑇆𑇔𑇒𑇆
𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆱𑆫𑇀𑆰𑆥𑆠𑆽𑆬𑆼𑆤 𑆠𑆠𑆾 𑆤𑆱𑇀𑆪𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇅 𑆤 𑆖𑆼𑆖𑇀𑆗𑆳𑆤𑇀𑆠𑆴𑆁 𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑇀𑆪𑆼𑆮𑆁 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳𑆁𑆱𑇀𑆠𑆠𑆾 𑆨𑆴𑆰𑆑𑇀 𑇆𑇔𑇓𑇆
𑆥𑆯𑇀𑆖𑆳𑆢𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑆴𑆫𑆳𑆟𑆳𑆩𑆡 𑆩𑆾𑆑𑇀𑆰𑆟𑆽𑆂 𑇅 𑆰𑆛𑇀𑆱𑆥𑇀𑆠𑆠𑆴𑆫𑇀𑆤𑆼𑆠𑇀𑆫𑆫𑆾𑆓𑆳 𑆢𑆯𑆳𑆰𑇀𑆛𑆳𑆢𑆯 𑆑𑆫𑇀𑆟𑆘𑆳𑆂 𑇆𑇔𑇔𑇆
𑆍𑆑𑆠𑇀𑆫𑆴𑆁𑆯𑆢𑇀 𑆔𑇀𑆫𑆳𑆟𑆓𑆠𑆳𑆂 𑆯𑆴𑆫𑆱𑇀𑆪𑆼𑆑𑆳𑆢𑆯𑆽𑆮 𑆠𑆶 𑇅 𑆅𑆠𑆴 𑆮𑆴𑆱𑇀𑆠𑆫𑆠𑆾 𑆢𑆸(𑆢𑆴)𑆰𑇀𑆛𑆳𑆂 𑆱𑆬𑆑𑇀𑆰𑆟𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆂 𑇆𑇔𑇕𑇆
𑆱𑆁𑆲𑆴𑆠𑆳𑆪𑆳𑆩𑆨𑆴𑆲𑆴𑆠𑆳𑆂 𑆱𑆥𑇀𑆠𑆰𑆰𑇀𑆛𑆴𑆫𑇀𑆩𑆶𑆒𑆳𑆩𑆪𑆳𑆂 𑇅 𑆍𑆠𑆳𑆮𑆤𑇀𑆠𑆾 𑆪𑆡𑆳𑆱𑇀𑆡𑆷𑆬𑆩𑆶𑆠𑇀𑆠𑆩𑆳𑆕𑇀𑆓𑆓𑆠𑆳 𑆓𑆢𑆳𑆂 𑇅 𑆃𑆱𑇀𑆩𑆴𑆚𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆼 𑆤𑆴𑆓𑆢𑆴𑆠𑆳𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆫𑆷𑆥𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆽𑆂 𑇆𑇔𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆮𑆓𑇀𑆫𑆲𑆳𑆑𑆸𑆠𑆴𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆧𑆳𑆬𑆓𑇀𑆫𑆲𑆳𑆟𑆳𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑆳𑆣𑆤𑆁 𑆖𑆳𑆥𑇀𑆪𑆤𑆤𑇀𑆠𑆫𑆩𑇀 𑇅 𑆇𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆁 𑆑𑆳𑆫𑆟𑆁 𑆖𑆽𑆮 𑆱𑆶𑆯𑇀𑆫𑆶𑆠𑆽𑆑𑆩𑆤𑆳𑆂 𑆯𑆸𑆟𑆶 𑇆𑇓𑇆
𑆱𑇀𑆑𑆤𑇀𑆢𑆓𑇀𑆫𑆲𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆡𑆩𑆂 𑆱𑇀𑆑𑆤𑇀𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫 𑆍𑆮 𑆖 𑇅 𑆯𑆑𑆶𑆤𑆵 𑆫𑆼𑆮𑆠𑆵 𑆖𑆽𑆮 𑆥𑆷𑆠𑆤𑆳 𑆖𑆳𑆤𑇀𑆣𑆥𑆷𑆠𑆤𑆳 𑇆𑇔𑇆
𑆥𑆷𑆠𑆤𑆳 𑆯𑆵𑆠𑆤𑆳𑆩𑆳 𑆖 𑆠𑆡𑆽𑆮 𑆩𑆶𑆒𑆩𑆟𑇀𑆝𑆴𑆑𑆳 𑇅 𑆤𑆮𑆩𑆾 𑆤𑆽𑆓𑆩𑆼𑆰𑆯𑇀𑆖 𑆪𑆂 𑆥𑆴𑆠𑆸𑆓𑇀𑆫𑆲𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆂 𑇆𑇕𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆩𑆳𑆠𑇀𑆫𑆾𑆂 𑆥𑇀𑆫𑆳𑆑𑇀𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆳𑆥𑆖𑆳𑆫𑆳𑆖𑇀𑆗𑆿𑆖𑆨𑇀𑆫𑆰𑇀𑆛𑆳𑆤𑇀𑆩𑆕𑇀𑆓𑆬𑆳𑆖𑆳𑆫𑆲𑆵𑆤𑆳𑆤𑇀 𑇅 𑆠𑇀𑆫𑆱𑇀𑆠𑆳𑆤𑇀 𑆲𑆸𑆰𑇀𑆛𑆳𑆁𑆱𑇀𑆠𑆫𑇀𑆘𑆴𑆠𑆳𑆤𑇀 𑆠𑆳𑆝𑆴𑆠𑆳𑆤𑇀 𑆮𑆳 𑆥𑆷𑆘𑆳𑆲𑆼𑆠𑆾𑆫𑇀𑆲𑆴𑆁𑆱𑇀𑆪𑆶𑆫𑆼𑆠𑆼 𑆑𑆶𑆩𑆳𑆫𑆳𑆤𑇀 𑇆𑇖𑇆
𑆎𑆯𑇀𑆮𑆫𑇀𑆪𑆱𑇀𑆡𑆳𑆱𑇀𑆠𑆼 𑆤 𑆯𑆑𑇀𑆪𑆳 𑆮𑆴𑆯𑆤𑇀𑆠𑆾 𑆢𑆼𑆲𑆁 𑆢𑇀𑆫𑆰𑇀𑆛𑆶𑆁 𑆩𑆳𑆤𑆶𑆰𑆽𑆫𑇀𑆮𑆴𑆯𑇀𑆮𑆫𑆷𑆥𑆳𑆂 𑇅 𑆄𑆥𑇀𑆠𑆁 𑆮𑆳𑆑𑇀𑆪𑆁 𑆠𑆠𑇀𑆱𑆩𑆵𑆑𑇀𑆰𑇀𑆪𑆳𑆨𑆴𑆣𑆳𑆱𑇀𑆪𑆼 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆪𑆳𑆤𑆴 𑆢𑆼𑆲𑆼 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇗𑇆
𑆯𑆷𑆤𑆳𑆑𑇀𑆰𑆂 𑆑𑇀𑆰𑆠𑆘𑆱𑆓𑆤𑇀𑆣𑆴𑆑𑆂 𑆱𑇀𑆠𑆤𑆢𑇀𑆮𑆴𑆝𑇀 𑆮𑆑𑇀𑆫𑆳𑆱𑇀𑆪𑆾 𑆲𑆠𑆖𑆬𑆴𑆠𑆽𑆑𑆥𑆑𑇀𑆰𑇀𑆩𑆤𑆼𑆠𑇀𑆫𑆂 𑇅 𑆇𑆢𑇀𑆮𑆴𑆓𑇀𑆤𑆂 𑆱𑆶𑆬𑆶𑆬𑆴𑆠𑆖𑆑𑇀𑆰𑆶𑆫𑆬𑇀𑆥𑆫𑆾𑆢𑆵 𑆱𑇀𑆑𑆤𑇀𑆢𑆳𑆫𑇀𑆠𑆾 𑆨𑆮𑆠𑆴 𑆖 𑆓𑆳𑆞𑆩𑆶𑆰𑇀𑆛𑆴𑆮𑆫𑇀𑆖𑆳𑆂 𑇆𑇘𑇆
𑆤𑆴𑆂𑆱𑆚𑇀𑆘𑇀𑆚𑆾 𑆨𑆮𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆼𑆠𑇀𑆱𑆱𑆚𑇀𑆘𑇀𑆚𑆂 𑆱𑆁𑆫𑆧𑇀𑆣𑆂 𑆑𑆫𑆖𑆫𑆟𑆽𑆯𑇀𑆖 𑆤𑆸𑆠𑇀𑆪𑆠𑆵𑆮 𑇅 𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆼 𑆱𑆸𑆘𑆠𑆴 𑆮𑆴𑆤𑆢𑇀𑆪 𑆘𑆸𑆩𑇀𑆨𑆩𑆳𑆟𑆂 𑆦𑆼𑆤𑆁 𑆖 𑆥𑇀𑆫𑆱𑆸𑆘𑆠𑆴 𑆠𑆠𑇀𑆱𑆒𑆳𑆨𑆴𑆥𑆤𑇀𑆤𑆂 𑇆𑇙𑇆
𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆾 𑆨𑆪𑆖𑆑𑆴𑆠𑆾 𑆮𑆴𑆲𑆕𑇀𑆓𑆓𑆤𑇀𑆣𑆴𑆂 𑆱𑆁𑆱𑇀𑆫𑆳𑆮𑆴𑆮𑇀𑆫𑆟𑆥𑆫𑆴𑆥𑆵𑆝𑆴𑆠𑆂 𑆱𑆩𑆤𑇀𑆠𑆳𑆠𑇀 𑇅 𑆱𑇀𑆦𑆾𑆛𑆽𑆯𑇀𑆖 𑆥𑇀𑆫𑆖𑆴𑆠𑆠𑆤𑆶𑆂 𑆱𑆢𑆳𑆲𑆥𑆳𑆑𑆽𑆫𑇀𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆨𑆮𑆠𑆴 𑆯𑆴𑆯𑆶𑆂 𑆑𑇀𑆰𑆠𑆂 𑆯𑆑𑆶𑆤𑇀𑆪𑆳 𑇆𑇑𑇐𑇆
𑆫𑆑𑇀𑆠𑆳𑆱𑇀𑆪𑆾 𑆲𑆫𑆴𑆠𑆩𑆬𑆾𑇁𑆠𑆴𑆥𑆳𑆟𑇀𑆝𑆶𑆢𑆼𑆲𑆂 𑆯𑇀𑆪𑆳𑆮𑆾 𑆮𑆳 𑆘𑇀𑆮𑆫𑆩𑆶𑆒𑆥𑆳𑆑𑆮𑆼𑆢𑆤𑆳𑆫𑇀𑆠𑆂 𑇅 𑆫𑆼𑆮𑆠𑇀𑆪𑆳 𑆮𑇀𑆪𑆡𑆴𑆠𑆠𑆤𑆶𑆯𑇀𑆖 𑆑𑆫𑇀𑆟𑆤𑆳𑆱𑆁 𑆩𑆸𑆢𑇀𑆤𑆳𑆠𑆴 𑆣𑇀𑆫𑆶𑆮𑆩𑆨𑆴𑆥𑆵𑆝𑆴𑆠𑆂 𑆑𑆶𑆩𑆳𑆫𑆂 𑇆𑇑𑇑𑇆
𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆕𑇀𑆓𑆂 𑆱𑇀𑆮𑆥𑆴𑆠𑆴 𑆱𑆶𑆒𑆁 𑆢𑆴𑆮𑆳 𑆤 𑆫𑆳𑆠𑇀𑆫𑆿 𑆮𑆴𑆝𑇀 𑆨𑆴𑆤𑇀𑆤𑆁 𑆱𑆸𑆘𑆠𑆴 𑆖 𑆑𑆳𑆑𑆠𑆶𑆬𑇀𑆪𑆓𑆤𑇀𑆣𑆴𑆂 𑇅 𑆗𑆫𑇀𑆢𑇀𑆪𑆳𑇁𑇁𑆫𑇀𑆠𑆾 𑆲𑆸𑆰𑆴𑆠𑆠𑆤𑆷𑆫𑆶𑆲𑆂 𑆑𑆶𑆩𑆳𑆫𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆬𑆶𑆫𑇀𑆨𑆮𑆠𑆴 𑆖 𑆥𑆷𑆠𑆤𑆳𑆓𑆸𑆲𑆵𑆠𑆂 𑇆𑇑𑇒𑇆
𑆪𑆾 𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆴 𑆱𑇀𑆠𑆤𑆩𑆠𑆴𑆱𑆳𑆫𑆑𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆖𑇀𑆗𑆫𑇀𑆢𑆵𑆨𑆴𑆫𑇀𑆘𑇀𑆮𑆫𑆱𑆲𑆴𑆠𑆳𑆨𑆴𑆫𑆫𑇀𑆢𑇀𑆪𑆩𑆳𑆤𑆂 𑇅 𑆢𑆶𑆫𑇀𑆮𑆫𑇀𑆟𑆂 𑆱𑆠𑆠𑆩𑆣𑆂𑆯𑆪𑆾𑇁𑆩𑇀𑆬𑆓𑆤𑇀𑆣𑆴𑆱𑇀𑆠𑆁 𑆧𑇀𑆫𑆷𑆪𑆶𑆫𑇀𑆨𑆴𑆰𑆘 𑆅𑆲𑆳𑆤𑇀𑆣𑆥𑆷𑆠𑆤𑆳𑆫𑇀𑆠𑆩𑇀 𑇆𑇑𑇓𑇆
𑆇𑆢𑇀𑆮𑆴𑆓𑇀𑆤𑆾 𑆨𑆸𑆯𑆩𑆠𑆴𑆮𑆼𑆥𑆠𑆼 𑆥𑇀𑆫𑆫𑆶𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆁𑆬𑆵𑆤𑆂 𑆱𑇀𑆮𑆥𑆴𑆠𑆴 𑆖 𑆪𑆱𑇀𑆪 𑆖𑆳𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆂 𑇅 𑆮𑆴𑆱𑇀𑆫𑆳𑆕𑇀𑆓𑆾 𑆨𑆸𑆯𑆩𑆠𑆴𑆱𑆳𑆫𑇀𑆪𑆠𑆼 𑆖 𑆪𑆱𑇀𑆠𑆁 𑆘𑆳𑆤𑆵𑆪𑆳𑆢𑇀𑆨𑆴𑆰𑆓𑆴𑆲 𑆯𑆵𑆠𑆥𑆷𑆠𑆤𑆳𑆫𑇀𑆠𑆩𑇀 𑇆𑇑𑇔𑇆
𑆩𑇀𑆬𑆳𑆤𑆳𑆕𑇀𑆓𑆂 𑆱𑆶𑆫𑆶𑆖𑆴𑆫𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆮𑆑𑇀𑆠𑇀𑆫𑆾 𑆧𑆲𑇀𑆮𑆳𑆯𑆵 𑆑𑆬𑆶𑆰𑆱𑆴𑆫𑆳𑆮𑆸𑆠𑆾𑆢𑆫𑆾 𑆪𑆂 𑇅 𑆱𑆾𑆢𑇀𑆮𑆼𑆓𑆾 𑆨𑆮𑆠𑆴 𑆖 𑆩𑆷𑆠𑇀𑆫𑆠𑆶𑆬𑇀𑆪𑆓𑆤𑇀𑆣𑆴𑆂 𑆱 𑆘𑇀𑆚𑆼𑆪𑆂 𑆯𑆴𑆯𑆶𑆫𑆴𑆲 𑆮𑆑𑇀𑆠𑇀𑆫𑆩𑆟𑇀𑆝𑆴𑆑𑆳𑆫𑇀𑆠𑆂 𑇆𑇑𑇕𑇆
𑆪𑆂 𑆦𑆼𑆤𑆁 𑆮𑆩𑆠𑆴 𑆮𑆴𑆤𑆩𑇀𑆪𑆠𑆼 𑆖 𑆩𑆣𑇀𑆪𑆼 𑆱𑆾𑆢𑇀𑆮𑆼𑆓𑆩𑇀 𑆮𑆴𑆬𑆥𑆠𑆴 𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆩𑆵𑆑𑇀𑆰𑆩𑆳𑆟𑆂 𑇅 𑆘𑇀𑆮𑆫𑇀𑆪𑆼𑆠 𑆥𑇀𑆫𑆠𑆠𑆩𑆡𑆾 𑆮𑆱𑆳𑆱𑆓𑆤𑇀𑆣𑆴𑆫𑇀𑆤𑆴𑆂𑆱𑆚𑇀𑆘𑇀𑆚𑆾 𑆨𑆮𑆠𑆴 𑆲𑆴 𑆤𑆽𑆓𑆩𑆼𑆰𑆘𑆶𑆰𑇀𑆛𑆂 𑇆𑇑𑇖𑇆

𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆬𑆱𑇀𑆪𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆫𑆶𑆖𑆴𑆓𑆿𑆫𑆮𑆽𑆂𑇅 𑆱𑆩𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆓𑇀𑆬𑆳𑆤𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆮𑆸𑆠𑆩𑇀𑇆𑇓𑇒𑇆
𑆑𑆰𑆳𑆪𑆑𑆛𑆶𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆰𑇀𑆟𑆽𑆂 𑆱𑆶𑆫𑆳𑆩𑆷𑆠𑇀𑆫𑆾𑆥𑆱𑆳𑆣𑆴𑆠𑆽𑆂𑇅 𑆦𑆬𑆠𑆽𑆬𑆪𑆶𑆠𑆽𑆂 𑆱𑆳𑆩𑇀𑆬𑆽𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆨𑆴𑆱𑇀𑆠𑆁 𑆮𑆴𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆠𑇀𑇆𑇓𑇓𑇆
𑆗𑆫𑇀𑆢𑆴𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆫𑆶𑆖𑆴𑆓𑇀𑆬𑆳𑆤𑆴𑆯𑆷𑆬𑆤𑆴𑆢𑇀𑆫𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆤𑆽𑆂 𑇅 𑆄𑆩𑆬𑆴𑆕𑇀𑆓𑆽𑆂 𑆱𑆢𑆳𑆲𑆽𑆱𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆠𑇀𑆪𑆯𑆤𑆳𑆮𑆸𑆠𑆩𑇀𑇆𑇓𑇔𑇆
𑆑𑆛𑆷𑆤𑆳𑆁 𑆬𑆮𑆟𑆳𑆤𑆳𑆁 𑆖 𑆑𑇀𑆮𑆳𑆡𑆽𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆽𑆯𑇀𑆖 𑆥𑆳𑆖𑆤𑆩𑇀𑇅 𑆮𑆴𑆫𑆼𑆑𑆾 𑆩𑆸𑆢𑆶𑆫𑆠𑇀𑆫𑆳𑆩𑆮𑆴𑆲𑆴𑆠𑆳 𑆖 𑆑𑇀𑆫𑆴𑆪𑆳 𑆲𑆴𑆠𑆳𑇆𑇓𑇕𑇆
𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆳𑆤𑆴𑆬𑆱𑆕𑇀𑆓𑆳𑆫𑇀𑆠𑆴𑆓𑆶𑆫𑆶𑆠𑇀𑆮𑆳𑆣𑇀𑆩𑆳𑆤𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆽𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆁 𑆮𑆴𑆝𑆳𑆮𑆸𑆠𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆽𑆂 𑆱𑆮𑆫𑇀𑆠𑆴𑆨𑆴𑆂𑇆𑇓𑇖𑇆
𑆯𑇀𑆪𑆳𑆩𑆳𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆽𑆯𑇀𑆖 𑆤𑆴𑆫𑆷𑆲𑆽𑆂 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆽𑆂𑇅 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑇀𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆩𑇀𑆪𑆓𑆶𑆢𑆳𑆮𑆫𑇀𑆠𑆲𑆫𑆼𑆟 𑆖𑇆𑇓𑇗𑇆
𑆃𑆨𑆶𑆑𑇀𑆠𑆼 𑆯𑆷𑆤𑇀𑆪𑆥𑆳𑆪𑆿 𑆮𑆳 𑆮𑆼𑆓𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆾𑇁𑆠𑆴𑆥𑆵𑆝𑆴𑆠𑆂𑇅 𑆣𑆳𑆮𑆠𑇀𑆪𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆠𑆠𑆂 𑆑𑆟𑇀𑆜𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆼𑆨𑇀𑆪𑆂 𑆒𑆼𑆨𑇀𑆪 𑆍𑆠𑇀𑆪𑆥𑆴𑇆𑇓𑇘𑇆
𑆩𑆷𑆠𑇀𑆫𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆾 𑆪𑆮𑆑𑆾𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆮𑆳𑆤𑇀𑇅 𑆠𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆠𑆽𑆬 𑆅𑆰𑇀𑆛𑆾𑇁𑆠𑇀𑆫 𑆤𑆴𑆫𑆷𑆲𑆂 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆂𑇆𑇓𑇙𑇆
𑆑𑆟𑇀𑆜𑆳𑆢𑆳𑆓𑆖𑇀𑆗𑆠𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆑𑆟𑇀𑆜𑆓𑇀𑆫𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂𑇅 𑆗𑆫𑇀𑆢𑆴𑆔𑇀𑆤𑆵𑆨𑆴𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑆨𑆴𑆯𑇀𑆖 𑆠𑆱𑇀𑆪 𑆑𑆳𑆫𑇀𑆪𑆁 𑆤𑆴𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇆𑇔𑇐𑇆
𑆪𑆱𑇀𑆪 𑆤𑆾𑆥𑆢𑇀𑆫𑆮𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆫𑆤𑆴𑆂𑆱𑆸𑆠𑆂𑇅 𑆱𑆫𑇀𑆮𑆼𑇁𑆬𑇀𑆥𑆾 𑆮𑆳𑇁𑇁𑆮𑆸𑆠𑆾 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆢𑆶𑆥𑆼𑆑𑇀𑆰𑇀𑆪𑆂 𑆱 𑆮𑆴𑆘𑆳𑆤𑆠𑆳𑇆𑇔𑇑𑇆
𑆪𑆶𑆑𑇀𑆠𑆱𑇀𑆤𑆼𑆲𑆁 𑆢𑇀𑆫𑆮𑆾𑆰𑇀𑆟𑆁 𑆖 𑆬𑆔𑆶𑆥𑆡𑇀𑆪𑆾𑆥𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀 𑆩𑆳𑆠𑇀𑆫𑆪𑆳 𑆨𑆾𑆘𑇀𑆪𑆩𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑇆𑇔𑇒𑇆
𑆣𑆳𑆤𑇀𑆪𑆤𑆳𑆓𑆫𑆱𑆴𑆢𑇀𑆣𑆁 𑆲𑆴 𑆠𑆾𑆪𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆖𑆑𑇀𑆰𑆟𑆂𑇅 𑆮𑇀𑆪𑆶𑆰𑆴𑆠𑆳𑆪 𑆤𑆴𑆯𑆳𑆁 𑆑𑆬𑇀𑆪𑆩𑆶𑆰𑇀𑆟𑆁 𑆮𑆳 𑆑𑆼𑆮𑆬𑆁 𑆘𑆬𑆩𑇀𑇆𑇔𑇓𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆘𑆵𑆫𑇀𑆟𑆁 𑆘𑆫𑆪𑆠𑆴 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆁 𑆠𑆢𑇀𑆨𑆴𑆤𑆠𑇀𑆠𑆴 𑆖𑇅 𑆩𑆳𑆫𑆶𑆠𑆱𑇀𑆪𑆳𑆤𑆶𑆬𑆾𑆩𑇀𑆪𑆁 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆁 𑆤𑆸𑆟𑆳𑆩𑇀𑇆𑇔𑇔𑇆
𑆮𑆩𑆤𑆼 𑆖 𑆮𑆴𑆫𑆼𑆑𑆼 𑆖 𑆤𑆴𑆫𑆷𑆲𑆼 𑆱𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆼𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆰𑇀𑆟𑆾𑆢𑆑𑆁 𑆢𑆼𑆪𑆁 𑆮𑆳𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇆𑇔𑇕𑇆
𑆫𑆷𑆑𑇀𑆰𑆤𑆴𑆠𑇀𑆪𑆱𑇀𑆠𑆶 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆴𑆫𑇀𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆵 𑆩𑆳𑆫𑆶𑆠𑆳𑆩𑆪𑆵𑇅 𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆯𑇀𑆫𑆾𑆟𑇀𑆪𑆶𑆢𑆳𑆮𑆸𑆠𑇀𑆠𑆮𑆳𑆠𑆳𑆯𑇀𑆖𑆳𑆫𑇀𑆲𑆳 𑆢𑆴𑆤𑆼 𑆢𑆴𑆤𑆼𑇆𑇔𑇖𑇆
𑆍𑆰𑆳𑆁 𑆖𑆳𑆯𑆶 𑆘𑆫𑆳𑆁 𑆱𑇀𑆤𑆼𑆲𑆾 𑆪𑆳𑆠𑇀𑆪𑆩𑇀𑆧𑆶 𑆱𑆴𑆑𑆠𑆳𑆱𑇀𑆮𑆴𑆮𑇅 𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆠𑇀𑆥𑇀𑆫𑆳𑆪𑆂 𑆱𑇀𑆤𑆼𑆲𑆁 𑆥𑆖𑆠𑆴 𑆥𑆳𑆮𑆑𑆂𑇆𑇔𑇗𑇆
𑆤 𑆠𑇀𑆮𑆳𑆩𑆁 𑆥𑇀𑆫𑆟𑆪𑆼𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆁 𑆱 𑆲𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆼𑆢𑇀𑆓𑆶𑆢𑆩𑇀𑇅 𑆱𑆳𑆮𑆯𑆼𑆰𑆁 𑆖 𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆮𑆳𑆪𑆶𑆂 𑆯𑆼𑆰𑆼 𑆲𑆴 𑆠𑆴𑆰𑇀𑆜𑆠𑆴𑇆𑇔𑇘𑇆
𑆤 𑆖𑆽𑆮 𑆓𑆶𑆢𑆑𑆟𑇀𑆜𑆳𑆨𑇀𑆪𑆳𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆩𑆤𑆤𑇀𑆠𑆫𑆩𑇀𑇅 𑆇𑆨𑆪𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆩𑆁 𑆓𑆖𑇀𑆗𑆤𑇀 𑆮𑆳𑆠𑆩𑆓𑇀𑆤𑆴𑆁 𑆖 𑆢𑆷𑆰𑆪𑆼𑆠𑇀𑇆𑇔𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆁 𑆤𑆴𑆫𑆷𑆲𑆁 𑆮𑆳 𑆤𑆽𑆑𑆩𑆼𑆮𑆳𑆠𑆴𑆯𑆵𑆬𑆪𑆼𑆠𑇀𑇅 𑆇𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆳𑆓𑇀𑆤𑆴𑆮𑆣𑆿 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑇀𑆤𑆴𑆫𑆷𑆲𑆳𑆠𑇀 𑆥𑆮𑆤𑆳𑆢𑇀𑆨𑆪𑆩𑇀𑇆𑇕𑇐𑇆
𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤𑆴𑆫𑆷𑆞𑆂 𑆱𑆁𑆱𑇀𑆤𑆼𑆲𑇀𑆪𑆾 𑆤𑆴𑆫𑆷𑆲𑇀𑆪𑆯𑇀𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑆴𑆠𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆯𑆾𑆣𑆤𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆽𑆮𑆁 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆤𑆶𑆠𑇀𑇆𑇕𑇑𑇆
𑆑𑆫𑇀𑆩𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆨𑆳𑆫𑆳𑆣𑇀𑆮𑆪𑆳(𑆥𑆳)𑆤𑆱𑇀𑆠𑇀𑆫𑆵𑆑𑆫𑇀𑆰𑆴𑆠𑆼𑆰𑆶 𑆖𑇅 𑆢𑆶𑆫𑇀𑆧𑆬𑆼 𑆮𑆳𑆠𑆨𑆓𑇀𑆤𑆼 𑆖 𑆩𑆳𑆠𑇀𑆫𑆳𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑆢𑆳 𑆩𑆠𑆂𑇆𑇕𑇒𑇆
𑆪𑆡𑆼𑆰𑇀𑆛𑆳𑆲𑆳𑆫𑆖𑆼𑆰𑇀𑆛𑆱𑇀𑆪 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆁 𑆤𑆴𑆫𑆠𑇀𑆪𑆪𑆂𑇅 𑆲𑇀𑆫𑆱𑇀𑆮𑆳𑆪𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆠𑇀𑆫𑆳𑆪𑆳 𑆩𑆳𑆠𑇀𑆫𑆳𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑆩𑆾 𑆨𑆮𑆼𑆠𑇀𑇆𑇕𑇓𑇆
𑆧𑆬𑇀𑆪𑆁 𑆱𑆶𑆒𑆾𑆥𑆖𑆫𑇀𑆪𑆁 𑆖 𑆱𑆶𑆒𑆁 𑆱𑆸𑆰𑇀𑆛𑆥𑆶𑆫𑆵𑆰𑆑𑆸𑆠𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆴𑆣𑆳𑆤𑆁 𑆲𑆴 𑆧𑆸𑆁𑆲𑆟𑆁 𑆮𑆳𑆠𑆫𑆾𑆓𑆤𑆶𑆠𑇀𑇆𑇕𑇔𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆮𑆳𑆠𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆩𑆳𑆪𑆾𑆑𑇀𑆠𑆳𑆂 𑆥𑇀𑆫𑆮𑆫𑆳𑆂 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆪𑆂𑇅 𑆠𑆼𑆰𑆳𑆁 𑆖𑆳𑆘𑇀𑆚𑆥𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆂𑇆𑇕𑇕𑇆
𑆥𑇀𑆫𑆳𑆓𑇀𑆨𑆾𑆘𑇀𑆪𑆁 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆼𑆫𑇀𑆪𑆢𑇀 𑆣𑇀𑆫𑆶𑆮𑆁 𑆪𑆼𑇁𑆫𑇀𑆲𑆳𑆱𑇀𑆠𑇀𑆫𑇀𑆪𑆲𑆳𑆖𑇀𑆖 𑆪𑆼 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆣𑆴𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆾 𑆩𑆳𑆠𑇀𑆫𑆳𑆧𑆱𑇀𑆠𑆴𑆮𑆴𑆣𑆴𑆱𑇀𑆠𑆡𑆳𑇆𑇕𑇖𑇆
𑆃𑆡𑆳𑆠𑆾 𑆤𑆼𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆱𑆴𑆢𑇀𑆣𑆴𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆡 𑆤𑆼𑆠𑇀𑆫𑆳𑆟𑆴 𑆧𑆱𑇀𑆠𑆵𑆁𑆯𑇀𑆖 𑆯𑆸𑆟𑆶 𑆮𑆫𑇀𑆘𑇀𑆪𑆳𑆤𑆴 𑆑𑆫𑇀𑆩𑆱𑆶𑇅 𑆤𑆼𑆠𑇀𑆫𑆱𑇀𑆪𑆳𑆘𑇀𑆚𑆥𑇀𑆫𑆟𑆵𑆠𑆱𑇀𑆪 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆳𑆂𑇆𑇓𑇆
𑆲𑇀𑆫𑆱𑇀𑆮𑆁 𑆢𑆵𑆫𑇀𑆔𑆁 𑆠𑆤𑆶 𑆱𑇀𑆡𑆷𑆬𑆁 𑆘𑆵𑆫𑇀𑆟𑆁 𑆯𑆴𑆡𑆴𑆬𑆧𑆤𑇀𑆣𑆤𑆩𑇀𑇅 𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆖𑇀𑆗𑆴𑆢𑇀𑆫𑆁 𑆠𑆡𑆳 𑆮𑆑𑇀𑆫𑆩𑆰𑇀𑆛𑆿 𑆤𑆼𑆠𑇀𑆫𑆳𑆟𑆴 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇔𑇆
𑆃𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑇀𑆪𑆠𑆴𑆓𑆠𑆴𑆑𑇀𑆰𑆾𑆨𑆑𑆫𑇀𑆰𑆟𑆑𑇀𑆰𑆟𑆤𑆱𑇀𑆫𑆮𑆳𑆂𑇅 𑆓𑆶𑆢𑆥𑆵𑆝𑆳 𑆓𑆠𑆴𑆫𑇀𑆘𑆴𑆲𑇀𑆩𑆳 𑆠𑆼𑆰𑆳𑆁 𑆢𑆾𑆰𑆳 𑆪𑆡𑆳𑆑𑇀𑆫𑆩𑆩𑇀𑇆𑇕𑇆
𑆮𑆴𑆰𑆩𑆩𑆳𑆁𑆱𑆬𑆖𑇀𑆗𑆴𑆤𑇀𑆤𑆱𑇀𑆡𑆷𑆬𑆘𑆳𑆬𑆴𑆑𑆮𑆳𑆠𑆬𑆳𑆂𑇅 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆯𑇀𑆖 𑆠𑆳𑆤𑆰𑇀𑆛𑆿 𑆧𑆱𑇀𑆠𑆵𑆤𑇀 𑆑𑆫𑇀𑆩𑆱𑆶 𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇆𑇖𑇆
𑆓𑆠𑆴𑆮𑆽𑆰𑆩𑇀𑆪𑆮𑆴𑆱𑇀𑆫𑆠𑇀𑆮𑆱𑇀𑆫𑆳𑆮𑆢𑆿𑆫𑇀𑆓𑇀𑆫𑆳𑆲𑇀𑆪𑆤𑆴𑆱𑇀𑆫𑆮𑆳𑆂𑇅 𑆦𑆼𑆤𑆴𑆬𑆖𑇀𑆪𑆶𑆠𑇀𑆪𑆣𑆳𑆫𑇀𑆪𑆠𑇀𑆮𑆁 𑆧𑆱𑇀𑆠𑆼𑆂 𑆱𑇀𑆪𑆶𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆢𑆾𑆰𑆠𑆂𑇆𑇗𑇆
𑆱𑆮𑆳𑆠𑆳𑆠𑆴𑆢𑇀𑆫𑆶𑆠𑆾𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠𑆠𑆴𑆫𑇀𑆪𑆓𑆶𑆬𑇀𑆬𑆶𑆥𑇀𑆠𑆑𑆩𑇀𑆥𑆴𑆠𑆳𑆂𑇅 𑆃𑆠𑆴𑆧𑆳𑆲𑇀𑆪𑆓𑆩𑆤𑇀𑆢𑆳𑆠𑆴𑆮𑆼𑆓𑆢𑆾𑆰𑆳𑆂 𑆥𑇀𑆫𑆟𑆼𑆠𑆸𑆠𑆂𑇆𑇘𑇆
𑆃𑆤𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑇀𑆪 𑆖 𑆧𑆢𑇀𑆣𑆼 𑆮𑆳 𑆢𑆠𑇀𑆠𑆼 𑆤𑆴𑆂𑆯𑆼𑆰 𑆍𑆮 𑆮𑆳𑇅 𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪 𑆑𑆶𑆥𑆴𑆠𑆾 𑆮𑆳𑆪𑆶𑆂 𑆯𑆷𑆬𑆠𑆾𑆢𑆑𑆫𑆾 𑆨𑆮𑆼𑆠𑇀𑇆𑇙𑇆
𑆠𑆠𑇀𑆫𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆾 𑆓𑆶𑆢𑆼 𑆱𑇀𑆮𑆼𑆢𑆾 𑆮𑆳𑆠𑆔𑇀𑆤𑆳𑆤𑇀𑆪𑆯𑆤𑆳𑆤𑆴 𑆖𑇅𑇑𑇐𑇅 𑆢𑇀𑆫𑆶𑆠𑆁 𑆥𑇀𑆫𑆟𑆵𑆠𑆼 𑆤𑆴𑆰𑇀𑆑𑆸𑆰𑇀𑆛𑆼 𑆱𑆲𑆱𑆾𑆠𑇀𑆑𑇀𑆰𑆴𑆥𑇀𑆠 𑆍𑆮 𑆮𑆳𑇆𑇑𑇐𑇆
𑆱𑇀𑆪𑆳𑆠𑇀 𑆑𑆛𑆵𑆓𑆶𑆢𑆘𑆕𑇀𑆔𑆳𑆫𑇀𑆠𑆴𑆧𑆱𑇀𑆠𑆴𑆱𑇀𑆠𑆩𑇀𑆨𑆾𑆫𑆶𑆮𑆼𑆢𑆤𑆳𑆂 𑇅 𑆨𑆾𑆘𑆤𑆁 𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆔𑇀𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆱𑇀𑆮𑆼𑆢𑆳𑆂 𑆱𑆧𑆱𑇀𑆠𑆪𑆂𑇆𑇑𑇑𑇆
𑆠𑆴𑆫𑇀𑆪𑆓𑇀𑆮𑆬𑇀𑆪𑆳𑆮𑆸𑆠𑆢𑇀𑆮𑆳𑆫𑆼 𑆧𑆢𑇀𑆣𑆼 𑆮𑆳𑇁𑆥𑆴 𑆤 𑆓𑆖𑇀𑆗𑆠𑆴𑇅 𑆤𑆼𑆠𑇀𑆫𑆼 𑆠𑆢𑆸𑆘𑆶 𑆤𑆴𑆰𑇀𑆑𑆸𑆰𑇀𑆪 𑆱𑆁𑆯𑆾𑆣𑇀𑆪 𑆖 𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆠𑇀𑇆𑇑𑇒𑇆
𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆼𑇁𑆤𑇀𑆠𑆫𑆳 𑆩𑆶𑆑𑇀𑆠𑆼 𑆓𑆶𑆢𑆼 𑆥𑇀𑆫𑆠𑆴𑆲𑆠𑆾𑇁𑆤𑆴𑆬𑆂𑇅 𑆇𑆫𑆂𑆯𑆴𑆫𑆾𑆫𑇀𑆠𑆴𑆩𑆷𑆫𑇀𑆮𑆾𑆯𑇀𑆖 𑆱𑆢𑆤𑆁 𑆘𑆤𑆪𑆼𑆢𑇀𑆧𑆬𑆵𑇆𑇑𑇓𑇆
𑆧𑆱𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀𑆠𑆠𑇀𑆫 𑆧𑆴𑆬𑇀𑆮𑆳𑆢𑆴𑆦𑆬𑆯𑇀𑆪𑆳𑆩𑆳𑆢𑆴𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆤𑇀𑇅 𑆱𑇀𑆪𑆳𑆢𑇀𑆢𑆳𑆲𑆾 𑆢𑆮𑆡𑆶𑆂 𑆯𑆾𑆦𑆂 𑆑𑆩𑇀𑆥𑆤𑆳𑆨𑆴𑆲𑆠𑆼 𑆓𑆶𑆢𑆼𑇆𑇑𑇔𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆳𑆂 𑆯𑆵𑆠𑆳𑆂 𑆱𑆼𑆑𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆱𑆧𑆱𑇀𑆠𑆪𑆂𑇅𑇑𑇕𑇅 𑆃𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆵𑆠𑆼𑆤 𑆤𑆼𑆠𑇀𑆫𑆼𑆟 𑆑𑇀𑆰𑆟𑆤𑆳𑆢𑇀𑆮𑆬𑆼𑆂𑇆𑇑𑇕𑇆
𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆳𑆫𑇀𑆠𑆴 𑆢𑆳𑆲𑆤𑆴𑆱𑇀𑆠𑆾𑆢𑆓𑆶𑆢𑆮𑆫𑇀𑆖𑆂𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆖𑆶𑆂 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆴𑆖𑇀𑆗𑆳𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇖𑇆
𑆤 𑆨𑆳𑆮𑆪𑆠𑆴 𑆩𑆤𑇀𑆢𑆱𑇀𑆠𑆶 𑆧𑆳𑆲𑇀𑆪𑆱𑇀𑆠𑇀𑆮𑆳𑆯𑆶 𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆠𑆠𑇀𑆫 𑆥𑆶𑆤𑆂 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆟𑆼𑆪𑆂 𑆱𑆴𑆢𑇀𑆣𑆴𑆩𑆴𑆖𑇀𑆗𑆠𑆳𑇆𑇑𑇗𑇆
𑆃𑆠𑆴𑆥𑇀𑆫𑆥𑆵𑆝𑆴𑆠𑆂 𑆑𑆾𑆰𑇀𑆜𑆼 𑆠𑆴𑆰𑇀𑆜𑆠𑇀𑆪𑆳𑆪𑆳𑆠𑆴 𑆮𑆳 𑆓𑆬𑆩𑇀𑇅 𑆠𑆠𑇀𑆫 𑆧𑆱𑇀𑆠𑆴𑆫𑇀𑆮𑆴𑆫𑆼𑆑𑆯𑇀𑆖 𑆓𑆬𑆥𑆵𑆝𑆳𑆢𑆴 𑆑𑆫𑇀𑆩 𑆖𑇆𑇑𑇘𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆤𑆼𑆠𑇀𑆫𑆧𑆱𑇀𑆠𑆴𑆥𑇀𑆫𑆟𑆼𑆠𑆹𑆟𑆳𑆁 𑆢𑆾𑆰𑆳𑆤𑆼𑆠𑆳𑆤𑇀 𑆱𑆨𑆼𑆰𑆘𑆳𑆤𑇀𑇅 𑆮𑆼𑆠𑇀𑆠𑆴 𑆪𑆱𑇀𑆠𑆼𑆤 𑆩𑆠𑆴𑆩𑆳𑆤𑇀 𑆧𑆱𑇀𑆠𑆴𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇆
𑆃𑆡 𑆯𑆾𑆣𑆤𑆪𑆾𑆂 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆣𑆴𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆳𑆤𑆶𑆬𑆾𑆩𑆪𑆾𑆂𑇅 𑆃𑆱𑆩𑇀𑆪𑆑𑇀𑆑𑆸𑆠𑆪𑆾𑆯𑇀𑆖𑆽𑆮 𑆢𑆾𑆰𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆱𑆿𑆰𑆣𑆳𑆤𑇀𑇆𑇓𑇆
𑆃𑆠𑇀𑆪𑆶𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆯𑆵𑆠𑆳 𑆲𑆴 𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆫𑇀𑆰𑆳𑆲𑆴𑆩𑆳𑆓𑆩𑆳𑆂𑇅 𑆠𑆢𑆤𑇀𑆠𑆫𑆼 𑆥𑇀𑆫𑆳𑆮𑆸𑆝𑆳𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆱𑆳𑆣𑆳𑆫𑆟𑆳𑆱𑇀𑆠𑇀𑆫𑆪𑆂𑇆𑇔𑇆
𑆥𑇀𑆫𑆳𑆮𑆸𑆛𑇀 𑆯𑆶𑆖𑆴𑆤𑆨𑆿 𑆘𑇀𑆚𑆼𑆪𑆿 𑆯𑆫𑆢𑆷𑆫𑇀𑆘𑆱𑆲𑆿 𑆥𑆶𑆤𑆂𑇅 𑆠𑆥𑆱𑇀𑆪𑆯𑇀𑆖 𑆩𑆣𑆶𑆯𑇀𑆖𑆽𑆮 𑆮𑆱𑆤𑇀𑆠𑆂 𑆯𑆾𑆣𑆤𑆁 𑆥𑇀𑆫𑆠𑆴𑇆𑇕𑇆
𑆍𑆠𑆳𑆤𑆸𑆠𑆷𑆤𑇀 𑆮𑆴𑆑𑆬𑇀𑆥𑇀𑆪𑆽𑆮𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆨𑆴𑆰𑆑𑇀𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆩𑆨𑆴𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆮𑇀𑆪𑆳𑆣𑆿 𑆮𑇀𑆪𑆳𑆣𑆴𑆮𑆯𑆼𑆤 𑆠𑆶𑇆𑇖𑇆
𑆑𑆫𑇀𑆩𑆟𑆳𑆁 𑆮𑆩𑆤𑆳𑆢𑆵𑆤𑆳𑆩𑆤𑇀𑆠𑆫𑆼𑆰𑇀𑆮𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆖𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆥𑇀𑆫𑆪𑆶𑆚𑇀𑆘𑆵𑆠 𑆱𑇀𑆤𑆼𑆲𑆁 𑆖𑆳𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇗𑇆
𑆮𑆴𑆱𑆫𑇀𑆥𑆥𑆴𑆝𑆑𑆳𑆯𑆾𑆦𑆑𑆳𑆩𑆬𑆳𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆴𑆟𑆂 𑇅 𑆃𑆨𑆴𑆔𑆳𑆠𑆮𑆴𑆰𑆳𑆫𑇀𑆠𑆳𑆁𑆯𑇀𑆖 𑆤𑆳𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆤𑇀 𑆮𑆴𑆫𑆼𑆖𑆪𑆼𑆠𑇀𑇆𑇘𑇆
𑆤𑆳𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆯𑆫𑆵𑆫𑆳𑆪 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆱𑇀𑆤𑆼𑆲𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆯𑆫𑆵𑆫𑆳𑆪 𑆫𑆷𑆑𑇀𑆰𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆥𑆤𑇀𑆤𑆼𑆤 𑆘𑆵𑆫𑇀𑆟𑆼 𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆍𑆑𑆳𑆓𑇀𑆫𑆩𑆤𑆱𑆳 𑆥𑆵𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆪𑆾𑆓𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼𑇆𑇑𑇐𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆠𑇀 𑆥𑆳𑆠𑇀𑆫𑆳𑆢𑇀𑆪𑆡𑆳 𑆠𑆾𑆪𑆩𑆪𑆠𑇀𑆤𑆼𑆤 𑆥𑇀𑆫𑆟𑆶𑆢𑇀𑆪𑆠𑆼𑇅 𑆑𑆦𑆳𑆢𑆪𑆂 𑆥𑇀𑆫𑆟𑆶𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆢𑇀𑆢𑆼𑆲𑆳𑆠𑇀𑆠𑆡𑆿𑆰𑆣𑆽𑆂𑇆𑇑𑇑𑇆
𑆄𑆫𑇀𑆢𑇀𑆫𑆁 𑆑𑆳𑆰𑇀𑆜𑆁 𑆪𑆡𑆳 𑆮𑆲𑇀𑆤𑆴𑆫𑇀𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆠𑆴 𑆱𑆫𑇀𑆮𑆠𑆂𑇅 𑆠𑆡𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆪 𑆮𑆽 𑆢𑆾𑆰𑆳𑆤𑇀 𑆱𑇀𑆮𑆼𑆢𑆾 𑆮𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆼𑆠𑇀 𑆱𑇀𑆡𑆴𑆫𑆳𑆤𑇀𑇆𑇑𑇒𑇆
𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆁 𑆮𑆳𑆱𑆾 𑆪𑆡𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑇀𑆪 𑆩𑆬𑆂 𑆱𑆁𑆯𑆾𑆣𑇀𑆪𑆠𑆼𑇁𑆩𑇀𑆨𑆱𑆳𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆽𑆱𑇀𑆠𑆡𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑇀𑆪 𑆯𑆾𑆣𑇀𑆪𑆠𑆼 𑆯𑆾𑆣𑆤𑆽𑆫𑇀𑆩𑆬𑆂 𑇆𑇑𑇓𑇆
𑆃𑆘𑆵𑆫𑇀𑆟𑆼 𑆮𑆫𑇀𑆣𑆠𑆼 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑇀𑆮𑆴𑆧𑆤𑇀𑆣𑆯𑇀𑆖𑆳𑆥𑆴 𑆘𑆳𑆪𑆠𑆼𑇅 𑆥𑆵𑆠𑆁 𑆱𑆁𑆯𑆾𑆣𑆤𑆁 𑆖𑆽𑆮 𑆮𑆴𑆥𑆫𑆵𑆠𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇑𑇔𑇆
𑆃𑆬𑇀𑆥𑆩𑆳𑆠𑇀𑆫𑆁 𑆩𑆲𑆳𑆮𑆼𑆓𑆁 𑆧𑆲𑆶𑆢𑆾𑆰𑆲𑆫𑆁 𑆱𑆶𑆒𑆩𑇀𑇅 𑆬𑆔𑆶𑆥𑆳𑆑𑆁 𑆱𑆶𑆒𑆳𑆱𑇀𑆮𑆳𑆢𑆁 𑆥𑇀𑆫𑆵𑆟𑆤𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇑𑇕𑇆
𑆃𑆮𑆴𑆑𑆳𑆫𑆴 𑆖 𑆮𑇀𑆪𑆳𑆥𑆠𑇀𑆠𑆿 𑆤𑆳𑆠𑆴𑆓𑇀𑆬𑆳𑆤𑆴𑆑𑆫𑆁 𑆖 𑆪𑆠𑇀𑇅 𑆓𑆤𑇀𑆣𑆮𑆫𑇀𑆟𑆫𑆱𑆾𑆥𑆼𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆮𑆢𑆿𑆰𑆣𑆩𑇀𑇆𑇑𑇖𑇆
𑆮𑆴𑆣𑆷𑆪 𑆩𑆳𑆤𑆱𑆳𑆤𑇀 𑆢𑆾𑆰𑆳𑆤𑇀 𑆑𑆳𑆩𑆳𑆢𑆵𑆤𑆯𑆶𑆨𑆾𑆢𑆪𑆳𑆤𑇀 𑇅 𑆍𑆑𑆳𑆓𑇀𑆫𑆩𑆤𑆱𑆳 𑆥𑆵𑆠𑆁 𑆱𑆩𑇀𑆪𑆓𑇀𑆪𑆾𑆓𑆳𑆪 𑆑𑆬𑇀𑆥𑆠𑆼𑇆𑇑𑇗𑇆
𑆤𑆫𑆂 𑆯𑇀𑆮𑆾 𑆮𑆩𑆤𑆁 𑆥𑆳𑆠𑆳 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆑𑆦𑆮𑆫𑇀𑆣𑆤𑆩𑇀𑇅 𑆱𑆶𑆘𑆫𑆁 𑆢𑇀𑆫𑆮𑆨𑆷𑆪𑆴𑆰𑇀𑆜𑆁, 𑆬𑆔𑇀𑆮𑆯𑆵𑆠𑆁 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇑𑇘𑇆
𑆇𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆳𑆬𑇀𑆥𑆑𑆦𑆠𑇀𑆮𑆼𑆤 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆁 𑆢𑆾𑆰𑆳𑆂 𑆱𑇀𑆫𑆮𑆤𑇀𑆠𑆴 𑆲𑆴𑇅𑇑𑇙𑇅 𑆥𑆵𑆠𑆿𑆰𑆣𑆱𑇀𑆪 𑆠𑆶 𑆨𑆴𑆰𑆑𑇀 𑆯𑆶𑆢𑇀𑆣𑆴𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇑𑇙𑇆
𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆑𑆦𑆳𑆤𑆶𑆓𑆼 𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆴𑆛𑇀𑆥𑆴𑆠𑇀𑆠𑆼𑇁𑆤𑆶𑆑𑆦𑆼 𑆠𑇀𑆮𑆣𑆂𑇅 𑆲𑆸𑆠𑆢𑆾𑆰𑆁 𑆮𑆢𑆼𑆠𑇀 𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆼 𑆖𑆼𑆠𑇀 𑆱𑆬𑆳𑆔𑆮𑆼𑇆𑇒𑇐𑇆
𑆮𑆳𑆩𑆪𑆼𑆠𑇀𑆠𑆶 𑆠𑆠𑆂 𑆯𑆼𑆰𑆩𑆿𑆰𑆣𑆁 𑆤 𑆠𑇀𑆮𑆬𑆳𑆔𑆮𑆼𑇅 𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆼𑇁𑆤𑆴𑆬𑆱𑆕𑇀𑆓𑆼 𑆖 𑆤𑆴𑆫𑆶𑆢𑇀𑆓𑆳𑆫𑆼𑇁𑆥𑆴 𑆮𑆳𑆩𑆪𑆼𑆠𑇀𑇆𑇒𑇑𑇆
𑆄𑆬𑆳𑆔𑆮𑆳𑆠𑇀𑆠𑆤𑆶𑆠𑇀𑆮𑆳𑆖𑇀𑆖 𑆑𑆦𑆱𑇀𑆪𑆳𑆥𑆠𑇀 𑆥𑆫𑆁 𑆨𑆮𑆼𑆠𑇀𑇅𑇒𑇒𑇅 𑆮𑆩𑆴𑆠𑆼 𑆮𑆫𑇀𑆣𑆠𑆼 𑆮𑆲𑇀𑆤𑆴𑆂 𑆯𑆩𑆁 𑆢𑆾𑆰𑆳 𑆮𑇀𑆫𑆘𑆤𑇀𑆠𑆴 𑆲𑆴𑇆𑇒𑇒𑇆
𑆮𑆩𑆴𑆠𑆁 𑆬𑆕𑇀𑆔𑆪𑆼𑆠𑇀 𑆱𑆩𑇀𑆪𑆓𑇀𑆘𑆵𑆫𑇀𑆟𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑇀𑆪𑆬𑆑𑇀𑆰𑆪𑆤𑇀𑇅 𑆠𑆳𑆤𑆴 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆠𑆶 𑆥𑆼𑆪𑆳𑆢𑆴𑆑𑇀𑆫𑆩𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆤 𑆬𑆕𑇀𑆔𑆤𑆩𑇀𑇆𑇒𑇓𑇆
𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆨𑇀𑆪𑆳𑆁 𑆯𑆶𑆢𑇀𑆣𑆱𑇀𑆪 𑆲𑆸𑆠𑆢𑆾𑆰𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂𑇅 𑆪𑆳𑆠𑇀𑆪𑆓𑇀𑆤𑆴𑆫𑇀𑆩𑆤𑇀𑆢𑆠𑆳𑆁 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆑𑇀𑆫𑆩𑆁 𑆥𑆼𑆪𑆳𑆢𑆴𑆩𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇒𑇔𑇆
𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆼 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆼𑇁𑆬𑇀𑆥𑆁 𑆩𑆢𑇀𑆪𑆥𑆼 𑆮𑆳𑆠𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼𑇅 𑆠𑆫𑇀𑆥𑆟𑆳𑆢𑆴𑆑𑇀𑆫𑆩𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆥𑆼𑆪𑆳𑇁𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆪𑆼𑆢𑇀𑆣𑆴 𑆠𑆳𑆤𑇀𑇆𑇒𑇕𑇆
𑆃𑆤𑆶𑆬𑆾𑆩𑆾𑇁𑆤𑆴𑆬𑆂 𑆱𑇀𑆮𑆳𑆱𑇀𑆡𑇀𑆪𑆁 𑆑𑇀𑆰𑆶𑆠𑇀𑆠𑆸𑆰𑇀𑆟𑆾𑆫𑇀𑆘𑆾 𑆩𑆤𑆱𑇀𑆮𑆴𑆠𑆳𑇅 𑆬𑆔𑆶𑆠𑇀𑆮𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆢𑇀𑆓𑆳𑆫𑆯𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆘𑆵𑆫𑇀𑆟𑆿𑆰𑆣𑆳𑆑𑆸𑆠𑆴𑆂𑇆𑇒𑇖𑇆
𑆑𑇀𑆬𑆩𑆾 𑆢𑆳𑆲𑆾𑇁𑆕𑇀𑆓𑆱𑆢𑆤𑆁 𑆨𑇀𑆫𑆩𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆳𑇅 𑆃𑆫𑆠𑆴𑆫𑇀𑆧𑆬𑆲𑆳𑆤𑆴𑆯𑇀𑆖 𑆱𑆳𑆮𑆯𑆼𑆰𑆿𑆰𑆣𑆳𑆑𑆸𑆠𑆴𑆂𑇆𑇒𑇗𑇆
𑆃𑆑𑆳𑆬𑆼𑇁𑆬𑇀𑆥𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆖 𑆥𑆶𑆫𑆳𑆟𑆁 𑆤 𑆖 𑆨𑆳𑆮𑆴𑆠𑆩𑇀𑇅 𑆃𑆱𑆩𑇀𑆪𑆑𑇀𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆁 𑆖𑆽𑆮 𑆮𑇀𑆪𑆳𑆥𑆢𑇀𑆪𑆼𑆠𑆿𑆰𑆣𑆁 𑆢𑇀𑆫𑆶𑆠𑆩𑇀𑇆𑇒𑇘𑇆
𑆄𑆣𑇀𑆩𑆳𑆤𑆁 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆯𑇀𑆖 𑆱𑇀𑆫𑆳𑆮𑆾 𑆲𑆸𑆢𑇀𑆓𑆳𑆠𑇀𑆫𑆪𑆾𑆫𑇀𑆓𑇀𑆫𑆲𑆂𑇅 𑆘𑆵𑆮𑆳𑆢𑆳𑆤𑆁 𑆱𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆂 𑆱𑆾𑆥𑆢𑇀𑆫𑆮𑆂 𑆑𑇀𑆬𑆩𑆂𑇆𑇒𑇙𑇆
𑆃𑆪𑆾𑆓𑆳𑆢𑆠𑆴𑆪𑆾𑆓𑆳𑆖𑇀𑆖 𑆢𑆯𑆽𑆠𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑆾 𑆩𑆠𑆳𑆂𑇅 𑆥𑇀𑆫𑆼𑆰𑇀𑆪𑆨𑆽𑆰𑆘𑇀𑆪𑆮𑆽𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑆽𑆓𑆶𑆟𑇀𑆪𑆳𑆢𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆖𑇆𑇓𑇐𑇆
𑆪𑆾𑆓𑆂 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆢𑆠𑆴𑆪𑆾𑆓𑆾𑇁𑆠𑆴𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇅 𑆃𑆪𑆾𑆓𑆂 𑆥𑇀𑆫𑆳𑆠𑆴𑆬𑆾𑆩𑇀𑆪𑆼𑆤 𑆤 𑆖𑆳𑆬𑇀𑆥𑆁 𑆮𑆳 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇆𑇓𑇑𑇆
𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆼𑆤 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑆩𑆲𑆸𑆢𑇀𑆪𑆩𑆠𑆴 𑆮𑆳 𑆧𑆲𑆶𑇅 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑆘𑆵𑆫𑇀𑆟𑆼 𑆖 𑆥𑆵𑆠𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇓𑇒𑇆
𑆑𑇀𑆰𑆶𑆣𑆳𑆫𑇀𑆠𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆳𑆨𑇀𑆪𑆳𑆁 𑆱𑇀𑆮𑆬𑇀𑆥𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆑𑆦𑆼𑆤 𑆮𑆳𑇅 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆥𑆵𑆠𑆁 𑆱𑇀𑆡𑆴𑆠𑆁 𑆑𑇀𑆰𑆶𑆧𑇀𑆣𑆁 𑆮𑆩𑆤𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇓𑇓𑇆
𑆥𑇀𑆫𑆳𑆠𑆴𑆬𑆾𑆩𑇀𑆪𑆼𑆤 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆲𑆫𑆟𑆳𑆠𑇀𑆠𑆼 𑆲𑇀𑆪𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆯𑆂𑇅 𑆃𑆪𑆾𑆓𑆱𑆚𑇀𑆘𑇀𑆚𑆼, 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆼𑆟 𑆪𑆳𑆠𑆴 𑆢𑆾𑆰𑆾 𑆤𑆮𑆳𑇁𑆬𑇀𑆥𑆯𑆂𑇆𑇓𑇔𑇆
𑆥𑆵𑆠𑆿𑆰𑆣𑆾 𑆤 𑆯𑆶𑆢𑇀𑆣𑆯𑇀𑆖𑆼𑆘𑇀𑆘𑆵𑆫𑇀𑆟𑆼 𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆶𑆤𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆐𑆰𑆣𑆁 𑆤 𑆠𑇀𑆮𑆘𑆵𑆫𑇀𑆟𑆼𑇁𑆤𑇀𑆪𑆢𑇀𑆨𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑆠𑆴𑆪𑆾𑆓𑆠𑆂𑇆𑇓𑇕𑇆
𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆓𑆶𑆫𑆶𑆠𑆳𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆬𑆔𑆶𑆠𑇀𑆮𑆁 𑆧𑆬𑆩𑆼𑆮 𑆖𑇅 𑆃𑆪𑆾𑆓𑆼 𑆩𑆸𑆢𑆶 𑆮𑆳 𑆢𑆢𑇀𑆪𑆳𑆢𑆿𑆰𑆣𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑆼𑆮 𑆮𑆳𑇆𑇓𑇖𑇆
𑆮𑆩𑆤𑆁 𑆤 𑆠𑆶 𑆢𑆶𑆯𑇀𑆗𑆫𑇀𑆢𑆁 𑆢𑆶𑆰𑇀𑆑𑆾𑆰𑇀𑆜𑆁 𑆤 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆥𑆳𑆪𑆪𑆼𑆠𑆿𑆰𑆣𑆁 𑆨𑆷𑆪𑆾 𑆲𑆤𑇀𑆪𑆳𑆠𑇀 𑆥𑆵𑆠𑆁 𑆥𑆶𑆤𑆫𑇀𑆲𑆴 𑆠𑆿𑇆𑇓𑇗𑇆
𑆃𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆢𑆼𑆲𑆱𑇀𑆪 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪𑆳𑆤𑆮𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆢𑆾𑆰𑆳𑆤𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪 𑆤𑆴𑆫𑇀𑆲𑆫𑇀𑆠𑆶𑆩𑆯𑆑𑇀𑆠𑆁 𑆘𑆤𑆪𑆼𑆢𑇀𑆓𑆢𑆳𑆤𑇀𑇆𑇓𑇘𑇆
𑆮𑆴𑆨𑇀𑆫𑆁𑆯𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆁 𑆲𑆴𑆑𑇀𑆑𑆳𑆁 𑆠𑆩𑆱𑆾 𑆢𑆫𑇀𑆯𑆤𑆁 𑆨𑆸𑆯𑆩𑇀 𑇅 𑆥𑆴𑆟𑇀𑆝𑆴𑆑𑆾𑆢𑇀𑆮𑆼𑆰𑇀𑆛𑆤𑆁 𑆑𑆟𑇀𑆝𑆷𑆩𑆷𑆫𑇀𑆮𑆾𑆂 𑆱𑆳𑆢𑆁 𑆮𑆴𑆮𑆫𑇀𑆟𑆠𑆳𑆩𑇀𑇆𑇓𑇙𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆖𑆳𑆠𑇀𑆪𑆬𑇀𑆥𑆁 𑆢𑆵𑆥𑇀𑆠𑆳𑆓𑇀𑆤𑆼𑆫𑇀𑆘𑆵𑆫𑇀𑆟𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆯𑆵𑆠𑆽𑆫𑇀𑆮𑆳 𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆳𑆩𑆼 𑆮𑆳 𑆢𑆾𑆰𑆳𑆤𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪 𑆤𑆳𑆲𑆫𑆼𑆠𑇀𑇆𑇔𑇐𑇆
𑆠𑆳𑆤𑆼𑆮 𑆘𑆤𑆪𑆼𑆢𑇀𑆫𑆾𑆓𑆳𑆤𑆪𑆾𑆓𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆱𑆂𑇅 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆩𑆠𑆴𑆩𑆳𑆁𑆱𑇀𑆠𑆠𑇀𑆫 𑆪𑆡𑆾𑆑𑇀𑆠𑆳𑆁 𑆑𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇆𑇔𑇑𑇆
𑆠𑆁 𑆠𑆽𑆬𑆬𑆮𑆟𑆳𑆨𑇀𑆪𑆑𑇀𑆠𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆥𑇀𑆫𑆱𑇀𑆠𑆫𑆱𑆕𑇀𑆑𑆫𑆽𑆂𑇅 𑆥𑆳𑆪𑆪𑆼𑆠 𑆥𑆶𑆤𑆫𑇀𑆘𑆵𑆫𑇀𑆟𑆼 𑆱𑆩𑆷𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳 𑆤𑆴𑆫𑆷𑆲𑆪𑆼𑆠𑇀𑇆𑇔𑇒𑇆
𑆤𑆴𑆫𑆷𑆞𑆁 𑆖 𑆫𑆱𑆽𑆫𑇀𑆣𑆳𑆤𑇀𑆮𑆽𑆫𑇀𑆨𑆾𑆘𑆪𑆴𑆠𑇀𑆮𑆳𑇁𑆤𑆶𑆮𑆳𑆱𑆪𑆼𑆠𑇀𑇅 𑆦𑆬𑆩𑆳𑆓𑆣𑆴𑆑𑆳𑆢𑆳𑆫𑆶𑆱𑆴𑆢𑇀𑆣𑆠𑆽𑆬𑆼𑆤 𑆩𑆳𑆠𑇀𑆫𑆪𑆳𑇆𑇔𑇓𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁 𑆮𑆳𑆠𑆲𑆫𑆽𑆂 𑆱𑇀𑆤𑆼𑆲𑆽𑆂 𑆥𑆶𑆤𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆼𑆤 𑆯𑆾𑆣𑆪𑆼𑆠𑇀𑇅 𑆤 𑆖𑆳𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆼𑆤 𑆠𑆠𑆾 𑆲𑇀𑆪𑆠𑆴𑆪𑆾𑆓𑆱𑇀𑆠𑆶 𑆘𑆳𑆪𑆠𑆼𑇆𑇔𑇔𑇆
𑆃𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆑𑇀𑆰𑆶𑆣𑆳𑆫𑇀𑆠𑆱𑇀𑆪 𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆱𑇀𑆪 𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆲𑆸𑆠𑇀𑆮𑆳𑇁𑇁𑆯𑆶 𑆮𑆴𑆛𑇀𑆥𑆴𑆠𑇀𑆠𑆑𑆦𑆳𑆤𑇀 𑆣𑆳𑆠𑆷𑆤𑇀𑆮𑆴𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆢𑇀𑆢𑇀𑆫𑆮𑆳𑆤𑇀𑇆𑇔𑇕𑇆
𑆧𑆬𑆱𑇀𑆮𑆫𑆑𑇀𑆰𑆪𑆁 𑆢𑆳𑆲𑆁 𑆑𑆟𑇀𑆜𑆯𑆾𑆰𑆁 𑆨𑇀𑆫𑆩𑆁 𑆠𑆸𑆰𑆳𑆩𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖 𑆩𑆣𑆶𑆫𑆽𑆱𑇀𑆠𑆠𑇀𑆫 𑆯𑆼𑆰𑆩𑆿𑆰𑆣𑆩𑆶𑆬𑇀𑆬𑆴𑆒𑆼𑆠𑇀𑇆𑇔𑇖𑇆
𑆮𑆩𑆤𑆼 𑆠𑆶 𑆮𑆴𑆫𑆼𑆑𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆑𑆼 𑆮𑆩𑆤𑆁 𑆥𑆶𑆤𑆂 𑇅 𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆳𑆢𑇀𑆪𑆽𑆂 𑆱𑆶𑆯𑆵𑆠𑆽𑆂 𑆱𑇀𑆠𑆩𑇀𑆨𑆪𑆼𑆖𑇀𑆖 𑆠𑆠𑇀𑇆𑇔𑇗𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆽𑆂 𑆯𑆵𑆠𑆽𑆫𑆤𑇀𑆤𑆥𑆳𑆤𑆿𑆰𑆣𑆽𑆱𑇀𑆠𑆡𑆳𑇅 𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑆴𑆱𑆳𑆫𑆔𑇀𑆤𑆽𑆫𑇀𑆢𑆳𑆲𑆘𑇀𑆮𑆫𑆲𑆫𑆽𑆫𑆥𑆴𑇆𑇔𑇘𑇆
𑆃𑆚𑇀𑆘𑆤𑆁 𑆖𑆤𑇀𑆢𑆤𑆾𑆯𑆵𑆫𑆩𑆘𑇀𑆘𑆳𑆱𑆸𑆑𑇀𑆯𑆫𑇀𑆑𑆫𑆾𑆢𑆑𑆩𑇀𑇅 𑆬𑆳𑆘𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆤𑇀𑆡𑆩𑆠𑆴𑆪𑆾𑆓𑆲𑆫𑆁 𑆥𑆫𑆩𑇀𑇆𑇔𑇙𑇆
𑆯𑆶𑆕𑇀𑆓𑆳𑆨𑆴𑆫𑇀𑆮𑆳 𑆮𑆛𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆴𑆢𑇀𑆣𑆳𑆁 𑆥𑆼𑆪𑆳𑆁 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆳𑆩𑇀𑇅 𑆮𑆫𑇀𑆖𑆂𑆱𑆳𑆕𑇀𑆓𑇀𑆫𑆳𑆲𑆴𑆑𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆑𑇀𑆰𑆵𑆫𑆁 𑆨𑆾𑆘𑇀𑆪𑆁 𑆖 𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇕𑇐𑇆
𑆘𑆳𑆕𑇀𑆓𑆬𑆽𑆫𑇀𑆮𑆳 𑆫𑆱𑆽𑆫𑇀𑆨𑆾𑆘𑇀𑆪𑆁 𑆥𑆴𑆖𑇀𑆗𑆳𑆧𑆱𑇀𑆠𑆴𑆯𑇀𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆩𑆣𑆶𑆫𑆽𑆫𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆯𑇀𑆖 𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆰𑆳𑇆𑇕𑇑𑇆
𑆮𑆩𑆤𑆱𑇀𑆪𑆳𑆠𑆴𑆪𑆾𑆓𑆼 𑆠𑆶 𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆥𑆫𑆴𑆰𑆼𑆖𑆴𑆠𑆂𑇅 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑆦𑆲𑆫𑆽𑆫𑇀𑆩𑆤𑇀𑆡𑆁 𑆱𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆯𑆫𑇀𑆑𑆫𑆩𑇀𑇆𑇕𑇒𑇆
𑆱𑆾𑆢𑇀𑆓𑆳𑆫𑆳𑆪𑆳𑆁 𑆨𑆸𑆯𑆁 𑆮𑆩𑇀𑆪𑆳𑆁 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆪𑆳𑆁 𑆣𑆳𑆤𑇀𑆪𑆩𑆶𑆱𑇀𑆠𑆪𑆾𑆂𑇅 𑆱𑆩𑆣𑆷𑆑𑆳𑆚𑇀𑆘𑆤𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆬𑆼𑆲𑆪𑆼𑆤𑇀𑆩𑆣𑆶𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇕𑇓𑇆
𑆦𑆬𑆳𑆤𑇀𑆪𑆩𑇀𑆬𑆳𑆤𑆴 𑆒𑆳𑆢𑆼𑆪𑆶𑆱𑇀𑆠𑆱𑇀𑆪 𑆖𑆳𑆤𑇀𑆪𑆼𑇁𑆓𑇀𑆫𑆠𑆾 𑆤𑆫𑆳𑆂𑇅 𑆤𑆴𑆂𑆱𑆸𑆠𑆳𑆁 𑆠𑆶 𑆠𑆴𑆬𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆑𑆬𑇀𑆑𑆬𑆴𑆥𑇀𑆠𑆳𑆁 𑆥𑇀𑆫𑆮𑆼𑆯𑆪𑆼𑆠𑇀𑇆𑇕𑇕𑇆
𑆮𑆳𑆓𑇀𑆓𑇀𑆫𑆲𑆳𑆤𑆴𑆬𑆫𑆾𑆓𑆼𑆰𑆶 𑆔𑆸𑆠𑆩𑆳𑆁𑆱𑆾𑆥𑆱𑆳𑆣𑆴𑆠𑆳𑆩𑇀𑇅 𑆪𑆮𑆳𑆓𑆷𑆁 𑆠𑆤𑆶𑆑𑆳𑆁 𑆢𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆿 𑆖 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀𑇆𑇕𑇖𑇆
𑆮𑆩𑆴𑆠𑆯𑇀𑆖 𑆮𑆴𑆫𑆴𑆑𑇀𑆠𑆯𑇀𑆖 𑆩𑆤𑇀𑆢𑆳𑆓𑇀𑆤𑆴𑆯𑇀𑆖 𑆮𑆴𑆬𑆕𑇀𑆔𑆴𑆠𑆂𑇅 𑆃𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆳𑆟𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆑𑇀𑆫𑆩𑆁 𑆥𑆼𑆪𑆳𑆢𑆴𑆑𑆁 𑆨𑆘𑆼𑆠𑇀 𑇆𑇕𑇗𑇆
𑆧𑆲𑆶𑆢𑆾𑆰𑆱𑇀𑆪 𑆫𑆷𑆑𑇀𑆰𑆱𑇀𑆪 𑆲𑆵𑆤𑆳𑆓𑇀𑆤𑆼𑆫𑆬𑇀𑆥𑆩𑆿𑆰𑆣𑆩𑇀𑇅 𑆱𑆾𑆢𑆳𑆮𑆫𑇀𑆠𑆱𑇀𑆪 𑆖𑆾𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪 𑆢𑆾𑆰𑆳𑆤𑇀𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑇀𑆤𑆴𑆫𑆶𑆣𑇀𑆪 𑆖𑇆𑇕𑇘𑇆
𑆨𑆸𑆯𑆩𑆳𑆣𑇀𑆩𑆳𑆥𑆪𑆼𑆤𑇀𑆤𑆳𑆨𑆴𑆁 𑆥𑆸𑆰𑇀𑆜𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆯𑆴𑆫𑆾𑆫𑆶𑆘𑆩𑇀𑇅 𑆯𑇀𑆮𑆳𑆱𑆮𑆴𑆟𑇀𑆩𑆷𑆠𑇀𑆫𑆮𑆳𑆠𑆳𑆤𑆳𑆁 𑆱𑆕𑇀𑆓𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖 𑆢𑆳𑆫𑆶𑆟𑆩𑇀𑇆𑇕𑇙𑇆
𑆃𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆮𑆼𑆢𑆮𑆫𑇀𑆠𑇀𑆪𑆳𑆢𑆴 𑆱𑆤𑆴𑆫𑆷𑆲𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀𑇅 𑆇𑆢𑆳𑆮𑆫𑇀𑆠𑆲𑆫𑆁 𑆱𑆫𑇀𑆮𑆁 𑆑𑆫𑇀𑆩𑆳𑆣𑇀𑆩𑆳𑆠𑆱𑇀𑆪 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇖𑇐𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆼𑆤 𑆓𑆶𑆫𑆶𑆑𑆾𑆰𑇀𑆜𑆼𑆤 𑆱𑆳𑆩𑆼 𑆧𑆬𑆮𑆢𑆿𑆰𑆣𑆩𑇀𑇅 𑆑𑇀𑆰𑆳𑆩𑆼𑆟 𑆩𑆸𑆢𑆶𑆑𑆾𑆰𑇀𑆜𑆼𑆤 𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆼𑆤𑆳𑆬𑇀𑆥𑆧𑆬𑆼𑆤 𑆮𑆳𑇆𑇖𑇑𑇆
𑆥𑆵𑆠𑆁 𑆓𑆠𑇀𑆮𑆳 𑆓𑆶𑆢𑆁 𑆱𑆳𑆩𑆩𑆳𑆯𑆶 𑆢𑆾𑆰𑆁 𑆤𑆴𑆫𑆱𑇀𑆪 𑆖𑇅 𑆠𑆵𑆮𑇀𑆫𑆯𑆷𑆬𑆳𑆁 𑆱𑆥𑆴𑆖𑇀𑆗𑆳𑆱𑇀𑆫𑆳𑆁 𑆑𑆫𑆾𑆠𑆴 𑆥𑆫𑆴𑆑𑆫𑇀𑆠𑆴𑆑𑆳𑆩𑇀𑇆𑇖𑇒𑇆
𑆬𑆕𑇀𑆔𑆤𑆁 𑆥𑆳𑆖𑆤𑆁 𑆱𑆳𑆩𑆼 𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆁 𑆬𑆔𑆶𑆨𑆾𑆘𑆤𑆩𑇀𑇅 𑆧𑆸𑆁𑆲𑆟𑆵𑆪𑆾 𑆮𑆴𑆣𑆴𑆂 𑆱𑆫𑇀𑆮𑆂 𑆑𑇀𑆰𑆳𑆩𑆱𑇀𑆪 𑆩𑆣𑆶𑆫𑆱𑇀𑆠𑆡𑆳𑇆𑇖𑇓𑇆
𑆄𑆩𑆼 𑆘𑆵𑆫𑇀𑆟𑆼𑇁𑆤𑆶𑆧𑆤𑇀𑆣𑆯𑇀𑆖𑆼𑆠𑇀 𑆑𑇀𑆰𑆳𑆫𑆳𑆩𑇀𑆬𑆁 𑆬𑆔𑆶 𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆥𑆶𑆰𑇀𑆥𑆑𑆳𑆱𑆵𑆱𑆩𑆴𑆯𑇀𑆫𑆁 𑆮𑆳 𑆑𑇀𑆰𑆳𑆫𑆼𑆟 𑆬𑆮𑆟𑆼𑆤 𑆮𑆳𑇆𑇖𑇔𑇆
𑆱𑆢𑆳𑆝𑆴𑆩𑆫𑆱𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳𑆠𑆼𑇁𑆣𑆴𑆑𑆼 𑆱𑆠𑆴𑇅 𑆢𑆣𑇀𑆪𑆩𑇀𑆬𑆁 𑆨𑆾𑆘𑆤𑆼 𑆥𑆳𑆤𑆼 𑆱𑆁𑆪𑆶𑆑𑇀𑆠𑆁 𑆢𑆳𑆝𑆴𑆩𑆠𑇀𑆮𑆖𑆳𑇆𑇖𑇕𑇆
𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆠𑆴𑆬𑆳𑆤𑆳𑆁 𑆮𑆳 𑆑𑆬𑇀𑆑𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆃𑆯𑇀𑆮𑆠𑇀𑆡𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆥𑇀𑆬𑆑𑇀𑆰𑆑𑆢𑆩𑇀𑆧𑆽𑆫𑇀𑆮𑆳 𑆯𑆸𑆠𑆁 𑆥𑆪𑆂𑇆𑇖𑇖𑇆
𑆑𑆰𑆳𑆪𑆩𑆣𑆶𑆫𑆁 𑆯𑆵𑆠𑆁 𑆥𑆴𑆖𑇀𑆗𑆳𑆧𑆱𑇀𑆠𑆴𑆩𑆡𑆳𑆥𑆴 𑆮𑆳𑇅 𑆪𑆰𑇀𑆛𑆵𑆩𑆣𑆶𑆑𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆱𑇀𑆤𑆼𑆲𑆧𑆱𑇀𑆠𑆴𑆁 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇖𑇗𑇆
𑆃𑆬𑇀𑆥𑆁 𑆠𑆶 𑆧𑆲𑆶𑆢𑆾𑆰𑆱𑇀𑆪 𑆢𑆾𑆰𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆯𑇀𑆪 𑆨𑆼𑆰𑆘𑆩𑇀𑇅 𑆃𑆬𑇀𑆥𑆳𑆬𑇀𑆥𑆁 𑆱𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀 𑆑𑆟𑇀𑆝𑆷𑆁 𑆯𑆾𑆦𑆁 𑆑𑆶𑆰𑇀𑆜𑆳𑆤𑆴 𑆓𑆿𑆫𑆮𑆩𑇀𑇆𑇖𑇘𑇆
𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆖𑆳𑆓𑇀𑆤𑆴𑆧𑆬𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆱𑇀𑆠𑆽𑆩𑆴𑆠𑇀𑆪𑆳𑆫𑆶𑆖𑆴𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑆳𑆂𑇅 𑆥𑆫𑆴𑆱𑇀𑆫𑆳𑆮𑆂 𑆱, 𑆠𑆁 𑆢𑆾𑆰𑆁 𑆯𑆩𑆪𑆼𑆢𑇀𑆮𑆳𑆩𑆪𑆼𑆢𑆥𑆴𑇆𑇖𑇙𑇆
𑆱𑇀𑆤𑆼𑆲𑆴𑆠𑆁 𑆮𑆳 𑆥𑆶𑆤𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇅 𑆯𑆶𑆢𑇀𑆣𑆼 𑆖𑆷𑆫𑇀𑆟𑆳𑆱𑆮𑆳𑆫𑆴𑆰𑇀𑆛𑆳𑆤𑇀 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆁𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇗𑇐𑇆
𑆥𑆵𑆠𑆿𑆰𑆣𑆱𑇀𑆪 𑆮𑆼𑆓𑆳𑆤𑆳𑆁 𑆤𑆴𑆓𑇀𑆫𑆲𑆳𑆤𑇀𑆩𑆳𑆫𑆶𑆠𑆳𑆢𑆪𑆂𑇅 𑆑𑆶𑆥𑆴𑆠𑆳 𑆲𑆸𑆢𑆪𑆁 𑆓𑆠𑇀𑆮𑆳 𑆔𑆾𑆫𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆲𑆸𑆢𑇀𑆓𑇀𑆫𑆲𑆩𑇀𑇆𑇗𑇑𑇆

𑆪𑆼𑇁𑆤𑇀𑆪𑆼 𑆠𑆼𑆰𑆳𑆁 𑆮𑆴𑆯𑆼𑆰𑆳𑆱𑇀𑆠𑆶 𑆠𑆷𑆫𑇀𑆟𑆁 𑆠𑆼𑆰𑆳𑆁 𑆱𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇅 𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆳𑆖𑇀𑆖 𑆠𑆡𑆽𑆮 𑆮𑆴𑆰𑆬𑆼𑆥𑆤𑆳𑆠𑇀 𑇆𑇒𑇒𑇆
𑆬𑆴𑆕𑇀𑆓𑆁 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆮𑆴𑆰𑆼𑆰𑇀𑆮𑆼𑆠... 𑇅𑇒𑇓𑇅 ...𑆖𑇀𑆗𑆸𑆟𑆶 𑆩𑆤𑇀𑆢𑆮𑆴𑆰𑆼𑆰𑇀𑆮𑆠𑆂 𑇅 𑆥𑇀𑆫𑆱𑆼𑆑𑆳𑆫𑆾𑆖𑆑𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆯𑆴𑆫𑆾𑆓𑆿𑆫𑆮𑆯𑆵𑆠𑆑𑆳𑆂 𑇆𑇒𑇓𑇆
𑆥𑆴𑆝𑆑𑆳𑆑𑆾𑆜𑆑𑆟𑇀𑆝𑆷𑆤𑆳𑆁 𑆘𑆤𑇀𑆩 𑆢𑆾𑆰𑆮𑆴𑆨𑆳𑆓𑆠𑆂 𑇅𑇒𑇔𑇅 𑆪𑆾𑆓𑆽𑆫𑇀𑆤𑆳𑆤𑆳𑆮𑆴𑆣𑆽𑆫𑆼𑆰𑆳𑆁 𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆓𑆫𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀 𑇆𑇒𑇔𑇆
𑆢𑆷𑆰𑆵𑆮𑆴𑆰𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆠𑆡𑆳 𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆬𑆼𑆥𑆤𑆳𑆠𑇀 𑇅𑇒𑇕𑇅 𑆍𑆑𑆘𑆳𑆠𑆵𑆤𑆠𑆱𑇀𑆠𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆑𑆵𑆛𑆳𑆤𑇀 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆨𑆼𑆢𑆠𑆂 𑇆𑇒𑇕𑇆
𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆾 𑆢𑆰𑇀𑆛𑆬𑆴𑆕𑇀𑆓𑆽𑆂 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆑𑇀𑆫𑆩𑆼𑆟 𑆖 𑇅 𑆠𑇀𑆫𑆴𑆑𑆟𑇀𑆛𑆂 𑆑𑆫𑆴𑆟𑆵 𑆖𑆳𑆥𑆴 𑆲𑆱𑇀𑆠𑆴𑆑𑆑𑇀𑆰𑆾𑇁𑆥𑆫𑆳𑆘𑆴𑆠𑆂 𑇅 𑆖𑆠𑇀𑆮𑆳𑆫 𑆍𑆠𑆼 𑆑𑆟𑆨𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆱𑇀𑆠𑆵𑆮𑇀𑆫𑆮𑆼𑆢𑆤𑆳𑆂 𑇆𑇒𑇖𑇆
𑆠𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾 𑆓𑆶𑆫𑆶𑆠𑆳 𑆓𑆳𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆢𑆁𑆯𑆂 𑆑𑆸𑆰𑇀𑆟𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇒𑇗𑇆
𑆥𑇀𑆫𑆠𑆴𑆱𑆷𑆫𑇀𑆪𑆑𑆂 , 𑆥𑆴𑆕𑇀𑆓𑆳𑆨𑆳𑆱𑆾, 𑆧𑆲𑆶𑆮𑆫𑇀𑆟𑆾, 𑆤𑆴𑆫𑆷𑆥𑆩𑆾 𑆓𑆾𑆣𑆼𑆫𑆼𑆑 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖 𑆓𑆾𑆣𑆼𑆫𑆑𑆳𑆂 ; 𑆠𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆯𑆾𑆦𑆾 𑆢𑆳𑆲𑆫𑆶𑆘𑆿 𑆖 𑆨𑆮𑆠𑆂, 𑆓𑆾𑆣𑆼𑆫𑆑𑆼𑆟𑆽𑆠𑆢𑆼𑆮 𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆘𑇀𑆮𑆫𑆯𑇀𑆖 𑇆𑇒𑇘𑇆
𑆓𑆬𑆓𑆾𑆬𑆴𑆑𑆳 - 𑆯𑇀𑆮𑆼𑆠𑆳, 𑆑𑆸𑆰𑇀𑆟𑆳, 𑆫𑆑𑇀𑆠𑆫𑆳𑆘𑆵, 𑆫𑆑𑇀𑆠𑆩𑆟𑇀𑆝𑆬𑆳, 𑆱𑆫𑇀𑆮𑆯𑇀𑆮𑆼𑆠𑆳, 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆼𑆠𑇀𑆪𑆼𑆮𑆁 𑆰𑆛𑇀; 𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆳𑆮𑆫𑇀𑆘𑆁 𑆢𑆳𑆲𑆯𑆾𑆦𑆑𑇀𑆬𑆼𑆢𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆪𑆳 𑆲𑆸𑆢𑆪𑆥𑆴𑆝𑆳𑇁𑆠𑆴𑆱𑆳𑆫𑆯𑇀𑆖, 𑆠𑆳𑆱𑆶 𑆩𑆣𑇀𑆪𑆼 𑆱𑆫𑇀𑆰𑆥𑆴𑆑𑆳 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆵 𑇆𑇒𑇙𑇆
𑆯𑆠𑆥𑆢𑇀𑆪𑆱𑇀𑆠𑆶- 𑆥𑆫𑆶𑆰𑆳, 𑆑𑆸𑆰𑇀𑆟𑆳, 𑆖𑆴𑆠𑇀𑆫𑆳, 𑆑𑆥𑆴𑆬𑆳, 𑆥𑆵𑆠𑆴𑆑𑆳, 𑆫𑆑𑇀𑆠𑆳, 𑆯𑇀𑆮𑆼𑆠𑆳, 𑆃𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆨𑆳, 𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆿; 𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆯𑆾𑆦𑆾 𑆮𑆼𑆢𑆤𑆳 𑆢𑆳𑆲𑆯𑇀𑆖 𑆲𑆸𑆢𑆪𑆼, 𑆯𑇀𑆮𑆼𑆠𑆳𑆓𑇀𑆤𑆴𑆥𑇀𑆫𑆨𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆠𑆢𑆼𑆮 𑆢𑆳𑆲𑆾 𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆯𑇀𑆮𑆼𑆠𑆥𑆴𑆝𑆑𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑇆𑇓𑇐𑇆
𑆩𑆟𑇀𑆝𑆷𑆑𑆳𑆂- 𑆑𑆸𑆰𑇀𑆟𑆂, 𑆱𑆳𑆫𑆂, 𑆑𑆶𑆲𑆑𑆾, 𑆲𑆫𑆴𑆠𑆾, 𑆫𑆑𑇀𑆠𑆾, 𑆪𑆮𑆮𑆫𑇀𑆟𑆳𑆨𑆾, 𑆨𑆸𑆑𑆶𑆛𑆵, 𑆑𑆾𑆛𑆴𑆑𑆯𑇀𑆖𑆼𑆠𑇀𑆪𑆰𑇀𑆛𑆿; 𑆠𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆢𑆁𑆯𑆼 𑆑𑆟𑇀𑆝𑆷𑆫𑇀𑆨𑆮𑆠𑆴 𑆥𑆵𑆠𑆦𑆼𑆤𑆳𑆓𑆩𑆯𑇀𑆖 𑆮𑆑𑇀𑆠𑇀𑆫𑆳𑆠𑇀, 𑆨𑆸𑆑𑆶𑆛𑆵𑆑𑆾𑆛𑆴𑆑𑆳𑆨𑇀𑆪𑆳𑆩𑆼𑆠𑆢𑆼𑆮 𑆢𑆳𑆲𑆯𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑇀𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳 𑆖𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑇀 𑇆𑇓𑇑𑇆
𑆮𑆴𑆯𑇀𑆮𑆩𑇀𑆨𑆫𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆢𑆁𑆯𑆂 𑆱𑆫𑇀𑆰𑆥𑆳𑆑𑆳𑆫𑆳𑆨𑆴𑆂 𑆥𑆴𑆝𑆑𑆳𑆨𑆴𑆂 𑆱𑆫𑆶𑆘𑆳𑆨𑆴𑆯𑇀𑆖𑆵𑆪𑆠𑆼, 𑆯𑆵𑆠𑆘𑇀𑆮𑆫𑆳𑆫𑇀𑆠𑆯𑇀𑆖 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇆𑇓𑇒𑇆
𑆃𑆲𑆴𑆟𑇀𑆝𑆶𑆑𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆠𑆾𑆢𑆢𑆳𑆲𑆑𑆟𑇀𑆝𑆶𑆯𑇀𑆮𑆪𑆡𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆩𑆾𑆲𑆯𑇀𑆖; 𑆑𑆟𑇀𑆝𑆷𑆩𑆑𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆥𑆵𑆠𑆳𑆕𑇀𑆓𑆯𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆘𑇀𑆮𑆫𑆳𑆢𑆴𑆨𑆴𑆫𑆨𑆴𑆲𑆤𑇀𑆪𑆠𑆼; 𑆯𑆷𑆑𑆮𑆸𑆤𑇀𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆑𑆟𑇀𑆝𑆷𑆑𑆾𑆜𑆳𑆂 𑆥𑇀𑆫𑆮𑆫𑇀𑆣𑆤𑇀𑆠𑆼 𑆯𑆷𑆑𑆁 𑆖𑆳𑆠𑇀𑆫 𑆬𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇓𑇆
𑆥𑆴𑆥𑆵𑆬𑆴𑆑𑆳𑆂- 𑆱𑇀𑆡𑆷𑆬𑆯𑆵𑆫𑇀𑆰𑆳, 𑆱𑆁𑆮𑆳𑆲𑆴𑆑𑆳, 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆴𑆑𑆳, 𑆃𑆕𑇀𑆓𑆶𑆬𑆴𑆑𑆳; 𑆑𑆥𑆴𑆬𑆴𑆑𑆳, 𑆖𑆴𑆠𑇀𑆫𑆮𑆫𑇀𑆟𑆼𑆠𑆴 𑆰𑆛𑇀; 𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆼 𑆢𑆁𑆯𑆼 𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆓𑇀𑆤𑆴𑆱𑇀𑆥𑆫𑇀𑆯𑆮𑆢𑇀𑆢𑆳𑆲𑆯𑆾𑆦𑆿 𑆨𑆮𑆠𑆂 𑇆𑇓𑇔𑇆
𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆂- 𑆑𑆳𑆤𑇀𑆠𑆳𑆫𑆴𑆑𑆳, 𑆑𑆸𑆰𑇀𑆟𑆳, 𑆥𑆴𑆕𑇀𑆓𑆬𑆳, 𑆩𑆣𑆷𑆬𑆴𑆑𑆳, 𑆑𑆳𑆰𑆳𑆪𑆵, 𑆱𑇀𑆡𑆳𑆬𑆴𑆑𑆼𑆠𑇀𑆪𑆼𑆮𑆁 𑆰𑆛𑇀; 𑆠𑆳𑆨𑆴𑆫𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆑𑆟𑇀𑆝𑆶𑆯𑆾𑆦𑆢𑆳𑆲𑆫𑆶𑆘𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆱𑇀𑆡𑆳𑆬𑆴𑆑𑆳𑆑𑆳𑆰𑆳𑆪𑆵𑆨𑇀𑆪𑆳𑆩𑆼𑆠𑆢𑆼𑆮 𑆯𑇀𑆪𑆳𑆮𑆥𑆴𑆝𑆑𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆶𑆥𑆢𑇀𑆫𑆮𑆳𑆯𑇀𑆖 𑆘𑇀𑆮𑆫𑆳𑆢𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆑𑆳𑆰𑆳𑆪𑆵 𑆱𑇀𑆡𑆳𑆬𑆴𑆑𑆳 𑆖 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆼 𑇆𑇓𑇕𑇆
𑆩𑆯𑆑𑆳𑆂- 𑆱𑆳𑆩𑆶𑆢𑇀𑆫𑆂, 𑆥𑆫𑆴𑆩𑆟𑇀𑆝𑆬𑆾, 𑆲𑆱𑇀𑆠𑆴𑆩𑆯𑆑𑆂, 𑆑𑆸𑆰𑇀𑆟𑆂, 𑆥𑆳𑆫𑇀𑆮𑆠𑆵𑆪 𑆅𑆠𑆴 𑆥𑆚𑇀𑆖; 𑆠𑆽𑆫𑇀𑆢𑆰𑇀𑆛𑆱𑇀𑆪 𑆠𑆵𑆮𑇀𑆫𑆳 𑆑𑆟𑇀𑆝𑆷𑆫𑇀𑆢𑆁𑆯𑆯𑆾𑆦𑆯𑇀𑆖, 𑆥𑆳𑆫𑇀𑆮𑆠𑆵𑆪𑆱𑇀𑆠𑆶 𑆑𑆵𑆛𑆽𑆂 𑆥𑇀𑆫𑆳𑆟𑆲𑆫𑆽𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆬𑆑𑇀𑆰𑆟𑆂 𑇆𑇓𑇖𑇆
𑆤𑆒𑆳𑆮𑆑𑆸𑆰𑇀𑆛𑆼𑇁𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆥𑆴𑆝𑆑𑆳𑆢𑆳𑆲𑆥𑆳𑆑𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇅 𑆘𑆬𑆿𑆑𑆱𑆳𑆁 𑆢𑆰𑇀𑆛𑆬𑆑𑇀𑆰𑆟𑆩𑆶𑆑𑇀𑆠𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆖 𑇆𑇓𑇗𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆓𑆾𑆣𑆼𑆫𑆑𑆂 𑆱𑇀𑆡𑆳𑆬𑆴𑆑𑆳 𑆖 𑆪𑆼 𑆖 𑆯𑇀𑆮𑆼𑆠𑆳𑆓𑇀𑆤𑆴𑆱𑆥𑇀𑆫𑆨𑆼 𑇅 𑆨𑆸𑆑𑆶𑆛𑆵 𑆑𑆾𑆛𑆴𑆑𑆯𑇀𑆖𑆽𑆮 𑆤 𑆱𑆴𑆣𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆼𑆑𑆘𑆳𑆠𑆴𑆰𑆶 𑇆𑇓𑇘𑇆
𑆯𑆮𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆽𑆱𑇀𑆠𑆶 𑆱𑆮𑆴𑆰𑆽𑆫𑆮𑆩𑆫𑇀𑆯𑆤𑆳𑆠𑇀 𑇅 𑆱𑇀𑆪𑆶𑆂 𑆑𑆟𑇀𑆝𑆷𑆢𑆳𑆲𑆑𑆾𑆜𑆳𑆫𑆶𑆂𑆥𑆴𑆝𑆑𑆳𑆠𑆾𑆢𑆮𑆼𑆢𑆤𑆳𑆂 𑇆𑇓𑇙𑇆
𑆥𑇀𑆫𑆑𑇀𑆬𑆼𑆢𑆮𑆳𑆁𑆱𑇀𑆠𑆡𑆳 𑆱𑇀𑆫𑆳𑆮𑆾 𑆨𑆸𑆯𑆁 𑆱𑆩𑇀𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑆠𑇀𑆮𑆖𑆩𑇀 𑇅 𑆢𑆴𑆓𑇀𑆣𑆮𑆴𑆢𑇀𑆣𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆪𑆡𑆳𑆮𑆢𑆮𑆖𑆳𑆫𑆪𑆼𑆠𑇀 𑇆𑇔𑇐𑇆
𑆤𑆳𑆮𑆱𑆤𑇀𑆤𑆁 𑆤 𑆖𑆾𑆠𑇀𑆱𑆤𑇀𑆤𑆩𑆠𑆴𑆱𑆁𑆫𑆩𑇀𑆨𑆮𑆼𑆢𑆤𑆩𑇀 𑇅 𑆢𑆁𑆯𑆳𑆢𑆿 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆫𑇀𑆠𑆴 𑆑𑆵𑆛𑆢𑆰𑇀𑆛𑆁 𑆱𑆶𑆧𑆳𑆣𑆑𑆩𑇀 𑇆𑇔𑇑𑇆

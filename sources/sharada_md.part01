𑆱𑆫𑇀𑆮𑆳𑆠𑆴𑆱𑆳𑆫𑆓𑇀𑆫𑆲𑆟𑆵𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆂𑆥𑇀𑆬𑆵𑆲𑆤𑆳𑆯𑆴𑆤𑆵𑇅 𑆥𑆚𑇀𑆖𑆑𑆾𑆬𑆑𑆪𑆷𑆰𑆯𑇀𑆖 𑆩𑆷𑆬𑆑𑆳𑆤𑆳𑆁 𑆖 𑆱𑆾𑆰𑆟𑆂𑇆𑇑𑇑𑇕𑇆
𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆾 𑆢𑆳𑆝𑆴𑆩𑆠𑆑𑇀𑆫𑆳𑆩𑇀𑆬𑆾 𑆘𑆳𑆕𑇀𑆓𑆬𑆂 𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆾 𑆫𑆱𑆂𑇅 𑆑𑇀𑆫𑆮𑇀𑆪𑆳𑆢𑆱𑇀𑆮𑆫𑆱𑆂 𑆯𑆱𑇀𑆠𑆾 𑆨𑆾𑆘𑆤𑆳𑆫𑇀𑆡𑆼 𑆱𑆢𑆵𑆥𑆤𑆂𑇆𑇑𑇑𑇖𑇆
𑆠𑆑𑇀𑆫𑆳𑆫𑆤𑆳𑆬𑆩𑆢𑇀𑆪𑆳𑆤𑆴 𑆥𑆳𑆤𑆳𑆪𑆳𑆫𑆴𑆰𑇀𑆛 𑆍𑆮 𑆖𑇅𑇑𑇑𑇗𑇅 𑆠𑆑𑇀𑆫𑆁 𑆠𑆶 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆼 𑆢𑆵𑆥𑆤𑆓𑇀𑆫𑆳𑆲𑆴𑆬𑆳𑆔𑆮𑆳𑆠𑇀𑇆𑇑𑇑𑇗𑇆
𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆁 𑆩𑆣𑆶𑆫𑆥𑆳𑆑𑆴𑆠𑇀𑆮𑆳𑆤𑇀𑆤 𑆖 𑆥𑆴𑆠𑇀𑆠𑆁 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆼𑆠𑇀𑇅 𑆑𑆰𑆳𑆪𑆾𑆰𑇀𑆟𑆮𑆴𑆑𑆳𑆯𑆴𑆠𑇀𑆮𑆳𑆢𑇀𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆳𑆖𑇀𑆖𑆽𑆮 𑆑𑆦𑆼 𑆲𑆴𑆠𑆩𑇀𑇆𑇑𑇑𑇘𑇆
𑆮𑆳𑆠𑆼 𑆱𑇀𑆮𑆳𑆢𑇀𑆮𑆩𑇀𑆬𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆢𑇀𑆪𑆱𑇀𑆑𑆩𑆮𑆴𑆢𑆳𑆲𑆴 𑆠𑆠𑇀𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆠𑆑𑇀𑆫𑆥𑇀𑆫𑆪𑆾𑆓𑆳 𑆪𑆼 𑆘𑆜𑆫𑆳𑆟𑆳𑆁 𑆠𑆡𑆳𑇁𑆫𑇀𑆯𑆱𑆳𑆩𑇀𑇆𑇑𑇑𑇙𑇆
𑆮𑆴𑆲𑆴𑆠𑆳 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆼 𑆱𑆫𑇀𑆮𑆯𑆱𑇀𑆠𑆳𑆤𑇀 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇅 𑆪𑆮𑆳𑆤𑇀𑆪𑆳𑆩𑆬𑆑𑆼 𑆥𑆡𑇀𑆪𑆳 𑆩𑆫𑆴𑆖𑆁 𑆠𑇀𑆫𑆴𑆥𑆬𑆁𑆯𑆴𑆑𑆩𑇀𑇆𑇑𑇒𑇐𑇆
𑆬𑆮𑆟𑆳𑆤𑆴 𑆥𑆬𑆳𑆁𑆯𑆳𑆤𑆴 𑆥𑆚𑇀𑆖 𑆖𑆽𑆑𑆠𑇀𑆫 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇅 𑆠𑆑𑇀𑆫𑆼 𑆠𑆢𑆳𑆱𑆶𑆠𑆁 𑆘𑆳𑆠𑆁 𑆠𑆑𑇀𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆁 𑆥𑆴𑆧𑆼𑆤𑇀𑆤𑆫𑆂𑇅 𑆢𑆵𑆥𑆤𑆁 𑆯𑆾𑆡𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆂𑆑𑇀𑆫𑆴𑆩𑆴𑆩𑆼𑆲𑆾𑆢𑆫𑆳𑆥𑆲𑆩𑇀𑇆𑇑𑇒𑇑𑇆
𑆅𑆠𑆴 𑆠𑆑𑇀𑆫𑆳𑆫𑆴𑆰𑇀𑆛𑆂𑇅 𑆱𑇀𑆮𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆩𑆶𑆠𑇀𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆩𑆓𑇀𑆤𑆴𑆤𑆴𑆫𑇀𑆮𑆳𑆥𑆑𑆁 𑆨𑆴𑆰𑆑𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆮𑆴𑆫𑆼𑆑𑆼𑆟 𑆤𑆴𑆫𑇀𑆲𑆫𑆼𑆢𑇀𑆮𑆩𑆤𑆼𑆤 𑆮𑆳𑇆𑇑𑇒𑇒𑇆
𑆃𑆮𑆴𑆢𑆳𑆲𑆴𑆨𑆴𑆫𑆤𑇀𑆤𑆽𑆯𑇀𑆖 𑆬𑆔𑆶𑆨𑆴𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆱𑆁𑆪𑆶𑆠𑆽𑆂𑇅 𑆘𑆳𑆕𑇀𑆓𑆬𑆳𑆤𑆳𑆁 𑆫𑆱𑆽𑆫𑇀𑆪𑆷𑆰𑆽𑆫𑇀𑆩𑆶𑆢𑇀𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆒𑆝𑆽𑆫𑆥𑆴𑇆𑇑𑇒𑇓𑇆
𑆢𑆳𑆝𑆴𑆩𑆳𑆩𑇀𑆬𑆽𑆂 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆽𑆫𑇀𑆢𑆵𑆥𑆤𑆓𑇀𑆫𑆳𑆲𑆴𑆱𑆁𑆪𑆶𑆠𑆽𑆂𑇅 𑆠𑆱𑇀𑆪𑆳𑆓𑇀𑆤𑆴𑆁 𑆢𑆵𑆥𑆪𑆼𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆨𑆴𑆯𑇀𑆖𑆳𑆥𑆴 𑆠𑆴𑆑𑇀𑆠𑆑𑆽𑆂𑇆𑇑𑇒𑇔𑇆
𑆥𑆛𑆾𑆬𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆳𑆯𑇀𑆮𑆠𑇀𑆡𑆮𑆛𑆥𑇀𑆬𑆑𑇀𑆰𑆑𑆥𑆵𑆠𑆤𑆳𑆤𑇀𑇅 𑆑𑆛𑆶𑆑𑆳𑆁 𑆫𑆾𑆲𑆴𑆟𑆵𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆤𑆴𑆩𑇀𑆧𑆁 𑆖 𑆢𑇀𑆮𑆴𑆥𑆬𑆳𑆁𑆯𑆴𑆑𑆩𑇀𑇆𑇑𑇒𑇖𑇆
𑆢𑇀𑆫𑆾𑆟𑆼𑇁𑆥𑆳𑆁 𑆱𑆳𑆣𑆪𑆼𑆠𑇀 𑆥𑆳𑆢𑆯𑆼𑆰𑆼 𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆔𑆸𑆠𑆳𑆠𑇀 𑆥𑆖𑆼𑆠𑇀𑇅 𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆮𑆵𑆫𑆳𑆩𑆳𑆓𑆣𑆴𑆑𑆾𑆠𑇀𑆥𑆬𑆽𑆂𑇆𑇑𑇒𑇗𑇆
𑆑𑆬𑇀𑆑𑆽𑆫𑆑𑇀𑆰𑆱𑆩𑆽𑆂 𑆥𑆼𑆪𑆁 𑆠𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆓𑇀𑆫𑆲𑆟𑆵𑆓𑆢𑆼𑇅 𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆪𑆢𑇀𑆔𑆸𑆠𑆁 𑆖𑆾𑆑𑇀𑆠𑆁 𑆑𑆿𑆰𑇀𑆜𑆴𑆑𑆼 𑆠𑆖𑇀𑆖 𑆢𑆳𑆥𑆪𑆼𑆠𑇀𑇆𑇑𑇒𑇘𑇆
𑆅𑆠𑆴 𑆖𑆤𑇀𑆢𑆤𑆳𑆢𑇀𑆪𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆤𑆳𑆓𑆫𑆳𑆠𑆴𑆮𑆴𑆰𑆼 𑆩𑆶𑆱𑇀𑆠𑆁 𑆣𑆳𑆠𑆑𑆵𑆁 𑆖 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇅 𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆮𑆑𑇀𑆦𑆬𑆁 𑆧𑆴𑆬𑇀𑆮𑆁 𑆥𑆳𑆜𑆳𑆁 𑆑𑆛𑆶𑆑𑆫𑆾𑆲𑆴𑆟𑆵𑆩𑇀𑇆𑇑𑇒𑇙𑇆
𑆥𑆴𑆧𑆼𑆠𑇀 𑆱𑆩𑆳𑆁𑆯𑆁 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆁 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳𑇅 𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆼 𑆫𑆑𑇀𑆠𑆁 𑆪𑆖𑇀𑆖𑆾𑆥𑆮𑆼𑆯𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇐𑇆
𑆃𑆫𑇀𑆯𑆳𑆁𑆱𑆴 𑆖 𑆓𑆶𑆢𑆼 𑆯𑆷𑆬𑆁 𑆘𑆪𑆼𑆖𑇀𑆖𑆽𑆮 𑆥𑇀𑆫𑆮𑆳𑆲𑆴𑆑𑆳𑆩𑇀𑇅 𑆤𑆳𑆓𑆫𑆳𑆢𑇀𑆪𑆩𑆴𑆢𑆁 𑆖𑆷𑆫𑇀𑆟𑆁 𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆥𑆷𑆘𑆴𑆠𑆩𑇀𑇆𑇑𑇓𑇑𑇆
𑆅𑆠𑆴 𑆤𑆳𑆓𑆫𑆳𑆢𑇀𑆪𑆁 𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆑𑆛𑆶𑆑𑆳𑆮𑇀𑆪𑆾𑆰𑆩𑆶𑆱𑇀𑆠𑆑𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆳𑆤𑇀 𑆱𑆩𑆳𑆤𑇀𑇅 𑆢𑇀𑆮𑆿 𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆢𑇀𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆮𑆓𑇀𑆨𑆳𑆓𑆳𑆤𑇀 𑆰𑆾𑆝𑆯 𑆖𑆷𑆫𑇀𑆟𑆪𑆼𑆠𑇀𑇆𑇑𑇓𑇒𑇆
𑆓𑆶𑆝𑆯𑆵𑆠𑆳𑆩𑇀𑆧𑆶𑆤𑆳 𑆥𑆵𑆠𑆁 𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆓𑆶𑆬𑇀𑆩𑆤𑆶𑆠𑇀𑇅 𑆑𑆳𑆩𑆬𑆳𑆘𑇀𑆮𑆫𑆥𑆳𑆟𑇀𑆝𑆶𑆠𑇀𑆮𑆩𑆼𑆲𑆳𑆫𑆶𑆖𑇀𑆪𑆠𑆴𑆱𑆳𑆫𑆤𑆶𑆠𑇀𑇆𑇑𑇓𑇓𑇆
𑆅𑆠𑆴 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆳𑆢𑇀𑆪𑆁 𑆖𑆷𑆫𑇀𑆟𑆩𑇀𑇅 𑆮𑆖𑆳𑆩𑆠𑆴𑆮𑆴𑆰𑆳𑆁 𑆥𑆳𑆜𑆳𑆁 𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆁 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆩𑇀𑇅 𑆱𑇀𑆪𑆾𑆤𑆳𑆑𑆾𑆢𑆵𑆖𑇀𑆪𑆑𑆛𑇀𑆮𑆕𑇀𑆓𑆮𑆠𑇀𑆱𑆑𑆠𑇀𑆮𑆓𑇀𑆢𑆶𑆫𑆳𑆬𑆨𑆳𑆂𑇆𑇑𑇓𑇔𑇆
𑆘𑆩𑇀𑆧𑇀𑆮𑆳𑆩𑇀𑆫𑆧𑆴𑆬𑇀𑆮𑆩𑆣𑇀𑆪𑆳𑆤𑆴 𑆤𑆴𑆩𑇀𑆧𑆯𑆳𑆑𑆦𑆬𑆳𑆤𑆴 𑆖𑇅 𑆠𑆢𑇀𑆫𑆾𑆓𑆯𑆩𑆩𑆤𑇀𑆮𑆴𑆖𑇀𑆗𑆤𑇀 𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆳𑆢𑇀𑆪𑆼𑆤 𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇓𑇖𑇆
𑆑𑆶𑆛𑆘𑆠𑇀𑆮𑆑𑇀𑆦𑆬𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆪𑆮𑆳𑆤𑆵 𑆢𑆼𑆮𑆢𑆳𑆫𑆶 𑆖𑇅 𑆥𑆛𑆾𑆬𑆤𑆴𑆩𑇀𑆧𑆥𑆠𑇀𑆫𑆽𑆬𑆳𑆱𑆿𑆫𑆳𑆰𑇀𑆛𑇀𑆫𑆪𑆠𑆴𑆮𑆴𑆰𑆳𑆠𑇀𑆮𑆖𑆂𑇆𑇑𑇓𑇘𑇆
𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆾𑆯𑇀𑆖 𑆧𑆵𑆘𑆳𑆤𑆴 𑆩𑆷𑆫𑇀𑆮𑆳 𑆥𑆫𑇀𑆥𑆛𑆑𑆱𑇀𑆠𑆡𑆳𑇅 𑆠𑆖𑇀𑆖𑆷𑆫𑇀𑆟𑆁 𑆩𑆣𑆶𑆤𑆳 𑆬𑆼𑆲𑇀𑆪𑆁 𑆥𑆼𑆪𑆁 𑆩𑆢𑇀𑆪𑆽𑆫𑇀𑆘𑆬𑆼𑆤 𑆮𑆳𑇆𑇑𑇓𑇙𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆟𑇀𑆝𑆶𑆓𑇀𑆫𑆲𑆟𑆵𑆫𑆾𑆓𑆓𑆶𑆬𑇀𑆩𑆯𑆷𑆬𑆳𑆫𑆶𑆖𑆴𑆘𑇀𑆮𑆫𑆳𑆤𑇀𑇅 𑆑𑆳𑆩𑆬𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆁 𑆖 𑆩𑆶𑆒𑆫𑆾𑆓𑆳𑆁𑆯𑇀𑆖 𑆤𑆳𑆯𑆪𑆼𑆠𑇀𑇆𑇑𑇔𑇐𑇆

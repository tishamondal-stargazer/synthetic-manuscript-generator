𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆘𑆳𑆠𑆴𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳 𑆖, 𑆑𑆶𑆬𑆥𑇀𑆫𑆱𑆑𑇀𑆠𑆳 𑆖, 𑆢𑆼𑆯𑆳𑆤𑆶𑆥𑆳𑆠𑆴𑆤𑆵 𑆖, 𑆑𑆳𑆬𑆳𑆤𑆶𑆥𑆳𑆠𑆴𑆤𑆵 𑆖 𑆮𑆪𑆾𑇁𑆤𑆶𑆥𑆳𑆠𑆴𑆤𑆵 𑆖, 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆴𑆪𑆠𑆳 𑆖𑆼𑆠𑆴𑇅 𑆘𑆳𑆠𑆴𑆑𑆶𑆬𑆢𑆼𑆯𑆑𑆳𑆬𑆮𑆪𑆂𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆤𑆴𑆪𑆠𑆳 𑆲𑆴 𑆠𑆼𑆰𑆳𑆁 𑆠𑆼𑆰𑆳𑆁 𑆥𑆶𑆫𑆶𑆰𑆳𑆟𑆳𑆁 𑆠𑆼 𑆠𑆼 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇕𑇆
𑆮𑆴𑆑𑆸𑆠𑆴𑆂 𑆥𑆶𑆤𑆫𑇀𑆬𑆑𑇀𑆰𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆖, 𑆬𑆑𑇀𑆰𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆖, 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆶𑆫𑆷𑆥𑆳 𑆖𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆬𑆑𑇀𑆰𑆟𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆤𑆳𑆩 𑆱𑆳 𑆪𑆱𑇀𑆪𑆳𑆂 𑆯𑆫𑆵𑆫𑆼 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆼𑆮 𑆲𑆼𑆠𑆶𑆨𑆷𑆠𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴 𑆢𑆽𑆮𑆳𑆠𑇀; 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑆴 𑆲𑆴 𑆑𑆳𑆤𑆴𑆖𑆴𑆖𑇀𑆗𑆫𑆵𑆫𑆾𑆥𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆪𑆳𑆤𑆴 𑆲𑆴 𑆠𑆱𑇀𑆩𑆴𑆁𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆳𑆬𑆼 𑆠𑆠𑇀𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆳𑆱𑆳𑆢𑇀𑆪 𑆠𑆳𑆁 𑆠𑆳𑆁 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆶𑆠𑇀𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴𑇅𑇗𑇅 𑆬𑆑𑇀𑆰𑇀𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳 𑆠𑆶 𑆱𑆳 𑆪𑆱𑇀𑆪𑆳 𑆇𑆥𑆬𑆨𑇀𑆪𑆠𑆼 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆪𑆡𑆾𑆑𑇀𑆠𑆁 𑆤𑆴𑆢𑆳𑆤𑆼𑆰𑆶𑇅𑇗𑇅 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆤𑆶𑆫𑆷𑆥𑆳 𑆠𑆶 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆫𑇀𑆡𑆳𑆤𑆶𑆑𑆳𑆫𑆴𑆟𑆵 𑆪𑆳, 𑆠𑆳𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆁 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆘𑇀𑆚𑆳𑆤𑆱𑇀𑆪𑆼𑆖𑇀𑆗𑆤𑇀𑆠𑆴 𑆨𑆴𑆰𑆘𑆾 𑆨𑆷𑆪𑆯𑇀𑆖𑆳𑆪𑆶𑆰𑆂 𑆑𑇀𑆰𑆪𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆁 𑆥𑇀𑆫𑆼𑆠𑆼𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆶𑆫𑆷𑆥𑆳𑆁, 𑆪𑆳𑆩𑆳𑆪𑆶𑆰𑆾𑇁𑆤𑇀𑆠𑆫𑇀𑆓𑆠𑆱𑇀𑆪 𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆶𑆥𑆢𑆴𑆯𑆤𑇀𑆠𑆴 𑆣𑆵𑆫𑆳𑆂𑇅 𑆪𑆳𑆁 𑆖𑆳𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆥𑆶𑆫𑆶𑆰𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆟𑆴 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆳𑆤𑇀𑆪𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂𑇅 𑆅𑆠𑇀𑆪𑆶𑆢𑇀𑆢𑆼𑆯𑆂𑇅 𑆠𑆁 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟𑆳𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇗𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆴𑆠 𑆍𑆮 𑆮𑆫𑇀𑆟𑆳𑆣𑆴𑆑𑆳𑆫𑆂𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆸𑆰𑇀𑆟𑆂, 𑆯𑇀𑆪𑆳𑆩𑆂 , 𑆯𑇀𑆪𑆳𑆩𑆳𑆮𑆢𑆳𑆠𑆂, 𑆃𑆮𑆢𑆳𑆠𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆳𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑆶𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆾 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆤𑆷𑆑𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆮𑆳𑇁𑆥𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆳𑆁𑆱𑇀𑆠𑆘𑇀𑆘𑇀𑆚𑆽𑆂𑇆𑇘𑇆
𑆤𑆵𑆬𑆯𑇀𑆪𑆳𑆮𑆠𑆳𑆩𑇀𑆫𑆲𑆫𑆴𑆠𑆯𑆶𑆑𑇀𑆬𑆳𑆯𑇀𑆖 𑆮𑆫𑇀𑆟𑆳𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑆶𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆾 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆑𑆸𑆠𑆳𑆤𑆨𑆷𑆠𑇀𑆮𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆳𑆤𑇀 𑇅 𑆅𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆯𑆫𑆵𑆫𑆱𑇀𑆪𑇅 𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆩𑆫𑇀𑆣𑆯𑆫𑆵𑆫𑆼 𑆮𑆴𑆑𑆸𑆠𑆴𑆮𑆫𑇀𑆟𑆩𑆫𑇀𑆣𑆯𑆫𑆵𑆫𑆼, 𑆢𑇀𑆮𑆳𑆮𑆥𑆴 𑆮𑆫𑇀𑆟𑆿 𑆩𑆫𑇀𑆪𑆳𑆢𑆳𑆮𑆴𑆨𑆑𑇀𑆠𑆿 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳; 𑆪𑆢𑇀𑆪𑆼𑆮𑆁 𑆱𑆮𑇀𑆪𑆢𑆑𑇀𑆰𑆴𑆟𑆮𑆴𑆨𑆳𑆓𑆼𑆤, 𑆪𑆢𑇀𑆪𑆼𑆮𑆁 𑆥𑆷𑆫𑇀𑆮𑆥𑆯𑇀𑆖𑆴𑆩𑆮𑆴𑆨𑆳𑆓𑆼𑆤, 𑆪𑆢𑇀𑆪𑆶𑆠𑇀𑆠𑆫𑆳𑆣𑆫𑆮𑆴𑆨𑆳𑆓𑆼𑆤, 𑆪𑆢𑇀𑆪𑆤𑇀𑆠𑆫𑇀𑆧𑆲𑆴𑆫𑇀𑆮𑆴𑆨𑆳𑆓𑆼𑆤, 𑆄𑆠𑆶𑆫𑆱𑇀𑆪𑆳𑆫𑆴𑆰𑇀𑆛𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀; 𑆍𑆮𑆩𑆼𑆮 𑆮𑆫𑇀𑆟𑆨𑆼𑆢𑆾 𑆩𑆶𑆒𑆼𑇁𑆥𑇀𑆪𑆤𑇀𑆪𑆠𑇀𑆫 𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆾 𑆩𑆫𑆟𑆳𑆪 𑆨𑆮𑆠𑆴𑇆𑇙𑇆
𑆮𑆫𑇀𑆟𑆨𑆼𑆢𑆼𑆤 𑆓𑇀𑆬𑆳𑆤𑆴𑆲𑆫𑇀𑆰𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆱𑇀𑆤𑆼𑆲𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳𑆂𑇆𑇑𑇐𑇆
𑆠𑆡𑆳 𑆥𑆴𑆥𑇀𑆬𑆶𑆮𑇀𑆪𑆕𑇀𑆓𑆠𑆴𑆬𑆑𑆳𑆬𑆑𑆥𑆴𑆝𑆑𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪𑆳𑆤𑆤𑆼 𑆘𑆤𑇀𑆩𑆳𑆠𑆶𑆫𑆱𑇀𑆪𑆽𑆮𑆩𑆼𑆮𑆳𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇑𑇑𑇆
𑆤𑆒𑆤𑆪𑆤𑆮𑆢𑆤𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆲𑆱𑇀𑆠𑆥𑆳𑆢𑆿𑆰𑇀𑆜𑆳𑆢𑆴𑆰𑇀𑆮𑆥𑆴 𑆖 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆾𑆑𑇀𑆠𑆳𑆤𑆳𑆁 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆢𑆶𑆫𑇀𑆨𑆳𑆮𑆾 𑆲𑆵𑆤𑆧𑆬𑆮𑆫𑇀𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆰𑆶 𑆬𑆑𑇀𑆰𑆟𑆩𑆳𑆪𑆶𑆰𑆂 𑆑𑇀𑆰𑆪𑆱𑇀𑆪 𑆨𑆮𑆠𑆴𑇆𑇑𑇒𑇆
𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆮𑆫𑇀𑆟𑆮𑆽𑆑𑆸𑆠𑆩𑆨𑆷𑆠𑆥𑆷𑆫𑇀𑆮𑆁 𑆱𑆲𑆱𑆾𑆠𑇀𑆥𑆢𑇀𑆪𑆼𑆠𑆳𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆩𑆼𑆮 𑆲𑆵𑆪𑆩𑆳𑆤𑆱𑇀𑆪𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆯𑆯𑇀𑆮𑆠𑇀, 𑆠𑆢𑆫𑆴𑆰𑇀𑆛𑆩𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆮𑆫𑇀𑆟𑆳𑆣𑆴𑆑𑆳𑆫𑆂𑇆𑇑𑇓𑇆
𑆱𑇀𑆮𑆫𑆳𑆣𑆴𑆑𑆳𑆫𑆱𑇀𑆠𑆶- 𑆲𑆁𑆱𑆑𑇀𑆫𑆿𑆚𑇀𑆖𑆤𑆼𑆩𑆴𑆢𑆶𑆤𑇀𑆢𑆶𑆨𑆴𑆑𑆬𑆮𑆴𑆕𑇀𑆑𑆑𑆳𑆑𑆑𑆥𑆾𑆠𑆘𑆫𑇀𑆘𑆫𑆳𑆤𑆶𑆑𑆳𑆫𑆳𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆮𑆫𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑆶𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆾𑇁𑆥𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆤𑆷𑆑𑆠𑆾𑇁𑆤𑇀𑆪𑆡𑆳 𑆮𑆳𑇁𑆥𑆴 𑆤𑆴𑆫𑇀𑆢𑆴𑆯𑇀𑆪𑆩𑆳𑆤𑆳𑆁𑆱𑇀𑆠𑆘𑇀𑆘𑇀𑆚𑆽𑆂𑇅 𑆍𑆝𑆑𑆑𑆬𑆓𑇀𑆫𑆱𑇀𑆠𑆳𑆮𑇀𑆪𑆑𑇀𑆠𑆓𑆢𑇀𑆓𑆢𑆑𑇀𑆰𑆳𑆩𑆢𑆵𑆤𑆳𑆤𑆶𑆑𑆵𑆫𑇀𑆟𑆳𑆱𑇀𑆠𑇀𑆮𑆳𑆠𑆶𑆫𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆫𑆳 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆪𑆳𑆁𑆯𑇀𑆖𑆳𑆥𑆫𑆳𑆤𑆶𑆥𑆼𑆑𑇀𑆰𑆩𑆳𑆟𑆾𑇁𑆥𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆓𑇀𑆮𑆴𑆑𑆸𑆠𑆳𑆤𑆨𑆷𑆠𑇀𑆮𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆳𑆤𑇀 𑇅 𑆅𑆠𑆴 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆴𑆑𑆸𑆠𑆴𑆱𑇀𑆮𑆫𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇑𑇔𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆫𑆳𑆟𑆳𑆩𑆳𑆯𑇀𑆮𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆮𑆫𑆳𑆤𑆼𑆑𑆠𑇀𑆮𑆩𑆼𑆑𑆱𑇀𑆪 𑆖𑆳𑆤𑆼𑆑𑆠𑇀𑆮𑆩𑆥𑇀𑆫𑆯𑆱𑇀𑆠𑆩𑇀𑇅 𑆅𑆠𑆴 𑆱𑇀𑆮𑆫𑆳𑆣𑆴𑆑𑆳𑆫𑆂𑇆𑇑𑇕𑇆
𑆅𑆠𑆴 𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆣𑆴𑆑𑆳𑆫𑆿 𑆪𑆡𑆳𑆮𑆢𑆶𑆑𑇀𑆠𑆿 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆘𑇀𑆚𑆳𑆤𑆳𑆫𑇀𑆡𑆩𑆴𑆠𑆴𑇆𑇑𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆪𑆱𑇀𑆪 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆾 𑆮𑆫𑇀𑆟𑆂 𑆯𑆫𑆵𑆫 𑆇𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆃𑆫𑇀𑆣𑆼 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳 𑆑𑆸𑆠𑇀𑆱𑇀𑆤𑆼 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆤 𑆖 𑆤𑆳𑆱𑇀𑆠𑆴 𑆱𑆂𑇆𑇑𑇗𑇆
𑆤𑆵𑆬𑆁 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳 𑆯𑇀𑆪𑆳𑆮𑆁 𑆠𑆳𑆩𑇀𑆫𑆁 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳𑇁𑆫𑆶𑆟𑆩𑇀𑇅 𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆩𑆤𑇀𑆪𑆡𑆳 𑆮𑆫𑇀𑆟𑆾 𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆼𑇁𑆫𑆴𑆰𑇀𑆛𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇘𑇆
𑆱𑇀𑆤𑆼𑆲𑆾 𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆼 𑆱𑆶𑆮𑇀𑆪𑆑𑇀𑆠𑆾 𑆫𑆿𑆑𑇀𑆰𑇀𑆪𑆩𑆫𑇀𑆣𑆩𑆶𑆒𑆼 𑆨𑆸𑆯𑆩𑇀𑇅 𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑆫𑇀𑆣𑆼 𑆠𑆡𑆳 𑆲𑆫𑇀𑆰𑆾 𑆩𑆶𑆒𑆳𑆫𑇀𑆣𑆼 𑆥𑇀𑆫𑆼𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇙𑇆
𑆠𑆴𑆬𑆑𑆳𑆂 𑆥𑆴𑆥𑇀𑆬𑆮𑆾 𑆮𑇀𑆪𑆕𑇀𑆓𑆳 𑆫𑆳𑆘𑆪𑆯𑇀𑆖 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆂𑇅 𑆄𑆠𑆶𑆫𑆱𑇀𑆪𑆳𑆯𑆶 𑆘𑆳𑆪𑆤𑇀𑆠𑆼 𑆩𑆶𑆒𑆼 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀 𑆩𑆶𑆩𑆶𑆑𑇀𑆰𑆠𑆂𑇆𑇒𑇐𑇆
𑆥𑆶𑆰𑇀𑆥𑆳𑆟𑆴 𑆤𑆒𑆢𑆤𑇀𑆠𑆼𑆰𑆶 𑆥𑆕𑇀𑆑𑆾 𑆮𑆳 𑆢𑆤𑇀𑆠𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑆂𑇅 𑆖𑆷𑆫𑇀𑆟𑆑𑆾 𑆮𑆳𑇁𑆥𑆴 𑆢𑆤𑇀𑆠𑆼𑆰𑆶 𑆬𑆑𑇀𑆰𑆟𑆁 𑆩𑆫𑆟𑆱𑇀𑆪 𑆠𑆠𑇀𑇆𑇒𑇑𑇆
𑆏𑆰𑇀𑆜𑆪𑆾𑆂 𑆥𑆳𑆢𑆪𑆾𑆂 𑆥𑆳𑆟𑇀𑆪𑆾𑆫𑆑𑇀𑆰𑇀𑆟𑆾𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆪𑆾𑆂𑇅 𑆤𑆒𑆼𑆰𑇀𑆮𑆥𑆴 𑆖 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆩𑆼𑆠𑆠𑇀 𑆑𑇀𑆰𑆵𑆟𑆧𑆬𑆼𑇁𑆤𑇀𑆠𑆑𑆸𑆠𑇀𑇆𑇒𑇒𑇆
𑆪𑆱𑇀𑆪 𑆤𑆵𑆬𑆳𑆮𑆶𑆨𑆳𑆮𑆾𑆰𑇀𑆜𑆿 𑆥𑆑𑇀𑆮𑆘𑆳𑆩𑇀𑆧𑆮𑆱𑆤𑇀𑆤𑆴𑆨𑆿𑇅 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆶𑆫𑆴𑆠𑆴 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑇀𑆤𑆫𑆾 𑆣𑆵𑆫𑆾 𑆓𑆠𑆳𑆪𑆶𑆰𑆩𑇀𑇆𑇒𑇓𑇆
𑆍𑆑𑆾 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳𑇁𑆤𑆼𑆑𑆾 𑆪𑆱𑇀𑆪 𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆂 𑆱𑇀𑆮𑆫𑆂𑇅 𑆱𑆲𑆱𑆾𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆘𑆤𑇀𑆠𑆾𑆫𑇀𑆲𑆵𑆪𑆩𑆳𑆤𑆱𑇀𑆪 𑆤𑆳𑆱𑇀𑆠𑆴 𑆱𑆂𑇆𑇒𑇔𑇆
𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆽𑆑𑆸𑆠𑆁 𑆱𑇀𑆮𑆫𑆮𑆫𑇀𑆟𑆪𑆾𑆂𑇅 𑆧𑆬𑆩𑆳𑆁𑆱𑆮𑆴𑆲𑆵𑆤𑆱𑇀𑆪 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆩𑆫𑆟𑆾𑆢𑆪𑆩𑇀 𑇆𑇒𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆅𑆠𑆴 𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆮𑆶𑆑𑇀𑆠𑆿 𑆬𑆑𑇀𑆰𑆟𑆳𑆫𑇀𑆡𑆁 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆳𑆩𑇀𑇅 𑆪𑆱𑇀𑆠𑆿 𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆴𑆘𑆳𑆤𑆳𑆠𑆴 𑆤𑆳𑆪𑆶𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆼 𑆱 𑆩𑆶𑆲𑇀𑆪𑆠𑆴𑇆𑇒𑇖𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆑𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆲𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆥𑆶𑆰𑇀𑆥𑆁 𑆪𑆡𑆳 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆦𑆬𑆱𑇀𑆪𑆼𑆲 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆂𑇅 𑆠𑆡𑆳 𑆬𑆴𑆕𑇀𑆓𑆩𑆫𑆴𑆰𑇀𑆛𑆳𑆒𑇀𑆪𑆁 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆁 𑆩𑆫𑆴𑆰𑇀𑆪𑆠𑆂𑇆𑇓𑇆
𑆃𑆥𑇀𑆪𑆼𑆮𑆁 𑆠𑆶 𑆨𑆮𑆼𑆠𑇀 𑆥𑆶𑆰𑇀𑆥𑆁 𑆦𑆬𑆼𑆤𑆳𑆤𑆤𑆶𑆧𑆤𑇀𑆣𑆴 𑆪𑆠𑇀𑇅 𑆦𑆬𑆁 𑆖𑆳𑆥𑆴 𑆨𑆮𑆼𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑇀𑆪𑆱𑇀𑆪 𑆥𑆶𑆰𑇀𑆥𑆁 𑆤 𑆥𑆷𑆫𑇀𑆮𑆘𑆩𑇀 𑇆𑇔𑇆
𑆤 𑆠𑇀𑆮𑆫𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑆘𑆳𑆠𑆱𑇀𑆪 𑆤𑆳𑆯𑆾𑇁𑆱𑇀𑆠𑆴 𑆩𑆫𑆟𑆳𑆢𑆸𑆠𑆼𑇅 𑆩𑆫𑆟𑆁 𑆖𑆳𑆥𑆴 𑆠𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆪𑆤𑇀𑆤𑆳𑆫𑆴𑆰𑇀𑆛𑆥𑆶𑆫𑆂𑆱𑆫𑆩𑇀𑇆𑇕𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆢𑆸𑆰𑇀𑆛𑆩𑆫𑆴𑆰𑇀𑆛𑆳𑆨𑆩𑆤𑆫𑆴𑆰𑇀𑆛𑆩𑆘𑆳𑆤𑆠𑆳𑇅 𑆃𑆫𑆴𑆰𑇀𑆛𑆁 𑆮𑆳𑇁𑆥𑇀𑆪𑆱𑆩𑇀𑆧𑆶𑆢𑇀𑆣𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆘𑆩𑇀𑇆𑇖𑇆
𑆘𑇀𑆚𑆳𑆤𑆱𑆩𑇀𑆧𑆾𑆣𑆤𑆳𑆫𑇀𑆡𑆁 𑆠𑆶 𑆬𑆴𑆕𑇀𑆓𑆽𑆫𑇀𑆩𑆫𑆟𑆥𑆷𑆫𑇀𑆮𑆘𑆽𑆂𑇅 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆳𑆤𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾 𑆤𑆫𑆳𑆤𑇀 𑆧𑆲𑆶𑆮𑆴𑆣𑆽𑆫𑇀𑆧𑆲𑆷𑆤𑇀 𑇆𑇗𑇆
𑆤𑆳𑆤𑆳𑆥𑆶𑆰𑇀𑆥𑆾𑆥𑆩𑆾 𑆓𑆤𑇀𑆣𑆾 𑆪𑆱𑇀𑆪 𑆨𑆳𑆠𑆴 𑆢𑆴𑆮𑆳𑆤𑆴𑆯𑆩𑇀𑇅 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆱𑇀𑆪 𑆮𑆤𑆱𑇀𑆪𑆼𑆮 𑆤𑆳𑆤𑆳𑆢𑇀𑆫𑆶𑆩𑆬𑆠𑆳𑆮𑆠𑆂𑇆𑇘𑇆
𑆠𑆩𑆳𑆲𑆶𑆂 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆁 𑆣𑆵𑆫𑆳 𑆤𑆫𑆁 𑆩𑆫𑆟𑆬𑆑𑇀𑆰𑆟𑆽𑆂𑇅 𑆱 𑆤𑆳 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆳𑆢𑇀𑆢𑆼𑆲𑆁 𑆘𑆲𑆳𑆠𑆵𑆠𑆴 𑆮𑆴𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇙𑇆
𑆍𑆮𑆩𑆼𑆑𑆽𑆑𑆯𑆂 𑆥𑆶𑆰𑇀𑆥𑆽𑆫𑇀𑆪𑆱𑇀𑆪 𑆓𑆤𑇀𑆣𑆂 𑆱𑆩𑆾 𑆨𑆮𑆼𑆠𑇀𑇅 𑆅𑆰𑇀𑆛𑆽𑆫𑇀𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳𑇁𑆤𑆴𑆰𑇀𑆛𑆽𑆂 𑆱 𑆖 𑆥𑆶𑆰𑇀𑆥𑆴𑆠 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇐𑇆
𑆱𑆩𑆳𑆱𑆼𑆤𑆳𑆯𑆶𑆨𑆳𑆤𑇀 𑆓𑆤𑇀𑆣𑆳𑆤𑆼𑆑𑆠𑇀𑆮𑆼𑆤𑆳𑆡𑆮𑆳 𑆥𑆶𑆤𑆂𑇅 𑆄𑆘𑆴𑆔𑇀𑆫𑆼𑆢𑇀𑆪𑆱𑇀𑆪 𑆓𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆠𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆁 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇑𑇆
𑆄𑆥𑇀𑆬𑆶𑆠𑆳𑆤𑆳𑆥𑇀𑆬𑆶𑆠𑆼 𑆑𑆳𑆪𑆼 𑆪𑆱𑇀𑆪 𑆓𑆤𑇀𑆣𑆳𑆂 𑆯𑆶𑆨𑆳𑆯𑆶𑆨𑆳𑆂𑇅 𑆮𑇀𑆪𑆠𑇀𑆪𑆳𑆱𑆼𑆤𑆳𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆳𑆂 𑆱𑇀𑆪𑆶𑆂 𑆱 𑆖 𑆥𑆶𑆰𑇀𑆥𑆴𑆠 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇆
𑆪𑆼 𑆖𑆳𑆤𑇀𑆪𑆼 𑆮𑆴𑆮𑆴𑆣𑆳𑆠𑇀𑆩𑆳𑆤𑆾 𑆓𑆤𑇀𑆣𑆳 𑆮𑆴𑆮𑆴𑆣𑆪𑆾𑆤𑆪𑆂𑇅 𑆠𑆼𑇁𑆥𑇀𑆪𑆤𑆼𑆤𑆳𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆳 𑆮𑆴𑆑𑆸𑆠𑆴𑆁 𑆓𑆠𑆳𑆂𑇆𑇑𑇔𑇆
𑆅𑆢𑆁 𑆖𑆳𑆥𑇀𑆪𑆠𑆴𑆢𑆼𑆯𑆳𑆫𑇀𑆡𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆓𑆤𑇀𑆣𑆱𑆁𑆯𑇀𑆫𑆪𑆩𑇀𑇅 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆾 𑆪𑆢𑆨𑆴𑆘𑇀𑆚𑆳𑆪 𑆨𑆴𑆰𑆕𑇀𑆩𑆫𑆟𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇑𑇕𑇆
𑆮𑆴𑆪𑆾𑆤𑆴𑆫𑇀𑆮𑆴𑆢𑆶𑆫𑆾 𑆓𑆤𑇀𑆣𑆾 𑆪𑆱𑇀𑆪 𑆓𑆳𑆠𑇀𑆫𑆼𑆰𑆶 𑆘𑆳𑆪𑆠𑆼𑇅 𑆅𑆰𑇀𑆛𑆾 𑆮𑆳 𑆪𑆢𑆴 𑆮𑆳𑇁𑆤𑆴𑆰𑇀𑆛𑆾 𑆤 𑆱 𑆘𑆵𑆮𑆠𑆴 𑆠𑆳𑆁 𑆱𑆩𑆳𑆩𑇀𑇆𑇑𑇖𑇆
𑆍𑆠𑆳𑆮𑆢𑇀𑆓𑆤𑇀𑆣𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁,...𑇅𑇑𑇗𑇅 ...𑆫𑆱𑆘𑇀𑆚𑆳𑆤𑆩𑆠𑆂 𑆥𑆫𑆩𑇀𑇅 𑆄𑆠𑆶𑆫𑆳𑆟𑆳𑆁 𑆯𑆫𑆵𑆫𑆼𑆰𑆶 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆮𑆴𑆣𑆴𑆥𑆷𑆫𑇀𑆮𑆑𑆩𑇀𑇆𑇑𑇗𑇆
𑆪𑆾 𑆫𑆱𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆳𑆤𑆳𑆁 𑆤𑆫𑆳𑆟𑆳𑆁 𑆢𑆼𑆲𑆱𑆩𑇀𑆨𑆮𑆂𑇅 𑆱 𑆍𑆰𑆳𑆁 𑆖𑆫𑆩𑆼 𑆑𑆳𑆬𑆼 𑆮𑆴𑆑𑆳𑆫𑆁 𑆨𑆘𑆠𑆼 𑆢𑇀𑆮𑆪𑆩𑇀𑇆𑇑𑇘𑇆
𑆑𑆯𑇀𑆖𑆴𑆢𑆼𑆮𑆳𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆩𑆠𑇀𑆪𑆫𑇀𑆡𑆩𑆶𑆥𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆱𑇀𑆮𑆳𑆢𑆶𑆠𑇀𑆮𑆩𑆥𑆫𑆯𑇀𑆖𑆳𑆥𑆴 𑆮𑆴𑆥𑆶𑆬𑆁 𑆨𑆘𑆠𑆼 𑆫𑆱𑆂𑇆𑇑𑇙𑇆
𑆠𑆩𑆤𑆼𑆤𑆳𑆤𑆶𑆩𑆳𑆤𑆼𑆤 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆓𑆠𑆩𑇀𑇅 𑆩𑆤𑆶𑆰𑇀𑆪𑆾 𑆲𑆴 𑆩𑆤𑆶𑆰𑇀𑆪𑆱𑇀𑆪 𑆑𑆡𑆁 𑆫𑆱𑆩𑆮𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆠𑇀𑇆𑇒𑇐𑇆
𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆯𑇀𑆖𑆽𑆮 𑆪𑆷𑆑𑆳𑆯𑇀𑆖 𑆢𑆁𑆯𑆳𑆯𑇀𑆖 𑆩𑆯𑆑𑆽𑆂 𑆱𑆲𑇅 𑆮𑆴𑆫𑆱𑆳𑆢𑆥𑆱𑆫𑇀𑆥𑆤𑇀𑆠𑆴 𑆘𑆤𑇀𑆠𑆾𑆂 𑆑𑆳𑆪𑆳𑆤𑇀𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆂𑇆𑇒𑇑𑇆
𑆃𑆠𑇀𑆪𑆫𑇀𑆡𑆫𑆱𑆴𑆑𑆁 𑆑𑆳𑆪𑆁 𑆑𑆳𑆬𑆥𑆑𑇀𑆮𑆱𑇀𑆪 𑆩𑆑𑇀𑆰𑆴𑆑𑆳𑆂𑇅 𑆃𑆥𑆴 𑆱𑇀𑆤𑆳𑆠𑆳𑆤𑆶𑆬𑆴𑆥𑇀𑆠𑆱𑇀𑆪 𑆨𑆸𑆯𑆩𑆳𑆪𑆳𑆤𑇀𑆠𑆴 𑆱𑆫𑇀𑆮𑆯𑆂𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆼𑆤 𑆩𑆪𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆫𑆱𑆓𑆤𑇀𑆣𑆪𑆾𑆂𑇅 𑆥𑆶𑆰𑇀𑆥𑆴𑆠𑆱𑇀𑆪 𑆤𑆫𑆱𑇀𑆪𑆽𑆠𑆠𑇀𑆦𑆬𑆁 𑆩𑆫𑆟𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇒𑇓𑇆
𑆃𑆡𑆳𑆠𑆂 𑆥𑆫𑆴𑆩𑆫𑇀𑆯𑆤𑆵𑆪𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆮𑆫𑇀𑆟𑆼 𑆱𑇀𑆮𑆫𑆼 𑆖 𑆓𑆤𑇀𑆣𑆼 𑆖 𑆫𑆱𑆼 𑆖𑆾𑆑𑇀𑆠𑆁 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀𑇅 𑆬𑆴𑆕𑇀𑆓𑆁 𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆠𑆳𑆁 𑆱𑆩𑇀𑆪𑆑𑇀 𑆱𑇀𑆥𑆫𑇀𑆯𑆼𑆰𑇀𑆮𑆥𑆴 𑆤𑆴𑆧𑆾𑆣𑆠𑇆𑇓𑇆
𑆱𑇀𑆥𑆫𑇀𑆯𑆥𑇀𑆫𑆳𑆣𑆳𑆤𑇀𑆪𑆼𑆤𑆽𑆮𑆳𑆠𑆶𑆫𑆱𑇀𑆪𑆳𑆪𑆶𑆰𑆂 𑆥𑇀𑆫𑆩𑆳𑆟𑆳𑆮𑆯𑆼𑆰𑆁 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆶𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆼𑆤 𑆥𑆳𑆟𑆴𑆤𑆳 𑆯𑆫𑆵𑆫𑆩𑆱𑇀𑆪 𑆑𑆼𑆮𑆬𑆁 𑆱𑇀𑆥𑆸𑆯𑆼𑆠𑇀, 𑆥𑆫𑆴𑆩𑆫𑇀𑆯𑆪𑆼𑆢𑇀𑆮𑆳𑇁𑆤𑇀𑆪𑆼𑆤𑇅 𑆥𑆫𑆴𑆩𑆸𑆯𑆠𑆳 𑆠𑆶 𑆒𑆬𑇀𑆮𑆳𑆠𑆶𑆫𑆯𑆫𑆵𑆫𑆩𑆴𑆩𑆼 𑆨𑆳𑆮𑆳𑆱𑇀𑆠𑆠𑇀𑆫 𑆠𑆠𑇀𑆫𑆳𑆮𑆧𑆾𑆢𑇀𑆣𑆮𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆱𑆠𑆠𑆁 𑆱𑇀𑆥𑆤𑇀𑆢𑆩𑆳𑆤𑆳𑆤𑆳𑆁 𑆯𑆫𑆵𑆫𑆢𑆼𑆯𑆳𑆤𑆳𑆩𑆱𑇀𑆥𑆤𑇀𑆢𑆤𑆁, 𑆤𑆴𑆠𑇀𑆪𑆾𑆰𑇀𑆩𑆟𑆳𑆁 𑆯𑆵𑆠𑆵𑆨𑆳𑆮𑆂, 𑆩𑆸𑆢𑆷𑆤𑆳𑆁 𑆢𑆳𑆫𑆶𑆟𑆠𑇀𑆮𑆁, 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆒𑆫𑆠𑇀𑆮𑆁, 𑆱𑆠𑆳𑆩𑆱𑆢𑇀𑆨𑆳𑆮𑆂 , 𑆱𑆤𑇀𑆣𑆵𑆤𑆳𑆁 𑆱𑇀𑆫𑆁𑆱𑆨𑇀𑆫𑆁𑆯𑆖𑇀𑆪𑆮𑆤𑆳𑆤𑆴; 𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆪𑆾𑆫𑇀𑆮𑆵𑆠𑆵𑆨𑆳𑆮𑆂, 𑆢𑆳𑆫𑆶𑆟𑆠𑇀𑆮𑆁, 𑆱𑇀𑆮𑆼𑆢𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆂, 𑆱𑇀𑆠𑆩𑇀𑆨𑆾 𑆮𑆳; 𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆢𑆵𑆢𑆸𑆯𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆤𑆳𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆨𑆸𑆯𑆮𑆴𑆑𑆸𑆠𑆩𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆁 𑆱𑇀𑆪𑆳𑆠𑇀𑇅 𑆅𑆠𑆴 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆩𑆶𑆑𑇀𑆠𑆁 𑆱𑆩𑆳𑆱𑆼𑆤𑇆𑇔𑇆
𑆠𑆢𑇀𑆮𑇀𑆪𑆳𑆱𑆠𑆾𑇁𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂- 𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑇀 𑆥𑆫𑆴𑆩𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆁 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤 𑆥𑆳𑆢𑆘𑆕𑇀𑆔𑆾𑆫𑆶𑆱𑇀𑆦𑆴𑆓𑆶𑆢𑆫𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆥𑆸𑆰𑇀𑆜𑆼𑆰𑆴𑆑𑆳𑆥𑆳𑆟𑆴𑆓𑇀𑆫𑆵𑆮𑆳𑆠𑆳𑆬𑇀𑆮𑆾𑆰𑇀𑆜𑆬𑆬𑆳𑆛𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆁 𑆯𑆵𑆠𑆁 𑆱𑇀𑆠𑆧𑇀𑆣𑆁 𑆢𑆳𑆫𑆶𑆟𑆁 𑆮𑆵𑆠𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆁 𑆮𑆳 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆥𑆫𑆳𑆱𑆶𑆫𑆪𑆁 𑆥𑆶𑆫𑆶𑆰𑆾 𑆤 𑆖𑆴𑆫𑆳𑆠𑇀 𑆑𑆳𑆬𑆁 𑆩𑆫𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑇀 𑆥𑆫𑆴𑆩𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆴 𑆥𑆸𑆡𑆑𑇀𑆠𑇀𑆮𑆼𑆤 𑆓𑆶𑆬𑇀𑆦𑆘𑆳𑆤𑆶𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆓𑆶𑆢𑆮𑆸𑆰𑆟𑆩𑆼𑆞𑇀𑆫𑆤𑆳𑆨𑇀𑆪𑆁𑆱𑆱𑇀𑆠𑆤𑆩𑆟𑆴𑆑𑆥𑆫𑇀𑆯𑆶𑆑𑆳𑆲𑆤𑆶𑆤𑆳𑆱𑆴𑆑𑆳𑆑𑆫𑇀𑆟𑆳𑆑𑇀𑆰𑆴𑆨𑇀𑆫𑆷𑆯𑆕𑇀𑆒𑆳𑆢𑆵𑆤𑆴 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆤𑆴 𑆮𑇀𑆪𑆱𑇀𑆠𑆳𑆤𑆴 𑆖𑇀𑆪𑆶𑆠𑆳𑆤𑆴 𑆱𑇀𑆡𑆳𑆤𑆼𑆨𑇀𑆪𑆂 𑆱𑇀𑆑𑆤𑇀𑆤𑆳𑆤𑆴 𑆮𑆳 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆪𑆁 𑆥𑆶𑆫𑆶𑆰𑆾𑇁𑆖𑆴𑆫𑆳𑆠𑇀 𑆑𑆳𑆬𑆁 𑆩𑆫𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇕𑇆
𑆠𑆡𑆳𑇁𑆱𑇀𑆪𑆾𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆩𑆤𑇀𑆪𑆳𑆢𑆤𑇀𑆠𑆥𑆑𑇀𑆰𑇀𑆩𑆖𑆑𑇀𑆰𑆶𑆂𑆑𑆼𑆯𑆬𑆾𑆩𑆾𑆢𑆫𑆤𑆒𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆫𑆳𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆢𑆶𑆖𑇀𑆗𑇀𑆮𑆳𑆱𑆾𑇁𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆾𑇁𑆠𑆴𑆲𑇀𑆫𑆱𑇀𑆮𑆾 𑆮𑆳 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆤𑇀𑆩𑆤𑇀𑆪𑆼 𑆥𑆫𑆴𑆩𑆸𑆯𑇀𑆪𑆩𑆳𑆤𑆼 𑆤 𑆱𑇀𑆥𑆤𑇀𑆢𑆼𑆪𑆳𑆠𑆳𑆁, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆢𑇀𑆢𑆤𑇀𑆠𑆳𑆂 𑆥𑆫𑆴𑆑𑆵𑆫𑇀𑆟𑆳𑆂 𑆯𑇀𑆮𑆼𑆠𑆳 𑆘𑆳𑆠𑆯𑆫𑇀𑆑𑆫𑆳𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑇀 𑆥𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆴 𑆘𑆛𑆳𑆧𑆢𑇀𑆣𑆳𑆤𑆴 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆖𑇀𑆖𑆑𑇀𑆰𑆶𑆰𑆵 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆲𑆵𑆤𑆼, 𑆮𑆴𑆑𑆸𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆼- 𑆃𑆠𑇀𑆪𑆶𑆠𑇀𑆥𑆴𑆟𑇀𑆝𑆴𑆠𑆼, 𑆃𑆠𑆴𑆥𑇀𑆫𑆮𑆴𑆰𑇀𑆛𑆼, 𑆃𑆠𑆴𑆘𑆴𑆲𑇀𑆩𑆼, 𑆃𑆠𑆴𑆮𑆴𑆰𑆩𑆼, 𑆃𑆠𑆴𑆩𑆶𑆑𑇀𑆠𑆧𑆤𑇀𑆣𑆤𑆼, 𑆃𑆠𑆴𑆥𑇀𑆫𑆱𑇀𑆫𑆶𑆠𑆼, 𑆱𑆠𑆠𑆾𑆤𑇀𑆩𑆴𑆰𑆴𑆠𑆼, 𑆱𑆠𑆠𑆤𑆴𑆩𑆴𑆰𑆴𑆠𑆼, 𑆤𑆴𑆩𑆴𑆰𑆾𑆤𑇀𑆩𑆼𑆰𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆼, 𑆮𑆴𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆢𑆸𑆰𑇀𑆛𑆴𑆑𑆼, 𑆮𑆴𑆥𑆫𑆵𑆠𑆢𑆸𑆰𑇀𑆛𑆴𑆑𑆼, 𑆲𑆵𑆤𑆢𑆸𑆰𑇀𑆛𑆴𑆑𑆼, 𑆮𑇀𑆪𑆱𑇀𑆠𑆢𑆸𑆰𑇀𑆛𑆴𑆑𑆼 , 𑆤𑆑𑆶𑆬𑆳𑆤𑇀𑆣𑆼, 𑆑𑆥𑆾𑆠𑆳𑆤𑇀𑆣𑆼, 𑆃𑆬𑆳𑆠𑆮𑆫𑇀𑆟𑆼, 𑆑𑆸𑆰𑇀𑆟𑆥𑆵𑆠𑆤𑆵𑆬𑆯𑇀𑆪𑆳𑆮𑆠𑆳𑆩𑇀𑆫𑆲𑆫𑆴𑆠𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆯𑆶𑆑𑇀𑆬𑆮𑆽𑆑𑆳𑆫𑆴𑆑𑆳𑆟𑆳𑆁 𑆮𑆫𑇀𑆟𑆳𑆤𑆳𑆩𑆤𑇀𑆪𑆠𑆩𑆼𑆤𑆳𑆠𑆴𑆥𑇀𑆬𑆶𑆠𑆼 𑆮𑆳 𑆱𑇀𑆪𑆳𑆠𑆳𑆁, 𑆠𑆢𑆳 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆡𑆳𑆱𑇀𑆪 𑆑𑆼𑆯𑆬𑆾𑆩𑆳𑆤𑇀𑆪𑆳𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆠𑆱𑇀𑆪 𑆖𑆼𑆠𑇀 𑆑𑆼𑆯𑆬𑆾𑆩𑆳𑆤𑇀𑆪𑆳𑆪𑆩𑇀𑆪𑆩𑆳𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆬𑆶𑆖𑇀𑆪𑆼𑆫𑆤𑇀 𑆤 𑆖𑆼𑆢𑇀𑆮𑆼𑆢𑆪𑆼𑆪𑆶𑆱𑇀𑆠𑆁 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆢𑆶𑆢𑆫𑆼 𑆱𑆴𑆫𑆳𑆂 𑆥𑇀𑆫𑆑𑆳𑆯𑆼𑆫𑆚𑇀 𑆯𑇀𑆪𑆳𑆮𑆠𑆳𑆩𑇀𑆫𑆤𑆵𑆬𑆲𑆳𑆫𑆴𑆢𑇀𑆫𑆯𑆶𑆑𑇀𑆬𑆳 𑆮𑆳 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆠𑆱𑇀𑆪 𑆖𑆼𑆤𑇀𑆤𑆒𑆳 𑆮𑆵𑆠𑆩𑆳𑆁𑆱𑆯𑆾𑆟𑆴𑆠𑆳𑆂 𑆥𑆑𑇀𑆮𑆘𑆳𑆩𑇀𑆧𑆮𑆮𑆫𑇀𑆟𑆳𑆂 𑆱𑇀𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇅 𑆃𑆡𑆳𑆱𑇀𑆪𑆳𑆕𑇀𑆓𑆶𑆬𑆵𑆫𑆳𑆪𑆖𑇀𑆗𑆼𑆠𑇀; 𑆠𑆱𑇀𑆪 𑆖𑆼𑆢𑆕𑇀𑆓𑆶𑆬𑆪 𑆄𑆪𑆩𑇀𑆪𑆩𑆳𑆤𑆳 𑆤 𑆱𑇀𑆦𑆶𑆛𑆼𑆪𑆶𑆂, 𑆥𑆫𑆳𑆱𑆶𑆫𑆴𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆍𑆠𑆳𑆤𑇀 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆤𑇀 𑆧𑆲𑆷𑆤𑇀 𑆨𑆳𑆮𑆳𑆤𑇀 𑆪𑆂 𑆱𑇀𑆥𑆸𑆯𑆤𑇀𑆤𑆮𑆧𑆶𑆣𑇀𑆪𑆠𑆼𑇅 𑆄𑆠𑆶𑆫𑆼 𑆤 𑆱 𑆱𑆩𑇀𑆩𑆾𑆲𑆩𑆳𑆪𑆶𑆫𑇀𑆘𑇀𑆚𑆳𑆤𑆱𑇀𑆪 𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇗𑇆
𑆃𑆡𑆳𑆠 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆤𑆵𑆑𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆪𑆡𑆳 𑆘𑆤𑇀𑆠𑆾𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆮𑆴𑆯𑆼𑆰𑆮𑆴𑆠𑇀𑇅 𑆘𑇀𑆚𑆳𑆠𑆶𑆩𑆴𑆖𑇀𑆗𑆤𑇀 𑆨𑆴𑆰𑆕𑇀𑆩𑆳𑆤𑆩𑆳𑆪𑆶𑆰𑆱𑇀𑆠𑆤𑇀𑆤𑆴𑆧𑆾𑆣𑆠 𑇆𑇓𑇆
𑆃𑆤𑆶𑆩𑆳𑆤𑆳𑆠𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑆼𑆠 𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑆵𑆤𑆴 𑆠𑆠𑇀𑆠𑇀𑆮𑆠𑆂𑇅 𑆃𑆢𑇀𑆣𑆳 𑆲𑆴 𑆮𑆴𑆢𑆴𑆠𑆁 𑆘𑇀𑆚𑆳𑆤𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑇀𑇆𑇔𑇆
𑆱𑇀𑆮𑆱𑇀𑆡𑆼𑆨𑇀𑆪𑆾 𑆮𑆴𑆑𑆸𑆠𑆁 𑆪𑆱𑇀𑆪 𑆘𑇀𑆚𑆳𑆤𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆱𑆁𑆯𑇀𑆫𑆪𑆩𑇀 𑇅 𑆄𑆬𑆑𑇀𑆰𑇀𑆪𑆼𑆠𑆳𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆤 𑆬𑆑𑇀𑆰𑆟𑆁 𑆩𑆫𑆟𑆱𑇀𑆪 𑆠𑆠𑇀𑇆𑇕𑇆
𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆬𑆑𑇀𑆰𑆟𑆁 𑆱𑆩𑇀𑆪𑆓𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆼𑆰𑇀𑆮𑆯𑆶𑆨𑆾𑆢𑆪𑆩𑇀𑇅 𑆠𑆢𑆼𑆮 𑆠𑆶 𑆥𑆶𑆤𑆫𑇀𑆨𑆷𑆪𑆾 𑆮𑆴𑆱𑇀𑆠𑆫𑆼𑆟 𑆤𑆴𑆧𑆾𑆣𑆠𑇆𑇖𑇆
𑆔𑆤𑆵𑆨𑆷𑆠𑆩𑆴𑆮𑆳𑆑𑆳𑆯𑆩𑆳𑆑𑆳𑆯𑆩𑆴𑆮 𑆩𑆼𑆢𑆴𑆤𑆵𑆩𑇀𑇅 𑆮𑆴𑆓𑆵𑆠𑆩𑆶𑆨𑆪𑆁 𑆲𑇀𑆪𑆼𑆠𑆠𑇀 𑆥𑆯𑇀𑆪𑆤𑇀 𑆩𑆫𑆟𑆩𑆸𑆖𑇀𑆗𑆠𑆴𑇆𑇗𑇆
𑆪𑆱𑇀𑆪 𑆢𑆫𑇀𑆯𑆤𑆩𑆳𑆪𑆳𑆠𑆴 𑆩𑆳𑆫𑆶𑆠𑆾𑇁𑆩𑇀𑆧𑆫𑆓𑆾𑆖𑆫𑆂𑇅 𑆃𑆓𑇀𑆤𑆴𑆫𑇀𑆤𑆳𑆪𑆳𑆠𑆴 𑆖𑆳𑆢𑆵𑆥𑇀𑆠𑆱𑇀𑆠𑆱𑇀𑆪𑆳𑆪𑆶𑆂𑆑𑇀𑆰𑆪𑆩𑆳𑆢𑆴𑆯𑆼𑆠𑇀𑇆𑇘𑇆

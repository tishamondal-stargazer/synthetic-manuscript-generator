𑆤 𑆲𑆴 𑆑𑆫𑇀𑆩 𑆩𑆲𑆠𑇀 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆦𑆬𑆁 𑆪𑆱𑇀𑆪 𑆤 𑆨𑆶𑆘𑇀𑆪𑆠𑆼𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆔𑇀𑆤𑆳𑆂 𑆑𑆫𑇀𑆩𑆘𑆳 𑆫𑆾𑆓𑆳𑆂 𑆥𑇀𑆫𑆯𑆩𑆁 𑆪𑆳𑆤𑇀𑆠𑆴 𑆠𑆠𑇀𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑇆𑇑𑇑𑇗𑇆
𑆃𑆠𑇀𑆪𑆶𑆓𑇀𑆫𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆳𑆖𑇀𑆗𑇀𑆫𑆮𑆟𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆯𑆾 𑆤 𑆖𑇅 𑆯𑆧𑇀𑆢𑆳𑆤𑆳𑆁 𑆖𑆳𑆠𑆴𑆲𑆵𑆤𑆳𑆤𑆳𑆁 𑆨𑆮𑆤𑇀𑆠𑆴 𑆯𑇀𑆫𑆮𑆟𑆳𑆘𑇀𑆘𑆝𑆳𑆂𑇆𑇑𑇑𑇘𑇆
𑆥𑆫𑆶𑆰𑆾𑆢𑇀𑆨𑆵𑆰𑆟𑆳𑆯𑆱𑇀𑆠𑆳𑆥𑇀𑆫𑆴𑆪𑆮𑇀𑆪𑆱𑆤𑆱𑆷𑆖𑆑𑆽𑆂𑇅 𑆯𑆧𑇀𑆢𑆽𑆂 𑆯𑇀𑆫𑆮𑆟𑆱𑆁𑆪𑆾𑆓𑆾 𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑆁𑆪𑆾𑆓 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇑𑇙𑇆
𑆃𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆾𑇁𑆠𑆴𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆾 𑆲𑆵𑆤𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯 𑆍𑆮 𑆖𑇅 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆁 𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟𑆾𑆑𑇀𑆠𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆧𑆳𑆣𑆑𑆂𑇆𑇑𑇒𑇐𑇆
𑆪𑆾 𑆨𑆷𑆠𑆮𑆴𑆰𑆮𑆳𑆠𑆳𑆤𑆳𑆩𑆑𑆳𑆬𑆼𑆤𑆳𑆓𑆠𑆯𑇀𑆖 𑆪𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆾 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓 𑆱 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇑𑇆
𑆫𑆷𑆥𑆳𑆟𑆳𑆁 𑆨𑆳𑆱𑇀𑆮𑆠𑆳𑆁 𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑇀𑆮𑆴𑆤𑆯𑇀𑆪𑆠𑇀𑆪𑆠𑆴𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀𑇅 𑆢𑆫𑇀𑆯𑆤𑆳𑆖𑇀𑆖𑆳𑆠𑆴𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆳𑆟𑆳𑆁 𑆱𑆫𑇀𑆮𑆯𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀𑇆𑇑𑇒𑇒𑇆
𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆨𑆽𑆫𑆮𑆧𑆵𑆨𑆠𑇀𑆱𑆢𑆷𑆫𑆳𑆠𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀 𑇅 𑆠𑆳𑆩𑆱𑆳𑆤𑆳𑆁 𑆖 𑆫𑆷𑆥𑆳𑆟𑆳𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆱𑆁𑆪𑆾𑆓 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇓𑇆
𑆃𑆠𑇀𑆪𑆳𑆢𑆳𑆤𑆩𑆤𑆳𑆢𑆳𑆤𑆩𑆾𑆑𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆢𑆴𑆨𑆴𑆯𑇀𑆖 𑆪𑆠𑇀𑇅 𑆫𑆱𑆳𑆤𑆳𑆁 𑆮𑆴𑆰𑆩𑆳𑆢𑆳𑆤𑆩𑆬𑇀𑆥𑆳𑆢𑆳𑆤𑆁 𑆖 𑆢𑆷𑆰𑆟𑆩𑇀𑇆𑇑𑇒𑇔𑇆
𑆃𑆠𑆴𑆩𑆸𑆢𑇀𑆮𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆓𑆤𑇀𑆣𑆳𑆤𑆳𑆩𑆶𑆥𑆱𑆼𑆮𑆤𑆩𑇀𑇅 𑆃𑆱𑆼𑆮𑆤𑆁 𑆱𑆫𑇀𑆮𑆯𑆯𑇀𑆖 𑆔𑇀𑆫𑆳𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆴𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇑𑇒𑇕𑇆
𑆥𑆷𑆠𑆴𑆨𑆷𑆠𑆮𑆴𑆰𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆳 𑆓𑆤𑇀𑆣𑆳 𑆪𑆼 𑆖𑆳𑆥𑇀𑆪𑆤𑆳𑆫𑇀𑆠𑆮𑆳𑆂𑇅 𑆠𑆽𑆫𑇀𑆓𑆤𑇀𑆣𑆽𑆫𑇀𑆔𑇀𑆫𑆳𑆟𑆱𑆁𑆪𑆾𑆓𑆾 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂 𑆱 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇖𑇆
𑆅𑆠𑇀𑆪𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆾 𑆢𑆾𑆰𑆑𑆾𑆥𑆤𑆂𑇅𑇑𑇒𑇗𑇅 𑆃𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆩𑆴𑆠𑆴 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆪𑆤𑇀𑆤 𑆪𑆳𑆠𑆴 𑆱𑆲𑆳𑆠𑇀𑆩𑆠𑆳𑆩𑇀𑇆𑇑𑇒𑇗𑇆
𑆩𑆴𑆡𑇀𑆪𑆳𑆠𑆴𑆲𑆵𑆤𑆪𑆾𑆓𑆼𑆨𑇀𑆪𑆾 𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆯𑆧𑇀𑆢𑆳𑆢𑆵𑆤𑆳𑆁 𑆱 𑆮𑆴𑆘𑇀𑆚𑆼𑆪𑆾 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆽𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆑𑆾 𑆧𑆶𑆣𑆽𑆂𑇆𑇑𑇒𑇘𑇆
𑆮𑆼𑆢𑆤𑆳𑆤𑆳𑆩𑆯𑆳𑆤𑇀𑆠𑆳𑆤𑆳𑆩𑆴𑆠𑇀𑆪𑆼𑆠𑆼 𑆲𑆼𑆠𑆮𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇅 𑆱𑆶𑆒𑆲𑆼𑆠𑆶𑆂 𑆱𑆩𑆱𑇀𑆠𑇀𑆮𑆼𑆑𑆂 𑆱𑆩𑆪𑆾𑆓𑆂 𑆱𑆶𑆢𑆶𑆫𑇀𑆬𑆨𑆂𑇆𑇑𑇒𑇙𑇆
𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆤 𑆖𑆽𑆮𑆳𑆫𑇀𑆡𑆳𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆱𑇀𑆪 𑆲𑆼𑆠𑆮𑆂𑇅 𑆲𑆼𑆠𑆶𑆱𑇀𑆠𑆶 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆱𑇀𑆪 𑆪𑆾𑆓𑆾 𑆢𑆸𑆰𑇀𑆛𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆂𑇆𑇑𑇓𑇐𑇆
𑆱𑆤𑇀𑆠𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆴 𑆱𑆤𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆳 𑆪𑆾𑆓𑆾 𑆤 𑆖 𑆤 𑆖𑆳𑆱𑇀𑆠𑆴 𑆫𑆶𑆑𑇀𑇅 𑆤 𑆱𑆶𑆒𑆁, 𑆑𑆳𑆫𑆟𑆁 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆪𑆾𑆓 𑆍𑆮 𑆖𑆠𑆶𑆫𑇀𑆮𑆣𑆂𑇆𑇑𑇓𑇑𑇆
𑆤𑆳𑆠𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆩𑆤𑆾 𑆧𑆶𑆢𑇀𑆣𑆴𑆁 𑆓𑆾𑆖𑆫𑆁 𑆑𑆫𑇀𑆩 𑆮𑆳 𑆮𑆴𑆤𑆳𑇅 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆁, 𑆪𑆡𑆳 𑆪𑆖𑇀𑆖 𑆧𑆾𑆢𑇀𑆣𑆮𑇀𑆪𑆁 𑆠𑆠𑇀𑆠𑆡𑆾𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇒𑇆
𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆂 𑆱𑇀𑆥𑆫𑇀𑆯𑆾 𑆩𑆳𑆤𑆱 𑆍𑆮 𑆖𑇅 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆳𑆤𑆳𑆁 𑆮𑆼𑆢𑆤𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆑𑆂𑇆𑇑𑇓𑇓𑇆
𑆅𑆖𑇀𑆗𑆳𑆢𑇀𑆮𑆼𑆰𑆳𑆠𑇀𑆩𑆴𑆑𑆳 𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆠𑆸𑆰𑇀𑆟𑆳 𑆖 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆳𑆤𑆳𑆁 𑆑𑆳𑆫𑆟𑆁 𑆥𑆶𑆤𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇓𑇔𑇆
𑆇𑆥𑆳𑆢𑆠𑇀𑆠𑆼 𑆲𑆴 𑆱𑆳 𑆨𑆳𑆮𑆳𑆤𑇀 𑆮𑆼𑆢𑆤𑆳𑆯𑇀𑆫𑆪𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆳𑆤𑇀𑇅 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆠𑆼 𑆤𑆳𑆤𑆶𑆥𑆳𑆢𑆳𑆤𑆼 𑆤𑆳𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑆾 𑆮𑆼𑆠𑇀𑆠𑆴 𑆮𑆼𑆢𑆤𑆳𑆂𑇆𑇑𑇓𑇕𑇆
𑆮𑆼𑆢𑆤𑆳𑆤𑆳𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆩𑆤𑆾 𑆢𑆼𑆲𑆯𑇀𑆖 𑆱𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆂𑇅 𑆑𑆼𑆯𑆬𑆾𑆩𑆤𑆒𑆳𑆓𑇀𑆫𑆳𑆤𑇀𑆤𑆩𑆬𑆢𑇀𑆫𑆮𑆓𑆶𑆟𑆽𑆫𑇀𑆮𑆴𑆤𑆳𑇆𑇑𑇓𑇖𑇆
𑆪𑆾𑆓𑆼 𑆩𑆾𑆑𑇀𑆰𑆼 𑆖 𑆱𑆫𑇀𑆮𑆳𑆱𑆳𑆁 𑆮𑆼𑆢𑆤𑆳𑆤𑆳𑆩𑆮𑆫𑇀𑆠𑆤𑆩𑇀𑇅 𑆩𑆾𑆑𑇀𑆰𑆼 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆤𑆴𑆂𑆯𑆼𑆰𑆳 𑆪𑆾𑆓𑆾 𑆩𑆾𑆑𑇀𑆰𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆑𑆂𑇆𑇑𑇓𑇗𑇆
𑆄𑆠𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆾𑆫𑇀𑆡𑆳𑆤𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆱𑆶𑆒𑆢𑆶𑆂𑆒𑆩𑆤𑆳𑆫𑆩𑇀𑆨𑆳𑆢𑆳𑆠𑇀𑆩𑆱𑇀𑆡𑆼 𑆩𑆤𑆱𑆴 𑆱𑇀𑆡𑆴𑆫𑆼𑇆𑇑𑇓𑇘𑇆
𑆤𑆴𑆮𑆫𑇀𑆠𑆠𑆼 𑆠𑆢𑆶𑆨𑆪𑆁 𑆮𑆯𑆴𑆠𑇀𑆮𑆁 𑆖𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆱𑆯𑆫𑆵𑆫𑆱𑇀𑆪 𑆪𑆾𑆓𑆘𑇀𑆚𑆳𑆱𑇀𑆠𑆁 𑆪𑆾𑆓𑆩𑆸𑆰𑆪𑆾 𑆮𑆴𑆢𑆶𑆂𑇆𑇑𑇓𑇙𑇆
𑆄𑆮𑆼𑆯𑆯𑇀𑆖𑆼𑆠𑆱𑆾 𑆘𑇀𑆚𑆳𑆤𑆩𑆫𑇀𑆡𑆳𑆤𑆳𑆁 𑆗𑆤𑇀𑆢𑆠𑆂 𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆢𑆸𑆰𑇀𑆛𑆴𑆂 𑆯𑇀𑆫𑆾𑆠𑇀𑆫𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆂 𑆑𑆳𑆤𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆛𑆠𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆢𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇑𑇔𑇐𑇆
𑆅𑆠𑇀𑆪𑆰𑇀𑆛𑆮𑆴𑆣𑆩𑆳𑆒𑇀𑆪𑆳𑆠𑆁 𑆪𑆾𑆓𑆴𑆤𑆳𑆁 𑆧𑆬𑆩𑆽𑆯𑇀𑆮𑆫𑆩𑇀𑇅 𑆯𑆶𑆢𑇀𑆣𑆱𑆠𑇀𑆠𑇀𑆮𑆱𑆩𑆳𑆣𑆳𑆤𑆳𑆠𑇀𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇑𑇔𑇑𑇆
𑆩𑆾𑆑𑇀𑆰𑆾 𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑇁𑆨𑆳𑆮𑆳𑆠𑇀 𑆧𑆬𑆮𑆠𑇀𑆑𑆫𑇀𑆩𑆱𑆕𑇀𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑇅 𑆮𑆴𑆪𑆾𑆓𑆂 𑆱𑆫𑇀𑆮𑆱𑆁𑆪𑆾𑆓𑆽𑆫𑆥𑆶𑆤𑆫𑇀𑆨𑆮 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇒𑇆
𑆱𑆠𑆳𑆩𑆶𑆥𑆳𑆱𑆤𑆁 𑆱𑆩𑇀𑆪𑆓𑆱𑆠𑆳𑆁 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆤𑆩𑇀𑇅 𑆮𑇀𑆫𑆠𑆖𑆫𑇀𑆪𑆾𑆥𑆮𑆳𑆱𑆿 𑆖 𑆤𑆴𑆪𑆩𑆳𑆯𑇀𑆖 𑆥𑆸𑆡𑆓𑇀𑆮𑆴𑆣𑆳𑆂𑇆𑇑𑇔𑇓𑇆
𑆣𑆳𑆫𑆟𑆁 𑆣𑆫𑇀𑆩𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆳𑆁 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆮𑆴𑆘𑆤𑆼 𑆫𑆠𑆴𑆂𑇅 𑆮𑆴𑆰𑆪𑆼𑆰𑇀𑆮𑆫𑆠𑆴𑆫𑇀𑆩𑆾𑆑𑇀𑆰𑆼 𑆮𑇀𑆪𑆮𑆱𑆳𑆪𑆂 𑆥𑆫𑆳 𑆣𑆸𑆠𑆴𑆂𑇆𑇑𑇔𑇔𑇆
𑆑𑆫𑇀𑆩𑆟𑆳𑆩𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆂 𑆑𑆸𑆠𑆳𑆤𑆳𑆁 𑆖 𑆥𑆫𑆴𑆑𑇀𑆰𑆪𑆂𑇅 𑆤𑆽𑆰𑇀𑆑𑇀𑆫𑆩𑇀𑆪𑆩𑆤𑆲𑆕𑇀𑆑𑆳𑆫𑆂 𑆱𑆁𑆪𑆾𑆓𑆼 𑆨𑆪𑆢𑆫𑇀𑆯𑆤𑆩𑇀𑇆𑇑𑇔𑇕𑇆
𑆩𑆤𑆾𑆧𑆶𑆢𑇀𑆣𑆴𑆱𑆩𑆳𑆣𑆳𑆤𑆩𑆫𑇀𑆡𑆠𑆠𑇀𑆠𑇀𑆮𑆥𑆫𑆵𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆠𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆩𑆸𑆠𑆼𑆫𑆶𑆥𑆱𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇑𑇔𑇖𑇆
𑆱𑇀𑆩𑆸𑆠𑆴𑆂 𑆱𑆠𑇀𑆱𑆼𑆮𑆤𑆳𑆢𑇀𑆪𑆽𑆯𑇀𑆖 𑆣𑆸𑆠𑇀𑆪𑆤𑇀𑆠𑆽𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆱𑇀𑆩𑆸𑆠𑇀𑆮𑆳 𑆱𑇀𑆮𑆨𑆳𑆮𑆁 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆱𑇀𑆩𑆫𑆤𑇀 𑆢𑆶𑆂𑆒𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇗𑇆
𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆼 𑆑𑆳𑆫𑆟𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆿 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆪𑆽𑆫𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇅 𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆫𑆷𑆥𑆓𑇀𑆫𑆲𑆟𑆳𑆠𑇀 𑆱𑆳𑆢𑆸𑆯𑇀𑆪𑆳𑆠𑇀 𑆱𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀𑇆𑇑𑇔𑇘𑇆
𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆳𑆢𑆨𑇀𑆪𑆳𑆱𑆳𑆘𑇀𑆘𑇀𑆚𑆳𑆤𑆪𑆾𑆓𑆳𑆠𑇀 𑆥𑆶𑆤𑆂 𑆯𑇀𑆫𑆶𑆠𑆳𑆠𑇀𑇅 𑆢𑆸𑆰𑇀𑆛𑆯𑇀𑆫𑆶𑆠𑆳𑆤𑆶𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆱𑇀𑆩𑆳𑆫𑆟𑆳𑆠𑇀 𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇙𑇆
𑆍𑆠𑆠𑇀𑆠𑆢𑆼𑆑𑆩𑆪𑆤𑆁 𑆩𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆩𑆾𑆑𑇀𑆰𑆱𑇀𑆪 𑆢𑆫𑇀𑆯𑆴𑆠𑆩𑇀𑇅 𑆠𑆠𑇀𑆠𑇀𑆮𑆱𑇀𑆩𑆸𑆠𑆴𑆧𑆬𑆁, 𑆪𑆼𑆤 𑆓𑆠𑆳 𑆤 𑆥𑆶𑆤𑆫𑆳𑆓𑆠𑆳𑆂𑇆𑇑𑇕𑇐𑇆
𑆃𑆪𑆤𑆁 𑆥𑆶𑆤𑆫𑆳𑆒𑇀𑆪𑆳𑆠𑆩𑆼𑆠𑆢𑇀𑆪𑆾𑆓𑆱𑇀𑆪 𑆪𑆾𑆓𑆴𑆨𑆴𑆂𑇅 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆣𑆫𑇀𑆩𑆽𑆂 𑆱𑆳𑆕𑇀𑆒𑇀𑆪𑆽𑆯𑇀𑆖 𑆩𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆩𑆾𑆑𑇀𑆰𑆱𑇀𑆪 𑆖𑆳𑆪𑆤𑆩𑇀𑇆𑇑𑇕𑇑𑇆
𑆱𑆫𑇀𑆮𑆁 𑆑𑆳𑆫𑆟𑆮𑆢𑇀𑆢𑆶𑆂𑆒𑆩𑆱𑇀𑆮𑆁 𑆖𑆳𑆤𑆴𑆠𑇀𑆪𑆩𑆼𑆮 𑆖𑇅 𑆤 𑆖𑆳𑆠𑇀𑆩𑆑𑆸𑆠𑆑𑆁 𑆠𑆢𑇀𑆣𑆴 𑆠𑆠𑇀𑆫 𑆖𑆾𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑇀𑆮𑆠𑆳𑇆𑇑𑇕𑇒𑇆
𑆪𑆳𑆮𑆤𑇀𑆤𑆾𑆠𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆠𑇀𑆪𑆳 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆤𑆽𑆠𑆢𑆲𑆁 𑆪𑆪𑆳𑇅 𑆤𑆽𑆠𑆤𑇀𑆩𑆩𑆼𑆠𑆴 𑆮𑆴𑆘𑇀𑆚𑆳𑆪 𑆘𑇀𑆚𑆂 𑆱𑆫𑇀𑆮𑆩𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇑𑇕𑇓𑇆
𑆠𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆫𑆩𑆱𑆤𑇀𑆤𑇀𑆪𑆳𑆱𑆼 𑆱𑆩𑆷𑆬𑆳𑆂 𑆱𑆫𑇀𑆮𑆮𑆼𑆢𑆤𑆳𑆂𑇅 𑆱𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆳 𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆪𑆳𑆤𑇀𑆠𑇀𑆪𑆯𑆼𑆰𑆠𑆂𑇆𑇑𑇕𑇔𑇆
𑆃𑆠𑆂 𑆥𑆫𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆨𑆷𑆠𑆾 𑆨𑆷𑆠𑆳𑆠𑇀𑆩𑆳 𑆤𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑇅 𑆤𑆴𑆂𑆱𑆸𑆠𑆂 𑆱𑆫𑇀𑆮𑆨𑆳𑆮𑆼𑆨𑇀𑆪𑆯𑇀𑆖𑆴𑆲𑇀𑆤𑆁 𑆪𑆱𑇀𑆪 𑆤 𑆮𑆴𑆢𑇀𑆪𑆠𑆼𑇅 𑆘𑇀𑆚𑆳𑆤𑆁 𑆧𑇀𑆫𑆲𑇀𑆩𑆮𑆴𑆢𑆳𑆁 𑆖𑆳𑆠𑇀𑆫 𑆤𑆳𑆘𑇀𑆚𑆱𑇀𑆠𑆘𑇀𑆘𑇀𑆚𑆳𑆠𑆶𑆩𑆫𑇀𑆲𑆠𑆴𑇆𑇑𑇕𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆂- 𑆥𑇀𑆫𑆯𑇀𑆤𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆠𑇀𑆫𑆪𑆾𑆮𑆴𑆁𑆯𑆠𑆴𑆫𑆶𑆠𑇀𑆠𑆩𑆳𑆂𑇅 𑆑𑆠𑆴𑆣𑆳𑆥𑆶𑆫𑆶𑆰𑆵𑆪𑆼𑇁𑆱𑇀𑆩𑆴𑆤𑇀𑆤𑆴𑆫𑇀𑆟𑆵𑆠𑆳𑆱𑇀𑆠𑆠𑇀𑆠𑇀𑆮𑆢𑆫𑇀𑆯𑆴𑆤𑆳𑇆𑇑𑇕𑇖𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆠𑆶𑆬𑇀𑆪𑆓𑆾𑆠𑇀𑆫𑆵𑆪𑆁 𑆯𑆳𑆫𑆵𑆫𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆃𑆠𑆶𑆬𑇀𑆪𑆓𑆾𑆠𑇀𑆫𑆱𑇀𑆪 𑆫𑆘𑆂𑆑𑇀𑆰𑆪𑆳𑆤𑇀𑆠𑆼 𑆫𑆲𑆾𑆮𑆴𑆱𑆸𑆰𑇀𑆛𑆁 𑆩𑆴𑆡𑆶𑆤𑆵𑆑𑆸𑆠𑆱𑇀𑆪𑇅 𑆑𑆴𑆁 𑆱𑇀𑆪𑆳𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆠𑇀𑆥𑇀𑆫𑆨𑆮𑆁 𑆖 𑆰𑆝𑇀𑆨𑇀𑆪𑆾 𑆪𑆠𑇀 𑆱𑇀𑆠𑇀𑆫𑆵𑆰𑆶 𑆓𑆫𑇀𑆨𑆠𑇀𑆮𑆩𑆶𑆥𑆽𑆠𑆴 𑆥𑆶𑆁𑆱𑆂𑇆𑇓𑇆
𑆯𑆶𑆑𑇀𑆫𑆁 𑆠𑆢𑆱𑇀𑆪 𑆥𑇀𑆫𑆮𑆢𑆤𑇀𑆠𑆴 𑆣𑆵𑆫𑆳 𑆪𑆢𑇀𑆣𑆵𑆪𑆠𑆼 𑆓𑆫𑇀𑆨𑆱𑆩𑆶𑆢𑇀𑆨𑆮𑆳𑆪𑇅 𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆨𑆷𑆩𑇀𑆪𑆧𑇀𑆓𑆶𑆟𑆥𑆳𑆢𑆮𑆠𑇀𑆠𑆠𑇀 𑆰𑆝𑇀𑆨𑇀𑆪𑆾 𑆫𑆱𑆼𑆨𑇀𑆪𑆂 𑆥𑇀𑆫𑆨𑆮𑆯𑇀𑆖 𑆠𑆱𑇀𑆪𑇆𑇔𑇆
𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆢𑆼𑆲𑆂 𑆱𑆩𑆪𑆼 𑆱𑆶𑆒𑆁 𑆖 𑆓𑆫𑇀𑆨𑆂 𑆑𑆡𑆁 𑆑𑆼𑆤 𑆖 𑆘𑆳𑆪𑆠𑆼 𑆱𑇀𑆠𑇀𑆫𑆵𑇅 𑆓𑆫𑇀𑆨𑆁 𑆖𑆴𑆫𑆳𑆢𑇀𑆮𑆴𑆤𑇀𑆢𑆠𑆴 𑆱𑆥𑇀𑆫𑆘𑆳𑇁𑆥𑆴 𑆨𑆷𑆠𑇀𑆮𑆳𑇁𑆡𑆮𑆳 𑆤𑆯𑇀𑆪𑆠𑆴 𑆑𑆼𑆤 𑆓𑆫𑇀𑆨𑆂𑇆𑇕𑇆

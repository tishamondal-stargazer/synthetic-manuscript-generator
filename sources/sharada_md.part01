𑆬𑆴𑆲𑆤𑇀 𑆘𑇀𑆮𑆫𑆳𑆫𑇀𑆠𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆖 𑆱𑆩𑆳𑆑𑇀𑆰𑆴𑆑𑆳𑆩𑇀 𑇅 𑆑𑆳𑆱𑆼 𑆯𑇀𑆮𑆳𑆱𑆼 𑆖 𑆩𑆣𑆶𑆤𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆖 𑆱𑆶𑆒𑆵 𑆨𑆮𑆼𑆠𑇀 𑇆𑇓𑇐𑇒𑇆
𑆮𑆴𑆢𑆳𑆫𑆵 𑆢𑆳𑆝𑆴𑆩𑆁 𑆬𑆾𑆣𑇀𑆫𑆁 𑆢𑆣𑆴𑆠𑇀𑆡𑆁 𑆧𑆵𑆘𑆥𑆷𑆫𑆑𑆩𑇀 𑇅 𑆍𑆨𑆴𑆂 𑆥𑇀𑆫𑆢𑆴𑆲𑇀𑆪𑆳𑆤𑇀𑆩𑆷𑆫𑇀𑆣𑆳𑆤𑆁 𑆠𑆸𑆝𑇀𑆢𑆳𑆲𑆳𑆫𑇀𑆠𑆱𑇀𑆪 𑆢𑆼𑆲𑆴𑆤𑆂 𑇆𑇓𑇐𑇓𑇆
𑆢𑆳𑆝𑆴𑆩𑆱𑇀𑆪 𑆱𑆴𑆠𑆳𑆪𑆳𑆯𑇀𑆖 𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆩𑆬𑆑𑆪𑆾𑆱𑇀𑆠𑆡𑆳 𑇅 𑆮𑆽𑆫𑆱𑇀𑆪𑆼 𑆣𑆳𑆫𑆪𑆼𑆠𑇀 𑆑𑆬𑇀𑆑𑆁 𑆓𑆟𑇀𑆝𑆷𑆰𑆁 𑆖 𑆪𑆡𑆳𑆲𑆴𑆠𑆩𑇀 𑇆𑇓𑇐𑇔𑇆
𑆑𑇀𑆰𑆵𑆫𑆼𑆑𑇀𑆰𑆶𑆫𑆱𑆩𑆳𑆑𑇀𑆰𑆵𑆑𑆱𑆫𑇀𑆥𑆴𑆱𑇀𑆠𑆽𑆬𑆾𑆰𑇀𑆟𑆮𑆳𑆫𑆴𑆨𑆴𑆂 𑇅𑇓𑇐𑇕𑇅 𑆯𑆷𑆤𑇀𑆪𑆼 𑆩𑆷𑆫𑇀𑆣𑇀𑆤𑆴 𑆲𑆴𑆠𑆁 𑆤𑆱𑇀𑆪𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆯𑆸𑆠𑆁 𑆔𑆸𑆠𑆩𑇀 𑇆𑇓𑇐𑇕𑇆
𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆽𑆱𑇀𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆯𑇀𑆪𑆳𑆩𑆳𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆥𑆴𑆥𑇀𑆥𑆬𑆴𑆱𑆁𑆪𑆶𑆠𑆽𑆂 𑇅 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆂 𑆯𑆫𑇀𑆑𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆾 𑆮𑆴𑆫𑆼𑆑𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆯𑆱𑇀𑆪𑆠𑆼 𑇆𑇓𑇐𑇖𑇆
𑆥𑆑𑇀𑆮𑆼 𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆼 𑆫𑆑𑇀𑆠𑆼 𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆓𑆼 𑆮𑆼𑆥𑆡𑆿 𑆠𑆡𑆳 𑇅𑇓𑇐𑇗𑇅 𑆑𑆦𑆮𑆳𑆠𑆾𑆠𑇀𑆡𑆪𑆾𑆫𑆼𑆮𑆁 𑆱𑇀𑆤𑆼𑆲𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆽𑆫𑇀𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇆𑇓𑇐𑇗𑇆
𑆲𑆸𑆠𑆢𑆾𑆰𑆾 𑆨𑇀𑆫𑆩𑆳𑆫𑇀𑆠𑆱𑇀𑆠𑆶 𑆬𑆴𑆲𑇀𑆪𑆳𑆠𑇀 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆱𑆴𑆠𑆳𑆨𑆪𑆳𑆂 𑇅𑇓𑇐𑇘𑇅 𑆮𑆳𑆠𑆔𑇀𑆤𑆩𑆣𑆶𑆫𑆽𑆫𑇀𑆪𑆾𑆘𑇀𑆪𑆳 𑆤𑆴𑆫𑆷𑆲𑆳 𑆮𑆳𑆠𑆘𑆼 𑆘𑇀𑆮𑆫𑆼 𑇆𑇓𑇐𑇘𑇆
𑆃𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆢𑆾𑆰𑆁 𑆥𑇀𑆫𑆳𑆟𑆁 𑆖 𑆪𑆡𑆳𑆱𑇀𑆮𑆁 𑆖𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆂 𑇅𑇓𑇐𑇙𑇅 𑆇𑆠𑇀𑆥𑆬𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆳𑆢𑇀𑆪𑆳(𑆞𑇀𑆪𑆳)𑆯𑇀𑆖𑆤𑇀𑆢𑆤𑆾𑆯𑆵𑆫𑆱𑆁𑆪𑆶𑆠𑆳𑆂 𑇆𑇓𑇐𑇙𑇆
𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆫𑆳𑆂 𑆯𑆵𑆠𑆳𑆂 𑆥𑆴𑆠𑇀𑆠𑆘𑇀𑆮𑆫𑆲𑆫𑆳 𑆩𑆠𑆳𑆂 𑇅 𑆄𑆩𑇀𑆫𑆳𑆢𑆵𑆤𑆳𑆁 𑆠𑇀𑆮𑆖𑆁 𑆯𑆕𑇀𑆒𑆁 𑆖𑆤𑇀𑆢𑆤𑆁 𑆩𑆣𑆶𑆑𑆾𑆠𑇀𑆥𑆬𑆼 𑇆𑇓𑇑𑇐𑇆
𑆓𑆽𑆫𑆴𑆑𑆳𑆚𑇀𑆘𑆤𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆩𑆸𑆟𑆳𑆬𑆳𑆤𑇀𑆪𑆡 𑆥𑆢𑇀𑆩𑆑𑆩𑇀 𑇅 𑆯𑇀𑆬𑆑𑇀𑆰𑇀𑆟𑆥𑆴𑆰𑇀𑆛𑆁 𑆠𑆶 𑆥𑆪𑆱𑆳 𑆯𑆫𑇀𑆑𑆫𑆳𑆩𑆣𑆶𑆱𑆁𑆪𑆶𑆠𑆩𑇀 𑇆𑇓𑇑𑇑𑇆
𑆱𑆶𑆥𑆷𑆠𑆁 𑆯𑆵𑆠𑆬𑆁 𑆧𑆱𑇀𑆠𑆴𑆁 𑆢𑆲𑇀𑆪𑆩𑆳𑆤𑆳𑆪 𑆢𑆳𑆥𑆪𑆼𑆠𑇀 𑇅𑇓𑇑𑇒𑇅 𑆘𑇀𑆮𑆫𑆢𑆳𑆲𑆳𑆥𑆲𑆁 𑆠𑆼𑆰𑆶 𑆱𑆴𑆢𑇀𑆣𑆁 𑆖𑆽𑆮𑆳𑆤𑆶𑆮𑆳𑆱𑆤𑆩𑇀 𑇆𑇓𑇑𑇒𑇆
𑆄𑆫𑆓𑇀𑆮𑆣𑆓𑆟𑆑𑇀𑆮𑆳𑆡𑆳𑆂 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆢𑆴𑆱𑆩𑆳𑆪𑆶𑆠𑆳𑆂 𑇅 𑆱𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆩𑆷𑆠𑇀𑆫𑆳 𑆢𑆼𑆪𑆳𑆂 𑆱𑇀𑆪𑆶𑆂 𑆑𑆦𑆘𑇀𑆮𑆫𑆮𑆴𑆤𑆳𑆯𑆤𑆳𑆂 𑇆𑇓𑇑𑇓𑇆
𑆑𑆦𑆔𑇀𑆤𑆽𑆫𑆼𑆮 𑆱𑆁𑆱𑆴𑆢𑇀𑆣𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆂 𑇅𑇓𑇑𑇔𑇅 𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆼 𑆖 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳 𑆧𑆱𑇀𑆠𑆪𑆾 𑆲𑆴𑆠𑆳𑆂 𑇆𑇓𑇑𑇔𑇆
𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆽𑆫𑆼𑆮 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳 𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆥𑇀𑆪𑆤𑆶𑆮𑆳𑆱𑆤𑆳𑆂 𑇅𑇓𑇑𑇕𑇅 𑆮𑆳𑆠𑆫𑆾𑆓𑆳𑆥𑆲𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆱𑇀𑆤𑆼𑆲𑆳 𑆪𑆼 𑆱𑆩𑇀𑆪𑆓𑆵𑆫𑆴𑆠𑆳𑆂 𑇆𑇓𑇑𑇕𑇆
𑆮𑆴𑆤𑆳 𑆠𑆽𑆬𑆁 𑆠 𑆍𑆮 𑆱𑇀𑆪𑆶𑆫𑇀𑆪𑆾𑆘𑇀𑆪𑆳 𑆩𑆳𑆫𑆶𑆠𑆘𑆼 𑆘𑇀𑆮𑆫𑆼 𑇅𑇓𑇑𑇖𑇅 𑆤𑆴𑆒𑆴𑆬𑆼𑆤𑆾𑆥𑆪𑆾𑆘𑇀𑆪𑆳𑆯𑇀𑆖 𑆠 𑆍𑆮𑆳𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆳𑆢𑆴𑆰𑆶 𑇆𑇓𑇑𑇖𑇆
𑆥𑆽𑆠𑇀𑆠𑆴𑆑𑆼 𑆩𑆣𑆶𑆫𑆽𑆱𑇀𑆠𑆴𑆑𑇀𑆠𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆯𑇀𑆖 𑆥𑆷𑆘𑇀𑆪𑆠𑆼 𑇅𑇓𑇑𑇗𑇅 𑆯𑇀𑆬𑆽𑆰𑇀𑆩𑆴𑆑𑆼 𑆑𑆛𑆶𑆠𑆴𑆑𑇀𑆠𑆽𑆯𑇀𑆖, 𑆱𑆁𑆱𑆸𑆰𑇀𑆛𑆳𑆤𑆵𑆠𑆫𑆼𑆰𑆶 𑆖 𑇆𑇓𑇑𑇗𑇆
𑆲𑆸𑆠𑆳𑆮𑆯𑆼𑆰𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆠𑆶 𑆠𑇀𑆮𑆑𑇀𑆱𑇀𑆡𑆁 𑆘𑆤𑆪𑆠𑆴 𑆘𑇀𑆮𑆫𑆩𑇀 𑇅 𑆥𑆴𑆧𑆼𑆢𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆁 𑆠𑆠𑇀𑆫 𑆯𑆵𑆠𑆁 𑆮𑆳 𑆯𑆫𑇀𑆑𑆫𑆾𑆢𑆑𑆩𑇀 𑇆𑇓𑇑𑇘𑇆
𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆾𑆫𑆤𑇀𑆤𑆩𑆯𑇀𑆤𑆵𑆪𑆳𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆱𑆩𑇀𑆥𑇀𑆬𑆶𑆠𑆩𑇀 𑇅𑇓𑇑𑇙𑇅 𑆑𑆦𑆮𑆳𑆠𑆾𑆠𑇀𑆡𑆪𑆾𑆫𑆼𑆮 𑆱𑇀𑆮𑆼𑆢𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆿 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇓𑇑𑇙𑇆
𑆔𑆸𑆠𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆫𑆳𑆠𑇀𑆫𑆳𑆠𑇀𑆠𑆶 𑆢𑆼𑆪𑆁 𑆱𑆫𑇀𑆮𑆘𑇀𑆮𑆫𑆼𑆰𑆶 𑆖 𑇅 𑆠𑆼𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟𑆳𑆯𑆪𑆁 𑆱𑇀𑆮𑆁 𑆓𑆠𑆳 𑆢𑆾𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑆲𑆴 𑇆𑇓𑇒𑇐𑇆
𑆣𑆳𑆠𑆷𑆤𑇀 𑆥𑇀𑆫𑆑𑇀𑆰𑆾𑆨𑆪𑆤𑇀 𑆢𑆾𑆰𑆾 𑆩𑆾𑆑𑇀𑆰𑆑𑆳𑆬𑆼 𑆧𑆬𑆵𑆪𑆠𑆼 𑇅 𑆠𑆼𑆤 𑆮𑇀𑆪𑆳𑆑𑆶𑆬𑆖𑆴𑆠𑇀𑆠𑆱𑇀𑆠𑆶 𑆩𑇀𑆫𑆴𑆪𑆩𑆳𑆟 𑆅𑆮𑆼𑆲𑆠𑆼 𑇆𑇓𑇒𑇑𑇆
𑆬𑆔𑆶𑆠𑇀𑆮𑆁 𑆯𑆴𑆫𑆱𑆂 𑆱𑇀𑆮𑆼𑆢𑆾 𑆩𑆶𑆒𑆩𑆳𑆥𑆳𑆟𑇀𑆝𑆶 𑆥𑆳𑆑𑆴 𑆖 𑇅 𑆑𑇀𑆰𑆮𑆡𑆶𑆯𑇀𑆖𑆳𑆤𑇀𑆤𑆑𑆳𑆕𑇀𑆑𑇀𑆰𑆳 𑆖 𑆘𑇀𑆮𑆫𑆩𑆶𑆑𑇀𑆠𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀 𑇆𑇓𑇒𑇒𑇆
𑆯𑆩𑇀𑆨𑆶𑆑𑇀𑆫𑆾𑆣𑆾𑆢𑇀𑆨𑆮𑆾 𑆔𑆾𑆫𑆾 𑆧𑆬𑆮𑆫𑇀𑆟𑆳𑆓𑇀𑆤𑆴𑆱𑆳𑆢𑆑𑆂 𑇅 𑆫𑆾𑆓𑆫𑆳𑆛𑇀 𑆫𑆾𑆔𑆱𑆕𑇀𑆔𑆳𑆠𑆾 𑆘𑇀𑆮𑆫 𑆅𑆠𑇀𑆪𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇆𑇓𑇒𑇓𑇆
𑆮𑇀𑆪𑆳𑆥𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆠𑇀 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆠𑇀𑆮𑆳𑆢𑆤𑇀𑆠𑆱𑆩𑇀𑆨𑆮𑆳𑆠𑇀 𑇅 𑆃𑆤𑇀𑆠𑆑𑆾 𑆲𑇀𑆪𑆼𑆰 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆘𑇀𑆮𑆫 𑆅𑆠𑇀𑆪𑆶𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼 𑇆𑇓𑇒𑇔𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆠𑆵𑆱𑆳𑆫𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆓𑆶𑆫𑇀𑆮𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆫𑆷𑆑𑇀𑆰𑆾𑆰𑇀𑆟𑆢𑇀𑆫𑆮𑆱𑇀𑆡𑆷𑆬𑆳𑆠𑆴𑆯𑆵𑆠𑆬𑆽𑆂 𑇅 𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆽𑆫𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆽𑆯𑇀𑆖𑆳𑆥𑆴 𑆨𑆾𑆘𑆤𑆽𑆂 𑇆𑇓𑇆
𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑇀𑆪𑆽𑆫𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆽𑆯𑇀𑆖 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑇀𑆮𑆴𑆰𑆳𑆢𑇀𑆨𑆪𑆳𑆠𑇀 𑇅 𑆯𑆾𑆑𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆳𑆩𑇀𑆧𑆶𑆩𑆢𑇀𑆪𑆳𑆠𑆴𑆥𑆳𑆤𑆳𑆠𑇀 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆫𑇀𑆠𑆶𑆥𑆫𑇀𑆪𑆪𑆳𑆠𑇀 𑇆𑇔𑇆
𑆘𑆬𑆳𑆠𑆴𑆫𑆩𑆟𑆽𑆫𑇀𑆮𑆼𑆓𑆮𑆴𑆔𑆳𑆠𑆽𑆂 𑆑𑆸𑆩𑆴𑆢𑆾𑆰𑆠𑆂 𑇅 𑆤𑆸𑆟𑆳𑆁 𑆨𑆮𑆠𑇀𑆪𑆠𑆵𑆱𑆳𑆫𑆾 𑆬𑆑𑇀𑆰𑆟𑆁 𑆠𑆱𑇀𑆪 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇕𑇆
𑆱𑆁𑆯𑆩𑇀𑆪𑆳𑆥𑆳𑆤𑇀𑆣𑆳𑆠𑆶𑆫𑆤𑇀𑆠𑆂 𑆑𑆸𑆯𑆳𑆤𑆶𑆁 𑆮𑆫𑇀𑆖𑆾𑆩𑆴𑆯𑇀𑆫𑆾 𑆩𑆳𑆫𑆶𑆠𑆼𑆤 𑆥𑇀𑆫𑆟𑆶𑆤𑇀𑆤𑆂 𑇅 𑆮𑆸𑆢𑇀𑆣𑆾𑇁𑆠𑆵𑆮𑆳𑆣𑆂 𑆱𑆫𑆠𑇀𑆪𑆼𑆰 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆔𑆾𑆫𑆁 𑆠𑆁 𑆠𑇀𑆮𑆠𑆵𑆱𑆳𑆫𑆩𑆳𑆲𑆶𑆂 𑇆𑇖𑇆
𑆍𑆑𑆽𑆑𑆯𑆂 𑆱𑆫𑇀𑆮𑆯𑆯𑇀𑆖𑆳𑆥𑆴 𑆢𑆾𑆰𑆽𑆂 𑆯𑆾𑆑𑆼𑆤𑆳𑆤𑇀𑆪𑆂 𑆰𑆰𑇀𑆜 𑆄𑆩𑆼𑆤 𑆖𑆾𑆑𑇀𑆠𑆂 𑇅 𑆑𑆼𑆖𑆴𑆠𑇀 𑆥𑇀𑆫𑆳𑆲𑆶𑆫𑇀𑆤𑆽𑆑𑆫𑆷𑆥𑆥𑇀𑆫𑆑𑆳𑆫𑆁 𑆤𑆽𑆮𑆼𑆠𑇀𑆪𑆼𑆮𑆁 𑆑𑆳𑆯𑆴𑆫𑆳𑆘𑆱𑇀𑆠𑇀𑆮𑆮𑆾𑆖𑆠𑇀 𑇆𑇗𑇆
𑆢𑆾𑆰𑆳𑆮𑆱𑇀𑆡𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆤𑆽𑆑𑆥𑇀𑆫𑆑𑆳𑆫𑆳𑆂 𑆑𑆳𑆬𑆼 𑆑𑆳𑆬𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆠𑆱𑇀𑆪𑆾𑆢𑇀𑆨𑆮𑆤𑇀𑆠𑆴 𑇅𑇘𑇅 𑆲𑆸𑆤𑇀𑆤𑆳𑆨𑆴𑆥𑆳𑆪𑆷𑆢𑆫𑆑𑆶𑆑𑇀𑆰𑆴𑆠𑆾𑆢𑆓𑆳𑆠𑇀𑆫𑆳𑆮𑆱𑆳𑆢𑆳𑆤𑆴𑆬𑆱𑆤𑇀𑆤𑆴𑆫𑆾𑆣𑆳𑆂 𑇆𑇘𑇆
𑆮𑆴𑆛𑇀𑆱𑆕𑇀𑆓 𑆄𑆣𑇀𑆩𑆳𑆤𑆩𑆡𑆳𑆮𑆴𑆥𑆳𑆑𑆾 𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆱𑇀𑆠𑆱𑇀𑆪 𑆥𑆶𑆫𑆂𑆱𑆫𑆳𑆟𑆴 𑇅𑇙𑇅 𑆯𑆷𑆬𑆳𑆮𑆴𑆰𑇀𑆛𑆂 𑆱𑆑𑇀𑆠𑆩𑆷𑆠𑇀𑆫𑆾𑇁𑆤𑇀𑆠𑇀𑆫𑆑𑆷𑆘𑆵 𑆱𑇀𑆫𑆱𑇀𑆠𑆳𑆥𑆳𑆤𑆂 𑆱𑆤𑇀𑆤𑆑𑆛𑇀𑆪𑆷𑆫𑆶𑆘𑆕𑇀𑆔𑆂 𑇆𑇙𑇆
𑆮𑆫𑇀𑆖𑆾 𑆩𑆶𑆚𑇀𑆖𑆠𑇀𑆪𑆬𑇀𑆥𑆩𑆬𑇀𑆥𑆁 𑆱𑆦𑆼𑆤𑆁 𑆫𑆷𑆑𑇀𑆰𑆁 𑆯𑇀𑆪𑆳𑆮𑆁 𑆱𑆳𑆤𑆴𑆬𑆁 𑆩𑆳𑆫𑆶𑆠𑆼𑆤 𑇅𑇑𑇐𑇅 𑆢𑆶𑆫𑇀𑆓𑆤𑇀𑆣𑇀𑆪𑆶𑆰𑇀𑆟𑆁 𑆮𑆼𑆓𑆮𑆤𑇀𑆩𑆳𑆁𑆱𑆠𑆾𑆪𑆥𑇀𑆫𑆒𑇀𑆪𑆁 𑆨𑆴𑆤𑇀𑆤𑆁 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆢𑆼𑆲𑆾𑇁𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆩𑇀 𑇆𑇑𑇐𑇆
𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀 𑆥𑆵𑆠𑆁 𑆤𑆵𑆬𑆩𑆳𑆬𑆾𑆲𑆴𑆠𑆁 𑆮𑆳 𑆠𑆸𑆰𑇀𑆟𑆳𑆩𑆷𑆫𑇀𑆖𑇀𑆗𑆳𑆢𑆳𑆲𑆥𑆳𑆑𑆘𑇀𑆮𑆫𑆳𑆫𑇀𑆠𑆂 𑇅𑇑𑇑𑇅 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆤𑆴𑆢𑇀𑆫𑆳𑆓𑆿𑆫𑆮𑆾𑆠𑇀𑆑𑇀𑆬𑆼𑆯𑆱𑆳𑆢𑆵 𑆮𑆼𑆓𑆳𑆯𑆕𑇀𑆑𑆵 𑆱𑆸𑆰𑇀𑆛𑆮𑆴𑆛𑇀𑆑𑆾𑇁𑆥𑆴 𑆨𑆷𑆪𑆂 𑇆𑇑𑇑𑇆
𑆯𑆶𑆑𑇀𑆬𑆁 𑆱𑆳𑆤𑇀𑆢𑇀𑆫𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆪𑆶𑆑𑇀𑆠𑆁 𑆨𑆑𑇀𑆠𑆢𑇀𑆮𑆼𑆰𑆵 𑆤𑆴𑆂𑆱𑇀𑆮𑆤𑆁 𑆲𑆸𑆰𑇀𑆛𑆫𑆾𑆩𑆳 𑇅𑇑𑇒𑇅 𑆠𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆶𑆑𑇀𑆠𑆾 𑆩𑆾𑆲𑆱𑆳𑆢𑆳𑆱𑇀𑆪𑆯𑆾𑆰𑆵 𑆮𑆫𑇀𑆖𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆤𑇀𑆤𑆽𑆑𑆮𑆫𑇀𑆟𑆁 𑆠𑆸𑆰𑆳𑆫𑇀𑆠𑆂 𑇆𑇑𑇒𑇆
𑆱𑆫𑇀𑆮𑆾𑆢𑇀𑆨𑆷𑆠𑆼 𑆱𑆫𑇀𑆮𑆬𑆴𑆕𑇀𑆓𑆾𑆥𑆥𑆠𑇀𑆠𑆴𑆂 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆯𑇀𑆖𑆳𑆪𑆁 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆼𑆰𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆂 𑇅𑇑𑇓𑇅 𑆠𑆽𑆱𑇀𑆠𑆽𑆫𑇀𑆨𑆳𑆮𑆽𑆂 𑆯𑆾𑆖𑆠𑆾𑇁𑆬𑇀𑆥𑆳𑆯𑆤𑆱𑇀𑆪 𑆧𑆳𑆰𑇀𑆥𑆳𑆮𑆼𑆓𑆂 𑆥𑆑𑇀𑆠𑆴𑆩𑆳𑆮𑆴𑆣𑇀𑆪(𑆯𑇀𑆪)𑆘𑆤𑇀𑆠𑆾𑆂 𑇆𑇑𑇓𑇆
𑆑𑆾𑆰𑇀𑆜𑆁 𑆓𑆠𑇀𑆮𑆳 𑆑𑇀𑆰𑆾𑆨𑆪𑆠𑇀𑆪𑆱𑇀𑆪 𑆫𑆑𑇀𑆠𑆁 𑆠𑆖𑇀𑆖𑆳𑆣𑆱𑇀𑆠𑆳𑆠𑇀 𑆑𑆳𑆑𑆟𑆤𑇀𑆠𑆵𑆥𑇀𑆫𑆑𑆳𑆯𑆩𑇀 𑇅 𑆮𑆫𑇀𑆖𑆾𑆩𑆴𑆯𑇀𑆫𑆁 𑆤𑆴𑆂𑆥𑆶𑆫𑆵𑆰𑆁 𑆱𑆓𑆤𑇀𑆣𑆁 𑆤𑆴𑆫𑇀𑆓𑆤𑇀𑆣𑆁 𑆮𑆳 𑆱𑆳𑆫𑇀𑆪𑆠𑆼 𑆠𑆼𑆤 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆠𑇀 𑇆𑇑𑇔𑇆
𑆯𑆾𑆑𑆾𑆠𑇀𑆥𑆤𑇀𑆤𑆾 𑆢𑆶𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑇀𑆪𑆾𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆫𑆾𑆓𑆾 𑆮𑆽𑆢𑇀𑆪𑆽𑆂 𑆑𑆰𑇀𑆛 𑆍𑆰 𑆥𑇀𑆫𑆢𑆴𑆰𑇀𑆛𑆂 𑇅𑇑𑇕𑇅 𑆄𑆩𑆳𑆘𑆵𑆫𑇀𑆟𑆾𑆥𑆢𑇀𑆫𑆶𑆠𑆳𑆂 𑆑𑇀𑆰𑆾𑆨𑆪𑆤𑇀𑆠𑆂 𑆑𑆾𑆰𑇀𑆜𑆁 𑆢𑆾𑆰𑆳𑆂 𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆶𑆰𑇀𑆛𑆳𑆂 𑆱𑆨𑆑𑇀𑆠𑆩𑇀 𑇆𑇑𑇕𑇆
𑆤𑆳𑆤𑆳𑆮𑆫𑇀𑆟𑆁 𑆤𑆽𑆑𑆯𑆂 𑆱𑆳𑆫𑆪𑆤𑇀𑆠𑆴 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆳𑆘𑇀𑆘𑆤𑇀𑆠𑆾𑆂 𑆰𑆰𑇀𑆜𑆩𑆼𑆤𑆁 𑆮𑆢𑆤𑇀𑆠𑆴 𑇆𑇑𑇖𑇆

𑆤𑆳𑆫𑆠𑇀𑆤𑆥𑆳𑆟𑆴𑆫𑇀𑆤𑆳𑆱𑇀𑆤𑆳𑆠𑆾 𑆤𑆾𑆥𑆲𑆠𑆮𑆳𑆱𑆳 𑆤𑆳𑆘𑆥𑆴𑆠𑇀𑆮𑆳 𑆤𑆳𑆲𑆶𑆠𑇀𑆮𑆳 𑆢𑆼𑆮𑆠𑆳𑆨𑇀𑆪𑆾 𑆤𑆳𑆤𑆴𑆫𑆷𑆥𑇀𑆪 𑆥𑆴𑆠𑆸𑆨𑇀𑆪𑆾 𑆤𑆳𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆓𑆶𑆫𑆶𑆨𑇀𑆪𑆾 𑆤𑆳𑆠𑆴𑆡𑆴𑆨𑇀𑆪𑆾 𑆤𑆾𑆥𑆳𑆯𑇀𑆫𑆴𑆠𑆼𑆨𑇀𑆪𑆾 𑆤𑆳𑆥𑆶𑆟𑇀𑆪𑆓𑆤𑇀𑆣𑆾 𑆤𑆳𑆩𑆳𑆬𑆵 𑆤𑆳𑆥𑇀𑆫𑆑𑇀𑆰𑆳𑆬𑆴𑆠𑆥𑆳𑆟𑆴𑆥𑆳𑆢𑆮𑆢𑆤𑆾 𑆤𑆳𑆯𑆶𑆢𑇀𑆣𑆩𑆶𑆒𑆾 𑆤𑆾𑆢𑆕𑇀𑆩𑆶𑆒𑆾 𑆤 𑆮𑆴𑆩𑆤𑆳 𑆤𑆳𑆨𑆑𑇀𑆠𑆳𑆯𑆴𑆰𑇀𑆛𑆳𑆯𑆶𑆖𑆴𑆑𑇀𑆰𑆶𑆣𑆴𑆠𑆥𑆫𑆴𑆖𑆫𑆾 𑆤 𑆥𑆳𑆠𑇀𑆫𑆵𑆰𑇀𑆮𑆩𑆼𑆣𑇀𑆪𑆳𑆱𑆶 𑆤𑆳𑆢𑆼𑆯𑆼 𑆤𑆳𑆑𑆳𑆬𑆼 𑆤𑆳𑆑𑆵𑆫𑇀𑆟𑆼 𑆤𑆳𑆢𑆠𑇀𑆠𑇀𑆮𑆳𑇁𑆓𑇀𑆫𑆩𑆓𑇀𑆤𑆪𑆼 𑆤𑆳𑆥𑇀𑆫𑆾𑆑𑇀𑆰𑆴𑆠𑆁 𑆥𑇀𑆫𑆾𑆑𑇀𑆰𑆟𑆾𑆢𑆑𑆽𑆫𑇀𑆤 𑆩𑆤𑇀𑆠𑇀𑆫𑆽𑆫𑆤𑆨𑆴𑆩𑆤𑇀𑆠𑇀𑆫𑆴𑆠𑆁 𑆤 𑆑𑆶𑆠𑇀𑆱𑆪𑆤𑇀𑆤 𑆑𑆶𑆠𑇀𑆱𑆴𑆠𑆁 𑆤 𑆥𑇀𑆫𑆠𑆴𑆑𑆷𑆬𑆾𑆥𑆲𑆴𑆠𑆩𑆤𑇀𑆤𑆩𑆳𑆢𑆢𑆵𑆠, 𑆤 𑆥𑆫𑇀𑆪𑆶𑆰𑆴𑆠𑆩𑆤𑇀𑆪𑆠𑇀𑆫 𑆩𑆳𑆁𑆱𑆲𑆫𑆴𑆠𑆑𑆯𑆶𑆰𑇀𑆑𑆯𑆳𑆑𑆦𑆬𑆨𑆑𑇀𑆰𑇀𑆪𑆼𑆨𑇀𑆪𑆂, 𑆤𑆳𑆯𑆼𑆰𑆨𑆶𑆑𑇀 𑆱𑇀𑆪𑆳𑆢𑆤𑇀𑆪𑆠𑇀𑆫 𑆢𑆣𑆴𑆩𑆣𑆶𑆬𑆮𑆟𑆱𑆑𑇀𑆠𑆶𑆱𑆫𑇀𑆥𑆴𑆨𑇀𑆪𑆂, 𑆤 𑆤𑆑𑇀𑆠𑆁 𑆢𑆣𑆴 𑆨𑆶𑆚𑇀𑆘𑆵𑆠, 𑆤 𑆱𑆑𑇀𑆠𑆷𑆤𑆼𑆑𑆳𑆤𑆯𑇀𑆤𑆵𑆪𑆳𑆤𑇀𑆤 𑆤𑆴𑆯𑆴 𑆤 𑆨𑆶𑆑𑇀𑆠𑇀𑆮𑆳 𑆤 𑆧𑆲𑆷𑆤𑇀𑆤 𑆢𑇀𑆮𑆴𑆫𑇀𑆤𑆾𑆢𑆑𑆳𑆤𑇀𑆠𑆫𑆴𑆠𑆳𑆠𑇀, 𑆤 𑆗𑆴𑆠𑇀𑆠𑇀𑆮𑆳 𑆢𑇀𑆮𑆴𑆘𑆽𑆫𑇀𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇒𑇐𑇆
𑆤𑆳𑆤𑆸𑆘𑆶𑆂 𑆑𑇀𑆰𑆶𑆪𑆳𑆤𑇀𑆤𑆳𑆢𑇀𑆪𑆳𑆤𑇀𑆤 𑆯𑆪𑆵𑆠, 𑆤 𑆮𑆼𑆓𑆴𑆠𑆾𑇁𑆤𑇀𑆪𑆑𑆳𑆫𑇀𑆪𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆱𑆬𑆴𑆬𑆱𑆾𑆩𑆳𑆫𑇀𑆑𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆥𑇀𑆫𑆠𑆴𑆩𑆶𑆒𑆁 𑆤𑆴𑆰𑇀𑆜𑆵𑆮𑆴𑆑𑆳(𑆮𑆳𑆠)𑆮𑆫𑇀𑆖𑆾𑆩𑆷𑆠𑇀𑆫𑆳𑆟𑇀𑆪𑆶𑆠𑇀𑆱𑆸𑆘𑆼𑆠𑇀, 𑆤 𑆥𑆤𑇀𑆡𑆳𑆤𑆩𑆮𑆩𑆷𑆠𑇀𑆫𑆪𑆼𑆤𑇀𑆤 𑆘𑆤𑆮𑆠𑆴 𑆤𑆳𑆤𑇀𑆤𑆑𑆳𑆬𑆼, 𑆤 𑆘𑆥𑆲𑆾𑆩𑆳𑆣𑇀𑆪𑆪𑆤𑆧𑆬𑆴𑆩𑆕𑇀𑆓𑆬𑆑𑇀𑆫𑆴𑆪𑆳𑆱𑆶 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆴𑆕𑇀𑆔𑆳𑆟𑆑𑆁 𑆩𑆶𑆚𑇀𑆖𑆼𑆠𑇀𑇆𑇒𑇑𑇆
𑆤 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆩𑆮𑆘𑆳𑆤𑆵𑆠, 𑆤𑆳𑆠𑆴𑆮𑆴𑆯𑇀𑆫𑆩𑇀𑆨𑆪𑆼𑆠𑇀, 𑆤 𑆓𑆶𑆲𑇀𑆪𑆩𑆤𑆶𑆯𑇀𑆫𑆳𑆮𑆪𑆼𑆠𑇀, 𑆤𑆳𑆣𑆴𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇅 𑆤 𑆫𑆘𑆱𑇀𑆮𑆬𑆳𑆁 𑆤𑆳𑆠𑆶𑆫𑆳𑆁 𑆤𑆳𑆩𑆼𑆣𑇀𑆪𑆳𑆁 𑆤𑆳𑆯𑆱𑇀𑆠𑆳𑆁 𑆤𑆳𑆤𑆴𑆰𑇀𑆛𑆫𑆷𑆥𑆳𑆖𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆳𑆁 𑆤𑆳𑆢𑆑𑇀𑆰𑆳𑆁 𑆤𑆳𑆢𑆑𑇀𑆰𑆴𑆟𑆳𑆁 𑆤𑆳𑆑𑆳𑆩𑆳𑆁 𑆤𑆳𑆤𑇀𑆪𑆑𑆳𑆩𑆳𑆁 𑆤𑆳𑆤𑇀𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆁 𑆤𑆳𑆤𑇀𑆪𑆪𑆾𑆤𑆴𑆁 𑆤𑆳𑆪𑆾𑆤𑆿 𑆤 𑆖𑆽𑆠𑇀𑆪𑆖𑆠𑇀𑆮𑆫𑆖𑆠𑆶𑆰𑇀𑆥𑆡𑆾𑆥𑆮𑆤𑆯𑇀𑆩𑆯𑆳𑆤𑆳𑆔𑆳𑆠𑆤𑆱𑆬𑆴𑆬𑆿𑆰𑆣𑆴𑆢𑇀𑆮𑆴𑆘𑆓𑆶𑆫𑆶𑆱𑆶𑆫𑆳𑆬𑆪𑆼𑆰𑆶 𑆤 𑆱𑆤𑇀𑆣𑇀𑆪𑆪𑆾𑆫𑇀𑆤𑆳𑆠𑆴𑆡𑆴𑆰𑆶 𑆤𑆳𑆯𑆶𑆖𑆴𑆫𑇀𑆤𑆳𑆘𑆓𑇀𑆣𑆨𑆼𑆰𑆘𑆾 𑆤𑆳𑆥𑇀𑆫𑆟𑆵𑆠𑆱𑆕𑇀𑆑𑆬𑇀𑆥𑆾 𑆤𑆳𑆤𑆶𑆥𑆱𑇀𑆡𑆴𑆠𑆥𑇀𑆫𑆲𑆫𑇀𑆰𑆾 𑆤𑆳𑆨𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀𑆤𑆳𑆠𑇀𑆪𑆯𑆴𑆠𑆾 𑆤 𑆮𑆴𑆰𑆩𑆱𑇀𑆡𑆾 𑆤 𑆩𑆷𑆠𑇀𑆫𑆾𑆖𑇀𑆖𑆳𑆫𑆥𑆵𑆝𑆴𑆠𑆾 𑆤 𑆯𑇀𑆫𑆩𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆾𑆥𑆮𑆳𑆱𑆑𑇀𑆬𑆩𑆳𑆨𑆴𑆲𑆠𑆾 𑆤𑆳𑆫𑆲𑆱𑆴 𑆮𑇀𑆪𑆮𑆳𑆪𑆁 𑆓𑆖𑇀𑆗𑆼𑆠𑇀𑇆𑇒𑇒𑇆
𑆤 𑆱𑆠𑆾 𑆤 𑆓𑆶𑆫𑆷𑆤𑇀 𑆥𑆫𑆴𑆮𑆢𑆼𑆠𑇀, 𑆤𑆳𑆯𑆶𑆖𑆴𑆫𑆨𑆴𑆖𑆳𑆫𑆑𑆫𑇀𑆩𑆖𑆽𑆠𑇀𑆪𑆥𑆷𑆘𑇀𑆪𑆥𑆷𑆘𑆳𑆣𑇀𑆪𑆪𑆤𑆩𑆨𑆴𑆤𑆴𑆫𑇀𑆮𑆫𑇀𑆠𑆪𑆼𑆠𑇀𑇆𑇒𑇓𑇆
𑆤 𑆮𑆴𑆢𑇀𑆪𑆶𑆠𑇀𑆱𑇀𑆮𑆤𑆳𑆫𑇀𑆠𑆮𑆵𑆰𑆶 𑆤𑆳𑆨𑇀𑆪𑆶𑆢𑆴𑆠𑆳𑆱𑆶 𑆢𑆴𑆑𑇀𑆰𑆶 𑆤𑆳𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆥𑇀𑆬𑆮𑆼 𑆤 𑆨𑆷𑆩𑆴𑆑𑆩𑇀𑆥𑆼 𑆤 𑆩𑆲𑆾𑆠𑇀𑆱𑆮𑆼 𑆤𑆾𑆬𑇀𑆑𑆳𑆥𑆳𑆠𑆼 𑆤 𑆩𑆲𑆳𑆓𑇀𑆫𑆲𑆾𑆥𑆓𑆩𑆤𑆼 𑆤 𑆤𑆰𑇀𑆛𑆖𑆤𑇀𑆢𑇀𑆫𑆳𑆪𑆳𑆁 𑆠𑆴𑆡𑆿 𑆤 𑆱𑆤𑇀𑆣𑇀𑆪𑆪𑆾𑆫𑇀𑆤𑆳𑆩𑆶𑆒𑆳𑆢𑇀𑆓𑆶𑆫𑆾𑆫𑇀𑆤𑆳𑆮𑆥𑆠𑆴𑆠𑆁 𑆤𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆤 𑆠𑆳𑆤𑇀𑆠𑆁 𑆤 𑆮𑆴𑆱𑇀𑆮𑆫𑆁 𑆤𑆳𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆥𑆢𑆁 𑆤𑆳𑆠𑆴𑆢𑇀𑆫𑆶𑆠𑆁 𑆤 𑆮𑆴𑆬𑆩𑇀𑆧𑆴𑆠𑆁 𑆤𑆳𑆠𑆴𑆑𑇀𑆬𑆵𑆧𑆁 𑆤𑆳𑆠𑇀𑆪𑆶𑆖𑇀𑆖𑆽𑆫𑇀𑆤𑆳𑆠𑆴𑆤𑆵𑆖𑆽𑆂 𑆱𑇀𑆮𑆫𑆽𑆫𑆣𑇀𑆪𑆪𑆤𑆩𑆨𑇀𑆪𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇒𑇔𑇆
𑆤𑆳𑆠𑆴𑆱𑆩𑆪𑆁 𑆘𑆲𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆤𑆴𑆪𑆩𑆁 𑆨𑆴𑆤𑇀𑆢𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆤𑆑𑇀𑆠𑆁 𑆤𑆳𑆢𑆼𑆯𑆼 𑆖𑆫𑆼𑆠𑇀, 𑆤 𑆱𑆤𑇀𑆣𑇀𑆪𑆳𑆱𑇀𑆮𑆨𑇀𑆪𑆮𑆲𑆳𑆫𑆳𑆣𑇀𑆪𑆪𑆤𑆱𑇀𑆠𑇀𑆫𑆵𑆱𑇀𑆮𑆥𑇀𑆤𑆱𑆼𑆮𑆵 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆧𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆬𑆶𑆧𑇀𑆣𑆩𑆷𑆫𑇀𑆒𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆑𑇀𑆬𑆵𑆧𑆽𑆂 𑆱𑆲 𑆱𑆒𑇀𑆪𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆩𑆢𑇀𑆪𑆢𑇀𑆪𑆷𑆠𑆮𑆼𑆯𑇀𑆪𑆳𑆥𑇀𑆫𑆱𑆕𑇀𑆓𑆫𑆶𑆖𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆓𑆶𑆲𑇀𑆪𑆁 𑆮𑆴𑆮𑆸𑆟𑆶𑆪𑆳𑆠𑇀, 𑆤 𑆑𑆚𑇀𑆖𑆴𑆢𑆮𑆘𑆳𑆤𑆵𑆪𑆳𑆠𑇀, 𑆤𑆳𑆲𑆩𑇀𑆩𑆳𑆤𑆵 𑆱𑇀𑆪𑆳𑆤𑇀𑆤𑆳𑆢𑆑𑇀𑆰𑆾 𑆤𑆳𑆢𑆑𑇀𑆰𑆴𑆟𑆾 𑆤𑆳𑆱𑆷𑆪𑆑𑆂, 𑆤 𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆟𑆳𑆤𑇀 𑆥𑆫𑆴𑆮𑆢𑆼𑆠𑇀, 𑆤 𑆓𑆮𑆳𑆁 𑆢𑆟𑇀𑆝𑆩𑆶𑆢𑇀𑆪𑆖𑇀𑆗𑆼𑆠𑇀, 𑆤 𑆮𑆸𑆢𑇀𑆣𑆳𑆤𑇀𑆤 𑆓𑆶𑆫𑆷𑆤𑇀𑆤 𑆓𑆟𑆳𑆤𑇀𑆤 𑆤𑆸𑆥𑆳𑆤𑇀 𑆮𑆳𑇁𑆣𑆴𑆑𑇀𑆰𑆴𑆥𑆼𑆠𑇀, 𑆤 𑆖𑆳𑆠𑆴𑆧𑇀𑆫𑆷𑆪𑆳𑆠𑇀, 𑆤 𑆧𑆳𑆤𑇀𑆣𑆮𑆳𑆤𑆶𑆫𑆑𑇀𑆠𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆓𑆶𑆲𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑇀 𑆧𑆲𑆴𑆰𑇀𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑇆𑇒𑇕𑇆
𑆤𑆳𑆣𑆵𑆫𑆾 𑆤𑆳𑆠𑇀𑆪𑆶𑆖𑇀𑆗𑇀𑆫𑆴𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤𑆳𑆨𑆸𑆠𑆨𑆸𑆠𑇀𑆪𑆂, 𑆤𑆳𑆮𑆴𑆯𑇀𑆫𑆧𑇀𑆣𑆱𑇀𑆮𑆘𑆤𑆂, 𑆤𑆽𑆑𑆂 𑆱𑆶𑆒𑆵, 𑆤 𑆢𑆶𑆂𑆒𑆯𑆵𑆬𑆳𑆖𑆳𑆫𑆾𑆥𑆖𑆳𑆫𑆂, 𑆤 𑆱𑆫𑇀𑆮𑆮𑆴𑆯𑇀𑆫𑆩𑇀𑆨𑆵, 𑆤 𑆱𑆫𑇀𑆮𑆳𑆨𑆴𑆯𑆕𑇀𑆑𑆵, 𑆤 𑆱𑆫𑇀𑆮𑆑𑆳𑆬𑆮𑆴𑆖𑆳𑆫𑆵𑇆𑇒𑇖𑇆
𑆤 𑆑𑆳𑆫𑇀𑆪𑆑𑆳𑆬𑆩𑆠𑆴𑆥𑆳𑆠𑆪𑆼𑆠𑇀, 𑆤𑆳𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆩𑆨𑆴𑆤𑆴𑆮𑆴𑆯𑆼𑆠𑇀, 𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑆯𑆓𑆂 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆖𑆚𑇀𑆖𑆬𑆁 𑆩𑆤𑆾𑇁𑆤𑆶𑆨𑇀𑆫𑆳𑆩𑆪𑆼𑆠𑇀, 𑆤 𑆧𑆶𑆢𑇀𑆣𑆵𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆠𑆴𑆨𑆳𑆫𑆩𑆳𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆖𑆳𑆠𑆴𑆢𑆵𑆫𑇀𑆔𑆱𑆷𑆠𑇀𑆫𑆵 𑆱𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆑𑇀𑆫𑆾𑆣𑆲𑆫𑇀𑆰𑆳𑆮𑆤𑆶𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆤 𑆯𑆾𑆑𑆩𑆤𑆶𑆮𑆱𑆼𑆠𑇀, 𑆤 𑆱𑆴𑆢𑇀𑆣𑆳𑆮𑆶𑆠𑇀𑆱𑆼𑆑𑆁 𑆪𑆖𑇀𑆗𑆼𑆤𑇀𑆤𑆳𑆱𑆴𑆢𑇀𑆣𑆿 𑆢𑆽𑆤𑇀𑆪𑆁, 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆱𑇀𑆩𑆫𑆼𑆠𑇀, 𑆲𑆼𑆠𑆶𑆥𑇀𑆫𑆨𑆳𑆮𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆂 𑆱𑇀𑆪𑆳𑆢𑇀𑆣𑆼𑆠𑇀𑆮𑆳𑆫𑆩𑇀𑆨𑆤𑆴𑆠𑇀𑆪𑆯𑇀𑆖, 𑆤 𑆑𑆸𑆠𑆩𑆴𑆠𑇀𑆪𑆳𑆯𑇀𑆮𑆱𑆼𑆠𑇀, 𑆤 𑆮𑆵𑆫𑇀𑆪𑆁 𑆘𑆲𑇀𑆪𑆳𑆠𑇀, 𑆤𑆳𑆥𑆮𑆳𑆢𑆩𑆤𑆶𑆱𑇀𑆩𑆫𑆼𑆠𑇀𑇆𑇒𑇗𑇆
𑆤𑆳𑆯𑆶𑆖𑆴𑆫𑆶𑆠𑇀𑆠𑆩𑆳𑆘𑇀𑆪𑆳𑆑𑇀𑆰𑆠𑆠𑆴𑆬𑆑𑆶𑆯𑆱𑆫𑇀𑆰𑆥𑆽𑆫𑆓𑇀𑆤𑆴𑆁 𑆘𑆶𑆲𑆶𑆪𑆳𑆢𑆳𑆠𑇀𑆩𑆳𑆤𑆩𑆳𑆯𑆵𑆫𑇀𑆨𑆴𑆫𑆳𑆯𑆳𑆱𑆳𑆤𑆂, 𑆃𑆓𑇀𑆤𑆴𑆫𑇀𑆩𑆼 𑆤𑆳𑆥𑆓𑆖𑇀𑆗𑆼𑆖𑇀𑆗𑆫𑆵𑆫𑆳𑆢𑇀𑆮𑆳𑆪𑆶𑆫𑇀𑆩𑆼 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑆳𑆢𑆣𑆳𑆠𑆶 𑆮𑆴𑆰𑇀𑆟𑆶𑆫𑇀𑆩𑆼 𑆧𑆬𑆩𑆳𑆢𑆣𑆳𑆠𑆶 𑆅𑆤𑇀𑆢𑇀𑆫𑆾 𑆩𑆼 𑆮𑆵𑆫𑇀𑆪𑆁 𑆯𑆴𑆮𑆳 𑆩𑆳𑆁 𑆥𑇀𑆫𑆮𑆴𑆯𑆤𑇀𑆠𑇀𑆮𑆳𑆥 𑆄𑆥𑆾𑆲𑆴𑆰𑇀𑆜𑆼𑆠𑇀𑆪𑆥𑆂 𑆱𑇀𑆥𑆸𑆯𑆼𑆠𑇀, 𑆢𑇀𑆮𑆴𑆂 𑆥𑆫𑆴𑆩𑆸𑆘𑇀𑆪𑆾𑆰𑇀𑆜𑆿 𑆥𑆳𑆢𑆿 𑆖𑆳𑆨𑇀𑆪𑆶𑆑𑇀𑆰𑇀𑆪 𑆩𑆷𑆫𑇀𑆣𑆤𑆴 𑆒𑆳𑆤𑆴 𑆖𑆾𑆥𑆱𑇀𑆥𑆸𑆯𑆼𑆢𑆢𑇀𑆨𑆴𑆫𑆳𑆠𑇀𑆩𑆳𑆤𑆁 𑆲𑆸𑆢𑆪𑆁 𑆯𑆴𑆫𑆯𑇀𑆖𑇆𑇒𑇘𑇆
𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆘𑇀𑆚𑆳𑆤𑆢𑆳𑆤𑆩𑆽𑆠𑇀𑆫𑆵𑆑𑆳𑆫𑆶𑆟𑇀𑆪𑆲𑆫𑇀𑆰𑆾𑆥𑆼𑆑𑇀𑆰𑆳𑆥𑇀𑆫𑆯𑆩𑆥𑆫𑆯𑇀𑆖 𑆱𑇀𑆪𑆳𑆢𑆴𑆠𑆴𑇆𑇒𑇙𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆳𑆂- 𑆥𑆚𑇀𑆖𑆥𑆚𑇀𑆖𑆑𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆩𑆤𑆾 𑆲𑆼𑆠𑆶𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆩𑇀𑇅 𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑇁𑆣𑇀𑆪𑆳𑆪𑆼 𑆱𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆩𑆒𑆴𑆬𑆼𑆤 𑆖𑇆𑇓𑇐𑇆
𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆁 𑆪𑆡𑆾𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆁 𑆪𑆂 𑆱𑆩𑇀𑆪𑆓𑆤𑆶𑆠𑆴𑆰𑇀𑆜𑆠𑆴𑇅 𑆱 𑆱𑆩𑆳𑆂 𑆯𑆠𑆩𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆳𑆪𑆶𑆰𑆳 𑆤 𑆮𑆴𑆪𑆶𑆘𑇀𑆪𑆠𑆼𑇆𑇓𑇑𑇆
𑆤𑆸𑆬𑆾𑆑𑆩𑆳𑆥𑆷𑆫𑆪𑆠𑆼 𑆪𑆯𑆱𑆳 𑆱𑆳𑆣𑆶𑆱𑆩𑇀𑆩𑆠𑆂𑇅 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆳𑆮𑆼𑆠𑆴 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆧𑆤𑇀𑆣𑆶𑆠𑆳𑆩𑆶𑆥𑆓𑆖𑇀𑆗𑆠𑆴𑇆𑇓𑇒𑇆
𑆥𑆫𑆳𑆤𑇀 𑆱𑆶𑆑𑆸𑆠𑆴𑆤𑆾 𑆬𑆾𑆑𑆳𑆤𑇀 𑆥𑆶𑆟𑇀𑆪𑆑𑆫𑇀𑆩𑆳 𑆥𑇀𑆫𑆥𑆢𑇀𑆪𑆠𑆼𑇅 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆸𑆠𑇀𑆠𑆩𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆩𑆴𑆢𑆁 𑆱𑆫𑇀𑆮𑆼𑆟 𑆱𑆫𑇀𑆮𑆢𑆳𑇆𑇓𑇓𑇆
𑆪𑆖𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑆥𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀 𑆱𑇀𑆪𑆳𑆢𑆤𑆶𑆑𑇀𑆠𑆩𑆴𑆲 𑆥𑆷𑆘𑆴𑆠𑆩𑇀𑇅 𑆮𑆸𑆠𑇀𑆠𑆁 𑆠𑆢𑆥𑆴 𑆖𑆳𑆠𑇀𑆫𑆼𑆪𑆂 𑆱𑆢𑆽𑆮𑆳𑆨𑇀𑆪𑆤𑆶𑆩𑆤𑇀𑆪𑆠𑆼𑇆𑇓𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆒𑆶𑆝𑇀𑆝𑆳𑆑𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆨𑆴𑆰𑆓𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑇀𑆪𑆶𑆥𑆱𑇀𑆡𑆳𑆠𑆳 𑆫𑆾𑆓𑆵 𑆥𑆳𑆢𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆩𑇀𑇅 𑆓𑆶𑆟𑆮𑆠𑇀 𑆑𑆳𑆫𑆟𑆁 𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆴𑆑𑆳𑆫𑆮𑇀𑆪𑆶𑆥𑆯𑆳𑆤𑇀𑆠𑆪𑆼𑇆𑇓𑇆
𑆮𑆴𑆑𑆳𑆫𑆾 𑆣𑆳𑆠𑆶𑆮𑆽𑆰𑆩𑇀𑆪𑆁, 𑆱𑆳𑆩𑇀𑆪𑆁 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆱𑆶𑆒𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆁, 𑆮𑆴𑆑𑆳𑆫𑆾 𑆢𑆶𑆂𑆒𑆩𑆼𑆮 𑆖𑇆𑇔𑇆
𑆖𑆠𑆶𑆫𑇀𑆟𑆳𑆁 𑆨𑆴𑆰𑆓𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆱𑇀𑆠𑆳𑆤𑆳𑆁 𑆣𑆳𑆠𑆶𑆮𑆽𑆑𑆸𑆠𑆼𑇅 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑇀𑆣𑆳𑆠𑆶𑆱𑆳𑆩𑇀𑆪𑆳𑆫𑇀𑆡𑆳 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆼𑆠𑇀𑆪𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇆𑇕𑇆
𑆯𑇀𑆫𑆶𑆠𑆼 𑆥𑆫𑇀𑆪𑆮𑆢𑆳𑆠𑆠𑇀𑆮𑆁 𑆧𑆲𑆶𑆯𑆾 𑆢𑆸𑆰𑇀𑆛𑆑𑆫𑇀𑆩𑆠𑆳𑇅 𑆢𑆳𑆑𑇀𑆰𑇀𑆪𑆁 𑆯𑆿𑆖𑆩𑆴𑆠𑆴 𑆘𑇀𑆚𑆼𑆪𑆁 𑆮𑆽𑆢𑇀𑆪𑆼 𑆓𑆶𑆟𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆩𑇀𑇆𑇖𑇆
𑆧𑆲𑆶𑆠𑆳 𑆠𑆠𑇀𑆫𑆪𑆾𑆓𑇀𑆪𑆠𑇀𑆮𑆩𑆤𑆼𑆑𑆮𑆴𑆣𑆑𑆬𑇀𑆥𑆤𑆳𑇅 𑆱𑆩𑇀𑆥𑆖𑇀𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆾𑇁𑆪𑆁 𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆓𑆶𑆟 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇗𑇆
𑆇𑆥𑆖𑆳𑆫𑆘𑇀𑆚𑆠𑆳 𑆢𑆳𑆑𑇀𑆰𑇀𑆪𑆩𑆤𑆶𑆫𑆳𑆓𑆯𑇀𑆖 𑆨𑆫𑇀𑆠𑆫𑆴𑇅 𑆯𑆿𑆖𑆁 𑆖𑆼𑆠𑆴 𑆖𑆠𑆶𑆰𑇀𑆑𑆾𑇁𑆪𑆁 𑆓𑆶𑆟𑆂 𑆥𑆫𑆴𑆖𑆫𑆼 𑆘𑆤𑆼𑇆𑇘𑇆
𑆱𑇀𑆩𑆸𑆠𑆴𑆫𑇀𑆤𑆴𑆫𑇀𑆢𑆼𑆯𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆩𑆨𑆵𑆫𑆶𑆠𑇀𑆮𑆩𑆡𑆳𑆥𑆴 𑆖𑇅 𑆘𑇀𑆚𑆳𑆥𑆑𑆠𑇀𑆮𑆁 𑆖 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆳𑆠𑆶𑆫𑆱𑇀𑆪 𑆓𑆶𑆟𑆳𑆂 𑆱𑇀𑆩𑆸𑆠𑆳𑆂𑇆𑇙𑇆
𑆑𑆳𑆫𑆟𑆁 𑆰𑆾𑆝𑆯𑆓𑆶𑆟𑆁 𑆱𑆴𑆢𑇀𑆣𑆿 𑆥𑆳𑆢𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆩𑇀𑇅 𑆮𑆴𑆘𑇀𑆚𑆳𑆠𑆳 𑆯𑆳𑆱𑆴𑆠𑆳 𑆪𑆾𑆑𑇀𑆠𑆳 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆨𑆴𑆰𑆓𑆠𑇀𑆫 𑆠𑆶𑇆𑇑𑇐𑇆
𑆥𑆑𑇀𑆠𑆿 𑆲𑆴 𑆑𑆳𑆫𑆟𑆁 𑆥𑆑𑇀𑆠𑆶𑆫𑇀𑆪𑆡𑆳 𑆥𑆳𑆠𑇀𑆫𑆼𑆤𑇀𑆣𑆤𑆳𑆤𑆬𑆳𑆂𑇅 𑆮𑆴𑆘𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆘𑆪𑆼 𑆨𑆷𑆩𑆴𑆯𑇀𑆖𑆩𑆷𑆂 𑆥𑇀𑆫𑆲𑆫𑆟𑆳𑆤𑆴 𑆖𑇆𑇑𑇑𑇆
𑆄𑆠𑆶𑆫𑆳𑆢𑇀𑆪𑆳𑆱𑇀𑆠𑆡𑆳 𑆱𑆴𑆢𑇀𑆣𑆿 𑆥𑆳𑆢𑆳𑆂 𑆑𑆳𑆫𑆟𑆱𑆚𑇀𑆘𑇀𑆚𑆴𑆠𑆳𑆂𑇅 𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆪𑆳𑆠𑆯𑇀𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆪𑆳𑆁 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆑𑆳𑆫𑆟𑆁 𑆨𑆴𑆰𑆑𑇀𑇆𑇑𑇒𑇆
𑆩𑆸𑆢𑇀𑆢𑆟𑇀𑆝𑆖𑆑𑇀𑆫𑆱𑆷𑆠𑇀𑆫𑆳𑆢𑇀𑆪𑆳𑆂 𑆑𑆶𑆩𑇀𑆨𑆑𑆳𑆫𑆳𑆢𑆸𑆠𑆼 𑆪𑆡𑆳𑇅 𑆤𑆳𑆮𑆲𑆤𑇀𑆠𑆴 𑆓𑆶𑆟𑆁 𑆮𑆽𑆢𑇀𑆪𑆳𑆢𑆸𑆠𑆼 𑆥𑆳𑆢𑆠𑇀𑆫𑆪𑆁 𑆠𑆡𑆳𑇆𑇑𑇓𑇆
𑆓𑆤𑇀𑆣𑆫𑇀𑆮𑆥𑆶𑆫𑆮𑆤𑇀𑆤𑆳𑆯𑆁 𑆪𑆢𑇀𑆮𑆴𑆑𑆳𑆫𑆳𑆂 𑆱𑆶𑆢𑆳𑆫𑆶𑆟𑆳𑆂𑇅 𑆪𑆳𑆤𑇀𑆠𑆴 𑆪𑆖𑇀𑆖𑆼𑆠𑆫𑆼 𑆮𑆸𑆢𑇀𑆣𑆴𑆩𑆳𑆯𑆷𑆥𑆳𑆪𑆥𑇀𑆫𑆠𑆵𑆑𑇀𑆰𑆴𑆟𑆂𑇆𑇑𑇔𑇆
𑆱𑆠𑆴 𑆥𑆳𑆢𑆠𑇀𑆫𑆪𑆼 𑆘𑇀𑆚𑆳𑆘𑇀𑆚𑆿 𑆨𑆴𑆰𑆘𑆳𑆮𑆠𑇀𑆫 𑆑𑆳𑆫𑆟𑆩𑇀𑇅𑇑𑇕𑇅 𑆮𑆫𑆩𑆳𑆠𑇀𑆩𑆳 𑆲𑆶𑆠𑆾𑇁𑆘𑇀𑆚𑆼𑆤 𑆤 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆴𑆠𑆳𑇆𑇑𑇕𑇆
𑆥𑆳𑆟𑆴𑆖𑆳𑆫𑆳𑆢𑇀𑆪𑆡𑆳𑇁𑆖𑆑𑇀𑆰𑆶𑆫𑆘𑇀𑆚𑆳𑆤𑆳𑆢𑇀𑆨𑆵𑆠𑆨𑆵𑆠𑆮𑆠𑇀𑇅 𑆤𑆿𑆫𑇀𑆩𑆳𑆫𑆶𑆠𑆮𑆯𑆼𑆮𑆳𑆘𑇀𑆚𑆾 𑆨𑆴𑆰𑆑𑇀 𑆖𑆫𑆠𑆴 𑆑𑆫𑇀𑆩𑆱𑆶𑇆𑇑𑇖𑇆
𑆪𑆢𑆸𑆖𑇀𑆗𑆪𑆳 𑆱𑆩𑆳𑆥𑆤𑇀𑆤𑆩𑆶𑆠𑇀𑆠𑆳𑆫𑇀𑆪 𑆤𑆴𑆪𑆠𑆳𑆪𑆶𑆰𑆩𑇀𑇅 𑆨𑆴𑆰𑆕𑇀𑆩𑆳𑆤𑆵 𑆤𑆴𑆲𑆤𑇀𑆠𑇀𑆪𑆳𑆯𑆶 𑆯𑆠𑆳𑆤𑇀𑆪𑆤𑆴𑆪𑆠𑆳𑆪𑆶𑆰𑆳𑆩𑇀𑇆𑇑𑇗𑇆
𑆠𑆱𑇀𑆩𑆳𑆖𑇀𑆗𑆳𑆱𑇀𑆠𑇀𑆫𑆼𑇁𑆫𑇀𑆡𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆿 𑆑𑆫𑇀𑆩𑆢𑆫𑇀𑆯𑆤𑆼𑇅 𑆨𑆴𑆰𑆑𑇀 𑆖𑆠𑆶𑆰𑇀𑆛𑆪𑆼 𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆨𑆴𑆱𑆫 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇑𑇘𑇆
𑆲𑆼𑆠𑆿 𑆬𑆴𑆕𑇀𑆓𑆼 𑆥𑇀𑆫𑆯𑆩𑆤𑆼 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆼𑇅 𑆘𑇀𑆚𑆳𑆤𑆁 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆪𑆱𑇀𑆪 𑆱 𑆫𑆳𑆘𑆳𑆫𑇀𑆲𑆾 𑆨𑆴𑆰𑆑𑇀𑆠𑆩𑆂𑇆𑇑𑇙𑇆
𑆯𑆱𑇀𑆠𑇀𑆫𑆁 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆳𑆟𑆴 𑆱𑆬𑆴𑆬𑆁 𑆓𑆶𑆟𑆢𑆾𑆰𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆪𑆼𑇅 𑆥𑆳𑆠𑇀𑆫𑆳𑆥𑆼𑆑𑇀𑆰𑆵𑆟𑇀𑆪𑆠𑆂 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆫𑇀𑆡𑆁 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀𑇆𑇒𑇐𑇆
𑆮𑆴𑆢𑇀𑆪𑆳 𑆮𑆴𑆠𑆫𑇀𑆑𑆾 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆁 𑆱𑇀𑆩𑆸𑆠𑆴𑆱𑇀𑆠𑆠𑇀𑆥𑆫𑆠𑆳 𑆑𑇀𑆫𑆴𑆪𑆳𑇅 𑆪𑆱𑇀𑆪𑆽𑆠𑆼 𑆰𑆝𑇀𑆓𑆶𑆟𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆤 𑆱𑆳𑆣𑇀𑆪𑆩𑆠𑆴𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇒𑇑𑇆
𑆮𑆴𑆢𑇀𑆪𑆳 𑆩𑆠𑆴𑆂 𑆑𑆫𑇀𑆩𑆢𑆸𑆰𑇀𑆛𑆴𑆫𑆨𑇀𑆪𑆳𑆱𑆂 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆳𑆯𑇀𑆫𑆪𑆂𑇅 𑆮𑆽𑆢𑇀𑆪𑆯𑆧𑇀𑆢𑆳𑆨𑆴𑆤𑆴𑆰𑇀𑆥𑆠𑇀𑆠𑆳𑆮𑆬𑆩𑆼𑆑𑆽𑆑𑆩𑆥𑇀𑆪𑆠𑆂𑇆𑇒𑇒𑇆
𑆪𑆱𑇀𑆪 𑆠𑇀𑆮𑆼𑆠𑆼 𑆓𑆶𑆟𑆳𑆂 𑆱𑆫𑇀𑆮𑆼 𑆱𑆤𑇀𑆠𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆪𑆂 𑆯𑆶𑆨𑆳𑆂𑇅 𑆱 𑆮𑆽𑆢𑇀𑆪𑆯𑆧𑇀𑆢𑆁 𑆱𑆢𑇀𑆨𑆷𑆠𑆩𑆫𑇀𑆲𑆤𑇀 𑆥𑇀𑆫𑆳𑆟𑆴𑆱𑆶𑆒𑆥𑇀𑆫𑆢𑆂𑇆𑇒𑇓𑇆
𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆁 𑆘𑇀𑆪𑆾𑆠𑆴𑆂 𑆥𑇀𑆫𑆑𑆳𑆯𑆳𑆫𑇀𑆡𑆁 𑆢𑆫𑇀𑆯𑆤𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑆳𑆠𑇀𑆩𑆤𑆂𑇅 𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆨𑆴𑆰𑆑𑇀 𑆱𑆶𑆪𑆶𑆑𑇀𑆠𑆳𑆨𑇀𑆪𑆳𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆤𑇀𑆤𑆳𑆥𑆫𑆳𑆣𑇀𑆪𑆠𑆴𑇆𑇒𑇔𑇆
𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆼 𑆠𑇀𑆫𑆪𑆂 𑆥𑆳𑆢𑆳 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆂𑇅 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆪𑆠𑇀𑆤𑆩𑆳𑆠𑆴𑆰𑇀𑆜𑆼𑆢𑇀𑆨𑆴𑆰𑆑𑇀 𑆱𑇀𑆮𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆢𑆴𑇆𑇒𑇕𑇆
𑆩𑆽𑆠𑇀𑆫𑆵 𑆑𑆳𑆫𑆶𑆟𑇀𑆪𑆩𑆳𑆫𑇀𑆠𑆼𑆰𑆶 𑆯𑆑𑇀𑆪𑆼 𑆥𑇀𑆫𑆵𑆠𑆴𑆫𑆶𑆥𑆼𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆱𑇀𑆡𑆼𑆰𑆶 𑆨𑆷𑆠𑆼𑆰𑆶 𑆮𑆽𑆢𑇀𑆪𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆼𑆠𑆴𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆁 𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆁 𑆥𑆳𑆢𑆂 𑆥𑆳𑆢𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆂𑇅 𑆨𑆴𑆰𑆑𑇀 𑆥𑇀𑆫𑆣𑆳𑆤𑆁 𑆥𑆳𑆢𑆼𑆨𑇀𑆪𑆾 𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆮𑆽𑆢𑇀𑆪𑆱𑇀𑆠𑆶 𑆪𑆢𑇀𑆓𑆶𑆟𑆂𑇆𑇒𑇗𑇆
𑆘𑇀𑆚𑆳𑆤𑆳𑆤𑆴 𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆧𑇀𑆫𑆳𑆲𑇀𑆩𑆵 𑆖 𑆨𑆴𑆰𑆘𑆳𑆁 𑆪𑆳 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑇅 𑆱𑆫𑇀𑆮𑆩𑆼𑆠𑆖𑇀𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆼 𑆒𑆶𑆝𑇀𑆝𑆳𑆑𑆼 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑆴𑆠𑆴𑇆𑇒𑇘𑇆
𑆃𑆡𑆳𑆠𑆾 𑆩𑆲𑆳𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆁 𑆰𑆾𑆝𑆯𑆑𑆬𑆁 𑆨𑆼𑆰𑆘𑆩𑆴𑆠𑆴 𑆨𑆴𑆰𑆘𑆾 𑆨𑆳𑆰𑆤𑇀𑆠𑆼, 𑆪𑆢𑆶𑆑𑇀𑆠𑆁 𑆥𑆷𑆫𑇀𑆮𑆳𑆣𑇀𑆪𑆳𑆪𑆼 𑆰𑆾𑆝𑆯𑆓𑆶𑆟𑆩𑆴𑆠𑆴, 𑆠𑆢𑇀𑆨𑆼𑆰𑆘𑆁 𑆪𑆶𑆑𑇀𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆩𑆬𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆳𑆪𑆼𑆠𑆴 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇓𑇆
𑆤𑆼𑆠𑆴 𑆩𑆽𑆠𑇀𑆫𑆼𑆪𑆂, 𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁? 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼 𑆲𑇀𑆪𑆳𑆠𑆶𑆫𑆳𑆂 𑆑𑆼𑆖𑆴𑆢𑆶𑆥𑆑𑆫𑆟𑆮𑆤𑇀𑆠𑆯𑇀𑆖 𑆥𑆫𑆴𑆖𑆳𑆫𑆑𑆱𑆩𑇀𑆥𑆤𑇀𑆤𑆳𑆯𑇀𑆖𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆯𑇀𑆖 𑆑𑆶𑆯𑆬𑆽𑆯𑇀𑆖 𑆨𑆴𑆰𑆓𑇀𑆨𑆴𑆫𑆤𑆶𑆰𑇀𑆜𑆴𑆠𑆳𑆂 𑆱𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆳𑆂, 𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼 𑆩𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳𑆂; 𑆠𑆱𑇀𑆩𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆩𑆑𑆴𑆚𑇀𑆖𑆴𑆠𑇀𑆑𑆫𑆁 𑆨𑆮𑆠𑆴, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆯𑇀𑆮𑆨𑇀𑆫𑆼 𑆱𑆫𑆱𑆴 𑆖 𑆥𑇀𑆫𑆱𑆴𑆑𑇀𑆠𑆩𑆬𑇀𑆥𑆩𑆶𑆢𑆑𑆁, 𑆤𑆢𑇀𑆪𑆳𑆁 𑆮𑆳 𑆱𑇀𑆪𑆤𑇀𑆢𑆩𑆳𑆤𑆳𑆪𑆳𑆁 𑆥𑆳𑆁𑆱𑆶𑆣𑆳𑆤𑆼 𑆮𑆳 𑆥𑆳𑆁𑆱𑆶𑆩𑆶𑆰𑇀𑆛𑆴𑆂 𑆥𑇀𑆫𑆑𑆵𑆫𑇀𑆟 𑆅𑆠𑆴; 𑆠𑆡𑆳𑇁𑆥𑆫𑆼 𑆢𑆸𑆯𑇀𑆪𑆤𑇀𑆠𑆼𑇁𑆤𑆶𑆥𑆑𑆫𑆟𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆴𑆖𑆳𑆫𑆑𑆳𑆯𑇀𑆖𑆳𑆤𑆳𑆠𑇀𑆩𑆮𑆤𑇀𑆠𑆯𑇀𑆖𑆳𑆑𑆶𑆯𑆬𑆽𑆯𑇀𑆖 𑆨𑆴𑆰𑆓𑇀𑆨𑆴𑆫𑆤𑆶𑆰𑇀𑆜𑆴𑆠𑆳𑆂 𑆱𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆩𑆳𑆤𑆳𑆂, 𑆠𑆡𑆳𑆪𑆶𑆑𑇀𑆠𑆳 𑆩𑇀𑆫𑆴𑆪𑆩𑆳𑆟𑆳𑆯𑇀𑆖𑆳𑆥𑆫𑆼𑇅 𑆪𑆠𑆯𑇀𑆖 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆱𑆴𑆣𑇀𑆪𑆠𑆴, 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆱𑆴𑆣𑇀𑆪𑆠𑆴, 𑆃𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆩𑇀𑆫𑆴𑆪𑆠𑆼; 𑆠𑆠𑆯𑇀𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆠𑆼 𑆨𑆼𑆰𑆘𑆩𑆨𑆼𑆰𑆘𑆼𑆤𑆳𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆩𑆴𑆠𑆴 𑇆𑇔𑇆
𑆩𑆽𑆠𑇀𑆫𑆼𑆪 ! 𑆩𑆴𑆡𑇀𑆪𑆳 𑆖𑆴𑆤𑇀𑆠𑇀𑆪𑆠 𑆅𑆠𑇀𑆪𑆳𑆠𑇀𑆫𑆼𑆪𑆂; 𑆑𑆴𑆁 𑆑𑆳𑆫𑆟𑆁, 𑆪𑆼 𑆲𑇀𑆪𑆳𑆠𑆶𑆫𑆳𑆂 𑆰𑆾𑆝𑆯𑆓𑆶𑆟𑆱𑆩𑆶𑆢𑆴𑆠𑆼𑆤𑆳𑆤𑆼𑆤 𑆨𑆼𑆰𑆘𑆼𑆤𑆾𑆥𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆳 𑆩𑇀𑆫𑆴𑆪𑆤𑇀𑆠 𑆅𑆠𑇀𑆪𑆶𑆑𑇀𑆠𑆁 𑆠𑆢𑆤𑆶𑆥𑆥𑆤𑇀𑆤𑆁, 𑆤 𑆲𑆴 𑆨𑆼𑆰𑆘𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆨𑆼𑆰𑆘𑆩𑆑𑆳𑆫𑆟𑆁 𑆨𑆮𑆠𑆴; 𑆪𑆼 𑆥𑆶𑆤𑆫𑆳𑆠𑆶𑆫𑆳𑆂 𑆑𑆼𑆮𑆬𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆳𑆢𑆸𑆠𑆼 𑆱𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆤𑇀𑆠𑆼, 𑆤 𑆠𑆼𑆰𑆳𑆁 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆨𑆼𑆰𑆘𑆾𑆥𑆥𑆳𑆢𑆤𑆳𑆪 𑆱𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆾 𑆤𑆳𑆱𑇀𑆠𑆴; 𑆪𑆡𑆳 𑆲𑆴 𑆥𑆠𑆴𑆠𑆁 𑆥𑆶𑆫𑆶𑆰𑆁 𑆱𑆩𑆫𑇀𑆡𑆩𑆶𑆠𑇀𑆡𑆳𑆤𑆳𑆪𑆾𑆠𑇀𑆡𑆳𑆥𑆪𑆤𑇀 𑆥𑆶𑆫𑆶𑆰𑆾 𑆧𑆬𑆩𑆱𑇀𑆪𑆾𑆥𑆳𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆱 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆠𑆫𑆩𑆥𑆫𑆴𑆑𑇀𑆬𑆴𑆰𑇀𑆛 𑆍𑆮𑆾𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆠𑇀, 𑆠𑆢𑇀𑆮𑆠𑇀 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆨𑆼𑆰𑆘𑆾𑆥𑆬𑆩𑇀𑆨𑆳𑆢𑆳𑆠𑆶𑆫𑆳𑆂; 𑆪𑆼 𑆖𑆳𑆠𑆶𑆫𑆳𑆂 𑆑𑆼𑆮𑆬𑆳𑆢𑇀𑆨𑆼𑆰𑆘𑆳𑆢𑆥𑆴 𑆩𑇀𑆫𑆴𑆪𑆤𑇀𑆠𑆼, 𑆤 𑆖 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆠𑆼 𑆨𑆼𑆰𑆘𑆾𑆥𑆥𑆤𑇀𑆤𑆳𑆂 𑆱𑆩𑆶𑆠𑇀𑆠𑆴𑆰𑇀𑆜𑆼𑆫𑆤𑇀, 𑆤𑆲𑆴 𑆱𑆫𑇀𑆮𑆼 𑆮𑇀𑆪𑆳𑆣𑆪𑆾 𑆨𑆮𑆤𑇀𑆠𑇀𑆪𑆶𑆥𑆳𑆪𑆱𑆳𑆣𑇀𑆪𑆳𑆂, 𑆤 𑆖𑆾𑆥𑆳𑆪𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆩𑆤𑆶𑆥𑆳𑆪𑆼𑆤 𑆱𑆴𑆢𑇀𑆣𑆴𑆫𑆱𑇀𑆠𑆴, 𑆤 𑆖𑆳𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑆳𑆁 𑆨𑆼𑆰𑆘𑆱𑆩𑆶𑆢𑆳𑆪𑆾𑇁𑆪𑆩𑆱𑇀𑆠𑆴 , 𑆤 𑆲𑇀𑆪𑆬𑆁 𑆘𑇀𑆚𑆳𑆤𑆮𑆳𑆤𑇀 𑆨𑆴𑆰𑆕𑇀𑆩𑆶𑆩𑆷𑆫𑇀𑆰𑆶𑆩𑆳𑆠𑆶𑆫𑆩𑆶𑆠𑇀𑆡𑆳𑆥𑆪𑆴𑆠𑆶𑆁; 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆑𑆳𑆫𑆴𑆟𑆾 𑆲𑆴 𑆑𑆶𑆯𑆬𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆪𑆡𑆳 𑆲𑆴 𑆪𑆾𑆓𑆘𑇀𑆚𑆾𑇁𑆨𑇀𑆪𑆳𑆱𑆤𑆴𑆠𑇀𑆪 𑆅𑆰𑇀𑆮𑆳𑆱𑆾 𑆣𑆤𑆶𑆫𑆳𑆢𑆳𑆪𑆼𑆰𑆶𑆩𑆱𑇀𑆪𑆤𑇀𑆤𑆳𑆠𑆴𑆮𑆴𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆼 𑆩𑆲𑆠𑆴 𑆑𑆳𑆪𑆼 𑆤𑆳𑆥𑆫𑆳𑆣𑆮𑆳𑆤𑇀 𑆨𑆮𑆠𑆴, 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆠𑆴 𑆖𑆼𑆰𑇀𑆛𑆑𑆳𑆫𑇀𑆪𑆁, 𑆠𑆡𑆳 𑆨𑆴𑆰𑆑𑇀 𑆱𑇀𑆮𑆓𑆶𑆟𑆱𑆩𑇀𑆥𑆤𑇀𑆤 𑆇𑆥𑆑𑆫𑆟𑆮𑆳𑆤𑇀 𑆮𑆵𑆑𑇀𑆰𑇀𑆪 𑆑𑆫𑇀𑆩𑆳𑆫𑆨𑆩𑆳𑆟𑆂 𑆱𑆳𑆣𑇀𑆪𑆫𑆾𑆓𑆩𑆤𑆥𑆫𑆳𑆣𑆂 𑆱𑆩𑇀𑆥𑆳𑆢𑆪𑆠𑇀𑆪𑆼𑆮𑆳𑆠𑆶𑆫𑆩𑆳𑆫𑆾𑆓𑇀𑆪𑆼𑆟; 𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆤 𑆨𑆼𑆰𑆘𑆩𑆨𑆼𑆰𑆘𑆼𑆤𑆳𑆮𑆴𑆯𑆴𑆰𑇀𑆛𑆁 𑆨𑆮𑆠𑆴𑇆𑇕𑇆
𑆅𑆢𑆁 𑆖 𑆤𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁- 𑆪𑆢𑆤𑆳𑆠𑆶𑆫𑆼𑆟 𑆨𑆼𑆰𑆘𑆼𑆤𑆳𑆠𑆶𑆫𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆩𑆂 , 𑆑𑇀𑆰𑆳𑆩𑆩𑆑𑇀𑆰𑆳𑆩𑆼𑆟, 𑆑𑆸𑆯𑆁 𑆖 𑆢𑆶𑆫𑇀𑆧𑆬𑆩𑆳𑆥𑇀𑆪𑆳𑆪𑆪𑆳𑆩𑆂, 𑆱𑇀𑆡𑆷𑆬𑆁 𑆩𑆼𑆢𑆱𑇀𑆮𑆴𑆤𑆩𑆥𑆠𑆫𑇀𑆥𑆪𑆳𑆩𑆂, 𑆯𑆵𑆠𑆼𑆤𑆾𑆰𑇀𑆟𑆳𑆨𑆴𑆨𑆷𑆠𑆩𑆶𑆥𑆖𑆫𑆳𑆩𑆂, 𑆯𑆵𑆠𑆳𑆨𑆴𑆨𑆷𑆠𑆩𑆶𑆰𑇀𑆟𑆼𑆤, 𑆤𑇀𑆪𑆷𑆤𑆳𑆤𑇀 𑆣𑆳𑆠𑆷𑆤𑇀 𑆥𑆷𑆫𑆪𑆳𑆩𑆂, 𑆮𑇀𑆪𑆠𑆴𑆫𑆴𑆑𑇀𑆠𑆳𑆤𑇀 𑆲𑇀𑆫𑆳𑆱𑆪𑆳𑆩𑆂, 𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆩𑆷𑆬𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟𑆾𑆥𑆖𑆫𑆤𑇀𑆠𑆂 𑆱𑆩𑇀𑆪𑆑𑇀 𑆥𑇀𑆫𑆑𑆸𑆠𑆿 𑆱𑇀𑆡𑆳𑆥𑆪𑆳𑆩𑆂; 𑆠𑆼𑆰𑆳𑆁 𑆤𑆱𑇀𑆠𑆡𑆳 𑆑𑆶𑆫𑇀𑆮𑆠𑆳𑆩𑆪𑆁 𑆨𑆼𑆰𑆘𑆱𑆩𑆶𑆢𑆳𑆪𑆂 𑆑𑆳𑆤𑇀𑆠𑆠𑆩𑆾 𑆨𑆮𑆠𑆴𑇆𑇖𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆨𑆳𑆓𑆘𑇀𑆚𑆾 𑆘𑇀𑆚𑆳𑆤𑆥𑆷𑆫𑇀𑆮𑆁 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆑𑆂𑇅 𑆑𑆳𑆬𑆼 𑆖𑆳𑆫𑆨𑆠𑆼 𑆑𑆫𑇀𑆩 𑆪𑆠𑇀𑆠𑆠𑇀 𑆱𑆳𑆣𑆪𑆠𑆴 𑆣𑇀𑆫𑆶𑆮𑆩𑇀𑇆𑇗𑇆
𑆃𑆫𑇀𑆡𑆮𑆴𑆢𑇀𑆪𑆳𑆪𑆯𑆾𑆲𑆳𑆤𑆴𑆩𑆶𑆥𑆑𑇀𑆫𑆾𑆯𑆩𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆩𑇀 𑇅 𑆥𑇀𑆫𑆳𑆥𑇀𑆤𑆶𑆪𑆳𑆤𑇀𑆤𑆴𑆪𑆠𑆁 𑆮𑆽𑆢𑇀𑆪𑆾 𑆪𑆾𑇁𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑆩𑆶𑆥𑆳𑆖𑆫𑆼𑆠𑇀𑇆𑇘𑇆
𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆁 𑆩𑆠𑆁 𑆱𑆳𑆣𑇀𑆪𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆩𑆡𑆳𑆥𑆴 𑆖𑇅 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆖𑆳𑆥𑇀𑆪𑆱𑆳𑆣𑇀𑆪𑆁 𑆱𑇀𑆪𑆳𑆢𑇀𑆪𑆳𑆥𑇀𑆪𑆁 𑆪𑆖𑇀𑆖𑆳𑆤𑆶𑆥𑆑𑇀𑆫𑆩𑆩𑇀 𑇆𑇙𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆯𑇀𑆖𑆳𑆬𑇀𑆥𑆩𑆣𑇀𑆪𑆩𑆾𑆠𑇀𑆑𑆸𑆰𑇀𑆛𑆠𑆳𑆁 𑆥𑇀𑆫𑆠𑆴𑇅 𑆮𑆴𑆑𑆬𑇀𑆥𑆾, 𑆤 𑆠𑇀𑆮𑆱𑆳𑆣𑇀𑆪𑆳𑆤𑆳𑆁 𑆤𑆴𑆪𑆠𑆳𑆤𑆳𑆁 𑆮𑆴𑆑𑆬𑇀𑆥𑆤𑆳𑇆𑇑𑇐𑇆
𑆲𑆼𑆠𑆮𑆂 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆴 𑆫𑆷𑆥𑆳𑆟𑇀𑆪𑆬𑇀𑆥𑆳𑆤𑆴 𑆪𑆱𑇀𑆪 𑆖𑇅 𑆤 𑆖 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆟𑆾 𑆢𑆷𑆰𑇀𑆪𑆾 𑆤 𑆢𑆾𑆰𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑇀𑆨𑆮𑆼𑆠𑇀𑇆𑇑𑇑𑇆
𑆤 𑆖 𑆑𑆳𑆬𑆓𑆶𑆟𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆾 𑆤 𑆢𑆼𑆯𑆾 𑆢𑆶𑆫𑆶𑆥𑆑𑇀𑆫𑆩𑆂𑇅 𑆓𑆠𑆴𑆫𑆼𑆑𑆳 𑆤𑆮𑆠𑇀𑆮𑆁 𑆖 𑆫𑆾𑆓𑆱𑇀𑆪𑆾𑆥𑆢𑇀𑆫𑆮𑆾 𑆤 𑆖𑇆𑇑𑇒𑇆
𑆢𑆾𑆰𑆯𑇀𑆖𑆽𑆑𑆂 𑆱𑆩𑆶𑆠𑇀𑆥𑆠𑇀𑆠𑆿 𑆢𑆼𑆲𑆂 𑆱𑆫𑇀𑆮𑆿𑆰𑆣𑆑𑇀𑆰𑆩𑆂𑇅 𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆾𑆥𑆥𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆪 𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇑𑇓𑇆
𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆳𑆟𑆳𑆁 𑆫𑆷𑆥𑆳𑆟𑆳𑆁 𑆩𑆣𑇀𑆪𑆩𑆼 𑆧𑆬𑆼𑇅 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆢𑆷𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆼𑇁𑆤𑇀𑆪𑆠𑆩𑆱𑇀𑆪 𑆖𑇆𑇑𑇔𑇆
𑆓𑆫𑇀𑆨𑆴𑆟𑆵𑆮𑆸𑆢𑇀𑆣𑆧𑆳𑆬𑆳𑆤𑆳𑆁 𑆤𑆳𑆠𑇀𑆪𑆶𑆥𑆢𑇀𑆫𑆮𑆥𑆵𑆝𑆴𑆠𑆩𑇀𑇅 𑆯𑆱𑇀𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆳𑆓𑇀𑆤𑆴𑆑𑆸𑆠𑇀𑆪𑆳𑆤𑆳𑆩𑆤𑆮𑆁 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆢𑆼𑆯𑆘𑆩𑇀𑇆𑇑𑇕𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑆼𑆑𑆥𑆡𑆁 𑆫𑆾𑆓𑆁 𑆤𑆳𑆠𑆴𑆥𑆷𑆫𑇀𑆟𑆖𑆠𑆶𑆰𑇀𑆥𑆢𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆥𑆡𑆁 𑆤𑆳𑆠𑆴𑆑𑆳𑆬𑆁 𑆮𑆳 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆱𑆳𑆣𑇀𑆪𑆁 𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆘𑆩𑇀𑇆𑇑𑇖𑇆
𑆯𑆼𑆰𑆠𑇀𑆮𑆳𑆢𑆳𑆪𑆶𑆰𑆾 𑆪𑆳𑆥𑇀𑆪𑆩𑆱𑆳𑆣𑇀𑆪𑆁 𑆥𑆡𑇀𑆪𑆱𑆼𑆮𑆪𑆳𑇅 𑆬𑆧𑇀𑆣𑆳𑆬𑇀𑆥𑆱𑆶𑆒𑆩𑆬𑇀𑆥𑆼𑆤 𑆲𑆼𑆠𑆶𑆤𑆳𑇁𑇁𑆯𑆶𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆑𑆩𑇀𑇆𑇑𑇗𑇆
𑆓𑆩𑇀𑆨𑆵𑆫𑆁 𑆧𑆲𑆶𑆣𑆳𑆠𑆶𑆱𑇀𑆡𑆁 𑆩𑆫𑇀𑆩𑆱𑆤𑇀𑆣𑆴𑆱𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆩𑇀𑇅 𑆤𑆴𑆠𑇀𑆪𑆳𑆤𑆶𑆯𑆳𑆪𑆴𑆤𑆁 𑆫𑆾𑆓𑆁 𑆢𑆵𑆫𑇀𑆔𑆑𑆳𑆬𑆩𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇆𑇑𑇘𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆢𑇀𑆢𑇀𑆮𑆴𑆢𑆾𑆰𑆘𑆁,...𑇅𑇑𑇙𑇅 ...𑆠𑆢𑇀𑆮𑆠𑇀 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆼𑆪𑆁 𑆠𑇀𑆫𑆴𑆢𑆾𑆰𑆘𑆩𑇀𑇅 𑆑𑇀𑆫𑆴𑆪𑆳𑆥𑆡𑆩𑆠𑆴𑆑𑇀𑆫𑆳𑆤𑇀𑆠𑆁 𑆱𑆫𑇀𑆮𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆩𑇀𑇆𑇑𑇙𑇆
𑆐𑆠𑇀𑆱𑆶𑆑𑇀𑆪𑆳𑆫𑆠𑆴𑆱𑆩𑇀𑆩𑆾𑆲𑆑𑆫𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆤𑆳𑆯𑆤𑆩𑇀𑇅 𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪 𑆱𑆶𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆁 𑆱𑆳𑆫𑆴𑆰𑇀𑆛𑆩𑆼𑆮 𑆖𑇆𑇒𑇐𑇆
𑆨𑆴𑆰𑆘𑆳 𑆥𑇀𑆫𑆳𑆑𑇀 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆽𑆮𑆁 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆥𑆯𑇀𑆖𑆳𑆠𑇀𑆑𑆫𑇀𑆩𑆱𑆩𑆳𑆫𑆩𑇀𑆨𑆂 𑆑𑆳𑆫𑇀𑆪𑆂 𑆱𑆳𑆣𑇀𑆪𑆼𑆰𑆶 𑆣𑆵𑆩𑆠𑆳𑇆𑇒𑇑𑇆
𑆱𑆳𑆣𑇀𑆪𑆳𑆱𑆳𑆣𑇀𑆪𑆮𑆴𑆨𑆳𑆓𑆘𑇀𑆚𑆾 𑆪𑆂 𑆱𑆩𑇀𑆪𑆑𑇀𑆥𑇀𑆫𑆠𑆴𑆥𑆠𑇀𑆠𑆴𑆩𑆳𑆤𑇀𑇅 𑆤 𑆱 𑆩𑆽𑆠𑇀𑆫𑆼𑆪𑆠𑆶𑆬𑇀𑆪𑆳𑆤𑆳𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆧𑆶𑆢𑇀𑆣𑆴𑆁 𑆥𑇀𑆫𑆑𑆬𑇀𑆥𑆪𑆼𑆠𑇀𑇆𑇒𑇒𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆅𑆲𑆿𑆰𑆣𑆁 𑆥𑆳𑆢𑆓𑆶𑆟𑆳𑆂 𑆥𑇀𑆫𑆨𑆮𑆾 𑆨𑆼𑆰𑆘𑆳𑆯𑇀𑆫𑆪𑆂𑇅 𑆄𑆠𑇀𑆫𑆼𑆪𑆩𑆽𑆠𑇀𑆫𑆼𑆪𑆩𑆠𑆵 𑆩𑆠𑆴𑆢𑇀𑆮𑆽𑆮𑆴𑆣𑇀𑆪𑆤𑆴𑆯𑇀𑆖𑆪𑆂𑇆𑇒𑇓𑇆
𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆳𑆯𑇀𑆖 𑆮𑇀𑆪𑆳𑆣𑆪𑆂 𑆱𑇀𑆮𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆳𑆂𑇅 𑆇𑆑𑇀𑆠𑆳 𑆩𑆲𑆳𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆼 𑆪𑆼𑆰𑇀𑆮𑆳𑆪𑆠𑇀𑆠𑆁 𑆨𑆴𑆰𑆓𑇀𑆘𑆴𑆠𑆩𑇀𑇆𑇒𑇔𑇆
𑆃𑆡𑆳𑆠𑆱𑇀𑆠𑆴𑆱𑇀𑆫𑆽𑆰𑆟𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆅𑆲 𑆒𑆬𑆶 𑆥𑆶𑆫𑆶𑆰𑆼𑆟𑆳𑆤𑆶𑆥𑆲𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑆴𑆥𑆿𑆫𑆶𑆰𑆥𑆫𑆳𑆑𑇀𑆫𑆩𑆼𑆟 𑆲𑆴𑆠𑆩𑆴𑆲 𑆖𑆳𑆩𑆶𑆰𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆬𑆾𑆑𑆼 𑆱𑆩𑆤𑆶𑆥𑆯𑇀𑆪𑆠𑆳 𑆠𑆴𑆱𑇀𑆫 𑆍𑆰𑆟𑆳𑆂 𑆥𑆫𑇀𑆪𑆼𑆰𑇀𑆛𑆮𑇀𑆪𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇅 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆥𑇀𑆫𑆳𑆟𑆽𑆰𑆟𑆳, 𑆣𑆤𑆽𑆰𑆟𑆳, 𑆥𑆫𑆬𑆾𑆑𑆽𑆰𑆟𑆼𑆠𑆴𑇆𑇓𑇆
𑆄𑆱𑆳𑆁 𑆠𑆶 𑆒𑆬𑇀𑆮𑆼𑆰𑆟𑆳𑆤𑆳𑆁 𑆥𑇀𑆫𑆳𑆟𑆽𑆰𑆟𑆳𑆁 𑆠𑆳𑆮𑆠𑇀 𑆥𑆷𑆫𑇀𑆮𑆠𑆫𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆠𑇅 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆥𑇀𑆫𑆳𑆟𑆥𑆫𑆴𑆠𑇀𑆪𑆳𑆓𑆼 𑆲𑆴 𑆱𑆫𑇀𑆮𑆠𑇀𑆪𑆳𑆓𑆂𑇅 𑆠𑆱𑇀𑆪𑆳𑆤𑆶𑆥𑆳𑆬𑆤𑆁- 𑆱𑇀𑆮𑆱𑇀𑆡𑆱𑇀𑆪 𑆱𑇀𑆮𑆱𑇀𑆡𑆮𑆸𑆠𑇀𑆠𑆳𑆤𑆶𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆄𑆠𑆶𑆫𑆱𑇀𑆪 𑆮𑆴𑆑𑆳𑆫𑆥𑇀𑆫𑆯𑆩𑆤𑆼𑇁𑆥𑇀𑆫𑆩𑆳𑆢𑆂, 𑆠𑆢𑆶𑆨𑆪𑆩𑆼𑆠𑆢𑆶𑆑𑇀𑆠𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑆖; 𑆠𑆢𑇀𑆪𑆡𑆾𑆑𑇀𑆠𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆩𑆳𑆤𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑆶𑆥𑆳𑆬𑆤𑆳𑆢𑇀𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆫𑆮𑆳𑆥𑇀𑆤𑆾𑆠𑆵𑆠𑆴 𑆥𑇀𑆫𑆡𑆩𑆽𑆰𑆟𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆠𑆴𑇆𑇔𑇆
𑆃𑆡 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳𑆁 𑆣𑆤𑆽𑆰𑆟𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆠, 𑆥𑇀𑆫𑆳𑆟𑆼𑆨𑇀𑆪𑆾 𑆲𑇀𑆪𑆤𑆤𑇀𑆠𑆫𑆁 𑆣𑆤𑆩𑆼𑆮 𑆥𑆫𑇀𑆪𑆼𑆰𑇀𑆛𑆮𑇀𑆪𑆁 𑆨𑆮𑆠𑆴 ; 𑆤 𑆲𑇀𑆪𑆠𑆂 𑆥𑆳𑆥𑆳𑆠𑇀 𑆥𑆳𑆥𑆵𑆪𑆾𑇁𑆱𑇀𑆠𑆴 𑆪𑆢𑆤𑆶𑆥𑆑𑆫𑆟𑆱𑇀𑆪 𑆢𑆵𑆫𑇀𑆔𑆩𑆳𑆪𑆶𑆂, 𑆠𑆱𑇀𑆩𑆳𑆢𑆶𑆥𑆑𑆫𑆟𑆳𑆤𑆴 𑆥𑆫𑇀𑆪𑆼𑆰𑇀𑆛𑆶𑆁 𑆪𑆠𑆼𑆠𑇅 𑆠𑆠𑇀𑆫𑆾𑆥𑆑𑆫𑆟𑆾𑆥𑆳𑆪𑆳𑆤𑆤𑆶𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆑𑆸𑆰𑆴𑆥𑆳𑆯𑆶𑆥𑆳𑆬𑇀𑆪𑆮𑆳𑆟𑆴𑆘𑇀𑆪𑆫𑆳𑆘𑆾𑆥𑆱𑆼𑆮𑆳𑆢𑆵𑆤𑆴, 𑆪𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆥𑆴 𑆱𑆠𑆳𑆩𑆮𑆴𑆓𑆫𑇀𑆲𑆴𑆠𑆳𑆤𑆴 𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆮𑆸𑆠𑇀𑆠𑆴𑆥𑆶𑆰𑇀𑆛𑆴𑆑𑆫𑆳𑆟𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆤𑇀𑆪𑆳𑆫𑆨𑆼𑆠 𑆑𑆫𑇀𑆠𑆶𑆁; 𑆠𑆡𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀 𑆢𑆵𑆫𑇀𑆔𑆘𑆵𑆮𑆴𑆠𑆁 𑆘𑆵𑆮𑆠𑇀𑆪𑆤𑆮𑆩𑆠𑆂 𑆥𑆶𑆫𑆶𑆰𑆾 𑆨𑆮𑆠𑆴 𑇅 𑆅𑆠𑆴 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆳 𑆣𑆤𑆽𑆰𑆟𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆠𑆴𑇆𑇕𑇆
𑆃𑆡 𑆠𑆸𑆠𑆵𑆪𑆳𑆁 𑆥𑆫𑆬𑆾𑆑𑆽𑆰𑆟𑆳𑆩𑆳𑆥𑆢𑇀𑆪𑆼𑆠𑇅 𑆱𑆁𑆯𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫, 𑆑𑆡𑆁? 𑆨𑆮𑆴𑆰𑇀𑆪𑆳𑆩 𑆅𑆠𑆯𑇀𑆖𑇀𑆪𑆶𑆠𑆳 𑆤𑆮𑆼𑆠𑆴; 𑆑𑆶𑆠𑆂 𑆥𑆶𑆤𑆂 𑆱𑆁𑆯𑆪 𑆅𑆠𑆴, 𑆇𑆖𑇀𑆪𑆠𑆼- 𑆱𑆤𑇀𑆠𑆴 𑆲𑇀𑆪𑆼𑆑𑆼 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆥𑆫𑆳𑆂 𑆥𑆫𑆾𑆑𑇀𑆰𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆱𑇀𑆪 𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑆳𑆂, 𑆱𑆤𑇀𑆠𑆴 𑆖𑆳𑆓𑆩𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆳𑆢𑆼𑆮 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴; 𑆯𑇀𑆫𑆶𑆠𑆴𑆨𑆼𑆢𑆳𑆖𑇀𑆖- ‘𑆩𑆳𑆠𑆫𑆁 𑆥𑆴𑆠𑆫𑆁 𑆖𑆽𑆑𑆼 𑆩𑆤𑇀𑆪𑆤𑇀𑆠𑆼 𑆘𑆤𑇀𑆩𑆑𑆳𑆫𑆟𑆩𑇀 𑇅 𑆱𑇀𑆮𑆨𑆳𑆮𑆁 𑆥𑆫𑆤𑆴𑆫𑇀𑆩𑆳𑆟𑆁 𑆪𑆢𑆸𑆖𑇀𑆗𑆳𑆁 𑆖𑆳𑆥𑆫𑆼 𑆘𑆤𑆳𑆂’ 𑇆 𑆅𑆠𑆴 𑇅 𑆃𑆠𑆂 𑆱𑆁𑆯𑆪𑆂- 𑆑𑆴𑆁 𑆤𑆶 𑆒𑆬𑇀𑆮𑆱𑇀𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆾 𑆤 𑆮𑆼𑆠𑆴𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑇀𑆪𑆧𑆶𑆢𑇀𑆣𑆴𑆁 𑆘𑆲𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑆁 𑆖𑇅 𑆑𑆱𑇀𑆩𑆳𑆠𑇀? 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁 𑆲𑇀𑆪𑆬𑇀𑆥𑆩𑇀; 𑆃𑆤𑆬𑇀𑆥𑆩𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑆱𑇀𑆠𑆴, 𑆪𑆢𑆳𑆓𑆩𑆳𑆤𑆶𑆩𑆳𑆤𑆪𑆶𑆑𑇀𑆠𑆴𑆨𑆴𑆫𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼; 𑆪𑆽𑆫𑆼𑆮 𑆠𑆳𑆮𑆢𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆽𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼, 𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆱𑆤𑇀𑆠𑆴 𑆖𑆳𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆟𑆴𑇆𑇗𑇆
𑆱𑆠𑆳𑆁 𑆖 𑆫𑆷𑆥𑆳𑆟𑆳𑆩𑆠𑆴𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆳𑆢𑆠𑆴𑆮𑆴𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆳𑆢𑆳𑆮𑆫𑆟𑆳𑆠𑇀 𑆑𑆫𑆟𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆳𑆤𑇀𑆩𑆤𑆾𑆤𑆮𑆱𑇀𑆡𑆳𑆤𑆳𑆠𑇀 𑆱𑆩𑆳𑆤𑆳𑆨𑆴𑆲𑆳𑆫𑆳𑆢𑆨𑆴𑆨𑆮𑆳𑆢𑆠𑆴𑆱𑆿𑆑𑇀𑆰𑇀𑆩𑇀𑆪𑆳𑆖𑇀𑆖 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆳𑆤𑆶𑆥𑆬𑆧𑇀𑆣𑆴𑆂; 𑆠𑆱𑇀𑆩𑆳𑆢𑆥𑆫𑆵𑆑𑇀𑆰𑆴𑆠𑆩𑆼𑆠𑆢𑆶𑆖𑇀𑆪𑆠𑆼- 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑆼𑆮𑆳𑆱𑇀𑆠𑆴, 𑆤𑆳𑆤𑇀𑆪𑆢𑆱𑇀𑆠𑆵𑆠𑆴𑇆𑇘𑇆
𑆯𑇀𑆫𑆶𑆠𑆪𑆯𑇀𑆖𑆽𑆠𑆳 𑆤 𑆑𑆳𑆫𑆟𑆁, 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑆴𑆫𑆾𑆣𑆳𑆠𑇀𑇅 𑆄𑆠𑇀𑆩𑆳 𑆩𑆳𑆠𑆶𑆂 𑆥𑆴𑆠𑆶𑆫𑇀𑆮𑆳 𑆪𑆂 𑆱𑆾𑇁𑆥𑆠𑇀𑆪𑆁 𑆪𑆢𑆴 𑆱𑆚𑇀𑆖𑆫𑆼𑆠𑇀𑇅 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆱𑆚𑇀𑆖𑆫𑆼𑆢𑆳𑆠𑇀𑆩𑆳 𑆱𑆫𑇀𑆮𑆾𑆮𑆳𑇁𑆮𑆪𑆮𑆼𑆤 𑆮𑆳𑇆𑇙𑇆
𑆱𑆫𑇀𑆮𑆯𑇀𑆖𑆼𑆠𑇀 𑆱𑆚𑇀𑆖𑆫𑆼𑆤𑇀𑆩𑆳𑆠𑆶𑆂 𑆥𑆴𑆠𑆶𑆫𑇀𑆮𑆳 𑆩𑆫𑆟𑆁 𑆨𑆮𑆼𑆠𑇀𑇅 𑆤𑆴𑆫𑆤𑇀𑆠𑆫𑆁, 𑆤𑆳𑆮𑆪𑆮𑆂 𑆑𑆯𑇀𑆖𑆴𑆠𑇀𑆱𑆷𑆑𑇀𑆰𑇀𑆩𑆱𑇀𑆪 𑆖𑆳𑆠𑇀𑆩𑆤𑆂𑇆𑇑𑇐𑇆
𑆧𑆶𑆢𑇀𑆣𑆴𑆫𑇀𑆩𑆤𑆯𑇀𑆖 𑆤𑆴𑆫𑇀𑆟𑆵𑆠𑆼 𑆪𑆡𑆽𑆮𑆳𑆠𑇀𑆩𑆳 𑆠𑆡𑆽𑆮 𑆠𑆼𑇅 𑆪𑆼𑆰𑆳𑆁 𑆖𑆽𑆰𑆳 𑆩𑆠𑆴𑆱𑇀𑆠𑆼𑆰𑆳𑆁 𑆪𑆾𑆤𑆴𑆫𑇀𑆤𑆳𑆱𑇀𑆠𑆴 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳𑇆𑇑𑇑𑇆
𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀 𑆱𑇀𑆮𑆳𑆨𑆳𑆮𑆴𑆑𑆁 𑆰𑆟𑇀𑆟𑆳𑆁 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆪𑆠𑇀 𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆱𑆁𑆪𑆾𑆓𑆼 𑆖 𑆮𑆴𑆪𑆾𑆓𑆼 𑆖 𑆠𑆼𑆰𑆳𑆁 𑆑𑆫𑇀𑆩𑆽𑆮 𑆑𑆳𑆫𑆟𑆩𑇀𑇆𑇑𑇒𑇆
𑆃𑆤𑆳𑆢𑆼𑆯𑇀𑆖𑆼𑆠𑆤𑆳𑆣𑆳𑆠𑆾𑆫𑇀𑆤𑆼𑆰𑇀𑆪𑆠𑆼 𑆥𑆫𑆤𑆴𑆫𑇀𑆩𑆴𑆠𑆴𑆂𑇅 𑆥𑆫 𑆄𑆠𑇀𑆩𑆳 𑆱 𑆖𑆼𑆢𑇀𑆣𑆼𑆠𑆶𑆫𑆴𑆰𑇀𑆛𑆾𑇁𑆱𑇀𑆠𑆶 𑆥𑆫𑆤𑆴𑆫𑇀𑆩𑆴𑆠𑆴𑆂𑇆𑇑𑇓𑇆
𑆤 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆤 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆤 𑆑𑆫𑇀𑆠𑆳 𑆑𑆳𑆫𑆟𑆁 𑆤 𑆖𑇅 𑆤 𑆢𑆼𑆮𑆳 𑆤𑆫𑇀𑆰𑆪𑆂 𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆑𑆫𑇀𑆩 𑆑𑆫𑇀𑆩𑆦𑆬𑆁 𑆤 𑆖𑇆𑇑𑇔𑇆
𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑆱𑇀𑆪𑆳𑆱𑇀𑆠𑆴 𑆤𑆽𑆮𑆳𑆠𑇀𑆩𑆳 𑆪𑆢𑆸𑆖𑇀𑆗𑆾𑆥𑆲𑆠𑆳𑆠𑇀𑆩𑆤𑆂𑇅 𑆥𑆳𑆠𑆑𑆼𑆨𑇀𑆪𑆂 𑆥𑆫𑆁 𑆖𑆽𑆠𑆠𑇀 𑆥𑆳𑆠𑆑𑆁 𑆤𑆳𑆱𑇀𑆠𑆴𑆑𑆓𑇀𑆫𑆲𑆂𑇆𑇑𑇕𑇆
𑆠𑆱𑇀𑆩𑆳𑆤𑇀𑆩𑆠𑆴𑆁 𑆮𑆴𑆩𑆶𑆖𑇀𑆪𑆽𑆠𑆳𑆩𑆩𑆳𑆫𑇀𑆓𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆁 𑆧𑆶𑆣𑆂𑇅 𑆱𑆠𑆳𑆁 𑆧𑆶𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆢𑆵𑆥𑆼𑆤 𑆥𑆯𑇀𑆪𑆼𑆠𑇀𑆱𑆫𑇀𑆮𑆁 𑆪𑆡𑆳𑆠𑆡𑆩𑇀𑇆𑇑𑇖𑇆
𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆩𑆼𑆮 𑆒𑆬𑆶 𑆱𑆫𑇀𑆮𑆁 𑆱𑆖𑇀𑆖𑆳𑆱𑆖𑇀𑆖; 𑆠𑆱𑇀𑆪 𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆳- 𑆄𑆥𑇀𑆠𑆾𑆥𑆢𑆼𑆯𑆂, 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑇀, 𑆃𑆤𑆶𑆩𑆳𑆤𑆁, 𑆪𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇗𑇆
𑆄𑆥𑇀𑆠𑆳𑆱𑇀𑆠𑆳𑆮𑆠𑇀- 𑆫𑆘𑆱𑇀𑆠𑆩𑆾𑆨𑇀𑆪𑆳𑆁 𑆤𑆴𑆫𑇀𑆩𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆥𑆾𑆘𑇀𑆚𑆳𑆤𑆧𑆬𑆼𑆤 𑆪𑆼𑇅 𑆪𑆼𑆰𑆳𑆁 𑆠𑇀𑆫𑆴𑆑𑆳𑆬𑆩𑆩𑆬𑆁 𑆘𑇀𑆚𑆳𑆤𑆩𑆮𑇀𑆪𑆳𑆲𑆠𑆁 𑆱𑆢𑆳𑇆𑇑𑇘𑇆
𑆄𑆥𑇀𑆠𑆳𑆂 𑆯𑆴𑆰𑇀𑆛𑆳 𑆮𑆴𑆧𑆶𑆢𑇀𑆣𑆳𑆱𑇀𑆠𑆼 𑆠𑆼𑆰𑆳𑆁 𑆮𑆳𑆑𑇀𑆪𑆩𑆱𑆁𑆯𑆪𑆩𑇀𑇅 𑆱𑆠𑇀𑆪𑆁, 𑆮𑆑𑇀𑆰𑇀𑆪𑆤𑇀𑆠𑆴 𑆠𑆼 𑆑𑆱𑇀𑆩𑆳𑆢𑆱𑆠𑇀𑆪𑆁 𑆤𑆵𑆫𑆘𑆱𑇀𑆠𑆩𑆳𑆂 𑇆𑇑𑇙𑇆
𑆄𑆠𑇀𑆩𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆾𑆫𑇀𑆡𑆳𑆤𑆳𑆁 𑆱𑆤𑇀𑆤𑆴𑆑𑆫𑇀𑆰𑆳𑆠𑇀 𑆥𑇀𑆫𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆮𑇀𑆪𑆑𑇀𑆠𑆳 𑆠𑆢𑆳𑆠𑇀𑆮𑆼 𑆪𑆳 𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆁 𑆱 𑆤𑆴𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇆𑇒𑇐𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆥𑆷𑆫𑇀𑆮𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆠𑇀𑆫𑆴𑆑𑆳𑆬𑆁 𑆖𑆳𑆤𑆶𑆩𑆵𑆪𑆠𑆼𑇅 𑆮𑆲𑇀𑆤𑆴𑆫𑇀𑆤𑆴𑆓𑆷𑆞𑆾 𑆣𑆷𑆩𑆼𑆤 𑆩𑆽𑆡𑆶𑆤𑆁 𑆓𑆫𑇀𑆨𑆢𑆫𑇀𑆯𑆤𑆳𑆠𑇀𑇆𑇒𑇑𑇆
𑆍𑆮𑆁 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆤𑇀𑆠𑇀𑆪𑆠𑆵𑆠𑆁 𑆧𑆵𑆘𑆳𑆠𑇀 𑆦𑆬𑆩𑆤𑆳𑆓𑆠𑆩𑇀𑇅 𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆧𑆵𑆘𑆳𑆠𑇀 𑆦𑆬𑆁 𑆘𑆳𑆠𑆩𑆴𑆲𑆽𑆮 𑆱𑆢𑆸𑆯𑆁 𑆧𑆶𑆣𑆳𑆂𑇆𑇒𑇒𑇆
𑆘𑆬𑆑𑆫𑇀𑆰𑆟𑆧𑆵𑆘𑆫𑇀𑆠𑆶𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀 𑆱𑆱𑇀𑆪𑆱𑆩𑇀𑆨𑆮𑆂𑇅 𑆪𑆶𑆑𑇀𑆠𑆴𑆂 𑆰𑆝𑇀𑆣𑆳𑆠𑆶𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆳𑆟𑆳𑆁 𑆱𑆩𑇀𑆨𑆮𑆱𑇀𑆠𑆡𑆳𑇆𑇒𑇓𑇆
𑆩𑆡𑇀𑆪𑆩𑆤𑇀𑆡𑆤(𑆑)𑆩𑆤𑇀𑆡𑆳𑆤𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆨𑆮𑆂𑇅 𑆪𑆶𑆑𑇀𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆳 𑆖𑆠𑆶𑆰𑇀𑆥𑆳𑆢𑆱𑆩𑇀𑆥𑆢𑇀𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆧𑆫𑇀𑆲𑆟𑆵𑇆𑇒𑇔𑇆
𑆧𑆶𑆢𑇀𑆣𑆴𑆂 𑆥𑆯𑇀𑆪𑆠𑆴 𑆪𑆳 𑆨𑆳𑆮𑆳𑆤𑇀 𑆧𑆲𑆶𑆑𑆳𑆫𑆟𑆪𑆾𑆓𑆘𑆳𑆤𑇀𑇅 𑆪𑆶𑆑𑇀𑆠𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆑𑆳𑆬𑆳 𑆱𑆳 𑆘𑇀𑆚𑆼𑆪𑆳 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆓𑆂 𑆱𑆳𑆣𑇀𑆪𑆠𑆼 𑆪𑆪𑆳𑇆𑇒𑇕𑇆
𑆍𑆰𑆳 𑆥𑆫𑆵𑆑𑇀𑆰𑆳 𑆤𑆳𑆱𑇀𑆠𑇀𑆪𑆤𑇀𑆪𑆳 𑆪𑆪𑆳 𑆱𑆫𑇀𑆮𑆁 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇅 𑆥𑆫𑆵𑆑𑇀𑆰𑇀𑆪𑆁 𑆱𑆢𑆱𑆖𑇀𑆖𑆽𑆮𑆁 𑆠𑆪𑆳 𑆖𑆳𑆱𑇀𑆠𑆴 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆂𑇆𑇒𑇖𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑇀𑆠𑆳𑆓𑆩𑆱𑇀𑆠𑆳𑆮𑆢𑇀𑆮𑆼𑆢𑆂 , 𑆪𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆾𑇁𑆥𑆴 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆮𑆼𑆢𑆳𑆫𑇀𑆡𑆳𑆢𑆮𑆴𑆥𑆫𑆵𑆠𑆂 𑆥𑆫𑆵𑆑𑇀𑆰𑆑𑆽𑆂 𑆥𑇀𑆫𑆟𑆵𑆠𑆂 𑆯𑆴𑆰𑇀𑆛𑆳𑆤𑆶𑆩𑆠𑆾 𑆬𑆾𑆑𑆳𑆤𑆶𑆓𑇀𑆫𑆲𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆂 𑆯𑆳𑆱𑇀𑆠𑇀𑆫𑆮𑆳𑆢𑆂, 𑆱 𑆖𑆳𑇁𑇁𑆥𑇀𑆠𑆳𑆓𑆩𑆂; 𑆄𑆥𑇀𑆠𑆳𑆓𑆩𑆳𑆢𑆶𑆥𑆬𑆨𑇀𑆪𑆠𑆼𑆢𑆳𑆤𑆠𑆥𑆾𑆪𑆘𑇀𑆚𑆱𑆠𑇀𑆪𑆳𑆲𑆴𑆁𑆱𑆳𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆳𑆟𑇀𑆪𑆨𑇀𑆪𑆶𑆢𑆪𑆤𑆴𑆂𑆯𑇀𑆫𑆼𑆪𑆱𑆑𑆫𑆳𑆟𑆵𑆠𑆴𑇆𑇒𑇗𑇆
𑆤 𑆖𑆳𑆤𑆠𑆴𑆮𑆸𑆠𑇀𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆢𑆾𑆰𑆳𑆟𑆳𑆩𑆢𑆾𑆰𑆽𑆫𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆾 𑆣𑆫𑇀𑆩𑆢𑇀𑆮𑆳𑆫𑆼𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇆𑇒𑇘𑇆
𑆣𑆫𑇀𑆩𑆢𑇀𑆮𑆳𑆫𑆳𑆮𑆲𑆴𑆠𑆽𑆯𑇀𑆖 𑆮𑇀𑆪𑆥𑆓𑆠𑆨𑆪𑆫𑆳𑆓𑆢𑇀𑆮𑆼𑆰𑆬𑆾𑆨𑆩𑆾𑆲𑆩𑆳𑆤𑆽𑆫𑇀𑆧𑇀𑆫𑆲𑇀𑆩𑆥𑆫𑆽𑆫𑆳𑆥𑇀𑆠𑆽𑆂 𑆑𑆫𑇀𑆩𑆮𑆴𑆢𑇀𑆨𑆴𑆫𑆤𑆶𑆥𑆲𑆠𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆖𑆳𑆫𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆽𑆂 𑆥𑆷𑆫𑇀𑆮𑆠𑆫𑆽𑆫𑇀𑆩𑆲𑆫𑇀𑆰𑆴𑆨𑆴𑆫𑇀𑆢𑆴𑆮𑇀𑆪𑆖𑆑𑇀𑆰𑆶𑆨𑆴𑆫𑇀𑆢𑆸𑆰𑇀𑆛𑇀𑆮𑆾𑆥𑆢𑆴𑆰𑇀𑆛𑆂 𑆥𑆶𑆤𑆫𑇀𑆨𑆮 𑆅𑆠𑆴 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆢𑆼𑆮𑆩𑇀 𑇆𑇒𑇙𑇆
𑆥𑇀𑆫𑆠𑇀𑆪𑆑𑇀𑆰𑆩𑆥𑆴 𑆖𑆾𑆥𑆬𑆨𑇀𑆪𑆠𑆼- 𑆩𑆳𑆠𑆳𑆥𑆴𑆠𑇀𑆫𑆾𑆫𑇀𑆮𑆴𑆱𑆢𑆸𑆯𑆳𑆤𑇀𑆪𑆥𑆠𑇀𑆪𑆳𑆤𑆴, 𑆠𑆶𑆬𑇀𑆪𑆱𑆩𑇀𑆨𑆮𑆳𑆤𑆳𑆁 𑆮𑆫𑇀𑆟𑆱𑇀𑆮𑆫𑆳𑆑𑆸𑆠𑆴𑆱𑆠𑇀𑆠𑇀𑆮𑆧𑆶𑆢𑇀𑆣𑆴𑆨𑆳𑆓𑇀𑆪𑆮𑆴𑆯𑆼𑆰𑆳𑆂, 𑆥𑇀𑆫𑆮𑆫𑆳𑆮𑆫𑆑𑆶𑆬𑆘𑆤𑇀𑆩, 𑆢𑆳𑆱𑇀𑆪𑆽𑆯𑇀𑆮𑆫𑇀𑆪𑆁, 𑆱𑆶𑆒𑆳𑆱𑆶𑆒𑆩𑆳𑆪𑆶𑆂, 𑆄𑆪𑆶𑆰𑆾 𑆮𑆽𑆰𑆩𑇀𑆪𑆩𑇀, 𑆅𑆲 𑆑𑆸𑆠𑆱𑇀𑆪𑆳𑆮𑆳𑆥𑇀𑆠𑆴𑆂, 𑆃𑆯𑆴𑆑𑇀𑆰𑆴𑆠𑆳𑆤𑆳𑆁 𑆖 𑆫𑆶𑆢𑆴𑆠𑆱𑇀𑆠𑆤𑆥𑆳𑆤𑆲𑆳𑆱𑆠𑇀𑆫𑆳𑆱𑆳𑆢𑆵𑆤𑆳𑆁 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂, 𑆬𑆑𑇀𑆰𑆟𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂, 𑆑𑆫𑇀𑆩𑆱𑆳𑆢𑆸𑆯𑇀𑆪𑆼 𑆦𑆬𑆮𑆴𑆯𑆼𑆰𑆂, 𑆩𑆼𑆣𑆳 𑆑𑇀𑆮𑆖𑆴𑆠𑇀 𑆑𑇀𑆮𑆖𑆴𑆠𑇀 𑆑𑆫𑇀𑆩𑆟𑇀𑆪𑆩𑆼𑆣𑆳, 𑆘𑆳𑆠𑆴𑆱𑇀𑆩𑆫𑆟𑆩𑇀- 𑆅𑆲𑆳𑆓𑆩𑆤𑆩𑆴𑆠𑆯𑇀𑆖𑇀𑆪𑆶𑆠𑆳𑆤𑆳𑆩𑆴𑆠𑆴 , 𑆱𑆩𑆢𑆫𑇀𑆯𑆤𑆼 𑆥𑇀𑆫𑆴𑆪𑆳𑆥𑇀𑆫𑆴𑆪𑆠𑇀𑆮𑆩𑇀𑇆𑇓𑇐𑇆
𑆃𑆠 𑆍𑆮𑆳𑆤𑆶𑆩𑆵𑆪𑆠𑆼- 𑆪𑆠𑇀- 𑆱𑇀𑆮𑆑𑆸𑆠𑆩𑆥𑆫𑆴𑆲𑆳𑆫𑇀𑆪𑆩𑆮𑆴𑆤𑆳𑆯𑆴 𑆥𑆿𑆫𑇀𑆮𑆢𑆼𑆲𑆴𑆑𑆁 𑆢𑆽𑆮𑆱𑆚𑇀𑆘𑇀𑆚𑆑𑆩𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆴𑆑𑆁 𑆑𑆫𑇀𑆩, 𑆠𑆱𑇀𑆪𑆽𑆠𑆠𑇀 𑆦𑆬𑆩𑇀; 𑆅𑆠𑆯𑇀𑆖𑆳𑆤𑇀𑆪𑆢𑇀𑆨𑆮𑆴𑆰𑇀𑆪𑆠𑆵𑆠𑆴; 𑆦𑆬𑆢𑇀𑆧𑆵𑆘𑆩𑆤𑆶𑆩𑆵𑆪𑆠𑆼, 𑆦𑆬𑆁 𑆖 𑆧𑆵𑆘𑆳𑆠𑇀𑇆𑇓𑇑𑇆
𑆪𑆶𑆑𑇀𑆠𑆴𑆯𑇀𑆖𑆽𑆰𑆳- 𑆰𑆝𑇀𑆣𑆳𑆠𑆶𑆱𑆩𑆶𑆢𑆪𑆳𑆢𑇀𑆓𑆫𑇀𑆨𑆘𑆤𑇀𑆩, 𑆑𑆫𑇀𑆠𑆸𑆑𑆫𑆟𑆱𑆁𑆪𑆾𑆓𑆳𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳; 𑆑𑆸𑆠𑆱𑇀𑆪 𑆑𑆫𑇀𑆩𑆟𑆂 𑆦𑆬𑆁 𑆤𑆳𑆑𑆸𑆠𑆱𑇀𑆪, 𑆤𑆳𑆕𑇀𑆑𑆶𑆫𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆫𑆧𑆵𑆘𑆳𑆠𑇀; 𑆑𑆫𑇀𑆩𑆱𑆢𑆸𑆯𑆁 𑆦𑆬𑆁, 𑆤𑆳𑆤𑇀𑆪𑆱𑇀𑆩𑆳𑆢𑇀𑆧𑆵𑆘𑆳𑆢𑆤𑇀𑆪𑆱𑇀𑆪𑆾𑆠𑇀𑆥𑆠𑇀𑆠𑆴𑆂; 𑆅𑆠𑆴 𑆪𑆶𑆑𑇀𑆠𑆴𑆂𑇆𑇓𑇒𑇆
𑆍𑆮𑆁 𑆥𑇀𑆫𑆩𑆳𑆟𑆽𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆨𑆴𑆫𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆼 𑆥𑆶𑆤𑆫𑇀𑆨𑆮𑆼 𑆣𑆫𑇀𑆩𑆢𑇀𑆮𑆳𑆫𑆼𑆰𑇀𑆮𑆮𑆣𑆵𑆪𑆼𑆠; 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆓𑆶𑆫𑆶𑆯𑆶𑆯𑇀𑆫𑆷𑆰𑆳𑆪𑆳𑆩𑆣𑇀𑆪𑆪𑆤𑆼 𑆮𑇀𑆫𑆠𑆖𑆫𑇀𑆪𑆳𑆪𑆳𑆁 𑆢𑆳𑆫𑆑𑇀𑆫𑆴𑆪𑆳𑆪𑆳𑆩𑆥𑆠𑇀𑆪𑆾𑆠𑇀𑆥𑆳𑆢𑆤𑆼 𑆨𑆸𑆠𑇀𑆪𑆨𑆫𑆟𑆼𑇁𑆠𑆴𑆡𑆴𑆥𑆷𑆘𑆳𑆪𑆳𑆁 𑆢𑆳𑆤𑆼𑇁𑆤𑆨𑆴𑆣𑇀𑆪𑆳𑆪𑆳𑆁 𑆠𑆥𑆱𑇀𑆪𑆤𑆱𑆷𑆪𑆳𑆪𑆳𑆁 𑆢𑆼𑆲𑆮𑆳𑆕𑇀𑆩𑆳𑆤𑆱𑆼 𑆑𑆫𑇀𑆩𑆟𑇀𑆪𑆑𑇀𑆬𑆴𑆰𑇀𑆛𑆼 𑆢𑆼𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆾𑆫𑇀𑆡𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳𑆠𑇀𑆩𑆥𑆫𑆵𑆑𑇀𑆰𑆳𑆪𑆳𑆁 𑆩𑆤𑆂𑆱𑆩𑆳𑆣𑆳𑆮𑆴𑆠𑆴; 𑆪𑆳𑆤𑆴 𑆖𑆳𑆤𑇀𑆪𑆳𑆤𑇀𑆪𑆥𑇀𑆪𑆼𑆮𑆁𑆮𑆴𑆣𑆳𑆤𑆴 𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆱𑆠𑆳𑆩𑆮𑆴𑆓𑆫𑇀𑆲𑆴𑆠𑆳𑆤𑆴 𑆱𑇀𑆮𑆫𑇀𑆓𑇀𑆪𑆳𑆟𑆴 𑆮𑆸𑆠𑇀𑆠𑆴𑆥𑆶𑆰𑇀𑆛𑆴𑆑𑆫𑆳𑆟𑆴 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑆠𑆳𑆤𑇀𑆪𑆳𑆫𑆨𑆼𑆠 𑆑𑆫𑇀𑆠𑆶𑆁; 𑆠𑆡𑆳 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆤𑆴𑆲 𑆖𑆽𑆮 𑆪𑆯𑆾 𑆬𑆨𑆠𑆼 𑆥𑇀𑆫𑆼𑆠𑇀𑆪 𑆖 𑆱𑇀𑆮𑆫𑇀𑆓𑆩𑇀𑇅 𑆅𑆠𑆴 𑆠𑆸𑆠𑆵𑆪𑆳 𑆥𑆫𑆬𑆾𑆑𑆽𑆰𑆟𑆳 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆠𑆳 𑆨𑆮𑆠𑆴𑇆𑇓𑇓𑇆
𑆃𑆡 𑆒𑆬𑆶 𑆠𑇀𑆫𑆪 𑆇𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆂, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆧𑆬𑆁, 𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆴, 𑆠𑇀𑆫𑆪𑆾 𑆫𑆾𑆓𑆳𑆂, 𑆠𑇀𑆫𑆪𑆾 𑆫𑆾𑆓𑆩𑆳𑆫𑇀𑆓𑆳𑆂, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆨𑆴𑆰𑆘𑆂, 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆿𑆰𑆣𑆩𑆴𑆠𑆴𑇆𑇓𑇔𑇆
𑆠𑇀𑆫𑆪 𑆇𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆳 𑆅𑆠𑆴- 𑆄𑆲𑆳𑆫𑆂, 𑆱𑇀𑆮𑆥𑇀𑆤𑆾, 𑆧𑇀𑆫𑆲𑇀𑆩𑆖𑆫𑇀𑆪𑆩𑆴𑆠𑆴; 𑆍𑆨𑆴𑆱𑇀𑆠𑇀𑆫𑆴𑆨𑆴𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆴𑆪𑆶𑆑𑇀𑆠𑆽𑆫𑆶𑆥𑆱𑇀𑆠𑆧𑇀𑆣𑆩𑆶𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆽𑆂 𑆯𑆫𑆵𑆫𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆾𑆥𑆖𑆪𑆾𑆥𑆖𑆴𑆠𑆩𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼 𑆪𑆳𑆮𑆢𑆳𑆪𑆶𑆂𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆳𑆠𑇀 𑆱𑆁𑆱𑇀𑆑𑆳𑆫𑆩𑆲𑆴𑆠𑆩𑆤𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 , 𑆪 𑆅𑆲𑆽𑆮𑆾𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼𑇆𑇓𑇕𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆁 𑆧𑆬𑆩𑆴𑆠𑆴- 𑆱𑆲𑆘𑆁, 𑆑𑆳𑆬𑆘𑆁, 𑆪𑆶𑆑𑇀𑆠𑆴𑆑𑆸𑆠𑆁 𑆖𑇅 𑆱𑆲𑆘𑆁 𑆪𑆖𑇀𑆗𑆫𑆵𑆫𑆱𑆠𑇀𑆠𑇀𑆮𑆪𑆾𑆂 𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆁, 𑆑𑆳𑆬𑆑𑆸𑆠𑆩𑆸𑆠𑆶𑆮𑆴𑆨𑆳𑆓𑆘𑆁 𑆮𑆪𑆂𑆑𑆸𑆠𑆁 𑆖, 𑆪𑆶𑆑𑇀𑆠𑆴𑆑𑆸𑆠𑆁 𑆥𑆶𑆤𑆱𑇀𑆠𑆢𑇀𑆪𑆢𑆳𑆲𑆳𑆫𑆖𑆼𑆰𑇀𑆛𑆳𑆪𑆾𑆓𑆘𑆩𑇀𑇆𑇓𑇖𑇆
𑆠𑇀𑆫𑆵𑆟𑇀𑆪𑆳𑆪𑆠𑆤𑆳𑆤𑆵𑆠𑆴- 𑆃𑆫𑇀𑆡𑆳𑆤𑆳𑆁 𑆑𑆫𑇀𑆩𑆟𑆂 𑆑𑆳𑆬𑆱𑇀𑆪 𑆖𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆳𑆂𑇅 𑆠𑆠𑇀𑆫𑆳𑆠𑆴𑆥𑇀𑆫𑆨𑆳𑆮𑆠𑆳𑆁 𑆢𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆢𑆫𑇀𑆯𑆤𑆩𑆠𑆴𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆢𑆫𑇀𑆯𑆤𑆩𑆪𑆾𑆓𑆂, 𑆃𑆠𑆴𑆯𑇀𑆬𑆴𑆰𑇀𑆛𑆳𑆠𑆴𑆮𑆴𑆥𑇀𑆫𑆑𑆸𑆰𑇀𑆛𑆫𑆿𑆢𑇀𑆫𑆨𑆽𑆫𑆮𑆳𑆢𑇀𑆨𑆶𑆠𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆧𑆵𑆨𑆠𑇀𑆱𑆤𑆮𑆴𑆑𑆸𑆠𑆮𑆴𑆠𑇀𑆫𑆳𑆱𑆤𑆳𑆢𑆴𑆫𑆷𑆥𑆢𑆫𑇀𑆯𑆤𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂; 𑆠𑆡𑆳𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆠𑆤𑆴𑆠𑆥𑆛𑆲𑆾𑆠𑇀𑆑𑇀𑆫𑆶𑆰𑇀𑆛𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆧𑇀𑆢𑆳𑆤𑆳𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆯𑇀𑆫𑆮𑆟𑆩𑆠𑆴𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆯𑇀𑆫𑆮𑆟𑆩𑆪𑆾𑆓𑆂, 𑆥𑆫𑆶𑆰𑆼𑆰𑇀𑆛𑆮𑆴𑆤𑆳𑆯𑆾𑆥𑆔𑆳𑆠𑆥𑇀𑆫𑆣𑆫𑇀𑆰𑆟𑆨𑆵𑆰𑆟𑆳𑆢𑆴𑆯𑆧𑇀𑆢𑆯𑇀𑆫𑆮𑆟𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂; 𑆠𑆡𑆳𑇁𑆠𑆴𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾𑆓𑇀𑆫𑆳𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆴𑆤𑆳𑆁 𑆓𑆤𑇀𑆣𑆳𑆤𑆳𑆩𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆁 𑆔𑇀𑆫𑆳𑆟𑆩𑆠𑆴𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆔𑇀𑆫𑆳𑆟𑆩𑆪𑆾𑆓𑆂, 𑆥𑆷𑆠𑆴𑆢𑇀𑆮𑆴𑆰𑇀𑆛𑆳𑆩𑆼𑆣𑇀𑆪𑆑𑇀𑆬𑆴𑆤𑇀𑆤𑆮𑆴𑆰𑆥𑆮𑆤𑆑𑆶𑆟𑆥𑆓𑆤𑇀𑆣𑆳𑆢𑆴𑆔𑇀𑆫𑆳𑆟𑆁 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂; 𑆠𑆡𑆳 𑆫𑆱𑆳𑆤𑆳𑆩𑆠𑇀𑆪𑆳𑆢𑆳𑆤𑆩𑆠𑆴𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆤𑆳𑆢𑆳𑆤𑆩𑆪𑆾𑆓𑆂, 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆾 𑆫𑆳𑆯𑆴𑆮𑆫𑇀𑆘𑇀𑆪𑆼𑆰𑇀𑆮𑆳𑆲𑆳𑆫𑆮𑆴𑆣𑆴𑆮𑆴𑆯𑆼𑆰𑆳𑆪𑆠𑆤𑆼𑆰𑆷𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆠𑆼; 𑆠𑆡𑆳𑇁𑆠𑆴𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆳𑆤𑆳𑆁 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆁 𑆱𑇀𑆤𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆾𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆖𑆳𑆠𑇀𑆪𑆶𑆥𑆱𑆼𑆮𑆤𑆩𑆠𑆴𑆪𑆾𑆓𑆂, 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆤𑆶𑆥𑆱𑆼𑆮𑆤𑆩𑆪𑆾𑆓𑆂, 𑆱𑇀𑆤𑆳𑆤𑆳𑆢𑆵𑆤𑆳𑆁 𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑆱𑇀𑆥𑆸𑆯𑇀𑆪𑆳𑆤𑆳𑆩𑆤𑆳𑆤𑆶𑆥𑆷𑆫𑇀𑆮𑇀𑆪𑆾𑆥𑆱𑆼𑆮𑆤𑆁 𑆮𑆴𑆰𑆩𑆱𑇀𑆡𑆳𑆤𑆳𑆨𑆴𑆔𑆳𑆠𑆳𑆯𑆶𑆖𑆴𑆨𑆷𑆠𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆢𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂𑇆𑇓𑇗𑇆
𑆠𑆠𑇀𑆫𑆽𑆑𑆁 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆮𑇀𑆪𑆳𑆥𑆑𑆁 , 𑆖𑆼𑆠𑆂- 𑆱𑆩𑆮𑆳𑆪𑆴, 𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆮𑇀𑆪𑆳𑆥𑇀𑆠𑆼𑆫𑇀𑆮𑇀𑆪𑆳𑆥𑆑𑆩𑆥𑆴 𑆖 𑆖𑆼𑆠𑆂; 𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆱𑆫𑇀𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆮𑇀𑆪𑆳𑆥𑆑𑆱𑇀𑆥𑆫𑇀𑆯𑆑𑆸𑆠𑆾 𑆪𑆾 𑆨𑆳𑆮𑆮𑆴𑆯𑆼𑆰𑆂, 𑆱𑆾𑇁𑆪𑆩𑆤𑆶𑆥𑆯𑆪𑆳𑆠𑇀 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆾 𑆨𑆮𑆠𑇀𑆪𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆂; 𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆫𑇀𑆡𑆾 𑆲𑇀𑆪𑆶𑆥𑆯𑆪𑆳𑆫𑇀𑆡𑆂𑇆𑇓𑇘𑇆
𑆑𑆫𑇀𑆩 𑆮𑆳𑆕𑇀𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆂𑇅 𑆠𑆠𑇀𑆫 𑆮𑆳𑆕𑇀𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆳𑆠𑆴𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆠𑆴𑆪𑆾𑆓𑆂; 𑆱𑆫𑇀𑆮𑆯𑆾𑇁𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆪𑆾𑆓𑆂; 𑆮𑆼𑆓𑆣𑆳𑆫𑆟𑆾𑆢𑆵𑆫𑆟𑆮𑆴𑆰𑆩𑆱𑇀𑆒𑆬𑆤𑆥𑆠𑆤𑆳𑆕𑇀𑆓𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆳𑆕𑇀𑆓𑆥𑇀𑆫𑆢𑆷𑆰𑆟𑆥𑇀𑆫𑆲𑆳𑆫𑆩𑆫𑇀𑆢𑆤𑆥𑇀𑆫𑆳𑆟𑆾𑆥𑆫𑆾𑆣𑆱𑆕𑇀𑆑𑇀𑆬𑆼𑆯𑆤𑆳𑆢𑆴𑆂 𑆯𑆳𑆫𑆵𑆫𑆾 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂, 𑆱𑆷𑆖𑆑𑆳𑆤𑆸𑆠𑆳𑆑𑆳𑆬𑆑𑆬𑆲𑆳𑆥𑇀𑆫𑆴𑆪𑆳𑆧𑆢𑇀𑆣𑆳𑆤𑆶𑆥𑆖𑆳𑆫𑆥𑆫𑆶𑆰𑆮𑆖𑆤𑆳𑆢𑆴𑆫𑇀𑆮𑆳𑆕𑇀𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂, 𑆨𑆪𑆯𑆾𑆑𑆑𑇀𑆫𑆾𑆣𑆬𑆾𑆨𑆩𑆾𑆲𑆩𑆳𑆤𑆼𑆫𑇀𑆰𑇀𑆪𑆳𑆩𑆴𑆡𑇀𑆪𑆳𑆢𑆫𑇀𑆯𑆤𑆳𑆢𑆴𑆫𑇀𑆩𑆳𑆤𑆱𑆾 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂𑇆𑇓𑇙𑇆
𑆱𑆕𑇀𑆓𑇀𑆫𑆲𑆼𑆟 𑆖𑆳𑆠𑆴𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆮𑆫𑇀𑆘𑆁 𑆑𑆫𑇀𑆩 𑆮𑆳𑆕𑇀𑆩𑆤𑆂𑆯𑆫𑆵𑆫𑆘𑆩𑆲𑆴𑆠𑆩𑆤𑆶𑆥𑆢𑆴𑆰𑇀𑆛𑆁 𑆪𑆠𑇀𑆠𑆖𑇀𑆖 𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆁 𑆮𑆴𑆢𑇀𑆪𑆳𑆠𑇀𑇆𑇔𑇐𑇆
𑆅𑆠𑆴 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆁 𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆼𑆮 𑆑𑆫𑇀𑆩 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣 𑆅𑆠𑆴 𑆮𑇀𑆪𑆮𑆱𑇀𑆪𑆼𑆠𑇀𑇆𑇔𑇑𑇆
𑆯𑆵𑆠𑆾𑆰𑇀𑆟𑆮𑆫𑇀𑆰𑆬𑆑𑇀𑆰𑆟𑆳𑆂 𑆥𑆶𑆤𑆫𑇀𑆲𑆼𑆩𑆤𑇀𑆠𑆓𑇀𑆫𑆵𑆰𑇀𑆩𑆮𑆫𑇀𑆰𑆳𑆂 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆂, 𑆱 𑆑𑆳𑆬𑆂𑇅 𑆠𑆠𑇀𑆫𑆳𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆂 𑆑𑆳𑆬𑆂 𑆑𑆳𑆬𑆳𑆠𑆴𑆪𑆾𑆓𑆂, 𑆲𑆵𑆤𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆂 (𑆑𑆳𑆬𑆂) 𑆑𑆳𑆬𑆳𑆪𑆾𑆓𑆂, 𑆪𑆡𑆳𑆱𑇀𑆮𑆬𑆑𑇀𑆰𑆟𑆮𑆴𑆥𑆫𑆵𑆠𑆬𑆑𑇀𑆰𑆟𑆱𑇀𑆠𑆶 (𑆑𑆳𑆬𑆂) 𑆑𑆳𑆬𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆂𑇅 𑆑𑆳𑆬𑆂 𑆥𑆶𑆤𑆂 𑆥𑆫𑆴𑆟𑆳𑆩 𑆇𑆖𑇀𑆪𑆠𑆼𑇆𑇔𑇒𑇆
𑆅𑆠𑇀𑆪𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆫𑇀𑆡𑆱𑆁𑆪𑆾𑆓𑆂, 𑆥𑇀𑆫𑆘𑇀𑆚𑆳𑆥𑆫𑆳𑆣𑆂, 𑆥𑆫𑆴𑆟𑆳𑆩𑆯𑇀𑆖𑆼𑆠𑆴 𑆠𑇀𑆫𑆪𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆮𑆴𑆑𑆬𑇀𑆥𑆳 𑆲𑆼𑆠𑆮𑆾 𑆮𑆴𑆑𑆳𑆫𑆳𑆟𑆳𑆁; 𑆱𑆩𑆪𑆾𑆓𑆪𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑆶 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆲𑆼𑆠𑆮𑆾 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇓𑇆
𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆩𑆼𑆮 𑆨𑆳𑆮𑆳𑆤𑆳𑆁 𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆿 𑆤𑆳𑆤𑇀𑆠𑆫𑆼𑆟 𑆪𑆾𑆓𑆳𑆪𑆾𑆓𑆳𑆠𑆴𑆪𑆾𑆓𑆩𑆴𑆡𑇀𑆪𑆳𑆪𑆾𑆓𑆳𑆤𑇀 𑆱𑆩𑆶𑆥𑆬𑆨𑇀𑆪𑆼𑆠𑆼; 𑆪𑆡𑆳𑆱𑇀𑆮𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆥𑆼𑆑𑇀𑆰𑆴𑆟𑆿 𑆲𑆴 𑆨𑆳𑆮𑆳𑆨𑆳𑆮𑆿𑇆𑇔𑇔𑇆
𑆠𑇀𑆫𑆪𑆾 𑆫𑆾𑆓𑆳 𑆅𑆠𑆴- 𑆤𑆴𑆘𑆳𑆓𑆤𑇀𑆠𑆶𑆩𑆳𑆤𑆱𑆳𑆂𑇅 𑆠𑆠𑇀𑆫 𑆤𑆴𑆘𑆂 𑆯𑆳𑆫𑆵𑆫𑆢𑆾𑆰𑆱𑆩𑆶𑆠𑇀𑆡𑆂, 𑆄𑆓𑆤𑇀𑆠𑆶𑆫𑇀𑆨𑆷𑆠𑆮𑆴𑆰𑆮𑆳𑆪𑇀𑆮𑆓𑇀𑆤𑆴𑆱𑆩𑇀𑆥𑇀𑆫𑆲𑆳𑆫𑆳𑆢𑆴𑆱𑆩𑆶𑆠𑇀𑆡𑆂, 𑆩𑆳𑆤𑆱𑆂 𑆥𑆶𑆤𑆫𑆴𑆰𑇀𑆛𑆱𑇀𑆪 𑆬𑆳𑆨𑆳𑆬𑇀𑆬𑆳𑆨𑆳𑆖𑇀𑆖𑆳𑆤𑆴𑆰𑇀𑆛𑆱𑇀𑆪𑆾𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇔𑇕𑇆
𑆠𑆠𑇀𑆫 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆠𑆳 𑆩𑆳𑆤𑆱𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆫𑆵𑆠𑆼𑆤𑆳𑆥𑆴 𑆱𑆠𑆳 𑆧𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆩𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆮𑆼𑆑𑇀𑆰𑇀𑆪 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆳𑆤𑆳𑆩𑆲𑆴𑆠𑆳𑆤𑆳𑆩𑆤𑆶𑆥𑆱𑆼𑆮𑆤𑆼 𑆲𑆴𑆠𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆱𑆼𑆮𑆤𑆼 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆁, 𑆤 𑆲𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆬𑆾𑆑𑆼 𑆠𑇀𑆫𑆪𑆩𑆼𑆠𑆤𑇀𑆩𑆳𑆤𑆱𑆁 𑆑𑆴𑆚𑇀𑆖𑆴𑆤𑇀𑆤𑆴𑆰𑇀𑆥𑆢𑇀𑆪𑆠𑆼 𑆱𑆶𑆒𑆁 𑆮𑆳 𑆢𑆶𑆂𑆒𑆁 𑆮𑆳; 𑆠𑆱𑇀𑆩𑆳𑆢𑆼𑆠𑆖𑇀𑆖𑆳𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆁- 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆳𑆤𑆳𑆁 𑆖𑆾𑆥𑆱𑆼𑆮𑆤𑆼 𑆥𑇀𑆫𑆪𑆠𑆴𑆠𑆮𑇀𑆪𑆩𑇀, 𑆄𑆠𑇀𑆩𑆢𑆼𑆯𑆑𑆶𑆬𑆑𑆳𑆬𑆧𑆬𑆯𑆑𑇀𑆠𑆴𑆘𑇀𑆚𑆳𑆤𑆼 𑆪𑆡𑆳𑆮𑆖𑇀𑆖𑆼𑆠𑆴𑇆𑇔𑇖𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆩𑆳𑆤𑆱𑆁 𑆥𑇀𑆫𑆠𑆴 𑆨𑆽𑆰𑆘𑇀𑆪𑆁 𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆓𑆱𑇀𑆪𑆳𑆤𑇀𑆮𑆮𑆼𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆠𑆢𑇀𑆮𑆴𑆢𑇀𑆪𑆱𑆼𑆮𑆳 𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆩𑆳𑆠𑇀𑆩𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑆱𑆫𑇀𑆮𑆯𑆂𑇆𑇔𑇗𑇆
𑆠𑇀𑆫𑆪𑆾 𑆫𑆾𑆓𑆩𑆳𑆫𑇀𑆓𑆳 𑆅𑆠𑆴- 𑆯𑆳𑆒𑆳, 𑆩𑆫𑇀𑆩𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆪𑆂, 𑆑𑆾𑆰𑇀𑆜𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆯𑆳𑆒𑆳 𑆫𑆑𑇀𑆠𑆳𑆢𑆪𑆾 𑆣𑆳𑆠𑆮𑆱𑇀𑆠𑇀𑆮𑆑𑇀 𑆖, 𑆱 𑆧𑆳𑆲𑇀𑆪𑆾 𑆫𑆾𑆓𑆩𑆳𑆫𑇀𑆓𑆂; 𑆩𑆫𑇀𑆩𑆳𑆟𑆴 𑆥𑆶𑆤𑆫𑇀𑆧𑆱𑇀𑆠𑆴𑆲𑆸𑆢𑆪𑆩𑆷𑆫𑇀𑆣𑆳𑆢𑆵𑆤𑆴, 𑆃𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆪𑆾𑇁𑆱𑇀𑆡𑆴𑆱𑆁𑆪𑆾𑆓𑆳𑆱𑇀𑆠𑆠𑇀𑆫𑆾𑆥𑆤𑆴𑆧𑆢𑇀𑆣𑆳𑆯𑇀𑆖 𑆱𑇀𑆤𑆳𑆪𑆶𑆑𑆟𑇀𑆝𑆫𑆳𑆂 , 𑆱 𑆩𑆣𑇀𑆪𑆩𑆾 𑆫𑆾𑆓𑆩𑆳𑆫𑇀𑆓𑆂; 𑆑𑆾𑆰𑇀𑆜𑆂 𑆥𑆶𑆤𑆫𑆶𑆖𑇀𑆪𑆠𑆼 𑆩𑆲𑆳𑆱𑇀𑆫𑆾𑆠𑆂 𑆯𑆫𑆵𑆫𑆩𑆣𑇀𑆪𑆁 𑆩𑆲𑆳𑆤𑆴𑆩𑇀𑆤𑆩𑆳𑆩𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆯𑇀𑆖𑆼𑆠𑆴 𑆥𑆫𑇀𑆪𑆳𑆪𑆯𑆧𑇀𑆢𑆽𑆱𑇀𑆠𑆤𑇀𑆠𑇀𑆫𑆼, 𑆱 𑆫𑆾𑆓𑆩𑆳𑆫𑇀𑆓 𑆄𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆂𑇆𑇔𑇘𑇆
𑆠𑆠𑇀𑆫, 𑆓𑆟𑇀𑆝𑆥𑆴𑆝𑆑𑆳𑆬𑆘𑇀𑆪𑆥𑆖𑆵𑆖𑆫𑇀𑆩𑆑𑆵𑆬𑆳𑆣𑆴𑆩𑆳𑆁𑆱𑆩𑆰𑆑𑆑𑆶𑆰𑇀𑆜𑆮𑇀𑆪𑆕𑇀𑆓𑆳𑆢𑆪𑆾 𑆮𑆴𑆑𑆳𑆫𑆳 𑆧𑆲𑆴𑆫𑇀𑆩𑆳𑆫𑇀𑆓𑆘𑆳𑆯𑇀𑆖 𑆮𑆴𑆱𑆫𑇀𑆥𑆯𑇀𑆮𑆪𑆡𑆶𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆾𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆳𑆢𑆪𑆂 𑆯𑆳𑆒𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆂; 𑆥𑆑𑇀𑆰𑆮𑆣𑆓𑇀𑆫𑆲𑆳𑆥𑆠𑆳𑆤𑆑𑆳𑆫𑇀𑆢𑆴𑆠𑆯𑆾𑆰𑆫𑆳𑆘𑆪𑆑𑇀𑆰𑇀𑆩𑆳𑆱𑇀𑆡𑆴𑆱𑆤𑇀𑆣𑆴𑆯𑆷𑆬𑆓𑆶𑆢𑆨𑇀𑆫𑆁𑆯𑆳𑆢𑆪𑆂 𑆯𑆴𑆫𑆾𑆲𑆸𑆢𑇀𑆧𑆱𑇀𑆠𑆴𑆫𑆾𑆓𑆳𑆢𑆪𑆯𑇀𑆖 𑆩𑆣𑇀𑆪𑆩𑆩𑆳𑆫𑇀𑆓𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆂; 𑆘𑇀𑆮𑆫𑆳𑆠𑆵𑆱𑆳𑆫𑆖𑇀𑆗𑆫𑇀𑆢𑇀𑆪𑆬𑆱𑆑𑆮𑆴𑆱𑆷𑆖𑆴𑆑𑆳𑆑𑆳𑆱𑆯𑇀𑆮𑆳𑆱𑆲𑆴𑆑𑇀𑆑𑆳𑆤𑆳𑆲𑆾𑆢𑆫𑆥𑇀𑆬𑆵𑆲𑆳𑆢𑆪𑆾𑇁𑆤𑇀𑆠𑆫𑇀𑆩𑆳𑆫𑇀𑆓𑆘𑆳𑆯𑇀𑆖 𑆮𑆴𑆱𑆫𑇀𑆥𑆯𑇀𑆮𑆪𑆡𑆶𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆾𑆮𑆴𑆢𑇀𑆫𑆣𑇀𑆪𑆳𑆢𑆪𑆂 𑆑𑆾𑆰𑇀𑆜𑆳𑆤𑆶𑆱𑆳𑆫𑆴𑆟𑆾 𑆨𑆮𑆤𑇀𑆠𑆴 𑆫𑆾𑆓𑆳𑆂𑇆𑇔𑇙𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆨𑆴𑆰𑆘 𑆅𑆠𑆴- 𑆨𑆴𑆰𑆑𑇀𑆗𑆢𑇀𑆩𑆖𑆫𑆳𑆂 𑆱𑆤𑇀𑆠𑆴 𑆱𑆤𑇀𑆠𑇀𑆪𑆼𑆑𑆼 𑆱𑆴𑆢𑇀𑆣𑆱𑆳𑆣𑆴𑆠𑆳𑆂𑇅 𑆱𑆤𑇀𑆠𑆴 𑆮𑆽𑆢𑇀𑆪𑆓𑆶𑆟𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆳 𑆨𑆴𑆰𑆘𑆾 𑆨𑆶𑆮𑆴𑇆𑇕𑇐𑇆
𑆮𑆽𑆢𑇀𑆪𑆨𑆳𑆟𑇀𑆝𑆿𑆰𑆣𑆽𑆂 𑆥𑆶𑆱𑇀𑆠𑆽𑆂 𑆥𑆬𑇀𑆬𑆮𑆽𑆫𑆮𑆬𑆾𑆑𑆤𑆽𑆂𑇅 𑆬𑆨𑆤𑇀𑆠𑆼 𑆪𑆼 𑆨𑆴𑆰𑆑𑇀𑆯𑆧𑇀𑆢𑆩𑆘𑇀𑆚𑆳𑆱𑇀𑆠𑆼 𑆥𑇀𑆫𑆠𑆴𑆫𑆷𑆥𑆑𑆳𑆂𑇆𑇕𑇑𑇆
𑆯𑇀𑆫𑆵𑆪𑆯𑆾𑆘𑇀𑆚𑆳𑆤𑆱𑆴𑆢𑇀𑆣𑆳𑆤𑆳𑆁 𑆮𑇀𑆪𑆥𑆢𑆼𑆯𑆳𑆢𑆠𑆢𑇀𑆮𑆴𑆣𑆳𑆂𑇅 𑆮𑆽𑆢𑇀𑆪𑆯𑆧𑇀𑆢𑆁 𑆬𑆨𑆤𑇀𑆠𑆼 𑆪𑆼 𑆘𑇀𑆚𑆼𑆪𑆳𑆱𑇀𑆠𑆼 𑆱𑆴𑆢𑇀𑆣𑆱𑆳𑆣𑆴𑆠𑆳𑆂𑇆𑇕𑇒𑇆
𑆥𑇀𑆫𑆪𑆾𑆓𑆘𑇀𑆚𑆳𑆤𑆮𑆴𑆘𑇀𑆚𑆳𑆤𑆱𑆴𑆢𑇀𑆣𑆴𑆱𑆴𑆢𑇀𑆣𑆳𑆂 𑆱𑆶𑆒𑆥𑇀𑆫𑆢𑆳𑆂𑇅 𑆘𑆵𑆮𑆴𑆠𑆳𑆨𑆴𑆱𑆫𑆳𑆱𑇀𑆠𑆼 𑆱𑇀𑆪𑆶𑆫𑇀𑆮𑆽𑆢𑇀𑆪𑆠𑇀𑆮𑆁 𑆠𑆼𑆰𑇀𑆮𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆴𑆠𑆴𑇆𑇕𑇓𑇆
𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆿𑆰𑆣𑆩𑆴𑆠𑆴- 𑆢𑆽𑆮𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁, 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁, 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆮𑆘𑆪𑆯𑇀𑆖𑇅 𑆠𑆠𑇀𑆫 𑆢𑆽𑆮𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁- 𑆩𑆤𑇀𑆠𑇀𑆫𑆿𑆰𑆣𑆴𑆩𑆟𑆴𑆩𑆕𑇀𑆓𑆬𑆧𑆬𑇀𑆪𑆶𑆥𑆲𑆳𑆫𑆲𑆾𑆩𑆤𑆴𑆪𑆩𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖𑆴𑆠𑇀𑆠𑆾𑆥𑆮𑆳𑆱𑆱𑇀𑆮𑆱𑇀𑆠𑇀𑆪𑆪𑆤𑆥𑇀𑆫𑆟𑆴𑆥𑆳𑆠𑆓𑆩𑆤𑆳𑆢𑆴, 𑆪𑆶𑆑𑇀𑆠𑆴𑆮𑇀𑆪𑆥𑆳𑆯𑇀𑆫𑆪𑆁- 𑆥𑆶𑆤𑆫𑆳𑆲𑆳𑆫𑆿𑆰𑆣𑆢𑇀𑆫𑆮𑇀𑆪𑆳𑆟𑆳𑆁 𑆪𑆾𑆘𑆤𑆳, 𑆱𑆠𑇀𑆠𑇀𑆮𑆳𑆮𑆘𑆪𑆂- 𑆥𑆶𑆤𑆫𑆲𑆴𑆠𑆼𑆨𑇀𑆪𑆾𑇁𑆫𑇀𑆡𑆼𑆨𑇀𑆪𑆾 𑆩𑆤𑆾𑆤𑆴𑆓𑇀𑆫𑆲𑆂𑇆𑇕𑇔𑇆
𑆯𑆫𑆵𑆫𑆢𑆾𑆰𑆥𑇀𑆫𑆑𑆾𑆥𑆼 𑆒𑆬𑆶 𑆯𑆫𑆵𑆫𑆩𑆼𑆮𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆥𑇀𑆫𑆳𑆪𑆯𑆱𑇀𑆠𑇀𑆫𑆴𑆮𑆴𑆣𑆩𑆿𑆰𑆣𑆩𑆴𑆖𑇀𑆗𑆤𑇀𑆠𑆴- 𑆃𑆤𑇀𑆠𑆂𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆤𑆁, 𑆧𑆲𑆴𑆂𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆤𑆁, 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆁 𑆖𑆼𑆠𑆴𑇅 𑆠𑆠𑇀𑆫𑆳𑆤𑇀𑆠𑆂𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆤𑆁 𑆪𑆢𑆤𑇀𑆠𑆂𑆯𑆫𑆵𑆫𑆩𑆤𑆶𑆥𑇀𑆫𑆮𑆴𑆯𑇀𑆪𑆿𑆰𑆣𑆩𑆳𑆲𑆳𑆫𑆘𑆳𑆠𑆮𑇀𑆪𑆳𑆣𑆵𑆤𑇀 𑆥𑇀𑆫𑆩𑆳𑆫𑇀𑆰𑇀𑆛𑆴, 𑆪𑆠𑇀𑆥𑆶𑆤𑆫𑇀𑆧𑆲𑆴𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆩𑆳𑆯𑇀𑆫𑆴𑆠𑇀𑆪𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆱𑇀𑆮𑆼𑆢𑆥𑇀𑆫𑆢𑆼𑆲𑆥𑆫𑆴𑆰𑆼𑆑𑆾𑆤𑇀𑆩𑆫𑇀𑆢𑆤𑆳𑆢𑇀𑆪𑆽𑆫𑆳𑆩𑆪𑆳𑆤𑇀 𑆥𑇀𑆫𑆩𑆳𑆫𑇀𑆰𑇀𑆛𑆴 𑆠𑆢𑇀𑆧𑆲𑆴𑆂𑆥𑆫𑆴𑆩𑆳𑆫𑇀𑆘𑆤𑆁, 𑆯𑆱𑇀𑆠𑇀𑆫𑆥𑇀𑆫𑆟𑆴𑆣𑆳𑆤𑆁 𑆥𑆶𑆤𑆯𑇀𑆗𑆼𑆢𑆤𑆨𑆼𑆢𑆤𑆮𑇀𑆪𑆣𑆤𑆢𑆳𑆫𑆟𑆬𑆼𑆒𑆤𑆾𑆠𑇀𑆥𑆳𑆛𑆤𑆥𑇀𑆫𑆖𑇀𑆗𑆤𑆱𑆵𑆮𑆤𑆽𑆰𑆟𑆑𑇀𑆰𑆳𑆫𑆘𑆬𑆿𑆑𑆱𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇕𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑇀𑆫𑆳𑆘𑇀𑆚𑆾 𑆫𑆾𑆓𑆼 𑆱𑆩𑆶𑆠𑇀𑆥𑆤𑇀𑆤𑆼 𑆧𑆳𑆲𑇀𑆪𑆼𑆤𑆳𑆨𑇀𑆪𑆤𑇀𑆠𑆫𑆼𑆟 𑆮𑆳𑇅 𑆑𑆫𑇀𑆩𑆟𑆳 𑆬𑆨𑆠𑆼 𑆯𑆫𑇀𑆩 𑆯𑆱𑇀𑆠𑇀𑆫𑆾𑆥𑆑𑇀𑆫𑆩𑆟𑆼𑆤 𑆮𑆳𑇆𑇕𑇖𑇆
𑆧𑆳𑆬𑆱𑇀𑆠𑆶 𑆒𑆬𑆶 𑆩𑆾𑆲𑆳𑆢𑇀𑆮𑆳 𑆥𑇀𑆫𑆩𑆳𑆢𑆳𑆢𑇀𑆮𑆳 𑆤 𑆧𑆶𑆣𑇀𑆪𑆠𑆼𑇅 𑆇𑆠𑇀𑆥𑆢𑇀𑆪𑆩𑆳𑆤𑆁 𑆥𑇀𑆫𑆡𑆩𑆁 𑆫𑆾𑆓𑆁 𑆯𑆠𑇀𑆫𑆶𑆩𑆴𑆮𑆳𑆧𑆶𑆣𑆂𑇆𑇕𑇗𑇆
𑆃𑆟𑆶𑆫𑇀𑆲𑆴 𑆥𑇀𑆫𑆡𑆩𑆁 𑆨𑆷𑆠𑇀𑆮𑆳 𑆫𑆾𑆓𑆂 𑆥𑆯𑇀𑆖𑆳𑆢𑇀𑆮𑆴𑆮𑆫𑇀𑆣𑆠𑆼𑇅 𑆱 𑆘𑆳𑆠𑆩𑆷𑆬𑆾 𑆩𑆶𑆰𑇀𑆟𑆳𑆠𑆴 𑆧𑆬𑆩𑆳𑆪𑆶𑆯𑇀𑆖 𑆢𑆶𑆫𑇀𑆩𑆠𑆼𑆂𑇆𑇕𑇘𑇆
𑆤 𑆩𑆷𑆞𑆾 𑆬𑆨𑆠𑆼 𑆱𑆚𑇀𑆘𑇀𑆚𑆳𑆁 𑆠𑆳𑆮𑆢𑇀𑆪𑆳𑆮𑆤𑇀𑆤 𑆥𑆵𑆝𑇀𑆪𑆠𑆼𑇅 𑆥𑆵𑆝𑆴𑆠𑆱𑇀𑆠𑆶 𑆩𑆠𑆴𑆁 𑆥𑆯𑇀𑆖𑆳𑆠𑇀 𑆑𑆶𑆫𑆶𑆠𑆼 𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆼𑇆𑇕𑇙𑇆
𑆃𑆡 𑆥𑆶𑆠𑇀𑆫𑆳𑆁𑆯𑇀𑆖 𑆢𑆳𑆫𑆳𑆁𑆯𑇀𑆖 𑆘𑇀𑆚𑆳𑆠𑆵𑆁𑆯𑇀𑆖𑆳𑆲𑆷𑆪 𑆨𑆳𑆰𑆠𑆼𑇅 𑆱𑆫𑇀𑆮𑆱𑇀𑆮𑆼𑆤𑆳𑆥𑆴 𑆩𑆼 𑆑𑆯𑇀𑆖𑆴𑆢𑇀𑆨𑆴𑆰𑆓𑆳𑆤𑆵𑆪𑆠𑆳𑆩𑆴𑆠𑆴𑇆𑇖𑇐𑇆
𑆠𑆡𑆳𑆮𑆴𑆣𑆁 𑆖 𑆑𑆂 𑆯𑆑𑇀𑆠𑆾 𑆢𑆶𑆫𑇀𑆧𑆬𑆁 𑆮𑇀𑆪𑆳𑆣𑆴𑆥𑆵𑆝𑆴𑆠𑆩𑇀𑇅 𑆑𑆸𑆯𑆁 𑆑𑇀𑆰𑆵𑆟𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆢𑆵𑆤𑆁 𑆥𑆫𑆴𑆠𑇀𑆫𑆳𑆠𑆶𑆁 𑆓𑆠𑆳𑆪𑆶𑆰𑆩𑇀𑇆𑇖𑇑𑇆
𑆱 𑆠𑇀𑆫𑆳𑆠𑆳𑆫𑆩𑆤𑆳𑆱𑆳𑆢𑇀𑆪 𑆧𑆳𑆬𑆱𑇀𑆠𑇀𑆪𑆘𑆠𑆴 𑆘𑆵𑆮𑆴𑆠𑆩𑇀𑇅 𑆓𑆾𑆣𑆳 𑆬𑆳𑆕𑇀𑆓𑆷𑆬𑆧𑆢𑇀𑆣𑆼𑆮𑆳𑆑𑆸𑆰𑇀𑆪𑆩𑆳𑆟𑆳 𑆧𑆬𑆵𑆪𑆱𑆳𑇆𑇖𑇒𑇆
𑆠𑆱𑇀𑆩𑆳𑆠𑇀 𑆥𑇀𑆫𑆳𑆓𑆼𑆮 𑆫𑆾𑆓𑆼𑆨𑇀𑆪𑆾 𑆫𑆾𑆓𑆼𑆰𑆶 𑆠𑆫𑆶𑆟𑆼𑆰𑆶 𑆮𑆳𑇅 𑆨𑆼𑆰𑆘𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆑𑆶𑆫𑇀𑆮𑆵𑆠 𑆪 𑆅𑆖𑇀𑆗𑆼𑆠𑇀 𑆱𑆶𑆒𑆩𑆳𑆠𑇀𑆩𑆤𑆂𑇆𑇖𑇓𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆍𑆰𑆟𑆳𑆂 𑆱𑆩𑆶𑆥𑆱𑇀𑆠𑆩𑇀𑆨𑆳 𑆧𑆬𑆁 𑆑𑆳𑆫𑆟𑆩𑆳𑆩𑆪𑆳𑆂𑇅 𑆠𑆴𑆱𑇀𑆫𑆽𑆰𑆟𑆵𑆪𑆼 𑆩𑆳𑆫𑇀𑆓𑆳𑆯𑇀𑆖 𑆨𑆴𑆰𑆘𑆾 𑆨𑆼𑆰𑆘𑆳𑆤𑆴 𑆖𑇆𑇖𑇔𑇆
𑆠𑇀𑆫𑆴𑆠𑇀𑆮𑆼𑆤𑆳𑆰𑇀𑆛𑆿 𑆱𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆑𑆸𑆰𑇀𑆟𑆳𑆠𑇀𑆫𑆼𑆪𑆼𑆟 𑆣𑆵𑆩𑆠𑆳𑇅 𑆨𑆳𑆮𑆳, 𑆨𑆳𑆮𑆼𑆰𑇀𑆮𑆱𑆑𑇀𑆠𑆼𑆤 𑆪𑆼𑆰𑆶 𑆱𑆫𑇀𑆮𑆁 𑆥𑇀𑆫𑆠𑆴𑆰𑇀𑆜𑆴𑆠𑆩𑇀𑇆𑇖𑇕𑇆
𑆃𑆡𑆳𑆠𑆾 𑆮𑆳𑆠𑆑𑆬𑆳𑆑𑆬𑆵𑆪𑆩𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆮𑆳𑆠𑆑𑆬𑆳𑆑𑆬𑆳𑆘𑇀𑆚𑆳𑆤𑆩𑆣𑆴𑆑𑆸𑆠𑇀𑆪 𑆥𑆫𑆱𑇀𑆥𑆫𑆩𑆠𑆳𑆤𑆴 𑆘𑆴𑆘𑇀𑆚𑆳𑆱𑆩𑆳𑆤𑆳𑆂 𑆱𑆩𑆶𑆥𑆮𑆴𑆯𑇀𑆪 𑆩𑆲𑆫𑇀𑆰𑆪𑆂 𑆥𑆥𑇀𑆫𑆖𑇀𑆗𑆶𑆫𑆤𑇀𑆪𑆾𑇁𑆤𑇀𑆪𑆁- 𑆑𑆴𑆕𑇀𑆓𑆶𑆟𑆾 𑆮𑆳𑆪𑆶𑆂, 𑆑𑆴𑆩𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆩𑇀, 𑆇𑆥𑆯𑆩𑆤𑆳𑆤𑆴 𑆮𑆳𑇁𑆱𑇀𑆪 𑆑𑆳𑆤𑆴, 𑆑𑆡𑆁 𑆖𑆽𑆤𑆩𑆱𑆕𑇀𑆔𑆳𑆠𑆮𑆤𑇀𑆠𑆩𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆩𑆤𑆳𑆱𑆳𑆢𑇀𑆪 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆥𑇀𑆫𑆑𑆾𑆥𑆪𑆤𑇀𑆠𑆴 𑆥𑇀𑆫𑆯𑆩𑆪𑆤𑇀𑆠𑆴 𑆮𑆳, 𑆑𑆳𑆤𑆴 𑆖𑆳𑆱𑇀𑆪 𑆑𑆶𑆥𑆴𑆠𑆳𑆑𑆶𑆥𑆴𑆠𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆳𑆯𑆫𑆵𑆫𑆖𑆫𑆱𑇀𑆪 𑆯𑆫𑆵𑆫𑆼𑆰𑆶 𑆖𑆫𑆠𑆂 𑆑𑆫𑇀𑆩𑆳𑆟𑆴 𑆧𑆲𑆴𑆂𑆯𑆫𑆵𑆫𑆼𑆨𑇀𑆪𑆾𑆮𑆼𑆠𑆴𑇆𑇓𑇆
𑆃𑆠𑇀𑆫𑆾𑆮𑆳𑆖 𑆑𑆶𑆯𑆂 𑆱𑆳𑆕𑇀𑆑𑆸𑆠𑇀𑆪𑆳𑆪𑆤𑆂- 𑆫𑆷𑆑𑇀𑆰𑆬𑆔𑆶𑆯𑆵𑆠𑆢𑆳𑆫𑆶𑆟𑆒𑆫𑆮𑆴𑆯𑆢𑆳𑆂 𑆰𑆝𑆴𑆩𑆼 𑆮𑆳𑆠𑆓𑆶𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑆴𑇆𑇔𑇆
𑆠𑆖𑇀𑆗𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆮𑆳𑆑𑇀𑆪𑆁 𑆑𑆶𑆩𑆳𑆫𑆯𑆴𑆫𑆳 𑆨𑆫𑆢𑇀𑆮𑆳𑆘 𑆇𑆮𑆳𑆖- 𑆍𑆮𑆩𑆼𑆠𑆢𑇀𑆪𑆡𑆳 𑆨𑆓𑆮𑆳𑆤𑆳𑆲, 𑆍𑆠 𑆍𑆮 𑆮𑆳𑆠𑆓𑆶𑆟𑆳 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆱 𑆠𑇀𑆮𑆼𑆮𑆕𑇀𑆓𑆶𑆟𑆽𑆫𑆼𑆮𑆤𑇀𑆢𑇀𑆫𑆮𑇀𑆪𑆽𑆫𑆼𑆮𑆩𑇀𑆥𑇀𑆫𑆨𑆳𑆮𑆽𑆯𑇀𑆖 𑆑𑆫𑇀𑆩𑆨𑆴𑆫𑆨𑇀𑆪𑆱𑇀𑆪𑆩𑆳𑆤𑆽𑆫𑇀𑆮𑆳𑆪𑆶𑆂 𑆥𑇀𑆫𑆑𑆾𑆥𑆩𑆳𑆥𑆢𑇀𑆪𑆠𑆼, 𑆱𑆩𑆳𑆤𑆓𑆶𑆟𑆳𑆨𑇀𑆪𑆳𑆱𑆾 𑆲𑆴 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑆳𑆫𑆟𑆩𑆴𑆠𑆴𑇆𑇕𑇆
𑆠𑆖𑇀𑆗𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆮𑆳𑆑𑇀𑆪𑆁 𑆑𑆳𑆕𑇀𑆑𑆳𑆪𑆤𑆾 𑆧𑆳𑆲𑇀𑆬𑆵𑆑𑆨𑆴𑆰𑆓𑆶𑆮𑆳𑆖- 𑆍𑆮𑆩𑆼𑆠𑆢𑇀𑆪𑆡𑆳 𑆨𑆓𑆮𑆳𑆤𑆳𑆲, 𑆍𑆠𑆳𑆤𑇀𑆪𑆼𑆮 𑆮𑆳𑆠𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴; 𑆃𑆠𑆾 𑆮𑆴𑆥𑆫𑆵𑆠𑆳𑆤𑆴 𑆮𑆳𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆯𑆩𑆤𑆳𑆤𑆴 𑆨𑆮𑆤𑇀𑆠𑆴, 𑆥𑇀𑆫𑆑𑆾𑆥𑆟𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆾 𑆲𑆴 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆥𑇀𑆫𑆯𑆩𑆑𑆳𑆫𑆟𑆩𑆴𑆠𑆴𑇆𑇖𑇆
𑆠𑆖𑇀𑆗𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆑𑆳𑆥𑇀𑆪𑆮𑆖𑆾 𑆨𑆓𑆮𑆳𑆤𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆫𑆳𑆠𑇀𑆫𑆼𑆪 𑆇𑆮𑆳𑆖- 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆨𑆮𑆤𑇀𑆠𑆂 𑆱𑆩𑇀𑆪𑆓𑆳𑆲𑆶𑆫𑆤𑇀𑆪𑆠𑇀𑆫𑆽𑆑𑆳𑆤𑇀𑆠𑆴𑆑𑆮𑆖𑆤𑆳𑆠𑇀; 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆒𑆬𑆶 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆳𑆟𑆂 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆷𑆠𑆳𑆂 𑆥𑆶𑆫𑆶𑆰𑆩𑆮𑇀𑆪𑆳𑆥𑆤𑇀𑆤𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆁 𑆧𑆬𑆮𑆫𑇀𑆟𑆱𑆶𑆒𑆾𑆥𑆥𑆤𑇀𑆤𑆩𑆳𑆪𑆶𑆰𑆳 𑆩𑆲𑆠𑆾𑆥𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴 𑆱𑆩𑇀𑆪𑆓𑆼𑆮𑆳𑆖𑆫𑆴𑆠𑆳 𑆣𑆫𑇀𑆩𑆳𑆫𑇀𑆡𑆑𑆳𑆩𑆳 𑆅𑆮 𑆤𑆴𑆂𑆯𑇀𑆫𑆼𑆪𑆱𑆼𑆤 𑆩𑆲𑆠𑆳 𑆥𑆶𑆫𑆶𑆰𑆩𑆴𑆲 𑆖𑆳𑆩𑆶𑆰𑇀𑆩𑆴𑆁𑆯𑇀𑆖 𑆬𑆾𑆑𑆼; 𑆮𑆴𑆑𑆸𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆼𑆤𑆁 𑆩𑆲𑆠𑆳 𑆮𑆴𑆥𑆫𑇀𑆪𑆪𑆼𑆟𑆾𑆥𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑆴 𑆉𑆠𑆮𑆱𑇀𑆠𑇀𑆫𑆪 𑆅𑆮 𑆮𑆴𑆑𑆸𑆠𑆴𑆩𑆳𑆥𑆤𑇀𑆤𑆳 𑆬𑆾𑆑𑆩𑆯𑆶𑆨𑆼𑆤𑆾𑆥𑆔𑆳𑆠𑆑𑆳𑆬 𑆅𑆠𑆴𑇆𑇑𑇓𑇆
𑆠𑆢𑆸𑆰𑆪𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆤𑆶𑆩𑆼𑆤𑆴𑆫𑆼 𑆮𑆖𑆤𑆩𑆳𑆠𑇀𑆫𑆼𑆪𑆱𑇀𑆪 𑆨𑆓𑆮𑆠𑆾𑇁𑆨𑆴𑆤𑆤𑆤𑇀𑆢𑆶𑆯𑇀𑆖𑆼𑆠𑆴𑇆𑇑𑇔𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆠𑆢𑆳𑆠𑇀𑆫𑆼𑆪𑆮𑆖𑆂 𑆯𑇀𑆫𑆶𑆠𑇀𑆮𑆳 𑆱𑆫𑇀𑆮 𑆍𑆮𑆳𑆤𑆶𑆩𑆼𑆤𑆴𑆫𑆼𑇅 𑆉𑆰𑆪𑆾𑇁𑆨𑆴𑆤𑆤𑆤𑇀𑆢𑆶𑆯𑇀𑆖 𑆪𑆡𑆼𑆤𑇀𑆢𑇀𑆫𑆮𑆖𑆤𑆁 𑆱𑆶𑆫𑆳𑆂𑇆𑇑𑇕𑇆
𑆠𑆠𑇀𑆫 𑆯𑇀𑆬𑆾𑆑𑆿- 𑆓𑆶𑆟𑆳𑆂 𑆰𑆝𑇀 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆾 𑆲𑆼𑆠𑆶𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩 𑆪𑆠𑇀 𑆥𑆶𑆤𑆂𑇅 𑆮𑆳𑆪𑆾𑆯𑇀𑆖𑆠𑆶𑆫𑇀𑆮𑆴𑆣𑆁 𑆑𑆫𑇀𑆩 𑆥𑆸𑆡𑆑𑇀 𑆖 𑆑𑆦𑆥𑆴𑆠𑇀𑆠𑆪𑆾𑆂𑇆𑇑𑇖𑇆
𑆩𑆲𑆫𑇀𑆰𑆵𑆟𑆳𑆁 𑆩𑆠𑆴𑆫𑇀𑆪𑆳 𑆪𑆳 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑆠𑆴𑆯𑇀𑆖 𑆪𑆳𑇅 𑆑𑆬𑆳𑆑𑆬𑆵𑆪𑆼 𑆮𑆳𑆠𑆱𑇀𑆪 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆑𑆳𑆯𑆴𑆠𑆩𑇀𑇆𑇑𑇗𑇆
𑆃𑆡𑆳𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆣𑇀𑆪𑆳𑆪𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂𑇆𑇑𑇆
𑆅𑆠𑆴 𑆲 𑆱𑇀𑆩𑆳𑆲 𑆨𑆓𑆮𑆳𑆤𑆳𑆠𑇀𑆫𑆼𑆪𑆂𑇆𑇒𑇆
𑆱𑆳𑆕𑇀𑆒𑇀𑆪𑆽𑆂 𑆱𑆕𑇀𑆒𑇀𑆪𑆳𑆠𑆱𑆕𑇀𑆒𑇀𑆪𑆼𑆪𑆽𑆂 𑆱𑆲𑆳𑆱𑆵𑆤𑆁 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑇀𑇅 𑆘𑆓𑆢𑇀𑆣𑆴𑆠𑆳𑆫𑇀𑆡𑆁 𑆥𑆥𑇀𑆫𑆖𑇀𑆗 𑆮𑆲𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆱𑇀𑆮𑆱𑆁𑆯𑆪𑆩𑇀𑇆𑇓𑇆
𑆑𑆴𑆁𑆪𑆾𑆤𑆪𑆂 𑆑𑆠𑆴 𑆱𑇀𑆤𑆼𑆲𑆳𑆂 𑆑𑆼 𑆖 𑆱𑇀𑆤𑆼𑆲𑆓𑆶𑆟𑆳𑆂 𑆥𑆸𑆡𑆑𑇀𑇅 𑆑𑆳𑆬𑆳𑆤𑆶𑆥𑆳𑆤𑆼 𑆑𑆼 𑆑𑆱𑇀𑆪 𑆑𑆠𑆴 𑆑𑆳𑆯𑇀𑆖 𑆮𑆴𑆖𑆳𑆫𑆟𑆳𑆂𑇆𑇔𑇆
𑆑𑆠𑆴 𑆩𑆳𑆠𑇀𑆫𑆳𑆂 𑆑𑆡𑆩𑇀𑆩𑆳𑆤𑆳𑆂 𑆑𑆳 𑆖 𑆑𑆼𑆰𑆷𑆥𑆢𑆴𑆯𑇀𑆪𑆠𑆼𑇅 𑆑𑆯𑇀𑆖 𑆑𑆼𑆨𑇀𑆪𑆾 𑆲𑆴𑆠𑆂 𑆱𑇀𑆤𑆼𑆲𑆂 𑆥𑇀𑆫𑆑𑆫𑇀𑆰𑆂 𑆱𑇀𑆤𑆼𑆲𑆤𑆼 𑆖 𑆑𑆂𑇆𑇕𑇆
𑆱𑇀𑆤𑆼𑆲𑇀𑆪𑆳𑆂 𑆑𑆼 𑆑𑆼 𑆤 𑆖 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆳𑆠𑆴𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆑𑆴𑆁 𑆥𑆳𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆡𑆩𑆁 𑆥𑆵𑆠𑆼 𑆘𑆵𑆫𑇀𑆟𑆼 𑆑𑆴𑆚𑇀𑆖 𑆲𑆴𑆠𑆳𑆲𑆴𑆠𑆩𑇀𑇆𑇖𑇆
𑆑𑆼 𑆩𑆸𑆢𑆶𑆑𑇀𑆫𑆷𑆫𑆑𑆾𑆰𑇀𑆜𑆳𑆂 𑆑𑆳 𑆮𑇀𑆪𑆳𑆥𑆢𑆂 𑆱𑆴𑆢𑇀𑆣𑆪𑆯𑇀𑆖 𑆑𑆳𑆂𑇅 𑆃𑆖𑇀𑆗𑆼 𑆱𑆁𑆯𑆾𑆣𑆤𑆼 𑆖𑆽𑆮 𑆱𑇀𑆤𑆼𑆲𑆼 𑆑𑆳 𑆮𑆸𑆠𑇀𑆠𑆴𑆫𑆴𑆰𑇀𑆪𑆠𑆼𑇆𑇗𑇆
𑆮𑆴𑆖𑆳𑆫𑆟𑆳𑆂 𑆑𑆼𑆰𑆶 𑆪𑆾𑆘𑇀𑆪𑆳 𑆮𑆴𑆣𑆴𑆤𑆳 𑆑𑆼𑆤 𑆠𑆠𑇀 𑆥𑇀𑆫𑆨𑆾!𑇅 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆪𑆳𑆩𑆴𑆠𑆮𑆴𑆘𑇀𑆚𑆳𑆤 𑆘𑇀𑆚𑆳𑆤𑆩𑆴𑆖𑇀𑆗𑆳𑆩𑆴 𑆮𑆼𑆢𑆴𑆠𑆶𑆩𑇀𑇆𑇘𑇆
𑆃𑆡 𑆠𑆠𑇀𑆱𑆁𑆯𑆪𑆖𑇀𑆗𑆼𑆠𑇀𑆠𑆳 𑆥𑇀𑆫𑆠𑇀𑆪𑆶𑆮𑆳𑆖 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆂𑇅 𑆱𑇀𑆤𑆼𑆲𑆳𑆤𑆳𑆁 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆳 𑆱𑆿𑆩𑇀𑆪 𑆪𑆾𑆤𑆴𑆂 𑆱𑇀𑆡𑆳𑆮𑆫𑆘𑆕𑇀𑆓𑆩𑆳𑇆𑇙𑇆

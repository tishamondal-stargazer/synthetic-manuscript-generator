𑆅𑆠𑆴 𑆢𑆯𑆩𑆷𑆬𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆱𑆩𑆷𑆬𑆦𑆬𑆥𑆠𑇀𑆫𑆳𑆪𑆳𑆂 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑇀𑆪𑆳 𑆫𑆱𑆳𑆞𑆑𑆼𑇅 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆧𑆬𑆳𑆮𑇀𑆪𑆾𑆰𑆮𑆴𑆝𑆕𑇀𑆓𑆯𑆛𑆴𑆖𑆴𑆠𑇀𑆫𑆑𑆽𑆂𑇆𑇑𑇒𑇕𑇆
𑆱𑆿𑆮𑆫𑇀𑆖𑆬𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆥𑆿𑆰𑇀𑆑𑆫𑆽𑆂𑇅 𑆮𑆸𑆯𑇀𑆖𑆵𑆫𑆧𑆸𑆲𑆠𑆵𑆥𑆡𑇀𑆪𑆳𑆪𑆮𑆳𑆤𑆵𑆢𑆳𑆝𑆴𑆩𑆫𑇀𑆣𑆴𑆨𑆴𑆂𑇆𑇑𑇒𑇖𑇆
𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆥𑆶𑆤𑆫𑇀𑆤𑆮𑆳𑆖𑆮𑇀𑆪𑆢𑆶𑆫𑆳𑆬𑆩𑇀𑆨𑆳𑆩𑇀𑆬𑆮𑆼𑆠𑆱𑆽𑆂𑇅 𑆯𑆸𑆕𑇀𑆓𑆵𑆠𑆳𑆩𑆬𑆑𑆵𑆨𑆳𑆫𑇀𑆓𑆵𑆫𑆳𑆱𑇀𑆤𑆳𑆓𑆾𑆑𑇀𑆰𑆶𑆫𑆑𑆽𑆂 𑆥𑆖𑆼𑆠𑇀𑇆𑇑𑇒𑇗𑇆
𑆑𑆬𑇀𑆑𑆽𑆱𑇀𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆑𑆳𑆱𑆼𑆰𑆶 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆼𑆰𑆶 𑆯𑆱𑇀𑆪𑆠𑆼𑇅 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆵𑆔𑆸𑆠𑆁 𑆲𑇀𑆪𑆼𑆠𑆠𑇀 𑆑𑆦𑆮𑇀𑆪𑆳𑆣𑆴𑆤𑆴𑆱𑆷𑆢𑆤𑆩𑇀𑇆𑇑𑇒𑇘𑇆
𑆅𑆠𑆴 𑆑𑆟𑇀𑆛𑆑𑆳𑆫𑆵𑆔𑆸𑆠𑆩𑇀𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆫𑆱𑆪𑆶𑆑𑇀𑆠𑆁 𑆮𑆳 𑆥𑆚𑇀𑆖𑆑𑆾𑆬𑆯𑆸𑆠𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆥𑆳𑆪𑆪𑆼𑆠𑇀 𑆑𑆦𑆘𑆼 𑆑𑆳𑆱𑆼 𑆲𑆴𑆑𑇀𑆑𑆳𑆯𑇀𑆮𑆳𑆱𑆼 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇒𑇙𑇆
𑆅𑆠𑆴 𑆑𑆶𑆬𑆠𑇀𑆡𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆣𑆷𑆩𑆳𑆁𑆱𑇀𑆠𑆳𑆤𑆼𑆮 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆖 𑆪𑆼 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳 𑆮𑆳𑆠𑆑𑆳𑆱𑆴𑆤𑆳𑆩𑇀𑇅 𑆑𑆾𑆯𑆳𑆠𑆑𑆵𑆦𑆬𑆳𑆤𑇀𑆩𑆣𑇀𑆪𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆮𑆳 𑆱𑆩𑆤𑆂𑆯𑆴𑆬𑆩𑇀𑇆𑇑𑇓𑇐𑇆
𑆠𑆩𑆑𑆂 𑆑𑆦𑆑𑆳𑆱𑆼 𑆠𑆶 𑆱𑇀𑆪𑆳𑆖𑇀𑆖𑆼𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆘𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆑𑆳𑆱𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆠𑆠𑇀𑆫 𑆪𑆡𑆳𑆮𑆱𑇀𑆡𑆁 𑆥𑇀𑆫𑆪𑆾𑆘𑆪𑆼𑆠𑇀𑇆𑇑𑇓𑇑𑇆
𑆮𑆳𑆠𑆼 𑆑𑆦𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆼 𑆠𑆶 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑆑𑆦𑆲𑆫𑆵𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇅 𑆥𑆴𑆠𑇀𑆠𑆳𑆤𑆶𑆧𑆤𑇀𑆣𑆪𑆾𑆫𑇀𑆮𑆳𑆠𑆑𑆦𑆪𑆾𑆂 𑆥𑆴𑆠𑇀𑆠𑆤𑆳𑆯𑆴𑆤𑆵𑆩𑇀𑇆𑇑𑇓𑇒𑇆
𑆄𑆫𑇀𑆢𑇀𑆫𑆼 𑆮𑆴𑆫𑆷𑆑𑇀𑆰𑆟𑆁, 𑆯𑆶𑆰𑇀𑆑𑆼 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆁, 𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆼𑇅 𑆑𑆳𑆱𑆼𑇁𑆤𑇀𑆤𑆥𑆳𑆤𑆁 𑆑𑆦𑆘𑆼 𑆱𑆥𑆴𑆠𑇀𑆠𑆼 𑆠𑆴𑆑𑇀𑆠𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇑𑇓𑇓𑇆
𑆅𑆠𑆴 𑆑𑆦𑆘𑆑𑆳𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑇅 𑆑𑆳𑆱𑆩𑆳𑆠𑇀𑆪𑆪𑆴𑆑𑆁 𑆩𑆠𑇀𑆮𑆳 𑆑𑇀𑆰𑆠𑆘𑆁 𑆠𑇀𑆮𑆫𑆪𑆳 𑆘𑆪𑆼𑆠𑇀𑇅 𑆩𑆣𑆶𑆫𑆽𑆫𑇀𑆘𑆵𑆮𑆤𑆵𑆪𑆽𑆯𑇀𑆖 𑆧𑆬𑆩𑆳𑆁𑆱𑆮𑆴𑆮𑆫𑇀𑆣𑆤𑆽𑆂𑇆𑇑𑇓𑇔𑇆
𑆥𑆴𑆥𑇀𑆥𑆬𑆵 𑆩𑆣𑆶𑆑𑆁 𑆥𑆴𑆰𑇀𑆛𑆁 𑆑𑆳𑆫𑇀𑆰𑆴𑆑𑆁 𑆱𑆱𑆴𑆠𑆾𑆥𑆬𑆩𑇀𑇅 𑆥𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑆁 𑆓𑆮𑇀𑆪𑆩𑆳𑆘𑆁 𑆖 𑆑𑇀𑆰𑆵𑆫𑆩𑆴𑆑𑇀𑆰𑆶𑆫𑆱𑆱𑇀𑆠𑆡𑆳𑇆𑇑𑇓𑇕𑇆
𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆖𑆷𑆫𑇀𑆟𑆩𑆳𑆩𑆬𑆑𑆳𑆢𑇀𑆫𑆱𑆂𑇅 𑆠𑆽𑆬𑆁 𑆖 𑆥𑇀𑆫𑆱𑆸𑆠𑆳𑆁𑆯𑆳𑆤𑆴 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆩𑆸𑆢𑆶𑆤𑆳𑇁𑆓𑇀𑆤𑆴𑆤𑆳𑇆𑇑𑇓𑇖𑇆
𑆥𑆖𑆼𑆬𑇀𑆬𑆼𑆲𑆁 𑆔𑆸𑆠𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆪𑆶𑆑𑇀𑆠𑆂 𑆱 𑆑𑇀𑆰𑆠𑆑𑆳𑆱𑆲𑆳𑇅 𑆯𑇀𑆮𑆳𑆱𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆑𑆳𑆫𑇀𑆯𑇀𑆪𑆼𑆰𑆶 𑆲𑆴𑆠𑆾 𑆮𑆸𑆢𑇀𑆣𑆼𑇁𑆬𑇀𑆥𑆫𑆼𑆠𑆱𑆴𑇆𑇑𑇓𑇗𑇆
𑆑𑇀𑆰𑆠𑆑𑆳𑆱𑆳𑆨𑆴𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆮𑆸𑆠𑇀𑆠𑆴𑆂 𑆱𑇀𑆪𑆳𑆠𑇀 𑆥𑆴𑆠𑇀𑆠𑆑𑆳𑆱𑆴𑆑𑆵𑇅 𑆑𑇀𑆰𑆵𑆫𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆩𑆣𑆶𑆥𑇀𑆫𑆳𑆪𑆳 𑆱𑆁𑆱𑆫𑇀𑆓𑆼 𑆠𑆶 𑆮𑆴𑆯𑆼𑆰𑆟𑆩𑇀𑇆𑇑𑇓𑇘𑇆
𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆫𑇀𑆢𑆴𑆠𑆼𑇁𑆨𑇀𑆪𑆕𑇀𑆓𑆾 𑆓𑆳𑆠𑇀𑆫𑆨𑆼𑆢𑆼 𑆔𑆸𑆠𑆽𑆫𑇀𑆲𑆴𑆠𑆂𑇅 𑆠𑆽𑆬𑆽𑆫𑇀𑆩𑆳𑆫𑆶𑆠𑆫𑆾𑆓𑆔𑇀𑆤𑆽𑆂 𑆥𑆵𑆝𑇀𑆪𑆩𑆳𑆤𑆼 𑆖 𑆮𑆳𑆪𑆶𑆤𑆳𑇆𑇑𑇓𑇙𑇆
𑆲𑆸𑆠𑇀𑆥𑆳𑆫𑇀𑆯𑇀𑆮𑆳𑆫𑇀𑆠𑆴𑆰𑆶 𑆥𑆳𑆤𑆁 𑆱𑇀𑆪𑆳𑆘𑇀𑆘𑆵𑆮𑆤𑆵𑆪𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆴𑆰𑆂𑇅 𑆱𑆢𑆳𑆲𑆁 𑆑𑆳𑆱𑆴𑆤𑆾 𑆫𑆑𑇀𑆠𑆁 𑆰𑇀𑆜𑆵𑆮𑆠𑆂 𑆱𑆧𑆬𑆼𑇁𑆤𑆬𑆼𑇆𑇑𑇔𑇐𑇆
𑆫𑆑𑇀𑆠𑆼 𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑇀𑆪 𑆄𑆱𑇀𑆪𑆳𑆢𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆳𑆓𑆠𑆼 𑆑𑇀𑆰𑆵𑆫𑆘𑆁 𑆔𑆸𑆠𑆩𑇀𑇅 𑆤𑆱𑇀𑆪𑆁 𑆥𑆳𑆤𑆁 𑆪𑆮𑆳𑆓𑆷𑆫𑇀𑆮𑆳 𑆯𑇀𑆫𑆳𑆤𑇀𑆠𑆼 𑆑𑇀𑆰𑆳𑆩𑆼 𑆲𑆠𑆳𑆤𑆬𑆼𑇆𑇑𑇔𑇒𑇆
𑆱𑇀𑆠𑆩𑇀𑆨𑆳𑆪𑆳𑆩𑆼𑆰𑆶 𑆩𑆲𑆠𑆵𑆁 𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆂 𑆥𑆴𑆧𑆼𑆠𑇀𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑇀𑆮𑆳 𑆮𑆳𑆠𑆫𑆾𑆓𑆔𑇀𑆤𑆁 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆳𑆮𑆴𑆫𑆾𑆣𑆴 𑆪𑆠𑇀𑇆𑇑𑇔𑇓𑇆
𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑆼 𑆑𑇀𑆰𑆠𑆢𑆾𑆰𑆼 𑆠𑆶 𑆑𑆦𑆼 𑆮𑆸𑆢𑇀𑆣 𑆇𑆫𑆂 𑆑𑇀𑆰𑆠𑆼𑇅 𑆢𑆳𑆬𑇀𑆪𑆠𑆼 𑆑𑆳𑆱𑆴𑆤𑆾 𑆪𑆱𑇀𑆪 𑆱 𑆣𑆷𑆩𑆳𑆤𑇀𑆤𑆳 𑆥𑆴𑆧𑆼𑆢𑆴𑆩𑆳𑆤𑇀𑇆𑇑𑇔𑇔𑇆
𑆢𑇀𑆮𑆼 𑆩𑆼𑆢𑆼 𑆩𑆣𑆶𑆑𑆁 𑆢𑇀𑆮𑆼 𑆖 𑆧𑆬𑆼 𑆠𑆽𑆂 𑆑𑇀𑆰𑆿𑆩𑆬𑆑𑇀𑆠𑆑𑆽𑆂𑇅 𑆮𑆫𑇀𑆠𑆴𑆠𑆽𑆫𑇀𑆣𑆷𑆩𑆩𑆳𑆥𑆵𑆪 𑆘𑆵𑆮𑆤𑆵𑆪𑆔𑆸𑆠𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇔𑇕𑇆
𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆥𑆬𑆳𑆯𑆳𑆘𑆓𑆤𑇀𑆣𑆳𑆠𑇀𑆮𑆑𑇀𑆑𑇀𑆰𑆵𑆫𑆴𑆤𑆳𑆓𑆫𑆽𑆂𑇅 𑆨𑆳𑆮𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆿𑆩𑆩𑆤𑆶 𑆖𑆼𑆑𑇀𑆰𑆶𑆓𑆶𑆝𑆾𑆢𑆑𑆩𑇀𑇆𑇑𑇔𑇖𑇆
𑆥𑆴𑆰𑇀𑆛𑇀𑆮𑆳 𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆁 𑆠𑆶𑆬𑇀𑆪𑆳𑆩𑆳𑆫𑇀𑆢𑇀𑆫𑆪𑆳 𑆮𑆛𑆯𑆶𑆕𑇀𑆓𑆪𑆳𑇅 𑆱𑆱𑆫𑇀𑆥𑆴𑆰𑇀𑆑𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆣𑆷𑆩𑆁 𑆠𑆴𑆠𑇀𑆠𑆴𑆫𑆴𑆥𑇀𑆫𑆠𑆴𑆨𑆾𑆘𑆤𑆩𑇀𑇆𑇑𑇔𑇗𑇆
𑆨𑆳𑆮𑆴𑆠𑆁 𑆘𑆵𑆮𑆤𑆵𑆪𑆽𑆫𑇀𑆮𑆳 𑆑𑆶𑆬𑆴𑆕𑇀𑆓𑆳𑆟𑇀𑆝𑆫𑆱𑆳𑆪𑆶𑆠𑆽𑆂𑇅 𑆑𑇀𑆰𑆿𑆩𑆁 𑆣𑆷𑆩𑆁 𑆥𑆴𑆧𑆼𑆠𑇀 𑆑𑇀𑆰𑆵𑆫𑆁 𑆯𑆸𑆠𑆁 𑆖𑆳𑆪𑆾𑆓𑆶𑆝𑆽𑆫𑆤𑆶𑇆𑇑𑇔𑇘𑇆
𑆅𑆠𑆴 𑆑𑇀𑆰𑆠𑆘𑆑𑆳𑆱𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆳𑇅 𑆱𑆩𑇀𑆥𑆷𑆫𑇀𑆟𑆫𑆷𑆥𑆁 𑆑𑇀𑆰𑆪𑆘𑆁 𑆢𑆶𑆫𑇀𑆧𑆬𑆱𑇀𑆪 𑆮𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑇅 𑆤𑆮𑆾𑆠𑇀𑆡𑆴𑆠𑆁 𑆧𑆬𑆮𑆠𑆂 𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆪𑆳𑆖𑆫𑆼𑆠𑇀 𑆑𑇀𑆫𑆴𑆪𑆳𑆩𑇀𑇆𑇑𑇔𑇙𑇆
𑆠𑆱𑇀𑆩𑆽 𑆧𑆸𑆁𑆲𑆟𑆩𑆼𑆮𑆳𑆢𑆿 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆓𑇀𑆤𑆼𑆯𑇀𑆖 𑆢𑆵𑆥𑆤𑆩𑇀𑇅 𑆧𑆲𑆶𑆢𑆾𑆰𑆳𑆪 𑆱𑆱𑇀𑆤𑆼𑆲𑆁 𑆩𑆸𑆢𑆶 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆩𑇀𑇆𑇑𑇕𑇐𑇆
𑆯𑆩𑇀𑆥𑆳𑆑𑆼𑆤 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑆪𑆳 𑆩𑆸𑆢𑇀𑆮𑆵𑆑𑆳𑆫𑆱𑆪𑆶𑆑𑇀𑆠𑆪𑆳𑇅 𑆠𑆴𑆬𑇀𑆮𑆑𑆱𑇀𑆪 𑆑𑆰𑆳𑆪𑆼𑆟 𑆮𑆴𑆢𑆳𑆫𑆵𑆱𑇀𑆮𑆫𑆱𑆼𑆤 𑆖𑇆𑇑𑇕𑇑𑇆
𑆱𑆫𑇀𑆥𑆴𑆂 𑆱𑆴𑆢𑇀𑆣𑆁 𑆥𑆴𑆧𑆼𑆢𑇀𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆑𑇀𑆰𑆵𑆟𑆢𑆼𑆲𑆾 𑆮𑆴𑆯𑆾𑆣𑆤𑆩𑇀𑇅 (𑆲𑆴𑆠𑆁 𑆠𑆢𑇀𑆢𑆼𑆲𑆧𑆬𑆪𑆾𑆫𑆱𑇀𑆪 𑆱𑆁𑆫𑆑𑇀𑆰𑆟𑆁 𑆩𑆠𑆩𑇀 )𑇆𑇑𑇕𑇒𑇆
𑆥𑆴𑆠𑇀𑆠𑆼 𑆑𑆦𑆼 𑆖 𑆱𑆕𑇀𑆑𑇀𑆰𑆵𑆟𑆼 𑆥𑆫𑆴𑆑𑇀𑆰𑆵𑆟𑆼𑆰𑆶 𑆣𑆳𑆠𑆶𑆰𑆶𑇅 𑆔𑆸𑆠𑆁 𑆑𑆫𑇀𑆑𑆛𑆑𑆵𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆮𑆴𑆧𑆬𑆳𑆱𑆳𑆣𑆴𑆠𑆁 𑆥𑆴𑆧𑆼𑆠𑇀𑇆𑇑𑇕𑇓𑇆
𑆮𑆴𑆢𑆳𑆫𑆵𑆨𑆴𑆂 𑆑𑆢𑆩𑇀𑆧𑆽𑆫𑇀𑆮𑆳 𑆠𑆳𑆬𑆱𑆱𑇀𑆪𑆽𑆱𑇀𑆠𑆡𑆳 𑆯𑆸𑆠𑆩𑇀𑇅 𑆔𑆸𑆠𑆁 𑆥𑆪𑆯𑇀𑆖 𑆩𑆷𑆠𑇀𑆫𑆱𑇀𑆪 𑆮𑆽𑆮𑆫𑇀𑆟𑇀𑆪𑆼 𑆑𑆸𑆖𑇀𑆗𑇀𑆫𑆤𑆴𑆫𑇀𑆓𑆩𑆼𑇆𑇑𑇕𑇔𑇆
𑆯𑆷𑆤𑆼 𑆱𑆮𑆼𑆢𑆤𑆼 𑆩𑆼𑆞𑇀𑆫𑆼 𑆥𑆳𑆪𑆿 𑆱𑆯𑇀𑆫𑆾𑆟𑆴𑆮𑆕𑇀𑆑𑇀𑆰𑆟𑆼𑇅 𑆔𑆸𑆠𑆩𑆟𑇀𑆝𑆼𑆤 𑆩𑆣𑆶𑆤𑆳𑇁𑆤𑆶𑆮𑆳𑆱𑇀𑆪𑆾 𑆩𑆴𑆯𑇀𑆫𑆑𑆼𑆟 𑆮𑆳𑇆𑇑𑇕𑇕𑇆
𑆐𑆰𑇀𑆟𑇀𑆪𑆳𑆠𑇀 𑆥𑇀𑆫𑆩𑆳𑆡𑆴𑆨𑆳𑆮𑆳𑆖𑇀𑆖 𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑇀𑆪𑆯𑇀𑆖𑇀𑆪𑆳𑆮𑆪𑆤𑇀𑆠𑆴 𑆠𑆼𑇅 𑆑𑆦𑆁, 𑆯𑆶𑆢𑇀𑆣𑆽𑆯𑇀𑆖 𑆠𑆽𑆂 𑆥𑆶𑆰𑇀𑆛𑆴𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆱𑆩𑇀𑆪𑆓𑇀𑆮𑆲𑆤𑇀𑆫𑆱𑆂𑇆𑇑𑇕𑇗𑇆
𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆖𑆮𑆴𑆑𑆳𑆨𑆳𑆫𑇀𑆓𑆴𑆖𑆴𑆠𑇀𑆫𑆑𑆽𑆂𑇅 𑆑𑆶𑆬𑆠𑇀𑆡𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆥𑆳𑆜𑆳𑆑𑆾𑆬𑆪𑆮𑆽𑆫𑇀𑆘𑆬𑆼𑇆𑇑𑇕𑇘𑇆
𑆯𑆸𑆠𑆽𑆫𑇀𑆤𑆳𑆓𑆫𑆢𑆶𑆂𑆱𑇀𑆥𑆫𑇀𑆯𑆳𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆯𑆛𑆴𑆥𑆿𑆰𑇀𑆑𑆫𑆽𑆂𑇅 𑆑𑆬𑇀𑆑𑆽𑆂 𑆑𑆫𑇀𑆑𑆛𑆯𑆸𑆕𑇀𑆓𑇀𑆪𑆳 𑆖 𑆱𑆩𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀𑇆𑇑𑇕𑇙𑇆
𑆱𑆴𑆢𑇀𑆣𑆼𑇁𑆱𑇀𑆩𑆴𑆁𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆿 𑆑𑇀𑆰𑆳𑆫𑆿 𑆢𑇀𑆮𑆿 𑆥𑆚𑇀𑆖 𑆬𑆮𑆟𑆳𑆤𑆴 𑆖𑇅 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆪𑆶𑆑𑇀𑆠𑇀𑆪𑆳 𑆥𑆴𑆧𑆼𑆤𑇀𑆩𑆳𑆠𑇀𑆫𑆳𑆁 𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆤𑆴𑆥𑆵𑆝𑆴𑆠𑆂𑇆𑇑𑇖𑇐𑇆
𑆅𑆠𑆴 𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆓𑆶𑆝𑆷𑆖𑆵𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆁 𑆩𑆷𑆫𑇀𑆮𑆳𑆁 𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆁 𑆯𑇀𑆫𑆼𑆪𑆱𑆵𑆁 𑆮𑆖𑆳𑆩𑇀𑇅 𑆤𑆴𑆢𑆴𑆓𑇀𑆣𑆴𑆑𑆳𑆁 𑆑𑆳𑆱𑆩𑆫𑇀𑆢𑆁 𑆥𑆳𑆜𑆳𑆁 𑆖𑆴𑆠𑇀𑆫𑆑𑆤𑆳𑆓𑆫𑆩𑇀𑇆𑇑𑇖𑇑𑇆
𑆘𑆬𑆼 𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆼 𑆥𑆑𑇀𑆠𑇀𑆮𑆳 𑆥𑆳𑆢𑆯𑆼𑆰𑆼𑆟 𑆠𑆠𑇀𑆱𑆩𑆩𑇀𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆧𑆼𑆢𑇀𑆓𑆶𑆬𑇀𑆩𑆯𑇀𑆮𑆳𑆱𑆳𑆫𑇀𑆠𑆴𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆤𑆶𑆠𑇀𑇆𑇑𑇖𑇒𑇆
𑆅𑆠𑆴 𑆓𑆶𑆝𑆷𑆖𑇀𑆪𑆳𑆢𑆴𑆔𑆸𑆠𑆩𑇀𑇅 𑆑𑆳𑆱𑆩𑆫𑇀𑆢𑆳𑆨𑆪𑆳𑆩𑆶𑆱𑇀𑆠𑆥𑆳𑆜𑆳𑆑𑆛𑇀𑆦𑆬𑆤𑆳𑆓𑆫𑆽𑆂𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆑𑆛𑆶𑆑𑆳𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆑𑆳𑆯𑇀𑆩𑆫𑇀𑆪𑆱𑆶𑆫𑆱𑆽𑆱𑇀𑆠𑆡𑆳𑇆𑇑𑇖𑇓𑇆
𑆃𑆑𑇀𑆰𑆩𑆳𑆠𑇀𑆫𑆽𑆫𑇀𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆁 𑆑𑇀𑆰𑆵𑆫𑆢𑇀𑆫𑆳𑆑𑇀𑆰𑆳𑆫𑆱𑆳𑆞𑆑𑆼𑇅 𑆥𑆖𑆼𑆖𑇀𑆗𑆾𑆰𑆘𑇀𑆮𑆫𑆥𑇀𑆬𑆵𑆲𑆱𑆫𑇀𑆮𑆑𑆳𑆱𑆲𑆫𑆁 𑆯𑆴𑆮𑆩𑇀𑇆𑇑𑇖𑇔𑇆
𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆽𑆂 𑆑𑇀𑆰𑆵𑆫𑆱𑆴𑆢𑇀𑆣𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆮𑆖𑆷𑆫𑇀𑆟𑆴𑆠𑆩𑇀𑇅 𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆼 𑆢𑆳𑆝𑆴𑆩𑆫𑆱𑆼 𑆮𑆴𑆥𑆑𑇀𑆮𑆁 𑆮𑇀𑆪𑆾𑆰𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇆𑇑𑇖𑇕𑇆
𑆥𑆴𑆧𑆼𑆢𑆶𑆥𑆫𑆴 𑆨𑆑𑇀𑆠𑆱𑇀𑆪 𑆪𑆮𑆑𑇀𑆰𑆳𑆫𑆔𑆸𑆠𑆁 𑆤𑆫𑆂𑇅 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆓𑆶𑆝𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆖𑇀𑆗𑆳𑆓𑆑𑇀𑆰𑆵𑆫𑆪𑆶𑆠𑆁 𑆔𑆸𑆠𑆩𑇀𑇆𑇑𑇖𑇖𑇆
𑆍𑆠𑆳𑆤𑇀𑆪𑆓𑇀𑆤𑆴𑆮𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆫𑇀𑆡𑆁 𑆱𑆫𑇀𑆥𑆵𑆁𑆰𑆴 𑆑𑇀𑆰𑆪𑆑𑆳𑆱𑆴𑆤𑆳𑆩𑇀𑇅 𑆱𑇀𑆪𑆶𑆫𑇀𑆢𑆾𑆰𑆧𑆢𑇀𑆣𑆑𑆾𑆰𑇀𑆜𑆾𑆫𑆂𑆱𑇀𑆫𑆾𑆠𑆱𑆳𑆁 𑆖 𑆮𑆴𑆯𑆶𑆢𑇀𑆣𑆪𑆼𑇆𑇑𑇖𑇗𑇆
𑆲𑆫𑆵𑆠𑆑𑆵𑆫𑇀𑆪𑆮𑆑𑇀𑆮𑆳𑆡𑆢𑇀𑆮𑇀𑆪𑆳𑆞𑆑𑆼 𑆮𑆴𑆁𑆯𑆠𑆴𑆁 𑆥𑆖𑆼𑆠𑇀𑇅 𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆳 𑆩𑆸𑆢𑆴𑆠𑇀𑆮𑆳 𑆠𑆳𑆱𑇀𑆠𑆱𑇀𑆩𑆴𑆤𑇀 𑆥𑆶𑆫𑆳𑆟𑆁 𑆓𑆶𑆝𑆰𑆛𑇀𑆥𑆬𑆩𑇀𑇆𑇑𑇖𑇘𑇆
𑆢𑆢𑇀𑆪𑆳𑆤𑇀𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆑𑆫𑇀𑆰𑆁 𑆑𑆫𑇀𑆰𑆳𑆫𑇀𑆣𑆁 𑆖 𑆫𑆱𑆳𑆚𑇀𑆘𑆤𑆳𑆠𑇀𑇅 𑆑𑆶𑆝𑆮𑆳𑆫𑇀𑆣𑆁 𑆖 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆳𑆂 𑆱 𑆬𑆼𑆲𑆂 𑆯𑇀𑆮𑆳𑆱𑆑𑆳𑆱𑆤𑆶𑆠𑇀𑇆𑇑𑇖𑇙𑇆
𑆍𑆫𑆟𑇀𑆝𑆥𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆁 𑆮𑆳 𑆮𑇀𑆪𑆾𑆰𑆠𑆽𑆬𑆓𑆶𑆝𑆳𑆤𑇀𑆮𑆴𑆠𑆩𑇀𑇅 𑆬𑆴𑆲𑇀𑆪𑆳𑆢𑆼𑆠𑆼𑆤 𑆮𑆴𑆣𑆴𑆤𑆳 𑆱𑆶𑆫𑆱𑆽𑆫𑆟𑇀𑆝𑆥𑆠𑇀𑆫𑆘𑆩𑇀𑇆𑇑𑇗𑇑𑇆

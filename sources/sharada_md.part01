𑆠𑇀𑆫𑆴𑆮𑆸𑆢𑇀𑆢𑆤𑇀𑆠𑆵𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆫𑇀𑆑𑆩𑆷𑆬𑆁 𑆬𑆾𑆲𑆳𑆯𑇀𑆮𑆩𑆳𑆫𑆑𑆿 𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆳𑆫𑆁 𑆠𑇀𑆫𑆴𑆦𑆬𑆳 𑆱𑇀𑆤𑆶𑆲𑇀𑆪𑆫𑇀𑆑𑆥𑆪𑆱𑆵 𑆩𑆣𑆶 𑇆𑇔𑇘𑇆
𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆱𑆩𑆳𑆪𑆶𑆑𑇀𑆠𑆽𑆱𑇀𑆠𑆽𑆬𑆩𑆼𑆠𑆽𑆫𑇀𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀 𑇅 𑆨𑆓𑆤𑇀𑆢𑆫𑆮𑆴𑆤𑆳𑆯𑆳𑆫𑇀𑆡𑆩𑆼𑆠𑆢𑇀𑆪𑆾𑆘𑇀𑆪𑆁 𑆮𑆴𑆯𑆼𑆰𑆠𑆂 𑇆𑇔𑇙𑇆
𑆖𑆴𑆠𑇀𑆫𑆑𑆳𑆫𑇀𑆑𑆿 𑆠𑇀𑆫𑆴𑆮𑆸𑆠𑇀𑆥𑆳𑆜𑆼 𑆩𑆬𑆥𑆷𑆁 𑆲𑆪𑆩𑆳𑆫𑆑𑆩𑇀 𑇅 𑆱𑆶𑆣𑆳𑆁 𑆮𑆖𑆳𑆁 𑆬𑆳𑆕𑇀𑆓𑆬𑆑𑆵𑆁 𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆁 𑆱𑆶𑆮𑆫𑇀𑆖𑆴𑆑𑆳𑆩𑇀 𑇆𑇕𑇐𑇆
𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆩𑆠𑆵𑆁 𑆖 𑆱𑆩𑇀𑆨𑆸𑆠𑇀𑆪 𑆠𑆽𑆬𑆁 𑆣𑆵𑆫𑆾 𑆮𑆴𑆥𑆳𑆖𑆪𑆼𑆠𑇀 𑇅 𑆍𑆠𑆢𑇀𑆣𑆴 𑆱𑇀𑆪𑆤𑇀𑆢𑆤𑆁 𑆠𑆽𑆬𑆁 𑆨𑆸𑆯𑆁 𑆢𑆢𑇀𑆪𑆳𑆢𑇀𑆨𑆓𑆤𑇀𑆢𑆫𑆼 𑇆𑇕𑇑𑇆
𑆯𑆾𑆣𑆤𑆁 𑆫𑆾𑆥𑆟𑆁 𑆖𑆽𑆮 𑆱𑆮𑆫𑇀𑆟𑆑𑆫𑆟𑆁 𑆠𑆡𑆳 𑇅 𑆢𑇀𑆮𑆴𑆮𑇀𑆫𑆟𑆵𑆪𑆩𑆮𑆼𑆑𑇀𑆰𑆼𑆠 𑆮𑇀𑆫𑆟𑆳𑆮𑆱𑇀𑆡𑆳𑆱𑆶 𑆧𑆶𑆢𑇀𑆣𑆴𑆩𑆳𑆤𑇀 𑇆𑇕𑇒𑇆
𑆗𑆴𑆢𑇀𑆫𑆳𑆢𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆲𑆫𑆼𑆢𑆾𑆰𑇀𑆜𑆩𑆫𑇀𑆯𑆾𑆪𑆤𑇀𑆠𑇀𑆫𑆱𑇀𑆪 𑆪𑆤𑇀𑆠𑇀𑆫𑆮𑆴𑆠𑇀 𑇅 𑆠𑆠𑆾 𑆨𑆓𑆤𑇀𑆢𑆫𑆼 𑆢𑆢𑇀𑆪𑆳𑆢𑆼𑆠𑆢𑆫𑇀𑆣𑆼𑆤𑇀𑆢𑆶𑆱𑆤𑇀𑆤𑆴𑆨𑆩𑇀 𑇆𑇕𑇓𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆁 𑆩𑆽𑆡𑆶𑆤𑆁 𑆑𑆾𑆥𑆁 𑆥𑆸𑆰𑇀𑆜𑆪𑆳𑆤𑆁 𑆓𑆶𑆫𑆷𑆟𑆴 𑆖 𑇅 𑆱𑆁𑆮𑆠𑇀𑆱𑆫𑆁 𑆥𑆫𑆴𑆲𑆫𑆼𑆢𑆶𑆥𑆫𑆷𑆞𑆮𑇀𑆫𑆟𑆾 𑆤𑆫𑆂 𑇆𑇕𑇔𑇆
𑆃𑆡𑆳𑆠𑆂 𑆑𑆶𑆰𑇀𑆜𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆮𑆼𑆓𑆮𑆴𑆔𑆳𑆠𑆽𑆂 𑆱𑇀𑆤𑆼𑆲𑆳𑆢𑆵𑆤𑆳𑆁 𑆖𑆳𑆪𑆡𑆳𑆫𑆩𑇀𑆨𑆽𑆂 𑆥𑆳𑆥𑆑𑇀𑆫𑆴𑆪𑆪𑆳 𑆥𑆶𑆫𑆳𑆑𑆸𑆠𑆑𑆫𑇀𑆩𑆪𑆾𑆓𑆳𑆖𑇀𑆖 𑆠𑇀𑆮𑆓𑇀𑆢𑆾𑆰𑆳 𑆨𑆮𑆤𑇀𑆠𑆴 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫 𑆠𑇀𑆮𑆓𑇀𑆢𑆾𑆰𑆵 𑆩𑆳𑆁𑆱𑆮𑆱𑆳𑆢𑆶𑆓𑇀𑆣𑆢𑆣𑆴𑆠𑆽𑆬𑆑𑆶𑆬𑆠𑇀𑆡𑆩𑆳𑆰𑆤𑆴𑆰𑇀𑆥𑆳𑆮𑆼𑆑𑇀𑆰𑆶𑆥𑆴𑆰𑇀𑆛𑆮𑆴𑆑𑆳𑆫𑆳𑆩𑇀𑆬𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆣𑇀𑆪𑆯𑆤𑆳𑆘𑆵𑆫𑇀𑆟𑆮𑆴𑆢𑆳𑆲𑇀𑆪𑆨𑆴𑆰𑇀𑆪𑆤𑇀𑆢𑆵𑆤𑆴 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆁 𑆮𑇀𑆪𑆮𑆳𑆪𑆁 𑆖 𑆥𑆫𑆴𑆲𑆫𑆼𑆠𑇀 𑇆𑇔𑇆
𑆠𑆠𑆂 𑆯𑆳𑆬𑆴𑆰𑆰𑇀𑆛𑆴𑆑𑆪𑆮𑆓𑆾𑆣𑆷𑆩𑆑𑆾𑆫𑆢𑆷𑆰𑆯𑇀𑆪𑆳𑆩𑆳𑆑𑆾𑆢𑇀𑆢𑆳𑆬𑆑𑆳𑆢𑆵𑆤𑆤𑆮𑆳𑆤𑇀 𑆨𑆶𑆚𑇀𑆘𑆵𑆠 𑆩𑆶𑆢𑇀𑆓𑆳𑆞𑆑𑇀𑆪𑆾𑆫𑆤𑇀𑆪𑆠𑆫𑆱𑇀𑆪 𑆪𑆷𑆰𑆼𑆟 𑆱𑆷𑆥𑆼𑆤 𑆮𑆳 𑆤𑆴𑆩𑇀𑆧𑆥𑆠𑇀𑆫𑆳𑆫𑆶𑆰𑇀𑆑𑆫𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆼𑆟, 𑆩𑆟𑇀𑆝𑆷𑆑𑆥𑆫𑇀𑆟𑇀𑆪𑆮𑆬𑇀𑆓𑆶𑆘𑆳𑆛𑆫𑆷𑆰𑆑𑆫𑆷𑆥𑆴𑆑𑆳𑆥𑆶𑆰𑇀𑆥𑆽𑆂 𑆱𑆫𑇀𑆥𑆴𑆂𑆱𑆴𑆢𑇀𑆣𑆽𑆂 𑆱𑆫𑇀𑆰𑆥𑆠𑆽𑆬𑆱𑆴𑆢𑇀𑆣𑆽𑆫𑇀𑆮𑆳, 𑆠𑆴𑆑𑇀𑆠𑆮𑆫𑇀𑆓𑆼𑆟 𑆮𑆳𑇁𑆨𑆴𑆲𑆴𑆠𑆼𑆤; 𑆩𑆳𑆁𑆱𑆱𑆳𑆠𑇀𑆩𑇀𑆪𑆳𑆪 𑆮𑆳 𑆘𑆳𑆕𑇀𑆓𑆬𑆩𑆳𑆁𑆱𑆩𑆩𑆼𑆢𑆱𑇀𑆑𑆁 𑆮𑆴𑆠𑆫𑆼𑆠𑇀; 𑆠𑆽𑆬𑆁 𑆮𑆘𑇀𑆫𑆑𑆩𑆨𑇀𑆪𑆕𑇀𑆓𑆳𑆫𑇀𑆡𑆼; 𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆑𑆰𑆳𑆪𑆩𑆶𑆠𑇀𑆱𑆳𑆢𑆤𑆳𑆫𑇀𑆡𑆼; 𑆥𑆳𑆤𑆥𑆫𑆴𑆰𑆼𑆑𑆳𑆮𑆓𑆳𑆲𑆳𑆢𑆴𑆰𑆶 𑆖 𑆒𑆢𑆴𑆫𑆑𑆰𑆳𑆪𑆩𑇀; 𑆅𑆠𑇀𑆪𑆼𑆰 𑆄𑆲𑆳𑆫𑆳𑆖𑆳𑆫𑆮𑆴𑆨𑆳𑆓𑆂 𑇆𑇕𑇆
𑆠𑆠𑇀𑆫 𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆼𑆰𑆷𑆨𑆪𑆠𑆂 𑆱𑆁𑆯𑆾𑆣𑆤𑆩𑆳𑆱𑆼𑆮𑆼𑆠 𑇅 𑆠𑆠𑇀𑆫 𑆠𑇀𑆮𑆑𑇀𑆱𑆩𑇀𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆯𑆾𑆣𑆤𑆳𑆬𑆼𑆥𑆤𑆳𑆤𑆴, 𑆯𑆾𑆟𑆴𑆠𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆬𑆼𑆥𑆤𑆑𑆰𑆳𑆪𑆥𑆳𑆤𑆯𑆾𑆟𑆴𑆠𑆳𑆮𑆱𑆼𑆖𑆤𑆳𑆤𑆴, 𑆩𑆳𑆁𑆱𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆼 𑆯𑆾𑆣𑆤𑆳𑆬𑆼𑆥𑆤𑆑𑆰𑆳𑆪𑆥𑆳𑆤𑆯𑆾𑆟𑆴𑆠𑆳𑆮𑆱𑆼𑆖𑆤𑆳𑆫𑆴𑆰𑇀𑆛𑆩𑆤𑇀𑆡𑆥𑇀𑆫𑆳𑆯𑆳𑆂, 𑆖𑆠𑆶𑆫𑇀𑆡𑆑𑆫𑇀𑆩𑆓𑆶𑆟𑆥𑇀𑆫𑆳𑆥𑇀𑆠𑆁 𑆪𑆳𑆥𑇀𑆪𑆩𑆳𑆠𑇀𑆩𑆮𑆠𑆂 𑆱𑆁𑆮𑆴𑆣𑆳𑆤𑆮𑆠𑆯𑇀𑆖, 𑆠𑆠𑇀𑆫 𑆱𑆁𑆯𑆾𑆣𑆤𑆳𑆖𑇀𑆗𑆾𑆟𑆴𑆠𑆳𑆮𑆱𑆼𑆖𑆤𑆳𑆖𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆯𑆴𑆬𑆳𑆘𑆠𑆶𑆣𑆳𑆠𑆶𑆩𑆳𑆑𑇀𑆰𑆵𑆑𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑇀𑆮𑆓𑆶𑆫𑆶𑆠𑆶𑆮𑆫𑆑𑆒𑆢𑆴𑆫𑆳𑆱𑆤𑆳𑆪𑆱𑇀𑆑𑆸𑆠𑆴𑆮𑆴𑆣𑆳𑆤𑆩𑆳𑆱𑆼𑆮𑆼𑆠; 𑆥𑆚𑇀𑆖𑆩𑆁 𑆤𑆽𑆮𑆾𑆥𑆑𑇀𑆫𑆩𑆼𑆠𑇀 𑇆𑇖𑇆
𑆠𑆠𑇀𑆫 𑆥𑇀𑆫𑆡𑆩𑆩𑆼𑆮 𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆁 𑆱𑇀𑆤𑆼𑆲𑆥𑆳𑆤𑆮𑆴𑆣𑆳𑆤𑆼𑆤𑆾𑆥𑆥𑆳𑆢𑆪𑆼𑆠𑇀 𑇅 𑆩𑆼𑆰𑆯𑆸𑆕𑇀𑆓𑆵𑆯𑇀𑆮𑆢𑆁𑆰𑇀𑆛𑇀𑆫𑆳𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆼𑆰𑇀𑆛𑆳𑆓𑆶𑆝𑆷𑆖𑆵𑆢𑇀𑆮𑆴𑆥𑆚𑇀𑆖𑆩𑆷𑆬𑆵𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆽𑆬𑆁 𑆔𑆸𑆠𑆁 𑆮𑆳 𑆮𑆳𑆠𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆁 𑆥𑆳𑆤𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆪𑆾𑆫𑇀𑆮𑆴𑆢𑆣𑇀𑆪𑆳𑆠𑇀, 𑆣𑆮𑆳𑆯𑇀𑆮𑆑𑆫𑇀𑆟𑆑𑆑𑆶𑆨𑆥𑆬𑆳𑆯𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆥𑆫𑇀𑆥𑆛𑆑𑆩𑆣𑆶𑆑𑆫𑆾𑆣𑇀𑆫𑆱𑆩𑆕𑇀𑆓𑆳𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆁, 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆯𑆳𑆬𑆳𑆫𑆓𑇀𑆮𑆣𑆤𑆴𑆩𑇀𑆧𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆫𑆴𑆖𑆮𑆖𑆳𑆑𑆶𑆰𑇀𑆜𑆱𑆴𑆢𑇀𑆣𑆁 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆑𑆶𑆰𑇀𑆜𑆴𑆤𑆳𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆳𑆨𑆪𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆱𑆫𑇀𑆮𑆼𑆰𑆳𑆁 𑆠𑆶𑆮𑆫𑆑𑆠𑆽𑆬𑆁 𑆨𑆬𑇀𑆬𑆳𑆠𑆑𑆠𑆽𑆬𑆁 𑆮𑆼𑆠𑆴 𑇆𑇗𑇆
𑆱𑆥𑇀𑆠𑆥𑆫𑇀𑆟𑆳𑆫𑆓𑇀𑆮𑆣𑆳𑆠𑆴𑆮𑆴𑆰𑆼𑆑𑇀𑆰𑆶𑆫𑆥𑆳𑆜𑆳𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑇀𑆪𑆩𑆸𑆠𑆳𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑆛𑆾𑆬𑆥𑆴𑆖𑆶𑆩𑆫𑇀𑆢𑆥𑆫𑇀𑆥𑆛𑆑𑆢𑆶𑆫𑆳𑆬𑆨𑆳𑆠𑇀𑆫𑆳𑆪𑆩𑆳𑆟𑆳𑆩𑆶𑆱𑇀𑆠𑆳𑆖𑆤𑇀𑆢𑆤𑆥𑆢𑇀𑆩𑆑- 𑆲𑆫𑆴𑆢𑇀𑆫𑆾𑆥𑆑𑆶𑆬𑇀𑆪𑆳𑆮𑆴𑆯𑆳𑆬𑆳𑆩𑆷𑆫𑇀𑆮𑆳𑆯𑆠𑆳𑆮𑆫𑆵𑆱𑆳𑆫𑆴𑆮𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆳𑆛𑆫𑆷𑆰𑆑𑆰𑆝𑇀𑆓𑇀𑆫𑆤𑇀𑆡𑆳𑆩𑆣𑆶𑆑𑆨𑆷𑆤𑆴𑆩𑇀𑆧𑆓𑆸𑆰𑇀𑆛𑆴𑆑𑆳 𑆅𑆠𑆴 𑆱𑆩𑆨𑆳𑆓𑆳𑆂 𑆑𑆬𑇀𑆑𑆂𑆱𑇀𑆪𑆳𑆠𑇀, 𑆑𑆬𑇀𑆑𑆳𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆠𑆢𑇀𑆢𑇀𑆮𑆴𑆓𑆶𑆟𑆾 𑆣𑆳𑆠𑇀𑆫𑆵𑆦𑆬𑆫𑆱𑆱𑇀𑆠𑆖𑇀𑆖𑆠𑆶𑆫𑇀𑆓𑆶𑆟𑆳 𑆄𑆥𑆱𑇀𑆠𑆢𑆽𑆑𑆣𑇀𑆪𑆁 𑆱𑆩𑆳𑆬𑆾𑆝𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆍𑆠𑆤𑇀𑆩𑆲𑆳𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆤𑆳𑆩 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆫𑆑𑇀𑆠𑆥𑆴𑆠𑇀𑆠𑆲𑆸𑆢𑇀𑆫𑆾𑆓𑆾𑆤𑇀𑆩𑆳𑆢𑆳𑆥𑆱𑇀𑆩𑆳𑆫𑆓𑆶𑆬𑇀𑆩𑆥𑆴𑆝𑆑𑆳𑆱𑆸𑆓𑇀𑆢𑆫𑆓𑆬𑆓𑆟𑇀𑆝𑆓𑆟𑇀𑆝𑆩𑆳𑆬𑆳- 𑆯𑇀𑆬𑆵𑆥𑆢𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆮𑆴𑆱𑆫𑇀𑆥𑆳𑆫𑇀𑆯𑆂𑆰𑆳𑆟𑇀𑆞𑇀𑆪𑆑𑆟𑇀𑆝𑆷𑆥𑆳𑆩𑆳𑆢𑆵𑆚𑇀𑆗𑆩𑆪𑆼𑆢𑆴𑆠𑆴 𑇆𑇘𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆥𑆛𑆾𑆬𑆥𑆴𑆖𑆶𑆩𑆤𑇀𑆢𑆳𑆛𑆫𑆷𑆰𑆑𑆑𑆛𑆶𑆫𑆾𑆲𑆴𑆟𑆵𑆢𑆶𑆫𑆳𑆬𑆨𑆳𑆠𑇀𑆫𑆳𑆪𑆩𑆳𑆟𑆳𑆂 𑆥𑆫𑇀𑆥𑆛𑆑𑆯𑇀𑆖𑆽𑆠𑆼𑆰𑆳𑆁 𑆢𑇀𑆮𑆴𑆥𑆬𑆴𑆑𑆳𑆤𑇀 𑆨𑆳𑆓𑆳𑆚𑇀𑆘𑆬𑆢𑇀𑆫𑆾𑆟𑆼 𑆥𑇀𑆫𑆑𑇀𑆰𑆴𑆥𑇀𑆪 𑆥𑆳𑆢𑆳𑆮𑆯𑆼𑆰𑆁 𑆑𑆰𑆳𑆪𑆩𑆳𑆢𑆳𑆪 𑆑𑆬𑇀𑆑𑆥𑆼𑆰𑇀𑆪𑆳𑆟𑆵𑆩𑆳𑆤𑆴 𑆨𑆼𑆰𑆘𑆳𑆤𑇀𑆪𑆫𑇀𑆣𑆥𑆬𑆴𑆑𑆳𑆤𑆴 𑆠𑇀𑆫𑆳𑆪𑆩𑆳𑆟𑆳𑆩𑆶𑆱𑇀𑆠𑆼𑆤𑇀𑆢𑇀𑆫𑆪𑆮𑆖𑆤𑇀𑆢𑆤𑆑𑆴𑆫𑆳𑆠𑆠𑆴𑆑𑇀𑆠𑆳𑆤𑆴 𑆥𑆴𑆥𑇀𑆥𑆬𑇀𑆪𑆯𑇀𑆖𑆽𑆠𑆳𑆤𑆴 𑆔𑆸𑆠𑆥𑇀𑆫𑆱𑇀𑆡𑆼 𑆱𑆩𑆳𑆮𑆳𑆥𑇀𑆪 𑆮𑆴𑆥𑆖𑆼𑆠𑇀, 𑆍𑆠𑆠𑇀𑆠𑆴𑆑𑇀𑆠𑆑𑆁 𑆤𑆳𑆩 𑆱𑆫𑇀𑆥𑆴𑆂 𑆑𑆶𑆰𑇀𑆜𑆮𑆴𑆰𑆩𑆘𑇀𑆮𑆫𑆓𑆶𑆬𑇀𑆩𑆳𑆫𑇀𑆯𑆾𑆓𑇀𑆫𑆲𑆟𑆵𑆢𑆾𑆰𑆯𑆾𑆦𑆥𑆳𑆟𑇀𑆝𑆶𑆫𑆾𑆓𑆮𑆴𑆱𑆫𑇀𑆥𑆰𑆳𑆟𑇀𑆞𑇀𑆪𑆯𑆩𑆤𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆘𑆠𑇀𑆫𑆶𑆓𑆠𑆫𑆾𑆓𑆔𑇀𑆤𑆁 𑆖𑆼𑆠𑆴 𑇆𑇙𑇆
𑆃𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆼𑆤 𑆔𑆸𑆠𑆼𑆤 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆱𑇀𑆮𑆴𑆤𑇀𑆤𑆱𑇀𑆪𑆽𑆑𑆳𑆁 𑆢𑇀𑆮𑆼 𑆠𑆴𑆱𑇀𑆫𑆯𑇀𑆖𑆠𑆱𑇀𑆫𑆂 𑆥𑆚𑇀𑆖 𑆮𑆳 𑆱𑆴𑆫𑆳 𑆮𑆴𑆣𑇀𑆪𑆼𑆠𑇀; 𑆩𑆟𑇀𑆝𑆬𑆳𑆤𑆴 𑆖𑆾𑆠𑇀𑆱𑆤𑇀𑆤𑆳𑆤𑇀𑆪𑆮𑆬𑆴𑆒𑆼𑆢𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁, 𑆥𑇀𑆫𑆖𑇀𑆗𑆪𑆼𑆢𑇀𑆮𑆳, 𑆱𑆩𑆶𑆢𑇀𑆫𑆦𑆼𑆤𑆯𑆳𑆑𑆓𑆾𑆘𑆵𑆑𑆳𑆑𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆴𑆑𑆳𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳𑇁𑆮𑆔𑆸𑆰𑇀𑆪𑆳𑆬𑆼𑆥𑆪𑆼𑆬𑇀𑆬𑆳𑆑𑇀𑆰𑆳𑆱𑆫𑇀𑆘𑆫𑆱𑆫𑆱𑆳𑆚𑇀𑆘𑆤- 𑆥𑇀𑆫𑆥𑆶𑆤𑇀𑆤𑆝𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆠𑆼𑆘𑆾𑆮𑆠𑇀𑆪𑆯𑇀𑆮𑆩𑆳𑆫𑆑𑆳𑆫𑇀𑆑𑆑𑆶𑆛𑆘𑆳𑆫𑆼𑆮𑆠𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆩𑆷𑆠𑇀𑆫𑆥𑆴𑆰𑇀𑆛𑆽𑆂 𑆥𑆴𑆠𑇀𑆠𑆥𑆴𑆰𑇀𑆛𑆽𑆫𑇀𑆮𑆳, 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆠𑆶𑆠𑇀𑆡𑆑𑆳𑆱𑆵𑆱𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆓𑆳𑆫𑆣𑆷𑆩𑆖𑆴𑆠𑇀𑆫𑆑𑆑𑆛𑆶𑆑𑆱𑆶𑆣𑆳𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆱𑆽𑆤𑇀𑆣𑆮𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆳, 𑆍𑆠𑆳𑆤𑇀𑆪𑆼𑆮𑆳𑆮𑆳𑆥𑇀𑆪 𑆑𑇀𑆰𑆳𑆫𑆑𑆬𑇀𑆥𑆼𑆤 𑆤𑆴𑆂𑆱𑇀𑆫𑆶𑆠𑆼 𑆥𑆳𑆬𑆳𑆯𑆼 𑆑𑇀𑆰𑆳𑆫𑆼 𑆠𑆠𑆾 𑆮𑆴𑆥𑆳𑆖𑇀𑆪 𑆦𑆳𑆟𑆵𑆠𑆩𑆴𑆮 𑆱𑆚𑇀𑆘𑆳𑆠𑆩𑆮𑆠𑆳𑆫𑇀𑆪 𑆬𑆼𑆥𑆪𑆼𑆠𑇀, 𑆘𑇀𑆪𑆾𑆠𑆴𑆰𑇀𑆑𑆦𑆬𑆬𑆳𑆑𑇀𑆰𑆳𑆩𑆫𑆴𑆖𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆱𑆶𑆩𑆤𑆂𑆥𑆠𑇀𑆫𑆽𑆫𑇀𑆮𑆳, 𑆲𑆫𑆴𑆠𑆳𑆬𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆫𑇀𑆑𑆑𑇀𑆰𑆵𑆫𑆠𑆴𑆬𑆯𑆴𑆓𑇀𑆫𑆶𑆩𑆫𑆴𑆖𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆳, 𑆱𑇀𑆮𑆫𑇀𑆘𑆴𑆑𑆳𑆑𑆶𑆰𑇀𑆜𑆠𑆶𑆠𑇀𑆡𑆑𑆶𑆛𑆘𑆖𑆴𑆠𑇀𑆫𑆑𑆮𑆴𑆝𑆕𑇀𑆓𑆩𑆫𑆴𑆖𑆫𑆾𑆣𑇀𑆫𑆩𑆤𑆂𑆯𑆴𑆬𑆳𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆳, 𑆲𑆫𑆵𑆠𑆑𑆵𑆑𑆫𑆚𑇀𑆘𑆴𑆑𑆳𑆮𑆴𑆝𑆕𑇀𑆓𑆱𑆴𑆢𑇀𑆣𑆳𑆫𑇀𑆡𑆑𑆬𑆮𑆟𑆫𑆾𑆖𑆤𑆳𑆮𑆬𑇀𑆓𑆶𑆘𑆲𑆫𑆴𑆢𑇀𑆫𑆳𑆑𑆬𑇀𑆑𑆽𑆫𑇀𑆮𑆳 𑇆𑇑𑇐𑇆
𑆬𑆳𑆑𑇀𑆰𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆱𑆫𑇀𑆰𑆥𑆳𑆂 𑆯𑇀𑆫𑆵𑆤𑆴𑆑𑆼𑆠𑆁 𑆫𑆳𑆠𑇀𑆫𑆴𑆫𑇀𑆮𑇀𑆪𑆾𑆰𑆁 𑆖𑆑𑇀𑆫𑆩𑆫𑇀𑆢𑆱𑇀𑆪 𑆧𑆵𑆘𑆩𑇀 𑇅 𑆑𑆸𑆠𑇀𑆮𑆽𑆑𑆱𑇀𑆡𑆁 𑆠𑆑𑇀𑆫𑆥𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆢𑆢𑇀𑆫𑆷𑆰𑆷𑆑𑇀𑆠𑆾 𑆩𑆷𑆬𑆑𑆳𑆢𑇀𑆧𑆵𑆘𑆪𑆶𑆑𑇀𑆠𑆂 𑇆𑇑𑇒𑇆
𑆱𑆴𑆤𑇀𑆣𑆷𑆢𑇀𑆨𑆷𑆠𑆁 𑆖𑆑𑇀𑆫𑆩𑆫𑇀𑆢𑆱𑇀𑆪 𑆧𑆵𑆘𑆩𑆴𑆑𑇀𑆰𑆷𑆢𑇀𑆨𑆷𑆠𑆁 𑆑𑆼𑆯𑆫𑆁 𑆠𑆳𑆫𑇀𑆑𑇀𑆰𑇀𑆪𑆯𑆽𑆬𑆩𑇀 𑇅 𑆥𑆴𑆰𑇀𑆛𑆾 𑆬𑆼𑆥𑆾𑇁𑆪𑆁 𑆑𑆥𑆴𑆠𑇀𑆡𑆳𑆢𑇀𑆫𑆱𑆼𑆤 𑆢𑆢𑇀𑆫𑆷𑆱𑇀𑆠𑆷𑆫𑇀𑆟𑆁 𑆤𑆳𑆯𑆪𑆠𑇀𑆪𑆼𑆰 𑆪𑆾𑆓𑆂 𑇆𑇑𑇓𑇆
𑆲𑆼𑆩𑆑𑇀𑆰𑆵𑆫𑆵 𑆮𑇀𑆪𑆳𑆣𑆴𑆔𑆳𑆠𑆂 𑆯𑆴𑆫𑆵𑆰𑆾 𑆤𑆴𑆩𑇀𑆧𑆂 𑆱𑆫𑇀𑆘𑆾 𑆮𑆠𑇀𑆱𑆑𑆂 𑆱𑆳𑆘𑆑𑆫𑇀𑆟𑆂 𑇅 𑆯𑆵𑆔𑇀𑆫𑆁 𑆠𑆵𑆮𑇀𑆫𑆳 𑆤𑆳𑆯𑆪𑆤𑇀𑆠𑆵𑆲 𑆢𑆢𑇀𑆫𑆷𑆂 𑆱𑇀𑆤𑆳𑆤𑆳𑆬𑆼𑆥𑆾𑆢𑇀𑆣𑆫𑇀𑆰𑆟𑆼𑆰𑆷𑆥𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑇆𑇑𑇔𑇆
𑆨𑆢𑇀𑆫𑆳𑆱𑆚𑇀𑆘𑇀𑆚𑆾𑆢𑆶𑆩𑇀𑆧𑆫𑆵𑆩𑆷𑆬𑆠𑆶𑆬𑇀𑆪𑆁 𑆢𑆠𑇀𑆠𑇀𑆮𑆳 𑆩𑆷𑆬𑆁 𑆑𑇀𑆰𑆾𑆢𑆪𑆴𑆠𑇀𑆮𑆳 𑆩𑆬𑆥𑇀𑆮𑆳𑆂 𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆠𑆾𑆪𑆁 𑆥𑆵𑆠𑆩𑆶𑆰𑇀𑆟𑆼 𑆱𑆶𑆒𑆾𑆰𑇀𑆟𑆁 𑆱𑇀𑆦𑆾𑆛𑆳𑆚𑇀𑆗𑇀𑆮𑆴𑆠𑇀𑆫𑆼 𑆥𑆶𑆟𑇀𑆝𑆫𑆵𑆑𑆼 𑆖 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀 𑇆𑇑𑇕𑇆
𑆑𑆸𑆰𑇀𑆟𑆱𑇀𑆪 𑆱𑆫𑇀𑆥𑆱𑇀𑆪 𑆩𑆱𑆵 𑆱𑆶𑆢𑆓𑇀𑆣𑆳 𑆧𑆽𑆨𑆵𑆠𑆑𑆁 𑆠𑆽𑆬𑆩𑆡 𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆩𑇀 𑇅 𑆍𑆠𑆠𑇀 𑆱𑆩𑆱𑇀𑆠𑆁 𑆩𑆸𑆢𑆴𑆠𑆁 𑆥𑇀𑆫𑆬𑆼𑆥𑆳𑆖𑇀𑆗𑇀𑆮𑆴𑆠𑇀𑆫𑆳𑆟𑆴 𑆃𑆫𑇀𑆮𑆳𑆟𑇀𑆪𑆥𑆲𑆤𑇀𑆠𑆴 𑆯𑆵𑆔𑇀𑆫𑆩𑇀 𑇆𑇑𑇗𑇆

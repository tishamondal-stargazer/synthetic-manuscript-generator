𑆰𑆝𑇀𑆮𑆴𑆣𑆾𑇁𑆮𑆪𑆮𑆱𑆩𑆶𑆠𑇀𑆡𑆂 𑆯𑆾𑆦𑆾𑇁𑆨𑆴𑆲𑆴𑆠𑆾 𑆬𑆑𑇀𑆰𑆟𑆠𑆂 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆠𑆯𑇀𑆖; 𑆱𑆫𑇀𑆮𑆱𑆫𑆱𑇀𑆠𑆶 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆂, 𑆠𑆢𑇀𑆪𑆡𑆳- 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆮𑆴𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆂 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆥𑆠𑆫𑇀𑆥𑆴𑆠𑆱𑇀𑆪𑆳𑆣𑇀𑆮𑆓𑆩𑆤𑆳𑆢𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆨𑇀𑆪𑆮𑆲𑆫𑆠𑆾 𑆮𑆳 𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆲𑆫𑆴𑆠𑆑𑆯𑆳𑆑𑆬𑆮𑆟𑆳𑆤𑆴 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆮𑆳𑇁𑆠𑆴𑆩𑆳𑆠𑇀𑆫𑆩𑆩𑇀𑆬𑆩𑆶𑆥𑆱𑆼𑆮𑆩𑆳𑆤𑆱𑇀𑆪 𑆩𑆸𑆠𑇀𑆥𑆑𑇀𑆮𑆬𑆾𑆰𑇀𑆛𑆑𑆛𑆯𑆫𑇀𑆑𑆫𑆳𑆤𑆷𑆥𑆿𑆢𑆑𑆩𑆳𑆁𑆱𑆱𑆼𑆮𑆤𑆳𑆢𑆘𑆵𑆫𑇀𑆟𑆴𑆤𑆾 𑆮𑆳 𑆓𑇀𑆫𑆳𑆩𑇀𑆪𑆣𑆫𑇀𑆩𑆱𑆼𑆮𑆤𑆳𑆢𑇀𑆮𑆴𑆫𑆶𑆢𑇀𑆣𑆳𑆲𑆳𑆫𑆱𑆼𑆮𑆤𑆳𑆠𑇀 𑆮𑆳 𑆲𑆱𑇀𑆠𑇀𑆪𑆯𑇀𑆮𑆾𑆰𑇀𑆛𑇀𑆫𑆫𑆡𑆥𑆢𑆳𑆠𑆴𑆱𑆕𑇀𑆑𑇀𑆰𑆾𑆨𑆟𑆳𑆢𑆪𑆾 𑆱𑆴𑆠𑆱𑇀𑆪 𑆢𑆾𑆰𑆳 𑆣𑆳𑆠𑆷𑆤𑇀 𑆥𑇀𑆫𑆢𑆷𑆰𑇀𑆪 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆳𑆥𑆳𑆢𑆪𑆤𑇀𑆠𑇀𑆪𑆒𑆴𑆬𑆼 𑆯𑆫𑆵𑆫𑆼 𑇆𑇔𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆫𑆫𑆶𑆟𑆂 𑆑𑆸𑆰𑇀𑆟𑆾 𑆮𑆳 𑆩𑆸𑆢𑆶𑆫𑆤𑆮𑆱𑇀𑆡𑆴𑆠𑆳𑆱𑇀𑆠𑆾𑆢𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆂; 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆵𑆠𑆂 𑆱𑆫𑆑𑇀𑆠𑆾 𑆮𑆳 𑆩𑆸𑆢𑆶𑆂 𑆯𑆵𑆔𑇀𑆫𑆳𑆤𑆶𑆱𑆳𑆫𑇀𑆪𑆷𑆰𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆂; 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆥𑆳𑆟𑇀𑆝𑆶𑆂 𑆯𑆶𑆑𑇀𑆬𑆾 𑆮𑆳 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆑𑆜𑆴𑆤𑆂 𑆯𑆵𑆠𑆾 𑆩𑆤𑇀𑆢𑆳𑆤𑆶𑆱𑆳𑆫𑆵, 𑆑𑆟𑇀𑆝𑇀𑆮𑆳𑆢𑆪𑆯𑇀𑆖𑆳𑆠𑇀𑆫 𑆮𑆼𑆢𑆤𑆳𑆮𑆴𑆯𑆼𑆰𑆳𑆂; 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆶𑆂 𑆱𑆫𑇀𑆮𑆮𑆫𑇀𑆟𑆮𑆼𑆢𑆤𑆂; 𑆮𑆴𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆱𑇀𑆠𑆶 𑆓𑆫𑆾𑆥𑆪𑆾𑆓𑆳𑆢𑇀𑆢𑆶𑆰𑇀𑆛𑆠𑆾𑆪𑆱𑆼𑆮𑆤𑆳𑆠𑇀 𑆥𑇀𑆫𑆑𑆶𑆡𑆴𑆠𑆾𑆢𑆑𑆳𑆮𑆓𑆳𑆲𑆤𑆳𑆠𑇀 𑆱𑆮𑆴𑆰𑆱𑆠𑇀𑆠𑇀𑆮𑆢𑆴𑆓𑇀𑆣𑆖𑆷𑆫𑇀𑆟𑆼𑆤𑆳𑆮𑆖𑆷𑆫𑇀𑆟𑆤𑆳𑆢𑇀𑆮𑆳 𑆱𑆮𑆴𑆰𑆩𑆷𑆠𑇀𑆫𑆥𑆶𑆫𑆵𑆰𑆯𑆶𑆑𑇀𑆫𑆱𑇀𑆥𑆸𑆰𑇀𑆛𑆳𑆤𑆳𑆁 𑆮𑆳 𑆠𑆸𑆟𑆑𑆳𑆰𑇀𑆜𑆳𑆢𑆵𑆤𑆳𑆁 𑆱𑆁𑆱𑇀𑆥𑆫𑇀𑆯𑆤𑆳𑆠𑇀, 𑆱 𑆠𑆶 𑆩𑆸𑆢𑆶𑆂 𑆑𑇀𑆰𑆴𑆥𑇀𑆫𑆾𑆠𑇀𑆡𑆳𑆤𑆾𑇁𑆮𑆬𑆩𑇀𑆧𑆵 𑆖𑆬𑆾𑇁𑆖𑆬𑆾 𑆮𑆳 𑆢𑆳𑆲𑆥𑆳𑆑𑆫𑆳𑆓𑆥𑇀𑆫𑆳𑆪𑆯𑇀𑆖 𑆨𑆮𑆠𑆴 𑇆𑇕𑇆
𑆨𑆮𑆤𑇀𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆢𑆾𑆰𑆳𑆂 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆷𑆫𑇀𑆣𑇀𑆮𑆁 𑆲𑆴 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑇀𑆪𑆳𑆩𑆳𑆯𑆪𑆱𑇀𑆡𑆴𑆠𑆳𑆂 𑇅 𑆥𑆑𑇀𑆮𑆳𑆯𑆪𑆱𑇀𑆡𑆳 𑆩𑆣𑇀𑆪𑆼 𑆖 𑆮𑆫𑇀𑆖𑆂𑆱𑇀𑆡𑆳𑆤𑆓𑆠𑆳𑆱𑇀𑆠𑇀𑆮𑆣𑆂 𑇆𑇖𑇆
𑆃𑆫𑇀𑆣𑆳𑆕𑇀𑆓𑆼𑇁𑆫𑆴𑆰𑇀𑆛𑆨𑆷𑆠𑆯𑇀𑆖 𑆪𑆯𑇀𑆖𑆾𑆫𑇀𑆣𑇀𑆮𑆁 𑆥𑆫𑆴𑆱𑆫𑇀𑆥𑆠𑆴 𑇅 𑆯𑇀𑆮𑆳𑆱𑆂 𑆥𑆴𑆥𑆳𑆱𑆳 𑆢𑆿𑆫𑇀𑆧𑆬𑇀𑆪𑆁 𑆘𑇀𑆮𑆫𑆯𑇀𑆖𑇀𑆗𑆫𑇀𑆢𑆴𑆫𑆫𑆾𑆖𑆑𑆂 𑇆𑇘𑇆
𑆲𑆴𑆑𑇀𑆑𑆳𑆠𑆵𑆱𑆳𑆫𑆑𑆳𑆱𑆳𑆯𑇀𑆖 𑆯𑆷𑆤𑆁 𑆱𑆕𑇀𑆑𑇀𑆰𑆥𑆪𑆤𑇀𑆠𑆴 𑆲𑆴 𑇅 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆠𑆾 𑆮𑆴𑆯𑆼𑆰𑆳𑆖𑇀𑆖 𑆠𑆼𑆰𑆳𑆁 𑆮𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆴 𑆨𑆼𑆰𑆘𑆩𑇀 𑇆𑇙𑇆
𑆯𑆾𑆦𑆴𑆤𑆂 𑆱𑆫𑇀𑆮 𑆍𑆮 𑆥𑆫𑆴𑆲𑆫𑆼𑆪𑆶𑆫𑆩𑇀𑆬𑆬𑆮𑆟𑆢𑆣𑆴𑆓𑆶𑆝𑆮𑆱𑆳𑆥𑆪𑆱𑇀𑆠𑆽𑆬𑆔𑆸𑆠𑆥𑆴𑆰𑇀𑆛𑆩𑆪𑆓𑆶𑆫𑆷𑆟𑆴 𑇆𑇑𑇐𑇆
𑆠𑆠𑇀𑆫 𑆮𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆿 𑆠𑇀𑆫𑆽𑆮𑆸𑆠𑆩𑆼𑆫𑆟𑇀𑆝𑆠𑆽𑆬𑆁 𑆮𑆳 𑆩𑆳𑆱𑆩𑆫𑇀𑆣𑆩𑆳𑆱𑆁 𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆤𑇀𑆪𑆓𑇀𑆫𑆾𑆣𑆳𑆢𑆴𑆑𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆴𑆠𑇀𑆠𑆯𑇀𑆮𑆪𑆡𑆿, 𑆄𑆫𑆓𑇀𑆮𑆣𑆳𑆢𑆴𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆯𑇀𑆮𑆪𑆡𑆿, 𑆱𑆤𑇀𑆤𑆴𑆥𑆳𑆠𑆯𑇀𑆮𑆪𑆡𑆿 𑆱𑇀𑆤𑆶𑆲𑆵𑆑𑇀𑆰𑆵𑆫𑆥𑆳𑆠𑇀𑆫𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆨𑆴𑆫𑆩𑇀𑆬𑆥𑆳𑆠𑇀𑆫𑆽𑆂 𑆥𑇀𑆫𑆠𑆴𑆱𑆁𑆱𑆸𑆘𑇀𑆪 𑆢𑆤𑇀𑆠𑆵𑆢𑇀𑆫𑆮𑆤𑇀𑆠𑆵𑆥𑇀𑆫𑆠𑆵𑆮𑆳𑆥𑆁 𑆱𑆫𑇀𑆥𑆴𑆂 𑆥𑆳𑆖𑆪𑆴𑆠𑇀𑆮𑆳 𑆥𑆳𑆪𑆪𑆼𑆠𑇀, 𑆮𑆴𑆰𑆤𑆴𑆩𑆴𑆠𑇀𑆠𑆼𑆰𑆶 𑆑𑆬𑇀𑆥𑆼𑆰𑆶 𑆥𑇀𑆫𑆠𑆵𑆑𑆳𑆫𑆂 𑇆𑇑𑇑𑇆
𑆃𑆠 𑆈𑆫𑇀𑆣𑇀𑆮𑆁 𑆱𑆳𑆩𑆳𑆤𑇀𑆪𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆶𑆥𑆢𑆼𑆑𑇀𑆰𑇀𑆪𑆳𑆩𑆂- 𑆠𑆴𑆬𑇀𑆮𑆑𑆔𑆸𑆠𑆖𑆠𑆶𑆫𑇀𑆡𑆳𑆤𑆴 𑆪𑆳𑆤𑇀𑆪𑆶𑆑𑇀𑆠𑆳𑆤𑇀𑆪𑆶𑆢𑆫𑆼𑆰𑆶 𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆠𑆩𑆩𑆶𑆥𑆪𑆶𑆘𑇀𑆪𑆩𑆳𑆤𑆁 𑆯𑇀𑆮𑆪𑆡𑆶𑆩𑆥𑆲𑆤𑇀𑆠𑆴, 𑆩𑆷𑆠𑇀𑆫𑆮𑆫𑇀𑆠𑆴𑆑𑇀𑆫𑆴𑆪𑆳𑆁 𑆮𑆳 𑆱𑆼𑆮𑆼𑆠, 𑆤𑆮𑆳𑆪𑆱𑆁 𑆮𑆳𑇁𑆲𑆫𑆲𑆫𑇀𑆩𑆣𑆶𑆤𑆳, 𑆮𑆴𑆝𑆕𑇀𑆓𑆳𑆠𑆴𑆮𑆴𑆰𑆳𑆑𑆶𑆛𑆘𑆦𑆬𑆨𑆢𑇀𑆫𑆢𑆳𑆫𑆶𑆤𑆳𑆓𑆫𑆩𑆫𑆴𑆖𑆖𑆷𑆫𑇀𑆟𑆁 𑆮𑆳 𑆣𑆫𑆟𑆩𑆶𑆰𑇀𑆟𑆳𑆩𑇀𑆧𑆶𑆤𑆳, 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑇀𑆰𑆳𑆫𑆳𑆪𑆯𑇀𑆖𑆷𑆫𑇀𑆟𑆳𑆤𑆴 𑆮𑆳 𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆑𑆰𑆳𑆪𑆼𑆟, 𑆩𑆷𑆠𑇀𑆫𑆁 𑆮𑆳 𑆠𑆶𑆬𑇀𑆪𑆑𑇀𑆰𑆵𑆫𑆁, 𑆲𑆫𑆵𑆠𑆑𑆵𑆁 𑆮𑆳 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆝𑆳𑆩𑆶𑆥𑆪𑆶𑆚𑇀𑆘𑆵𑆠, 𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆯𑆶𑆟𑇀𑆜𑆵𑆁 𑆮𑆳, 𑆓𑆶𑆓𑇀𑆓𑆶𑆬𑆶𑆁 𑆮𑆳 𑆩𑆷𑆠𑇀𑆫𑆼𑆟 𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆑𑆰𑆳𑆪𑆳𑆤𑆶𑆥𑆳𑆤𑆁 𑆮𑆳, 𑆠𑆶𑆬𑇀𑆪𑆓𑆶𑆝𑆁 𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆁 𑆮𑆳, 𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆑𑆰𑆳𑆪𑆁 𑆩𑆷𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆱𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆁 𑆥𑆪𑆾𑇁𑆤𑆶𑆥𑆳𑆤𑆩𑆲𑆫𑆲𑆫𑇀𑆩𑆳𑆱𑆁, 𑆮𑇀𑆪𑆾𑆰𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆑𑆰𑆳𑆪𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆮𑆳 𑆱𑆫𑇀𑆥𑆴𑆰𑆳 𑆩𑆶𑆢𑇀𑆓𑆾𑆬𑆶𑆩𑇀𑆧𑆳𑆤𑇀 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀, 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆖𑆮𑇀𑆪𑆖𑆴𑆠𑇀𑆫𑆑𑆩𑆪𑆷𑆫𑆑𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳 𑆑𑇀𑆰𑆵𑆫𑆁 𑆥𑆴𑆧𑆼𑆠𑇀, 𑆱𑆲𑆿𑆰𑆣𑆩𑆶𑆫𑆕𑇀𑆓𑆵𑆩𑆷𑆬𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆠𑇀𑆫𑆴𑆑𑆛𑆶𑆑𑆽𑆫𑆟𑇀𑆝𑆯𑇀𑆪𑆳𑆩𑆳𑆩𑆷𑆬𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆱𑆲𑆳𑆢𑆼𑆮𑆢𑆳𑆫𑆶𑆱𑆴𑆢𑇀𑆣𑆁 𑆮𑆳, 𑆠𑆡𑆳𑇁𑆬𑆳𑆧𑆷𑆧𑆴𑆨𑆵𑆠𑆑𑆦𑆬𑆑𑆬𑇀𑆑𑆁 𑆮𑆳 𑆠𑆟𑇀𑆝𑆶𑆬𑆳𑆩𑇀𑆧𑆶𑆤𑆳; 𑆑𑇀𑆰𑆳𑆫𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆫𑆴𑆖𑆯𑆸𑆕𑇀𑆓𑆮𑆼𑆫𑆳𑆤𑆶𑆱𑆴𑆢𑇀𑆣𑆼𑆤 𑆖 𑆩𑆶𑆢𑇀𑆓𑆪𑆷𑆰𑆼𑆟𑆳𑆬𑆮𑆟𑆼𑆤𑆳𑆬𑇀𑆥𑆱𑇀𑆤𑆼𑆲𑆼𑆤 𑆨𑆾𑆘𑆪𑆼𑆢𑇀𑆪𑆮𑆳𑆤𑇀𑆤𑆁 𑆓𑆾𑆣𑆷𑆩𑆳𑆤𑇀𑆤𑆁 𑆮𑆳; 𑆮𑆸𑆑𑇀𑆰𑆑𑆳𑆫𑇀𑆑𑆤𑆑𑇀𑆠𑆩𑆳𑆬𑆤𑆴𑆩𑇀𑆧𑆮𑆫𑇀𑆰𑆳𑆨𑆷𑆑𑇀𑆮𑆳𑆡𑆽𑆯𑇀𑆖 𑆥𑆫𑆴𑆰𑆼𑆑𑆂; 𑆱𑆫𑇀𑆰𑆥𑆱𑆶𑆮𑆫𑇀𑆖𑆬𑆳𑆱𑆽𑆤𑇀𑆣𑆮𑆯𑆳𑆫𑇀𑆕𑇀𑆓𑆼𑆰𑇀𑆛𑆳𑆨𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆼𑆲𑆂 𑆑𑆳𑆫𑇀𑆪𑆂; 𑆪𑆡𑆳𑆢𑆾𑆰𑆁 𑆖 𑆮𑆩𑆤𑆮𑆴𑆫𑆼𑆖𑆤𑆳𑆱𑇀𑆡𑆳𑆥𑆤𑆳𑆤𑆴 𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆳𑆤𑇀𑆪𑆘𑆱𑇀𑆫𑆩𑆶𑆥𑆱𑆼𑆮𑆼𑆠, 𑆱𑇀𑆤𑆼𑆲𑆱𑇀𑆮𑆼𑆢𑆾𑆥𑆤𑆳𑆲𑆳𑆁𑆯𑇀𑆖; 𑆱𑆴𑆫𑆳𑆨𑆴𑆯𑇀𑆖𑆳𑆨𑆵𑆑𑇀𑆰𑇀𑆟𑆁 𑆯𑆾𑆟𑆴𑆠𑆩𑆮𑆱𑆼𑆖𑆪𑆼𑆢𑆤𑇀𑆪𑆠𑇀𑆫𑆾𑆥𑆢𑇀𑆫𑆮𑆯𑆾𑆦𑆳𑆢𑆴𑆠𑆴 𑇆𑇑𑇒𑇆
𑆨𑆮𑆠𑆴 𑆖𑆳𑆠𑇀𑆫- 𑆥𑆴𑆰𑇀𑆛𑆳𑆤𑇀𑆤𑆩𑆩𑇀𑆬𑆁 𑆬𑆮𑆟𑆳𑆤𑆴 𑆩𑆢𑇀𑆪𑆁 𑆩𑆸𑆢𑆁 𑆢𑆴𑆮𑆳𑆱𑇀𑆮𑆥𑇀𑆤𑆩𑆘𑆳𑆕𑇀𑆓𑆬𑆁 𑆖 𑇅 𑆱𑇀𑆠𑇀𑆫𑆴𑆪𑆾 𑆔𑆸𑆠𑆁 𑆠𑆽𑆬𑆥𑆪𑆾𑆓𑆶𑆫𑆷𑆟𑆴 𑆯𑆾𑆦𑆁 𑆘𑆴𑆔𑆳𑆁𑆱𑆶𑆂 𑆥𑆫𑆴𑆮𑆫𑇀𑆘𑆪𑆼𑆠𑇀𑆠𑆶 𑇆𑇑𑇓𑇆
𑆃𑆡𑆳𑆠𑆾𑇁𑆤𑆳𑆓𑆠𑆳𑆧𑆳𑆣𑆳𑆥𑇀𑆫𑆠𑆴𑆰𑆼𑆣𑆁 𑆮𑇀𑆪𑆳𑆒𑇀𑆪𑆳𑆱𑇀𑆪𑆳𑆩𑆂 𑇆𑇑𑇆
𑆪𑆡𑆾𑆮𑆳𑆖 𑆨𑆓𑆮𑆳𑆤𑇀 𑆣𑆤𑇀𑆮𑆤𑇀𑆠𑆫𑆴𑆂 𑇆𑇒𑇆
𑆇𑆠𑇀𑆡𑆳𑆪𑆾𑆠𑇀𑆡𑆳𑆪 𑆱𑆠𑆠𑆁 𑆱𑇀𑆮𑆱𑇀𑆡𑆼𑆤𑆳𑆫𑆾𑆓𑇀𑆪𑆩𑆴𑆖𑇀𑆗𑆠𑆳 𑇅 𑆣𑆵𑆩𑆠𑆳 𑆪𑆢𑆤𑆶𑆰𑇀𑆜𑆼𑆪𑆁 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆱𑆩𑇀𑆥𑇀𑆫𑆮𑆑𑇀𑆰𑇀𑆪𑆠𑆼 𑇆𑇓𑇆
𑆠𑆠𑇀𑆫𑆳𑆢𑆿 𑆢𑆤𑇀𑆠𑆥𑆮𑆤𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆕𑇀𑆓𑆶𑆬𑆩𑆳𑆪𑆠𑆩𑇀 𑇅 𑆑𑆤𑆴𑆰𑇀𑆜𑆴𑆑𑆳𑆥𑆫𑆵𑆟𑆳𑆲𑆩𑆸𑆘𑇀𑆮𑆓𑇀𑆫𑆤𑇀𑆡𑆴𑆠𑆩𑆮𑇀𑆫𑆟𑆩𑇀 𑇆𑇔𑇆
𑆃𑆪𑆶𑆓𑇀𑆩𑆓𑇀𑆫𑆤𑇀𑆡𑆴 𑆪𑆖𑇀𑆖𑆳𑆥𑆴 𑆥𑇀𑆫𑆠𑇀𑆪𑆓𑇀𑆫𑆁 𑆯𑆱𑇀𑆠𑆨𑆷𑆩𑆴𑆘𑆩𑇀 𑇅 𑆃𑆮𑆼𑆑𑇀𑆰𑇀𑆪𑆫𑇀𑆠𑆶𑆁 𑆖 𑆢𑆾𑆰𑆁 𑆖 𑆫𑆱𑆁 𑆮𑆵𑆫𑇀𑆪𑆁 𑆖 𑆪𑆾𑆘𑆪𑆼𑆠𑇀 𑇆𑇕𑇆
𑆑𑆰𑆳𑆪𑆁 𑆩𑆣𑆶𑆫𑆁 𑆠𑆴𑆑𑇀𑆠𑆁 𑆑𑆛𑆶𑆑𑆁 𑆥𑇀𑆫𑆳𑆠𑆫𑆶𑆠𑇀𑆡𑆴𑆠𑆂 𑇅 𑆤𑆴𑆩𑇀𑆧𑆯𑇀𑆖 𑆠𑆴𑆑𑇀𑆠𑆑𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆂 𑆑𑆰𑆳𑆪𑆼 𑆒𑆢𑆴𑆫𑆱𑇀𑆠𑆡𑆳 𑇆𑇖𑇆
𑆩𑆣𑆷𑆑𑆾 𑆩𑆣𑆶𑆫𑆼 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆂 𑆑𑆫𑆚𑇀𑆘𑆂 𑆑𑆛𑆶𑆑𑆼 𑆠𑆡𑆳 𑇅 𑆑𑇀𑆰𑆿𑆢𑇀𑆫𑆮𑇀𑆪𑆾𑆰𑆠𑇀𑆫𑆴𑆮𑆫𑇀𑆓𑆳𑆑𑇀𑆠𑆁 𑆱𑆠𑆽𑆬𑆁 𑆱𑆽𑆤𑇀𑆣𑆮𑆼𑆤 𑆖 𑇆𑇗𑇆
𑆖𑆷𑆫𑇀𑆟𑆼𑆤 𑆠𑆼𑆘𑆾𑆮𑆠𑇀𑆪𑆳𑆯𑇀𑆖 𑆢𑆤𑇀𑆠𑆳𑆤𑇀𑆤𑆴𑆠𑇀𑆪𑆁 𑆮𑆴𑆯𑆾𑆣𑆪𑆼𑆠𑇀 𑇅 𑆍𑆑𑆽𑆑𑆁 𑆔𑆫𑇀𑆰𑆪𑆼𑆢𑇀𑆢𑆤𑇀𑆠𑆁 𑆩𑆸𑆢𑆶𑆤𑆳 𑆑𑆷𑆫𑇀𑆖𑆑𑆼𑆤 𑆖 𑇆𑇘𑇆

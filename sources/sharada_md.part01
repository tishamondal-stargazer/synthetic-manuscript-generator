𑆠𑆴𑆬𑆳𑆂 𑆥𑇀𑆫𑆴𑆪𑆳𑆬𑆾 𑆩𑆣𑆶𑆑𑆁 𑆧𑆴𑆱𑆁 𑆩𑆷𑆬𑆁 𑆖 𑆮𑆼𑆠𑆱𑆳𑆠𑇀𑇅 𑆄𑆘𑆼𑆤 𑆥𑆪𑆱𑆳 𑆥𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆫𑆬𑆼𑆥𑆾 𑆢𑆳𑆲𑆫𑆳𑆓𑆤𑆶𑆠𑇀𑇆𑇑𑇓𑇓𑇆
𑆥𑇀𑆫𑆥𑆿𑆟𑇀𑆝𑆫𑆵𑆑𑆩𑆚𑇀𑆘𑆴𑆰𑇀𑆜𑆳𑆢𑆳𑆫𑇀𑆮𑆵𑆩𑆣𑆶𑆑𑆖𑆤𑇀𑆢𑆤𑆽𑆂𑇅 𑆱𑆴𑆠𑆾𑆥𑆬𑆽𑆫𑆑𑆳𑆱𑆑𑇀𑆠𑆶𑆩𑆱𑆷𑆫𑆾𑆯𑆵𑆫𑆥𑆢𑇀𑆩𑆑𑆽𑆂𑇆𑇑𑇓𑇔𑇆
𑆬𑆼𑆥𑆾 𑆫𑆶𑆓𑇀𑆢𑆳𑆲𑆮𑆵𑆱𑆫𑇀𑆥𑆫𑆳𑆓𑆯𑆾𑆦𑆤𑆴𑆮𑆳𑆫𑆟𑆂𑇅 𑆥𑆴𑆠𑇀𑆠𑆫𑆑𑇀𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆠𑇀𑆮𑆼𑆠𑆼, 𑆬𑆼𑆥𑆳𑆤𑇀 𑆮𑆳𑆠𑆾𑆠𑇀𑆠𑆫𑆼 𑆯𑆸𑆟𑆶𑇆𑇑𑇓𑇕𑇆
𑆮𑆳𑆠𑆔𑇀𑆤𑆽𑆂 𑆱𑆳𑆣𑆴𑆠𑆂 𑆱𑇀𑆤𑆴𑆓𑇀𑆣𑆂 𑆱𑆑𑇀𑆰𑆵𑆫𑆩𑆶𑆢𑇀𑆓𑆥𑆳𑆪𑆱𑆂 𑇅 𑆠𑆴𑆬𑆱𑆫𑇀𑆰𑆥𑆥𑆴𑆟𑇀𑆝𑆽𑆫𑇀𑆮𑆳𑇁𑆥𑇀𑆪𑆶𑆥𑆤𑆳𑆲𑆾 𑆫𑆶𑆘𑆳𑆥𑆲𑆂𑇆𑇑𑇓𑇖𑇆
𑆐𑆢𑆑𑆥𑇀𑆫𑆱𑆲𑆳𑆤𑆷𑆥𑆮𑆼𑆯𑆮𑆳𑆫𑆳𑆂 𑆱𑆶𑆱𑆁𑆱𑇀𑆑𑆸𑆠𑆳𑆂𑇅 𑆘𑆵𑆮𑆤𑆵𑆪𑆿𑆰𑆣𑆽𑆂 𑆱𑇀𑆤𑆼𑆲𑆪𑆶𑆑𑇀𑆠𑆳𑆂 𑆱𑇀𑆪𑆶𑆫𑆶𑆥𑆤𑆳𑆲𑆤𑆼𑇆𑇑𑇓𑇗𑇆
𑆱𑇀𑆠𑆩𑇀𑆨𑆠𑆾𑆢𑆫𑆶𑆓𑆳𑆪𑆳𑆩𑆯𑆾𑆡𑆳𑆕𑇀𑆓𑆓𑇀𑆫𑆲𑆤𑆳𑆯𑆤𑆳𑆂𑇅 𑆘𑆵𑆮𑆤𑆵𑆪𑆿𑆰𑆣𑆽𑆂 𑆱𑆴𑆢𑇀𑆣𑆳 𑆱𑆥𑆪𑆱𑇀𑆑𑆳 𑆮𑆱𑆳𑇁𑆥𑆴 𑆮𑆳𑇆𑇑𑇓𑇘𑇆
𑆔𑆸𑆠𑆁 𑆱𑆲𑆖𑆫𑆳𑆤𑇀𑆩𑆷𑆬𑆁 𑆘𑆵𑆮𑆤𑇀𑆠𑆵 𑆖𑇀𑆗𑆳𑆓𑆬𑆁 𑆥𑆪𑆂𑇅 𑆬𑆼𑆥𑆂 𑆥𑆴𑆰𑇀𑆛𑆳𑆱𑇀𑆠𑆴𑆬𑆳𑆱𑇀𑆠𑆢𑇀𑆮𑆢𑇀𑆨𑆸𑆰𑇀𑆛𑆳𑆂 𑆥𑆪𑆱𑆴 𑆤𑆴𑆫𑇀𑆮𑆸𑆠𑆳𑆂𑇆𑇑𑇓𑇙𑇆
𑆑𑇀𑆰𑆵𑆫𑆥𑆴𑆰𑇀𑆛𑆩𑆶𑆩𑆳𑆬𑆼𑆥𑆩𑆼𑆫𑆟𑇀𑆝𑆱𑇀𑆪 𑆦𑆬𑆳𑆤𑆴 𑆖𑇅 𑆑𑆶𑆫𑇀𑆪𑆳𑆖𑇀𑆗𑆷𑆬𑆤𑆴𑆮𑆸𑆠𑇀𑆠𑇀𑆪𑆫𑇀𑆡𑆁 𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆩𑆤𑆴𑆬𑆼𑇁𑆣𑆴𑆑𑆼𑇆𑇑𑇔𑇐𑇆
𑆱𑆩𑆷𑆬𑆳𑆓𑇀𑆫𑆖𑇀𑆗𑆢𑆽𑆫𑆟𑇀𑆝𑆑𑇀𑆮𑆳𑆡𑆼 𑆢𑇀𑆮𑆴𑆥𑇀𑆫𑆳𑆱𑇀𑆡𑆴𑆑𑆁 𑆥𑆸𑆡𑆑𑇀𑇅 𑆔𑆸𑆠𑆁 𑆠𑆽𑆬𑆁 𑆮𑆱𑆳 𑆩𑆘𑇀𑆘𑆳 𑆖𑆳𑆤𑆷𑆥𑆩𑆸𑆓𑆥𑆑𑇀𑆰𑆴𑆟𑆳𑆩𑇀𑇆𑇑𑇔𑇑𑇆
𑆑𑆬𑇀𑆑𑆳𑆫𑇀𑆡𑆼 𑆘𑆵𑆮𑆤𑆵𑆪𑆳𑆤𑆴 𑆓𑆮𑇀𑆪𑆁 𑆑𑇀𑆰𑆵𑆫𑆩𑆡𑆳𑆘𑆑𑆩𑇀𑇅 𑆲𑆫𑆴𑆢𑇀𑆫𑆾𑆠𑇀𑆥𑆬𑆑𑆶𑆰𑇀𑆜𑆽𑆬𑆳𑆯𑆠𑆳𑆲𑇀𑆮𑆳𑆯𑇀𑆮𑆲𑆤𑆖𑇀𑆗𑆢𑆳𑆤𑇀 𑇆𑇑𑇔𑇒𑇆
𑆧𑆴𑆬𑇀𑆮𑆩𑆳𑆠𑇀𑆫𑆳𑆤𑇀 𑆥𑆸𑆡𑆑𑇀 𑆥𑆶𑆰𑇀𑆥𑆁 𑆑𑆳𑆑𑆶𑆨𑆁 𑆖𑆳𑆥𑆴 𑆱𑆳𑆣𑆪𑆼𑆠𑇀𑇅 𑆩𑆣𑆷𑆖𑇀𑆗𑆴𑆰𑇀𑆛𑆥𑆬𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆿 𑆢𑆢𑇀𑆪𑆳𑆖𑇀𑆗𑆵𑆠𑆼𑇁𑆮𑆠𑆳𑆫𑆴𑆠𑆼𑇆𑇑𑇔𑇓𑇆
𑆯𑆷𑆬𑆼𑆤𑆽𑆰𑆾𑇁𑆫𑇀𑆢𑆴𑆠𑆳𑆕𑇀𑆓𑆳𑆤𑆳𑆁 𑆬𑆼𑆥𑆂 𑆱𑆤𑇀𑆣𑆴𑆓𑆠𑆼𑇁𑆤𑆴𑆬𑆼𑇅 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆖𑇀𑆪𑆶𑆠𑆼 𑆨𑆓𑇀𑆤𑆼 𑆒𑆚𑇀𑆘𑆼 𑆑𑆶𑆧𑇀𑆘𑆼 𑆖 𑆯𑆱𑇀𑆪𑆠𑆼𑇆𑇑𑇔𑇔𑇆
𑆯𑆾𑆦𑆓𑆿𑆫𑆮𑆑𑆟𑇀𑆝𑇀𑆮𑆳𑆢𑇀𑆪𑆽𑆫𑇀𑆪𑆶𑆑𑇀𑆠𑆼 𑆠𑇀𑆮𑆱𑇀𑆩𑆴𑆤𑇀 𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆼𑇅 𑆩𑆷𑆠𑇀𑆫𑆑𑇀𑆰𑆳𑆫𑆱𑆶𑆫𑆳𑆥𑆑𑇀𑆮𑆁 𑆔𑆸𑆠𑆩𑆨𑇀𑆪𑆚𑇀𑆘𑆤𑆼 𑆲𑆴𑆠𑆩𑇀𑇆𑇑𑇔𑇕𑇆
𑆥𑆢𑇀𑆩𑆑𑆁 𑆠𑇀𑆮𑆑𑇀 𑆱𑆩𑆣𑆶𑆑𑆁 𑆱𑆳𑆫𑆴𑆮𑆳 𑆖𑆼𑆠𑆴 𑆠𑆽𑆫𑇀𑆔𑆸𑆠𑆩𑇀𑇅 𑆱𑆴𑆢𑇀𑆣𑆁 𑆱𑆩𑆣𑆶𑆯𑆶𑆑𑇀𑆠𑆁 𑆱𑇀𑆪𑆳𑆠𑇀 𑆱𑆼𑆑𑆳𑆨𑇀𑆪𑆕𑇀𑆓𑆼 𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆼𑇆𑇑𑇔𑇖𑇆
𑆑𑇀𑆰𑆳𑆫𑆱𑇀𑆠𑆽𑆬𑆁 𑆓𑆮𑆳𑆁 𑆩𑆷𑆠𑇀𑆫𑆁 𑆘𑆬𑆁 𑆖 𑆑𑆛𑆶𑆑𑆽𑆂 𑆯𑆸𑆠𑆩𑇀𑇅 𑆥𑆫𑆴𑆰𑆼𑆑𑆼 𑆥𑇀𑆫𑆯𑆁𑆱𑆤𑇀𑆠𑆴 𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆼𑇆𑇑𑇔𑇗𑇆
𑆬𑆼𑆥𑆂 𑆱𑆫𑇀𑆰𑆥𑆤𑆴𑆩𑇀𑆧𑆳𑆫𑇀𑆑𑆲𑆴𑆁𑆱𑇀𑆫𑆳𑆑𑇀𑆰𑆵𑆫𑆠𑆴𑆬𑆽𑆫𑇀𑆲𑆴𑆠𑆂𑇅 𑆯𑇀𑆫𑆼𑆰𑇀𑆜𑆂 𑆱𑆴𑆢𑇀𑆣𑆂 𑆑𑆥𑆴𑆠𑇀𑆡𑆠𑇀𑆮𑆓𑇀𑆔𑆸𑆠𑆑𑇀𑆰𑆵𑆫𑆽𑆂 𑆱𑆱𑆑𑇀𑆠𑆶𑆨𑆴𑆂𑇆𑇑𑇔𑇘𑇆
𑆓𑆸𑆲𑆣𑆷𑆩𑆾 𑆮𑆖𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆯𑆠𑆳𑆲𑇀𑆮𑆳 𑆫𑆘𑆤𑆵𑆢𑇀𑆮𑆪𑆩𑇀𑇅 𑆥𑇀𑆫𑆬𑆼𑆥𑆂 𑆯𑆷𑆬𑆤𑆶𑆢𑇀𑆮𑆳𑆠𑆫𑆑𑇀𑆠𑆼 𑆮𑆳𑆠𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆼𑇆𑇑𑇔𑇙𑇆
𑆠𑆓𑆫𑆁 𑆠𑇀𑆮𑆑𑇀 𑆯𑆠𑆳𑆲𑇀𑆮𑆽𑆬𑆳 𑆑𑆶𑆰𑇀𑆜𑆁 𑆩𑆶𑆱𑇀𑆠𑆁 𑆲𑆫𑆼𑆟𑆶𑆑𑆳𑇅 𑆢𑆳𑆫𑆶 𑆮𑇀𑆪𑆳𑆔𑇀𑆫𑆤𑆒𑆁 𑆖𑆳𑆩𑇀𑆬𑆥𑆴𑆰𑇀𑆛𑆁 𑆮𑆳𑆠𑆑𑆦𑆳𑆱𑇀𑆫𑆤𑆶𑆠𑇀𑇆𑇑𑇕𑇐𑇆
𑆩𑆣𑆶𑆯𑆴𑆓𑇀𑆫𑆾𑆫𑇀𑆲𑆴𑆠𑆁 𑆠𑆢𑇀𑆮𑆢𑇀𑆧𑆵𑆘𑆁 𑆣𑆳𑆤𑇀𑆪𑆳𑆩𑇀𑆬𑆱𑆁𑆪𑆶𑆠𑆩𑇀𑇅 𑆩𑆶𑆲𑆷𑆫𑇀𑆠𑆁 𑆬𑆴𑆥𑇀𑆠𑆩𑆩𑇀𑆬𑆽𑆯𑇀𑆖 𑆱𑆴𑆚𑇀𑆖𑆼𑆢𑇀𑆮𑆳𑆠𑆑𑆦𑆾𑆠𑇀𑆠𑆫𑆩𑇀𑇆𑇑𑇕𑇑𑇆
𑆠𑇀𑆫𑆴𑆦𑆬𑆳𑆮𑇀𑆪𑆾𑆰𑆥𑆠𑇀𑆫𑆽𑆬𑆳𑆠𑇀𑆮𑆑𑇀𑆑𑇀𑆰𑆵𑆫𑆵𑆖𑆴𑆠𑇀𑆫𑆑𑆁 𑆮𑆖𑆳𑆩𑇀𑇅 𑆮𑆴𑆝𑆕𑇀𑆓𑆁 𑆥𑆴𑆥𑇀𑆥𑆬𑆵𑆩𑆷𑆬𑆁 𑆫𑆾𑆩𑆯𑆁 𑆮𑆸𑆰𑆑𑆠𑇀𑆮𑆖𑆩𑇀𑇆𑇑𑇕𑇒𑇆
𑆉𑆢𑇀𑆣𑆴𑆁 𑆠𑆳𑆩𑆬𑆑𑆵𑆁 𑆖𑆮𑇀𑆪𑆁 𑆱𑆩𑆨𑆳𑆓𑆳𑆤𑆴 𑆥𑆼𑆰𑆪𑆼𑆠𑇀𑇅 𑆑𑆬𑇀𑆪𑆁 𑆬𑆴𑆥𑇀𑆠𑆩𑆪𑆱𑇀𑆥𑆳𑆠𑇀𑆫𑆼 𑆩𑆣𑇀𑆪𑆳𑆲𑇀𑆤𑆼 𑆨𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑆠𑆠𑆂𑇆𑇑𑇕𑇓𑇆
𑆮𑆫𑇀𑆘𑆪𑆼𑆢𑇀𑆢𑆣𑆴𑆯𑆶𑆑𑇀𑆠𑆳𑆤𑆴 𑆑𑇀𑆰𑆳𑆫𑆁 𑆮𑆽𑆫𑆾𑆣𑆴𑆑𑆳𑆤𑆴 𑆖𑇅 𑆮𑆳𑆠𑆳𑆱𑇀𑆫𑆼 𑆱𑆫𑇀𑆮𑆢𑆾𑆰𑆼𑇁𑆥𑆴 𑆲𑆴𑆠𑆁 𑆯𑆷𑆬𑆳𑆫𑇀𑆢𑆴𑆠𑆼 𑆥𑆫𑆩𑇀𑇆𑇑𑇕𑇔𑇆
𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆱𑇀𑆡𑆳𑆤𑆮𑆴𑆯𑆼𑆰𑆳𑆁𑆯𑇀𑆖 𑆢𑆾𑆰𑆳𑆟𑆳𑆁 𑆖 𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇅 𑆖𑆴𑆑𑆴𑆠𑇀𑆱𑆴𑆠𑆩𑆴𑆢𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆷𑆲𑆳𑆥𑆾𑆲𑆮𑆴𑆑𑆬𑇀𑆥𑆮𑆴𑆠𑇀𑇆𑇑𑇕𑇕𑇆
𑆑𑆶𑆥𑆴𑆠𑆼 𑆩𑆳𑆫𑇀𑆓𑆱𑆁𑆫𑆾𑆣𑆳𑆤𑇀𑆩𑆼𑆢𑆱𑆾 𑆮𑆳 𑆑𑆦𑆱𑇀𑆪 𑆮𑆳𑇅 𑆃𑆠𑆴𑆮𑆸𑆢𑇀𑆣𑇀𑆪𑆳𑇁𑆤𑆴𑆬𑆼 𑆤𑆳𑆢𑆿 𑆯𑆱𑇀𑆠𑆁 𑆱𑇀𑆤𑆼𑆲𑆤𑆧𑆸𑆁𑆲𑆟𑆩𑇀𑇆𑇑𑇕𑇖𑇆
𑆮𑇀𑆪𑆳𑆪𑆳𑆩𑆯𑆾𑆣𑆤𑆳𑆫𑆴𑆰𑇀𑆛𑆩𑆷𑆠𑇀𑆫𑆥𑆳𑆤𑆽𑆫𑇀𑆮𑆴𑆫𑆼𑆖𑆤𑆽𑆂𑇅 𑆠𑆑𑇀𑆫𑆳𑆨𑆪𑆳𑆥𑇀𑆫𑆪𑆾𑆓𑆽𑆯𑇀𑆖 𑆑𑇀𑆰𑆥𑆪𑆼𑆠𑇀 𑆑𑆦𑆩𑆼𑆢𑆱𑆵𑇆𑇑𑇕𑇗𑇆

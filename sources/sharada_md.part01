𑆮𑆴𑆘𑇀𑆮𑆫𑆁 𑆘𑇀𑆮𑆫𑆱𑆤𑇀𑆢𑆼𑆲𑆁 𑆥𑆫𑇀𑆪𑆥𑆸𑆖𑇀𑆗𑆠𑇀 𑆥𑆶𑆤𑆫𑇀𑆮𑆱𑆶𑆩𑇀𑇅 𑆮𑆴𑆮𑆴𑆑𑇀𑆠𑆼 𑆯𑆳𑆤𑇀𑆠𑆩𑆳𑆱𑆵𑆤𑆩𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆂 𑆑𑆸𑆠𑆳𑆚𑇀𑆘𑆬𑆴𑆂𑇆𑇓𑇆
𑆢𑆼𑆲𑆼𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆩𑆤𑆱𑇀𑆠𑆳𑆥𑆵 𑆱𑆫𑇀𑆮𑆫𑆾𑆓𑆳𑆓𑇀𑆫𑆘𑆾 𑆧𑆬𑆵𑇅 𑆘𑇀𑆮𑆫𑆂 𑆥𑇀𑆫𑆣𑆳𑆤𑆾 𑆫𑆾𑆓𑆳𑆟𑆳𑆩𑆶𑆑𑇀𑆠𑆾 𑆨𑆓𑆮𑆠𑆳 𑆥𑆶𑆫𑆳𑇆𑇔𑇆
𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆳𑆟𑆴𑆱𑆥𑆠𑇀𑆤𑆱𑇀𑆪 𑆣𑇀𑆫𑆶𑆮𑆱𑇀𑆪 𑆥𑇀𑆫𑆬𑆪𑆾𑆢𑆪𑆼𑇅 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆁 𑆖 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆁 𑆖 𑆥𑇀𑆫𑆨𑆳𑆮𑆁 𑆑𑆳𑆫𑆟𑆳𑆤𑆴 𑆖𑇆𑇕𑇆
𑆥𑆷𑆫𑇀𑆮𑆫𑆷𑆥𑆩𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆁 𑆧𑆬𑆑𑆳𑆬𑆳𑆠𑇀𑆩𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅 𑆮𑇀𑆪𑆳𑆱𑆠𑆾 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆳𑆖𑇀𑆖 𑆥𑆸𑆡𑆓𑇀𑆨𑆴𑆤𑇀𑆤𑆱𑇀𑆪 𑆖𑆳𑆑𑆸𑆠𑆴𑆩𑇀𑇆𑇖𑇆
𑆬𑆴𑆕𑇀𑆓𑆩𑆳𑆩𑆱𑇀𑆪 𑆘𑆵𑆫𑇀𑆟𑆱𑇀𑆪 𑆱𑆿𑆰𑆣𑆁 𑆖 𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆫𑆩𑆩𑇀𑇅 𑆮𑆴𑆩𑆶𑆚𑇀𑆖𑆠𑆂 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆱𑇀𑆪 𑆖𑆴𑆲𑇀𑆤𑆁 𑆪𑆖𑇀𑆖 𑆥𑆸𑆡𑆑𑇀 𑆥𑆸𑆡𑆑𑇀𑇆𑇗𑇆
𑆘𑇀𑆮𑆫𑆳𑆮𑆱𑆸𑆰𑇀𑆛𑆾 𑆫𑆑𑇀𑆰𑇀𑆪𑆯𑇀𑆖 𑆪𑆳𑆮𑆠𑇀𑆑𑆳𑆬𑆁 𑆪𑆠𑆾 𑆪𑆠𑆂𑇅 𑆥𑇀𑆫𑆯𑆳𑆤𑇀𑆠𑆂 𑆑𑆳𑆫𑆟𑆽𑆫𑇀𑆪𑆽𑆯𑇀𑆖 𑆥𑆶𑆤𑆫𑆳𑆮𑆫𑇀𑆠𑆠𑆼 𑆘𑇀𑆮𑆫𑆂𑇆𑇘𑇆
𑆪𑆳𑆯𑇀𑆖𑆳𑆥𑆴 𑆥𑆶𑆤𑆫𑆳𑆮𑆸𑆠𑇀𑆠𑆁 𑆑𑇀𑆫𑆴𑆪𑆳𑆂 𑆥𑇀𑆫𑆯𑆩𑆪𑆤𑇀𑆠𑆴 𑆠𑆩𑇀𑇅 𑆘𑆓𑆢𑇀𑆣𑆴𑆠𑆳𑆫𑇀𑆡𑆁 𑆠𑆠𑇀 𑆱𑆫𑇀𑆮𑆁 𑆨𑆓𑆮𑆤𑇀! 𑆮𑆑𑇀𑆠𑆶𑆩𑆫𑇀𑆲𑆱𑆴𑇆𑇙𑇆
𑆠𑆢𑆓𑇀𑆤𑆴𑆮𑆼𑆯𑆱𑇀𑆪 𑆮𑆖𑆾 𑆤𑆴𑆯𑆩𑇀𑆪 𑆓𑆶𑆫𑆶𑆫𑆧𑇀𑆫𑆮𑆵𑆠𑇀𑇅 𑆘𑇀𑆮𑆫𑆳𑆣𑆴𑆑𑆳𑆫𑆼 𑆪𑆢𑇀𑆮𑆳𑆖𑇀𑆪𑆁 𑆠𑆠𑇀 𑆱𑆿𑆩𑇀𑆪! 𑆤𑆴𑆒𑆴𑆬𑆁 𑆯𑆸𑆟𑆶𑇆𑇑𑇐𑇆
𑆘𑇀𑆮𑆫𑆾 𑆮𑆴𑆑𑆳𑆫𑆾 𑆫𑆾𑆓𑆯𑇀𑆖 𑆮𑇀𑆪𑆳𑆣𑆴𑆫𑆳𑆠𑆕𑇀𑆑 𑆍𑆮 𑆖𑇅 𑆍𑆑𑆾𑇁𑆫𑇀𑆡𑆾 𑆤𑆳𑆩𑆥𑆫𑇀𑆪𑆳𑆪𑆽𑆫𑇀𑆮𑆴𑆮𑆴𑆣𑆽𑆫𑆨𑆴𑆣𑆵𑆪𑆠𑆼𑇆𑇑𑇑𑇆
𑆠𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆫𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆢𑆾𑆰𑆳𑆂 𑆯𑆳𑆫𑆵𑆫𑆩𑆳𑆤𑆱𑆳𑆂𑇅 𑆢𑆼𑆲𑆴𑆤𑆁 𑆤 𑆲𑆴 𑆤𑆴𑆫𑇀𑆢𑆾𑆰𑆁 𑆘𑇀𑆮𑆫𑆂 𑆱𑆩𑆶𑆥𑆱𑆼𑆮𑆠𑆼𑇆𑇑𑇒𑇆
𑆑𑇀𑆰𑆪𑆱𑇀𑆠𑆩𑆾 𑆘𑇀𑆮𑆫𑆂 𑆥𑆳𑆥𑇀𑆩𑆳 𑆩𑆸𑆠𑇀𑆪𑆶𑆯𑇀𑆖𑆾𑆑𑇀𑆠𑆳 𑆪𑆩𑆳𑆠𑇀𑆩𑆑𑆳𑆂𑇅 𑆥𑆚𑇀𑆖𑆠𑇀𑆮𑆥𑇀𑆫𑆠𑇀𑆪𑆪𑆳𑆤𑇀𑆤𑆹𑆟𑆳𑆁 𑆑𑇀𑆬𑆴𑆯𑇀𑆪𑆠𑆳𑆁 𑆱𑇀𑆮𑆼𑆤 𑆑𑆫𑇀𑆩𑆟𑆳𑇆𑇑𑇓𑇆
𑆅𑆠𑇀𑆪𑆱𑇀𑆪 𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆂 𑆥𑇀𑆫𑆾𑆑𑇀𑆠𑆳, ...𑇅𑇑𑇔𑇅 ... 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆱𑇀𑆠𑆶 𑆥𑆫𑆴𑆓𑇀𑆫𑆲𑆳𑆠𑇀𑇅 𑆤𑆴𑆢𑆳𑆤𑆼 𑆥𑆷𑆫𑇀𑆮𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳 𑆫𑆶𑆢𑇀𑆫𑆑𑆾𑆥𑆳𑆖𑇀𑆖 𑆢𑆳𑆫𑆶𑆟𑆳𑆠𑇀𑇆𑇑𑇔𑇆
𑆢𑇀𑆮𑆴𑆠𑆵𑆪𑆼 𑆲𑆴 𑆪𑆶𑆓𑆼 𑆯𑆫𑇀𑆮𑆩𑆑𑇀𑆫𑆾𑆣𑆮𑇀𑆫𑆠𑆩𑆳𑆱𑇀𑆡𑆴𑆠𑆩𑇀𑇅 𑆢𑆴𑆮𑇀𑆪𑆁 𑆱𑆲𑆱𑇀𑆫𑆁 𑆮𑆫𑇀𑆰𑆳𑆟𑆳𑆩𑆱𑆶𑆫𑆳 𑆃𑆨𑆴𑆢𑆶𑆢𑇀𑆫𑆶𑆮𑆶𑆂𑇆𑇑𑇕𑇆
𑆠𑆥𑆾𑆮𑆴𑆔𑇀𑆤𑆳𑆯𑆤𑆳𑆂 𑆑𑆫𑇀𑆠𑆶𑆁 𑆠𑆥𑆾𑆮𑆴𑆔𑇀𑆤𑆁 𑆩𑆲𑆳𑆠𑇀𑆩𑆤𑆂𑇅 𑆥𑆯𑇀𑆪𑆤𑇀 𑆱𑆩𑆫𑇀𑆡𑆯𑇀𑆖𑆾𑆥𑆼𑆑𑇀𑆰𑆳𑆁 𑆖𑆑𑇀𑆫𑆼 𑆢𑆑𑇀𑆰𑆂 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆂𑇆𑇑𑇖𑇆
𑆥𑆶𑆤𑆫𑇀𑆩𑆳𑆲𑆼𑆯𑇀𑆮𑆫𑆁 𑆨𑆳𑆓𑆁 𑆣𑇀𑆫𑆶𑆮𑆁 𑆢𑆑𑇀𑆰𑆂 𑆥𑇀𑆫𑆘𑆳𑆥𑆠𑆴𑆂𑇅 𑆪𑆘𑇀𑆚𑆼 𑆤 𑆑𑆬𑇀𑆥𑆪𑆳𑆩𑆳𑆱 𑆥𑇀𑆫𑆾𑆖𑇀𑆪𑆩𑆳𑆤𑆂 𑆱𑆶𑆫𑆽𑆫𑆥𑆴𑇆𑇑𑇗𑇆
𑆉𑆖𑆂 𑆥𑆯𑆶𑆥𑆠𑆼𑆫𑇀𑆪𑆳𑆯𑇀𑆖 𑆯𑆽𑆮𑇀𑆪 𑆄𑆲𑆠𑆪𑆯𑇀𑆖 𑆪𑆳𑆂𑇅 𑆪𑆘𑇀𑆚𑆱𑆴𑆢𑇀𑆣𑆴𑆥𑇀𑆫𑆢𑆳𑆱𑇀𑆠𑆳𑆨𑆴𑆫𑇀𑆲𑆵𑆤𑆁 𑆖𑆽𑆮 𑆱 𑆅𑆰𑇀𑆛𑆮𑆳𑆤𑇀𑇆𑇑𑇘𑇆
𑆃𑆡𑆾𑆠𑇀𑆠𑆵𑆫𑇀𑆟𑆮𑇀𑆫𑆠𑆾 𑆢𑆼𑆮𑆾 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆢𑆑𑇀𑆰𑆮𑇀𑆪𑆠𑆴𑆑𑇀𑆫𑆩𑆩𑇀𑇅 𑆫𑆶𑆢𑇀𑆫𑆾 𑆫𑆿𑆢𑇀𑆫𑆁 𑆥𑆶𑆫𑆱𑇀𑆑𑆸𑆠𑇀𑆪 𑆨𑆳𑆮𑆩𑆳𑆠𑇀𑆩𑆮𑆴𑆢𑆳𑆠𑇀𑆩𑆤𑆂𑇆𑇑𑇙𑇆
𑆱𑆸𑆰𑇀𑆛𑇀𑆮𑆳 𑆬𑆬𑆳𑆛𑆼 𑆖𑆑𑇀𑆰𑆶𑆫𑇀𑆮𑆽 𑆢𑆓𑇀𑆣𑇀𑆮𑆳 𑆠𑆳𑆤𑆱𑆶𑆫𑆳𑆤𑇀 𑆥𑇀𑆫𑆨𑆶𑆂𑇅 𑆧𑆳𑆬𑆁 𑆑𑇀𑆫𑆾𑆣𑆳𑆓𑇀𑆤𑆴𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆩𑆱𑆸𑆘𑆠𑇀 𑆱𑆠𑇀𑆫𑆤𑆳𑆯𑆤𑆩𑇀𑇆𑇒𑇐𑇆
𑆠𑆠𑆾 𑆪𑆘𑇀𑆚𑆂 𑆱 𑆮𑆴𑆣𑇀𑆮𑆱𑇀𑆠𑆾 𑆮𑇀𑆪𑆡𑆴𑆠𑆳𑆯𑇀𑆖 𑆢𑆴𑆮𑆿𑆑𑆱𑆂𑇅 𑆢𑆳𑆲𑆮𑇀𑆪𑆡𑆳𑆥𑆫𑆵𑆠𑆳𑆯𑇀𑆖 𑆨𑇀𑆫𑆳𑆤𑇀𑆠𑆳 𑆨𑆷𑆠𑆓𑆟𑆳 𑆢𑆴𑆯𑆂𑇆𑇒𑇑𑇆
𑆃𑆡𑆼𑆯𑇀𑆮𑆫𑆁 𑆢𑆼𑆮𑆓𑆟𑆂 𑆱𑆲 𑆱𑆥𑇀𑆠𑆫𑇀𑆰𑆴𑆨𑆴𑆫𑇀𑆮𑆴𑆨𑆶𑆩𑇀𑇅 𑆠𑆩𑆸𑆓𑇀𑆨𑆴𑆫𑆱𑇀𑆠𑆶𑆮𑆤𑇀 𑆪𑆳𑆮𑆖𑇀𑆗𑆽𑆮𑆼 𑆨𑆳𑆮𑆼 𑆯𑆴𑆮𑆂 𑆱𑇀𑆡𑆴𑆠𑆂𑇆𑇒𑇒𑇆
𑆯𑆴𑆮𑆁 𑆯𑆴𑆮𑆳𑆪 𑆨𑆷𑆠𑆳𑆤𑆳𑆁 𑆱𑇀𑆡𑆴𑆠𑆁 𑆘𑇀𑆚𑆳𑆠𑇀𑆮𑆳 𑆑𑆸𑆠𑆳𑆚𑇀𑆘𑆬𑆴𑆂𑇅 𑆨𑆴𑆪𑆳 𑆨𑆱𑇀𑆩𑆥𑇀𑆫𑆲𑆫𑆟𑆱𑇀𑆠𑇀𑆫𑆴𑆯𑆴𑆫𑆳 𑆤𑆮𑆬𑆾𑆖𑆤𑆂𑇆𑇒𑇓𑇆
𑆘𑇀𑆮𑆳𑆬𑆳𑆩𑆳𑆬𑆳𑆑𑆶𑆬𑆾 𑆫𑆿𑆢𑇀𑆫𑆾 𑆲𑇀𑆫𑆱𑇀𑆮𑆘𑆕𑇀𑆔𑆾𑆢𑆫𑆂 𑆑𑇀𑆫𑆩𑆳𑆠𑇀𑇅 𑆑𑇀𑆫𑆾𑆣𑆳𑆓𑇀𑆤𑆴𑆫𑆶𑆑𑇀𑆠𑆮𑆳𑆤𑇀 𑆢𑆼𑆮𑆩𑆲𑆁 𑆑𑆴𑆁 𑆑𑆫𑆮𑆳𑆟𑆴 𑆠𑆼𑇆𑇒𑇔𑇆
𑆠𑆩𑆶𑆮𑆳𑆖𑆼𑆯𑇀𑆮𑆫𑆂 𑆑𑇀𑆫𑆾𑆣𑆁 𑆘𑇀𑆮𑆫𑆾 𑆬𑆾𑆑𑆼 𑆨𑆮𑆴𑆰𑇀𑆪𑆱𑆴𑇅 𑆘𑆤𑇀𑆩𑆳𑆢𑆿 𑆤𑆴𑆣𑆤𑆼 𑆖 𑆠𑇀𑆮𑆩𑆥𑆖𑆳𑆫𑆳𑆤𑇀𑆠𑆫𑆼𑆰𑆶 𑆖𑇆𑇒𑇕𑇆
𑆱𑆤𑇀𑆠𑆳𑆥𑆂 𑆱𑆳𑆫𑆶𑆖𑆴𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆱𑆳𑆕𑇀𑆓𑆩𑆫𑇀𑆢𑆾 𑆲𑆸𑆢𑆴 𑆮𑇀𑆪𑆡𑆳𑇅 𑆘𑇀𑆮𑆫𑆥𑇀𑆫𑆨𑆳𑆮𑆾, 𑆘𑆤𑇀𑆩𑆳𑆢𑆿 𑆤𑆴𑆣𑆤𑆼 𑆖 𑆩𑆲𑆠𑇀𑆠𑆩𑆂𑇆𑇒𑇖𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆮𑆸𑆠𑇀𑆠𑆴𑆯𑇀𑆖 𑆥𑇀𑆫𑆨𑆳𑆮𑆯𑇀𑆖 𑆥𑇀𑆫𑆢𑆫𑇀𑆯𑆴𑆠𑆂𑇅𑇒𑇗𑇅 𑆤𑆴𑆢𑆳𑆤𑆼 𑆑𑆳𑆫𑆟𑆳𑆤𑇀𑆪𑆰𑇀𑆛𑆿 𑆥𑆷𑆫𑇀𑆮𑆾𑆑𑇀𑆠𑆳𑆤𑆴 𑆮𑆴𑆨𑆳𑆓𑆯𑆂𑇆𑇒𑇗𑇆
𑆄𑆬𑆱𑇀𑆪𑆁 𑆤𑆪𑆤𑆼 𑆱𑆳𑆱𑇀𑆫𑆼 𑆘𑆸𑆩𑇀𑆨𑆟𑆁 𑆓𑆿𑆫𑆮𑆁 𑆑𑇀𑆫𑆩𑆂𑇅 𑆘𑇀𑆮𑆬𑆤𑆳𑆠𑆥𑆮𑆳𑆪𑇀𑆮𑆩𑇀𑆧𑆶𑆨𑆑𑇀𑆠𑆴𑆢𑇀𑆮𑆼𑆰𑆳𑆮𑆤𑆴𑆯𑇀𑆖𑆴𑆠𑆿𑇆𑇒𑇘𑇆
𑆃𑆮𑆴𑆥𑆳𑆑𑆳𑆱𑇀𑆪𑆮𑆽𑆫𑆱𑇀𑆪𑆼 𑆲𑆳𑆤𑆴𑆯𑇀𑆖 𑆧𑆬𑆮𑆫𑇀𑆟𑆪𑆾𑆂𑇅 𑆯𑆵𑆬𑆮𑆽𑆑𑆸𑆠𑆩𑆬𑇀𑆥𑆁 𑆖 𑆘𑇀𑆮𑆫𑆬𑆑𑇀𑆰𑆟𑆩𑆓𑇀𑆫𑆘𑆩𑇀𑇆𑇒𑇙𑇆
𑆑𑆼𑆮𑆬𑆁 𑆱𑆩𑆤𑆱𑇀𑆑𑆁 𑆖 𑆘𑇀𑆮𑆫𑆳𑆣𑆴𑆰𑇀𑆜𑆳𑆤𑆩𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆯𑆫𑆵𑆫𑆁, 𑆧𑆬𑆑𑆳𑆬𑆱𑇀𑆠𑆶 𑆤𑆴𑆢𑆳𑆤𑆼 𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆫𑇀𑆯𑆴𑆠𑆂𑇆𑇓𑇐𑇆
𑆘𑇀𑆮𑆫𑆥𑇀𑆫𑆠𑇀𑆪𑆳𑆠𑇀𑆩𑆴𑆑𑆁 𑆬𑆴𑆕𑇀𑆓𑆁 𑆱𑆤𑇀𑆠𑆳𑆥𑆾 𑆢𑆼𑆲𑆩𑆳𑆤𑆱𑆂𑇅 𑆘𑇀𑆮𑆫𑆼𑆟𑆳𑆮𑆴𑆯𑆠𑆳 𑆨𑆷𑆠𑆁 𑆤 𑆲𑆴 𑆑𑆴𑆚𑇀𑆖𑆴𑆤𑇀𑆤 𑆠𑆥𑇀𑆪𑆠𑆼𑇆𑇓𑇑𑇆
𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆾 𑆮𑆴𑆣𑆴𑆨𑆼𑆢𑆼𑆤 𑆘𑇀𑆮𑆫𑆂 𑆯𑆳𑆫𑆵𑆫𑆩𑆳𑆤𑆱𑆂𑇅 𑆥𑆶𑆤𑆯𑇀𑆖 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆾 𑆢𑆸𑆰𑇀𑆛𑆂 𑆱𑆿𑆩𑇀𑆪𑆯𑇀𑆖𑆳𑆓𑇀𑆤𑆼𑆪 𑆍𑆮 𑆮𑆳𑇆𑇓𑇒𑇆
𑆃𑆤𑇀𑆠𑆫𑇀𑆮𑆼𑆓𑆾 𑆧𑆲𑆴𑆫𑇀𑆮𑆼𑆓𑆾 𑆢𑇀𑆮𑆴𑆮𑆴𑆣𑆂 𑆥𑆶𑆤𑆫𑆶𑆖𑇀𑆪𑆠𑆼𑇅 𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆾 𑆮𑆽𑆑𑆸𑆠𑆯𑇀𑆖𑆽𑆮 𑆱𑆳𑆣𑇀𑆪𑆯𑇀𑆖𑆳𑆱𑆳𑆣𑇀𑆪 𑆍𑆮 𑆖𑇆𑇓𑇓𑇆
𑆥𑆶𑆤𑆂 𑆥𑆚𑇀𑆖𑆮𑆴𑆣𑆾 𑆢𑆸𑆰𑇀𑆛𑆾 𑆢𑆾𑆰𑆑𑆳𑆬𑆧𑆬𑆳𑆧𑆬𑆳𑆠𑇀𑇅 𑆱𑆤𑇀𑆠𑆠𑆂 𑆱𑆠𑆠𑆾𑇁𑆤𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆱𑇀𑆠𑆸𑆠𑆵𑆪𑆑𑆖𑆠𑆶𑆫𑇀𑆡𑆑𑆿𑇆𑇓𑇔𑇆
𑆥𑆶𑆤𑆫𑆳𑆯𑇀𑆫𑆪𑆨𑆼𑆢𑆼𑆤 𑆣𑆳𑆠𑆷𑆤𑆳𑆁 𑆱𑆥𑇀𑆠𑆣𑆳 𑆩𑆠𑆂𑇅 𑆨𑆴𑆤𑇀𑆤𑆂 𑆑𑆳𑆫𑆟𑆨𑆼𑆢𑆼𑆤 𑆥𑆶𑆤𑆫𑆰𑇀𑆛𑆮𑆴𑆣𑆾 𑆘𑇀𑆮𑆫𑆂𑇆𑇓𑇕𑇆
𑆯𑆳𑆫𑆵𑆫𑆾 𑆘𑆳𑆪𑆠𑆼 𑆥𑆷𑆫𑇀𑆮𑆁 𑆢𑆼𑆲𑆼, 𑆩𑆤𑆱𑆴 𑆩𑆳𑆤𑆱𑆂𑇅 𑆮𑆽𑆖𑆴𑆠𑇀𑆠𑇀𑆪𑆩𑆫𑆠𑆴𑆫𑇀𑆓𑇀𑆬𑆳𑆤𑆴𑆫𑇀𑆩𑆤𑆱𑆱𑇀𑆠𑆳𑆥𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇓𑇖𑇆
𑆅𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆳𑆟𑆳𑆁 𑆖 𑆮𑆽𑆑𑆸𑆠𑇀𑆪𑆁 𑆘𑇀𑆚𑆼𑆪𑆁 𑆱𑆤𑇀𑆠𑆳𑆥𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇅𑇓𑇗𑇅 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆳𑆠𑇀𑆩𑆑𑆂 𑆯𑆵𑆠𑆩𑆶𑆰𑇀𑆟𑆁 𑆮𑆳𑆠𑆑𑆦𑆳𑆠𑇀𑆩𑆑𑆂𑇆𑇓𑇗𑇆
𑆅𑆖𑇀𑆗𑆠𑇀𑆪𑆶𑆨𑆪𑆩𑆼𑆠𑆠𑇀𑆠𑆶 𑆘𑇀𑆮𑆫𑆾 𑆮𑇀𑆪𑆳𑆩𑆴𑆯𑇀𑆫𑆬𑆑𑇀𑆰𑆟𑆂𑇅𑇓𑇘𑇅 𑆪𑆾𑆓𑆮𑆳𑆲𑆂 𑆥𑆫𑆁 𑆮𑆳𑆪𑆶𑆂 𑆱𑆁𑆪𑆾𑆓𑆳𑆢𑆶𑆨𑆪𑆳𑆫𑇀𑆡𑆑𑆸𑆠𑇀𑇆𑇓𑇘𑇆
𑆢𑆳𑆲𑆑𑆸𑆠𑇀𑆠𑆼𑆘𑆱𑆳 𑆪𑆶𑆑𑇀𑆠𑆂, 𑆯𑆵𑆠𑆑𑆸𑆠𑇀 𑆱𑆾𑆩𑆱𑆁𑆯𑇀𑆫𑆪𑆳𑆠𑇀𑇅𑇓𑇙𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆢𑆳𑆲𑆾𑇁𑆣𑆴𑆑𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳 𑆥𑇀𑆫𑆬𑆳𑆥𑆂 𑆯𑇀𑆮𑆱𑆤𑆁 𑆨𑇀𑆫𑆩𑆂𑇆𑇓𑇙𑇆
𑆱𑆤𑇀𑆣𑇀𑆪𑆱𑇀𑆡𑆴𑆯𑆷𑆬𑆩𑆱𑇀𑆮𑆼𑆢𑆾 𑆢𑆾𑆰𑆮𑆫𑇀𑆖𑆾𑆮𑆴𑆤𑆴𑆓𑇀𑆫𑆲𑆂𑇅 𑆃𑆤𑇀𑆠𑆫𑇀𑆮𑆼𑆓𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆘𑇀𑆮𑆫𑆱𑇀𑆪𑆽𑆠𑆳𑆤𑆴 𑆬𑆑𑇀𑆰𑆪𑆼𑆠𑇀𑇆𑇔𑇐𑇆
𑆱𑆤𑇀𑆠𑆳𑆥𑆾𑇁𑆨𑇀𑆪𑆣𑆴𑆑𑆾 𑆧𑆳𑆲𑇀𑆪𑆱𑇀𑆠𑆸𑆰𑇀𑆟𑆳𑆢𑆵𑆤𑆳𑆁 𑆖 𑆩𑆳𑆫𑇀𑆢𑆮𑆩𑇀𑇅 𑆧𑆲𑆴𑆫𑇀𑆮𑆼𑆓𑆱𑇀𑆪 𑆬𑆴𑆕𑇀𑆓𑆳𑆤𑆴 𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆠𑇀𑆮𑆩𑆼𑆮 𑆖𑇆𑇔𑇑𑇆
𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆂 𑆱𑆶𑆒𑆱𑆳𑆣𑇀𑆪𑆱𑇀𑆠𑆶 𑆮𑆱𑆤𑇀𑆠𑆯𑆫𑆢𑆶𑆢𑇀𑆨𑆮𑆂𑇅 𑆇𑆰𑇀𑆟𑆩𑆶𑆰𑇀𑆟𑆼𑆤 𑆱𑆁𑆮𑆸𑆢𑇀𑆣𑆁 𑆥𑆴𑆠𑇀𑆠𑆁 𑆯𑆫𑆢𑆴 𑆑𑆶𑆥𑇀𑆪𑆠𑆴𑇆𑇔𑇒𑇆
𑆖𑆴𑆠𑆂 𑆯𑆵𑆠𑆼 𑆑𑆦𑆯𑇀𑆖𑆽𑆮𑆁 𑆮𑆱𑆤𑇀𑆠𑆼 𑆱𑆩𑆶𑆢𑆵𑆫𑇀𑆪𑆠𑆼𑇅 𑆮𑆫𑇀𑆰𑆳𑆱𑇀𑆮𑆩𑇀𑆬𑆮𑆴𑆥𑆳𑆑𑆳𑆨𑆴𑆫𑆢𑇀𑆨𑆴𑆫𑆾𑆰𑆣𑆴𑆨𑆴𑆱𑇀𑆠𑆡𑆳𑇆𑇔𑇓𑇆
𑆱𑆚𑇀𑆖𑆴𑆠𑆁 𑆥𑆴𑆠𑇀𑆠𑆩𑆶𑆢𑇀𑆫𑆴𑆑𑇀𑆠𑆁 𑆯𑆫𑆢𑇀𑆪𑆳𑆢𑆴𑆠𑇀𑆪𑆠𑆼𑆘𑆱𑆳𑇅 𑆘𑇀𑆮𑆫𑆁 𑆱𑆚𑇀𑆘𑆤𑆪𑆠𑇀𑆪𑆳𑆯𑆶 𑆠𑆱𑇀𑆪 𑆖𑆳𑆤𑆶𑆧𑆬𑆂 𑆑𑆦𑆂𑇆𑇔𑇔𑇆
𑆥𑇀𑆫𑆑𑆸𑆠𑇀𑆪𑆽𑆮 𑆮𑆴𑆱𑆫𑇀𑆓𑆱𑇀𑆪 𑆠𑆠𑇀𑆫 𑆤𑆳𑆤𑆯𑆤𑆳𑆢𑇀𑆨𑆪𑆩𑇀𑇅 𑆃𑆢𑇀𑆨𑆴𑆫𑆾𑆰𑆣𑆴𑆨𑆴𑆯𑇀𑆖𑆽𑆮 𑆩𑆣𑆶𑆫𑆳𑆨𑆴𑆯𑇀𑆖𑆴𑆠𑆂 𑆑𑆦𑆂𑇆𑇔𑇕𑇆
𑆲𑆼𑆩𑆤𑇀𑆠𑆼, 𑆱𑆷𑆫𑇀𑆪𑆱𑆤𑇀𑆠𑆥𑇀𑆠𑆂 𑆱 𑆮𑆱𑆤𑇀𑆠𑆼 𑆥𑇀𑆫𑆑𑆶𑆥𑇀𑆪𑆠𑆴𑇅 𑆮𑆱𑆤𑇀𑆠𑆼 𑆯𑇀𑆬𑆼𑆰𑇀𑆩𑆟𑆳 𑆠𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆂 𑆱𑆩𑆶𑆥𑆘𑆳𑆪𑆠𑆼𑇆𑇔𑇖𑇆
𑆄𑆢𑆳𑆤𑆩𑆣𑇀𑆪𑆼 𑆠𑆱𑇀𑆪𑆳𑆥𑆴 𑆮𑆳𑆠𑆥𑆴𑆠𑇀𑆠𑆁 𑆨𑆮𑆼𑆢𑆤𑆶𑇅𑇔𑇗𑇅 𑆄𑆢𑆳𑆮𑆤𑇀𑆠𑆼 𑆖 𑆩𑆣𑇀𑆪𑆼 𑆖 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆢𑆾𑆰𑆧𑆬𑆳𑆧𑆬𑆩𑇀𑇆𑇔𑇗𑇆
𑆯𑆫𑆢𑇀𑆮𑆱𑆤𑇀𑆠𑆪𑆾𑆫𑇀𑆮𑆴𑆢𑇀𑆮𑆳𑆚𑇀𑆘𑇀𑆮𑆫𑆱𑇀𑆪 𑆥𑇀𑆫𑆠𑆴𑆑𑆳𑆫𑆪𑆼𑆠𑇀𑇅𑇔𑇘𑇅 𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆩𑆶𑆢𑇀𑆢𑆴𑆯𑇀𑆪 𑆤𑆴𑆫𑇀𑆢𑆴𑆰𑇀𑆛𑆂 𑆥𑇀𑆫𑆳𑆑𑆸𑆠𑆾 𑆘𑇀𑆮𑆫𑆂𑇆𑇔𑇘𑇆
𑆥𑇀𑆫𑆳𑆪𑆼𑆟𑆳𑆤𑆴𑆬𑆘𑆾 𑆢𑆶𑆂𑆒𑆂 𑆑𑆳𑆬𑆼𑆰𑇀𑆮𑆤𑇀𑆪𑆼𑆰𑆶 𑆮𑆽𑆑𑆸𑆠𑆂𑇅 𑆲𑆼𑆠𑆮𑆾 𑆮𑆴𑆮𑆴𑆣𑆳𑆱𑇀𑆠𑆱𑇀𑆪 𑆤𑆴𑆢𑆳𑆤𑆼 𑆱𑆩𑇀𑆥𑇀𑆫𑆢𑆫𑇀𑆯𑆴𑆠𑆳𑆂𑇆𑇔𑇙𑇆
𑆧𑆬𑆮𑆠𑇀𑆱𑇀𑆮𑆬𑇀𑆥𑆢𑆾𑆰𑆼𑆰𑆶 𑆘𑇀𑆮𑆫𑆂 𑆱𑆳𑆣𑇀𑆪𑆾𑇁𑆤𑆶𑆥𑆢𑇀𑆫𑆮𑆂𑇅𑇕𑇐𑇅 𑆲𑆼𑆠𑆶𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆨𑆴𑆫𑇀𑆘𑆳𑆠𑆾 𑆧𑆬𑆴𑆨𑆴𑆫𑇀𑆧𑆲𑆶𑆬𑆑𑇀𑆰𑆟𑆂𑇆𑇕𑇐𑇆
𑆘𑇀𑆮𑆫𑆂 𑆥𑇀𑆫𑆳𑆟𑆳𑆤𑇀𑆠𑆑𑆸𑆢𑇀𑆪𑆯𑇀𑆖 𑆯𑆵𑆔𑇀𑆫𑆩𑆴𑆤𑇀𑆢𑇀𑆫𑆴𑆪𑆤𑆳𑆯𑆤𑆂𑇅𑇕𑇑𑇅 𑆱𑆥𑇀𑆠𑆳𑆲𑆳𑆢𑇀𑆮𑆳 𑆢𑆯𑆳𑆲𑆳𑆢𑇀𑆮𑆳 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆳𑆠𑇀𑆠𑆡𑆽𑆮 𑆖𑇆𑇕𑇑𑇆
𑆱𑆥𑇀𑆫𑆬𑆳𑆥𑆨𑇀𑆫𑆩𑆯𑇀𑆮𑆳𑆱𑆱𑇀𑆠𑆵𑆑𑇀𑆰𑇀𑆟𑆾 𑆲𑆤𑇀𑆪𑆳𑆘𑇀𑆘𑇀𑆮𑆫𑆾 𑆤𑆫𑆩𑇀𑇅𑇕𑇒𑇅 𑆘𑇀𑆮𑆫𑆂 𑆑𑇀𑆰𑆵𑆟𑆱𑇀𑆪 𑆯𑆷𑆤𑆱𑇀𑆪 𑆓𑆩𑇀𑆨𑆵𑆫𑆾 𑆢𑆽𑆫𑇀𑆔𑆫𑆳𑆠𑇀𑆫𑆴𑆑𑆂𑇆𑇕𑇒𑇆
𑆃𑆱𑆳𑆣𑇀𑆪𑆾 𑆧𑆬𑆮𑆳𑆤𑇀 𑆪𑆯𑇀𑆖 𑆑𑆼𑆯𑆱𑆵𑆩𑆤𑇀𑆠𑆑𑆸𑆘𑇀𑆘𑇀𑆮𑆫𑆂𑇅𑇕𑇓𑇅 𑆱𑇀𑆫𑆾𑆠𑆾𑆨𑆴𑆫𑇀𑆮𑆴𑆱𑆸𑆠𑆳 𑆢𑆾𑆰𑆳 𑆓𑆶𑆫𑆮𑆾 𑆫𑆱𑆮𑆳𑆲𑆴𑆨𑆴𑆂𑇆𑇕𑇓𑇆
𑆱𑆫𑇀𑆮𑆢𑆼𑆲𑆳𑆤𑆶𑆓𑆳𑆂 𑆱𑇀𑆠𑆧𑇀𑆣𑆳 𑆘𑇀𑆮𑆫𑆁 𑆑𑆶𑆫𑇀𑆮𑆤𑇀𑆠𑆴 𑆱𑆤𑇀𑆠𑆠𑆩𑇀𑇅 𑆢𑆯𑆳𑆲𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆳𑆲𑆁 𑆮𑆳 𑆱𑆥𑇀𑆠𑆳𑆲𑆁 𑆮𑆳 𑆱𑆶𑆢𑆶𑆂𑆱𑆲𑆂𑇆𑇕𑇔𑇆
𑆱 𑆯𑆵𑆔𑇀𑆫𑆁 𑆯𑆵𑆔𑇀𑆫𑆑𑆳𑆫𑆴𑆠𑇀𑆮𑆳𑆠𑇀 𑆥𑇀𑆫𑆯𑆩𑆁 𑆪𑆳𑆠𑆴 𑆲𑆤𑇀𑆠𑆴 𑆮𑆳𑇅 𑆑𑆳𑆬𑆢𑆷𑆰𑇀𑆪𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆨𑆴𑆫𑇀𑆢𑆾𑆰𑆱𑇀𑆠𑆶𑆬𑇀𑆪𑆾 𑆲𑆴 𑆱𑆤𑇀𑆠𑆠𑆩𑇀𑇆𑇕𑇕𑇆
𑆤𑆴𑆰𑇀𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆠𑆱𑇀𑆩𑆳𑆘𑇀𑆘𑇀𑆚𑆼𑆪𑆂 𑆱𑆶𑆢𑆶𑆂𑆱𑆲𑆂𑇅 𑆪𑆡𑆳 𑆣𑆳𑆠𑆷𑆁𑆱𑇀𑆠𑆡𑆳 𑆩𑆷𑆠𑇀𑆫𑆁 𑆥𑆶𑆫𑆵𑆰𑆁 𑆖𑆳𑆤𑆴𑆬𑆳𑆢𑆪𑆂𑇆𑇕𑇖𑇆
𑆪𑆶𑆓𑆥𑆖𑇀𑆖𑆳𑆤𑆶𑆥𑆢𑇀𑆪𑆤𑇀𑆠𑆼 𑆤𑆴𑆪𑆩𑆳𑆠𑇀 𑆱𑆤𑇀𑆠𑆠𑆼 𑆘𑇀𑆮𑆫𑆼𑇅 𑆱 𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆮𑆳𑇁𑆥𑇀𑆪𑆯𑆶𑆢𑇀𑆣𑇀𑆪𑆳 𑆮𑆳 𑆫𑆱𑆳𑆢𑆵𑆤𑆳𑆩𑆯𑆼𑆰𑆠𑆂𑇆𑇕𑇗𑇆
𑆱𑆥𑇀𑆠𑆳𑆲𑆳𑆢𑆴𑆰𑆶 𑆑𑆳𑆬𑆼𑆰𑆶 𑆥𑇀𑆫𑆯𑆩𑆁 𑆪𑆳𑆠𑆴 𑆲𑆤𑇀𑆠𑆴 𑆮𑆳𑇅 𑆪𑆢𑆳 𑆠𑆶 𑆤𑆳𑆠𑆴𑆯𑆶𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆤 𑆮𑆳 𑆯𑆶𑆣𑇀𑆪𑆤𑇀𑆠𑆴 𑆱𑆫𑇀𑆮𑆯𑆂𑇆𑇕𑇘𑇆
𑆢𑇀𑆮𑆳𑆢𑆯𑆽𑆠𑆼 𑆱𑆩𑆶𑆢𑇀𑆢𑆴𑆰𑇀𑆛𑆳𑆂 𑆱𑆤𑇀𑆠𑆠𑆱𑇀𑆪𑆳𑆯𑇀𑆫𑆪𑆳𑆱𑇀𑆠𑆢𑆳𑇅 𑆮𑆴𑆱𑆫𑇀𑆓𑆁 𑆢𑇀𑆮𑆳𑆢𑆯𑆼 𑆑𑆸𑆠𑇀𑆮𑆳 𑆢𑆴𑆮𑆱𑆼𑇁𑆮𑇀𑆪𑆑𑇀𑆠𑆬𑆑𑇀𑆰𑆟𑆩𑇀𑇆𑇕𑇙𑇆
𑆢𑆶𑆫𑇀𑆬𑆨𑆾𑆥𑆯𑆩𑆂 𑆑𑆳𑆬𑆁 𑆢𑆵𑆫𑇀𑆔𑆩𑆥𑇀𑆪𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇅 𑆅𑆠𑆴 𑆧𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆘𑇀𑆮𑆫𑆁 𑆮𑆽𑆢𑇀𑆪 𑆇𑆥𑆑𑇀𑆫𑆳𑆩𑆼𑆠𑇀𑆠𑆶 𑆱𑆤𑇀𑆠𑆠𑆩𑇀 𑇆𑇖𑇐𑇆
𑆑𑇀𑆫𑆴𑆪𑆳𑆑𑇀𑆫𑆩𑆮𑆴𑆣𑆿 𑆪𑆶𑆑𑇀𑆠𑆂 𑆥𑇀𑆫𑆳𑆪𑆂 𑆥𑇀𑆫𑆳𑆓𑆥𑆠𑆫𑇀𑆥𑆟𑆽𑆂𑇅𑇖𑇑𑇅 𑆫𑆑𑇀𑆠𑆣𑆳𑆠𑇀𑆮𑆳𑆯𑇀𑆫𑆪𑆂 𑆥𑇀𑆫𑆳𑆪𑆾 𑆢𑆾𑆰𑆂 𑆱𑆠𑆠𑆑𑆁 𑆘𑇀𑆮𑆫𑆩𑇀𑇆𑇖𑇑𑇆
𑆱𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆂 𑆑𑆶𑆫𑆶𑆠𑆼 𑆑𑆳𑆬𑆮𑆸𑆢𑇀𑆣𑆴𑆑𑇀𑆰𑆪𑆳𑆠𑇀𑆩𑆑𑆩𑇀𑇅 𑆃𑆲𑆾𑆫𑆳𑆠𑇀𑆫𑆼 𑆱𑆠𑆠𑆑𑆾 𑆢𑇀𑆮𑆿 𑆑𑆳𑆬𑆳𑆮𑆤𑆶𑆮𑆫𑇀𑆠𑆠𑆼𑇆𑇖𑇒𑇆
𑆑𑆳𑆬𑆥𑇀𑆫𑆑𑆸𑆠𑆴𑆢𑆷𑆰𑇀𑆪𑆳𑆟𑆳𑆁 𑆥𑇀𑆫𑆳𑆥𑇀𑆪𑆽𑆮𑆳𑆤𑇀𑆪𑆠𑆩𑆳𑆢𑇀𑆧𑆬𑆩𑇀𑇅 𑆃𑆤𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆰𑇀𑆑𑆁 𑆘𑇀𑆮𑆫𑆁 𑆢𑆾𑆰𑆾 𑆫𑆶𑆢𑇀𑆣𑇀𑆮𑆳 𑆩𑆼𑆢𑆾𑆮𑆲𑆳𑆂 𑆱𑆴𑆫𑆳𑆂𑇆𑇖𑇓𑇆
𑆱𑆥𑇀𑆫𑆠𑇀𑆪𑆤𑆵𑆑𑆾 𑆘𑆤𑆪𑆠𑇀𑆪𑆼𑆑𑆑𑆳𑆬𑆩𑆲𑆫𑇀𑆤𑆴𑆯𑆴𑇅 𑆢𑆾𑆰𑆾𑇁𑆱𑇀𑆡𑆴𑆩𑆘𑇀𑆘𑆓𑆂 𑆑𑆶𑆫𑇀𑆪𑆳𑆠𑇀𑆠𑆸𑆠𑆵𑆪𑆑𑆖𑆠𑆶𑆫𑇀𑆡𑆑𑆿𑇆𑇖𑇔𑇆
𑆓𑆠𑆴𑆫𑇀𑆢𑇀𑆮𑇀𑆪𑆼𑆑𑆳𑆤𑇀𑆠𑆫𑆳𑇁𑆤𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆫𑇀𑆢𑆾𑆰𑆱𑇀𑆪𑆾𑆑𑇀𑆠𑆳𑇁𑆤𑇀𑆪𑆡𑆳 𑆥𑆫𑆽𑆂𑇅 𑆃𑆤𑇀𑆪𑆼𑆢𑇀𑆪𑆶𑆰𑇀𑆑𑆁 𑆘𑇀𑆮𑆫𑆁 𑆑𑆶𑆫𑇀𑆪𑆳𑆢𑆥𑆴 𑆱𑆁𑆯𑇀𑆫𑆴𑆠𑇀𑆪 𑆯𑆾𑆟𑆴𑆠𑆩𑇀𑇆𑇖𑇕𑇆
